{
    "word_family": [
        "snikken",
        "snikheet"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "17b59eed-f408-37dc-9a6b-2789504691ea",
                    "sense_definition": "krampachtige ademhaling of schokkend geluid bij hevig huilen of verdriet",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verdriet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met een diepe <w>snik</w> probeerde het kind zijn tranen te bedwingen.",
                            "target_lang_translations": {
                                "fr": "Avec un profond <w>sanglot</w>, l'enfant essaya de retenir ses larmes."
                            }
                        },
                        {
                            "text": "Hij bleef zijn standpunt tot zijn laatste <w>snik</w> vurig verdedigen.",
                            "target_lang_translations": {
                                "fr": "Il continua à défendre ardemment sa position jusqu'à son dernier <w>soupir</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de laatste snik"
                    ],
                    "target_lang_definitions": {
                        "fr": "Respiration convulsive ou bruit saccadé produit lors de pleurs intenses ou de chagrin."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "sanglot",
                                "target_lang_sense_clarification": "bruit saccadé ou spasme de pleurs"
                            },
                            {
                                "target_lang_word": "soupir",
                                "target_lang_sense_clarification": "dans l'expression 'le dernier soupir' (de laatste snik)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b43fb990-6fae-33eb-a6eb-9ac076b6348b",
                    "sense_definition": "historisch type zeilboot of trekschuit voor passagiers- en goederenvervoer",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vaartuig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het museum ligt een gerestaureerde <w>snik</w> uit de negentiende eeuw.",
                            "target_lang_translations": {
                                "fr": "Dans le musée se trouve un <w>snik</w> restauré datant du dix-neuvième siècle."
                            }
                        },
                        {
                            "text": "Vroeger voer deze <w>snik</w> regelmatig tussen Groningen en andere steden.",
                            "target_lang_translations": {
                                "fr": "Autrefois, ce <w>coche d'eau</w> naviguait régulièrement entre Groningue et d'autres villes."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historische benaming voor een type vaartuig"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Type historique de bateau à voile ou coche d'eau néerlandais destiné au transport de passagers et de marchandises."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "snik",
                                "target_lang_sense_clarification": "coche d'eau ou embarcation historique néerlandaise"
                            },
                            {
                                "target_lang_word": "coche d'eau",
                                "target_lang_sense_clarification": "bateau de transport fluvial tiré ou à voile"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0bf93804-4f8d-3271-b359-a5d8ef19784f",
                    "sense_definition": "bij het volle verstand of verstandig (vrijwel uitsluitend in ontkennende constructies)",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verstand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ben je niet goed <w>snik</w> om zo hard door de stad te rijden?",
                            "target_lang_translations": {
                                "fr": "Tu es complètement <w>cinglé</w> de rouler aussi vite en ville ?"
                            }
                        },
                        {
                            "text": "Iedereen dacht dat hij niet goed <w>snik</w> was toen hij zijn baan opzegde.",
                            "target_lang_translations": {
                                "fr": "Tout le monde pensait qu'il n'avait <w>pas toute sa tête</w> quand il a démissionné de son travail."
                            }
                        }
                    ],
                    "synonyms": [
                        "snugger"
                    ],
                    "common_phrases": [
                        "niet goed snik"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informele vaste uitdrukking"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Dans son bon sens ou lucide (presque exclusivement employé dans la locution négative 'niet goed snik' : fou, pas net)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "dans son bon sens",
                                "target_lang_sense_clarification": "souvent précédé de la négation : pas net, pas toute sa tête"
                            },
                            {
                                "target_lang_word": "timbré",
                                "target_lang_sense_clarification": "pour traduire l'expression 'niet goed snik'"
                            },
                            {
                                "target_lang_word": "cinglé",
                                "target_lang_sense_clarification": "familier, pour 'niet goed snik'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c707be2-0bcd-3b5c-82b3-8b2db4b9c07e",
                    "sense_definition": "zeer heet en benauwend",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "temperatuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was die middag zo <w>snik</w> dat niemand naar buiten wilde gaan.",
                            "target_lang_translations": {
                                "fr": "Il faisait tellement <w>étouffant</w> cet après-midi-là que personne ne voulait sortir."
                            }
                        },
                        {
                            "text": "In de kleine zolderkamer voelde de lucht drukkend en <w>snik</w> aan.",
                            "target_lang_translations": {
                                "fr": "Dans la petite mansarde, l'air semblait lourd et <w>suffoquant</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "snikheet",
                        "benauwd"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "voornamelijk dialectaal of verouderd, vaker als snikheet"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Très chaud et étouffant, lourd."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "étouffant",
                                "target_lang_sense_clarification": "chaleur accablante et lourde"
                            },
                            {
                                "target_lang_word": "suffoquant",
                                "target_lang_sense_clarification": "chaleur très pesante"
                            },
                            {
                                "target_lang_word": "très lourd",
                                "target_lang_sense_clarification": "à propos du temps ou de l'air"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1d87e72e-9d61-38de-9fc3-b7b07ca45836",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>snikken</w>",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "vorm_snikken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als ik aan het verlies denk, <w>snik</w> ik van verdriet.",
                            "target_lang_translations": {
                                "fr": "Quand je pense à cette perte, je <w>sanglote</w> de chagrin."
                            }
                        },
                        {
                            "text": "Ik <w>snik</w> zachtjes in mijn kussen om niemand wakker te maken.",
                            "target_lang_translations": {
                                "fr": "Je <w>sanglote</w> doucement dans mon oreiller pour ne réveiller personne."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "persoonsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Première personne du singulier du présent de l'indicatif du verbe 'snikken' (sangloter)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "sanglote",
                                "target_lang_sense_clarification": "1re personne du singulier de 'sangloter'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61f5c481-0ce8-3263-8a6a-920168a5e372",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd (bij inversie) van <w>snikken</w>",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "vorm_snikken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>snik</w> je zo hard na het telefoongesprek?",
                            "target_lang_translations": {
                                "fr": "Pourquoi <w>sanglotes</w>-tu si fort après cet appel téléphonique ?"
                            }
                        },
                        {
                            "text": "<w>Snik</w> je van opluchting of is er iets ergs gebeurd?",
                            "target_lang_translations": {
                                "fr": "<w>Sanglotes</w>-tu de soulagement ou s'est-il passé quelque chose de grave ?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "persoonsvorm bij inversie"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Deuxième personne du singulier du présent de l'indicatif (lors d'une inversion) du verbe 'snikken'."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "sanglotes",
                                "target_lang_sense_clarification": "2e personne du singulier de 'sangloter'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b9c0cad-3b21-3759-aee4-4805518d2d14",
                    "sense_definition": "gebiedende wijs van <w>snikken</w>",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vorm_snikken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Snik</w> maar even uit, dat zal je vast wat opluchting geven.",
                            "target_lang_translations": {
                                "fr": "<w>Sanglote</w> un bon coup, cela te soulagera sûrement."
                            }
                        },
                        {
                            "text": "<w>Snik</w> niet zo luid, want de buren kunnen je horen.",
                            "target_lang_translations": {
                                "fr": "Ne <w>sanglote</w> pas si fort, car les voisins risquent de t'entendre."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperatief"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Impératif du verbe 'snikken' (sangloter)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "sanglote",
                                "target_lang_sense_clarification": "impératif singulier de 'sangloter'"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}