                ],
                "translations": [
                    {
                        "translation_id": "5db5a188-cd4a-49c4-95e9-535e7a3bd1da",
                        "source_entry_id": "8033136b-718b-3055-b6f6-04b24585fb2a",
                        "source_sense_id": "76722856-53f9-3fee-8afc-359aaeeb2149",
                        "target_lang_word": "Tollwut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tollwut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f74534f-d966-36ac-b10c-17a91749da94",
                                        "entry_id": "2bf9ff26-b660-33b3-a3d0-7b6bdcfb777a",
                                        "glosses": [
                                            "eine hochgefährliche, meist tödlich endende Virusinfektion, die zum Beispiel durch einen Biss von Tieren (Hund, Fuchs) auch auf den Menschen übertragen werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69feb22d-da93-444f-bc89-9caa3586917f",
                                                "sense_id": "7f74534f-d966-36ac-b10c-17a91749da94",
                                                "text": "Die Tollwut kann bei Organtransplantationen von Mensch zu Mensch übertragen werden."
                                            },
                                            {
                                                "example_id": "2203d806-5e68-4db0-8bbb-7c30fd3f2279",
                                                "sense_id": "7f74534f-d966-36ac-b10c-17a91749da94",
                                                "text": "Lass den Hund besser nicht von der Leine, in diesem Gebiet hier soll Tollwut aufgetreten sein."
                                            },
                                            {
                                                "example_id": "842b2c68-698c-493f-8a46-6ff8cd9d9d07",
                                                "sense_id": "7f74534f-d966-36ac-b10c-17a91749da94",
                                                "text": "„Beide Male musste ich ins Krankenhaus, bekam scheußliche Spritzen gegen Tetanus, Tollwut oder weiß der Teufel was für Krankheiten.“"
                                            },
                                            {
                                                "example_id": "0df3636b-22b4-45ec-a38a-eec25806c8e0",
                                                "sense_id": "7f74534f-d966-36ac-b10c-17a91749da94",
                                                "text": "„Frau Katzer warnte uns vor Tieren mit Tollwut.“"
                                            },
                                            {
                                                "example_id": "afeff288-6f29-4374-8810-2b34e06e7037",
                                                "sense_id": "7f74534f-d966-36ac-b10c-17a91749da94",
                                                "text": "„Der ›Veitstanz‹, wie die Anfälle bei Epilepsie und Tollwut unterschiedslos genannt wurden, hat seinen Namen von ihm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3814d296-4525-427d-9c69-251b465a477d",
                        "source_entry_id": "8033136b-718b-3055-b6f6-04b24585fb2a",
                        "source_sense_id": "76722856-53f9-3fee-8afc-359aaeeb2149",
                        "target_lang_word": "rabies",
