{
    "word_family": [
        "obtusely",
        "obtuseness",
        "obtusity"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "141f137b-4d2d-387b-bfbe-3a2974cdfb6f",
                    "sense_definition": "Lacking intelligence or quickness of understanding; slow to grasp meaning.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "intellectual_dullness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was too <w>obtuse</w> to realize that his constant complaining was annoying everyone around him.",
                            "target_lang_translations": {
                                "ru": "Он был слишком <w>туп</w>, чтобы понять, что его постоянные жалобы раздражали всех вокруг."
                            }
                        },
                        {
                            "text": "It would be <w>obtuse</w> to ignore the obvious signs that the project is failing.",
                            "target_lang_translations": {
                                "ru": "Было бы <w>глупо</w> игнорировать очевидные признаки провала проекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "dense",
                        "dim",
                        "dim-witted",
                        "thick",
                        "dull"
                    ],
                    "antonyms": [
                        "bright",
                        "intelligent",
                        "on the ball",
                        "quick off the mark",
                        "quick-witted",
                        "sharp",
                        "smart"
                    ],
                    "common_phrases": [
                        "remarkably obtuse",
                        "deliberately obtuse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Недостаточно сообразительный или медленно понимающий суть вещей; бестолковый или глуповатый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тупой",
                                "target_lang_sense_clarification": "не сообразительный, глупый"
                            },
                            {
                                "target_lang_word": "недалёкий",
                                "target_lang_sense_clarification": "ограниченный умом"
                            },
                            {
                                "target_lang_word": "несообразительный",
                                "target_lang_sense_clarification": "медленно понимающий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8caa124e-1bbd-3a39-8774-bcf46e962232",
                    "sense_definition": "Describing an angle greater than 90 degrees and less than 180 degrees.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The triangle has one <w>obtuse</w> angle, making it an obtuse triangle.",
                            "target_lang_translations": {
                                "ru": "У треугольника один <w>тупой</w> угол, что делает его тупоугольным."
                            }
                        },
                        {
                            "text": "Measure the corner carefully to see if it is an <w>obtuse</w> angle.",
                            "target_lang_translations": {
                                "ru": "Внимательно измерьте угол, чтобы проверить, является ли он <w>тупым</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "obtuse-angled"
                    ],
                    "antonyms": [
                        "acute"
                    ],
                    "common_phrases": [
                        "obtuse angle",
                        "obtuse triangle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обозначает угол величиной более 90 и менее 180 градусов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тупой",
                                "target_lang_sense_clarification": "в геометрии, об угле или треугольнике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24887ee9-7480-35c7-9bbf-e61f34011c24",
                    "sense_definition": "Not sharp or pointed; having a blunt edge or end.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tool has an <w>obtuse</w> tip that is safer for children to use.",
                            "target_lang_translations": {
                                "ru": "У этого инструмента <w>тупой</w> наконечник, более безопасный для детей."
                            }
                        },
                        {
                            "text": "The <w>obtuse</w> edge of the blade could not cut through the thick rope.",
                            "target_lang_translations": {
                                "ru": "<w>Тупое</w> лезвие не смогло перерезать толстую верёвку."
                            }
                        }
                    ],
                    "synonyms": [
                        "blunt",
                        "dull"
                    ],
                    "antonyms": [
                        "sharp",
                        "pointed"
                    ],
                    "common_phrases": [
                        "obtuse point",
                        "obtuse edge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не острый, не заострённый; имеющий скруглённый или затупленный край либо конец."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тупой",
                                "target_lang_sense_clarification": "не острый"
                            },
                            {
                                "target_lang_word": "притуплённый",
                                "target_lang_sense_clarification": "со сглаженным острием"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa37d384-e9c0-3ab5-90dd-576d813480d2",
                    "sense_definition": "Describing a sound that is muffled or not clear.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thick walls produced an <w>obtuse</w> sound that was hard to identify.",
                            "target_lang_translations": {
                                "ru": "Толстые стены издавали <w>глухой</w> звук, источник которого было трудно определить."
                            }
                        },
                        {
                            "text": "He described the <w>obtuse</w> noise as a distant thud behind the door.",
                            "target_lang_translations": {
                                "ru": "Он описал этот <w>приглушённый</w> шум как далёкий глухой удар за дверью."
                            }
                        }
                    ],
                    "synonyms": [
                        "deadened",
                        "muffled",
                        "dull"
                    ],
                    "antonyms": [
                        "clear",
                        "sharp"
                    ],
                    "target_lang_definitions": {
                        "ru": "О звуке: глухой, неясный или приглушённый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глухой",
                                "target_lang_sense_clarification": "о незвонком звуке"
                            },
                            {
                                "target_lang_word": "приглушённый",
                                "target_lang_sense_clarification": "о тихом, нечётком звуке"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "09c6f371-9311-362a-b53b-c59507f89914",
                    "sense_definition": "To make something less intense, sensitive, or sharp.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dull",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medication helped to <w>obtuse</w> the sharp pain in his leg.",
                            "target_lang_translations": {
                                "ru": "Лекарство помогло <w>притупить</w> острую боль в ноге."
                            }
                        },
                        {
                            "text": "Constant exposure to loud noise can <w>obtuse</w> one's hearing over time.",
                            "target_lang_translations": {
                                "ru": "Постоянное воздействие громкого шума может со временем <w>ослабить</w> слух."
                            }
                        }
                    ],
                    "synonyms": [
                        "dull"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо менее интенсивным, чувствительным или острым; притуплять."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "притуплять",
                                "target_lang_sense_clarification": "чувства, боль или остроту"
                            },
                            {
                                "target_lang_word": "ослаблять",
                                "target_lang_sense_clarification": "делать менее выраженным"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}