                ],
                "senses": [
                    {
                        "sense_id": "577824c7-a1cf-3f1e-a746-d3c9b4dec300",
                        "entry_id": "cdf8a46e-111e-3ea6-adcd-365b677a2fb2",
                        "glosses": [
                            "iemand die houtskool maakt door onder uitsluiting van zuurstof hout te verhitten"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "6d22125f-40cd-44cc-9b81-4051bbd388d4",
                                "sense_id": "577824c7-a1cf-3f1e-a746-d3c9b4dec300",
                                "text": "En daar, kun je je voorstellen, stond dan zo'n kolenbrander uit het bos met een levend berenjong, of een opzichter uit een ver perceel met een ertsmonster."
                            }
                        ]
                    },
                    {
                        "sense_id": "0366e3c2-37e3-3d55-84ab-448ff218727a",
                        "entry_id": "cdf8a46e-111e-3ea6-adcd-365b677a2fb2",
                        "glosses": [
                            "bedrijf dat steenkolen verbrandt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54301ab2-10a8-4d41-b143-3c59d42019c4",
                                "sense_id": "0366e3c2-37e3-3d55-84ab-448ff218727a",
                                "text": "„De elektriciens kopen massaal houtpellets op”, zegt Ide. Zo worden de prijzen van hout drastisch de hoogte ingejaagd. Spano heeft behoefte aan 400.000 ton hout per jaar, maar als Awyrs (Luik) als kolenbrander overschakelt op hout, heeft het evenveel hout nodig als Spano verbruikt. Dat zorgt voor enorme druk op de markt en drijft de houtsector in het nauw."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e10a9455-e478-4f19-b166-d43f0245d1cd",
                        "source_entry_id": "cdf8a46e-111e-3ea6-adcd-365b677a2fb2",
