                                        "sense_id": "987dacc9-8803-38f2-8462-bf4f325f058a",
                                        "entry_id": "f42d7d6c-0f3f-34f5-b87d-7cae79015ff6",
                                        "glosses": [
                                            "zum Knöpfen bestimmte Öffnung in zum Beispiel Stoff oder Leder von Kleidungsstücken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "634b4c5d-1965-4f88-ae87-ffdc11bfe8d7",
                                                "sense_id": "987dacc9-8803-38f2-8462-bf4f325f058a",
                                                "text": "Das Knopfloch ist zu eng, daher das Zuknöpfen zu schwer."
                                            },
                                            {
                                                "example_id": "2fd01673-2e0d-4b90-95a8-26e444ba61e8",
                                                "sense_id": "987dacc9-8803-38f2-8462-bf4f325f058a",
                                                "text": "„Er war außerordentlich reinlich. Sein Knopfloch war stets von einem Strauß von stark duftenden Blumen geschmückt, z. B. Tuberosen, Narzissen und spanischem Jasmin.“"
                                            },
                                            {
                                                "example_id": "8472308c-3b1d-44a2-8ac3-79a73fce05f2",
                                                "sense_id": "987dacc9-8803-38f2-8462-bf4f325f058a",
                                                "text": "„Am kleinen Finger der Linken, über dem weißen Handschuh, trug er einen Siegelring und im Knopfloch eine Orchidee.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0a244b1e-2205-39c6-bba0-4f9a33412f72",
                                        "entry_id": "f42d7d6c-0f3f-34f5-b87d-7cae79015ff6",
                                        "glosses": [
                                            "englischer Country Dance, mit dem Zuknöpfen ähnlicher Schlussfigur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "273b5989-3956-48eb-b6a6-a5926d8db3ea",
                                                "sense_id": "0a244b1e-2205-39c6-bba0-4f9a33412f72",
                                                "text": "Beim Volkstanzfest wurde auch das Knopfloch getanzt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
