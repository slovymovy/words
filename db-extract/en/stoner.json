                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b6116e95-b96e-3809-80db-e3ec713f207f",
                        "entry_id": "a5ca5b28-6778-36c5-a9e0-5b4cd4be06f9",
                        "glosses": [
                            "A habitual user of cannabis."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "8bf4e5e3-53d6-41df-832c-0ae880547656",
                                "sense_id": "b6116e95-b96e-3809-80db-e3ec713f207f",
                                "text": "\"You're useless when you're high on catnip, you know that?\" \"Mewww mew?\" \"No I will NOT put on Dark Side of the Moon and the Wizard of Oz for you. Goddamned stoner cat.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "5a92cd0f-cc9e-35a5-8fa5-9f20568aed5b",
                        "entry_id": "a5ca5b28-6778-36c5-a9e0-5b4cd4be06f9",
                        "glosses": [
                            "Someone or something that weighs a certain number of stones."
                        ],
                        "tags": [
                            "in-compounds"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35b8ae92-d6cd-4dbf-960f-756f1222f51e",
                        "source_entry_id": "a5ca5b28-6778-36c5-a9e0-5b4cd4be06f9",
                        "source_sense_description": "a habitual user of cannabis",
                        "target_lang_word": "Kiffer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kiffer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7428988-f56c-3f69-98e0-af9c5051a126",
                                        "entry_id": "d8dfb52f-5e42-395b-a76d-609a13ea246b",
                                        "glosses": [
                                            "jemand, der Marihuana oder Haschisch (stets) raucht"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9843b6e0-8c27-4038-a65f-18bb80f8c84a",
                                                "sense_id": "c7428988-f56c-3f69-98e0-af9c5051a126",
                                                "text": "„Bier macht dick, Schnaps macht krank, ich bin Kiffer, Gott sei Dank!“ (Graffiti)"
                                            },
                                            {
                                                "example_id": "e2f2522d-2d0c-4142-b89b-1212a4e50fb7",
                                                "sense_id": "c7428988-f56c-3f69-98e0-af9c5051a126",
                                                "text": "„Dabei schnitten die Kiffer in allen drei Tests umso schlechter ab, je mehr Tüten sie sich in ihrem bisherigen Leben reingezogen hatten, und zwar auch dann noch, wenn sie mittlerweile auf Cannabis verzichteten.“"
                                            },
                                            {
                                                "example_id": "3950753f-a8cc-430d-bbba-90b66b4b7afd",
                                                "sense_id": "c7428988-f56c-3f69-98e0-af9c5051a126",
                                                "text": "„Bisher müssen ‚Kiffer‘, wie die Konsumenten von Cannabis gerne genannt werden, ihren Gebrauch überwiegend unter dem Radar ausleben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1482a9bf-afcd-4b74-bae8-d650f6a466a4",
                        "source_entry_id": "a5ca5b28-6778-36c5-a9e0-5b4cd4be06f9",
