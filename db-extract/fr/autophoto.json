                "senses": [
                    {
                        "sense_id": "bd54e18a-7fe1-3285-89a2-fc1441c307ac",
                        "entry_id": "68bef81a-12c5-302a-8dd5-7a8e0af408b3",
                        "glosses": [
                            "Autoportrait fait à l’aide d’un appareil photo ou d’un photophone, en général pour le publier sur un réseau social."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "01c3a6a2-8095-4f76-afff-6936261fd5fc",
                                "sense_id": "bd54e18a-7fe1-3285-89a2-fc1441c307ac",
                                "text": "La scène, qui aurait été prise au Pérou, nous montre le Saskatchewanais prenant une autophoto."
                            },
                            {
                                "example_id": "87e69618-f901-441d-a372-3ef8f79cacab",
                                "sense_id": "bd54e18a-7fe1-3285-89a2-fc1441c307ac",
                                "text": "Beaucoup d’Internautes ont tenu à relativiser l’autophoto des trois dirigeants, qui ont laissé de côté le ton solennel généralement de mise lors de cérémonies funéraires, le temps d’un cliché."
                            }
                        ]
                    }
