                ],
                "senses": [
                    {
                        "sense_id": "ba61509e-a957-38b2-b823-5c65920f4e09",
                        "entry_id": "c2192ba7-5466-3fe6-a8b3-30fe6b433486",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b132648f-1121-4085-bf85-93ff9a779717",
                                "sense_id": "ba61509e-a957-38b2-b823-5c65920f4e09",
                                "text": "Frau Gansert ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "db273952-9fe1-4f27-b7e1-097ca6f158af",
                                "sense_id": "ba61509e-a957-38b2-b823-5c65920f4e09",
                                "text": "Herr Gansert wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a530628b-18e2-41bb-ba21-35c6733e5839",
                                "sense_id": "ba61509e-a957-38b2-b823-5c65920f4e09",
                                "text": "Die Ganserts fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "00398fc8-63f6-4cdd-ab86-26d5ae5320a4",
                                "sense_id": "ba61509e-a957-38b2-b823-5c65920f4e09",
                                "text": "Der Gansert trägt nie die Pullover, die die Gansert ihm strickt."
                            },
                            {
                                "example_id": "db8f0abf-b19a-4347-a5c4-3d91dfc0c471",
                                "sense_id": "ba61509e-a957-38b2-b823-5c65920f4e09",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gansert kommt, geht der Herr Gansert.“"
                            },
                            {
                                "example_id": "b2de3d88-1c65-483e-aec7-8093ae7ebe4a",
                                "sense_id": "ba61509e-a957-38b2-b823-5c65920f4e09",
                                "text": "Gansert kommt und geht."
                            },
                            {
                                "example_id": "914555f7-3779-4e2d-8fe4-84788e49117c",
                                "sense_id": "ba61509e-a957-38b2-b823-5c65920f4e09",
                                "text": "Ganserts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
