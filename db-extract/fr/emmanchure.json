        "fr-extract.jsonl": [
            {
                "entry_id": "79af6464-2b35-3cd8-ad01-c74003921f29",
                "word": "emmanchure",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "78ba94e0-eedf-46fc-9d52-95d887753230",
                        "entry_id": "79af6464-2b35-3cd8-ad01-c74003921f29",
                        "tags": [
                            "plural"
                        ],
                        "form": "emmanchures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fa199989-42b5-344a-9d93-7e1332ba2e0f",
                        "entry_id": "79af6464-2b35-3cd8-ad01-c74003921f29",
                        "glosses": [
                            "Chacune des deux ouvertures d’un vêtement, d’une robe, d’une chemise, etc., à laquelle on adapte les manches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c06469a-5ed6-464a-b4a3-f9c14fb4d0fb",
                                "sense_id": "fa199989-42b5-344a-9d93-7e1332ba2e0f",
                                "text": "On partage la manche en deux parties égales ainsi que l’emmanchure ; on attache la couture qui joint la manche au bas de l’emmanchure et à 1 ou 2 centimètres en avant de la couture piquée, laquelle joint le petit côté au devant du corsage."
                            },
                            {
                                "example_id": "34e027b1-ca86-444f-a60c-ce547d3822b7",
                                "sense_id": "fa199989-42b5-344a-9d93-7e1332ba2e0f",
                                "text": "Le vent qui soufflait plus âpre et plus rude nous collait nos vêtements sur le corps : il nous frappait heureusement dans le dos, mais comme l’emmanchure de ma veste était décousue, il entrait par ce trou et me glissait le long du bras, ce qui était loin de me réchauffer."
                            },
                            {
                                "example_id": "49736451-e9ed-4930-8f38-993585097a09",
                                "sense_id": "fa199989-42b5-344a-9d93-7e1332ba2e0f",
                                "text": "Elle a des gestes brusques pour étreindre la chatte et, en avant de la rumeur feutrée du marché, on entend la soie qui craque aux emmanchures."
                            },
                            {
                                "example_id": "bcb71e29-e645-4a97-a559-fd4c812e53c9",
                                "sense_id": "fa199989-42b5-344a-9d93-7e1332ba2e0f",
                                "text": "La jeannette est une petite planche qui permet un repassage minutieux des emmanchures, des manches et des poignets."
                            },
                            {
                                "example_id": "8ca1cb29-0352-4fc2-aa78-5d35bea8dc37",
                                "sense_id": "fa199989-42b5-344a-9d93-7e1332ba2e0f",
                                "text": "Parfois, Douce essuyait son visage d’un revers de la main, ou replaçait une mèche rebelle sur son front. Par l’emmanchure de son corsage, Gabriel entrevoyait alors la naissance de ses seins, et son désir se faisait plus fort. Incontrôlable."
                            },
                            {
                                "example_id": "35320e53-c6e4-4d62-a053-4890a44e20b5",
                                "sense_id": "fa199989-42b5-344a-9d93-7e1332ba2e0f",
                                "text": "Les emmanchures d’un habit."
                            },
                            {
                                "example_id": "9dad3ed0-f474-49cf-8f56-a888bab2e5e5",
                                "sense_id": "fa199989-42b5-344a-9d93-7e1332ba2e0f",
                                "text": "Cette emmanchure est trop étroite, est trop large."
                            },
                            {
                                "example_id": "cba9f200-529b-49c2-90d3-7f178f1b1e75",
                                "sense_id": "fa199989-42b5-344a-9d93-7e1332ba2e0f",
                                "text": "Cette robe me gêne aux emmanchures, à l’emmanchure."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
