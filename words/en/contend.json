{
    "word_family": [
        "contender",
        "contention",
        "contentious"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8a523a28-7eb5-34c3-b15b-c4ff12e23e1e",
                    "sense_definition": "To state or assert a position strongly as part of an argument.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "argumentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defense lawyers <w>contend</w> that their client was not even in the city when the crime occurred.",
                            "target_lang_translations": {
                                "ru": "Адвокаты защиты <w>утверждают</w>, что их подзащитного даже не было в городе, когда произошло преступление.",
                                "zh": "辩护律师<w>主张</w>，案发时他们的当事人甚至不在城里。",
                                "de": "Die Verteidiger <w>behaupten</w>, dass ihr Mandant nicht einmal in der Stadt war, als das Verbrechen geschah."
                            }
                        },
                        {
                            "text": "Many critics <w>contend</w> that the new policy will actually increase costs rather than reduce them.",
                            "target_lang_translations": {
                                "ru": "Многие критики <w>заявляют</w>, что новая политика на самом деле приведет к росту расходов, а не к их сокращению.",
                                "zh": "许多评论家<w>声称</w>，这项新政策实际上会增加成本，而不是减少成本。",
                                "de": "Viele Kritiker <w>vertreten die Ansicht</w>, dass die neue Politik die Kosten eher erhöhen als senken wird."
                            }
                        }
                    ],
                    "synonyms": [
                        "assert",
                        "aver",
                        "dispute"
                    ],
                    "antonyms": [
                        "concede",
                        "deny"
                    ],
                    "common_phrases": [
                        "contend that"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердо заявлять или отстаивать свою позицию в рамках спора или аргументации.",
                        "zh": "在争论或论证中坚定地陈述或主张某种立场。",
                        "de": "Eine Position im Rahmen einer Argumentation nachdrücklich vertreten oder behaupten."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утверждать",
                                "target_lang_sense_clarification": "уверенно высказывать мнение"
                            },
                            {
                                "target_lang_word": "заявлять",
                                "target_lang_sense_clarification": "официально или открыто высказывать позицию"
                            },
                            {
                                "target_lang_word": "настаивать",
                                "target_lang_sense_clarification": "упорно доказывать свою правоту"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主张",
                                "target_lang_sense_clarification": "坚定地提出某种观点或立场"
                            },
                            {
                                "target_lang_word": "声称",
                                "target_lang_sense_clarification": "公开或正式地宣称某事"
                            },
                            {
                                "target_lang_word": "坚持认为",
                                "target_lang_sense_clarification": "固执地持有某种看法"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "behaupten",
                                "target_lang_sense_clarification": "etwas als wahr darstellen"
                            },
                            {
                                "target_lang_word": "die Ansicht vertreten",
                                "target_lang_sense_clarification": "eine Meinung offiziell äußern"
                            },
                            {
                                "target_lang_word": "vorbringen",
                                "target_lang_sense_clarification": "ein Argument oder eine Begründung anführen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2ae4876-ecbe-3ce0-a284-1002519b39c3",
                    "sense_definition": "To struggle to surmount or deal with a difficulty or obstacle.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "struggle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rescue team had to <w>contend</w> with freezing temperatures and heavy snow throughout the night.",
                            "target_lang_translations": {
                                "ru": "Спасателям пришлось <w>бороться</w> с минусовой температурой и сильным снегопадом на протяжении всей ночи.",
                                "zh": "救援队整晚都必须<w>应对</w>严寒的气温和大雪。",
                                "de": "Das Rettungsteam musste die ganze Nacht mit eisigen Temperaturen und starkem Schneefall <w>kämpfen</w>."
                            }
                        },
                        {
                            "text": "Small businesses often have to <w>contend</w> with many challenges during their first year of operation.",
                            "target_lang_translations": {
                                "ru": "Малому бизнесу часто приходится <w>справляться</w> со множеством трудностей в течение первого года работы.",
                                "zh": "小企业在运营的第一年通常必须<w>克服</w>许多挑战。",
                                "de": "Kleine Unternehmen müssen im ersten Jahr oft mit vielen Herausforderungen <w>ringen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "struggle",
                        "strive"
                    ],
                    "antonyms": [
                        "surrender",
                        "yield"
                    ],
                    "common_phrases": [
                        "contend with challenges",
                        "contend with difficulties"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прилагать усилия для преодоления трудностей или решения проблем.",
                        "zh": "努力克服困难或应对障碍。",
                        "de": "Sich anstrengen, um eine Schwierigkeit oder ein Hindernis zu überwinden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бороться",
                                "target_lang_sense_clarification": "противостоять трудностям или обстоятельствам"
                            },
                            {
                                "target_lang_word": "справляться",
                                "target_lang_sense_clarification": "преодолевать препятствия"
                            },
                            {
                                "target_lang_word": "сталкиваться",
                                "target_lang_sense_clarification": "иметь дело с проблемами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "应对",
                                "target_lang_sense_clarification": "处理或解决困难局面"
                            },
                            {
                                "target_lang_word": "抗衡",
                                "target_lang_sense_clarification": "与不利因素进行对抗"
                            },
                            {
                                "target_lang_word": "克服",
                                "target_lang_sense_clarification": "战胜困难或障碍"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "kämpfen mit",
                                "target_lang_sense_clarification": "sich einer schwierigen Situation stellen"
                            },
                            {
                                "target_lang_word": "ringen mit",
                                "target_lang_sense_clarification": "sich intensiv mit einem Problem auseinandersetzen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33196e38-a400-31e6-b76d-d69e6b288aaf",
                    "sense_definition": "To compete with others in a struggle for power or victory.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Three main candidates will <w>contend</w> for the leadership of the party in the upcoming election.",
                            "target_lang_translations": {
                                "ru": "Три основных кандидата будут <w>бороться</w> за лидерство в партии на предстоящих выборах.",
                                "zh": "三位主要候选人将在即将到来的选举中<w>角逐</w>党内领导权。",
                                "de": "Drei Hauptkandidaten werden bei der kommenden Wahl um die Parteiführung <w>kämpfen</w>."
                            }
                        },
                        {
                            "text": "The two athletes will <w>contend</w> for the gold medal in the final race tomorrow.",
                            "target_lang_translations": {
                                "ru": "Завтра в финальном забеге два атлета будут <w>соперничать</w> за золотую медаль.",
                                "zh": "这两名运动员明天将在决赛中<w>争夺</w>金牌。",
                                "de": "Die beiden Athleten werden morgen im Finalrennen um die Goldmedaille <w>ringen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vie",
                        "contest",
                        "fight",
                        "combat"
                    ],
                    "antonyms": [
                        "cooperate",
                        "collaborate"
                    ],
                    "common_phrases": [
                        "contend for power",
                        "contend for the title"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соревноваться с другими в борьбе за власть, победу или награду.",
                        "zh": "在权力或胜利的争夺中与他人竞争。",
                        "de": "Mit anderen um Macht, einen Sieg oder eine Auszeichnung konkurrieren."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соперничать",
                                "target_lang_sense_clarification": "быть конкурентом в борьбе за что-либо"
                            },
                            {
                                "target_lang_word": "бороться",
                                "target_lang_sense_clarification": "активно состязаться за победу"
                            },
                            {
                                "target_lang_word": "претендовать",
                                "target_lang_sense_clarification": "заявлять права на победу или титул"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "竞争",
                                "target_lang_sense_clarification": "为了某种目标而与他人较量"
                            },
                            {
                                "target_lang_word": "角逐",
                                "target_lang_sense_clarification": "在竞赛或权力斗争中争夺"
                            },
                            {
                                "target_lang_word": "争夺",
                                "target_lang_sense_clarification": "力求获得某物或某种地位"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "kämpfen um",
                                "target_lang_sense_clarification": "sich um ein Ziel oder einen Titel bemühen"
                            },
                            {
                                "target_lang_word": "ringen um",
                                "target_lang_sense_clarification": "hartnäckig um etwas konkurrieren"
                            },
                            {
                                "target_lang_word": "konkurrieren",
                                "target_lang_sense_clarification": "im Wettbewerb mit anderen stehen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f474fca1-82e0-368a-9940-1a3c1eaee9e2",
                    "sense_definition": "To engage in a heated debate or verbal dispute.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "argumentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scholars continue to <w>contend</w> about the true meaning of the ancient text.",
                            "target_lang_translations": {
                                "ru": "Ученые продолжают <w>спорить</w> об истинном значении древнего текста.",
                                "zh": "学者们继续就这部古籍的真实含义进行<w>争论</w>。",
                                "de": "Die Gelehrten <w>streiten</w> weiterhin über die wahre Bedeutung des antiken Textes."
                            }
                        },
                        {
                            "text": "It is useless to <w>contend</w> about such trivial matters when we have more important work to do.",
                            "target_lang_translations": {
                                "ru": "Бесполезно <w>препираться</w> по таким пустякам, когда у нас есть более важная работа.",
                                "zh": "当我们有更重要的工作要做时，为这些琐事<w>争执</w>是毫无意义的。",
                                "de": "Es ist nutzlos, über solche trivialen Dinge zu <w>streiten</w>, wenn wir wichtigere Arbeit zu erledigen haben."
                            }
                        }
                    ],
                    "synonyms": [
                        "dispute",
                        "debate",
                        "litigate"
                    ],
                    "antonyms": [
                        "agree",
                        "concur"
                    ],
                    "common_phrases": [
                        "contend about"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участвовать в жаркой дискуссии или словесном споре.",
                        "zh": "参与激烈的辩论或口头争执。",
                        "de": "Sich in einer hitzigen Debatte oder einem verbalen Streit befinden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спорить",
                                "target_lang_sense_clarification": "вести дискуссию или дебаты"
                            },
                            {
                                "target_lang_word": "дискутировать",
                                "target_lang_sense_clarification": "обсуждать спорный вопрос"
                            },
                            {
                                "target_lang_word": "препираться",
                                "target_lang_sense_clarification": "спорить по пустякам"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "争论",
                                "target_lang_sense_clarification": "就某事进行辩论或意见交换"
                            },
                            {
                                "target_lang_word": "辩驳",
                                "target_lang_sense_clarification": "通过辩论来反驳对方"
                            },
                            {
                                "target_lang_word": "争执",
                                "target_lang_sense_clarification": "因意见不合而发生口角"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "streiten",
                                "target_lang_sense_clarification": "eine verbale Auseinandersetzung führen"
                            },
                            {
                                "target_lang_word": "argumentieren",
                                "target_lang_sense_clarification": "sich in einer Diskussion gegenseitig mit Argumenten begegnen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}