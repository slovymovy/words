                    {
                        "sense_id": "986c63be-ab47-35b2-bd68-3c03754ba656",
                        "entry_id": "d4ab1d95-4c62-3554-ab56-781d59804d72",
                        "glosses": [
                            "A person who writes a new law."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6b17ac7c-2d86-3900-9d70-6634e590de09",
                        "entry_id": "d4ab1d95-4c62-3554-ab56-781d59804d72",
                        "glosses": [
                            "A person who writes a new law.",
                            "Any of the delegates to the Constitutional Convention that drafted the United States Constitution and the Bill of Rights."
                        ],
                        "tags": [
                            "US",
                            "capitalized",
                            "historical",
                            "plural-normally",
                            "sometimes"
                        ],
                        "examples": [
                            {
                                "example_id": "85ca3ab8-127d-445a-906e-a58ba3e0332e",
                                "sense_id": "6b17ac7c-2d86-3900-9d70-6634e590de09",
                                "text": "the Framers of the Constitution"
                            },
                            {
                                "example_id": "3abcfeab-346d-43ff-8bc3-8959fc6682e4",
                                "sense_id": "6b17ac7c-2d86-3900-9d70-6634e590de09",
                                "text": "In a real sense, US democracy has died this month. It doesn’t mean it’s dead for the long term but at this moment the idea of an accountable representative system, as the framers of the constitution wrote it, is no longer present."
                            }
                        ]
                    },
                    {
                        "sense_id": "964adc02-c058-3666-9ef0-e4956eb2b4f9",
                        "entry_id": "d4ab1d95-4c62-3554-ab56-781d59804d72",
                        "glosses": [
                            "A person who frames another, attempting to have them convicted of a crime they did not commit."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "40e336e9-0789-3be5-8900-a1050898392f",
                        "entry_id": "d4ab1d95-4c62-3554-ab56-781d59804d72",
                        "glosses": [
                            "A person who embeds another person's web pages in an HTML frame, so that they misleadingly appear to be part of the framing site."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "cfc85166-7d76-4a8e-9d3a-7ac6cf81de9b",
                                "sense_id": "40e336e9-0789-3be5-8900-a1050898392f",
                                "text": "The Los Angeles Times is also policing Web sites that frame its site without permission. As of November 1997, the Times had threatened to send cease and desist letters to unlicensed framers."
                            }
                        ]
                    }
                ],
