                                "sense_id": "2b288d26-ba7f-3bbe-a19b-799aa346c69f",
                                "text": "Pitch contour: mid-rising [lɑ(ː)˧˦]"
                            },
                            {
                                "example_id": "6ab97e07-91db-47fa-85d0-39253a077426",
                                "sense_id": "2b288d26-ba7f-3bbe-a19b-799aa346c69f",
                                "text": "Oh wait it’s not today, lah. It’s on Sunday."
                            }
                        ]
