                        "glosses": [
                            "Action de fureter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e75ec5a-0d27-4368-ba14-5e81d6f24ac4",
                                "sense_id": "60fcb663-86a2-3e71-ade3-7266e9896727",
                                "text": "Un furetage silencieux des poches et des armoires, où pouvaient traîner des lettres."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba11b6f4-70b4-3ae6-a729-702b683bef5b",
                        "entry_id": "6aee0ce3-a93c-3678-a416-e1e47f1d7e96",
                        "glosses": [
                            "Exploitation des plus gros brins d’un taillis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5f6ca56-7e80-497e-af32-944e79b29022",
                                "sense_id": "ba11b6f4-70b4-3ae6-a729-702b683bef5b",
                                "text": "Pour pallier cet inconvénient, dans les régions de montagne où le hêtre est la seule essence susceptible de fournir du bois de feu intéressant, les habitants ont développé la technique du « furetage »."
                            },
                            {
                                "example_id": "c002e56c-0cb6-4a84-8522-b2849ffb765c",
                                "sense_id": "ba11b6f4-70b4-3ae6-a729-702b683bef5b",
                                "text": "Il s’agira plutôt d’éclaircies au profit exclusif des arbres objectif, accompagnés d’un furetage dans le taillis, si besoin (afin de limiter la remontée du sous-étage risquant de faire mourir les grosses branches basses des houppiers)."
                            }
                        ]
                    }
