                "senses": [
                    {
                        "sense_id": "c74ca9cc-e811-3454-b4af-b2e4569669d5",
                        "entry_id": "3309bb29-9b49-3454-8e1d-6dc3f0f43a93",
                        "glosses": [
                            "wat je maar heel kort, in een flits, ziet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce963256-e7d5-48ee-b9ef-a9fe3a378968",
                                "sense_id": "c74ca9cc-e811-3454-b4af-b2e4569669d5",
                                "text": "Wij konden maar een glimp van het nieuwe automodel zien."
                            },
                            {
                                "example_id": "350a561d-4f0a-4fee-b05f-208e21c1dfcb",
                                "sense_id": "c74ca9cc-e811-3454-b4af-b2e4569669d5",
                                "text": "Het volk houdt zich urenlang op straat op, zelfs in het donker of als het sneeuwt. in de hoop een glimp van haar gezicht op te vangen achter het raam van haar vergulde koets."
                            },
                            {
                                "example_id": "8acef6f4-9371-4ad1-8a7f-75eceae1f2b4",
                                "sense_id": "c74ca9cc-e811-3454-b4af-b2e4569669d5",
                                "text": "Duizenden gelovigen staan in de Italiaanse stad Padua in de rij om een glimp op te vangen van de relikwieën van de heilige Antonius. Het skelet is voor het eerst sinds 1981 weer van dichtbij te zien voor het publiek."
                            }
                        ]
                    }
