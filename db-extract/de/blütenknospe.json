                    {
                        "sense_id": "97c1c26e-3b0b-36dd-a89c-558513cc6dbb",
                        "entry_id": "5b43b62f-5226-3921-9186-7359eaa1dc60",
                        "glosses": [
                            "noch nicht aufgegangene, knospenförmige Blüte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "648c5e4a-1408-4b8a-8614-44213d457e06",
                                "sense_id": "97c1c26e-3b0b-36dd-a89c-558513cc6dbb",
                                "text": "Die Blütenknospen sind leider letzte Nacht erfroren."
                            },
                            {
                                "example_id": "9fc0fad1-cb89-45af-a628-241e59137c4c",
                                "sense_id": "97c1c26e-3b0b-36dd-a89c-558513cc6dbb",
                                "text": "„Die Bauern sagen, der kalte Wind im Spätfrühling bläst deshalb, weil dann die Blütenknospen der Eiche aufbrechen, und tatsächlich bläst jedes Frühjahr der kalte Wind gerade um die Zeit, in der die Eichenknospen aufbrechen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
