                                "sense_id": "f3746864-e193-3d32-906d-73cc3ddd8494",
                                "text": "Nous en profitions pour retourner dans le parc, sucer des cailloux, baver, gagater comme lui, finir les bouillies."
                            },
                            {
                                "example_id": "9e14781f-13bf-4604-8a61-4985b6aefa54",
                                "sense_id": "f3746864-e193-3d32-906d-73cc3ddd8494",
                                "text": "Arrête de gagater vieille bique."
                            },
                            {
                                "example_id": "4bd2c930-48ef-4187-8c66-7ef23b3764f7",
                                "sense_id": "f3746864-e193-3d32-906d-73cc3ddd8494",
                                "text": "Mais comme il gagate sur sa petite soeur, ce n'est pas trop grave."
                            }
