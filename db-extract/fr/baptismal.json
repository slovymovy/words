                            {
                                "example_id": "15cab80b-2fce-4922-b63f-9e7e30dc717e",
                                "sense_id": "aacb18a3-e0c4-3bcd-bab8-9b1119851525",
                                "text": "Le malade ne songeait plus qu'aux siens et à l'autre monde que sa foi baptismale lui avait toujours montré après cette vie."
                            },
                            {
                                "example_id": "5bb39cbf-0531-4e0e-bc46-16124271f613",
                                "sense_id": "aacb18a3-e0c4-3bcd-bab8-9b1119851525",
                                "text": "Il regarde la cuve baptismale simplement creusée dans le mur de brique."
                            }
                        ]
                    }
                ],
