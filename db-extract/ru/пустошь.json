                            {
                                "target_word": "erial",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "46ff2e92-190c-3a23-a106-e7e008af726a",
                                        "entry_id": "884410e5-e2d4-33b8-8ba7-4e48608dcd9e",
                                        "glosses": [
                                            "Terreno, tierra, o campo, sin cultivar ni labrar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3eded9b6-1b3d-4b5d-9ab1-a25e4a9c8979",
                                                "sense_id": "46ff2e92-190c-3a23-a106-e7e008af726a",
                                                "text": "También descubrí que la isla era un erial y tenía motivos para imaginarla despoblada salvo por fieras."
                                            },
                                            {
                                                "example_id": "20503f87-b7c8-4724-b0aa-b3e188a741e2",
                                                "sense_id": "46ff2e92-190c-3a23-a106-e7e008af726a",
                                                "text": "Un inmenso erial se avista en la parte trasera de la casa, donde antes hubo un jardín, y se prolonga hasta los restos del antiguo soto."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2db3f570-59ea-304c-97cd-afe72ea527d5",
                                        "entry_id": "884410e5-e2d4-33b8-8ba7-4e48608dcd9e",
