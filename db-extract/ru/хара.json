            {
                "entry_id": "9a7cc182-0be7-3559-8805-31a486b5f37b",
                "word": "хара",
                "pos": "noun",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "20e93ca0-c984-3095-8faa-013e856390f7",
                        "entry_id": "9a7cc182-0be7-3559-8805-31a486b5f37b",
                        "glosses": [
                            "степь (в Японии)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0987e219-b110-43b6-88a7-bf0db96555aa",
                                "sense_id": "20e93ca0-c984-3095-8faa-013e856390f7",
                                "text": "Волнистая поверхность его возвышается в среднем до 400 м, доходя местами до 933 м, и понижается полого к западу, к граничащей с ним продольной долине, тогда как на востоке обрывается довольно круто с уровня 500-600 м к береговой террасе, шириною в 2-4 км, занятой однообразной степью ― хара."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "e2591e49-e59b-322e-999f-5360cae09588",
