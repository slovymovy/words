    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "78aa5588-b741-3dbd-a061-97d9eed69543",
                "word": "Marx",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d6bfaf19-6409-3700-b22d-735cd5decddc",
                        "entry_id": "78aa5588-b741-3dbd-a061-97d9eed69543",
                        "glosses": [
                            "A surname from German"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05a9f425-db32-4d69-9c31-b938bb35d98b",
                                "sense_id": "d6bfaf19-6409-3700-b22d-735cd5decddc",
                                "text": "The family tree boasts an astonishing array of celebrated historical figures from the prophet Isaiah to Sir Isaiah Berlin, from Felix Mendelssohn to Karl Marx and Moses Montefiore. The list also includes Yehudi Menuhin, Helena Rubinstein, the Rothschilds and even Rosenstein himself."
                            }
                        ]
                    },
                    {
                        "sense_id": "b29be7b4-15f6-3b8f-b77a-58c354e53057",
                        "entry_id": "78aa5588-b741-3dbd-a061-97d9eed69543",
                        "glosses": [
                            "A surname from German",
                            "Karl Marx (1818–1883), a German political philosopher, economist, and sociologist."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "017d96d3-d3ce-491b-b69d-1d7cf3793c42",
                                "sense_id": "b29be7b4-15f6-3b8f-b77a-58c354e53057",
                                "text": "This is one of the developments Karl Marx failed to predict. Had he foreseen it he might have expired in guffaws, rolling in the aisle of the British Museum Library amid the notes for Das Kapital, that bearded Santa Claus of the revolution who slipped the unwanted gift of communism down the world's chimneys."
                            },
                            {
                                "example_id": "37939e86-1f4c-4437-8318-eebaba2a6a96",
                                "sense_id": "b29be7b4-15f6-3b8f-b77a-58c354e53057",
                                "text": "He discovered that far from focusing on the writings of Marx and Engels for their reading, the Bolsheviks and their children preferred expressly anti-revolutionary works by western authors such as Dickens, Defoe, Shakespeare, Hugo, Balzac, Flaubert, Goethe, Kipling and Wilde."
                            },
                            {
                                "example_id": "b92762c4-42d3-4b37-817d-f3642a2a3ec4",
                                "sense_id": "b29be7b4-15f6-3b8f-b77a-58c354e53057",
                                "text": "In his experience, Christ had led him to Marx, and the Gospels, with their message of social justice, had led him to communism."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c15823f-6a1b-412c-8617-d0a4a1e1bc63",
                        "source_entry_id": "78aa5588-b741-3dbd-a061-97d9eed69543",
