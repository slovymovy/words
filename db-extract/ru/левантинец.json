                    }
                ],
                "translations": [
                    {
                        "translation_id": "61857bc0-6e2b-4ead-a327-350a34381c3b",
                        "source_entry_id": "92bab1db-9e37-395a-a6cb-f1cbf53e2e30",
                        "source_sense_id": "76d2b69e-3ad7-310b-9203-0e51d9dec122",
                        "target_lang_word": "Franco-Levantine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Franco-Levantine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85546a7a-5d99-3e64-939f-5f943628daa0",
                                        "entry_id": "67c96fc6-e30b-3491-a8fa-09c67cbdb3d0",
                                        "glosses": [
                                            "A Catholic or Latinophone resident of the Levant, or one who culturally belongs to this community."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f74addad-7f70-4a3e-9ea7-497813c8eef4",
                                                "sense_id": "85546a7a-5d99-3e64-939f-5f943628daa0",
                                                "text": "This is an outstanding publication of photographs by J. P. Foscolo (1852-1927), a Franco-Levantine born on the Greek island of Zakynthos."
                                            },
                                            {
                                                "example_id": "643441b4-ba66-4bfa-ae7d-ab4509824a51",
                                                "sense_id": "85546a7a-5d99-3e64-939f-5f943628daa0",
                                                "text": "Half an hour later, the door of the inner sanctum opened and a portly and important-looking Franco-Levantine walked out and Peter was ushered into Mr. Mabardi's office."
                                            },
                                            {
                                                "example_id": "72129570-9d8a-4d5f-ba39-06d4d6ab62e1",
                                                "sense_id": "85546a7a-5d99-3e64-939f-5f943628daa0",
                                                "text": "But Franks (or Franco-Levantines) and Greeks constituted the two major ethno-religious groups, Latin and Orthodox respectively."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Franco-Levantine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "341bec53-1843-3042-8680-6f43a38308e5",
                                        "entry_id": "d7286083-802c-3558-8386-55da72050d90",
                                        "glosses": [
                                            "Characteristic of the culture of Franco-Levantines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1fe7134-c612-414a-b2ac-2cd7d921f8c9",
                                                "sense_id": "341bec53-1843-3042-8680-6f43a38308e5",
                                                "text": "This renowned Franco-Levantine restaurant and bar provides a welcome escape from the bustle of the city centre."
                                            },
                                            {
                                                "example_id": "71e9758a-7736-47c4-a064-ebac4b13fa94",
                                                "sense_id": "341bec53-1843-3042-8680-6f43a38308e5",
                                                "text": "Is she not herself in Egypt also taken in the toils of Franco-Levantine influences, as dominant at Cairo as they are at Constantinople ?"
                                            },
                                            {
                                                "example_id": "2f2d3029-bd28-40d3-b829-c1271ad8d47a",
                                                "sense_id": "341bec53-1843-3042-8680-6f43a38308e5",
                                                "text": "In the case of Maadi the tone would be unmistakably English and in the case of Heliopolis, Franco-Levantine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b98af02b-720d-417a-abc4-32f640a376f8",
                        "source_entry_id": "92bab1db-9e37-395a-a6cb-f1cbf53e2e30",
                        "source_sense_id": "76d2b69e-3ad7-310b-9203-0e51d9dec122",
                        "target_lang_word": "Levantine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Levantine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "516a11a5-0a45-32ee-a05c-e8b3cdebaefc",
                                        "entry_id": "35d6976b-a9be-3783-bd26-b609e8f0058a",
                                        "glosses": [
                                            "Of the Levant, the Eastern Mediterranean."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "599473d5-1e41-400e-b52f-fb790e294e84",
                                                "sense_id": "516a11a5-0a45-32ee-a05c-e8b3cdebaefc",
                                                "text": "[O]ne minute this \"Jihadi John\" was struggling to get by, and get accepted, in drizzly England, unemployed with a mortgage to pay and a chip on his shoulder, and the next he stands in brilliant Levantine sunlight, where everything is clear and etched, at the vanguard of some Sunni Risorgimento intent on subjecting the world to its murderous brand of Wahhabi Islam."
                                            }
                                        ]
                                    }
                                ]
                            },
