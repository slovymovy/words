                "senses": [
                    {
                        "sense_id": "610f665d-0af3-38d4-9492-17454cf182ed",
                        "entry_id": "331ed2a1-153c-3ac6-8e7d-ba68c05bafc9",
                        "glosses": [
                            "Remis à plus tard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5626428d-5211-4499-a2c6-4e335574256d",
                                "sense_id": "610f665d-0af3-38d4-9492-17454cf182ed",
                                "text": "La 18ᵉ séance de l'Assemblée de septembre ajournée, mais non close, pour donner le temps de jouer à l’application des sanctions et au « jugement de Dieu » dans le duel italo-éthiopien, allait s'ouvrir."
                            },
                            {
                                "example_id": "f7341fc6-65f0-43b0-ace1-9d9ea491bbda",
                                "sense_id": "610f665d-0af3-38d4-9492-17454cf182ed",
                                "text": "Bien entendu le projet est amputé aussitôt qu'établi. En effet le gros ouvrage à implanter sur les hauteurs de Vaux-lès-Mouzon est ajourné alors qu'il devait former le pilier ouest de la position […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "b84d6be1-0517-3fac-8334-2e4e4c8e2e88",
                        "entry_id": "331ed2a1-153c-3ac6-8e7d-ba68c05bafc9",
                        "glosses": [
                            "Recalé lors d'un examen, invité à le repasser lors d'une prochaine session."
                        ],
                        "tags": [
                            "euphemism"
                        ],
                        "examples": [
                            {
                                "example_id": "a61ca267-830a-4211-9d32-144d4bd72775",
                                "sense_id": "b84d6be1-0517-3fac-8334-2e4e4c8e2e88",
                                "text": "Un candidat ajourné à un examen."
                            }
                        ]
                    }
                ],
                "translations": [],
