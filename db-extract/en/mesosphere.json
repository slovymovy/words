    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4d351ae9-2a95-3c4d-9e2b-ca01f2e7f9bc",
                "word": "mesosphere",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a3737d56-19a5-4df6-9582-0fe71b6a223f",
                        "entry_id": "4d351ae9-2a95-3c4d-9e2b-ca01f2e7f9bc",
                        "tags": [
                            "plural"
                        ],
                        "form": "mesospheres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8003178a-a275-3925-9407-a5197a8466d8",
                        "entry_id": "4d351ae9-2a95-3c4d-9e2b-ca01f2e7f9bc",
                        "glosses": [
                            "The layer of the Earth's atmosphere that is directly above the stratosphere and directly below the thermosphere."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47002a0c-102c-430e-b56a-d45824cedc30",
                                "sense_id": "8003178a-a275-3925-9407-a5197a8466d8",
                                "text": "The mesosphere may be described as the earth's intermediate or middle atmosphere, which separates the thermosphere above from the ozonosphere (or stratosphere) below, both of which are responsible for absorption of most of the ultraviolet part of the solar radiation and preventing it from reaching the earth's surface."
                            }
                        ]
                    },
                    {
                        "sense_id": "9638e5a8-89b1-3805-b268-7336843c1c2a",
                        "entry_id": "4d351ae9-2a95-3c4d-9e2b-ca01f2e7f9bc",
                        "glosses": [
                            "The part of the Earth's mantle below the asthenosphere and above the outer core."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c2ceb0a-a700-4e23-9ebe-16a1c5c50d29",
                        "source_entry_id": "4d351ae9-2a95-3c4d-9e2b-ca01f2e7f9bc",
                        "source_sense_description": "layer of the Earth's atmosphere",
                        "target_lang_word": "mezosféra",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mezosféra",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "0a13c265-1920-3cad-b9d3-b1a842e20ea4",
                                        "entry_id": "af0e62cb-8047-3d9d-81ee-71bb9cdfa55c",
                                        "glosses": [
                                            "část atmosféry mezi stratopauzou a mezopauzou"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "660c5a23-71fb-465c-aa0f-52b2e7f29dd2",
                                                "sense_id": "0a13c265-1920-3cad-b9d3-b1a842e20ea4",
                                                "text": "V mezosféře teplota klesá na −85 °C."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bbec0a8a-2b50-49f6-9801-003659a40796",
                        "source_entry_id": "4d351ae9-2a95-3c4d-9e2b-ca01f2e7f9bc",
                        "source_sense_description": "layer of the Earth's atmosphere",
                        "target_lang_word": "mesosfeer",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mesosfeer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "896236ca-0f6f-3fbc-b07a-f00aa75c2bb7",
                                        "entry_id": "aa04b542-c002-3d61-9d31-358bb870fbbd",
                                        "glosses": [
                                            "deel van de dampkring tussen 50 en 80 km waar de temperatuur daalt naarmate je hoger komt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfd90fcf-f263-4898-aa86-dc4a86a5b5f7",
                                                "sense_id": "896236ca-0f6f-3fbc-b07a-f00aa75c2bb7",
                                                "text": "Wisselingen in de activiteit van de zon kunnen van grotere invloed zijn op het klimaat dan tot nu toe is aangenomen. De niet-actieve zon zendt naar verhouding zó weinig ultraviolette straling naar de aarde dat de ozonlaag in stratosfeer en lage mesosfeer er merkbaar door afkoelt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ec134bb-bc64-376e-8dc3-50d68c34feb5",
                                        "entry_id": "aa04b542-c002-3d61-9d31-358bb870fbbd",
                                        "glosses": [
                                            "hardere deel van de aardmantel ongeveer vanaf 670 km diepte tot 2900 km, de diepte waar de aardkern begint"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b216447-ee47-4b09-8863-4828b50b8f68",
                                                "sense_id": "9ec134bb-bc64-376e-8dc3-50d68c34feb5",
                                                "text": "Tot op een diepte van 670 km worden aardbevingen geregistreerd in wegduikende lithosferische platen (…). In de ondermantel – ook wel mesosfeer genoemd – neemt de snelheid van de seismische golven geleidelijk toe tot aan de kern-mantelgrens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceef73e3-7f1d-3cfa-95bf-2aebc7edb701",
                                        "entry_id": "aa04b542-c002-3d61-9d31-358bb870fbbd",
                                        "glosses": [
                                            "sociale verbanden die groter zijn dan gezinnen en andere groepen waar iedereen elkaar kent, maar niet de hele samenleving omvatten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "167b5995-68ae-45a5-9f5b-769f54ac4864",
                                                "sense_id": "ceef73e3-7f1d-3cfa-95bf-2aebc7edb701",
                                                "text": "Dit dan voor wat betreft de samenleving als geheel. Ook echter in de mesosfeer van grote instellingen en organisaties en in de microsfeer van gezin en individuele rechten en belangen is deze tweedeling zichtbaar te maken. Terwijl sommige organisaties - met name ondernemingen en legers - krachtige aanhangers zijn van gecentraliseerde ‘planning of change’, staan vele vrijwillige organisaties - zoals democratische politieke partijen en vakverenigingen - op het standpunt dat verandering ‘aan de basis’ moet beginnen en daar moet groeien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0785fb1d-d6f8-499d-bd8f-ba5a3332552c",
                        "source_entry_id": "4d351ae9-2a95-3c4d-9e2b-ca01f2e7f9bc",
                        "source_sense_description": "layer of the Earth's atmosphere",
                        "target_lang_word": "mésosphère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mésosphère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0dc933af-a29c-34cc-a122-7e25f06071d2",
                                        "entry_id": "11a4f9a0-382d-3a99-b33e-85e1794954be",
                                        "glosses": [
                                            "Couche de l’atmosphère terrestre juste au-dessus de la stratosphère, séparée de cette dernière par la stratopause."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0af9ed4c-f79a-4a40-ab71-4287c266a6df",
                                                "sense_id": "0dc933af-a29c-34cc-a122-7e25f06071d2",
                                                "text": "C’est dans la mésosphère que les corps étrangers (météorites, vaisseaux spatiaux...) entrant dans l’atmosphère commencent à s’échauffer par frottement des molécules d’air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2c5a13f-c46c-3830-810e-f4b5a6cb8cd5",
                                        "entry_id": "11a4f9a0-382d-3a99-b33e-85e1794954be",
                                        "glosses": [
                                            "Couche du manteau terrestre, située entre l'asthénosphère et le noyau."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65b0a089-f11e-4427-b8e3-c822c8fe638e",
                        "source_entry_id": "4d351ae9-2a95-3c4d-9e2b-ca01f2e7f9bc",
                        "source_sense_description": "layer of the Earth's atmosphere",
                        "target_lang_word": "Mesosphäre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mesosphäre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "272cb6ee-ebb0-3248-8a6e-df5a67a74ab1",
                                        "entry_id": "8354098b-6651-301c-9fab-88e5516af013",
                                        "glosses": [
                                            "mittlere der fünf Schichten der Erdatmosphäre im Bereich von etwa 50 Kilometer an bis 80 Kilometer Höhe über der Erdoberfläche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "766dfa0b-8919-427d-bc7b-1f76a6f47803",
                                                "sense_id": "272cb6ee-ebb0-3248-8a6e-df5a67a74ab1",
                                                "text": "Die Mesosphäre wird im unteren Bereich von der Stratopause und im oberen Bereich von der Mesopause begrenzt."
                                            },
                                            {
                                                "example_id": "837a03e8-a385-4d39-98d0-2d254ad10661",
                                                "sense_id": "272cb6ee-ebb0-3248-8a6e-df5a67a74ab1",
                                                "text": "Einatomiger Sauerstoff kommt auch in der Mesosphäre vor, in der Sauerstoff O2 durch UV-C-Strahlung in einatomigen Sauerstoff zersetzt wird."
                                            },
                                            {
                                                "example_id": "9c08c980-b3df-47d2-923a-0c1b6d11047b",
                                                "sense_id": "272cb6ee-ebb0-3248-8a6e-df5a67a74ab1",
                                                "text": "Solche Wolken bilden sich normalerweise im Sommer über den Polargebieten in der sogenannten Mesosphäre, in einer Höhe von bis zu 85 Kilometern, und sind damit die höchsten Wolkenformationen der Erde."
                                            },
                                            {
                                                "example_id": "38b640c3-7619-496e-8691-b35d751eda15",
                                                "sense_id": "272cb6ee-ebb0-3248-8a6e-df5a67a74ab1",
                                                "text": "Anschließend wurden die Wasserpartikel vermutlich durch Wirbelströme in der Mesosphäre oder der darüberliegenden Thermosphäre erfasst und mit einer Geschwindigkeit von bis zu 330 Kilometern pro Stunde vom Ort ihrer Freisetzung weggetragen."
                                            },
                                            {
                                                "example_id": "56735f03-38bd-42b7-8378-c8ab8ca0bc20",
                                                "sense_id": "272cb6ee-ebb0-3248-8a6e-df5a67a74ab1",
                                                "text": "Aus diesem Grunde wird der Versuch unternommen, mittels chemischer Modelle neben dem spärlichen Monitoring der Mesosphäre einen Einblick in die physikalisch-chemischen Prozesse der oberen Atmosphäre zu gewinnen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
