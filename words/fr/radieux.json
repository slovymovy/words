                                "target_lang_word": "灿烂",
                                "target_lang_sense_clarification": "形容笑容，表示喜悦"
                            },
                            {
                                "target_lang_word": "容光焕发",
                                "target_lang_sense_clarification": "形容神采，多因喜悦而起"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5e67ba3-a1a6-344e-ab7e-eb02f68a44f4",
                    "sense_definition": "Qui brille d'un éclat vif et lumineux, en parlant du soleil, du ciel ou du temps.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lumiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons profité d'un soleil <w>radieux</w> pendant toute la semaine de vacances.",
                            "target_lang_translations": {
                                "en": "We enjoyed <w>brilliant</w> sunshine all week during our holiday.",
                                "ru": "Всю неделю отпуска мы наслаждались <w>лучезарным</w> солнцем.",
                                "de": "Während der ganzen Urlaubswoche genossen wir <w>strahlenden</w> Sonnenschein.",
                                "es": "Disfrutamos de un sol <w>radiante</w> durante toda la semana de vacaciones.",
                                "zh": "我们在假期的整整一周里都享受着<w>明媚</w>的阳光。"
                            }
                        },
                        {
                            "text": "Après plusieurs jours de pluie continue, le matin s'est levé sous un ciel <w>radieux</w>.",
                            "target_lang_translations": {
                                "en": "After several days of nonstop rain, the morning dawned under a <w>bright</w> sky.",
                                "ru": "После нескольких дней непрерывного дождя утро настало под <w>ясным</w> небом.",
                                "de": "Nach mehreren Regentagen in Folge zeigte sich der Morgen unter einem <w>strahlenden</w> Himmel.",
                                "es": "Tras varios días de lluvia continua, la mañana amaneció bajo un cielo <w>despejado</w>.",
                                "zh": "连续下了好几天雨之后，这天早晨迎来了<w>晴朗</w>的天空。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rayonnant"
                    ],
                    "antonyms": [
                        "couvert",
                        "nuageux",
                        "sombre"
                    ],
                    "common_phrases": [
                        "soleil radieux",
                        "temps radieux",
                        "ciel radieux"
                    ],
                    "target_lang_definitions": {
                        "en": "Shining with a vivid, bright light, said of the sun, sky or weather.",
                        "ru": "Ярко сияющий, о солнце, небе или погоде.",
                        "de": "Von hellem, kräftigem Licht erfüllt, besonders bei Sonne, Himmel oder Wetter.",
                        "es": "Que brilla con una luz intensa y clara, referido al sol, al cielo o al tiempo.",
                        "zh": "形容阳光、天空或天气明亮而耀眼。"
                    },
