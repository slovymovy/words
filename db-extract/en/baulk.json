                "senses": [
                    {
                        "sense_id": "3c391390-ccaf-3430-91a9-a2076e21acf3",
                        "entry_id": "f796fa7c-8669-302d-bced-6b222372fc42",
                        "glosses": [
                            "Alternative spelling of balk."
                        ],
                        "tags": [
                            "UK",
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "029ed5bc-87b3-4c30-aadc-343d31925b3f",
                                "sense_id": "3c391390-ccaf-3430-91a9-a2076e21acf3",
                                "text": "What made those holes and rents / In the dock's harsh swarth leaves, bruised as to baulk / All hope of greenness?"
                            },
                            {
                                "example_id": "739e4422-17ab-4387-89fc-f77ea7e5c9bb",
                                "sense_id": "3c391390-ccaf-3430-91a9-a2076e21acf3",
                                "text": "As he talked, slowly, quietly, I had the impression that it must surely be an accident that had happened, but that his mind, unhinged by tragedy, baulked at Anna’s death."
                            },
                            {
                                "example_id": "3372afb5-6ad1-455f-88ce-3531be59a502",
                                "sense_id": "3c391390-ccaf-3430-91a9-a2076e21acf3",
                                "text": "What wasn't done was the second part of the work to add Piccadilly's two new through platforms. The Department for Transport baulked at Network Rail's price, but nonetheless May 2018's timetable increased services to 15tph. Punctuality dropped."
                            },
                            {
                                "example_id": "b8868333-9859-4e00-b692-51ca8f3254cf",
                                "sense_id": "3c391390-ccaf-3430-91a9-a2076e21acf3",
                                "text": "Colleagues and confidants describe Yaccarino as a conservative. But when I ask about her personal politics, she baulks."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
