                    "frequency": "VeryLow",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als ervaren <w>koker</w> wist hij precies hoe lang de groenten moesten koken.",
                            "target_lang_translations": {
