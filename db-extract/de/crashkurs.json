                "senses": [
                    {
                        "sense_id": "4945ea89-e59a-3ccd-83b2-be647bc19307",
                        "entry_id": "976bc53d-95a5-385b-ad63-daa05d64dc4b",
                        "glosses": [
                            "Kurs, der in kurzer Zeit die wichtigsten Aspekte eines Themas lehrt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dcdb782-1069-4a23-aac7-d364dda82998",
                                "sense_id": "4945ea89-e59a-3ccd-83b2-be647bc19307",
                                "text": "Ich habe in einem Crashkurs Italienisch gelernt."
                            },
                            {
                                "example_id": "b9155e33-f29d-4da4-92de-57ba792092a6",
                                "sense_id": "4945ea89-e59a-3ccd-83b2-be647bc19307",
                                "text": "„Den Crashkurs, den die Union jetzt in der Energiepolitik absolviert, hat Töpfer als allmählichen Meinungswandel in den achtziger Jahren hinter sich gebracht.“"
                            },
                            {
                                "example_id": "235d7742-e88e-49a2-896d-e7e1e8b2ce12",
                                "sense_id": "4945ea89-e59a-3ccd-83b2-be647bc19307",
                                "text": "„Zwischen geeisten Cappuccinos und Clubsandwich bekomme ich einen Crashkurs in aktueller griechischer Innenpolitik.“"
                            },
                            {
                                "example_id": "e049f78b-d428-45f9-b75b-988483d0b618",
                                "sense_id": "4945ea89-e59a-3ccd-83b2-be647bc19307",
                                "text": "„Sechs Wochen lang erhielten junge Leute einen Crashkurs in Geschichte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
