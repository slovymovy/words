                        "examples": [
                            {
                                "example_id": "a98c4c1f-d9c8-4ad5-8cd3-3ceb003c21e0",
                                "sense_id": "51b83615-3cd1-363f-930e-e69191e97626",
                                "text": "„Wir näherten uns Nakuru, und ich wollte gerade einen kleinen Scherz machen und fragen, ob wir nicht den Flamingos im Nakuru-See einen Besuch abstatten sollten, als hinter einer Kurve plötzlich eine Gruppe junger Männer vor uns auftauchte, die mit Steinen, Pfeilen, Bögen und Macheten bewaffnet waren - wahrscheinlich stammten sie aus der chinesischen Lieferung, die vor ein paar Tagen in Mombasa beschlagnahmt worden war.“"
                            }
                        ],
