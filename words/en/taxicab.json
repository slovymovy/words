{
    "word_family": [
        "cab",
        "taxi"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a64ba893-a524-3d32-9664-940e48300da3",
                    "sense_definition": "A car available for public hire along with its driver to take passengers to a specified destination, usually fitted with a taximeter to determine the fare.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "transportation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were running late for our flight, so we decided to take a <w>taxicab</w> directly to the airport.",
                            "target_lang_translations": {
                                "zh": "我们赶飞机快迟到了，所以决定直接乘<w>出租车</w>去机场。"
                            }
                        },
                        {
                            "text": "A yellow <w>taxicab</w> stopped at the curb to let out two tourists with heavy luggage.",
                            "target_lang_translations": {
                                "zh": "一辆黄色<w>出租车</w>停在路边，放下两名带着沉重行李的游客。"
                            }
                        }
                    ],
                    "synonyms": [
                        "taxi"
                    ],
                    "common_phrases": [
                        "take a taxicab",
                        "hail a taxicab"
                    ],
                    "target_lang_definitions": {
                        "zh": "出租车，供公众雇佣并配备计价器的载客汽车。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "出租车",
                                "target_lang_sense_clarification": "中国大陆常用"
                            },
                            {
                                "target_lang_word": "计程车",
                                "target_lang_sense_clarification": "台湾等地区常用"
                            },
                            {
                                "target_lang_word": "的士",
                                "target_lang_sense_clarification": "口语或粤语区常用"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cb0c6a87-b32e-3e42-9249-ec975d34ed4b",
                    "sense_definition": "To travel or commute using a taxicab.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "transportation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Instead of waiting for the evening train, she <w>taxicabbed</w> across the city to make the meeting on time.",
                            "target_lang_translations": {
                                "zh": "她没有等晚班火车，而是<w>打车</w>穿过整个城市以准时参加会议。"
                            }
                        },
                        {
                            "text": "They spent the entire weekend <w>taxicabbing</w> between different art galleries downtown.",
                            "target_lang_translations": {
                                "zh": "他们整个周末都在市中心辗转<w>打车</w>穿梭于各个艺术馆之间。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "乘坐出租车出行或通勤。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "坐出租车",
                                "target_lang_sense_clarification": "搭乘出租车出行"
                            },
                            {
                                "target_lang_word": "打车",
                                "target_lang_sense_clarification": "乘坐出租车的常用口语动词"
                            },
                            {
                                "target_lang_word": "打的",
                                "target_lang_sense_clarification": "乘坐出租车，口语常用"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}