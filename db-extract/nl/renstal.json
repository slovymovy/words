                        "examples": [
                            {
                                "example_id": "cf3eb315-1605-43f6-b293-adf0ff875658",
                                "sense_id": "ff9ad137-ff93-3537-8c15-a88b01b7c48e",
                                "text": "De afgelopen jaren wist de renstal met een voor Formule 1-begrippen klein budget erg sterk te presteren. In 2008, het eerste jaar van Force India, behaalde het team nog geen punt, maar kroop het steeds verder naar voren op de grid."
                            },
                            {
                                "example_id": "b65f57be-309b-451e-8009-2a5615ca3d21",
                                "sense_id": "ff9ad137-ff93-3537-8c15-a88b01b7c48e",
                                "text": "Ferrari heeft vandaag als laatste Formule 1-team de wagen voor het nieuwe seizoen getoond. De bolide is uiteraard knalrood met dit jaar zwarte accenten. Voor de Italiaanse renstal zitten Sebastian Vettel en Charles Leclerc in de wagen."
                            }
                        ]
                    }
