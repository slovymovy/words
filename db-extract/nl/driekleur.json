                            }
                        ]
                    },
                    {
                        "translation_id": "1325a4e7-55e4-439f-85c5-a7a0cecf8dc9",
                        "source_entry_id": "1186304a-4eb5-3c15-81aa-89c3aeaa8d8b",
                        "source_sense_id": "481c2ae3-d7cc-3de6-b32e-8ac714a63e58",
                        "target_lang_word": "tricolore",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tricolore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "263c3301-e587-3d12-a85d-0017731046d0",
                                        "entry_id": "18c04011-1218-3c4b-afb4-08d9aeae9933",
                                        "glosses": [
                                            "Qui est de trois couleurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d13bb02-d870-4e45-a0e4-eb94651db6f3",
                                                "sense_id": "263c3301-e587-3d12-a85d-0017731046d0",
                                                "text": "Fleur tricolore."
                                            },
                                            {
                                                "example_id": "0707340e-601e-4620-a1f3-b8491310152c",
                                                "sense_id": "263c3301-e587-3d12-a85d-0017731046d0",
                                                "text": "Chat tricolore : dont la robe porte, soit de façon mélangée soit en taches, les trois couleurs roux, noir et blanc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10e7af69-d424-3684-861f-697226957262",
                                        "entry_id": "18c04011-1218-3c4b-afb4-08d9aeae9933",
                                        "glosses": [
                                            "Se dit d’un drapeau comportant trois couleurs à bandes verticales ou horizontales, comme les drapeaux français, belge, italien, et de nombreux autres, et en particulier en parlant du drapeau de son propre pays."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aac5f905-bc52-30c2-b49e-13ca0f0f3255",
                                        "entry_id": "18c04011-1218-3c4b-afb4-08d9aeae9933",
                                        "glosses": [
                                            "Relatif à la France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "572e9991-806e-4556-bf02-3a90562fa8d1",
                                                "sense_id": "aac5f905-bc52-30c2-b49e-13ca0f0f3255",
                                                "text": "Et, si l’état-major des armées se félicitait, dans un tweet en septembre, de 7 349 survols, 1 413 frappes et 2 197 objectifs détruits en trois ans, il soutient que les ailes tricolores n’ont fait aucun dégât parmi les civils."
                                            },
                                            {
                                                "example_id": "cfe76de2-72fb-4a71-9c44-ea9707774d22",
                                                "sense_id": "aac5f905-bc52-30c2-b49e-13ca0f0f3255",
                                                "text": "Mais, deux jours plus tard, face à l’avalanche de critiques sur la « lenteur » de la campagne tricolore, M. Véran a été contraint d’opérer une volte-face, en décidant « d’accélérer la protection des publics prioritaires »."
                                            },
                                            {
                                                "example_id": "0d9961ac-3281-44e5-bdc0-44753836f7e3",
                                                "sense_id": "aac5f905-bc52-30c2-b49e-13ca0f0f3255",
                                                "text": "La Francilienne de 28 ans, installée au Texas, assume l’étiquette de favorite, qu’elle doit aussi à son incontestable rang de nᵒ 1 tricolore."
                                            },
                                            {
                                                "example_id": "44b13a12-6b03-4754-b387-46b3a558d5a8",
                                                "sense_id": "aac5f905-bc52-30c2-b49e-13ca0f0f3255",
                                                "text": "La paternité du porno tricolore est généralement attribuée au producteur Lucien Hustaix avec Les Jouisseuses qui démarre sa carrière en salle le 12 juin 1974."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tricolore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cd7a3d88-4563-328c-a0ad-bd95c5a0ebf4",
                                        "entry_id": "08423e10-5d9a-36ae-8201-83dcdf7dcfcd",
                                        "glosses": [
                                            "Compétiteur français d'un sport individuel ou d'équipe."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "749631fa-1474-4a24-91b7-e6d47b40cf09",
                                                "sense_id": "cd7a3d88-4563-328c-a0ad-bd95c5a0ebf4",
                                                "text": "Un groupe de baroudeurs, sans tricolore, s'est échappé par l'avant. Mais le peloton des meilleurs a décidé de chasser les courageux. Sans pitié."
                                            },
                                            {
                                                "example_id": "86deff4d-29e0-4854-a9a1-15e210c90978",
                                                "sense_id": "cd7a3d88-4563-328c-a0ad-bd95c5a0ebf4",
                                                "text": "Aux commentaires des matchs des Bleues sur beIN Sports, l’ancienne tricolore Audrey Sauret loue sa « montée en puissance depuis son arrivée en sélection. Ce n’est peut-être pas un leadeur vocal, mais un leadeur par l’exemple, de par sa manière de combattre et de ne rien lâcher. »"
                                            },
                                            {
                                                "example_id": "a35941da-4435-4be3-8fef-9d5380daaf18",
                                                "sense_id": "cd7a3d88-4563-328c-a0ad-bd95c5a0ebf4",
                                                "text": "Entre les échanges, des spectateurs déchaînés tapent sur les panneaux de bois placés au bord du court et traitent les tricolores de tous les noms. Le tout sous les yeux du chef d'État paraguayen Alfredo Stroessner, un dictateur de sinistre mémoire."
                                            }
                                        ]
                                    }
                                ]
                            },
