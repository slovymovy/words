{
    "word_family": [
        "yelper",
        "yelping"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f7801409-8af4-34df-a664-5ddee58ffe8e",
                    "sense_definition": "To utter an abrupt, high-pitched noise, often due to pain, excitement, or surprise.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vocal_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The puppy began to <w>yelp</w> in pain when its tail was accidentally stepped on.",
                            "target_lang_translations": {
                                "de": "Der Welpe begann vor Schmerz zu <w>jaulen</w>, als ihm versehentlich auf den Schwanz getreten wurde."
                            }
                        },
                        {
                            "text": "The children would <w>yelp</w> with delight every time a wave splashed over them.",
                            "target_lang_translations": {
                                "de": "Die Kinder <w>kreischten</w> jedes Mal vor Vergnügen auf, wenn eine Welle über sie schwappte."
                            }
                        }
                    ],
                    "synonyms": [
                        "yap",
                        "shriek",
                        "squeal",
                        "bark"
                    ],
                    "common_phrases": [
                        "yelp with delight",
                        "yelp in pain"
                    ],
                    "target_lang_definitions": {
                        "de": "Einen plötzlichen, hohen Schrei ausstoßen, oft vor Schmerz, Aufregung oder Überraschung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "jaulen",
                                "target_lang_sense_clarification": "von Tieren, besonders Hunden, vor Schmerz"
                            },
                            {
                                "target_lang_word": "aufschreien",
                                "target_lang_sense_clarification": "plötzlich und kurz schreien vor Schmerz oder Überraschung"
                            },
                            {
                                "target_lang_word": "kreischen",
                                "target_lang_sense_clarification": "einen schrillen, hohen Laut ausstoßen"
                            },
                            {
                                "target_lang_word": "kläffen",
                                "target_lang_sense_clarification": "kurz und hell bellen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a627efc1-b4f2-308e-9687-d9f1e5296004",
                    "sense_definition": "An abrupt, high-pitched noise or utterance, typically made by an animal or a person in pain or excitement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vocal_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog let out a sudden <w>yelp</w> when the door closed on its paw.",
                            "target_lang_translations": {
                                "de": "Der Hund stieß einen plötzlichen <w>Jauler</w> aus, als sich die Tür über seiner Pfote schloss."
                            }
                        },
                        {
                            "text": "With a sharp <w>yelp</w> of surprise, she jumped back from the cold water.",
                            "target_lang_translations": {
                                "de": "Mit einem schrillen <w>Aufschrei</w> der Überraschung sprang sie vor dem kalten Wasser zurück."
                            }
                        }
                    ],
                    "synonyms": [
                        "shriek",
                        "squeal",
                        "yap",
                        "bark"
                    ],
                    "common_phrases": [
                        "sudden yelp",
                        "yelp of pain",
                        "yelp of surprise"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein plötzlicher, hoher Schrei oder Laut, der typischerweise von einem Tier oder einer Person vor Schmerz oder Aufregung ausgestoßen wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Jauler",
                                "target_lang_sense_clarification": "kurzer, hoher Schrei eines Tieres"
                            },
                            {
                                "target_lang_word": "Aufschrei",
                                "target_lang_sense_clarification": "plötzlicher Schrei einer Person vor Schmerz oder Überraschung"
                            },
                            {
                                "target_lang_word": "Kläffen",
                                "target_lang_sense_clarification": "kurzes, helles Bellen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d2e4e59-679b-3416-bef3-bf470534c333",
                    "sense_definition": "A type of emergency vehicle siren sound that is quicker and more intense than a standard wail.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "siren_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police car switched its siren from a wail to a rapid <w>yelp</w> to clear the busy intersection.",
                            "target_lang_translations": {
                                "de": "Das Polizeiauto schaltete seine Sirene von einem Heulton auf ein schnelles <w>Yelp-Signal</w> um, um die belebte Kreuzung freizumachen."
                            }
                        },
                        {
                            "text": "I heard the distinctive <w>yelp</w> of an ambulance approaching from behind.",
                            "target_lang_translations": {
                                "de": "Ich hörte das charakteristische <w>Yelp-Signal</w> eines Krankenwagens, der sich von hinten näherte."
                            }
                        }
                    ],
                    "common_phrases": [
                        "siren yelp"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein schneller, intensiver Sirenenton eines Einsatzfahrzeugs, der sich vom normalen Heulton unterscheidet."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Yelp-Signal",
                                "target_lang_sense_clarification": "schnelles, gellendes Sondersignal von Polizeifahrzeugen"
                            },
                            {
                                "target_lang_word": "Yelp-Ton",
                                "target_lang_sense_clarification": "schnell modulierter Sirenenton"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}