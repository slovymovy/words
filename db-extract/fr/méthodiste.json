            {
                "entry_id": "8e835e90-5edf-399b-af02-a4d81a93b79d",
                "word": "méthodiste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "27946477-c567-441e-8f1d-be8821e28f0b",
                        "entry_id": "8e835e90-5edf-399b-af02-a4d81a93b79d",
                        "tags": [
                            "plural"
                        ],
                        "form": "méthodistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b59754f8-200d-3eae-a4a2-e40dc336643a",
                        "entry_id": "8e835e90-5edf-399b-af02-a4d81a93b79d",
                        "glosses": [
                            "Relatif au mouvement du méthodisme et à ses adhérents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca533859-17e6-4cdd-8682-bfaa0c2056d7",
                                "sense_id": "b59754f8-200d-3eae-a4a2-e40dc336643a",
                                "text": "La base doctrinale des sociétés méthodistes fut les trente-neuf articles de l'Eglise anglicane, que Wesley donna comme confes­sion de foi à l'Eglise méthodiste d'Amérique, après leur avoir fait subir quelques retouches."
                            },
                            {
                                "example_id": "1c616830-6640-45f6-be62-aeb2f16eb20e",
                                "sense_id": "b59754f8-200d-3eae-a4a2-e40dc336643a",
                                "text": "On comprend bien des choses si l'on sait que chacun de ces hommes devait être enterré selon les rites de sa bande, avec tout ce qu'il peut y avoir de prières : catholiques, juives, puritaines, presbytériennes, méthodistes, parsies, jaines, musulmanes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10d88b1e-6526-43ed-86f8-17216f9fe398",
                        "source_entry_id": "8e835e90-5edf-399b-af02-a4d81a93b79d",
                        "source_sense_id": "b59754f8-200d-3eae-a4a2-e40dc336643a",
                        "target_lang_word": "Methodist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Methodist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64582447-8c6b-34f5-8f0c-d21353cb0727",
                                        "entry_id": "0264d505-2ecc-3886-b6b3-6a684efeebea",
                                        "glosses": [
                                            "Anhänger einer christlichen Religionsgemeinschaft der Erweckungsbewegung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8554b105-a10f-4719-890c-26c2a3f5aa13",
                                                "sense_id": "64582447-8c6b-34f5-8f0c-d21353cb0727",
                                                "text": "„Er gehörte den Methodisten an, die mehrere Leprahospitäler in der Gegend betrieben.“"
                                            },
                                            {
                                                "example_id": "3064fb65-143c-4907-8fdd-ee093c52ef55",
                                                "sense_id": "64582447-8c6b-34f5-8f0c-d21353cb0727",
                                                "text": "„Die Farmer, die einesteils selbst Methodisten waren, andernteils die Sitte des Hauses ehrten, legten die schon ergriffenen Messer wieder nieder und sahen andächtig auf die leeren Teller herunter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf6ce0aa-7742-4932-87f3-cbaec28d8ee7",
                        "source_entry_id": "8e835e90-5edf-399b-af02-a4d81a93b79d",
                        "source_sense_id": "b59754f8-200d-3eae-a4a2-e40dc336643a",
                        "target_lang_word": "Methodist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Methodist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9fc4682-c8c4-3b5c-8081-a3835d401078",
                                        "entry_id": "f9d89741-905a-3c93-ab6e-5831f4858d89",
                                        "glosses": [
                                            "A member of the Methodist Church; a Wesleyan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2db5abe-5ac4-461e-aac2-a4c346737798",
                                                "sense_id": "d9fc4682-c8c4-3b5c-8081-a3835d401078",
                                                "text": "The question, which visibly moved Clinton, delves into an area of the candidate’s life that is deeply personal but rarely discussed. Clinton’s friends and confidants describe the former first lady as a devout Methodist whose faith guides much of what she does."
                                            },
                                            {
                                                "example_id": "bfc779d3-a353-4b0c-845a-c05308cb144a",
                                                "sense_id": "d9fc4682-c8c4-3b5c-8081-a3835d401078",
                                                "text": "After years of debate, hundreds of United Methodists from all over the world gathered in St. Louis last week to settle the denomination’s stance on LGBT clergy and same-sex weddings."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Methodist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "912b00f7-f52a-33fa-92a3-ee16d9e6e753",
                                        "entry_id": "3fa5e969-3561-3b95-b4e9-f26405a83f0b",
                                        "glosses": [
                                            "Of or pertaining to the branch of Christianity that descends from the religious societies overseen by John Wesley (1703–1791) among others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c15f2040-cf09-41f0-9de0-fbf5abd26e2a",
                                                "sense_id": "912b00f7-f52a-33fa-92a3-ee16d9e6e753",
                                                "text": "Clinton’s faith is something she developed as a child growing up in Park Ridge, Illinois, attending the suburb’s First Methodist Church."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
