                "senses": [
                    {
                        "sense_id": "370e6785-edc5-376d-8c19-44e44d1c1365",
                        "entry_id": "afbd5132-232c-3c39-b805-87b0ef342f20",
                        "glosses": [
                            "Établissement public conçu pour danser."
                        ],
                        "tags": [
                            "Faux anglicisme"
                        ],
                        "examples": [
                            {
                                "example_id": "f338e672-a76f-4c1e-815d-a4a5bcfc313d",
                                "sense_id": "370e6785-edc5-376d-8c19-44e44d1c1365",
                                "text": "Les Berlinois de la Société ne fréquentent jamais ce dancing vulgaire où la jeunesse brune et les « sous-offs » de la garnison fraternisent."
                            },
                            {
                                "example_id": "02777674-0f2d-4829-bbfd-4d4ace635e71",
                                "sense_id": "370e6785-edc5-376d-8c19-44e44d1c1365",
                                "text": "Deux des Allemands leur ont parlé d’un dancing curieux où l’on trouve des taxi-boys."
                            },
                            {
                                "example_id": "5b061bea-8b28-4a8d-b4cb-d4cd4850b583",
                                "sense_id": "370e6785-edc5-376d-8c19-44e44d1c1365",
                                "text": "Lorsqu'il a racheté ce petit dancing, en 1986, ce n'était qu'un modeste « parquet » où les sexagénaires des villages entre Narbonne et Béziers aimaient se retrouver le samedi soir pour danser le tango et la valse au rythme d'un orchestre local. L'endroit était franchement has been et la clientèle s'amenuisait. « Le Gentleman » était, à l'époque, une espèce de construction provisoire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "928010f4-257a-4827-86ca-7a652ccca392",
                        "source_entry_id": "afbd5132-232c-3c39-b805-87b0ef342f20",
                        "source_sense_id": "370e6785-edc5-376d-8c19-44e44d1c1365",
                        "target_lang_word": "dance hall",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
