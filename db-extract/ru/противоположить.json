                    }
                ],
                "senses": [
                    {
                        "sense_id": "cc504f78-ffe4-3617-82cc-effc13326c1b",
                        "entry_id": "a36042e0-5a8a-3baf-a259-b2691a03bb2e",
                        "glosses": [
                            "сравнить, сопоставить с кем-либо, чем-либо, указав несходность признаков одного и другого, дать рядом что-либо несходное по каким-либо признакам"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a748a3d7-4302-3c06-bda2-18ca03afca14",
                        "entry_id": "a36042e0-5a8a-3baf-a259-b2691a03bb2e",
                        "glosses": [
                            "направить, выставить, обратить против кого-либо, чего-либо"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff27cbb1-6aa2-4702-acb4-2e6d208ef1a9",
                        "source_entry_id": "a36042e0-5a8a-3baf-a259-b2691a03bb2e",
                        "target_lang_word": "opposer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opposer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c1d32f16-454b-301c-b710-34c3f48c2460",
                                        "entry_id": "12e73da2-6e28-3327-b413-ad52fd447cce",
                                        "glosses": [
                                            "Mettre une chose vis-à-vis d’une autre, ou en placer plusieurs de manière à faire contraste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cf34a8e-dc6c-40ae-87f0-c9d6a9b4b4db",
                                                "sense_id": "c1d32f16-454b-301c-b710-34c3f48c2460",
                                                "text": "Opposer une fausse porte à la porte d’entrée, un trumeau à une cheminée."
                                            },
                                            {
                                                "example_id": "479be001-4c1d-42f6-92ff-dfcc9aeaf02e",
                                                "sense_id": "c1d32f16-454b-301c-b710-34c3f48c2460",
                                                "text": "Opposer, dans un tableau, des bruns aux clairs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29d35e3a-dc2c-30cf-bb8f-1e5def2d31c6",
                                        "entry_id": "12e73da2-6e28-3327-b413-ad52fd447cce",
                                        "glosses": [
                                            "Placer une chose de manière qu’elle fasse obstacle à une autre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc9ba505-ff29-42bb-a3d1-d43d718906fd",
                                                "sense_id": "29d35e3a-dc2c-30cf-bb8f-1e5def2d31c6",
                                                "text": "On leur opposa des troupes fraîches, de nouvelles troupes."
                                            },
                                            {
                                                "example_id": "73d4bab2-1bad-47ec-9e85-2e3040fc4457",
                                                "sense_id": "29d35e3a-dc2c-30cf-bb8f-1e5def2d31c6",
                                                "text": "On lui opposa un dangereux adversaire."
                                            },
                                            {
                                                "example_id": "dbc56a9d-13e2-4deb-8249-61f30fbef0da",
                                                "sense_id": "29d35e3a-dc2c-30cf-bb8f-1e5def2d31c6",
                                                "text": "Opposer Aristote à Platon."
                                            },
                                            {
                                                "example_id": "5307e709-d268-44bf-9d8b-a3b7c40a86c6",
                                                "sense_id": "29d35e3a-dc2c-30cf-bb8f-1e5def2d31c6",
                                                "text": "Opposer une digue à l’impétuosité de la mer."
                                            },
                                            {
                                                "example_id": "1b7805a7-364d-451c-b846-61f76efba023",
                                                "sense_id": "29d35e3a-dc2c-30cf-bb8f-1e5def2d31c6",
                                                "text": "Opposer une batterie à une autre."
                                            },
                                            {
                                                "example_id": "a8a799f1-e0da-4679-8d8e-6ae8ed1b8e7c",
                                                "sense_id": "29d35e3a-dc2c-30cf-bb8f-1e5def2d31c6",
                                                "text": "— Vous mettrez en avant que…, mais à cela j’oppose que…"
                                            },
                                            {
                                                "example_id": "38c01cc3-4e46-44d6-ac3b-8cb5f640e061",
                                                "sense_id": "29d35e3a-dc2c-30cf-bb8f-1e5def2d31c6",
                                                "text": "— Il opposa de fortes raisons à tout ce qu’on lui avait dit."
                                            },
                                            {
                                                "example_id": "9c82ae6e-84b1-4b40-a9cc-90c4317c15ac",
                                                "sense_id": "29d35e3a-dc2c-30cf-bb8f-1e5def2d31c6",
                                                "text": "Opposer la force à la force."
                                            },
                                            {
                                                "example_id": "c39a6fed-20ab-4950-8f27-c852e916bdec",
                                                "sense_id": "29d35e3a-dc2c-30cf-bb8f-1e5def2d31c6",
                                                "text": "Opposer un obstacle aux entreprises de quelqu’un."
                                            },
                                            {
                                                "example_id": "509cdbb8-f226-4b9d-8d3a-5a0d18147e02",
                                                "sense_id": "29d35e3a-dc2c-30cf-bb8f-1e5def2d31c6",
                                                "text": "Opposer l’autorité d’Aristote à celle de Platon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87982d32-d2d7-3f43-8d4a-79bcdb88cd86",
                                        "entry_id": "12e73da2-6e28-3327-b413-ad52fd447cce",
                                        "glosses": [
                                            "Mettre en comparaison, en opposition ou en parallèle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d57c229f-b70d-43a5-b164-e67563013352",
                                                "sense_id": "87982d32-d2d7-3f43-8d4a-79bcdb88cd86",
                                                "text": "Une autre réponse, plus fréquente qu'on ne l’imagine, et que l’on oppose également, par exemple, à toute tentative de réforme progressive de l'orthographe : puisque nous en avons « bavé », il serait immoral que les générations qui nous suivent n'en bavassent point aussi."
                                            },
                                            {
                                                "example_id": "2221aa49-ea98-4bc0-9566-f572763ec6f7",
                                                "sense_id": "87982d32-d2d7-3f43-8d4a-79bcdb88cd86",
                                                "text": "Quels orateurs pouvait-on opposer à Cicéron, à Démosthène ? — Il y a peu de statues modernes qu’on puisse opposer aux statues antiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c332b52d-0fa8-3f3f-b5fc-c72b6a7abf9f",
                                        "entry_id": "12e73da2-6e28-3327-b413-ad52fd447cce",
                                        "glosses": [
                                            "Se mettre en opposition face à quelque chose ou à quelqu’un."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a279e414-e6db-4472-979a-a1fe865c6cbd",
                                                "sense_id": "c332b52d-0fa8-3f3f-b5fc-c72b6a7abf9f",
                                                "text": "Le soir était venu. Nicole frotta plusieurs allumettes sur le plancher ; mais l'humidité s’opposait à leur inflammation, […]."
                                            },
                                            {
                                                "example_id": "66ae769e-f9a5-440a-9cdc-f497a539d579",
                                                "sense_id": "c332b52d-0fa8-3f3f-b5fc-c72b6a7abf9f",
                                                "text": "S’opposer aussi. S’opposer d’abord. S’opposer sans donner le sentiment – comme nous le faisons trop souvent – d’avoir toujours besoin de nous justifier de notre rejet radical de la politique impulsée par la majorité actuelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46f18326-bad2-393a-98ab-f977dc37c7f5",
                                        "entry_id": "12e73da2-6e28-3327-b413-ad52fd447cce",
                                        "glosses": [
                                            "Déclarer suivant les formes judiciaires qu’on met empêchement à l’exécution de quelque acte, de quelque arrêt, de quelque formalité de justice."
                                        ],
                                        "tags": [
                                            "especially",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56d09e13-eca0-4caf-a5c0-07021f5c519f",
                                                "sense_id": "46f18326-bad2-393a-98ab-f977dc37c7f5",
                                                "text": "S’opposer à la levée des scellés, à un paiement, à un mariage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
