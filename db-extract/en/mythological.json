                "senses": [
                    {
                        "sense_id": "55034511-2568-384b-82a7-960aef871f9f",
                        "entry_id": "a73e9567-e7d0-38c3-baae-d9930a1bc0ca",
                        "glosses": [
                            "Of, or relating to myths or mythology."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3ba619ec-b0e8-40af-ae0b-5ed9a1e78669",
                                "sense_id": "55034511-2568-384b-82a7-960aef871f9f",
                                "text": "In short—to be mythological in my conclusion—the quiver of Cupid hangs at the girdle of Fate together with her spindle and scissors."
                            }
                        ]
                    },
                    {
                        "sense_id": "815c4dd8-2ed7-3f52-a7f4-bb627640e362",
                        "entry_id": "a73e9567-e7d0-38c3-baae-d9930a1bc0ca",
