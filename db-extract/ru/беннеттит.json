                        "examples": [
                            {
                                "example_id": "0b2fd1ee-2f35-4a69-81fd-9aa86c4554a2",
                                "sense_id": "f2f8a061-d71e-3b63-8f35-a8605e86321b",
                                "text": "У одних беннеттитов стебли были тонкие, ветвящиеся, у других — толстые, похожие на бочонок или несколько сросшихся ананасов."
                            },
                            {
                                "example_id": "c6bef569-f565-465f-8b7f-3be1b6f2f0e2",
                                "sense_id": "f2f8a061-d71e-3b63-8f35-a8605e86321b",
                                "text": "Наиболее богатые остатками беннеттитов слои обнаружены в Мексике."
                            }
                        ]
                    }
