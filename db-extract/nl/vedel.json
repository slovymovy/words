                "senses": [
                    {
                        "sense_id": "9f709072-8fcb-33c7-84b2-acdcaf5e73dd",
                        "entry_id": "6d1726fe-1cd2-34f8-859c-aa42ea0e9f08",
                        "glosses": [
                            "middeleeuws strijkinstrument met 3-5 darmsnaren, een ovale of peervormige romp (of klankkast), o-vormige klankgaten en aparte hals die een bladvormige kop bezat met rechtopstaande stemschroeven"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "fb10ee37-481b-423b-99fb-35a4de526e4b",
                                "sense_id": "9f709072-8fcb-33c7-84b2-acdcaf5e73dd",
                                "text": "De vedel is een voorloper van de huidige viool."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f5aec7e-a3bc-4cfa-b1ed-69af42d6c8b5",
                        "source_entry_id": "6d1726fe-1cd2-34f8-859c-aa42ea0e9f08",
                        "source_sense_id": "9f709072-8fcb-33c7-84b2-acdcaf5e73dd",
                        "source_sense_description": "middeleeuws, meestal vijfsnarig strijkinstrument",
                        "target_lang_word": "Fiedel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fiedel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7e037c4-cd63-33ed-9bf5-fa4f735b1da1",
                                        "entry_id": "0bbcc3e0-ce4a-3ea4-baee-c0a2a017a871",
                                        "glosses": [
                                            "mittelalterliches Streichinstrument, das als Vorläufer der Violine gilt"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d93eaa9-1031-4acd-927b-a8e8e4bbf300",
                                                "sense_id": "f7e037c4-cd63-33ed-9bf5-fa4f735b1da1",
                                                "text": "\"Neuerdings wird die Fiedel wieder gebaut, aber nicht immer streng nach histor. Vorbildern.\""
                                            },
                                            {
                                                "example_id": "221131c6-d30f-425c-acbc-a5ff5b546204",
                                                "sense_id": "f7e037c4-cd63-33ed-9bf5-fa4f735b1da1",
                                                "text": "\"Zupft die Fiedel, singt ein Liedel, lasst die Sorgen all' zu Haus! …\""
                                            },
                                            {
                                                "example_id": "17111310-f020-4bc7-b1bf-f4b563969005",
                                                "sense_id": "f7e037c4-cd63-33ed-9bf5-fa4f735b1da1",
                                                "text": "Die Fiedel ist das Hauptstreichinstrument des Mittelalters."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d3b8a566-406a-3f37-b296-dcbdda699ae5",
                                        "entry_id": "0bbcc3e0-ce4a-3ea4-baee-c0a2a017a871",
                                        "glosses": [
                                            "volkstümliche Bezeichnung für die Violine"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fed9123a-e621-4231-89e8-e592adb65bd8",
                                                "sense_id": "d3b8a566-406a-3f37-b296-dcbdda699ae5",
                                                "text": "„Nebenbei stopfte er Vögel aus und spielte auch zum Tanz auf; denn er versteht sich auf die Ziehharmonika und die Trompete und wird auch ganz gut mit der Fiedel fertig.“"
                                            },
                                            {
                                                "example_id": "c1010112-1ebe-4f5d-8d57-c2c98fb16244",
                                                "sense_id": "d3b8a566-406a-3f37-b296-dcbdda699ae5",
                                                "text": "„Aber den Mann mit der Fiedel wollte keiner hören noch ansehen, zudem waren alle Saiten auf seiner Fiedel dünn geworden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c2ffab5d-a632-3b89-b3b9-7e99efbbf9d4",
                                        "entry_id": "0bbcc3e0-ce4a-3ea4-baee-c0a2a017a871",
                                        "glosses": [
                                            "ein kleiner, meist belegter Happen Brot"
                                        ],
                                        "tags": [
                                            "Essen; regional",
                                            "ostmeißnisch",
                                            "südostmeißnisch",
                                            "osterzgebirgisch",
                                            "oberlausitzisch"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
