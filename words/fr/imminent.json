                    "frequency": "VeryLow",
                    "semantic_group_id": "temporel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce prince éclairé et <w>imminent</w> monarque rencontrait déjà les représentants des puissances voisines."
