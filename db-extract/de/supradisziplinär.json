                    },
                    {
                        "form_id": "4fba7246-1c9b-4ddd-9b37-daf351d83ac3",
                        "entry_id": "48489c61-97b7-3023-ab2e-e343d1757871",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind supradisziplinär"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a60b2361-6bd6-3550-a2d0-899c30d310e3",
                        "entry_id": "48489c61-97b7-3023-ab2e-e343d1757871",
                        "glosses": [
                            "außerhalb und oberhalb einer Fächergliederung beziehungsweise eines Fächerkanons stehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01bc4d46-16ea-48ea-9c7c-1b8473ae33bd",
                                "sense_id": "a60b2361-6bd6-3550-a2d0-899c30d310e3",
                                "text": "„Während sich der supradisziplinäre Unterricht als eine Art Fach über den Fächern etabliert, organisiert sich der interdisziplinäre Unterricht in der Kooperation der Fächer.“"
                            },
                            {
                                "example_id": "8b3fef53-a883-420f-8e89-99f78c307ff4",
                                "sense_id": "a60b2361-6bd6-3550-a2d0-899c30d310e3",
                                "text": "„Die meisten der hier publizierten Arbeiten sind deutlich inter- oder besser supradisziplinär ausgerichtet.“"
                            },
                            {
                                "example_id": "b2400792-f636-480e-ba65-abd6827372ed",
                                "sense_id": "a60b2361-6bd6-3550-a2d0-899c30d310e3",
                                "text": "„Er wollte damit Makro- und Mikroperspektive, Untersuchung und Veränderung, Außensicht und Innensicht sowie quantitative und qualitative Forschungspraxis supradisziplinär verbinden.“"
                            },
                            {
                                "example_id": "8ffe7d0b-0878-4b0f-a8a9-877e06dba5e2",
                                "sense_id": "a60b2361-6bd6-3550-a2d0-899c30d310e3",
                                "text": "„Die Allgemeine Systemtheorie bietet einen Ansatz, der supradisziplinär in Form einer allgemeinen Modelltheorie die Modelle zur empirischen Anreicherung und inhaltlichen Interpretation bereithält, der interdisziplinär einen empirischen einzelwissenschaftlichen Modelltransfer ermöglicht und ein terminologisches Basisvokabular als Integrationsfunktion zur Verfügung stellt.“"
                            },
                            {
                                "example_id": "3fa6cca1-49d1-42e6-a31f-5c87acf6386e",
                                "sense_id": "a60b2361-6bd6-3550-a2d0-899c30d310e3",
                                "text": "„Die literaturwissenschaftliche Forschung neuer Art wird nicht nur nicht oder nur in ganz besonders kulturelitärem Rahmen zur Kenntnis genommen, sondern kann supradisziplinär gar nicht mehr wirklich überzeugend zur Kenntnis gebracht werden – übrigens nicht einmal, ja vor allem nicht im normalen akademischen Unterricht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
