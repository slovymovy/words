{
    "word_family": [
        "powdery",
        "gunpowder",
        "powderpuff"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "97456c4a-1d65-329f-a70f-15020c28d199",
                    "sense_definition": "Fine dry particles produced by grinding, crushing, or disintegration.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "particles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recipe calls for a teaspoon of chili <w>powder</w> to add some heat.",
                            "target_lang_translations": {
                                "ru": "В рецепте требуется чайная ложка <w>порошка</w> чили для остроты.",
                                "fr": "La recette demande une cuillère à café de <w>poudre</w> de piment pour ajouter du piquant."
                            }
                        },
                        {
                            "text": "He crushed the aspirin tablet into a fine <w>powder</w> before mixing it with water.",
                            "target_lang_translations": {
                                "ru": "Он растолок таблетку аспирина в мелкий <w>порошок</w>, прежде чем смешать её с водой.",
                                "fr": "Il a écrasé le comprimé d'aspirine en une fine <w>poudre</w> avant de le mélanger à de l'eau."
                            }
                        }
                    ],
                    "common_phrases": [
                        "baking powder",
                        "chili powder",
                        "washing powder",
                        "milk powder",
                        "cocoa powder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мелкие сухие частицы, полученные путем размалывания, дробления или распада.",
                        "fr": "Particules sèches et fines obtenues par broyage, concassage ou désintégration."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порошок",
                                "target_lang_sense_clarification": "общее значение; лекарственный или пищевой"
                            },
                            {
                                "target_lang_word": "пудра",
                                "target_lang_sense_clarification": "очень мелкий порошок (сахарная, металлическая)"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "poudre",
                                "target_lang_sense_clarification": "substance solide broyée ou pilée"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd0d672f-d8b0-3b1f-918c-afc912ce6550",
                    "sense_definition": "A soft, dry substance applied to the skin, especially the face, to reduce shine or make it smooth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cosmetic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She applied some <w>powder</w> to her nose to stop it from shining.",
                            "target_lang_translations": {
                                "ru": "Она нанесла немного <w>пудры</w> на нос, чтобы он не блестел.",
                                "fr": "Elle a appliqué un peu de <w>poudre</w> sur son nez pour éviter qu'il ne brille."
                            }
                        },
                        {
                            "text": "Use baby <w>powder</w> to keep the infant's skin dry and comfortable.",
                            "target_lang_translations": {
                                "ru": "Используйте детскую <w>присыпку</w>, чтобы кожа младенца оставалась сухой и чувствовала себя комфортно.",
                                "fr": "Utilisez du <w>talc</w> pour garder la peau du nourrisson sèche et confortable."
                            }
                        }
                    ],
                    "common_phrases": [
                        "baby powder",
                        "face powder",
                        "talcum powder",
                        "powder room"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкое сухое вещество, наносимое на кожу, особенно на лицо, для устранения блеска или придания гладкости.",
                        "fr": "Substance sèche et douce appliquée sur la peau, notamment le visage, pour matifier ou lisser."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пудра",
                                "target_lang_sense_clarification": "косметическая"
                            },
                            {
                                "target_lang_word": "присыпка",
                                "target_lang_sense_clarification": "детская, гигиеническая"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "poudre",
                                "target_lang_sense_clarification": "produit cosmétique pour le visage"
                            },
                            {
                                "target_lang_word": "talc",
                                "target_lang_sense_clarification": "poudre hygiénique pour le corps ou les bébés"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71f808a1-6e25-3729-acc7-34935de06851",
                    "sense_definition": "An explosive substance used in guns or for blasting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "explosive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers had to keep their <w>powder</w> dry to ensure their muskets would fire.",
                            "target_lang_translations": {
                                "ru": "Солдаты должны были держать <w>порох</w> сухим, чтобы их мушкеты могли стрелять.",
                                "fr": "Les soldats devaient garder leur <w>poudre</w> au sec pour s'assurer que leurs mousquets tireraient."
                            }
                        },
                        {
                            "text": "A single spark could ignite the barrel of black <w>powder</w>.",
                            "target_lang_translations": {
                                "ru": "Одна искра могла воспламенить бочку с черным <w>порохом</w>.",
                                "fr": "Une seule étincelle pourrait enflammer le baril de <w>poudre</w> noire."
                            }
                        }
                    ],
                    "common_phrases": [
                        "black powder",
                        "gunpowder",
                        "powder keg"
                    ],
                    "target_lang_definitions": {
                        "ru": "Взрывчатое вещество, используемое в оружии или для взрывных работ.",
                        "fr": "Substance explosive utilisée dans les armes à feu ou pour les travaux de démolition."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порох",
                                "target_lang_sense_clarification": "взрывчатое вещество"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "poudre",
                                "target_lang_sense_clarification": "mélange explosif (ex: poudre à canon)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ceddd34-cec3-350e-9c1d-fa6547c117a1",
                    "sense_definition": "Fresh, light, dry snow that is loose and not packed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "snow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Skiers love the fresh <w>powder</w> found on the upper mountain slopes.",
                            "target_lang_translations": {
                                "ru": "Лыжники любят свежий <w>пухляк</w> на верхних склонах гор.",
                                "fr": "Les skieurs adorent la <w>poudreuse</w> fraîche sur les pentes supérieures de la montagne."
                            }
                        },
                        {
                            "text": "We spent the entire day skiing through deep <w>powder</w>.",
                            "target_lang_translations": {
                                "ru": "Мы провели весь день, катаясь по глубокому <w>пухляку</w>.",
                                "fr": "Nous avons passé toute la journée à skier dans une <w>poudreuse</w> profonde."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fresh powder",
                        "deep powder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свежий, легкий, сухой снег, который рыхлый и не слежавшийся.",
                        "fr": "Neige fraîche, légère et sèche, non tassée."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пухляк",
                                "target_lang_sense_clarification": "сленг лыжников"
                            },
                            {
                                "target_lang_word": "свежий снег",
                                "target_lang_sense_clarification": "рыхлый, мягкий"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "neige poudreuse",
                                "target_lang_sense_clarification": "terme technique pour la neige fraîche"
                            },
                            {
                                "target_lang_word": "poudreuse",
                                "target_lang_sense_clarification": "terme courant chez les skieurs"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "68708df4-4089-3cd5-baef-4910b284d8b2",
                    "sense_definition": "To cover or sprinkle a surface with a fine substance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "particles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef began to <w>powder</w> the cake with a layer of icing sugar.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар начал <w>припудривать</w> торт слоем сахарной пудры.",
                                "fr": "Le chef a commencé à <w>saupoudrer</w> le gâteau d'une couche de sucre glace."
                            }
                        },
                        {
                            "text": "Light snow began to <w>powder</w> the tops of the pine trees.",
                            "target_lang_translations": {
                                "ru": "Легкий снег начал <w>припорошить</w> верхушки сосен.",
                                "fr": "Une neige légère a commencé à <w>poudrer</w> la cime des pins."
                            }
                        }
                    ],
                    "common_phrases": [
                        "powder with sugar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать или посыпать поверхность мелким веществом.",
                        "fr": "Couvrir ou saupoudrer une surface avec une substance fine."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посыпать",
                                "target_lang_sense_clarification": "покрывать слоем чего-либо"
                            },
                            {
                                "target_lang_word": "припудрить",
                                "target_lang_sense_clarification": "слегка посыпать (напр. сахаром)"
                            },
                            {
                                "target_lang_word": "припорошить",
                                "target_lang_sense_clarification": "о снеге или пыли"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "saupoudrer",
                                "target_lang_sense_clarification": "répandre une substance en poudre sur quelque chose"
                            },
                            {
                                "target_lang_word": "poudrer",
                                "target_lang_sense_clarification": "recouvrir d'une fine couche"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30b9a364-c151-3adf-a9ce-5375a6fdf603",
                    "sense_definition": "To apply cosmetic powder to the face or body.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cosmetic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She excused herself from the table to go and <w>powder</w> her nose.",
                            "target_lang_translations": {
                                "ru": "Она извинилась и вышла из-за стола, чтобы <w>припудрить</w> носик.",
                                "fr": "Elle s'est excusée de table pour aller se <w>poudrer</w> le nez."
                            }
                        },
                        {
                            "text": "Actors must <w>powder</w> their faces to prevent glare under the bright studio lights.",
                            "target_lang_translations": {
                                "ru": "Актеры должны <w>пудрить</w> лица, чтобы предотвратить блики под ярким студийным светом.",
                                "fr": "Les acteurs doivent se <w>poudrer</w> le visage pour éviter les reflets sous les lumières vives du studio."
                            }
                        }
                    ],
                    "common_phrases": [
                        "powder one's nose"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наносить косметическую пудру на лицо или тело.",
                        "fr": "Appliquer de la poudre cosmétique sur le visage ou le corps."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пудрить",
                                "target_lang_sense_clarification": "наносить макияж"
                            },
                            {
                                "target_lang_word": "припудрить",
                                "target_lang_sense_clarification": "подправить макияж"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "se poudrer",
                                "target_lang_sense_clarification": "appliquer du maquillage en poudre"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c23e168-2eac-33ac-b5fd-660581139cef",
                    "sense_definition": "To crush or grind something into fine dry particles.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "particles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The industrial machine is designed to <w>powder</w> rocks into dust.",
                            "target_lang_translations": {
                                "ru": "Эта промышленная машина предназначена для того, чтобы <w>истирать в порошок</w> камни в пыль.",
                                "fr": "La machine industrielle est conçue pour <w>pulvériser</w> les roches en poussière."
                            }
                        },
                        {
                            "text": "You should <w>powder</w> the dried herbs before adding them to the mixture.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>растереть в порошок</w> сушеные травы перед добавлением их в смесь.",
                                "fr": "Vous devriez <w>réduire en poudre</w> les herbes séchées avant de les ajouter au mélange."
                            }
                        }
                    ],
                    "synonyms": [
                        "pulverize",
                        "grind",
                        "pound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дробить или размалывать что-либо в мелкие сухие частицы.",
                        "fr": "Écraser ou broyer quelque chose en fines particules sèches."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растирать в порошок",
                                "target_lang_sense_clarification": "измельчать до состояния пыли"
                            },
                            {
                                "target_lang_word": "измельчать",
                                "target_lang_sense_clarification": "дробить"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "pulvériser",
                                "target_lang_sense_clarification": "réduire en poudre fine"
                            },
                            {
                                "target_lang_word": "réduire en poudre",
                                "target_lang_sense_clarification": "action de broyer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c48c629-b0e1-3a88-98b8-293c464699aa",
                    "sense_definition": "To leave quickly or suddenly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "depart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When the police arrived, the suspect decided to <w>powder</w> immediately.",
                            "target_lang_translations": {
                                "ru": "Когда прибыла полиция, подозреваемый решил немедленно <w>смыться</w>.",
                                "fr": "Quand la police est arrivée, le suspect a décidé de <w>filer</w> immédiatement."
                            }
                        },
                        {
                            "text": "The party was getting boring, so we decided to <w>powder</w>.",
                            "target_lang_translations": {
                                "ru": "Вечеринка становилась скучной, поэтому мы решили <w>свалить</w>.",
                                "fr": "La fête devenait ennuyeuse, alors nous avons décidé de <w>filer</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "take a powder"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often used in the phrase 'take a powder'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро или внезапно уйти.",
                        "fr": "Partir rapidement ou soudainement."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смыться",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "сбежать",
                                "target_lang_sense_clarification": "покинуть место"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "filer",
                                "target_lang_sense_clarification": "partir vite (familier)"
                            },
                            {
                                "target_lang_word": "se carapater",
                                "target_lang_sense_clarification": "s'enfuir (familier)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2f6fca8c-2a57-3d87-86a2-2845872b8aca",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Powder</w> was known for his contributions to the local community.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Паудер</w> был известен своим вкладом в местное сообщество.",
                                "fr": "M. <w>Powder</w> était connu pour ses contributions à la communauté locale."
                            }
                        },
                        {
                            "text": "I met a woman named Sarah <w>Powder</w> at the conference.",
                            "target_lang_translations": {
                                "ru": "Я встретил женщину по имени Сара <w>Паудер</w> на конференции.",
                                "fr": "J'ai rencontré une femme nommée Sarah <w>Powder</w> à la conférence."
                            }
                        }
                    ],
                    "traits": [
                        {
