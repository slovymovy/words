                "senses": [
                    {
                        "sense_id": "0c3ec93d-afaa-3fcb-b50f-9c56cdceab77",
                        "entry_id": "7e6ee828-5c0c-398b-a174-4369bd20d401",
                        "glosses": [
                            "Deutschland"
                        ],
                        "tags": [
                            "Austrian German",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "37b91cca-c06c-45d9-99c3-fc01f93ffbe1",
                                "sense_id": "0c3ec93d-afaa-3fcb-b50f-9c56cdceab77",
                                "text": "„Und was, wenn im Tunnel vor der Kühlerhaube wie aus dem Nichts ein Blockwart auftaucht und den Fahrer aus dem Piefkeland rechts ran bittet?“"
                            },
                            {
                                "example_id": "4d3550cc-03c3-44fc-bfa0-05fc88e15bd2",
                                "sense_id": "0c3ec93d-afaa-3fcb-b50f-9c56cdceab77",
                                "text": "„In Wien hat man diesen Zungenschlag einfach – er ist ein Exportschlager ins „Piefkeland“, wo diese charmante Kantigkeit nicht wenig Fans hat.“"
                            },
                            {
                                "example_id": "c8e1900f-f38c-40e5-bf6b-e4da79d20cc7",
                                "sense_id": "0c3ec93d-afaa-3fcb-b50f-9c56cdceab77",
                                "text": "„Und in diesem Sinne liegt dann auch Bayern im Medaillenspiegel der Ski-WM vor Österreich, nicht Deutschland, erst recht nicht Piefkeland.“"
                            },
                            {
                                "example_id": "867a9778-0d19-4006-b12f-96912adea911",
                                "sense_id": "0c3ec93d-afaa-3fcb-b50f-9c56cdceab77",
                                "text": "„Von Norden, von Piefkeland her, frisst man sich durch eine Unzahl langer, finsterer Hochgebirgstunnel, bis sich die hochgradig wohllebige Region der Südweststeiermark auftut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
