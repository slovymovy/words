                "senses": [
                    {
                        "sense_id": "667a1759-57bf-3fdb-9d9f-5960c9cd99a5",
                        "entry_id": "37d39d27-f172-305c-b514-318035c49e2b",
                        "glosses": [
                            "meist ältere Autofahrer (aus Gegenden mit wenig Straßenverkehr), die sich nur langsam und unsicher fortbewegen"
                        ],
                        "tags": [
                            "derogatory",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "68fa6044-c3a8-407b-8e7d-cb3d4116fc10",
                                "sense_id": "667a1759-57bf-3fdb-9d9f-5960c9cd99a5",
                                "text": "Sieh dir diesen Hutfahrer da vorn an!"
                            },
                            {
                                "example_id": "a622b226-7f93-446e-a0a1-23fd44783040",
                                "sense_id": "667a1759-57bf-3fdb-9d9f-5960c9cd99a5",
                                "text": "Nicht nur Sitzriesen und Hutfahrer fühlen sich auf allen Plätzen wohl, der Chrysler-Van überzeugt auch beim Kofferraumvolumen (538 bis 3405 Liter) und den Detaillösungen."
                            },
                            {
                                "example_id": "9f199904-bf76-4c2d-95f4-34b517e87d25",
                                "sense_id": "667a1759-57bf-3fdb-9d9f-5960c9cd99a5",
                                "text": "Vorzüge wie der große Kofferraum, die selbst für Hutfahrer ausreichende Kopffreiheit auf allen Plätzen, die hohe Verarbeitungsqualität oder die variable Nutzung inklusive umklappbarem Beifahrersitz sind in einem unauffälligen Kleid versteckt."
                            },
                            {
                                "example_id": "e93698cd-ef39-4b07-81dc-81b8515f54f6",
                                "sense_id": "667a1759-57bf-3fdb-9d9f-5960c9cd99a5",
                                "text": "Nach anfänglichen Startproblemen kam Düringer immer besser auf Touren und ging mit voller Power über die ganze Renndistanz. So fordert er eine Änderung der Straßenverkehrsordnung in Bezug auf Hutfahrer und warnt eindringlich vor einem Gebrauchtwagenhändler namens \"Herr Jörg\"."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
