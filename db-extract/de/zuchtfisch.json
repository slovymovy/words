                "senses": [
                    {
                        "sense_id": "7da5ecf8-6a79-3c23-98b4-758b86a1e0cc",
                        "entry_id": "f250c3e8-fc12-3c5b-934a-0327652d0694",
                        "glosses": [
                            "Fisch, der aus einer Fischzucht stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec140d97-2234-43c4-a7f2-427d7890c490",
                                "sense_id": "7da5ecf8-6a79-3c23-98b4-758b86a1e0cc",
                                "text": "„Einst als Heiligabendessen schlechthin betrachtet (zur aktuellen Jahreszeit ja auch gerne Weihnachtskarpfen genannt), wurde der sanftmütige heimische Zuchtfisch inzwischen von den Festtagstischen bedauerlicherweise weitgehend verdrängt.“"
                            },
                            {
                                "example_id": "7f1c355a-44f7-4eb4-8092-b82cc4912c4d",
                                "sense_id": "7da5ecf8-6a79-3c23-98b4-758b86a1e0cc",
                                "text": "„Insgesamt sechsmal vergaben die Tester für den frischen Zuchtfisch die Note \"gut\" und einmal die Note \"befriedigend\".“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
