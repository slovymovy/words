                "senses": [
                    {
                        "sense_id": "eafd1231-7d24-3238-bd08-13aa1da57303",
                        "entry_id": "fecc548d-d922-32ac-aecd-b8c0f8a507af",
                        "glosses": [
                            "Besonderheit/Selbstständigkeit der eigenen Sprache gegenüber anderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee944165-8e67-4065-aa91-d618fbfac2af",
                                "sense_id": "eafd1231-7d24-3238-bd08-13aa1da57303",
                                "text": "„So richtig seine erste Feststellung ist, so problematisch ist seine Behauptung, die DDR-Regierung habe tatsächlich ernstlich die Eigenstaatlichkeit durch eine Eigensprachlichkeit »untermauern« wollen.“"
                            },
                            {
                                "example_id": "234d4147-1940-4764-91a2-d92cf14a4502",
                                "sense_id": "eafd1231-7d24-3238-bd08-13aa1da57303",
                                "text": "„In Galicien zum Beispiel verhinderte die Eigensprachlichkeit in Verbindung mit wirtschaftlicher Unterentwicklung eine Identifizierung mit dem Zentralstaat.“"
                            },
                            {
                                "example_id": "1c18e754-9383-4f9b-9bb1-9d36eafdcc8d",
                                "sense_id": "eafd1231-7d24-3238-bd08-13aa1da57303",
                                "text": "„Aber diese und andere Beispiele markieren zugleich den Übergang von den stilistischen Ungewöhnlichkeiten, die als Fiktionalitätssignale fungieren, zur Eigensprachlichkeit des Poetischen, zur dichterischen Sprachautonomie.“"
                            },
                            {
                                "example_id": "07fceb14-9f7d-4fc4-ad7b-67f2415e62c9",
                                "sense_id": "eafd1231-7d24-3238-bd08-13aa1da57303",
                                "text": "„Wohl nicht zuletzt deswegen, weil der Mythos von der Eigensprachlichkeit des Niederdeutschen auch bei der Deutung und Wertung von Literatur zu ihrer „Überhöhung“ verführen kann [2].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
