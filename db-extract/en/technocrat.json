            {
                "entry_id": "6b9185e7-570a-39bc-b0ac-70b3cbb5295f",
                "word": "technocrat",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6b262285-df1e-4a91-b877-ce91612bd532",
