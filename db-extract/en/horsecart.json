                                "target_senses": [
                                    {
                                        "sense_id": "9ee47acb-8008-3740-af68-fdcbd708a988",
                                        "entry_id": "2fa9a022-3a8f-3134-a982-358d06177092",
                                        "glosses": [
                                            "Wagen, der von einem oder mehreren Pferden gezogen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "439be415-56b2-4cbf-a4de-72279fa270a2",
                                                "sense_id": "9ee47acb-8008-3740-af68-fdcbd708a988",
                                                "text": "Wir fuhren das Gemüse mit dem Pferdewagen zum Markt."
                                            },
                                            {
                                                "example_id": "1f1b011d-5041-47ee-8ad6-d04334cc692a",
                                                "sense_id": "9ee47acb-8008-3740-af68-fdcbd708a988",
                                                "text": "„So macht sich eine Kolonne von fünfzehn Pferdewagen mit deutschen Frauen und Kindern bewacht von Soldaten der Roten Armee auf den Weg in Richtung Groß Döbern.“"
                                            },
                                            {
                                                "example_id": "58fe79e6-3231-4a7c-a052-e0acb5c6df4f",
                                                "sense_id": "9ee47acb-8008-3740-af68-fdcbd708a988",
                                                "text": "„Sie hätten sich wohl noch tagelang so quälen müssen, wäre nicht Bauer Kämper, der sein Holz mit seinen beiden erwachsenen Söhnen schon nach Hause gebracht hatte, am dritten Tag mit seinem Pferdewagen gekommen.“"
                                            },
                                            {
                                                "example_id": "54167dcf-27aa-4467-b6d4-481fb276da17",
                                                "sense_id": "9ee47acb-8008-3740-af68-fdcbd708a988",
                                                "text": "„Drei Tage dauerte die Fahrt im Pferdewagen; für damalige Verhältnisse eine weite, umständliche Reise.“"
                                            },
                                            {
                                                "example_id": "11bf8d9c-044a-446e-b8f9-b990a761bf25",
                                                "sense_id": "9ee47acb-8008-3740-af68-fdcbd708a988",
                                                "text": "„Über die Place de la Concorde zockeln Pferdewagen, und die werden von den nur wenig schnelleren Velotaxis überholt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
