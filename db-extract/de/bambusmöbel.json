                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94d8c924-9f77-4405-876a-939dcc6f6c54",
                                "sense_id": "17c4abc5-b1a0-34fb-aa50-5faab720c587",
                                "text": "„Die staubigen Wege, die Strohdächer, der gestampfte Erdboden in den Hütten und die einfachen Bambusmöbel, die Schweineställe mit den echten, leise im Dunkeln herumschnüffelnden Schweinen, das Gackern der unschuldigen Hühner, die suppige Luft, die stechenden Moskitos, das platschende Geräusch, als mein argloser Fuß in einen Matschkuchen Büffeldung trat — all das stürzte mich in einen Schwindel aus Trauer und Verlangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
