                {
                    "sense_id": "362a70f4-baad-345a-83c0-f68546d5e6c5",
                    "sense_definition": "freundliche Grußformel bei der Begegnung mit anderen Personen",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "begruessung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Hallo</w>, wie geht es dir heute an diesem schönen Morgen?"
                        },
                        {
                            "text": "Wenn Peter seine Nachbarn sieht, ruft er ihnen immer freundlich ein <w>Hallo</w> zu."
                        }
                    ],
                    "antonyms": [
                        "tschüss",
                        "auf Wiedersehen",
                        "ade"
                    ],
