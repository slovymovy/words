                "senses": [
                    {
                        "sense_id": "2e71ba64-df27-3064-aacb-554c24111e2c",
                        "entry_id": "c550f690-0459-3cca-9d14-7f316f171ea4",
                        "glosses": [
                            "Raum, in dem ein Luftaustausch oder auch der Lufttransport stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19885171-a359-494c-b0ef-c5152912deda",
                                "sense_id": "2e71ba64-df27-3064-aacb-554c24111e2c",
                                "text": "„Bei geschlossenem Fenster lassen sie gezielt Frischluft in die Lüftungskammern ein, die sich aufgrund der hier vorhandenen mittleren Temperatur erwärmt.“"
                            },
                            {
                                "example_id": "921669a3-af52-464c-a0aa-065d021c1bcf",
                                "sense_id": "2e71ba64-df27-3064-aacb-554c24111e2c",
                                "text": "„Die Lüftungskammer wird durch Einsetzen von runden Passscheiben aus stranggepresstem Polystyren gebildet.“"
                            },
                            {
                                "example_id": "63a017e4-fccc-44b2-8144-c4f63f2a1af7",
                                "sense_id": "2e71ba64-df27-3064-aacb-554c24111e2c",
                                "text": "„Bei geschlossenem Fenster lassen sie permanent Frischluft durch die Lüftungskammern ein - ohne Windgeräusche oder Lärmbelästigung.“"
                            },
                            {
                                "example_id": "73983c54-aeab-466d-9395-337f8ec54b3b",
                                "sense_id": "2e71ba64-df27-3064-aacb-554c24111e2c",
                                "text": "„Andere Ventile verwenden die Öffnung auf andere Art und Weise, z.B. handelt es sich manchmal um eine Lüftungskammer zwischen den Profildichtungen.“"
                            },
                            {
                                "example_id": "af662a68-7cf1-45b4-809a-20f41944fdb3",
                                "sense_id": "2e71ba64-df27-3064-aacb-554c24111e2c",
                                "text": "„Mit Hilfe von Tauchpumpen und Wassersaugern werden die Lüftungskammern während und nach dem Reinigungsprozess komplett gesäubert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
