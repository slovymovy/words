                "senses": [
                    {
                        "sense_id": "3cb908ae-ea48-3f77-a92d-a994f2482f9b",
                        "entry_id": "dcb5598c-3199-3ade-b4bb-471b848a7a58",
                        "glosses": [
                            "разновидность фитинга, предназначенная для закрытия концевых отверстий"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "268b775d-5b14-4221-bd1a-c6ffb011aac4",
                        "source_entry_id": "dcb5598c-3199-3ade-b4bb-471b848a7a58",
                        "source_sense_id": "3cb908ae-ea48-3f77-a92d-a994f2482f9b",
                        "target_lang_word": "bouchon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bouchon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1bb82bf-0b60-363b-b606-ce2aef76aded",
                                        "entry_id": "94871a7f-0ab9-349e-b078-d10192237108",
                                        "glosses": [
                                            "Objet qui sert à boucher, en particulier des bouteilles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c99c8dcc-f876-492f-9c3f-ad3a2362a859",
                                                "sense_id": "a1bb82bf-0b60-363b-b606-ce2aef76aded",
                                                "text": "J’ai oublié de remettre le bouchon du réservoir d’essence."
                                            },
                                            {
                                                "example_id": "a0beb166-767a-444d-9009-70f2fffb08cb",
                                                "sense_id": "a1bb82bf-0b60-363b-b606-ce2aef76aded",
                                                "text": "Bouchon de bois, de papier, de filasse, de verre, de cristal."
                                            },
                                            {
                                                "example_id": "45cd2be8-6089-4a00-b3a9-b4d1edd1a36c",
                                                "sense_id": "a1bb82bf-0b60-363b-b606-ce2aef76aded",
                                                "text": "Une bouteille de champagne trempe dans un seau de glace qu’il a pris lui-même chez le limonadier d’à côté. Tout en achevant de s’habiller, il la débouche soigneusement, évitant le bruit de bouchon qui saute, qu’on lui a appris à trouver vulgaire, remplit son verre à dents du liquide qui pétille, et froidement, délibérément, le vide, le remplit à nouveau, et recommence jusqu’à ce que toute la bouteille y passe."
                                            },
                                            {
                                                "example_id": "9c1e0187-4868-4e76-a155-24fd9b55f7f3",
                                                "sense_id": "a1bb82bf-0b60-363b-b606-ce2aef76aded",
                                                "text": "Aloïse se pencha, attrapa la bouteille de mirabelle sur la table, fit sauter le bouchon d'un coup de pouce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee2bcb05-80f5-3381-8612-4168156958c8",
                                        "entry_id": "94871a7f-0ab9-349e-b078-d10192237108",
                                        "glosses": [
                                            "Quantité correspondant au contenu d’un bouchon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53960de7-07e0-4a7c-8265-af7ae393d87d",
                                                "sense_id": "ee2bcb05-80f5-3381-8612-4168156958c8",
                                                "text": "La veille, préparez la crème achta libanaise en mélangeant un 1/2 L de lait entier, 40 g de maïzena, un bouchon d’eau de fleur d’oranger, un bouchon d’eau de rose et un peu de sucre en poudre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c8cc954-07ec-3f77-843d-98e40fc19f69",
                                        "entry_id": "94871a7f-0ab9-349e-b078-d10192237108",
                                        "glosses": [
                                            "Flotteur d’une ligne de pêche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e974b6b-e1dd-44eb-814c-bef72c28f6d6",
                                                "sense_id": "9c8cc954-07ec-3f77-843d-98e40fc19f69",
                                                "text": "Toutes les fois que l'hameçon doit être maintenu entre deux eaux, l'emploi d'un flotteur destiné à le soutenir est nécessaire ; mais, d'un autre côté, la mobilité extrême de ces flotteurs leur faisant déceler la plus petite oscillation imprimée à l'appât, on a bien vite profité de ce concours et l'on emploie des flottes ou bouchons même pour le cas où l'hameçon traîne sur le fond."
                                            },
                                            {
                                                "example_id": "3108563d-eb32-4bb7-aea4-12e896dd6a5d",
                                                "sense_id": "9c8cc954-07ec-3f77-843d-98e40fc19f69",
                                                "text": "Voyez-vous, la patronne, il y a les gens comme Ségard qui sont dans la vie comme des bouchons sur un fleuve."
                                            },
                                            {
                                                "example_id": "5713d6b3-e68c-4329-bb84-d265ffa4d48a",
                                                "sense_id": "9c8cc954-07ec-3f77-843d-98e40fc19f69",
                                                "text": "Le Meunier continuait de surveiller son bouchon qui nageotait, hésitant à plonger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "332f4a90-7f68-333a-8913-b872980793b1",
                                        "entry_id": "94871a7f-0ab9-349e-b078-d10192237108",
                                        "glosses": [
                                            "Ce qui obstrue une voie de circulation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f86582d7-1f6c-4fac-8be3-2c0a7516ed4e",
                                                "sense_id": "332f4a90-7f68-333a-8913-b872980793b1",
                                                "text": "On signale plusieurs kilomètres de bouchon sur l’autoroute des vacances."
                                            },
                                            {
                                                "example_id": "2f34f6aa-893d-4fca-8f81-690b73cb004c",
                                                "sense_id": "332f4a90-7f68-333a-8913-b872980793b1",
                                                "text": "Pour calculer le montant des heures perdues par les usagers de la route à partir des volumes d’encombrement, il est nécessaire d’estimer le nombre de véhicules qui se trouvent dans un kilomètre de bouchon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ab08dfe-1506-319b-9cdd-c2711aad05bf",
                                        "entry_id": "94871a7f-0ab9-349e-b078-d10192237108",
                                        "glosses": [
                                            "Ce qui obstrue un tuyau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "820f97b0-7831-482c-b0d4-871cf175b194",
                                                "sense_id": "6ab08dfe-1506-319b-9cdd-c2711aad05bf",
                                                "text": "Pour nous, un béton facilement pompable est un béton qui ne forme pas de bouchons lors du pompage (et non pas celui qui se pompe à faible pression)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f47152a-3fd9-3ce0-9ca1-978cd1f0361e",
                                        "entry_id": "94871a7f-0ab9-349e-b078-d10192237108",
                                        "glosses": [
                                            "Phénomène qui empêche ou ralentit le libre accomplissement d'un grand nombre d'actions ayant des destinations apparentées."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95b823bb-9371-4a62-80fb-2383f3d185ea",
                                                "sense_id": "0f47152a-3fd9-3ce0-9ca1-978cd1f0361e",
                                                "text": "J'ai ensuite demandé à Marie-Eve Trudel d'écrire sur le bouchon de diffusion dans le théâtre, des créations ne trouvant pas d'issue dans les salles, dans le contexte post-pandémique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a115bb6-4649-3eda-910a-6491e46dcc26",
                                        "entry_id": "94871a7f-0ab9-349e-b078-d10192237108",
                                        "glosses": [
                                            "Adaptateur USB destiné aux communications sans-fil (wifi, Bluetooth, infrarouge)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d61903c6-d04a-3745-8e50-d5ac59ecfce6",
                                        "entry_id": "94871a7f-0ab9-349e-b078-d10192237108",
                                        "glosses": [
                                            "Poignée de paille, ou de foin, tortillée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53ac4a18-5dbe-46a7-8741-4baf82198e9e",
                                                "sense_id": "d61903c6-d04a-3745-8e50-d5ac59ecfce6",
                                                "text": "Faire un bouchon de paille pour frotter un cheval."
                                            },
                                            {
                                                "example_id": "008ca318-c927-4512-a257-ac59b7cc852f",
                                                "sense_id": "d61903c6-d04a-3745-8e50-d5ac59ecfce6",
                                                "text": "Mettre un bouchon de paille à la queue d’un cheval pour indiquer qu’il est à vendre."
                                            },
                                            {
                                                "example_id": "73da28a5-a2bb-4f7b-94b8-77febed327be",
                                                "sense_id": "d61903c6-d04a-3745-8e50-d5ac59ecfce6",
                                                "text": "Quand je revins la terrine était pleine d’une belle bouillie jaunâtre, et mère Barberin frottait avec un bouchon de foin vigoureusement la poêle à frire."
                                            },
                                            {
                                                "example_id": "214f1247-9bd9-40d6-8d16-5b37b3acfc83",
                                                "sense_id": "d61903c6-d04a-3745-8e50-d5ac59ecfce6",
                                                "text": "L'écrivain (Michelet], dans son enfance, entendait les vieux soldats raconter que lorsqu'arrivaient les conscrits bretons, ils les menaient à la fontaine et les frottaient vigoureusement avec un bouchon de paille avant de les admettre à la chambrée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3a1b9d6-69af-3144-8c63-0d5ce11ed9c3",
                                        "entry_id": "94871a7f-0ab9-349e-b078-d10192237108",
                                        "glosses": [
                                            "Tas, paquet de linge, ou de vêtements, froissés, chiffonnés, tortillés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea341650-d2b5-4513-bbaa-6041bdd19ac6",
                                                "sense_id": "e3a1b9d6-69af-3144-8c63-0d5ce11ed9c3",
                                                "text": "Un bouchon de linge."
                                            },
                                            {
                                                "example_id": "f76e1d6b-5fe6-4883-a68c-fb05a3a2ec1b",
                                                "sense_id": "e3a1b9d6-69af-3144-8c63-0d5ce11ed9c3",
                                                "text": "Mettre du linge en bouchon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8246bbb7-f87c-38d4-a159-294a4d8f6f87",
                                        "entry_id": "94871a7f-0ab9-349e-b078-d10192237108",
                                        "glosses": [
                                            "Rameau de verdure, couronne de lierre ou quelque autre signe qu’on attache à une maison pour faire connaître qu’on y vend du vin."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ee217ba-e1c1-4cb5-9fc0-41bb97051aa9",
                                                "sense_id": "8246bbb7-f87c-38d4-a159-294a4d8f6f87",
                                                "text": "Un bouchon de cabaret."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51c4d79d-f9ff-395e-99bd-6ee75bec2ad1",
                                        "entry_id": "94871a7f-0ab9-349e-b078-d10192237108",
                                        "glosses": [
                                            "Restaurant ; auberge ; cabaret."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b23f9b85-02fc-4045-ad94-072dc06a899f",
                                                "sense_id": "51c4d79d-f9ff-395e-99bd-6ee75bec2ad1",
                                                "text": "Amis, il faut faire une pause,\nJ'aperçois l'ombre d'un bouchon,\nBuvons à l'aimable Fanchon,\nChantons pour elle quelque chose."
                                            },
                                            {
                                                "example_id": "572e18a8-511c-41c1-a534-2d91814e6cc9",
                                                "sense_id": "51c4d79d-f9ff-395e-99bd-6ee75bec2ad1",
                                                "text": "Je vous conduirais bien encore à l’auberge… mais il n’y en a point. Je vais vous mener tout droit chez la mère Guite, qui a un fameux bouchon, et où vous ne manquerez de rien."
                                            },
                                            {
                                                "example_id": "0ab758d0-3d58-4136-adeb-f6bd10cdec96",
                                                "sense_id": "51c4d79d-f9ff-395e-99bd-6ee75bec2ad1",
                                                "text": "Jusque-là, uniquement occupé à des fantaisies de destruction, le général n’avait point eu le temps de songer à faire garder le camp, autrement que par un petit poste établi à un kilomètre de Bellomer, sur la route de Chartres, dans un bouchon fréquenté des rouliers."
                                            },
                                            {
                                                "example_id": "c817ff51-f5be-4c97-b6f2-2b83f1810706",
                                                "sense_id": "51c4d79d-f9ff-395e-99bd-6ee75bec2ad1",
                                                "text": "Puis le bout de cette rue était bruyant, il y avait des cabarets, « des bouchons, » comme on disait, avec un trognon d’arbre, un paquet de branches, pour servir d’enseigne. Il sortait de ces bouchons un bruit de querelles, un goût de vin qui me montait au cerveau, m’irritait les sens et me faisait plus joyeux et plus fort."
                                            },
                                            {
                                                "example_id": "a7cdc36e-beaa-4cfa-bccd-c3edd3cdd732",
                                                "sense_id": "51c4d79d-f9ff-395e-99bd-6ee75bec2ad1",
                                                "text": "A onze heures il arrivait à Fresnay-les-Chaumes, déjeunait à l’unique bouchon de ce hameau de Pithiviers-le-Vieil, d'un chanteau de pain bis et d'un hareng saur, additionnés d'un petit vin du pays qui lui fit faire une de ces grimaces !"
                                            },
                                            {
                                                "example_id": "15ce8b18-3856-433e-93da-42f986179622",
                                                "sense_id": "51c4d79d-f9ff-395e-99bd-6ee75bec2ad1",
                                                "text": "À dater de ce jour, Cacaine ne travailla plus et […] hanta fort régulièrement les divers bouchons de la commune, proclamant sur tous les tons que les indigènes de Velrans n’étaient que des sauvages […]"
                                            },
                                            {
                                                "example_id": "101fe057-21b9-481b-a13f-2fc8261bbf55",
                                                "sense_id": "51c4d79d-f9ff-395e-99bd-6ee75bec2ad1",
                                                "text": "Comme il y avait sur le rivage un bouchon, il voulut nous y rendre notre politesse et nous offrit tout de suite son éternelle bouteille de vin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41c5258d-89b2-37ad-8ef8-b68bc90ad5f8",
                                        "entry_id": "94871a7f-0ab9-349e-b078-d10192237108",
                                        "glosses": [
                                            "Petite bouchée de viande de porc entourée de nouilles cuites à la vapeur que l’on sert généralement en tant qu’apéritif chaud dans certaines îles de l’océan Indien et notamment sur l’île de La Réunion."
                                        ],
                                        "tags": [
                                            "La Réunion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12e24b39-81ed-471b-be37-f7663542cbe4",
                                                "sense_id": "41c5258d-89b2-37ad-8ef8-b68bc90ad5f8",
                                                "text": "À l’instar de beaucoup d’autres, la cuisine des îles accuse les coups d’une certaine « américanisation » (à titre d’exemple, à La Réunion aujourd’hui, un « sandwich américain » est un bout de baguette tartiné de mayonnaise, qui contient des bouchons, sorte de dim sum, le tout grillé et recouvert de fromage fondu – sans commentaire)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f145948-e8a5-3597-8308-b5d6deb28434",
                                        "entry_id": "94871a7f-0ab9-349e-b078-d10192237108",
                                        "glosses": [
                                            "Terme d'affection à l'égard d'un enfant ou d'une jeune fille"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8066285-a3fe-4a5e-9275-d549329faa49",
                                                "sense_id": "0f145948-e8a5-3597-8308-b5d6deb28434",
                                                "text": "C'est un joli petit bouchon qui nous réjouit fort : cela n'aura vingt ans que dans deux ans d'ici."
                                            },
                                            {
                                                "example_id": "efecdb4e-bd45-44dc-9958-5cf69415af44",
                                                "sense_id": "0f145948-e8a5-3597-8308-b5d6deb28434",
                                                "text": "Donne-le moi, mon bouchon, je vais t'arranger ça. Depuis le temps qu'on se connait, je peux bien te faire ça."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "948691a0-d85c-3e4c-a361-3d6ced0bab3a",
                                        "entry_id": "94871a7f-0ab9-349e-b078-d10192237108",
                                        "glosses": [
                                            "Buisson."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae2cdc4b-7092-321d-87fa-44a48f618992",
                                        "entry_id": "94871a7f-0ab9-349e-b078-d10192237108",
                                        "glosses": [
                                            "Plaquage rugueux, violent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3b214ae-b344-465e-a842-55c9774ac67c",
                                                "sense_id": "ae2cdc4b-7092-321d-87fa-44a48f618992",
                                                "text": "Mettre un bouchon, coller un bouchon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dd71c73-fcbd-34c9-be14-9ff3cf679266",
                                        "entry_id": "94871a7f-0ab9-349e-b078-d10192237108",
                                        "glosses": [
                                            "Code qui n'effectue aucun traitement et retourne toujours le même résultat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bouchon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b65d32a3-0cef-3899-8344-4e2eee17666d",
                                        "entry_id": "7d1ea052-1035-372d-a4f2-e105ea374eb4",
                                        "glosses": [
                                            "Autre nom du cochonnet."
                                        ],
                                        "tags": [
                                            "Pétanque"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2544c2b2-4fe6-432a-83b6-e114b1525b97",
                                                "sense_id": "b65d32a3-0cef-3899-8344-4e2eee17666d",
                                                "text": "Le but (également appelé « petit », « bouchon » ou « cochonnet ») : sphère de bois de laquelle les joueurs essaient de se rapprocher. Le but est traditionnellement en buis ou de couleur fluo."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9316f155-acca-4753-9146-dfac2006b04a",
                        "source_entry_id": "dcb5598c-3199-3ade-b4bb-471b848a7a58",
                        "source_sense_id": "3cb908ae-ea48-3f77-a92d-a994f2482f9b",
                        "target_lang_word": "obturateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obturateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "83b4b16d-f412-3085-ac47-6b9b1d3f9060",
                                        "entry_id": "5bfdbf77-a632-3695-8c3b-fcc14a1ef1c7",
                                        "glosses": [
                                            "Pièce, appareil qui sert à fermer, à boucher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86a003ef-99e0-4889-8c10-cf66111f9d9f",
                                                "sense_id": "83b4b16d-f412-3085-ac47-6b9b1d3f9060",
                                                "text": "L’obturateur d’un canon, d’une conduite d’eau."
                                            },
                                            {
                                                "example_id": "0e2a6f08-4749-494f-abb9-beb12e72bd50",
                                                "sense_id": "83b4b16d-f412-3085-ac47-6b9b1d3f9060",
                                                "text": "L’ennemi se servait aussi de points lumineux appliqués par un système très simple. Au moyen d’écrans qui cachaient ou laissaient passer la lumière, il produisait des éclipses plus ou moins longues. Le premier obturateur, par exemple, masquait un verre blanc et le second un verre rouge. Les couleurs émises et la durée de l’émission suffisaient pour constituer une sorte d’alphabet analogue à celui employé dans la télégraphie électrique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "287ec8a3-6dea-3210-a021-b8229e9ed11d",
                                        "entry_id": "5bfdbf77-a632-3695-8c3b-fcc14a1ef1c7",
                                        "glosses": [
                                            "Plaque de verre que l’on met sous les cloches remplies de gaz ou de liquide, pour les fermer hermétiquement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "78f4f248-a3b6-370d-90c2-d150bb68c3b6",
                                        "entry_id": "5bfdbf77-a632-3695-8c3b-fcc14a1ef1c7",
                                        "glosses": [
                                            "Appareil qui normalement masque la surface sensible (film, capteur) et qui ne la découvre que pendant le temps de pose voulu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "272a0e97-1123-4c0e-a2df-377236b22189",
                                                "sense_id": "78f4f248-a3b6-370d-90c2-d150bb68c3b6",
                                                "text": "La mise au point et la vitesse de l’obturateur (qu’on placera de préférence près de la plaque) se détermineront par quelques essais préalables ; s’il y avait surexposition avec la vitesse la plus grande, on diaphragmerait tout simplement."
                                            },
                                            {
                                                "example_id": "14d68fa0-7188-4b17-a979-4107587164a7",
                                                "sense_id": "78f4f248-a3b6-370d-90c2-d150bb68c3b6",
                                                "text": "Pour évaluer exactement les temps de pose, il est indispensable de pouvoir déterminer ou vérifier les vitesses des obturateurs.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7811773d-155a-3d41-b53f-2989978e2e04",
                                        "entry_id": "5bfdbf77-a632-3695-8c3b-fcc14a1ef1c7",
                                        "glosses": [
                                            "Plaque d’or ou d’argent destinée à fermer une ouverture accidentelle à la voûte du palais, aux os du crâne, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
