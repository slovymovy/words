        "fr-extract.jsonl": [
            {
                "entry_id": "aa05925e-4d1f-30bc-a0ca-a4b331c73e7b",
                "word": "Cesse",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dd2fb665-0101-320e-816e-3e8ef1b66973",
                        "entry_id": "aa05925e-4d1f-30bc-a0ca-a4b331c73e7b",
                        "glosses": [
                            "Commune française du département de la Meuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d7e2a47-0002-45d7-a8a0-9eccbc746162",
                                "sense_id": "dd2fb665-0101-320e-816e-3e8ef1b66973",
                                "text": "M. Lefebvre Gineau prononce un long discours sur le cinquième projet, qui a pour but de réunir la commune de Cesse (Ardennes) au canton de Stenay (Meuse). Il ne propose aucun amendement; […]. Ce projet est adopté par 215 voix contre 3."
                            },
                            {
                                "example_id": "3b8416fa-478e-4b9b-b638-a9efe9ca897a",
                                "sense_id": "dd2fb665-0101-320e-816e-3e8ef1b66973",
                                "text": "A partir de l'échange de Vesly sur Aisne contre Mouzon, échange conclu, en 1379, au profit de la France, Cesse, appendice extrême du Mosomois, Cesse, village enclavé aux portes de Stenay, dans les terres chino-barro-lotharingiennes, Cesse avait subi les chances désastreuses de sa périlleuse situation. Au point de vue spirituel, comme le prieuré de Dun, celui de Cesse se trouvait rayé du Pouillé de Rheims, et le calvinisme l'avait envahi : au point de vue social, complétement ruiné, de 1589 à 1595, dans les incursions de Turenne contre les Guisards de la ligue concentrés autour de Jametz, Cesse était désert à la fin du seizième siècle; ses habitants avaient fui...[…]."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b30a7109-03c4-3882-829e-5b924ec03902",
                "word": "Cesse",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "70789190-6720-34b4-b629-f12544e1da00",
                        "entry_id": "b30a7109-03c4-3882-829e-5b924ec03902",
                        "glosses": [
                            "Rivière du bas Languedoc (France), affluent de l'Aude sur sa rive gauche."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "0a3d6f0d-0776-3b98-af9c-31d19bd7003f",
                "word": "cesse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b5067f53-1469-38dd-ae32-8ced2a0b8c45",
                        "entry_id": "0a3d6f0d-0776-3b98-af9c-31d19bd7003f",
                        "glosses": [
                            "Fin, relâche."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "70ce8359-a17a-488b-b74c-efd002925348",
                                "sense_id": "b5067f53-1469-38dd-ae32-8ced2a0b8c45",
                                "text": "Sa haine contre vous n'aurait jamais de cesse."
                            },
                            {
                                "example_id": "a77642ab-0991-46aa-95c4-41b670954d7a",
                                "sense_id": "b5067f53-1469-38dd-ae32-8ced2a0b8c45",
                                "text": "Ô cruauté du sort qui n'a jamais de cesse !"
                            },
                            {
                                "example_id": "ba1c297c-a09d-400e-8ccf-e17e0ef3fda4",
                                "sense_id": "b5067f53-1469-38dd-ae32-8ced2a0b8c45",
                                "text": "L'esprit [le démon] s’en va, n'a point de cesse\nQu'il n'ait mis le fil sous la presse."
                            },
                            {
                                "example_id": "2a556292-5ff7-4305-840e-592a30a07565",
                                "sense_id": "b5067f53-1469-38dd-ae32-8ced2a0b8c45",
                                "text": "Point de cesse, point de relâche."
                            },
                            {
                                "example_id": "876c9daa-242b-4d34-917f-7374c9f6bc6a",
                                "sense_id": "b5067f53-1469-38dd-ae32-8ced2a0b8c45",
                                "text": "Des applaudissements avortaient. Car Maurice Rostand, lisait toujours, sans une cesse, sans daigner songer à une de ces pauses qui permettent de savoir où l’on en est avec le public, de tâter, eut-on dit, le pouls de sons succès."
                            },
                            {
                                "example_id": "2a0ff380-8c64-413e-a0d0-b0ee6a716e9e",
                                "sense_id": "b5067f53-1469-38dd-ae32-8ced2a0b8c45",
                                "text": "À force vint l’aube, puis, dix heures du matin qui était notre heure de cesse, et on s’arrêta pour aller dormir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bae13a80-d077-4fa0-964e-debed3deb249",
                        "source_entry_id": "0a3d6f0d-0776-3b98-af9c-31d19bd7003f",
                        "source_sense_id": "b5067f53-1469-38dd-ae32-8ced2a0b8c45",
                        "target_lang_word": "Rast",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rast",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8490f83-7df2-35ca-96c1-545e6240230a",
                                        "entry_id": "6b291d51-e538-3156-a028-4a0457505207",
                                        "glosses": [
                                            "Unterbrechung einer Reise oder Wanderung zur Erholung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43778912-89d8-4231-8b89-4dd0123f6506",
                                                "sense_id": "d8490f83-7df2-35ca-96c1-545e6240230a",
                                                "text": "Nach 15 Kilometern werden wir eine Rast einlegen."
                                            },
                                            {
                                                "example_id": "046257e7-5d02-4f4b-bca2-d0bbe13674b5",
                                                "sense_id": "d8490f83-7df2-35ca-96c1-545e6240230a",
                                                "text": "„Nach mancher Rast und manchem Aufbruch, nach endlosem Schauen, vielerlei Wein wurden die Windungen des Flusses gleichförmiger.“"
                                            },
                                            {
                                                "example_id": "4ab9d9bf-8255-46de-af2b-ff175f5fa01b",
                                                "sense_id": "d8490f83-7df2-35ca-96c1-545e6240230a",
                                                "text": "„Beide hatten sich augenscheinlich hier, wo sie ihr Wild erlegt hatten, nach der Anstrengung für kurze Rast ins Gras geworfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
