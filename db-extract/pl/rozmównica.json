                                "sense_id": "5fff4fc0-5b6c-33d9-bc9a-56416da7d781",
                                "text": "Ponoć aparat w rozmównicy nr 3 już działa prawidłowo."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "03db4a28-6387-3d91-aada-f8c7399ffb7e",
