                "senses": [
                    {
                        "sense_id": "0dbd5b4a-5189-3baa-9f24-c3d23e2d627e",
                        "entry_id": "78c3e2da-52e6-3e8c-a68c-10647de15b76",
                        "glosses": [
                            "Défaire d’une draille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2731a03d-859d-477b-9f79-d43676384ac2",
                                "sense_id": "0dbd5b4a-5189-3baa-9f24-c3d23e2d627e",
                                "text": "Il avait réussi à décrocher la manille et finissait de désendrailler la voile de l’étai quand les autres ramenaient tout dans le sac posé sur le pont au niveau de l’étrave."
                            },
                            {
                                "example_id": "1280bc38-4df6-41b1-aa1b-a51edf753eb6",
                                "sense_id": "0dbd5b4a-5189-3baa-9f24-c3d23e2d627e",
                                "text": "Je donne du mou à la balancine, vérifie la filière qui vient d’arracher l’embase d’un chandelier, je raidis les écoutes pour empêcher le hale-bas de battre au roulis, il me faut désendrailler la capette si je ne veux pas voir mes palisses se prendre dans les droules au risque de dépenater les escrilles des écubes."
                            }
                        ]
                    }
                ],
