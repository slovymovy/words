                        "glosses": [
                            "Faire perdre son caractère aviné à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9efb1fa2-254b-4ad7-801d-3c6cc908f31e",
                                "sense_id": "936f8657-5aea-3803-9694-1c31df283014",
                                "text": "Je les attend avec furibard, ces gosses à la con qui veulent tenter de me désaviner."
                            },
                            {
                                "example_id": "14412882-6333-4280-a727-eed356fb095f",
                                "sense_id": "936f8657-5aea-3803-9694-1c31df283014",
                                "text": "Philosophe pour de rire, encore plus pour de vrai Gardant seul en revers de quoi désaviner"
                            },
                            {
                                "example_id": "616c14d6-413f-45df-82e6-8d14ea80bfa9",
                                "sense_id": "936f8657-5aea-3803-9694-1c31df283014",
                                "text": "C’est comme si je me desséchais, me déshydratais, autre façon, peu glorieuse, de me « désaviner »."
                            }
                        ]
                    }
