                        "glosses": [
                            "Discipline consistant à enchaîner des mouvements classiques de boxe, mais sans adversaire et en musique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebaf5b9d-3148-4c14-b182-d4639cba9111",
                                "sense_id": "e290e358-aace-3319-b017-9ed1861dbde8",
                                "text": "L’aéroboxe est une discipline très prisée par les femmes car elle permet d’évacuer le stress, d’affiner et de tonifier son corps, le tout sans aucun risque."
                            },
                            {
                                "example_id": "ebde0a77-2a53-420e-ad6e-8353af612331",
                                "sense_id": "e290e358-aace-3319-b017-9ed1861dbde8",
                                "text": "L’aéroboxe est un sport intense, qui entraîne une dépense calorique importante et sollicite la plupart des muscles de votre corps."
                            },
                            {
                                "example_id": "ba3fee2a-4209-423b-a9ec-d3999e661485",
                                "sense_id": "e290e358-aace-3319-b017-9ed1861dbde8",
                                "text": "Avec l’aéroboxe, préparez-vous à travailler les plus grands coups de la boxe."
