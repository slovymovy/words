                                "target_senses": [
                                    {
                                        "sense_id": "e8c3141f-58bc-30cf-8f22-d300f1f4789e",
                                        "entry_id": "2e6f5eae-5e3d-3ba2-b34c-3e9c234e7e9d",
                                        "glosses": [
                                            "von Kokain befreien"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3ec72ea-f67b-4753-99f0-9240d3f7d415",
                                                "sense_id": "e8c3141f-58bc-30cf-8f22-d300f1f4789e",
                                                "text": "In den ersten Jahren des 20. Jahrhunderts wurde das Getränk dann „entkokainisiert“."
                                            },
                                            {
                                                "example_id": "371d7d80-285c-4f07-9592-3806f55456d0",
                                                "sense_id": "e8c3141f-58bc-30cf-8f22-d300f1f4789e",
                                                "text": "Nach der Entdeckung der Gefährlichkeit des Kokains wurde 1903 die Produktion auf entkokainisierte Cocablätter umgestellt."
                                            },
                                            {
                                                "example_id": "2cf33e90-485b-41d7-808f-78436bf01aa0",
                                                "sense_id": "e8c3141f-58bc-30cf-8f22-d300f1f4789e",
                                                "text": "Zwar werden bei der Herstellung der Grundsubstanz aus Geschmacksgründen bis heute Kokablätter verwendet, diese werden allerdings vorher entkokainisiert."
                                            },
                                            {
                                                "example_id": "0417b501-592d-44db-988c-017044f1399b",
                                                "sense_id": "e8c3141f-58bc-30cf-8f22-d300f1f4789e",
                                                "text": "Erwähnt werden in dem Originalrezept zwar Kokablätter, nicht aber die Kolanüsse. Doch auch sie müssen für den Sirup verwendet worden sein. Wie sonst hätte das Getränk seinen Namen erhalten? Seit spätestens 1900 werden nur noch entkokainisierte Kokablätter verwendet."
                                            },
                                            {
                                                "example_id": "68c719eb-2cd8-4487-a240-23e42a9fdd00",
                                                "sense_id": "e8c3141f-58bc-30cf-8f22-d300f1f4789e",
                                                "text": "So träumen wir mutig von Zeiten, in denen Hustensaft noch Heroin hieß, die Kokablätter in unserer Cola noch nicht entkokainisiert waren und es sich noch gelohnt hat, am Klebstoff zu schnüffeln."
                                            }
                                        ],
