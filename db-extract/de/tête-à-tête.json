                "senses": [
                    {
                        "sense_id": "98157199-a1f7-30f1-abb6-94c96376ff62",
                        "entry_id": "ad2c5b43-a561-306c-886d-0acde3ca1791",
                        "glosses": [
                            "intimes Beisammensein"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "4b2f7149-9d00-4dba-a53e-51bc8b6b0d79",
                                "sense_id": "98157199-a1f7-30f1-abb6-94c96376ff62",
                                "text": "„Das Motiv der Radierung variiert in Seitenverkehrung ein Gemälde von 1885, ein intimes Tête-à-Tête aus dem Milieu der Kristiania-Boheme .“"
                            },
                            {
                                "example_id": "d75f9234-28cc-4bbe-8daf-4a698267b5f0",
                                "sense_id": "98157199-a1f7-30f1-abb6-94c96376ff62",
                                "text": "„Wenn ärarisches Geld im Spiele war, hatten sich die Burschen wiederholt in Bjelina mit Champagner bezecht, dann das ganze Bordell freigehalten, einer Auserkorenen im Tête-à-Tête ein paar Banknoten geschenkt, und zwei haben sich im Morgengrauen auf der Straße mit dem Karabiner erschossen.“"
                            },
                            {
                                "example_id": "d1b7225b-3457-47da-9056-af8b8f069ff6",
                                "sense_id": "98157199-a1f7-30f1-abb6-94c96376ff62",
                                "text": "„Wussten Sie, dass auf Betriebsweihnachtsfeiern 52 Prozent der Anwesenden gerne ein erotisches Tête-à-Tête hätten?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5889f71c-dd85-3693-8f96-f97718d478fb",
                        "entry_id": "ad2c5b43-a561-306c-886d-0acde3ca1791",
                        "glosses": [
                            "Treffen unter Ausschluss der Öffentlichkeit"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "0036a70c-1b2c-4bbc-946b-0cf5d11641f0",
                                "sense_id": "5889f71c-dd85-3693-8f96-f97718d478fb",
                                "text": "„Ein Tête-à-Tête mit dem mächtigsten Mann der freien Welt gewährt das Weiße Haus bevorzugt den Größen der amerikanischen Fernsehsender und vielleicht noch den Korrespondenten der einen oder anderen bedeutenden US-Tageszeitung.“"
                            },
                            {
                                "example_id": "a9781f06-8f28-4290-9d7c-4a2dcbe4546d",
                                "sense_id": "5889f71c-dd85-3693-8f96-f97718d478fb",
                                "text": "„Das Tête-à-Tête mit den beiden jungen Mädchen machte mich ein wenig verlegen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
