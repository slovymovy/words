                    {
                        "translation_id": "c01dc8a2-d6ab-4d4e-842b-ac46aa001947",
                        "source_entry_id": "19856b74-35b5-3ef6-819b-cd1d50e6cbf1",
                        "source_sense_description": "такой, которому ничто не удаётся, которого преследуют неудачи; неудачливый",
                        "target_lang_word": "luckless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
