                "translations": [
                    {
                        "translation_id": "dae7dce0-1257-4fbf-b0a8-2e22aa68a8f4",
                        "source_entry_id": "0234477b-814b-3a6b-9fea-2d291625c70a",
                        "source_sense_id": "48982a7e-44e6-3e2d-8f2b-24a9f49f65aa",
                        "target_lang_word": "marvellously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marvellously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ed46fdf-d54b-34bc-92bc-1b7348eaf0f6",
                                        "entry_id": "ae034daf-a3f5-3b11-b41b-8472d66b24b0",
                                        "glosses": [
                                            "In a marvellous manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c9a4100-e15f-4ddf-be94-df9073f1c24d",
                                                "sense_id": "5ed46fdf-d54b-34bc-92bc-1b7348eaf0f6",
                                                "text": "The plan worked marvellously, even better than we had expected."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "052e2166-1399-3b18-b4e6-93bd728e1c7d",
                                        "entry_id": "ae034daf-a3f5-3b11-b41b-8472d66b24b0",
                                        "glosses": [
                                            "To a great or impressive degree; very."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3141e0b-5e04-4c22-af49-403be0f41c4a",
                                                "sense_id": "052e2166-1399-3b18-b4e6-93bd728e1c7d",
                                                "text": "[N]eyther hys ſeruantes nor hymſelf ſuffered to gone^([sic – meaning go?]) oute, parceiuyng well ſo greate a thyng without his knowledge not begun for noughte, comparyng this maner preſẽ[n]t with this laſt nightes chere, ĩ[n] ſo few houres ſo gret a chaunge marueylouſlye miſliked."
                                            },
                                            {
                                                "example_id": "1649bebf-b581-4e5a-8de8-55d3ab5eec75",
                                                "sense_id": "052e2166-1399-3b18-b4e6-93bd728e1c7d",
                                                "text": "I groaned with hunger. I had seen a marvellously large penny loaf at a baker's—the largest I could possibly get for the price."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ef392ff-56b2-435b-8c81-eaf2515d5781",
                        "source_entry_id": "0234477b-814b-3a6b-9fea-2d291625c70a",
                        "source_sense_id": "48982a7e-44e6-3e2d-8f2b-24a9f49f65aa",
                        "target_lang_word": "wonderfully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wonderfully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c16a9725-e711-38ff-969f-de8cd00c9264",
                                        "entry_id": "038cf3f4-bf9f-330e-a028-7ad9e894bd8c",
                                        "glosses": [
                                            "In a wonderful manner.",
                                            "In an excellent manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d11e28a-ae98-457d-91f0-9bd67c2fe24f",
                                                "sense_id": "c16a9725-e711-38ff-969f-de8cd00c9264",
                                                "text": "He entertained us wonderfully."
                                            },
                                            {
                                                "example_id": "51d061ba-d7ea-4ca6-854b-153ce3216ead",
                                                "sense_id": "c16a9725-e711-38ff-969f-de8cd00c9264",
                                                "text": "By freeing statisticians from dealing with complicated calculations, the statistical aspects of a problem can become the main focus. This point is wonderfully illustrated by Smith and Gelfand (1992)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "990fcdbf-c417-3c8a-8c93-e07195b91a28",
                                        "entry_id": "038cf3f4-bf9f-330e-a028-7ad9e894bd8c",
                                        "glosses": [
                                            "In a wonderful manner.",
                                            "To an extent inspiring wonder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "456f0992-53aa-4f4a-84a1-c109fd9c1b6c",
                                                "sense_id": "990fcdbf-c417-3c8a-8c93-e07195b91a28",
                                                "text": "On a clear night, the Montana sky is wonderfully vast and full of stars."
                                            },
                                            {
                                                "example_id": "31aae87d-f932-48b6-8066-eb3ecbce7e5b",
                                                "sense_id": "990fcdbf-c417-3c8a-8c93-e07195b91a28",
                                                "text": "It was wonderfully stormy and dark on the night when the ship went down."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0da0faee-cc64-44ae-b900-f90195ab836a",
                        "source_entry_id": "0234477b-814b-3a6b-9fea-2d291625c70a",
                        "source_sense_id": "48982a7e-44e6-3e2d-8f2b-24a9f49f65aa",
                        "target_lang_word": "miraculeusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "miraculeusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "14d1097f-0129-32bb-872e-8f0f52597749",
                                        "entry_id": "5259e367-3940-3a71-b4bd-fc0a7b097869",
                                        "glosses": [
                                            "D’une façon miraculeuse, par miracle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d243674a-dfc6-4280-a340-a9c7b78a0b47",
                                                "sense_id": "14d1097f-0129-32bb-872e-8f0f52597749",
                                                "text": "Daniel fut jeté dans la fosse aux lions, et il en fut miraculeusement délivré."
                                            },
                                            {
                                                "example_id": "0c2dce72-7f64-45b4-8bdf-1e9e7f5494db",
                                                "sense_id": "14d1097f-0129-32bb-872e-8f0f52597749",
                                                "text": "[…]; perdu dans l'Arctique pendant trois ans il est miraculeusement sauvé avec son seul compagnon par un phoquier norvégien."
                                            },
                                            {
                                                "example_id": "be71d010-ffa7-4665-8e93-b8960366af27",
                                                "sense_id": "14d1097f-0129-32bb-872e-8f0f52597749",
                                                "text": "Zéphyrin Camélinat sortira miraculeusement indemne de la Semaine sanglante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26750967-ca7c-360e-8f40-24685b929095",
                                        "entry_id": "5259e367-3940-3a71-b4bd-fc0a7b097869",
                                        "glosses": [
                                            "D’une façon extraordinaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efc98b1b-9543-47d4-afb1-fbe68b6028f9",
                                                "sense_id": "26750967-ca7c-360e-8f40-24685b929095",
                                                "text": "Un trône indignement renversé et miraculeusement rétabli."
                                            },
                                            {
                                                "example_id": "37e55119-199c-416a-88e5-fba63c0f2fe4",
                                                "sense_id": "26750967-ca7c-360e-8f40-24685b929095",
                                                "text": "Dans l'intérieur, qui paraissait impraticable, des routes se sont miraculeusement ouvertes, parcourues aussitôt par des automobiles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7bb95d02-d47b-4e13-875e-c7c88e97d1ec",
                        "source_entry_id": "0234477b-814b-3a6b-9fea-2d291625c70a",
                        "source_sense_id": "48982a7e-44e6-3e2d-8f2b-24a9f49f65aa",
                        "target_lang_word": "milagrosamente",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1886929c-6695-4731-9f13-660dae21c126",
                        "source_entry_id": "0234477b-814b-3a6b-9fea-2d291625c70a",
                        "source_sense_id": "48982a7e-44e6-3e2d-8f2b-24a9f49f65aa",
                        "target_lang_word": "wunderbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wunderbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e238610d-fd11-31d0-b97d-247f9c28d1dd",
                                        "entry_id": "8d856feb-f334-3ac0-a5c8-3cb95d488de4",
                                        "glosses": [
                                            "wie ein Wunder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fd739fd-b5cf-489d-abdf-1923f0a3098b",
                                                "sense_id": "e238610d-fd11-31d0-b97d-247f9c28d1dd",
                                                "text": "Obwohl alle Tiere männlich waren, vermehrten sie sich auf wunderbare Weise."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "db2c7ca4-62b9-379b-a982-532680f4daee",
                                        "entry_id": "8d856feb-f334-3ac0-a5c8-3cb95d488de4",
                                        "glosses": [
                                            "überragend gut, besonders schön oder herrlich"
                                        ],
                                        "tags": [
                                            "Ausdruck der Freude",
                                            "positiven Überraschung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fddac23b-7a25-4ecc-98ff-10aa90fdcbfb",
                                                "sense_id": "db2c7ca4-62b9-379b-a982-532680f4daee",
                                                "text": "„Deltafliegen ist eine wunderbare, freie Art von Fliegen, die dem Vogelflug bestimmt am nächsten kommt.“"
                                            },
                                            {
                                                "example_id": "25630124-e6bb-4416-9bb2-5fd0122b8217",
                                                "sense_id": "db2c7ca4-62b9-379b-a982-532680f4daee",
                                                "text": "Das Wetter ist heute einfach wunderbar."
                                            },
                                            {
                                                "example_id": "4d2f23d2-bdd5-4bab-8b7b-13c2da5d03cd",
                                                "sense_id": "db2c7ca4-62b9-379b-a982-532680f4daee",
                                                "text": "Liebling, Du hast uns ein wunderbares Essen gekocht."
                                            },
                                            {
                                                "example_id": "602f2e0a-df18-4bb1-8eed-655d652b9b5b",
                                                "sense_id": "db2c7ca4-62b9-379b-a982-532680f4daee",
                                                "text": "Wunderbar, es ist ein Junge!"
                                            },
                                            {
                                                "example_id": "6d91ddfe-8e86-43a6-9d19-68d9db439c4f",
                                                "sense_id": "db2c7ca4-62b9-379b-a982-532680f4daee",
                                                "text": "Der Mond ist aufgegangen, - Die goldnen Sternlein prangen - Am Himmel hell und klar; - Der Wald steht schwarz und schweiget, - Und aus den Wiesen steiget - Der weiße Nebel wunderbar. […]"
                                            },
                                            {
                                                "example_id": "c91548b9-1009-4ff0-a262-4014307bada6",
                                                "sense_id": "db2c7ca4-62b9-379b-a982-532680f4daee",
                                                "text": "Dem Politikberater Michael Spreng fällt nichts ein, was die Kanzlerin im Moment besser machen könnte. Er sagt: \"Frau Merkel erweckt den Eindruck: Es ist alles wunderbar, ihr müsst mich nur wählen. […]"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d2109b6-2080-493d-a27a-0995e925b1e4",
                        "source_entry_id": "0234477b-814b-3a6b-9fea-2d291625c70a",
