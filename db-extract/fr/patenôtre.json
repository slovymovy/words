        "fr-extract.jsonl": [
            {
                "entry_id": "a0d8dcf9-5b94-3f77-90bb-2acfc476dda8",
                "word": "patenôtre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b5f19d81-656b-49bb-81f7-2874856d88f0",
                        "entry_id": "a0d8dcf9-5b94-3f77-90bb-2acfc476dda8",
                        "tags": [
                            "plural"
                        ],
                        "form": "patenôtres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9434c434-191c-307f-a998-5f4a3d9f581a",
                        "entry_id": "a0d8dcf9-5b94-3f77-90bb-2acfc476dda8",
                        "glosses": [
                            "Oraison dominicale ou prière du « Notre Père »."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "42e36715-f5ea-4567-b483-ed2fb3bfd533",
                                "sense_id": "9434c434-191c-307f-a998-5f4a3d9f581a",
                                "text": "[…] ; vous les béguines au noir bonnet, vous direz vos patenôtres au lieu de radoter sur l'un et l'autre et en même temps ça vous diminuera votre temps de purgatoire."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2c5c2e0-abbe-3ed7-b361-bf2a6ce8977d",
                        "entry_id": "a0d8dcf9-5b94-3f77-90bb-2acfc476dda8",
                        "glosses": [
                            "Suite de prières marmonnées."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f4b66f2f-4cc2-4110-bfa4-b0ba17f73637",
                                "sense_id": "e2c5c2e0-abbe-3ed7-b361-bf2a6ce8977d",
                                "text": "Rêveurs et brochant des babines comme singes disant leurs patenôtres, ils se promenaient sur la galerie, tantôt marmottant, tantôt poussant de grands éclats de voix."
                            },
                            {
                                "example_id": "47785d67-61e6-4847-80a1-3b28e98b2c3b",
                                "sense_id": "e2c5c2e0-abbe-3ed7-b361-bf2a6ce8977d",
                                "text": "Il était bègue, parlait presque toujours en latin, marmottait des patenôtres du matin au soir et ressemblait si fort à un singe qu'on l'avait surnommé Jocko."
                            },
                            {
                                "example_id": "7794dbda-4de1-4c8b-928d-8b3e75407424",
                                "sense_id": "e2c5c2e0-abbe-3ed7-b361-bf2a6ce8977d",
                                "text": "Les dévotes […] s’agenouillaient avec faste, prenaient des attitudes d’anges contrits, marmottaient d’intarissables patenôtres."
                            },
                            {
                                "example_id": "8d062ac2-c665-43d3-ac36-d4dd0d50d013",
                                "sense_id": "e2c5c2e0-abbe-3ed7-b361-bf2a6ce8977d",
                                "text": "En apparence, ce turbulent apôtre des lumières fait contraste avec ses ancêtres confits en dévotion et abondants en patenôtres."
                            },
                            {
                                "example_id": "4bde9700-f3a4-48ea-8a8e-e24243f50175",
                                "sense_id": "e2c5c2e0-abbe-3ed7-b361-bf2a6ce8977d",
                                "text": "Il était grand diseur de patenôtres et surveillait mes lectures avec une pieuse sollicitude."
                            },
                            {
                                "example_id": "8963a3ef-9d90-4c46-8b68-8de09ce86a9d",
                                "sense_id": "e2c5c2e0-abbe-3ed7-b361-bf2a6ce8977d",
                                "text": "L’espace intérieur d’une architecture inextricable qu’on peut difficilement embrasser d’un seul coup d’œil, paraît rempli de fidèles, de leur bourdonnement et de leurs patenôtres."
                            }
                        ]
                    },
                    {
                        "sense_id": "90ecbcbd-ea99-3b44-bc68-4f446dd09182",
                        "entry_id": "a0d8dcf9-5b94-3f77-90bb-2acfc476dda8",
                        "glosses": [
                            "Chapelet ou cordelette fermée, en forme de collier, comprenant un nombre déterminé de nœuds ou boules (10, 50 ou 150 le plus souvent), destinés à guider le décompte de prières vocales : Notre Père, Ave Maria, ou oraisons jaculatoires."
                        ],
                        "tags": [
                            "Plus rare"
                        ],
                        "examples": [
                            {
                                "example_id": "3a1b2dee-ab7e-4b9c-b348-f4aa624e183c",
                                "sense_id": "90ecbcbd-ea99-3b44-bc68-4f446dd09182",
                                "text": "Quinze sols quatre deniers parisis, pour avoir porté deux patenôtres ! C’est un peu cher."
                            },
                            {
                                "example_id": "2bc8cf39-49da-4da2-aa18-3432f70d64d0",
                                "sense_id": "90ecbcbd-ea99-3b44-bc68-4f446dd09182",
                                "text": "A son appeau se prendront aisément les républicains français qui n'auront pas assez d’épithètes laudatives quand ils célébreront la victoire de Sadowa : l’intelligence philosophique, l’organisation moderne ont vaincu les donneurs d’eau bénite, les marchands de patenôtres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7132b0d3-32e2-432d-88d5-52df5b71d11d",
                        "source_entry_id": "a0d8dcf9-5b94-3f77-90bb-2acfc476dda8",
                        "target_lang_word": "Vaterunser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vaterunser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "243ad6c3-0b99-3a4c-8857-01a11074372e",
                                        "entry_id": "0c12ad22-4971-3753-b2ed-9909629c54e3",
                                        "glosses": [
                                            "Gebet des Christentums, benannt nach seinen Anfangsworten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f83f46d-a8ac-4e16-b6ba-8c01908c46e9",
                                                "sense_id": "243ad6c3-0b99-3a4c-8857-01a11074372e",
                                                "text": "Der Pfarrer betete zusammen mit allen Kirchenbesuchern das Vaterunser."
                                            },
                                            {
                                                "example_id": "fccb7ae8-d7b7-4817-aaa4-1d79f27a5b7e",
                                                "sense_id": "243ad6c3-0b99-3a4c-8857-01a11074372e",
                                                "text": "Das Vaterunser beginnt mit den Worten »Vater unser im Himmel, geheiligt werde dein Name."
                                            },
                                            {
                                                "example_id": "035e9177-750d-4479-be2c-91c20fcc05d0",
                                                "sense_id": "243ad6c3-0b99-3a4c-8857-01a11074372e",
                                                "text": "„Den Abschluß bilden das gemeinsame Singen und das Vaterunser.“"
                                            },
                                            {
                                                "example_id": "e337c6a0-1d1b-4d9e-bbeb-8b739eff9412",
                                                "sense_id": "243ad6c3-0b99-3a4c-8857-01a11074372e",
                                                "text": "„Ein Vaterunser lang verharrte er unter dem Wagen, dann rückten Infanteristen vor, bildeten um die Batterie ein Karree und vertrieben mit Gewehrfeuer die Angreifer.“"
                                            },
                                            {
                                                "example_id": "3f5bbaac-898d-474e-a912-ccb2feb96864",
                                                "sense_id": "243ad6c3-0b99-3a4c-8857-01a11074372e",
                                                "text": "„Das Herz blutete mir bei den Tränen seiner Schwestern und seiner Mutter, die mit dem Rosenkranz in der Hand viele Vaterunser murmelte und immer wieder ein ›Dio provederà‹ einfügte.“"
                                            },
                                            {
                                                "example_id": "e40a2916-51c8-4ee6-ae54-34aacf276d96",
                                                "sense_id": "243ad6c3-0b99-3a4c-8857-01a11074372e",
                                                "text": "„Ein paar Vaterunser, und man war aller Sünden ledig und konnte Fußball spielen gehen oder in der Städtischen Leihbücherei versuchen, verbotene Bücher zu bekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b5c1574-c181-4ed0-b40b-b05174092289",
