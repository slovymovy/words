                    "sense_id": "a00ae446-8236-3ce8-b83e-1aa5998a3607",
                    "sense_definition": "Bestimmter Artikel für feminine Substantive im Nominativ und Akkusativ Singular von <w>der</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "bestimmter_artikel",
                    "name_type": "no",
                    "examples": [
                        {
