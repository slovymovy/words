                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55dd3a4c-97b3-463d-9fb6-07871debfc91",
                                                "sense_id": "d219c037-e11d-3047-8c32-601c9bc6b6de",
                                                "text": "En wat deden de andere Pieten in die drie dagen? Natuurlijk, ze maakten een nieuwe rode mantel voor Sinterklaas."
                                            },
                                            {
                                                "example_id": "de8ae21d-518d-4b49-a5fa-ceab086013e8",
                                                "sense_id": "d219c037-e11d-3047-8c32-601c9bc6b6de",
                                                "text": "Natuurlijk had ik ook tot mijn pensioen kunnen wachten, maar ik wilde het nu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
