                "translations": [
                    {
                        "translation_id": "53215514-8fb3-463f-88bf-bec1be9bda86",
                        "source_entry_id": "d2efe0a1-9c20-3a33-a750-eab0a7bc7452",
                        "source_sense_id": "15844d98-3e99-36b5-bf05-1af2951e10bf",
                        "target_lang_word": "misery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16020650-2d61-3e7f-b9f4-e85791bb44fc",
                                        "entry_id": "e3fc0a3a-a23a-3c66-8a67-473aaa6dbc9f",
                                        "glosses": [
                                            "Great unhappiness; extreme pain of body or mind; wretchedness; distress; woe."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "843f3f29-76a1-4325-932a-e1f86ff408f1",
                                                "sense_id": "16020650-2d61-3e7f-b9f4-e85791bb44fc",
                                                "text": "Ever since his wife left him you can see the misery on his face."
                                            },
                                            {
                                                "example_id": "3f0b8704-e49e-4238-a8c2-0a72e7a44b28",
                                                "sense_id": "16020650-2d61-3e7f-b9f4-e85791bb44fc",
                                                "text": "For miſerie doth braueſt mindes abate, / And make them ſeeke for that they wont to ſcorne, / Of fortune and of hope at once forlorne."
                                            },
                                            {
                                                "example_id": "26192730-f9fe-4d5b-ae46-83c72117a231",
                                                "sense_id": "16020650-2d61-3e7f-b9f4-e85791bb44fc",
                                                "text": "It was not just the confusion that unhappiness brings, it was not just the loneliness, it was the despair that accompanies all those emotions that turns unhappiness into utter misery."
                                            },
                                            {
                                                "example_id": "ff8901d5-162c-47f5-abbf-dfaf3e00db22",
                                                "sense_id": "16020650-2d61-3e7f-b9f4-e85791bb44fc",
                                                "text": "Then, in January, a creeping tsunami of train cancellations, triggered by major staff absences as a result of the aggressive transmissibility of Omicron, heaped further misery on rail users."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e16716ed-2583-3e91-bc56-10329fdeaa1f",
                                        "entry_id": "e3fc0a3a-a23a-3c66-8a67-473aaa6dbc9f",
                                        "glosses": [
                                            "A bodily ache or pain."
                                        ],
                                        "tags": [
                                            "UK",
                                            "US",
                                            "countable",
                                            "dialectal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceb5ed3f-e497-45f7-a46d-714d5a630e82",
                                                "sense_id": "e16716ed-2583-3e91-bc56-10329fdeaa1f",
                                                "text": "[...] and I had a misery in my left breast and shoulder. I was hurt, but knew not how or how much."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7a59426-a495-304a-83fb-b9e9f7ef795d",
                                        "entry_id": "e3fc0a3a-a23a-3c66-8a67-473aaa6dbc9f",
                                        "glosses": [
                                            "Cause of misery; calamity; misfortune."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4ac0ebb5-869d-3d1f-bb74-47c6da410d92",
                                        "entry_id": "e3fc0a3a-a23a-3c66-8a67-473aaa6dbc9f",
                                        "glosses": [
                                            "poverty."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cbb79ca-bef5-4de0-85be-b752972b913b",
                                                "sense_id": "4ac0ebb5-869d-3d1f-bb74-47c6da410d92",
                                                "text": "The Widdow that hath but a pan of braſſe, […]\nMuſt pay her Landlord many a groat,\nOr twil be puld out of her throat: […]\nThe rich haue all, the poore liue in miſerie: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dcf153a-95c8-32c3-9f4d-da3441ebb613",
                                        "entry_id": "e3fc0a3a-a23a-3c66-8a67-473aaa6dbc9f",
                                        "glosses": [
                                            "greed; avarice."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
