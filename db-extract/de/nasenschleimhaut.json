                "senses": [
                    {
                        "sense_id": "5f2eaf9a-29e1-337f-b81c-1b7322cc275f",
                        "entry_id": "115a4820-9aee-38ce-8f59-39ae3995dacf",
                        "glosses": [
                            "die innere Auskleidung der Nasenhöhle und der Nasenmuscheln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42723b40-5da6-4751-9e89-2d0cbaefefb8",
                                "sense_id": "5f2eaf9a-29e1-337f-b81c-1b7322cc275f",
                                "text": "„Niespulver ist ein Scherzartikel, der die Nasenschleimhaut so stark reizt, dass man unwillkürlich niesen muss.“"
                            },
                            {
                                "example_id": "ca1edf97-b0c0-4b95-992c-e7ee7ad8db39",
                                "sense_id": "5f2eaf9a-29e1-337f-b81c-1b7322cc275f",
                                "text": "„Und richtig, was ihn damals am meisten beeindruckt hatte, das war der aparte Duft, der seine Nasenschleimhaut kitzelte, als sie an ihm vorüberschwebte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
