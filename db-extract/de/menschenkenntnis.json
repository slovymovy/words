                        ],
                        "form": "die Menschenkenntnis"
                    },
                    {
                        "form_id": "814b47a3-85f1-42ce-9ce5-e46440846acc",
                        "entry_id": "3b0be827-343e-3b61-8165-faa78db61877",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Menschenkenntnisse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8ba25135-976e-3eaa-9556-28a9d3476a9a",
                        "entry_id": "3b0be827-343e-3b61-8165-faa78db61877",
                        "glosses": [
                            "Fähigkeit, Menschen richtig beurteilen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07da181c-df16-452b-a60c-2e0ef4ed9251",
                                "sense_id": "8ba25135-976e-3eaa-9556-28a9d3476a9a",
                                "text": "Wer eine gute Menschenkenntnis besitzt, lässt sich nicht leicht übers Ohr hauen."
                            },
                            {
                                "example_id": "307b3633-795d-42f9-afa9-fd30ab15f733",
                                "sense_id": "8ba25135-976e-3eaa-9556-28a9d3476a9a",
                                "text": "„Menschenkenntnis erwirbt er sich vor allem durch seine Reisebekanntschaften.“"
                            },
                            {
                                "example_id": "766e9751-ed2c-4725-b3f4-8ce7b485199b",
                                "sense_id": "8ba25135-976e-3eaa-9556-28a9d3476a9a",
                                "text": "„Geduld, Präzision, Disziplin, Verschwiegenheit und Seriosität sowie gute Menschenkenntnisse sind für die Arbeit wichtig.“"
                            },
                            {
                                "example_id": "f8a70103-c0ab-4689-a89b-a5a72cc204dc",
                                "sense_id": "8ba25135-976e-3eaa-9556-28a9d3476a9a",
                                "text": "„Sie haben auf unseren Reisen Gelegenheit, sich die umfassendsten Welt- und Menschenkenntnisse zu erwerben, sich in allen Zweigen auszubilden, alle erdenklichen Genüsse zu kosten, auszuschlürfen, mit einem Worte, manneswürdig zu siegen.“"
                            },
                            {
                                "example_id": "7fb178e7-6bd6-4eb2-8661-c9dbc3306dff",
                                "sense_id": "8ba25135-976e-3eaa-9556-28a9d3476a9a",
                                "text": "„Aber da saß Hamann bereits in der Kutsche und hatte Zeit, seine Menschenkenntnis neu zu überprüfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77868a24-0e1b-4f19-8080-c90ca791cb0e",
