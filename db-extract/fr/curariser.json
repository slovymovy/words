                "senses": [
                    {
                        "sense_id": "eddaa5c6-c816-30e3-b4e7-98c0dcc6e7bd",
                        "entry_id": "92a07f2a-ae81-3a53-941b-703413e837c7",
                        "glosses": [
                            "Injecter du curare, un curarisant à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edb2fbe5-14cf-4b46-8840-bbe397ba7378",
                                "sense_id": "eddaa5c6-c816-30e3-b4e7-98c0dcc6e7bd",
                                "text": "Il est nécessaire de demander au médecin anesthésiste de curariser le patient afin de faciliter cette réduction. Une tension excessive peut engendrer une fracture de l'acromion ou de l'épine."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6b79897-4536-3d29-9a43-8e81edb65660",
                        "entry_id": "92a07f2a-ae81-3a53-941b-703413e837c7",
                        "glosses": [
                            "Être atteint d’une blessure imprégnée de curare."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98cadd4c-072e-45e9-b69a-cadc1431fec7",
                                "sense_id": "e6b79897-4536-3d29-9a43-8e81edb65660",
                                "text": "Curarisé par une flèche empoisonnée, on meurt prisonnier d’un corps inerte, le regard lucide et terrifié, l’esprit impuissant."
                            }
                        ]
                    }
                ],
