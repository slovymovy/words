                        "entry_id": "f23c5054-1c70-34ea-aea0-b6a9f9c32ed9",
                        "glosses": [
                            "Personne qui fabrique ou vend des coffres."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e4cf5cb9-dce2-4115-9bbb-d935265adef6",
                                "sense_id": "97867c11-df22-3579-9015-d58ae5950442",
                                "text": "Un siècle plus tard, en 1479, sept coffretiers et malletiers seulement sont recensés dans le royaume."
                            },
                            {
                                "example_id": "a2fd0b95-4146-4057-aa86-7acf2e25cf73",
                                "sense_id": "97867c11-df22-3579-9015-d58ae5950442",
                                "text": "Claude Devoyé a épousé l'ébéniste Pierre Séverin, mais qui est décédée en 1753 en laissant un fils ébéniste au faubourg Saint-Germain-des-Prés et une fille mariée à un maître coffretier du même endroit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88735bf6-d03e-447c-b888-659d2f5eee10",
                        "source_entry_id": "f23c5054-1c70-34ea-aea0-b6a9f9c32ed9",
                        "source_sense_id": "97867c11-df22-3579-9015-d58ae5950442",
                        "target_lang_word": "Schreiner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schreiner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2451bf0f-2c0b-3b79-94ea-d95b5a4795e5",
                                        "entry_id": "871720ec-3c34-3774-9f53-491de9aa71e4",
                                        "glosses": [
                                            "Handwerker, der aus Holz Möbel oder Fenster und Türen herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc169f6b-69d5-4deb-80fc-00793a1e1d3a",
                                                "sense_id": "2451bf0f-2c0b-3b79-94ea-d95b5a4795e5",
                                                "text": "Den Schrank haben wir uns vom Schreiner machen lassen."
                                            },
                                            {
                                                "example_id": "fffd6693-6ee3-4d34-989b-f41dfef8477b",
                                                "sense_id": "2451bf0f-2c0b-3b79-94ea-d95b5a4795e5",
                                                "text": "„Die beiden Schreiner lächelten und meinten, sie würden es doch hoffen.“"
                                            },
                                            {
                                                "example_id": "fb3eaf31-d610-4b05-bacf-1cc9cf429a60",
                                                "sense_id": "2451bf0f-2c0b-3b79-94ea-d95b5a4795e5",
                                                "text": "„Später ging er zu einem Schreiner in die Lehre, allerdings brach er diese bald ab.“"
                                            },
                                            {
                                                "example_id": "40b34c4c-a3f7-4b22-856d-62c4d1339106",
                                                "sense_id": "2451bf0f-2c0b-3b79-94ea-d95b5a4795e5",
                                                "text": "„Schreiner fertigten Holzroste für französische Betten.“"
                                            },
                                            {
                                                "example_id": "e472b7dc-db5b-4d7d-9591-697e4a9a7273",
                                                "sense_id": "2451bf0f-2c0b-3b79-94ea-d95b5a4795e5",
                                                "text": "„Fried kam in die Lehrlingsgruppe der Schreiner, und ihn steckte man zu den Gärtnern.“"
                                            }
                                        ],
