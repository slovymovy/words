                                "target_senses": [
                                    {
                                        "sense_id": "ba22067f-abec-39b5-9fc9-e94ff430cd92",
                                        "entry_id": "2cf366e2-3d74-37d0-8680-7f6b16f78f2c",
                                        "glosses": [
                                            "A stone tablet inscribed with a curse, as used in parts of the ancient Mediterranean to target someone with maleficent magic."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "658d598e-4679-4f28-ac65-b0b8fc637343",
                                                "sense_id": "ba22067f-abec-39b5-9fc9-e94ff430cd92",
                                                "text": "A simple curse tablet might be inscribed with the words “As this piece of lead grows cold, so will John Smith.”"
                                            },
                                            {
                                                "example_id": "910bba9e-a5c8-4e56-9e02-af1ae682bd27",
                                                "sense_id": "ba22067f-abec-39b5-9fc9-e94ff430cd92",
                                                "text": "Curse tablets persisted in their original Greek homeland, and spread out from it across much of the empire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
