                {
                    "sense_id": "93bebab5-9baf-3c9c-9f57-e19a9d856db3",
                    "sense_definition": "Een informele groet ter afsluiting, vaak gebruikt in brieven, e-mails of berichten.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bedankt voor je snelle reactie en <w>groetjes</w>!",
                            "target_lang_translations": {
                                "en": "Thanks for your quick reply and <w>best regards</w>!",
                                "ru": "Спасибо за быстрый ответ и <w>всего хорошего</w>!",
                                "pl": "Dziękuję za szybką odpowiedź i <w>pozdrawiam</w>!",
                                "de": "Danke für deine schnelle Antwort und <w>liebe Grüße</w>!",
                                "fr": "Merci pour ta réponse rapide et <w>amitiés</w> !",
                                "it": "Grazie per la tua rapida risposta e <w>saluti</w>!",
                                "cs": "Díky za rychlou odpověď a <w>měj se</w>!",
                                "tr": "Hızlı yanıtın için teşekkürler, <w>sevgiler</w>!",
                                "es": "¡Gracias por tu rápida respuesta y <w>saludos</w>!",
                                "zh": "谢谢你的快速回复，<w>祝好</w>！"
                            }
                        },
                        {
                            "text": "Ik zie je volgende week weer op school, <w>groetjes</w>.",
                            "target_lang_translations": {
                                "en": "I'll see you at school again next week, <w>cheers</w>.",
                                "ru": "Увидимся на следующей неделе в школе, <w>пока</w>.",
                                "pl": "Widzimy się w szkole w przyszłym tygodniu, <w>pa</w>.",
                                "de": "Wir sehen uns nächste Woche wieder in der Schule, <w>liebe Grüße</w>.",
                                "fr": "Je te revois la semaine prochaine à l'école, <w>bises</w>.",
                                "it": "Ci vediamo a scuola la prossima settimana, <w>ciao</w>.",
                                "cs": "Uvidíme se příští týden ve škole, <w>ahoj</w>.",
                                "tr": "Haftaya okulda görüşürüz, <w>hoşça kal</w>.",
                                "es": "Te veo la próxima semana en la escuela, <w>un abrazo</w>.",
                                "zh": "下周学校见，<w>再见</w>。"
                            }
                        }
