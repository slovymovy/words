                "senses": [
                    {
                        "sense_id": "bcbde89d-d376-3043-8128-a832c0e96c43",
                        "entry_id": "0ea96363-55eb-38ff-afa9-091b40908123",
                        "glosses": [
                            "bestückter oder unbestückter, stabiler, runder Träger, welcher das sichere Lagern (Schutz vor Knickungen), den Transport und die Verlegung von (elektrischen) Kabeln oder Leitungen ermöglicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a5c19b9-14b0-45ad-a448-e82ba092b235",
                                "sense_id": "bcbde89d-d376-3043-8128-a832c0e96c43",
                                "text": "Bring mir mal bitte die Kabeltrommel, denn das Kabel an der Bohrmaschine ist zu kurz, um an die Decke zu kommen."
                            },
                            {
                                "example_id": "5f67f566-475d-4089-8535-1d782a44b322",
                                "sense_id": "bcbde89d-d376-3043-8128-a832c0e96c43",
                                "text": "Die Elektriker wollten die Leitung noch weiter verlegen, doch die Kabeltrommel war leer."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
