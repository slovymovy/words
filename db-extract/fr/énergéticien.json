                ],
                "senses": [
                    {
                        "sense_id": "e827e75e-df9d-3ac2-a35a-77163c477389",
                        "entry_id": "1d9c3b26-61b7-3067-b0a0-ea86e84ec2e0",
                        "glosses": [
                            "Spécialiste de l’énergétique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0acdc871-4127-4f9f-83bb-925728b360cb",
                                "sense_id": "e827e75e-df9d-3ac2-a35a-77163c477389",
                                "text": "Entre le volume à rénover, la capacité de financement, la capacité des énergéticiens et des professionnels du BTP — quand on sait qu’il y a, par exemple, huit à dix mois de délai pour avoir des huisseries — le calendrier me semble très ambitieux."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2a0de72-da30-3696-af68-fca5a33e2e35",
                        "entry_id": "1d9c3b26-61b7-3067-b0a0-ea86e84ec2e0",
                        "glosses": [
                            "Producteur et fournisseur d’énergie."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "1bca045d-5751-456d-b976-1fd5cc7efab3",
                                "sense_id": "d2a0de72-da30-3696-af68-fca5a33e2e35",
                                "text": "La naissance du troisième énergéticien de la planète exigeait la conciliation de la raison d’État et des intérêts privés."
                            },
                            {
                                "example_id": "087d62cf-44b5-4757-94b5-6261678aa36e",
                                "sense_id": "d2a0de72-da30-3696-af68-fca5a33e2e35",
                                "text": "EDF et l’énergéticien néerlandais Delta vont construire et exploiter une centrale à cycle combiné gaz aux Pays-Bas."
                            },
                            {
                                "example_id": "4d0927a0-b40b-4450-98f1-95b93ad6dfcc",
                                "sense_id": "d2a0de72-da30-3696-af68-fca5a33e2e35",
                                "text": "Il met ainsi le doigt sur un éventuel conflit d’intérêts dans le secteur des économies d’énergie, dans lequel les principaux énergéticiens joueraient un double jeu."
                            },
                            {
                                "example_id": "c264d903-1d55-48d0-a272-f695b026f3aa",
                                "sense_id": "d2a0de72-da30-3696-af68-fca5a33e2e35",
                                "text": "En janvier 2022, l’énergéticien confirme la découverte de défauts similaires sur le réacteur 1 de 1 300 MWe de Penly (Seine-Maritime)."
                            }
                        ]
                    },
                    {
                        "sense_id": "0abd31ee-f64b-3756-b2cb-7088702f0256",
                        "entry_id": "1d9c3b26-61b7-3067-b0a0-ea86e84ec2e0",
                        "glosses": [
                            "Personne qui prétend procurer des soins thérapeutiques à l’aide de transmission d’énergie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c86fac2-7ab4-4e2b-ac3d-13a321aeb952",
                                "sense_id": "0abd31ee-f64b-3756-b2cb-7088702f0256",
                                "text": "J'irais voir une vraie thérapeute. Pas un énergéticien, ni une démagnétiseuse, ni un guérisseur, encore moins une voyante (qui m'avait prédit amour et fortune dans les six mois), mais un vrai psy, avec de vrais diplômes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23c669f4-8ef5-4c54-8936-ff92129b3b8a",
                        "source_entry_id": "1d9c3b26-61b7-3067-b0a0-ea86e84ec2e0",
                        "target_lang_word": "Energieproduzent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8908e17d-e2c2-47b1-bd77-ec1e7093af46",
                        "source_entry_id": "1d9c3b26-61b7-3067-b0a0-ea86e84ec2e0",
                        "target_lang_word": "Energieversorger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Energieversorger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a31dbf2-de6a-39c7-a492-d24494ff9edb",
                                        "entry_id": "eab5e7c0-3e37-32f0-a050-1116d3317438",
                                        "glosses": [
                                            "Unternehmen, das seine Kunden mit elektrischem Strom versorgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a926fc4f-7df3-4d68-8b3f-140d10470ac9",
                                                "sense_id": "1a31dbf2-de6a-39c7-a492-d24494ff9edb",
                                                "text": "Der Energieversorger fuhr hohe Verluste durch den Stromausfall ein."
                                            },
                                            {
                                                "example_id": "54cf6390-8e88-467f-9424-b56b4a7bd35f",
                                                "sense_id": "1a31dbf2-de6a-39c7-a492-d24494ff9edb",
                                                "text": "„Die Verpflichtung des Verbrauchers, bei Änderung der Besitz-, Eigentums- oder Miteigentumsverhältnisse an der Wohnung dafür zu sorgen, dass der Nachfolger in die Rechte und Pflichten aus dem Vertrag mit dem Energieversorger eintritt, ist dahin zu interpretieren, dass der Verbraucher, der die Wohnung aufgibt und das der Benützung zugrunde liegende Rechtsverhältnis beendet, seinem Nachfolger bei sonstiger Weiterhaftung für die aus dem Vertrag resultierenden Ansprüche des Energieversorgers die Rechte und Pflichten aus dem Vertrag überbinden muss.“"
                                            },
                                            {
                                                "example_id": "fc7ec91c-b29c-43f1-8e8f-4ad421923067",
                                                "sense_id": "1a31dbf2-de6a-39c7-a492-d24494ff9edb",
                                                "text": "„Auch im Winter bei Minusgraden dürfen Energieversorger weiter den Strom abklemmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
