                                "target_senses": [
                                    {
                                        "sense_id": "d83c16f6-9ef4-3ab6-8839-9ec3d6383f81",
                                        "entry_id": "6e1a8caa-920c-3339-9884-da91f341942d",
                                        "glosses": [
                                            "vierter Mond des Planeten Jupiter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b2944b4-64fd-466a-b812-b2ee2fc726c3",
                                                "sense_id": "d83c16f6-9ef4-3ab6-8839-9ec3d6383f81",
                                                "text": "Die Kallisto ist der kraterreichste Körper des Sonnensystems."
                                            },
                                            {
                                                "example_id": "c4dac739-e915-43c0-97a8-14a51e312e3e",
                                                "sense_id": "d83c16f6-9ef4-3ab6-8839-9ec3d6383f81",
                                                "text": "Auch für Europa und Kallisto deuten die bisherigen Beobachtungen auf Ozeane unter der Eiskruste der Monde hin."
                                            },
                                            {
                                                "example_id": "270b52b9-c747-495a-9e98-044ebc1ca4f8",
                                                "sense_id": "d83c16f6-9ef4-3ab6-8839-9ec3d6383f81",
                                                "text": "Die Umlaufszeiten der vier Monde nehmen von innen (1,8 Tage bei Io) nach außen (16,7 Tage bei Kallisto) zu."
                                            },
                                            {
                                                "example_id": "83d44248-46ae-4c72-963a-054b2f74d339",
                                                "sense_id": "d83c16f6-9ef4-3ab6-8839-9ec3d6383f81",
                                                "text": "Kallistos bräunlich-graues Eis reflektiert daher nur noch wenig Sonnenlicht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
