                "translations": [
                    {
                        "translation_id": "1e834431-8868-4880-8ead-c72ff588cd5f",
                        "source_entry_id": "faa30fd1-cc9c-3531-8897-b44d55c8bb36",
                        "source_sense_id": "6580f9d3-492c-3d9e-9975-3697884c228b",
                        "source_sense_description": "stad in Pakistan",
                        "target_lang_word": "Lahore",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lahore",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa0cbaaf-9d42-3027-a3ee-b78b0b9b67a0",
                                        "entry_id": "bf0297b4-bfd2-3ff4-a89b-b90648e861b1",
                                        "glosses": [
                                            "Hauptstadt der pakistanischen Provinz Punjab"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d514ee1-b1d2-4ca1-9944-01bacf455611",
                                                "sense_id": "aa0cbaaf-9d42-3027-a3ee-b78b0b9b67a0",
                                                "text": "„Im Punjab gibt es noch einige Tausend Sikhs, vor allem in Lahore.“"
                                            },
                                            {
                                                "example_id": "2e1bfc14-02c1-4b24-ae28-89b8262589c9",
                                                "sense_id": "aa0cbaaf-9d42-3027-a3ee-b78b0b9b67a0",
                                                "text": "„Hatte Zaman Schah zunächst Ranjit Singh zum Gouverneur von Lahore erhoben, so sagte sich dieser bald von Kabul los und gründete ein eigenständiges Reich.“"
                                            },
                                            {
                                                "example_id": "2059203e-c7bf-4f51-ba1b-2e9ad9376b42",
                                                "sense_id": "aa0cbaaf-9d42-3027-a3ee-b78b0b9b67a0",
                                                "text": "„Wir haben in den letzten Tagen so viele neue Hinweise bekommen, dass wir alle Netzwerke zwischen London und Lahore ausheben können.“"
                                            },
                                            {
                                                "example_id": "93125de9-d6b7-41fa-9101-3b1d80d774ff",
                                                "sense_id": "aa0cbaaf-9d42-3027-a3ee-b78b0b9b67a0",
                                                "text": "„Die Straßenschilder sagen mir, dass wir Richtung Lahore fahren, aber es gibt ein halbes Dutzend Abzweigungen auf dieser Straße, die in verschiedene Landesteile führen, und Major Kiyani fährt wahrscheinlich in eine seinem eigentlichen Ziel entgegengesetzte Richtung.“"
                                            },
                                            {
                                                "example_id": "253437f2-a159-48cf-8ebe-e8e73434173f",
                                                "sense_id": "aa0cbaaf-9d42-3027-a3ee-b78b0b9b67a0",
                                                "text": "„Dann traf ein Paket bei unserem Konsulat in Lahore ein.“"
                                            },
                                            {
                                                "example_id": "e45a1b31-0029-4c42-9cfe-388d45165dc0",
                                                "sense_id": "aa0cbaaf-9d42-3027-a3ee-b78b0b9b67a0",
                                                "text": "„Er besitzt eine Filiale in Lahore und - dem Ladenschild zufolge - jetzt auch eine in Toronto.“"
                                            },
                                            {
                                                "example_id": "d2279b56-c4f2-4277-9f5f-32ce161e94e8",
                                                "sense_id": "aa0cbaaf-9d42-3027-a3ee-b78b0b9b67a0",
                                                "text": "„In den vergangenen dreizehn Monaten hatte er fünf Reisen nach Pakistan unternommen, von denen ihn zwei nach Karatschi, zwei nach Lahore und eine nach Islamabad geführt hatten.“"
                                            },
                                            {
                                                "example_id": "ee47b7a3-8d72-4f47-8f8c-5207ee4e4a10",
                                                "sense_id": "aa0cbaaf-9d42-3027-a3ee-b78b0b9b67a0",
                                                "text": "„Die Männer drückten mir tief gerührt die Hand, die Frauen küssten mich und hatten Tränen in den Augen, Obristen ließen in der Messe auf mein Wohl trinken, Kompanieoffiziere klopften mir auf die Schulter, ein irischer Subalternoffizier und seine junge Frau nötigten mich, bei ihrem neugeborenen Sohn Pate zu stehen (der Arme wurde mit dem schrecklichen Namen Flashman O'Toole ins Leben entlassen) und die Damen von der Kirchengilde in Lahore schenkten mir einen rotweißblauen Seidenschal mit der gestickten Devise ‚In Treue fest‘.“"
                                            },
                                            {
                                                "example_id": "a2531293-0c41-479f-8ced-d5dcd10cdaf0",
                                                "sense_id": "aa0cbaaf-9d42-3027-a3ee-b78b0b9b67a0",
                                                "text": "„Bis 2007 kamen bei Hinterhalten und Selbstmordanschlägen in größeren Städten wie Islamabad, Lahore und Peschawar mehr als 1500 pakistanische Soldaten und Polizisten ums Leben.“"
                                            },
                                            {
                                                "example_id": "2e51c120-4940-4937-ab74-4a2db88f85fc",
                                                "sense_id": "aa0cbaaf-9d42-3027-a3ee-b78b0b9b67a0",
                                                "text": "„In CIA-Kreisen kursiert das Gerücht, dass er einst in einem Restaurant in Lahore in Pakistan eine Zielperson mit einem Blasrohr getötet hat, ohne dass deren Leibwächter ihn bemerkten.“"
                                            },
                                            {
                                                "example_id": "4eff6593-90e9-4af1-abd7-0a8101d7c933",
                                                "sense_id": "aa0cbaaf-9d42-3027-a3ee-b78b0b9b67a0",
                                                "text": "„Letzter bekannter Aufenthaltsort war Lahore, vor etwas mehr als einer Woche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
