                "senses": [
                    {
                        "sense_id": "496d13dc-6ba0-3e50-b92b-9f0d14f617d5",
                        "entry_id": "c76fe8d8-d193-305e-9f65-95902bf8023b",
                        "glosses": [
                            "(abgezogenes) Fell eines Karakals"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b409ee1-ad0e-4024-9d95-dd56386706da",
                                "sense_id": "496d13dc-6ba0-3e50-b92b-9f0d14f617d5",
                                "text": "„Auf dem internationalen Pelzmarkt werden Karakalfelle jedoch nicht hoch bezahlt und der Pelztierhandel stellt deswegen keine spezifische Gefährdung dieser Katzenart dar.“"
                            },
                            {
                                "example_id": "1f004f9f-ff2e-4a94-8b4b-02345d3cae51",
                                "sense_id": "496d13dc-6ba0-3e50-b92b-9f0d14f617d5",
                                "text": "„Er trägt Hemd und Hose von europäischem Schnitt und die Mütze aus Karakalfell, die bei wohlhabenden Afghanen den Turban abgelöst hat.“"
                            },
                            {
                                "example_id": "79fe4570-5567-4ede-ac88-d0262c48e04a",
                                "sense_id": "496d13dc-6ba0-3e50-b92b-9f0d14f617d5",
                                "text": "„Was aus den von ihm beschriebenen Karakalfellen geworden ist, bleibt fraglich.“"
                            },
                            {
                                "example_id": "69c480b6-69ea-438e-8c0c-f996af69dc09",
                                "sense_id": "496d13dc-6ba0-3e50-b92b-9f0d14f617d5",
                                "text": "„Die Farbe des Karakalfells variiert auf der Oberseite je nach Lebensraum von blass rotbraun in trockenen Gebieten bis zu sandbraun oder sogar ziegelrot in niederschlagsreicheren Gegenden.“"
                            },
                            {
                                "example_id": "5139c03b-5845-4444-91c1-1ef203c72e3a",
                                "sense_id": "496d13dc-6ba0-3e50-b92b-9f0d14f617d5",
                                "text": "„Über Luchs- und Karakalfelle vgl. ediet. Dioclet. S. 124 Blümner“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
