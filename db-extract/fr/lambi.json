                            {
                                "example_id": "a851734f-f081-4781-a1d3-581c2fc29f3c",
                                "sense_id": "f9d78091-8c0f-3bc5-9a1b-06108b293a1b",
                                "text": "En Haïti comme aux Antilles françaises, poulet, cabri, lambi sont des plats très appréciés, accompagnés le plus souvent de riz et de bananes plantains."
                            },
                            {
                                "example_id": "fb2ab7bb-bd29-44d4-a7c5-1a8a9dddf180",
                                "sense_id": "f9d78091-8c0f-3bc5-9a1b-06108b293a1b",
                                "text": "Je m’étais bien reposé mais néanmoins si ce n’était le son de la corne de lambi que faisait résonner Zobra, j’aurais prolongé mon sommeil de deux bonnes heures supplémentaires."
                            }
                        ]
