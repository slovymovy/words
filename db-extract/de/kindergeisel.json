                        "entry_id": "35da41e3-cda2-3c30-876f-53f70df43cef",
                        "glosses": [
                            "Kind, das von Verbrechern zum Schutz (zum Beispiel vor der Polizei) oder zur Forderung eines Lösegeldes festgehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a937fb9-5393-4203-8989-ce9f6abd66b7",
                                "sense_id": "f124915b-a27f-3c4d-98f9-ecc79dab1619",
                                "text": "„Die Welt ist von dem Verbrechen gegen die Kindergeiseln entsetzt.“"
                            },
                            {
                                "example_id": "169db241-3f66-4e1f-85bf-49dc86c94bb6",
                                "sense_id": "f124915b-a27f-3c4d-98f9-ecc79dab1619",
                                "text": "„Von den Kindergeiseln gibt es bis heute kein Lebenszeichen.“"
                            },
                            {
                                "example_id": "37a71068-8bda-4945-85d3-de398fa31c92",
                                "sense_id": "f124915b-a27f-3c4d-98f9-ecc79dab1619",
                                "text": "„Abu Nidals Truppe hielt über Weihnachten die Welt mit der angekündigten und immer wieder verzögerten Freilassung zweier französischer Kindergeiseln in Atem.“"
                            }
                        ],
