                "senses": [
                    {
                        "sense_id": "2614413e-98cb-37d9-bc62-d5cd1e580fe3",
                        "entry_id": "daeb0942-c971-3357-835c-96c6e8becbd3",
                        "glosses": [
                            "instrument de musique à cordes frappées avec clavier construit par C.E. Friederici. Le forte-piano, issu du clavicorde est un des précurseurs du piano."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "756e2076-74d9-4a2e-a089-a75e5c2ed36b",
                                "sense_id": "2614413e-98cb-37d9-bc62-d5cd1e580fe3",
                                "text": "Je vais machinalement m’asseoir au piano, et à l’imitation de Paganini qui ne jouait que sur une seule corde, je me mets bravement à attaquer d'un seul doigt \"Malbrough s’en va-t-en guerre\". Ce chant, veuf d’accompagnement, attire, par son contraste peu harmonieux, l’attention de ma grand-mère. Se penchant alors vers sa voisine : \"Qui est-ce donc qui joue du forté-piano en ce moment ?\", lui dit-elle."
                            },
                            {
                                "example_id": "e6c93a7f-5e88-4722-8641-5f0fd65965e5",
                                "sense_id": "2614413e-98cb-37d9-bc62-d5cd1e580fe3",
                                "text": "Sur un fiasco qu’elle fit à cinq ans au forté-piano à un concert donné par sa mère dans son salon, elle fut reléguée parmi la domesticité."
                            }
                        ]
                    },
                    {
                        "sense_id": "3db2da8b-00d6-3fb5-b856-400400bb1649",
                        "entry_id": "daeb0942-c971-3357-835c-96c6e8becbd3",
                        "glosses": [
                            "Le fait de passer d'une nuance forte à une nuance piano sans transition."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
