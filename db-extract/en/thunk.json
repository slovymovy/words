                    {
                        "sense_id": "7680db6b-e065-32ca-bc1c-04fb4b783888",
                        "entry_id": "b267a2f2-b58d-3476-828a-f606e6cbd1f1",
                        "glosses": [
                            "Frapper quelque chose sans le briser, en émettant un bruit sourd."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ead76787-dc82-4566-aa03-9ccca17e17d5",
                                "sense_id": "7680db6b-e065-32ca-bc1c-04fb4b783888",
                                "text": "I was thunked on the head by his stick."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc264d6e-c42c-37bb-a049-4a58ed3c78fc",
                        "entry_id": "b267a2f2-b58d-3476-828a-f606e6cbd1f1",
                        "glosses": [
                            "Utiliser une translation de données."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd70d259-6caa-4948-a03a-248b35156de9",
                                "sense_id": "cc264d6e-c42c-37bb-a049-4a58ed3c78fc",
                                "text": "It’s up to you to come up with an intermediate process that converts the addresses and surmounts the stack differences. This is where \"thunking\" enters the picture. To thunk, you create a 32-bit DLL that mediates between the 16-bit and 32-bit stacks, ensuring that data is correctly pushed onto and taken off of the stacks."
                            }
                        ]
                    }
                ],
