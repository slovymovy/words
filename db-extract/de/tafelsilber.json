                                    },
                                    {
                                        "sense_id": "33836293-0d41-3e06-961d-8ab272cf6f0e",
                                        "entry_id": "b4ec4e71-cd5e-3117-8695-f062bcd331a6",
                                        "glosses": [
                                            "A shiny gray color."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ca2a76b-7802-4232-aea1-f7b22107a78d",
                                                "sense_id": "33836293-0d41-3e06-961d-8ab272cf6f0e",
                                                "text": "I'll need some mayonnaise and a silver tin of sardines, a banana."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e40701f1-3384-3257-a43a-801b52e084c6",
                                        "entry_id": "b4ec4e71-cd5e-3117-8695-f062bcd331a6",
                                        "glosses": [
                                            "a silver medal"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "01f838ab-8f08-3a14-86dd-aa9d17a72eaa",
                                        "entry_id": "b4ec4e71-cd5e-3117-8695-f062bcd331a6",
                                        "glosses": [
                                            "Anything resembling silver; something shiny and white."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f82f7e24-a819-45d4-90b7-7f2f8aff2f28",
                                                "sense_id": "01f838ab-8f08-3a14-86dd-aa9d17a72eaa",
                                                "text": "And next morning they found him dead, with his neck broken, in the bottom of the stone pit, with his beautiful clothes a little bloody, and foul and stained with the duckweed from the pond. But his face was a face of such happiness that, had you seen it, you would have understood indeed how that he had died happy, never knowing that cool and streaming silver for the duckweed in the pond."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "silver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf371af6-88ad-33eb-ada9-f4df0adc1e34",
                                        "entry_id": "db175ae8-27d6-30ff-b46b-f9799647248a",
                                        "glosses": [
                                            "Made from silver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a5387d6-5eba-4daf-b961-dc75faf084d0",
                                                "sense_id": "cf371af6-88ad-33eb-ada9-f4df0adc1e34",
                                                "text": "He looked round the poor room, at the distempered walls, and the bad engravings in meretricious frames, the crinkly paper and wax flowers on the chiffonier; and he thought of a room like Father Bryan's, with panelling, with cut glass, with tulips in silver pots, such a room as he had hoped to have for his own."
                                            },
                                            {
                                                "example_id": "6cf5c415-16f5-4c05-94ce-1f70bad77e58",
                                                "sense_id": "cf371af6-88ad-33eb-ada9-f4df0adc1e34",
                                                "text": "But Richmond[…]appeared to lose himself in his own reflections. Some pickled crab, which he had not touched, had been removed with a damson pie; and his sister saw, peeping around the massive silver epergne that almost obscured him from her view, that he had eaten no more than a spoonful of that either."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2260a27-1821-321d-9a6e-115e78a67f2a",
                                        "entry_id": "db175ae8-27d6-30ff-b46b-f9799647248a",
                                        "glosses": [
                                            "Made from another white metal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a46d49e5-ba03-3eef-a60b-3c26e9d391cb",
                                        "entry_id": "db175ae8-27d6-30ff-b46b-f9799647248a",
                                        "glosses": [
                                            "Having a color like silver: a shiny gray."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8dde442e-d3f0-30f9-983b-7e7442a99db2",
                                        "entry_id": "db175ae8-27d6-30ff-b46b-f9799647248a",
                                        "glosses": [
                                            "Denoting the twenty-fifth anniversary, especially of a wedding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a1f38d7-1ab4-4e86-9201-14982f84ec4c",
                                                "sense_id": "8dde442e-d3f0-30f9-983b-7e7442a99db2",
                                                "text": "Mostly, these have been relationships of 10 or less years. However, one respondent has celebrated her silver wedding anniversary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1ce3f6d-e047-37ca-9a31-55958c0445ff",
                                        "entry_id": "db175ae8-27d6-30ff-b46b-f9799647248a",
                                        "glosses": [
                                            "Premium, but inferior to gold."
                                        ],
                                        "tags": [
                                            "of commercial services"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c781d12e-2c29-35b2-a554-456b27149a6c",
                                        "entry_id": "db175ae8-27d6-30ff-b46b-f9799647248a",
                                        "glosses": [
                                            "Pertaining or relating to elderly persons."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "839838e7-6d63-3d58-ba89-49ad5116c0ef",
                                        "entry_id": "db175ae8-27d6-30ff-b46b-f9799647248a",
                                        "glosses": [
                                            "Having the clear, musical tone of silver; soft and clear in sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49998c67-96b8-4c64-87f9-7463d5a128fe",
                                                "sense_id": "839838e7-6d63-3d58-ba89-49ad5116c0ef",
                                                "text": "a silver-voiced young girl"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "silver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee121c9b-ba03-3a24-bfd7-2f3758ddf2bc",
                                        "entry_id": "dc20a8b7-a991-3bee-9b80-63f5a131e533",
                                        "glosses": [
                                            "To acquire a silvery colour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46cc2d50-4bdb-467c-b886-028823e9dcbc",
                                                "sense_id": "ee121c9b-ba03-3a24-bfd7-2f3758ddf2bc",
                                                "text": "Presently all the eastern sky began to silver and shine, and objects before invisible in the west—chiefly the tall towers on Mount Zion—emerged as from a shadowy depth, [...]"
                                            },
                                            {
                                                "example_id": "aa2c0402-4c13-433d-ae41-40b7d6f7af55",
                                                "sense_id": "ee121c9b-ba03-3a24-bfd7-2f3758ddf2bc",
                                                "text": "But when the moon rose and the breeze awakened, and the sedges stirred, and the cat's-paws raced across the moonlit ponds, and the far surf off Wonder Head intoned the hymn of the four winds, the trinity, earth and sky and water, became one thunderous symphony—a harmony of sound and colour silvered to a monochrome by the moon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6489d085-651a-3896-8699-134df2b0d73f",
                                        "entry_id": "dc20a8b7-a991-3bee-9b80-63f5a131e533",
                                        "glosses": [
                                            "To cover with silver, or with a silvery metal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e32ab86-0583-4107-84be-70f380fed01f",
                                                "sense_id": "6489d085-651a-3896-8699-134df2b0d73f",
                                                "text": "to silver a pin; to silver a glass mirror plate with an amalgam of tin and mercury"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb1aa30f-06fc-3f2b-9dc6-808a92eb6fbb",
                                        "entry_id": "dc20a8b7-a991-3bee-9b80-63f5a131e533",
                                        "glosses": [
                                            "To polish like silver; to impart a brightness to, like that of silver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40286a52-b8f1-4311-bbbf-328241a9e857",
                                                "sense_id": "eb1aa30f-06fc-3f2b-9dc6-808a92eb6fbb",
                                                "text": "For here retir'd the ſinking billows ſleep, / And ſmiling calmneſs ſilver'd o'er the deep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e9e0d86-ecac-3018-91e9-e7b28c58a42a",
                                        "entry_id": "dc20a8b7-a991-3bee-9b80-63f5a131e533",
                                        "glosses": [
                                            "To make hoary, or white, like silver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca8d24a1-040f-4b5b-99f0-59a372689ceb",
                                                "sense_id": "2e9e0d86-ecac-3018-91e9-e7b28c58a42a",
                                                "text": "Remote from cities liv'd a Swain, / Unvex'd with all the cares of gain, / His head was ſilver'd o'er with age, / And long experience made him ſage; [...]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
