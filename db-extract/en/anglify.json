                        "glosses": [
                            "To convert to English (language or culture); to anglicise."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "cfe153ff-aea1-46bd-b08f-c2dc741fb9bc",
                                "sense_id": "22fd5772-664e-3990-a361-9df70332101c",
                                "text": "Why should Pennsylvania […] become a Colony of aliens, who will shortly be so numerous as to Germanize us, instead of our Anglifying them, and will never adopt our language or customs, any more than they can acquire our complexion?"
                            },
                            {
                                "example_id": "3dcc9e7d-d555-472f-9a3e-2f39186c7376",
                                "sense_id": "22fd5772-664e-3990-a361-9df70332101c",
                                "text": "Englishmen speak to their servants in French, and the shops are all French; indeed I should think that Calais or Boulogne was much more Anglified"
                            }
                        ]
                    }
