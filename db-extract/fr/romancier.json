            {
                "entry_id": "906d460e-9443-3bab-9fa0-a8c3f1477b59",
                "word": "romancier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "59dc1700-3183-42ad-b002-15026d814857",
                        "entry_id": "906d460e-9443-3bab-9fa0-a8c3f1477b59",
                        "tags": [
                            "plural"
                        ],
                        "form": "romanciers"
                    },
                    {
                        "form_id": "f563f185-39b9-47c2-b26f-12e25bb67057",
                        "entry_id": "906d460e-9443-3bab-9fa0-a8c3f1477b59",
                        "tags": [
                            "feminine"
                        ],
                        "form": "romancière"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "728608c7-2b95-32e0-856e-44a98b2a136e",
                        "entry_id": "906d460e-9443-3bab-9fa0-a8c3f1477b59",
                        "glosses": [
                            "Auteur d’ouvrages en français, au Moyen Âge."
                        ],
                        "tags": [
                            "Sens étymologique"
                        ],
                        "examples": [
                            {
                                "example_id": "65a9f373-32b2-4e1f-9476-a66980a3bfe8",
                                "sense_id": "728608c7-2b95-32e0-856e-44a98b2a136e",
                                "text": "Une invention de romancier, (…) qui fut lui-même un jongleur et qui (…) resta des années, vers le début du XIIIᵉ siècle, au service d’un haut baron."
                            }
                        ]
                    },
                    {
                        "sense_id": "c25f02be-1bb8-3edc-9051-ec61b4ff31fb",
                        "entry_id": "906d460e-9443-3bab-9fa0-a8c3f1477b59",
                        "glosses": [
                            "Auteur qui écrit des romans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be363e4e-9a07-4b2b-83de-ef688165dd75",
                                "sense_id": "c25f02be-1bb8-3edc-9051-ec61b4ff31fb",
                                "text": "Aujourd’hui plus que jamais, les romanciers disposent de ces effets, et ils sont dans leur droit ; car la nature s’est, de tout temps, permis d’être plus forte qu’eux."
                            },
                            {
                                "example_id": "8776f8f4-1aaf-4f34-b9e9-ef35f8e92532",
                                "sense_id": "c25f02be-1bb8-3edc-9051-ec61b4ff31fb",
                                "text": "L'historien n'a pas à délivrer des prix de vertu, […] ; les questions qui intéressent les chroniqueurs et passionnent les romanciers sont celles qu'il laisse le plus volontiers de côté."
                            },
                            {
                                "example_id": "4bdcdb30-73cf-4ed8-bd3e-8e21d3453fca",
                                "sense_id": "c25f02be-1bb8-3edc-9051-ec61b4ff31fb",
                                "text": "Un éditeur […] lui proposa de rafistoler les manuscrits d'un grand faiseur feuilletonnesque. […]. Henri se mit à la besogne, remania l'infâme et crasseuse foutaise du romancier célèbre, pimenta cette ratatouille sans goût."
                            },
                            {
                                "example_id": "4f6fb8b6-c44e-4264-8ec4-a7b26e4ce530",
                                "sense_id": "c25f02be-1bb8-3edc-9051-ec61b4ff31fb",
                                "text": "Alors que le romancier, riche de son don d'ubiquité, peut se dédoubler en autant de personnages que son humeur daigne susciter au fil des pages, le poète reste fixé à la finitude de son expérience, à la racine de son cri."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04fa3884-3445-4261-9b0a-8b15be1c5015",
                        "source_entry_id": "906d460e-9443-3bab-9fa0-a8c3f1477b59",
                        "target_lang_word": "Romancier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Romancier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16810161-534b-34df-9e48-885f0d216d32",
                                        "entry_id": "291acd4e-1a6e-36e1-8446-1b48179ec0c2",
                                        "glosses": [
                                            "Autor/Schriftsteller, der Romane verfasst"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73fc21b1-3921-40d8-a481-3d61d282b33e",
                                                "sense_id": "16810161-534b-34df-9e48-885f0d216d32",
                                                "text": "„Der Film, für den die älteren Bereiche der Kulturproduktion gewissermaßen zuliefern, zog Theaterschauspieler und Regisseure ebenso an wie Musiker und Maler, Fotografen und Philosophen, Journalisten und Lyriker, Modedesigner und Romanciers.“"
                                            },
                                            {
                                                "example_id": "9afe75a9-a596-4250-bd75-0cff21c6f989",
                                                "sense_id": "16810161-534b-34df-9e48-885f0d216d32",
                                                "text": "„Natürlich haben die Romanciers des 19. Jahrhunderts sich nicht derselben Kategorien wie wir bedient, um die Gesellschaftsstruktur ihrer Zeit darzustellen.“"
                                            },
                                            {
                                                "example_id": "789d2316-e5b9-430d-91f0-e69d29883cd1",
                                                "sense_id": "16810161-534b-34df-9e48-885f0d216d32",
                                                "text": "„Auf dem Weg zum Schiff entdecken wir an der Rheinpromenade einen Gedenkstein mit bronzener Platte für den großen französischen Romancier Victor Hugo, der auf seiner Rheinreise im Oktober 1840 die Stadt besuchte.“"
                                            },
                                            {
                                                "example_id": "4e28a321-db1a-4473-a068-125303823e21",
                                                "sense_id": "16810161-534b-34df-9e48-885f0d216d32",
                                                "text": "„Nach 19 Kapiteln scheint der erfahrene Romancier bemerkt zu haben, dass die Sache für ein Gesellschaftsporträt im Plauderton doch zu heikel war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
