{
    "word_family": [
        "invention",
        "inventor",
        "inventive",
        "invent"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1c6fe2a2-8f80-3f68-b170-befd78c7fe22",
                    "sense_definition": "To create or develop something that already exists, often wasting time by not using existing solutions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>reinvent</w> the wheel when there are already efficient tools available for this task.",
                            "target_lang_translations": {
                                "zh": "既然已经有高效的工具可用，就不要<w>重复发明</w>轮子了。"
                            }
                        },
                        {
                            "text": "The team spent weeks <w>reinventing</w> the wheel instead of using the company's existing software library.",
                            "target_lang_translations": {
                                "zh": "团队花了数周时间<w>重复发明</w>轮子，而不是使用公司现有的软件库。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "reinvent the wheel"
                    ],
                    "target_lang_definitions": {
                        "zh": "指重复发明已有的事物，通常指因不利用现有方案而浪费时间。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "重复发明",
                                "target_lang_sense_clarification": "指在已有解决方案的情况下，再次进行不必要的开发。"
                            },
                            {
                                "target_lang_word": "另起炉灶",
                                "target_lang_sense_clarification": "比喻放弃现有的基础，重新开始，常含贬义。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f59e7fb6-bd6c-3026-bb3f-43740a23f0dc",
                    "sense_definition": "To change or transform something or someone into a new form, style, or image.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transformation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist managed to <w>reinvent</w> herself after years of silence by releasing a completely different album.",
                            "target_lang_translations": {
                                "zh": "这位艺术家在沉寂多年后，通过发行一张风格迥异的专辑成功实现了自我<w>重塑</w>。"
                            }
                        },
                        {
                            "text": "The company needs to <w>reinvent</w> its brand image to attract a younger generation of customers.",
                            "target_lang_translations": {
                                "zh": "公司需要<w>重塑</w>其品牌形象，以吸引更年轻一代的客户。"
                            }
                        }
                    ],
                    "synonyms": [
                        "transform",
                        "revamp",
                        "rebrand"
                    ],
                    "common_phrases": [
                        "reinvent oneself"
                    ],
                    "target_lang_definitions": {
                        "zh": "指将某人或某物改变或重塑为新的形式、风格或形象。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "重塑",
                                "target_lang_sense_clarification": "指彻底改变某人或某物的形象或结构。"
                            },
                            {
                                "target_lang_word": "彻底改造",
                                "target_lang_sense_clarification": "指对某事物进行根本性的改变。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}