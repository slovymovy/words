                "senses": [
                    {
                        "sense_id": "97e6a163-b624-34ad-b67a-0ce914a7f32b",
                        "entry_id": "09f6ba9f-61ff-37e9-82d3-26c62867654d",
                        "glosses": [
                            "маленькая мужская круглая шапочка из мягкой ткани без околыша, плотно прилегающая к голове"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ad5edb9-4006-4ab8-8598-6a916e9d54b5",
                        "source_entry_id": "09f6ba9f-61ff-37e9-82d3-26c62867654d",
                        "source_sense_id": "97e6a163-b624-34ad-b67a-0ce914a7f32b",
                        "target_lang_word": "yarmulke",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yarmulke",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8319542-9666-3d8f-aff8-14ce34cb1bbc",
                                        "entry_id": "8daac55b-d2b7-3b63-b29b-eec01e1aefb2",
                                        "glosses": [
                                            "A skullcap worn by religious Jewish males (especially during prayer)."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5456cab-e2f9-4588-96d1-c28b6b70f9e9",
                                                "sense_id": "a8319542-9666-3d8f-aff8-14ce34cb1bbc",
                                                "text": "And I always feel uncomfortable dur­ing the High Holy Days watching people in yarmulkes rushing through the streets, knowing they’ll be swaying and moaning something ancient and indecipherable, even to me."
                                            },
                                            {
                                                "example_id": "dddb244c-1f7a-4244-a6c7-3527f600ef65",
                                                "sense_id": "a8319542-9666-3d8f-aff8-14ce34cb1bbc",
                                                "text": "But once Dr. Levenson, who works for the Indian Health Service and wears a colorful tapestry yarmulke, has alerted the tiny network, it almost seems as if we have stepped into Yiddishland."
                                            },
                                            {
                                                "example_id": "db4cd55f-fe3f-4914-b7ab-8b31f16d6f4f",
                                                "sense_id": "a8319542-9666-3d8f-aff8-14ce34cb1bbc",
                                                "text": "“I call on all citizens of Berlin and across Germany to wear the yarmulke (as the skullcap is known in Yiddish) next Saturday if there are new, intolerable attacks targeting Israel and Jews on the occasion of Al-Quds Day in Berlin,” said Felix Klein in a statement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e96b69b-ef32-4fdd-b4cc-de07b2dba530",
                        "source_entry_id": "09f6ba9f-61ff-37e9-82d3-26c62867654d",
                        "source_sense_id": "97e6a163-b624-34ad-b67a-0ce914a7f32b",
                        "target_lang_word": "jarmułka",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jarmułka",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "e3d7a62c-9344-36fd-9afb-f4fcbfd6ba0e",
                                        "entry_id": "3fa482c0-dd1e-3101-ae18-46456c29cb1e",
                                        "glosses": [
                                            "okrągła czapeczka bez daszka, okrywająca tylko czubek głowy, noszona głównie przez Żydów"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cf5d1a4-308b-4ceb-ad4a-69642a0563e2",
                                                "sense_id": "e3d7a62c-9344-36fd-9afb-f4fcbfd6ba0e",
                                                "text": "Była to broda siwa i siwe włosy, dobywające się spod jarmułki aksamitnej"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
