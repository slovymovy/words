                "senses": [
                    {
                        "sense_id": "900efa8b-d2a1-3686-9b46-8b4b074435af",
                        "entry_id": "8db05578-910d-39c8-bde0-8ca32d3cc062",
                        "glosses": [
                            "Redonner un caractère plus hispanique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e579c67b-fcaf-488c-85b6-2f0d79fb20be",
                                "sense_id": "900efa8b-d2a1-3686-9b46-8b4b074435af",
                                "text": "la seconde est qu’il ne s'agissait pas d’européaniser la péninsule, mais bien au contraire de « réhispaniser » la péninsule elle—même, afin de mieux hispaniser l’Europe ensuite."
                            },
                            {
                                "example_id": "d7a269b7-f763-41ad-b359-03640cd3c575",
                                "sense_id": "900efa8b-d2a1-3686-9b46-8b4b074435af",
                                "text": "Mais il ne fait que l'affirmer, il veut réhispaniser l'équipe."
                            },
                            {
                                "example_id": "6fbddd68-e6d6-4a5a-8853-f1ec29b60ea2",
                                "sense_id": "900efa8b-d2a1-3686-9b46-8b4b074435af",
                                "text": "Les textes de la presse judéo-espagnole de la fin du dix-neuvième siècle témoignent, en ce sens, de la volonté des auteurs de réhispaniser le judéo-espagnol, en prenant la langue écrite espagnole comme modèle culturel."
                            }
                        ]
                    }
