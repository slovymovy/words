                "senses": [
                    {
                        "sense_id": "3a53c14d-2e69-37d7-821c-c91a7f15bc95",
                        "entry_id": "1137359d-5cea-38eb-9d15-9b41924dc0db",
                        "glosses": [
                            "Relatif à l’anxiété et la dépression."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f1447ce-b49c-458c-8491-e88f11a9b431",
                                "sense_id": "3a53c14d-2e69-37d7-821c-c91a7f15bc95",
                                "text": "Les résultats, posant sur le salarié le diagnostic d’un « syndrome anxiodépressif majeur », dédouanaient l’employeur, qui les avait ensuite utilisés pour sa défense dans le procès en faute inexcusable intenté par la veuve de l’ingénieur."
                            },
                            {
                                "example_id": "e87df505-60aa-40b8-a9da-6f5152992685",
                                "sense_id": "3a53c14d-2e69-37d7-821c-c91a7f15bc95",
                                "text": "On parle désormais d’états anxiodépressifs car l’anxiété est en croissance."
                            },
                            {
                                "example_id": "1a68a929-531e-4134-9d97-af616a995d72",
                                "sense_id": "3a53c14d-2e69-37d7-821c-c91a7f15bc95",
                                "text": "Selon les psychiatres, M. Turcotte souffrait d’un trouble d’adaptation avec humeur anxiodépressive, lors des événements."
                            },
                            {
                                "example_id": "2350f5be-8a0d-4273-a5de-99dc59018f7f",
                                "sense_id": "3a53c14d-2e69-37d7-821c-c91a7f15bc95",
                                "text": "Confronté pendant deux ans à des récriminations incessantes, le commandant de la compagnie avait dû faire l’objet d’un suivi pour un état anxiodépressif."
                            }
                        ]
                    }
