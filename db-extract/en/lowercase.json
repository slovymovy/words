                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f720763-7a7d-3505-ba33-1f11cb006ca9",
                                        "entry_id": "59183d49-7d53-3405-bc2f-428e2929c652",
                                        "glosses": [
                                            "von geringem Ausmaß"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88ef9d19-64de-416b-bcfb-9300fe555fbc",
                                                "sense_id": "0f720763-7a7d-3505-ba33-1f11cb006ca9",
                                                "text": "Das ist ein kleines Haus."
                                            },
                                            {
                                                "example_id": "730eeebd-f5c3-422a-905f-3400ff75ab8e",
                                                "sense_id": "0f720763-7a7d-3505-ba33-1f11cb006ca9",
                                                "text": "Wale ernähren sich von Plankton und kleinen Fischen."
                                            },
                                            {
                                                "example_id": "fabd7df4-9770-4822-a82c-22802b971355",
                                                "sense_id": "0f720763-7a7d-3505-ba33-1f11cb006ca9",
                                                "text": "„Blumen produzieren Pollenkörner. Sie sind klein und leicht und einige von ihnen so geformt, dass sie über lange Entfernungen durch die Luft treiben können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "55d6c0ec-086f-3a68-a6cc-ba7afcadafc0",
                                        "entry_id": "59183d49-7d53-3405-bc2f-428e2929c652",
                                        "glosses": [
                                            "unbedeutend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bbcc9cd-da6a-427c-9b24-3fad91d1e37c",
                                                "sense_id": "55d6c0ec-086f-3a68-a6cc-ba7afcadafc0",
                                                "text": "Ich bin hier nur ein kleiner Angestellter."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d1f73b6b-a792-3c43-b9fa-b0519678218c",
                                        "entry_id": "59183d49-7d53-3405-bc2f-428e2929c652",
                                        "glosses": [
                                            "als Kleinbuchstabe, in Kleinbuchstaben oder mit kleinem Anfangsbuchstaben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0376a6f0-35c9-4eb0-a208-d8b432745198",
                                                "sense_id": "d1f73b6b-a792-3c43-b9fa-b0519678218c",
                                                "text": "„haut“ mit kleinem h"
                                            },
                                            {
                                                "example_id": "3cf6a535-9b0d-4e96-ae1e-5f4bef1ef136",
                                                "sense_id": "d1f73b6b-a792-3c43-b9fa-b0519678218c",
                                                "text": "Substantive werden großgeschrieben, Adjektive klein."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "af2c2a55-3521-3ae4-af06-c9f2f1087783",
                                        "entry_id": "59183d49-7d53-3405-bc2f-428e2929c652",
                                        "glosses": [
                                            "jung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c14760f6-525b-4e99-a7e3-082dd6f6c52e",
                                                "sense_id": "af2c2a55-3521-3ae4-af06-c9f2f1087783",
                                                "text": "„Hänschen klein / ging allein / in die weite Welt hinein.“"
                                            },
                                            {
                                                "example_id": "87155a1e-51d1-4ce5-84ae-dcb431c29f09",
                                                "sense_id": "af2c2a55-3521-3ae4-af06-c9f2f1087783",
                                                "text": "„Frau Berta saß in der Felsenkluft, / Sie klagt ihr bitt'res Loos; Klein Roland spielt' in freier Luft; / Deß Klage war nicht groß.“"
                                            },
                                            {
                                                "example_id": "8bdd0718-f327-4241-8564-da987d830e1a",
                                                "sense_id": "af2c2a55-3521-3ae4-af06-c9f2f1087783",
                                                "text": "„Laß beide uns fliehn zu dem Englein hin, / Damit du nicht werdest, was ich jetzt bin: // Eine arme Mutter, verlassen, allein, / Verstoßen, verhöhnt, mit dem Kindchen klein!“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
