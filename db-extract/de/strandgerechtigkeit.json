                ],
                "senses": [
                    {
                        "sense_id": "dddf5685-5049-3d7f-89f6-1c4a735dc45d",
                        "entry_id": "4d786737-8b62-3395-976d-dc16b040963a",
                        "glosses": [
                            "Recht, über das Strandgut, die gestrandete Schiffe und die Wracks eines bestimmten Küstenabschnittes zu verfügen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a09de6b-1ed6-4aef-977d-1c8dcc4d79c2",
                                "sense_id": "dddf5685-5049-3d7f-89f6-1c4a735dc45d",
                                "text": "Diese Strandgerechtigkeit ist ein Attribut der Stadt bis ins 19. Jahrhundert geblieben, dann auf den Fiscus, vertreten durch das, die Hafenpolizei ausübende, Haupt-Zollamt in Kolbergermünde übergegangen."
                            },
                            {
                                "example_id": "f644ad88-e7a0-4147-a32c-24f6eb16dfbd",
                                "sense_id": "dddf5685-5049-3d7f-89f6-1c4a735dc45d",
                                "text": "Die Strandgerechtigkeit wurde durch die Fürsten verschenkt, vererbt, verkauft!"
                            },
                            {
                                "example_id": "de2bcdd4-965e-4395-b86e-2999cc6467b9",
                                "sense_id": "dddf5685-5049-3d7f-89f6-1c4a735dc45d",
                                "text": "In eben diesem Privilegium wurde der Stadt die Strandgerechtigkeit von der alten Rega an bis Nest mit allen Zubehörungen und Gerechtigkeiten, dahin ertheilt, daß Niemand anders, als die vom Rathe gesetzten Vorsteher des Hafens die an den Strand geschlagenen Güter und Waaren in Verwahrung nehmen, solche, wenn es unverderbliche Waaren sind, für den Kaufmann, so den Schiffbruch erlitten hat, aufbehalten, und wenn er komme, sich ihm frei jedoch gegen Erlegung eines billigen Bergegeldes wieder geben sollen: wären es aber verderbliche Waaren, so sollen die Vorsteher des Hafens selbige verkaufen, das dafür eingenommene Geld aber den Eigenthümer derselben, wenn er sich melde, für ein billiges Bergegeld zustellen; sollte sich Niemand zu dem gestrandeten Gute melden, so solle dasselbe zu Nutzen und zur Verbesserung des Hafens angewendet werden."
                            },
                            {
                                "example_id": "cd6e1c17-a9a7-4f44-b020-f302cde5a6e5",
                                "sense_id": "dddf5685-5049-3d7f-89f6-1c4a735dc45d",
                                "text": "Die Ostsee wirft längs des Strandes eine ansehnliche Menge von Kalksteinen aus. Die Gutsherrschaft, der durch die landesherrlichen Privilegien vom 9. Dezember 1699 und 12. Juli 1714 die Strandgerechtigkeit verliehen ist, läßt diese Kalksteine sammeln und in ihrem Kalkofen brennen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
