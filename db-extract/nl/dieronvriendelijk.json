                        "entry_id": "43f0c55c-30c7-3106-9d13-bbdfd0f4c8a2",
                        "glosses": [
                            "van iets dat het niet prettig is voor dieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bd48bad-775f-4469-b7e6-0b482066425f",
                                "sense_id": "db418ac6-1a62-3ebd-8c4d-4478b7c48ea4",
                                "text": "Een voorstel van de Partij voor de Dieren om daar een stokje voor te steken, kreeg de steun van alle partijen. Subsidies horen volgens de Partij voor de Dieren niet te gaan naar dieronvriendelijk leedvermaak."
                            },
                            {
                                "example_id": "8fe3b7b8-b30e-453e-80fb-45ed8bd2e51c",
                                "sense_id": "db418ac6-1a62-3ebd-8c4d-4478b7c48ea4",
                                "text": "Vooral in de vleessector is het aantal duurzame aanbiedingen vorig jaar fors gedaald, met 40 procent. Er waren in totaal 83 aanbiedingen van diervriendelijk geproduceerd vlees. Ter vergelijking: in hetzelfde jaar stuntten de acht grootste supermarktketens ruim 3000 keer met - zoals Wakker Dier zegt - 'dieronvriendelijk industrievlees'."
                            }
                        ]
                    }
