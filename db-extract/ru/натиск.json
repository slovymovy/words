                        ]
                    },
                    {
                        "translation_id": "6635ff70-280a-4409-bd7c-db3e6662fce4",
                        "source_entry_id": "fee2a9b2-e3bd-362b-8687-2821e61564ca",
                        "target_lang_word": "poussée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poussée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb68c781-8f6f-34da-a9ca-3b17c4ad1d05",
                                        "entry_id": "cd9177f3-2399-3f3c-a6a6-04f9d8f63f65",
                                        "glosses": [
                                            "Action de pousser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90333ffe-6c72-4d96-a46f-fd6940d59341",
                                                "sense_id": "eb68c781-8f6f-34da-a9ca-3b17c4ad1d05",
                                                "text": "Une bousculade plus violente se produisit ; les petits veaux et les génisses rejetés de droite et de gauche par la poussée des grands bestiaux s’égratignèrent aux ronces flottantes des haies."
                                            },
                                            {
                                                "example_id": "eb8e3ebb-5e33-4cd8-a866-c0431913668c",
                                                "sense_id": "eb68c781-8f6f-34da-a9ca-3b17c4ad1d05",
                                                "text": "Le 9 juin, après une brève accalmie, elle doit affronter l'offensive allemande qui se développe dans la région de Thugny-Trugny et de Givry et réussit de nouveau à rétablir son front. Mais la poussée allemande est telle que le 14 juin, la 14ᵉ DI est obligée de battre en retraite […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9179c9a-f371-3709-b404-4db264a87c99",
                                        "entry_id": "cd9177f3-2399-3f3c-a6a6-04f9d8f63f65",
                                        "glosses": [
                                            "Action de pousser violemment."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a22a5e13-d095-487c-9bf0-ec8d2299595a",
                                                "sense_id": "d9179c9a-f371-3709-b404-4db264a87c99",
                                                "text": "Donner une poussée à quelqu’un."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88f91ea8-e997-3abf-8a60-cd5a3b9ca7d2",
                                        "entry_id": "cd9177f3-2399-3f3c-a6a6-04f9d8f63f65",
                                        "glosses": [
                                            "Pression, effort exercé par un objet (une construction, par des terres)."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e1c4af9-528d-4f07-bb46-db580cd711cf",
                                                "sense_id": "88f91ea8-e997-3abf-8a60-cd5a3b9ca7d2",
                                                "text": "Il faut que cet arc-boutant soit bien fort pour soutenir la poussée de cette voûte, de cette arcade. — Ce mur est assez épais pour résister à la poussée des terres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f647df2b-aadb-31b9-b4da-364ffe7c2168",
                                        "entry_id": "cd9177f3-2399-3f3c-a6a6-04f9d8f63f65",
                                        "glosses": [
                                            "Force d’un réacteur, d’un moteur-fusée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e297a19b-0f1c-4976-93ed-a94970c9a290",
                                                "sense_id": "f647df2b-aadb-31b9-b4da-364ffe7c2168",
                                                "text": "Cinq moteurs de 3.400.000 kilos de poussée les ont projetés vers la lune à 39.000 km/h."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77453513-ca22-38b2-9e46-e1baeec6a1f8",
                                        "entry_id": "cd9177f3-2399-3f3c-a6a6-04f9d8f63f65",
                                        "glosses": [
                                            "Manifestation brusque, subite d’un mal, d’une maladie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "720e9c85-91f3-4733-8cea-e30df7d85d48",
                                                "sense_id": "77453513-ca22-38b2-9e46-e1baeec6a1f8",
                                                "text": "La suppression de la fonction ovarienne entraîne souvent une poussée d’obésité à laquelle s'associe l’empâtement des formes, du masculinisme avec hypertrichose, rappelant dans une certaine mesure le masculinisme cortico-surrénal."
                                            },
                                            {
                                                "example_id": "11dc56d5-5624-4a5d-ae54-83a7a9807bc4",
                                                "sense_id": "77453513-ca22-38b2-9e46-e1baeec6a1f8",
                                                "text": "De longues poussées comme si on lui eût enfoncé un fil de fer au cœur des os."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "524ed004-ddd7-3888-bead-6498cae27bdc",
                                        "entry_id": "cd9177f3-2399-3f3c-a6a6-04f9d8f63f65",
                                        "glosses": [
                                            "Accès."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b1d8abc-fc03-492b-a2d2-720b315955c0",
                                                "sense_id": "524ed004-ddd7-3888-bead-6498cae27bdc",
                                                "text": "Il s’ensuit au début des années 1990 une poussée de japonophobie aux États-Unis, puis l'abandon par Bill Clinton en 1993 de la S.I.I.. En synchronie, le Japon réduit ses investissements directs et diminue ses prêts à court terme […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3438640a-c4d0-3c97-b576-ce66c4dcc8b3",
                                        "entry_id": "cd9177f3-2399-3f3c-a6a6-04f9d8f63f65",
                                        "glosses": [
                                            "Grande quantité qui survient à la fois."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1230d184-4fe4-49eb-bc4e-5094d7162712",
                                                "sense_id": "3438640a-c4d0-3c97-b576-ce66c4dcc8b3",
                                                "text": "Une poussée de travail."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poussée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f8c38bfa-acd0-319e-8d36-a05b9e40635a",
