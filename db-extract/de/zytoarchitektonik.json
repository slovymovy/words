                    {
                        "sense_id": "8afa6476-f21a-3255-a7fd-c31b54826a4f",
                        "entry_id": "3bd52e75-2bc5-34f5-847c-24e6012556b4",
                        "glosses": [
                            "zelluläre Zusammensetzung und Anordnung, insbesondere im Bereich der Großhirnrinde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9959aa82-16b7-4222-914b-ac0531c0986e",
                                "sense_id": "8afa6476-f21a-3255-a7fd-c31b54826a4f",
                                "text": "„Die Zytoarchitektonik des Frontalkortex ist dadurch gekennzeichnet, dass die Pyramidenzellen in Lamina III und V das Bild beherrschen und die Körnerzellschichten in den Hintergrund treten.“"
                            },
                            {
                                "example_id": "e76d26a8-e904-4d0d-9752-eb93b133630f",
                                "sense_id": "8afa6476-f21a-3255-a7fd-c31b54826a4f",
                                "text": "„Körpersignale werden allgemein als eher unpräzise angesehen und agranulare viszeromotorische Regionen aufgrund ihrer Zytoarchitektonik wenig sensitiv für Vorhersagefehler.“"
                            }
                        ],
