        "fr-extract.jsonl": [
            {
                "entry_id": "ed6016c4-cd4b-39b9-8a1f-362724e86613",
                "word": "réglementation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c7794f8d-8b49-46a2-995c-59bcf8f7943a",
                        "entry_id": "ed6016c4-cd4b-39b9-8a1f-362724e86613",
                        "tags": [
                            "plural"
                        ],
                        "form": "réglementations"
                    },
                    {
                        "form_id": "efc9700e-f8fb-422d-b5fd-cbc98b975dd8",
                        "entry_id": "ed6016c4-cd4b-39b9-8a1f-362724e86613",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "règlementation"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "973bea42-3423-3444-b138-6cf853243914",
                        "entry_id": "ed6016c4-cd4b-39b9-8a1f-362724e86613",
                        "glosses": [
                            "Ensemble d’indications, de prescriptions, de lois, de règles, régissant une activité sociale."
                        ],
                        "tags": [
                            "Droit administratif",
                            "Politiques publiques"
                        ],
                        "examples": [
                            {
                                "example_id": "2cc33ce0-9054-423c-9c57-9f356bb494a8",
                                "sense_id": "973bea42-3423-3444-b138-6cf853243914",
                                "text": "A peine l'arrêté de M. le Maire d’Auxerre avait-il paru dans les journaux du département, que plusieurs habitants de Mailly-la-Ville vinrent, le journal en main et la menace sur les lèvres, réclamer pour leur commune une réglementation semblable à celle que M. le Maire d'Auxerre avait publiée contre les abeilles."
                            },
                            {
                                "example_id": "b0b22017-5f4c-4555-9f0c-605fd5fc844c",
                                "sense_id": "973bea42-3423-3444-b138-6cf853243914",
                                "text": "De ces conceptions sortaient encore, fatalement, la réglementation, la loi, l’État."
                            },
                            {
                                "example_id": "1b2359f0-da1f-4171-8046-a085aaf0b632",
                                "sense_id": "973bea42-3423-3444-b138-6cf853243914",
                                "text": "Les variétés d’eau de table artificielles qui pourront se produire dans la suite feront l'objet d'une réglementation spéciale."
                            },
                            {
                                "example_id": "3bf9be1c-5124-453d-a987-ad897e61bad7",
                                "sense_id": "973bea42-3423-3444-b138-6cf853243914",
                                "text": "Tandis que sous l'empire des anciennes lois, l'état de perruquier et celui de baigneur étuviste étaient assujettis à une réglementation sévère, l'exercice de la profession de sage-femme était abandonné aux premières venues."
                            },
                            {
                                "example_id": "0a372aae-ec65-43cb-b4e7-2c9202d8af98",
                                "sense_id": "973bea42-3423-3444-b138-6cf853243914",
                                "text": "Il explique ainsi que si la réglementation du bruit des tondeuses à gazon n'a pas par nature de dimension transnationale, une intervention de l'Union peut tout de même être justifiée conformément à l’exigence de la réalisation du marché intérieur."
                            },
                            {
                                "example_id": "6467b064-5000-41d5-b0ef-0e8d6f667911",
                                "sense_id": "973bea42-3423-3444-b138-6cf853243914",
                                "text": "Cette question n’a pas encore été étudiée en profondeur étant donné que l’orbite terrestre basse n’est soumise à aucune réglementation environnementale."
                            },
                            {
                                "example_id": "fe80825c-a2e3-41d8-b0b8-45260dc31d30",
                                "sense_id": "973bea42-3423-3444-b138-6cf853243914",
                                "text": "Plusieurs associations d’automobilistes poussent la commission européenne à établir une réglementation pour l’éclairage des voitures."
                            }
                        ]
                    },
                    {
                        "sense_id": "62b38103-8f7f-3e04-8b13-1977b2b49447",
                        "entry_id": "ed6016c4-cd4b-39b9-8a1f-362724e86613",
                        "glosses": [
                            "Action de réglementer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73e2e31c-c122-4540-a9b2-e46a82c93399",
                                "sense_id": "62b38103-8f7f-3e04-8b13-1977b2b49447",
                                "text": "[…] ; quand les cléricaux sont les plus faibles dans un pays, il ne manquent jamais de recommander des mesures de sévère réglementation pour se venger de patrons francs-maçons."
                            },
                            {
                                "example_id": "9acb86e7-9ab8-46b5-b4cd-691fe55218ea",
                                "sense_id": "62b38103-8f7f-3e04-8b13-1977b2b49447",
                                "text": "Il y a dans ce pays abus de réglementation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "868da737-3373-49d4-9655-cb9ef6e2ad66",
                        "source_entry_id": "ed6016c4-cd4b-39b9-8a1f-362724e86613",
                        "source_sense_description": "Ensemble de règles, de lois",
                        "target_lang_word": "Regelung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regelung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "beecbe40-7ddf-3049-9efe-05577580a822",
                                        "entry_id": "55730e4e-816b-3ccc-acbb-a41e5e07c118",
                                        "glosses": [
                                            "das Ordnen, Regeln"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f16d9179-b5ef-48de-bfaf-e3e12b3f0f5e",
                                                "sense_id": "beecbe40-7ddf-3049-9efe-05577580a822",
                                                "text": "Die Regelung des Verkehrs erfolgt durch die Verkehrspolizei."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2ac303ee-bf7a-3c3e-8e2b-1ecff56c572e",
                                        "entry_id": "55730e4e-816b-3ccc-acbb-a41e5e07c118",
                                        "glosses": [
                                            "Verfahren, bei dem das Ergebnis über eine Rückkopplung Einfluss auf die Stellgröße nimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bd87dd3-124c-444f-b0de-372d81252e85",
                                                "sense_id": "2ac303ee-bf7a-3c3e-8e2b-1ecff56c572e",
                                                "text": "Bei der Regelung wird der tatsächliche Wert des Ausgangs auf den Regler zurückgeführt, so dass auf Störungen reagiert werden kann und der Sollwert trotz ungenauer Modelle erreicht wird."
                                            },
                                            {
                                                "example_id": "7db32cc4-08d0-4f2a-859d-fc2818ac7859",
                                                "sense_id": "2ac303ee-bf7a-3c3e-8e2b-1ecff56c572e",
                                                "text": "Zur Realisierung einer digitalen Regelung ist es erforderlich, dass das kontinuierliche Signal mit einer geeigneten Abtastrate abgetastet wird."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0c0fa55f-2db1-3d05-9cd2-80d6480465bf",
                                        "entry_id": "55730e4e-816b-3ccc-acbb-a41e5e07c118",
                                        "glosses": [
                                            "Festlegung, Vorschrift, die etwas ordnet oder reguliert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8f65e68-6317-4962-887e-a8f7493db5c5",
                                                "sense_id": "0c0fa55f-2db1-3d05-9cd2-80d6480465bf",
                                                "text": "Die Innenministerkonferenz hatte bereits im Dezember beschlossen, die bisher großzügige Regelung zu verschärfen."
                                            },
                                            {
                                                "example_id": "8a8d7734-d0ff-4a28-98f8-4627ce8852c9",
                                                "sense_id": "0c0fa55f-2db1-3d05-9cd2-80d6480465bf",
                                                "text": "Ab wann tritt die neue Regelung für das Kindergeld in Kraft?"
                                            },
                                            {
                                                "example_id": "f089601a-ad30-4b22-acfd-b9413f9e20cc",
                                                "sense_id": "0c0fa55f-2db1-3d05-9cd2-80d6480465bf",
                                                "text": "„Nach der neuen Regelung der Worttrennung am Zeilenende ergeben sich bei vielen Fremdwörtern mehrere Trennvarianten.“"
                                            },
                                            {
                                                "example_id": "71eacda0-56b8-42be-b32a-859b82a4a9ba",
                                                "sense_id": "0c0fa55f-2db1-3d05-9cd2-80d6480465bf",
                                                "text": "„Das EU-Parlament hat für eine Regelung gestimmt, wonach unverkaufte Kleidung nicht mehr vernichtet werden darf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da0eb0e9-ec44-4826-ab2b-486af3503b45",
                        "source_entry_id": "ed6016c4-cd4b-39b9-8a1f-362724e86613",
