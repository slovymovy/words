                "senses": [
                    {
                        "sense_id": "bf4d7eb9-a223-381c-ba4b-d7889dc2879c",
                        "entry_id": "d12539ff-f619-34d2-933a-ceda6f4f603f",
                        "glosses": [
                            "Ausfuhr von Gewürzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bf401f5-72d4-4bee-9713-abe872ad86a4",
                                "sense_id": "bf4d7eb9-a223-381c-ba4b-d7889dc2879c",
                                "text": "„Durch die Kombination von Diplomatie und roher Gewalt gelang es der Niederländischen Ostindien-Kompanie, die Macht an sich zu reißen und sich das Monopol auf den Gewürzexport von den Inseln zu sichern.“"
                            },
                            {
                                "example_id": "cfd74039-0570-44ec-82dd-1d1c3b4a55b7",
                                "sense_id": "bf4d7eb9-a223-381c-ba4b-d7889dc2879c",
                                "text": "„Parallel zum Gewürzexport entwickelte sich der Sklavenhandel mit Arabien und Asien zum lukrativen Standbein der arabischen Oberschicht Sansibars.“"
                            },
                            {
                                "example_id": "cd3b8b05-dc85-4125-a9bf-b60a82ea62d7",
                                "sense_id": "bf4d7eb9-a223-381c-ba4b-d7889dc2879c",
                                "text": "„Strategisches Ziel der Kompanie war es, den Gewürzexport aus den Molukken zu kontrollieren.“"
                            },
                            {
                                "example_id": "073791a1-5b54-4ebf-9a7b-ca9158fbf65b",
                                "sense_id": "bf4d7eb9-a223-381c-ba4b-d7889dc2879c",
                                "text": "„Der zunehmende Konkurrenzdruck aus Asien und Afrika machte den Tee- und Gewürzexport unrentabel.“"
                            },
                            {
                                "example_id": "766929a0-f313-4bf7-ac8f-b19ca468f2a4",
                                "sense_id": "bf4d7eb9-a223-381c-ba4b-d7889dc2879c",
                                "text": "„Den Gewürzexport behielten sich die Holländer selbst vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
