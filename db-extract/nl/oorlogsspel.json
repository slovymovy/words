                "senses": [
                    {
                        "sense_id": "89db454f-344b-33d7-a9c4-a9afdd957345",
                        "entry_id": "9697ab96-84da-3eac-98fd-345b2e1ede2f",
                        "glosses": [
                            "de oorlog voorgesteld als een spel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f151cc08-76c4-4307-aabd-42553bd3f477",
                                "sense_id": "89db454f-344b-33d7-a9c4-a9afdd957345",
                                "text": "Hoeveel ingewikkelder is het oorlogsspel, dat gespeeld wordt binnen bepaalde tijdgrenzen, en waar het niet de wil van één persoon is die de levenloze stukken stuurt, maar waar alles voortvloeit uit de ontelbare botsingen van de wilsuitingen van diverse personen."
                            }
                        ]
                    },
                    {
                        "sense_id": "3502d410-5d65-37eb-9501-494fa59a9916",
                        "entry_id": "9697ab96-84da-3eac-98fd-345b2e1ede2f",
                        "glosses": [
                            "spel waarin een oorlog wordt gesimuleerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a3d3be0-34ce-47eb-a87d-5975055e22a0",
                                "sense_id": "3502d410-5d65-37eb-9501-494fa59a9916",
                                "text": "Zit je lekker een oorlogsspel te spelen, valt er ineens een SWAT-team binnen. Dat gebeurde een Amerikaanse gamer. Hij had net in de livestream van z'n spel Counter Strike tegen zijn medespelers 'I think we're being swatted' - toen de deur openbrak en inderdaad een zwaarbewapend arrestatieteam binnenviel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a77f2d7-de63-4914-b4ea-f3ef4a020cc2",
                        "source_entry_id": "9697ab96-84da-3eac-98fd-345b2e1ede2f",
                        "source_sense_id": "3502d410-5d65-37eb-9501-494fa59a9916",
                        "source_sense_description": "spel waarin een oorlog wordt gesimuleerd",
                        "target_lang_word": "war game",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "war game",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9010bbca-1823-3479-90f5-56c94228092c",
                                        "entry_id": "1261bd01-430c-36d4-ab0b-25e18633b050",
                                        "glosses": [
                                            "A simulation (by whatever means, physical or digital), for training and strategy purposes, of a military operation involving two or more opposing forces using rules, data, and procedures designed to depict an actual or assumed real-life situation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5de1290-3ac3-4990-9c98-8cfaf7e98964",
                                                "sense_id": "9010bbca-1823-3479-90f5-56c94228092c",
                                                "text": "Well, the WOPR [War Operations Planning Response] spends all it's time thinking about World War III. Twenty-four hours a day, 365 days a year, it plays an endless series of war games using all available information on the state of the world. The WOPR has already fought World War III as a game time and time again."
                                            },
                                            {
                                                "example_id": "4aefa1ba-c371-497f-806f-365493150f5d",
                                                "sense_id": "9010bbca-1823-3479-90f5-56c94228092c",
                                                "text": "On the other hand, war games in the Weimar era did not first develop into a political instrument when they began to incorporate political entities. Rather, only war games were able to approximate exactly the situation that was to be avoided at all costs."
                                            },
                                            {
                                                "example_id": "f2a7ae8a-f4d2-4034-8865-1fbc33ad945e",
                                                "sense_id": "9010bbca-1823-3479-90f5-56c94228092c",
                                                "text": "In a sort of blooper reel, I will go over some of the things that occurred in a few of the wargames but we left out when collating the overall timeline."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19d61d36-9bc6-3d7d-a3ca-c601aa230c9d",
                                        "entry_id": "1261bd01-430c-36d4-ab0b-25e18633b050",
                                        "glosses": [
                                            "A game, for entertainment or edutainment purposes, that simulates or represents a military operation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "war game",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5cb5603a-b28c-3618-8c38-6a891f926c36",
                                        "entry_id": "8bbb0caf-62c1-3196-94a9-614ad3e22b9b",
                                        "glosses": [
                                            "To run a military simulation of this kind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42d7b16d-0874-4f5c-84e7-a1b906e7693e",
                                                "sense_id": "5cb5603a-b28c-3618-8c38-6a891f926c36",
                                                "text": "Together Britain, the United States and Ukraine conducted an assessment of the new plan, trying to war game it once more."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
