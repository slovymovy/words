                        "cross_references": [
                            {
                                "target_word": "flashlight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19f66cd5-0c43-3b01-afb3-b65baed47def",
                                        "entry_id": "664c008c-f6b4-3789-b125-0356ca862380",
                                        "glosses": [
                                            "A battery-powered hand-held light source."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Philippines",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9334052c-833e-4dde-a102-b9d26bb67a5c",
                                                "sense_id": "19f66cd5-0c43-3b01-afb3-b65baed47def",
                                                "text": "At school he used to do Dr. Jekyll turning into Mr. Hyde, shining a flashlight into his face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c0f747b-6633-3d70-9a49-31bd21c41c7d",
                                        "entry_id": "664c008c-f6b4-3789-b125-0356ca862380",
                                        "glosses": [
                                            "A flashgun (device used to create flashes of light for photography)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5c82a24-2112-4bfa-9737-7cf74bdabc35",
                                                "sense_id": "8c0f747b-6633-3d70-9a49-31bd21c41c7d",
                                                "text": "He sat in an arm-chair with his forefinger to his temple, and when the photographer's flashlight went off, he hoped that the hotel had caught fire and that this would end it all."
                                            },
                                            {
                                                "example_id": "6ac93541-0251-4cbf-a949-829d60be8c21",
                                                "sense_id": "8c0f747b-6633-3d70-9a49-31bd21c41c7d",
                                                "text": "[…] the flashlight exploded like a tiny bomb, making the Vicar jump a little, which explains why his face is a thankful blur, his deadly role forgotten to history (I have the photograph before me now)."
                                            },
                                            {
                                                "example_id": "0ea44661-20c1-4bc6-98b6-a6ea707df1a6",
                                                "sense_id": "8c0f747b-6633-3d70-9a49-31bd21c41c7d",
                                                "text": "[…] two or three bright flashlights went off close to us. It seemed that some prominent person was being quickly interviewed by reporters and photographed just before the ship left."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52ad9ebb-14df-3eb2-945c-de9d16fcd9ba",
                                        "entry_id": "664c008c-f6b4-3789-b125-0356ca862380",
                                        "glosses": [
                                            "A photograph taken with a flash camera."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "flashlight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c49de011-44c6-390d-8478-70765d00c475",
                                        "entry_id": "f14ca91f-bce2-313a-b5d7-bb1a019e9237",
                                        "glosses": [
                                            "To illuminate with a flashlight."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "accc58ec-de59-4f16-bf71-7ac5a05978ef",
                                                "sense_id": "c49de011-44c6-390d-8478-70765d00c475",
                                                "text": "Autis stepped carefully while flashlighting the fog in front of himself and Gar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
