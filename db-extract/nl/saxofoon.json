                        "source_entry_id": "0f82e010-41c9-3f02-8723-cf9ef13fdfd1",
                        "source_sense_id": "bc17ab57-d2d4-3584-afa2-94673bc6ac9c",
                        "source_sense_description": "een metalen blaasinstrument met een enkel riet",
                        "target_lang_word": "saxophone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
