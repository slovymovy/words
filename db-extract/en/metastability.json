        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4e31afbf-202b-3bdb-928b-c7395e9b5484",
                "word": "metastability",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "67c9be40-de0c-4af0-bbdb-037921344c44",
                        "entry_id": "4e31afbf-202b-3bdb-928b-c7395e9b5484",
                        "tags": [
                            "plural"
                        ],
                        "form": "metastabilities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6d9ee33c-f30c-3b99-b411-3eefe68acc2f",
                        "entry_id": "4e31afbf-202b-3bdb-928b-c7395e9b5484",
                        "glosses": [
                            "An unstable but potentially long-lived state of a system; for example, a supersaturated solution or an excited atom."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "86bb8c50-f995-458b-b48a-2a387f62653c",
                                "sense_id": "6d9ee33c-f30c-3b99-b411-3eefe68acc2f",
                                "text": "Soloman's belief that love is necessarily paradoxical issues from his attempt to define it as what Sartre would call a dialectical metastability. Love must therefore be not a \"state of the union but a never ending conflict of pushing away and pulling together.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b19f317a-c2aa-4a05-a634-5d295fe71dca",
                        "source_entry_id": "4e31afbf-202b-3bdb-928b-c7395e9b5484",
                        "source_sense_id": "6d9ee33c-f30c-3b99-b411-3eefe68acc2f",
                        "source_sense_description": "unstable but potentially long-lived state",
                        "target_lang_word": "métastabilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "métastabilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a396eadd-bc41-3a25-84e2-fc7ce857910c",
                                        "entry_id": "44e2f987-e972-3058-9cfe-17bcb4f6935c",
                                        "glosses": [
                                            "État métastable de la matière."
                                        ],
                                        "tags": [
                                            "Chimie physique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3890d1ef-24b6-4eb7-8283-8f5a329c20df",
                                                "sense_id": "a396eadd-bc41-3a25-84e2-fc7ce857910c",
                                                "text": "La métastabilité est la capacité pour un état d'être stable cinétiquement mais pas thermodynamiquement."
                                            },
                                            {
                                                "example_id": "28c8a4d7-adf6-46c7-9278-3b85320bdc42",
                                                "sense_id": "a396eadd-bc41-3a25-84e2-fc7ce857910c",
                                                "text": "Modélisation de la métastabilité de structures MIS à base de silicium amorphe d'après des mesures de capacité quasistatique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86f62500-f1a7-3dec-ae0e-c919aea1054d",
                                        "entry_id": "44e2f987-e972-3058-9cfe-17bcb4f6935c",
                                        "glosses": [
                                            "Caractère potentiellement instable, fondamentalement transitoire d'une situation."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a08da729-28ac-40ed-ab18-e7a639a9580a",
                                                "sense_id": "86f62500-f1a7-3dec-ae0e-c919aea1054d",
                                                "text": "Dans le passage de G. Hottois, le terme pré-individué souligne la métastabilité que sous-entend le processus d'individuation."
                                            },
                                            {
                                                "example_id": "4ae56758-b378-4d10-9255-055a530f79d7",
                                                "sense_id": "86f62500-f1a7-3dec-ae0e-c919aea1054d",
                                                "text": "La dimension symbolique de toute forme instituée doit être prise en compte parmi les éléments constituant la métastabilité du système."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
