                        "form": "кряжа́ми"
                    },
                    {
                        "form_id": "ff0492f8-9d26-48eb-adc0-4712b009c5ca",
                        "entry_id": "4939979f-8e5d-375f-8473-a52225c7f700",
                        "tags": [
                            "singular",
                            "prepositional"
                        ],
                        "form": "кряже́"
                    },
                    {
                        "form_id": "4263d71d-04b0-4757-94df-b52ab3c54ccf",
                        "entry_id": "4939979f-8e5d-375f-8473-a52225c7f700",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "кряжа́х"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3da6a7fb-850b-3edf-9577-26d3a0c8175b",
                        "entry_id": "4939979f-8e5d-375f-8473-a52225c7f700",
                        "glosses": [
                            "невысокая горная цепь; холмистое плоскогорье"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f89f6c1b-3a90-49f7-8e9e-94838d2fcf98",
                                "sense_id": "3da6a7fb-850b-3edf-9577-26d3a0c8175b",
                                "text": "И когда, наконец, полузадохшиеся и изнеможденные, мы взошли на последний кряж, нам сверкнула в глаза так давно невиданная спокойная вода, словно серебряный щит: горное озеро Адели."
                            }
                        ]
                    },
                    {
                        "sense_id": "500aaeb5-9f47-3f86-93b5-128f9c7466fa",
                        "entry_id": "4939979f-8e5d-375f-8473-a52225c7f700",
                        "glosses": [
                            "спец. толстый короткий обрубок бревна из близкой к корню части дерева"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a523aaec-e910-4fef-bbf7-4b500678ae28",
                                "sense_id": "500aaeb5-9f47-3f86-93b5-128f9c7466fa",
                                "text": "Даже пройдя середину толстого кряжа, пила нисколько не затиралась, а только шла позвенивая и выфыркивала желтоватые сосновые опилки на комбинезонные брюки тому и другому."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "382b6476-16a7-4512-be57-e13bcfca0d68",
                        "source_entry_id": "4939979f-8e5d-375f-8473-a52225c7f700",
                        "source_sense_description": "цепь гор",
                        "target_lang_word": "ridge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ridge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7300a57e-519e-376d-98c2-ecdcea9789f3",
                                        "entry_id": "9c34d65e-5e71-3f57-8ff6-580760a487d7",
                                        "glosses": [
                                            "To form into a ridge."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8d35d80c-bb58-37f9-a44f-5b861d334f90",
                                        "entry_id": "9c34d65e-5e71-3f57-8ff6-580760a487d7",
                                        "glosses": [
                                            "To extend in ridges."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ridge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "520d899b-4591-3fb0-9d11-2d99d416ba51",
                                        "entry_id": "4834f591-8872-3dc9-a15c-15f2e13a22e8",
                                        "glosses": [
                                            "The back of any animal; especially the upper or projecting part of the back of a quadruped."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a481d310-75bf-41cb-8140-b57b92cc1125",
                                                "sense_id": "520d899b-4591-3fb0-9d11-2d99d416ba51",
                                                "text": "He thought it was no time to ſtay, / And let the Night too ſteal away, / But in a trice advanced the Knight, / Upon the Bare Ridge, Bolt upright, / And groping out for Ralpho’s Jade, / He found the Saddle too was ſtraid[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "483099f1-cb2a-3414-86e7-2e94f6ff6856",
                                        "entry_id": "4834f591-8872-3dc9-a15c-15f2e13a22e8",
                                        "glosses": [
                                            "Any extended protuberance; a projecting line or strip."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1046cc5b-1fb2-4696-8c13-117eb346316a",
                                                "sense_id": "483099f1-cb2a-3414-86e7-2e94f6ff6856",
                                                "text": "The plough threw up ridges of earth between the furrows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9b11c02-b3c7-389f-95a0-e0449ccc5bd0",
                                        "entry_id": "4834f591-8872-3dc9-a15c-15f2e13a22e8",
                                        "glosses": [
                                            "The line along which two sloping surfaces meet which diverge towards the ground."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6f47d25-d654-40b3-a006-baa9b3be7b27",
                                                "sense_id": "b9b11c02-b3c7-389f-95a0-e0449ccc5bd0",
                                                "text": "mountain ridge"
                                            },
                                            {
                                                "example_id": "9fb764f8-d813-4fea-81d8-b1dfa08d33ea",
                                                "sense_id": "b9b11c02-b3c7-389f-95a0-e0449ccc5bd0",
                                                "text": "It was not far from the house; but the ground sank into a depression there, and the ridge of it behind shut out everything except just the roof of the tallest hayrick."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "100091cb-9856-3130-a94c-66e6a9705070",
                                        "entry_id": "4834f591-8872-3dc9-a15c-15f2e13a22e8",
                                        "glosses": [
                                            "The highest point on a roof, represented by a horizontal line where two roof areas intersect, running the length of the area."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c998fd1-e761-42e4-8025-e8f7c4a64445",
                                                "sense_id": "100091cb-9856-3130-a94c-66e6a9705070",
                                                "text": "Maccario, it was evident, did not care to take the risk of blundering upon a picket, and a man led them by twisting paths until at last the hacienda rose blackly before them. Appleby could see it dimly, a blur of shadowy buildings with the ridge of roof parapet alone cutting hard and sharp against the clearing sky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46024e31-d194-3838-b65a-47f04df4c8ab",
                                        "entry_id": "4834f591-8872-3dc9-a15c-15f2e13a22e8",
                                        "glosses": [
                                            "The highest portion of the glacis proceeding from the salient angle of the covered way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12bf3ae2-45ad-4d85-8e2b-cbc9675bbca6",
                                                "sense_id": "46024e31-d194-3838-b65a-47f04df4c8ab",
                                                "text": "the British Guards lie down behind a ridge to avoid the shot and shell from the opposite heights"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d15f09c-ea2d-3d35-9f12-62a264d88091",
                                        "entry_id": "4834f591-8872-3dc9-a15c-15f2e13a22e8",
                                        "glosses": [
                                            "A chain of mountains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b114279-bd43-4883-ba7b-5ff99c5b79b7",
                                                "sense_id": "4d15f09c-ea2d-3d35-9f12-62a264d88091",
                                                "text": "[…]Which to maintaine, I would allow him oddes, / And meete him, were I tide to runne afoote, / Euen to the frozen ridges of the Alpes, / Or any other ground inhabitable, / Where euer Engliſhman durſt ſet his foote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "243987c7-3494-3cac-a6ca-4f21039704e0",
                                        "entry_id": "4834f591-8872-3dc9-a15c-15f2e13a22e8",
                                        "glosses": [
                                            "A chain of hills."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14ddfc00-0aa7-323a-9572-fa7e4581e514",
                                        "entry_id": "4834f591-8872-3dc9-a15c-15f2e13a22e8",
                                        "glosses": [
                                            "A long narrow elevation on an ocean bottom."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "052ab276-e145-36e8-b5cf-2b2f2081b050",
                                        "entry_id": "4834f591-8872-3dc9-a15c-15f2e13a22e8",
                                        "glosses": [
                                            "An elongated region of high atmospheric pressure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
