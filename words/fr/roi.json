                {
                    "sense_id": "dc158ba1-4b02-38c1-ad1a-ac8be35eb2bc",
                    "sense_definition": "Titre de celui qui règne sur un peuple ou un État monarchique et qui est à la tête d'un royaume, par hérédité ou par élection.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "chef d'un royaume ou d'un groupe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>roi</w> de France habitait au château de Versailles."
                        },
                        {
                            "text": "Les <w>rois</w> d'Espagne ont longtemps régné sur un immense empire."
                        },
                        {
                            "text": "Le peuple a acclamé le <w>roi</w> sur la grande place."
                        }
                    ],
                    "synonyms": [
                        "monarque"
                    ],
                    "common_phrases": [
                        "le roi de France",
                        "le roi d'Angleterre",
                        "couronner un roi",
                        "Sa Majesté le roi",
                        "vive le roi"
                    ]
                },
                {
