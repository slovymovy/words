                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "622b0715-ca42-4dbc-a54f-6b498509abf0",
                        "source_entry_id": "faaef75f-2bc4-33f7-8a23-559169489018",
                        "source_sense_id": "62071307-2d00-377e-a78c-6185f01c90c4",
                        "source_sense_description": "Undoubtedly; unquestionably",
                        "target_lang_word": "indubitablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indubitablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea83132a-a755-3da1-a3ae-705618a95aab",
                                        "entry_id": "a2c16199-e18a-3de3-b421-35dbb57795d8",
                                        "glosses": [
                                            "D’une façon indubitable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f4d6896-0176-4439-a04d-3717b71548e8",
                                                "sense_id": "ea83132a-a755-3da1-a3ae-705618a95aab",
                                                "text": "C'est la muse indubitablement qui inspire les mauvais vielleurs."
                                            },
                                            {
                                                "example_id": "5d578ea6-b45c-45aa-9da6-fb1bfbb1de53",
                                                "sense_id": "ea83132a-a755-3da1-a3ae-705618a95aab",
                                                "text": "Je vous jure par le Seigneur qu'indubitablement je vous prendrai."
                                            },
                                            {
                                                "example_id": "5fee301d-78fa-4c53-bd0b-99f1c9714bdb",
                                                "sense_id": "ea83132a-a755-3da1-a3ae-705618a95aab",
                                                "text": "Il y a des gens, à la vérité, qui prétendent qu’un homme qui se vantait d’avoir un génie familier, était indubitablement un peu fou ou un peu fripon."
                                            },
                                            {
                                                "example_id": "b0d4191c-99cf-42e1-a83c-4abf9da7f707",
                                                "sense_id": "ea83132a-a755-3da1-a3ae-705618a95aab",
                                                "text": "Par malheur, je n’ai point l’art de me contrefaire ; Il vient pour un sujet qui ne saurait me plaire, Et je le marquerais indubitablement."
                                            },
                                            {
                                                "example_id": "d1a7c006-740e-400b-b80a-2713fa2df6d7",
                                                "sense_id": "ea83132a-a755-3da1-a3ae-705618a95aab",
                                                "text": "En effet, le cap Bathurst et le territoire y confinant se trouvaient indubitablement situés au-dessus du soixante-dixième parallèle."
                                            },
                                            {
                                                "example_id": "8eafe666-3a30-4922-adae-77cab4266fe0",
                                                "sense_id": "ea83132a-a755-3da1-a3ae-705618a95aab",
                                                "text": "Les Français traversent indubitablement une crise qui n’est pas seulement économique et sociale mais qui est avant tout une crise de la morale."
                                            },
                                            {
                                                "example_id": "7b14ad94-743c-4abc-ad77-b129106afaec",
                                                "sense_id": "ea83132a-a755-3da1-a3ae-705618a95aab",
                                                "text": "La forêt dense d'un Touareg du milieu saharien sera indubitablement moins boisée que celle d'un Sénoufo de la zone soudanienne, qui elle-même sera considérée comme une forêt claire ou secondaire par un habitant baoulé de la zone guinéenne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55e19947-1523-4bcb-930e-056f2aa1aa60",
                        "source_entry_id": "faaef75f-2bc4-33f7-8a23-559169489018",
                        "source_sense_id": "62071307-2d00-377e-a78c-6185f01c90c4",
