                                "target_senses": [
                                    {
                                        "sense_id": "069d45ed-56b5-37b0-8574-44c2f29767cf",
                                        "entry_id": "fa05316f-8d36-3d7a-bc44-9983f5db9544",
                                        "glosses": [
                                            "Fécondation."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a377b3c-bb71-4ab4-b42c-013e98ae4b1a",
                                                "sense_id": "069d45ed-56b5-37b0-8574-44c2f29767cf",
                                                "text": "L’âne et l’ânesse y tendent encore par une autre cause, comme ils sont originaires des climats chauds, le froid s’oppose à leur génération, et c’est par cette raison qu’on attend les chaleurs de l’été pour les faire accoupler ; lorsqu’on les laisse joindre dans d’autres temps, et surtout en hiver, il est rare que l'imprégnation suive l’accouplement, même réitéré […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a341706f-f50c-36ef-821f-be19b5a9db01",
                                        "entry_id": "fa05316f-8d36-3d7a-bc44-9983f5db9544",
                                        "glosses": [
                                            "Action d’imprégner ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b17b7e92-f134-319d-8555-5e0924037541",
                                        "entry_id": "fa05316f-8d36-3d7a-bc44-9983f5db9544",
                                        "glosses": [
                                            "Instauration d’un lien privilégié entre un homme et un animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fe2f638-2945-4fce-a3ba-f02d7a4d5900",
                                                "sense_id": "b17b7e92-f134-319d-8555-5e0924037541",
                                                "text": "Popularisée par les films animaliers, la technique de l’imprégnation permet de montrer ce qu’est la vie sauvage, sans capturer les animaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8819527-ffae-4525-90b4-9ebfc2c66fea",
                        "source_entry_id": "478b8cc4-0327-3608-b9e5-e6eb66bbd0ab",
                        "source_sense_id": "b85167be-5c0f-33ca-bca5-2cf9b49bed6a",
                        "source_sense_description": "das Durchtränken eines porösen Materials mit Feuchtigkeit abstoßenden Mitteln",
                        "target_lang_word": "imperméabilisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imperméabilisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "33f07e98-d5cd-3c46-bf3d-48daf8687c94",
                                        "entry_id": "701ae939-a759-339d-90fa-c692718466b3",
                                        "glosses": [
                                            "Action de rendre un matériau, une surface ou un ouvrage imperméable à l’eau (par revêtement, traitement ou conception)."
                                        ],
                                        "tags": [
                                            "Sciences des matériaux",
                                            "Génie civil"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1902d8f9-2d0c-3c24-88e2-63dc19ba8742",
                                        "entry_id": "701ae939-a759-339d-90fa-c692718466b3",
                                        "glosses": [
                                            "Recouvrement ou traitement des sols par des surfaces artificielles (béton, enrobé, dalles, etc.) réduisant fortement l’infiltration et augmentant le ruissellement."
                                        ],
                                        "tags": [
                                            "Urbanisme",
                                            "Environnement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "384e9e5b-657b-43d6-8a9d-1deaaa918f32",
                                                "sense_id": "1902d8f9-2d0c-3c24-88e2-63dc19ba8742",
                                                "text": "Derrière \"imperméabilisation des sols\", il faut comprendre le recouvrement des terres par des routes et des constructions, qui ne permettent plus au sol d'absorber l'eau pluviale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cf52c68-b6a3-3004-9377-0714780e7f50",
                                        "entry_id": "701ae939-a759-339d-90fa-c692718466b3",
                                        "glosses": [
                                            "Processus par lequel les tissus végétaux limitent les pertes d’eau, notamment via la cuticule (cutinisation) ou la subérisation."
                                        ],
                                        "tags": [
                                            "Biologie végétale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ece68d85-c9a3-41cd-ac72-6f3275c7488b",
                                                "sense_id": "6cf52c68-b6a3-3004-9377-0714780e7f50",
                                                "text": "Ce polymère cuticulaire permet une imperméabilisation de la plante, une protection contre les radiations UV, ainsi que la rigidification de ses parties érigées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
