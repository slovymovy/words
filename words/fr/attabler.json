                    "frequency": "Middle",
                    "semantic_group_id": "repas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une longue journée de marche, nous nous sommes <w>attablés</w> pour dîner ensemble."
                        },
                        {
                            "text": "Les clients aiment s'<w>attabler</w> en terrasse dès l'arrivée des beaux jours."
                        }
                    ],
                    "synonyms": [
                        "se mettre à table"
                    ],
                    "common_phrases": [
                        "s'attabler en terrasse",
                        "s'attabler au restaurant"
                    ]
                },
                {
                    "sense_id": "db2539d3-3a1a-346b-a06d-b18c51ae98de",
                    "sense_definition": "S'asseoir autour d'une table pour participer à un jeu de cartes ou de société.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "jeu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute la famille s'est <w>attablée</w> pour commencer une longue partie de cartes."
                        },
                        {
                            "text": "Les joueurs se sont <w>attablés</w> autour du plateau d'échecs dans un silence total."
                        }
                    ],
                    "common_phrases": [
                        "s'attabler pour jouer"
                    ]
                },
                {
                    "sense_id": "3ad2db21-9ac1-3315-a513-2914169b10c4",
                    "sense_definition": "Faire asseoir quelqu'un à table.",
