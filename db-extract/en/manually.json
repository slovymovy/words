                                        "examples": [
                                            {
                                                "example_id": "df4a4cb5-c778-477c-9c9b-798ce751d328",
                                                "sense_id": "30601282-fc87-364b-8a3e-437621041b93",
                                                "text": "Les huîtres, les étrilles, les pétoncles et les tellines se ramassent manuellement."
                                            }
                                        ]
