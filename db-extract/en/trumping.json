                        "entry_id": "34a9e737-a436-3b1a-a3bf-9cb01e69aa2f",
                        "glosses": [
                            "The act by which something is trumped, topped or capped."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5e77801-3ea9-4c40-9d19-4c4813bafb04",
                                "sense_id": "0a55094a-94b2-3fe2-ad52-c30070571c91",
                                "text": "Employ two revokes, two trumpings of your partner's best card and two ignorings of a call — all in the same hand!"
                            },
                            {
                                "example_id": "013f7ef5-5a44-42b4-8e18-a84d84ef72a9",
                                "sense_id": "0a55094a-94b2-3fe2-ad52-c30070571c91",
                                "text": "To describe an oddball combination like 'Frolf' as a 'marriage of Frisbee and Golf' is to open yourself to trumpings of the form 'yeah, a shotgun marriage', 'a broken marriage', or depending on your politics, a 'gay marriage'."
                            }
                        ]
                    },
                    {
                        "sense_id": "10a87a3a-718b-38f2-8a5a-80c72bd8a779",
                        "entry_id": "34a9e737-a436-3b1a-a3bf-9cb01e69aa2f",
                        "glosses": [
                            "The sound of a trumpet."
                        ],
                        "tags": [
                            "archaic",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "fd40050f-2586-4a25-b1b3-9868045c0b40",
                                "sense_id": "10a87a3a-718b-38f2-8a5a-80c72bd8a779",
                                "text": "1861-1868, Frank Moore, The Rebellion Record\nWe list to the trumpings that herald the storm,\nTo the roll of the drum, and the order to form!"
                            }
                        ]
                    }
