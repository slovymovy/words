                                        "glosses": [
                                            "ein zum Tierstamm Mollusca gehörendes, wirbelloses Tier ohne Knochen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27b0915f-38f8-4bae-8aef-c30f58d13899",
                                                "sense_id": "d1307efd-f005-3cc3-9073-e004135c1953",
                                                "text": "Der Kopf der Weichtiere trägt häufig hochentwickelte Augen."
                                            },
                                            {
                                                "example_id": "8f185b4b-2aa5-4cab-9474-d67a6968cdba",
                                                "sense_id": "d1307efd-f005-3cc3-9073-e004135c1953",
                                                "text": "Bei vielen Weichtieren umgibt eine schützende Schale den Weichkörper."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cc9496e-4483-41b2-8bea-8188394d83a3",
                        "source_entry_id": "83669823-d8cc-34b9-a299-9e305f5fece0",
                        "source_sense_description": "soft-bodied invertebrate of phylum Mollusca — see also clam, oyster, mussel",
                        "target_lang_word": "Molluske",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Molluske",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "96c61636-c62f-32ca-9985-ae65d2ae4c7d",
                                        "entry_id": "fd0ab49d-0024-3402-872d-da43a7f25ac7",
                                        "glosses": [
                                            "wirbelloses Tier mit weichem Körper; Weichtier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e922d805-71f8-49cc-8e2c-19fec3b9f8b2",
                                                "sense_id": "96c61636-c62f-32ca-9985-ae65d2ae4c7d",
                                                "text": "„Die meisten Mollusken bewegen sich durch Kriechen auf dem Grunde der Gewässer, die sie bewohnen, in langsamer und höchst unvollkommener Weise.“"
                                            },
                                            {
                                                "example_id": "5b8de79d-700b-42cb-9f46-d12b6e59a5ea",
                                                "sense_id": "96c61636-c62f-32ca-9985-ae65d2ae4c7d",
                                                "text": "„Während Bonpland krank in seiner Koje lag, kochendheißen Rum trank und für keine Arbeit zu gebrauchen war, zerschnitt Humboldt die beiden Mollusken unter dem Mikroskop, […].“"
                                            },
                                            {
                                                "example_id": "4e00f0e5-f62e-46f1-a054-244a7b7f7205",
                                                "sense_id": "96c61636-c62f-32ca-9985-ae65d2ae4c7d",
                                                "text": "„Formlose, graue Mollusken hatten sie gebildet, gereizt durch einen Fremdkörper, ein Sandkorn zwischen ihren Schalen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "08515d41-84e9-3218-832d-ccbe6c9c94ba",
                                        "entry_id": "fd0ab49d-0024-3402-872d-da43a7f25ac7",
                                        "glosses": [
                                            "eine kleine, weiche Geschwulst der Haut, erzeugt durch das Molluscum-contagiosum-Virus"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
