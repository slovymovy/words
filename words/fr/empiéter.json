                        "empiéter sur les prérogatives"
                    ]
                },
                {
                    "sense_id": "a9e5986c-a39e-35e6-b36d-f1cccd651b59",
                    "sense_definition": "Occuper indûment une portion d'un espace ou d'un terrain appartenant à autrui.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La nouvelle clôture du voisin <w>empiète</w> de quelques centimètres sur notre terrain."
                        },
                        {
                            "text": "Vous ne pouvez pas construire ce garage s'il <w>empiète</w> sur la parcelle adjacente."
                        }
                    ],
                    "synonyms": [
                        "mordre",
                        "déborder"
                    ],
                    "common_phrases": [
