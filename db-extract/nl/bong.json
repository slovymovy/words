                        "examples": [
                            {
                                "example_id": "b34989a4-23b7-4ade-a521-f2792458f82f",
                                "sense_id": "d1f8366e-bfbe-3e2a-8608-ce4ece9dfc92",
                                "text": "En ja, aan het eind van de gang stond Appelwang. Nee maar, die sloeg op een grote gong. Bing... bong... bing... bong...!"
                            },
                            {
                                "example_id": "dc8e97f1-b209-4048-b204-6a4a600c6d1b",
                                "sense_id": "d1f8366e-bfbe-3e2a-8608-ce4ece9dfc92",
                                "text": "⧖ De klok op den toren klept elf uur. Bong... bong... bong..."
                            }
                        ]
                    }
