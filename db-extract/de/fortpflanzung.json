                "senses": [
                    {
                        "sense_id": "076b0ade-bd77-328f-84da-5407a032eaf1",
                        "entry_id": "10115cb9-2258-37bf-b5ed-29e5643f0823",
                        "glosses": [
                            "die Erzeugung von Nachkommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c5cb0ac-f08b-42a8-9548-8b4b8456de0b",
                                "sense_id": "076b0ade-bd77-328f-84da-5407a032eaf1",
                                "text": "Ein ganzer Zweig der Medizin befasst sich mit der Fortpflanzung."
                            },
                            {
                                "example_id": "0aa39535-9d0f-4de9-9ccf-a6f9e7ebdf7b",
                                "sense_id": "076b0ade-bd77-328f-84da-5407a032eaf1",
                                "text": "„Zweitens muß sie ihre eigene Art durch Fortpflanzung erhalten; und sicherlich würde sie sich dieser Aufgabe nicht entledigen, was auch immer der heilige Augustinus dazu sagt, wenn sie nicht bei ihrer Erfüllung Lust empfände.“"
                            },
                            {
                                "example_id": "4593c375-036f-4315-a41f-3789c4dec411",
                                "sense_id": "076b0ade-bd77-328f-84da-5407a032eaf1",
                                "text": "„Gehörsinn, Stimme und Sehkraft wurden im Fluge erledigt; dann aber ließ sich Bouvard lang und breit über die Frage der Fortpflanzung aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a955e9f7-1989-36b7-aab3-463c0636ed45",
                        "entry_id": "10115cb9-2258-37bf-b5ed-29e5643f0823",
                        "glosses": [
                            "Ausbreitung (von Wellen, Fehlern und so weiter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23a17465-d5b0-407c-bb5d-009d9d2ce9f8",
                                "sense_id": "a955e9f7-1989-36b7-aab3-463c0636ed45",
                                "text": "Die Seismologie untersucht die Fortpflanzung von Wellen in der Erde."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f19c8ea-946e-4074-8f64-77e0df9bb605",
                        "source_entry_id": "10115cb9-2258-37bf-b5ed-29e5643f0823",
                        "source_sense_id": "076b0ade-bd77-328f-84da-5407a032eaf1",
