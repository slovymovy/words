                                        "glosses": [
                                            "rodzaj samosądu, wymierzenie przez tłum kary (szczególnie śmierci) na osobie posądzanej o przestępstwo bez przeprowadzenia sprawy sądowej"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fc56aa5-bab4-4618-8a41-27713d968044",
                                                "sense_id": "7a3382c3-a815-3d6c-a992-126de0ef9d67",
                                                "text": "Linczów dokonywano zwłaszcza w XVIII i XIX w. na Murzynach w południowych stanach USA."
                                            },
                                            {
                                                "example_id": "e41a0fee-dbce-43a6-b686-9da418910f16",
                                                "sense_id": "7a3382c3-a815-3d6c-a992-126de0ef9d67",
                                                "text": "Kilkanaście osób podejrzanych o rozprzestrzenianie cholery przy użyciu czarów padło ofiarą linczu. Ciała ofiar zostały rozsiekane maczetami, a następnie spalone"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
