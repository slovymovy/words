                "senses": [
                    {
                        "sense_id": "6ad06f8a-b9ad-30c7-b8b5-7ad6daeabde0",
                        "entry_id": "36d7405d-75b8-3f13-9c6f-00fcf099e7d9",
                        "glosses": [
                            "Supprimer l’influence de Donald Trump."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2d648fe-3277-45de-8f13-5a14246c3919",
                                "sense_id": "6ad06f8a-b9ad-30c7-b8b5-7ad6daeabde0",
                                "text": "Et oui, il y a un lien évident entre l’augmentation du prix du Toblerone et l’élection de Donald Trump. J’ai donc échoué à me \"détrumpiser\", j’essayerai de faire mieux demain."
                            },
                            {
                                "example_id": "4eaac4f4-6c14-4684-a905-b2d00f39763a",
                                "sense_id": "6ad06f8a-b9ad-30c7-b8b5-7ad6daeabde0",
                                "text": "Joe Biden rebat les cartes, détrumpise, vaccine à tout-va et multiplie les plans de relance. Le retour de l’Amérique est un défi pour l’Europe qui risque le décrochage, explique, dans sa chronique, Sylvie Kauffmann, éditorialiste au « Monde »."
                            },
                            {
                                "example_id": "36da7aca-16d1-42f2-a9b2-2cc42803582d",
                                "sense_id": "6ad06f8a-b9ad-30c7-b8b5-7ad6daeabde0",
                                "text": "Le Parti républicain doit se reconstruire et donc accepter de se « détrumpiser », de devenir autre chose que le véhicule politique d’un seul homme comme il l’a été au cours des quatre dernières années."
                            }
                        ]
                    }
