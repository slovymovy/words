                                "target_senses": [
                                    {
                                        "sense_id": "7f6285a2-cd63-3f15-a62b-b1d6df147f03",
                                        "entry_id": "30678fe2-1a2f-34e4-ae3f-30ceb764820b",
                                        "glosses": [
                                            "obere Begrenzung des Mundraums zur Nasenhöhle hin, die im Anschluss an den Zahndamm als harter Gaumen beginnt und sich als weicher Gaumen fortsetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68be6ba7-37fd-4528-a592-7cf9a258e533",
                                                "sense_id": "7f6285a2-cd63-3f15-a62b-b1d6df147f03",
                                                "text": "Der Gaumen schließt als obere Begrenzung des Mundraums an Lippen, Zähne und Zahndamm an."
                                            },
                                            {
                                                "example_id": "763fab85-0aee-4c32-ae11-74031a0fb8bd",
                                                "sense_id": "7f6285a2-cd63-3f15-a62b-b1d6df147f03",
                                                "text": "Auf Grund meiner Allergie entzündet sich jedes Mal mein Gaumen, wenn ich Tomaten esse."
                                            },
                                            {
                                                "example_id": "ee9a5d5c-1d4b-40e1-9e27-4f123a0335d5",
                                                "sense_id": "7f6285a2-cd63-3f15-a62b-b1d6df147f03",
                                                "text": "„Sein Gaumen jubilierte bei jedem Bissen.“"
                                            },
                                            {
                                                "example_id": "4757ceae-062a-4a14-aa2a-e50bffc57422",
                                                "sense_id": "7f6285a2-cd63-3f15-a62b-b1d6df147f03",
                                                "text": "„Diese war mit einem dampfenden Haunch vom wilden Büffel besetzt, dem deliziösesten Roastbeef, das auch der Gaumen eines Königs nicht verschmähen dürfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
