                "senses": [
                    {
                        "sense_id": "24c4a08f-268d-39a1-9f0b-dfcf15ee66c8",
                        "entry_id": "4b5d9245-d164-3703-b47d-f3454b0a4c04",
                        "glosses": [
                            "rundlicher, oben offener Behälter, in den eine weiche, süße Milchspeise eingefüllt wird oder wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f07dab4d-67c8-44d2-9c4d-cc2595a6413c",
                                "sense_id": "24c4a08f-268d-39a1-9f0b-dfcf15ee66c8",
                                "text": "„Ein Mal, für einen kurzen Moment kann ich etwas von dem Landliebe-Grießpudding sehen: in dem Augenblick, in dem die cremefarbene, dickliche Flüssigkeit in den Puddingbecher fließt.“"
                            },
                            {
                                "example_id": "7c5ca29f-c9d4-495c-8b85-fda96dbefb2c",
                                "sense_id": "24c4a08f-268d-39a1-9f0b-dfcf15ee66c8",
                                "text": "„In einigen Puddingbechern stecken so viele Kalorien wie in einer kleinen Mahlzeit.“"
                            },
                            {
                                "example_id": "0d143ac0-37d7-4f72-b0a1-37564e79bd81",
                                "sense_id": "24c4a08f-268d-39a1-9f0b-dfcf15ee66c8",
                                "text": "„Die Lust auf Süßes hat einen Igel in Saarbrücken in einen Schlamassel gebracht: Sein Kopf steckte so tief in einem leeren Puddingbecher, dass er ihn nicht mehr allein herausbekam und samt der ungewöhnlichen Kopfbedeckung nachts über die Straße lief.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
