                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08e08a60-4012-47ef-b9fb-2ef98d36f7d2",
                                "sense_id": "8b057520-d440-375d-aa15-4a60515fe15e",
                                "text": "― Дорогуша ты моя, сердечная, ― слащаво ныла Власьевна."
                            },
                            {
                                "example_id": "b73a6e6a-0a5a-44a1-b49f-cacb760bcd7c",
                                "sense_id": "8b057520-d440-375d-aa15-4a60515fe15e",
                                "text": "На площадке его окликает режиссёр В.: «Дорогуша, здравствуйте.»"
                            }
                        ]
                    }
