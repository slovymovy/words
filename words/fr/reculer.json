            "senses": [
                {
                    "sense_id": "dcfdb85e-8187-3260-8976-93bc60e869d3",
                    "sense_definition": "Aller ou se déplacer vers l'arrière.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mouvement_arriere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conducteur doit <w>reculer</w> lentement pour sortir de cette place de stationnement étroite."
                        },
                        {
                            "text": "Quand le chien s'est approché, elle a <w>reculé</w> de deux pas par peur."
                        }
                    ],
                    "antonyms": [
                        "avancer"
                    ],
                    "common_phrases": [
                        "reculer d'un pas",
                        "faire reculer"
                    ]
                },
                {
                    "sense_id": "9d0870c2-779a-3078-b75a-480705608afb",
                    "sense_definition": "Déplacer ou pousser un objet vers l'arrière.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement_arriere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Peux-tu <w>reculer</w> ta chaise pour laisser passer les personnes derrière toi ?"
                        },
                        {
                            "text": "Nous devons <w>reculer</w> cette table afin de libérer de l'espace dans la pièce."
                        }
                    ],
                    "antonyms": [
                        "avancer"
                    ],
                    "common_phrases": [
                        "reculer sa chaise",
                        "reculer la table"
                    ]
                },
                {
                    "sense_id": "5fe2857f-5ede-3aa1-af28-e8d81c901b32",
                    "sense_definition": "Renoncer ou céder face à une difficulté, à un danger ou à une opposition.",
