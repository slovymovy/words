                ],
                "senses": [
                    {
                        "sense_id": "52e2bad4-8115-3608-b486-63b51d74f7f0",
                        "entry_id": "72b1003d-10d5-32e1-97c9-fe396c17c3ef",
                        "glosses": [
                            "die Vorbereitung auf den Empfang eines Sakramentes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a24efcc9-176f-4dda-81a6-f44998e110fd",
                                "sense_id": "52e2bad4-8115-3608-b486-63b51d74f7f0",
                                "text": "„Die Sakramentenkatechese liegt in vielen Pfarreien großenteils in den Händen ehrenamtlicher Katecheten, die keine besondere Ausbildung vorweisen müssen.“"
                            },
                            {
                                "example_id": "2fd10794-fbf1-4332-8c65-ba967d976d39",
                                "sense_id": "52e2bad4-8115-3608-b486-63b51d74f7f0",
                                "text": "„Die Sakramentenkatechese erfolgt meist in Form wöchentlicher Treffen der einzelnen Kleingruppen, nicht selten auch in der Wohnung der Katecheten.“"
                            },
                            {
                                "example_id": "69d35dca-2a8c-4e1c-a8ce-b7d8fe540832",
                                "sense_id": "52e2bad4-8115-3608-b486-63b51d74f7f0",
                                "text": "„Ziel der Sakramentenkatechese ist es, auf eine Begegnung mit Jesus Christus im Sakrament vorzubereiten.“"
                            },
                            {
                                "example_id": "714a7f67-4cdf-4492-b717-01d500d9d4f8",
                                "sense_id": "52e2bad4-8115-3608-b486-63b51d74f7f0",
                                "text": "„Die Sakramentenkatechese wird jeweils als begleiteter Abschnitt auf dem Glaubensweg gestaltet. Um Menschen unterschiedlich geprägter religiöser und kirchlicher Sozialisation zu erreichen, hält sie unterschiedliche Angebote und Wege bereit.“"
                            },
                            {
                                "example_id": "a6afcb8c-92a7-49f8-b4ba-00a6b4242c2e",
                                "sense_id": "52e2bad4-8115-3608-b486-63b51d74f7f0",
                                "text": "„Aufgrund der Gemeindebefragung wissen wir, dass die Sakramentenkatechese im Vergleich zu andern Angeboten der Gemeinde für viele der Befragten einen sehr hohen Stellenwert hat.“"
                            },
                            {
                                "example_id": "7251a04b-40b7-440b-b26f-d7a21a30bd7d",
                                "sense_id": "52e2bad4-8115-3608-b486-63b51d74f7f0",
                                "text": "„Die Abfolge von Taufe, religiösen Erfahrungen und Vermittlung von Glaubensinhalten in Familie, Religionsunterricht, Sakramentenkatechese und kirchlicher Jugendarbeit entspricht nur noch punktuell der Realität der Menschen heute.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
