                            {
                                "target_lang_word": "одеяние",
                                "target_lang_sense_clarification": "устаревшее"
                            },
                            {
                                "target_lang_word": "платье",
                                "target_lang_sense_clarification": "одежда, наряд"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kılık kıyafet",
                                "target_lang_sense_clarification": "dış görünüş, giysi"
                            },
                            {
                                "target_lang_word": "giysi",
                                "target_lang_sense_clarification": "eski kullanımda elbise"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e988c6c7-c3e3-3cc8-a214-e7c686b9d1a4",
                    "sense_definition": "To clothe.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actors were <w>habited</w> in Victorian costumes.",
                            "target_lang_translations": {
                                "ru": "Актеры были <w>облачены</w> в викторианские костюмы.",
                                "tr": "Oyuncular Viktorya dönemi kostümleriyle <w>giydirilmişti</w>."
                            }
                        },
                        {
                            "text": "She was <w>habited</w> for the journey in warm clothes.",
                            "target_lang_translations": {
                                "ru": "Она была <w>одета</w> в дорогу в теплые вещи.",
                                "tr": "Yolculuk için sıcak tutan giysilerle <w>donatılmıştı</w>."
                            }
