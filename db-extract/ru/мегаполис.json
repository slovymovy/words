                                "target_senses": [
                                    {
                                        "sense_id": "34449e12-a853-3a89-bc58-11f0e3110024",
                                        "entry_id": "9bd08a84-2b4e-35f5-b25f-55e5e2828d73",
                                        "glosses": [
                                            "A large conurbation, where two or more large cities have sprawled outward to meet, forming something larger than a normal metropolis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c3a1410-69a8-42b1-a655-4504f82691a8",
                                                "sense_id": "34449e12-a853-3a89-bc58-11f0e3110024",
                                                "text": "The Eastern Seaboard megalopolis extends from New Hampshire to Alexandria, VA."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
