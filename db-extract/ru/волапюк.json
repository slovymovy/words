                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "209bc95c-3c92-4133-8f4d-dd7b6fa3ad7a",
                        "source_entry_id": "f39ec84f-e2ca-357b-854f-55e59a79bc3e",
                        "source_sense_description": "искусственный язык",
                        "target_lang_word": "Volapük",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Volapük",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53e954b6-8fee-318b-8576-128bebdc3a78",
                                        "entry_id": "7071291c-3d83-3fa7-8df5-343d5fc3498b",
                                        "glosses": [
                                            "1880 von Johann Martin Schleyer geschaffene Plansprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ac2b2d1-f1ba-4f0f-9451-1a6ff32ce2c8",
                                                "sense_id": "53e954b6-8fee-318b-8576-128bebdc3a78",
                                                "text": "Volapük ist eine der ältesten Plansprachen."
                                            },
                                            {
                                                "example_id": "5f749ed8-104d-45f2-bfbf-1e167a9c0356",
                                                "sense_id": "53e954b6-8fee-318b-8576-128bebdc3a78",
                                                "text": "„In »Der Augenblick« trifft eine Person auf eine Gruppe fremder Menschen in einer ortlosen Landschaft, die eine gescheiterte Universalsprache Volapük sprechen.“"
                                            },
                                            {
                                                "example_id": "472b4b3d-e255-4e42-94c2-f6329d808ee0",
                                                "sense_id": "53e954b6-8fee-318b-8576-128bebdc3a78",
                                                "text": "„Niemand muß sich mehr mit Volapük und Esperanto abquälen, wir haben doch das globale Englisch!“"
                                            },
                                            {
                                                "example_id": "fccfb878-7733-440e-bff4-8533c59b47ca",
                                                "sense_id": "53e954b6-8fee-318b-8576-128bebdc3a78",
                                                "text": "„Leibniz denkt bei dieser ungeheuerlichen Idee nur nebenher an den Nutzen, den eine einheitliche Menschensprache gewähren könnte; man darf seinen Plan wirklich nicht auf eine Stufe stellen mit den albernen Bestrebungen unserer kleinen Zeitgenossen, die ein Volapük oder Esperanto erfinden, wie Kinder sich eine Erbsensprache erfinden, und die damit wirklich so weit kommen, wie ein Missionar, der das Vaterunser ins Hottentottische übersetzt.“"
                                            },
                                            {
                                                "example_id": "ffbbeea4-35df-4af6-b490-6472f2f94371",
                                                "sense_id": "53e954b6-8fee-318b-8576-128bebdc3a78",
                                                "text": "„Sie antwortet in Volapük.“"
                                            },
                                            {
                                                "example_id": "2915c897-da30-4cb4-9562-6567d3ba549b",
                                                "sense_id": "53e954b6-8fee-318b-8576-128bebdc3a78",
                                                "text": "„Im Gegensatz zum Volapük bietet Esperanto auch die Möglichkeit, für ästhetische oder literarische Zwecke eingesetzt zu werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
