                                        "glosses": [
                                            "The act or process of capitalising.",
                                            "Choice of case (when writing a word); the act or process of writing a word in a particular case, such as ALL CAPS, Title Case, CamelCase, Sentence case, or all lowercase.",
                                            "The act or process of writing (something: either an entire word or text, or just the initial letter(s) thereof) in capital letters."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9e8b2ae-5d4f-454a-a534-53243121ba41",
                                                "sense_id": "37dca23a-c308-3386-aacf-3061cc75484f",
                                                "text": "The capitalisation of all nouns is a distinctive feature of German."
                                            },
                                            {
                                                "example_id": "373c4499-38e5-49d9-8458-fa63b76e3b26",
                                                "sense_id": "37dca23a-c308-3386-aacf-3061cc75484f",
                                                "text": "Race is a flawed concept to begin with, and while the capitalisation of the “b” assuages race politics, it also validates race politics."
                                            },
                                            {
                                                "example_id": "ae87c78d-542d-4a8e-9b4e-3b1e7dd17f9c",
                                                "sense_id": "37dca23a-c308-3386-aacf-3061cc75484f",
                                                "text": "Frequent, sometimes unexpected capitalisations are customary in Dickinson’s writing, and here they gain additional nuance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ddacd83-fbca-31d5-9af3-420d82bb6d74",
                                        "entry_id": "989fd590-c4ef-36a9-9c9d-38d122d74d01",
                                        "glosses": [
                                            "The act or process of capitalising.",
                                            "The act or process of seizing (an opportunity) and profiting or obtaining an advantage (from it)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4cbb77d-9fe6-4f76-b720-4a0dfc606de1",
                                                "sense_id": "0ddacd83-fbca-31d5-9af3-420d82bb6d74",
                                                "text": "[...] apparently indicating the degree to which his identification with black music predicates his capitalization on it [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce46f6a8-bb21-3c98-bc07-c01443db8a85",
                                        "entry_id": "989fd590-c4ef-36a9-9c9d-38d122d74d01",
                                        "glosses": [
                                            "The state of being capitalised."
                                        ],
                                        "tags": [
