                "senses": [
                    {
                        "sense_id": "9b07346d-40e3-395d-9048-8c5e66254770",
                        "entry_id": "776bcf56-3e48-3a86-a100-ded39bb000a5",
                        "glosses": [
                            "Variante de négrerie ; lieu où l'on enfermait les noirs mis sous esclavages."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "94db0dbe-edad-450d-9784-ab3a4b4af4e0",
                                "sense_id": "9b07346d-40e3-395d-9048-8c5e66254770",
                                "text": "Les autres esclaves sont soit vendus sur le débarcadère, soit dirigés sur des nègreries en attendant leur vente \"à l’encan\", c'est à dire aux enchères."
                            }
                        ]
                    },
                    {
                        "sense_id": "75e73e7d-a67e-3671-b8fb-d99483cea06f",
                        "entry_id": "776bcf56-3e48-3a86-a100-ded39bb000a5",
                        "glosses": [
                            "Ensemble des Noirs."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "60e7b9a6-5dc2-4152-a4fe-47410461c358",
                                "sense_id": "75e73e7d-a67e-3671-b8fb-d99483cea06f",
                                "text": "Tout candidat à l’immigration devient héritier de tirailleur, comme si le sacrifice de ce brave était éternel héritage de toute la nègrerie, comme si nous accepterions que les USA nous dictent à jamais leurs volontés à cause de l’opération Overlord."
                            }
                        ]
                    },
                    {
                        "sense_id": "2e6d9755-6c9a-3fe9-b6ab-44e88f2256e1",
                        "entry_id": "776bcf56-3e48-3a86-a100-ded39bb000a5",
                        "glosses": [
                            "Caractère propre aux Noirs."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f7d59460-8feb-483b-9672-3a104cb7d362",
                                "sense_id": "2e6d9755-6c9a-3fe9-b6ab-44e88f2256e1",
                                "text": "Les peignoirs de bain ne sont plus blancs : il sont bariolés à la sauvagesse, ocellés à la façon de pelages de tigresses et de panthères, et jetés, comme des capes, sur les épaules humides et les reins ruisselants. Les tableaux de Gustave Moreau avaient prévu cette heureuse transformation, qui tient aussi au choc en retour des colonies, à la « nègrerie » transférée aux Blanches."
                            }
                        ]
                    }
