                "senses": [
                    {
                        "sense_id": "12fa3128-b57a-3522-8bb2-98818a5bc972",
                        "entry_id": "8654bd84-28af-343f-ba23-020d8606764d",
                        "glosses": [
                            "Déclarer comme faisant l’objet d’une prise d’option."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dcec0b9-ded8-4a31-8cad-f509b0398ec0",
                                "sense_id": "12fa3128-b57a-3522-8bb2-98818a5bc972",
                                "text": "« Mettre une fille en option » ou « l’optionner », c’était pour le client une autre façon de dire « je me réserve le droit de décider à la dernière minute si je vais finir par la confirmer » (tache rouge)."
                            },
                            {
                                "example_id": "5ebea555-14c4-4785-a033-929f75e1602b",
                                "sense_id": "12fa3128-b57a-3522-8bb2-98818a5bc972",
                                "text": "Contactez-nous pour optionner votre date."
                            },
                            {
                                "example_id": "aaecc85a-4290-4857-bce2-231ae50858e3",
                                "sense_id": "12fa3128-b57a-3522-8bb2-98818a5bc972",
                                "text": "David Fincher vient d’optionner le roman macabre de Jason Starr paru en 2009, Panic Attack."
                            }
                        ]
                    }
