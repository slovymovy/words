                    {
                        "sense_id": "141690d9-cec1-3ae8-94b6-32db9461ccb1",
                        "entry_id": "51cef581-83e7-358f-81de-4e6ff48233ed",
                        "glosses": [
                            "Sechzigerjahre des zwanzigsten Jahrhunderts, Sechziger"
                        ],
