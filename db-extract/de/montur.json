                        "sense_id": "6cd7fadb-4301-3c73-a9ca-09cddf7688f3",
                        "entry_id": "37876bc1-d82b-33d7-acbe-e7cefcfbd458",
                        "glosses": [
                            "Kleidungsstücke bei einer bestimmten Tätigkeit oder einem bestimmten Anlass, Uniform oder Dienstkleidung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f58d2df8-048e-4f7e-8aec-f8ffde4b66b0",
                                "sense_id": "6cd7fadb-4301-3c73-a9ca-09cddf7688f3",
                                "text": "Wenn du am Esstisch nie deine Montur ausziehst, wissen alle, dass du Monteur bist."
                            },
                            {
                                "example_id": "b29a1662-5e41-4d6d-aacb-efdb18754497",
                                "sense_id": "6cd7fadb-4301-3c73-a9ca-09cddf7688f3",
                                "text": "„Unter der Montur hatte er kein Hemd gehabt, sondern nur eine lange, fettige, geblümte Seidenweste, auf dem nackten, gelblichen, mageren Körper.“"
                            }
                        ],
