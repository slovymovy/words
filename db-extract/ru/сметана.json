                    },
                    {
                        "translation_id": "3374cbbf-331b-4d1f-9632-cef7cae947c7",
                        "source_entry_id": "ecec1648-2c6a-34c1-9cfe-49e8f8ced6ba",
                        "source_sense_id": "ef35eceb-dd6a-307f-ba85-c6d5e3ec1304",
                        "target_lang_word": "crème fraîche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crème fraîche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f595d658-0f8e-30b8-81f5-383efb1d1b2f",
                                        "entry_id": "469810bc-df29-395f-8303-3424f715f0d7",
                                        "glosses": [
                                            "Crème blanche, épaisse, pasteurisée et légèrement acidifiée par culture bactérienne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dea3041c-08bd-47ba-8bba-f7d7ab0f9b83",
                                                "sense_id": "f595d658-0f8e-30b8-81f5-383efb1d1b2f",
                                                "text": "Après s’être goinfré d’une copieuse platée de spaghettis à l’huile de truffe et à la crème fraîche, avoir descendu à lui tout seul les trois quarts d’une bouteille de montepulciano, il me raconte ce qu’il sait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3c3ba79-7ca5-4f06-a727-ec3103b6ca98",
                        "source_entry_id": "ecec1648-2c6a-34c1-9cfe-49e8f8ced6ba",
                        "source_sense_id": "ef35eceb-dd6a-307f-ba85-c6d5e3ec1304",
                        "target_lang_word": "fromage blanc",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fromage blanc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31a11532-eaef-399c-b561-e84769acad5c",
                                        "entry_id": "5bd6558e-2781-3322-b91c-800a4068e670",
                                        "glosses": [
                                            "Fromage obtenu à partir de lait que l’on a fait cailler avec de la présure, sans fermentation, puis que l’on a rendu onctueux en le lissant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3d937e2-c807-4b8f-8d93-dae43238b31f",
                                                "sense_id": "31a11532-eaef-399c-b561-e84769acad5c",
                                                "text": "L'été, la marchande de fromage blanc claironnait sa ritournelle : « Fromage à la crème, fromage à la crème ». Nous lui achetions plusieurs de ces cœurs logés dans des moules. La marchande, après les avoir précautionneusement démoulés et dégagés d'une sorte d’étamine qui les enveloppait, les versait dans notre grand saladier et les arrosait d’une crème onctueuse."
                                            },
                                            {
                                                "example_id": "c8568cfc-0fc0-42fe-96eb-25cc1870d3eb",
                                                "sense_id": "31a11532-eaef-399c-b561-e84769acad5c",
                                                "text": "Les « Fromages blancs » était le nom donné à la fanfare municipale à cause de la forme et de la couleur des casquettes de ses musiciens. Son chef était M. Muracciole, officier de marine en retraite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
