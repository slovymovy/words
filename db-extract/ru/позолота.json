                "senses": [
                    {
                        "sense_id": "bb1332dd-bf61-39b9-9020-003425bcd170",
                        "entry_id": "cfdad3ce-c71e-3678-9711-482bb6313ef1",
                        "glosses": [
                            "тонкий слой золота или золотой либо бронзовой краски, покрывающий что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bd87902-7af7-49e0-8a83-a1791f1cdb1f",
                                "sense_id": "bb1332dd-bf61-39b9-9020-003425bcd170",
                                "text": "Амвон, а на нём раскрытая книга, и позолота на буквах уже лупится."
                            }
                        ]
                    },
                    {
                        "sense_id": "51eea8a0-adab-3916-a4e6-6e9f8f195a10",
                        "entry_id": "cfdad3ce-c71e-3678-9711-482bb6313ef1",
                        "glosses": [
                            "нанесение на предмет тонкого слоя золота (от долей мкм до нескольких мкм) в декоративных, защитных или защитно-декоративных целях"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7c59019-bec4-4b21-9931-1085cbca64fe",
                        "source_entry_id": "cfdad3ce-c71e-3678-9711-482bb6313ef1",
                        "target_lang_word": "Blattgold",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blattgold",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85113f69-3681-386c-b692-93519f5d8166",
                                        "entry_id": "e1b6a1b4-3c51-3a28-b29d-c217565d9da5",
                                        "glosses": [
                                            "eine sehr dünn ausgetriebene Goldfolie, die meist zur Vergoldung von Gegenständen benutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a873934d-fb70-4ba1-a448-31c17c00c3df",
                                                "sense_id": "85113f69-3681-386c-b692-93519f5d8166",
                                                "text": "„Gold galt als Metall der Götter, besonders des strahlenden Sonnengottes. Die Spitze der Obelisken wurde mit Blattgold überzogen.“"
                                            },
                                            {
                                                "example_id": "acb1f4c4-af91-4426-b683-215a124d1e5a",
                                                "sense_id": "85113f69-3681-386c-b692-93519f5d8166",
                                                "text": "„Vorne auf dem mit zartem Blattgold verzierten Einband prangte das breite Lächeln der Grinsekatze.“"
                                            },
                                            {
                                                "example_id": "8771268c-9790-43cf-87e8-b1a09cae89fc",
                                                "sense_id": "85113f69-3681-386c-b692-93519f5d8166",
                                                "text": "„Eines der berühmtesten Artefakte ist ein künstliches, mit Blattgold überzogenenes Bäumchen von 70 Zentimeter Höhe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
