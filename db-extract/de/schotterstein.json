                "senses": [
                    {
                        "sense_id": "257c9f2d-9e6d-32f2-b81b-5ac111ca5644",
                        "entry_id": "da40581e-e8ca-3b7a-801b-62c2de1ae6ce",
                        "glosses": [
                            "ein Stein aus einer Menge Schotters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d4993df-a8f6-4c8b-8f6d-28c92a941abc",
                                "sense_id": "257c9f2d-9e6d-32f2-b81b-5ac111ca5644",
                                "text": "„Glas und Schottersteine hatten sich in den Wunden festgesetzt und glitzerten spöttisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d7bbcb9-d082-4596-93bc-12d357717edc",
                        "source_entry_id": "da40581e-e8ca-3b7a-801b-62c2de1ae6ce",
                        "source_sense_id": "257c9f2d-9e6d-32f2-b81b-5ac111ca5644",
                        "source_sense_description": "ein Stein aus einer Menge Schotters",
                        "target_lang_word": "gravier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gravier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7abbbaf1-2825-3ae0-a031-764bff008018",
                                        "entry_id": "ce697a4a-fe1f-380e-9698-19604b4b7b17",
                                        "glosses": [
                                            "Roche détritique à éléments assez gros (sables grossiers et cailloux), d’origine fluviatile ou littorale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "651983dc-547a-48ce-bf17-e56142a102ba",
                                                "sense_id": "7abbbaf1-2825-3ae0-a031-764bff008018",
                                                "text": "Samedi dernier, – répliqua M. Smallways, – j’ai été obligé de ramasser trois brouettées de gravier dans mes pommes de terre… trois brouettées de lest qu’ils nous ont versées sur la tête."
                                            },
                                            {
                                                "example_id": "e54d7868-f6fa-432f-8673-df59c0d4d8a9",
                                                "sense_id": "7abbbaf1-2825-3ae0-a031-764bff008018",
                                                "text": "La Garonne devenant divagante multiplie, à loisir, les « gaules » ou « gaures », c'est-à-dire ses bras, et les « îles », résultant de l’atterrissement des graviers vite envahis par la végétation spontanée et bientôt exhaussées par la rétention du limon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b853cdb-d981-3f8f-8041-c9fa3cd65de8",
                                        "entry_id": "ce697a4a-fe1f-380e-9698-19604b4b7b17",
                                        "glosses": [
                                            "Ensemble de petits cailloux servant au revêtement des allées, dans un jardin, etc."
                                        ],
                                        "tags": [
                                            "Jardinage"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e196e24-5c55-3dff-b0df-47ff52e615b7",
                                        "entry_id": "ce697a4a-fe1f-380e-9698-19604b4b7b17",
                                        "glosses": [
                                            "Pierres concassées, de diamètres de 0,5 à 4 cm, servant au revêtement des chemins carrossables non asphaltés, et au remplissage de volumes pour lesquels on désire que l’écoulement d’eau soit maximal."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "889ec438-bbb5-4c26-90a4-20f3be7311c8",
                                                "sense_id": "2e196e24-5c55-3dff-b0df-47ff52e615b7",
                                                "text": "Le cri du gravier sous ses bottines, dans le silence, la fit tressaillir."
                                            },
                                            {
                                                "example_id": "3beb9ada-99ea-4684-bb2d-3b38fd54f134",
                                                "sense_id": "2e196e24-5c55-3dff-b0df-47ff52e615b7",
                                                "text": "En remontant le vieil escalier de bois, il entendit comme un bruit de bottes sur les graviers au-dessus de lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1de4a638-8b5a-370c-a886-b08794f5b8e9",
                                        "entry_id": "ce697a4a-fe1f-380e-9698-19604b4b7b17",
                                        "glosses": [
                                            "Concrétions assez grosses analogues à de petites pierres qui se forment dans les reins ou dans la vessie."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "49530d5d-cd1d-3a92-8ead-8fc0ec96da01",
                                        "entry_id": "ce697a4a-fe1f-380e-9698-19604b4b7b17",
                                        "glosses": [
                                            "Personne chargée d’étaler et de faire sécher la morue ou d’autres poissons sur les graves, les terrains caillouteux du rivage."
                                        ],
                                        "tags": [
                                            "Terre-Neuve"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e424edc-615e-48f6-baf5-bb6c46170f20",
                                                "sense_id": "49530d5d-cd1d-3a92-8ead-8fc0ec96da01",
                                                "text": "Mais la vie du gravier, qu'il fût mousse ou novice, était très fatigante, comme en témoignent les mémoires de Pléville Le Pelley, qui avait travaillé à Terre-Neuve comme mousse à l'age de 12 ans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28faaa11-373e-40a2-add3-ad79fdc049ad",
                        "source_entry_id": "da40581e-e8ca-3b7a-801b-62c2de1ae6ce",
                        "source_sense_id": "257c9f2d-9e6d-32f2-b81b-5ac111ca5644",
                        "source_sense_description": "ein Stein aus einer Menge Schotters",
                        "target_lang_word": "ballast",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ballast",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "300aa05a-13c7-3fb2-beba-124fd5ae6a0c",
                                        "entry_id": "4f2f711f-57e7-3ebe-9153-aee01e581f3c",
                                        "glosses": [
                                            "Lest permettant de gérer la stabilité, l’assiette ou la gîte d’un navire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7000497-20ca-471f-beb2-87dd7257d308",
                                                "sense_id": "300aa05a-13c7-3fb2-beba-124fd5ae6a0c",
                                                "text": "On les voyait glisser sans jamais perdre contact avec le sol, semblables à de vieux navires enfoncés profondément dans l'océan des choses terrestres, y prenant appui et ballast."
                                            },
                                            {
                                                "example_id": "869203b6-b1a3-4db4-a70a-85a001066ddd",
                                                "sense_id": "300aa05a-13c7-3fb2-beba-124fd5ae6a0c",
                                                "text": "La seule faculté que possède l’ordinateur à un degré surhumain, c’est la mémoire. Or l’accumulation du passé est dans certaines limites un atout important, mais c’est aussi un fardeau, un ballast dont très sagement la nature se débarrasse à chaque génération nouvelle – puisque le savoir des parents ne se transmet pas héréditairement aux enfants."
                                            },
                                            {
                                                "example_id": "3eb412eb-9a69-4b7e-8024-69853cee1881",
                                                "sense_id": "300aa05a-13c7-3fb2-beba-124fd5ae6a0c",
                                                "text": "Le relargage d’œufs ou de juvéniles lors du vidage de ballasts de navires en provenance de l’océan Pacifique est moins plausible, et aucune analyse ne vient le confirmer."
                                            },
                                            {
                                                "example_id": "32ab10d9-b92c-4160-aea4-6ccc89b35088",
                                                "sense_id": "300aa05a-13c7-3fb2-beba-124fd5ae6a0c",
                                                "text": "Les nombreux virements de bord sont propices à l’apprentissage. Je transfère le ballast, je matosse sur l’autre bord, je vire, je transfère à nouveau le ballast, je matosse sur bâbord, je vire à nouveau..."
                                            },
                                            {
                                                "example_id": "e95e355e-450a-41a4-80a3-11ab56849f64",
                                                "sense_id": "300aa05a-13c7-3fb2-beba-124fd5ae6a0c",
                                                "text": "Cette plante vasculaire proviendrait d’Asie et aurait été introduite dans nos milieux aquatiques par les vidanges de ballasts des navires et par les rejets d'eau d’aquariums domestiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a53251ea-9720-359c-a3d4-5c0b1380cf09",
                                        "entry_id": "4f2f711f-57e7-3ebe-9153-aee01e581f3c",
                                        "glosses": [
                                            "Réservoir d’un sous-marin contenant de l’air ou de l’eau pour régler son immersion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f061d4cc-21ee-39d3-a202-f4d6fc714ab4",
                                        "entry_id": "4f2f711f-57e7-3ebe-9153-aee01e581f3c",
                                        "glosses": [
                                            "Remblai de gravier que l’on tasse sur les voies ferrées pour assujettir les traverses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3475a28b-798f-4e82-ac7c-38f7d0e1d5ff",
                                                "sense_id": "f061d4cc-21ee-39d3-a202-f4d6fc714ab4",
                                                "text": "A Massy-Palaiseau, un appareil spécial, dit sauterelle, a été installé par dessus la voie d'accès aux marchandises, pour permettre aux trains de ballast et de matériel venant de Juvisy, de continuer leur marche sur la deuxième voie posée."
                                            },
                                            {
                                                "example_id": "7f65d42b-0a9e-4eb3-882a-815efefb4546",
                                                "sense_id": "f061d4cc-21ee-39d3-a202-f4d6fc714ab4",
                                                "text": "Vingt minutes apaisées avec, d’un côté, cette vie qui refaisait surface tandis que, de l’autre, le ballast qui défilait sous la rame aspirait à lui les humeurs sales du jour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "665a08e6-5b55-3a6f-bd84-f117248bb701",
                                        "entry_id": "4f2f711f-57e7-3ebe-9153-aee01e581f3c",
                                        "glosses": [
                                            "Composant électrique utilisé pour réduire le courant électrique dans un circuit électrique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
