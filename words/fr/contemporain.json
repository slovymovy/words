{
    "word_family": [
        "contemporanéité"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "157673a2-311e-31d3-a9f2-c51e1c635d05",
                    "sense_definition": "Qui appartient à l'époque actuelle, au temps présent.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "actuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce musée expose de nombreuses œuvres d'art <w>contemporain</w> créées par de jeunes artistes."
                        },
                        {
                            "text": "La société <w>contemporaine</w> fait face à des défis technologiques et écologiques majeurs."
                        }
                    ],
                    "synonyms": [
                        "actuel"
                    ],
                    "antonyms": [
                        "ancien"
                    ],
                    "common_phrases": [
                        "art contemporain",
                        "époque contemporaine",
                        "monde contemporain"
                    ]
                },
                {
                    "sense_id": "839965e6-2c75-38d8-abb5-ea8aa442ff2e",
                    "sense_definition": "Qui appartient à la même époque ou a vécu au même moment qu'une autre personne ou chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "meme_epoque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce compositeur était <w>contemporain</w> de Mozart, mais son œuvre est moins connue aujourd'hui."
                        },
                        {
                            "text": "Plusieurs auteurs <w>contemporains</w> de Victor Hugo ont salué son génie littéraire."
                        }
                    ],
                    "common_phrases": [
                        "auteur contemporain",
                        "témoin contemporain"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4e5359e3-93b3-3414-a8b2-dbbabd035a63",
                    "sense_definition": "Personne qui vit ou a vécu à la même époque qu'une autre, ou à l'époque actuelle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "meme_epoque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce grand philosophe n'a pas toujours été compris par ses <w>contemporains</w>."
                        },
                        {
                            "text": "Certains de nos <w>contemporains</w> préfèrent vivre loin des grandes villes."
                        }
                    ],
                    "common_phrases": [
                        "jugement de ses contemporains"
                    ]
                },
                {
                    "sense_id": "e37dedcc-73ba-300c-ba99-c1ac7bf24151",
                    "sense_definition": "Personne qui est née la même année qu'une autre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "meme_epoque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon grand-père a retrouvé un <w>contemporain</w> né lui aussi en mil neuf cent quarante."
                        },
                        {
                            "text": "Elle a découvert que ce célèbre écrivain était son <w>contemporain</w> exact."
                        }
                    ],
                    "synonyms": [
                        "conscrit"
                    ]
                },
                {
                    "sense_id": "79e7dbf9-7f66-3ac9-ab3b-ad4ae9882d02",
                    "sense_definition": "Ensemble des réalités, des tendances ou de la culture du temps présent.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "actuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle galerie d'exposition est résolument tournée vers le <w>contemporain</w>."
                        },
                        {
                            "text": "Le festival cherche à créer un dialogue enrichissant entre le passé et le <w>contemporain</w>."
                        }
                    ],
                    "common_phrases": [
                        "ouvert sur le contemporain"
                    ]
                }
            ]
        }
    ]
}