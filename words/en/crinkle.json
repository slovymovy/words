{
    "word_family": [
        "crinkly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7fa8b875-6922-376d-a9a2-8a9b708ff427",
                    "sense_definition": "A small wrinkle, fold, or crease in a surface.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wrinkle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He observed the <w>crinkles</w> forming around his eyes and suddenly felt old.",
                            "target_lang_translations": {
                                "cs": "Pozoroval <w>vrásky</w>, které se mu tvořily kolem očí, a náhle se cítil starý."
                            }
                        },
                        {
                            "text": "The paper had several <w>crinkles</w> after being stuffed into the small envelope.",
                            "target_lang_translations": {
                                "cs": "Papír měl po nacpání do malé obálky několik <w>záhybů</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "wrinkle",
                        "crease",
                        "fold"
                    ],
                    "target_lang_definitions": {
                        "cs": "Drobná vráska, záhyb nebo ohyb na povrchu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vráska",
                                "target_lang_sense_clarification": "zejména na kůži nebo obličeji"
                            },
                            {
                                "target_lang_word": "záhyb",
                                "target_lang_sense_clarification": "na látce nebo papíru"
                            },
                            {
                                "target_lang_word": "ohyb",
                                "target_lang_sense_clarification": "místo, kde je materiál přehnutý"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1cf26fa-5db6-3ae3-b30d-5c88d6671419",
                    "sense_definition": "The sound or action of making small folds or creases.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wrinkle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>crinkle</w> of the plastic bag woke the sleeping baby.",
                            "target_lang_translations": {
                                "cs": "<w>Šustění</w> plastového sáčku probudilo spící dítě."
                            }
                        },
                        {
                            "text": "She listened to the soft <w>crinkle</w> of the gift wrap as she opened her present.",
                            "target_lang_translations": {
                                "cs": "Poslouchala jemné <w>šustění</w> balicího papíru, když rozbalovala svůj dárek."
                            }
                        }
                    ],
                    "synonyms": [
                        "rustle"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zvuk nebo činnost vytváření drobných záhybů či ohybů."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "šustění",
                                "target_lang_sense_clarification": "zvuk vydávaný papírem nebo plastem"
                            },
                            {
                                "target_lang_word": "mačkání",
                                "target_lang_sense_clarification": "činnost vytvářející záhyby"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a4b592c7-639c-33a0-bc0c-1fd4129f7973",
                    "sense_definition": "To form small folds or creases in something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wrinkle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>crinkled</w> the candy wrapper and threw it into the trash can.",
                            "target_lang_translations": {
                                "cs": "<w>Zmačkal</w> obal od bonbonu a hodil ho do koše."
                            }
                        },
                        {
                            "text": "The old man's face <w>crinkled</w> into a warm smile when he saw his grandson.",
                            "target_lang_translations": {
                                "cs": "Starcovu tvář <w>pokrčily</w> vřelé úsměvy, když uviděl svého vnuka."
                            }
                        }
                    ],
                    "synonyms": [
                        "crease",
                        "crumple"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vytvářet drobné záhyby nebo ohyby na něčem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zmačkat",
                                "target_lang_sense_clarification": "vytvořit záhyby neuspořádaně"
                            },
                            {
                                "target_lang_word": "pokrčit",
                                "target_lang_sense_clarification": "vytvořit ohyby na povrchu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87ca8b30-04d8-3b85-8b4b-6aeba89f21bc",
                    "sense_definition": "To make a soft, rustling sound like stiff paper or fabric.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dry leaves <w>crinkle</w> under our feet as we walk through the park.",
                            "target_lang_translations": {
                                "cs": "Suché listí pod našima nohama <w>šustí</w>, když procházíme parkem."
                            }
                        },
                        {
                            "text": "The expensive silk dress would <w>crinkle</w> whenever she moved across the room.",
                            "target_lang_translations": {
                                "cs": "Drahé hedvábné šaty <w>šustily</w> pokaždé, když se pohnula po místnosti."
                            }
                        }
                    ],
                    "synonyms": [
                        "rustle"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vydávat jemný, šustivý zvuk jako tuhý papír nebo látka."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "šustit",
                                "target_lang_sense_clarification": "vydávat zvuk při pohybu nebo mačkání"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}