                            {
                                "target_lang_word": "fotografía de mesa",
                                "target_lang_sense_clarification": "fotografía de bodegón o producto"
                            },
                            {
                                "target_lang_word": "bodegón",
                                "target_lang_sense_clarification": "naturaleza muerta o foto de producto"
                            }
                        ]
