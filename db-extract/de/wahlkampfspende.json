                "senses": [
                    {
                        "sense_id": "fe57191d-a27f-32b8-a3b6-6c7b356c4c85",
                        "entry_id": "ee65bd78-2879-390c-98c3-98a2218c72e3",
                        "glosses": [
                            "finanzielle Zuwendung, die für die Finanzierung eines Wahlkampfes vorgesehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bce582d-7172-4902-874a-f808402085cb",
                                "sense_id": "fe57191d-a27f-32b8-a3b6-6c7b356c4c85",
                                "text": "„Vor der Abstimmung über Tirols Olympiabewerbung erhielten die Neos eine Wahlkampfspende von der Firma des ÖSV-Chefs Peter Schröcksnadel, wie die Rechercheplattform ‚Addendum‘ am Sonntag berichtete.“"
                            },
                            {
                                "example_id": "6e3def56-5e86-468a-824a-c99580110e6b",
                                "sense_id": "fe57191d-a27f-32b8-a3b6-6c7b356c4c85",
                                "text": "„Bei der Zahlung könnte es sich um eine unzulässige Wahlkampfspende gehandelt haben.“"
                            },
                            {
                                "example_id": "2b6a40b6-3f17-4dfa-b49f-37d673bda699",
                                "sense_id": "fe57191d-a27f-32b8-a3b6-6c7b356c4c85",
                                "text": "„Die frühere Buchhalterin von L'Oréal Erbin Liliane Bettencourt beteuert, Frankreichs Präsident Sarkozy habe von der Multimilliardärin Wahlkampfspenden erhalten.“"
                            }
                        ],
