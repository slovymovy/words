                {
                    "sense_id": "66b47fcc-07a7-309c-97cb-64f180478774",
                    "sense_definition": "Se regrouper en un même lieu en parlant de personnes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "regroupement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les membres du conseil municipal s'<w>assemblent</w> chaque premier lundi du mois.",
                            "target_lang_translations": {
                                "en": "The members of the town council <w>assemble</w> every first Monday of the month.",
                                "ru": "Члены городского совета <w>собираются</w> каждый первый понедельник месяца.",
                                "de": "Die Mitglieder des Gemeinderats <w>versammeln</w> <w>sich</w> jeden ersten Montag im Monat.",
                                "es": "Los miembros del consejo municipal <w>se reúnen</w> cada primer lunes del mes.",
                                "zh": "市议会成员每月的第一个星期一都会<w>聚集</w>在一起。"
                            }
                        },
                        {
                            "text": "Les citoyens s'<w>assemblèrent</w> sur la place principale pour écouter le discours du maire.",
                            "target_lang_translations": {
                                "en": "The citizens <w>assembled</w> in the main square to listen to the mayor's speech.",
                                "ru": "Горожане <w>собрались</w> на главной площади, чтобы послушать речь мэра.",
                                "de": "Die Bürger <w>versammelten</w> <w>sich</w> auf dem Hauptplatz, um der Rede des Bürgermeisters zuzuhören.",
                                "es": "Los ciudadanos <w>se reunieron</w> en la plaza principal para escuchar el discurso del alcalde.",
                                "zh": "市民们<w>聚集</w>在主广场上，听市长发表讲话。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "s'assembler en foule"
                    ],
                    "target_lang_definitions": {
                        "en": "To come together in one place, said of people.",
