                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "700d1025-723f-4818-8f7e-1d7ae34bad1d",
                                "sense_id": "abafc20a-7558-325d-a51e-6f86bb954ed9",
                                "text": "Erb and Remak in Germany, Beard and Rockwell and Althans in America, have used it with advantage, in the forms of galvanisms and faradisms, in the treatment of joint troubles."
                            },
                            {
                                "example_id": "26e8b221-ea2c-41e4-b94b-882a12f0c39b",
                                "sense_id": "abafc20a-7558-325d-a51e-6f86bb954ed9",
                                "text": "The electrical reactions now show a distinct myasthenic reaction, the orbicularis and frontal exhausting on the application of from 16 to 25 faradisms."
                            },
                            {
                                "example_id": "d94d1092-a242-4ee6-99e6-546d18066793",
                                "sense_id": "abafc20a-7558-325d-a51e-6f86bb954ed9",
                                "text": "Lewis Yealland, the junior doctor in charge, used faradism and suggestion to restore motor function in Patrick's arm […]."
                            }
                        ]
                    }
