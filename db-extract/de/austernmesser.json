                                "target_senses": [
                                    {
                                        "sense_id": "c32ca79a-37fa-38f0-b181-3a28023546ff",
                                        "entry_id": "3a85f685-6481-3e15-bbdf-c5769cf0b885",
                                        "glosses": [
                                            "A knife with a short, thick blade, used to pry open oysters and separate the meat from the shell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c19a3d0-131d-4938-97dd-8a6c8e250449",
                                                "sense_id": "c32ca79a-37fa-38f0-b181-3a28023546ff",
                                                "text": "That Puddin', sir, and me, has, back to back,\nWithstood the fearful Rumty Tums' attack,\nAnd swum the Indian Ocean for our lives,\nPursued by Oysters, armed with oyster knives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
