                        "glosses": [
                            "Ramener à un état antérieur qui était déjà considéré comme antique, trop ancien ou dépassé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "984536ef-781b-40de-930f-53345a1de415",
                                "sense_id": "d5a9ba7f-8902-370b-8f10-72dc1829679b",
                                "text": "(...) le retour à un vécu qui, pour avoir été parfois artificiellement réarchaïsé par un clergé avide de pouvoir, n'en demeure pas moins très proche du peuple (...)"
                            },
                            {
                                "example_id": "1418ee86-6c82-46d9-b6de-d906d6071c55",
                                "sense_id": "d5a9ba7f-8902-370b-8f10-72dc1829679b",
                                "text": "Dans la civilisation européenne, la volonté de conserver cet état \"réarchaïsé\" ne conduit qu'à une existence intuitive et instinctive..."
                            }
                        ]
                    }
