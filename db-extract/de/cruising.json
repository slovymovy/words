                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0febde87-ce8b-43f5-b56b-4860240fd338",
                                                "sense_id": "48f8b5ec-5258-32e8-a4b0-1f9c2f81a555",
                                                "text": "Cruising is a popular activity among the over-60s."
                                            },
                                            {
                                                "example_id": "35f2c61a-3530-405f-a5bd-569388bb24bb",
                                                "sense_id": "48f8b5ec-5258-32e8-a4b0-1f9c2f81a555",
                                                "text": "Maintenance time takes away from the time for sightseeing, fishing, reading, or the other things that were the original objectives of cruising."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a35dc7f0-e878-32c9-b92b-66a3fb7ad7bb",
