                                "zh": "在这一<w>时刻</w>，我没时间谈话。"
                            }
                        },
                        {
                            "text": "De trein vertrok precies op het juiste <w>ogenblik</w>.",
                            "target_lang_translations": {
                                "en": "The train left at exactly the right <w>moment</w>.",
                                "ru": "Поезд отправился точно в нужный <w>момент</w>.",
                                "pl": "Pociąg odjechał dokładnie w odpowiednim <w>momencie</w>.",
                                "de": "Der Zug fuhr genau im richtigen <w>Augenblick</w> ab.",
                                "fr": "Le train est parti exactement au bon <w>moment</w>.",
                                "it": "Il treno è partito esattamente al <w>momento</w> giusto.",
                                "cs": "Vlak odjel přesně v ten správný <w>okamžik</w>.",
                                "tr": "Tren tam doğru <w>anda</w> hareket etti.",
                                "es": "El tren salió exactamente en el <w>momento</w> adecuado.",
                                "zh": "火车出发得正是时候，一点儿也不差，真是恰当的<w>时刻</w>。"
                            }
