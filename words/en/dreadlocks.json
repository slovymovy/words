{
    "word_family": [
        "dread"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "18b55ece-f8c2-30fc-82ed-604e54923cfd",
                    "sense_definition": "A hairstyle in which the hair is matted into long, rope-like strands.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hairstyle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to grow his hair out and style it into <w>dreadlocks</w>.",
                            "target_lang_translations": {
                                "zh": "他决定把头发留长，并把它做成<w>脏辫</w>。"
                            }
                        },
                        {
                            "text": "Many people with <w>dreadlocks</w> use natural oils to keep their hair healthy.",
                            "target_lang_translations": {
                                "zh": "许多留着<w>脏辫</w>的人会使用天然精油来保持头发健康。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dreads",
                        "locks"
                    ],
                    "common_phrases": [
                        "wear dreadlocks",
                        "long dreadlocks"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种将头发缠结成绳状长条的发型。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "脏辫",
                                "target_lang_sense_clarification": "指将头发编织或缠结成绳状的发型，常用于描述雷鬼风格的脏辫。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f2a69196-6897-3a80-b7aa-bfcf942763ab",
                    "sense_definition": "Third-person singular simple present indicative of <w>dreadlock</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>dreadlocks</w> her hair every few months to maintain the style.",
                            "target_lang_translations": {
                                "zh": "她每隔几个月就会<w>编</w>一次<w>脏辫</w>来维持这个发型。"
                            }
                        },
                        {
                            "text": "He <w>dreadlocks</w> his hair carefully to ensure each strand is tight.",
                            "target_lang_translations": {
                                "zh": "他仔细地<w>编</w>着<w>脏辫</w>，以确保每一股都足够紧实。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Third-person singular simple present indicative form."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动词 dreadlock 的第三人称单数现在时形式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "编脏辫",
                                "target_lang_sense_clarification": "指将头发编成脏辫这一动作。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
