                        ]
                    }
                },
                {
                    "sense_id": "89b194ae-d475-3530-9182-4893b5e08dd6",
                    "sense_definition": "Flâner, perdre son temps ou travailler de manière paresseuse et négligée.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "flaner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au lieu de finir son travail, l'apprenti passait son après-midi à <w>louper</w> dans l'atelier.",
                            "target_lang_translations": {
                                "en": "Instead of finishing his work, the apprentice spent his afternoon <w>loafing</w> in the workshop.",
                                "ru": "Вместо того чтобы закончить работу, ученик всю вторую половину дня <w>бездельничал</w> в мастерской.",
                                "de": "Anstatt seine Arbeit zu beenden, <w>faulenzte</w> der Lehrling den ganzen Nachmittag in der Werkstatt.",
                                "es": "En lugar de terminar su trabajo, el aprendiz pasaba la tarde <w>holgazaneando</w> en el taller.",
                                "zh": "学徒没有把活干完，整个下午都在作坊里<w>偷懒</w>。"
                            }
                        },
                        {
                            "text": "Il préférait <w>louper</w> sur les boulevards plutôt que de chercher un nouvel emploi.",
                            "target_lang_translations": {
                                "en": "He preferred to <w>loaf</w> on the boulevards rather than look for a new job.",
                                "ru": "Он предпочитал <w>слоняться</w> по бульварам, а не искать новую работу.",
                                "de": "Er zog es vor, auf den Boulevards zu <w>bummeln</w>, statt eine neue Stelle zu suchen.",
                                "es": "Prefería <w>callejear</w> por los bulevares antes que buscar un nuevo empleo.",
                                "zh": "他宁愿在林荫大道上<w>闲逛</w>，也不愿去找新工作。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "argot ancien"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To idle around or waste time, or work in a careless, lazy way.",
                        "ru": "Бездельничать, терять время или работать лениво и небрежно.",
                        "de": "Ziellos herumschlendern, Zeit verschwenden oder nachlässig und faul arbeiten.",
                        "es": "Pasear sin rumbo, perder el tiempo o trabajar de forma perezosa y descuidada.",
                        "zh": "无所事事地闲逛，浪费时间，或懒散、马虎地干活。"
                    },
