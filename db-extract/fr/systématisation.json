                "forms": [
                    {
                        "form_id": "572abff8-242f-4e2d-bcb5-7a811f13f55d",
                        "entry_id": "a7eaf926-ffbb-3df1-90e9-4b3eee71321c",
                        "tags": [
                            "plural"
                        ],
                        "form": "systématisations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5f0c1e1e-40c7-39f2-b09e-5384e07d7962",
                        "entry_id": "a7eaf926-ffbb-3df1-90e9-4b3eee71321c",
                        "glosses": [
                            "Action de systématiser, de rendre systématique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a92843d9-c375-4ebf-b5ee-e6bdb1c9d7e9",
                                "sense_id": "5f0c1e1e-40c7-39f2-b09e-5384e07d7962",
                                "text": "La systématisation de la vaccination."
                            },
                            {
                                "example_id": "d01f0231-b6f8-4d70-9266-b122448ccdb2",
                                "sense_id": "5f0c1e1e-40c7-39f2-b09e-5384e07d7962",
                                "text": "Avec la systématisation des descriptions nomenclaturelles, seules les secondes listes pourraient être conservées."
                            }
                        ]
                    },
                    {
                        "sense_id": "f4477def-6265-3079-ae5a-8670138b34bd",
                        "entry_id": "a7eaf926-ffbb-3df1-90e9-4b3eee71321c",
                        "glosses": [
                            "Instauration en tant que système."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e37ba94-4e8b-41e7-87a6-d3944a9f7880",
                                "sense_id": "f4477def-6265-3079-ae5a-8670138b34bd",
                                "text": "La doctrine médicale de l’Ayurvéda est un pur dogmatisme ; elle est toute entière en théories, dont le dogmes, clairs et précis, se tiennent et se relient, et par leur solidarité composent un corps aussi nettement circonscrit que celui de la systématisation galénique."
                            }
                        ]
                    },
                    {
                        "sense_id": "daf4f392-ae5f-3dd3-af80-31f14f540af0",
                        "entry_id": "a7eaf926-ffbb-3df1-90e9-4b3eee71321c",
                        "glosses": [
                            "Organisation anatomique en segments constituant un ensemble cohérent selon un ordre déterminé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9024cfec-d242-411f-8d26-9e8042ce94c3",
                                "sense_id": "daf4f392-ae5f-3dd3-af80-31f14f540af0",
                                "text": "Les bronches lobaires se divisent en bronches segmentaires correspondant à la systématisation du parenchyme pulmonaire."
                            },
                            {
                                "example_id": "bd605c25-2e9f-4988-824d-89d6b196647c",
                                "sense_id": "daf4f392-ae5f-3dd3-af80-31f14f540af0",
                                "text": "La systématisation du plexus brachial est la répartition des axones à partir des racines dans les nerfs périphériques et terminaux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95ba4b25-3e69-4a59-baab-b8fdbc2c7c22",
                        "source_entry_id": "a7eaf926-ffbb-3df1-90e9-4b3eee71321c",
