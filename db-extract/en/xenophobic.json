                    },
                    {
                        "translation_id": "1cd600f1-5ce6-4640-a8fe-1134a1493a2e",
                        "source_entry_id": "f191ac42-d6ef-32a4-b4f2-ce71874b1862",
                        "source_sense_id": "70e33731-26fd-3068-8030-037523903bd8",
                        "source_sense_description": "exhibiting or characterised by xenophobia",
                        "target_lang_word": "xenophob",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "xenophob",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db473d72-e85d-3951-afeb-f06039f26f64",
                                        "entry_id": "fe09c409-764a-3c14-9aa1-205898e0d46a",
                                        "glosses": [
                                            "feindlich gegenüber Fremden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "575aaeb2-e61d-48c0-a2b1-4eeae66ffc1b",
                                                "sense_id": "db473d72-e85d-3951-afeb-f06039f26f64",
                                                "text": "Ich verbitte mir diesen derart xenophoben Unterton in deinen Fragen!"
                                            },
                                            {
                                                "example_id": "040352c9-38b1-4ade-8958-8c03b962a926",
                                                "sense_id": "db473d72-e85d-3951-afeb-f06039f26f64",
                                                "text": "„Es scheint daher begrüßenswert, wenn die Diskussion über das Vordringen des Englischen unter derartigen Auspizien geführt und auch öffentlich geführt wird, zumal solange dies - wie in den großen Tages- und Wochenzeitungen bisher geschehen - besonnen und ohne allzu starke xenophobe Mißtöne geschieht.“"
                                            },
                                            {
                                                "example_id": "30ae2b89-24a9-4b9a-8f16-62fd6445053e",
                                                "sense_id": "db473d72-e85d-3951-afeb-f06039f26f64",
                                                "text": "[Die] xenophobe Grundhaltung [der griechischen Medien] zeige sich in Schlagzeilen wie: \"Merkel will uns plattmachen\", \"Schäuble der Menschenverachter\", \"Lagarde, die vorgab uns zu helfen, durchgeknallt\"."
                                            },
                                            {
                                                "example_id": "4943f59b-c4c9-403d-84f2-f872ce893ec8",
                                                "sense_id": "db473d72-e85d-3951-afeb-f06039f26f64",
                                                "text": "Tatsächlich führen die ungarische Regierung und die Regierungspartei Fidesz seit Monaten eine Anti-Flüchtlings- und Anti-Einwanderungskampagne mit deutlichen xenophoben Akzenten."
                                            },
                                            {
                                                "example_id": "1d8f9246-4557-4246-b0ae-ad9f74fecd00",
                                                "sense_id": "db473d72-e85d-3951-afeb-f06039f26f64",
                                                "text": "„Der anolanische Roman ist ein anarchischer und multikultureller Mischmasch, ein künstlerisches Produkt, das so selbstbezogen, inzestuös und hausgemacht ist wie alles andere im isolierten und xenophoben Angola.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
