                    },
                    {
                        "translation_id": "c5e2c99e-aff6-47dc-8a7e-f32af18372f4",
                        "source_entry_id": "b4ecb540-59c8-311b-9041-0baac07ff943",
                        "source_sense_id": "b4150867-3398-37ef-9458-4e0d8a17979c",
                        "target_lang_word": "stammerer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stammerer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "122ec1d9-3650-3ecc-baa1-bd16657c8bf4",
                                        "entry_id": "18523066-30eb-32f2-803b-c9f22ba0f9a5",
                                        "glosses": [
                                            "One who stammers; a stutterer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75685239-cf65-4355-b21e-5e0cac1b04d5",
                                                "sense_id": "122ec1d9-3650-3ecc-baa1-bd16657c8bf4",
                                                "text": "Marry—as the friendly vapour ascended, how his prattle would curl up sometimes with it! the ligaments, which tongue-tied him, were loosened, and the stammerer proceeded a statist!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e3b620b-daf7-4f60-8174-e6baed893245",
                        "source_entry_id": "b4ecb540-59c8-311b-9041-0baac07ff943",
                        "source_sense_id": "b4150867-3398-37ef-9458-4e0d8a17979c",
                        "target_lang_word": "Stotterer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stotterer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7de7d92-57e0-3b49-9593-6c3fb8c95b31",
                                        "entry_id": "d38fece0-13bb-3b2c-b3d2-8e133e0bdc6d",
                                        "glosses": [
                                            "Person, die stottert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84a1a8e5-52d5-4362-bba5-bddc95714a95",
                                                "sense_id": "c7de7d92-57e0-3b49-9593-6c3fb8c95b31",
                                                "text": "„Nun hatte der Stotterer Reinhold, Franzens wirklicher Freund, schon wieder eine Freundin, die Cilly hieß oder jedenfalls behauptete, so zu heißen.“"
                                            },
                                            {
                                                "example_id": "97d08245-1bbe-4033-85ab-bc50168491c1",
                                                "sense_id": "c7de7d92-57e0-3b49-9593-6c3fb8c95b31",
                                                "text": "„Es gibt die Geschichte von dem Stotterer, der von Frankfurt nach München umzieht.“"
                                            },
                                            {
                                                "example_id": "fa278f4f-746b-4e4c-9863-42c063ea14ca",
                                                "sense_id": "c7de7d92-57e0-3b49-9593-6c3fb8c95b31",
                                                "text": "„Ein Glatzkopf und ein Stotterer begegnen sich auf der Straße."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1507f188-4208-4847-af83-605a7ce43be7",
                        "source_entry_id": "b4ecb540-59c8-311b-9041-0baac07ff943",
                        "source_sense_id": "b4150867-3398-37ef-9458-4e0d8a17979c",
                        "target_lang_word": "Stotterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stotterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "892c6c3a-2539-3fc2-9b37-61e8ba404825",
                                        "entry_id": "f45eabaa-eb19-3491-a75d-acba2e209dc6",
                                        "glosses": [
                                            "stotternde Frau bzw. stotterndes Mädchen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "515b72b8-3b38-4010-b76a-5056560cbbec",
                                                "sense_id": "892c6c3a-2539-3fc2-9b37-61e8ba404825",
                                                "text": "„Ich zahlte nicht nur ihr einen Schnaps, sondern auch der Stotterin und sogar ihrer anderen Nachbarin, die als Frieda Kniefall angesprochen wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
