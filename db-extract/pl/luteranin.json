                ],
                "senses": [
                    {
                        "sense_id": "78e88163-90e9-360c-8c73-823c56339e02",
                        "entry_id": "51294a1a-d14a-3ed4-b98e-f4f13a4d807a",
                        "glosses": [
                            "osoba, która wyznaje luteranizm"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b59662c-80c4-4953-852a-cf2b2e5e951c",
                        "source_entry_id": "51294a1a-d14a-3ed4-b98e-f4f13a4d807a",
                        "source_sense_id": "78e88163-90e9-360c-8c73-823c56339e02",
                        "target_lang_word": "Lutheran",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lutheran",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d58b5e8d-a019-3d85-a24d-43b8dd298015",
                                        "entry_id": "5b75509c-9b8b-348c-9898-fe38e7780807",
                                        "glosses": [
                                            "Of or pertaining to the theology of Martin Luther (1483–1546) or his followers, or the Lutheran church."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "332564c9-8798-48e3-ac7e-0cc2e1450a6f",
                                                "sense_id": "d58b5e8d-a019-3d85-a24d-43b8dd298015",
                                                "text": "A Lutheran understanding of the Lord’s Supper is not the same as that of other denominations."
                                            },
                                            {
                                                "example_id": "f716ca50-e156-4d04-bac7-24a849163bb4",
                                                "sense_id": "d58b5e8d-a019-3d85-a24d-43b8dd298015",
                                                "text": "[I]f when Luther firſt began to teach new doctrine, the catholiks at that time had not vouchſafed to giue him the hering, but had auoided his prechings & preuy couenticles, ther had not bin now in the worlde, either Lutheran, Swinglian, Calueniſt, Puritan, Anabaptiſt, Trinetarie, Family of loue, Adamite, or the lyke: whereof now there are ſo many thouſands abroad, al ſpringing of that firſt ſecte, and troubling at this day the whole worlde, […]"
                                            },
                                            {
                                                "example_id": "c172b533-9a82-453f-8527-96c99e9e3c0a",
                                                "sense_id": "d58b5e8d-a019-3d85-a24d-43b8dd298015",
                                                "text": "On the borders of that river [the Volga] 104 colonies have ſettled, conſiſting of Germans, who emigrated to thoſe parts in the years of dearth and famine. Theſe colonies have already three Calviniſt, and four Lutheran ministers."
                                            },
                                            {
                                                "example_id": "53282db3-b265-4f3c-a815-5cf8d9f43393",
                                                "sense_id": "d58b5e8d-a019-3d85-a24d-43b8dd298015",
                                                "text": "[A] number of Lutheran priests were involved in the activities of the EHS [Estonian Heritage Society]. The EELC [Estonian Evangelical Lutheran Church] identified itself again as 'the people's church' and stressed the connection between the Lutheran Church and Estonian national identity, although the alleged connection with radical nationalism is an exaggeration."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Lutheran",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5db15064-c419-3f85-8dea-8d256226e92a",
                                        "entry_id": "8690541b-66be-3f76-b655-9660c64f30d7",
                                        "glosses": [
                                            "A member of any of the Christian churches which identify with the theology of Martin Luther."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d30970a-d056-42e4-9bd2-7d7f04ff8e39",
                                                "sense_id": "5db15064-c419-3f85-8dea-8d256226e92a",
                                                "text": "The split between the Lutherans and the Roman Catholics began with the Edict of Worms in 1521."
                                            },
                                            {
                                                "example_id": "24a01358-6b3f-48ed-b8c4-9ca7bf0a4d54",
                                                "sense_id": "5db15064-c419-3f85-8dea-8d256226e92a",
                                                "text": "[I]f you had bene but ſo conuerſante in Caluine [John Calvin] as your profeſsion requireth, you could not ſo far haue bene ouerſeene in this eaſie diſtinction knowen to Catholike, Lutheran and Zuinglian, although when Caluine wrote thus, perhaps he was more then halfe a Lutheran, and not ſo far gone in Zuinglianiſme as after."
                                            },
                                            {
                                                "example_id": "f461258c-0c8e-43e3-9a3b-8718b058db14",
                                                "sense_id": "5db15064-c419-3f85-8dea-8d256226e92a",
                                                "text": "[…] George of Mecklenburg, a younger brother of the reigning Duke, an active and ambitious Prince, collected a conſiderable number of thoſe ſoldiers of fortune who had accompanied Henry of Brunſwick in all his wild enterprizes; and though a zealous Lutheran himſelf, invaded the territories of the Magdeburgers, hoping that, by the merit of this ſervice, he might procure ſome part of their domains to be allotted to him as an eſtabliſhment."
                                            },
                                            {
                                                "example_id": "4cf85a6a-6127-48a0-a64e-0255a86af6a4",
                                                "sense_id": "5db15064-c419-3f85-8dea-8d256226e92a",
                                                "text": "At this memorable Diet of Speyer (1529), a compact Roman Catholic majority faced a weak Lutheran minority. The Emperor, through his commissioners, declared at the outset that he abolished, \"by his imperial and absolute authority (Machtvollkommenheit),\" the clause in the ordinance of 1526 on which the Lutherans had relied when they founded their territorial Churches; it had been the cause, he said, \"of much ill counsel and misundestanding.\" […] It was this ordinance which called forth the celebrated Protest, from which comes the name Protestant. The Protest was read in the Diet on the day (April 19th, 1529) when all concessions to the Lutherans had been refused."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "310206ff-2b52-4888-8e3e-d8e43ccee1b2",
                        "source_entry_id": "51294a1a-d14a-3ed4-b98e-f4f13a4d807a",
                        "source_sense_id": "78e88163-90e9-360c-8c73-823c56339e02",
                        "target_lang_word": "luterano",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luterano",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "efe10582-9e70-36e1-aab5-b490decf7511",
                                        "entry_id": "1cd661d2-dbe6-3c72-9b08-c5869085adfa",
                                        "glosses": [
                                            "Que pertenece o concierne al religioso protestante Martín Lutero o el luteranismo."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59aacfd4-6e4d-40e9-a013-89bd910e6514",
                                                "sense_id": "efe10582-9e70-36e1-aab5-b490decf7511",
                                                "text": "En el séptimo los libros luteranos que se abrasan sobre un altar y unas letras que dicen."
                                            },
                                            {
                                                "example_id": "b7ec706a-b936-4277-bb44-25a45c9a4928",
                                                "sense_id": "efe10582-9e70-36e1-aab5-b490decf7511",
                                                "text": "hubo bala tan desmandada que estando en la iglesia mayor haciendo sus oraciones luteranas, entró y, se barrió las piernas de seis que estaban sentados en un banco."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "920f4d44-b5f5-3b70-8eaf-845e2b22be82",
                                        "entry_id": "1cd661d2-dbe6-3c72-9b08-c5869085adfa",
                                        "glosses": [
                                            "Seguidor del luteranismo."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b844933-c892-4a8f-acdb-899760336f87",
                                                "sense_id": "920f4d44-b5f5-3b70-8eaf-845e2b22be82",
                                                "text": "Antes, vosotros recebistes en vuestro ejército los luteranos que se vinieron huyendo de Alemaña, y con ellos hicistes guerra al Emperador."
                                            },
                                            {
                                                "example_id": "33588642-b511-40ef-9835-df2e71952bb9",
                                                "sense_id": "920f4d44-b5f5-3b70-8eaf-845e2b22be82",
                                                "text": "La herejía era el rejalgar que, una vez en la entraña, daba al traste con la más firme entereza, y, según él, ya el tósigo estaba en parte sorbido. Valladolid era un foco de luteranos. Salamanca, un seminario de herejes."
                                            },
                                            {
                                                "example_id": "fbc87cc3-0c81-4e6f-b5b1-57108fc38130",
                                                "sense_id": "920f4d44-b5f5-3b70-8eaf-845e2b22be82",
                                                "text": "En España se persiguió la doctrina de los hebreos, como se persiguió la de los luteranos o calvinistas. Y se persiguió por ser, todo eso, herejía."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec7be443-0a06-4c77-ba52-33db21597aed",
