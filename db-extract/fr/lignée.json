                        "cross_references": [
                            {
                                "target_word": "Sippe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a1db9d3-4ceb-3358-babe-ff565cd2eb32",
                                        "entry_id": "90fde6b5-c7eb-3b75-8400-1d00ce34f5cb",
                                        "glosses": [
                                            "Gruppe von Menschen mit gemeinsamer Abstammung, die unter anderem durch Bräuche miteinander verbunden sind"
                                        ],
                                        "tags": [
                                            "Völkerkunde"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6f12ef4-b9d3-43f9-98ea-064853f81a09",
                                                "sense_id": "8a1db9d3-4ceb-3358-babe-ff565cd2eb32",
                                                "text": "„Diese Kurzfassung des Familienstammbaums beschreibt nur einen Teil der Sippe.“"
                                            },
                                            {
                                                "example_id": "bd8ce069-d2a1-40ee-88cf-d6762925c1e7",
                                                "sense_id": "8a1db9d3-4ceb-3358-babe-ff565cd2eb32",
                                                "text": "„Drinnen wurde es totenstill, die vollständig versammelte Sippe erstarrte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "29d16b66-4a09-3f27-9535-3b8e9bb67df4",
                                        "entry_id": "90fde6b5-c7eb-3b75-8400-1d00ce34f5cb",
                                        "glosses": [
                                            "Mitglieder der Familie oder der Verwandtschaft"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aacf788f-0270-47f7-82b0-ead8bad8f175",
                                                "sense_id": "29d16b66-4a09-3f27-9535-3b8e9bb67df4",
                                                "text": "Mit deiner Sippe will ich nichts zu tun haben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d021a190-a202-338e-9b8f-25d4b08a7b05",
                                        "entry_id": "90fde6b5-c7eb-3b75-8400-1d00ce34f5cb",
                                        "glosses": [
                                            "Gruppe von Tieren oder Pflanzen mit der gleichen Abstammung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c0ba722-6304-42ef-aeda-735df02c29d2",
                                                "sense_id": "d021a190-a202-338e-9b8f-25d4b08a7b05",
                                                "text": "In der Sippe der Fichten sind die Pflanzen sich sehr ähnlich."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2a800b3-52fc-40a6-8c1b-20896b7d49ba",
                        "source_entry_id": "a6af3e01-1273-348e-a37b-8d4532d5895f",
