                        "entry_id": "0403dc74-33b1-3010-b389-f8f9c6d4c4ad",
                        "glosses": [
                            "Dénomination française des divisions administratives territoriales de certains pays d’Europe centrale, notamment en Hongrie (megye), Slovaquie (župe, kraj), Croatie (županija), Bosnie-Herzégovine (županija), Roumanie (comitat)."
                        ],
                        "tags": [
                            "Toponymie"
                        ],
                        "examples": [
                            {
                                "example_id": "ac46507a-9957-4bc3-bd14-4c7e8515ba4b",
                                "sense_id": "6f40aea5-23a6-3337-aea1-2aa6fcafc348",
                                "text": "Ce système orographique appartenait à la portion la plus sauvage de la Transylvanie, comprise sous la dénomination de comitat de Klausenburg ou Kolosvar."
                            }
                        ]
                    }
                ],
                "translations": [
