            {
                "entry_id": "6fe99c5c-2506-32f1-8451-e25fb2db9a57",
                "word": "méthodiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "aabe07e8-48a9-45b4-a070-9547019abd5c",
                        "entry_id": "6fe99c5c-2506-32f1-8451-e25fb2db9a57",
                        "tags": [
