                "senses": [
                    {
                        "sense_id": "5d6563e9-d0b1-3318-ad17-e757e704aeb5",
                        "entry_id": "052f40b5-9bba-3bcc-b87c-e19c78a8127a",
                        "glosses": [
                            "Insel in der Nordsee"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "d4980eed-9a82-4981-a0b4-4f6b42b70129",
                                "sense_id": "5d6563e9-d0b1-3318-ad17-e757e704aeb5",
                                "text": "Auf einigen Nordseeinseln leben die Angehörigen des friesischen Volkes."
                            },
                            {
                                "example_id": "c6622fa4-3493-4dcb-9507-cc6ca27175b5",
                                "sense_id": "5d6563e9-d0b1-3318-ad17-e757e704aeb5",
                                "text": "„Wir waren auf der Nordseeinsel Juist, und weil ich so tapfer war, durfte ich danach einen riesigen Kiwi-Eisbecher essen.“"
                            },
                            {
                                "example_id": "382f5d69-026f-4cd2-ac16-a52a2f5864c8",
                                "sense_id": "5d6563e9-d0b1-3318-ad17-e757e704aeb5",
                                "text": "„Ein festgefahrenes Küstenmotorschiff hat die Hafeneinfahrt von Wangerooge blockiert und damit den Schiffsverkehr von und zu der Nordseeinsel zum Stillstand gebracht.“"
                            },
                            {
                                "example_id": "4098740f-2f35-4c45-a797-6503a53f0e35",
                                "sense_id": "5d6563e9-d0b1-3318-ad17-e757e704aeb5",
                                "text": "„Wattwanderungen zwischen den Nordseeinseln Amrum und Föhr sind beliebt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
