                        "source_entry_id": "9338de24-2a53-330c-9197-c8bf15f9f8ff",
                        "source_sense_id": "899169ff-0929-37f0-b544-9e1dfaa889c0",
                        "target_lang_word": "guilt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guilt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4aaeb917-7e74-32d4-9dbf-b593ce8be590",
                                        "entry_id": "560bce81-56e2-3498-a422-54f8cb0c67c8",
                                        "glosses": [
                                            "Responsibility for wrongdoing."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a52bef39-b483-378d-a9b4-2e994ff1a168",
                                        "entry_id": "560bce81-56e2-3498-a422-54f8cb0c67c8",
                                        "glosses": [
                                            "The state of having been found guilty or admitted guilt in legal proceedings."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "69942f52-4389-32de-b0df-2678133404d1",
                                        "entry_id": "560bce81-56e2-3498-a422-54f8cb0c67c8",
                                        "glosses": [
                                            "Regret for having done wrong."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04738664-18ec-4515-80f6-edfb666fe259",
                                                "sense_id": "69942f52-4389-32de-b0df-2678133404d1",
                                                "text": "Appropriate guilt is experienced when we actually do something objectively wrong—for example, exploit another, betray a trust, and so on. […] Inappropriate guilt occurs from believing a lie and is resolved by an application of the truth."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "guilt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5f28348-c4dd-330b-81ff-cdd9a59c6733",
                                        "entry_id": "1aaf7334-1d9a-30ae-9ca1-2e54fc735a34",
                                        "glosses": [
                                            "To commit offenses; act criminally."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "guilt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0de15d55-1e58-3cfb-91f7-98121cc198df",
                                        "entry_id": "70417820-1ca7-30a9-a317-23f7000d3f2f",
                                        "glosses": [
                                            "To cause someone to feel guilt, particularly in order to influence their behaviour."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e014116a-5b7c-4fe7-8fe1-cf7ec156deeb",
                                                "sense_id": "0de15d55-1e58-3cfb-91f7-98121cc198df",
                                                "text": "He didn't want to do it, but his wife guilted him into it."
                                            },
                                            {
                                                "example_id": "56079386-ecee-4a22-beb4-9b170f2c05b8",
                                                "sense_id": "0de15d55-1e58-3cfb-91f7-98121cc198df",
                                                "text": "Shame based parents would have guilted him for expressing anger."
                                            },
                                            {
                                                "example_id": "8cf1e8b0-4d35-458b-9143-49e7f8d584dd",
                                                "sense_id": "0de15d55-1e58-3cfb-91f7-98121cc198df",
                                                "text": "We don't have to be manipulated, guilted, coerced, or forced into anything."
                                            },
                                            {
                                                "example_id": "f7e24e67-6540-4646-afe8-20165814299a",
                                                "sense_id": "0de15d55-1e58-3cfb-91f7-98121cc198df",
                                                "text": "But I won't be threatened or bribed or guilted into giving up something that's important to me."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "guilt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9595bba-d375-391c-99fc-9d03cfa81f65",
                                        "entry_id": "dc1f60d1-3af3-369b-8a28-6bdce2c69515",
                                        "glosses": [
                                            "Obsolete form of gilt (“gilded”)"
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09e69c3c-b3f4-47df-bedf-b7fd6da3f282",
                                                "sense_id": "a9595bba-d375-391c-99fc-9d03cfa81f65",
                                                "text": "Two silver monteths, two large fflaggons, two large tankards, two silver salvers, a voyder and a knyfe, two silver salts, two guilt bolls of the like size, one other boll, three silver bolls, in all 24 pieces guilt and unguilt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
