            {
                "entry_id": "a9f8f090-8130-308d-8953-154b21912a37",
                "word": "laminated",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5c73d45d-4c1c-361b-ba97-8648cc51adc2",
                        "entry_id": "a9f8f090-8130-308d-8953-154b21912a37",
                        "glosses": [
                            "Made by lamination."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "96dde0c9-398b-4818-9bd7-c573be874d4a",
                                "sense_id": "5c73d45d-4c1c-361b-ba97-8648cc51adc2",
                                "text": "The accident was also one of several since Clapham [...] that demonstrated the role of breakable windows in the death toll. RSSB research would later confirm and reinforce the need for laminated glass to protect passengers and increase survivability."
                            }
                        ]
                    },
                    {
                        "sense_id": "3214691f-a788-3dda-bf7d-1ccc23e49c95",
                        "entry_id": "a9f8f090-8130-308d-8953-154b21912a37",
                        "glosses": [
                            "Consisting of many thin layers."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8ec870e0-1a74-44f9-93c8-f2fe1c924c1b",
                                "sense_id": "3214691f-a788-3dda-bf7d-1ccc23e49c95",
                                "text": "A laminated arch is a timber arch made of layers of bent planks secured by treenails."
                            },
                            {
                                "example_id": "73b340ce-a0e7-488b-a7e4-22717528906a",
                                "sense_id": "3214691f-a788-3dda-bf7d-1ccc23e49c95",
                                "text": "All springs for the engine and tender are of the laminated type with plates of carbon steel, which are secured in the spring buckles by a vertical centre rivet."
                            },
                            {
                                "example_id": "dbd8784b-d06d-48a6-ae35-7e16d0ec153e",
                                "sense_id": "3214691f-a788-3dda-bf7d-1ccc23e49c95",
                                "text": "In general, steel springs were stipulated for primary suspension, although rubber was accepted for auxiliary springing; hydraulic dampers were specified and the use of laminated springs ruled out."
                            }
                        ]
                    },
                    {
                        "sense_id": "896b8a0f-e89d-38bb-a051-a377a94dea29",
                        "entry_id": "a9f8f090-8130-308d-8953-154b21912a37",
                        "glosses": [
                            "Splitting into thin layers parallel to bedding."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ee8b8d8b-90ad-4953-a3bf-d16d8a6cf3df",
                                "sense_id": "896b8a0f-e89d-38bb-a051-a377a94dea29",
                                "text": "Shale is laminated."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c519801d-dcd9-4853-846b-50b6a8ae0925",
                        "source_entry_id": "a9f8f090-8130-308d-8953-154b21912a37",
                        "source_sense_description": "made by lamination",
                        "target_lang_word": "laminé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laminé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ab5cda2-a28c-3186-9840-054b7f40dac3",
                                        "entry_id": "415b330d-f001-35f5-8183-ede8a336d2cd",
                                        "glosses": [
                                            "Qui a été laminé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0ad5573-b4c2-4523-aa26-b961a67d93b6",
                                                "sense_id": "8ab5cda2-a28c-3186-9840-054b7f40dac3",
                                                "text": "Or laminé."
                                            },
                                            {
                                                "example_id": "e79182f2-14b8-481e-8684-3c809b1f94a0",
                                                "sense_id": "8ab5cda2-a28c-3186-9840-054b7f40dac3",
                                                "text": "En charpente métallique, une poutrelle désigne un produit sidérurgique en acier laminé à chaud ayant une forme de I ou de H."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "laminé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fb01f09a-76ac-3dcb-a514-7bb34b0c712c",
                                        "entry_id": "365e2748-6d4b-3ea1-ac4b-d04918a98bb7",
                                        "glosses": [
                                            "Produit issu du laminage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56143c16-cf48-4cbe-833e-fc9dd8d3f066",
                                                "sense_id": "fb01f09a-76ac-3dcb-a514-7bb34b0c712c",
                                                "text": "Il existe deux grandes classes de laminés : les demi-produits et les produits finis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc257747-57f1-3594-9438-b7cdf729af99",
                                        "entry_id": "365e2748-6d4b-3ea1-ac4b-d04918a98bb7",
                                        "glosses": [
                                            "Parquet flottant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "095239bd-6098-4536-ac6b-beb18e6e4bd1",
                                                "sense_id": "dc257747-57f1-3594-9438-b7cdf729af99",
                                                "text": "Le laminé est un parquet destiné à être posé, le plus souvent sur un matériau préexistant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "laminé",
                                "target_lang_code": "fr",
                                "target_senses": [
