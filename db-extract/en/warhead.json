                    {
                        "translation_id": "89c59e4c-df5d-4244-b6ae-2dcfc44bda8b",
                        "source_entry_id": "2ea70501-b57f-36be-8685-25e61bc6ea13",
                        "source_sense_description": "part of a missile, projectile, torpedo, rocket, or other munition",
                        "target_lang_word": "Sprengkopf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprengkopf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e35187e-2452-3af9-954d-9cff0887adce",
                                        "entry_id": "b02e6f46-8480-3c9f-b0fa-6b4e4c64a023",
                                        "glosses": [
                                            "Teil einer komplexen Explosionswaffe, welcher die Sprengladung enthält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6472c6f8-6a20-4260-aba6-f746f188c9e4",
                                                "sense_id": "7e35187e-2452-3af9-954d-9cff0887adce",
                                                "text": "Fernlenkraketen und Torpedos bestehen im Wesentlichen aus einem Sprengkopf und einem Trägersystem zur Steuerung."
                                            },
                                            {
                                                "example_id": "be07ee7b-8cdd-4179-8fea-e73b8dd39157",
                                                "sense_id": "7e35187e-2452-3af9-954d-9cff0887adce",
                                                "text": "„Nach Aussagen eines westlichen Geheimdienstbeamten besitzt Russland mindestens 64 der neuen Marschflugkörper, die auch mit einem atomaren Sprengkopf bestückt werden können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99ac813b-2af8-4b20-9894-86d44d12808e",
                        "source_entry_id": "2ea70501-b57f-36be-8685-25e61bc6ea13",
                        "source_sense_description": "part of a missile, projectile, torpedo, rocket, or other munition",
                        "target_lang_word": "Gefechtskopf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gefechtskopf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a153a74b-34f9-3ae0-b398-ed8d30352252",
                                        "entry_id": "64862d7c-18bc-3fc5-8270-b63cd57fb941",
                                        "glosses": [
                                            "Teil einer komplexen Explosionswaffe, welcher die Sprengladung und den Zünder enthält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa781414-f093-40a8-9d9c-f5006696e1dc",
                                                "sense_id": "a153a74b-34f9-3ae0-b398-ed8d30352252",
                                                "text": "„Dabei ist bei kleineren Flugkörpern der Gefechtskopf gehärtet, um ein Eindringen in den zumeist ebenfalls gehärteten Schiffsrumpf zu gewährleisten.“"
                                            },
                                            {
                                                "example_id": "58782da4-f14a-4227-8a1e-ad873c2ffa37",
                                                "sense_id": "a153a74b-34f9-3ae0-b398-ed8d30352252",
                                                "text": "„Sie war bereits im Anflug für den letzten, finalen Schlag, hatte den Gefechtskopf eines Torpedos schon scharf gemacht und zielte auf den Bereich des Triganon, in welchem sich die Brücke befand.“"
                                            },
                                            {
                                                "example_id": "186e5f04-d853-4bb7-9a1d-d8cdf638bee7",
                                                "sense_id": "a153a74b-34f9-3ae0-b398-ed8d30352252",
                                                "text": "„Die neuere al-Hussein-Rakete dürfte eine Reichweite von etwa 650 Kilometern gehabt haben, über die sie einen Gefechtskopf von 500 Kilogramm transportieren konnte – allerdings mit einer Zielgenauigkeit von höchstens 1,3 Kilometern.“"
                                            },
                                            {
                                                "example_id": "95bf0891-8c15-4fac-9bfe-b02a575c3595",
                                                "sense_id": "a153a74b-34f9-3ae0-b398-ed8d30352252",
                                                "text": "„Der Gefechtskopf würde voraussichtlich das ganze Triebwerk samt Verkleidung und Aufhängung herausreißen und mit ein bißchen Glück die Tragfläche abbrechen lassen.“"
                                            },
                                            {
                                                "example_id": "6112fbbf-b3cf-4b31-8e6d-69df77569396",
                                                "sense_id": "a153a74b-34f9-3ae0-b398-ed8d30352252",
                                                "text": "„Er stellte den Gefechtskopf mit einem Schieber am Griff auf zehn Tonnen, visierte kurz und wartete auf den Feuerbefehl.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
