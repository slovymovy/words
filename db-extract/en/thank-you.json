                                "target_senses": [
                                    {
                                        "sense_id": "2e40d340-8184-3aaa-9369-87c9e782eb79",
                                        "entry_id": "665bd4fa-8eeb-3384-b4ac-8f743ed2c56a",
                                        "glosses": [
                                            "dankzegging"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90683766-4c83-41ad-92a0-ce58c2ea9759",
                                                "sense_id": "2e40d340-8184-3aaa-9369-87c9e782eb79",
                                                "text": "Op secretaressedag kregen de secretaresses van de Minister-President bloemen als bedankje voor hun goede zorgen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c6345e9-b847-3f22-b5e6-355b88c12e3c",
                                        "entry_id": "665bd4fa-8eeb-3384-b4ac-8f743ed2c56a",
                                        "glosses": [
                                            "afzegging"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2ca7efc-8ed5-4b01-8189-a7ef7b0dc1f3",
                                                "sense_id": "6c6345e9-b847-3f22-b5e6-355b88c12e3c",
                                                "text": "Ik ontving een bedankje van Piet, hij kon vanavond niet op het feest komen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b741dce-ddb9-4e4c-8342-b4515568118b",
                        "source_entry_id": "d51c4161-9c39-3d3d-bc37-d3fe20189e64",
                        "source_sense_description": "Translations",
                        "target_lang_word": "remerciement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "remerciement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5dc2b1ec-ad37-37a0-b21f-32566d7548fe",
                                        "entry_id": "c1c01619-8cc0-37dd-b305-ae5fd4410fc2",
                                        "glosses": [
                                            "Action de remercier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "195fed3c-c3d7-4dc0-84a5-e792464a3cc1",
                                                "sense_id": "5dc2b1ec-ad37-37a0-b21f-32566d7548fe",
                                                "text": "En ouvrant la séance, M. Hibon, président sortant, adresse ses remerciements pour le grand honneur, qui, dit-il, fut fait à un amateur de présider les travaux de la Société en 1936, puis il prie M. Allorge de lui succéder au fauteuil présidentiel."
                                            },
                                            {
                                                "example_id": "1f7f0664-8adf-4878-adb9-4cf70ad15d3e",
                                                "sense_id": "5dc2b1ec-ad37-37a0-b21f-32566d7548fe",
                                                "text": "S'il n'est pas toujours aisé de formuler un remerciement, il n'est pas non plus toujours facile d'en recevoir un."
                                            },
                                            {
                                                "example_id": "0048ed13-585d-470a-a9fc-46e12149c7c8",
                                                "sense_id": "5dc2b1ec-ad37-37a0-b21f-32566d7548fe",
                                                "text": "Je vous fais mes remerciements de ce que vous nous avez accordé cela, pour ce que vous nous avez accordé."
                                            },
                                            {
                                                "example_id": "efdc86dc-6cba-4b2d-8fcd-65b782a9fe4c",
                                                "sense_id": "5dc2b1ec-ad37-37a0-b21f-32566d7548fe",
                                                "text": "Je vous en fais mes remerciements."
                                            },
                                            {
                                                "example_id": "89c90e0e-0af9-48c5-8ea2-aba176205b23",
                                                "sense_id": "5dc2b1ec-ad37-37a0-b21f-32566d7548fe",
                                                "text": "Je vous dois des remerciements pour les soins que vous avez pris de mon affaire."
                                            },
                                            {
                                                "example_id": "8fdefeb4-3254-4e7a-847f-1dd675b89fac",
                                                "sense_id": "5dc2b1ec-ad37-37a0-b21f-32566d7548fe",
                                                "text": "De très humbles remerciements."
                                            },
                                            {
                                                "example_id": "f9ae2388-8ec0-4c92-8432-f0260b40fe5c",
                                                "sense_id": "5dc2b1ec-ad37-37a0-b21f-32566d7548fe",
                                                "text": "Je vous réitère, je vous renouvelle mes remerciements."
                                            },
                                            {
                                                "example_id": "7f2d2abf-85e3-49e6-8cb3-08b918d2ccc0",
                                                "sense_id": "5dc2b1ec-ad37-37a0-b21f-32566d7548fe",
                                                "text": "Discours de remerciement."
                                            },
                                            {
                                                "example_id": "643ee489-54e0-4e2d-ac7c-5eb88a6d70d8",
                                                "sense_id": "5dc2b1ec-ad37-37a0-b21f-32566d7548fe",
                                                "text": "Un remerciement tout particulier va aux douzes militants qui ont participé aux interviews en profondeur et qui, ce qui n’est pas toujours facile, m’ont raconté leur vies de longues heures durant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d3e0d14-3436-3eaf-a882-8ff63de81ab8",
                                        "entry_id": "c1c01619-8cc0-37dd-b305-ae5fd4410fc2",
                                        "glosses": [
                                            "Manière de remercier, ce qui sert à remercier, actes, paroles, lettre etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6913990-ec68-49ef-aa83-279dfe3667fe",
                                                "sense_id": "3d3e0d14-3436-3eaf-a882-8ff63de81ab8",
                                                "text": "Les remerciements arrivent , sur un papier à en-tête d'un groupement ésotérique, rendu moins inquiétant par la formule bénédictine : PAX ajoutée à la plume."
                                            },
                                            {
                                                "example_id": "11a5ed53-5220-4250-a3ef-64a831ad02dc",
                                                "sense_id": "3d3e0d14-3436-3eaf-a882-8ff63de81ab8",
                                                "text": "Lorsque je me sens désespérée, déprimée, que j'ai le sentiment d'avoir une boule d'anxiété, que je suis pleine de mauvaises ondes, je rédige une carte de remerciement à l'attention de quelqu'un, de n'importe qui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4010591d-dad7-38a9-a93d-802a29a90b78",
                                        "entry_id": "c1c01619-8cc0-37dd-b305-ae5fd4410fc2",
                                        "glosses": [
                                            "Discours du récipiendaire à l’Académie française."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74e29d0e-85e0-480e-a9dc-554f0c8c3bc1",
                                                "sense_id": "4010591d-dad7-38a9-a93d-802a29a90b78",
                                                "text": "La parole est à M. X pour la lecture de son remerciement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ae4b5c2-a123-4c3a-8be2-a592ccaceb08",
                        "source_entry_id": "d51c4161-9c39-3d3d-bc37-d3fe20189e64",
                        "source_sense_description": "Translations",
                        "target_lang_word": "благодарность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "благодарность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9a4dc01d-a3f8-3fb3-a994-05ebf64edb10",
                                        "entry_id": "a20672b5-0705-36fe-8084-fab1fbf89550",
                                        "glosses": [
                                            "чувство признательности за оказанное внимание, услугу, сделанное добро"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e057cf65-314e-44c1-8386-2058d8ed65bd",
                                                "sense_id": "9a4dc01d-a3f8-3fb3-a994-05ebf64edb10",
                                                "text": "Моя вам огромная благодарность за ваше титаническое терпение."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c8dca81-39ec-39de-a46b-678d679f9e93",
                                        "entry_id": "a20672b5-0705-36fe-8084-fab1fbf89550",
                                        "glosses": [
                                            "выражение такого чувства [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34f55fd8-a69c-450b-bb5f-f97bebdaeed5",
                                                "sense_id": "8c8dca81-39ec-39de-a46b-678d679f9e93",
                                                "text": "[Лебезятников:] Ну и решил, что вам действительно передо мной совестно такие куши давать, и, кроме того, может быть, подумал я, он хочет ей сюрприз сделать, удивить ее, когда она найдет у себя в кармане целых сто рублей. (Потому что иные благотворители очень любят этак размазывать свои благодеяния; я знаю). Потом мне тоже подумалось, что вы хотите ее испытать, то есть придет ли она, найдя, благодарить? Потом, что хотите избежать благодарности и чтоб, ну, как это там говорится: чтоб правая рука, что ль, не знала... одним словом как-то этак..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b3acad8-3c9a-3941-a458-533c1304be41",
                                        "entry_id": "a20672b5-0705-36fe-8084-fab1fbf89550",
                                        "glosses": [
                                            "мера поощрения в виде официальной положительной оценки чьего-либо труда"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43a5cf1d-d9a4-46cd-b8e5-b4415e8f6017",
                                                "sense_id": "8b3acad8-3c9a-3941-a458-533c1304be41",
                                                "text": "Вчера Валентине Николаевне благодарность выписали, оглянуться не успела, как 30 лет отработала."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19c01624-3465-33ac-9a44-485bd9afdf3d",
                                        "entry_id": "a20672b5-0705-36fe-8084-fab1fbf89550",
