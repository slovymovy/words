{
    "word_family": [
        "giddiness",
        "giddily"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "849ed283-0e7f-3986-a4d5-5cc7f54e591b",
                    "sense_definition": "Feeling a sense of spinning in the head, causing a perception of unsteadiness and being about to fall down; dizzy.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dizziness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The man became <w>giddy</w> upon standing up so fast after sitting for hours.",
                            "target_lang_translations": {
                                "ru": "У мужчины <w>закружилась голова</w>, когда он так быстро встал после многочасового сидения.",
                                "zh": "那个人坐了几个小时后猛地站起来，感到一阵<w>头晕</w>。"
                            }
                        },
                        {
                            "text": "I wish you wouldn't keep spinning around like that; you make me feel quite <w>giddy</w>.",
                            "target_lang_translations": {
                                "ru": "Хотелось бы, чтобы ты перестал так кружиться; у меня от тебя <w>кружится голова</w>.",
                                "zh": "我希望你别再那样转来转去了，你转得我都有点<w>眩晕</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dizzy",
                        "light-headed",
                        "woozy"
                    ],
                    "antonyms": [
                        "steady",
                        "stable"
                    ],
                    "common_phrases": [
                        "feel giddy",
                        "quite giddy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ощущение вращения в голове, вызывающее чувство неустойчивости и риск падения; испытывающий головокружение.",
                        "zh": "感到头晕目眩，身体不稳，有要跌倒的感觉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испытывающий головокружение",
                                "target_lang_sense_clarification": "о физическом состоянии"
                            },
                            {
                                "target_lang_word": "дурно",
                                "target_lang_sense_clarification": "в значении 'чувствовать дурноту'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "头晕",
                                "target_lang_sense_clarification": "指感到眩晕的身体状态"
                            },
                            {
                                "target_lang_word": "眩晕",
                                "target_lang_sense_clarification": "指感到天旋地转"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e482a0a-5dc8-392e-9997-5a4d6eea657b",
                    "sense_definition": "Joyfully elated; overcome with excitement or happiness.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "excitement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young boy was <w>giddy</w> with excitement when he opened his birthday presents.",
                            "target_lang_translations": {
                                "ru": " Мальчик был <w>вне себя</w> от восторга, когда открывал подарки на день рождения.",
                                "zh": "小男孩打开生日礼物时，<w>欣喜若狂</w>。"
                            }
                        },
                        {
                            "text": "She felt <w>giddy</w> with delight after hearing the wonderful news about her promotion.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала <w>головокружительный</w> восторг, услышав чудесную новость о своем повышении.",
                                "zh": "听到升职的好消息后，她感到<w>飘飘然</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "elated",
                        "thrilled",
                        "overjoyed",
                        "euphoric",
                        "excited",
                        "happy"
                    ],
                    "antonyms": [
                        "depressed",
                        "miserable"
                    ],
                    "common_phrases": [
                        "giddy with excitement",
                        "giddy with delight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Радостно возбужденный; охваченный волнением или счастьем.",
                        "zh": "因极度兴奋或快乐而感到飘飘然。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вне себя от радости",
                                "target_lang_sense_clarification": "о сильном восторге"
                            },
                            {
                                "target_lang_word": "одурманенный",
                                "target_lang_sense_clarification": "счастьем или успехом"
                            },
                            {
                                "target_lang_word": "легкомысленный",
                                "target_lang_sense_clarification": "от избытка чувств"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "欣喜若狂",
                                "target_lang_sense_clarification": "形容高兴到了极点"
                            },
                            {
                                "target_lang_word": "飘飘然",
                                "target_lang_sense_clarification": "形容因得意或兴奋而神志恍惚"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97a97642-8008-304c-9440-cc6148215d58",
                    "sense_definition": "Unable to concentrate or think seriously; easily excited; impulsive; also, lightheartedly silly; frivolous.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>giddy</w> young man who rarely thinks about the consequences of his actions.",
                            "target_lang_translations": {
                                "ru": "Он <w>легкомысленный</w> молодой человек, который редко задумывается о последствиях своих поступков.",
                                "zh": "他是个<w>轻率</w>的年轻人，很少考虑自己行为的后果。"
                            }
                        },
                        {
                            "text": "The <w>giddy</w> laughter of the teenagers echoed through the quiet library hallways.",
                            "target_lang_translations": {
                                "ru": "<w>Ветреный</w> смех подростков эхом разносился по тихим коридорам библиотеки.",
                                "zh": "青少年们<w>轻浮</w>的笑声在安静的图书馆走廊里回荡。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flighty",
                        "frivolous",
                        "silly",
                        "feather-headed"
                    ],
                    "antonyms": [
                        "serious",
                        "sober",
                        "staid"
                    ],
                    "common_phrases": [
                        "giddy laughter",
                        "giddy behavior"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неспособный сосредоточиться или серьезно мыслить; легко возбудимый; импульсивный; также беззаботно глупый или легкомысленный.",
                        "zh": "无法集中注意力或认真思考；轻浮、轻率。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легкомысленный",
                                "target_lang_sense_clarification": "о характере или поведении"
                            },
                            {
                                "target_lang_word": "ветреный",
                                "target_lang_sense_clarification": "о человеке"
                            },
                            {
                                "target_lang_word": "пустой",
                                "target_lang_sense_clarification": "о смехе или разговоре"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轻浮",
                                "target_lang_sense_clarification": "指言行不庄重"
                            },
                            {
                                "target_lang_word": "轻率",
                                "target_lang_sense_clarification": "指做事不慎重"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a69714f-a8fa-3ae3-9128-1d89c1a9727a",
                    "sense_definition": "Causing or likely to cause dizziness or a feeling of unsteadiness.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "dizziness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They climbed to a <w>giddy</w> height and looked down at the tiny cars below.",
                            "target_lang_translations": {
                                "ru": "Они поднялись на <w>головокружительную</w> высоту и посмотрели вниз на крошечные машины.",
                                "zh": "他们爬到了<w>令人眩晕的</w>高度，俯视着下面微小的汽车。"
                            }
                        },
                        {
                            "text": "The skyscraper offered a <w>giddy</w> view of the city from its observation deck.",
                            "target_lang_translations": {
                                "ru": "С небоскреба открывался <w>головокружительный</w> вид на город.",
                                "zh": "从摩天大楼的观景台望去，城市景色<w>令人眩晕</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vertiginous"
                    ],
                    "common_phrases": [
                        "giddy height",
                        "giddy pace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий или способный вызвать головокружение или чувство неустойчивости.",
                        "zh": "引起或可能引起头晕或不稳感的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "головокружительный",
                                "target_lang_sense_clarification": "о высоте или скорости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "令人眩晕的",
                                "target_lang_sense_clarification": "形容高度或速度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "136e70a3-9157-3467-b49c-a5da6b42a56a",
                    "sense_definition": "Moving around something or spinning rapidly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancers moved in a <w>giddy</w> whirl across the ballroom floor.",
                            "target_lang_translations": {
                                "ru": "Танцоры двигались в <w>стремительном</w> вихре по залу.",
                                "zh": "舞者们在舞池中<w>旋转</w>着穿梭。"
                            }
                        },
                        {
                            "text": "The leaves were caught in a <w>giddy</w> circle by the sudden gust of wind.",
                            "target_lang_translations": {
                                "ru": "Листья закружились в <w>бешеном</w> хороводе от внезапного порыва ветра.",
                                "zh": "突如其来的阵风将落叶卷入了一场<w>旋转</w>的漩涡中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "whirling",
                        "spinning",
                        "reeling"
                    ],
                    "common_phrases": [
                        "giddy whirl",
                        "giddy circle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in literary contexts to describe rapid motion"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Движущийся вокруг чего-либо или вращающийся с большой скоростью.",
                        "zh": "围绕某物移动或快速旋转。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стремительный",
                                "target_lang_sense_clarification": "о вращательном движении"
                            },
                            {
                                "target_lang_word": "вихревой",
                                "target_lang_sense_clarification": "о кружении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "旋转的",
                                "target_lang_sense_clarification": "形容快速转动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a3d38da-bb39-30c5-915b-780b31f65e6c",
                    "sense_definition": "Used as an intensifier to emphasize a noun.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent a <w>giddy</w> lot of money on that old car without checking the engine.",
                            "target_lang_translations": {
                                "ru": "Он потратил <w>чертову</w> уйму денег на ту старую машину, даже не проверив двигатель.",
                                "zh": "他没检查引擎就花了一笔<w>极其</w>昂贵的钱买了那辆旧车。"
                            }
                        },
                        {
                            "text": "Don't play the <w>giddy</w> ox and just do your work properly.",
                            "target_lang_translations": {
                                "ru": "Не <w>валяй дурака</w> и просто делай свою работу как следует.",
                                "zh": "别再<w>轻浮</w>了，好好工作。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "giddy lot",
                        "play the giddy ox"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "British slang usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется как усилитель для придания эмоциональной окраски существительному (британский сленг).",
                        "zh": "用作强调名词的程度副词（英国俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чертов",
                                "target_lang_sense_clarification": "усилительное слово"
                            },
                            {
                                "target_lang_word": "глупый",
                                "target_lang_sense_clarification": "в идиоме 'play the giddy ox'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极其",
                                "target_lang_sense_clarification": "用作程度强调"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d9d360d7-064b-371d-98f2-712a4efad7da",
                    "sense_definition": "To make someone or something dizzy or unsteady.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dizziness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rapid flashing lights began <w>giddying</w> the audience during the concert.",
                            "target_lang_translations": {
                                "ru": "Часто мигающие огни начали <w>кружить голову</w> зрителям во время концерта.",
                                "zh": "音乐会期间，快速闪烁的灯光开始让观众感到<w>头晕</w>。"
                            }
                        },
                        {
                            "text": "The sheer height of the mountain was enough to <w>giddy</w> even the most experienced climber.",
                            "target_lang_translations": {
                                "ru": "Одной только высоты горы было достаточно, чтобы <w>вскружить голову</w> даже самому опытному альпинисту.",
                                "zh": "山的高度足以让最有经验的登山者也感到<w>眩晕</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dizzy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать у кого-либо головокружение или чувство неустойчивости.",
                        "zh": "使某人感到头晕或不稳。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вскружить голову",
                                "target_lang_sense_clarification": "вызвать головокружение"
                            },
                            {
                                "target_lang_word": "одурманивать",
                                "target_lang_sense_clarification": "лишать ясности мысли"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使……头晕",
                                "target_lang_sense_clarification": "导致眩晕感"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "96f95930-87fb-3f2e-baba-7ea2807912ce",
                    "sense_definition": "Someone or something that is frivolous or impulsive.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>giddies</w> of the town spent their afternoons chasing the latest fashions.",
                            "target_lang_translations": {
                                "ru": "Городские <w>вертопрахи</w> проводили свои дни в погоне за последней модой.",
                                "zh": "镇上的那些<w>轻浮的人</w>整个下午都在追逐最新的时尚。"
                            }
                        },
                        {
                            "text": "She was often dismissed as a mere <w>giddy</w> by her more serious colleagues.",
                            "target_lang_translations": {
                                "ru": "Более серьезные коллеги часто не принимали ее всерьез, считая просто <w>пустышкой</w>.",
                                "zh": "她经常被更严肃的同事视为一个<w>轻浮的人</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used as a noun in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кто-то или что-то легкомысленное или импульсивное (устаревшее).",
                        "zh": "轻浮或冲动的人（过时用法）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вертопрах",
                                "target_lang_sense_clarification": "о легкомысленном человеке"
                            },
                            {
                                "target_lang_word": "пустышка",
                                "target_lang_sense_clarification": "о несерьезном человеке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轻浮的人",
                                "target_lang_sense_clarification": "指不稳重的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2d98166a-05e2-39fb-88ec-89917fe32408",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historical records mention a man named Thomas <w>Giddy</w> who lived in the village.",
                            "target_lang_translations": {
                                "ru": "В исторических записях упоминается человек по имени Томас <w>Гидди</w>, живший в этой деревне.",
                                "zh": "历史记录提到一个名叫托马斯·<w>吉迪</w>的人曾住在这个村子里。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Гидди",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吉迪",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}