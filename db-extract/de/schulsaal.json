                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef7738d9-ecfa-4663-b111-17cf88fafc56",
                                "sense_id": "bcf27ad3-8c83-3bdf-b9a0-4abc19d40021",
                                "text": "„Aufgrund des Zuzugs Heimatvertriebener und Flüchtlinge wurden die Gottesdienste in den Schulsaal verlegt.“"
                            },
                            {
                                "example_id": "ef99813f-13ed-4510-8ceb-ad23acc2cae0",
                                "sense_id": "bcf27ad3-8c83-3bdf-b9a0-4abc19d40021",
                                "text": "„Noch einmal fanden wir uns in jenem Schulsaal zusammen, aus dem ich einige Wochen früher so unrühmlich ausgewiesen worden war, um das Notabitur zu absolvieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
