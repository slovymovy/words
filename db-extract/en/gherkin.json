                    {
                        "sense_id": "dfa3282e-cf1b-3655-a31c-a4744fce09a9",
                        "entry_id": "d8c58bf0-01f5-3dcf-bdd9-adb9391b0310",
                        "glosses": [
                            "The penis."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "4bd82aeb-e976-4828-9272-5875eb974d9c",
                                "sense_id": "dfa3282e-cf1b-3655-a31c-a4744fce09a9",
                                "text": "“Yes, daddy,” I moaned, lying big-time as his finger played in my sudsy pussy. “Say please,” he ordered, taking my hand to circle around his gherkin."
                            },
                            {
                                "example_id": "af57c386-ab4b-4e85-a367-1f8340d6ec77",
                                "sense_id": "dfa3282e-cf1b-3655-a31c-a4744fce09a9",
                                "text": "“Even my gherkin is sorry, and it didn't talk shit about anybody,\" persists Adrian. The edge of Titus's mouth quivers in laughter."
                            },
                            {
                                "example_id": "8ef06816-35a2-475e-a60a-051b30b97158",
                                "sense_id": "dfa3282e-cf1b-3655-a31c-a4744fce09a9",
                                "text": "His gherkin was doing the tent dance, and he couldn't have been prouder."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
