                                "sense_id": "9f991a7e-7f4f-3bb0-aa67-db9250f33bbe",
                                "text": "Das Großamt des Konnetabels wurde 1627 durch Kardinal Richelieu abgeschafft."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3b3f6fb9-4284-33be-b82d-8d2fc7ad970f",
