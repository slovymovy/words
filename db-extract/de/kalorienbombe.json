                                    {
                                        "sense_id": "14d08fb8-c1d9-3415-aacc-625d3b36deb1",
                                        "entry_id": "cc30f233-5096-357c-b6d9-cddaaf98f3b8",
                                        "glosses": [
                                            "Food that contains an excessive and unhealthy amount of calories."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab01d454-7eb9-4b55-963c-ffcaa00e5fe8",
                                                "sense_id": "14d08fb8-c1d9-3415-aacc-625d3b36deb1",
                                                "text": "However, cheese is a calorie bomb. Add cheese to restaurant-sized portions and it's more like an atomic calorie bomb."
                                            },
                                            {
                                                "example_id": "943b129d-5b2c-44d8-a30e-3a2586fcec30",
                                                "sense_id": "14d08fb8-c1d9-3415-aacc-625d3b36deb1",
                                                "text": "Or is it the nutritional opposite: a calorie bomb of full-fat chocolate ice cream, whole milk, and sugary syrup?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
