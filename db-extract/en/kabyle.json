                "senses": [
                    {
                        "sense_id": "42fe4e9e-1bbe-364f-8ac8-ffae0026c6e2",
                        "entry_id": "23b46d51-db5d-3717-be34-7e94e12bc04d",
                        "glosses": [
                            "Pertaining to these people or their language."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "245290a2-b9f1-4da6-84a7-482a0c8ef6bd",
                                "sense_id": "42fe4e9e-1bbe-364f-8ac8-ffae0026c6e2",
                                "text": "Revisiting his native land that year, Albert Camus was horrified to find Kabyle children fighting with dogs for the contents of a rubbish bin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81d632d4-543a-4540-8823-986f62b2b215",
                        "source_entry_id": "23b46d51-db5d-3717-be34-7e94e12bc04d",
                        "source_sense_id": "42fe4e9e-1bbe-364f-8ac8-ffae0026c6e2",
                        "source_sense_description": "pertaining to these people or their language",
                        "target_lang_word": "kabyle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kabyle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0adea68e-3725-35a4-8663-eac01b57ecdf",
                                        "entry_id": "7325b487-5539-360a-90e6-d2195b39d430",
                                        "glosses": [
                                            "Originaire de Kabylie ou relatif à cette partie de l’Atlas algérien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "173ae3f4-5465-417e-bb1c-06fba6a18f8a",
                                                "sense_id": "0adea68e-3725-35a4-8663-eac01b57ecdf",
                                                "text": "C’est donc dans trois groupes que se trouvent les bourgeois algériens : kabyle, tlemcénien, mozabite."
                                            },
                                            {
                                                "example_id": "0c45f72c-187d-4022-8cd4-2b2d33f0565c",
                                                "sense_id": "0adea68e-3725-35a4-8663-eac01b57ecdf",
                                                "text": "Mais cela peut même aller jusqu’à la désertification lorsque les familles ont pu à leur tour migrer : la montagne kabyle ou libanaise est ainsi constellée de fermes abandonnées."
                                            },
                                            {
                                                "example_id": "08077fda-80dd-4ce7-8c91-5328ce3e6b53",
                                                "sense_id": "0adea68e-3725-35a4-8663-eac01b57ecdf",
                                                "text": "On leur parle de roumis ennemis. Ennemis ? Les musulmanes des douars kabyles n’ont jamais vu de roumis. Comment pourraient-elles les haïr ? On leur dit qu’après le départ des roumis l’Algérie renaîtra, la terre sera aux musulmans."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kabyle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c4f90fc6-2f25-3d19-a686-63344297fbfd",
                                        "entry_id": "2d4c4d3e-3d6a-3b93-aa6c-b0e5a041e639",
                                        "glosses": [
                                            "Langue kabyle, langue berbère parlée principalement en Kabylie (Algérie)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dc51e0f-6154-4583-95e4-8fbcf2a1293d",
                                                "sense_id": "c4f90fc6-2f25-3d19-a686-63344297fbfd",
                                                "text": "En kabyle, abeille se dit tizizwit."
                                            },
                                            {
                                                "example_id": "5e1a5e28-141e-4f92-b71c-811f9466c72c",
                                                "sense_id": "c4f90fc6-2f25-3d19-a686-63344297fbfd",
                                                "text": "T’es beau"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c23a4f9a-d575-3fd3-aeba-e13e11b14a3d",
                                        "entry_id": "2d4c4d3e-3d6a-3b93-aa6c-b0e5a041e639",
                                        "glosses": [
                                            "Châle à petites fleurs. ^([1])"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
