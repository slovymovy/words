                                        "entry_id": "5aa1888a-5cf5-31d6-8800-abe5e8bb5a7d",
                                        "glosses": [
                                            "Discipline scientifique consacrée à la conception, la validation (notamment statistique) et l'application de méthodes d'évaluation de la psyché humaine et des processus mentaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84d01241-ea8a-4b50-87ad-8df5f4d8b59f",
                                                "sense_id": "678bbbd5-be8d-3e50-810d-ec7a1a30c984",
                                                "text": "Les tests psychologiques (dits aussi tests psychométriques), tels que ceux dédiés à l'estimation de la personnalité, de valeurs, de motivations ou encore d'aptitudes sensori-motrices et intellectuelles (par la psychotechnique), sont les outils les plus courants du champs de la psychométrie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "277284c4-5c37-3616-b3ab-aa5936ddf9d8",
                                        "entry_id": "5aa1888a-5cf5-31d6-8800-abe5e8bb5a7d",
                                        "glosses": [
                                            "Faculté supposée à déceler, sur la base d'un contact physique, l'histoire d'un objet ou de la personne l'ayant possédé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
