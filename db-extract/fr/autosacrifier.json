                        "examples": [
                            {
                                "example_id": "d12fdb54-e538-4b61-99c8-c14dc990e173",
                                "sense_id": "44ab66dc-f7a0-3cea-b601-5cd9332f1f07",
                                "text": "Il surgit à l'est mais ne bouge pas: pour qu’il ne brûle pas le monde, les dieux acceptent finalement de s’autosacrifier."
                            },
                            {
                                "example_id": "8e391ff7-ea36-4c8d-8d56-59c8f5d13e87",
                                "sense_id": "44ab66dc-f7a0-3cea-b601-5cd9332f1f07",
                                "text": "DSK aurait-il pu être victime d'un lapsus mental et s’autosacrifier, n’ayant pas envie de rentrer en campagne ?"
                            },
                            {
                                "example_id": "9fb279ad-6bbb-4e33-a13b-93bb322d5cec",
                                "sense_id": "44ab66dc-f7a0-3cea-b601-5cd9332f1f07",
                                "text": "Il ne reste plus à celle-ci que l’obligation de s’autosacrifier pour assurer le spectacle nécessaire au plaisir du peuple."
                            }
                        ]
