                        "glosses": [
                            "Drang von Sklaven, aus der Gefangenschaft zu fliehen"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "77ae63d7-77a1-454a-aa64-174ff58cba62",
                                "sense_id": "ecd0d4ff-b45b-3566-a986-d3896bf1f7f9",
                                "text": "Dieser Sklave ist der Drapetomanie verfallen."
                            }
