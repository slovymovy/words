                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82ef5069-f910-4c0b-bcd9-a8ad220109fa",
                        "source_entry_id": "ba0eb9c4-a91b-37fc-ae4d-4c6e317f42aa",
                        "source_sense_id": "f79bf861-e9df-33b9-a4c3-626fe8fbfee2",
                        "target_lang_word": "Erwärmung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erwärmung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b736d73-faae-346a-9501-62bb8f189fed",
                                        "entry_id": "027c3ca2-24f5-3a95-bdca-469f33c712a5",
                                        "glosses": [
                                            "kleine Erhöhung der Temperatur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db518bad-72ea-4758-97b5-4170cdaf584e",
                                                "sense_id": "2b736d73-faae-346a-9501-62bb8f189fed",
                                                "text": "Bei der Reaktion ist mit einer Erwärmung des Substrats zu rechnen."
                                            },
                                            {
                                                "example_id": "8d816dfc-b492-4690-a0d5-8deb8f1c0215",
                                                "sense_id": "2b736d73-faae-346a-9501-62bb8f189fed",
                                                "text": "Die Erwärmung der Atmosphäre scheint unabwendbar."
                                            },
                                            {
                                                "example_id": "1d2fa22c-ef1e-4ee4-8b45-287425d9b213",
                                                "sense_id": "2b736d73-faae-346a-9501-62bb8f189fed",
                                                "text": "„Zweitens werde diskutiert, ob die globale Erwärmung die jährlichen Schwankungen im Luftdruckunterschied zwischen Islandtief und Azorenhoch verstärkt.“"
                                            },
                                            {
                                                "example_id": "5130f4ef-3833-4c69-a610-c616d9c2df06",
                                                "sense_id": "2b736d73-faae-346a-9501-62bb8f189fed",
                                                "text": "„Der kleine Inselstaat setzt sich vor allem für die Belange vieler pazifischer Länder ein, die vom Meeresspiegelanstieg infolge der globalen Erwärmung bedroht sind.“"
                                            },
                                            {
                                                "example_id": "dbda1175-693a-4916-ae6d-f35f0154f4e6",
                                                "sense_id": "2b736d73-faae-346a-9501-62bb8f189fed",
                                                "text": "„»Wir wissen schon seit Jahrzehnten, dass eine bestimmte Menge Kohlendioxid, die in die Atmosphäre abgegeben wird, immer ein bestimmtes Maß der Erwärmung nach sich zieht. Das ist eine Grundlage der Wissenschaft«, sagt er.“"
                                            },
                                            {
                                                "example_id": "c794f95d-85ec-4ad5-89a4-010428e22906",
                                                "sense_id": "2b736d73-faae-346a-9501-62bb8f189fed",
                                                "text": "„Wenn Salze gelöst werden, sind oft Temperaturänderungen zu beobachten. So löst sich Kaliumchlorid unter Abkühlung, Lithiumchlorid dagegen unter Erwärmung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2068bbb5-235f-4d4e-ae42-082c1379e90c",
                        "source_entry_id": "ba0eb9c4-a91b-37fc-ae4d-4c6e317f42aa",
                        "source_sense_id": "f79bf861-e9df-33b9-a4c3-626fe8fbfee2",
                        "target_lang_word": "réchauffement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réchauffement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec830a33-e0d2-34bc-8238-ee50a1593914",
                                        "entry_id": "1827b8a3-18ed-3415-b67e-fa2e74b60c93",
                                        "glosses": [
                                            "Fait de se réchauffer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9840bc4b-2abd-357c-8709-5d4b6091c3d9",
                                        "entry_id": "1827b8a3-18ed-3415-b67e-fa2e74b60c93",
                                        "glosses": [
                                            "Action de donner de la chaleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8bb0a17-ccee-4251-803d-685cd1c52c0d",
                                                "sense_id": "9840bc4b-2abd-357c-8709-5d4b6091c3d9",
                                                "text": "Les techniques de réchauffement sont destinées à relever la température centrale quand celle-ci est inférieure à 36°C."
                                            },
                                            {
                                                "example_id": "68ae915f-8742-43ab-9c85-cf1da82483c5",
                                                "sense_id": "9840bc4b-2abd-357c-8709-5d4b6091c3d9",
                                                "text": "La clim est « un fort vecteur d’inégalités entre les groupes sociaux. Pour le confort de quelques-uns, elle va augmenter l’ inconfort de l’ensemble de la population » en augmentant le réchauffement à l’extérieur, dans les endroits partagés, commente Géraldine Molina."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42bd6d6f-b4d0-3cb6-986e-b663564184bc",
                                        "entry_id": "1827b8a3-18ed-3415-b67e-fa2e74b60c93",
                                        "glosses": [
                                            "Augmentation de la température."
                                        ],
                                        "tags": [
                                            "Climat"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d24d47c2-5200-40be-9ac9-cf2eae890e9d",
                                                "sense_id": "42bd6d6f-b4d0-3cb6-986e-b663564184bc",
                                                "text": "Arrive le dernier réchauffement, coïncidant avec le recul, la fonte des glaciers. Il a peu à peu conduit à un climat plus chaud et plus sec que le climat actuel : le climat xérothermique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b13ee6be-3427-3659-87ca-63bf93459332",
                                        "entry_id": "1827b8a3-18ed-3415-b67e-fa2e74b60c93",
                                        "glosses": [
                                            "Réchauffement climatique."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60c81db8-5ba6-4cfb-a1d9-0318df2df4e0",
                                                "sense_id": "b13ee6be-3427-3659-87ca-63bf93459332",
                                                "text": "35 % des zones humides, des milieux naturels à la biodiversité particulièrement riche, ont été détruits depuis 1970 sous le double effet de l’action de l’homme et du réchauffement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93a69a03-5e27-3706-b29b-37a03e3507f9",
                                        "entry_id": "1827b8a3-18ed-3415-b67e-fa2e74b60c93",
                                        "glosses": [
                                            "Fait de se réconcilier."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4366cddc-09da-47fe-8558-fb6bfc5d222c",
                                                "sense_id": "93a69a03-5e27-3706-b29b-37a03e3507f9",
                                                "text": "Depuis, une lettre de Kim à Trump et un troisième sommet intercoréen Kim-Moon ont permis de confirmer le spectaculaire réchauffement en cours après une année 2017 scandée par des menaces de guerre atomique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
