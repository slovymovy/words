                        "source_entry_id": "1d81b430-0979-3a93-838d-419f64fa41dd",
                        "source_sense_id": "47a81cae-d5ad-31d2-9887-fcedcaf85dd8",
                        "target_lang_word": "Babouvist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Babouvist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce6bfc6e-652d-3efc-a78e-d14005fcb0a1",
                                        "entry_id": "b2ae5a72-9cf7-3dd4-9b53-5e3acb8c39dd",
                                        "glosses": [
                                            "A supporter or follower of François-Noël Babeuf or his ideas, including universal equal income and the abolition of private property."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2873d3bc-aa95-4130-b508-2416e59f887a",
                                                "sense_id": "ce6bfc6e-652d-3efc-a78e-d14005fcb0a1",
                                                "text": "At the end of the month, Merlin ordered the disbanding of the Police Legion, which had been infiltrated by the Babouvists."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3303b46d-dd3f-4eeb-a20a-48459474b1f5",
                        "source_entry_id": "1d81b430-0979-3a93-838d-419f64fa41dd",
                        "source_sense_id": "47a81cae-d5ad-31d2-9887-fcedcaf85dd8",
                        "target_lang_word": "бабуви́ст",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бабуви́ст",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "dccd6462-09de-3c37-89fc-078ed1e3fcd7",
                                        "entry_id": "bf4bc6cf-42d6-3beb-8d30-c9782fd506d3",
                                        "glosses": [
                                            "истор., полит. приверженец или представитель бабувизма; последователь идей Г. Бабёфа"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c80cc5a0-4db1-4366-82ec-f8b75434c055",
                                                "sense_id": "dccd6462-09de-3c37-89fc-078ed1e3fcd7",
                                                "text": "После тяжёлой семейной катастрофы Александр Тургенев в качестве скитальца искал самых разнообразных европейских встреч — он записывал анекдоты Проспера Мериме, любезничал с Виктором Гюго, спорил с Бальзаком о Сведенборге, дружил с карбонарием Андрианом, часами беседовал с бабувистом Буонарроти, путешествовал со знаменитым Стендалем, вместе с Лерминье посещал беседы сенсимонистов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
