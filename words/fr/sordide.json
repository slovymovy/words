    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ff76c983-486d-335f-b8d9-e2563748b493",
                    "sense_definition": "D'une saleté repoussante, qui dénote une extrême misère matérielle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "saleté",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils vivaient dans un logement <w>sordide</w> où l'humidité couvrait tous les murs décrépits."
                        },
                        {
                            "text": "L'inspecteur découvrit une pièce <w>sordide</w> remplie de détritus et sans aucune fenêtre."
                        }
                    ],
                    "synonyms": [
                        "crasseux",
                        "immonde",
                        "misérable",
                        "repoussant"
                    ],
                    "antonyms": [
                        "propre",
                        "salubre",
                        "luxueux"
                    ],
                    "common_phrases": [
                        "logement sordide",
                        "quartier sordide"
                    ]
                },
                {
                    "sense_id": "16ea13ce-be29-3335-881c-523de5f8807d",
                    "sense_definition": "D'une bassesse morale révoltante ; vil, ignoble.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les journaux ont révélé les détails <w>sordides</w> de cette lamentable affaire criminelle."
                        },
                        {
                            "text": "Il a trahi ses proches par un calcul <w>sordide</w>, sans éprouver le moindre remords."
                        }
                    ],
                    "synonyms": [
                        "abject",
                        "ignoble",
                        "vil",
                        "méprisable"
                    ],
                    "antonyms": [
                        "noble",
                        "honorable"
                    ],
                    "common_phrases": [
                        "histoire sordide",
                        "détails sordides"
                    ]
                },
                {
                    "sense_id": "7652e3e5-1a62-31c4-8cb9-aa57cf971555",
                    "sense_definition": "Qui fait preuve d'une mesquinerie ou d'une avarice ignoble.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "avarice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Poussé par une avarice <w>sordide</w>, le vieil homme refusait d'allumer le chauffage en plein hiver."
                        },
                        {
                            "text": "Ses choix étaient constamment dictés par un intérêt <w>sordide</w> au détriment de ses amis."
                        }
                    ],
                    "synonyms": [
                        "avare",
                        "mesquin"
                    ],
                    "antonyms": [
                        "généreux",
                        "magnanime"
                    ],
                    "common_phrases": [
                        "avarice sordide",
                        "intérêt sordide"
                    ]
                }
            ]
        }
    ]
