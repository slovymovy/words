    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1c172f54-3488-3c85-a0f5-d73f44fd06dc",
                    "sense_definition": "etwas vielen Menschen mitteilen, bekannt machen oder in Umlauf bringen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "weitergabe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Soziale Netzwerke machen es leicht, ungeprüfte Gerüchte rasch zu <w>verbreiten</w>."
                        },
                        {
                            "text": "Die Aktivisten wollten ihre Botschaft für den Klimaschutz weltweit <w>verbreiten</w>."
                        }
                    ],
                    "synonyms": [
                        "bekanntmachen",
                        "weiterverbreiten",
                        "propagieren",
                        "herumerzählen"
                    ],
                    "common_phrases": [
                        "Gerüchte verbreiten",
                        "eine Nachricht verbreiten",
                        "Panik verbreiten"
                    ]
                },
                {
                    "sense_id": "771b2bba-4f9d-39bb-939b-4a7caeba91c2",
                    "sense_definition": "sich über einen größeren Raum ausdehnen oder unter vielen Menschen herumsprechen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ausbreitung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Neuigkeit über den Rücktritt <w>verbreitete</w> sich wie ein Lauffeuer in der Stadt."
                        },
                        {
                            "text": "Im gesamten Treppenhaus <w>verbreitete</w> sich schnell der Duft von frischem Kaffee."
                        }
                    ],
                    "synonyms": [
                        "sich ausbreiten"
                    ],
                    "common_phrases": [
                        "sich schnell verbreiten",
                        "sich wie ein Lauffeuer verbreiten"
                    ]
                },
                {
                    "sense_id": "5c9ec891-916d-35b7-9049-f526631f8c13",
                    "sense_definition": "Gegenstände oder Partikel über eine weite Fläche verteilen oder verstreuen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ausbreitung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Wind <w>verbreitet</w> die Pollen oft über viele Kilometer."
                        },
                        {
                            "text": "Viele Vögel fressen Waldbeeren und <w>verbreiten</w> dadurch die Samen in der Umgebung."
                        }
                    ],
                    "synonyms": [
                        "verteilen",
                        "ausbreiten"
                    ],
                    "common_phrases": [
                        "Samen verbreiten"
                    ]
                },
                {
                    "sense_id": "258d9bb4-4ff8-361b-b3e2-971e2377c9fb",
                    "sense_definition": "sich in aller Ausführlichkeit und mit vielen Worten über ein Thema äußern",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Professor <w>verbreitete</w> sich über eine Stunde lang über die historische Entwicklung."
                        },
                        {
                            "text": "Sie wollte sich vor den Journalisten nicht weiter über interne Probleme <w>verbreiten</w>."
                        }
                    ],
                    "synonyms": [
                        "sich auslassen"
                    ],
                    "common_phrases": [
                        "sich über etwas verbreiten"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7072fe2b-60aa-37ae-a7fc-aebaa13ce737",
                    "sense_definition": "das Weitergeben, Bekanntmachen oder Verteilen von Inhalten oder Dingen an viele Menschen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weitergabe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das unbefugte <w>Verbreiten</w> vertraulicher Daten kann schwere rechtliche Konsequenzen nach sich ziehen."
                        },
                        {
                            "text": "Das bewusste <w>Verbreiten</w> von Falschmeldungen gefährdet das Vertrauen in die Medien."
                        }
                    ],
                    "common_phrases": [
                        "das Verbreiten von Gerüchten",
                        "das Verbreiten von Falschmeldungen"
                    ]
                }
            ]
        }
