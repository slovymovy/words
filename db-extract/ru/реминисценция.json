                    {
                        "translation_id": "5c44af8f-5bec-4b9d-b27a-b7faad8eca04",
                        "source_entry_id": "e55482c2-6857-3c9d-8ee6-eac4edc6e5ce",
                        "target_lang_word": "Reminiszenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reminiszenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "584311f7-7087-3a15-9c95-35c30c727c8f",
                                        "entry_id": "e0582424-8279-3a65-b1b1-8993024b783b",
                                        "glosses": [
                                            "Erinnerung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8e042ff-8dd8-4218-80f5-0b7a939b5b67",
                                                "sense_id": "584311f7-7087-3a15-9c95-35c30c727c8f",
                                                "text": "Die Gegenstände in diesem Schrank waren Reminiszenzen an verflossene Lieben."
                                            },
                                            {
                                                "example_id": "9c32015a-49fc-42a2-b6d4-64b44b616c05",
                                                "sense_id": "584311f7-7087-3a15-9c95-35c30c727c8f",
                                                "text": "Die Kiste auf dem Dachboden enthielt Reminiszenzen an seine Kindheit."
                                            },
                                            {
                                                "example_id": "c65c8bde-817e-44fc-b54f-1038596e6bdc",
                                                "sense_id": "584311f7-7087-3a15-9c95-35c30c727c8f",
                                                "text": "„Als Reminiszenz an ihre ferne Hauptstadt nannten die Migranten ihre Kolonie Berlin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "74567298-4021-360c-b630-a9695ab5362f",
                                        "entry_id": "e0582424-8279-3a65-b1b1-8993024b783b",
                                        "glosses": [
                                            "Anklang an früher Erfahrenes; etwas, das durch Ähnlichkeit an etwas anderes erinnert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb2c087d-7699-4c56-8ab4-8140d4b8b952",
                                                "sense_id": "74567298-4021-360c-b630-a9695ab5362f",
                                                "text": "Das Lied ist voller Reminiszenzen an die populären Walzerklänge vergangener Zeiten."
                                            },
                                            {
                                                "example_id": "809121c1-aa63-4c84-abd7-29facde44531",
                                                "sense_id": "74567298-4021-360c-b630-a9695ab5362f",
                                                "text": "Im neuen Spielfilm von Meyer gibt es einige gelungene Reminiszenzen an Hitchcock."
                                            },
                                            {
                                                "example_id": "52a6f219-5c1f-4e46-bc15-897489e5b7a5",
                                                "sense_id": "74567298-4021-360c-b630-a9695ab5362f",
                                                "text": "„Es sind Reminiszenzen, die kaum auffallen und die vielleicht deshalb noch nicht skandalisiert wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1348c698-0ab5-48d1-8168-f0b84ec5478c",
                        "source_entry_id": "e55482c2-6857-3c9d-8ee6-eac4edc6e5ce",
                        "target_lang_word": "Anklang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anklang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "562f67e9-abd2-3c48-bc18-a2f9c5ab2150",
                                        "entry_id": "c098abb1-010a-3a8f-b1b2-f2097d98af3b",
                                        "glosses": [
                                            "Assoziation mit ähnlichen Lauten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea563fa3-cd39-4c8c-be7f-59f28a0f9126",
                                                "sense_id": "562f67e9-abd2-3c48-bc18-a2f9c5ab2150",
                                                "text": "Sie benannten das neue Modell im Anklang an seinen Vorgänger."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6d63056a-bea4-341c-94d3-4917bdb4d6fe",
                                        "entry_id": "c098abb1-010a-3a8f-b1b2-f2097d98af3b",
                                        "glosses": [
                                            "Zustimmung, Beifall"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "836c5ab4-bf24-4b13-9450-50338c28879e",
                                                "sense_id": "6d63056a-bea4-341c-94d3-4917bdb4d6fe",
                                                "text": "Seine Auftritte fanden viel Anklang."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "740bbf24-1d7b-4de9-9e4f-730e86596f5e",
                        "source_entry_id": "e55482c2-6857-3c9d-8ee6-eac4edc6e5ce",
                        "target_lang_word": "Erinnerung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erinnerung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9714d18-b407-3584-8b3f-79017f4c6b17",
                                        "entry_id": "8ad01e89-5227-3d6f-84bd-941b81e230dd",
                                        "glosses": [
                                            "die Fähigkeit, Vergangenes im Gedächtnis zu behalten; die Summe aller Erinnerungen [2] eines Menschen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8474f77-40b1-4e9b-8afd-fac4385ad32a",
                                                "sense_id": "f9714d18-b407-3584-8b3f-79017f4c6b17",
                                                "text": "Mein Vater wird langsam alt, seine Erinnerung lässt ihn immer öfter im Stich."
                                            },
                                            {
                                                "example_id": "9f5a7e76-9f50-4fcf-9979-6bfac7d02c39",
                                                "sense_id": "f9714d18-b407-3584-8b3f-79017f4c6b17",
                                                "text": "„Er hielt die Erinnerung für die lebenerhaltende Kraft der Menschen und Planeten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7f6feb56-7dea-3b84-a340-f87fe63cfb04",
                                        "entry_id": "8ad01e89-5227-3d6f-84bd-941b81e230dd",
                                        "glosses": [
                                            "ein bestimmter Gedanke, der durch die Fähigkeit [1] verblieben ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84bd9513-0611-4a17-a9b7-649e86fea245",
                                                "sense_id": "7f6feb56-7dea-3b84-a340-f87fe63cfb04",
                                                "text": "„Von allen meinen Erinnerungen, von all den unzähligen Empfindungen meines Lebens war die bedrückendste die Erinnerung an den einzigen Mord, den ich begangen habe.“"
                                            },
                                            {
                                                "example_id": "6fb6cdd0-add8-446b-94bf-d1b3aed71925",
                                                "sense_id": "7f6feb56-7dea-3b84-a340-f87fe63cfb04",
                                                "text": "„Erinnerung ist im Deutschland der fünfziger Jahre ein unangenehmer Störfaktor für die Neudemokraten, die gerade beginnen, das Land mit dem gleichen Eifer aufzubauen, mit dem sie es wenige Jahre zuvor zerstört hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "63fdadb1-7753-3f6b-ac3b-1705e8b6e785",
                                        "entry_id": "8ad01e89-5227-3d6f-84bd-941b81e230dd",
                                        "glosses": [
                                            "die Erinnerung [2] an ein bestimmtes Ereignis oder eine bestimmte Person; oft in Form eines Denkmals oder Ähnlichem manifestiert"
                                        ],
                                        "tags": [
                                            "konkret"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3aea6ec0-d5f2-44ba-ac38-df4947132836",
                                                "sense_id": "63fdadb1-7753-3f6b-ac3b-1705e8b6e785",
                                                "text": "„Erst seit 1951 trägt die Straße ihren heutigen Namen, in Erinnerung an die Berliner Schneiderin Käthe Niederkirchner, die 1933 als Kommunistin Deutschland verlassen musste und zehn Jahre später als sowjetische Agentin zurückkam, in Berlin festgenommen und Ende September 1944 im KZ Ravensbrück hingerichtet wurde.“"
                                            },
                                            {
                                                "example_id": "6e8f99eb-ea06-4d96-b001-4b25b2caeb82",
                                                "sense_id": "63fdadb1-7753-3f6b-ac3b-1705e8b6e785",
                                                "text": "„Trotz des scharfen Windes – da weht noch etwas anderes: Sie nennen es hier den Rhöngeist, und sie meinen damit den nie zu Ende geträumten Traum vom Fliegen, die Zähigkeit, die Leidenschaft und die Erinnerung an die Pionierzeit des Segelflugs.“"
                                            },
                                            {
                                                "example_id": "ab7d8411-fcc0-40ad-8919-3bac635bcbd9",
                                                "sense_id": "63fdadb1-7753-3f6b-ac3b-1705e8b6e785",
                                                "text": "„Erwachsenen Menschen ist es nur eine gewisse Weile erlaubt, in süßen Erinnerungen zu schwelgen, und bald wandte sich der Geschäftsführer seinem eigentlichen Thema zu.“"
                                            },
                                            {
                                                "example_id": "393f4f7c-ae8a-4f3e-b516-218e3b7ad473",
                                                "sense_id": "63fdadb1-7753-3f6b-ac3b-1705e8b6e785",
                                                "text": "„Die Londoner Psychologin Julia Shaw hat ihr eine falsche Erinnerung eingepflanzt.“"
                                            },
                                            {
                                                "example_id": "0a0ac7a8-82ce-4cd9-b666-01a02b689084",
                                                "sense_id": "63fdadb1-7753-3f6b-ac3b-1705e8b6e785",
                                                "text": "„Die Gäste erhalten goldene Medaillen zur Erinnerung an das Ereignis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "85faa058-c35c-34f4-8fb3-66516b1bde07",
                                        "entry_id": "8ad01e89-5227-3d6f-84bd-941b81e230dd",
                                        "glosses": [
                                            "ein Text oder Zeichen mit dem Zweck, die Erinnerung [1] wieder aufzufrischen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c88501d2-6cb1-4554-9314-ea77afa56b6f",
                                                "sense_id": "85faa058-c35c-34f4-8fb3-66516b1bde07",
                                                "text": "Danke für die Erinnerung, Milch mitzubringen. Ich hätte nicht mehr daran gedacht."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "c2ba0b13-2800-300b-bed1-cd0e86c1443c",
                                        "entry_id": "8ad01e89-5227-3d6f-84bd-941b81e230dd",
                                        "glosses": [
                                            "ohne Plural ein Rechtsbehelf, der innerhalb derselben Instanz zu einer gerichtlichen Überprüfung einer Maßnahme führt, die ein Gerichtsbeamter oder ein ersuchter oder beauftragter Richter getroffen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "075ec474-24e4-4337-a3f4-b33dca7fe947",
                                                "sense_id": "c2ba0b13-2800-300b-bed1-cd0e86c1443c",
                                                "text": "Gegen die Weigerung des Gerichtsvollziehers, einen Vollstreckungsauftrag zu übernehmen, kann sich der Vollstreckungsgläubiger gemäß § 766 Abs. 2 ZPO mittels Erinnerung zu Wehr setzen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbaa5b3a-b8cb-48c0-9cb2-eebadb4850f5",
                        "source_entry_id": "e55482c2-6857-3c9d-8ee6-eac4edc6e5ce",
                        "target_lang_word": "réminiscence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réminiscence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2b86336-721c-3b2c-8b05-c59947e5cfa4",
                                        "entry_id": "f05b0647-a076-30ef-a571-aab204844d4f",
                                        "glosses": [
                                            "Rappel à la mémoire d’un souvenir qui n’est pas reconnu comme tel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ade947d-b28e-4527-b495-99dea12888af",
                                                "sense_id": "a2b86336-721c-3b2c-8b05-c59947e5cfa4",
                                                "text": "Et s’il les avait lui-même goulûment tétés ces gros seins tellement mystérieux quand il était nourrisson, il n’en gardait presque aucun souvenir. Si ce n’était la réminiscence fantomatique d’un parfum vaguement sucré se dissipant avec le temps."
                                            },
                                            {
                                                "example_id": "775e13d0-9ace-451f-8865-2de01f5e29b8",
                                                "sense_id": "a2b86336-721c-3b2c-8b05-c59947e5cfa4",
                                                "text": "Les platoniciens croyaient que toutes les connaissances que nous acquérons ne sont que des réminiscences de ce que nous avons su avant notre naissance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47d77e21-a96e-3c9e-8d99-ba8a707a94dc",
                                        "entry_id": "f05b0647-a076-30ef-a571-aab204844d4f",
                                        "glosses": [
                                            "Souvenir qui apparaît à l’esprit sans que les pensées antérieures à cette apparition, ni les objets observés durant ou avant l’apparition du souvenir n’y semblent rattachés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73bd2cd7-1067-4383-b110-2f757a149e4f",
                                                "sense_id": "47d77e21-a96e-3c9e-8d99-ba8a707a94dc",
                                                "text": "Il s’agit vraiment de dénoncer une mise en scène traumatique dans laquelle celui qui est en proie à des réminiscences de violences cherche à enrôler de force un acteur pour y jouer à sa place le rôle de victime, lui-même se choisissant le rôle le moins exposé de l’agresseur tout-puissant, avec pour scénario la scène de violence qui va lui permettre de faire disjoncter son circuit émotionnel et de s’anesthésier très efficacement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdc242b6-8e88-3d52-9a48-190196dcf427",
                                        "entry_id": "f05b0647-a076-30ef-a571-aab204844d4f",
                                        "glosses": [
                                            "Souvenirs vagues et confus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d929b76d-002e-44bb-8792-18811fae6e02",
                                                "sense_id": "cdc242b6-8e88-3d52-9a48-190196dcf427",
                                                "text": "Si tout cela me semble excessif, je dois bien reconnaître qu'il me revient parfois, lors de certains réveils douloureux, de vagues réminiscences de faits irrationnels, des phénomènes énigmatiques où songes et réalité s'entremêlent."
                                            },
                                            {
                                                "example_id": "30684264-782f-49bd-a42b-3c1d0caf9f9a",
                                                "sense_id": "cdc242b6-8e88-3d52-9a48-190196dcf427",
                                                "text": "J’ai une vague réminiscence des évènements de l'époque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cfe86c2-159e-3f26-9c20-13fd3f4100f1",
                                        "entry_id": "f05b0647-a076-30ef-a571-aab204844d4f",
                                        "glosses": [
                                            "Emprunt plus ou moins conscient fait par l’auteur d’une œuvre artistique ou littéraire à d’autres créateurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e904dd8a-02d4-4a0b-98e2-acd4231cf320",
                                                "sense_id": "7cfe86c2-159e-3f26-9c20-13fd3f4100f1",
                                                "text": "C’est, dit-elle, de simples stances sur lesquelles j’ai osé plaquer des réminiscences d’airs allemands…"
                                            },
                                            {
                                                "example_id": "f89fc2b8-6a8e-4a15-a651-aaee8fa4ebe8",
                                                "sense_id": "7cfe86c2-159e-3f26-9c20-13fd3f4100f1",
                                                "text": "« Contraste éternel entre la joie et les larmes, entre la vie et la mort », songea M. Bernomdunchien à qui sa mission conférait des réminiscences hugolâtres, à la pensée de ce cadavre abandonné qui l’attendait, au bout de ce glauque chemin de vagues."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
