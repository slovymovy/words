                                            {
                                                "example_id": "397e9c69-cbd9-4304-815b-432c5da46a36",
                                                "sense_id": "ec103a62-6ce8-375f-896c-e1ae5f1ad90e",
                                                "text": "Le défi réside peut-être aujourd'hui dans le fait de pouvoir sororiser sans reproduire à l'intérieur ni hiérarchies ni échelles de valeur, depuis nos existences dissidentes, collectives et merveilleusement frelatées",
                                                "translation": "Mayra Lucio, traduction Jeanne Godard Davant, Bisexualités féministes, 2025"
                                            }
                                        ]
