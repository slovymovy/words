                "senses": [
                    {
                        "sense_id": "479e3598-287f-3e44-9637-21be999ec09b",
                        "entry_id": "4e7ea994-4c34-328c-8f7a-c88f1c7b8d34",
                        "glosses": [
                            "ktoś należący do przestępczego półświatka, w szczególności paryskiego"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "eb396993-d337-4a97-8554-a1ecf6164146",
                                "sense_id": "479e3598-287f-3e44-9637-21be999ec09b",
                                "text": "Syn ulicy przeklęty, apasz zbój, który od najmłodszych lat postrach siał, rabował, kradł, aż w urocze sidła pięknej ulicznicy wpadł."
                            },
                            {
                                "example_id": "ed31e5f9-243e-4cee-b230-7b9eeaa1caf4",
                                "sense_id": "479e3598-287f-3e44-9637-21be999ec09b",
                                "text": "Apaszem Stasiek był; w krąg znały go ulice\n W spelunkach, tam gdzie podłe życie wre.\n Kochanką jego była zwykła ulicznica,\nCo gdzieś na rogu sprzedaje ciało swe."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1261cf2-8866-4687-ba7b-b3b16ecdbcbb",
                        "source_entry_id": "4e7ea994-4c34-328c-8f7a-c88f1c7b8d34",
                        "source_sense_id": "479e3598-287f-3e44-9637-21be999ec09b",
                        "target_lang_word": "Apache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a9ddde7c-7cad-3149-bc88-a79d1b6cda95",
                                        "entry_id": "230a2de9-df6c-3958-9ea6-0f4c9f20e114",
                                        "glosses": [
                                            "ein Angehöriger der gleichnamigen Indianernation im Südwesten der Vereinigten Staaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7f87ddb-7c1d-492f-8f20-4a5cc4bcfb4f",
                                                "sense_id": "a9ddde7c-7cad-3149-bc88-a79d1b6cda95",
                                                "text": "„Ich hätte mein Leben dahingegeben, um ihm das seinige zu erhalten, so wie er dieses hundertmal für mich wagte. Dies war mir nicht vergönnt; er ist dahingegangen, indem er, wie immer, ein Retter seiner Freunde war; aber er soll nur körperlich gestorben sein und hier in diesen Blättern fortleben, wie er in meiner Seele lebt, er Winnetou, der große Häuptling der Apachen.“"
                                            },
                                            {
                                                "example_id": "e4039b61-7c0d-42e7-bd55-9576c09af852",
                                                "sense_id": "a9ddde7c-7cad-3149-bc88-a79d1b6cda95",
                                                "text": "„Die ersten Pferdezuchten der Prärie bauten Apachen und Jumano im Süden und Südwesten auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
