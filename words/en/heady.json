                            }
                        },
                        {
                            "text": "I met a man named Mr. <w>Heady</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "nl": "Ik ontmoette gisteren een man genaamd meneer <w>Heady</w> op de conferentie."
                            }
