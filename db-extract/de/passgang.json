                                "target_senses": [
                                    {
                                        "sense_id": "a802eaf1-864d-37f4-baed-ec81d676fa7b",
                                        "entry_id": "d88ba678-ee11-31b4-8e63-659a28ab9c83",
                                        "glosses": [
                                            "To walk back and forth in a small distance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc2b8070-c6d2-4555-883e-d6cf37f76cfd",
                                                "sense_id": "a802eaf1-864d-37f4-baed-ec81d676fa7b",
                                                "text": "Groups of men, in all imaginable attitudes, were lying, standing, sitting, or pacing up and down."
                                            },
                                            {
                                                "example_id": "db27368b-558b-47e2-aa32-5b6e0e788a2d",
                                                "sense_id": "a802eaf1-864d-37f4-baed-ec81d676fa7b",
                                                "text": "As we stood waiting for the departure time with the setting sun twinkling on the great brass dome of our 2-4-0, the sound of church bells was the only one apart from the measured tread of the guard slowly pacing towards his van, and, standing at an open window, I more than once heard the fireman's \"Right away!\" to his mate in acknowledgement of a desultory wave of the unfurled green flag."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "926a3390-5ad7-3d53-a211-c279321119ad",
                                        "entry_id": "d88ba678-ee11-31b4-8e63-659a28ab9c83",
                                        "glosses": [
                                            "To set the speed in a race."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfb60dc0-e4b5-4681-8372-0005000c4555",
                                                "sense_id": "926a3390-5ad7-3d53-a211-c279321119ad",
                                                "text": "The clubs in London, Manchester, Birmingham, etc., hold various track meetings for races varying from one mile to fifty miles, the longer distances being sometimes paced by tandems."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51918db2-02a7-38a0-bb08-872b51e83198",
                                        "entry_id": "d88ba678-ee11-31b4-8e63-659a28ab9c83",
                                        "glosses": [
                                            "To measure by walking."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
