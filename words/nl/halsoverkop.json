{
    "word_family": [
        "hals",
        "over",
        "kop"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "cb6fea9f-3222-33b7-b7dd-aeb4df2e2ae3",
                    "sense_definition": "zeer snel en zonder er goed over na te denken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "haastig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een aantal gezinnen moest <w>halsoverkop</w> de flat verlaten vanwege een gaslek.",
                            "target_lang_translations": {
                                "en": "A number of families had to leave the apartment <w>hurriedly</w> because of a gas leak."
                            }
                        },
                        {
                            "text": "Zeker als het om geld gaat kan <w>halsoverkop</w> beslissen veel geld gaan kosten.",
                            "target_lang_translations": {
                                "en": "Especially when it comes to money, deciding <w>rashly</w> can end up costing a lot of money."
                            }
                        }
                    ],
                    "synonyms": [
                        "haastig",
                        "onbezonnen",
                        "overhaast"
                    ],
                    "antonyms": [
                        "bezonnen",
                        "doordacht"
                    ],
                    "common_phrases": [
                        "halsoverkop vertrekken",
                        "halsoverkop beslissen"
                    ],
                    "target_lang_definitions": {
                        "en": "Very quickly and without thinking carefully; in a rushed or impulsive manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "headlong",
                                "target_lang_sense_clarification": "rushing into something without thought"
                            },
                            {
                                "target_lang_word": "precipitately",
                                "target_lang_sense_clarification": "suddenly and without deliberation"
                            },
                            {
                                "target_lang_word": "hurriedly",
                                "target_lang_sense_clarification": "in a great hurry"
                            },
                            {
                                "target_lang_word": "rashly",
                                "target_lang_sense_clarification": "without considering the consequences"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0e25396-b2cf-36e4-b57b-a0ce49d96468",
                    "sense_definition": "op een zeer intense of hartstochtelijke manier, vooral gebruikt bij verliefdheid",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "intensiteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij werd tijdens zijn vakantie in Italië <w>halsoverkop</w> verliefd op een lokaal meisje.",
                            "target_lang_translations": {
                                "en": "During his holiday in Italy, he fell <w>head over heels</w> in love with a local girl."
                            }
                        },
                        {
                            "text": "Zij raakten <w>halsoverkop</w> verliefd en besloten binnen een maand te gaan trouwen.",
                            "target_lang_translations": {
                                "en": "They fell <w>madly</w> in love and decided to get married within a month."
                            }
                        }
                    ],
                    "synonyms": [
                        "smoorverliefd",
                        "onmiddellijk",
                        "plotseling"
                    ],
                    "common_phrases": [
                        "halsoverkop verliefd"
                    ],
                    "target_lang_definitions": {
                        "en": "In a very intense or passionate way, especially used when falling in love."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "head over heels",
                                "target_lang_sense_clarification": "completely and utterly in love"
                            },
                            {
                                "target_lang_word": "madly",
                                "target_lang_sense_clarification": "to an extreme degree, usually with love"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5d9b739-ece8-398a-af1c-40a2caf7bc49",
                    "sense_definition": "met een buiteling waarbij het lichaam over de kop gaat",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De turner viel van de balk en rolde <w>halsoverkop</w> over de dikke mat.",
                            "target_lang_translations": {
                                "en": "The gymnast fell off the beam and rolled <w>head over heels</w> across the thick mat."
                            }
                        },
                        {
                            "text": "Toen hij over de drempel struikelde, vloog hij <w>halsoverkop</w> de kamer binnen.",
                            "target_lang_translations": {
                                "en": "When he tripped over the threshold, he flew <w>headfirst</w> into the room."
                            }
                        }
                    ],
                    "synonyms": [
                        "ondersteboven",
                        "voorover"
                    ],
                    "common_phrases": [
                        "halsoverkop rollen"
                    ],
                    "target_lang_definitions": {
                        "en": "With a tumbling motion where the body goes over the head; headfirst or upside down."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "head over heels",
                                "target_lang_sense_clarification": "turning over in a physical tumble"
                            },
                            {
                                "target_lang_word": "headfirst",
                                "target_lang_sense_clarification": "with the head leading the way"
                            },
                            {
                                "target_lang_word": "topsy-turvy",
                                "target_lang_sense_clarification": "in a state of confusion or upside down"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}