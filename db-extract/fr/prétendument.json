                "senses": [
                    {
                        "sense_id": "4fc8fd80-7726-3a03-9cfc-76c1a3096e86",
                        "entry_id": "f30726e1-72b3-34cb-a28a-8c785f7d5a59",
                        "glosses": [
                            "Faussement ; à tort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7c9e046-f637-4979-b05a-a189c73aad57",
                                "sense_id": "4fc8fd80-7726-3a03-9cfc-76c1a3096e86",
                                "text": "C’est toutefois dans les aventures politico-industrielles prétendument justifiées par l’intérêt national que l’État s’égare avec la délectation la plus grande."
                            },
                            {
                                "example_id": "5bfa8a92-3807-4b70-bdc9-a68130bc89a6",
                                "sense_id": "4fc8fd80-7726-3a03-9cfc-76c1a3096e86",
                                "text": "A Jaffa, ce village de pêcheurs à côté de Tel-Aviv, je visitais le souk. Je me fis arnaquer en achetant des bijoux prétendument yéménites, mais je vis surtout des djellabas blanches, comme celles qu'il portait."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d32ebed-a63f-456c-ac02-f5c95b25ea75",
                        "source_entry_id": "f30726e1-72b3-34cb-a28a-8c785f7d5a59",
                        "source_sense_id": "4fc8fd80-7726-3a03-9cfc-76c1a3096e86",
                        "target_lang_word": "angeblich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "angeblich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c878d92f-c635-3e81-990a-fe07aca671a8",
                                        "entry_id": "f5fe3373-5405-3a78-aea9-1e9c165427ca",
                                        "glosses": [
                                            "wie ohne Gewähr angegeben, behauptet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a216768-f3ec-4646-b8bf-de7af95cd3f9",
                                                "sense_id": "c878d92f-c635-3e81-990a-fe07aca671a8",
                                                "text": "Angeblich trifft er einen prominenten Gast."
                                            },
                                            {
                                                "example_id": "aae10024-e27e-4996-9c86-88b3f2ba0476",
                                                "sense_id": "c878d92f-c635-3e81-990a-fe07aca671a8",
                                                "text": "„Die Anleger hatten Geld in sogenannte Bermuda-Versicherungen gesteckt, spezielle »Lebensversicherungen«, mit denen sich Schwarzgeld angeblich risikolos reinwaschen ließ.“"
                                            },
                                            {
                                                "example_id": "6c2bff3b-c267-4263-8817-2890c910c504",
                                                "sense_id": "c878d92f-c635-3e81-990a-fe07aca671a8",
                                                "text": "„Angeblich waren die Wiedervereinigung und der Niedergang der DDR durch Weingenuss beschleunigt worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01baa976-c544-4e0b-90e3-4154c3b4083d",
                        "source_entry_id": "f30726e1-72b3-34cb-a28a-8c785f7d5a59",
