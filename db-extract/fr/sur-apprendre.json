                "senses": [
                    {
                        "sense_id": "782d3db5-dcb1-3392-81d3-db6ef170ddbe",
                        "entry_id": "d52b751a-8ab1-3dc3-bc71-4b11d275ed8c",
                        "glosses": [
                            "Apprendre de façon excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b31e199-5533-4913-8671-4aab240eb85d",
                                "sense_id": "782d3db5-dcb1-3392-81d3-db6ef170ddbe",
                                "text": "Ces courbes montrent clairement que lorsqu’ils sont confrontés à un grand nombre de variables peu pertinentes les SVM ont tendance à sur-apprendre et leur capacité de généralisation s'en trouve affectée."
                            }
                        ]
                    }
