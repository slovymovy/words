                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e2746cc-8e87-46ca-9233-2948d184841c",
                                "sense_id": "1d672c75-d186-30c5-8fbb-be40c769b08c",
                                "text": "Les esthètes apprécieront le reportage iconographique très riche sur l’éruption, en particulier les aiguilles péléennes."
                            },
                            {
                                "example_id": "ddb13bfc-4bdf-4cf0-88fb-abbe55a42a7c",
                                "sense_id": "1d672c75-d186-30c5-8fbb-be40c769b08c",
                                "text": "Les calculs théoriques de vésiculation et les expériences de dégazage montrent que les magmas péléens dégazent plus que les magmas pliniens."
                            }
                        ]
                    }
