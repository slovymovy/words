        "fr-extract.jsonl": [
            {
                "entry_id": "c725772f-8a4f-376b-9f2a-e6c289fd951e",
                "word": "baliveau",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6e85dbe0-a77b-4d26-9cd2-f1b185765829",
                        "entry_id": "c725772f-8a4f-376b-9f2a-e6c289fd951e",
                        "tags": [
                            "plural"
                        ],
                        "form": "baliveaux"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e3056719-a55d-3cbf-9cf8-a34f5b3c4eaf",
                        "entry_id": "c725772f-8a4f-376b-9f2a-e6c289fd951e",
                        "glosses": [
                            "Jeune arbre réservé, lors de la coupe d’un taillis, afin qu’il puisse devenir un arbre de haute futaie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4476bd8d-9062-4f4a-ba37-9fbec77fddda",
                                "sense_id": "e3056719-a55d-3cbf-9cf8-a34f5b3c4eaf",
                                "text": "On n’apercevait qu’une vaste clairière dans laquelle on avait fait une coupe au printemps précédent, et dont les jeunes baliveaux aux tiges flexibles se courbaient sous le poids de la neige."
                            },
                            {
                                "example_id": "1225e50b-69da-4576-9a2c-889c079b0e41",
                                "sense_id": "e3056719-a55d-3cbf-9cf8-a34f5b3c4eaf",
                                "text": "Comme il arrivait dans les fonds de Bois-sous-Roche, par une fin de journée chaude, il avait vu une douzaine de jeunes baliveaux, coupés par un maraudeur."
                            },
                            {
                                "example_id": "9b097d2b-c85d-4643-97dc-561be2d14283",
                                "sense_id": "e3056719-a55d-3cbf-9cf8-a34f5b3c4eaf",
                                "text": "La méthode du taillis sous futaie fait participer à la fois des avantages du taillis et d’une partie de ceux de la futaie, […]. Dans ce but on conserve à chaque coupe du taillis un certain nombre d’arbres appelés baliveaux auxquels on laisse parcourir plusieurs révolutions."
                            },
                            {
                                "example_id": "2fd426bb-6eee-446c-acb4-5979ae512a33",
                                "sense_id": "e3056719-a55d-3cbf-9cf8-a34f5b3c4eaf",
                                "text": "La strate arborescente est constituée essentiellement par le Chêne pédonculé, le Chêne sessile en baliveaux sensiblement codominants."
                            },
                            {
                                "example_id": "7bc9b40f-b0d1-4885-8c60-1f62004e0bbc",
                                "sense_id": "e3056719-a55d-3cbf-9cf8-a34f5b3c4eaf",
                                "text": "C'est un long vieillard, mince comme un baliveau, un peu courbé par une bonne septantaine d'ans."
                            },
                            {
                                "example_id": "3955c97f-400f-4911-af1e-5a93abda1818",
                                "sense_id": "e3056719-a55d-3cbf-9cf8-a34f5b3c4eaf",
                                "text": "Il avait la ferme du Rochas qui a cent quarante-trois hectares d’un seul tenant dont soixante journals en terres labourables, quarante journals de prés sans un jonc et sept coupes de baliveaux de chênes de vingt ans."
                            }
                        ]
                    },
                    {
                        "sense_id": "7881ccac-9e23-39e1-80d1-aa53f34a50ab",
                        "entry_id": "c725772f-8a4f-376b-9f2a-e6c289fd951e",
                        "glosses": [
                            "Arbre de pépinière ayant un tronc bien vertical et des branches latérales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19686a40-13bb-462b-abd6-80c78f7eddb2",
                                "sense_id": "7881ccac-9e23-39e1-80d1-aa53f34a50ab",
                                "text": "Le chêne rouvre, planté dernièrement au Vallon du Salut par la classe de grande section de l’école Clair-Vallon, n’est à ce jour qu'un jeune plant d’à peine quelques dizaines de centimètres. Autant dire que les petits écoliers devront être patients avant de pouvoir profiter de son ombre. Mais leur enthousiasme pourrait bien favoriser la pousse de ce joli baliveau ainsi que des autres plants d’arbre qu’ils s’apprêtent à planter à divers endroits sur le territoire."
                            }
                        ]
                    },
                    {
                        "sense_id": "95fc3cbd-0c0b-32f6-a4a3-9f000bc7865a",
                        "entry_id": "c725772f-8a4f-376b-9f2a-e6c289fd951e",
                        "glosses": [
                            "Grande perche verticale qui supporte les échafauds."
                        ],
                        "tags": [
                            "Échafaudage"
                        ],
                        "examples": [
                            {
                                "example_id": "cd7fe3d0-a1e3-47fd-a7bf-43781290afc4",
                                "sense_id": "95fc3cbd-0c0b-32f6-a4a3-9f000bc7865a",
                                "text": "La surface inférieure du hourdis est nécessairement irrégulière. Aussi, plus tard, quand il s’agit de procéder au plafonnage, la première opération consiste-t-elle à couper les baliveaux correspondant aux joints des planches sur lesquelles a été coulé le hourdis et à dresser la surface."
                            }
                        ]
                    }
                ],
