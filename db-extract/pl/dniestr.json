                        "entry_id": "7b3e7966-f90d-399a-8ae2-eb08285a87e1",
                        "glosses": [
                            "Fluss in der heutigen Ukraine und Moldawien, der im Schwarzen Meer mündet; Dnjestr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c863e26-2ca7-41ed-9aa4-e250d9a01501",
                                "sense_id": "f8ea3272-2901-3a25-a65c-c3b1dc3f2d26",
                                "text": "„Ostatnie ślady osiadłego życia kończyły się, idąc ku południowi, niedaleko za Czehrynem ode Dniepru, a od Dniestru, niedaleko za Umaniem, a potem już hen ku limanom i morzu step i step w dwie rzeki, jakby w ramę ujęty.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a61960f-f971-4cfd-9643-66f6e90ad13b",
                        "source_entry_id": "7b3e7966-f90d-399a-8ae2-eb08285a87e1",
                        "source_sense_id": "f8ea3272-2901-3a25-a65c-c3b1dc3f2d26",
                        "source_sense_description": "Fluss in der heutigen Ukraine und Moldawien, der im Schwarzen Meer mündet; Dnjestr",
                        "target_lang_word": "Dnjestr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dnjestr",
