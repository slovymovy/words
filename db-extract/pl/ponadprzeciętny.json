                    },
                    {
                        "translation_id": "01264579-7152-4477-92cf-5ac3405f11bf",
                        "source_entry_id": "48c4e6c8-d23e-3ac4-aa4f-94b6b6e41131",
                        "source_sense_id": "efcb0090-b1fe-3a20-9fe2-48529eabe163",
                        "target_lang_word": "extraordinary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extraordinary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db0dfa86-7831-3744-b30e-0fbb136bd2d0",
                                        "entry_id": "9d74f97a-a370-3dee-b2c7-b04bece01430",
                                        "glosses": [
                                            "Not ordinary; exceptional; unusual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8de70641-82e3-4370-8aea-c8587e1ea848",
                                                "sense_id": "db0dfa86-7831-3744-b30e-0fbb136bd2d0",
                                                "text": "Except in extraordinary circumstances, […]"
                                            },
                                            {
                                                "example_id": "77ea7651-5b03-4bef-99bb-3161bb33f1e6",
                                                "sense_id": "db0dfa86-7831-3744-b30e-0fbb136bd2d0",
                                                "text": "Everybody knew I was an extraordinary person. When I was born my beard was three feet long."
                                            },
                                            {
                                                "example_id": "b17957c4-18c6-4c53-8d0f-c0e9cbab032c",
                                                "sense_id": "db0dfa86-7831-3744-b30e-0fbb136bd2d0",
                                                "text": "The Houses may meet in extraordinary sessions at the request of the Government, of the Permanent Deputation or of the overall majority of members of either of the two Houses. Extraordinary sessions must be convened with a specific agenda and shall be adjourned once this has been dealt with."
                                            },
                                            {
                                                "example_id": "2f132cc3-517f-41c7-bce1-739f7badaa94",
                                                "sense_id": "db0dfa86-7831-3744-b30e-0fbb136bd2d0",
                                                "text": "Tony Woodcock's early try and a penalty from fourth-choice fly-half Stephen Donald were enough to see the All Blacks home in an extraordinary match that defied all pre-match predictions."
                                            },
                                            {
                                                "example_id": "2cd2787c-91fc-4538-8c2b-944efeb90ac8",
                                                "sense_id": "db0dfa86-7831-3744-b30e-0fbb136bd2d0",
                                                "text": "From the ground, Colombo’s port does not look like much. […] But viewed from high up in one of the growing number of skyscrapers in Sri Lanka’s capital, it is clear that something extraordinary is happening: China is creating a shipping hub just 200 miles from India’s southern tip."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebe60052-77bd-3bf0-be8d-9875eade65fc",
                                        "entry_id": "9d74f97a-a370-3dee-b2c7-b04bece01430",
                                        "glosses": [
                                            "Remarkably good."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0de7d07f-e2cd-4c30-afd1-f0091ee500cb",
                                                "sense_id": "ebe60052-77bd-3bf0-be8d-9875eade65fc",
                                                "text": "an extraordinary poet"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50a46237-3aa8-397b-8762-5528fa9ec369",
                                        "entry_id": "9d74f97a-a370-3dee-b2c7-b04bece01430",
                                        "glosses": [
                                            "Special or supernumerary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a08fdec-0883-4a0d-86cf-4d6c9b2f685c",
                                                "sense_id": "50a46237-3aa8-397b-8762-5528fa9ec369",
                                                "text": "the physician extraordinary in a royal household"
                                            },
                                            {
                                                "example_id": "2c0da6e1-0ebb-4467-a347-4e85069f1d6a",
                                                "sense_id": "50a46237-3aa8-397b-8762-5528fa9ec369",
                                                "text": "an extraordinary professor in a German university"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
