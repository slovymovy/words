                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8914b562-36e1-42e3-806a-5e69bcbc5b10",
                                                "sense_id": "0d5ce273-879e-3c8f-af64-0b41fe325fc6",
                                                "text": "Ich habe mich bei der genauen Quellenangabe leider versehen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "047b9dcc-d374-3770-8008-80658a4f485a",
                                        "entry_id": "b0d7bdf1-9daf-3d52-bb4a-4aad2a23d7aa",
                                        "glosses": [
                                            "auf etwas gefasst sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2658227-2132-4138-af3c-ebb6fed49340",
                                                "sense_id": "047b9dcc-d374-3770-8008-80658a4f485a",
                                                "text": "Ehe man sich dessen versieht, hat man schon verloren."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "81b75e2b-4a9d-311c-8d14-4ebc09ffed32",
