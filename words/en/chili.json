                    }
                },
                {
                    "sense_id": "9c1b0ad9-4576-3c44-8f73-509d35bc6354",
                    "sense_definition": "A town in New York, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "He grew up in the small town of <w>Chili</w> in New York state.",
                            "target_lang_translations": {
                                "ru": "Он вырос в маленьком городке <w>Чили</w> в штате Нью-Йорк.",
                                "zh": "他在纽约州的一个叫<w>奇利</w>的小镇长大。"
                            }
                        },
                        {
                            "text": "The local council of <w>Chili</w> announced plans for a new park.",
                            "target_lang_translations": {
                                "ru": "Местный совет <w>Чили</w> объявил о планах создания нового парка.",
                                "zh": "<w>奇利</w>当地议会宣布了新建公园的计划。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
