                "senses": [
                    {
                        "sense_id": "119bbffb-d41c-3b88-8ed4-7a6c799a5c37",
                        "entry_id": "a8407cf7-3be2-3d0c-8922-c1645c58bd7e",
                        "glosses": [
                            "The quality of being acute or pointed"
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "b37f6948-47d6-42e6-b416-04dd501e8db5",
                                "sense_id": "119bbffb-d41c-3b88-8ed4-7a6c799a5c37",
                                "text": "the acuteness of an angle"
                            }
                        ]
                    },
                    {
                        "sense_id": "9152bc69-51f6-3fec-991e-0a71743a0304",
                        "entry_id": "a8407cf7-3be2-3d0c-8922-c1645c58bd7e",
                        "glosses": [
                            "The faculty of precise discernment or perception; sensitiveness"
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "9ac99ae6-9ca3-4717-8488-378fbaf98f62",
                                "sense_id": "9152bc69-51f6-3fec-991e-0a71743a0304",
                                "text": "By acuteness of feeling, we perceive small objects or slight impressions."
                            },
                            {
                                "example_id": "a96916b4-5068-485b-9bb0-3e4f62eb165f",
                                "sense_id": "9152bc69-51f6-3fec-991e-0a71743a0304",
                                "text": "By acuteness of intellect, we discern nice distinctions."
                            }
                        ]
                    },
                    {
                        "sense_id": "7484e8f9-d5f2-33d8-bb94-8cf74b4888b3",
                        "entry_id": "a8407cf7-3be2-3d0c-8922-c1645c58bd7e",
                        "glosses": [
                            "Shrillness; high pitch; – said of sounds."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "eb37b887-97d2-39f8-b979-75d0810dd780",
                        "entry_id": "a8407cf7-3be2-3d0c-8922-c1645c58bd7e",
                        "glosses": [
                            "Violence of a disease, which brings it speedily to a crisis."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "c7df6918-f27c-4da0-96c4-fdc544500358",
                                "sense_id": "eb37b887-97d2-39f8-b979-75d0810dd780",
                                "text": "At the time, I set it down to some idiosyncratic, personal distaste, and merely wondered at the acuteness of the symptoms; but I have since had reason to believe the cause to lie much deeper in the nature of man, and to turn on some nobler hinge than the principle of hatred."
                            }
                        ]
                    },
                    {
                        "sense_id": "8cf062a5-5a07-34d0-8a05-7af769309f2d",
                        "entry_id": "a8407cf7-3be2-3d0c-8922-c1645c58bd7e",
                        "glosses": [
                            "Shrewdness, quickness of mind"
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af2b258e-ecd4-4948-96a0-eb1b819f0c6a",
                        "source_entry_id": "a8407cf7-3be2-3d0c-8922-c1645c58bd7e",
                        "source_sense_description": "violence of a disease",
                        "target_lang_word": "Akuität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akuität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "80ea2204-1aee-31a7-871a-07ad8352e282",
                                        "entry_id": "792db2fc-d44f-31a4-9153-aa8461fdda9b",
                                        "glosses": [
                                            "Eigenschaft einer Krankheit, schnell (und heftig) (akut) zu verlaufen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99d1ba98-81de-4646-9d43-b0168d039ea7",
                                                "sense_id": "80ea2204-1aee-31a7-871a-07ad8352e282",
                                                "text": "„Das Syndrom wird also bestimmt durch vorgegebene individuale Besonderheiten einerseits und die Akuität und Intensität der krankhaften Störung andererseits.“"
                                            },
                                            {
                                                "example_id": "33a597ce-b2a2-4f1f-8fc3-08f68a1faeda",
                                                "sense_id": "80ea2204-1aee-31a7-871a-07ad8352e282",
                                                "text": "„Erst in den letzten Jahren beginnt sich ein vor allen Dingen von Gilliam und Sontheimer vorgeschlagenes Einteilungsprinzip durchzusetzen, das die Hautmanifestationen der Erkrankung nach ihrer Lokalisation, Morphologie und Akuität differenziert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
