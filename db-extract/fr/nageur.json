                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b392e20-cfc3-46f1-8307-af7eba488a31",
                                                "sense_id": "5c8cf4f5-e29a-3a16-9320-9a9490cc7dd4",
                                                "text": "Die Wettkämpfe der Schwimmer versprechen spannend zu werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9e460871-6c4e-389c-8a81-3a0822d1a7c6",
                                        "entry_id": "c82c67c4-4fc2-3fa0-82e2-903df903787c",
                                        "glosses": [
                                            "ein Auftriebskörper"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef8d35bf-18be-4d1f-a296-2a3df17d473b",
                                                "sense_id": "9e460871-6c4e-389c-8a81-3a0822d1a7c6",
                                                "text": "Zwei Schwimmer geben dem Wasserflugzeug den nötigen Auftrieb."
                                            },
                                            {
                                                "example_id": "eacbb05e-335d-40e8-9dab-1abad3c23285",
                                                "sense_id": "9e460871-6c4e-389c-8a81-3a0822d1a7c6",
                                                "text": "„Der Schwimmer hüpfte hin und wieder an die Oberfläche, und die Leine wurde schlaff.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92c96ac6-f204-4d91-b30f-9b1f81b8726b",
                        "source_entry_id": "81b579c2-45e4-310a-b1e0-7feda702c91c",
                        "target_lang_word": "Schwimmerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwimmerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89ea6e6d-3201-36c6-981c-d3db2f408f9e",
                                        "entry_id": "41d1d5f4-0470-3827-b7a7-786c792cad29",
                                        "glosses": [
                                            "weibliche Person, die den Schwimmsport ausübt oder die schwimmen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4b92c0c-da2f-47e7-ad80-5c4df70e500d",
                                                "sense_id": "89ea6e6d-3201-36c6-981c-d3db2f408f9e",
                                                "text": "„Das Schwimmen darf geübten Schwimmerinnen erlaubt werden; nur sollen sie mit diesem Vergnügen erst beginnen, wenn die Jahreszeit so weit vorgeschritten ist, daß sich das Wasser auf wenigstens 15°–16° R [Grad Réaumur] erwärmt hat; ….“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
