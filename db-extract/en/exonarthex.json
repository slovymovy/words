                        "entry_id": "5acc57a4-7b2c-3cea-8da1-1778acd118fa",
                        "glosses": [
                            "The space anterior to the narthex of a church, sometimes roofed-over as with a porch, but more often an enclosed courtyard; in antiquity, the courtyard where catechumens were permitted to be close to the Eucharist, but forbidden to see it celebrated."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25dc83b9-58dd-4b30-a260-50704770c299",
                                "sense_id": "f4039215-07e5-30f9-bf9f-f9e73b4bfd73",
                                "text": "The exonarthex is of inferior workmanship, and has been thought by some of later date than the rest of the church; but there seems no ground for this belief."
                            }
                        ]
                    }
                ],
