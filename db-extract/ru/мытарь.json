                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52cf75b5-006c-41b1-abc7-48f6c0eddc22",
                                "sense_id": "a9bec364-f41d-38f4-af19-1fbb76540f28",
                                "text": "два человека вошли в храм помолиться: один фарисей, а другой мытарь."
                            }
                        ]
                    },
                    {
                        "sense_id": "e168e348-cb8a-38a3-bf68-a62a02848d0e",
                        "entry_id": "fc5b99ec-d1c0-3fb7-91e9-c852cc0ff891",
