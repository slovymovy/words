                                        "glosses": [
                                            "Offensive or repulsive; arousing disgust or aversion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34124864-1f91-48e1-a9f0-9f5e86664b1f",
                                                "sense_id": "ba00dfba-3896-3474-975b-c8e3d2e3e60f",
                                                "text": "Repugnant is a creature who would squander the ability to lift an eye to heaven conscious of his fleeting time here"
