{
    "word_family": [
        "inherit",
        "inheritance",
        "inheritable",
        "disinherit",
        "disinheritance"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9d8bb855-4245-3039-a455-9ab335ec65de",
                    "sense_definition": "A person who receives money, property, or a title from someone who has died; an heir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "succession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was named as the sole <w>inheritor</w> of her grandfather's vast estate.",
                            "target_lang_translations": {
                                "de": "Sie wurde als die alleinige <w>Erbin</w> des riesigen Vermögens ihres Großvaters eingesetzt."
                            }
                        },
                        {
                            "text": "As the primary <w>inheritors</w> of this tradition, we must work to preserve it.",
                            "target_lang_translations": {
                                "de": "Als die wesentlichen <w>Erben</w> dieser Tradition müssen wir daran arbeiten, sie zu bewahren."
                            }
                        }
                    ],
                    "synonyms": [
                        "heir",
                        "beneficiary",
                        "successor"
                    ],
                    "common_phrases": [
                        "sole inheritor",
                        "rightful inheritor"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person, die nach dem Tod von jemandem Geld, Eigentum oder einen Titel erhält; ein Erbe oder Nachfolger."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Erbe",
                                "target_lang_sense_clarification": "männlich, Nachlass oder Tradition"
                            },
                            {
                                "target_lang_word": "Erbin",
                                "target_lang_sense_clarification": "weiblich, Nachlass oder Tradition"
                            },
                            {
                                "target_lang_word": "Nachfolger",
                                "target_lang_sense_clarification": "im übertragenen Sinne, bspw. einer Tradition"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "442eb21b-9257-3609-8598-c85640c44098",
                    "sense_definition": "A class or component that derives attributes or behaviors from another through object-oriented inheritance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The subclass acts as an <w>inheritor</w> of all public methods from the parent class.",
                            "target_lang_translations": {
                                "de": "Die Subklasse agiert als <w>abgeleitete Klasse</w>, die alle öffentlichen Methoden der Elternklasse erbt."
                            }
                        },
                        {
                            "text": "Each <w>inheritor</w> overrides the default behavior defined in the base interface.",
                            "target_lang_translations": {
                                "de": "Jede <w>abgeleitete Klasse</w> überschreibt das im Basisschnittstellen-Design definierte Standardverhalten."
                            }
                        }
                    ],
                    "synonyms": [
                        "derived class",
                        "subclass"
                    ],
                    "antonyms": [
                        "base class",
                        "superclass"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Klasse oder Komponente, die Attribute oder Verhalten durch objektorientierte Vererbung von einer anderen übernimmt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "abgeleitete Klasse",
                                "target_lang_sense_clarification": "in der Programmierung"
                            },
                            {
                                "target_lang_word": "Unterklasse",
                                "target_lang_sense_clarification": "Subklasse in der Programmierung"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}