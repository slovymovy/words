                                "target_senses": [
                                    {
                                        "sense_id": "a7995312-18ea-3a43-a367-7706194f07c7",
                                        "entry_id": "0569fa79-68a8-345d-8082-c916e514b532",
                                        "glosses": [
                                            "One who saws timber, especially in a sawpit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "084af09e-b67b-3297-a6ff-9112a796e67c",
                                        "entry_id": "0569fa79-68a8-345d-8082-c916e514b532",
                                        "glosses": [
                                            "A large trunk of a tree brought down by the force of a river's current."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "375e5aa6-a082-459e-9b71-e5a567cb90c2",
                                                "sense_id": "084af09e-b67b-3297-a6ff-9112a796e67c",
                                                "text": "‘A’most used-up I am, I do declare!’ she observed. ‘The jolting in the cars is pretty nigh as bad as if the rail was full of snags and sawyers.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ef41ee5-e769-3ef7-82ef-34e29b0f369c",
                                        "entry_id": "0569fa79-68a8-345d-8082-c916e514b532",
                                        "glosses": [
                                            "A beetle, mostly in the genus Monochamus, that lives and feeds on trees, including timber."
                                        ],
