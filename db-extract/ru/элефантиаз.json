                "senses": [
                    {
                        "sense_id": "c132e746-7caf-363a-a1ec-8f7fb892f9d0",
                        "entry_id": "566c09ac-432a-3d08-ab80-db3e2a86cf59",
                        "glosses": [
                            "мед. необратимое, постепенно прогрессирующее утолщение кожи и подкожной клетчатки при длительных застоях лимфы и расширении лимфатических сосудов, приводящее к увеличению органа; слоновость"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e55df21-e55b-44b7-ac4e-78554f5cccf1",
                                "sense_id": "c132e746-7caf-363a-a1ec-8f7fb892f9d0",
                                "text": "В тропических и субтропических странах широко распространена тяжелая болезнь ― слоновость, или элефантиаз, ― стойкое увеличение размеров отдельных частей тела."
                            }
                        ]
                    }
                ],
                "translations": [
