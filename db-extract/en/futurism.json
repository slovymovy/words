                "entry_id": "e68c559e-8f6b-3557-9ee7-de437a1bbd75",
                "word": "futurism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "606f6884-67c4-441b-a9ea-0a096700bfa2",
                        "entry_id": "e68c559e-8f6b-3557-9ee7-de437a1bbd75",
                        "tags": [
                            "plural"
                        ],
                        "form": "futurisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "04143c35-df9d-3dd5-a9c7-0b96316366b5",
                        "entry_id": "e68c559e-8f6b-3557-9ee7-de437a1bbd75",
                        "glosses": [
                            "An early 20th century avant-garde art movement focused on speed, the mechanical, and the modern, which took a deeply antagonistic attitude to traditional artistic conventions."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c85be00e-457b-4564-a1ed-8d17cd1378b1",
                                "sense_id": "04143c35-df9d-3dd5-a9c7-0b96316366b5",
                                "text": "Suffice it to say that Futurism has a gratifying dislike both of Liberal politics and Christian morals; I say gratifying because, however unfortunately the cross and the cap of liberty have quarrelled, they are always united in the feeble hatred of such silly megalomaniacs as these. […"
                            }
                        ]
                    },
                    {
                        "sense_id": "e090522f-1ba1-3405-89ee-2a522ce3e81d",
                        "entry_id": "e68c559e-8f6b-3557-9ee7-de437a1bbd75",
                        "glosses": [
                            "The study and prediction of possible futures."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "60f76e23-349b-3c92-9f46-d63fb5bd0fcd",
                        "entry_id": "e68c559e-8f6b-3557-9ee7-de437a1bbd75",
                        "glosses": [
                            "The Jewish expectation of the messiah in the future."
                        ],
                        "tags": [
                            "Judaism",
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "73947055-6d8e-31b9-879d-3c341d6f1bc8",
                        "entry_id": "e68c559e-8f6b-3557-9ee7-de437a1bbd75",
                        "glosses": [
                            "Eschatological interpretations associating some Biblical prophecies with future events yet to be fulfilled, including the Second Coming."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dbfe0a47-d174-4be3-a13a-fb6624b7062a",
                        "source_entry_id": "e68c559e-8f6b-3557-9ee7-de437a1bbd75",
                        "source_sense_description": "art movement",
                        "target_lang_word": "futurismus",
