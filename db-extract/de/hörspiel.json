                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "77b10cd7-0143-4a1c-ba0d-e7a551a3f4a1",
                        "source_entry_id": "a7d3c11c-c07c-30e1-a9bb-7b8129057972",
                        "source_sense_id": "69d2752d-7bf5-329e-8b9b-d19a63dd719e",
                        "target_lang_word": "dramatique radio",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dramatique radio",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "206390bd-0681-3116-aa67-ec92203786a8",
                                        "entry_id": "ed5eadb3-2a09-3bc7-bb3e-f65181f0f38d",
                                        "glosses": [
                                            "Production radiophonique utilisant, en plus des procédés littéraires du genre théâtral, les moyens propres à la radio pour conter une histoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "288757eb-d689-4d87-b786-ba48b1beed57",
                                                "sense_id": "206390bd-0681-3116-aa67-ec92203786a8",
                                                "text": "La dramatique radio tient de la « nature morte », elle recourt aux choses immobiles pour fixer ses images. Certains objets font avancer l’histoire."
                                            },
                                            {
                                                "example_id": "bd76b078-d1a7-4a69-9ecd-f796a08a5886",
                                                "sense_id": "206390bd-0681-3116-aa67-ec92203786a8",
                                                "text": "« La Guerre des Mondes », un effet de réel qui a marqué l’histoire de la radio : L’œuvre littéraire de H. G. Wells qui a fait l’objet d’une dramatique radio écrite, lue par Orson Welles et interprétée par la troupe du Mercury Theatre, est un exemple emblématique de ce phénomène."
                                            },
                                            {
                                                "example_id": "d384e3b6-4388-4691-88f5-0d1046171d5e",
                                                "sense_id": "206390bd-0681-3116-aa67-ec92203786a8",
                                                "text": "En 1981, la radio KUSC de l’Université de Californie (une filiale de la célèbre chaîne publique américaine NPR) diffusait le tout premier épisode d’une dramatique radio basée sur le populaire film de George Lucas, Star Wars."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
