                                                "example_id": "330af75d-93ac-4d72-be3b-a951674c3667",
                                                "sense_id": "a7d69eb2-54d5-3847-b0c8-d58962ec080b",
                                                "text": "Игорь Васильевич свернул с главной дорожки, обогнул двухэтажное здание, поднялся по пожарной лестнице на чердак."
                                            },
                                            {
                                                "example_id": "2da55768-8de6-4065-aab0-c0390496aa1b",
                                                "sense_id": "a7d69eb2-54d5-3847-b0c8-d58962ec080b",
                                                "text": "Лежу вечером, смотрю на луну и вспоминаю, как любил спать на нашем чердаке у окошка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab5f40ee-e18a-3b72-97b6-f39e9eae5cfa",
