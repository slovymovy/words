                    "target_lang_definitions": {
                        "ru": "Отработка действий или учебная тренировка, часто используемая в военной или аварийной подготовке для доведения навыков до автоматизма.",
                        "tr": "Genellikle askeri veya acil durum eğitimlerinde disiplinli tekrarlarla yapılan tatbikat veya pratik çalışması."
                    },
                    "translations": {
                        "ru": [
