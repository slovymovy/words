                "senses": [
                    {
                        "sense_id": "d3e4cf27-5cd0-3351-b84e-3a8e078f77c9",
                        "entry_id": "2aa70266-694f-3db7-8592-fb3a1d3bf013",
                        "glosses": [
                            "Unternehmen, das sich auf die Zucht/Vermehrung/Mast von Lachs spezialisiert hat; Fischzucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "580576d5-003c-4de1-990a-9c7aa5c72ee5",
                                "sense_id": "d3e4cf27-5cd0-3351-b84e-3a8e078f77c9",
                                "text": "„Die erste Lachsfarm, die in Schwimmkäfigen adulte Tiere für den Markt produzierte, wurde jedoch 1960 in Norwegen errichtet.“"
                            },
                            {
                                "example_id": "84d2f63c-f850-4fb0-8ba9-800bd1191094",
                                "sense_id": "d3e4cf27-5cd0-3351-b84e-3a8e078f77c9",
                                "text": "„Selbst in Norwegen gehen die Bestände an wildem Lachs drastisch zurück, weil die Lachse, wenn sie zum Laichen in die Flüsse schwimmen, durch Gebiete mit großen Lachsfarmen müssen.“"
                            },
                            {
                                "example_id": "dfe36603-de57-48a3-b48a-0a4fc48d8fe7",
                                "sense_id": "d3e4cf27-5cd0-3351-b84e-3a8e078f77c9",
                                "text": "„Doch die Hinweise, dass Lachsfarmen großen Schaden anrichten, häufen sich.“"
                            },
                            {
                                "example_id": "d4484cf6-b4d1-4511-98e4-617cd849e8d6",
                                "sense_id": "d3e4cf27-5cd0-3351-b84e-3a8e078f77c9",
                                "text": "„Natürlich haben wir in der Anlage auch nachgefragt, was der exakte Grund für die 100 Meter Abstandsregel von Lachsfarmen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
