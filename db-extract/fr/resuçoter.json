                        "glosses": [
                            "Suçoter à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd6f9ed4-8916-427e-889c-eff13fed08b0",
                                "sense_id": "54976f3c-6b40-38b3-adb9-3feed1278b13",
                                "text": "Antoine partage tout avec le labrador de belle maman : il suçote un peu son pain, qui le croque un peu, et il resuçote le pain !"
                            },
                            {
                                "example_id": "fcdffac6-9f69-4988-b222-775116807b43",
                                "sense_id": "54976f3c-6b40-38b3-adb9-3feed1278b13",
                                "text": "Ils s'y reprenaient à plusieurs fois avant de resuçoter, mais maintenant, ça ne les dérange plus du tout !"
                            },
                            {
                                "example_id": "d251a038-4cb2-4ace-a2a6-bc01ec8c730b",
                                "sense_id": "54976f3c-6b40-38b3-adb9-3feed1278b13",
                                "text": "Je suis en train de me suçoter le doigt en lisant ça... là je tape sur le clavier et je compte me resuçoter le doigt direct après"
                            }
                        ]
                    }
