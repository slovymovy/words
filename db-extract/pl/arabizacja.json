                                        "sense_id": "be024512-518a-3708-b7de-64162d1491de",
                                        "entry_id": "955e2fe1-80e1-33d7-b2a5-b9f40d908f59",
                                        "glosses": [
                                            "proces waarbij de Arabische taal, cultuur en religie in een bepaalde samenleving steeds meer invloed krijgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46e573e7-3e33-4588-af52-f46c3a4d280b",
                                                "sense_id": "be024512-518a-3708-b7de-64162d1491de",
                                                "text": ",,Hij heeft veel meegemaakt. Tijdens de arabisering van Irak zijn veel Koerden verbannen en vermoord. Veel vrienden van hem zijn omgekomen. Hier in Nederland begon Fuad meteen weer met zijn activiteiten, gericht tegen het regime van Saddam Hoessein”, vertelde Caroline Montessori destijds, vanaf hun thuisbasis in Amstelveen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96812a94-3d4f-4f3f-9abc-df9e643d84dc",
                        "source_entry_id": "64ddaa0f-97e2-3d14-a742-078bd168b570",
                        "source_sense_id": "7eefe26f-2aed-3cdb-98d5-c4cdc7480bf6",
