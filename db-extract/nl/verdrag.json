                "translations": [
                    {
                        "translation_id": "4739aef0-e155-4aa0-90a9-37ccc2c34950",
                        "source_entry_id": "bb8bb371-72f2-3473-9adb-41f24a6083de",
                        "source_sense_id": "564b60d0-d8a7-39c1-8752-4a155869ae81",
                        "source_sense_description": "een wettelijk wederzijds bindende overeenkomst tussen twee of meer staten",
                        "target_lang_word": "Vertrag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vertrag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62056a88-8f68-3c69-9be1-35792e80e6ab",
                                        "entry_id": "c840b545-8c39-33eb-af93-e2e6064a9c9a",
                                        "glosses": [
                                            "rechtlich bindende Vereinbarung zwischen mindestens zwei verschiedenen Partnern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b8567a6-ffbe-43d3-b235-0e04d357c7f6",
                                                "sense_id": "62056a88-8f68-3c69-9be1-35792e80e6ab",
                                                "text": "Auch wenn wir Freunde sind, haben wir einen Vertrag aufgesetzt, als ich Peters Auto kaufte."
                                            },
                                            {
                                                "example_id": "7cc73868-0f51-4c7b-960f-e3699cfa55cd",
                                                "sense_id": "62056a88-8f68-3c69-9be1-35792e80e6ab",
                                                "text": "„Daphne beklagte sich über ihren Vertrag und über die Nebenrechte.“"
                                            },
                                            {
                                                "example_id": "dff64fe9-0ec0-430e-9fab-60bd57083832",
                                                "sense_id": "62056a88-8f68-3c69-9be1-35792e80e6ab",
                                                "text": "„Bei Milch, Käse und Joghurt gibt es längerfristige Verträge, nur beim Streichfett verhandeln Molkereien und Handel ihre Kontrakte monatlich neu.“"
                                            },
                                            {
                                                "example_id": "27686aeb-feab-44d3-8268-b84586abd2e8",
                                                "sense_id": "62056a88-8f68-3c69-9be1-35792e80e6ab",
                                                "text": "„Er wurde von Kapitän Johnston aufgenommen, unterschrieb den Vertrag und schloss sich uns am folgenden Tag in Seemannsplünnen an.“"
                                            },
                                            {
                                                "example_id": "49bedcfd-a4e6-40d4-8fd3-0d318dad6001",
                                                "sense_id": "62056a88-8f68-3c69-9be1-35792e80e6ab",
                                                "text": "„Remarque hat einen sehr lukrativen Vertrag abgeschlossen, und Alfred Scherz hofft, den Bestsellerautor langfristig an sein Haus binden zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aceee5f9-9187-40fb-824b-5fe437de0964",
                        "source_entry_id": "bb8bb371-72f2-3473-9adb-41f24a6083de",
                        "source_sense_id": "564b60d0-d8a7-39c1-8752-4a155869ae81",
                        "source_sense_description": "een wettelijk wederzijds bindende overeenkomst tussen twee of meer staten",
                        "target_lang_word": "treaty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "treaty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab6de3f6-0f48-3046-a148-a81525e957b5",
                                        "entry_id": "f268cdb3-a910-33c0-b821-fff11ae618f6",
                                        "glosses": [
                                            "To get into (a specific situation) through a treaty."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e59299b-7c85-3508-add2-110e49de7e6f",
                                        "entry_id": "f268cdb3-a910-33c0-b821-fff11ae618f6",
                                        "glosses": [
                                            "To enter into a treaty."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "treaty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e23fe94d-6e52-3f3b-9744-61b5a98366bc",
                                        "entry_id": "15519895-d9f3-33c8-b716-1b0b507f3102",
                                        "glosses": [
                                            "A formal binding agreement concluded by subjects of international law, namely, states and international organizations; a convention, a pact."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74c477f1-3978-441e-9457-9fa96278af8c",
                                                "sense_id": "e23fe94d-6e52-3f3b-9744-61b5a98366bc",
                                                "text": "to sign a peace treaty"
                                            },
                                            {
                                                "example_id": "7bc68dee-7bc3-4a39-a8bb-6f5850f8ead7",
                                                "sense_id": "e23fe94d-6e52-3f3b-9744-61b5a98366bc",
                                                "text": "to write up a treaty touching climate change"
                                            },
                                            {
                                                "example_id": "fe00dd9c-7b70-4dd8-b70a-a8222833d3ad",
                                                "sense_id": "e23fe94d-6e52-3f3b-9744-61b5a98366bc",
                                                "text": "[T]he Duke of Britaine hauing beene an Hoſte, and a kind of Parent or Foſter-father to the King, in his tenderneſſe of age, and vveakneſſe of fortune, did looke for at this time from King Henry (the renovvned King of England) rather braue Troupes for his Succours, then a vaine Treatie of Peace."
                                            },
                                            {
                                                "example_id": "0eba4478-2c1b-44c3-8573-6dd5a8b3330a",
                                                "sense_id": "e23fe94d-6e52-3f3b-9744-61b5a98366bc",
                                                "text": "Soon after his [James VI and I's] coming to the Crown of England he entered into ſecret treaties with Spain, in order to the forcing the States to a peace: […]"
                                            },
                                            {
                                                "example_id": "c6202a3b-a1cb-46b8-82be-9cb33a03eddb",
                                                "sense_id": "e23fe94d-6e52-3f3b-9744-61b5a98366bc",
                                                "text": "Exportation was encouraged ſometimes by dravvbacks, ſometimes by bounties, ſometimes by advantageous treaties of commerce with foreign ſtates, and ſometimes by eſtabliſhment of colonies in diſtant countries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a89a407a-29a0-3931-b7ad-9d0dc8e4cd5f",
                                        "entry_id": "15519895-d9f3-33c8-b716-1b0b507f3102",
                                        "glosses": [
                                            "Chiefly in in treaty: discussions or negotiations in order to reach an agreement."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07a15c7d-36e3-4c52-8c2a-1972d5783ae6",
                                                "sense_id": "a89a407a-29a0-3931-b7ad-9d0dc8e4cd5f",
                                                "text": "To a meeting of the executors of late Viscˢˢᵉ Mordaunt's estate, to consider of the sale of Parsons Greene; being in treaty with Mr. Loftus, and to settle the halfe yeare's account."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1203fa2f-cd73-374e-b06b-683e45e642f7",
                                        "entry_id": "15519895-d9f3-33c8-b716-1b0b507f3102",
                                        "glosses": [
                                            "Chiefly in private treaty: an agreement or settlement reached following negotiations; a compact, a contract, a covenant."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6cebeafa-530c-3f28-bf31-53d715fcffda",
                                        "entry_id": "15519895-d9f3-33c8-b716-1b0b507f3102",
                                        "glosses": [
                                            "The manner or process of treating someone or something; treatment; also, the manner in which someone or something acts or behaves; behaviour."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b90b0097-f717-4453-a1d1-8793af455299",
                                                "sense_id": "6cebeafa-530c-3f28-bf31-53d715fcffda",
                                                "text": "Hoſ[t]. They call me Good-ſtock. / Lov[el]. Sir, and you confeſſe it, / Both i'your language, treaty, and your bearing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db038a91-761e-3159-9ebf-d34a5424eb8c",
                                        "entry_id": "15519895-d9f3-33c8-b716-1b0b507f3102",
                                        "glosses": [
                                            "The addressing or consideration of a subject; discussion, treatment."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f3fa5dc-08e6-3054-8e0a-0d901453864d",
                                        "entry_id": "15519895-d9f3-33c8-b716-1b0b507f3102",
                                        "glosses": [
                                            "A formal, systematic discourse on some subject; a treatise."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "decfbf90-a6f1-4cf5-b880-47205ad856bb",
                                                "sense_id": "8f3fa5dc-08e6-3054-8e0a-0d901453864d",
                                                "text": "And though Galen doth ſometime nibble at Moſes, and beſide the Apoſtate Chriſtian, ſome Heathens have queſtioned his Philoſophicall part or treaty of the Creation: Yet is there ſurely no reaſonable Pagan, that will not admire the rationall and well grounded precepts of Chriſt; […]"
                                            },
                                            {
                                                "example_id": "00d4b223-cc39-4dd6-9363-075f11eb41b2",
                                                "sense_id": "8f3fa5dc-08e6-3054-8e0a-0d901453864d",
                                                "text": "The Miniſters in Holland did upon this occaſion ſhew a very particular violence. In their ſermons, and in ſome printed treaties, they charged the Judges with corruption, who had carried the ſentence no farther than to baniſhment: And compared the fate of the De Wits to Haman’s."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80c6adb3-e9b3-3ad6-8722-342df9b1820f",
                                        "entry_id": "15519895-d9f3-33c8-b716-1b0b507f3102",
                                        "glosses": [
                                            "An act of beseeeching or entreating; an entreaty, a plea, a request."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aea2454c-98e1-4a7b-8abe-4a673574f411",
                                                "sense_id": "80c6adb3-e9b3-3ad6-8722-342df9b1820f",
                                                "text": "Now I must / To the young man ſend humble Treaties, dodge / And palter in the ſhifts of lovvnes, vvho / VVith halfe the bulke o' th' vvorld plaid as I pleas'd, / Making, and marring Fortunes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
