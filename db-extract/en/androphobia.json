                                "example_id": "2b5bff20-b367-403c-b270-48f4b2c28a5a",
                                "sense_id": "53acd220-fb9a-38f4-81e4-0de8e8d6ea62",
                                "text": "In the case of androphobia, a reaction can occur when exposed to men or masculinity, in anticipation of such experiences, or even hearing words related to the male sex."
                            }
                        ]
