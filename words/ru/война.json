    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "79c03d83-fd79-3ad3-8ba3-5bfa36e464d5",
                    "sense_definition": "Вооружённая борьба и боевые действия между государствами, народами или общественными группами.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "military_conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта страшная <w>война</w> длилась четыре долгих года.",
                            "target_lang_translations": {
                                "en": "This terrible <w>war</w> lasted four long years.",
                                "zh": "这场可怕的<w>战争</w>持续了四年之久。"
                            }
                        },
                        {
                            "text": "Правительство страны решило не объявлять <w>войну</w> соседям.",
                            "target_lang_translations": {
                                "en": "The country's government decided not to declare <w>war</w> on its neighbors.",
                                "zh": "该国政府决定不对邻国宣<w>战</w>。"
                            }
                        },
                        {
                            "text": "Вторая мировая <w>война</w> изменила ход истории.",
                            "target_lang_translations": {
                                "en": "The Second World <w>War</w> changed the course of history.",
                                "zh": "第二次世界<w>大战</w>改变了历史进程。"
                            }
                        }
                    ],
                    "synonyms": [
                        "конфликт"
                    ],
                    "antonyms": [
                        "мир"
                    ],
                    "common_phrases": [
                        "мировая война",
                        "гражданская война",
                        "объявить войну",
                        "начало войны"
                    ],
                    "target_lang_definitions": {
                        "en": "Armed struggle and combat operations between states, peoples, or social groups.",
                        "zh": "国家、民族或社会群体之间进行的武装斗争和军事行动。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "war",
                                "target_lang_sense_clarification": "armed conflict"
                            },
                            {
                                "target_lang_word": "warfare",
                                "target_lang_sense_clarification": "activity of fighting"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "战争",
                                "target_lang_sense_clarification": "武装冲突"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b78c0c4-0c4a-33a3-938a-792d7f74a682",
                    "sense_definition": "Острый конфликт или борьба в политической, экономической или информационной сферах без применения оружия.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Торговая <w>война</w> привела к повышению цен на товары.",
                            "target_lang_translations": {
                                "en": "The trade <w>war</w> led to an increase in goods prices.",
                                "zh": "贸易<w>战</w>导致了商品价格上涨。"
                            }
                        },
                        {
                            "text": "Холодная <w>война</w> между державами закончилась в прошлом веке.",
                            "target_lang_translations": {
                                "en": "The Cold <w>War</w> between the powers ended in the last century.",
                                "zh": "大国之间的冷<w>战</w>在上个世纪结束了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "противостояние",
                        "борьба",
                        "вражда"
                    ],
                    "antonyms": [
                        "мир",
                        "дружба"
                    ],
                    "common_phrases": [
                        "холодная война",
                        "информационная война",
                        "торговая война"
                    ],
                    "target_lang_definitions": {
                        "en": "Acute conflict or struggle in political, economic, or information spheres without the use of weapons.",
                        "zh": "在政治、经济或信息领域中，不使用武器的激烈冲突或斗争。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "war",
                                "target_lang_sense_clarification": "non-military conflict"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "战争",
                                "target_lang_sense_clarification": "非军事冲突"
                            },
                            {
                                "target_lang_word": "对抗",
                                "target_lang_sense_clarification": "激烈的竞争或对立"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdf450e9-cea1-3da8-b64c-b62262a600cc",
                    "sense_definition": "Активные действия, направленные на уничтожение или искоренение чего-либо негативного.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врачи ведут ежедневную <w>войну</w> с опасными болезнями.",
                            "target_lang_translations": {
                                "en": "Doctors wage a daily <w>war</w> against dangerous diseases.",
                                "zh": "医生们每天都在与危险的疾病进行<w>斗争</w>。"
                            }
                        },
                        {
                            "text": "Государство объявило <w>войну</w> коррупции и преступности.",
                            "target_lang_translations": {
                                "en": "The state declared <w>war</w> on corruption and crime.",
                                "zh": "政府向腐败和犯罪宣<w>战</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "борьба"
                    ],
                    "common_phrases": [
                        "война с бедностью",
                        "война с коррупцией"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in media or speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Active actions aimed at destroying or eradicating something negative.",
                        "zh": "旨在消除或根除某种负面事物的积极行动。"
                    },
                    "translations": {
