{
    "word_family": [
        "spatter",
        "spit"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4ba6aa32-b853-395d-90f2-43b74502273d",
                    "sense_definition": "simple past and past participle of <w>spit</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "spit_past",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>spat</w> the bitter seeds onto the ground after tasting the fruit.",
                            "target_lang_translations": {
                                "ru": "Попробовав фрукт, он <w>выплюнул</w> горькие семена на землю.",
                                "zh": "尝过水果后，他把苦涩的种子<w>吐</w>到了地上。"
                            }
                        },
                        {
                            "text": "The angry camel <w>spat</w> at the tourists who got too close to its face.",
                            "target_lang_translations": {
                                "ru": "Разозленный верблюд <w>плюнул</w> в туристов, которые подошли слишком близко к его морде.",
                                "zh": "那头愤怒的骆驼向靠得太近的游客<w>吐</w>了口水。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "прошедшее время и причастие прошедшего времени от глагола spit (плевать)",
                        "zh": "动词 spit 的过去式和过去分词"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плюнул",
                                "target_lang_sense_clarification": "прошедшее время"
                            },
                            {
                                "target_lang_word": "выплюнул",
                                "target_lang_sense_clarification": "прошедшее время, об объекте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吐",
                                "target_lang_sense_clarification": "吐出物体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10f0d373-570a-36c4-9497-1976717db47b",
                    "sense_definition": "To quarrel or argue pettily for a short period of time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quarrel_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two neighbors often <w>spat</w> over where the property line actually begins.",
                            "target_lang_translations": {
                                "ru": "Двое соседей часто <w>ссорились</w> из-за того, где на самом деле проходит граница участка.",
                                "zh": "那两个邻居经常为了房产界线到底从哪儿开始而<w>拌嘴</w>。"
                            }
                        },
                        {
                            "text": "They were <w>spatting</w> about whose turn it was to do the dishes.",
                            "target_lang_translations": {
                                "ru": "Они <w>препирались</w> о том, чья очередь мыть посуду.",
                                "zh": "他们正在为该轮到谁洗碗而<w>争执</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tiff",
                        "squabble",
                        "bicker",
                        "quarrel",
                        "wrangle",
                        "argue",
                        "quibble",
                        "row"
                    ],
                    "antonyms": [
                        "agree",
                        "concur"
                    ],
                    "target_lang_definitions": {
                        "ru": "ссориться или спорить по пустякам в течение короткого времени",
                        "zh": "指短时间内为琐事争吵或拌嘴"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ссориться",
                                "target_lang_sense_clarification": "вступать в конфликт"
                            },
                            {
                                "target_lang_word": "браниться",
                                "target_lang_sense_clarification": "выражать недовольство"
                            },
                            {
                                "target_lang_word": "переругиваться",
                                "target_lang_sense_clarification": "обмениваться колкостями"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拌嘴",
                                "target_lang_sense_clarification": "小规模争吵"
                            },
                            {
                                "target_lang_word": "争执",
                                "target_lang_sense_clarification": "发生口角"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32228ba8-019b-3151-abf6-2d09f70156fd",
                    "sense_definition": "To strike something with a light, spattering sound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "strike_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy raindrops <w>spatted</w> against the windowpane all through the night.",
                            "target_lang_translations": {
                                "ru": "Тяжелые капли дождя всю ночь <w>барабанили</w> по оконному стеклу.",
                                "zh": "整整一夜，沉重的雨点都在窗玻璃上<w>拍打</w>作响。"
                            }
                        },
                        {
                            "text": "He heard the sound of grease as it <w>spatted</w> onto the hot stove.",
                            "target_lang_translations": {
                                "ru": "Он услышал звук жира, когда тот <w>брызнул</w> на горячую плиту.",
                                "zh": "他听到了油脂<w>溅落</w>在热炉子上的声音。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "ударяться обо что-либо с легким, брызгающим звуком",
                        "zh": "指物体撞击表面时发出轻微的溅射声"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шлёпать",
                                "target_lang_sense_clarification": "издавать звук удара"
                            },
                            {
                                "target_lang_word": "барабанить",
                                "target_lang_sense_clarification": "о дожде"
                            },
                            {
                                "target_lang_word": "брызгать",
                                "target_lang_sense_clarification": "о каплях или жире"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拍打",
                                "target_lang_sense_clarification": "发出撞击声"
                            },
                            {
                                "target_lang_word": "溅落",
                                "target_lang_sense_clarification": "液体溅出并发出声音"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a711f127-cabd-3d98-a1fe-fb0325e414f8",
                    "sense_definition": "To produce or release spawn, specifically used in reference to shellfish.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shellfish_spawn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The oysters <w>spat</w> in the early summer when the water temperature reached its peak.",
                            "target_lang_translations": {
                                "ru": "Устрицы <w>метали икру</w> в начале лета, когда температура воды достигла своего пика.",
                                "zh": "当水温达到峰值时，牡蛎在初夏<w>产卵</w>。"
                            }
                        },
                        {
                            "text": "Biologists monitored the bay to see when the local mussels would <w>spat</w>.",
                            "target_lang_translations": {
                                "ru": "Биологи наблюдали за заливом, чтобы увидеть, когда местные мидии начнут <w>размножаться</w>.",
                                "zh": "生物学家监测着海湾，以观察当地的贻贝何时会<w>产卵</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "производить или выпускать икру (о моллюсках)",
                        "zh": "指贝类等软体动物产卵或排卵"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "метать икру",
                                "target_lang_sense_clarification": "о моллюсках"
                            },
                            {
                                "target_lang_word": "размножаться",
                                "target_lang_sense_clarification": "биологический процесс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "产卵",
                                "target_lang_sense_clarification": "生物繁殖行为"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "93ea1db8-070e-36aa-9a98-e04923e0eda3",
                    "sense_definition": "A brief, minor argument or a petty quarrel between people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quarrel_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The couple had a minor <w>spat</w> about what to eat for dinner.",
                            "target_lang_translations": {
                                "ru": "У пары произошла небольшая <w>размолвка</w> по поводу того, что съесть на ужин.",
                                "zh": "这对夫妇为了晚饭吃什么发生了小小的<w>口角</w>。"
                            }
                        },
                        {
                            "text": "It was just a trivial <w>spat</w> that was forgotten by the next morning.",
                            "target_lang_translations": {
                                "ru": "Это была всего лишь пустяковая <w>ссора</w>, о которой забыли к следующему утру.",
                                "zh": "那不过是一场琐碎的<w>拌嘴</w>，第二天早上就被遗忘了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tiff",
                        "squabble",
                        "bicker",
                        "quarrel",
                        "row"
                    ],
                    "antonyms": [
                        "agreement",
                        "harmony"
                    ],
                    "common_phrases": [
                        "trivial spat",
                        "vicious spat",
                        "minor spat"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "короткая, незначительная размолвка или мелкая ссора между людьми",
                        "zh": "指人与人之间短暂、轻微的争吵或口角"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размолвка",
                                "target_lang_sense_clarification": "легкая ссора"
                            },
                            {
                                "target_lang_word": "перепалка",
                                "target_lang_sense_clarification": "словесный спор"
                            },
                            {
                                "target_lang_word": "ссора",
                                "target_lang_sense_clarification": "небольшой конфликт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "口角",
                                "target_lang_sense_clarification": "小争执"
                            },
                            {
                                "target_lang_word": "拌嘴",
                                "target_lang_sense_clarification": "琐碎的争吵"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e7a07ae-d9fa-3166-89f3-f09924ff8c2a",
                    "sense_definition": "A cloth covering worn over the ankle and the upper part of a shoe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gentleman wore white <w>spats</w> over his polished black shoes for the gala.",
                            "target_lang_translations": {
                                "ru": "Для торжественного вечера джентльмен надел белые <w>гамаши</w> поверх начищенных черных туфель.",
                                "zh": "那位绅士在参加盛会时，在擦得锃亮的黑皮鞋上套了白色的<w>鞋罩</w>。"
                            }
                        },
                        {
                            "text": "Vintage costumes often include <w>spats</w> to replicate the fashion of the early twentieth century.",
                            "target_lang_translations": {
                                "ru": "Винтажные костюмы часто включают <w>гетры</w>, чтобы воссоздать моду начала двадцатого века.",
                                "zh": "复古服装通常包括<w>护腿</w>，以重现二十世纪初的时尚。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical fashion"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "тканевая накладка, надеваемая поверх щиколотки и верхней части обуви",
                        "zh": "一种覆盖在脚踝和鞋面上部的布制护套"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гамаши",
                                "target_lang_sense_clarification": "накладки на пуговицах"
                            },
                            {
                                "target_lang_word": "гетры",
                                "target_lang_sense_clarification": "защитные накладки"
                            },
                            {
                                "target_lang_word": "штиблеты",
                                "target_lang_sense_clarification": "исторические высокие гетры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鞋罩",
                                "target_lang_sense_clarification": "覆盖鞋面的保护套"
                            },
                            {
                                "target_lang_word": "护腿",
                                "target_lang_sense_clarification": "覆盖脚踝的装饰或保护物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a00d607-8e12-3e68-bb8d-49c5afa2e2fa",
                    "sense_definition": "A young or juvenile shellfish, such as an oyster, that has attached to a surface.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "shellfish_spawn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The oyster <w>spat</w> were carefully transferred to the growing beds in the estuary.",
                            "target_lang_translations": {
                                "ru": "Молодь устриц (<w>спат</w>) была осторожно перенесена на грядки для выращивания в эстуарии.",
                                "zh": "牡蛎<w>幼贝</w>被小心地转移到了河口的养殖床上。"
                            }
                        },
                        {
                            "text": "Farmers check the collectors weekly to see if any new <w>spat</w> have attached.",
                            "target_lang_translations": {
                                "ru": "Фермеры еженедельно проверяют коллекторы, чтобы увидеть, не прикрепились ли новые <w>личинки</w>.",
                                "zh": "农户每周检查收集器，看看是否有新的<w>幼贝</w>附着。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "oyster spat",
                        "spat fall"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "молодой моллюск (например, устрица), прикрепившийся к поверхности",
                        "zh": "指已附着在物体表面上的幼年贝类"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спат",
                                "target_lang_sense_clarification": "молодь устриц"
                            },
                            {
                                "target_lang_word": "личинка",
                                "target_lang_sense_clarification": "осевшая личинка моллюска"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "幼贝",
                                "target_lang_sense_clarification": "贝类幼体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3cad90b8-8ecf-33c7-adbf-1bacf7c4f603",
                    "sense_definition": "A piece of vehicle bodywork that covers the upper part of the rear tires.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "automotive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The classic car featured elegant rear wheel <w>spats</w> that improved its streamlined look.",
                            "target_lang_translations": {
                                "ru": "Классический автомобиль отличался элегантными <w>щитками</w> на задних колесах, которые улучшали его обтекаемый вид.",
                                "zh": "这辆经典汽车配有优雅的后<w>轮罩</w>，提升了其流线型外观。"
                            }
                        },
                        {
                            "text": "He decided to remove the <w>spats</w> to give the vehicle a more modern appearance.",
                            "target_lang_translations": {
                                "ru": "Он решил снять <w>обтекатели</w>, чтобы придать автомобилю более современный вид.",
                                "zh": "他决定拆掉<w>挡泥板</w>，让车看起来更现代。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fender skirt"
                    ],
                    "common_phrases": [
                        "wheel spat"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "деталь кузова автомобиля, закрывающая верхнюю часть задних колес",
                        "zh": "汽车车身上覆盖后轮上部的挡板"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щиток",
                                "target_lang_sense_clarification": "колесная арка"
                            },
                            {
                                "target_lang_word": "обтекатель",
                                "target_lang_sense_clarification": "для улучшения аэродинамики"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轮罩",
                                "target_lang_sense_clarification": "覆盖车轮的挡板"
                            },
                            {
                                "target_lang_word": "挡泥板",
                                "target_lang_sense_clarification": "车轮上方的覆盖件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59ac9458-8cdd-3d3a-b768-04fc5c74e443",
                    "sense_definition": "An obsolete astronomical unit of distance equal to one billion kilometers.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The distance was measured in <w>spats</w> in the old scientific journal from the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "В старом научном журнале девятнадцатого века расстояние измерялось в <w>спатах</w>.",
                                "zh": "在十九世纪的一本旧科学期刊中，距离是用<w>斯帕特</w>来衡量的。"
                            }
                        },
                        {
                            "text": "One <w>spat</w> represents a distance far greater than the span of our inner solar system.",
                            "target_lang_translations": {
                                "ru": "Один <w>спат</w> представляет собой расстояние, намного превышающее протяженность нашей внутренней солнечной системы.",
                                "zh": "一个<w>斯帕特</w>所代表的距离远大于我们内太阳系的范围。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "no longer in use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "устаревшая астрономическая единица расстояния, равная одному миллиарду километров",
                        "zh": "一种已废弃的天文距离单位，等于十亿公里"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спат",
                                "target_lang_sense_clarification": "единица измерения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "斯帕特",
                                "target_lang_sense_clarification": "已废弃的距离单位"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}