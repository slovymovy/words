        "fr-extract.jsonl": [
            {
                "entry_id": "ce50ead9-97bb-3eab-8d38-3fd8b1684be2",
                "word": "Pollux",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d8fb4f6c-b2f3-320b-a0ae-a9ab1b03ae8d",
                        "entry_id": "ce50ead9-97bb-3eab-8d38-3fd8b1684be2",
                        "glosses": [
                            "Frère divin de Castor, Hélène et Clytemnestre, fils de Zeus et Léda."
                        ],
                        "tags": [
                            "Anthroponyme"
                        ],
                        "examples": [
                            {
                                "example_id": "c1a28302-5056-44b1-a557-870050711688",
                                "sense_id": "d8fb4f6c-b2f3-320b-a0ae-a9ab1b03ae8d",
                                "text": "Je vois aussi Léda, l’épouse de Tyndare, Léda qui donna à ce héros deux fils magnanimes, Castor, habile à dompter les coursiers, et Pollux, si plein de force au pugilat."
                            }
                        ]
                    },
                    {
                        "sense_id": "7696a9aa-8fa4-330e-af93-ead300e48f21",
                        "entry_id": "ce50ead9-97bb-3eab-8d38-3fd8b1684be2",
                        "glosses": [
                            "Étoile de la constellation des Gémeaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bf1e9cb-8cbd-478b-8a0c-4aa5ba0cc048",
                                "sense_id": "7696a9aa-8fa4-330e-af93-ead300e48f21",
                                "text": "Castor est en fait un système très complexe, composé de six étoiles en orbite les unes autour des autres tandis que Pollux est une étoile géante."
                            }
                        ]
                    },
                    {
                        "sense_id": "00976151-c069-371e-807f-d5694579ff15",
                        "entry_id": "ce50ead9-97bb-3eab-8d38-3fd8b1684be2",
                        "glosses": [
                            "Satellite naturel de la planète Saturne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14d72c78-2cf4-4fb7-aedf-b4962bea1494",
                                "sense_id": "00976151-c069-371e-807f-d5694579ff15",
                                "text": "C’est le 21 octobre 2004 que la sonde Cassini-Huygens a photographié pour la première fois Pollux en orbite autour de Saturne."
                            }
                        ]
                    },
                    {
                        "sense_id": "54588ebb-c47b-3c20-846c-8f4fe89009af",
                        "entry_id": "ce50ead9-97bb-3eab-8d38-3fd8b1684be2",
                        "glosses": [
                            "Sommet de plus de 4,000 mètres des Alpes valaisannes, en Suisse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48a71416-b7b9-415a-9b27-3a09fba498c3",
                                "sense_id": "54588ebb-c47b-3c20-846c-8f4fe89009af",
                                "text": "Entre le Schalbetterfluh, au pied de Pollux, et le Breithorn, le glacier de Schwarz descend dans le glacier de Gorner."
                            }
                        ]
                    },
                    {
                        "sense_id": "7cd7db33-beee-3f7d-aff4-10d208afbb2b",
                        "entry_id": "ce50ead9-97bb-3eab-8d38-3fd8b1684be2",
                        "glosses": [
                            "Personnage canin de la série télévisée d’animation Le Manège enchanté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09d32119-8e58-4ab6-8236-0eae690bafa8",
                                "sense_id": "7cd7db33-beee-3f7d-aff4-10d208afbb2b",
                                "text": "Il a beau avoir 40 ans, Pollux est toujours aussi maladroit."
                            }
                        ]
                    }
                ],
