                ],
                "senses": [
                    {
                        "sense_id": "15432aa1-922b-3a3e-9de9-74d498f08ff3",
                        "entry_id": "a62ada36-bd12-3f79-afd3-ce6eb679ce29",
                        "glosses": [
                            "Type de consommation collaborative qui réduit la distinction entre producteur et consommateur."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "06b35ca5-4f01-4685-83c9-86447fd8c8ec",
                                "sense_id": "15432aa1-922b-3a3e-9de9-74d498f08ff3",
                                "text": "Le prosumérisme et les modèles économiques « intelligents » axés sur les données entraînent des changements qui répondent mieux aux demandes des consommateurs en matière d'économie, de transparence et de minimisation de l'empreinte environnementale."
                            },
                            {
                                "example_id": "75287eee-e0fb-4ec0-acce-1ed67b3c770c",
                                "sense_id": "15432aa1-922b-3a3e-9de9-74d498f08ff3",
                                "text": "Cela correspond au phénomène général du prosumérisme : les gens veulent produire et consommer du contenu en même temps."
                            },
                            {
                                "example_id": "8c64bbc0-80d6-4558-b922-a5ff1e82f988",
                                "sense_id": "15432aa1-922b-3a3e-9de9-74d498f08ff3",
                                "text": "La mise en œuvre de la stratégie nationale d’indépendance énergétique permet de renforcer la sécurité énergétique et la compétitivité du pays et de promouvoir le prosumérisme énergétique."
                            }
                        ]
                    }
                ],
