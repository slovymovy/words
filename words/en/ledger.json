{
    "word_family": [
        "ledgering"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1727a64b-c358-3286-b6b5-a9a45a2c2779",
                    "sense_definition": "A book or other scheme for keeping accounting records.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accounting_records",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accountant carefully entered the daily transactions into the company's main <w>ledger</w>.",
                            "target_lang_translations": {
                                "ru": "Бухгалтер аккуратно занес ежедневные операции в главную <w>бухгалтерскую книгу</w> компании."
                            }
                        },
                        {
                            "text": "A woman's decisions in the shop often lie concealed behind her husband's name in the <w>ledger</w>.",
                            "target_lang_translations": {
                                "ru": "Решения женщины в магазине часто остаются скрытыми за именем ее мужа в <w>гроссбухе</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "accounting ledger",
                        "company ledger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Книга или иная система для ведения бухгалтерского учета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гроссбух",
                                "target_lang_sense_clarification": "главная бухгалтерская книга"
                            },
                            {
                                "target_lang_word": "бухгалтерская книга",
                                "target_lang_sense_clarification": "для учета хозяйственных операций"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03c13dfe-f14e-3a12-8480-503701fe6261",
                    "sense_definition": "A book for keeping notes; a record book, a register.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "record_keeping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The policeman carefully transcribed the witness's statement word for word in his <w>ledger</w>.",
                            "target_lang_translations": {
                                "ru": "Полицейский тщательно переписал показания свидетеля слово в слово в свой <w>блокнот для записей</w>."
                            }
                        },
                        {
                            "text": "He kept a detailed <w>ledger</w> of all the visitors who entered the historic building.",
                            "target_lang_translations": {
                                "ru": "Он вел подробный <w>журнал учета</w> всех посетителей, входивших в историческое здание."
                            }
                        }
                    ],
                    "common_phrases": [
                        "attendance ledger",
                        "official ledger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Книга для ведения записей; журнал учета, регистрационная книга."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "журнал",
                                "target_lang_sense_clarification": "для регистрации или учета"
                            },
                            {
                                "target_lang_word": "книга записей",
                                "target_lang_sense_clarification": "для заметок и фиксации событий"
                            },
                            {
                                "target_lang_word": "гроссбух",
                                "target_lang_sense_clarification": "разг., толстая книга для записей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eda66905-2207-386a-9adf-be454e6cca68",
                    "sense_definition": "A collection of accounting entries consisting of credits and debits.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "accounting_records",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>ledger</w> exhibits at one view the accounts with an individual, showing both debits and credits.",
                            "target_lang_translations": {
                                "ru": "<w>Главная книга</w> сразу показывает состояние счетов отдельного лица, отражая как дебет, так и кредит."
                            }
                        },
                        {
                            "text": "He spent the afternoon balancing the <w>ledger</w> to ensure all financial entries matched.",
                            "target_lang_translations": {
                                "ru": "Он провел вторую половину дня, сводя <w>баланс</w>, чтобы убедиться, что все финансовые проводки совпадают."
                            }
                        }
                    ],
                    "common_phrases": [
                        "general ledger",
                        "double-entry ledger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совокупность бухгалтерских проводок, состоящая из дебета и кредита."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "главная книга",
                                "target_lang_sense_clarification": "бухгалтерский регистр счетов"
                            },
                            {
                                "target_lang_word": "гроссбух",
                                "target_lang_sense_clarification": "сводка всех счетов и операций"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55f72720-7dbb-33d2-880b-cdfcea322a1b",
                    "sense_definition": "A distributed ledger, a public financial transaction database, typically using a blockchain.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "accounting_records",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is only one <w>ledger</w>, but that <w>ledger</w> is not stored in any one central location.",
                            "target_lang_translations": {
                                "ru": "Существует только один <w>реестр</w>, но этот <w>реестр</w> не хранится в каком-то одном центральном месте."
                            }
                        },
                        {
                            "text": "Cryptocurrencies rely on a decentralized <w>ledger</w> to verify transactions securely.",
                            "target_lang_translations": {
                                "ru": "Криптовалюты полагаются на децентрализованный <w>реестр</w> для безопасного подтверждения транзакций."
                            }
                        }
                    ],
                    "common_phrases": [
                        "distributed ledger",
                        "blockchain ledger"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распределенный реестр, публичная база данных финансовых транзакций, обычно использующая блокчейн."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реестр",
                                "target_lang_sense_clarification": "в технологии блокчейн"
                            },
                            {
                                "target_lang_word": "распределенный реестр",
                                "target_lang_sense_clarification": "база данных транзакций"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca0f9eae-ea05-339d-b113-485d92287395",
                    "sense_definition": "A board attached to a wall to provide support for attaching other structural elements (such as deck joists or roof rafters) to a building.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For more secure rooftop decks, a <w>ledger</w> is attached to the face of the house with perpendicular sleepers.",
                            "target_lang_translations": {
                                "ru": "Для более надежных террас на крыше к фасаду дома крепится <w>опорная доска</w> с перпендикулярными лагами."
                            }
                        },
                        {
                            "text": "The carpenter made sure the <w>ledger</w> board was perfectly level before attaching the deck joists.",
                            "target_lang_translations": {
                                "ru": "Плотник убедился, что <w>опорная доска</w> установлена идеально ровно, прежде чем крепить балки настила."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ledger board"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Опорная доска (брус), прикрепляемая к стене здания для монтажа других конструктивных элементов (например, балок террасы или стропил)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опорная доска",
                                "target_lang_sense_clarification": "пристенная балка для крепления каркаса"
                            },
                            {
                                "target_lang_word": "лежень",
                                "target_lang_sense_clarification": "строительный опорный брус"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a9b484a-a533-340b-960b-622d5659f380",
                    "sense_definition": "A large, flat stone, especially one laid over a tomb.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stonework",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In Great Britain, <w>ledgers</w> that were placed outside of churches are sometimes termed external <w>ledgers</w>.",
                            "target_lang_translations": {
                                "ru": "В Великобритании <w>надгробные плиты</w>, расположенные вне церквей, иногда называют внешними плитами."
                            }
                        },
                        {
                            "text": "The ancient churchyard was filled with moss-covered <w>ledger</w> stones dating back to the seventeenth century.",
                            "target_lang_translations": {
                                "ru": "Старинный погост был заполнен покрытыми мхом <w>надгробными плитами</w>, датируемыми семнадцатым веком."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ledger stone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая плоская каменная плита, укладываемая на могилу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надгробная плита",
                                "target_lang_sense_clarification": "плоский камень на могиле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "624f10c9-75ec-3248-bee4-68e328fd64ae",
                    "sense_definition": "A fishing line or bait used for bottom fishing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When fishing for eels with a <w>ledger</w> line, do not be in too much haste to strike when you see a bite.",
                            "target_lang_translations": {
                                "ru": "При ловле угрей на <w>донную снасть</w> не спешите подсекать, когда увидите поклевку."
                            }
                        },
                        {
                            "text": "He preferred using a heavy <w>ledger</w> to keep his bait stationary on the riverbed.",
                            "target_lang_translations": {
                                "ru": "Он предпочитал использовать тяжелое <w>донное грузило</w>, чтобы удерживать наживку неподвижно на дне реки."
                            }
                        }
                    ],
                    "synonyms": [
                        "ligger"
                    ],
                    "common_phrases": [
                        "ledger line",
                        "ledger bait"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рыболовная снасть или наживка для донной ловли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "донная снасть",
                                "target_lang_sense_clarification": "донка для придонной ловли"
                            },
                            {
                                "target_lang_word": "донное грузило",
                                "target_lang_sense_clarification": "рыболовное грузило для удержания приманки на дне"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "df96457f-41ab-3246-aaa8-db5a8207602d",
                    "sense_definition": "To record (something) in, or as if in, a ledger.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "recording",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clerk would <w>ledger</w> the figures of each month as soon as they were received.",
                            "target_lang_translations": {
                                "ru": "Клерк <w>заносил в книгу учета</w> цифры за каждый месяц, как только они поступали."
                            }
                        },
                        {
                            "text": "It seemed as if his entire scientific knowledge was <w>ledgered</w> in his brain for instant recall.",
                            "target_lang_translations": {
                                "ru": "Казалось, будто все его научные знания были <w>записаны</w> в его мозгу для мгновенного извлечения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ledger the figures"
                    ],
                    "target_lang_definitions": {
                        "ru": "Записывать или вносить данные в бухгалтерскую книгу или реестр."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заносить в гроссбух",
                                "target_lang_sense_clarification": "регистрировать в книге учета"
                            },
                            {
                                "target_lang_word": "записывать",
                                "target_lang_sense_clarification": "вносить в реестр или журнал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94149f69-8469-3330-be35-7e44606c8bac",
                    "sense_definition": "To engage in bottom fishing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fishing_verbs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The best baits for <w>ledgering</w> are worms, greaves, and occasionally a bunch of gentles.",
                            "target_lang_translations": {
                                "ru": "Лучшими наживками для <w>донной ловли</w> являются черви, шкварки и иногда пучок опарышей."
                            }
                        },
                        {
                            "text": "He spent the quiet evening <w>ledgering</w> for barbel near the deep bend of the river.",
                            "target_lang_translations": {
                                "ru": "Он провел тихий вечер, <w>рыбача на донку</w> на усача у глубокого изгиба реки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ledgering for barbel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ловить рыбу на донную снасть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рыбачить на донку",
                                "target_lang_sense_clarification": "ловить рыбу со дна"
                            },
                            {
                                "target_lang_word": "ловить на донную снасть",
                                "target_lang_sense_clarification": "донная рыбалка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4ebfafe-cd4b-3f9b-91dc-16dde603f4fc",
                    "sense_definition": "To use (a certain type of bait) in bottom fishing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fishing_verbs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angler decided on <w>ledgering</w> a small bait rather than freelining one to spot runs earlier.",
                            "target_lang_translations": {
                                "ru": "Рыболов решил <w>использовать в качестве донной наживки</w> мелкую приманку, а не пускать ее в свободный нахлыст, чтобы раньше заметить поклевку."
                            }
                        },
                        {
                            "text": "He succeeded in catching several flounder by <w>ledgering</w> worms along the sandy bottom.",
                            "target_lang_translations": {
                                "ru": "Ему удалось поймать несколько камбал, <w>насаживая для донной ловли</w> червей вдоль песчаного дна."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ledgering a bait"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать определенный тип наживки при донной ловле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "использовать в качестве донной наживки",
                                "target_lang_sense_clarification": "насаживать для ловли со дна"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f3c56637-3aa5-3c6b-b355-59b899457625",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named in honor of the philanthropist Arthur <w>Ledger</w>.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь филантропа Артура <w>Леджера</w>."
                            }
                        },
                        {
                            "text": "We contacted Mr. <w>Ledger</w> to ask about the historical documents of the estate.",
                            "target_lang_translations": {
                                "ru": "Мы связались с господином <w>Леджером</w>, чтобы спросить об исторических документах поместья."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Леджер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}