                        "glosses": [
                            "direct met elkaar verbonden, zo verbonden dat ze niet onafhankelijk van elkaar veranderen",
                            "waarvan de records een sleutelgegeven delen, zodat de gegevens uit verschillende bestanden gecombineerd kunnen worden"
                        ],
