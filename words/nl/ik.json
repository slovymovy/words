            "senses": [
                {
                    "sense_id": "8eeded7a-1ecf-391c-84e1-9844ac59ac14",
                    "sense_definition": "Verwijst naar de persoon die aan het woord is of de tekst schrijft (eerste persoon enkelvoud).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ik</w> ga morgen naar school.",
                            "target_lang_translations": {
                                "ru": "<w>Я</w> завтра иду в школу.",
                                "en": "<w>I</w> am going to school tomorrow.",
                                "tr": "Yarın okula <w>ben</w> gidiyorum.",
                                "pl": "<w>Ja</w> idę jutro do szkoły.",
                                "de": "<w>Ich</w> gehe morgen zur Schule.",
                                "fr": "<w>Je</w> vais à l'école demain.",
                                "it": "Domani vado a scuola. (In italiano il pronome <w>io</w> è solitamente sottinteso)",
                                "cs": "<w>Já</w> jdu zítra do školy.",
                                "es": "<w>Yo</w> voy a la escuela mañana."
                            }
                        },
                        {
                            "text": "<w>Ik</w> heb zin in een kopje koffie.",
                            "target_lang_translations": {
                                "ru": "<w>Я</w> хочу выпить чашечку кофе.",
                                "en": "<w>I</w> feel like having a cup of coffee.",
                                "tr": "Canım bir fincan kahve içmek istiyor (Burada <w>ben</w> gizli özne olarak yer alır).",
                                "pl": "Mam ochotę na filiżankę kawy. (W języku polskim zaimek <w>ja</w> jest zazwyczaj pomijany).",
                                "de": "<w>Ich</w> habe Lust auf eine Tasse Kaffee.",
                                "fr": "<w>J'</w>ai envie d'une tasse de café.",
                                "it": "Ho voglia di una tazza di caffè. (In italiano il pronome <w>io</w> è solitamente sottinteso)",
                                "cs": "<w>Mám</w> chuť na šálek kávy.",
                                "es": "Tengo ganas de tomar una taza de café. (En español, el pronombre <w>yo</w> suele omitirse)."
                            }
                        },
                        {
                            "text": "<w>Ik</w> zing dit lied speciaal voor jou.",
                            "target_lang_translations": {
                                "ru": "<w>Я</w> пою эту песню специально для тебя.",
                                "en": "<w>I</w> am singing this song especially for you.",
                                "tr": "Bu şarkıyı özellikle senin için <w>ben</w> söylüyorum.",
                                "pl": "<w>Ja</w> śpiewam tę piosenkę specjalnie dla ciebie.",
                                "de": "<w>Ich</w> singe dieses Lied speziell für dich.",
                                "fr": "<w>Je</w> chante cette chanson spécialement pour toi.",
                                "it": "Canto questa canzone specialmente per te. (In italiano il pronome <w>io</w> è solitamente sottinteso)",
                                "cs": "<w>Zpívám</w> tuto píseň speciálně pro tebe.",
                                "es": "<w>Yo</w> canto esta canción especialmente para ti."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ik ben",
                        "ik heb",
                        "ik wil",
                        "ik weet",
                        "ik denk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Указывает на говорящего или пишущего (первое лицо единственного числа).",
                        "en": "Refers to the person speaking or writing (first person singular).",
                        "tr": "Konuşan veya yazan kişiyi belirten sözcük (birinci tekil şahıs zamiri).",
                        "pl": "Odnosi się do osoby, która mówi lub pisze tekst (pierwsza osoba liczby pojedynczej).",
                        "de": "Bezieht sich auf die Person, die spricht oder schreibt (erste Person Singular).",
                        "fr": "Fait référence à la personne qui parle ou qui écrit (première personne du singulier).",
                        "it": "Si riferisce alla persona che parla o scrive (prima persona singolare).",
                        "cs": "Odkazuje na osobu, která mluví nebo píše text (první osoba jednotného čísla).",
                        "es": "Se refiere a la persona que habla o escribe (primera persona del singular)."
                    },
