                "senses": [
                    {
                        "sense_id": "8eb6bf16-ffe9-30a7-8337-fd9b239bc7f9",
                        "entry_id": "fc597042-07e2-31a4-b15d-2af609a664e8",
                        "glosses": [
                            "Faire sortir du con (du sexe de la femme)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b2cff4a-c311-40ee-a1af-3c7b21c4c289",
                                "sense_id": "8eb6bf16-ffe9-30a7-8337-fd9b239bc7f9",
                                "text": "Elle a émis quatre fois dans le con, sans la désenconner."
                            },
                            {
                                "example_id": "5c0aca3a-d437-4f83-a7da-b822036c82a3",
                                "sense_id": "8eb6bf16-ffe9-30a7-8337-fd9b239bc7f9",
                                "text": "Quelques minutes passèrent au long desquelles Mona se mit à jouer avec mon instrument, puis quand la pointe de ma queue se fut bien dressée elle s’allongea sur le côté sans désenconner la pine qu’elle avait en con et me demanda de la sodomiser en me priant d’y aller lentement pour qu'elle puisse goûter longuement ma venue."
                            },
                            {
                                "example_id": "600f88e8-923f-4e3b-aa9a-4230bdf296be",
                                "sense_id": "8eb6bf16-ffe9-30a7-8337-fd9b239bc7f9",
                                "text": "Ce cul devant mes yeux me donne tant de fièvres,\nQue je me désenconne et le prends dans mes lèvres."
                            }
                        ]
                    }
                ],
