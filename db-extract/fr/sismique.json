                ],
                "senses": [
                    {
                        "sense_id": "0f90cd06-3546-35c6-8bf8-8f9d80c7fe95",
                        "entry_id": "439bd541-859d-3589-b42d-94a09e0a42dc",
                        "glosses": [
                            "Relatif à la sismologie et en particulier aux séismes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7b9b5bd-4e34-472f-a088-6c4f16a94daf",
                                "sense_id": "0f90cd06-3546-35c6-8bf8-8f9d80c7fe95",
                                "text": "L'activité sismique en Provence est modérée."
                            },
                            {
                                "example_id": "f634214f-3ef3-45a4-afbc-65a9b34c069b",
                                "sense_id": "0f90cd06-3546-35c6-8bf8-8f9d80c7fe95",
                                "text": "Phénomène sismique."
                            },
                            {
                                "example_id": "ce33b018-b485-4c64-8d87-0bcf789c43b0",
                                "sense_id": "0f90cd06-3546-35c6-8bf8-8f9d80c7fe95",
                                "text": "Ces piliers peuvent être utilisés dans la construction pour soutenir des bâtiments dans les zones sismiques."
                            },
                            {
                                "example_id": "1ab59d46-5885-496a-b1d0-09cb3d00dcf2",
                                "sense_id": "0f90cd06-3546-35c6-8bf8-8f9d80c7fe95",
                                "text": "Les explosions ont été si puissantes qu’elles ont été détectées par des systèmes de surveillance sismique. Les premières secousses de magnitude 2,8 ont été enregistrées à 3 h 56 du matin, suivies de sept plus faibles, de magnitude 2 à 2,8."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "222d7954-c531-49ae-9f6b-bcb67a3217f6",
                        "source_entry_id": "439bd541-859d-3589-b42d-94a09e0a42dc",
                        "source_sense_id": "0f90cd06-3546-35c6-8bf8-8f9d80c7fe95",
                        "target_lang_word": "seismisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seismisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5a83741-7089-3c32-ba77-41f5cf014ff7",
                                        "entry_id": "a894e2ad-6b4b-37b6-a433-66f78f54cb21",
                                        "glosses": [
                                            "Erdbeben betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0998623-de89-4fe2-9da4-633f290ede32",
                                                "sense_id": "f5a83741-7089-3c32-ba77-41f5cf014ff7",
                                                "text": "Wissenschaftler beobachten die seismischen Bewegungen genau."
                                            },
                                            {
                                                "example_id": "dc439e30-964c-4403-bb92-c8bca38ecc8a",
                                                "sense_id": "f5a83741-7089-3c32-ba77-41f5cf014ff7",
                                                "text": "„An vielen Orten weltweit registrierten Wissenschaftlerinnen und Wissenschaftler im September 2023 seismische Signale – über ganze neun Tage.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a49e28be-3c31-4b52-b2d8-d577d63976e8",
                        "source_entry_id": "439bd541-859d-3589-b42d-94a09e0a42dc",
                        "source_sense_id": "0f90cd06-3546-35c6-8bf8-8f9d80c7fe95",
