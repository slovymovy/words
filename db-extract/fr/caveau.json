                        "examples": [
                            {
                                "example_id": "5a9a612e-7540-47f3-a1dd-83fc8662a10c",
                                "sense_id": "ee3657d4-7218-37b4-842b-3a6e1c345bfe",
                                "text": "Ils creusèrent un trou d’1 m.2 [sic] de profondeur et de 6 mètres de large, érigèrent des murs de rondins d’1 m.2 au-dessus du sol et utilisèrent des mottes de terre pour le toit. Ce concept fut connu sous le nom de caveau.",
                                "translation": "They dug a hole of 1 meter by 2 to a depth of 6 meters, erected log walls 1 to 2 meters above the ground and used clods of earth for the roof. This concept was known under the name of a caveau.",
                                "english": "They dug a hole of 1 meter by 2 to a depth of 6 meters, erected log walls 1 to 2 meters above the ground and used clods of earth for the roof. This concept was known under the name of a caveau."
