                "senses": [
                    {
                        "sense_id": "b8cbaccc-4335-3fed-af19-49d5277ecee1",
                        "entry_id": "122fd72c-ea42-3d61-b6f4-0666fce36fe3",
                        "glosses": [
                            "Therapeutin, die durch die gezielte Anwendung von Musik versucht, die Patienten zu heilen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df8ddcdf-a3c0-4c5f-8711-cba31be1432c",
                                "sense_id": "b8cbaccc-4335-3fed-af19-49d5277ecee1",
                                "text": "„Manche Männer schlagen oder vergewaltigen ihre Frauen. Schwerer Schritt über die Demarkationslinie Die Britin Louisa Lang arbeitet als Musiktherapeutin im Zentrum vor allem mit Kindern. Musik ist eine universelle Sprache, ein Medium für das Kind, sich auszudrücken.“"
                            },
                            {
                                "example_id": "bfc44083-ca71-446b-ad68-4ff3e93ffceb",
                                "sense_id": "b8cbaccc-4335-3fed-af19-49d5277ecee1",
                                "text": "„Die Musiktherapeutin Stefanie Trikojat-Klein stellt Melodien und Tonfolgen vor, die Kinder bis sieben Jahre am liebsten mögen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
