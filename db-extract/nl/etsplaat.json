                "senses": [
                    {
                        "sense_id": "934288df-af81-3b78-b01f-3ed49f3381ae",
                        "entry_id": "c9b13d54-18b9-307a-bb4f-af35d107c2d2",
                        "glosses": [
                            "metalen plaat waarop men met een droge naald een tekening maakt die later afgedrukt kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b9d73c8-9df6-413e-ae28-6dfe34fb0b63",
                                "sense_id": "934288df-af81-3b78-b01f-3ed49f3381ae",
                                "text": "Het start met een afbeelding uit de collectie van het Rijksmuseum die al op de etsplaat staat. Op basis daarvan gaan de kinderen aan de slag met een droge naald. Hoe dat moet, en wat een droge naald is, wordt uiteraard allemaal uitgelegd."
                            },
                            {
                                "example_id": "1f52861f-bd10-4692-92b9-bfd26bdd57e2",
                                "sense_id": "934288df-af81-3b78-b01f-3ed49f3381ae",
                                "text": "Beeldend kunstenaar Aat Veldhoen is eerder vandaag op 84-jarige leeftijd overleden in zijn woonplaats Amsterdam aan de gevolgen van een herseninfarct. Dat werd zojuist door collega en fotograaf Koos Breukel bevestigd. Zij werkten samen aan een expositie van Velthoens oude etsplaten. Breukel werd ingelicht door Veldhoens dochter Venus."
                            },
                            {
                                "example_id": "35698859-92c7-4474-8b6a-4aef53fbbbfb",
                                "sense_id": "934288df-af81-3b78-b01f-3ed49f3381ae",
                                "text": "Het begon met Rembrandt. Die bezat zeker acht schilderijen en ongetwijfeld ook veel etsen van Segers – plus de etsplaat van diens ‘Landschap met Tobias en de engel’ (ca. 1633), die hij omwerkte tot ‘De vlucht naar Egypte’ (ca. 1652)."
                            }
                        ]
                    }
