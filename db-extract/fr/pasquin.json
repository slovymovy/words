        "fr-extract.jsonl": [
            {
                "entry_id": "5c32e71f-b3b9-37ea-b7cc-eb5510295523",
                "word": "Pasquin",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3209a671-ab7c-3ffe-9894-6ef6499b1a6f",
                        "entry_id": "5c32e71f-b3b9-37ea-b7cc-eb5510295523",
                        "glosses": [
                            "Statue hellénistique mutilée, datant du IIIᵉ siècle avant notre ère, exhumée à Rome au XVᵉ siècle, à l'effigie d'un gladiateur et à laquelle on a coutume d’attacher des petites satires en particulier de la part des étudiants le jour de la saint Marc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53acf31d-03b2-4a23-a1e4-1ba03ffe04cd",
                                "sense_id": "3209a671-ab7c-3ffe-9894-6ef6499b1a6f",
                                "text": "Pasquin est une statue antique exhumée - en piteux état - au début du XVIe siècle et placée par le cardinal Carafa au coin de l'actuel palais Braschi, près de la place Navona."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1d564cb-229b-35f2-bfcd-02f9e88d868f",
                        "entry_id": "5c32e71f-b3b9-37ea-b7cc-eb5510295523",
                        "glosses": [
                            "Statue hellénistique mutilée, datant du IIIᵉ siècle avant notre ère, exhumée à Rome au XVᵉ siècle, à l'effigie d'un gladiateur et à laquelle on a coutume d’attacher des petites satires en particulier de la part des étudiants le jour de la saint Marc.",
                            "Personnage représenté par cette statue à qui on donne la parole, notamment dans des dialogues avec un autre personnage, Marforio, représenté par une statue qui lui fait face."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f0d65742-89af-4c0f-bdf1-0cb13414499c",
                                "sense_id": "c1d564cb-229b-35f2-bfcd-02f9e88d868f",
                                "text": "Ces maraudailles de Paris disent que Marfore demande à Pasquin pourquoi on prend en une même année Philisbourg et Maëstricht, et que Pasquin répond que c'est parce que M. de Turenne est à Saint-Denis et monsieur le Prince à Chantilly."
                            }
                        ]
                    },
                    {
                        "sense_id": "728abc8f-ab45-39d4-b023-ef3c361602fe",
                        "entry_id": "5c32e71f-b3b9-37ea-b7cc-eb5510295523",
                        "glosses": [
                            "Nom d’un valet de comédie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30886d84-cf76-43b4-a5a5-2b85972c905e",
                                "sense_id": "728abc8f-ab45-39d4-b023-ef3c361602fe",
                                "text": "Le Pasquin de la troupe."
                            },
                            {
                                "example_id": "083dd163-79e5-4835-9bbe-7600e2c261b5",
                                "sense_id": "728abc8f-ab45-39d4-b023-ef3c361602fe",
                                "text": "Pasquin est de la race des laquais de bonne maison, lurons pleins de plus d’ardeur que de scrupules, qui donnaient beaucoup d’embarras à leurs maîtres et dont la dynastie commence à Mascarille, à Crispin, à Scapin, pour aboutir à Frontin et à Figaro."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e1f1036-a362-402a-8538-590f68e350d4",
                        "source_entry_id": "5c32e71f-b3b9-37ea-b7cc-eb5510295523",
