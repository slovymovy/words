                                    {
                                        "sense_id": "37e22809-2543-3bc8-82a0-1eb0968f3cb1",
                                        "entry_id": "77f751cf-9c6c-3fc2-a90b-07d4ffd6fa1a",
                                        "glosses": [
                                            "The smallest local government unit in the Philippines, a subdivision of a city or municipality."
                                        ],
                                        "tags": [
                                            "Philippines"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fa99137-aa52-47f9-b0d9-ba6b196a1403",
                                                "sense_id": "37e22809-2543-3bc8-82a0-1eb0968f3cb1",
                                                "text": "Because of this active involvement of the civilian and other auxiliary units (e.g. barangay tanod), the police are able to devote their time and resources to the control and prevention of serious crimes."
                                            },
                                            {
                                                "example_id": "a4613dfe-ff62-4f86-a512-d0da3b41911d",
                                                "sense_id": "37e22809-2543-3bc8-82a0-1eb0968f3cb1",
                                                "text": "The Government Service Insurance System (GSIS) shall establish and administer an appropriate system under which the punong barangay, the members of the sangguniang barangay, the barangay secretary, the barangay treasurer, and the members of the brangay tanod shall enjoy insurance coverage as provided in this Code and other pertinent laws ."
                                            },
                                            {
                                                "example_id": "9bc3b4d3-93d4-48d7-9fe8-425f7b8b244f",
                                                "sense_id": "37e22809-2543-3bc8-82a0-1eb0968f3cb1",
                                                "text": "The victim is always addressed as the \"datu\" or rich man of their Barangay and enjoyed an economic ascendancy over Marcelino, a mere barangay tanod."
                                            }
                                        ]
                                    },
