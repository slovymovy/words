        "ru-extract.jsonl": [
            {
                "entry_id": "c06975cd-d142-3464-b383-cc987d3ee3c8",
                "word": "безмятежно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "24014665-6ab5-3618-af23-e2eb02cace7c",
                        "entry_id": "c06975cd-d142-3464-b383-cc987d3ee3c8",
                        "glosses": [
                            "наречие к безмятежный; спокойно, без тревог, волнений и т. п."
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "675e06da-7699-48ad-af95-b3ab408adaaf",
                                "sense_id": "24014665-6ab5-3618-af23-e2eb02cace7c",
                                "text": "Глубокая важность была в его закрытых глазах, и губы улыбались блаженно и безмятежно, как будто бы он перед расставаньем с жизнью узнал какую-то глубокую и сладкую тайну, разрешившую всю человеческую его жизнь."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f380a96-53c2-44fb-9736-5e36d81c3743",
                        "source_entry_id": "c06975cd-d142-3464-b383-cc987d3ee3c8",
                        "source_sense_id": "24014665-6ab5-3618-af23-e2eb02cace7c",
                        "target_lang_word": "serenely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "serenely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ced32b9e-d4c4-3239-9128-c0d74d63bb6e",
                                        "entry_id": "c0904e55-4d87-34a4-8fe7-9c0c8d95bcb7",
                                        "glosses": [
                                            "In a serene manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dd53883-1997-44b6-8ebb-464ad17e3505",
                                                "sense_id": "ced32b9e-d4c4-3239-9128-c0d74d63bb6e",
                                                "text": "I’ve flown in flimsy microlights, soaring serenely above rich farmland. I’ve ridden tactical combat helicopters missions, skimming the desert floor and banking hard around sand dunes."
                                            },
                                            {
                                                "example_id": "0fc2383b-23d6-4c31-b58f-413ddfeaa725",
                                                "sense_id": "ced32b9e-d4c4-3239-9128-c0d74d63bb6e",
                                                "text": "Ruling in the immunity case, Chief Justice John Roberts seemed to serenely arrogate to the Court an immense power to determine whether the president might ever face criminal consequence without worrying whether the emboldening of a rampaging executive might at some point place the authority of the judiciary in danger."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16c9caab-8331-4e33-a3c2-39828e2e9915",
                        "source_entry_id": "c06975cd-d142-3464-b383-cc987d3ee3c8",
                        "source_sense_id": "24014665-6ab5-3618-af23-e2eb02cace7c",
                        "target_lang_word": "quietly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quietly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54591f42-6dcf-3765-ae69-a703fa8cbaf8",
                                        "entry_id": "cb74771d-09fc-385a-8146-2745d8ff403a",
                                        "glosses": [
                                            "In a quiet manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4326ee50-f560-403b-a186-fd887ddddd83",
                                                "sense_id": "54591f42-6dcf-3765-ae69-a703fa8cbaf8",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him.[…]. The captive made no resistance and came not only quietly but in a series of eager little rushes like a timid dog on a choke chain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eda331b1-2342-4a23-a5b1-b66884ded63e",
                        "source_entry_id": "c06975cd-d142-3464-b383-cc987d3ee3c8",
                        "source_sense_id": "24014665-6ab5-3618-af23-e2eb02cace7c",
                        "target_lang_word": "peacefully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peacefully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d91dfdf0-436a-319f-b676-b6ca37866d99",
                                        "entry_id": "2deb9e58-0775-3910-8bd3-932747c26123",
                                        "glosses": [
                                            "In a peaceful manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b053ca3-d517-46b9-9196-eb7dfc4ae78a",
                                                "sense_id": "d91dfdf0-436a-319f-b676-b6ca37866d99",
                                                "text": "She and her husband managed to fix up a false floor in one of their rooms in which they fed the roosters; so whenever a picket came in sight her call would bring the whole family out of the woods and clearing into the refuge, where they remained peacefully amongst corn-cobs till the danger had passed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
