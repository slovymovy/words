                    {
                        "sense_id": "2f235a1e-a31a-3747-b2df-31496c583abb",
                        "entry_id": "4d11fbd8-9545-3a0c-afb4-cc83653768bb",
                        "glosses": [
                            "Having no or low alcohol content; being low-alcohol or alcohol-free"
                        ],
                        "tags": [
                            "British"
                        ],
                        "examples": [
                            {
                                "example_id": "a9675672-5243-4760-a377-1317111ed30f",
                                "sense_id": "2f235a1e-a31a-3747-b2df-31496c583abb",
                                "text": "NoLo (no alcohol, low alcohol) is one of the hottest trends in the drinks industry."
                            },
                            {
                                "example_id": "2d6433ef-4f82-46d1-9800-cf34809290cd",
                                "sense_id": "2f235a1e-a31a-3747-b2df-31496c583abb",
                                "text": "The UK drinks industry has embarked on a detox that extends beyond January with companies racing to bring out “nolo” (no- or low-alcohol) beers, spirits and cocktails to satisfy a thirst for hangover-free drinking."
                            },
                            {
                                "example_id": "7e7db869-697b-4319-928f-83d804aaa5e9",
                                "sense_id": "2f235a1e-a31a-3747-b2df-31496c583abb",
                                "text": "No and low (nicknamed 'nolo') alcoholic beverages are set to be the UK’s biggest alcohol trend for 2020, according to a new study."
                            },
                            {
                                "example_id": "ac81d236-3bdd-4cd9-ac65-48d439cc1f5c",
                                "sense_id": "2f235a1e-a31a-3747-b2df-31496c583abb",
                                "text": "\"Nolo\" alcohol is set to be one of the driving trends of 2020, according to the craft brewers' trade organisation."
                            },
                            {
                                "example_id": "6f9b9379-4d79-43fc-90eb-76caf5b8022c",
                                "sense_id": "2f235a1e-a31a-3747-b2df-31496c583abb",
                                "text": "Encouragingly, sales of no or low-alcohol beer are up 30% since 2016 and “nolo” alcohol is set to be one of the driving trends of 2020, although I am sure trends are being reviewed in the light of the pandemic."
                            }
                        ]
                    }
                ],
