                        "form": "es ist versetzbar"
                    },
                    {
                        "form_id": "7a0d9ce7-46fb-47a1-8eb1-3af99e8d339a",
                        "entry_id": "4f116529-5911-39be-a931-75f3b97d119d",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind versetzbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c3ef9168-abb4-3199-8bd2-0bfc7ad983b0",
                        "entry_id": "4f116529-5911-39be-a931-75f3b97d119d",
                        "glosses": [
                            "einem anderen Dienstort zugewiesen werden könnend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3055be0-6be6-47e7-8663-340c7119a8cb",
                                "sense_id": "c3ef9168-abb4-3199-8bd2-0bfc7ad983b0",
                                "text": "„Grundsätzlich sind alle Beamten versetzbar, Einschränkungen ergeben sich für Hochschullehrer, Mitglieder der Rechnungshöfe, Personalratsmitglieder und .Gleichstellungsbeauftragte.“"
                            },
                            {
                                "example_id": "b5fe0eef-b3b6-4f79-aae2-cea859d15de3",
                                "sense_id": "c3ef9168-abb4-3199-8bd2-0bfc7ad983b0",
                                "text": "„Partner müssten die Berufsentscheidung mittragen und wenn möglich ‚portable‘, also gemeinsam versetzbar sein.“"
                            },
                            {
                                "example_id": "76df1f97-c30a-4aee-9607-3d52e784ef65",
                                "sense_id": "c3ef9168-abb4-3199-8bd2-0bfc7ad983b0",
                                "text": "„Doch Liberalisierung hin, Universaldienst-Ordnung her, der Gewerkschaft geht es gar nicht um die Versorgung der Postkunden, sondern um eigene Pfründe bzw. jene 48,1% der 27 000 Pöstler, die unkündbare und nicht versetzbare Beamte sind.“"
                            },
                            {
                                "example_id": "9fe2f15d-61b3-4e51-8cf7-44f93d458d01",
                                "sense_id": "c3ef9168-abb4-3199-8bd2-0bfc7ad983b0",
                                "text": "„Wenn die Vertretung beendet sei, blieben Überstände an Richtern übrig, die aber zugleich versetzbar seien - ein Umstand, den Reissner so rasch wie möglich beendet sehen will: […]“"
                            },
                            {
                                "example_id": "7ca67c86-ec9e-44de-91ff-ba9cf07b38d3",
                                "sense_id": "c3ef9168-abb4-3199-8bd2-0bfc7ad983b0",
                                "text": "„Zur Immobilität des Apparates trägt bei, daß Beamte gegen ihren Willen so gut wie nicht versetzbar sind, schon gar nicht von einem Dienstherren zum anderen, also etwa aus dem Bundes- in den Gemeindedienst oder umgekehrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "11edccd0-f4b6-332b-aaed-9fc768d1438d",
                        "entry_id": "4f116529-5911-39be-a931-75f3b97d119d",
                        "glosses": [
                            "in der Lage, an einen anderen Ort, in einen anderen Zustand gebracht zu werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e2490b8-ed23-4d64-88c6-b40cd916cca0",
                                "sense_id": "11edccd0-f4b6-332b-aaed-9fc768d1438d",
                                "text": "„Im Herbste ist das Stämmchen versetzbar.“"
                            },
                            {
                                "example_id": "525bae6c-de2e-4b95-b6fa-b299eb0a5ec5",
                                "sense_id": "11edccd0-f4b6-332b-aaed-9fc768d1438d",
                                "text": "„[Die grossen Felsbrocken] liegen auf dem Autobahn-Trassee und sind angesichts ihrer Grösse von insgesamt 670 Kubikmeter und einem Gesamtgewicht von 1600 Tonnen nur unter grossem Aufwand versetzbar.“"
                            },
                            {
                                "example_id": "c01e204c-59cc-46ec-b1cf-d3c5179a44c1",
                                "sense_id": "11edccd0-f4b6-332b-aaed-9fc768d1438d",
                                "text": "„Es handelt sich um eine zerlegbare und leicht versetzbare Ausführung.“"
                            },
                            {
                                "example_id": "6888d24c-dbf8-40e9-a909-5640e17e1ba2",
                                "sense_id": "11edccd0-f4b6-332b-aaed-9fc768d1438d",
                                "text": "„[Die Sitze in Reihe zwei] sind verschiebbar und auch in die dritte Reihe versetzbar.“"
                            },
                            {
                                "example_id": "8fb9db17-0574-4bba-ab91-e5af2a21359e",
                                "sense_id": "11edccd0-f4b6-332b-aaed-9fc768d1438d",
                                "text": "„Ihre Engramme sind aus dem Latenzzustand in einen neuen Erregungszustand versetzbar, ekphorierbar.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ea0fed25-bc3e-3529-965a-1b8012c5e3b8",
                        "entry_id": "4f116529-5911-39be-a931-75f3b97d119d",
                        "glosses": [
                            "geeignet, als Pfand zu dienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7c4de38-cd54-4145-8446-9272ac0574aa",
                                "sense_id": "ea0fed25-bc3e-3529-965a-1b8012c5e3b8",
                                "text": "„Ihr Mann pumpte in seiner Not jeden an, von dem er glaubte, er könne etwas abgeben, ließ stunden und brachte das letzte Versetzbare zu dem Onkel mit den drei Kugeln, dem Pfandhaus.“"
                            },
                            {
                                "example_id": "3145d0f9-6818-441a-924e-e960a063952d",
                                "sense_id": "ea0fed25-bc3e-3529-965a-1b8012c5e3b8",
                                "text": "„Alles was nur versetzbar war, liegt im Pfandhaus.“"
                            },
                            {
                                "example_id": "85573fa1-5608-4bbc-ac49-4fb49618be07",
                                "sense_id": "ea0fed25-bc3e-3529-965a-1b8012c5e3b8",
                                "text": "„Nach und nach wanderte alles Versetzbare ins Pfandhaus, aber selbst dadurch konnten die drängenden Gläubiger nicht zufriedengestellt werden.“"
                            },
                            {
                                "example_id": "a2dadf0f-23a7-4f9e-b983-09fc711792b5",
                                "sense_id": "ea0fed25-bc3e-3529-965a-1b8012c5e3b8",
                                "text": "„In den Häusern der Armen ist jedes versetzbare Möbel in das Pfandhaus gewandert; ein Paar Fetzen dienen den vor Kälte zitternden Bewohnern als Bedeckung.“"
                            },
                            {
                                "example_id": "cc0c7efd-a58e-45ba-934f-bc88726ba72b",
                                "sense_id": "ea0fed25-bc3e-3529-965a-1b8012c5e3b8",
                                "text": "„Sie gereichen vielmehr nur den Eignern der Bank, oder des Pfandhauses zum merklichen Vortheile, den Wucherer machen sie zum Betrüger, den Geizigen nichts weniger als freigebig, den Mißtrauischen zum Geizhalse, dem rechtschaffenen Geldbesitzer sind sie offenbar schädlich, weil er sein Geld nicht mehr unter so ganz sicheren Bedingnissen, oder nur gegen weit geringere Zinse als vorhin austhun [sic?] kann, dem geldbedürftigen Besitzer versetzbarer Stücken helfen sie zwar aus der esrten Noth, allein die, so Vermögen haben, welches aber nicht versetzbar ist, und jene, die keines haben, dörfen davon keine Hilfe erwarten.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
