                ],
                "senses": [
                    {
                        "sense_id": "b57ecc1d-9fde-3752-b6e0-9132bc506cbb",
                        "entry_id": "f5cb4e61-00cc-3e85-9cc1-cc7c6d2ae025",
                        "glosses": [
                            "Abhilfe; Beseitigung einer Belastung, eines Missstandes"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "64023fd8-661f-4dbb-aa63-951e94ee5640",
                                "sense_id": "b57ecc1d-9fde-3752-b6e0-9132bc506cbb",
                                "text": "„An Remedur lässt es der Heiland nicht fehlen, wann arme Seelen nur seine Remedur annähmen.“"
                            },
                            {
                                "example_id": "4607f0f8-b8f1-467f-9888-3311d5e72f20",
                                "sense_id": "b57ecc1d-9fde-3752-b6e0-9132bc506cbb",
                                "text": "„Deutlich rügten die Richter in ihrer einstimmig ergangenen Entscheidung Fehler im Finanzausgleichssystem der Bundesrepublik und dies, obwohl das Gericht schon früher Remedur angemahnt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98fc2bd5-81be-4a4f-ab00-df7df9f41891",
                        "source_entry_id": "f5cb4e61-00cc-3e85-9cc1-cc7c6d2ae025",
                        "source_sense_id": "b57ecc1d-9fde-3752-b6e0-9132bc506cbb",
                        "source_sense_description": "veraltet: Abhilfe; Beseitigung einer Belastung, eines Missstandes",
                        "target_lang_word": "remedy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
