                "senses": [
                    {
                        "sense_id": "b7515535-32ce-32ce-8392-9b5f56f95ddd",
                        "entry_id": "d6db536f-2b8a-382f-872f-cf984b29b57e",
                        "glosses": [
                            "der linke, in Mähren verlaufende, Nebenfluss der Donau"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "672b7c68-bf1e-4447-b237-8508bc5b84fb",
                                "sense_id": "b7515535-32ce-32ce-8392-9b5f56f95ddd",
                                "text": "Im Urlaub haben wir an der March geangelt."
                            },
                            {
                                "example_id": "1c36a621-5788-46a5-a152-a1928de3fb75",
                                "sense_id": "b7515535-32ce-32ce-8392-9b5f56f95ddd",
                                "text": "„Die viadonau hat die Dämme entlang der March und Thaya sowie an den Zubringer-Bächen Weidenbach, Sulzbach, Jedenspeigen-Bach und Zaya generalsaniert.“"
                            },
                            {
                                "example_id": "a3b98a6a-7f6b-422c-b4d9-ec85be625280",
                                "sense_id": "b7515535-32ce-32ce-8392-9b5f56f95ddd",
                                "text": "„Viele Jahre lang trennte der Eiserne Vorhang entlang der Flüsse March und Thaya das Weinviertel und Mähren.“"
                            },
                            {
                                "example_id": "e881c06a-bd82-4659-967f-871fc7a60404",
                                "sense_id": "b7515535-32ce-32ce-8392-9b5f56f95ddd",
                                "text": "„Mehrere tausend Menschen flohen zur Zeit des Kommunismus über die March aus der Tschechoslowakei nach Österreich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
