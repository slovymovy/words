                "senses": [
                    {
                        "sense_id": "2f895bf4-8eea-35cf-9b4d-0919da1dc3c4",
                        "entry_id": "9827ea35-a819-38b5-a0ab-7378e9792be6",
                        "glosses": [
                            "Poignée de porte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0497987-4420-4cb1-b0e5-761951ef9dd3",
                                "sense_id": "2f895bf4-8eea-35cf-9b4d-0919da1dc3c4",
                                "text": "Der Detektiv war schon am Gehen und hatte die Türklinke in der Hand, als ihm noch eine wichtige Frage einfiel. — Le détective était déjà en train de partir et avait la main sur la poignée de porte lorsque lui revint à l’esprit une question importante."
                            },
                            {
                                "example_id": "bbf26c30-be3c-4eba-98b3-4168014e3bb6",
                                "sense_id": "2f895bf4-8eea-35cf-9b4d-0919da1dc3c4",
                                "text": "Auch über Türklinken oder Haltegriffe in Bussen und Bahnen kann das Virus weitergegeben werden."
                            }
                        ]
                    }
                ],
