                "senses": [
                    {
                        "sense_id": "75e43abe-b92d-326c-a443-2a006b4c6bc0",
                        "entry_id": "b3f4ced6-df5a-3762-b7f8-5f3f6ea88146",
                        "glosses": [
                            "Wunde, die sich am Kopf befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77d1a3e6-d0d3-4f8b-9538-a76abe7cd7dc",
                                "sense_id": "75e43abe-b92d-326c-a443-2a006b4c6bc0",
                                "text": "„Zeichen absichtlicher Gewalteinwirkung – sonst ein häufiges Phänomen bei mittelalterlichen Skeletten – tauchen in den Funden aus Cambridge insgesamt eher selten auf. Sie finden sich aber dennoch, etwa bei einem Mönch, der wohl mit einem Arm einen Schlag abzuwehren versuchte und sich dabei eine Fraktur zuzog sowie eine Kopfwunde erlitt.“"
                            },
                            {
                                "example_id": "d2fab0bc-e4ba-45d3-98e7-519489b27c25",
                                "sense_id": "75e43abe-b92d-326c-a443-2a006b4c6bc0",
                                "text": "„Als Archäologen die Mumie dieses Königs durchleuchteten, entdeckten sie schwere Kopfwunden, die gleich von mehreren Waffen stammten: einem Schwert oder einer Streitaxt, einem Speer, einem Dolch und einem stumpfen Objekt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
