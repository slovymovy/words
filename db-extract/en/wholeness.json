                    {
                        "translation_id": "6db08fd0-74cd-4ca0-a1d1-b24203a1c8ed",
                        "source_entry_id": "71374868-a700-30b5-a1d4-40ba255e031f",
                        "source_sense_description": "quality of being whole",
                        "target_lang_word": "це́лостность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "це́лостность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "dffcf0f0-56fb-311c-bfc9-bd493bf5b211",
                                        "entry_id": "c1e7d102-bba3-3335-bb08-14aae3af86d4",
                                        "glosses": [
                                            "свойство по значению прилагательного целостный; полнота, завершённость"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "269366cd-f047-4e88-9f5b-9d0ddb27d33e",
                                                "sense_id": "dffcf0f0-56fb-311c-bfc9-bd493bf5b211",
                                                "text": "Восприятие зрительного поля определяется не отдельными элементами, как в случае ассоциаций, предшествующим опытом и т. д., а динамическими силами, определяющими целостность восприятия."
                                            },
                                            {
                                                "example_id": "046a994f-b872-4ae0-b340-2fa266444ffa",
                                                "sense_id": "dffcf0f0-56fb-311c-bfc9-bd493bf5b211",
                                                "text": "При подсветке водных объектов уместно цветное освещение — главное, чтобы сохранилась целостность композиционного замысла."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27125d0c-87be-349d-9551-de7e927f2700",
                                        "entry_id": "c1e7d102-bba3-3335-bb08-14aae3af86d4",
                                        "glosses": [
                                            "свойство по значению прилагательного целый; отсутствие повреждений"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b8e0d4a-7bc8-4263-8f9f-ca0689cb4e4e",
                                                "sense_id": "27125d0c-87be-349d-9551-de7e927f2700",
                                                "text": "Опустите глубоко в землю фундамент — и вы не будете бояться за целостность вашего жилища."
                                            },
                                            {
                                                "example_id": "3bffc3f8-a1dd-4636-b578-3758d9c2d514",
                                                "sense_id": "27125d0c-87be-349d-9551-de7e927f2700",
                                                "text": "Отщепившись от молекулы белка в результате ряда жизненных процессов, ароматическая группа, правда, претерпевает целый ряд превращений, но ароматическое ядро во всех фазах своего превращения и вплоть до момента своего выделения из организма животного сохраняет свою целостность."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9777dc8e-dcc5-4a8c-9817-fb089686c866",
                        "source_entry_id": "71374868-a700-30b5-a1d4-40ba255e031f",
                        "source_sense_description": "quality of being whole",
                        "target_lang_word": "це́льность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "це́льность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d8adc6fd-82ef-3054-b115-f5baae904c0c",
                                        "entry_id": "53cefb4d-bae9-32f2-8f79-93ad3a2b0788",
                                        "glosses": [
                                            "свойство или состояние по значению прилагательного цельный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7217a89-b1eb-451c-a310-e354c8d8cbdb",
                                                "sense_id": "d8adc6fd-82ef-3054-b115-f5baae904c0c",
                                                "text": "Направление литературы изменилось потому, что изменилось направление самой жизни; произведения литературы утратили цельность, потому что в самой жизни нет этой цельности."
                                            },
                                            {
                                                "example_id": "943d26ac-d290-4008-b5dd-219d56d521f7",
                                                "sense_id": "d8adc6fd-82ef-3054-b115-f5baae904c0c",
                                                "text": "Как, однако, ни потешались товарищи над его задумчивостью и рассеянностию, но его тёплое сердце, кротость, добродушие и поражавшая даже их, мальчишек в школе, простота, цельность характера, чистого и высокого, ― всё это приобрело ему ничем не нарушимую симпатию молодой толпы."
                                            },
                                            {
                                                "example_id": "ce800dda-70d5-47df-a3d8-e4cc1b5cf7f4",
                                                "sense_id": "d8adc6fd-82ef-3054-b115-f5baae904c0c",
                                                "text": "Ни одна мысль не высказана до конца, форма крайне скомкана и лишена цельности."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
