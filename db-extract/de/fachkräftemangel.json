                        "examples": [
                            {
                                "example_id": "ad7e9816-3f23-476d-8c82-f319b982c504",
                                "sense_id": "7a9885dd-e0b2-31dc-b3b9-fc379ed97b6a",
                                "text": "Der Fachkräftemangel droht sich laut einer Studie des arbeitgebernahen IW Köln bis 2040 drastisch zu verschärfen. Der Staat müsse schon jetzt gegensteuern, verlangen die Ökonomen.",
                                "translation": "The shortage of skilled workers threatens to drastically exacerbate by 2040, according to a study by IW Köln, the business-friendly German Economic Institute in Cologne. The economists insist that the government must take measures to address this now.",
                                "english": "The shortage of skilled workers threatens to drastically exacerbate by 2040, according to a study by IW Köln, the business-friendly German Economic Institute in Cologne. The economists insist that the government must take measures to address this now."
                            }
                        ]
                    }
