                ],
                "senses": [
                    {
                        "sense_id": "fcd3c41e-2a0c-3d34-89b2-a7e11b22e7a5",
                        "entry_id": "c2236ce5-0a94-3608-837b-634bb9a0d2b9",
                        "glosses": [
                            "aus Hopfen, Malz und Wasser gebrautes alkoholisches und ungefiltertes Getränk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "632dfde5-5409-4a82-993a-f6eaf60650e3",
                                "sense_id": "fcd3c41e-2a0c-3d34-89b2-a7e11b22e7a5",
                                "text": "„Zwickelbier bezeichnet im Grunde genommen eine Probe des in Reifung befindlichen Jungbieres. Früher zapfte der Braumeister aus den Fässern, in welchen sich das Jungbier befand, mittels des Zwickels (eines dünnen Hahnes, welcher durch ein extra gebohrtes Loch in das Fass getrieben wurde) vereinzelt Kostproben des Bieres ab, um seine Entwicklung beurteilen zu können.“"
                            },
                            {
                                "example_id": "300afbdc-2696-4d89-ab7b-cead6d7a4fea",
                                "sense_id": "fcd3c41e-2a0c-3d34-89b2-a7e11b22e7a5",
                                "text": "„In den beiden kupfernen Kesseln wird ab sofort schon ab Mittag gebraut - die Gäste zum Anzapfen des noch unfertigen, trüben Zwickelbieres auch mal in den Bierkeller geladen, verspricht Leopold's neuer Wirt Klaus Schumacher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
