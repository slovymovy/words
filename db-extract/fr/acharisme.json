                        "entry_id": "5eb03748-8e7f-37e2-ad66-cd514684c082",
                        "glosses": [
                            "Branche de l’islam sunnite qui récuse la thèse du libre arbitre au profit de celle de la prédestination et adopte la thèse du Coran éternel et incréé niée par les mutazilites."
                        ],
                        "tags": [
                            "Sunnisme"
                        ],
                        "examples": [
                            {
                                "example_id": "45e43bfc-cdae-4aad-9433-6155996cbbae",
                                "sense_id": "9bf43cfd-1343-361b-97bd-fe6f64304152",
                                "text": "L’acharisme qui représente une idéologie médiane tout en s’appuyant sur l’orthodoxie, est adopté par les Seldjoukides."
                            },
                            {
                                "example_id": "63f83248-ccf3-4701-8d31-61f2e7ca3440",
                                "sense_id": "9bf43cfd-1343-361b-97bd-fe6f64304152",
                                "text": "Avec l’acharisme le sunnisme trouva sa première formulation théologique importante face au mutazilisme et aux sectes."
                            }
                        ]
                    }
