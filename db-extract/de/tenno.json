                ],
                "senses": [
                    {
                        "sense_id": "a860230b-7182-3eae-9151-91ca8c34deef",
                        "entry_id": "6522130d-33a6-3310-a55e-25c1953a7dc7",
                        "glosses": [
                            "Titel des japanischen Herrschers"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "3c23d1c5-7442-4850-bedf-52e7d8e1139e",
                                "sense_id": "a860230b-7182-3eae-9151-91ca8c34deef",
                                "text": "„Als im Herbst ein junger Abgeordneter dem Tenno bei einem Empfang einen Brief überreichte, mit dem er ihn auf das Schicksal der Opfer von Fukushima aufmerksam machen wollte, reagierte das konservative Japan empört.“"
                            },
                            {
                                "example_id": "985f564a-e53e-476f-b421-1a95892fd670",
                                "sense_id": "a860230b-7182-3eae-9151-91ca8c34deef",
                                "text": "„Als Akihito am 12. November 1989 offiziell zum 125. Tenno ausgerufen wurde, stellte er seine Regierungszeit unter die Devise „Heisei“: „werdender Frieden“.“"
                            },
                            {
                                "example_id": "7c9c72bd-c061-4d53-a745-a6c27f8c31bc",
                                "sense_id": "a860230b-7182-3eae-9151-91ca8c34deef",
                                "text": "„Suzuki verlieh dem Augenblick zusätzliche Dramatik, indem er sich vor dem Tenno zu Boden warf.“"
                            }
                        ],
