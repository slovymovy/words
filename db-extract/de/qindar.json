                                                "sense_id": "3fef5fcb-1d8f-35d1-a632-8d2a5b5a285a",
                                                "text": "For all its squalor qintars and qintars of gold dust are traded there."
                                            },
                                            {
                                                "example_id": "a5e325d4-a8ad-4dd5-89b8-13278163fc02",
                                                "sense_id": "3fef5fcb-1d8f-35d1-a632-8d2a5b5a285a",
