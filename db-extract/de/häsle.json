                ],
                "senses": [
                    {
                        "sense_id": "066432cb-19ab-31b4-94c1-cb577b520a84",
                        "entry_id": "9c8b7286-220c-39b7-b48b-880005395b8e",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e4e7d6e-e241-42d4-8656-6a8819a77dd9",
                                "sense_id": "066432cb-19ab-31b4-94c1-cb577b520a84",
                                "text": "Frau Häsle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "66024761-6ef4-4323-98ea-930a36308419",
                                "sense_id": "066432cb-19ab-31b4-94c1-cb577b520a84",
                                "text": "Herr Häsle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "00a0e171-9add-4413-b312-640563b50e72",
                                "sense_id": "066432cb-19ab-31b4-94c1-cb577b520a84",
                                "text": "Die Häsles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "5ea3204c-baa4-4549-980f-0ac7a3772d25",
                                "sense_id": "066432cb-19ab-31b4-94c1-cb577b520a84",
                                "text": "Der Häsle trägt nie die Pullover, die die Häsle ihm strickt."
                            },
                            {
                                "example_id": "4b8321c3-80a1-44ff-8861-affb8f865087",
                                "sense_id": "066432cb-19ab-31b4-94c1-cb577b520a84",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Häsle kommt, geht der Herr Häsle.“"
                            },
                            {
                                "example_id": "2608b336-1060-4f36-8ea2-3e39cf982bb0",
                                "sense_id": "066432cb-19ab-31b4-94c1-cb577b520a84",
                                "text": "Häsle kommt und geht."
                            },
                            {
                                "example_id": "d679155d-eaf1-4d51-b0a8-98401ce1483a",
                                "sense_id": "066432cb-19ab-31b4-94c1-cb577b520a84",
                                "text": "Häsles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
