                        "sense_id": "9dd9500b-2359-3b2b-8d52-a0185d48990a",
                        "entry_id": "991d67fc-1af0-3dc2-82a8-15ebf6a0d12b",
                        "glosses": [
                            "a harrier, predatory bird of the subfamily Circinae"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ae5efea1-d2c2-33e7-8f30-6623723c4400",
                        "entry_id": "991d67fc-1af0-3dc2-82a8-15ebf6a0d12b",
                        "glosses": [
                            "a chicken thief, who steals fowl"
                        ],
                        "tags": [
                            "literally",
                            "masculine",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "87c76de4-b68e-474e-a4b6-20f270772d0a",
                                "sense_id": "ae5efea1-d2c2-33e7-8f30-6623723c4400",
                                "text": "Zoo gingen beiden nu op de vaart, en Reinaert bracht Tibert in de schuur van eenen pastoor, waaruit hij daags te voren eenen haan had geroofd. Een strik stond daar gereed gespannen om den kiekendief te vangen."
                            },
                            {
                                "example_id": "9bc9c9ee-3444-4214-9149-ebe69f430c55",
                                "sense_id": "ae5efea1-d2c2-33e7-8f30-6623723c4400",
                                "text": "“ Padopen ! ” zei Jan, “ daar loopt de vos met mijnen schoonsten haan eweg! ” Hij speelt zijn klonen uit en op zijn slobben met den vlegel in de hand, vliegt hij den kiekendief achterna."
                            },
                            {
                                "example_id": "73880bec-779c-478d-8022-984765311f4a",
                                "sense_id": "ae5efea1-d2c2-33e7-8f30-6623723c4400",
                                "text": "“ Sapperloot ! ” riep Jan, “ daar zie ik den vos met mijn schoonsten haan wegloopen! ” / Rap als de wind wierp hij zijne holsblokken uit, en op zijne zokken, met den dorschvlegel op zijne schouders, achtervolgde hij den kiekendief."
                            },
                            {
                                "example_id": "d823c9cf-23de-41ab-a656-93362552214e",
                                "sense_id": "ae5efea1-d2c2-33e7-8f30-6623723c4400",
                                "text": "Nuttige roofdieren worden al te vaak als kiekendieven door boeren verdelgd",
                                "translation": "Useful predators are all too often exterminated by farmers as 'chicken thieves'",
                                "english": "Useful predators are all too often exterminated by farmers as 'chicken thieves'"
                            }
                        ]
                    }
                ],
