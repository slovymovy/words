                    {
                        "translation_id": "dfb41621-273e-4a01-ae27-38182b8ce59f",
                        "source_entry_id": "89a755b4-7560-3b2a-9aa4-d25f403fd0e6",
                        "source_sense_id": "6e8d0451-dcb3-3670-8bda-941d25b18500",
                        "source_sense_description": "eine Schriftform, bei der die Buchstaben (Lettern) verbunden/zusammenhängend wiedergeben werden",
                        "target_lang_word": "cursive",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cursive",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "71ab13a2-3578-3217-b965-749ac0f5c459",
                                        "entry_id": "3854ff6b-b737-3837-bdaf-9784b3728f4f",
                                        "glosses": [
                                            "Écriture cursive, écriture liée."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6f7b377-c628-440f-916c-20fe171eeeab",
                                                "sense_id": "71ab13a2-3578-3217-b965-749ac0f5c459",
                                                "text": "La cursive est le nom donné aux graphies ayant un tracé rapide résultant de la simplification d'écritures calligraphiées."
                                            },
                                            {
                                                "example_id": "34bd3d2d-9a30-48bc-84b0-4b3f91076d9d",
                                                "sense_id": "71ab13a2-3578-3217-b965-749ac0f5c459",
                                                "text": "Leur filiation réside dans leur intention créatrice : pousser les deux styles de la cursive jusqu’au bout de leurs possibilités."
                                            },
                                            {
                                                "example_id": "0d7cd8f1-9eae-4663-a382-8e80f1b52083",
                                                "sense_id": "71ab13a2-3578-3217-b965-749ac0f5c459",
                                                "text": "L’apprentissage des cursives permet aux enfants d’écrire de manière plus rapide et fluide puisque le nombre de levées de crayon est limité et qu’on enchaîne des lettres dans un mouvement continu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cursive",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b4fcf25-9e3e-3f24-8dd7-fc32571a6702",
                                        "entry_id": "4b49dc60-4803-3199-8e9a-12eda29bfddb",
                                        "glosses": [
                                            "Féminin singulier de cursif."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63490ad8-8cdf-4f03-af3c-40722855f867",
                                                "sense_id": "3b4fcf25-9e3e-3f24-8dd7-fc32571a6702",
                                                "text": "La lecture analytique ou détaillée, feu lecture méthodique, est associée à la lecture des textes littéraires dont il importe de construire le sens, alors que la lecture cursive, comme forme usuelle de la lecture, convient à tous les textes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
