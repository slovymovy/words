                                                "sense_id": "80a128fe-d617-326a-b5dc-4e364eb0ef8c",
                                                "text": "The dough is passed through the pasta machine several times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8185fbf-7a46-384d-a414-68c0bcce641d",
                                        "entry_id": "47cf7f34-8c2f-366f-a9cc-f0b225d40500",
                                        "glosses": [
                                            "To undergo; to experience."
                                        ],
                                        "tags": [],
                                        "examples": [
