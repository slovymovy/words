                "senses": [
                    {
                        "sense_id": "3eee42f1-6354-3b49-a7d6-a692d8f0f516",
                        "entry_id": "c4807109-9aac-34e2-8903-4a93ef4c36e2",
                        "glosses": [
                            "weibliche Person, die Speisen oder Getränke vor jemand anderem probiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66ce33c0-eb5f-4e20-b060-7f0403642b1d",
                                "sense_id": "3eee42f1-6354-3b49-a7d6-a692d8f0f516",
                                "text": "Ich komme mir wie deine Vorkosterin vor, nein, diese Suppe ist weder zu heiß noch zu salzig, die wird dir schmecken. Komm, probier mal selbst!"
                            },
                            {
                                "example_id": "bf71f824-ed0e-4d56-b2b0-ae85e05e468d",
                                "sense_id": "3eee42f1-6354-3b49-a7d6-a692d8f0f516",
                                "text": "Da der Senator panische Angst hatte, vergiftet zu werden, musste seine Frau Dora stets als Vorkosterin fungieren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
