                    {
                        "translation_id": "ad22b8ed-f460-4e3e-862a-1d37359a981b",
                        "source_entry_id": "e5085510-df51-3caa-9858-e0f0ed215fa8",
                        "source_sense_description": "having beautiful buttocks",
                        "target_lang_word": "callipyge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "callipyge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c10109e-daf0-3c83-ab21-591e385ac9f8",
                                        "entry_id": "089a0f18-be5f-309c-873d-2f03b7440e31",
                                        "glosses": [
                                            "Qui a de belles fesses, aux formes harmonieuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e74f8ff-e162-473f-8cd9-14c8cb40b791",
                                                "sense_id": "9c10109e-daf0-3c83-ab21-591e385ac9f8",
                                                "text": "Il y eut à Syracuse deux femmes aux belles fesses, ou callipyges. Ces deux femmes, devenues riches, firent élever un temple à Vénus, qu’elles appelèrent la déesse aux belles fesses, selon ce que dit Archélaüs dans ses Iambes."
                                            },
                                            {
                                                "example_id": "47b92c3f-e832-4799-aec1-2192351cbc01",
                                                "sense_id": "9c10109e-daf0-3c83-ab21-591e385ac9f8",
                                                "text": "Ô gracieuse et callipyge\nTous les culs sont de la Saint-Jean\nLe tien leur fait vraiment la pige\nDéesse aux collines d’argent"
                                            },
                                            {
                                                "example_id": "21a2173a-22e1-40c9-9b33-85cbd7d8a828",
                                                "sense_id": "9c10109e-daf0-3c83-ab21-591e385ac9f8",
                                                "text": "Passait un’ bell’ gretchen au carrefour du château,\nEntre la rue Didot et la rue de Vanves,\nCallipyge à prétendre\nJouer les Vénus chez les Hottentots,\nEntre la rue de Vanv’s et la rue Didot."
                                            },
                                            {
                                                "example_id": "302edc28-4552-464f-80e4-f8187a7ea0b0",
                                                "sense_id": "9c10109e-daf0-3c83-ab21-591e385ac9f8",
                                                "text": "Sensible et callipyge, Victoire, votre pudeur vous embellit.",
                                                "translation": "— (Comte d’Époisse)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eea904db-8045-3625-8336-740614ae8936",
                                        "entry_id": "089a0f18-be5f-309c-873d-2f03b7440e31",
                                        "glosses": [
                                            "Qui a des formes arrondies. Gros et gras."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "ironic",
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
