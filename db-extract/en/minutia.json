                        "target_lang_word": "petit détail",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bcd57324-c625-4df3-9c3d-c135f69b73e4",
                        "source_entry_id": "4db41c9c-1693-3c46-a513-0e4c89e08906",
                        "source_sense_description": "minor detail",
                        "target_lang_word": "Detail",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Detail",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "32c976d4-19d3-3c81-8970-061d468a05e6",
                                        "entry_id": "8194cd5f-b58e-3efa-92d5-4ac708aa37ef",
                                        "glosses": [
                                            "Einzelheit, Einzelnes (so wie bspw.: im Detail = im Einzelnen), Kleinigkeit; auch: charakterisierendes Element"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "585319aa-a9b7-4320-ac21-e1f62b8ab9b8",
                                                "sense_id": "32c976d4-19d3-3c81-8970-061d468a05e6",
                                                "text": "Er liebte jedes Detail."
                                            },
                                            {
                                                "example_id": "7dd94ea3-0ddd-45a6-89cb-b529fba0a3c9",
                                                "sense_id": "32c976d4-19d3-3c81-8970-061d468a05e6",
                                                "text": "„Weitere Details erspare ich mir an dieser Stelle.“"
                                            },
                                            {
                                                "example_id": "5a256d6c-f9d8-4315-9261-4841ce37c15d",
                                                "sense_id": "32c976d4-19d3-3c81-8970-061d468a05e6",
                                                "text": "„Auf weitere Details aus beiden Befragungen muß hier verzichtet werden.“"
                                            },
                                            {
                                                "example_id": "98ee274d-19f1-427c-b695-c98c91d40496",
                                                "sense_id": "32c976d4-19d3-3c81-8970-061d468a05e6",
                                                "text": "„Er arbeitet sich in die technischen Details ein, in den Streit um die Prioritäten im Rahmen der Erfindungen und so fort.“"
                                            },
                                            {
                                                "example_id": "bcb0638d-b220-4038-9c2f-c54d7e9ce062",
                                                "sense_id": "32c976d4-19d3-3c81-8970-061d468a05e6",
                                                "text": "„Der Einblattdruck ist mit viel Liebe zum grausamen Detail gestaltet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41dbf885-c56a-4998-8317-dde6a5c8ba6f",
                        "source_entry_id": "4db41c9c-1693-3c46-a513-0e4c89e08906",
                        "source_sense_description": "minor detail",
                        "target_lang_word": "Einzelheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einzelheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "51e81ec3-7884-379e-9e78-4c9791664ef0",
                                        "entry_id": "0be255da-1072-3e61-8760-2b4aa0707e06",
                                        "glosses": [
                                            "einzelner Teil eines größeren Ganzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "158ec10f-c0c6-4a09-9551-a7c81094a59f",
                                                "sense_id": "51e81ec3-7884-379e-9e78-4c9791664ef0",
                                                "text": "„Dies merkwürdige Stück kann nur verlieren, wenn seine Fassung geändert wird; wie es Bach für Klavier schrieb, ist genial bis in alle Einzelheiten, und jeder Versuch einer Bereicherung kann nur schwächlich wirken.“"
                                            },
                                            {
                                                "example_id": "fcca1077-febd-4e42-828f-877c13407333",
                                                "sense_id": "51e81ec3-7884-379e-9e78-4c9791664ef0",
                                                "text": "„Dort sann ich über die Einzelheiten meines Planes nach.“"
                                            },
                                            {
                                                "example_id": "756c2486-c4ba-4a75-89f0-287068d9373d",
                                                "sense_id": "51e81ec3-7884-379e-9e78-4c9791664ef0",
                                                "text": "„Und er sah die Dinge in allen Einzelheiten, sah die Farbe der Federn, den Busch, die Form und die Färbung der Blätter.“"
                                            },
                                            {
                                                "example_id": "065802b8-eb73-4879-b881-deb9d09ef8ce",
                                                "sense_id": "51e81ec3-7884-379e-9e78-4c9791664ef0",
                                                "text": "„So erzählte sie alle Einzelheiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "918a8efc-57a3-41ad-ba13-c2a375737ec0",
                        "source_entry_id": "4db41c9c-1693-3c46-a513-0e4c89e08906",
                        "source_sense_description": "minor detail",
                        "target_lang_word": "winziges Detail",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3a02f654-ed07-4938-8d19-92105599b6f3",
                        "source_entry_id": "4db41c9c-1693-3c46-a513-0e4c89e08906",
                        "source_sense_description": "minor detail",
                        "target_lang_word": "Kleinigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kleinigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fac20459-820c-380a-a53d-684248c44856",
                                        "entry_id": "e96fe193-aa41-3a2e-a0a9-213a4b2c5b3e",
                                        "glosses": [
                                            "winzige oder unbedeutende Sache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b92c024-3437-4925-bd0b-223cbbc2f20e",
                                                "sense_id": "fac20459-820c-380a-a53d-684248c44856",
                                                "text": "Um die Kleinigkeiten kümmern wir uns später."
                                            },
                                            {
                                                "example_id": "332e788c-7909-4836-b0d0-3284dc471cd3",
                                                "sense_id": "fac20459-820c-380a-a53d-684248c44856",
                                                "text": "„Und dieser feige Verräter spuckte sofort alles aus, was er wußte, ohne die geringste Kleinigkeit auszulassen.“"
                                            },
                                            {
                                                "example_id": "6e4c2861-905a-4d37-b8a4-ee6bea2e481f",
                                                "sense_id": "fac20459-820c-380a-a53d-684248c44856",
                                                "text": "„Kleinigkeiten machten manchmal den größten Unterschied.“"
                                            },
                                            {
                                                "example_id": "22a398f2-bf61-4a07-a7dc-c108f4ca2cd9",
                                                "sense_id": "fac20459-820c-380a-a53d-684248c44856",
                                                "text": "„Aber an diesen Kleinigkeiten soll man sich nicht stoßen, wenn es gilt, einen neuen Markenartikel auszuprobieren, der einem so unwiderstehlich angeboten wird.“"
                                            },
                                            {
                                                "example_id": "11b91152-b0f2-4ee0-b2fb-e3c7b853278b",
                                                "sense_id": "fac20459-820c-380a-a53d-684248c44856",
                                                "text": "„Ein unangenehmes Gefühl befällt Guđriđur, die dabei ist, Kaffee zu kochen und eine Kleinigkeit anzurichten, nichts Bedeutendes, das weiß sie, aber immerhin etwas, und sie gibt sich Mühe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74288afe-2c71-4253-a638-799776fde78b",
                        "source_entry_id": "4db41c9c-1693-3c46-a513-0e4c89e08906",
                        "source_sense_description": "minor detail",
                        "target_lang_word": "Nebensächlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nebensächlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eaaa627a-94d0-3a3e-917e-98468c182ac9",
                                        "entry_id": "63587bae-a1a5-3938-bd3e-2db15134c718",
                                        "glosses": [
                                            "etwas, das in den Augen des Betrachters nicht so wichtig ist wie vieles andere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72f2022f-808b-4544-8728-2a624009b7ea",
                                                "sense_id": "eaaa627a-94d0-3a3e-917e-98468c182ac9",
                                                "text": "Nun lass uns mal nicht über die Nebensächlichkeiten reden. Mir geht es hier um die große Linie. Bis du bei diesem Geschäft dabei oder nicht?"
                                            },
                                            {
                                                "example_id": "736ded06-8b7f-4ba0-ba85-a0e40db11c9d",
                                                "sense_id": "eaaa627a-94d0-3a3e-917e-98468c182ac9",
                                                "text": "„Es stimmte, dass ich auf Nebensächlichkeiten wie das Wetter kaum achtete, da andere Dinge meine ganze Aufmerksamkeit in Anspruch nahmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
