                "senses": [
                    {
                        "sense_id": "5e5cadfe-2111-3cd7-9fee-b61ff49fb219",
                        "entry_id": "cd8b8431-aa9a-33ac-8a24-5952e686c2f7",
                        "glosses": [
                            "energy transition, the transition from energy generated from fossil fuels to renewable energy; Energiewende"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "ef35b5fc-216e-4c6b-b105-3544ab630053",
                                "sense_id": "5e5cadfe-2111-3cd7-9fee-b61ff49fb219",
                                "text": "„Wenn wir jetzt unsere große Energiewende organisieren, wenn wir dafür sorgen, dass wir auf erneuerbare Energien setzen und aussteigen aus der Kohleverstromung“, hatte der Kanzler gerade gesagt, „dann ist schon die Frage, was wir dem Arbeiter und der Arbeiterin in den Tagebauen sagen über seine Perspektive.“"
                            },
                            {
                                "example_id": "abaf3362-12f2-4b47-9ea2-76c137335442",
                                "sense_id": "5e5cadfe-2111-3cd7-9fee-b61ff49fb219",
                                "text": "Mit den Nord-Stream-Pipelines explodierte an jenem Tag auch das bisherige Konzept der deutschen Energiewende."
                            }
                        ]
                    }
                ],
