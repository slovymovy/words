                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The geologist examined the <w>depressed</w> section of the landscape.",
                            "target_lang_translations": {
                                "ru": "Геолог осмотрел <w>пониженный</w> участок ландшафта.",
                                "zh": "地质学家检查了地貌中<w>凹陷</w>的部分。",
                                "es": "El geólogo examinó la sección <w>hundida</w> del paisaje.",
                                "tr": "Jeolog, arazinin <w>çukurlaşmış</w> kısmını inceledi.",
                                "de": "Der Geologe untersuchte den <w>vertieften</w> Abschnitt der Landschaft."
                            }
                        },
                        {
                            "text": "A <w>depressed</w> fracture of the skull requires immediate medical attention.",
                            "target_lang_translations": {
                                "ru": "<w>Вдавленный</w> перелом черепа требует немедленной медицинской помощи.",
                                "zh": "颅骨<w>凹陷</w>性骨折需要立即就医。",
                                "es": "Una fractura <w>hundida</w> del cráneo requiere atención médica inmediata.",
                                "tr": "Kafatası üzerindeki <w>çökük</w> bir kırık, acil tıbbi müdahale gerektirir.",
                                "de": "Eine <w>eingedrückte</w> Schädelfraktur erfordert sofortige medizinische Behandlung."
                            }
                        }
                    ],
                    "common_phrases": [
                        "depressed fracture",
                        "depressed button"
                    ],
                    "target_lang_definitions": {
