                        "glosses": [
                            "Of or pertaining to a council, especially an ecclesiastical council."
                        ],
                        "tags": [
                            "formal",
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "004e665f-e6de-4360-a05c-df0c43396b5b",
                                "sense_id": "823c5f4a-35b2-373a-9de7-216d4181655b",
                                "text": "The next few years saw increasing tension between those wishing to develop this conciliar mechanism and successive popes seeking to build on the papacy's newly restored integrity."
                            },
                            {
                                "example_id": "76aed2ec-464e-4362-9fb9-ae6abd93f545",
                                "sense_id": "823c5f4a-35b2-373a-9de7-216d4181655b",
                                "text": "This was the era which witnessed the beginnings of the conciliar movement, which sought to subordinate the papacy to the decisions of Church Councils."
                            }
                        ]
                    }
