                "senses": [
                    {
                        "sense_id": "3cab1721-a771-3118-ab23-74293d306363",
                        "entry_id": "e027d13c-adcc-368a-8661-efaf26825bb7",
                        "glosses": [
                            "Verabreichung (Impfen) eines Serums, das den menschlichen Körper vor der durch das Coronavirus SARS-CoV-2 verursachten Krankheit Covid-19 schützen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f9d6847-c85c-4c06-9943-b894c061305f",
                                "sense_id": "3cab1721-a771-3118-ab23-74293d306363",
                                "text": "„Wenn die Corona-Impfung da ist, heißt es dann Arm gegen Reich?“"
                            },
                            {
                                "example_id": "f60ae7d5-55ef-4031-9c31-bf986a2d9548",
                                "sense_id": "3cab1721-a771-3118-ab23-74293d306363",
                                "text": "„Nach Meinung der Chefwissenschaftlerin der Weltgesundheitsorganisation WHO könnte eine breit abgelegte Corona-Impfung Mitte 2021 erfolgen.“"
                            },
                            {
                                "example_id": "4570d416-df5d-484e-b671-3d7f7022b0c8",
                                "sense_id": "3cab1721-a771-3118-ab23-74293d306363",
                                "text": "„Wann kommt die Corona-Impfung?“"
                            },
                            {
                                "example_id": "2aac8be4-f944-47a2-911b-a54efad51f6a",
                                "sense_id": "3cab1721-a771-3118-ab23-74293d306363",
                                "text": "„In den vergangenen drei Monaten ist die Zahl der Befürworter einer Corona-Impfung gesunken. Gründe dafür seien die Angst vor Nebenwirkungen oder unklare Sicherheit.“"
                            },
                            {
                                "example_id": "43abb0ac-5d95-41c7-9e8a-414b28c25f2b",
                                "sense_id": "3cab1721-a771-3118-ab23-74293d306363",
                                "text": "„Einen Gesetzesentwurf gibt es zwar nicht - trotzdem ist eine Corona-Impfung in aller Munde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
