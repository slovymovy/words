                "senses": [
                    {
                        "sense_id": "e1ed62c2-cacf-37a9-a665-f74f84e36136",
                        "entry_id": "422efb4e-22ba-347d-8f3f-4616308c2e70",
                        "glosses": [
                            "автомобиль чешской марки Tatra"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fa179e0-05d8-447e-b5a9-73706d1ef9ce",
                                "sense_id": "e1ed62c2-cacf-37a9-a665-f74f84e36136",
                                "text": "«Зимы», «зисы» и «татры», // Сдвинув полосы фар, // Подъезжают к театру, // И слепят тротуар."
                            },
                            {
                                "example_id": "18c0b5cf-48ab-40ff-891f-922b3698f531",
                                "sense_id": "e1ed62c2-cacf-37a9-a665-f74f84e36136",
                                "text": "Вайс получил новенькую высокоосную чехословацкую «татру» с мотором воздушного охлаждения — машину, приспособленную к армейским нуждам, со специальными креплениями в передней и задней части корпуса для установки пулемета."
                            }
                        ]
                    }
