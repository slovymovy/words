                "senses": [
                    {
                        "sense_id": "c012005e-dd56-32f2-9f4d-91b66376141c",
                        "entry_id": "b96d67b3-4ab1-314d-9083-81f2498d5f83",
                        "glosses": [
                            "ontevreden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86951118-646e-4b9e-a59b-93ae26670675",
                                "sense_id": "c012005e-dd56-32f2-9f4d-91b66376141c",
                                "text": "In tijden van crisis kan je je geld maar beter niet over de balk gooien. Dat moet Trevor Jessup gedacht hebben toen hij niet tevreden was over het 'VIP-arrangement' dat een naaktdanseres hem had verstrekt. De malcontente klant pikte gewoon zijn centen terug uit de tas van de stripper."
                            },
                            {
                                "example_id": "0f8e565b-0383-4519-a15d-fcdd88853b54",
                                "sense_id": "c012005e-dd56-32f2-9f4d-91b66376141c",
                                "text": "Slotsom. Hoe strikter de scheiding en hoe completer de uitleg, hoe beter. Uiteindelijk gaat het om het verschil tussen journalistiek en reclame, niet alleen om lettertypes, partner content, malcontente of contente partners."
                            }
                        ]
                    }
