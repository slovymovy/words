                        "glosses": [
                            "groep mensen die samen een kleinkunstvoorstelling maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ea51c51-db94-4497-ac00-a505f87250f2",
                                "sense_id": "ee3e7a17-f03a-3172-8f07-a010a44f2ebd",
                                "text": "Behalve zijn rol in het cabaretgezelschap was Florusse actief als presentator, acteur en regisseur. Zo presenteerde hij in de jaren 80 het Schooltv-weekjournaal, samen met Jantine de Jonge."
                            },
                            {
                                "example_id": "ed85f8bc-756d-489a-a81c-c345af0fbd01",
                                "sense_id": "ee3e7a17-f03a-3172-8f07-a010a44f2ebd",
                                "text": "Pieter van Empelen, medeoprichter van het cabaretgezelschap Don Quishocking, is op 74-jarige leeftijd overleden. Van Empelen was tekstschrijver, pianist en componist."
                            }
                        ]
                    }
