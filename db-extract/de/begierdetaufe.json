                "senses": [
                    {
                        "sense_id": "f72c393d-6873-3d4c-9820-a43f40810b9f",
                        "entry_id": "4e725667-a646-307c-8b82-7da52652deda",
                        "glosses": [
                            "Form der Taufe, die jemandem, der das Taufsakrament aufgrund bestimmter äußerer, unverschuldeter Gründe nicht empfangen kann, zuteilwerden kann"
                        ],
                        "tags": [
                            "katholische Theologie"
                        ],
                        "examples": [
                            {
                                "example_id": "190bebe0-0a96-487d-bb54-ef13e177b0f3",
                                "sense_id": "f72c393d-6873-3d4c-9820-a43f40810b9f",
                                "text": "„Theologiegeschichtlich wurde in Bezug auf die Begierdetaufe ([…]) jedoch unterschiedlich darauf geantwortet, ob der Wunsch mit dem ausdrücklichen Bekenntnis des Glaubens an Gott und einen von ihm gesandten Erlöser verbunden sein müsse, oder aber ein impliziter Wunsch (aufrichtiges Bemühen um ein gerechtes Leben und aufrichtige Suche nach dem wahren Gott) ohne ausdrückliches Bekenntnis die Bedingung der Begierdetaufe erfülle.“"
                            },
                            {
                                "example_id": "2f8b4685-9ee6-420a-ad54-eaf28583f874",
                                "sense_id": "f72c393d-6873-3d4c-9820-a43f40810b9f",
                                "text": "„Die Begierdetaufe ist das mit vollkommener Reue verbundene ausdrückliche oder eingeschlossene Verlangen nach der sakramentalen Taufe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
