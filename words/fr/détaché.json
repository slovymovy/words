    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6d3b0a52-7520-352b-b8c4-ee208c219ff0",
                    "sense_definition": "Qui n'est plus attaché, noué ou fixé physiquement à quelque chose d'autre.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "separation_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chien court librement dans le jardin parce qu'il est <w>détaché</w>."
                        },
                        {
                            "text": "Attention, ton lacet est <w>détaché</w>, tu risques de tomber !"
                        }
                    ],
                    "synonyms": [
                        "délié",
                        "décroché"
                    ],
                    "antonyms": [
                        "lié"
                    ],
                    "common_phrases": [
                        "cheveux détachés",
                        "pièces détachées"
                    ]
                },
                {
                    "sense_id": "c67ff1c6-dbec-356d-a1ee-89d91ea243d4",
                    "sense_definition": "Qui montre de l'indifférence, du désintérêt ou du recul affectif face à une situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude_mentale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il répondait aux questions difficiles d'un ton parfaitement calme et <w>détaché</w>."
                        },
                        {
                            "text": "Elle gardait un regard <w>détaché</w> sur les conflits qui agitaient ses collègues de bureau."
                        }
                    ],
                    "synonyms": [
                        "indifférent",
                        "distant",
                        "désintéressé"
                    ],
                    "common_phrases": [
                        "ton détaché",
                        "air détaché"
                    ]
                },
                {
                    "sense_id": "4897ed33-aa74-36c6-a3d0-3fdfb9da9988",
                    "sense_definition": "Affecté temporairement à une autre fonction, une autre unité ou une autre administration.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "professionnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce professeur est actuellement <w>détaché</w> auprès d'une ambassade pour deux ans."
                        },
                        {
                            "text": "Le fonctionnaire <w>détaché</w> conserve ses droits à l'avancement dans son administration d'origine."
                        }
                    ],
                    "synonyms": [
                        "affecté",
                        "délégué"
                    ]
                },
                {
                    "sense_id": "9834ba42-fb04-34ac-b667-c6c436dfbc9f",
                    "sense_definition": "En musique, qualifie des notes jouées séparément les unes des autres de façon nette.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pianiste interprète ce passage rapide avec un toucher remarquablement <w>détaché</w>."
                        },
                        {
                            "text": "Le chef d'orchestre demande aux violons de produire des sons bien <w>détachés</w>."
                        }
                    ],
                    "synonyms": [
                        "staccato",
                        "saccadé"
                    ],
                    "antonyms": [
                        "lié"
                    ],
                    "common_phrases": [
                        "notes détachées"
                    ]
                }
            ]
        },
        {
