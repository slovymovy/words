                ],
                "senses": [
                    {
                        "sense_id": "ab35bdb0-ef6c-38a4-8e47-4b667c515be9",
                        "entry_id": "3b9b8339-65d5-32ae-8dbb-f59daf006792",
                        "glosses": [
                            "kibic"
                        ],
                        "tags": [
                            "Poznań",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "ec9e42dd-4ad8-40a4-8247-a0c34f299869",
                                "sense_id": "ab35bdb0-ef6c-38a4-8e47-4b667c515be9",
                                "text": "Prawdziwy kibol to taki szplin, co cołki tydzień będzie wcinał ino skibki z gzikiem i ślepe ryby. Za uszperane bejmy zaś kupi bilet na Kolejorza"
                            },
                            {
                                "example_id": "6b773b63-568c-445e-ba25-a501d53a21c8",
                                "sense_id": "ab35bdb0-ef6c-38a4-8e47-4b667c515be9",
                                "text": "Przyszłem ździebko do rozumu, patrzę, a tu Helci nie ma. Poszła precz. Wylynga nie kibol!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "25871a77-1c36-3954-b778-7dc1cf7ae321",
                        "entry_id": "3b9b8339-65d5-32ae-8dbb-f59daf006792",
                        "glosses": [
                            "kibic, fanatyk jakiejś drużyny, często zachowujący się agresywnie, chuligan stadionowy"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "9b315fff-b3c6-4c11-939e-2d0a112925b2",
                                "sense_id": "25871a77-1c36-3954-b778-7dc1cf7ae321",
                                "text": "Kibole znów zrobili zadymę na meczu."
                            },
                            {
                                "example_id": "6996b75c-a626-4431-a190-a32b4bddf2f9",
                                "sense_id": "25871a77-1c36-3954-b778-7dc1cf7ae321",
                                "text": "W poradnikowych tekstach dla kibiców wybierających się nad Wisłę przestrzega się więc szczególnie przed tutejszymi kibolami"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
