{
    "word_family": [
        "czujny",
        "czujność",
        "czujka"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c7ae90ba-c7a6-3df2-b4fa-64718699a878",
                    "sense_definition": "nie spać, pozostawać w stanie aktywności umysłowej",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "stan_aktywnosci",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chore dziecko <w>czuwało</w> przez całą noc, więc rodzice nie mogli zasnąć.",
                            "target_lang_translations": {
                                "ru": "Больной ребенок <w>бодрствовал</w> всю ночь, поэтому родители не могли уснуть."
                            }
                        },
                        {
                            "text": "Muszę <w>czuwać</w> do rana, aby dokończyć ten ważny projekt.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>не спать</w> до утра, чтобы закончить этот важный проект."
                            }
                        }
                    ],
                    "synonyms": [
                        "nie spać"
                    ],
                    "antonyms": [
                        "spać"
                    ],
                    "common_phrases": [
                        "czuwać do rana"
                    ],
                    "target_lang_definitions": {
                        "ru": "не спать, оставаться в состоянии бодрствования"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бодрствовать",
                                "target_lang_sense_clarification": "находиться в состоянии бодрствования, не спать"
                            },
                            {
                                "target_lang_word": "не спать",
                                "target_lang_sense_clarification": "наиболее употребительный вариант в разговорной речи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b44d16d5-ac98-324c-a1df-33a5e00d7b73",
                    "sense_definition": "strzec, pilnować kogoś lub czegoś, dbać o bezpieczeństwo",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "opieka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Anioł stróż <w>czuwa</w> nad każdym człowiekiem.",
                            "target_lang_translations": {
                                "ru": "Ангел-хранитель <w>присматривает</w> за каждым человеком."
                            }
                        },
                        {
                            "text": "Lekarz <w>czuwa</w> nad stanem zdrowia pacjenta po operacji.",
                            "target_lang_translations": {
                                "ru": "Врач <w>следит</w> за состоянием здоровья пациента после операции."
                            }
                        }
                    ],
                    "synonyms": [
                        "pilnować",
                        "strzec"
                    ],
                    "common_phrases": [
                        "czuwać nad kimś",
                        "czuwać nad czymś"
                    ],
                    "target_lang_definitions": {
                        "ru": "охранять, присматривать за кем-то или чем-то, заботиться о безопасности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "присматривать",
                                "target_lang_sense_clarification": "следить за кем-то, заботиться о безопасности"
                            },
                            {
                                "target_lang_word": "охранять",
                                "target_lang_sense_clarification": "обеспечивать защиту и безопасность"
                            },
                            {
                                "target_lang_word": "бдеть",
                                "target_lang_sense_clarification": "книжное, неусыпно следить за чем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f6b15f6-cb73-3996-9ddf-23fba822c4af",
                    "sense_definition": "być czujnym, zachowywać ostrożność, kontrolować sytuację",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stan_aktywnosci",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kierownik <w>czuwał</w>, aby wszystko odbyło się zgodnie z harmonogramem.",
                            "target_lang_translations": {
                                "ru": "Руководитель <w>следил</w> за тем, чтобы всё прошло по графику."
                            }
                        },
                        {
                            "text": "Musimy <w>czuwać</w>, bo sytuacja na rynku jest bardzo niepewna.",
                            "target_lang_translations": {
                                "ru": "Мы должны <w>быть начеку</w>, потому что ситуация на рынке очень нестабильна."
                            }
                        }
                    ],
                    "synonyms": [
                        "uważać",
                        "kontrolować"
                    ],
                    "common_phrases": [
                        "czuwać nad przebiegiem"
                    ],
                    "target_lang_definitions": {
                        "ru": "быть бдительным, проявлять осторожность, контролировать ситуацию"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть начеку",
                                "target_lang_sense_clarification": "проявлять бдительность и осторожность"
                            },
                            {
                                "target_lang_word": "следить",
                                "target_lang_sense_clarification": "контролировать развитие событий"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}