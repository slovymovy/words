                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ebace51-f030-4293-9a1a-d280c7ec5587",
                        "source_entry_id": "efdb3537-2344-3f1d-818d-b54f14b8b7af",
                        "source_sense_id": "bec67d95-5e75-31a5-8864-ec19e7f675d2",
                        "source_sense_description": "aanwijzing",
                        "target_lang_word": "Hinweis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hinweis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c414d8ef-664b-31d7-ad40-7756cf0c2616",
                                        "entry_id": "7d5c98c1-1e02-3f61-9061-e38b1a8a2c13",
                                        "glosses": [
                                            "die Handlung, jemanden auf etwas aufmerksam zu machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9a1f117-eb00-470b-ad50-922b4ba25ef7",
                                                "sense_id": "c414d8ef-664b-31d7-ad40-7756cf0c2616",
                                                "text": "Er gab ihm einen Hinweis."
                                            },
                                            {
                                                "example_id": "3304c28a-d672-49d0-951d-f1feef0355ab",
                                                "sense_id": "c414d8ef-664b-31d7-ad40-7756cf0c2616",
                                                "text": "„Es kam ihm vor, als ginge der amerikanische Hauptmann hastig über diesen Hinweis hinweg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "30880ae7-ddf7-35a2-9042-e2df88883b15",
                                        "entry_id": "7d5c98c1-1e02-3f61-9061-e38b1a8a2c13",
                                        "glosses": [
                                            "etwas, das jemanden auf etwas aufmerksam macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "103660e0-c1b7-4491-b683-4bc6d3f518df",
                                                "sense_id": "30880ae7-ddf7-35a2-9042-e2df88883b15",
                                                "text": "Die Kratzer waren Hinweise auf einen Kampf."
                                            },
                                            {
                                                "example_id": "545b71ba-e44c-41f7-845f-6766ef93f20a",
                                                "sense_id": "30880ae7-ddf7-35a2-9042-e2df88883b15",
                                                "text": "Wer zweckdienliche Hinweise zum Unfall geben kann, wird gebeten, sich bei der Polizei zu melden."
                                            },
                                            {
                                                "example_id": "4aeb0ad1-463a-4f53-a895-d21caf613f8b",
                                                "sense_id": "30880ae7-ddf7-35a2-9042-e2df88883b15",
                                                "text": "„Auch wenn die Schätzungen zu Hebungen in Afrika sehr weit auseinandergehen, gibt es doch Hinweise darauf, dass zum Beispiel das Gebirgsgebiet Namibias, welches aktuell bis über 2000 Meter hoch aufragt, in den letzten 10 Millionen Jahren um etwa 1000 Meter angehoben wurde.“"
                                            },
                                            {
                                                "example_id": "3c268747-56ce-4aa6-85f7-f41450a6abee",
                                                "sense_id": "30880ae7-ddf7-35a2-9042-e2df88883b15",
                                                "text": "„Vielleicht verbargen sich in ihrem Suchverlauf irgendwelche Hinweise darauf, dass sie geplant hatte, Eiríkur zu verlassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bcf33ebc-3dc8-4251-99a0-1a898b474e08",
                        "source_entry_id": "efdb3537-2344-3f1d-818d-b54f14b8b7af",
                        "source_sense_id": "bec67d95-5e75-31a5-8864-ec19e7f675d2",
                        "source_sense_description": "aanwijzing",
                        "target_lang_word": "Indiz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Indiz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e15a9330-9126-32de-8c12-78da500d0874",
                                        "entry_id": "c1363ebd-3aa0-3328-8ab7-274fd001e738",
                                        "glosses": [
                                            "Hinweis; Andeutung; eine Information, die bestimmte Ereignisse wahrscheinlich macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efffccd9-c6b2-497f-a46f-522667543e95",
                                                "sense_id": "e15a9330-9126-32de-8c12-78da500d0874",
                                                "text": "Die Indizien in diesem Fall sprechen für einen Selbstmord."
                                            },
                                            {
                                                "example_id": "53a8916e-aa7c-45f6-b7e9-886ba1b05766",
                                                "sense_id": "e15a9330-9126-32de-8c12-78da500d0874",
                                                "text": "„Tatsächlich hat die Polizei viele Indizien, die nahelegen, dass Abubaker C. der Mörder ist.“"
                                            },
                                            {
                                                "example_id": "3e1d1655-6ac2-4b0b-ba87-bde29facbc67",
                                                "sense_id": "e15a9330-9126-32de-8c12-78da500d0874",
                                                "text": "„Die Unfallhäufigkeit gilt als Indiz dafür, wie gut eine Firma die Betriebsabläufe generell im Griff hat.“"
                                            },
                                            {
                                                "example_id": "eccabd44-256f-4ecc-954a-9e0afea342a8",
                                                "sense_id": "e15a9330-9126-32de-8c12-78da500d0874",
                                                "text": "„Indiz für den verbreiteten Wunsch, Wagemut zu demonstrieren und sich über das starke Tier zu profilieren, ist auch das Stiertreiben (Encierro), das am Morgen eines Stierkampftages im spanischen Pamplona […] die sogenannten Corredores auf die Straßen zieht.“"
                                            },
                                            {
                                                "example_id": "dc11728d-8641-4dab-b5cb-4dcd64eae367",
                                                "sense_id": "e15a9330-9126-32de-8c12-78da500d0874",
                                                "text": "„Der Pastor wurde übrigens aufgrund eines merkwürdigen Indizes endgültig der Tötung seiner Ehefrau überführt: Er hatte die Gummistiefel, in denen er seine Frau am Waldesrand umgebracht hatte, im Geländewagen vergessen.“"
                                            },
                                            {
                                                "example_id": "9b21018c-0939-4bf7-9a83-87a10d226454",
                                                "sense_id": "e15a9330-9126-32de-8c12-78da500d0874",
                                                "text": "[O.J. Simpson: Im Prozess] „wird der berühmte Sportler trotz überwältigender Indizien freigesprochen.“"
                                            },
                                            {
                                                "example_id": "8c9ffef1-4705-4a9a-8c5f-97eac61cd83a",
                                                "sense_id": "e15a9330-9126-32de-8c12-78da500d0874",
                                                "text": "„Es gebe Indizien für ein ‚ausgeprägtes‘ Racial Profiling in Deutschland.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "140cd648-5fb2-4e03-bcea-95136ce64f5f",
                        "source_entry_id": "efdb3537-2344-3f1d-818d-b54f14b8b7af",
                        "source_sense_id": "bec67d95-5e75-31a5-8864-ec19e7f675d2",
                        "source_sense_description": "aanwijzing",
                        "target_lang_word": "indication",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indication",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc73c02b-8f98-3cbc-ae60-ce884b26e523",
                                        "entry_id": "552590ca-bc59-3868-9300-b72966607651",
                                        "glosses": [
                                            "An act of pointing out or indicating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6cca1452-346d-39e2-96f7-f533463302e1",
                                        "entry_id": "552590ca-bc59-3868-9300-b72966607651",
                                        "glosses": [
                                            "A fact that shows that something exists or may happen."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94354c2a-0e2b-4364-8042-f97ef56f53f7",
                                                "sense_id": "6cca1452-346d-39e2-96f7-f533463302e1",
                                                "text": "The frequent stops they make in the most convenient places are plain indications of their weariness."
                                            },
                                            {
                                                "example_id": "955a3423-c2c8-49ec-a6e3-6739a2a32776",
                                                "sense_id": "6cca1452-346d-39e2-96f7-f533463302e1",
                                                "text": "There's no indication that the fire was caused by criminals."
                                            },
                                            {
                                                "example_id": "7b625990-1514-485f-8b65-2a065619047f",
                                                "sense_id": "6cca1452-346d-39e2-96f7-f533463302e1",
                                                "text": "All the indications point to drink-driving as the cause of the accident."
                                            },
                                            {
                                                "example_id": "fa279e17-670f-4ec8-a7d5-81142d7e6d1c",
                                                "sense_id": "6cca1452-346d-39e2-96f7-f533463302e1",
                                                "text": "Her shrewd eye, accustomed to note the slightest indications, had already marked their likeness to each other, and that ease of affection which belongs to habit and relationship."
                                            },
                                            {
                                                "example_id": "1a5412ea-1699-4e9c-a64d-a7ceb77ec56c",
                                                "sense_id": "6cca1452-346d-39e2-96f7-f533463302e1",
                                                "text": "We turn briefly to ME /ɛː/ and /ɔː/. There is little or no indication of change for most of the sixteenth century; Bellot’s ME /ɛː/ has ‘the mouth halfe open’, which does not suggest anything closer than [ɛː], other French and German writers give similar descriptions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be46fa0d-d7fc-3893-ae99-c4e6c371125c",
                                        "entry_id": "552590ca-bc59-3868-9300-b72966607651",
                                        "glosses": [
                                            "A mark or another symbol used to represent something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "332d0098-a498-3492-8108-4b5c64564568",
                                        "entry_id": "552590ca-bc59-3868-9300-b72966607651",
                                        "glosses": [
                                            "A discovery made; information."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8781f7e-57fe-3974-9852-f6f0c563e013",
                                        "entry_id": "552590ca-bc59-3868-9300-b72966607651",
                                        "glosses": [
                                            "An explanation; a display."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fd1c4cb-0cf2-4046-8cbb-0a3341a2b2fe",
                                                "sense_id": "a8781f7e-57fe-3974-9852-f6f0c563e013",
                                                "text": "For the indication either proceeds from one experiment to another; or else from experiments to axioms; which axioms themselves suggest new experiments."
                                            },
                                            {
                                                "example_id": "f952f771-1a42-4648-99d6-ee0ff153f773",
                                                "sense_id": "a8781f7e-57fe-3974-9852-f6f0c563e013",
                                                "text": "The committee, unknown to the workmen, also followed the next or succeeding mash, which was better made, and obtained the following results: First indication of the saccharometer .. 7⅘ degrees. Last indication of the saccharometer ... 1"
                                            },
                                            {
                                                "example_id": "4affe040-d9f2-4eac-a8d5-e03af36a0608",
                                                "sense_id": "a8781f7e-57fe-3974-9852-f6f0c563e013",
                                                "text": "In an electrical anunciator the combination with a plurality of indicators all operative conjointly and simultaneously by any one of several circuit closers and adapted to give a combined indication, of the automatic means for holding the circuit closed until all of the indicators in the circuit have made their indications, and then resetting the operated circuit closer ready for another operation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7caca58-546c-36ff-b2da-35a295220e48",
                                        "entry_id": "552590ca-bc59-3868-9300-b72966607651",
                                        "glosses": [
                                            "Any symptom or occurrence in a disease that serves to direct to suitable remedies; the problem that warrants and prompts the use of a diagnostic test, imaging mode, or treatment (e.g., medication, surgical procedure)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b7c0916-3c04-4feb-9b57-10b45f4a3ff2",
                                                "sense_id": "c7caca58-546c-36ff-b2da-35a295220e48",
                                                "text": "Influenza and suspected influenza are FDA-approved indications for oseltamivir."
                                            },
                                            {
                                                "example_id": "f7cd615d-b335-4861-8409-2452da55eab7",
                                                "sense_id": "c7caca58-546c-36ff-b2da-35a295220e48",
                                                "text": "In the United States, major depressive disorder is an off-label indication for clomipramine, but in various other countries, it is an approved indication."
                                            },
                                            {
                                                "example_id": "69e801d0-0d73-4b53-8a69-63cc0113ed11",
                                                "sense_id": "c7caca58-546c-36ff-b2da-35a295220e48",
                                                "text": "The theme of treatment failure of previous treatments plus continuing impairment (pain and poor function) appears among the indications for many types of joint replacement surgery."
                                            },
                                            {
                                                "example_id": "6001897f-86d7-44cc-af9a-68f70223b444",
                                                "sense_id": "c7caca58-546c-36ff-b2da-35a295220e48",
                                                "text": "The first indication he meets by a dose of calomel, 1o to .30 gm., followed, if necessary, by magnesium sulphate in boiled water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7aedbabb-4633-3c33-bf02-c397a0af10eb",
                                        "entry_id": "552590ca-bc59-3868-9300-b72966607651",
                                        "glosses": [
                                            "A declared approximation of the price at which a traded security is likely to commence trading."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c21b92b4-8dea-47ab-bfb7-fa4104e44283",
                        "source_entry_id": "efdb3537-2344-3f1d-818d-b54f14b8b7af",
                        "source_sense_id": "bec67d95-5e75-31a5-8864-ec19e7f675d2",
                        "source_sense_description": "aanwijzing",
                        "target_lang_word": "indication",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indication",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37c8bf91-91df-30f4-88e3-7fd265e004dd",
                                        "entry_id": "1f49b951-aa75-39b4-98f6-d989a473a4ca",
                                        "glosses": [
                                            "Action d’indiquer ; le renseignement fourni."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bcd83a9-551d-4beb-b1f2-5a6ec4601062",
                                                "sense_id": "37c8bf91-91df-30f4-88e3-7fd265e004dd",
                                                "text": "[…]; arrivé devant cette planche où l'on espérait lire une indication de route, on se trouve en face d'une sauvage peinture, barbouillage de flammes rouges et d'ailes volantes ; […]."
                                            },
                                            {
                                                "example_id": "e72a8ef6-37e6-42cb-bdb1-429f7c341f35",
                                                "sense_id": "37c8bf91-91df-30f4-88e3-7fd265e004dd",
                                                "text": "Le reste, sauf, si l'on veut, le compas de relèvement, est à l'avenant, ou parfaitement dérisoire, comme le spidomètre (pour mesurer la vitesse), sans aucune précision, donc sans usage de loch, sans raison d'être hors de régate, et l'anémomètre, dont l’indication... dépend de l'endroit où on le place."
                                            },
                                            {
                                                "example_id": "f3a74e6b-0e81-44f3-a7fc-101bfeddda87",
                                                "sense_id": "37c8bf91-91df-30f4-88e3-7fd265e004dd",
                                                "text": "Il fut arrêté dans la foule, sur l’indication d’un tel."
                                            },
                                            {
                                                "example_id": "f2571c1b-1ddd-4e81-b315-4ba2ce8864ef",
                                                "sense_id": "37c8bf91-91df-30f4-88e3-7fd265e004dd",
                                                "text": "Cela peut fournir d’utiles indications. — Vous m’aviez donné une fausse indication."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d09a04d-1310-30ef-8ef1-94448f73bd1a",
                                        "entry_id": "1f49b951-aa75-39b4-98f6-d989a473a4ca",
                                        "glosses": [
                                            "Ce qui indique, ce qui donne à connaître quelque chose, et qui en est une espèce de signe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d45c0bc7-3ba9-4dfd-a3f1-0c434a6738c2",
                                                "sense_id": "9d09a04d-1310-30ef-8ef1-94448f73bd1a",
                                                "text": "Son embarras est une indication de sa faute, une indication qu’il se sent coupable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "178837d5-4ea0-3ed3-a7ec-68bcd2434337",
                                        "entry_id": "1f49b951-aa75-39b4-98f6-d989a473a4ca",
                                        "glosses": [
                                            "Justification médicale (situation clinique en général : diagnostic, pathologie, etc.) d’un examen ou d’un traitement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b74c1bf9-0e3b-4e79-bfb2-e22dd36193b9",
                                                "sense_id": "178837d5-4ea0-3ed3-a7ec-68bcd2434337",
                                                "text": "Les indications des radiographies du crâne sont limitées aux suspicions d’embarrure et aux plaies profondes"
                                            },
                                            {
                                                "example_id": "b0cca5ba-ea85-4196-be7b-4b88902b8e3e",
                                                "sense_id": "178837d5-4ea0-3ed3-a7ec-68bcd2434337",
                                                "text": "À la fin du XIXᵉ siècle, la liqueur de Fowler, solution d'arsenic dans du bicarbonate de potassium, occupe une place de choix comme tonique, une indication qui n'est plus réservée aujourd'hui qu'aux chevaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d862052c-8a72-3529-a4b8-7407f97fa556",
                                        "entry_id": "1f49b951-aa75-39b4-98f6-d989a473a4ca",
                                        "glosses": [
                                            "Valeur fournie par un instrument ou système de mesure lors d’une opération de mesurage."
                                        ],
                                        "tags": [],
                                        "note": "Cette valeur est souvent de nature différente de celle du mesurande (cf. exemple",
                                        "examples": [
                                            {
                                                "example_id": "decc1ff5-196e-4f7e-abd9-5c21a1250202",
                                                "sense_id": "d862052c-8a72-3529-a4b8-7407f97fa556",
                                                "text": "Beaucoup de capteurs de pression fournissent une indication de la pression mesurée sous forme de tension électrique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
