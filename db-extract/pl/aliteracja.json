                                    {
                                        "sense_id": "a00208cc-839f-3afe-957b-7654cf9b3824",
                                        "entry_id": "2df1c57e-6779-3a89-8be0-50c32d57171f",
                                        "glosses": [
                                            "Uso de vocablos en que se repiten las mismas sílabas o letras. Por ejemplo: \\\"apeló lo lógico\\"
