                "senses": [
                    {
                        "sense_id": "8fd71fcf-47ec-3bcd-92ed-b3f2cc9900f7",
                        "entry_id": "8ddec775-e47a-3acb-8684-af760a37bfca",
                        "glosses": [
                            "Berufsbezeichnung für eine Erzieherin speziell für Kinder unter 3 Jahren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c24c0b65-3756-4e02-b492-d9cd62c7ae2e",
                                "sense_id": "8fd71fcf-47ec-3bcd-92ed-b3f2cc9900f7",
                                "text": "Freudig begrüßt der kleine Leon am Morgen die Krippenerzieherin."
                            },
                            {
                                "example_id": "42835d24-0b43-4ec4-8a7a-8d2d97a4b7d1",
                                "sense_id": "8fd71fcf-47ec-3bcd-92ed-b3f2cc9900f7",
                                "text": "Die Ausbildung zur Krippenerzieherin dauert 3 Jahre und erfolgt an einer medizinischen Fachschule."
                            },
                            {
                                "example_id": "fb62e005-51cc-4e4a-8a29-5786450b0bc8",
                                "sense_id": "8fd71fcf-47ec-3bcd-92ed-b3f2cc9900f7",
                                "text": "Die Ausbildung zur Krippenerzieherin beinhaltet ein 3-jähriges Fachschulstudium."
                            },
                            {
                                "example_id": "328b05b5-f9ae-487c-924c-4699e829cd69",
                                "sense_id": "8fd71fcf-47ec-3bcd-92ed-b3f2cc9900f7",
                                "text": "„Es ist unsere Aufgabe als politisch Verantwortliche für eine gute Ausbildung der Krippenerzieherinnen zu sorgen“"
                            },
                            {
                                "example_id": "fb8be215-2d1d-4b7f-b586-6b6747dbceb1",
                                "sense_id": "8fd71fcf-47ec-3bcd-92ed-b3f2cc9900f7",
                                "text": "„Wechselt die Krippenerzieherin aber ihre Arbeitsstelle, hat sie Urlaub oder wechselt das Kind mit wachsendem Alter die Gruppen und geschieht dies nicht mit entsprechenden Eingewöhnungs-, Trennungs- und Abschiedsphasen […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
