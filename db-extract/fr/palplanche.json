                                        "entry_id": "480f9b44-18dd-3450-80f0-af5678ca28eb",
                                        "glosses": [
                                            "A type of retaining wall used during construction by driving interlocking sheets of material into the ground."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1225c408-b7ab-4f51-8fb5-28a9606640a7",
                                                "sense_id": "3d4e7d54-0a4d-3bbc-8cec-e2759fce1254",
                                                "text": "During the two Sundays preceding the accident, the track had been lifted to permit installation of shallow raft abutments some five to six feet under the track, which will eventually support a temporary bridge span during the construction of the permanent span, and sheet piling across the formation to hold the sides of future excavation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2d17fe5-d1f4-3835-8992-40c9fa79ab59",
                                        "entry_id": "480f9b44-18dd-3450-80f0-af5678ca28eb",
                                        "glosses": [
                                            "The material used to assemble a sheet pile retaining wall."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25f6f44f-1b2b-4102-98ba-1209cc17d6ea",
                                                "sense_id": "c2d17fe5-d1f4-3835-8992-40c9fa79ab59",
                                                "text": "During the partial line closure, engineers installed sheet piling to act as a retaining wall to support the embankment and road, and make it safe to carry out long-term repairs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
