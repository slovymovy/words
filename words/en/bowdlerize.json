                    "frequency": "Low",
                    "semantic_group_id": "censor_text",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The publisher decided to <w>bowdlerize</w> the classic novel to make it suitable for younger readers."
                        },
                        {
                            "text": "Critics accused the network of attempting to <w>bowdlerize</w> the film by cutting several controversial scenes."
                        }
                    ],
                    "synonyms": [
                        "expurgate",
                        "censor",
                        "sanitize",
                        "cleanse"
                    ],
                    "common_phrases": [
