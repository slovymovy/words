                                        "glosses": [
                                            "Nom de famille français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb2691e4-7b6a-414e-9269-931eebedc123",
                                                "sense_id": "0cd9a93d-5c36-3960-8513-838da7008273",
                                                "text": "Dans l’ouvrage Nicolas Bouvier, au gré des géographies, Alexandre Chollier nous livre une biographie illustrée par les photos prises par l’écrivain, qui était aussi chasseur d’images."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Bouvier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44520f93-dc2c-3826-85ff-e7ff117e2284",
                                        "entry_id": "dfa8665b-5d79-3279-b0cf-15cdf7e4fe77",
                                        "glosses": [
                                            "Constellation du ciel boréal, bordée par le Dragon, la Grande Ourse, les Chiens de chasse, la Chevelure de Bérénice, la Vierge, la Tête du Serpent, la Couronne boréale, et Hercule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4fbce7b-1812-498c-adf6-0d4ad026010c",
                                                "sense_id": "44520f93-dc2c-3826-85ff-e7ff117e2284",
                                                "text": "Quand une heure du matin fit pencher l’étoile du Bouvier sur le clocher de Toull, le curé s’assoupit dans la prière, et Marsillat s’endormit presque aussi bien que Cadet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
