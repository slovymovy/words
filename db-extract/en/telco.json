                                "target_senses": [
                                    {
                                        "sense_id": "899aa1e1-2ab6-3403-85bc-e615a2f352c3",
                                        "entry_id": "aba042fa-d546-33c4-9346-d2abc8cf72ac",
                                        "glosses": [
                                            "Unternehmen, das sowohl Netzbetreiber als auch Mobilfunkanbieter ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efdb05c6-e395-44c0-8deb-cf3d33ea1fae",
                                                "sense_id": "899aa1e1-2ab6-3403-85bc-e615a2f352c3",
                                                "text": "„In beiden Fällen zahlen Sie eine Gebühr an einen Anbieter, beispielweise Ihrer Telefongesellschaft oder Ihrem Kabelfernsehanbieter.“"
                                            },
                                            {
                                                "example_id": "d6113d57-850a-4c0b-bc60-a5e0a059e5bf",
                                                "sense_id": "899aa1e1-2ab6-3403-85bc-e615a2f352c3",
                                                "text": "„Raphaela füllte den neuen Antrag aus und verließ dann die Filiale der Telefongesellschaft.“"
                                            },
                                            {
                                                "example_id": "bd69d11a-e797-4f02-bd40-9f620552d6cf",
                                                "sense_id": "899aa1e1-2ab6-3403-85bc-e615a2f352c3",
                                                "text": "„Seit der Privatisierung der staatlichen Telefongesellschaft 1999 gibt es inzwischen viele regionale und einige nationale Telefonanbieter.“"
                                            }
                                        ],
