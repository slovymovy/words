                "senses": [
                    {
                        "sense_id": "e6f34526-307a-3db0-8d06-fe477feecdea",
                        "entry_id": "0c6c89f2-ec01-312d-8f98-6ef6dca09e8c",
                        "glosses": [
                            "Composé organique comportant plusieurs fonctions alcool."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "367a069a-cedf-4096-b4a4-b09954a9b86a",
                                "sense_id": "e6f34526-307a-3db0-8d06-fe477feecdea",
                                "text": "Parmi les principaux polyols, il y a le glycérol, le sorbitol, le mannitol."
                            },
                            {
                                "example_id": "b49e50b5-2749-453a-b93f-31c77d947f21",
                                "sense_id": "e6f34526-307a-3db0-8d06-fe477feecdea",
                                "text": "Quant à la fraction neutre, elle est de nouveau purifiée par chromatographie flash sur colonne de silice, permettant ainsi de séparer, les cérides, les alcools terpéniques et stérols, et les polyols."
                            },
                            {
                                "example_id": "bd876aef-87c3-4cf5-83ce-6897912b8922",
                                "sense_id": "e6f34526-307a-3db0-8d06-fe477feecdea",
                                "text": "Les polyols, utilisés en grande quantité, peuvent entraîner des diarrhées sans gravité par un mécanisme osmotique."
                            },
                            {
                                "example_id": "f6e8e156-b996-4486-95f9-d30997b488b3",
                                "sense_id": "e6f34526-307a-3db0-8d06-fe477feecdea",
                                "text": "Dans le domaine chimique, il conduisit des investigations sur les glucides: il démontra le caractère cyclique de la structure de l’inositol, un polyol dont il prépara le racémique, donna la formule exacte du tréhalose, découvrit le premier polyol à sept carbones, décrit le perséitol et étudia la composition de l’amidon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af01b029-240a-4704-a290-6cc33208f749",
                        "source_entry_id": "0c6c89f2-ec01-312d-8f98-6ef6dca09e8c",
                        "source_sense_id": "e6f34526-307a-3db0-8d06-fe477feecdea",
                        "source_sense_description": "composé chimique de formule générale CₙH₂ₙ₊₂Oₙ",
