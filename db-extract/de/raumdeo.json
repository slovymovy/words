                "senses": [
                    {
                        "sense_id": "28a1fd10-14a0-350b-8a4b-58349534683a",
                        "entry_id": "9e2d590e-48ae-32b5-8c5e-2c4fa7d09a4f",
                        "glosses": [
                            "Duftstoff zur Verbesserung der Luft von Innenräumen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8919adb7-9bd1-4903-82e4-5df3eaf1685c",
                                "sense_id": "28a1fd10-14a0-350b-8a4b-58349534683a",
                                "text": "„Anschließend versprühte sie in ihrem Zimmer Raumdeo und ließ das Fenster auf, um den Geruch zu vertreiben.“"
                            },
                            {
                                "example_id": "ebafac2c-eec7-4102-aa98-35caf1273ab5",
                                "sense_id": "28a1fd10-14a0-350b-8a4b-58349534683a",
                                "text": "„Es stank hier drinnen, eine Mischung aus vergammeltem Essen und irgendeinem blumigen Raumdeo.“"
                            },
                            {
                                "example_id": "517c10e4-0b62-43a5-89c2-64c4622999a4",
                                "sense_id": "28a1fd10-14a0-350b-8a4b-58349534683a",
                                "text": "„Er war froh gewesen, dass sie sich nicht dieses blumiges Raumdeo ausgesucht hatte, das ihn an die schreckliche Zeit mit Emma erinnert hätte.“"
                            },
                            {
                                "example_id": "5274229c-9993-4341-af4b-13a458fcd4ee",
                                "sense_id": "28a1fd10-14a0-350b-8a4b-58349534683a",
                                "text": "„Ich öfnete den Mund, schloss ihn wieder, führte ihn nach oben in die Küche, die immer noch nach dem Raumdeo mit Zitrusduft roch, und platzierte den Weihnachtsstern mitten auf den Tisch.“"
                            },
                            {
                                "example_id": "5b6ee17c-4c1e-4356-bcd2-9c4526a34c39",
                                "sense_id": "28a1fd10-14a0-350b-8a4b-58349534683a",
                                "text": "„Unverkennbare Schritte und das Geräusch von alten Plastiktüten waren im Flur zu hören und ich rannte umso schneller zur Küche und holte die Dose mit dem Raumdeo und sprühte wild in der Wohnung herum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
