                        "glosses": [
                            "A city in Khövsgöl, Mongolia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca4c723c-b0f8-4efe-ba4d-3dddc95ad2d8",
                                "sense_id": "6610b659-fc57-3b91-a159-c4695f7a4eca",
                                "text": "Mörön was the administrative capital of Khövsgöl aimag, sure — but why here? There was no obvious difference between this dusty, treeless plain and the 200 kilometres or so of dusty, treeless plain we'd just driven through. I looked out for the wide, flowing river that would justify the town’s name but I couldn’t see anything."
                            },
                            {
                                "example_id": "bb6c60d1-c436-4ec0-945f-f869872f8504",
                                "sense_id": "6610b659-fc57-3b91-a159-c4695f7a4eca",
                                "text": "Save time by catching a flight from Ulaanbaatar to Khovsgol's provincial capital, Murun. If you’re feeling adventurous, get on a local bus from Ulaanbaatar to Murun. During the 12 hours, you’ll see the vast central Mongolian countryside."
                            }
                        ]
                    }
