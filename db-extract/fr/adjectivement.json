                    {
                        "sense_id": "41f66713-7b2f-3c07-ab3c-4c674e324e8e",
                        "entry_id": "5bb36092-fec1-3455-9ee4-d87559d57313",
                        "glosses": [
                            "Avec la valeur d’un adjectif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c239bb54-440f-4d2d-8477-fdaa60019068",
                                "sense_id": "41f66713-7b2f-3c07-ab3c-4c674e324e8e",
                                "text": "Ce mot s’emploie quelquefois adjectivement."
                            },
                            {
                                "example_id": "096f0375-58a3-47c3-aab0-22905d12b10b",
                                "sense_id": "41f66713-7b2f-3c07-ab3c-4c674e324e8e",
                                "text": "Selon la tradition, en effet, le nom (ou le syntagme nominal) employé adjectivement est invariable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a40304b6-5f45-4b56-bb14-9ac9620f8ce7",
                        "source_entry_id": "5bb36092-fec1-3455-9ee4-d87559d57313",
                        "source_sense_id": "41f66713-7b2f-3c07-ab3c-4c674e324e8e",
                        "target_lang_word": "adjectivally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adjectivally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82773a9a-72bb-3b8e-809f-41b96d2f677c",
                                        "entry_id": "a714b7e2-a63d-3c6a-9e9f-e933b28f83f5",
                                        "glosses": [
                                            "As, or in the manner of, an adjective."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ac7567e-db44-4b88-b4aa-2672dd261a8b",
                                                "sense_id": "82773a9a-72bb-3b8e-809f-41b96d2f677c",
                                                "text": "In that sense, the word acts adjectivally, whereas in most cases it acts adverbially."
                                            },
                                            {
                                                "example_id": "c5eb00e7-fff1-47c4-b2a1-4f17505e6bd6",
                                                "sense_id": "82773a9a-72bb-3b8e-809f-41b96d2f677c",
                                                "text": "...it was observed that overt definite pronouns may also function adjectivally in various languages..."
                                            },
                                            {
                                                "example_id": "36774ef2-598f-4cce-85c4-a4c41f816f96",
                                                "sense_id": "82773a9a-72bb-3b8e-809f-41b96d2f677c",
                                                "text": "All attributive adjectives function adjectivally; an attributive adjective cannot function substantivally."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91c768d4-b65f-414d-ba48-06ba3537acd6",
