        "nl-extract.jsonl": [
            {
                "entry_id": "b32b14d5-2c7f-37f4-9ad0-64dfe0aacf12",
                "word": "uitputtend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b8a6f774-c25a-3ab0-b457-c87f94d98bd4",
                        "entry_id": "b32b14d5-2c7f-37f4-9ad0-64dfe0aacf12",
                        "glosses": [
                            "van een onderzoek: alles zodanig compleet en nauwkeurig onderzoeken dat er niet nog meer onderzocht kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e3c9ed2-727f-41a8-a61d-661984d013ef",
                                "sense_id": "b8a6f774-c25a-3ab0-b457-c87f94d98bd4",
                                "text": "Het hof vindt dat er nog niet volledig uitputtend onderzoek is gedaan naar het scenario dat Groenendijk en zijn advocaat Sébas Diekstra ter zitting schetsten. Dit moet binnen drie maanden alsnog gebeuren."
                            },
                            {
                                "example_id": "c67c6665-c9bf-4dde-b2c8-148582fe9f3f",
                                "sense_id": "b8a6f774-c25a-3ab0-b457-c87f94d98bd4",
                                "text": "Daarnaast gaat de Belastingdienst vanaf volgende week harder optreden tegen kwaadwillende opdrachtgevers. Een nieuw handhavingsplan zorgt ervoor dat belastinginspecteurs minder uitputtend bewijs nodig hebben om overtreders te kunnen beboeten. ,,De Belastingdienst moet zijn tanden laten zien”, aldus Snel."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6d0c828-e989-30a9-9731-612346c098b8",
                        "entry_id": "b32b14d5-2c7f-37f4-9ad0-64dfe0aacf12",
                        "glosses": [
                            "uiterst vermoeiend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12660c2a-09fb-4736-b8f1-8f30fb904505",
                                "sense_id": "d6d0c828-e989-30a9-9731-612346c098b8",
                                "text": "Voor de familie is de maandenlange ontvoering slopend en uitputtend, zegt Svein Holden, de advocaat van Hagen, in een reactie. ,,De ontvoering was een wrede, onmenselijke daad.’’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e5a86e6-3b6d-4976-a177-e86bd4974645",
                        "source_entry_id": "b32b14d5-2c7f-37f4-9ad0-64dfe0aacf12",
                        "source_sense_id": "d6d0c828-e989-30a9-9731-612346c098b8",
                        "source_sense_description": "uiterst vermoeiend",
                        "target_lang_word": "arduous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arduous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a70f2e2-d44c-3b20-9e58-b82e164c163a",
                                        "entry_id": "730e3b4c-379b-3083-9443-86a8268c3941",
                                        "glosses": [
                                            "Needing or using up much energy; testing powers of endurance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7c92278-c694-4dc1-982f-c739ab8f273f",
                                                "sense_id": "6a70f2e2-d44c-3b20-9e58-b82e164c163a",
                                                "text": "The movement towards a peaceful settlement has been a long and arduous political struggle."
                                            },
                                            {
                                                "example_id": "b8d42753-474d-44d3-ab71-091f3cfb4eff",
                                                "sense_id": "6a70f2e2-d44c-3b20-9e58-b82e164c163a",
                                                "text": "Chelsea survived and can now turn their attentions to the Champions League final against Bayern Munich in Germany later this month as they face an increasingly arduous task to finish in the Premier League's top four."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28cd6f1e-a2e8-3a7f-a4dc-8a72327009a4",
                                        "entry_id": "730e3b4c-379b-3083-9443-86a8268c3941",
                                        "glosses": [
                                            "burning; ardent"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33fb7a9f-84e6-43bf-85f7-e46bdbc2f21f",
                                                "sense_id": "28cd6f1e-a2e8-3a7f-a4dc-8a72327009a4",
                                                "text": "1805-1814, Dante, Henry Francis Cary (translator), The Divine Comedy\nWhere flames the arduous Spirit of Isidore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed4270b4-9f3c-3737-9efd-83c29899cdf9",
                                        "entry_id": "730e3b4c-379b-3083-9443-86a8268c3941",
                                        "glosses": [
                                            "Difficult or exhausting to traverse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa1ca3f7-885d-4822-81e9-12b48188d174",
                                                "sense_id": "ed4270b4-9f3c-3737-9efd-83c29899cdf9",
                                                "text": "Beyond the river, an arduous slope rises 3286 feet in 13 miles."
                                            },
                                            {
                                                "example_id": "2e8b9ff0-58e8-4972-874f-45bc1d0f88af",
                                                "sense_id": "ed4270b4-9f3c-3737-9efd-83c29899cdf9",
                                                "text": "Mike looked up from the arduous mountain trail. They'd been climbing for five hours and he was beginning to feel irritable."
                                            },
                                            {
                                                "example_id": "60c4f40a-cd71-442a-955e-836ffe43c1d3",
                                                "sense_id": "ed4270b4-9f3c-3737-9efd-83c29899cdf9",
                                                "text": "Survivor reaches as many as 28 million viewers who watch contestants win a new Pontiac or guzzle Mountain Dew after scaling an arduous cliff."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19649bc3-10dd-45ba-9dc7-e6ee58eef54f",
                        "source_entry_id": "b32b14d5-2c7f-37f4-9ad0-64dfe0aacf12",
                        "source_sense_id": "d6d0c828-e989-30a9-9731-612346c098b8",
