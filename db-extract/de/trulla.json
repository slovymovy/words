                    {
                        "sense_id": "9d6de808-f63c-34ea-b075-cccc3d6ca75c",
                        "entry_id": "577ceffe-9ccb-3a70-980d-bec47de9c684",
                        "glosses": [
                            "(schludrige) Frau"
                        ],
                        "tags": [
                            "casual",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "365ddcae-6274-4b3a-8aeb-8ee103624c96",
                                "sense_id": "9d6de808-f63c-34ea-b075-cccc3d6ca75c",
                                "text": "Meine Klassenlehrerin ist eine richtige Trulla."
                            },
                            {
                                "example_id": "9b923cf0-5541-4fc0-a406-150561f63dc8",
                                "sense_id": "9d6de808-f63c-34ea-b075-cccc3d6ca75c",
                                "text": "Hast du die Trulla da drüben gesehen?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c073cd4-e3b9-4b6e-a43e-8b7912b896e5",
                        "source_entry_id": "577ceffe-9ccb-3a70-980d-bec47de9c684",
                        "source_sense_id": "9d6de808-f63c-34ea-b075-cccc3d6ca75c",
                        "source_sense_description": "abwertend, salopp: (schludrige) Frau",
                        "target_lang_word": "troela",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "troela",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a350d00e-aef2-3a15-9d53-62639420b8d6",
                                        "entry_id": "5870aba7-b77b-37cf-a0a8-a426190b7eeb",
                                        "glosses": [
                                            "vervelende, zeurende, lelijke vrouw of meisje"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32f9f370-2963-40a2-a31d-ac442e9f8252",
                                                "sense_id": "a350d00e-aef2-3a15-9d53-62639420b8d6",
                                                "text": "‘Al aan gedacht waar jullie naartoe kunnen? Plopsaland, de watervallen van Coo, de grotten van Han?’‘Met die botox-bitch, die silicone-troela, die Marie Antoinette van den Aldi?’"
                                            },
                                            {
                                                "example_id": "f9e70dd7-f1a8-4840-82ea-211ae68612aa",
                                                "sense_id": "a350d00e-aef2-3a15-9d53-62639420b8d6",
                                                "text": "Maar in plaats van een grijze notaris stapt daar een platinablonde troela de salon binnen. Zóóó leuk, zegt ze in plat accent, om nou eindelijk eens die kinderen van haar verloofde te ontmoeten"
                                            },
                                            {
                                                "example_id": "17f56607-d607-4dda-900b-4ce68b3dd15a",
                                                "sense_id": "a350d00e-aef2-3a15-9d53-62639420b8d6",
                                                "text": "De dag na deze criminele afrekening was het Nationale Buitenspeeldag. Hoorde een muts op de radio op zo’n pedagogisch toontje vertellen hoe belangrijk het is dat kinderen buiten spelen. Week eerder hoorde ik een zelfde soort troela ons waarschuwen hoe gevaarlijk het is als kinderen te vaak buiten spelen. Ze worden dan blootgesteld aan te veel zon. De kans op huidkanker is enorm. Insmeermoeders moesten er komen. Kinderen van top tot teen in de zonnebrandcrème. En kogelvrije vesten dus"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f4ac7de-cfc4-3d8e-a703-8d7daa88b42b",
                                        "entry_id": "5870aba7-b77b-37cf-a0a8-a426190b7eeb",
                                        "glosses": [
                                            "klankreeks die voorkomt in volksliedjes"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
