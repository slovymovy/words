                },
                {
                    "sense_id": "886bcbcc-eab5-388c-b263-6ef852772fdc",
                    "sense_definition": "Envoyer le ballon ou la balle vers le centre du terrain ou devant le but adverse.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sport_ballon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'ailier a débordé sur l'aile avant de <w>centrer</w> en retrait pour son attaquant."
                        },
                        {
                            "text": "Le jeune joueur hésite souvent à tirer au but et préfère <w>centrer</w> dans la surface."
                        }
                    ],
                    "common_phrases": [
