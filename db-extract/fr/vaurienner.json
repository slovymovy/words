                "senses": [
                    {
                        "sense_id": "6ee718e0-78de-3891-b437-3a93c1af9a96",
                        "entry_id": "f5d6a86e-5795-3831-bad2-521cee84d2ef",
                        "glosses": [
                            "Se conduire comme un vaurien."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5a05a8eb-2fed-4819-b356-75514634ddd9",
                                "sense_id": "6ee718e0-78de-3891-b437-3a93c1af9a96",
                                "text": "Eh ! bien, sire, voulez-vous vaurienner comme dans votre jeunesse ?"
                            },
                            {
                                "example_id": "a00c17b6-7877-4882-90e2-afa2e7ba666a",
                                "sense_id": "6ee718e0-78de-3891-b437-3a93c1af9a96",
                                "text": "Nous ne sommes plus au temps où votre nom était un diplôme de voleur et de tire-laine, où vos nobles pères couraient vaurienner la nuit par les rues, cassant les lanternes, rossant le guet, tapageurs de clapiers, filous de brelans, dormeurs ivres de ruisseaux."
                            }
                        ]
                    }
