                ],
                "senses": [
                    {
                        "sense_id": "0a82dac2-0a2e-3638-b3cb-815fd71cc209",
                        "entry_id": "f7bbb2bb-a465-32e1-b904-c20fbf0e3e71",
                        "glosses": [
                            "unwirksame Therapie gegen Alterung einer Person und zur Stärkung der Immunabwehr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db511f26-a024-41bd-a00d-018626826ae8",
                                "sense_id": "0a82dac2-0a2e-3638-b3cb-815fd71cc209",
                                "text": "Frischzellenkuren sind nichts anderes als Scharlatanerie."
                            },
                            {
                                "example_id": "3d97f7af-1c5f-4c46-a45b-eba05c4818bb",
                                "sense_id": "0a82dac2-0a2e-3638-b3cb-815fd71cc209",
                                "text": "„Damals, als die \"Frischzellenkur\" in den deutschen Wortschatz einging, gaben sich die prominenten Patienten in den spezialisierten Sanatorien die Klinke in die Hand.“"
                            },
                            {
                                "example_id": "1e9fe940-e6c7-4eef-9721-bd2472ef5cc1",
                                "sense_id": "0a82dac2-0a2e-3638-b3cb-815fd71cc209",
                                "text": "„In den Folgejahren liessen sich Prominente jeder Couleur“ […] „mit der sogenannten Zellulartherapie behandeln, was der Methode zu einiger Popularität verhalf. Der Begriff «Frischzellenkur» hat es damit zwar in die Alltagssprache geschafft, dem Verfahren selber blieben aber schulmedizinische Weihen versagt.“"
                            },
                            {
                                "example_id": "e5118319-89f4-4cee-a9a9-ab7e00e3a832",
                                "sense_id": "0a82dac2-0a2e-3638-b3cb-815fd71cc209",
                                "text": "„Jahrelang waren so genannte Frischzellenkuren ein gutes Geschäft für Privatkliniken am Genfersee – auch weil die Behörden wegschauten.“"
                            },
                            {
                                "example_id": "d0006614-50c2-480e-8c36-90c17230204e",
                                "sense_id": "0a82dac2-0a2e-3638-b3cb-815fd71cc209",
                                "text": "„All das wird dem Land so guttun wie eine Frischzellenkur in einem Schweizer Sanatorium.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "52df9026-4ef2-3fa6-9a96-24634a693b2b",
                        "entry_id": "f7bbb2bb-a465-32e1-b904-c20fbf0e3e71",
                        "glosses": [
                            "umfassende Renovierung/Modernisierung einer Sache"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "422aced2-1a5e-4a5f-a575-eed0b6b1f27c",
                                "sense_id": "52df9026-4ef2-3fa6-9a96-24634a693b2b",
                                "text": "„Die Schweizer Luftwaffe braucht eine Frischzellenkur.“"
                            },
                            {
                                "example_id": "18cca57f-9e7f-4c3a-874f-c745f2b60e3d",
                                "sense_id": "52df9026-4ef2-3fa6-9a96-24634a693b2b",
                                "text": "[Bismarck-Denkmal in Hamburg:] „Zu sehen ist jedenfalls niemand, nirgendwo ein Bauarbeiter, der gerade an der Frischzellenkur des Denkmals arbeitet.“"
                            },
                            {
                                "example_id": "c0cd62b3-5c06-4c29-a7c8-1aea5a890b61",
                                "sense_id": "52df9026-4ef2-3fa6-9a96-24634a693b2b",
                                "text": "[Schlagzeile:] „Basel Baselland - Das Gefängnis Laufen hat eine Frischzellenkur hinter sich“"
                            },
                            {
                                "example_id": "ef80014c-2d33-4f6b-a6de-fe38ff069c1d",
                                "sense_id": "52df9026-4ef2-3fa6-9a96-24634a693b2b",
                                "text": "[Schlagzeile:] „Frischzellenkur für Matisse-Meisterwerk“"
                            },
                            {
                                "example_id": "c197a09e-2cef-4811-91b4-0d1632a8d9e7",
                                "sense_id": "52df9026-4ef2-3fa6-9a96-24634a693b2b",
                                "text": "„Wir zeigen am Beispiel eines c’t-Bauvorschlags von 2013, wie Sie einem älteren Rechner eine Frischzellenkur spendieren.“"
                            },
                            {
                                "example_id": "2919318b-583d-42fd-844c-f521394f49aa",
                                "sense_id": "52df9026-4ef2-3fa6-9a96-24634a693b2b",
                                "text": "„Der Mailclient Thunderbird hat mit dem Versionssprung auf 102 eine gründliche Frischzellenkur erhalten – sowohl in der Optik als auch bei den Funktionen.“"
                            },
                            {
                                "example_id": "e241a6f6-69d4-404e-8007-6400616ac1b3",
                                "sense_id": "52df9026-4ef2-3fa6-9a96-24634a693b2b",
                                "text": "[Europäische Union:] „Dabei braucht die Union eine Frischzellenkur, wenn sie vor dem Wähler bestehen will.“"
                            },
                            {
                                "example_id": "21b267e2-403f-49ab-a676-355f9d849dff",
                                "sense_id": "52df9026-4ef2-3fa6-9a96-24634a693b2b",
                                "text": "[Schlagzeile:] „Kölner Power-Fußball: Baumgarts Frischzellenkur begeistert“"
                            },
                            {
                                "example_id": "acbaf193-7978-4010-b910-a3381a1ea079",
                                "sense_id": "52df9026-4ef2-3fa6-9a96-24634a693b2b",
                                "text": "„Den auch in Amerika aufkommenden Punk betrachtete Waits als Frischzellenkur für das Musikgeschäft und er hieß ihn mit offenen Armen willkommen.“"
                            },
                            {
                                "example_id": "1cf1cb3d-e507-45af-bd34-fa2cde16c8da",
                                "sense_id": "52df9026-4ef2-3fa6-9a96-24634a693b2b",
                                "text": "[Christina Stumpp, CDU:] „Als Teil des Teams rund um Friedrich Merz, den neuen Parteivorsitzenden der CDU, will sie der Partei eine Frischzellenkur verpassen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
