                                "target_senses": [
                                    {
                                        "sense_id": "dd7552fe-0c7b-35f3-88d5-875a9a43e0fe",
                                        "entry_id": "da7b2762-8c50-3005-b707-f20f52140f22",
                                        "glosses": [
                                            "Relating to a crown or coronation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d78767dc-d210-4986-ab6c-9c4524f114b6",
                                                "sense_id": "dd7552fe-0c7b-35f3-88d5-875a9a43e0fe",
                                                "text": "The law and his coronal oath require his undeniable assent to what laws the Parliament agree upon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b047c83f-074d-3c76-979f-7b61cee06733",
                                        "entry_id": "da7b2762-8c50-3005-b707-f20f52140f22",
                                        "glosses": [
                                            "Relating to the corona of a star."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ee64b7d-be8f-48fd-8c78-79f1b08ca97c",
                                                "sense_id": "b047c83f-074d-3c76-979f-7b61cee06733",
                                                "text": "The coronal light during the eclipse is faint."
                                            },
                                            {
                                                "example_id": "dec4115e-414b-424c-bad2-b37b13f07ad0",
                                                "sense_id": "b047c83f-074d-3c76-979f-7b61cee06733",
                                                "text": "Coronal holes are darker, cooler regions of the sun's atmosphere, or corona, containing little solar material. In these gaps, magnetic field lines whip out into the solar wind rather than looping back to the sun's surface. Coronal holes can affect space weather, as they send solar particles streaming off the sun about three times faster than the slower wind unleashed elsewhere from the sun's atmosphere, according to a description from NASA."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6c5c0cd-5fa7-3161-ac30-4c56f1d97573",
                                        "entry_id": "da7b2762-8c50-3005-b707-f20f52140f22",
                                        "glosses": [
                                            "Relating to the corona of a flower."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da18b8f2-a5ba-371b-8e23-48888ad8e181",
                                        "entry_id": "da7b2762-8c50-3005-b707-f20f52140f22",
                                        "glosses": [
                                            "Relating to a sound made with the tip or blade of the tongue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7760f479-995e-3c4d-9809-7c8af04f4ead",
                                        "entry_id": "da7b2762-8c50-3005-b707-f20f52140f22",
                                        "glosses": [
                                            "Relating to the coronal plane that divides a body into dorsal (back) and ventral (front)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41085296-9c54-3fb0-9ed7-fa75d2638681",
                                        "entry_id": "da7b2762-8c50-3005-b707-f20f52140f22",
                                        "glosses": [
                                            "Relating to the external (supragingival) portion of the tooth."
                                        ],
                                        "tags": [],
