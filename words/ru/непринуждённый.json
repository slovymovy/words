    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "26923334-d467-3305-b292-a00ff0f6eb27",
                    "sense_definition": "Лишённый натянутости, естественный, свободный в поведении или общении.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "natural_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У него был очень <w>непринуждённый</w> вид, будто он совсем не волновался перед выступлением.",
                            "target_lang_translations": {
                                "de": "Er wirkte sehr <w>zwanglos</w>, als ob er vor dem Auftritt überhaupt nicht nervös wäre."
                            }
                        },
                        {
                            "text": "Друзья вели <w>непринуждённый</w> разговор за чашкой кофе в уютном кафе.",
                            "target_lang_translations": {
                                "de": "Die Freunde führten bei einer Tasse Kaffee in einem gemütlichen Café ein <w>ungezwungenes</w> Gespräch."
                            }
                        }
                    ],
                    "synonyms": [
                        "естественный",
                        "свободный",
                        "лёгкий"
                    ],
                    "antonyms": [
                        "скованный"
                    ],
                    "common_phrases": [
                        "непринуждённый разговор",
                        "непринуждённый тон",
                        "непринуждённый вид"
                    ],
                    "target_lang_definitions": {
                        "de": "Frei von Anspannung, natürlich und ungezwungen im Verhalten oder in der Kommunikation."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zwanglos",
                                "target_lang_sense_clarification": "bezieht sich auf eine entspannte, natürliche Atmosphäre oder ein Verhalten ohne soziale Zwänge"
                            },
                            {
                                "target_lang_word": "ungezwungen",
                                "target_lang_sense_clarification": "beschreibt eine natürliche, lockere Art, die nicht aufgesetzt wirkt"
                            },
                            {
                                "target_lang_word": "locker",
                                "target_lang_sense_clarification": "umgangssprachlich für eine entspannte und unverkrampfte Haltung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7780569d-8649-3d85-8ddb-e09d5fa1a152",
                    "sense_definition": "Добровольный, совершаемый без внешнего давления.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "voluntary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это был <w>непринуждённый</w> взнос, который каждый сделал по своему желанию.",
                            "target_lang_translations": {
                                "de": "Es war ein <w>freiwilliger</w> Beitrag, den jeder nach eigenem Ermessen leistete."
                            }
                        },
                        {
                            "text": "Участие в проекте было <w>непринуждённым</w> и основывалось на личном интересе сотрудников.",
                            "target_lang_translations": {
                                "de": "Die Teilnahme am Projekt war <w>freiwillig</w> und basierte auf dem persönlichen Interesse der Mitarbeiter."
                            }
                        }
                    ],
                    "synonyms": [
                        "добровольный"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Устаревшее значение слова."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Freiwillig, ohne äußeren Zwang oder Druck geschehend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "freiwillig",
                                "target_lang_sense_clarification": "aus eigenem Antrieb, ohne äußere Verpflichtung"
                            },
                            {
                                "target_lang_word": "unverpflichtend",
                                "target_lang_sense_clarification": "ohne bindende Vorgaben oder Zwang"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}