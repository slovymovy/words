                "senses": [
                    {
                        "sense_id": "70d285b7-b573-3211-a5d9-0e67f50cfb0f",
                        "entry_id": "b8b56fe1-f721-3ceb-8a5c-05c8e8238b8e",
                        "glosses": [
                            "Donner un caractère gestionnaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d98389f-b1dc-465d-a2fc-f32ee0ab3b8e",
                                "sense_id": "70d285b7-b573-3211-a5d9-0e67f50cfb0f",
                                "text": "Peut-on tout « gestionnariser » ?"
                            },
                            {
                                "example_id": "00b1aeca-5f0a-4ee3-b818-4a76433589bb",
                                "sense_id": "70d285b7-b573-3211-a5d9-0e67f50cfb0f",
                                "text": "D’ailleurs, j’avoue ne plus avoir une haute opinion de la presse. Elle s’est « gestionnarisée » en suivant les tendances d’autres professions, édition, politique, université, santé, monde associatif, etc."
                            },
                            {
                                "example_id": "d3609e4c-5823-47d3-b391-c7903935b68c",
                                "sense_id": "70d285b7-b573-3211-a5d9-0e67f50cfb0f",
                                "text": "Ces dernières années, le fonctionnement même du système éducatif se « gestionnarise »."
                            }
                        ]
                    }
                ],
