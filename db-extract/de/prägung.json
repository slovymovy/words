                                                "example_id": "e2a959b6-aa6d-4e08-b3d0-e5e7e8cb06aa",
                                                "sense_id": "de1d1530-2188-3c92-874d-2ec0729be4b1",
                                                "text": "Er worden stempels gebruikt om de keerwanden van een bouwkuip uiteen te houden."
