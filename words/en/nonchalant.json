{
    "word_family": [
        "nonchalance",
        "nonchalantly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cad871d7-da66-34e5-b203-006b6dc21200",
                    "sense_definition": "Casually calm and relaxed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relaxed_attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She maintained a <w>nonchalant</w> attitude despite the chaos happening around her.",
                            "target_lang_translations": {
                                "de": "Trotz des Chaos um sie herum behielt sie eine <w>lässige</w> Haltung bei."
                            }
                        },
                        {
                            "text": "He gave a <w>nonchalant</w> shrug when asked about the difficult exam.",
                            "target_lang_translations": {
                                "de": "Er zuckte nur <w>beiläufig</w> mit den Schultern, als man ihn nach der schwierigen Prüfung fragte."
                            }
                        }
                    ],
                    "synonyms": [
                        "carefree",
                        "cool",
                        "mellow",
                        "easygoing",
                        "calm"
                    ],
                    "antonyms": [
                        "careful",
                        "attentive"
                    ],
                    "common_phrases": [
                        "nonchalant attitude",
                        "nonchalant shrug"
                    ],
                    "target_lang_definitions": {
                        "de": "Auf ungezwungene Art gelassen, ruhig und entspannt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "lässig",
                                "target_lang_sense_clarification": "ungezwungen und locker"
                            },
                            {
                                "target_lang_word": "nonchalant",
                                "target_lang_sense_clarification": "gehoben für ungezwungen und selbstverständlich wirkend"
                            },
                            {
                                "target_lang_word": "gelassen",
                                "target_lang_sense_clarification": "ruhig und unaufgeregt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0dd5782-684b-30a3-b641-793cbd872ae3",
                    "sense_definition": "Indifferent or unconcerned, behaving as if detached from a situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "relaxed_attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is dangerous to be so <w>nonchalant</w> about such a serious matter.",
                            "target_lang_translations": {
                                "de": "Es ist gefährlich, bei einer so ernsten Angelegenheit so <w>gleichgültig</w> zu sein."
                            }
                        },
                        {
                            "text": "His <w>nonchalant</w> response to the crisis upset his colleagues.",
                            "target_lang_translations": {
                                "de": "Seine <w>nonchalante</w> Reaktion auf die Krise verärgerte seine Kollegen."
                            }
                        }
                    ],
                    "synonyms": [
                        "blasé",
                        "unconcerned",
                        "apathetic"
                    ],
                    "antonyms": [
                        "concerned"
                    ],
                    "common_phrases": [
                        "nonchalant response"
                    ],
                    "target_lang_definitions": {
                        "de": "Gleichgültig, unbeteiligt oder scheinbar distanziert gegenüber einer ernsten Situation."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "gleichgültig",
                                "target_lang_sense_clarification": "ohne Interesse oder Anteilnahme"
                            },
                            {
                                "target_lang_word": "nonchalant",
                                "target_lang_sense_clarification": "gehoben für auffällig unbesorgt oder distanziert"
                            },
                            {
                                "target_lang_word": "teilnahmslos",
                                "target_lang_sense_clarification": "ohne emotionale Beteiligung"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}