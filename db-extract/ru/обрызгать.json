                "translations": [
                    {
                        "translation_id": "807f04d2-cb9f-4c38-a78a-48d6126efd6a",
                        "source_entry_id": "57d6ce56-9dd5-3f60-8ae4-474793e5eec2",
                        "source_sense_id": "c78bbacb-de8f-3dba-8ce6-68f288a45317",
                        "target_lang_word": "éclabousser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éclabousser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb02594c-bfb1-36d5-9b88-de9c70c310bc",
                                        "entry_id": "040dadb9-1e8f-32bb-9dae-3cdd95103813",
                                        "glosses": [
                                            "Couvrir quelqu’un ou quelque chose d’une boue qu’on fait jaillir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef8b8185-f02f-4acb-b75d-627f792d7341",
                                                "sense_id": "eb02594c-bfb1-36d5-9b88-de9c70c310bc",
                                                "text": "Où diable avez-vous pu vous éclabousser ainsi par un temps si sec ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1d1992f-6926-38fa-b855-2ea25d9cb6d1",
                                        "entry_id": "040dadb9-1e8f-32bb-9dae-3cdd95103813",
                                        "glosses": [
                                            "Envoyer de l’eau (ou un autre liquide) par giclées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2958b1bc-92ab-46bf-b529-8f87d19df514",
                                                "sense_id": "a1d1992f-6926-38fa-b855-2ea25d9cb6d1",
                                                "text": "Les hommes se déshabillent pour se laver et font la queue aux pompes; la plaisanterie habituelle est d’éclabousser Ragueton, qui a des pantoufles en tapisserie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdff168a-699f-369c-88ff-ba27fac23bd4",
                                        "entry_id": "040dadb9-1e8f-32bb-9dae-3cdd95103813",
                                        "glosses": [
                                            "Faire gicler de l'eau (ou un autre liquide)."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a01af5d7-4cc6-46ec-a4f5-e651aa9eb619",
                                                "sense_id": "cdff168a-699f-369c-88ff-ba27fac23bd4",
                                                "text": "Regardez un enfant sur le bord de la mer, il tape du pied dans l’eau pendant un quart d’heure pour la simple joie d’éclabousser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba4fac1c-56aa-3be6-bbf0-06ab5a086a66",
                                        "entry_id": "040dadb9-1e8f-32bb-9dae-3cdd95103813",
                                        "glosses": [
                                            "Couvrir d’un liquide."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50ebfc5b-973d-4b5d-9e4f-93ac80d7dd71",
                                                "sense_id": "ba4fac1c-56aa-3be6-bbf0-06ab5a086a66",
                                                "text": "À mesure que sa rapière trouait une poitrine et que le sang tiède éclaboussait ses mains et son visage, lui, l’œil dilaté, les narines ouvertes, les dents serrées, regagnait le terrain perdu et se rapprochait de la maison assiégée."
                                            },
                                            {
                                                "example_id": "a15c2b02-abb4-4296-ac53-dd5c9a6e3412",
                                                "sense_id": "ba4fac1c-56aa-3be6-bbf0-06ab5a086a66",
                                                "text": "En démocratie, la liberté d’expression d’un président sortant capable d’inciter ses supporteurs à une tentative de coup d’État au Capitole, ne mérite aucune protection. Le sang des morts éclaboussé sur ses planchers en fait foi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07401732-4844-3b2c-9a78-2030e77b6cf2",
                                        "entry_id": "040dadb9-1e8f-32bb-9dae-3cdd95103813",
                                        "glosses": [
                                            "Couvrir de lumière."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "578fa129-667e-4680-a634-780758604d75",
                                                "sense_id": "07401732-4844-3b2c-9a78-2030e77b6cf2",
                                                "text": "Depuis plus d'une semaine, la zone est infestée de flics et d'agents en civil. La nuit, elle entend l'hélicoptère passer en vrombissant, voit le pinceau du projecteur éclabousser les collines de mesquites, de chênes et de roches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c06225b-2ab7-34c6-b187-2bcc3d382330",
                                        "entry_id": "040dadb9-1e8f-32bb-9dae-3cdd95103813",
                                        "glosses": [
                                            "Couvrir de honte, de réprobations, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c523f2e-7f7a-4dca-abc0-2dcdb1ae143e",
                                                "sense_id": "5c06225b-2ab7-34c6-b187-2bcc3d382330",
                                                "text": "Voici donc qu’à peine à ses débuts, le scandale éclabousse par ricochet le Président du Conseil dans la personne d’un de ses protégés."
                                            },
                                            {
                                                "example_id": "dd28d91a-113a-4d70-b42a-8a32fd902c14",
                                                "sense_id": "5c06225b-2ab7-34c6-b187-2bcc3d382330",
                                                "text": "Plusieurs entreprises du pays ont été éclaboussées depuis et l'affaire a même compromis la candidature de Sapporo (nord du Japon) pour les JO d'hiver de 2030."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06ca41e4-bc13-32b4-b23e-f59a4da143c4",
                                        "entry_id": "040dadb9-1e8f-32bb-9dae-3cdd95103813",
                                        "glosses": [
                                            "Étaler un luxe insolent de manière prétentieuse."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a745b9b0-714d-4890-b4cc-44af32543b56",
                                                "sense_id": "06ca41e4-bc13-32b4-b23e-f59a4da143c4",
                                                "text": "Il éclabousse tout le monde avec ses richesses."
                                            },
                                            {
                                                "example_id": "612d5487-b862-43b0-a384-76a26b0d4afb",
                                                "sense_id": "06ca41e4-bc13-32b4-b23e-f59a4da143c4",
                                                "text": "La lampe éteinte, Félicité ne put dormir. Les yeux fermés, elle faisait de merveilleux châteaux en Espagne. Les vingt mille francs de rente dansaient devant elle, dans l’ombre, une danse diabolique. Elle habitait un bel appartement de la ville neuve, avait le luxe de M. Peirotte, donnait des soirées, éclaboussait de sa fortune la ville entière. Ce qui chatouillait le plus ses vanités, c’était la belle position que son mari occuperait alors."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
