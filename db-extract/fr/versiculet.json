                "senses": [
                    {
                        "sense_id": "0a2449ae-b0f8-3b20-b3df-6d84c7732d5c",
                        "entry_id": "94f26f4a-8bf5-393e-a48c-533c17b4527a",
                        "glosses": [
                            "Petit vers."
                        ],
                        "tags": [
                            "Par plaisanterie"
                        ],
                        "examples": [
                            {
                                "example_id": "d22f4ac2-0725-49b5-a1d0-c523fedfcf59",
                                "sense_id": "0a2449ae-b0f8-3b20-b3df-6d84c7732d5c",
                                "text": "Les petits versiculets faits pour Mme la duchesse de Choiseul et pour M. Saurin n’étaient faits que pour eux."
                            },
                            {
                                "example_id": "f32e83e3-ed4b-4f21-8daf-e903a4b75a0a",
                                "sense_id": "0a2449ae-b0f8-3b20-b3df-6d84c7732d5c",
                                "text": "Si mes anges [M. et Mme d’Argental] trouvent ces versiculets supportables, à la bonne heure ; sinon, au rebut."
                            },
                            {
                                "example_id": "3e3ce184-4fd3-4c32-87ab-3533ed7b7286",
                                "sense_id": "0a2449ae-b0f8-3b20-b3df-6d84c7732d5c",
                                "text": "Écris des versiculets, mets-toi dans un coin pour vivre avec tes petites pensées et tes petites impressions misérables, fouille dans toutes sortes de menues subtilités psychologiques, et surtout ne va pas t’imaginer que tes caprices, tes exaspérations maladives et nerveuses, aient rien de commun avec la mâle indignation, avec l’honnête colère d’un homme convaincu !"
                            }
                        ]
                    }
