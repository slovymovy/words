{
    "word_family": [
        "chive"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "28bf549b-491e-3846-a248-009edb4972a0",
                    "sense_definition": "The thin, green, onion-flavored leaves of a perennial plant used as a culinary herb.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "culinary_herb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sprinkle some fresh <w>chives</w> over the baked potato to add a mild onion flavor.",
                            "target_lang_translations": {
                                "cs": "Posypte pečenou bramboru čerstvou <w>pažitkou</w>, abyste dodali jemnou cibulovou chuť."
                            }
                        },
                        {
                            "text": "The recipe calls for chopped <w>chives</w> to garnish the creamy soup.",
                            "target_lang_translations": {
                                "cs": "Recept vyžaduje nasekanou <w>pažitku</w> na ozdobu krémové polévky."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chopped chives",
                        "fresh chives"
                    ],
                    "target_lang_definitions": {
                        "cs": "Tenké, zelené listy vytrvalé rostliny s cibulovou chutí, které se používají jako kuchyňská bylinka."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pažitka",
                                "target_lang_sense_clarification": "běžný název pro bylinku používanou v kuchyni"
                            },
                            {
                                "target_lang_word": "šnytlík",
                                "target_lang_sense_clarification": "nářeční nebo regionální označení pro pažitku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcbd6c19-81d3-31d7-ba51-4e9b4a07b054",
                    "sense_definition": "A perennial plant, Allium schoenoprasum, which is related to the onion and produces edible leaves.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "culinary_herb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>chive</w> is a hardy plant that grows easily in most garden soil.",
                            "target_lang_translations": {
                                "cs": "<w>Pažitka</w> je odolná rostlina, která snadno roste ve většině zahradních zemin."
                            }
                        },
                        {
                            "text": "Many gardeners plant <w>chives</w> because their purple flowers attract bees.",
                            "target_lang_translations": {
                                "cs": "Mnoho zahrádkářů sází <w>pažitku</w>, protože její fialové květy lákají včely."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vytrvalá rostlina (Allium schoenoprasum), která je příbuzná cibuli a vytváří jedlé listy."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pažitka pobřežní",
                                "target_lang_sense_clarification": "botanický název rostliny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "060fbbde-e117-3af3-97e3-ffd0e8ca8fb8",
                    "sense_definition": "A thin filament or thread-like part of a flower, such as a stamen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The delicate <w>chives</w> of the saffron flower are carefully harvested by hand.",
                            "target_lang_translations": {
                                "cs": "Jemné <w>tyčinky</w> květu šafránu jsou pečlivě sklízeny ručně."
                            }
                        },
                        {
                            "text": "Botanists examined the <w>chive</w> under a microscope to study the pollen structure.",
                            "target_lang_translations": {
                                "cs": "Botanici zkoumali <w>tyčinku</w> pod mikroskopem, aby studovali strukturu pylu."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older botanical or literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Tenká nitkovitá část květu, například tyčinka."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "tyčinka",
                                "target_lang_sense_clarification": "botanický termín pro samčí pohlavní orgán květu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76c92cfe-b03f-30da-9441-f70926b42b67",
                    "sense_definition": "A knife or sharp cutting tool.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The criminal pulled out a <w>chive</w> during the confrontation in the alleyway.",
                            "target_lang_translations": {
                                "cs": "Zločinec během konfrontace v uličce vytáhl <w>nůž</w>."
                            }
                        },
                        {
                            "text": "He kept a hidden <w>chive</w> in his boot for protection.",
                            "target_lang_translations": {
                                "cs": "Pro ochranu nosil v botě schovaný <w>nůž</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "knife",
                        "shiv"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Historical criminal underworld slang."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Nůž nebo ostrý řezný nástroj."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nůž",
                                "target_lang_sense_clarification": "obecný nástroj k řezání"
                            },
                            {
                                "target_lang_word": "dýka",
                                "target_lang_sense_clarification": "slangové označení pro improvizovanou zbraň"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f144d802-1744-3933-b7ac-78286feecf09",
                    "sense_definition": "To stab someone with a knife.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The victim was <w>chived</w> during the violent struggle.",
                            "target_lang_translations": {
                                "cs": "Oběť byla během násilného střetu <w>bodnuta</w>."
                            }
                        },
                        {
                            "text": "He was <w>chived</w> in the chest and required immediate medical attention.",
                            "target_lang_translations": {
                                "cs": "Byl <w>bodnut</w> do hrudníku a vyžadoval okamžitou lékařskou pomoc."
                            }
