                    {
                        "sense_id": "0f6052b5-c249-35a8-86c5-da101ae58d42",
                        "entry_id": "68d15f83-6961-3dce-8b86-7701ef2bb0e0",
                        "glosses": [
                            "tijdschrift waarin je kunt lezen welke radio- of televisieprogramma's, op welke tijd op welke zender worden uitgezonden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce4f61a9-b4fa-42d2-ac1e-f8bb883864f5",
                                "sense_id": "0f6052b5-c249-35a8-86c5-da101ae58d42",
                                "text": "Muziek & Woord, dat ook als programmablad van Klara fungeerde, werd afgevoerd toen het tijdschrift nog 2.700 abonnees telde. Klara koos ervoor om in zijn website te investeren. Decom hoopt een groot deel van de lezers van Muziek & Woord terug te winnen. Met tweeduizend abonnees en het aandeel uit de losse verkoop draait Staalkaart break-even."
                            },
                            {
                                "example_id": "059fadb4-d58d-4e4b-96d3-03622933a214",
                                "sense_id": "0f6052b5-c249-35a8-86c5-da101ae58d42",
                                "text": "Omdat het schrappen zo laat gebeurde, staan al details over de docu in Radio Times, het programmablad van de BBC."
                            }
                        ]
                    }
