                        "entry_id": "477a4652-47b2-355d-9acc-476a85f1285d",
                        "glosses": [
                            "apparaat waaruit men, na het inwerpen van voldoende geld, zelf flesjes (fris)drank kan pakken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce5c382d-8885-4f99-b884-6ac93ab1240e",
                                "sense_id": "3344a804-6ff7-3c33-b3d4-5f2e0c968511",
                                "text": "Ja, we hebben gedacht aan het plaatsen van een drankautomaat in de rokersruimte maar ook dat ligt moeilijk."
                            },
                            {
                                "example_id": "cd12d518-1df1-463d-9108-44d364ea7d2c",
                                "sense_id": "3344a804-6ff7-3c33-b3d4-5f2e0c968511",
                                "text": "En dan ga ik nu eens de gang op, kijken of de drankautomaat nog een cola light in de aanbieding heeft. Want van al dat getater heb ik best dorst gekregen."
                            },
                            {
                                "example_id": "6e62c2f8-1b5e-4dec-bb9b-e51ae29a26ad",
                                "sense_id": "3344a804-6ff7-3c33-b3d4-5f2e0c968511",
                                "text": "De kersverse partners gaan samen werken aan producten van Coca-Cola die kunnen worden gebruikt voor de drankautomaat Keurig Cold, die Green Mountain ontwikkelde voor thuisgebruik."
                            }
                        ]
                    }
