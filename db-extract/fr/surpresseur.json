                "senses": [
                    {
                        "sense_id": "a4bbf9a8-ee23-3ffe-94e0-d6ae5e582604",
                        "entry_id": "a3b5cca3-ae5e-34bf-8b3f-e4526f4d96a8",
                        "glosses": [
                            "Compresseur destiné à augmenter la pression d'un fluide dans un système de canalisations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8fe747b-2ca7-45e1-948b-fa8e82f3b31c",
                                "sense_id": "a4bbf9a8-ee23-3ffe-94e0-d6ae5e582604",
                                "text": "Le surpresseur, cœur de l’engin, sorte de pompe sans préfiltre, est installé dans le local technique, en sortie de filtre (sur la partie refoulante bien sûr)."
                            },
                            {
                                "example_id": "6316cfbc-3565-4469-ba84-c40b8b2b78a4",
                                "sense_id": "a4bbf9a8-ee23-3ffe-94e0-d6ae5e582604",
                                "text": "Un surpresseur a pour fonction la mise et le maintien sous pression du réseau de distribution d’eau de pluie. La puissance de la pompe ou du surpresseur doit être inférieure à un kilowatt."
                            },
                            {
                                "example_id": "84d8146b-5728-4e34-aa78-64e4bcfb2215",
                                "sense_id": "a4bbf9a8-ee23-3ffe-94e0-d6ae5e582604",
                                "text": "La société Hydra LS demande au juge administratif d’annuler le marché public de service conclu par l’office public de l’habitat de Calais avec la société des Eaux de Calais ayant pour objet la maintenance des suppresseurs d’eaux et, à titre subsidiaire, de résilier le marché conclu par l’office public de l’habitat de Calais avec la société des Eaux de Calais, de condamner l’office public de l’habitat de Calais à l’indemniser du préjudice qu’elle a subi en raison de l’illégalité de la procédure de passation du marché litigieux."
                            }
                        ]
                    }
