                        "entry_id": "a93b2d19-6872-3bcd-a2a2-b3f2a340d959",
                        "glosses": [
                            "klinisches Bild, das sich aus der Gesamtheit der aus einem Krankheitsprozess resultierenden Symptome ergibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8026046a-2e47-472b-a259-34ca9fcc009d",
                                "sense_id": "a9679469-6b7f-3a5d-9551-46d48c591ec0",
                                "text": "Die Symptomatik des Patienten lässt auf einen Hirntumor schließen."
                            },
                            {
                                "example_id": "65c09714-07be-4ca6-a8d6-6306889ce43f",
                                "sense_id": "a9679469-6b7f-3a5d-9551-46d48c591ec0",
                                "text": "[Covid-19-Erkrankungen:] „Ungewöhnlich sind vor allem die schwerwiegenden Hirnschädigungen selbst bei Patienten mit einer leichten Symptomatik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
