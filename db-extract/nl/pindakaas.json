                "senses": [
                    {
                        "sense_id": "7e4ba164-2f06-3644-89d9-47530f5b30ce",
                        "entry_id": "e77d89ad-8b2b-3271-b6e7-7c48808d5972",
                        "glosses": [
                            "een soort broodbeleg dat bestaat uit een pasta van pinda's, slaolie en zout"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a216aba-7c53-4a82-937e-ad7b85709654",
                                "sense_id": "7e4ba164-2f06-3644-89d9-47530f5b30ce",
                                "text": "Hij had gisteren pindakaas op zijn brood."
                            },
                            {
                                "example_id": "a1c1804c-d9f3-422a-9fc0-1624947c4e61",
                                "sense_id": "7e4ba164-2f06-3644-89d9-47530f5b30ce",
                                "text": "De kans is groot dat ook pindakaas binnenkort op de lijst van verboden middelen komt te staan. Dat blijkt uit geheime documenten die in het bezit zijn van HNS. De gevleugelde uitspraak 'Op een boterham met pindakaas kun je de Tour niet winnen' heeft dopingjagers wakkergeschud. 'Pindakaas is minder onschuldig dan het lijkt', aldus een anonieme dopingexpert (H. Ram)."
                            },
                            {
                                "example_id": "2646f997-107f-44e3-9495-6bdd194f1475",
                                "sense_id": "7e4ba164-2f06-3644-89d9-47530f5b30ce",
                                "text": "Had hij gelijk? Was het egoïstisch om je gezin zo lang achter te laten? Ondertussen keek ik in zijn doos en haalde er wat tonijn, noedels en pindakaas uit."
                            }
                        ]
                    }
                ],
