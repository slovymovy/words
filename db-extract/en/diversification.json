                        "target_lang_word": "Diversifikation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diversifikation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33b0d668-5226-30f5-bdd9-34d8805f023f",
                                        "entry_id": "0375b268-aa56-3b36-b777-cad2e667b071",
                                        "glosses": [
                                            "Veränderung, Abwechslung, Vielfalt (Spezialisierung auf mehrere, unterschiedliche Gebiete; Prozess der Veränderung von einer Klasse in mehrere unterschiedliche)"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "106c4c97-2ef8-3b87-a14b-e2fccbae766d",
                                        "entry_id": "0375b268-aa56-3b36-b777-cad2e667b071",
                                        "glosses": [
                                            "Programm einer gezielten Unternehmenspolitik, die unter Berücksichtigung der Produktions- und Absatzstruktur neue Produkte auf neuen Märkten einführen und damit die Zukunft eines Unternehmens sichern will"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d97c380-cece-4740-a3fb-76499738b570",
                                                "sense_id": "106c4c97-2ef8-3b87-a14b-e2fccbae766d",
                                                "text": "Diversifikation betreiben Firmen, indem sie sich ein weiteres „Standbein“, also ein weiteres Produkt zulegen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d0f7099f-8fbf-3ea1-8241-39916df9d9c5",
                                        "entry_id": "0375b268-aa56-3b36-b777-cad2e667b071",
                                        "glosses": [
                                            "Differenzierung einer ursprünglichen Form in mehrere unterschiedliche Formen oder unterschiedliche Ausprägung einer sprachlichen Kategorie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6c755cd-9015-45a4-8b80-870081c1c3c1",
                                                "sense_id": "d0f7099f-8fbf-3ea1-8241-39916df9d9c5",
                                                "text": "Man kann die verschiedenen Kasus einer Sprache als Diversifikation der grammatischen Kategorie \"Kasus\" verstehen."
                                            },
                                            {
                                                "example_id": "0fc40019-cb7a-43bd-bd41-f06af298bbba",
                                                "sense_id": "d0f7099f-8fbf-3ea1-8241-39916df9d9c5",
                                                "text": "In der Quantitativen Linguistik wurde der Vorschlag eines Diversifikationsgesetzes gemacht und mit Erfolg überprüft. Die verschiedenen Formen einer Diversifikation sind gemäß dem Diversifikationsgesetz verteilt."
                                            },
                                            {
                                                "example_id": "d856d259-2989-4ca0-afaa-6aa3f99ba2f9",
                                                "sense_id": "d0f7099f-8fbf-3ea1-8241-39916df9d9c5",
                                                "text": "„Die semantische Diversifikation wirkt sich auf mehreren Ebenen aus. Auf der morphologischen Ebene betrifft die semantische Diversifikation die Bedeutung von Affixen.“"
                                            },
                                            {
                                                "example_id": "e66618a3-ad2a-42fb-abf8-ef9943ed6388",
                                                "sense_id": "d0f7099f-8fbf-3ea1-8241-39916df9d9c5",
                                                "text": "„Zur Untersuchung der grammatischen Diversifikation im Text wurde … das häufigste und stark polyfunktionale grammatische Morphem, d.h. die polnische Präposition w ausgewählt.“"
                                            },
                                            {
                                                "example_id": "a1d36f5a-32e0-42a7-baa0-e1d9e43933ca",
                                                "sense_id": "d0f7099f-8fbf-3ea1-8241-39916df9d9c5",
                                                "text": "„Die auf diese Weise erhaltenen Resultate legen den Schluß nahe, daß die semantische Diversifikation von »in« in dem untersuchten Werk recht homogen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
