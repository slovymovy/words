                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ea81886-2557-42c4-9b53-475d2daccc44",
                        "source_entry_id": "b96e9edb-cacf-3a99-987f-e927e3c74faf",
