                        "examples": [
                            {
                                "example_id": "6fad8d33-6d4e-4e7f-aa2e-39327490a932",
                                "sense_id": "d88aba52-e9a8-3084-a9c0-2665ea02c1ff",
                                "text": "In 1992 mocht Washington voor het laatst een grote titel vieren. Het American Football-team Washington Redskins won dat jaar in de Super Bowl met 37-24 van de Buffalo Bills. Sindsdien was er voor de Redskins vaak hoop, maar nog veel vaker bittere teleurstelling. De honkballers van de Washington Nationals hebben onder aanvoering van buitenvelder Bryce Harper en werper Max Scherzer weliswaar een topteam, maar in de play-offs geven de sterren veelal niet thuis. De laatste honkbaltitel voor een team uit Washington dateert uit 1924."
                            },
                            {
                                "example_id": "b8cd2415-53be-4078-8207-6a044e9272f3",
                                "sense_id": "d88aba52-e9a8-3084-a9c0-2665ea02c1ff",
                                "text": "Ook zijn teamgenoten zijn lovend over hem. Een van die spelers is buitenvelder Ender Inciarte, die vorig jaar werd verkozen in het All Star-team, de selectie van beste spelers in de Amerikaanse profcompetitie."
                            }
                        ]
                    }
