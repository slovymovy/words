                                    {
                                        "sense_id": "271bf780-d61c-3baf-805d-0692051670d4",
                                        "entry_id": "d521f776-56ad-364d-aae7-c535287b4322",
                                        "glosses": [
                                            "für sich alleine, gesondert, separat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a395d16-2818-4010-91b1-2e6256bb8621",
                                                "sense_id": "271bf780-d61c-3baf-805d-0692051670d4",
                                                "text": "Diese Punkte werden wir später besonders behandeln."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b67f877a-7bf0-324a-adfe-674ccc7dd60e",
                                        "entry_id": "d521f776-56ad-364d-aae7-c535287b4322",
                                        "glosses": [
                                            "mit Nachdruck zum Ausdruck gebracht; ausdrücklich, entschieden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7bd396b-fb5f-4691-ba80-680da67257eb",
                                                "sense_id": "b67f877a-7bf0-324a-adfe-674ccc7dd60e",
                                                "text": "Auf diese Verbote wurde besonders hingewiesen."
                                            },
                                            {
                                                "example_id": "6d30faa4-4684-4c51-bc06-426bb4c15ee3",
                                                "sense_id": "b67f877a-7bf0-324a-adfe-674ccc7dd60e",
                                                "text": "Ganz besonders ist es verboten, hier nachts herumzuspazieren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2b22bca3-23ac-36ac-a5e3-3226c9edb06a",
                                        "entry_id": "d521f776-56ad-364d-aae7-c535287b4322",
                                        "glosses": [
                                            "sehr"
                                        ],
                                        "tags": [
                                            "eine Eigenschaft verstärkend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26b9890c-efe6-426f-a296-43a602c755d7",
                                                "sense_id": "2b22bca3-23ac-36ac-a5e3-3226c9edb06a",
                                                "text": "„Wir schreiben hier über den Motorflug, weil sich hier die Nöte des westdeutschen Luftsportes besonders kraß abzeichnen.“"
                                            },
                                            {
                                                "example_id": "220e5385-f8d3-48ce-8095-731763fb3ab2",
                                                "sense_id": "2b22bca3-23ac-36ac-a5e3-3226c9edb06a",
                                                "text": "Das hast du aber besonders schlau eingefädelt!"
                                            },
                                            {
                                                "example_id": "805f3f25-3303-43a0-a3dc-9c295bc3994b",
                                                "sense_id": "2b22bca3-23ac-36ac-a5e3-3226c9edb06a",
                                                "text": "Das Kantinenessen ist heute aber besonders gut."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "45c20ceb-c035-3e87-a873-a8fa0edb0468",
                                        "entry_id": "d521f776-56ad-364d-aae7-c535287b4322",
                                        "glosses": [
                                            "positiv herausragend"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6375f72d-828f-4b95-b907-e3e7e5f027eb",
                                                "sense_id": "45c20ceb-c035-3e87-a873-a8fa0edb0468",
                                                "text": "Das Kantinenessen ist heute nicht besonders."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "13c9541b-31b0-363a-8b79-0e6f9415c279",
                                        "entry_id": "d521f776-56ad-364d-aae7-c535287b4322",
                                        "glosses": [
                                            "nicht der Norm entsprechend; absonderlich"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "427d6bb5-96dd-45b1-8f5b-574c319c94ee",
                                                "sense_id": "13c9541b-31b0-363a-8b79-0e6f9415c279",
                                                "text": "Also mein Onkel Richard ist schon besonders, er lebt in einem Haus ohne Strom und Wasser."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
