                        "examples": [
                            {
                                "example_id": "62e9bb74-e465-47d6-b92f-836fd6565823",
                                "sense_id": "561504f7-f14a-3765-adf3-e783fbcb6417",
                                "text": "„Zwei koexistierende Waldsänger (Orangefleck-W., Vermivora celata; Virginia-W., […]) erlitten beide höhere Nestprädation, wenn sie nebeneinander vorkamen.“"
                            },
                            {
                                "example_id": "7b6afe25-80c8-4195-b334-9903e84a332c",
                                "sense_id": "561504f7-f14a-3765-adf3-e783fbcb6417",
                                "text": "„Im Summen des Waldes hörte man seine Stimme nur noch schwach. ›Ein Orangefleck-Waldsänger!‹, rief er.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
