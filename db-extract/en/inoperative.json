                                                "sense_id": "238e5c08-136c-3a62-943e-ebf573530a8e",
                                                "text": "Der defekte Plattenspieler zerkratzt die Schallplatten."
                                            },
                                            {
                                                "example_id": "36fb9b32-ad80-4732-a7ff-d1e3c0c90eeb",
                                                "sense_id": "238e5c08-136c-3a62-943e-ebf573530a8e",
                                                "text": "„Wir trafen kurz nach Weihnachten vor dem defekten Leergutautomaten der Extra-Kaufhalle aufeinander.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
