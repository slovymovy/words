                                    {
                                        "sense_id": "1cd5a5ee-8b7b-38b6-bedd-8157d1365608",
                                        "entry_id": "d8905b5a-e6ba-39a6-ba14-998667d77814",
                                        "glosses": [
                                            "Any of a class of inert, semi-inorganic polymeric compounds (polysiloxanes), that have a wide range of thermal stability and extreme water repellence, used in a very wide range of industrial applications, and in prosthetic replacements for body parts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3efce539-ec9b-43d0-8093-b4a19727da2e",
                                                "sense_id": "1cd5a5ee-8b7b-38b6-bedd-8157d1365608",
                                                "text": "[H]e had little time or respect for the rich skip bitches who were his neighbours, useless fake-tanned women with plastic smiles and silicone tits who spent their husbands' money on afternoon teas, endless shopping and personal trainers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "silicone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e1e82e2-b961-3bc2-9a8d-46b23f543763",
                                        "entry_id": "a9faa9f6-bc9f-3e05-accd-2fc627e905c4",
                                        "glosses": [
                                            "To join or treat (something) with a silicone-based product."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9c6a451-9e4f-4add-b9df-3a52be7c5750",
                                                "sense_id": "8e1e82e2-b961-3bc2-9a8d-46b23f543763",
                                                "text": "silicone the bathtub to the tile"
                                            },
                                            {
                                                "example_id": "48e50b4d-e7e3-437f-a0fb-d2175bf8f251",
                                                "sense_id": "8e1e82e2-b961-3bc2-9a8d-46b23f543763",
                                                "text": "Structural glazing or siliconing of window units is, according to Donald F. Kelly, Jr., president of AMPAT, the bonding of glass to a metal frame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "435c8d5f-2fa8-30e5-8f93-cda26467b299",
                                        "entry_id": "a9faa9f6-bc9f-3e05-accd-2fc627e905c4",
                                        "glosses": [
                                            "To enhance or reconstruct (a body part) with a prosthesis containing silicone."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6260816b-2587-400f-877c-457ce57dac07",
                                                "sense_id": "435c8d5f-2fa8-30e5-8f93-cda26467b299",
                                                "text": "The next girl, with huge, perfectly spherical, siliconed breasts perched high on her slender chest, got the loudest roar. ‘Oh, there are two things I like about her!’ shouted the DJ. ‘How about you, boys?’"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "silicone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26be3658-5df2-3285-ad2f-9550291a092a",
                                        "entry_id": "44ab0599-cec1-3860-bc1c-1478febd9bfe",
                                        "glosses": [
                                            "Having had cosmetic surgery, especially breast enlargement."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2db87c65-fddb-4094-bbd6-a1d948440a7a",
                                                "sense_id": "26be3658-5df2-3285-ad2f-9550291a092a",
                                                "text": "Besides, the bevy of silicone beauties surrounding him would have been difficult, not to mention ego-crushing, to wade through."
                                            },
                                            {
                                                "example_id": "7ff4d98c-c5ae-4ef3-9989-fdb802a99ca1",
                                                "sense_id": "26be3658-5df2-3285-ad2f-9550291a092a",
                                                "text": "They want to see men covered in sweat, lying in bed with some unknown, blank, silicone actresses — they want sculpted bodies, they don't give a shit about performance."
                                            },
                                            {
                                                "example_id": "c399678e-9dab-4d51-bd4e-c9e14ca112c5",
                                                "sense_id": "26be3658-5df2-3285-ad2f-9550291a092a",
                                                "text": "Nowadays it is a cliché to associate silicone women with narco aesthetics, overdrawn Pamela Anderson clones popularized by telenovelas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
