                                        "glosses": [
                                            "A British gold coin worth 20 shillings, first produced during the reign of King James I, and bearing a legend indicating the king's intention of uniting the kingdoms of England and Scotland."
                                        ],
                                        "tags": [
                                            "UK",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93665ff5-680b-48d3-8735-eff0a90e03db",
                                                "sense_id": "f7c08c3e-cf9a-3220-8ae6-93cfc8302cd0",
                                                "text": "Occasionally Scots and Irish coins are also found. The gold hoards consist entirely of crown gold unites, half unites and quarter unites from the reigns of James I and Charles I."
                                            }
                                        ]
                                    }
                                ]
                            }
