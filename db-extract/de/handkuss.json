                    },
                    {
                        "translation_id": "a328af61-f703-4e4f-81e5-d5b2ef4522e5",
                        "source_entry_id": "7d75aa21-87c6-39dc-a766-550a5efb508e",
                        "source_sense_id": "7d078008-8521-3cd3-ab08-a7458dc3829b",
                        "source_sense_description": "das Küssen des Handrückens zur Begrüßung oder Verabschiedung",
                        "target_lang_word": "baisemain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baisemain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2e504862-f9c5-37b1-b528-673b8fba3d4f",
                                        "entry_id": "b8200310-79ab-33c6-a72d-06aaa91ce4d1",
                                        "glosses": [
                                            "Hommage que le vassal rend au seigneur du fief en lui baisant la main."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "131f66d7-a9e0-4aff-ae17-49c9378e325b",
                                                "sense_id": "2e504862-f9c5-37b1-b528-673b8fba3d4f",
                                                "text": "Il ne devait que le baisemain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e6424c9-aa57-33d3-b282-9a8a8a42a63b",
                                        "entry_id": "b8200310-79ab-33c6-a72d-06aaa91ce4d1",
                                        "glosses": [
                                            "Geste de politesse qui consiste à baiser la main d’une dame pour la saluer ou pour prendre congé d’elle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1414825-0481-4135-8305-7ad192f88272",
                                                "sense_id": "7e6424c9-aa57-33d3-b282-9a8a8a42a63b",
                                                "text": "Aussitôt de tous les gradins partent des viva assourdissants ; les mouchoirs s’agitent ; les chapeaux des majos volent dans l’arène, et le héros vainqueur envoie modestement des baisemains de tous les côtés."
                                            },
                                            {
                                                "example_id": "7616d659-fa7c-42e6-ad52-8b59ff135aee",
                                                "sense_id": "7e6424c9-aa57-33d3-b282-9a8a8a42a63b",
                                                "text": "Le snobisme scolaire qui consiste, en poésie, à n’employer que certains mots déterminés, à la priver de certains autres, qu’ils soient techniques, médicaux, populaires ou argotiques, me fait penser au prestige du rince-doigts et du baisemain. Ce n’est pas le rince-doigts qui fait les mains propres ni le baisemain qui fait la tendresse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
