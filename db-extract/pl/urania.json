                        ],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "b6644dfa-ea73-3730-ba5d-cd4d91f3644b",
                        "entry_id": "f62d10b0-b3c7-3b2b-a214-5f83fcb3586f",
                        "glosses": [
                            "planetoida o numerze katalogowym 30, z pasa głównego planetoid, odkryta w 1854 r."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2753d87b-03d8-466c-852d-4745f9076759",
                                "sense_id": "b6644dfa-ea73-3730-ba5d-cd4d91f3644b",
                                "text": "Urania porusza się w obszarze między orbitami Marsa i Jowisza."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
