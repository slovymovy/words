                "senses": [
                    {
                        "sense_id": "bd8e434a-c777-3e22-b546-de676766439c",
                        "entry_id": "5ff36897-366b-333a-a798-0c645dd37c6c",
                        "glosses": [
                            "Qui a l’habitude de se lever tôt le matin, matinal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b35a697-a09f-4edd-8bb7-0ce01e708a47",
                                "sense_id": "bd8e434a-c777-3e22-b546-de676766439c",
                                "text": "Ah ! ah ! fit le roi […] vous êtes bien matineux, Henriot, pour un jeune marié !"
                            },
                            {
                                "example_id": "27b5871e-86d2-48dd-b2d0-bb82e43d54b8",
                                "sense_id": "bd8e434a-c777-3e22-b546-de676766439c",
                                "text": "Les Parisiens ne sont pas matineux, surtout après une journée de fatigue."
                            },
                            {
                                "example_id": "0e6ed9fc-be2d-46da-bda2-6109b6c02d0e",
                                "sense_id": "bd8e434a-c777-3e22-b546-de676766439c",
                                "text": "Elle trouvait le moyen d’avoir déjà vécu son meilleur temps d’indépendance avant que les plus matineux aient poussé leurs persiennes."
                            },
                            {
                                "example_id": "84b694ef-a349-4cc5-8063-3dc9b4ff04ce",
                                "sense_id": "bd8e434a-c777-3e22-b546-de676766439c",
                                "text": "Filles, garçons, vieilles et vieux,\nEn souquenilles magnifiques,\nS’en vont aux vignes, matineux,\nSelon les coutumes bibliques."
                            },
                            {
                                "example_id": "5eef9f69-9c4e-4eea-bf89-79f60ac09440",
                                "sense_id": "bd8e434a-c777-3e22-b546-de676766439c",
                                "text": "Bosse, le cafetier de la place, un des plus matineux, n’a pas encore entrouvert ses persiennes."
                            },
                            {
                                "example_id": "1fa4bbd0-5f17-41d8-8a8f-7f0d77720911",
                                "sense_id": "bd8e434a-c777-3e22-b546-de676766439c",
                                "text": "On entendit une porte tourner sur ses ferrures, dans ce silence du matin, et une première petite échoppe arabe s’ouvrit, où l’on vendait du café avec des beignets au miel, à l’usage des gens matineux."
                            }
                        ]
                    }
                ],
