        "nl-extract.jsonl": [
            {
                "entry_id": "a4cbb746-5af1-32c2-abd2-6d5b9bb9fd65",
                "word": "trailer",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "92cb20cb-1a42-4a21-96e9-bdffc7e6c160",
                        "entry_id": "a4cbb746-5af1-32c2-abd2-6d5b9bb9fd65",
                        "tags": [
                            "plural"
                        ],
                        "form": "trailers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "30f08614-3c18-3e07-8ed1-c873c01e6b3e",
                        "entry_id": "a4cbb746-5af1-32c2-abd2-6d5b9bb9fd65",
                        "glosses": [
                            "wagen die aan de achterkant van een auto vast wordt gemaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2adf9c1-fed0-4f31-bb12-6d5244aa27de",
                                "sense_id": "30f08614-3c18-3e07-8ed1-c873c01e6b3e",
                                "text": "Bram kwam op 't idee om van Wieren nog naar een trailer te vragen achter de tractor aan. Ook dit verliep gunstig. Achter Middenmeer stond nog een trailer, maar voorbanden waren lek en één achterwiel stond bij een boerderij verder."
                            },
                            {
                                "example_id": "5692dc5f-7496-4062-a580-75c3d579f935",
                                "sense_id": "30f08614-3c18-3e07-8ed1-c873c01e6b3e",
                                "text": "Hij leefde in een zelf verbouwde kampeerbus en kon dankzij een kleine Smart, dat hij op een trailer achter zijn bus aan trok, overal naar toe rijden als hij zijn kampeerbus een tijdje bij een van zijn vrienden voor de deur had geparkeerd."
                            }
                        ]
                    },
                    {
                        "sense_id": "5072fe9a-c65a-3404-97df-b1a46cc60a1c",
                        "entry_id": "a4cbb746-5af1-32c2-abd2-6d5b9bb9fd65",
                        "glosses": [
                            "vrachtwagen met oplegger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6e31a51-ca10-4dcd-ad90-2edf51529855",
                                "sense_id": "5072fe9a-c65a-3404-97df-b1a46cc60a1c",
                                "text": "Plotseling dook er pal voor ons een trailer op, een gigantisch bakbeest dat in de tegengestelde richting zeilde. Het opleggersgedeelte hing als een brede staart naar beneden, en Frido slaagde er niet in het gevaarte te ontwijken."
                            }
                        ]
                    },
                    {
                        "sense_id": "46bc414f-099f-3719-8935-f9532fcff3bc",
                        "entry_id": "a4cbb746-5af1-32c2-abd2-6d5b9bb9fd65",
                        "glosses": [
                            "woonwagen die aan de achterkant van een personenauto vast wordt gemaakt"
                        ],
                        "tags": [
                            "wonen"
                        ],
                        "examples": [
                            {
                                "example_id": "5acd33a6-864b-44c4-9624-8f5af2089000",
                                "sense_id": "46bc414f-099f-3719-8935-f9532fcff3bc",
                                "text": "Bij Raymond Carver geen uitsneden uit propere burgermanslevens in de buitenwijken, maar een nietsverhullende uitlichting van het harde, rauwe, vaak troosteloze segment van Amerika: de wereld van de sappelaars die in trailers wonen, uitzichtloze baantjes hebben of die nauwelijks het hoofd boven water houden in grauwe stadjes in het Midden-Westen."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb7ecab8-abdf-3e5a-a12b-f5a2ae2b22d8",
                        "entry_id": "a4cbb746-5af1-32c2-abd2-6d5b9bb9fd65",
                        "glosses": [
                            "voorproefje met fragmenten van een binnenkort uit te brengen film, meestal vóór het begin van een andere voorstelling in de bioscoop of op tv getoond"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b33f58fb-5403-4916-bfa5-67221a4e6410",
                                "sense_id": "cb7ecab8-abdf-3e5a-a12b-f5a2ae2b22d8",
                                "text": "Bij het zien van trailer van de film Le Bonheur (zonder iets te weten van hoe en wat, ik kende alleen een film en de naam van de regisseuse Agnès Varda) raakte ik onmiddellijk geïntrigeerd door de stoet van van uitzinnig feestelijke zonovergoten beelden (directe reactie: Elegance, Margriet, modeadvertenties)."
                            }
                        ]
                    }
                ],
