                ],
                "senses": [
                    {
                        "sense_id": "e4762500-84de-3e56-baca-bb6f156fb34d",
                        "entry_id": "0ee17cf9-a876-3be9-acaa-2213982038ec",
                        "glosses": [
                            "Apparaître."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e44b0a6e-c88b-47c0-82f9-9a6245192028",
                                "sense_id": "e4762500-84de-3e56-baca-bb6f156fb34d",
                                "text": "Constitué Louis Damour, mesnager, du lieu de Velaux, aagé d’environ 50 ans, témoing assigné et produit à la request de M. le procureur général du Roy, ainsin qu’il a faict apparoir de la coppie."
                            },
                            {
                                "example_id": "117677ab-b2d1-41b0-a8b4-f5c39ea50b65",
                                "sense_id": "e4762500-84de-3e56-baca-bb6f156fb34d",
                                "text": "Devers l’Afrique & Perse, à Tauris & à Trapezance ou Trebisonde, un signe merveilleux fait apparoir à la fin de Mars grande effusion de sang & mortalité, & plus au royaume de Naples & Sicile. & au païs de Provence signes apparants de peste & guerre."
                            }
                        ]
                    },
                    {
                        "sense_id": "84687301-3595-3565-a7f3-44997de15de2",
                        "entry_id": "0ee17cf9-a876-3be9-acaa-2213982038ec",
                        "glosses": [
                            "Être évident, être manifeste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b28868e5-e21d-4925-a195-8176626906a8",
                                "sense_id": "84687301-3595-3565-a7f3-44997de15de2",
                                "text": "Madame, Monsieur, Il appert que le commerçant 9061-3183 Québec inc. faisant affaire sous le nom Couverture Argus aurait cessé ses activités au 4120, rue Sainte-Catherine Ouest, vers le 15 mars 2004. Ce commerçant avait fourni un cautionnement de 12 500 $, valide du 19 novembre 2003 au 8 novembre 2005."
                            }
                        ]
                    }
