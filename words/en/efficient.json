{
    "word_family": [
        "efficiency",
        "efficiently",
        "inefficiency",
        "inefficient"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "08372609-3d97-3f23-90f5-292edc1c9672",
                    "sense_definition": "Making good, thorough, or careful use of resources; not consuming extra.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "resource_usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new manager introduced a highly <w>efficient</w> system for tracking orders.",
                            "target_lang_translations": {
                                "ru": "Новый менеджер внедрил высоко<w>эффективную</w> систему отслеживания заказов.",
                                "zh": "新经理引入了一套非常<w>高效</w>的订单追踪系统。"
                            }
                        },
                        {
                            "text": "We need to be more <w>efficient</w> with our time to finish the project by Friday.",
                            "target_lang_translations": {
                                "ru": "Нам нужно более <w>рационально</w> использовать время, чтобы закончить проект к пятнице.",
                                "zh": "我们需要更<w>高效</w>地利用时间，以便在周五前完成项目。"
                            }
                        }
                    ],
                    "synonyms": [
                        "economical"
                    ],
                    "antonyms": [
                        "inefficient",
                        "uneconomical",
                        "prodigal"
                    ],
                    "common_phrases": [
                        "highly efficient",
                        "cost efficient",
                        "energy efficient",
                        "efficient use"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рационально использующий ресурсы, дающий наилучший результат с наименьшими затратами.",
                        "zh": "指在利用资源时做得好、彻底或仔细，不浪费额外资源。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эффективный",
                                "target_lang_sense_clarification": "действенный, результативный"
                            },
                            {
                                "target_lang_word": "рациональный",
                                "target_lang_sense_clarification": "разумный в использовании ресурсов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "高效",
                                "target_lang_sense_clarification": "指工作或使用资源时效率高"
                            },
                            {
                                "target_lang_word": "有成效",
                                "target_lang_sense_clarification": "指能产生良好结果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6d3e1b8-ef45-3839-a19c-68f1ed5d3715",
                    "sense_definition": "Expressing the proportion of consumed energy that was successfully used in a process; the ratio of useful output to total input.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "technical_ratio",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "LED bulbs are much more <w>efficient</w> than traditional incandescent lights.",
                            "target_lang_translations": {
                                "ru": "Светодиодные лампы гораздо <w>экономичнее</w> традиционных ламп накаливания.",
                                "zh": "LED灯泡比传统的白炽灯要<w>节能</w>得多。"
                            }
                        },
                        {
                            "text": "Engineers are trying to design a fuel <w>efficient</w> engine for the new car model.",
                            "target_lang_translations": {
                                "ru": "Инженеры пытаются разработать <w>экономичный</w> двигатель для новой модели автомобиля.",
                                "zh": "工程师们正在为新车型设计一款<w>节能</w>的发动机。"
                            }
                        }
                    ],
                    "antonyms": [
                        "inefficient"
                    ],
                    "common_phrases": [
                        "fuel efficient",
                        "thermally efficient"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся высоким коэффициентом полезного действия (КПД); потребляющий мало ресурсов для работы.",
                        "zh": "指在过程中成功利用的能量比例，即有效输出与总输入的比率。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экономичный",
                                "target_lang_sense_clarification": "выгодный, потребляющий мало ресурсов"
                            },
                            {
                                "target_lang_word": "энергоэффективный",
                                "target_lang_sense_clarification": "сберегающий энергию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "节能",
                                "target_lang_sense_clarification": "指节省能源"
                            },
                            {
                                "target_lang_word": "经济",
                                "target_lang_sense_clarification": "指消耗资源少"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ad90144-dad8-33d0-9220-c8f542bb90ea",
                    "sense_definition": "Causing effects, producing results; bringing into being; initiating change.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "causative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In philosophy, the agent that brings something about is called the <w>efficient</w> cause.",
                            "target_lang_translations": {
                                "ru": "В философии агент, который что-либо осуществляет, называется <w>действующей</w> причиной.",
                                "zh": "在哲学中，促成某事发生的动因被称为<w>直接</w>原因。"
                            }
                        },
                        {
                            "text": "The lawyer argued that the driver's negligence was the <w>efficient</w> cause of the accident.",
                            "target_lang_translations": {
                                "ru": "Адвокат утверждал, что халатность водителя стала <w>непосредственной</w> причиной аварии.",
                                "zh": "律师辩称，司机的疏忽是导致事故的<w>直接</w>原因。"
                            }
                        }
                    ],
                    "synonyms": [
                        "efficacious",
                        "potent"
                    ],
                    "common_phrases": [
                        "efficient cause"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "philosophy"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "legal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Производящий действие или результат; являющийся непосредственной причиной изменения.",
                        "zh": "产生效果或结果；引起变化。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "действующий",
                                "target_lang_sense_clarification": "в сочетании \"действующая причина\""
                            },
                            {
                                "target_lang_word": "производящий",
                                "target_lang_sense_clarification": "создающий эффект"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "直接的",
                                "target_lang_sense_clarification": "指导致结果的直接原因"
                            },
                            {
                                "target_lang_word": "起作用的",
                                "target_lang_sense_clarification": "指产生实际影响的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f5edc432-e4cd-3928-89ed-ebe441a28330",
                    "sense_definition": "A cause; something that causes an effect.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher discussed the primary <w>efficient</w> of the universe.",
                            "target_lang_translations": {
                                "ru": "Философ обсуждал первичную <w>движущую силу</w> вселенной.",
                                "zh": "这位哲学家探讨了宇宙最初的<w>动力</w>。"
                            }
                        },
                        {
                            "text": "He argued that money was the <w>efficient</w> of the crime.",
                            "target_lang_translations": {
                                "ru": "Он утверждал, что деньги были <w>причиной</w> преступления.",
                                "zh": "他认为金钱是这起犯罪的<w>起因</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что производит действие; причина или источник силы.",
                        "zh": "原因；引起某种结果的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "движущая сила",
                                "target_lang_sense_clarification": "источник действия"
                            },
                            {
                                "target_lang_word": "причина",
                                "target_lang_sense_clarification": "основание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "动力",
                                "target_lang_sense_clarification": "指推动事物发展的力量"
                            },
                            {
                                "target_lang_word": "起因",
                                "target_lang_sense_clarification": "指事件发生的根源"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}