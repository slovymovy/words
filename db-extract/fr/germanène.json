                                        "sense_id": "0a0a9812-c94e-393c-841c-4bc9303b2108",
                                        "entry_id": "9b2a0042-d4ee-3fa2-b401-96ad16517560",
                                        "glosses": [
                                            "An allotrope of germanium that has a hexagonal, planar structure analogous to graphene"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d8d049a-df90-4abe-8e1d-b18aabb2cdae",
                                                "sense_id": "0a0a9812-c94e-393c-841c-4bc9303b2108",
                                                "text": "Calculating the complex dielectric function for optical interband transitions we show that the two-dimensional crystals silicene and germanene possess the same low-frequency absorbance as graphene."
                                            },
                                            {
                                                "example_id": "a68a50e5-1692-40e4-b779-07e2758bb291",
                                                "sense_id": "0a0a9812-c94e-393c-841c-4bc9303b2108",
                                                "text": "We present first-principles studies of the optical absorbance of the group IV honeycomb crystals graphene, silicene, germanene, and tinene."
                                            },
                                            {
                                                "example_id": "9942f894-c609-4769-87e2-6ebb3d9f9057",
                                                "sense_id": "0a0a9812-c94e-393c-841c-4bc9303b2108",
                                                "text": "After the successful synthesis of silicene in 2012, which was followed by a surge of studies on elemental, novel two-dimensional (2D) materials beyond graphene, a daunting quest was to obtain germanene, the germanium-based analogue of graphene, already predicted to possibly exist in 2009."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
