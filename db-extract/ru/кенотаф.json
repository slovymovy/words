                                            {
                                                "example_id": "486839b9-9eeb-4e20-a0b1-981956b5b624",
                                                "sense_id": "ad607ffd-ba7b-3b10-9044-772411694232",
                                                "text": "„ Hier errichtete Herodes dem Urvater ein Scheingrab, ein Kenotaph.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
