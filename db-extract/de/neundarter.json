                "senses": [
                    {
                        "sense_id": "e9079fa8-6b03-34b5-a633-0c15566bcedc",
                        "entry_id": "a7b13d8b-c077-392b-bdc7-e79bc53954ec",
                        "glosses": [
                            "das Gewinnen eines Sets beim 501er-Dartspiel mit genau neun Würfen"
                        ],
                        "tags": [
                            "Darts"
                        ],
                        "examples": [
                            {
                                "example_id": "a80f0786-5a08-424d-b040-f6707b4c6b6b",
                                "sense_id": "e9079fa8-6b03-34b5-a633-0c15566bcedc",
                                "text": "„Und auch bei diesem Spiel gibt es Höchstleistungen, wie etwa 17 Möglichkeiten, einen Neundarter — ein Durchgang 501 mit neun Darts beendet — zu werfen.“"
                            },
                            {
                                "example_id": "42209558-41c5-4912-9718-25b0ebdd1f6e",
                                "sense_id": "e9079fa8-6b03-34b5-a633-0c15566bcedc",
                                "text": "„Nun sind Sie wieder in einer starken Verfassung, trumpfen in der Premier League auf und haben dort auch schon ein perfektes Spiel mit dem Neundarter abgeliefert.“"
                            },
                            {
                                "example_id": "2f3727b3-3bb9-47b4-8e6b-d20e86953f3b",
                                "sense_id": "e9079fa8-6b03-34b5-a633-0c15566bcedc",
                                "text": "„Bei einem ‚Neundarter‘ ist das Spiel in wenigen Minuten beendet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
