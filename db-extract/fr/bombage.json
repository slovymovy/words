                        "entry_id": "1f5d227c-3b11-36d4-bd62-002f56aaf6f7",
                        "glosses": [
                            "Opération du vitrier qui a pour but de cintrer le verre au four."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33b1298f-cbd9-4417-acf3-99fdfaa25719",
                                "sense_id": "571a4316-a895-3f67-ba33-554f3e36327a",
                                "text": "L'obligation de combiner le bombage et la trempe, notamment pour tous les vitrages d'une voiture sauf le pare-brise, est un avantage plutôt qu'un inconvénient."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc3fdf46-981c-34e3-b3e9-e58396d50d38",
                        "entry_id": "1f5d227c-3b11-36d4-bd62-002f56aaf6f7",
                        "glosses": [
                            "Opération de cintrage de tout matériau en plaque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b523fb9b-c973-44ec-9ab3-14ca241f710b",
                                "sense_id": "fc3fdf46-981c-34e3-b3e9-e58396d50d38",
                                "text": "Ils sont responsables de la dégradation des aliments dont une des manifestations possible est le bombage des boîtes métalliques."
                            }
                        ]
                    }
                ],
