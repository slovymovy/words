                ],
                "senses": [
                    {
                        "sense_id": "b3a52c09-1037-3c50-81dc-35d9c9485cc1",
                        "entry_id": "e13928ba-66f8-36e4-af9b-b963c33a4173",
                        "glosses": [
                            "Variante orthographique de froufrouter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53cd6e70-7e13-4fc0-b1fd-d4ea25004bac",
                                "sense_id": "b3a52c09-1037-3c50-81dc-35d9c9485cc1",
                                "text": "Il froufroutte, remarqua Lyams, avec une inflexion efféminée, je vous parie qu’il froufroutte."
                            },
                            {
                                "example_id": "8122c16c-f747-4017-8cd2-dd19986f5568",
                                "sense_id": "b3a52c09-1037-3c50-81dc-35d9c9485cc1",
                                "text": "Ce sont des baronnes, toutes sortes de baronnes en an, en eim ou en er, Bechman, Lechmann, Staffmann, Wanheim, Wirweiller ou Zevyller qui se tordent de rire, qui font froufroutter, onduler, frissonner des robes de satin, de dentelles, de crêpe de Chine, des robes couleur aurore, crépuscule ou vieil or."
                            },
                            {
                                "example_id": "2a698f82-e8ea-4ebb-98a5-aebef4582c2e",
                                "sense_id": "b3a52c09-1037-3c50-81dc-35d9c9485cc1",
                                "text": "Entrons dans cette galerie où tout froufroutte dans le craquement des soies ou des velours de Lyon !"
                            }
                        ]
                    }
                ],
