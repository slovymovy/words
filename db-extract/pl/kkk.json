                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fdee9e0-d1c9-4bcd-b7f8-d0ee663a30e1",
                                                "sense_id": "ede08a26-80c0-3e2d-954f-a407427ac001",
                                                "text": "La CEC consiste à récupérer le sang veineux (pauvre en O2) dans l’oreillette droite, l’oxygéner par une membrane puis le réinjecter dans le réseau artériel."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "CEC",
                                "target_lang_code": "fr",
                                "target_senses": [
