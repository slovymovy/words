{
    "word_family": [
        "cashier",
        "cashless",
        "cashable",
        "encash"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bf509c89-d5ef-30ff-a102-ef2cde2835b1",
                    "sense_definition": "Money in the form of notes, bills, and coins, as opposed to checks, credit, or electronic transactions.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "money_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I wanted to buy a coffee, but I didn't have any <w>cash</w> in my wallet.",
                            "target_lang_translations": {
                                "ru": "Я хотел купить кофе, но у меня в кошельке не было <w>наличных</w>.",
                                "zh": "我想买杯咖啡，但钱包里没带<w>现金</w>。"
                            }
                        },
                        {
                            "text": "The small shop accepts <w>cash</w> only, so you cannot use your card.",
                            "target_lang_translations": {
                                "ru": "Этот маленький магазин принимает только <w>наличные</w>, поэтому вы не можете использовать карту.",
                                "zh": "这家小店只收<w>现金</w>，所以你不能用卡支付。"
                            }
                        }
                    ],
                    "synonyms": [
                        "currency",
                        "change",
                        "bills",
                        "coins",
                        "legal tender",
                        "banknotes",
                        "money"
                    ],
                    "antonyms": [
                        "credit",
                        "check"
                    ],
                    "common_phrases": [
                        "pay in cash",
                        "hard cash",
                        "petty cash",
                        "cash only",
                        "spare cash"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деньги в виде банкнот и монет, в отличие от чеков, кредитов или электронных транзакций.",
                        "zh": "以纸币和硬币形式存在的货币，区别于支票、信用或电子交易。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нали́чные",
                                "target_lang_sense_clarification": "деньги"
                            },
                            {
                                "target_lang_word": "нали́чка",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "нали́чные де́ньги",
                                "target_lang_sense_clarification": "полная форма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "现金",
                                "target_lang_sense_clarification": "货币"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c884e8ec-3e3e-3946-998a-7c19d88a22ca",
                    "sense_definition": "Liquid assets or money that can be traded or used quickly, as distinct from invested assets.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "money_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is profitable, but it has a serious <w>cash</w> flow problem.",
                            "target_lang_translations": {
                                "ru": "Компания прибыльна, но у нее серьезные проблемы с потоком <w>денежных средств</w>.",
                                "zh": "公司虽然盈利，但面临严重的<w>资金</w>周转问题。"
                            }
                        },
                        {
                            "text": "Investors are holding more <w>cash</w> because the stock market is volatile.",
                            "target_lang_translations": {
                                "ru": "Инвесторы держат больше <w>наличности</w>, так как фондовый рынок нестабилен.",
                                "zh": "由于股市波动剧烈，投资者持有更多的<w>现金</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "funds",
                        "capital",
                        "liquidity",
                        "resources"
                    ],
                    "antonyms": [
                        "debt",
                        "liability"
                    ],
                    "common_phrases": [
                        "cash flow",
                        "cash cow",
                        "cash strapped",
                        "cash crop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ликвидные активы или деньги, которые можно быстро использовать, в отличие от инвестированных активов.",
                        "zh": "流动资产或可快速使用的资金，区别于投资资产。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "де́нежные сре́дства",
                                "target_lang_sense_clarification": "финансы"
                            },
                            {
                                "target_lang_word": "нали́чность",
                                "target_lang_sense_clarification": "свободные средства"
                            },
                            {
                                "target_lang_word": "кэш",
                                "target_lang_sense_clarification": "бизнес-сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "资金",
                                "target_lang_sense_clarification": "财务"
                            },
                            {
                                "target_lang_word": "流动资金",
                                "target_lang_sense_clarification": "金融"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b5b4d82-e342-31d1-bfed-10d040417f8f",
                    "sense_definition": "A cash register, or the counter in a business where payments are made.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please take your items to the <w>cash</w> to pay for them.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, пройдите с товарами на <w>кассу</w> для оплаты.",
                                "zh": "请把商品拿到<w>收银台</w>结账。"
                            }
                        },
                        {
                            "text": "There was a long line at the <w>cash</w>, so we decided to wait.",
                            "target_lang_translations": {
                                "ru": "На <w>кассе</w> была длинная очередь, поэтому мы решили подождать.",
                                "zh": "<w>收银台</w>排着长队，所以我们决定等一会儿。"
                            }
                        }
                    ],
                    "synonyms": [
                        "checkout",
                        "counter",
                        "register",
                        "till"
                    ],
                    "common_phrases": [
                        "at the cash"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in North American English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кассовый аппарат или прилавок в магазине, где производится оплата.",
                        "zh": "收银机或商业场所中进行付款的柜台。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ка́сса",
                                "target_lang_sense_clarification": "место оплаты"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "收银台",
                                "target_lang_sense_clarification": "地点"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "80bd0778-4b5f-3845-abac-96eb94497ab7",
                    "sense_definition": "To exchange a check or financial instrument for money in the form of notes or bills.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "money_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He went to the bank to <w>cash</w> his weekly paycheck.",
                            "target_lang_translations": {
                                "ru": "Он пошел в банк, чтобы <w>обналичить</w> свой еженедельный чек.",
                                "zh": "他去银行把每周的工资支票<w>兑现</w>了。"
                            }
                        },
                        {
                            "text": "You can <w>cash</w> these traveler's checks at any major hotel.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>обналичить</w> эти дорожные чеки в любом крупном отеле.",
                                "zh": "你可以在任何一家大型酒店<w>兑现</w>这些旅行支票。"
                            }
                        }
                    ],
                    "synonyms": [
                        "exchange",
                        "redeem"
                    ],
                    "common_phrases": [
                        "cash a check",
                        "cash in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обменивать чек или финансовый инструмент на наличные деньги.",
                        "zh": "将支票或金融票据兑换成纸币或硬币。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обнали́чить",
                                "target_lang_sense_clarification": "получить деньги"
                            },
                            {
                                "target_lang_word": "обнали́чивать",
                                "target_lang_sense_clarification": "процесс обмена"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "兑现",
                                "target_lang_sense_clarification": "获取现金"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "71cf70c0-5840-3c6c-a416-3d2302dc386a",
                    "sense_definition": "A surname originating as an occupation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name_group",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Johnny <w>Cash</w> was a famous American singer and songwriter.",
                            "target_lang_translations": {
                                "ru": "Джонни <w>Кэш</w> был известным американским певцом и автором песен.",
                                "zh": "约翰尼·<w>卡什</w>是一位著名的美国歌手和词曲作者。"
                            }
                        },
                        {
                            "text": "We met Mr. <w>Cash</w> at the conference last week.",
                            "target_lang_translations": {
                                "ru": "Мы встретили мистера <w>Кэша</w> на конференции на прошлой неделе.",
                                "zh": "我们上周在会议上见到了<w>卡什</w>先生。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия, происходящая от названия профессии.",
                        "zh": "源于职业的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Кэш",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卡什",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "933c7426-7e48-3369-998d-39158d4f024a",
                    "sense_definition": "A male given name transferred from the surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name_group",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "They decided to name their newborn son <w>Cash</w>.",
                            "target_lang_translations": {
                                "ru": "Они решили назвать своего новорожденного сына <w>Кэш</w>.",
                                "zh": "他们决定给刚出生的儿子取名为<w>卡什</w>。"
                            }
                        },
                        {
                            "text": "<w>Cash</w> is becoming a more popular name for boys in recent years.",
                            "target_lang_translations": {
                                "ru": "Имя <w>Кэш</w> становится все более популярным для мальчиков в последние годы.",
                                "zh": "近年来，<w>卡什</w>作为男孩的名字越来越受欢迎。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское имя, перешедшее от фамилии.",
                        "zh": "源自姓氏的男性名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Кэш",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卡什",
                                "target_lang_sense_clarification": "名字"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c5acd9e-3018-3ba1-abb5-5ab654735279",
                    "sense_definition": "A number of places in the United States, such as a city in Arkansas or communities in Georgia and Texas.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "He grew up in a small town called <w>Cash</w> in Arkansas.",
                            "target_lang_translations": {
                                "ru": "Он вырос в маленьком городке под названием <w>Кэш</w> в Арканзасе.",
                                "zh": "他在阿肯色州一个叫<w>卡什</w>的小镇长大。"
                            }
                        },
                        {
                            "text": "The road trip took us through the community of <w>Cash</w>.",
                            "target_lang_translations": {
                                "ru": "Наше автопутешествие проходило через поселение <w>Кэш</w>.",
                                "zh": "我们的公路旅行经过了<w>卡什</w>社区。"
                            }
                        }
