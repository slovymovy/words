                        "sense_id": "0aa0c0fb-5540-3db2-8a4a-699eae372c72",
                        "entry_id": "4465d8d6-a157-3e0f-a3e6-9abe1cf483df",
                        "glosses": [
                            "Operation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c309d644-0ebf-4fd6-bd83-068c5586896f",
                                "sense_id": "0aa0c0fb-5540-3db2-8a4a-699eae372c72",
                                "text": "Morgen um 14:30 ist Ihre OP."
                            },
                            {
                                "example_id": "c1bc2e72-e2ff-44d8-9a79-184bb1bb8303",
                                "sense_id": "0aa0c0fb-5540-3db2-8a4a-699eae372c72",
                                "text": "„Die Äther-Narkose beschädigte außerdem seinen Herzmuskel - doch das Schlimmste für die Eltern war, dass die OP zweihundert Reichsmark kostete.“"
                            },
                            {
                                "example_id": "d9f8ca21-c3e7-45a2-ab5f-231217263837",
                                "sense_id": "0aa0c0fb-5540-3db2-8a4a-699eae372c72",
                                "text": "„Tatsächlich verlor der Patient bei der OP viel Blut, und seine Laborwerte sanken lebensgefährlich tief ab.“"
                            }
                        ],
                        "sense_index_json": "\"7\""
                    },
                    {
                        "sense_id": "1a03ce36-c679-32af-a216-365e9d4f7b08",
                        "entry_id": "4465d8d6-a157-3e0f-a3e6-9abe1cf483df",
                        "glosses": [
                            "Operationssaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0037ac60-6302-4d61-ae64-c37d04043414",
                                "sense_id": "1a03ce36-c679-32af-a216-365e9d4f7b08",
                                "text": "Der Patient muss sofort in den OP."
                            },
                            {
                                "example_id": "8e9f7cf3-b97b-498d-a3d6-0452e894796b",
                                "sense_id": "1a03ce36-c679-32af-a216-365e9d4f7b08",
                                "text": "„Der Putzmann hat schon viele seltsame Dinge im Herz Jesu erlebt: die Geburt von Fünflingen zum Beispiel oder einen Boxkampf zwischen zwei Ärzten im OP, weil sie sich nicht einigen konnten, wer die Schere in dem Patienten vergessen hatte, bevor sie ihn zunähten.“"
                            }
                        ],
                        "sense_index_json": "\"8\""
                    },
