                "senses": [
                    {
                        "sense_id": "0ba265d2-fe02-3159-94f1-ade7e7a6cd9d",
                        "entry_id": "e97254ed-9e04-37e2-a5df-e230685556b7",
                        "glosses": [
                            "Studium im Fach der Zahnmedizin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b81be015-5759-444b-a761-fa4063fc358b",
                                "sense_id": "0ba265d2-fe02-3159-94f1-ade7e7a6cd9d",
                                "text": "„Ein Zahnmedizinstudium hat er abgeschlossen, aber es zog ihn immer in die Wüste.“"
                            },
                            {
                                "example_id": "bf043212-813e-4d5d-8e54-8bd831c822c4",
                                "sense_id": "0ba265d2-fe02-3159-94f1-ade7e7a6cd9d",
                                "text": "„Warum haben Sie sich gerade für ein Zahnmedizinstudium entschieden? Das ist schwer zu beantworten. Ich habe mich dem medizinischen Beruf immer sehr hingezogen gefühlt. Das war schon in der Schulzeit so.“"
                            },
                            {
                                "example_id": "0fed6365-1cdc-4736-bbd8-81ecba9cd6d0",
                                "sense_id": "0ba265d2-fe02-3159-94f1-ade7e7a6cd9d",
                                "text": "„Sie war mitten im Zahnmedizinstudium in Leipzig und ich überredete sie zu einer Motorradfahrt nach Thüringen.“"
                            },
                            {
                                "example_id": "da45b2d4-988a-4be9-9611-19531978a432",
                                "sense_id": "0ba265d2-fe02-3159-94f1-ade7e7a6cd9d",
                                "text": "„Gehören Sie zu der Generation von Ärzten, die zu einer Zeit das Medizin- oder Zahnmedizinstudium abgeschlossen haben, zu der ein Vertrag als Kassenarzt noch als sichere Einkommensquelle galt, die neben einem guten Einkommen einen wohlverdienten Ruhestand nahezu garantierte?“"
                            }
                        ],
