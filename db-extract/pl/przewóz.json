                                        ]
                                    },
                                    {
                                        "sense_id": "84077261-c22f-36dd-bbbd-165a185b1f2b",
                                        "entry_id": "b3766fc1-0e19-381e-801e-8e2be8f34e99",
                                        "glosses": [
                                            "The state of being transported by emotion; rapture."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19e29a8d-edc6-46a7-9e85-59852de0601d",
                                                "sense_id": "84077261-c22f-36dd-bbbd-165a185b1f2b",
