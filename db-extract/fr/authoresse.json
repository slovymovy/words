                            {
                                "example_id": "81632df4-314c-4cd3-a3d1-67aeb8c61c12",
                                "sense_id": "d42fdefa-bb85-365c-b132-cfb6d401db99",
                                "text": "L’authoresse anglaise hésite, indique à peine la très belle scène qu’elle a trouvée."
                            },
                            {
                                "example_id": "cac3aa99-84e2-4553-bafc-d4bce729c969",
                                "sense_id": "d42fdefa-bb85-365c-b132-cfb6d401db99",
                                "text": "Actrice-authoresse, elle se fabrique des saynètes monologues à un personnage ou à plusieurs personnages successifs, qu’elle interprète elle-même"
                            },
                            {
                                "example_id": "bb67aaf8-e1f8-4a13-87bd-56ad48c51cf9",
                                "sense_id": "d42fdefa-bb85-365c-b132-cfb6d401db99",
                                "text": "Elle sera pendant vingt ans ([…]) la spécialiste du mystère sexuel, l’authoresse émancipée revendiquant dans un monde décadent son statut ambidextre et faisandé."
                            }
                        ]
                    }
