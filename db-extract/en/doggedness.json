                "translations": [
                    {
                        "translation_id": "1d44f702-5d1f-43b0-be3c-bdc40b82260e",
                        "source_entry_id": "6eb7338e-17f0-3382-9ba4-3b99745bd023",
                        "source_sense_description": "persistence, perseverance, tenacity",
                        "target_lang_word": "Beharrlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beharrlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "97b52fa8-a3f5-3891-a659-8c9da870a40e",
                                        "entry_id": "f5294214-34d0-39d3-844a-b878fc8dd308",
                                        "glosses": [
                                            "Beharrlichsein; Eigenschaft, beharrlich zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bea4c4ba-58e5-4086-9267-914c6c74dc02",
                                                "sense_id": "97b52fa8-a3f5-3891-a659-8c9da870a40e",
                                                "text": "Er hatte mit immenser Beharrlichkeit dafür gekämpft, dass die Krankenkasse die Behandlungskosten seiner Tochter übernahm."
                                            },
                                            {
                                                "example_id": "d4881214-0277-429c-8fb2-1263acbad922",
                                                "sense_id": "97b52fa8-a3f5-3891-a659-8c9da870a40e",
                                                "text": "„Lebensweltlichen Gewissheiten haftet eine Beharrlichkeit an, die sich als Wahrung des Humanen zu erweisen vermag.“"
                                            },
                                            {
                                                "example_id": "f4f1f936-74d1-4d52-9771-aa9ee240921c",
                                                "sense_id": "97b52fa8-a3f5-3891-a659-8c9da870a40e",
                                                "text": "„Er sah in ihm einen sehr scharf und klar denkenden Verstandesmenschen, der die Macht, zu der ihn seine Energie und seine Beharrlichkeit hatten gelangen lssen, lediglich zum Wohle Russlands benutzte.“"
                                            },
                                            {
                                                "example_id": "b9291546-2cf5-4ab1-be60-33d294175422",
                                                "sense_id": "97b52fa8-a3f5-3891-a659-8c9da870a40e",
                                                "text": "„Diese höchst beleidigende Beharrlichkeit erschien mir ungeheuerlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b1902b2-1bc8-4a80-a7dd-45558a74cb00",
                        "source_entry_id": "6eb7338e-17f0-3382-9ba4-3b99745bd023",
                        "source_sense_description": "persistence, perseverance, tenacity",
                        "target_lang_word": "Hartnäckigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hartnäckigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59abfa8c-d037-389e-9c2a-f54ebf57d977",
                                        "entry_id": "9d1c52b8-f6a1-3cc6-a48b-0b2d11674d60",
                                        "glosses": [
                                            "Haltung, ein bestimmtes Ziel andauernd/unbeirrt zu verfolgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4a53661-cb1c-4e6a-8f42-e5c3805daec5",
                                                "sense_id": "59abfa8c-d037-389e-9c2a-f54ebf57d977",
                                                "text": "„Mit der Hartnäckigkeit der Viersenerinnen hatte die Reichsstelle für Obst und Gemüse aber nicht gerechnet, denn die Damen fuhren trotzdem und wirkten wohl sehr überzeugend.“"
                                            },
                                            {
                                                "example_id": "9debb7b4-283c-4ff8-b203-587400764819",
                                                "sense_id": "59abfa8c-d037-389e-9c2a-f54ebf57d977",
                                                "text": "„Und ja, Sie merken es sicher, ich war neidisch auf die Hartnäckigkeit dieser deutschen Frauen, die es geschafft hatten, sich eine neue Heimat zu schaffen.“"
                                            },
                                            {
                                                "example_id": "b4c7f1e0-8e3f-4715-ad23-451f655d4e5b",
                                                "sense_id": "59abfa8c-d037-389e-9c2a-f54ebf57d977",
                                                "text": "„Es war mehr die reizbare Hartnäckigkeit eines kranken Genies, die er herausschrie, herauszischte.“"
                                            },
                                            {
                                                "example_id": "4f751ac6-5c13-4754-ae7c-2a8032e998e8",
                                                "sense_id": "59abfa8c-d037-389e-9c2a-f54ebf57d977",
                                                "text": "„Seine Unbeugsamkeit und Hartnäckigkeit waren zum Sprichworte geworden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be9df7f5-8b5c-4e41-b3c8-1ac36813d002",
                        "source_entry_id": "6eb7338e-17f0-3382-9ba4-3b99745bd023",
                        "source_sense_description": "persistence, perseverance, tenacity",
                        "target_lang_word": "Zähigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zähigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0cd93167-3f61-3477-94a3-069d1259c322",
                                        "entry_id": "d58313cd-2838-3f72-b330-684c1dfb616e",
                                        "glosses": [
                                            "Eigenschaft, zäh zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69b73a00-3d4d-4aa8-b609-d898e08faa78",
                                                "sense_id": "0cd93167-3f61-3477-94a3-069d1259c322",
                                                "text": "„Nicht ohne einen gewissen Respekt für ihre Zähigkeit ließen sie Henni von nun an in Ruhe.“"
                                            },
                                            {
                                                "example_id": "07be6425-1e63-4fb2-a9b5-14e6bdaa1cc2",
                                                "sense_id": "0cd93167-3f61-3477-94a3-069d1259c322",
                                                "text": "„Er hatte jene Zähigkeit in praktischen Dingen, die Pierre fehlte, im höchsten Grade, und diese Eigenschaft setzte ihn in den Stand, eine Sache in Gang zu bringen, ohne dass es erst weitausholender Vorbereitungen und übertriebener Anstrengungen bedurfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b028e78-cdca-46c8-8930-a71aabe70a27",
                        "source_entry_id": "6eb7338e-17f0-3382-9ba4-3b99745bd023",
                        "source_sense_description": "persistence, perseverance, tenacity",
                        "target_lang_word": "упо́рство",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "упо́рство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "79650b0b-adb1-3ebc-a296-1069417c1c14",
                                        "entry_id": "5b093e36-3530-3c82-831e-a87941c9d17b",
                                        "glosses": [
                                            "свойство по значению прилагательного упорный; настойчивое, упорное стремление к чему-либо, к осуществлению чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a085325-cb94-45dd-9d99-79c3495dfd1d",
                                                "sense_id": "79650b0b-adb1-3ebc-a296-1069417c1c14",
                                                "text": "Гордость, дерзость, упорство, восторженность еретика имеют только вид энергии, в сущности они ― немощь, нуждающаяся в благоразумном соболезновании."
                                            },
                                            {
                                                "example_id": "2fe32ad0-1fe0-412b-a6e6-f477af016c26",
                                                "sense_id": "79650b0b-adb1-3ebc-a296-1069417c1c14",
                                                "text": "Конечно, было сопротивление, было мужество и упорство обречённых, были восстания, была самопожертвенность, когда для спасения далёкого, незнакомого человека другой человек рисковал своей жизнью и жизнью своей семьи."
                                            },
                                            {
                                                "example_id": "45eae1e9-907e-4abc-8534-f5a054af273e",
                                                "sense_id": "79650b0b-adb1-3ebc-a296-1069417c1c14",
                                                "text": "Мне кажется, что упорство наше в Сталинграде ― это упорство Ньютона, упорство Эйнштейна, что победа на Волге знаменует торжество идей Эйнштейна, словом, понимаете, вот такое чувство."
                                            },
                                            {
                                                "example_id": "54c56bfe-ea93-4ec4-ae51-732fcc7dfe94",
                                                "sense_id": "79650b0b-adb1-3ebc-a296-1069417c1c14",
                                                "text": "В его беспрерывной развязной болтовне и в глазах, жадных и просящих, была незащищённость, что-то детское, недоразвитое и какое-то упорство, обречённое на провал."
                                            },
                                            {
                                                "example_id": "e759de08-bf57-4371-92af-9d44b6536a67",
                                                "sense_id": "79650b0b-adb1-3ebc-a296-1069417c1c14",
                                                "text": "Знали, что в двух шагах под холодным брезентом торжествуют отвага и удаль. Безграничная нежность южанина и упорство гвардейца… Наутро Рябчук оторвал доски и вышел, шатаясь, бледный и слабый."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
