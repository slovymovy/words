                    {
                        "sense_id": "20116451-61eb-3dfd-a166-46db2b956cf1",
                        "entry_id": "833f9691-b88f-3e57-bc36-df91f4fef918",
                        "glosses": [
                            "Patriotische Europäer gegen die Islamisierung des Abendlandes"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "40bf8b4e-8334-41ef-bae6-26a7d99574d7",
                                "sense_id": "20116451-61eb-3dfd-a166-46db2b956cf1",
                                "text": "„Die Homogenität des deutschen Volks oder der deutschen Nation, der sich die AfD oder PEGIDA verpflichtet fühlen, gibt es nicht.“"
                            },
                            {
                                "example_id": "2ecf4465-6671-4345-9c9b-e7385d667a9f",
                                "sense_id": "20116451-61eb-3dfd-a166-46db2b956cf1",
                                "text": "„Die Abneigung gegen eine heterogene Gesellschaft, ein Volk aus freien und gleichen Staatsbürgerinnen und Staatsbürgern, die sich ein Grundgesetz und eine demokratische Praxis teilen, artikulieren nicht nur die politischen Akteure von PEGIDA oder der AfD.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
