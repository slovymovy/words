                                        "entry_id": "b5e47870-4ed8-3c39-9387-0cd762035fc9",
                                        "glosses": [
                                            "aus fermentiertem Gemüse bestehendes Gericht der koreanischen Küche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
