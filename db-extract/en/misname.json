                ],
                "senses": [
                    {
                        "sense_id": "052a28ef-4359-3854-85e4-082a1acbc51a",
                        "entry_id": "f3a26259-54ed-3525-8048-7b2f8be9d46b",
                        "glosses": [
                            "To call by a wrong name."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9bb2c0ab-03af-43be-bb6f-ce1cfc3b6184",
                                "sense_id": "052a28ef-4359-3854-85e4-082a1acbc51a",
                                "text": "Misnamed (and misgendered) was Patricia Glass Schuman, of Neal-Schuman Publishers."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f5a6acc-a506-35f9-a20e-270cdc53d276",
                        "entry_id": "f3a26259-54ed-3525-8048-7b2f8be9d46b",
                        "glosses": [
                            "To give an unsuitable or injurious name to; name incorrectly."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "abc6ed25-24d5-4e5c-9659-c4e4ba0e57d2",
                                "sense_id": "2f5a6acc-a506-35f9-a20e-270cdc53d276",
                                "text": "Near-synonym: misnomer"
                            },
                            {
                                "example_id": "ebd209be-b184-46c9-8fb0-f64bb177fa3a",
                                "sense_id": "2f5a6acc-a506-35f9-a20e-270cdc53d276",
                                "text": "Elsewhere is pain in looking back on the blotted page misnamed Experience."
                            },
                            {
                                "example_id": "f82a4d95-3f60-4713-ac95-9a4c69ee73d4",
                                "sense_id": "2f5a6acc-a506-35f9-a20e-270cdc53d276",
                                "text": "The Intelligence Office proved to be as much misnamed as those institutions usually are, and varying degrees of unintelligence were shown in the candidates offered for the position of cook at Boxley Hall; […]"
                            }
                        ]
                    }
                ],
