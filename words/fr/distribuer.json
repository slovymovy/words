                        "distribuer des amendes"
                    ]
                },
                {
                    "sense_id": "4b7df642-223d-3d96-892c-3236a370e45b",
                    "sense_definition": "Replacer dans leurs cassetins les caractères d'imprimerie mobiles qui ont servi à la composition.",
