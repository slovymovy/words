                                        "glosses": [
                                            "de avond voor kerst op 24 december"
                                        ],
                                        "tags": [
                                            "kerst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd7f7a31-9aa0-4276-afb5-a673767e0c01",
                                                "sense_id": "c921d700-8798-3c85-894c-27ab3a039abe",
                                                "text": "Op kerstavond komen er vrienden bij ons eten."
                                            },
                                            {
                                                "example_id": "08726373-b2fe-4dc0-90b1-ffdacff92a0c",
                                                "sense_id": "c921d700-8798-3c85-894c-27ab3a039abe",
                                                "text": "Het is natuurlijk een zonde om op kerstavond te applaudisseren, gelukkig dat ik niet de moraal van mijn grootmoeder heb geërfd."
                                            }
                                        ]
