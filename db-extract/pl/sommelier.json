                                        "sense_id": "25c0ae17-f44b-33f3-a17d-6bd8fc61d2fd",
                                        "entry_id": "168577d3-eeec-3218-bacf-dc05b18e2ba1",
                                        "glosses": [
                                            "Maître artisan qui fabrique des sommiers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
