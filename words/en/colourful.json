            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1242c24c-f507-3a06-821f-90f53020a0ee",
                    "sense_definition": "Having many bright colors; full of variety and interest.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden was filled with <w>colourful</w> flowers that attracted many butterflies.",
                            "target_lang_translations": {
                                "ru": "Сад был полон <w>ярких</w> цветов, которые привлекали множество бабочек."
                            }
                        },
                        {
                            "text": "She wore a <w>colourful</w> dress to the summer party.",
                            "target_lang_translations": {
                                "ru": "На летнюю вечеринку она надела <w>разноцветное</w> платье."
                            }
                        }
                    ],
                    "synonyms": [
                        "vibrant",
                        "bright",
                        "multicoloured"
                    ],
                    "antonyms": [
                        "colourless",
                        "drab",
                        "plain"
                    ],
                    "common_phrases": [
                        "colourful"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Включающий грубые или оскорбительные слова, особенно нецензурную лексику."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крепкий",
                                "target_lang_sense_clarification": "о выражениях или языке"
                            },
                            {
                                "target_lang_word": "сочный",
                                "target_lang_sense_clarification": "о выразительной, часто грубой речи"
                            },
                            {
                                "target_lang_word": "нецензурный",
                                "target_lang_sense_clarification": "содержащий брань"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1242c24c-f507-3a06-821f-90f53020a0ee",
                    "sense_definition": "Interesting, exciting, or full of variety, often in a way that is slightly unconventional.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The retired sailor told many <w>colourful</w> stories about his time at sea.",
                            "target_lang_translations": {
                                "ru": "Моряк в отставке рассказывал много <w>колоритных</w> историй о своем времени в море."
                            }
                        },
                        {
                            "text": "He is known as one of the most <w>colourful</w> characters in the local community.",
                            "target_lang_translations": {
                                "ru": "Он известен как один из самых <w>ярких</w> персонажей в местном сообществе."
                            }
                        }
                    ],
                    "synonyms": [
                        "vivid",
                        "picturesque",
                        "fascinating"
                    ],
