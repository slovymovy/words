                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "15c17022-aba6-39c7-a5b4-23f049c11ff7",
                                        "entry_id": "dac722fd-9c4d-3341-b46c-5e3f3d55f263",
