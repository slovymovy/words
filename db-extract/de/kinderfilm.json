                        "examples": [
                            {
                                "example_id": "4ab651d5-100a-470d-a9ab-32aebee338e2",
                                "sense_id": "b69b0e3a-e9c7-3215-93dc-8efa710d1cf1",
                                "text": "\"Pippi Langstrumpf\" ist ein Kinderfilm."
                            },
                            {
                                "example_id": "4b07b0f5-5bf0-492b-b72c-f885620b5443",
                                "sense_id": "b69b0e3a-e9c7-3215-93dc-8efa710d1cf1",
                                "text": "Die Kinderfilme finden Sie im Regal oben rechts."
                            },
                            {
                                "example_id": "71a4df72-358b-48a8-bb0f-1c09f7e985ad",
                                "sense_id": "b69b0e3a-e9c7-3215-93dc-8efa710d1cf1",
                                "text": "Wir haben uns unterhalten und es ging um den Kinderfilm, den wir gestern gesehen haben."
                            },
                            {
                                "example_id": "fd36c7f8-d3a0-444d-bbf3-c3f08cf667a5",
                                "sense_id": "b69b0e3a-e9c7-3215-93dc-8efa710d1cf1",
                                "text": "In dem Kinderfilm spielt David Bowie einen Koboldkönig."
                            }
                        ],
