        "fr-extract.jsonl": [
            {
                "entry_id": "7e1cdcde-1d27-3277-aff1-ec99c01739b7",
                "word": "Fanchon",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "05601ba7-4fc1-3400-8cbe-c1786f59dd08",
                        "entry_id": "7e1cdcde-1d27-3277-aff1-ec99c01739b7",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc701f53-bf0f-423d-a177-9e8e174a89f1",
                                "sense_id": "05601ba7-4fc1-3400-8cbe-c1786f59dd08",
                                "text": "Parfois dénommée \"Chant des Marie-Louise\", l'aimable Fanchon est une chanson de garnison communément attribuée à Antoine-Charles-Louis, comte de Lasalle (10 mai 1775 - 6 juillet 1809), officier du premier Empire, fondateur de la Société des Assoiffés (ou des Altérés), qui l'aurait composée au soir de la bataille de Marengo, le 25 prairial an VIII (14 juin 1800)."
                            },
                            {
                                "example_id": "e954c2e0-61be-4100-8a3a-a6771fc43bc8",
                                "sense_id": "05601ba7-4fc1-3400-8cbe-c1786f59dd08",
                                "text": "... vous citez au lieu d’observer, et c’est à l’aide d’un vers d’Horace que vous nous dites le caractère de Fanchon. Horace ne connaissait point Fanchon, et Fanchon ne connaît pas Horace."
                            },
                            {
                                "example_id": "f69aac89-f31f-4dba-97f3-b0a4cbd2a2b5",
                                "sense_id": "05601ba7-4fc1-3400-8cbe-c1786f59dd08",
                                "text": "Le dispositif narratif dominant dans les romans pornographiques du XVIIᵉ siècle est le dialogue entre deux femmes, qui sont parfois des nonnes, l’une généralement plus initiée aux choses du sexe que l’autre. Ainsi, dans le premier dialogue de L’École des filles, on voit Suzanne en train d’instruire Fanchon sur les choses de l’amour afin qu’elle se prépare à recevoir M. Robinet ; dans le second dialogue, Fanchon rend compte à Suzanne de ses rencontres amoureuses, et Suzanne parfait son éducation sur tout ce qui touche de près ou de loin au sexe."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b5ebb790-7501-3f94-a58c-77d73637a9e9",
                "word": "fanchon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7f322e17-1992-4390-89e5-371d7a61f060",
                        "entry_id": "b5ebb790-7501-3f94-a58c-77d73637a9e9",
                        "tags": [
                            "plural"
                        ],
                        "form": "fanchons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dda2d19e-844d-3998-b31d-126027d684bd",
                        "entry_id": "b5ebb790-7501-3f94-a58c-77d73637a9e9",
                        "glosses": [
                            "Petit fichu que les femmes portent sur la tête et nouent sous le menton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c68614f6-e98d-427b-88a8-4e8bd14c4552",
                                "sense_id": "dda2d19e-844d-3998-b31d-126027d684bd",
                                "text": "Elle tenait à la main un bouquet de catleyas et Swann vit, sous sa fanchon de dentelle, qu’elle avait dans les cheveux des fleurs de cette même orchidée attachées à une aigrette en plumes de cygne."
                            },
                            {
                                "example_id": "01d8dbef-585e-4c97-88af-54538f2f5a9d",
                                "sense_id": "dda2d19e-844d-3998-b31d-126027d684bd",
                                "text": "C’était aussi la gorge de son ennemie qu’elle voyait, entre les pointes du fichu à la Fanchon, noué assez bas, de Galswinthe."
                            },
                            {
                                "example_id": "173b8248-3cca-490b-bb50-7eef0a0c2abb",
                                "sense_id": "dda2d19e-844d-3998-b31d-126027d684bd",
                                "text": "Nous regardons, hébétés, faire Nathalie qui rattache le menton, noue le mouchoir autour de la tête encore souple : on dirait que Maman a mal aux dents, qu’elle se laisse docilement mettre une fanchon."
                            },
                            {
                                "example_id": "2d391c64-fa75-49a5-80e2-34ed41979215",
                                "sense_id": "dda2d19e-844d-3998-b31d-126027d684bd",
                                "text": "Une femme sans âge aux cheveux empaquetés dans une fanchon faite avec un mouchoir à carreaux examinait l’instituteur en clignant des paupières."
                            },
                            {
                                "example_id": "b6776c59-4368-41bc-83a5-093920cfeb9e",
                                "sense_id": "dda2d19e-844d-3998-b31d-126027d684bd",
                                "text": "Une de ses filles, Dora - à moins que ce ne fût Mildred - apercevant l'Administrateur, rajusta sa fanchon à fleurs, remonta ses bas de laine blanche sous la jupe longue."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
