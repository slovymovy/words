                                "target_senses": [
                                    {
                                        "sense_id": "5d0152ce-1dd4-3dd1-883c-49f12658da6d",
                                        "entry_id": "ee8fd932-0507-3508-83d9-7662b11b3f55",
                                        "glosses": [
                                            "To pierce; now generally replaced by transfix."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4fa9f766-f122-3dad-a093-765d281cd892",
                                        "entry_id": "ee8fd932-0507-3508-83d9-7662b11b3f55",
                                        "glosses": [
                                            "To pierce; now generally replaced by transfix.",
                                            "(Of a piercing look) to direct at someone."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b951a4c-7fb7-499a-9f4e-adc2356f262a",
                                                "sense_id": "4fa9f766-f122-3dad-a093-765d281cd892",
                                                "text": "He fixed me with a sickly grin, and said, \"I told you it wouldn't work!\""
                                            },
                                            {
                                                "example_id": "48786e6f-f367-47ed-9163-cf7d984c07bd",
                                                "sense_id": "4fa9f766-f122-3dad-a093-765d281cd892",
                                                "text": "She sniffed, too, comprehendingly, and fixed her son with a relentless eye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce30bb8d-8602-3143-876b-959578ce0c94",
                                        "entry_id": "ee8fd932-0507-3508-83d9-7662b11b3f55",
                                        "glosses": [
                                            "To attach; to affix; to hold in place or at a particular time."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07412843-90b3-4e48-ab59-138e1bb30818",
                                                "sense_id": "ce30bb8d-8602-3143-876b-959578ce0c94",
                                                "text": "A dab of chewing gum will fix your note to the bulletin board."
                                            },
                                            {
                                                "example_id": "a4461f3f-5ada-4a73-8c5e-f7af2b0aa4b8",
                                                "sense_id": "ce30bb8d-8602-3143-876b-959578ce0c94",
                                                "text": "A leech can fix itself to your skin without you feeling it."
                                            },
                                            {
                                                "example_id": "da8da24b-7a5e-4842-83f5-4c8f12fbd7aa",
                                                "sense_id": "ce30bb8d-8602-3143-876b-959578ce0c94",
                                                "text": "The Constitution fixes the date when Congress must meet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab444369-2691-3dd7-879a-cb63772c6d22",
                                        "entry_id": "ee8fd932-0507-3508-83d9-7662b11b3f55",
                                        "glosses": [
                                            "To attach; to affix; to hold in place or at a particular time.",
                                            "To focus or determine (oneself, on a concept); to fixate."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "passive",
                                            "transitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66103856-a252-43a8-a51f-bc6217be7003",
                                                "sense_id": "ab444369-2691-3dd7-879a-cb63772c6d22",
                                                "text": "She's fixed on the idea of becoming a doctor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7d8b752-b6b8-33a7-9507-01d01833be95",
                                        "entry_id": "ee8fd932-0507-3508-83d9-7662b11b3f55",
                                        "glosses": [
                                            "To attach; to affix; to hold in place or at a particular time.",
                                            "To prevent enemy pawns from advancing by directly opposing the most advanced one with one of one's own pawns so as to threaten to capture any advancing backward pawns."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9b0dff38-0aea-3384-9cf4-743fe76e4322",
                                        "entry_id": "ee8fd932-0507-3508-83d9-7662b11b3f55",
                                        "glosses": [
                                            "To attach; to affix; to hold in place or at a particular time."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81eeb312-4ff5-4442-84b0-6ec230f479ad",
                                                "sense_id": "9b0dff38-0aea-3384-9cf4-743fe76e4322",
                                                "text": "The Democratic Party woke to shambles; many looked around to fix blame. A Hunt aide decided not enough Blacks had come out to vote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b1eeb27-409e-3b77-907c-70f50033183c",
                                        "entry_id": "ee8fd932-0507-3508-83d9-7662b11b3f55",
                                        "glosses": [
                                            "To mend, to repair."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "deac6e62-63d7-4991-be14-5ba64829200c",
                                                "sense_id": "5b1eeb27-409e-3b77-907c-70f50033183c",
                                                "text": "That heater will start a fire if you don't fix it."
                                            },
                                            {
                                                "example_id": "ea70dbdd-11ac-43d8-bd08-ebb7c49f341e",
                                                "sense_id": "5b1eeb27-409e-3b77-907c-70f50033183c",
                                                "text": "You can't fix stupid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43626d59-7aae-3a0b-8a50-53a641da671c",
                                        "entry_id": "ee8fd932-0507-3508-83d9-7662b11b3f55",
                                        "glosses": [
                                            "To prepare (food or drink)."
                                        ],
                                        "tags": [
                                            "ditransitive",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "add7486d-ad49-4a9c-9fe7-97648df2262b",
                                                "sense_id": "43626d59-7aae-3a0b-8a50-53a641da671c",
                                                "text": "She fixed dinner for the kids."
                                            },
                                            {
                                                "example_id": "ad839e98-7c81-48da-b342-c2331e434687",
                                                "sense_id": "43626d59-7aae-3a0b-8a50-53a641da671c",
                                                "text": "She fixed Peter a slice of black bread and jam by cutting the hard crust petalwise around the edge, so the child could tear off convenient pieces."
                                            },
                                            {
                                                "example_id": "bb0dbd8a-c3e2-44b3-bca1-b721d339f3dd",
                                                "sense_id": "43626d59-7aae-3a0b-8a50-53a641da671c",
                                                "text": "I fixed us drinks—orange juice with some vodka I'd gotten on sale—and washed a few dishes to get my mind off Jess and the fact of his not texting back."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "641e3d3f-8f05-365a-9b37-a4b5d3646740",
                                        "entry_id": "ee8fd932-0507-3508-83d9-7662b11b3f55",
                                        "glosses": [
                                            "To make (a contest, vote, or gamble) unfair; to privilege one contestant or a particular group of contestants, usually before the contest begins; to arrange immunity for defendants by tampering with the justice system via bribery or extortion."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4496412-9a6a-4826-80e5-8564d622c17b",
                                                "sense_id": "641e3d3f-8f05-365a-9b37-a4b5d3646740",
                                                "text": "A majority of voters believed the election was fixed in favor of the incumbent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37f9b6fb-3915-3edc-a55e-a860f24563fe",
                                        "entry_id": "ee8fd932-0507-3508-83d9-7662b11b3f55",
                                        "glosses": [
                                            "To surgically render an animal, especially a pet, infertile."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8604b4f1-4b80-4565-8e1e-30d6fe88e08d",
                                                "sense_id": "37f9b6fb-3915-3edc-a55e-a860f24563fe",
                                                "text": "Rover stopped digging under the fence after we had the vet fix him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8f342df-8fe3-3483-9a57-b4c4f8a111cd",
                                        "entry_id": "ee8fd932-0507-3508-83d9-7662b11b3f55",
                                        "glosses": [
                                            "To map (a point or subset) to itself."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "375771ce-9136-4c0a-8f8b-73ce635f0c92",
                                                "sense_id": "b8f342df-8fe3-3483-9a57-b4c4f8a111cd",
                                                "text": "The function f#58;#92;mathbb#123;R#125;#92;to#92;mathbb#123;R#125;#59;f(x)#58;#61;4x-3 fixes the point 1#92;in#92;mathbb#123;R#125;, since f(1)#61;4(1)-3#61;1."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "912ecbb6-f2a4-3828-923e-8c055abc1fca",
                                        "entry_id": "ee8fd932-0507-3508-83d9-7662b11b3f55",
                                        "glosses": [
                                            "To take revenge on, to best; to serve justice on an assumed miscreant."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09bd04f7-c39f-4158-bbf5-533cd2d80f84",
                                                "sense_id": "912ecbb6-f2a4-3828-923e-8c055abc1fca",
                                                "text": "He got caught breaking into lockers, so a couple of guys fixed him after work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "667afc3c-b5b4-382a-b0a7-9c73fe3ad613",
                                        "entry_id": "ee8fd932-0507-3508-83d9-7662b11b3f55",
                                        "glosses": [
                                            "To render (a photographic impression) permanent by treating with such applications as will make it insensitive to the action of light."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04114a93-d74d-36ba-a311-141f9f2b403d",
                                        "entry_id": "ee8fd932-0507-3508-83d9-7662b11b3f55",
                                        "glosses": [
                                            "To convert into a stable or available form."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37a8622f-f3a1-4525-a424-d65e5a3b5771",
                                                "sense_id": "04114a93-d74d-36ba-a311-141f9f2b403d",
                                                "text": "Legumes are valued in crop rotation for their ability to fix nitrogen."
                                            },
                                            {
                                                "example_id": "564b815e-a583-4e48-896d-8a8ed5b78dea",
                                                "sense_id": "04114a93-d74d-36ba-a311-141f9f2b403d",
                                                "text": "it is well to fix with sodium hyposulphite , and to wash as usual"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a50e67d6-fa8c-31f8-83df-f2dcaeccc663",
                                        "entry_id": "ee8fd932-0507-3508-83d9-7662b11b3f55",
                                        "glosses": [
                                            "To become fixed; to settle or remain permanently; to cease from wandering; to rest."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37c94a37-f079-4e9f-8687-e282c4e3790e",
                                                "sense_id": "a50e67d6-fa8c-31f8-83df-f2dcaeccc663",
                                                "text": "Accuſing ſome malignant Star,\nNot Britain, for that fateful War,\nYour kindneſs baniſhes your fear,\nReſolv’d to fix for ever here."
                                            },
                                            {
                                                "example_id": "857df95d-0157-4354-854a-cd38b2f013d1",
                                                "sense_id": "a50e67d6-fa8c-31f8-83df-f2dcaeccc663",
                                                "text": "A cheerless place! the solitary Bee,\nWhose buzzing was the only sound of life,\nFlew there on restless wing,\nSeeking in vain one blossom, where to fix."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59c36603-e571-3cad-9973-9749f2d2b935",
                                        "entry_id": "ee8fd932-0507-3508-83d9-7662b11b3f55",
                                        "glosses": [
                                            "To become firm, so as to resist volatilization; to cease to flow or be fluid; to congeal; to become hard and malleable, as a metallic substance."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d1b0333-0c07-4607-ac09-b7b934f0fdaf",
                                                "sense_id": "59c36603-e571-3cad-9973-9749f2d2b935",
                                                "text": "quicksilver will fix, so asto endure the hammer"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f1ec627-52dc-3e5c-9686-264d11fd035b",
                                        "entry_id": "ee8fd932-0507-3508-83d9-7662b11b3f55",
                                        "glosses": [
                                            "To shoot; to inject a drug."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a3f7c9b-858f-47de-b32b-a7b34bd807f6",
                                                "sense_id": "9f1ec627-52dc-3e5c-9686-264d11fd035b",
                                                "text": "She doesn't have to worry about stool pigeons because every law in the Federal District knows that Lupita sells junk. She keeps outfits in glasses of alcohol so the junkies can fix in the joint and walk out clean."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "578bb86c-5da5-3783-b887-99f0ce6f82a9",
