                "senses": [
                    {
                        "sense_id": "9cb0b80e-d556-34c7-becd-cc2fbb4bf004",
                        "entry_id": "b69af04a-3298-3a22-b611-f54b360793d2",
                        "glosses": [
                            "Enlever l'équipement domotique d’un endroit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fdd5842-4e9f-4c1b-807e-7161a03f3a6f",
                                "sense_id": "9cb0b80e-d556-34c7-becd-cc2fbb4bf004",
                                "text": "Au départ j’ai hésité à passer également par des relais histoire de rester sur du standard en cas de revente ou de besoin de « dédomotiser » mais le coût des TLR (je voulais rester en 1 pour 1) m'a fait finalement opter pour mon premier choix."
                            },
                            {
                                "example_id": "d662b1d6-95b4-4109-be6e-44672fd03c81",
                                "sense_id": "9cb0b80e-d556-34c7-becd-cc2fbb4bf004",
                                "text": "Rollback : pour “dédomotiser” il suffit de débrancher la partie domotique."
                            },
                            {
                                "example_id": "17d6d1a1-1166-44b8-859d-be746a5022a6",
                                "sense_id": "9cb0b80e-d556-34c7-becd-cc2fbb4bf004",
                                "text": "Dédomotiser un appartement, un temps non négligeable à prendre en compte"
                            }
                        ]
                    }
