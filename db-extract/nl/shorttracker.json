                        "examples": [
                            {
                                "example_id": "93264500-e73b-4c37-a665-033f936be461",
                                "sense_id": "ffe1a4f3-a8e5-360a-b20c-472ddfbfc390",
                                "text": "Sjinkie Knegt maakt vanavond al zijn rentree in het wedstrijdcircuit. De 30-jarige shorttracker komt bij de wereldbekerfinale in Dordrecht in actie in de kwartfinales van de relay voor mannen."
                            },
                            {
                                "example_id": "ad57ca6b-2183-4569-8847-6ce90fc08d3a",
                                "sense_id": "ffe1a4f3-a8e5-360a-b20c-472ddfbfc390",
                                "text": "Melle van 't Wout heeft voor het eerst in zijn loopbaan een wereldbekermedaille veroverd. De 19-jarige shorttracker hield in Dresden brons over aan zijn optreden op de 500 meter. Het goud was een prooi voor de Canadees Steven Dubois, voor Shaolin Sandor Liu uit Hongarije."
                            }
                        ]
