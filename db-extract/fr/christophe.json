                                            {
                                                "example_id": "ea02fa0f-8eda-4b19-9788-a3cd31d1bc6a",
                                                "sense_id": "8b1db642-8338-31e9-896e-eada36b8bc36",
                                                "text": "Miał na imię Krzysztof i był kierowcą z podkrakowskiej miejscowości."
                                            },
                                            {
                                                "example_id": "749138d6-ada0-4733-bb01-b5e3efec687a",
                                                "sense_id": "8b1db642-8338-31e9-896e-eada36b8bc36",
                                                "text": "W połowie lat osiemdziesiątych Krzysztof Kieślowski nakręcił „Krótki film o zabijaniu”"
                                            },
                                            {
                                                "example_id": "7f691784-0b69-4de4-bf8b-e770c789c0aa",
                                                "sense_id": "8b1db642-8338-31e9-896e-eada36b8bc36",
                                                "text": "W Kościele katolickim na 25 lipca przypada wspomnienie św. Krzysztofa, patrona kierowców i podróżnych."
                                            },
                                            {
