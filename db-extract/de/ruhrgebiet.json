                        ],
                        "form": "das Ruhrgebiet"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f22d1123-1a8b-3780-8870-770ef4e5edfe",
                        "entry_id": "27e9c763-276b-34fd-a9d7-2543a601cb11",
                        "glosses": [
                            "Ballungsraum in Nordrhein-Westfalen, Gebiet zwischen dem Kreis Wesel (mit Xanten) und Duisburg im Westen und Hamm, Hagen und Kreis Unna sowie dem Ennepe-Ruhr-Kreis im Osten. Das Gebiet umfasst die Flüsse Rhein, Lippe und Ruhr, mit etwa 5,3 Millionen Einwohnern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "492d9bac-696e-4c7f-8f4d-c1fc813bf460",
                                "sense_id": "f22d1123-1a8b-3780-8870-770ef4e5edfe",
                                "text": "Im Ruhrgebiet gibt es viele Museen und Universitäten."
                            },
                            {
                                "example_id": "4121a680-ae76-4337-b5c7-99703f0e0078",
                                "sense_id": "f22d1123-1a8b-3780-8870-770ef4e5edfe",
                                "text": "Die größte Stadt im Ruhrgebiet ist Dortmund."
                            },
                            {
                                "example_id": "4e5079fa-f06b-4121-be0d-7b6b3863fd8a",
                                "sense_id": "f22d1123-1a8b-3780-8870-770ef4e5edfe",
                                "text": "„Im Ruhrgebiet schmückten die Arbeiter die Tore der geretteten Fabriken mit Girlanden.“"
                            },
                            {
                                "example_id": "7a06fd6f-0b0b-42ba-a245-d73460d374d3",
                                "sense_id": "f22d1123-1a8b-3780-8870-770ef4e5edfe",
                                "text": "„Im Jahr 1943 erlebte das Ruhrgebiet die bis dahin schwersten Bombardierungen.“"
                            },
                            {
                                "example_id": "fd6a6b05-3948-40d3-8239-6446491b4797",
                                "sense_id": "f22d1123-1a8b-3780-8870-770ef4e5edfe",
                                "text": "„Außerdem ermahnte die Reichsregierung die Bevölkerung des Ruhrgebiets, ausschließlich mit friedlichen Mitteln Widerstand zu leisten.“"
                            },
                            {
                                "example_id": "f5496cda-0ee2-4846-9387-b4e3b30ea902",
                                "sense_id": "f22d1123-1a8b-3780-8870-770ef4e5edfe",
                                "text": "„In der Mitte aber kesselten die 9. und die 1. U.S. Army 350000 deutsche Soldaten im Ruhrgebiet ein.“"
                            },
                            {
                                "example_id": "0a0f65a1-d392-4a98-8738-3ccfcdec964e",
                                "sense_id": "f22d1123-1a8b-3780-8870-770ef4e5edfe",
                                "text": "[1923:] „Französische und belgische Truppen besetzten das Ruhrgebiet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
