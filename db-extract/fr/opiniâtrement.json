        "fr-extract.jsonl": [
            {
                "entry_id": "ebbe149e-8a60-3448-bf66-69c23d6eaf12",
                "word": "opiniâtrement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "38bf915c-c7f1-34be-a218-e60b4e6bcfb9",
                        "entry_id": "ebbe149e-8a60-3448-bf66-69c23d6eaf12",
                        "glosses": [
                            "D’une façon opiniâtre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de90aacb-078a-4d30-8b09-d9b3933f1932",
                                "sense_id": "38bf915c-c7f1-34be-a218-e60b4e6bcfb9",
                                "text": "Les amis mêmes de l’abbé Régnier lui avaient donné le nom de l’abbé Pertinax, parce qu’il avait, dit-on, l’habitude de disputer opiniâtrement dans les assemblées."
                            },
                            {
                                "example_id": "345c53d2-c4f7-44df-8322-00d244ac2060",
                                "sense_id": "38bf915c-c7f1-34be-a218-e60b4e6bcfb9",
                                "text": "Une envie folle le taraudait de piquer du poing dans le dos arrondi du monsieur peu pressé, lequel, pourvu d'une inconscience comique, bourlinguant de droite à gauche, s'installait opiniâtrement devant lui, pareil à une citadelle mouvante et calamiteuse."
                            },
                            {
                                "example_id": "28b3936f-bf37-4f36-8443-01dd68d192ef",
                                "sense_id": "38bf915c-c7f1-34be-a218-e60b4e6bcfb9",
                                "text": "Il réclamait opiniâtrement des revers à la mode, des boutons de fantaisie, des poches innombrables."
                            }
                        ]
                    },
                    {
                        "sense_id": "40a5b08b-9428-3385-b675-a43a8eff7047",
                        "entry_id": "ebbe149e-8a60-3448-bf66-69c23d6eaf12",
                        "glosses": [
                            "Sans céder ; sans se relâcher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f47289f-8d58-4651-8522-04c2cec725f6",
                                "sense_id": "40a5b08b-9428-3385-b675-a43a8eff7047",
                                "text": "La ferme Navarin, les buttes de Souain, du mont Muret, de Tahure et du Mesnil, les villages de Tahure, Ripont, Rouvroy, Cernay-en-Dormois, Servon-Melzicourt, organisés en points d'appui et opiniâtrement défendus par l'ennemi, ont été conquis de haute lutte dans la première journée de la bataille."
                            },
                            {
                                "example_id": "b040c469-c00d-4031-b275-067ef53ee903",
                                "sense_id": "40a5b08b-9428-3385-b675-a43a8eff7047",
                                "text": "Le renard mord dangereusement, opiniâtrement, et l’on est obligé de se servir d’un ferrement pour le faire démordre."
                            },
                            {
                                "example_id": "e4f57884-0d3c-4684-bdfa-d7db92856da2",
                                "sense_id": "40a5b08b-9428-3385-b675-a43a8eff7047",
                                "text": "Omitov, Michel et leurs compagnes avaient folâtré pour rejoindre à pied la route du bord de mer, à proximité de Talmont, où les pêcheurs tournés vers les flots ignoraient opiniâtrement les badauds venus jusque-là pour applaudir dans leur dos l’exceptionnel spectacle vélocipédique dont ils n’avaient que faire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f609a688-e0fa-4e0c-a001-970aa8364ed5",
                        "source_entry_id": "ebbe149e-8a60-3448-bf66-69c23d6eaf12",
                        "target_lang_word": "doggedly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doggedly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "566d22fa-0eba-397e-8b5b-fd30fd155a41",
                                        "entry_id": "61396804-290c-3f1e-944c-859b4d666f90",
                                        "glosses": [
                                            "In a way that is stubbornly persistent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3f10c33-6921-41d7-8494-2df1cd31fb9d",
                                                "sense_id": "566d22fa-0eba-397e-8b5b-fd30fd155a41",
                                                "text": "I grew moody, silent, and unsocial, but studied on doggedly and incessantly."
                                            },
                                            {
                                                "example_id": "1fdaa2dc-9974-41b6-8c8f-41f3210d4791",
                                                "sense_id": "566d22fa-0eba-397e-8b5b-fd30fd155a41",
                                                "text": "I continued to pound along doggedly. I was grimly resolute."
                                            },
                                            {
                                                "example_id": "2ede5bba-7401-4265-a100-cedf91001c23",
                                                "sense_id": "566d22fa-0eba-397e-8b5b-fd30fd155a41",
                                                "text": "She was married to someone.\nHe was doggedly determined he would get her."
                                            },
                                            {
                                                "example_id": "8f828a23-7171-47e5-9ec1-2bff193bce2e",
                                                "sense_id": "566d22fa-0eba-397e-8b5b-fd30fd155a41",
                                                "text": "Unemployment hovered doggedly near 10%."
                                            },
                                            {
                                                "example_id": "5256124d-ee34-48ca-b5ed-cc82373edd4c",
                                                "sense_id": "566d22fa-0eba-397e-8b5b-fd30fd155a41",
                                                "text": "The announcement was made in Leeds - the largest city in Europe without a mass transit system. It's also a city which has been doggedly pressing (to little avail) for an integrated transport system for two decades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bc03559-6499-37c3-822b-e8a06bc29797",
                                        "entry_id": "61396804-290c-3f1e-944c-859b4d666f90",
                                        "glosses": [
                                            "sullenly, gloomily"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2fb4b86-f899-486d-8bdf-7f97a4f8eed2",
                                                "sense_id": "8bc03559-6499-37c3-822b-e8a06bc29797",
                                                "text": "'Nay,' said Dr Johnson, 'a man may write at any time, if he will set himself DOGGEDLY to it.' [Footnote: This word is commonly used to signify sullenly, gloomily and in that sense alone it appears in Dr Johnson's Dictionary. I suppose he meant by it 'with an OBSTINATE RESOLUTION, similar to that of a sullen man'.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b5c9a63-59c6-4ecd-89d3-10858c781d46",
                        "source_entry_id": "ebbe149e-8a60-3448-bf66-69c23d6eaf12",
                        "target_lang_word": "persistently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "persistently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d00633d9-28c1-3bd3-96f7-cc4b9d6ce6ae",
                                        "entry_id": "e9112d1c-9901-34a0-a648-1e798483773e",
                                        "glosses": [
                                            "In a persistent manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e67a906-7cef-4638-9b52-c2810fb6d4de",
                                                "sense_id": "d00633d9-28c1-3bd3-96f7-cc4b9d6ce6ae",
                                                "text": "The small girl persistently asked her father to buy her the doll."
                                            },
                                            {
                                                "example_id": "251da8f6-1cb7-4589-a9a7-6dd193bbe37e",
                                                "sense_id": "d00633d9-28c1-3bd3-96f7-cc4b9d6ce6ae",
                                                "text": "One of the most persistently held beliefs about sharks is that they have to stay in motion to stay alive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0da092c-b1b1-4198-8346-f250df86e2b2",
                        "source_entry_id": "ebbe149e-8a60-3448-bf66-69c23d6eaf12",
                        "target_lang_word": "relentlessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "relentlessly",
