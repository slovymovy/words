                                        "sense_id": "909ae75d-e1f6-3251-a9f0-988aaecdd541",
                                        "entry_id": "4e93b674-8bec-33b8-acb7-1fd4aff6ee33",
                                        "glosses": [
                                            "With constant frequency or pattern."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8563e81-7547-4010-9790-869bec59e810",
                                                "sense_id": "909ae75d-e1f6-3251-a9f0-988aaecdd541",
                                                "text": "We regularly buy lottery tickets from the corner store."
                                            },
                                            {
                                                "example_id": "197bf772-224f-4377-9120-f1f4fe0cb924",
                                                "sense_id": "909ae75d-e1f6-3251-a9f0-988aaecdd541",
                                                "text": "Wax models of the pudenda of both sexes were regularly placed before the altar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57c46cbf-5208-3dd7-83ac-1148fc05048b",
                                        "entry_id": "4e93b674-8bec-33b8-acb7-1fd4aff6ee33",
                                        "glosses": [
                                            "normally; ordinarily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70f5e888-4046-407c-a241-964eb307f5c4",
                                                "sense_id": "57c46cbf-5208-3dd7-83ac-1148fc05048b",
                                                "text": "Noemi decided to dress regularly for the party, instead of going for an outrageous outfit."
                                            },
                                            {
                                                "example_id": "a4684854-3230-42ad-beaf-d4c18aed7730",
                                                "sense_id": "57c46cbf-5208-3dd7-83ac-1148fc05048b",
                                                "text": "The period of life at which initiation takes place is regularly puberty."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbdede05-1e3f-4593-a6c5-c0fbf9635c26",
                        "source_entry_id": "38b016ff-7c9e-36b4-b699-718ff660c832",
                        "source_sense_id": "8cae9907-b5fb-336e-b7ee-777ad93ba19f",
                        "target_lang_word": "régulièrement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "régulièrement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4889dc77-3e3b-3060-ab87-ba4d594211cf",
                                        "entry_id": "48f9bdb9-0300-30a4-8737-35f56c4d7b13",
                                        "glosses": [
                                            "D’une manière régulière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a399258c-fa62-4a81-96e2-81660b36d709",
                                                "sense_id": "4889dc77-3e3b-3060-ab87-ba4d594211cf",
                                                "text": "Vers la racine, le poil se rétrécit régulièrement et les extrémités libres sont légèrement renflées ou obtuses."
                                            },
                                            {
                                                "example_id": "49b6872b-fb58-4b63-9ef7-46854249ba95",
                                                "sense_id": "4889dc77-3e3b-3060-ab87-ba4d594211cf",
                                                "text": "Elle était sujette à de fréquentes insomnies et prenait régulièrement un ou deux cachets de théralène qu’elle faisait dissoudre dans un verre d’eau."
                                            },
                                            {
                                                "example_id": "bb750285-8b7e-4de0-8f04-71bf513ef964",
                                                "sense_id": "4889dc77-3e3b-3060-ab87-ba4d594211cf",
                                                "text": "Ainsi, le lit de l'Oued Bouskoura à Casablanca a vu s'établir de nombreuses populations à la suite de vagues d’exodes ruraux, ou le quartier Koulima à Tétouan, situé dans un point bas régulièrement touché par les inondations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "981f790a-5dcc-3fd6-a4c2-1411f8517ccb",
                                        "entry_id": "48f9bdb9-0300-30a4-8737-35f56c4d7b13",
                                        "glosses": [
                                            "Exactement, ponctuellement, uniformément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80499674-b2fd-4fc9-bef5-370d3dee90c3",
                                                "sense_id": "981f790a-5dcc-3fd6-a4c2-1411f8517ccb",
                                                "text": "La duchesse de Nemours dit que, dans une conférence accordée à quelques députés des rebelles [dans la Fronde], on leur fit accroire que le prince de Condé se faisait servir régulièrement à son dîner des oreilles de Parisiens,"
                                            },
                                            {
                                                "example_id": "ad813b98-98f4-4c23-8018-36e1aef3365b",
                                                "sense_id": "981f790a-5dcc-3fd6-a4c2-1411f8517ccb",
                                                "text": "Vous voyez que j'écris régulièrement, tout malade que je suis, dès qu’il s'agit de la moindre affaire,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e81b9cc-1e8f-3308-ba0d-c6c9473b834e",
                                        "entry_id": "48f9bdb9-0300-30a4-8737-35f56c4d7b13",
                                        "glosses": [
                                            "Dans les formes ; selon la procédure ou les règles prescrites."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a693905-f41b-40f8-b993-55945d2ea487",
                                                "sense_id": "9e81b9cc-1e8f-3308-ba0d-c6c9473b834e",
                                                "text": "Enfin sur le chemin de Bolmont à la halte du même nom, […], l’empierrement du chemin bien que régulièrement exécuté, est incapable de retenir les marnes qui refluent entre les cailloux, au passage des voitures."
                                            },
                                            {
                                                "example_id": "73db73b0-93da-407c-b04d-058d36fe14ee",
                                                "sense_id": "9e81b9cc-1e8f-3308-ba0d-c6c9473b834e",
                                                "text": "Il a été ainsi jugé qu’un amendement (à un projet de décret), présenté verbalement en séance par le Gouvernement lors de l’examen pour avis par le Conseil d’État, est régulièrement soumis au Conseil d’État."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96248f84-26e0-4590-b10e-ca3b4b606ab4",
                        "source_entry_id": "38b016ff-7c9e-36b4-b699-718ff660c832",
                        "source_sense_id": "8cae9907-b5fb-336e-b7ee-777ad93ba19f",
                        "target_lang_word": "regularmente",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regularmente",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "5c776f3a-6ca9-3f92-baf4-549e6841be6a",
                                        "entry_id": "0d9202f5-951e-3a86-987c-34fbf2e8d4d0",
                                        "glosses": [
                                            "Que se da de forma común, ordinaria o natural."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f79bb6f3-d9de-4ba5-9a09-deebaf916be8",
                                                "sense_id": "5c776f3a-6ca9-3f92-baf4-549e6841be6a",
                                                "text": "Los vecinos, que regularmente en estas bellas horas de la tarde, después de concluir sus tareas diarias, acostumbraban siempre salir a respirar el ambiente fresco de las calles, o a tomar un baño en las pozas y remansos del río o a discurrir por la plaza o por las huertas, en busca de solaz, hoy no se atrevían a traspasar los dinteles de su casa, y por el contrario, antes de que sonara en el campanario de la parroquia el toque de oración, hacían sus provisiones de prisa y se encerraban en sus casas, como si hubiese epidemia, palpitando de terror a cada ruido que oían."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ee316134-9c71-3f2d-acdd-0059be7d18d0",
                                        "entry_id": "0d9202f5-951e-3a86-987c-34fbf2e8d4d0",
                                        "glosses": [
                                            "Según reglas."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c64e491a-7e8c-3aeb-92b9-be5d7019b497",
                                        "entry_id": "0d9202f5-951e-3a86-987c-34fbf2e8d4d0",
                                        "glosses": [
                                            "Ni bien ni mal o de manera mediana."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb751503-d446-4242-9ecc-04cbd30cc1f5",
                                                "sense_id": "c64e491a-7e8c-3aeb-92b9-be5d7019b497",
                                                "text": "-Dirás tú que a qué cuento vienen todas estas cosas... Pues, hijo, a que las consideres bien, si quieres hacernos ese favor; y después, a que, por la Virgen María y por todos los santos del cielo, nos des un respiro antes de matarnos de melancolía y de vergüenza en esa cárcel en que nos quieres encerrar... Mira, yo tengo un plan: a ver qué te parece... Tu suegro tiene para pasarlo regularmente, nada más que regularmente, donde está; pero puede dar un pellizco a sus recursos sin llegar a verse en los apuros que nosotros; y lo dará, porque es su obligación, y sé yo que lo dará en cuanto reciba la carta que le escribí después que tú te marchaste esta mañana. Nosotras dos, aunque la estación nos coge desnudas, enteramente desnudas, porque desde que llegamos a Madrid no nos hemos hecho una triste hilacha, nos arreglaremos con lo del invierno pasado... Ya ves que esto es una economía. Chuncha es mujer que tiene hoy buenos asideros entre las gentes del Gobierno: yo sé que si pide algo a ciertos hombres, no han de negárselo, y pienso hablarle para que saque un destinillo a Manolo... ¡Pobre hijo mío!, ¡verse precisado a trabajar como un cualquiera!..., ¡él, tan distinguido, tan mimado y tan tiernecito!... Pues ya tienes aquí otro recurso de qué echar mano, porque yo te prometo que lo que gane Manolo y lo que dé su padre ha de ser para cubrir los gastos de primera necesidad que tanto te apuran... Ya sé que vas a decirme: y si Manolo no halla destino y su padre no nos da un cuarto, ¿de qué sirven esos planes?... De nada, hijo, de nada..., de maldita de Dios la cosa... Pero mientras se ve si sirven o no, danos un respiro..., no te pido mucho, dos meses..., ¡un mes siquiera!, vamos, me parece que no es mucho un mes..., ¡un mes para ir haciendo fuerza de voluntad!... Mira, te lo pido por Dios..., ya que no lo hagas por nosotros; y de rodillas, si crees que no me humillo bastante..."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50de6e2f-113d-477f-9ab9-922eeae87098",
                        "source_entry_id": "38b016ff-7c9e-36b4-b699-718ff660c832",
                        "source_sense_id": "8cae9907-b5fb-336e-b7ee-777ad93ba19f",
                        "target_lang_word": "regelmäßig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regelmäßig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0494a752-3408-3928-88bc-6b99b3a614d1",
                                        "entry_id": "afce8803-ea08-3e3f-bbd5-8bae3e515233",
                                        "glosses": [
                                            "in festen örtlichen oder zeitlichen Abständen wiederholt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a85780fb-931b-43ec-aac1-955b0817631d",
                                                "sense_id": "0494a752-3408-3928-88bc-6b99b3a614d1",
                                                "text": "Auf dieser Tapete erkenne ich kein regelmäßiges Muster, sie scheint mit einem Zufallsgenerator bedruckt worden zu sein."
                                            },
                                            {
                                                "example_id": "e443894d-205a-430f-bf2d-297a9342d5e1",
                                                "sense_id": "0494a752-3408-3928-88bc-6b99b3a614d1",
                                                "text": "Wer bewegt sich schon regelmäßig und das ein Leben lang?"
                                            },
                                            {
                                                "example_id": "b5c7d7fa-93c9-418a-a714-a425210b50b7",
                                                "sense_id": "0494a752-3408-3928-88bc-6b99b3a614d1",
                                                "text": "„Daraufhin schlossen sich auch Aziza und Ahmet der kleinen Besuchergruppe an, wobei Ahmet mir in regelmäßigen Intervallen nonverbale Zeichen der Missbilligung sendete.“"
                                            },
                                            {
                                                "example_id": "4728b1aa-d225-43a6-9a19-9e30c2b3632d",
                                                "sense_id": "0494a752-3408-3928-88bc-6b99b3a614d1",
                                                "text": "„Um diese Streitereien zu beenden, treffen die freien Männer einer Region schon bald regelmäßig zusammen.“"
                                            },
                                            {
                                                "example_id": "8713e18b-7c0b-4b25-b905-b7c1a784536b",
                                                "sense_id": "0494a752-3408-3928-88bc-6b99b3a614d1",
                                                "text": "„Kluge Kapitalanleger lassen sich nicht nur bisherige Mietverträge zur Prüfung aushändigen, sondern lassen sich auch den regelmäßigen Mieteingang bescheinigen, indem sie z.B. Einsicht in die Kontoauszüge des Vorbesitzers bekommen.“"
                                            },
                                            {
                                                "example_id": "b97aa406-58a7-421e-8770-568e3f20e564",
                                                "sense_id": "0494a752-3408-3928-88bc-6b99b3a614d1",
                                                "text": "„Drachenfliegen ist eine anspruchsvolle, dynamische Flugsportart. Sie erfordert überdurchschnittlich gute körperliche Fitness und regelmäßiges Training.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "605e31e2-76ed-3b02-9e96-21f77b11c1b0",
                                        "entry_id": "afce8803-ea08-3e3f-bbd5-8bae3e515233",
                                        "glosses": [
                                            "immer wieder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7738a765-9306-435d-a080-75c1d4fbc774",
                                                "sense_id": "605e31e2-76ed-3b02-9e96-21f77b11c1b0",
                                                "text": "„Nicht nur im Motorflug, sondern auch im Segelflug finden sich überzogene Flugzustände oder gar Trudeln regelmäßig als Ursache von Unfällen in den Statistiken der BfU."
                                            },
                                            {
                                                "example_id": "b67e6512-4141-4572-8d7a-026d201fd1f6",
                                                "sense_id": "605e31e2-76ed-3b02-9e96-21f77b11c1b0",
                                                "text": "„Damit es nicht zu langweilig wird, müssen die Probanden regelmäßig Matches und Challenges über sich ergehen lassen, Wettkämpfe und Herausforderungen also.“"
                                            },
                                            {
                                                "example_id": "05a42d78-5255-43b7-b920-33ca6c01a9a8",
                                                "sense_id": "605e31e2-76ed-3b02-9e96-21f77b11c1b0",
                                                "text": "Ich gehe regelmäßig an den Computer."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "96d5b015-7833-3814-8d58-8395361df4c1",
                                        "entry_id": "afce8803-ea08-3e3f-bbd5-8bae3e515233",
                                        "glosses": [
                                            "gemäß der Regel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0928568-1fa0-40c3-b782-461c3205393e",
                                                "sense_id": "96d5b015-7833-3814-8d58-8395361df4c1",
                                                "text": "„regelmäßig wird im engeren Wortsinn als der Regel gemäß (wenn also keine Ausnahme greift) verstanden, …“"
                                            },
                                            {
                                                "example_id": "4ee17ad4-3c06-4214-a92d-15fc72717ffd",
                                                "sense_id": "96d5b015-7833-3814-8d58-8395361df4c1",
                                                "text": "„Ein Gestaltungsrecht wird regelmäßig durch formlose empfangsbedürftige Willenserklärung ausgeübt, wird mit deren Zugang an den Empfänger wirksam und erlischt mit seiner Ausübung.“"
                                            },
                                            {
                                                "example_id": "45191087-369a-493a-b368-2c79d8ef2336",
                                                "sense_id": "96d5b015-7833-3814-8d58-8395361df4c1",
                                                "text": "„Die subjektive Erwartung der Klägerin, dass sich die Geschäftslage bessern werde, ist dabei nicht entscheidend; wird das wirtschaftliche Risiko aus der Unternehmensführung doch regelmäßig nicht von den Arbeitnehmern übernommen.“"
                                            },
                                            {
                                                "example_id": "ce298ef0-1b24-49e3-9217-c6b73f91885e",
                                                "sense_id": "96d5b015-7833-3814-8d58-8395361df4c1",
                                                "text": "„Im öffentlichen Recht führt die Verjährung regelmäßig zum Erlöschen des Anspruchs.“"
                                            },
                                            {
                                                "example_id": "82edfb11-a6ba-4aa4-a82f-632a8b595bed",
                                                "sense_id": "96d5b015-7833-3814-8d58-8395361df4c1",
                                                "text": "„Regelmäßige Arbeitsstätte ist der ortsgebundene Mittelpunkt der dauerhaft angelegten beruflichen Tätigkeit des Arbeitnehmers, unabhängig davon, ob es sich um eine Einrichtung des Arbeitgebers handelt (Punkt 9.4 Absatz 3 LStR 2008).“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1bdf61e-d461-41e7-9368-c7edc2ecae72",
                        "source_entry_id": "38b016ff-7c9e-36b4-b699-718ff660c832",
                        "source_sense_id": "8cae9907-b5fb-336e-b7ee-777ad93ba19f",
                        "target_lang_word": "регулярно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "регулярно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b835a9cb-9d91-3e6b-bd59-36fd33398de2",
                                        "entry_id": "08345c80-ad62-332d-976f-22da04be5698",
                                        "glosses": [
                                            "наречие к регулярный; постоянно, через определённые промежутки времени"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af18a049-1aed-43c7-8960-24ecf533868b",
                                                "sense_id": "b835a9cb-9d91-3e6b-bd59-36fd33398de2",
                                                "text": "Как каждый юнкер или офицер в крепости регулярно пьёт портер, играет в штос, толкует о наградах за экспедиции, так в станице регулярно пьёт с хозяевами чихирь, угощает девок закусками и мёдом, волочится за казачками, в которых влюбляется; иногда и женится."
                                            },
                                            {
                                                "example_id": "13064fe2-1803-41cb-b07c-22cd09224145",
                                                "sense_id": "b835a9cb-9d91-3e6b-bd59-36fd33398de2",
                                                "text": "В продолжение всей двадцатилетней дружбы с Варварой Петровной он раза по три и по четыре в год регулярно впадал в так называемую между нами «гражданскую скорбь», то есть просто в хандру, но словечко это нравилось многоуважаемой Варваре Петровне."
                                            },
                                            {
                                                "example_id": "caa7759f-3703-48af-93b0-e7844f85d28c",
                                                "sense_id": "b835a9cb-9d91-3e6b-bd59-36fd33398de2",
                                                "text": "С тех пор в продолжении 41 года Жюль Верн регулярно давал по два романа в год."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1565f82f-6470-35b1-be82-89d8fb335d8e",
                                        "entry_id": "08345c80-ad62-332d-976f-22da04be5698",
                                        "glosses": [
                                            "устар. размеренно, в соответствии с установленным порядком, правилами и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33928360-ce7f-4095-b985-59f65985a314",
                                                "sense_id": "1565f82f-6470-35b1-be82-89d8fb335d8e",
                                                "text": "У него не было ни семейных воспоминаний, потому что он вырос сиротой в чужом доме и чуть не с пятнадцати лет пошёл на тяжёлую службу; не было в жизни его и особенных радостей, потому что всю жизнь свою провёл он регулярно, однообразно, боясь хоть на волосок выступить из показанных ему обязанностей."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
