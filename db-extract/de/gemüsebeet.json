                ],
                "senses": [
                    {
                        "sense_id": "bd7204b3-08fe-3065-81be-0c5eedbd1b5b",
                        "entry_id": "e75d3c62-8549-3e44-bf46-ad3f836d8fd3",
                        "glosses": [
                            "abgegrenztes Stück Boden, das zur Zucht von Gemüse genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a952313b-3320-43be-a508-15759bcdaf95",
                                "sense_id": "bd7204b3-08fe-3065-81be-0c5eedbd1b5b",
                                "text": "Der Gärtner bewässert des Gemüsebeet."
                            },
                            {
                                "example_id": "c894fa4b-1bfb-4b0c-9da2-280aa63c86ba",
                                "sense_id": "bd7204b3-08fe-3065-81be-0c5eedbd1b5b",
                                "text": "„Den größten Teil des Gartens nahmen verwahrloste Gemüsebeete ein.“"
                            },
                            {
                                "example_id": "48125fec-6944-40ed-80df-287167518f33",
                                "sense_id": "bd7204b3-08fe-3065-81be-0c5eedbd1b5b",
                                "text": "„Von den Urhebern des in Rede stehenden Planes hätte man aber auch das nicht sagen können, da sie unter dem Zertrampeln der Gemüsebeete ja nicht zu leiden hatten.“"
                            },
                            {
                                "example_id": "ebfa3389-b034-48d4-b6e3-aaa30f2af34c",
                                "sense_id": "bd7204b3-08fe-3065-81be-0c5eedbd1b5b",
                                "text": "„Außerdem legte er um das Haus herum Gemüsebeete an und pflanzte Petersilie, Dill, Schnittlauch, Mohrrüben, Kopfsalat und Fleischtomaten.“"
                            },
                            {
                                "example_id": "23504883-ac1a-4947-aebf-08b41a72a945",
                                "sense_id": "bd7204b3-08fe-3065-81be-0c5eedbd1b5b",
                                "text": "„Bevor der Pfarrer ging, vertraute er Pécuchet schüchtern an, dieses nachgemachte Grabmal mitten auf den Gemüsebeeten fände er unpassend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
