                    }
                ],
                "senses": [
                    {
                        "sense_id": "60079987-4891-3a46-a1c3-b2dd089f51e4",
                        "entry_id": "73617fe0-8cd7-3034-b101-b2c60bc66f4a",
                        "glosses": [
                            "Anhänger des Pantheismus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b664f5f3-fa03-49bc-82a5-0c84d23935e7",
                                "sense_id": "60079987-4891-3a46-a1c3-b2dd089f51e4",
                                "text": "Pantheisten glauben, dass Gott das Universum ist."
                            },
                            {
                                "example_id": "6dd3d22c-c33b-4722-9618-532e4754fbef",
                                "sense_id": "60079987-4891-3a46-a1c3-b2dd089f51e4",
                                "text": "„Wir sind naturforschend Pantheisten, dichtend Polytheisten, sittlich Monotheisten.“"
                            },
                            {
                                "example_id": "3319f7b2-6cfa-4f46-acd9-8789dc424970",
                                "sense_id": "60079987-4891-3a46-a1c3-b2dd089f51e4",
                                "text": "Albert Einstein, der an \"Spinozas Gott\" glaubte, war ein Pantheist."
                            },
                            {
                                "example_id": "ed7d72f6-f64a-4283-bbe8-807aee642344",
                                "sense_id": "60079987-4891-3a46-a1c3-b2dd089f51e4",
                                "text": "„Das Vaterland des Pantheisten [Gottfried] Keller war weder gottgesegnet noch ewig, sondern ein Werden und Vergehen wie alles in der Welt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5956a576-9e55-4f02-9902-fa4a19d7ab14",
