                                "example_id": "0c87f08f-c7e7-4f73-944c-8cc766d92cd8",
                                "sense_id": "dbc219ad-db03-3e71-bf4d-c1f65687e8e0",
                                "text": "Panu Kornelowi przypadł do gustu chłopak jego córki."
