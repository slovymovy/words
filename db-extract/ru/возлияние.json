                ],
                "senses": [
                    {
                        "sense_id": "0b6c7b72-885d-3893-9c35-45d6ad84f6e4",
                        "entry_id": "a4cafd97-6637-3210-a664-cab0e19df144",
                        "glosses": [
                            "истор. у некоторых народов в древности — принесение вина в жертву богам как обряд жертвоприношения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a747248f-4fb5-45d8-b91d-b37de8754669",
                                "sense_id": "0b6c7b72-885d-3893-9c35-45d6ad84f6e4",
                                "text": "Приношения могут быть различных родов, так как обо всем, что тешит человека, полагали, что оно тешит и божество; самым обычным было возлияние (sponde) масла, вина или меда на кору дерева, в углубление скалы, в родник или реку."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d0acbe7-2d74-3a15-b0c4-bf300bb36376",
                        "entry_id": "a4cafd97-6637-3210-a664-cab0e19df144",
                        "glosses": [
                            "перен., шутл. питьё спиртных напитков"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80606fa5-4d9c-4718-af1d-e776f6abfd49",
                                "sense_id": "0d0acbe7-2d74-3a15-b0c4-bf300bb36376",
                                "text": "За столом шло обильное возлияние, подкрепленное солидной закуской."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1e9fdf2-6d9f-4677-8e70-481201d9ad73",
                        "source_entry_id": "a4cafd97-6637-3210-a664-cab0e19df144",
                        "source_sense_description": "принесение вина в жертву богам",
                        "target_lang_word": "libation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "libation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51da0c37-584f-3d65-8b30-49c9d57bc506",
                                        "entry_id": "b24b0d92-0205-38f5-8321-17a340091199",
                                        "glosses": [
                                            "The act of pouring a liquid, most often wine, in sacrifice on the ground, on a ritual object, or on a victim, in honor of some deity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81cb63a6-6bf3-41be-8ba7-8c97434233e6",
                                                "sense_id": "51da0c37-584f-3d65-8b30-49c9d57bc506",
                                                "text": "While we to Jove the pure libations pay,\n Than Jove what apter claims the hallow'd lay?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "786f02a0-d958-3048-84c6-c576f9d041dd",
                                        "entry_id": "b24b0d92-0205-38f5-8321-17a340091199",
                                        "glosses": [
                                            "The wine or liquid thus poured out."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "55b0528a-6717-3f24-8de1-8495a5b080fc",
                                        "entry_id": "b24b0d92-0205-38f5-8321-17a340091199",
                                        "glosses": [
                                            "A beverage, especially an alcoholic one."
                                        ],
                                        "tags": [
                                            "countable",
                                            "humorous",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd01b2e6-45cb-4e18-9527-be71acc587e0",
                                                "sense_id": "55b0528a-6717-3f24-8de1-8495a5b080fc",
                                                "text": "[…] watching you, the waiters, not quite making eye-contact but scanning for any little way to be of service, plus plum-jacketed sommeliers walking around to see if you need a non-buffet libation…"
                                            },
                                            {
                                                "example_id": "806a8505-3061-4221-92d9-cf24b3a69a01",
                                                "sense_id": "55b0528a-6717-3f24-8de1-8495a5b080fc",
                                                "text": "What's more, Swedish researchers found that the fat and fiber in nuts slow the absorption of alcohol into your bloodstream. This can help smooth out the effects of moderate alcohol consumption. For best results, try to eat about 15 minutes before taking your first libation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
