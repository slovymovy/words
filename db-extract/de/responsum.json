                        "examples": [
                            {
                                "example_id": "91e2b3e0-7f3c-48ac-8fef-cf373d928088",
                                "sense_id": "86458fc1-b361-3e9f-a0af-c511d053ddda",
                                "text": "„Mit dem Hebräisch-Aramäischen besaßen die Juden eine eigene Sakral- und Hochsprache, die sie nicht nur im synagogalen Gottesdienst und für die Gebete gebrauchten, sondern ebenso zum Verfassen rabbinischer Dokumente wie z. B. Responsa.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "df477ce6-1cea-3fec-9689-a4d3daeb7d30",
                        "entry_id": "40510a53-c18a-3a2a-bb51-3e126eec8be7",
                        "glosses": [
                            "in Versen verfasste Antwort in einem liturgischen Gesang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a979ff0-9d86-425a-b51f-d04b245b2105",
                                "sense_id": "df477ce6-1cea-3fec-9689-a4d3daeb7d30",
                                "text": "„Vorsänger oder Schola singen den Text des Kehrverses und einen oder mehrere weitere Verse, die Versammlung antwortet jeweils mit dem ganzen Kehrvers oder einem Teil, dem Responsum.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
