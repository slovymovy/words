                                        "sense_id": "2064d90d-224d-3f23-9141-337ad4081a6b",
                                        "entry_id": "f6f242c8-31d0-3a1c-a8b9-1160934f203e",
                                        "glosses": [
                                            "An electronic effect which simulates echoes or reverberations in the sound signal being processed."
                                        ],
                                        "tags": [
