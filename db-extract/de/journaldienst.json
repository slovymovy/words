                ],
                "senses": [
                    {
                        "sense_id": "a7dcf3ab-fa97-34ed-9a20-7c690e6024c4",
                        "entry_id": "614160d3-c10a-387c-bfc8-9144b7e1fca8",
                        "glosses": [
                            "Bereitschaftsdienst (am Dienstort)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d08da386-67e5-4268-9d37-74d4d830f543",
                                "sense_id": "a7dcf3ab-fa97-34ed-9a20-7c690e6024c4",
                                "text": "„Dem Beamten, der außerhalb der im Dienstplan vorgeschriebenen Dienststunden zu einem Journaldienst herangezogen wird, gebührt für die im Journaldienst enthaltene Bereitschaftszeit und Dienstleistung an Stelle der Vergütungen nach den §§ 16 und 17 eine Journaldienstzulage.“"
                            },
                            {
                                "example_id": "7982b385-0e43-43d2-9f14-bc00eb6d9c9d",
                                "sense_id": "a7dcf3ab-fa97-34ed-9a20-7c690e6024c4",
                                "text": "„Den Beamten und Vertragsbediensteten, die im Bereich des Bundesministeriums für Inneres zu einem Journaldienst herangezogen werden, gebührt eine Journaldienstzulage nach Maßgabe der §§ 2 bis 5.“"
                            },
                            {
                                "example_id": "d07bacc0-2565-4eec-a3b5-87758ef217ad",
                                "sense_id": "a7dcf3ab-fa97-34ed-9a20-7c690e6024c4",
                                "text": "„180 von 1500 Stellen sollen ab 2012 eingespart, 24 Journaldienste gestrichen werden.“"
                            },
                            {
                                "example_id": "ae9d84d9-134b-4031-af5a-53433001d106",
                                "sense_id": "a7dcf3ab-fa97-34ed-9a20-7c690e6024c4",
                                "text": "„Der Gesetzesgeber erklärt, dass solche Nachtdienste eigentlich keine sind, sondern eben Journaldienste, also Bereitschaftsdienste, in denen nicht durchgearbeitet wird. Das mag im einen oder anderen Fachgebiet zutreffen, aber in den meisten – so auch in meinem – nicht. Im Journaldienst bin ich alleine im Kreißsaal verantwortlich, wo in der Tagesschicht im Schnitt zwei Oberärzte und zwei Assistenzärzte arbeiten.“"
                            },
                            {
                                "example_id": "f3a952b5-d7ef-48c5-9353-16302bb465ad",
                                "sense_id": "a7dcf3ab-fa97-34ed-9a20-7c690e6024c4",
                                "text": "„Die Betriebsvereinbarung wird um einen Monat verlängert, damit sind 24-stündige Journaldienste für die Pflegekräfte und die medizinisch-technischen Angestellten weiterhin möglich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9c0e8d3d-d48b-3d35-9bcf-b71f3d3874e5",
                        "entry_id": "614160d3-c10a-387c-bfc8-9144b7e1fca8",
                        "glosses": [
                            "Person, die [1] hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c2c6720-5b7a-4afb-8d01-2d3717eb4476",
                                "sense_id": "9c0e8d3d-d48b-3d35-9bcf-b71f3d3874e5",
                                "text": "„Beim Journaldienst der Polizei anrufen? Natürlich.“"
                            },
                            {
                                "example_id": "8fc3a561-1cdb-41a9-9be0-ac10a352570e",
                                "sense_id": "9c0e8d3d-d48b-3d35-9bcf-b71f3d3874e5",
                                "text": "„Der Journaldienst meinte: ‚Aber ich war doch nicht dabei.‘“"
                            },
                            {
                                "example_id": "462a3208-e08c-4496-8340-cd39517e4825",
                                "sense_id": "9c0e8d3d-d48b-3d35-9bcf-b71f3d3874e5",
                                "text": "„Keine Minute verging, da war der Journaldienst wieder zur Stelle.“"
                            },
                            {
                                "example_id": "f6b527f5-cc6b-4132-b9b3-934ec548c5c6",
                                "sense_id": "9c0e8d3d-d48b-3d35-9bcf-b71f3d3874e5",
                                "text": "„Wir machen jetzt auch Schluß und melden uns beim Journaldienst ab; es ist fast zwanzig Uhr!“"
                            },
                            {
                                "example_id": "ce4ec3b3-6366-40d4-9b05-4d3b186bbcdc",
                                "sense_id": "9c0e8d3d-d48b-3d35-9bcf-b71f3d3874e5",
                                "text": "„Ich ruf mal den Journaldienst an.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
