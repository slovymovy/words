                        "glosses": [
                            "besonders aufregende Situation, in die man sich bewusst mit einer Mischung aus Angst und Lust begibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0486ab69-41c1-443d-99e7-4d8b4b639a57",
                                "sense_id": "d572cfc0-2ca3-39e3-b78b-c6bb4ddb1794",
                                "text": "„Hobby-Skifahrer suchen Erholung, keinen Thrill. Einen Helm zu tragen gilt nicht mehr als spießig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
