                                    {
                                        "sense_id": "67ba87c4-13bb-31d0-b7c3-a7948381c127",
                                        "entry_id": "35322869-255b-30fe-80b3-ed2176180ff0",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 98, das zu den Actinoiden gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ff2d62c-51de-4bba-97a7-95aeb6230733",
                                                "sense_id": "67ba87c4-13bb-31d0-b7c3-a7948381c127",
                                                "text": "„Bei Californium handelt es sich um ein künstliches, radioaktives Metall mit einem Schmelzpunkt von ca. 900 °C und einer Dichte von 15,1 g/cm³. “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
