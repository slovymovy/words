                        "examples": [
                            {
                                "example_id": "f2aa2c48-59fe-4b89-abbd-8a9cf6430220",
                                "sense_id": "640e4128-aa2f-3873-8fa5-8ab49e144a8d",
                                "text": "Tijdens de oorlog werden verschillende slagschepen ingezet om zeeslagen te voeren.",
                                "translation": "During the war, several battleships were deployed to engage in naval battles.",
                                "english": "During the war, several battleships were deployed to engage in naval battles."
                            },
                            {
                                "example_id": "d3455190-5277-4b83-b4bb-853158d0068d",
                                "sense_id": "640e4128-aa2f-3873-8fa5-8ab49e144a8d",
                                "text": "Het slagschipje is een miniatuurversie van het imposante slagschip dat in een museum tentoongesteld wordt.",
                                "translation": "The battleship is a miniature version of the imposing battleship displayed in a museum.",
                                "english": "The battleship is a miniature version of the imposing battleship displayed in a museum."
                            },
                            {
                                "example_id": "de5c3cea-7e99-4d40-a910-8cd46cf1ca88",
                                "sense_id": "640e4128-aa2f-3873-8fa5-8ab49e144a8d",
                                "text": "Het slagschip is uitgerust met krachtige kanonnen en gepantserde bepantsering.",
                                "translation": "The battleship is equipped with powerful cannons and armored plating.",
                                "english": "The battleship is equipped with powerful cannons and armored plating."
                            }
                        ]
