                                    },
                                    {
                                        "sense_id": "8c57297a-beb0-3ea0-b515-c1cda04035ae",
                                        "entry_id": "1f6bfb25-bf47-39b6-ac00-79f4fcd2ec9c",
                                        "glosses": [
                                            "The act of submitting or giving e.g. a completed piece of work."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cd822dd-dbfb-4aee-9fb2-0227cc11ec43",
                                                "sense_id": "8c57297a-beb0-3ea0-b515-c1cda04035ae",
                                                "text": "Any submissions received after Friday will have marks deducted for lateness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "246e1d16-2326-3521-8b15-de36837c6a6a",
                                        "entry_id": "1f6bfb25-bf47-39b6-ac00-79f4fcd2ec9c",
                                        "glosses": [
                                            "The thing which has been submitted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7057eb8-0598-4eed-9558-b46d02f54906",
                                                "sense_id": "246e1d16-2326-3521-8b15-de36837c6a6a",
                                                "text": "In his submission to the UN, [Christof] Heyns points to the experience of drones. Unmanned aerial vehicles were intended initially only for surveillance, and their use for offensive purposes was prohibited, yet once strategists realised their perceived advantages as a means of carrying out targeted killings, all objections were swept out of the way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52195826-f0a3-3ab9-9d58-5b4ce4f658bd",
                                        "entry_id": "1f6bfb25-bf47-39b6-ac00-79f4fcd2ec9c",
                                        "glosses": [
                                            "A submission hold in wrestling, mixed martial arts, or other combat sports."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfd865e5-8573-4fe7-aecc-f4015e3c80e1",
                                                "sense_id": "52195826-f0a3-3ab9-9d58-5b4ce4f658bd",
                                                "text": "He used overhooks to block the punches, but he didn't seem to know any submissions off the overhooks."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "submission",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64b0ae8c-1372-3844-977b-fafbe8fa5000",
                                        "entry_id": "d6a185ec-91ea-3992-8656-608fd1dc50f1",
                                        "glosses": [
                                            "A subset or component of a mission."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5de9492-8088-470b-acd0-db6dbdc232d5",
                                                "sense_id": "64b0ae8c-1372-3844-977b-fafbe8fa5000",
                                                "text": "The commander would have to communicate to his operational planners his intent — how he wanted to fight the battle and what missions and submissions were vital to achieving what the corps order had defined as missions for the division."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de2c5321-6bcd-4788-bce5-bff6fadeb6a3",
                        "source_entry_id": "d09f5658-71d9-3761-98f6-f390b9a6455a",
                        "source_sense_id": "528c9736-5293-3f5b-a8bb-412cfbe0e36b",
                        "target_lang_word": "Unterwerfung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterwerfung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9011017-b8d9-3ce0-b6a3-2313ffea6656",
                                        "entry_id": "24347d59-94f7-3fc0-9fe5-fdd9ffb44ba2",
                                        "glosses": [
                                            "die Handlung, sich jemandem zu ergeben; Akzeptanz einer (Zwangs-)Herrschaft oder Macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffa36879-29ac-469c-8782-860838afbc60",
                                                "sense_id": "d9011017-b8d9-3ce0-b6a3-2313ffea6656",
                                                "text": "Jetzt aufzuhören, käme einer Unterwerfung gleich."
                                            },
                                            {
                                                "example_id": "d6ea7957-2918-4601-bbb5-3d23f1e90e8f",
                                                "sense_id": "d9011017-b8d9-3ce0-b6a3-2313ffea6656",
                                                "text": "„Er stieß weit nach Osten vor, plünderte und zerstörte seinerseits den Ring, nahm die Unterwerfung des Khagans entgegen und trieb die Scharen der Awaren, die sich nicht beugen wollten, zur Flucht über die Theiß nach Osten.“"
                                            },
                                            {
                                                "example_id": "14543a5a-c741-4bfa-95b1-2a2637fe95a7",
                                                "sense_id": "d9011017-b8d9-3ce0-b6a3-2313ffea6656",
                                                "text": "„Mein Alter und mein Status geben ihr die vernunftmäßig nachvollziehbare Erlaubnis, sich zu unterwerfen, und im Bett ist Unterwerfung kein unangenehmes Gefühl.“"
                                            },
                                            {
                                                "example_id": "d2132f10-9288-4725-b594-732938177116",
                                                "sense_id": "d9011017-b8d9-3ce0-b6a3-2313ffea6656",
                                                "text": "„Der Despotismus erhöht die Wollust, er sucht Unterwerfung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "99649efb-81d8-3667-9518-6387c7e81da7",
                                        "entry_id": "24347d59-94f7-3fc0-9fe5-fdd9ffb44ba2",
                                        "glosses": [
                                            "gewaltsame Aneignung eines Herrschaftsgebiets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd73cb14-9125-4243-b852-ff03df71f020",
                                                "sense_id": "99649efb-81d8-3667-9518-6387c7e81da7",
                                                "text": "Die Unterwerfung des besiegten Landes führte zu Protesten."
                                            },
                                            {
                                                "example_id": "c242b868-2d78-4dd2-be26-6b622f7f1e01",
                                                "sense_id": "99649efb-81d8-3667-9518-6387c7e81da7",
                                                "text": "„Nach der Unterwerfung der nördlichen Grenzvölker und dem Abkommen mit dem Partherkönig im Osten 20 v. Chr. schien der Friede des Reiches tatsächlich für immer gesichert.“"
                                            },
                                            {
                                                "example_id": "d8ce7107-af91-4dea-8fb3-9386c2fb25a7",
                                                "sense_id": "99649efb-81d8-3667-9518-6387c7e81da7",
                                                "text": "„Ihm steckten Erfahrungen in den Knochen, die er wenige Jahre zuvor bei der Unterwerfung der Kumanen gemacht hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
