                                                "sense_id": "e7e5707d-cbc6-33a2-bfe2-ba29bdf02a94",
                                                "text": "„Er steht für die schlimmsten Exzesse des amerikanischen Nationalstolzes.“"
                                            },
                                            {
                                                "example_id": "52421c9a-1b2d-48af-80cf-bccf51e06b7c",
                                                "sense_id": "e7e5707d-cbc6-33a2-bfe2-ba29bdf02a94",
                                                "text": "„Ein weitverbreiteter Irrtum, dem besonders gerne intellektuelle Trinker anhängen, die ihre Exzesse akademisch rechtfertigen wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
