                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "vooral Zuid-Nederlands of dialect"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A small piece of fried bacon or fat (greaves).",
                        "ru": "Выжаренный кусочек сала (шкварка).",
                        "fr": "Morceau de gras ou de lard fondu et croustillant (gratton)."
                    },
                    "translations": {
                        "en": [
