                "senses": [
                    {
                        "sense_id": "7eab71c7-8887-3dc6-81e6-621f554f72a7",
                        "entry_id": "50bdb5ed-d058-313c-96e5-40f8bec5aad4",
                        "glosses": [
                            "книжн. делать мрачным, затемнять, затмевать, наводить мрак"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5922165f-8999-48b0-b308-cc07d38b0dd9",
                                "sense_id": "7eab71c7-8887-3dc6-81e6-621f554f72a7",
                                "text": "Тучи помрачают небо и солнце."
                            },
                            {
                                "example_id": "507f4b80-0688-4f9d-ba55-8075b0aae601",
                                "sense_id": "7eab71c7-8887-3dc6-81e6-621f554f72a7",
                                "text": "Безумие или страсти помрачают рассудок."
                            },
                            {
                                "example_id": "7e53dd7a-63fc-4a66-94c0-ee0e94dbd7be",
                                "sense_id": "7eab71c7-8887-3dc6-81e6-621f554f72a7",
                                "text": "Иногда она забывалась, и тогда опять облако грусти помрачало её чело."
                            }
                        ]
                    }
                ],
