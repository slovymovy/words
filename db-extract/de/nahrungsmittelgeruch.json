                "senses": [
                    {
                        "sense_id": "a9d4a944-bb83-3419-bba7-1b21ae1a0a6e",
                        "entry_id": "4557d481-443f-39e4-bac1-0182b4667064",
                        "glosses": [
                            "wahrnehmbarer Geruch von etwas Essbarem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74725e6c-5afb-417c-bbf6-007d8885e463",
                                "sense_id": "a9d4a944-bb83-3419-bba7-1b21ae1a0a6e",
                                "text": "„Gesichtsausdrücke von drei bis acht Stunden alten Säuglingen (vor der ersten Brust- oder Flaschenmahlzeit) als Reaktion auf Nahrungsmittelgerüche.“"
                            },
                            {
                                "example_id": "330ec937-33ff-4ec9-92a3-56949b0eee49",
                                "sense_id": "a9d4a944-bb83-3419-bba7-1b21ae1a0a6e",
                                "text": "„Beseitigen Sie Nahrungsmittelgerüche durch die Installation einer Dunstabzugshaube.“"
                            },
                            {
                                "example_id": "e0ff8f27-c13a-4497-9458-4a3af4213124",
                                "sense_id": "a9d4a944-bb83-3419-bba7-1b21ae1a0a6e",
                                "text": "„Zum Beispiel, werden Nahrungsmittelgerüche normalerweise orthonasally und retronasally erfahren, während Nichtlebensmittelgerüche nur orthonasally empfunden werden.“"
                            },
                            {
                                "example_id": "cd6303f0-c077-4b79-a48e-cc0fdda72350",
                                "sense_id": "a9d4a944-bb83-3419-bba7-1b21ae1a0a6e",
                                "text": "77,3% der von den 22 Patienten gemachten Angaben bezogen sich auf Gerüche der Kategorie «Sauberkeit-Unsauberkeit», 16,5% entfielen auf Nahrungsmittelgerüche und 6,2% auf Gerüche der Kategorie «Romantik»."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
