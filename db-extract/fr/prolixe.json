                                                "sense_id": "65002f6a-c531-3371-a6bf-f7fbe3611601",
                                                "text": "Wir haben oft weitschweifige Wanderungen unternommen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "21d802b0-abea-34b8-a017-54386d05ddb6",
                                        "entry_id": "97684d75-42bd-32bf-a552-15bc16861d90",
                                        "glosses": [
                                            "ausführlicher und wortreicher als nötig"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a239f650-a072-43ed-be66-9e777483029e",
                                                "sense_id": "21d802b0-abea-34b8-a017-54386d05ddb6",
                                                "text": "Opa erzählte gerne weitschweifige Geschichten von früher."
                                            },
                                            {
                                                "example_id": "ef102920-3fff-4891-8963-f79d9e2a6e4e",
                                                "sense_id": "21d802b0-abea-34b8-a017-54386d05ddb6",
                                                "text": "Das Für und Wider wurde weitscheifig diskutiert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51dfb552-fa60-4378-b426-5310940a0ee3",
                        "source_entry_id": "a73a3b5d-f63c-35bb-a4ad-e9568224f8af",
                        "source_sense_id": "80371d35-8c25-38c8-93cc-60a3eba6fc96",
                        "target_lang_word": "prolix",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prolix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "416ecf6a-4e72-359b-a904-3254eb38f67f",
                                        "entry_id": "e30b9380-f150-317b-b9ef-6781eb85680e",
                                        "glosses": [
                                            "Tediously lengthy; dwelling on trivial details."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10a4496e-a3c3-4f28-8c8c-5e555365e375",
                                                "sense_id": "416ecf6a-4e72-359b-a904-3254eb38f67f",
                                                "text": "\"Give me but the luxury of answering to one of his prolix, contradictory speeches, and...I only ask the revenge of a reply.\""
                                            },
                                            {
                                                "example_id": "5f470c4e-3dce-4c55-a764-3072f0d7b3d0",
                                                "sense_id": "416ecf6a-4e72-359b-a904-3254eb38f67f",
                                                "text": "People who have blamed [Jean Charles Léonard de] Sismondi as unnecessarily prolix cannot have considered the crowd of details presented by the history of Italy."
                                            },
                                            {
                                                "example_id": "3ea23c05-861c-4769-a66b-4295d8e3a419",
                                                "sense_id": "416ecf6a-4e72-359b-a904-3254eb38f67f",
                                                "text": "From General Peckem's office on the mainland came prolix bulletins each day headed by such cheery homilies as \"Procrastination is the Thief of Time and \"Cleanliness is Next to Godliness.\""
                                            },
                                            {
                                                "example_id": "e8735bd4-2459-4ffd-bddd-d3d346b5078c",
                                                "sense_id": "416ecf6a-4e72-359b-a904-3254eb38f67f",
                                                "text": "Traditional narratives he found too prolix and discursive. \"There's always 14 pages describing a lawn that you skip over,\" he says."
                                            },
                                            {
                                                "example_id": "3dc389f1-4279-4f0b-bfdb-4856725822a6",
                                                "sense_id": "416ecf6a-4e72-359b-a904-3254eb38f67f",
                                                "text": "Prolix! Prolix! / Nothing a pair of scissors can't fix!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08286594-af1f-366d-8a48-4e3c8ba41f3e",
                                        "entry_id": "e30b9380-f150-317b-b9ef-6781eb85680e",
                                        "glosses": [
                                            "Long; having great length."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
