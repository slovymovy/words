                        "entry_id": "ab43bab2-7a99-3449-9c2c-aa3a67027e03",
                        "glosses": [
                            "Exsudat végétal composé à la fois de gomme, soluble dans l’eau, et de résine, soluble dans l’éthanol, produit naturellement ou après incision de l’écorce de certaines plantes."
                        ],
                        "tags": [
                            "Pharmacognosie"
                        ],
                        "examples": [
                            {
                                "example_id": "4e2568d3-dbf8-41ba-a9fd-2aca43ef1d51",
                                "sense_id": "21ae90ce-9f98-316a-8f4b-aa3e67896cab",
                                "text": "La gomme-résine est un suc laiteux qui découle de certains végétaux auxquels on fait des incisions."
                            },
                            {
                                "example_id": "4bc7afac-ef24-4260-94b1-e274c39ea29f",
                                "sense_id": "21ae90ce-9f98-316a-8f4b-aa3e67896cab",
                                "text": "L’assa foetida, la myrrhe, l’encens sont des gommes-résines."
                            }
                        ]
                    }
                ],
