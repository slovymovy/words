                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e6d3fccb-cfc3-48aa-9e44-71ae90649008",
                                "sense_id": "62f33015-c7e8-3538-bffc-cb998a2f1f0f",
                                "text": "[…] if the Act of 1789 designed only to unfund the debt, it is equally unjust with destroying it, it is different not in principle but in degree."
                            },
                            {
                                "example_id": "ff72048d-5dfb-4d5a-8614-04a5f6d72a87",
                                "sense_id": "62f33015-c7e8-3538-bffc-cb998a2f1f0f",
                                "text": "So the effort to unfund them, really, was based on their learning that they were nonsupportive?"
                            },
                            {
                                "example_id": "cb979563-ab39-412e-b482-a8508bfd904c",
                                "sense_id": "62f33015-c7e8-3538-bffc-cb998a2f1f0f",
                                "text": "But that in-force block will become an unfunding block at some point where the payments made are greater than the premiums, investment income, and investment rollover."
                            },
                            {
                                "example_id": "24185820-c581-4747-a365-48e571268185",
                                "sense_id": "62f33015-c7e8-3538-bffc-cb998a2f1f0f",
                                "text": "This data element contains the last two positions of the latest IMET order number that either funds, unfunds, or modifies an IMET record."
                            }
                        ]
