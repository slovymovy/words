                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d22dbdb7-7b00-4ca4-828a-9a589bed473f",
                        "entry_id": "c4e13451-7673-3cbe-8962-a4c5ef211ba2",
                        "tags": [
