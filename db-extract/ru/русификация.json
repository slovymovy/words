                                        "entry_id": "62da625f-3e08-3e41-bfd7-3458fc535677",
                                        "glosses": [
                                            "The process of making anything Russian."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20900ed6-1402-4bcc-936b-1b46702c73df",
                                                "sense_id": "ab45d3cf-09be-3684-a90f-df29fc4075ec",
                                                "text": "the Russification of Western rock music"
                                            },
                                            {
                                                "example_id": "32039538-cbd5-44ab-ae47-911b85e82052",
                                                "sense_id": "ab45d3cf-09be-3684-a90f-df29fc4075ec",
                                                "text": "As a schoolboy in the Soviet Ukraine's second largest city of Kharkiv, (it was then spelled Kharkov in line with the all-permeating 'Russification'), I was a railway buff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "828d6612-b29c-3107-a129-68332bbb2b0a",
                                        "entry_id": "62da625f-3e08-3e41-bfd7-3458fc535677",
                                        "glosses": [
                                            "The process of making anything Russian.",
                                            "A policy that enforces traditional Russian values either domestically or internationally."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f624c29-8f47-3f36-89a7-5622733c597d",
                                        "entry_id": "62da625f-3e08-3e41-bfd7-3458fc535677",
                                        "glosses": [
                                            "The process of making anything Russian.",
                                            "Localization of a software or hardware interface (e.g. text on buttons of a washing machine) into the Russian language, whether using Cyrillic or transliteration. See Computer Russification."
                                        ],
                                        "tags": [
                                            "uncountable"
