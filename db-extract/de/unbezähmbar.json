                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind unbezähmbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5528acea-966b-358b-b3c6-68a9f0def0df",
                        "entry_id": "1ed2b388-e2dd-3460-ba8a-48f7101d10ba",
                        "glosses": [
                            "so, dass es nicht bezähmt werden kann"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "a42f6ee5-2adf-4bac-856b-732da2eda324",
                                "sense_id": "5528acea-966b-358b-b3c6-68a9f0def0df",
                                "text": "„Sie ist ein stürmisches unbezähmbares Mädchen, mit männlichen Neigungen, trotz ihres verführerischen echt weiblichen Reizes.“"
                            },
                            {
                                "example_id": "80f76ff1-1f66-4440-8694-03b1f3b7b9a6",
                                "sense_id": "5528acea-966b-358b-b3c6-68a9f0def0df",
                                "text": "„Bismarck hat doch wohl ziemlich unbezweifelbare positive Leistungen vollbracht. Seine Freude am Witzereißen und Anulken war aber so unbezähmbar, daß sie ihn nahezu niemals verließ.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a1bcb35-8137-4fbd-a6ea-8b495e8d9e5d",
                        "source_entry_id": "1ed2b388-e2dd-3460-ba8a-48f7101d10ba",
                        "source_sense_id": "5528acea-966b-358b-b3c6-68a9f0def0df",
                        "source_sense_description": "auch übertragen: so, dass es nicht bezähmt werden kann",
                        "target_lang_word": "untameable",
