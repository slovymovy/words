                "senses": [
                    {
                        "sense_id": "f3a79581-48db-382d-9ec2-2792a21a08aa",
                        "entry_id": "252dcb86-d789-3ad7-88d8-05523e985beb",
                        "glosses": [
                            "Areal/Gegend (Gebiet), wo ein bestimmtes Ereignis häufig auftritt; Land mit starker Verbreitung des Virus SARS-CoV-2; Land mit hohen Fallzahlen von Covid-19; Gegend mit dem hohen Risiko, sich dort mit dem Virus anzustecken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3e5861e-0a65-47ff-9091-36b12c2dfcec",
                                "sense_id": "f3a79581-48db-382d-9ec2-2792a21a08aa",
                                "text": "„Daneben sind bei Einreise in die Bundesrepublik Deutschland nach einem Aufenthalt in einem ausländischen Hochrisikogebiet (bisher Hochinzidenzgebiet) oder Virusvariantengebiet spezielle Anmelde-, Nachweis- und Quarantänepflicht zu beachten.“"
                            },
                            {
                                "example_id": "93243a17-4253-467d-9bb1-2beec6773eb5",
                                "sense_id": "f3a79581-48db-382d-9ec2-2792a21a08aa",
                                "text": "„Am Freitag (05.03.2021) hat das Robert Koch Institut mit Wirkung zum 07.03. das gesamte Land Ungarn zum Hochinzidenzgebiet erklärt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
