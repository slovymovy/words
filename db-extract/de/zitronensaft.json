                    },
                    {
                        "form_id": "70683986-7c57-4b5f-82d0-062a06d11bea",
                        "entry_id": "9e9095e6-1cae-3d8d-81fb-8dca2bf7338a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zitronensäfte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3c7cb962-2de1-3d80-b301-422dd901a069",
                        "entry_id": "9e9095e6-1cae-3d8d-81fb-8dca2bf7338a",
                        "glosses": [
                            "Saft, der durch das Pressen von Zitronen gewonnen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb9ec6ca-69cb-4752-bb0f-5ca9a8acbe2c",
                                "sense_id": "3c7cb962-2de1-3d80-b301-422dd901a069",
                                "text": "Er trinkt jeden Morgen einen Zitronensaft zum Frühstück."
                            },
                            {
                                "example_id": "566f8bb5-8d6e-4b3f-b00a-9dd07c8e1b1c",
                                "sense_id": "3c7cb962-2de1-3d80-b301-422dd901a069",
                                "text": "„Es gab nicht einmal Zitronensaft mehr und auch keinen echten Tee.“"
                            },
                            {
                                "example_id": "81a11b23-913a-48f0-804a-8d475a270117",
                                "sense_id": "3c7cb962-2de1-3d80-b301-422dd901a069",
                                "text": "„Als der Kellner die zwei Gläser frischgepressten Zitronensaft mit Eis, die zwei Whisky und die Flasche Perrier brachte, erklärt er mir, die Apotheke habe geschlossen und er könne kein Thermometer besorgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90e70a8d-b0da-40a5-a756-1a3b96d6f343",
                        "source_entry_id": "9e9095e6-1cae-3d8d-81fb-8dca2bf7338a",
                        "source_sense_id": "3c7cb962-2de1-3d80-b301-422dd901a069",
                        "source_sense_description": "Saft, der durch das Pressen von Zitronen hergestellt wird",
                        "target_lang_word": "lemon juice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lemon juice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2d2f7aa-def3-3355-8832-14cbfd5e9731",
                                        "entry_id": "9adf0699-5589-33c7-8f5b-fea4119b6185",
                                        "glosses": [
                                            "The liquid extract of lemon fruit, notably sour and often condensed, as used especially in food preparation."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f2cc320-8668-3cc7-ad47-743518a591c3",
                                        "entry_id": "9adf0699-5589-33c7-8f5b-fea4119b6185",
                                        "glosses": [
                                            "The juice of a sweet lemon or sweet lime."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6a8cd5f-0ece-49bb-aeb2-8eb0ca409861",
                                                "sense_id": "2f2cc320-8668-3cc7-ad47-743518a591c3",
                                                "text": "“Come and eat,” said my father. Everyone else had already eaten lunch, so my mother waited on me. First she gave me a tall glass of lemon juice, followed by white noodles, egg rolls, cucumber salad, fish sauce, and meat rolled in rice bread."
                                            },
                                            {
                                                "example_id": "f8c11bb4-a41c-4abc-8f4d-77cd21683ea7",
                                                "sense_id": "2f2cc320-8668-3cc7-ad47-743518a591c3",
                                                "text": "They wiped his face with a hot towel, gave him a tall glass of very refreshing lemon juice, and took his temperature, after making him comfortable on a nice clean soft bed inside the ambulance, which sped along its siren wailing."
                                            },
                                            {
                                                "example_id": "82d03b18-f08a-4490-b93c-b5e4bf32fad3",
                                                "sense_id": "2f2cc320-8668-3cc7-ad47-743518a591c3",
                                                "text": "Spiritual pilgrims can console themselves for giving in to their appetites by making sure to buy fromage made by the monks of Cîteaux; pick up some good bread and sparkling lemon juice to go with the cheese and have a picnic on the way to the abbey."
                                            },
                                            {
                                                "example_id": "866c1cdc-841a-4909-9936-e3c2ef23c0df",
                                                "sense_id": "2f2cc320-8668-3cc7-ad47-743518a591c3",
                                                "text": "Smita Dongre settled Vikram on the sofa and a young lady dressed in a bright salwar kameez placed lemon juice and biscuits on the table. [...] Vikram sipped sugary lemon juice."
                                            },
                                            {
                                                "example_id": "25234499-6a05-4a93-bb31-b8297ede2c69",
                                                "sense_id": "2f2cc320-8668-3cc7-ad47-743518a591c3",
                                                "text": "Upon seating, guests are treated to a complimentary free glass of thirst quenching lemon juice with ice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e74f459-02f8-4c01-ba7a-d138535511df",
                        "source_entry_id": "9e9095e6-1cae-3d8d-81fb-8dca2bf7338a",
