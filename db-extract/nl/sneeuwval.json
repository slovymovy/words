                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9cc4c6cc-23cb-3991-9894-e676eb4ef59a",
                        "entry_id": "53db39aa-20d3-3557-90ca-9f2e9d046fae",
                        "glosses": [
                            "het vallen van sneeuw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5244069-26fc-4a85-b95e-3bec735f7856",
                                "sense_id": "9cc4c6cc-23cb-3991-9894-e676eb4ef59a",
                                "text": "Ik liep door een betoverende witte wereld, maar realiseerde me dat ik de grens twee weken later niet meer had kunnen halen vanwege de overmatige sneeuwval."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7df1eb76-f3ef-42c7-a9d6-efad7ceca01e",
                        "source_entry_id": "53db39aa-20d3-3557-90ca-9f2e9d046fae",
                        "source_sense_id": "9cc4c6cc-23cb-3991-9894-e676eb4ef59a",
                        "target_lang_word": "снегопад",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "снегопад",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "72dda001-dcc5-32c9-91a2-ac420797652e",
                                        "entry_id": "5a709ec7-9925-3b34-9f6d-0f2f14ad4a6c",
                                        "glosses": [
                                            "метеорол. выпадение снега (обычно в большом количестве)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e469c88e-a1fe-4699-b456-20ad010664e0",
                                                "sense_id": "72dda001-dcc5-32c9-91a2-ac420797652e",
                                                "text": "По случаю снегопада весь соседний с нами склон Хангая белел этим осадком, тем контрастнее выделялся лес и ближайшие скалы гребня, мимо которых змеёю вилась короткая тропа, трудная для сообщения монголов друг с другом."
                                            },
                                            {
                                                "example_id": "ea981d88-8d19-4e00-9f09-aab54df1f627",
                                                "sense_id": "72dda001-dcc5-32c9-91a2-ac420797652e",
                                                "text": "Полыхали морозы, сменяясь оттепелями и обильными снегопадами."
                                            },
                                            {
                                                "example_id": "6f25fafc-fe70-4b40-8da8-3afa3c64dbfb",
                                                "sense_id": "72dda001-dcc5-32c9-91a2-ac420797652e",
                                                "text": "Уборка улиц от снега производилась рано утром, а при больших снегопадах — несколько раз в день."
                                            },
                                            {
                                                "example_id": "7f15518e-8052-42b8-a25e-64b6155b8c41",
                                                "sense_id": "72dda001-dcc5-32c9-91a2-ac420797652e",
                                                "text": "Из-за снегопадов часто нелётная погода, а значит, нет писем."
                                            },
                                            {
                                                "example_id": "6a904ca3-a35f-4586-bd77-209474dec020",
                                                "sense_id": "72dda001-dcc5-32c9-91a2-ac420797652e",
                                                "text": "После многодневных морозов немного отпустило — начался снегопад, и Замоскворечье на глазах заносило снегом."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
