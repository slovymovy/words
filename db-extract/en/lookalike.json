                "word": "lookalike",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "db0bf1f7-3e7e-4103-9569-90f9fe5ea8b1",
                        "entry_id": "416cee0e-f11e-31da-a8b2-f14754090af0",
                        "tags": [
                            "plural"
                        ],
                        "form": "lookalikes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1cb73f7f-1203-3032-954d-b70ce2fd75ba",
                        "entry_id": "416cee0e-f11e-31da-a8b2-f14754090af0",
                        "glosses": [
                            "Someone who, or something which, physically resembles (looks like) another.",
                            "A doppelganger, impersonator, imposter, or body double."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff6e5743-96c1-4caa-9ada-94ba6aef7ea8",
                                "sense_id": "1cb73f7f-1203-3032-954d-b70ce2fd75ba",
                                "text": "The cousins were such close lookalikes they could impersonate each other, and sometimes did."
                            },
                            {
                                "example_id": "ba207c25-2f6b-4541-9c10-e5e91592ad40",
                                "sense_id": "1cb73f7f-1203-3032-954d-b70ce2fd75ba",
                                "text": "A Queen Lookalike Fled Thailand of Lese-Majeste […] Mum Dew has been accused of trying to dress like the Queen Mother, Sirikit, wife of the late King Bhumibol Adulyadej."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ff078be-51b0-3329-b8af-d990be642fdb",
                        "entry_id": "416cee0e-f11e-31da-a8b2-f14754090af0",
                        "glosses": [
                            "Someone who, or something which, physically resembles (looks like) another.",
                            "Something that looks very similar to or the same as the genuine article."
                        ],
                        "tags": [
                            "Canada",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "9268376d-ea29-4a0e-8c29-c90e70bb91d3",
                                "sense_id": "8ff078be-51b0-3329-b8af-d990be642fdb",
                                "text": "Among competing products, a generic substitute is one thing, whereas a deceptive lookalike is another."
                            },
                            {
                                "example_id": "fcf4433c-687c-43b0-b09c-5bde95a46dd5",
                                "sense_id": "8ff078be-51b0-3329-b8af-d990be642fdb",
                                "text": "Only a lookalike, not a real hearse, it had just enough room in the trunk for one coffin. The other one would have to sit on the back seat. Pierre got a green canvas tarp and laid it out on the seat. Rico stood by, watching anxiously."
                            },
                            {
                                "example_id": "2831f34a-6413-4e05-8948-02ebddbff76a",
                                "sense_id": "8ff078be-51b0-3329-b8af-d990be642fdb",
                                "text": "[The car] used by Ferris and his friends in the 1986 movie was not a real Ferrari. The Italian automaker made fewer than 100 250GTs, which cost $350,000 each. The studio saved money by putting a lookalike fiberglass shell on an MG."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f5cf074-5f9f-4ff4-9a9b-07c037477030",
                        "source_entry_id": "416cee0e-f11e-31da-a8b2-f14754090af0",
