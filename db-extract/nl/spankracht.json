                        "examples": [
                            {
                                "example_id": "2fd87d5b-8cf5-46e5-bfea-f1aa8eaa5db7",
                                "sense_id": "339691ae-fb7a-3505-98a3-fb4ebac39923",
                                "text": "Een ongezonde bevolking kan geen gezonde economie creëren. Een depressieve bevolking mist de spankracht om nieuwe ontwikkelingen aan te jagen. Dus hoe meer schuld, hoe ernstiger de neerwaartse spiraal waarin Griekenland zich bevindt. Als vrijwillig adviseur in de Griekse gezondheidszorg zie ik de gevolgen. Het wordt hoog tijd dat de Europese Gemeenschap dit erkent en tot steun overgaat."
                            }
                        ]
                    },
                    {
                        "sense_id": "b218af1c-ec0e-36b2-8744-472e1d5ca6c0",
                        "entry_id": "60963480-7af0-37f9-a0a6-c2661c5550bf",
                        "glosses": [
                            "het vermogen om aan externe krachten weerstand te bieden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96634db7-275c-4f8c-9abd-0d7f43d80320",
                                "sense_id": "b218af1c-ec0e-36b2-8744-472e1d5ca6c0",
                                "text": "De spankracht van de verhoudingen tussen kabinet en oppositie wordt volop getest vandaag. Op het spel: belastingontwijking, de dividendbelasting en de Klimaatwet."
                            }
                        ]
