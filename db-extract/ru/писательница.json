                                            {
                                                "example_id": "15ffeccb-8419-419d-9748-bd955b303640",
                                                "sense_id": "3df81c8a-401a-3173-b1a8-77c3890cbaed",
                                                "text": "Fernanda Pivano è stata una famosa scrittrice italiana"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5501cce9-a2c6-42bf-845a-fdc42a0f5aaa",
                        "source_entry_id": "ee84054a-9072-3b16-9675-2002015cc599",
                        "source_sense_id": "ef1a902d-a078-30bd-a6de-2cf344ce1614",
                        "target_lang_word": "Schriftstellerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schriftstellerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2bba25d9-a183-3fc9-b39b-1dee2d6e150a",
                                        "entry_id": "efb78149-62bc-369e-904d-1f7961cbf1d2",
                                        "glosses": [
                                            "weibliche Person, die schriftliche Werke verfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8235201-8e4c-4222-9df7-fcd2c22a4b2b",
                                                "sense_id": "2bba25d9-a183-3fc9-b39b-1dee2d6e150a",
                                                "text": "Agatha Christie war eine sehr bekannte Schriftstellerin."
                                            },
                                            {
                                                "example_id": "2ec63e46-2d67-49f6-9b31-5eee1bee7e14",
                                                "sense_id": "2bba25d9-a183-3fc9-b39b-1dee2d6e150a",
                                                "text": "„Die Schriftstellerin Germaine de Staël, die den gesellschaftlichen Rückschritt in ihrem Roman »Delphine« kritisierte, wird des Landes verwiesen und muss ihren literarischen Salon aufgeben.“"
                                            },
                                            {
                                                "example_id": "0c77b3de-771f-4be1-a398-336e56fa8348",
                                                "sense_id": "2bba25d9-a183-3fc9-b39b-1dee2d6e150a",
                                                "text": "„Konsequent hat die Schriftstellerin bei der Publikation des Textes an seiner authentischen Struktur festgehalten, auch bei den Namen.“"
                                            },
                                            {
                                                "example_id": "8fbd00ce-b5a8-4c09-aea8-b702a6febf03",
                                                "sense_id": "2bba25d9-a183-3fc9-b39b-1dee2d6e150a",
                                                "text": "„Nach einer Weile sagt Efe, dass sie immer Schriftstellerin werden wollte.“"
                                            },
                                            {
                                                "example_id": "2f7207e2-cf06-40fc-a5c1-492a94fd5641",
                                                "sense_id": "2bba25d9-a183-3fc9-b39b-1dee2d6e150a",
                                                "text": "„Hella Wuolijoki war eine linke Schriftstellerin und Geschäftsfrau im Holzhandel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "528337a1-dbbd-4e44-bdf3-9968a570fc83",
                        "source_entry_id": "ee84054a-9072-3b16-9675-2002015cc599",
                        "source_sense_id": "ef1a902d-a078-30bd-a6de-2cf344ce1614",
                        "target_lang_word": "Autorin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Autorin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c186da6d-3aa7-32b0-a19b-c2fae4d6456b",
                                        "entry_id": "25db41c0-bc88-3688-8731-b4b5ec761c73",
                                        "glosses": [
                                            "Verfasserin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d819d28-1089-42fd-b5e1-a1ad744699d5",
                                                "sense_id": "c186da6d-3aa7-32b0-a19b-c2fae4d6456b",
                                                "text": "Aha, das ist also die Autorin dieses Machwerks!"
                                            },
                                            {
                                                "example_id": "ea64e94a-afd9-4fbf-8a14-fe2baeeb7a0e",
                                                "sense_id": "c186da6d-3aa7-32b0-a19b-c2fae4d6456b",
                                                "text": "„Sollte man Menschen verurteilen, die ihre Träume ausleben?, fragt die Autorin – und hilft mit vielen praktischen Exkursen zum Thema Höhenbergsteigen.“"
                                            },
                                            {
                                                "example_id": "96c47c14-56b4-4f63-ab83-c43543e6d294",
                                                "sense_id": "c186da6d-3aa7-32b0-a19b-c2fae4d6456b",
                                                "text": "„Die Autorin dieser Erklärung ist eine Dame im Alter von etwa fünfzig Jahren aus einer der besten deutschen Familien.“"
                                            },
                                            {
                                                "example_id": "77bd2e6f-d6d9-4cfa-8b97-0568263a8d4c",
                                                "sense_id": "c186da6d-3aa7-32b0-a19b-c2fae4d6456b",
                                                "text": "„Autor und Autorinnen, zwei Frauen und ein Mann, alle mit Professuren in Astronomie ausgestattet, behaupten mit unangenehm überzeugenden Argumenten, dass die Menschheit von Beginn an in falschen Vorstellungen von der Welt befangen sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9eea175f-80e8-3ebb-9114-871d25f1bc0a",
                                        "entry_id": "25db41c0-bc88-3688-8731-b4b5ec761c73",
                                        "glosses": [
                                            "Schriftstellerin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15788eba-92c3-48c3-9762-897f5a5cfd6f",
                                                "sense_id": "9eea175f-80e8-3ebb-9114-871d25f1bc0a",
                                                "text": "Sie ist eine berühmte Autorin."
                                            },
                                            {
                                                "example_id": "cfe41796-fb56-4850-8a6f-b9e94a94eafe",
                                                "sense_id": "9eea175f-80e8-3ebb-9114-871d25f1bc0a",
                                                "text": "„Die Münsterer Autorin Sofie Capasso bringt mit dem Fantasy-Roman „Ozeanaugen“ ihr mittlerweile drittes Buch auf den Markt.“"
                                            },
                                            {
                                                "example_id": "c5fd4de7-7f52-4067-a8bb-6636e1252249",
                                                "sense_id": "9eea175f-80e8-3ebb-9114-871d25f1bc0a",
                                                "text": "„Ich muss die Autorin kennenlernen.“"
                                            },
                                            {
                                                "example_id": "5460ab54-b851-4e1a-bf23-c93f548993f4",
                                                "sense_id": "9eea175f-80e8-3ebb-9114-871d25f1bc0a",
                                                "text": "„Doch Jane Austen hat man die atemlose Zeichensetzung und Spontaneität herausredigiert, vielleicht weil ein solcher Eindruck von ihr den stereotypischen Vorstellungen einer sittsamen und zurückhaltenden Autorin widersprochen hätte.“"
                                            },
                                            {
                                                "example_id": "9a40c3be-9adc-4db3-87d7-8152e419402a",
                                                "sense_id": "9eea175f-80e8-3ebb-9114-871d25f1bc0a",
                                                "text": "„Wer über hiergebliebene Autorinnen und Autoren schreibt, darf die literarische Emigration nicht außer Acht lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65b8b611-5b57-45d1-81db-bb5adcf6e630",
                        "source_entry_id": "ee84054a-9072-3b16-9675-2002015cc599",
                        "source_sense_id": "ef1a902d-a078-30bd-a6de-2cf344ce1614",
                        "target_lang_word": "Schreiberin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schreiberin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "926884aa-b76e-3175-a920-d37a41e35bd2",
                                        "entry_id": "bb0ca66d-de09-3bef-b109-8241baed1623",
                                        "glosses": [
                                            "weibliche Person, die etwas schreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eec43624-4bf8-4880-b342-6d5e1277b44c",
                                                "sense_id": "926884aa-b76e-3175-a920-d37a41e35bd2",
                                                "text": "„Das hatte anderseits den Vorzug klarer Verständlichkeit und unterschied ihren Brief vorteilhaft vom Geschreibsel so manch gelehrten Blaustrumpfs, das sich in seiner Verworrenheit mehr wie ein Essay denn wie ein Brief liest, und bei dessen Lektüre der Empfänger überhaupt nicht klug wird, worauf die Schreiberin eigentlich hinaus will.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b20435bf-48f2-4a51-97ac-20f114eea0fa",
                        "source_entry_id": "ee84054a-9072-3b16-9675-2002015cc599",
                        "source_sense_id": "ef1a902d-a078-30bd-a6de-2cf344ce1614",
                        "target_lang_word": "schrijfster",
