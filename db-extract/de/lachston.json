                "senses": [
                    {
                        "sense_id": "137385fc-83d4-3259-9c6f-ca0c3ce653e1",
                        "entry_id": "a918a62d-274f-3239-a51b-82f90221bfda",
                        "glosses": [
                            "Farbton, wie ihn Lachs aufweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c265d46-8441-4f6a-b6b5-9b9470e2be7d",
                                "sense_id": "137385fc-83d4-3259-9c6f-ca0c3ce653e1",
                                "text": "„Uschi Glas trug ein elegantes Kleid im zarten Lachston.“"
                            },
                            {
                                "example_id": "f09d51db-9183-4b2f-955d-bee0ad94c5b6",
                                "sense_id": "137385fc-83d4-3259-9c6f-ca0c3ce653e1",
                                "text": "„Händler berichten, dass bei den Jungs vor allem Türkis gut ankomme und bei den Mädchen ein Lachston. Aber auch Gelb, Grün und Pink seien gefragt.“"
                            },
                            {
                                "example_id": "52446545-0d55-4d99-890a-31120543fa2d",
                                "sense_id": "137385fc-83d4-3259-9c6f-ca0c3ce653e1",
                                "text": "„Die nötige Frische im schwarzen Outfit liefert eine Wildlederjacke in einem kräftigen Lachston, findet Morin.“"
                            },
                            {
                                "example_id": "b5dd860f-72e4-48c8-bc4e-2f0ac0f09cf1",
                                "sense_id": "137385fc-83d4-3259-9c6f-ca0c3ce653e1",
                                "text": "„Ein V-Pulli mit Seidenmanschetten ist inspiriert aus den dreißiger Jahren, Hemden werden mit dicken japanischen Muschelknöpfen aufgewertet, und der für Wäsche typische Lachston, das leicht gebrochene Weiß, das ausgewaschene Zitronengelb, das Hellblau für die Männer sieht zugleich locker und feierlich aus: […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
