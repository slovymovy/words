                ],
                "senses": [
                    {
                        "sense_id": "d82f8ca6-b9a3-3e9d-a3cb-77f3cbd7984f",
                        "entry_id": "48bc9fd4-71e4-3af0-82b1-1bb5655a5892",
                        "glosses": [
                            "Afghanistani, Afghani, Afghan (of, from or relating to Afghanistan)"
                        ],
                        "tags": [
                            "not-comparable",
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "0ed833b3-e19c-4032-ae49-0e94d62ca260",
                                "sense_id": "d82f8ca6-b9a3-3e9d-a3cb-77f3cbd7984f",
                                "text": "Szyr Ali, emir afganistański, jak donoszą telegramy, zabrał skarby swoje i uciekł do Rosyi.",
                                "translation": "Sher Ali, the Emir of Afghanistan, as the telegrams report, took his treasure and fled to Russia",
                                "english": "Sher Ali, the Emir of Afghanistan, as the telegrams report, took his treasure and fled to Russia"
                            },
                            {
                                "example_id": "49861952-d060-4d79-8b92-c1333fed55a9",
                                "sense_id": "d82f8ca6-b9a3-3e9d-a3cb-77f3cbd7984f",
                                "text": "Człowiek się liczy, a religia to dodatek (dla mnie zbędny) a nie odwrotnie, pojebie afganistański.",
                                "translation": "The human matters, and religion is a accessory (unnecessary for me), and not the other way around, Afghanistani fucker.",
                                "english": "The human matters, and religion is a accessory (unnecessary for me), and not the other way around, Afghanistani fucker."
                            },
                            {
                                "example_id": "6c5316ee-34c6-4653-84c8-969ad67d8226",
                                "sense_id": "d82f8ca6-b9a3-3e9d-a3cb-77f3cbd7984f",
                                "text": "W piosence \"O mój rozmarynie...\" zamiast \"dadzą mi konika\" usłyszymy: \"dadzą mi mundur oryginalny khaki afganistański, dadzą mi wsparcie myśliwców F16, trochę przestarzałe, ale powinny starczyć na irackie czołgi...\".",
                                "translation": "In the song \"Oh my rosemary...\" instead of \"they shall give me a horse\", we hear: \"they shall give an original khaki Afghanistani uniform, they shall give me F16 fighter support, a bit old, but it should be enough for the Iraqi tanks...\".",
                                "english": "In the song \"Oh my rosemary...\" instead of \"they shall give me a horse\", we hear: \"they shall give an original khaki Afghanistani uniform, they shall give me F16 fighter support, a bit old, but it should be enough for the Iraqi tanks...\"."
                            }
                        ]
                    }
