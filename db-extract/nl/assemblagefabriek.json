                "senses": [
                    {
                        "sense_id": "fc7fb414-49e2-3f2b-8b0b-eae453c3e058",
                        "entry_id": "63c08a96-a39a-390c-9d8b-28c665e9d2cc",
                        "glosses": [
                            "fabriek waar uit verschillende onderdelen een compleet product wordt gemaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09662c81-cc6f-445a-830b-da1a12dd18f9",
                                "sense_id": "fc7fb414-49e2-3f2b-8b0b-eae453c3e058",
                                "text": "Ter Horst denkt de concurrentie met China aan te kunnen omdat het om een assemblagefabriek gaat. Dat is een veel minder kostbare investering dan de fabrieken die eerder zonnepanelen in Europa fabriceerden. De zonnecellen in de panelen gaat Powerfield dus niet zelf maken maar worden geïmporteerd. Omdat het bedrijf zelf de grootste klant van de fabriek wordt, is de helft van de afzet al gegarandeerd."
                            },
                            {
                                "example_id": "bfa71e0b-d042-45a9-9dc0-b71b03bf78c7",
                                "sense_id": "fc7fb414-49e2-3f2b-8b0b-eae453c3e058",
                                "text": "Bij de Sif Group uit Roermond maken ze de stalen funderingspijpen voor de steeds groter wordende windmolens op zee. Het aantal arbeidsplaatsen bij Sif is de afgelopen jaren verdubbeld en het bedrijf heeft vorig jaar een nieuwe assemblagefabriek gebouwd op de Maasvlakte in Rotterdam."
                            },
                            {
                                "example_id": "91b7014e-d2f4-433a-9ca8-34daa5ae8738",
                                "sense_id": "fc7fb414-49e2-3f2b-8b0b-eae453c3e058",
                                "text": "De nieuwe assemblagefabriek van het Amerikaanse automerk Tesla ging vandaag in Tilburg vandaag open, na een fikse lobby van gemeente, provincie en het ministerie van Economische Zaken."
                            }
                        ]
                    }
