                "senses": [
                    {
                        "sense_id": "fb615489-f153-3253-8c7a-a3820f71347a",
                        "entry_id": "3ad82ea4-d496-35b6-a051-7887e1002a67",
                        "glosses": [
                            "Papiergeld während der Französischen Revolution"
                        ],
                        "tags": [
                            "historical",
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "812554ae-1adf-40da-91f0-443e269a616d",
                                "sense_id": "fb615489-f153-3253-8c7a-a3820f71347a",
                                "text": "„Die Gläubiger des Staates mußten die Assignaten anstelle von Bargeld annehmen.“"
                            },
                            {
                                "example_id": "265a65f9-6da0-4433-accc-7a849496e8d8",
                                "sense_id": "fb615489-f153-3253-8c7a-a3820f71347a",
                                "text": "„Moskau war überflutet von falschen und echten Assignaten, und sie hatten gar keinen Wert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a31fc30-d398-4de5-a3c6-8b6f48544aed",
                        "source_entry_id": "3ad82ea4-d496-35b6-a051-7887e1002a67",
                        "source_sense_id": "fb615489-f153-3253-8c7a-a3820f71347a",
                        "source_sense_description": "historisch, meist Plural: Papiergeld während der Französischen Revolution",
                        "target_lang_word": "assignat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assignat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8fb7db1-7ef2-3a0d-9869-ceb7f04e8ddc",
                                        "entry_id": "7b000088-b259-32b7-a8e8-891456a7204e",
                                        "glosses": [
                                            "A banknote used during the French Revolution, on the security of state land."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "391a00b3-b302-45b5-a7a2-31ceea70349e",
                                                "sense_id": "d8fb7db1-7ef2-3a0d-9869-ceb7f04e8ddc",
                                                "text": "If the landed man wishes to mortgage, he falls the value of his land, and raises the value of assignats."
                                            },
                                            {
                                                "example_id": "756adece-fc80-4bb4-93c0-efebfba83225",
                                                "sense_id": "d8fb7db1-7ef2-3a0d-9869-ceb7f04e8ddc",
                                                "text": "[O]n her request for money, I took out a parcel of assignats I had in my pocket."
                                            },
                                            {
                                                "example_id": "7be8ce72-0647-437c-9da9-17703400abac",
                                                "sense_id": "d8fb7db1-7ef2-3a0d-9869-ceb7f04e8ddc",
                                                "text": "He was in favour of a national bank; he was strongly opposed to the reckless issue of assignats and spoke against it in the Assembly."
                                            },
                                            {
                                                "example_id": "0deb0911-c18f-490d-a225-37a46f00d7b4",
                                                "sense_id": "d8fb7db1-7ef2-3a0d-9869-ceb7f04e8ddc",
                                                "text": "The continuing depreciation of the assignat was worsening problems: in November and December, the currency's cash return dipped below 1 per cent of its face value, bringing a comic aspect to many exchanges and inducing street beggars to decline alms in paper form."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d3d17d0-ca7b-4edb-b057-c5ad868ae647",
                        "source_entry_id": "3ad82ea4-d496-35b6-a051-7887e1002a67",
                        "source_sense_id": "fb615489-f153-3253-8c7a-a3820f71347a",
                        "source_sense_description": "historisch, meist Plural: Papiergeld während der Französischen Revolution",
                        "target_lang_word": "assignat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assignat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3f27c258-bd3f-3a8c-a113-731e960629ac",
                                        "entry_id": "d06e5835-ee75-3fa4-bef1-b10c5151e488",
                                        "glosses": [
                                            "Constitution ou assignation d’une rente sur un héritage qui demeure nommément affecté au paiement annuel de cette rente."
                                        ],
                                        "tags": [
                                            "Ancienne jurisprudence"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d5cbe57-1bb0-4c2d-9f69-ad02e7791d16",
                                                "sense_id": "3f27c258-bd3f-3a8c-a113-731e960629ac",
                                                "text": "Jadis femme ne prenoit douaire sur ce où elle avoit don ou assignat (transmission de propriété en cas de non remploi de la dot, ou seulement hypothèque spéciale)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fa35941-e7a4-3d6c-8fdd-b91a8238491c",
                                        "entry_id": "d06e5835-ee75-3fa4-bef1-b10c5151e488",
                                        "glosses": [
                                            "Papier-monnaie dont le paiement était assigné sur la vente des biens nationaux, émis pendant la Révolution française."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f40bdfca-4a45-49da-acc0-bc190182ad2c",
                                                "sense_id": "5fa35941-e7a4-3d6c-8fdd-b91a8238491c",
                                                "text": "Quoique la prudence maternelle ne leur eût laissé emporter qu’une faible somme, ils se croyaient riches en possédant quelques louis, véritable trésor dans un temps où les assignats étaient arrivés au dernier degré d’avilissement, et où l’or valait beaucoup d’argent."
                                            },
                                            {
                                                "example_id": "fb085778-c6b5-4d50-a4dd-f738dc69935a",
                                                "sense_id": "5fa35941-e7a4-3d6c-8fdd-b91a8238491c",
                                                "text": "La Constituante émit, le 21 décembre 1789, pour 400 millions d’assignats portant intérêt à 5% ; dix mois plus tard, elle en émit pour 800 millions sans intérêt et ayant cours forcé."
                                            },
                                            {
                                                "example_id": "6cb124c9-5973-4be1-975d-b755a9f31fea",
                                                "sense_id": "5fa35941-e7a4-3d6c-8fdd-b91a8238491c",
                                                "text": "Ainsi leurs 1,800 liv. assignats n’étaient prises qu’au taux de deux cents capitaux pour un, et encore fallait-il que ce fussent des assignats de 100 liv. et au-dessous, ceux d’un chiffre supérieur ayant cessé absolument d’avoir cours depuis le 23 prairial."
                                            },
                                            {
                                                "example_id": "8d3f1ac1-79cd-47ae-be0b-cf945c8707e7",
                                                "sense_id": "5fa35941-e7a4-3d6c-8fdd-b91a8238491c",
                                                "text": "En janvier 1794, lors de la vente de ses biens, déclarés acquis à la Nation, le château d’Étrépigny est acheté, moyennant 15 100 francs en assignats, pour le compte de Lefèvre-Gineau, seconde personnalité d'exception du village."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c05569b-8e8d-3e23-a2d3-1d5202c8440a",
                                        "entry_id": "d06e5835-ee75-3fa4-bef1-b10c5151e488",
                                        "glosses": [
                                            "Billet de banque."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d4913d9-c344-4bc7-965d-562daf4d4bd7",
                                                "sense_id": "0c05569b-8e8d-3e23-a2d3-1d5202c8440a",
                                                "text": "– On y aurait transporté les assignats et on aurait abandonné la DS beaucoup plus loin, après avoir transbordé le magot dans la Chevrolet au volant de laquelle Antoine, toujours prudent, attendrait ses hommes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7408c8cf-87df-31a4-ad2f-78b003f08002",
                                        "entry_id": "d06e5835-ee75-3fa4-bef1-b10c5151e488",
                                        "glosses": [
                                            "Toute espèce de papier-monnaie dont la valeur est dépréciée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "339b54f7-26f4-466b-8301-6f1c418fd47c",
                                                "sense_id": "7408c8cf-87df-31a4-ad2f-78b003f08002",
                                                "text": "Aujourd'hui, par la force mystérieuse des choses, la Turquie est tombée, l'Espagne est tombée. À l'heure où nous parlons, les assignats, cette dernière vermine des vieilles sociétés pourries, dévorent l'empire Turc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
