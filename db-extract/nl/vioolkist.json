                        "examples": [
                            {
                                "example_id": "658ad154-66dc-42fb-a36f-eb5830584b03",
                                "sense_id": "8e6b50cb-878f-3838-844f-01d75d4a52f1",
                                "text": "Het gat werd gedempt met geld, de vioolkist met aardappelen."
                            },
                            {
                                "example_id": "ab534fe2-6f33-4354-8f01-c32c613abeaa",
                                "sense_id": "8e6b50cb-878f-3838-844f-01d75d4a52f1",
                                "text": "Het instrument werd onder meer aan een forensisch onderzoek onderworpen. Daarmee werd aangetoond dat de viool in zeewater heeft gelegen. Ook werden de viool en de vioolkist vergeleken met spullen van andere Titanic-slachtoffers. Daarop waren dezelfde sporen van corrosie door zeewater te zien."
                            }
                        ]
