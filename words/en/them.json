{
    "word_family": [
        "themselves"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "2591b88e-4fdb-385e-9eb6-e2ef0ab7089b",
                    "sense_definition": "The objective form of \"they\", referring to a group of people, animals, or things previously mentioned.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "object_pronoun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She treated <w>them</w> for a cold.",
                            "target_lang_translations": {
                                "ru": "Она лечила <w>их</w> от простуды.",
                                "zh": "她给<w>他们</w>治感冒。"
                            }
                        },
                        {
                            "text": "Please give the documents to <w>them</w> immediately.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, немедленно передайте <w>им</w> документы.",
                                "zh": "请立刻把文件交给<w>他们</w>。"
                            }
                        },
                        {
                            "text": "I saw <w>them</w> walking in the park yesterday.",
                            "target_lang_translations": {
                                "ru": "Я видел <w>их</w> вчера гуляющими в парке.",
                                "zh": "我昨天看见<w>他们</w>在公园里散步。"
                            }
                        }
                    ],
                    "synonyms": [
                        "'em"
                    ],
                    "common_phrases": [
                        "one of them",
                        "all of them",
                        "some of them",
                        "none of them",
                        "both of them"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объектная форма местоимения \"они\", относящаяся к группе людей, животных или предметов, упомянутых ранее.",
                        "zh": "代词“they”的宾格形式，指代前文提到的群体（人、动物或事物）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "их",
                                "target_lang_sense_clarification": "винительный падеж"
                            },
                            {
                                "target_lang_word": "им",
                                "target_lang_sense_clarification": "дательный падеж"
                            },
                            {
                                "target_lang_word": "них",
                                "target_lang_sense_clarification": "после предлогов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "他们",
                                "target_lang_sense_clarification": "指代男性或男女混合群体"
                            },
                            {
                                "target_lang_word": "她们",
                                "target_lang_sense_clarification": "指代女性群体"
                            },
                            {
                                "target_lang_word": "它们",
                                "target_lang_sense_clarification": "指代动物或事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca78098f-26d4-3bba-807a-ce0ba0fc9cd2",
                    "sense_definition": "The objective form of \"they\", referring to a single person whose gender is unknown, irrelevant, or non-binary.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "object_pronoun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If a student has a question, do not ignore <w>them</w>.",
                            "target_lang_translations": {
                                "ru": "Если у студента есть вопрос, не игнорируйте <w>его</w>.",
                                "zh": "如果学生有问题，不要忽视<w>他</w>。"
                            }
                        },
                        {
                            "text": "Someone left their phone here, so I need to find <w>them</w>.",
                            "target_lang_translations": {
                                "ru": "Кто-то оставил здесь свой телефон, поэтому мне нужно найти <w>его</w>.",
                                "zh": "有人把手机落在这儿了，我得找到<w>他</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "'em"
                    ],
                    "common_phrases": [
                        "tell them",
                        "ask them",
                        "help them"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объектная форма местоимения \"они\", используемая для обозначения одного человека, чей пол неизвестен, неважен или является небинарным.",
                        "zh": "代词“they”的宾格形式，用于指代性别未知、不重要或非二元性别的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "его",
                                "target_lang_sense_clarification": "общий мужской род"
                            },
                            {
                                "target_lang_word": "их",
                                "target_lang_sense_clarification": "гендерно-нейтральное (редко)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "他",
                                "target_lang_sense_clarification": "在中文中通常使用“他”作为性别中立的指代"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39ab44d6-f74b-3c93-beb6-f945295680e7",
                    "sense_definition": "Used as a subject or complement in place of \"they\" or \"those\" in non-standard speech.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I know it seems unfair, but <w>them</w>'s the rules.",
                            "target_lang_translations": {
                                "ru": "Я знаю, это кажется несправедливым, но <w>таковы</w> правила.",
                                "zh": "我知道这看起来不公平，但<w>那些</w>就是规矩。"
                            }
                        },
                        {
                            "text": "It is <w>them</w> that fear the consequences, not us.",
                            "target_lang_translations": {
                                "ru": "Это <w>они</w> боятся последствий, а не мы.",
                                "zh": "害怕后果的是<w>他们</w>，不是我们。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "them's the rules"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in fixed phrases or dialects."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется как подлежащее или именная часть сказуемого вместо \"they\" или \"those\" в нестандартной речи.",
                        "zh": "在非标准口语中，用作主语或补语，代替“they”或“those”。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "они",
                                "target_lang_sense_clarification": "просторечие"
                            },
                            {
                                "target_lang_word": "таковы",
                                "target_lang_sense_clarification": "в устойчивых фразах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "那些",
                                "target_lang_sense_clarification": "口语中指代事物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "730b78cd-1837-3493-a06b-04e83933fc82",
                    "sense_definition": "Used instead of \"those\" to indicate specific people or things.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gimme two of <w>them</w> yellow ones.",
                            "target_lang_translations": {
                                "ru": "Дай-ка мне две <w>тех</w> жёлтых.",
                                "zh": "给我两个<w>那些</w>黄色的。"
                            }
                        },
                        {
                            "text": "Look at <w>them</w> clouds gathering over the hill.",
                            "target_lang_translations": {
                                "ru": "Посмотри на <w>те</w> облака, собирающиеся над холмом.",
                                "zh": "看<w>那些</w>在山头聚集的云。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dem"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": ""
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется вместо \"those\" для указания на конкретных людей или предметы (диалектное).",
                        "zh": "在方言或口语中代替“those”，用于指代特定的人或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "те",
                                "target_lang_sense_clarification": "указательное местоимение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "那些",
                                "target_lang_sense_clarification": "指示代词"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}