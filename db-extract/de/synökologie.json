                "senses": [
                    {
                        "sense_id": "c165eda8-eed3-34ac-8b09-5a684ea6ee59",
                        "entry_id": "dceaaaea-98b3-399a-958c-c551de219d15",
                        "glosses": [
                            "Teilgebiet der Ökologie, das sich mit der Untersuchung der Struktur und Funktion von Lebensgemeinschaften befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7ac63df-6f3c-4f09-9fa1-0942b84905c9",
                                "sense_id": "c165eda8-eed3-34ac-8b09-5a684ea6ee59",
                                "text": "Viele Konzepte der Synökologie sind für die Zootierhaltung weniger wichtig als die der Autökologie, welche die Ansprüche der Tiere an die unbelebte Umwelt beschreiben."
                            },
                            {
                                "example_id": "7f1da082-803e-4ff0-b186-ceb718c6cd6e",
                                "sense_id": "c165eda8-eed3-34ac-8b09-5a684ea6ee59",
                                "text": "Ein Konzept der Synökologie ist das Räuber-Beute-Verhältnis."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29782a05-a670-4d64-9602-29753e156358",
                        "source_entry_id": "dceaaaea-98b3-399a-958c-c551de219d15",
