                "senses": [
                    {
                        "sense_id": "b3d40bac-2968-308d-bb92-960424e8f4d4",
                        "entry_id": "b08b5b83-c04c-39f5-88af-b29652a275c0",
                        "glosses": [
                            "offizielle, für die Veröffentlichung/Verbreitung durch die Presse vorgesehene Mitteilung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d690132-e3ba-44ac-999b-4f43fdbeeb53",
                                "sense_id": "b3d40bac-2968-308d-bb92-960424e8f4d4",
                                "text": "„Als Mhanda, der Sprecher der ZIPA, am 30. September 1976 in einem Interview mit dem mosambikanischen Rundfunk den Standpunkt der ZIPA erläuterte, verlangte Mugabe von ihm, sich zukünftig der ZANU-Politik zu unterwerfen und auf eigenständige Presseerklärungen zu verzichten.“"
                            },
                            {
                                "example_id": "33a09a9d-b411-43da-8ee9-7959cd3a65ab",
                                "sense_id": "b3d40bac-2968-308d-bb92-960424e8f4d4",
                                "text": "„Es gab sogar Gerüchte, sie habe ihn gebeten, als Vizepräsident an ihrer Seite zu kandidieren, aber sobald die Wahl vorüber war, gaben die beiden in einer gemeinsamen Presseerklärung das Ende ihrer Beziehung bekannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
