                                    },
                                    {
                                        "sense_id": "4d09a9ce-902b-3ba1-8285-aa5991506a1e",
                                        "entry_id": "95571ec0-c68e-3b7e-9a7c-f902814d7f14",
                                        "glosses": [
                                            "A proponent of proletarian internationalism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0a0966f-ce29-4b8e-9681-6e0fb65daf3e",
                                                "sense_id": "4d09a9ce-902b-3ba1-8285-aa5991506a1e",
                                                "text": "A thorough-going internationalist, Marshall was a leading Boston organizer for the Peoples Anti-War Mobilization march of 100,000 at the Pentagon in 1981."
                                            },
                                            {
                                                "example_id": "3f04d948-2ee9-488b-8d57-f7ccb6185a57",
                                                "sense_id": "4d09a9ce-902b-3ba1-8285-aa5991506a1e",
                                                "text": "I'm sure Hitler has more than a few enemies even in Germany. Germany too has its internationalists and its revolutionary workers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57df2db6-578e-3545-8aed-1230cd681ac3",
