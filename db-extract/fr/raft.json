                                ]
                            },
                            {
                                "target_word": "raft",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53c81430-f47f-3176-89a9-7dbb8624b6be",
                                        "entry_id": "b36449b7-f8b1-38d9-b759-dbc2e6b9efeb",
                                        "glosses": [
                                            "To convey on a raft."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "523783ed-d667-47de-b724-0cdde199beec",
                                                "sense_id": "53c81430-f47f-3176-89a9-7dbb8624b6be",
                                                "text": "For timber I imported pine logs from Manchuria, rafted them two hundred miles down the Yalu River, three hundred miles over the Yellow Sea, and twenty miles up the Tatung River, where a thirty-five-foot tide lifted the consignment to Pyongyang."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ddf8b5e-1b9b-320d-abf7-00fd0c13fc7d",
                                        "entry_id": "b36449b7-f8b1-38d9-b759-dbc2e6b9efeb",
                                        "glosses": [
                                            "To make into a raft."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c98e1cff-4398-3595-8d4f-d06e6cc5e992",
                                        "entry_id": "b36449b7-f8b1-38d9-b759-dbc2e6b9efeb",
                                        "glosses": [
                                            "To travel by raft."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e99ef7c8-e34b-39a3-9a13-74a37b668d56",
                                        "entry_id": "b36449b7-f8b1-38d9-b759-dbc2e6b9efeb",
                                        "glosses": [
                                            "To dock (toolbars, etc.) so that they share horizontal or vertical space."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd24a873-01fb-4bf3-97da-c718beb58c93",
                                                "sense_id": "e99ef7c8-e34b-39a3-9a13-74a37b668d56",
                                                "text": "The ToolStripContainer provides built-in rafting and docking of ToolStrip, MenuStrip, and StatusStrip controls."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "raft",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c689e082-d7c0-3ce0-909a-1de777ee96dd",
                                        "entry_id": "031e9f6c-163d-3f36-a5ca-f3028f1a1320",
                                        "glosses": [
                                            "A large (but unspecified) number, a lot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9065602b-27fb-4aa0-bcec-e5e5aeade9da",
                                                "sense_id": "c689e082-d7c0-3ce0-909a-1de777ee96dd",
                                                "text": "1977-1980, Lou Sullivan, personal diary, quoted in 2019, Ellis Martin, Zach Ozma (editors), We Both Laughed In Pleasure\nPomeroy asked me a raft of factual-type questions (how old were you when you began menstruating? did you ever see your parents having intercourse? did you have many friends in high school? how was your relationship with your father?). It seemed he had a written questionnaire & checked off answers as I have them."
                                            },
                                            {
                                                "example_id": "21de7ff1-06e6-46a8-a1d3-b691687574c3",
                                                "sense_id": "c689e082-d7c0-3ce0-909a-1de777ee96dd",
                                                "text": "Among those arrested was the grand master himself, Jacques de Molay, who found himself facing a raft of charges based on the specious evidence of former knights [...]."
                                            },
                                            {
                                                "example_id": "295cd2c0-c09f-4546-a5da-9862ab25c2ce",
                                                "sense_id": "c689e082-d7c0-3ce0-909a-1de777ee96dd",
                                                "text": "The goals and entertainment dried up after the break as Wales made a raft of substitutions but, with more meaningful challenges to come, a capacity crowd at the Stok Racecourse appreciated the bigger picture with Croatia on the horizon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
