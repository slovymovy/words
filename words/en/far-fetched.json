    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "88004c17-4588-3daf-b727-bf86634254c7",
                    "sense_definition": "Implausible; not likely; difficult to believe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "implausible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is full of <w>far-fetched</w> ideas to make money.",
                            "target_lang_translations": {
                                "it": "È pieno di idee <w>inverosimili</w> per fare soldi."
                            }
                        },
                        {
                            "text": "The theory about the missing treasure seems quite <w>far-fetched</w> to most experts.",
                            "target_lang_translations": {
                                "it": "La teoria sul tesoro scomparso sembra piuttosto <w>poco credibile</w> alla maggior parte degli esperti."
                            }
                        }
                    ],
                    "synonyms": [
                        "outlandish",
                        "wild",
                        "impractical"
                    ],
                    "common_phrases": [
                        "far-fetched idea",
                        "far-fetched story",
                        "far-fetched theory"
                    ],
                    "target_lang_definitions": {
                        "it": "Implausibile; poco probabile; difficile da credere."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "inverosimile",
                                "target_lang_sense_clarification": "Che non sembra vero o è altamente improbabile."
                            },
                            {
                                "target_lang_word": "poco credibile",
                                "target_lang_sense_clarification": "Che non ispira fiducia o non sembra realistico."
                            },
                            {
                                "target_lang_word": "strampalato",
                                "target_lang_sense_clarification": "Usato spesso per idee o teorie bizzarre e prive di logica."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f7746d8-e4c4-3063-8a12-cf07b1312979",
                    "sense_definition": "Brought from a great distance.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "distance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant sold <w>far-fetched</w> spices from across the ocean.",
                            "target_lang_translations": {
                                "it": "Il mercante vendeva spezie <w>provenienti da lontano</w> oltreoceano."
                            }
                        },
                        {
                            "text": "They decorated the room with <w>far-fetched</w> artifacts collected during their travels.",
                            "target_lang_translations": {
                                "it": "Hanno decorato la stanza con manufatti <w>esotici</w> collezionati durante i loro viaggi."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Portato da una grande distanza; proveniente da lontano."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "proveniente da lontano",
                                "target_lang_sense_clarification": "Descrive oggetti o merci che arrivano da luoghi remoti."
                            },
                            {
                                "target_lang_word": "esotico",
                                "target_lang_sense_clarification": "Che proviene da paesi lontani e spesso ha un fascino particolare."
                            }
                        ]
                    }
                }
            ]
        }
    ]
