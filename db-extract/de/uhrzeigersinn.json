                        "entry_id": "5e09593d-85b4-3aca-ad88-d259ccfdae59",
                        "glosses": [
                            "Richtung drehender Bewegung gleich der Sonne geschuldeter Schatten, auf der Nordhalbkugel nach rechts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c52d36b-95f5-44de-a3dd-b902551bd488",
                                "sense_id": "fe9c70cc-6a05-3b0b-a729-b6f583e5ac40",
                                "text": "Wir können diese Position durch eine Drehung des Dreiecks um 90° im Uhrzeigersinn erreichen."
                            },
                            {
                                "example_id": "610515dc-248c-43a9-9757-94fb7a58471b",
                                "sense_id": "fe9c70cc-6a05-3b0b-a729-b6f583e5ac40",
                                "text": "Bei den thermischen Ringöffnungen von Cyclobuten drehen sich die Kohlenstoffatome in die gleiche Richtung, entweder beide im oder beide gegen den Uhrzeigersinn."
                            },
                            {
                                "example_id": "3f62ecf5-6a55-4acb-840e-f914491a953b",
                                "sense_id": "fe9c70cc-6a05-3b0b-a729-b6f583e5ac40",
                                "text": "„Hantelförmig dreht sich der winkelige Kurs gegen den Uhrzeigersinn rund um die orientalisch-schöne Altstadt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
