                "senses": [
                    {
                        "sense_id": "055571fe-465f-3267-b2c9-bc5062dca011",
                        "entry_id": "796077e8-8dd7-3724-b9d0-a188c0b81d60",
                        "glosses": [
                            "Gerät, das Cäsiumionen ionisiert, wenn diese auf die heiße Wolframoberfläche stoßen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "910724ed-f851-47ac-beb0-3369c853546f",
                                "sense_id": "055571fe-465f-3267-b2c9-bc5062dca011",
                                "text": "„Der flüssige Treibstoff strömt über die Leitung des Treibstoff-Fördersystems zu dem Wolframverdampfer und -ionisator, das Cäsium wird auf eine Temperatur von 1300°C bis 1500°C erhitzt.“"
                            },
                            {
                                "example_id": "3463fa90-7c94-4be8-8ba7-0f02c6e9808d",
                                "sense_id": "055571fe-465f-3267-b2c9-bc5062dca011",
                                "text": "„Mit einem Wolframionisator bei einer Temperatur von 3000 K wurden Ionisationseffizienzen gemessen, die um einen Faktor 1000 höher sind, als die mit reiner Oberflächenionisation zu erwarten wären [Huyse83].“"
                            },
                            {
                                "example_id": "fe957e17-4798-462a-9144-dcfd05cbf84b",
                                "sense_id": "055571fe-465f-3267-b2c9-bc5062dca011",
                                "text": "„Wolfram-Spitzenionisator mit erniedrigter Ladungsträger-Emissionsenergie (Austrittsarbeit)“"
                            },
                            {
                                "example_id": "338fb2e0-2bd1-4e0b-911e-baaf29145858",
                                "sense_id": "055571fe-465f-3267-b2c9-bc5062dca011",
                                "text": "„Für den Fall eines Wolframionisators sind die Abszissenwerte für verschiedene Elemente markiert.“"
                            },
                            {
                                "example_id": "d898039e-cadf-4169-89fe-73f9714389c3",
                                "sense_id": "055571fe-465f-3267-b2c9-bc5062dca011",
                                "text": "„Eine beträchtliche Verlängerung der Lebensdauer wurde vermittelst Ersatzes des dickdrähtigen Wolframionisators durch eine dünndrahtige Spirale erzielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
