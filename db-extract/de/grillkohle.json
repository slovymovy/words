                "senses": [
                    {
                        "sense_id": "0c7fab19-66c1-3f80-a699-a2fa865b30cf",
                        "entry_id": "3fd056d0-17c3-3ccf-b1e9-4ff428ee1002",
                        "glosses": [
                            "(Holz-)Kohle, mit deren Verbrennungswärme verschiedenes Grillgut erhitzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8157ada-adfc-41a9-b729-4c4a83f59382",
                                "sense_id": "0c7fab19-66c1-3f80-a699-a2fa865b30cf",
                                "text": "„Holzkohle wird in Hochöfen zur Eisengewinnung verwendet, zur Gewinnung von Schwarzpulver, als Grillkohle, zum Filtrieren und Klären von Flüssigkeiten und zur Herstellung von Aktivkohle.“"
                            },
                            {
                                "example_id": "70e1893d-bed9-41b0-90e7-4618b748c112",
                                "sense_id": "0c7fab19-66c1-3f80-a699-a2fa865b30cf",
                                "text": "„Holzkohle wird durch Holzverkohlung (Holz) gewonnen und heute vor allem als Grillkohle verwendet, aber auch als Reinigungmittel von Flüssigkeiten und Gasen, zur Herstellung medizinischer Aktivkohle und Zeichenkohle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56b1288a-f982-4733-b4f2-1349bd17233e",
                        "source_entry_id": "3fd056d0-17c3-3ccf-b1e9-4ff428ee1002",
                        "source_sense_id": "0c7fab19-66c1-3f80-a699-a2fa865b30cf",
                        "source_sense_description": "(Holz-)Kohle, mit deren Verbrennungswärme verschiedenes Grillgut erhitzt wird",
                        "target_lang_word": "charcoal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "charcoal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fc039db-9920-30c4-9191-70d7bf3ae472",
                                        "entry_id": "1b243ab1-a5d6-3e45-aa11-bf5ee5cff7c5",
                                        "glosses": [
                                            "impure carbon obtained by destructive distillation of wood or other organic matter, that is, heating it in the absence of oxygen."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0685776-96f7-423f-a118-2bdf627a3dc2",
                                                "sense_id": "1fc039db-9920-30c4-9191-70d7bf3ae472",
                                                "text": "The grate was laid with charcoal, to that she put a light, and then, as if she had forgotten something, hurried to the library, and carefully locked the door. First returning to see that the fire had kindled, she then went to the window, which, with the first gleam of moonlight, she cautiously unclosed, and stepped into the shrubbery."
                                            },
                                            {
                                                "example_id": "235baeeb-9c20-4859-a719-50ec1b97c23e",
                                                "sense_id": "1fc039db-9920-30c4-9191-70d7bf3ae472",
                                                "text": "But through the oligopoly, charcoal fuel proliferated throughout London's trades and industries. By the 1200s, brewers and bakers, tilemakers, glassblowers, pottery producers, and a range of other craftsmen all became hour-to-hour consumers of charcoal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9cad890-1633-391b-a111-06017e4611e8",
                                        "entry_id": "1b243ab1-a5d6-3e45-aa11-bf5ee5cff7c5",
                                        "glosses": [
                                            "A stick of black carbon material used for drawing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5b869ef-a51b-4ab2-9433-0afff6f1ee25",
                                                "sense_id": "c9cad890-1633-391b-a111-06017e4611e8",
                                                "text": "He takes the prepared charcoal used by artists, brings it to a white heat, and suddenly plunges it in a bath of mercury, of which the globules instantly penetrate the pores of charcoal, and may be said to metallize it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b10df7fd-9029-3cd7-b929-d21e768ee631",
                                        "entry_id": "1b243ab1-a5d6-3e45-aa11-bf5ee5cff7c5",
                                        "glosses": [
                                            "A drawing made with charcoal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ff98135-fb4d-3c11-b174-714f5f21866b",
