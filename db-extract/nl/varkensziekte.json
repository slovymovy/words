                        "glosses": [
                            "een ziekte die vooral varkens treft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc37d860-8636-4a80-b6f8-fb0db26d65c7",
                                "sense_id": "24764f05-189b-37b7-bf6d-6c146c6d19ac",
                                "text": "Iemand zei gisteren: Toen we het bos gingen kappen, kwam de aids in de wereld, via de apen, en deze varkensziekte is domweg een gevolg van de wijze waarop de bio-industrie met varkens omgaat."
                            },
                            {
                                "example_id": "d73517e3-5064-4b17-98d2-233b352c3a89",
                                "sense_id": "24764f05-189b-37b7-bf6d-6c146c6d19ac",
                                "text": "De zeer besmettelijke en gevaarlijk varkensziekte PED heeft in januari de ‘varkensrijke’ gebieden in Oost-Brabant en Noord-Limburg bereikt."
                            },
                            {
                                "example_id": "8f28f2b9-9e30-4612-b161-b6d48ca764d0",
                                "sense_id": "24764f05-189b-37b7-bf6d-6c146c6d19ac",
                                "text": "Varkenspest: Dodelijke varkensziekte. Vijftien jaar geleden werden zo'n 11 miljoen varkens geruimd. De ziekte waart nog steeds rond in Oost-Europa. Preventie: vaccineren."
                            }
                        ]
                    }
