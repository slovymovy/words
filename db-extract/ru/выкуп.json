                        ]
                    },
                    {
                        "translation_id": "52651862-e760-443b-9224-c6bfab0c9c27",
                        "source_entry_id": "3409191e-fc9e-392c-8318-3e0b299c70fb",
                        "source_sense_description": "плата",
                        "target_lang_word": "Lösegeld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lösegeld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "464a0a9f-2acf-3b18-86a4-7297a36830c5",
                                        "entry_id": "c0e1fbfd-0c80-321f-ae37-a603a3ce2db3",
                                        "glosses": [
                                            "Geld, das für die Freilassung einer Geisel gezahlt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6618c150-e54f-4722-a482-27d17b4dda7a",
                                                "sense_id": "464a0a9f-2acf-3b18-86a4-7297a36830c5",
                                                "text": "Die Entführer verlangen eine Million Euro Lösegeld."
                                            },
                                            {
                                                "example_id": "cd13dddf-0792-4690-8d6b-fa72a364e904",
                                                "sense_id": "464a0a9f-2acf-3b18-86a4-7297a36830c5",
                                                "text": "„Die Krise verschärfte sich erheblich, als im Jahre 455 die Vandalen Rom einnahmen, die Stadt plünderten, die Oberschicht gefangen nahmen und erst nach Zahlung eines hohen Lösegeldes entließen.“"
                                            },
                                            {
                                                "example_id": "0c56b100-6486-4d04-a6b4-4d1fd5d50836",
                                                "sense_id": "464a0a9f-2acf-3b18-86a4-7297a36830c5",
                                                "text": "„Vielfach enden Entführungen glimpflich für die Entführten, doch hat in letzter Zeit auch die Extremistengruppe Al-Kaida auf der Arabischen Halbinsel (AQAP) mehrere Ausländer entführt, darunter einen südafrikanischen Lehrer, den sie zu ermorden drohen, sollte für ihn kein Lösegeld gezahlt werden.“"
                                            },
                                            {
                                                "example_id": "f973834c-48ae-4ac0-8190-24eac2f57cec",
                                                "sense_id": "464a0a9f-2acf-3b18-86a4-7297a36830c5",
                                                "text": "„Polybios erwähnt nicht das hohe Lösegeld, das die Römer für den Abzug der Gallier zahlen müssen, wie Livius berichtet.“"
                                            },
                                            {
                                                "example_id": "7bfe5b8a-d5d5-4392-9a3e-3d4eab73d7b5",
                                                "sense_id": "464a0a9f-2acf-3b18-86a4-7297a36830c5",
                                                "text": "„Das musste der Wesir des Mogulreichs erfahren, dessen großes Heer Baji Rao zweimal besiegte, dann aber jedesmal gegen hohes Lösegeld davonziehen ließ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
