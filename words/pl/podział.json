                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nikt nie wiedział, gdzie on <w>podział</w> wszystkie dokumenty z biura przed wyjazdem.",
                            "target_lang_translations": {
