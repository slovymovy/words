                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "a21b7fc3-75b4-4db5-8b2d-eb6434c171d5",
                                "sense_id": "4bfa141d-f3f0-355a-9d41-f310e7b13afc",
                                "text": "Caesars Pränomen lautet Gaius."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2b4817e-0d29-479b-8ec3-ce8fc09703f9",
                        "source_entry_id": "e2e51c38-6cfd-3656-8c80-ad92fa51ffe7",
                        "source_sense_id": "4bfa141d-f3f0-355a-9d41-f310e7b13afc",
                        "source_sense_description": "historisch: vorangestellter Name (Vorname) einer Person im alten Rom",
                        "target_lang_word": "praenomen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "praenomen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0126564-901f-3380-a960-344518af20fb",
                                        "entry_id": "b6ff2ad3-1834-33b3-9fba-08695cd48eac",
                                        "glosses": [
                                            "An Ancient Roman given name."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1444104-ab62-4064-b9cc-a7def1ec4f81",
                                                "sense_id": "a0126564-901f-3380-a960-344518af20fb",
                                                "text": "Julius Caesar's praenomen was Gaius."
                                            },
                                            {
                                                "example_id": "3b286674-011a-4e9b-91d1-c30590708e5d",
                                                "sense_id": "a0126564-901f-3380-a960-344518af20fb",
                                                "text": "The Romans evolved a quite different system of nomenclature, which in its classical form consisted of three names, the praenomen (e.g. Marcus), nomen (e.g. Tullius), and cognomen (e.g. Cicero), and two other designations (the name of the father and of the tribe): […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb98b535-0a34-3b15-86b8-364598fec305",
                                        "entry_id": "b6ff2ad3-1834-33b3-9fba-08695cd48eac",
                                        "glosses": [
                                            "The throne name of a pharaoh, the fourth of the five names of the royal titulary, traditionally encircled by a cartouche and preceded by the title nswt-bjtj."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61f884ef-7015-40e5-9737-8cdd8003dfb1",
                                                "sense_id": "bb98b535-0a34-3b15-86b8-364598fec305",
                                                "text": "Tutankhamun's praenomen or throne name was Nebkheperrure, \"Lord of the forms of Ra\"."
                                            },
                                            {
                                                "example_id": "e41fc9fc-851e-4e07-abec-4042dad80ff0",
                                                "sense_id": "bb98b535-0a34-3b15-86b8-364598fec305",
                                                "text": "The old explanation was that the Greeks applied the name [λαβύρινθος (labúrinthos)] to it [the Temple of Hawara] because the prenomen or \"throne-name\" of its builder, Amenemhat III., would have been pronounced *Nemarîᵉ, and, by a usual interchange of n with l, transliterated into Greek as Labaris or Lamaris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6414333-b6f5-3707-b579-6299f7fa912f",
                                        "entry_id": "b6ff2ad3-1834-33b3-9fba-08695cd48eac",
                                        "glosses": [
                                            "The genus name in a binomial scientific name."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6400f3a6-bf8c-4a5a-8990-e8c1f413620b",
                                                "sense_id": "e6414333-b6f5-3707-b579-6299f7fa912f",
                                                "text": "In the name Tyrannosaurus rex, \"Tyrannosaurus\" is the praenomen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
