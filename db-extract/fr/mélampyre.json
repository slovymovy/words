                        "glosses": [
                            "Plante herbacée annuelle du genre Melampyrum de la famille des Orobanchacées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e88620d1-1d8e-4466-bf54-922c05026b3d",
                                "sense_id": "5d2aae94-2f65-34d0-adfe-728b2554750c",
                                "text": "Le mélampyre des cultures (Melampyrum arvense) est aussi dit blé de vache, cornette, rougeole, queue de renard, sarette ou sarrette."
                            },
                            {
                                "example_id": "a0240602-5edb-4009-941c-dc347d174fe5",
                                "sense_id": "5d2aae94-2f65-34d0-adfe-728b2554750c",
                                "text": "Le mélampyre linéaire est une plante acidophile et xérophile qui pousse dans le sous-bois des forêts de conifères et dans les parties les moins humides des tourbières ombrotrophes, ainsi que sur les rochers déboisés."
                            }
                        ]
                    }
