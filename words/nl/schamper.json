                            {
                                "target_lang_word": "spotte",
                                "target_lang_sense_clarification": "Befehlsform von spotten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b6a2fb1-c9fb-34ce-bfcd-9d23b0094625",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd (inversie) van <w>schamperen</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "schamperen_verboeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Schamper</w> je nu alweer over mijn voorstel voor de vakantie?",
                            "target_lang_translations": {
                                "de": "<w>Spottest</w> du jetzt schon wieder über meinen Urlaubsvorschlag?"
                            }
                        },
                        {
                            "text": "Waarom <w>schamper</w> je wanneer iemand een serieuze vraag stelt?",
                            "target_lang_translations": {
                                "de": "Warum <w>höhnst</w> du, wenn jemand eine ernste Frage stellt?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging van schamperen"
                        }
                    ],
                    "target_lang_definitions": {
