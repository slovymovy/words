                "senses": [
                    {
                        "sense_id": "25a3d1f2-fa32-34f8-872c-a13659bfbd78",
                        "entry_id": "87ebb541-0828-363a-a38b-dc6d3b82c70b",
                        "glosses": [
                            "Rendre exigu."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a1b02317-79fa-4275-bc75-bd59d0466b60",
                                "sense_id": "25a3d1f2-fa32-34f8-872c-a13659bfbd78",
                                "text": "La chaîne des nouvelles traductions installe l’original chaque fois dans une nouvelle époque (le fait progresser d’époque en époque) ; la communauté des retraductions, à rebours, précise ou « exiguïse » toujours plus l’original de sorte qu’il apparaîtrait au bout de compte (mais il n’y a pas de bout du compte) comme un point."
                            },
                            {
                                "example_id": "3394ca2e-f96f-4632-9493-9819bc0619d3",
                                "sense_id": "25a3d1f2-fa32-34f8-872c-a13659bfbd78",
                                "text": "Exiguïsant jusqu’à la promiscuité le volume de l’habitacle, ils se voûtèrent sous le plafond ainsi que des atlantes sous un entablement, puis ils fixèrent leurs pieds et ne bougèrent plus, comme absents."
                            }
                        ]
                    }
