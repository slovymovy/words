            {
                "entry_id": "e9352b75-81ef-34f6-ac6f-f508c048072d",
                "word": "Pentateuque",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "437ba2ea-307d-36d9-b491-31202975f3d4",
                        "entry_id": "e9352b75-81ef-34f6-ac6f-f508c048072d",
                        "glosses": [
                            "Ensemble des cinq premiers livres de la Bible (Genèse, Exode, Lévitique, Nombres, et Deutéronome)."
                        ],
                        "tags": [
                            "Biblical"
                        ],
                        "examples": [
                            {
                                "example_id": "15da0160-5c18-4f93-9654-9013710f5721",
                                "sense_id": "437ba2ea-307d-36d9-b491-31202975f3d4",
                                "text": "[…], il n'est pas nécessaire que ce serment soit reçu par le rabbin dans un temple Israélite; il suffit qu'il soit prêté devant le juge-commissaire, more judaico, la tête couverte et la main droite posée sur le Pentateuque hébraïque."
                            },
                            {
                                "example_id": "bece4337-a688-4680-a3eb-10fb7e638195",
                                "sense_id": "437ba2ea-307d-36d9-b491-31202975f3d4",
                                "text": "Aux premiers temps du christianisme primitif, les lois alimentaires ont été abolies par Paul de Tarse. Vers la fin du premier siècle, il en va de même pour les sacrifices d'animaux et un certain nombre de règles figurant dans le Pentateuque."
                            },
                            {
                                "example_id": "38c7b8c5-9080-4874-9ed5-2dfd188c83d6",
                                "sense_id": "437ba2ea-307d-36d9-b491-31202975f3d4",
                                "text": "Dans la Bible hébraïque, le livre du Deutéronome conclut le Pentateuque, mais pas seulement."
                            },
                            {
                                "example_id": "915a6ff0-a90d-4192-a7c8-00c98a3690b2",
                                "sense_id": "437ba2ea-307d-36d9-b491-31202975f3d4",
                                "text": "Pour Paul, le passé, c'est le temps de la Torah, du Pentateuque, selon le nom que les Juifs d'Alexandrie donnèrent à cette dernière et qui fut repris par les chrétiens; …."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e081790d-2689-40a1-a03e-be0ff14e9df5",
                        "source_entry_id": "e9352b75-81ef-34f6-ac6f-f508c048072d",
                        "source_sense_id": "437ba2ea-307d-36d9-b491-31202975f3d4",
                        "source_sense_description": "Ensemble des cinq premiers livres de la Bible",
                        "target_lang_word": "Pentateuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pentateuch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "125809d8-9104-3527-9eb6-ad8b35087ea6",
                                        "entry_id": "8f9b2d3f-398f-3660-a5af-25e12cd31a79",
                                        "glosses": [
                                            "eine Sammelbezeichnung für die fünf Bücher Mose, das heißt die ersten fünf Bücher des Alten Testaments"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "702ccd8e-0c0d-42ad-b75d-53ecb398c292",
                                                "sense_id": "125809d8-9104-3527-9eb6-ad8b35087ea6",
                                                "text": "Das Buch Genesis ist das erste Buch des Pentateuchs."
                                            },
                                            {
                                                "example_id": "37d53488-dba7-4b1e-a907-ff93c90b604f",
                                                "sense_id": "125809d8-9104-3527-9eb6-ad8b35087ea6",
                                                "text": "Der Pentateuch besteht aus folgenden fünf Büchern: Genesis, Exodus, Levitikus, Numeri, Deuteronomium."
                                            },
                                            {
                                                "example_id": "602e5265-18dc-41f1-8317-308a7354386d",
                                                "sense_id": "125809d8-9104-3527-9eb6-ad8b35087ea6",
                                                "text": "Der Pentateuch wurde etwa 440 v. Chr. fertiggestellt."
                                            },
                                            {
                                                "example_id": "5c32f7a6-5fa6-40fb-89f6-0a49cd3cdafa",
                                                "sense_id": "125809d8-9104-3527-9eb6-ad8b35087ea6",
                                                "text": "„Er glaubte nicht an den Pentateuch, war aber der Meinung, daß Gott im Talmud gegenwärtig sei.“"
                                            },
                                            {
                                                "example_id": "f1d2aa7a-1888-44a4-ad83-972932200f7f",
                                                "sense_id": "125809d8-9104-3527-9eb6-ad8b35087ea6",
                                                "text": "„1544 erschienen in Konstanz und Augsburg zwei jiddische Übersetzungen des Pentateuch nach Manuskripten, die auf der traditionellen jiddischen Übersetzungspraxis beruhen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
