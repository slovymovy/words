    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "feb13d09-ce62-3a96-bb64-615f9c33da71",
                    "sense_definition": "Переместиться изнутри наружу, покинуть помещение или пределы чего-либо",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я хочу <выйти> на улицу и подышать свежим воздухом.",
                            "target_lang_translations": {
                                "en": "I want to <go out> and get some fresh air.",
                                "de": "Ich möchte auf die Straße <hinausgehen> und etwas frische Luft schnappen.",
                                "zh": "我想<出去>走走，呼吸一下新鲜空气。"
                            }
                        },
                        {
                            "text": "Он быстро <вышел> из комнаты, хлопнув дверью.",
                            "target_lang_translations": {
                                "en": "He quickly <left> the room, slamming the door.",
                                "de": "Er hat das Zimmer schnell <verlassen> und die Tür zugeschlagen.",
                                "zh": "他砰地一声关上门，迅速<离开>了房间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "покинуть",
                        "уйти"
                    ],
                    "antonyms": [
                        "войти",
                        "зайти"
                    ],
                    "common_phrases": [
                        "выйти из дома",
                        "выйти на улицу",
                        "выйти из машины"
                    ],
                    "target_lang_definitions": {
                        "en": "To move from inside to outside, to leave a room or the limits of something",
                        "de": "Einen Raum oder ein Gebiet von innen nach außen verlassen",
                        "zh": "从内部移动到外部，离开房间或某个范围"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "go out",
                                "target_lang_sense_clarification": "general movement from inside to outside"
                            },
                            {
                                "target_lang_word": "leave",
                                "target_lang_sense_clarification": "to depart from a place"
                            },
                            {
                                "target_lang_word": "exit",
                                "target_lang_sense_clarification": "formal or physical act of leaving"
                            },
                            {
                                "target_lang_word": "get out",
                                "target_lang_sense_clarification": "informal, often implies leaving a vehicle or confined space"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "hinausgehen",
                                "target_lang_sense_clarification": "von drinnen nach draußen gehen"
                            },
                            {
                                "target_lang_word": "verlassen",
                                "target_lang_sense_clarification": "einen Ort oder ein Gebäude verlassen"
                            },
                            {
                                "target_lang_word": "aussteigen",
                                "target_lang_sense_clarification": "aus einem Fahrzeug aussteigen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出去",
                                "target_lang_sense_clarification": "从内部到外部的一般移动"
                            },
                            {
                                "target_lang_word": "离开",
                                "target_lang_sense_clarification": "从某地出发或离开某处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97e52063-9109-3620-b983-1697ef78ec1a",
                    "sense_definition": "Вступить в брак (о женщине)",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "marriage",
                    "name_type": "no",
