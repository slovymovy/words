                "senses": [
                    {
                        "sense_id": "ab01d1c0-4bbd-3a22-b8e2-1b447ed6f225",
                        "entry_id": "a819736b-a9c8-3924-9cec-798872dceb57",
                        "glosses": [
                            "bouwwerk met meerdere vergaderzalen, bestemd voor vergaderingen en andere bijeenkomsten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "330335cd-4902-4590-8b6e-f33387f4d158",
                                "sense_id": "ab01d1c0-4bbd-3a22-b8e2-1b447ed6f225",
                                "text": "Toen premier Edi Rama de trappen van het congrescentrum kwam afgewandeld, grapten zijn vrienden: „Erop af, Jeroen, jij bent belangrijk.”"
                            },
                            {
                                "example_id": "abc7438b-243d-4651-9bcc-2ca8558d7461",
                                "sense_id": "ab01d1c0-4bbd-3a22-b8e2-1b447ed6f225",
                                "text": "„Het congrescentrum ligt twee meter onder zeeniveau”, zegt hij."
                            },
                            {
                                "example_id": "a9a1225b-bef0-4e21-9f42-304ade0256f1",
                                "sense_id": "ab01d1c0-4bbd-3a22-b8e2-1b447ed6f225",
                                "text": "Langs de hele kuststrook verrees een uitgebreide infrastructuur om toeristen en grote evenementen te lokken: pretparken, hotels, vakantieresorts met golfbanen, culturele megacomplexen, congrescentra, een F1-circuit en een vliegveld."
                            }
                        ]
                    },
                    {
                        "sense_id": "be732370-1d07-3b81-9cc1-d7d99ba5db9b",
                        "entry_id": "a819736b-a9c8-3924-9cec-798872dceb57",
                        "glosses": [
                            "onderneming die een gebouw en personeel aanbiedt waar vergaderingen en andere bijeenkomsten kunnen worden gehouden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9519ba4-6736-4fec-b2e1-5a10cc428c18",
                                "sense_id": "be732370-1d07-3b81-9cc1-d7d99ba5db9b",
                                "text": "Zo kan hij bezoekers laten zien dat het instituut ook een grote bibliotheek heeft, een congrescentrum en afdelingen waar onderzoek wordt gedaan naar onder meer duurzame ontwikkeling, landbouw en gezondheidszorg."
                            },
                            {
                                "example_id": "89936495-67bc-47bc-b26c-179458c99854",
                                "sense_id": "be732370-1d07-3b81-9cc1-d7d99ba5db9b",
                                "text": "Congrescentrum RAI Amsterdam gaat zo’n 30 procent van de banen schrappen omdat het zwaar te lijden heeft onder de coronacrisis."
                            },
                            {
                                "example_id": "54818ddd-f181-42cd-9400-e5b0af3ea7f2",
                                "sense_id": "be732370-1d07-3b81-9cc1-d7d99ba5db9b",
                                "text": "Dat betekent dat ook kerken en congrescentra weer grotere bijeenkomsten kunnen organiseren, zoals bruiloften"
                            }
                        ]
                    }
                ],
