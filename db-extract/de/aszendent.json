                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ascendant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "19f17a8a-2d99-399e-8d76-6c409b954394",
                                        "entry_id": "c616a493-5f89-3f81-942d-a2199b39f12c",
                                        "glosses": [
                                            "Qui va en montant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1efbf09f-bb15-461a-a2c3-ec882a642609",
                                                "sense_id": "19f17a8a-2d99-399e-8d76-6c409b954394",
                                                "text": "Les flux présentent un cycle annuel où se succèdent une phase d'écoulement en direction de la nappe, et une phase ascendante quand l'évapotranspiration devient supérieure aux précipitations."
                                            },
                                            {
                                                "example_id": "1551e6ee-7fa1-4c5e-b62b-f33168815e13",
                                                "sense_id": "19f17a8a-2d99-399e-8d76-6c409b954394",
                                                "text": "Or, elle ne ménage encore que rarement des années semi-sabbatiques à mi-temps, préludant aux changements de carrière et favorisant la mobilité sociale ascendante ou transverse."
                                            },
                                            {
                                                "example_id": "27232206-973c-4e9f-a957-f5ec8a494ea6",
                                                "sense_id": "19f17a8a-2d99-399e-8d76-6c409b954394",
                                                "text": "aorte ascendante, muscle oblique ascendant, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "520ff607-d951-3b86-bcfb-fb99bb327b60",
                                        "entry_id": "c616a493-5f89-3f81-942d-a2199b39f12c",
                                        "glosses": [
                                            "Se dit d'un organe, généralement la tige, couché à sa base puis se redressant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc62b853-303f-3d73-b552-cd1a4150400a",
                                        "entry_id": "c616a493-5f89-3f81-942d-a2199b39f12c",
                                        "glosses": [
                                            "Se dit des astres qui montent sur l’horizon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f41d2275-277d-4be1-a1e1-6fad00269244",
                                                "sense_id": "cc62b853-303f-3d73-b552-cd1a4150400a",
                                                "text": "Les astrologues prétendaient que le point ascendant avait beaucoup d’influence sur la naissance des hommes et sur les évènements de leur vie."
                                            },
                                            {
                                                "example_id": "f9545fe2-a5d2-4965-8f86-ec3deae3befa",
                                                "sense_id": "cc62b853-303f-3d73-b552-cd1a4150400a",
                                                "text": "Latitude ascendante."
                                            },
                                            {
                                                "example_id": "d922c86d-dd82-419a-83f8-a19c5531e69c",
                                                "sense_id": "cc62b853-303f-3d73-b552-cd1a4150400a",
                                                "text": "Nœud ascendant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44a1c6a1-c960-357c-8baa-0970a51d759c",
                                        "entry_id": "c616a493-5f89-3f81-942d-a2199b39f12c",
                                        "glosses": [
                                            "Désigne une personne d'une génération précédente en ligne directe."
                                        ],
                                        "tags": [
                                            "Généalogie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ac59d70-7fd7-4302-adca-8fa0093eb265",
                                                "sense_id": "44a1c6a1-c960-357c-8baa-0970a51d759c",
                                                "text": "Ligne ascendante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df688c57-e7cf-32e0-80ea-91e7416c8674",
                                        "entry_id": "c616a493-5f89-3f81-942d-a2199b39f12c",
                                        "glosses": [
                                            "Se dit d'une démarche qui se fonde sur des données, des observations ou des résultats concrets pour aboutir à une explication ou à une modélisation conceptuelle."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ascendant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40196f33-fcff-3097-b52b-8c4469a04606",
                                        "entry_id": "4361f82e-939d-3cd4-8632-78161fdea84b",
                                        "glosses": [
                                            "Définit une personne d’une génération précédente en ligne directe : père, mère, grand-père, grand-mère, etc."
                                        ],
                                        "tags": [
                                            "Famille"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9016041a-0a0c-4f07-a7ff-a2e06c470b3f",
                                                "sense_id": "40196f33-fcff-3097-b52b-8c4469a04606",
                                                "text": "Les registres de Mièges, près de Nozeroy, contiennent, à la date du 9 février 1682, l'acte de mariage d'un Denis Pasteur et de Jeanne David. Ce Denis, — qui dans la série des ascendants de Pasteur permet de ne plus perdre de vue la destinée de la famille, — habita le village de Plénisette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b4eec08-b395-36d0-b86a-26a4c70d2aa7",
                                        "entry_id": "4361f82e-939d-3cd4-8632-78161fdea84b",
                                        "glosses": [
                                            "Pouvoir, influence que l'on exerce sur une autre personne grâce à une position hiérarchique ou sociale, force physique, ou stature psychologique supérieure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0df0b509-66d1-4c61-8583-8f5abf2b04f9",
                                                "sense_id": "4b4eec08-b395-36d0-b86a-26a4c70d2aa7",
                                                "text": "Leur vue a sur notre zèle\nUn ascendant trop puissant."
                                            },
                                            {
                                                "example_id": "80956b58-5e27-4c0e-a196-b4b8925e20fb",
                                                "sense_id": "4b4eec08-b395-36d0-b86a-26a4c70d2aa7",
                                                "text": "Cette étrangère n’avait qu’à paraître pour apprivoiser les plus récalcitrants et le quinquagénaire Bernage subit comme les autres l’ascendant de sa beauté."
                                            },
                                            {
                                                "example_id": "0f6e58ef-ef76-4e77-8687-9de64cc652c8",
                                                "sense_id": "4b4eec08-b395-36d0-b86a-26a4c70d2aa7",
                                                "text": "Pour la première fois, il prit conscience de l’ascendant qu’il exerçait sur les autres, et de la puissance vraiment extraordinaire avec laquelle il imposait ses décisions."
                                            },
                                            {
                                                "example_id": "5d74bd69-5d06-460b-afad-344175bcbaca",
                                                "sense_id": "4b4eec08-b395-36d0-b86a-26a4c70d2aa7",
                                                "text": "Avoir l'ascendant psychologique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27fc7564-fcc7-3785-a54e-4109c8729fb6",
                                        "entry_id": "4361f82e-939d-3cd4-8632-78161fdea84b",
                                        "glosses": [
                                            "Point d’intersection vers l’est, entre l’horizon et l’écliptique. L’horizon et l’écliptique ont un second point d’intersection vers l’ouest appelé point descendant. C’est une précision donnée après le signe zodiacal."
                                        ],
                                        "tags": [],
                                        "note": "on l’écrit parfois avec une majuscule initiale",
                                        "examples": [
                                            {
                                                "example_id": "73f507af-fbc2-4d3d-b14a-1e9b26d8e9b4",
                                                "sense_id": "27fc7564-fcc7-3785-a54e-4109c8729fb6",
                                                "text": "Je suis Taureau, ascendant Lion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de24b986-9004-34c6-95aa-1cc1492ff301",
                                        "entry_id": "4361f82e-939d-3cd4-8632-78161fdea84b",
                                        "glosses": [
                                            "Influence supposée des astres sur le destin des êtres humains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd45dc50-2bf8-4653-a2ef-d91bb8568253",
                                                "sense_id": "de24b986-9004-34c6-95aa-1cc1492ff301",
                                                "text": "[…]\n Quel astre d’ire et d’envie,\nQuand vous naissiez, marquoit votre ascendant,\nQue votre courage endurci,\nPlus je le supplie, moins ait de merci ?"
                                            },
                                            {
                                                "example_id": "89935884-85ba-4d3f-912b-0e008fc68ed0",
                                                "sense_id": "de24b986-9004-34c6-95aa-1cc1492ff301",
                                                "text": "Il avait vraisemblablement interrogé sa mère pour connaître son ascendant, Gémeaux, et pour déterminer l’emplacement du Soleil, de Mercure et de Jupiter à l’heure de sa venue au monde."
                                            }
                                        ]
                                    }
                                ]
                            },
