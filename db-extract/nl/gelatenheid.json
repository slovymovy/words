                "forms": [],
                "senses": [
                    {
                        "sense_id": "c2d6537c-4b32-33cb-899f-44649c4b8a82",
                        "entry_id": "7b35bbbf-4f62-320b-93cd-9ddeb5c019a0",
                        "glosses": [
                            "geestestoestand waardoor men een onaangename situatie alleen door doffe aanvaarding kan accepteren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ca7c2d0-03c1-4512-9bf7-0f2186080ab6",
                                "sense_id": "c2d6537c-4b32-33cb-899f-44649c4b8a82",
                                "text": "Ooit had de gedachte haar met opwinding vervuld, nu was er gelatenheid over die gemiste kans. Ónzin, Reid. Ik ben een goede verpleegster. Ik heb daarbuiten alleen lagere school. Ze zien me aankomen op de universiteit.'"
                            },
                            {
                                "example_id": "2be4ff55-e68d-4dc5-a819-2d778b990fd1",
                                "sense_id": "c2d6537c-4b32-33cb-899f-44649c4b8a82",
                                "text": "Terwijl de VN in een spoedzitting bijeen is om over de situatie in Mali te overleggen, overheerst in de hoofdstad Bamako gelatenheid. \"Mensen op straat zeggen: tsja, Mali. Dit gaat nog zes keer gebeuren\", zegt antropoloog en Mali-deskundige Mirjam de Bruijn vanuit Bamako."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40b3df27-0243-42c2-887f-4360245624d4",
                        "source_entry_id": "7b35bbbf-4f62-320b-93cd-9ddeb5c019a0",
                        "source_sense_id": "c2d6537c-4b32-33cb-899f-44649c4b8a82",
                        "source_sense_description": "geestestoestand waardoor men een onaangename situatie alleen door doffe...",
                        "target_lang_word": "meekness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meekness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b66f448-7430-3f12-ac7c-6b028063cc8a",
                                        "entry_id": "f4c8aab2-537d-3c1b-8917-91a704977393",
                                        "glosses": [
                                            "The state or quality of being meek."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a4d4688-f867-4921-94eb-a8af47c3197e",
                                                "sense_id": "5b66f448-7430-3f12-ac7c-6b028063cc8a",
                                                "text": "But thou, O man of God, flie these things; and follow after righteousnesse, godlinesse, faith, loue, patience, meekenesse."
                                            },
                                            {
                                                "example_id": "f9bab15d-9529-488c-a3b9-4f0bcb64c54a",
                                                "sense_id": "5b66f448-7430-3f12-ac7c-6b028063cc8a",
                                                "text": "Nor could Pym fail to notice that his old friend in rendering account of himself assumed the familiar meekness of the displaced person in the presence of his betters."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7180636e-7148-47dc-a215-7a6d08c58046",
                        "source_entry_id": "7b35bbbf-4f62-320b-93cd-9ddeb5c019a0",
                        "source_sense_id": "c2d6537c-4b32-33cb-899f-44649c4b8a82",
                        "source_sense_description": "geestestoestand waardoor men een onaangename situatie alleen door doffe...",
                        "target_lang_word": "acquiescence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acquiescence",
