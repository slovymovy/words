                        "glosses": [
                            "Resembling or characteristic of pepper, especially in having a spicy taste."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "53afa536-b67b-3b30-a475-6accc5c4a0f6",
                        "entry_id": "c2a35d04-2577-30b0-8e8c-c784117a40c2",
                        "glosses": [
                            "Having a fiery temperament."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "55aa74db-8da5-4273-ac29-83a99392c8fc",
                                "sense_id": "53afa536-b67b-3b30-a475-6accc5c4a0f6",
                                "text": "a peppery old Army major"
                            },
                            {
                                "example_id": "369f563e-495d-48a1-984c-3ee349cecd52",
                                "sense_id": "53afa536-b67b-3b30-a475-6accc5c4a0f6",
                                "text": "At the Stag and Antlers old Mrs. Crocket, than whom no old woman in the public line was ever more generous, more peppery, or more kind, kept two clean bedrooms, and could cook a leg of Dartmoor mutton and make an apple pie against any woman in Devonshire."
                            },
                            {
                                "example_id": "42475aaa-5ae1-406f-a5b4-685b5f16651b",
                                "sense_id": "53afa536-b67b-3b30-a475-6accc5c4a0f6",
                                "text": "For I'm a peppery potentate, / Who's little inclined his claim to bate, / To fit the wit of a bit of a chit, / And that's the long and short of it!"
                            },
                            {
                                "example_id": "21bb2c9c-d326-4a62-ae02-f08cc0337f86",
                                "sense_id": "53afa536-b67b-3b30-a475-6accc5c4a0f6",
                                "text": "\"If Lord John Roxton would condescend----\" \"My dear George, don't be so peppery,\" said his wife, with her hand on the black mane that drooped over the microscope."
                            }
                        ]
                    }
                ],
                "translations": [
