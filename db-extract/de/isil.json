                                                "example_id": "617bfa95-44fd-49e1-9b64-6bb5e37075de",
                                                "sense_id": "bf48f68d-0cae-398a-8221-6adad895bb87",
                                                "text": "Despite territorial defeats in Iraq and Syria, ISIS continues to draw support from HVEs in the United States and the group’s global calls for attacks have intensified since the death last year of senior leader Abu Bakr al-Baghdadi."
                                            },
                                            {
                                                "example_id": "fe21ff98-f57a-4c69-925a-23ad6d5065c0",
                                                "sense_id": "bf48f68d-0cae-398a-8221-6adad895bb87",
                                                "text": "Terror groups linked to al Qaeda and ISIS have been active in Niger for years."
