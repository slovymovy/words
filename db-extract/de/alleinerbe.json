                "senses": [
                    {
                        "sense_id": "3e520a15-b30e-3a4a-aec9-ac8d97c02082",
                        "entry_id": "103741b8-853a-3ab8-929b-439f285ad942",
                        "glosses": [
                            "(männliche^☆) Person, auf die das gesamte Vermögen des Erblassers mit dem Erbfall übergeht, die also dessen einziger Erbe ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6eec98e5-36e5-4741-86a4-fa82566f3ed9",
                                "sense_id": "3e520a15-b30e-3a4a-aec9-ac8d97c02082",
                                "text": "Frau Jensen hat Onkel Willi zu ihrem testamentarischen Alleinerben gemacht."
                            },
                            {
                                "example_id": "b19adb92-740d-40cc-ab15-aa6dbe5e69cb",
                                "sense_id": "3e520a15-b30e-3a4a-aec9-ac8d97c02082",
                                "text": "Zwar war Pankratz Alleinerbe seines Vaters, er war aber mit einer Vielzahl von Vermächtnissen beschwert."
                            },
                            {
                                "example_id": "d4420dbb-8649-4743-ac78-bb3ad9e3a0b0",
                                "sense_id": "3e520a15-b30e-3a4a-aec9-ac8d97c02082",
                                "text": "„Der Mann wurde auf Basis des Testaments Alleinerbe und erhielt die Eigentumswohnung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
