                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a4cbbca5-310b-3aaf-acec-9418ce00e57a",
                    "sense_definition": "Alternative form of <w>thuris</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient recipe called for a measure of <w>thus</w> to be added to the mixture.",
                            "target_lang_translations": {
                                "ru": "Древний рецепт требовал добавить в смесь меру <w>ла́дана</w>.",
                                "tr": "Eski tarif, karışıma bir miktar <w>buhur</w> eklenmesini gerektiriyordu.",
                                "es": "La antigua receta requería añadir una medida de <w>incienso</w> a la mezcla.",
                                "zh": "古老的配方要求在混合物中加入一定量的<w>乳香</w>。"
                            }
                        },
                        {
                            "text": "He collected the hardened <w>thus</w> from the pine trees to use as incense.",
                            "target_lang_translations": {
                                "ru": "Он собирал затвердевший <w>ла́дан</w> с сосен, чтобы использовать его как благовоние.",
                                "tr": "Çam ağaçlarından sertleşmiş <w>günlük reçinesini</w> tütsü olarak kullanmak üzere topladı.",
                                "es": "Recogió el <w>incienso</w> endurecido de los pinos para usarlo como sahumerio.",
                                "zh": "他从松树上收集了硬化的<w>乳香</w>用作香料。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative form"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ладан (ароматическая смола); устаревшее название.",
                        "tr": "Akgünlük, buhur (eski dilde tütsü reçinesi).",
                        "es": "Nombre arcaico para el incienso o resina aromática.",
                        "zh": "乳香（一种芳香树脂），古语用法。"
                    },
                    "translations": {
                        "ru": [
