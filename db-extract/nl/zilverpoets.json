                        "glosses": [
                            "schoonmaakmiddel waarmee men zilveroxide van een zilveren voorwerp kan verwijderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "579b881a-bb23-4e10-9f99-5e37bf325007",
                                "sense_id": "341d86c3-96b0-33b9-af1d-931baacf2d21",
                                "text": "Een doekje met zilverpoets is de finishing touch, daarna mag de KNVB deze door FC Utrecht en Feyenoord zo felbegeerde trofee naar de Kuip vervoeren."
                            },
                            {
                                "example_id": "dec76ae0-37dd-402f-aa69-4824b65225b0",
                                "sense_id": "341d86c3-96b0-33b9-af1d-931baacf2d21",
                                "text": "Heb je geen zin om je zilveren bestek stuk voor stuk te poetsen met een doekje met zilverpoets? Los dan drie eetlepels soda of keukenzout in een teiltje warm water op, leg een stuk aluminiumfolie zilver de bodem en leg het bestek er tien minuten op. Het zout/soda en de folie gaan een reactie aan, waardoor het zilveroxide (die lelijke zwarte aanslag) wordt verwijderd."
                            }
                        ]
                    }
