                    },
                    {
                        "translation_id": "dff419be-69b1-4724-b916-b038aa27e3f8",
                        "source_entry_id": "f90654f3-de6c-37fd-9aa0-36f588fd5e5f",
                        "source_sense_id": "fa5eb5d9-a26a-34a8-98c1-61e9ed373d6a",
                        "target_lang_word": "petit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "petit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "92fb5951-9b93-3046-aafa-7cd95012c5ca",
                                        "entry_id": "9e6c284a-9de8-31d5-bb99-fa505b9f6ee4",
                                        "glosses": [
                                            "De taille réduite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce5e56d6-64a9-4979-be63-c05eb8a56448",
                                                "sense_id": "92fb5951-9b93-3046-aafa-7cd95012c5ca",
                                                "text": "Un petit caillou."
                                            },
                                            {
                                                "example_id": "2048a591-b28c-400b-9e56-65a0d177602f",
                                                "sense_id": "92fb5951-9b93-3046-aafa-7cd95012c5ca",
                                                "text": "C’est un homme de petite taille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a1bf4a5-944d-33b7-a744-4d807496f5d2",
                                        "entry_id": "9e6c284a-9de8-31d5-bb99-fa505b9f6ee4",
                                        "glosses": [
                                            "Jeune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae065cda-797f-4311-9b19-d6a36cc90396",
                                                "sense_id": "0a1bf4a5-944d-33b7-a744-4d807496f5d2",
                                                "text": "Quand j’étais petit, je jouais souvent à la balle."
                                            },
                                            {
                                                "example_id": "10b39cc7-ca8d-4baf-a9cb-d5b93340e32c",
                                                "sense_id": "0a1bf4a5-944d-33b7-a744-4d807496f5d2",
                                                "text": "La vieille devait être beaucoup plus grande quand elle était petite."
                                            },
                                            {
                                                "example_id": "285fdc8d-b118-441a-b317-e3daa0392f3b",
                                                "sense_id": "0a1bf4a5-944d-33b7-a744-4d807496f5d2",
                                                "text": "Par contre, la grande gueule, celui qui balance les « krèles », je le connais. Il tape sa petite sœur. La gamine a déjà fait trois séjours à l’hosto."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beeda40b-2012-37b9-a140-c1186c79eb21",
                                        "entry_id": "9e6c284a-9de8-31d5-bb99-fa505b9f6ee4",
                                        "glosses": [
                                            "Mesquin ; médiocre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e31b3d24-f053-4bec-b407-f812e6915a42",
                                                "sense_id": "beeda40b-2012-37b9-a140-c1186c79eb21",
                                                "text": "Ah ! Ce que tu dis est vraiment petit !"
                                            },
                                            {
                                                "example_id": "7818ae56-3bdd-40bf-9a74-9bed44c8c0ba",
                                                "sense_id": "beeda40b-2012-37b9-a140-c1186c79eb21",
                                                "text": "M. le prince lui répondit fièrement qu’il était las de rendre compte de ses actions à de petits messieurs comme lui, qui en jugeraient à leur mode."
                                            },
                                            {
                                                "example_id": "c306829c-0c32-4ec6-9b8b-bf6dcba909f1",
                                                "sense_id": "beeda40b-2012-37b9-a140-c1186c79eb21",
                                                "text": "Les moyennes calculées portent sur l’année de calendrier et ne comprennent que du cidre de bonne qualité à l’exclusion du petit cidre et de l’« halbi », boisson fabriquée avec des pommes et des poires. Il en est de même pour le poiré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07adfbad-722c-349b-9ea5-f315fc2480d7",
                                        "entry_id": "9e6c284a-9de8-31d5-bb99-fa505b9f6ee4",
                                        "glosses": [
                                            "Qui est peu élevé en quantité, qui n’atteint pas la mesure ordinaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e64f222-a135-46b1-a837-3a3d75ab0c79",
                                                "sense_id": "07adfbad-722c-349b-9ea5-f315fc2480d7",
                                                "text": "Les Spartiates étaient petits en nombre, grands de cœur, ambitieux et violents ; de fausses lois n’en aurait tiré que de pâles coquins ; Lycurgue en fit d’héroïques brigands."
                                            },
                                            {
                                                "example_id": "3ab98a7a-9584-4fe0-9b14-e164411fbb26",
                                                "sense_id": "07adfbad-722c-349b-9ea5-f315fc2480d7",
                                                "text": "Un petit nombre de convives a repris du dessert."
                                            },
                                            {
                                                "example_id": "9bf6135a-8745-437c-ba72-2249c08b5b79",
                                                "sense_id": "07adfbad-722c-349b-9ea5-f315fc2480d7",
                                                "text": "Il me faudra encore une petite heure pour arriver à Lyon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b4eddb6-e435-3b62-b234-c7dde4a4cfaf",
                                        "entry_id": "9e6c284a-9de8-31d5-bb99-fa505b9f6ee4",
                                        "glosses": [
                                            "En raccourci, en miniature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de1f1389-f8be-46e1-9d91-c830da10853b",
                                                "sense_id": "2b4eddb6-e435-3b62-b234-c7dde4a4cfaf",
                                                "text": "Cette ville est un petit paris."
                                            },
                                            {
                                                "example_id": "faca3f56-8b95-4922-8c1b-4100713dbb33",
                                                "sense_id": "2b4eddb6-e435-3b62-b234-c7dde4a4cfaf",
                                                "text": "D'autres immigrants venus de pays plus lointains ont pris racine au Québec, essentiellement dans la région montréalaise où se sont multipliés les quartiers que l'on baptise par les pays d'origine d'une partie de leur population : Petite Italie, Petit Haïti, Petite Grèce, Petite Portugal, Petit Liban, Petit Maghreb. Pour la même raison Trois-Rivières a eu sa Petite Pologne où vivaient de nombreux Polonais embauchés à l'usine de textile Wabasso."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c97a92e1-9b19-352a-8b5c-569dca81c50a",
                                        "entry_id": "9e6c284a-9de8-31d5-bb99-fa505b9f6ee4",
                                        "glosses": [
                                            "Marque d’affection."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "832a93c2-11e9-4918-9c8b-081dd8c27267",
                                                "sense_id": "c97a92e1-9b19-352a-8b5c-569dca81c50a",
                                                "text": "Mon petit mari."
                                            },
                                            {
                                                "example_id": "f95b2ffa-d1a3-4b26-a9ba-0d5acdc7ca92",
                                                "sense_id": "c97a92e1-9b19-352a-8b5c-569dca81c50a",
                                                "text": "Chère petite."
                                            },
                                            {
                                                "example_id": "73f54197-6caa-4243-9490-10b8291984e3",
                                                "sense_id": "c97a92e1-9b19-352a-8b5c-569dca81c50a",
                                                "text": "En voyant entrer Lucien, M. Berchu père dit à sa femme, personne énorme de cinquante à soixante ans :\n— Ma petite, offre une tasse de thé à M. Leuwen.\nComme madame Berchu n’écoutait pas, M. Berchu répéta deux fois sa phrase avec ma petite."
                                            },
                                            {
                                                "example_id": "084def25-f4ea-4729-94ad-efd989a4a1b2",
                                                "sense_id": "c97a92e1-9b19-352a-8b5c-569dca81c50a",
                                                "text": "— Ma petite, dit-elle, car elles se traitaient mutuellement de ma petite, pourquoi ne m’avez-vous pas encore présenté votre amoureux ?…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db28b734-2873-3102-b2d1-10d5ccdaca02",
                                        "entry_id": "9e6c284a-9de8-31d5-bb99-fa505b9f6ee4",
                                        "glosses": [
                                            "Marque de rabaissement."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "789644e5-d5b7-4676-93af-e7159b9ba9d9",
                                                "sense_id": "db28b734-2873-3102-b2d1-10d5ccdaca02",
                                                "text": "Et ce petit imbécile prétentieux qui nous raconte tout sur une Chine qu’il ne connaît pas ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17c42b49-f0cf-347c-a2a5-b28f2f5580b5",
                                        "entry_id": "9e6c284a-9de8-31d5-bb99-fa505b9f6ee4",
                                        "glosses": [
                                            "Négligeable, dont on peut s’abstenir de tenir compte dans les calculs sans qu'ils soient significativement altérés."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31837f16-2f87-3c9f-96af-5b47f90689a6",
                                        "entry_id": "9e6c284a-9de8-31d5-bb99-fa505b9f6ee4",
                                        "glosses": [
                                            "Appel adressé à un jeune garçon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c960a10-3680-460b-9610-a2200e517eea",
                                                "sense_id": "31837f16-2f87-3c9f-96af-5b47f90689a6",
                                                "text": "Non, bien certainement, il n’y a plus aujourd’hui des couchers de soleils comme ceux-là… Quand ils s’annonçaient plus spécialement magnifiques ou extraordinaires, et que je n’y étais pas, tante Berthe, qui n’en manquait pas un, m’appelait en hâte : « Petit !… petit !… viens vite ! »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e09915fd-29e5-3a35-9831-b0508099ec45",
                                        "entry_id": "9e6c284a-9de8-31d5-bb99-fa505b9f6ee4",
                                        "glosses": [
                                            "Appel répété lancé aux volailles d'une basse-cour pour les rassembler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bf33c4a-0b78-4978-9eb9-030a3bcd4279",
                                                "sense_id": "e09915fd-29e5-3a35-9831-b0508099ec45",
                                                "text": "Petits ! Petits !"
                                            },
                                            {
                                                "example_id": "962734a8-ef83-4f64-a9d1-25441cbb069f",
                                                "sense_id": "e09915fd-29e5-3a35-9831-b0508099ec45",
                                                "text": "La maman donna à manger aux pigeons sans appeler : petits, petits ; elle jetait les graines comme ça, de loin, d’ailleurs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "petit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "209009c5-af44-3e1c-8436-cd11475739ff",
