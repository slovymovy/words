                    },
                    {
                        "translation_id": "1f33d4d9-e1ab-449d-945a-5eb8a44f82c6",
                        "source_entry_id": "edf01796-8764-3583-a0cc-622cd0825644",
                        "source_sense_id": "bc655808-69d9-32c3-ae4a-1b69e620682b",
                        "target_lang_word": "Édouard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Édouard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b5bfd133-1b18-3150-b161-541d389cfe69",
                                        "entry_id": "77c1b983-f038-3f58-9821-34aa510e2323",
                                        "glosses": [
                                            "Prénom masculin français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6483fabe-c1fe-43fd-8711-ea133182ebd0",
                                                "sense_id": "b5bfd133-1b18-3150-b161-541d389cfe69",
                                                "text": "Édouard fume le cigare\nEt Léonard porte une barbe noire\nLéontine fait la cuisine\nMonsieur Gaston s’occupe du téléfon."
                                            },
                                            {
                                                "example_id": "b7d2b4a7-8de6-48f0-b33a-72d7aba331b7",
                                                "sense_id": "b5bfd133-1b18-3150-b161-541d389cfe69",
                                                "text": "L’idée de construire des pavillons à partir de terre crue, grâce à une impression 3D, a valu sa sélection à Édouard François."
                                            },
                                            {
                                                "example_id": "1e4fd899-e190-4938-bedf-f40b95e05710",
                                                "sense_id": "b5bfd133-1b18-3150-b161-541d389cfe69",
                                                "text": "Édouard boutonna son duffle-coat et traversa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b2a11a7-e74b-3f31-8604-43a824788f3d",
                                        "entry_id": "77c1b983-f038-3f58-9821-34aa510e2323",
                                        "glosses": [
                                            "Prénom francisé de plusieurs rois d’Angleterre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "befcb690-6452-44c7-b8e5-f9f7a5fdfcfa",
                                                "sense_id": "4b2a11a7-e74b-3f31-8604-43a824788f3d",
                                                "text": "Les cheveux sont blonds, - de ce blond familier aux filles de Normandie, qui a la couleur du blé mûr noirci par l'âpre chaleur solaire d'Août, et qui attend la faucille. Eux, ces cheveux mûrs aussi, mais pour une autre faucille, ne l'ont pas attendue longtemps ! Elle les porte courts, carrément coupés sur le front, avec deux lourdes touffes, sans frisure, tombant des deux côtés des joues, - à peu près comme les Enfants d'Édouard dans le célèbre tableau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
