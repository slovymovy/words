                ],
                "senses": [
                    {
                        "sense_id": "e042e244-95d5-3682-a483-b8a8624610f5",
                        "entry_id": "ff63e7ca-79e8-345a-adac-f8c5d9fc99e4",
                        "glosses": [
                            "Sonner comme un gong."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d08c8945-2897-493e-a508-56cdd1dfdaa3",
                                "sense_id": "e042e244-95d5-3682-a483-b8a8624610f5",
                                "text": "L’heure H venait de gonguer."
                            },
                            {
                                "example_id": "0c10f6a1-9e36-4a12-8536-d2b4eb43418b",
                                "sense_id": "e042e244-95d5-3682-a483-b8a8624610f5",
                                "text": "Les jours à papier sont finis… Elle est morte la rumination… les noircissages de balivernes ! Y a qu’à entendre le destin qui gongue là, que c’est le bacchanal qui bascule, que va falloir fuir à tire-d’aile."
                            }
                        ]
                    },
                    {
                        "sense_id": "9bbfd71c-50a4-351b-95d5-3a32bb6a3874",
                        "entry_id": "ff63e7ca-79e8-345a-adac-f8c5d9fc99e4",
                        "glosses": [
                            "Annoncer en sonnant un gong."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2bbcdab8-3d7d-4114-be2e-8b320b520553",
                                "sense_id": "9bbfd71c-50a4-351b-95d5-3a32bb6a3874",
                                "text": "Mais on a gongué le dîner depuis longtemps."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c94e2cc-4aa4-3bcc-abe4-6ba07d4078c2",
                        "entry_id": "ff63e7ca-79e8-345a-adac-f8c5d9fc99e4",
                        "glosses": [
                            "Sonner un gong d’avertissement, sur un véhicule, généralement un tram."
                        ],
                        "tags": [
                            "especially",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b58731c6-5777-4cfd-8b9f-029097c5502f",
                                "sense_id": "7c94e2cc-4aa4-3bcc-abe4-6ba07d4078c2",
                                "text": "À l’adresse des ados notamment, à qui il est demandé d’éteindre leurs MP3 quand ils traversent les rails sous peine de ne pas entendre le tram « gonguer », autrement dit klaxonner."
                            },
                            {
                                "example_id": "5e1547d2-bbc8-42c2-9af0-3cca4784cfe3",
                                "sense_id": "7c94e2cc-4aa4-3bcc-abe4-6ba07d4078c2",
                                "text": "«Le conducteur du tramway a “gongué” pour se signaler. La personne a tourné la tête vers le tram mais a continué à traverser. …»"
                            }
                        ]
                    }
                ],
