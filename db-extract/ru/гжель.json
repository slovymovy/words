                    },
                    {
                        "translation_id": "6bace231-2d58-4cb1-a8ff-560be979c12f",
                        "source_entry_id": "c6d05fbd-4ac4-344d-a986-e40c55cd8ada",
                        "source_sense_id": "a7a179e4-c605-3c57-9fff-c1b8e095295a",
                        "target_lang_word": "porcelaine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "porcelaine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32b59252-d13d-3b27-9ebc-8f87efbe8111",
                                        "entry_id": "23cdff89-c9c9-38de-8700-1e1d1b314c60",
                                        "glosses": [
                                            "Cyprée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "976ef373-e9d4-40bd-9e56-78865fc44bda",
                                                "sense_id": "32b59252-d13d-3b27-9ebc-8f87efbe8111",
                                                "text": "En juin 1611, environ deux cents Hurons et Algonquins se rendirent aux rapides de Lachine pour rencontrer Champlain et Gravé du Pont et leur remettre en secret : « 50 castors & 4 carquans de leurs porcelaines (qu’ils estiment entre eux comme nous faisons les chaisnes d’or)"
                                            },
                                            {
                                                "example_id": "3ed113e7-eb3d-4905-8895-047406f211a5",
                                                "sense_id": "32b59252-d13d-3b27-9ebc-8f87efbe8111",
                                                "text": "Nous avions aussi la pêche au corail sur le récif. — Rarahu m’accompagnait souvent en pirogue dans ces excursions, où nous fouillions l’eau tiède et bleue, à la recherche de madrépores rares ou de porcelaines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74fc00a7-fb10-3f38-a93f-a29bc8a42b9a",
                                        "entry_id": "23cdff89-c9c9-38de-8700-1e1d1b314c60",
                                        "glosses": [
                                            "Céramique blanche, très fine et qui sert à fabriquer des vases, des assiettes et des ustensiles divers."
                                        ],
                                        "tags": [
                                            "Céramique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbff3a97-cf66-4b31-8e05-57785eccfae7",
                                                "sense_id": "74fc00a7-fb10-3f38-a93f-a29bc8a42b9a",
                                                "text": "On voyait un petit Dunkerque assez bien garni, des jardinières en porcelaine chinoise luxueusement montées."
                                            },
                                            {
                                                "example_id": "e45759a9-d262-4a2a-8700-a3bcf9a6aa63",
                                                "sense_id": "74fc00a7-fb10-3f38-a93f-a29bc8a42b9a",
                                                "text": "Puis en regard, sur un socle, il vit un vase de porcelaine de Sèvres sur lequel était gravé : donné par madame la Dauphine."
                                            },
                                            {
                                                "example_id": "8df849c5-5eee-43d8-afbf-062f07907d50",
                                                "sense_id": "74fc00a7-fb10-3f38-a93f-a29bc8a42b9a",
                                                "text": "La porcelaine, cette matière céramique la plus parfaite, résulte de la liaison à une température très élevée, de l’infusible kaolin et du fusible feldspath, en une masse homogène."
                                            },
                                            {
                                                "example_id": "1648da3b-5e8c-4629-8204-eadd2ab10abe",
                                                "sense_id": "74fc00a7-fb10-3f38-a93f-a29bc8a42b9a",
                                                "text": "On y fumait du tabac fin dans des pipes de porcelaine, et pour une monnaie de nickel, qui valait à peine un sou, on avait une pinte de bière fraîche, qui moussait doucement dans des pots de grès, sur les tables d’auberge."
                                            },
                                            {
                                                "example_id": "2fbcdc6d-6f24-45e5-bd07-a78e28ac1883",
                                                "sense_id": "74fc00a7-fb10-3f38-a93f-a29bc8a42b9a",
                                                "text": "Des coffres du grenier, elles extraient un service complet de vieille porcelaine d’Arras, blanche aux fleurs bleues, qu’elles tiennent de l’héritage de l’oncle Joachim."
                                            },
                                            {
                                                "example_id": "99f3a724-5456-4d5d-b8f3-d7789a5cf9d3",
                                                "sense_id": "74fc00a7-fb10-3f38-a93f-a29bc8a42b9a",
                                                "text": "D'abord, et surtout, c'était la salle à manger, avec en son milieu une longue table de chêne blond éclairée par une suspension de cuivre habillé d'un abat-jour en porcelaine surmonté d'une grosse boule colorée que l'on appelait « le monte-baisse »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12a83308-f793-3ddd-ab8c-deb7e3814f27",
                                        "entry_id": "23cdff89-c9c9-38de-8700-1e1d1b314c60",
                                        "glosses": [
                                            "Objet en porcelaine."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3766d99a-050f-4120-a31a-b05f68621fe7",
                                                "sense_id": "12a83308-f793-3ddd-ab8c-deb7e3814f27",
                                                "text": "Manicamp, seul. – (Ramassant un des débris.) C’est étonnant comme la porcelaine dure peu dans cette maison… On devrait la couler en bronze… comme les canons…"
                                            },
                                            {
                                                "example_id": "4d4f3807-f10a-4eb1-b33c-9ea07518b4bf",
                                                "sense_id": "12a83308-f793-3ddd-ab8c-deb7e3814f27",
                                                "text": "Un Petit Dunkerque est une sorte de bazar de fines porcelaines et de curiosités artistiques, de charmantes et délicates inutilités , qui en font un bric-à-brac fashionable."
                                            },
                                            {
                                                "example_id": "066c128b-a9c3-484b-b688-e6bc2116997f",
                                                "sense_id": "12a83308-f793-3ddd-ab8c-deb7e3814f27",
                                                "text": "Dans les endroits abrités, je découvrais de petites porcelaines roses, de grands oscabrions dont le dos est protégé par une cuirasse solide composée de pièces mobiles comme celles des anciens brassards ; …"
                                            },
                                            {
                                                "example_id": "9601cd10-cde9-463c-9379-7ea5a5a4b4fe",
                                                "sense_id": "12a83308-f793-3ddd-ab8c-deb7e3814f27",
                                                "text": "Le rémouleur, l’étameur ou le raccommodeur de porcelaine jetaient leur appel ou faisaient retentir une musique à l’aide d’une petite corne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e00dc46f-5b22-3ad7-b32d-0ebc6e2329ff",
                                        "entry_id": "23cdff89-c9c9-38de-8700-1e1d1b314c60",
                                        "glosses": [
                                            "Qui a l'apparence de la porcelaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2ab3aee-7dc0-45c1-b204-42e5039f38e8",
                                                "sense_id": "e00dc46f-5b22-3ad7-b32d-0ebc6e2329ff",
                                                "text": "Alors Déodat oublie tout d’un coup qu’il est facteur, une ivresse guerrière lui monte au cerveau, ses yeux de porcelaine tendre jettent des éclairs funestes."
                                            },
                                            {
                                                "example_id": "829eb802-b11a-4af5-b549-a14f52174323",
                                                "sense_id": "e00dc46f-5b22-3ad7-b32d-0ebc6e2329ff",
                                                "text": "Elle était comme d’habitude impitoyablement maquillée, presque peinte, le rouge à lèvres écarlate et l’ombre à paupières violine soulignaient son teint pâle, sa peau « de porcelaine » comme on dit dans les romans d’Yves Simon."
                                            },
                                            {
                                                "example_id": "7c47a7a9-b710-4a01-bc50-e3b3c0331083",
                                                "sense_id": "e00dc46f-5b22-3ad7-b32d-0ebc6e2329ff",
                                                "text": "La porcelaine surprend par son aspect transparent : mettez une lumière derrière votre objet en porcelaine et vous verrez au travers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9400b930-c874-3f12-bbb1-418f6ad2233c",
                                        "entry_id": "23cdff89-c9c9-38de-8700-1e1d1b314c60",
                                        "glosses": [
                                            "Plante succulente tropicale, originaire du Mexique, décorative, médicinale et dont les feuilles peuvent être mangées."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "18507301-f135-3158-8c94-dd7fe3fa4b35",
                                        "entry_id": "23cdff89-c9c9-38de-8700-1e1d1b314c60",
                                        "glosses": [
                                            "Notodonte porcelaine."
                                        ],
                                        "tags": [
                                            "Lépidoptérologie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
