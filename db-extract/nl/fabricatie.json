                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05e3a157-55d3-4ebc-a7b8-69484a384803",
                                                "sense_id": "10682f86-e26b-38b7-977f-a573d0604299",
                                                "text": "La suppression presque complète de l’oxyde de carbone dans la fabrication du gaz à l’eau, au moyen de la vapeur surchauffée est un fait expérimental qui a donné lieu à diverses interprétations sur lesquelles nous appuierons d’une manière spéciale ; […]."
                                            },
                                            {
                                                "example_id": "5b54acb8-977f-49a5-a2ac-abc43951606c",
                                                "sense_id": "10682f86-e26b-38b7-977f-a573d0604299",
                                                "text": "La fabrication des étoffes de laine, des soieries."
                                            },
                                            {
                                                "example_id": "b3c72048-e8fc-4818-80ac-e7e6e29d76f5",
                                                "sense_id": "10682f86-e26b-38b7-977f-a573d0604299",
                                                "text": "Les procédés qu’on emploie pour cette fabrication."
                                            },
                                            {
                                                "example_id": "6058ccd0-da41-461b-beb3-380ada795203",
                                                "sense_id": "10682f86-e26b-38b7-977f-a573d0604299",
                                                "text": "Frais de fabrication."
                                            },
                                            {
                                                "example_id": "281f5fa3-410b-44b7-9c34-e9ca3e11cf29",
                                                "sense_id": "10682f86-e26b-38b7-977f-a573d0604299",
                                                "text": "La fabrication de la monnaie."
                                            },
                                            {
                                                "example_id": "efccf48a-fb8c-4b5b-b01f-86288275fdb5",
                                                "sense_id": "10682f86-e26b-38b7-977f-a573d0604299",
                                                "text": "La fabrication des monnaies d’or, d’argent, de billon."
                                            },
                                            {
                                                "example_id": "33d3f5a3-ef57-4ba9-865c-47c3ee724fa9",
                                                "sense_id": "10682f86-e26b-38b7-977f-a573d0604299",
                                                "text": "Objet d’une bonne, d’une mauvaise fabrication."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c276139-6a69-33e2-82c7-f47d3cee1d66",
                                        "entry_id": "b586d569-5f9b-3fdf-ba97-34eb3f9dda29",
                                        "glosses": [
                                            "Procédé ou manière de fabriquer quelque chose de façon industrielle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcd1d2af-d004-41dd-aaa5-11cba34e414a",
                                                "sense_id": "9c276139-6a69-33e2-82c7-f47d3cee1d66",
                                                "text": "les processus de fabrication."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ce1855c-159b-32d2-9eda-b717a122d799",
                                        "entry_id": "b586d569-5f9b-3fdf-ba97-34eb3f9dda29",
                                        "glosses": [
                                            "Action de façonner les pensées ou le comportement d’une personne ou d’un groupe de personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fac9f00b-612f-47c1-9b16-8309dcb47aed",
                                                "sense_id": "0ce1855c-159b-32d2-9eda-b717a122d799",
                                                "text": "C’est au cours de ces années quarante que la fabrication d’une star de cinéma en Égypte suit les règles adoptées par le cinéma américain."
                                            },
                                            {
                                                "example_id": "7409c6ca-4002-41d2-9852-e31f91ad080e",
                                                "sense_id": "0ce1855c-159b-32d2-9eda-b717a122d799",
                                                "text": "Les enseignants en gestion participent à la fabrication du consentement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1424a25b-4428-3f25-b4b3-e67c78ff0dc0",
                                        "entry_id": "b586d569-5f9b-3fdf-ba97-34eb3f9dda29",
                                        "glosses": [
                                            "Action d’inventer quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8ea98e4-e5b5-4c67-a247-547cc80aec84",
                                                "sense_id": "1424a25b-4428-3f25-b4b3-e67c78ff0dc0",
                                                "text": "La fabrication de fausses nouvelles."
                                            },
                                            {
                                                "example_id": "49ce584c-1911-4550-aa63-723ea126722c",
                                                "sense_id": "1424a25b-4428-3f25-b4b3-e67c78ff0dc0",
                                                "text": "La fabrication d’un faux acte, d’un faux testament."
                                            }
                                        ]
