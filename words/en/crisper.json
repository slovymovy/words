{
    "word_family": [
        "crisp",
        "crisply",
        "crispness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "848e2255-64e8-3d28-8c6d-749cbb695cf4",
                    "sense_definition": "comparative form of <w>crisp</w>: more crisp",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "crispness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The autumn air felt even <w>crisper</w> than it did yesterday morning.",
                            "target_lang_translations": {
                                "cs": "Podzimní vzduch byl dnes ráno ještě <w>svěžejší</w>, než byl včera."
                            }
                        },
                        {
                            "text": "These crackers are <w>crisper</w> than the ones we bought last week.",
                            "target_lang_translations": {
                                "cs": "Tyto krekry jsou <w>křupavější</w> než ty, které jsme koupili minulý týden."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative adjective"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "2. stupeň přídavného jména crisp: křupavější, svěžejší"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "křupavější",
                                "target_lang_sense_clarification": "ve smyslu textury jídla"
                            },
                            {
                                "target_lang_word": "svěžejší",
                                "target_lang_sense_clarification": "ve smyslu počasí nebo vzduchu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3758a947-fe62-399f-b026-b25e9f72a3c1",
                    "sense_definition": "The section of a refrigerator used to store fruit and vegetables at a slightly higher temperature than the rest of the refrigerator.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "refrigerator_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Put the fresh lettuce in the <w>crisper</w> so it stays fresh longer.",
                            "target_lang_translations": {
                                "cs": "Dej čerstvý salát do <w>přihrádky na zeleninu</w>, aby zůstal déle čerstvý."
                            }
                        },
                        {
                            "text": "I found some old carrots hidden at the bottom of the refrigerator <w>crisper</w>.",
                            "target_lang_translations": {
                                "cs": "Našel jsem nějakou starou mrkev schovanou na dně <w>šuplíku na zeleninu</w> v lednici."
                            }
                        }
                    ],
                    "synonyms": [
                        "salad drawer"
                    ],
                    "common_phrases": [
                        "refrigerator crisper"
                    ],
                    "target_lang_definitions": {
                        "cs": "Přihrádka v chladničce určená pro skladování ovoce a zeleniny"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "přihrádka na zeleninu",
                                "target_lang_sense_clarification": "běžné označení v češtině"
                            },
                            {
                                "target_lang_word": "šuplík na zeleninu",
                                "target_lang_sense_clarification": "hovorové označení"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d832c93-3835-3073-a6d2-988c08b7ef98",
                    "sense_definition": "A cooled food storage container, used to cool items that do not require complete refrigeration.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "refrigerator_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small <w>crisper</w> keeps the fruit cool without freezing it.",
                            "target_lang_translations": {
                                "cs": "Ten malý <w>chladicí box</w> udržuje ovoce v chladu, aniž by ho zmrazil."
                            }
                        },
                        {
                            "text": "Check the <w>crisper</w> to see if the berries are still firm.",
                            "target_lang_translations": {
                                "cs": "Zkontroluj <w>chladicí box</w>, jestli jsou bobule stále pevné."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Chladicí nádoba nebo prostor pro potraviny, které nevyžadují hluboké chlazení"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "chladicí box",
                                "target_lang_sense_clarification": "obecný termín pro chladicí prostor"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e444c478-9d19-30f0-a55b-e2a6a0d3f28d",
                    "sense_definition": "A device for crisping or curling the hair.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hair_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used the old metal <w>crisper</w> to add waves to her hair.",
                            "target_lang_translations": {
                                "cs": "Použila starou kovovou <w>krepovačku</w>, aby si vytvořila ve vlasech vlny."
                            }
                        },
                        {
                            "text": "Modern styling tools have largely replaced the traditional hair <w>crisper</w>.",
                            "target_lang_translations": {
                                "cs": "Moderní stylingové nástroje do značné míry nahradily tradiční <w>krepovačku</w> na vlasy."
                            }
                        }
                    ],
                    "synonyms": [
                        "curler"
                    ],
                    "target_lang_definitions": {
                        "cs": "Nástroj na úpravu vlasů, kulma nebo krepovačka"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "krepovačka",
                                "target_lang_sense_clarification": "nástroj na vytváření vlnitých textur ve vlasech"
                            },
                            {
                                "target_lang_word": "kulma",
                                "target_lang_sense_clarification": "obecnější nástroj na úpravu vlasů"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b73146b-0610-3278-ab12-dbbddfe10464",
                    "sense_definition": "An instrument for making little curls in the nap of cloth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "textile_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The textile worker used a <w>crisper</w> to finish the fabric surface.",
                            "target_lang_translations": {
                                "cs": "Textilní dělník použil <w>krepovací stroj</w> k dokončení povrchu látky."
                            }
                        },
                        {
                            "text": "This antique <w>crisper</w> was once essential for processing fine wool.",
                            "target_lang_translations": {
                                "cs": "Tento starožitný <w>krepovací stroj</w> byl kdysi nezbytný pro zpracování jemné vlny."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Nástroj na vytváření drobných kudrlinek v textiliích"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "krepovací stroj",
                                "target_lang_sense_clarification": "průmyslový nástroj na úpravu tkanin"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}