                "senses": [
                    {
                        "sense_id": "f487995d-c336-3ad6-88dd-b99bd260debe",
                        "entry_id": "c0fdcfe8-2e62-31cd-b00e-c91a10d392c3",
                        "glosses": [
                            "derjenige Teil des Vornamens, der nicht als Rufname verwendet wird"
                        ],
                        "tags": [
                            "Onomastik"
                        ],
                        "examples": [
                            {
                                "example_id": "89784a74-cb90-4571-8baf-fb9fff840db5",
                                "sense_id": "f487995d-c336-3ad6-88dd-b99bd260debe",
                                "text": "„Für den VN oder die übrigen VN, die nicht den RN ausmachen, ist auch der Terminus BeiVN üblich.“"
                            },
                            {
                                "example_id": "532b0e97-c992-4671-acdc-41cf98fda3bb",
                                "sense_id": "f487995d-c336-3ad6-88dd-b99bd260debe",
                                "text": "„Man hat allerdings beobachtet, daß unter amerikanischem Einfluß der Namenstyp Walter F. Müller – mit abgekürztem Beivornamen zwischen Ruf- und Familienname – an Beliebtheit gewonnen hat; …“"
                            },
                            {
                                "example_id": "0553d755-9554-448d-810a-944a1b180714",
                                "sense_id": "f487995d-c336-3ad6-88dd-b99bd260debe",
                                "text": "„In den westlichen Kulturen ist seit dem Mittelalter ein aus einem (oder mehreren) individuellen Tauf- oder Vornamen und einem hereditären Familiennamen bestehendes Namensschema sehr verbreitet. Beispiel:",
                                "translation": "Spitzname: Susi: (Kürzung des Vornamens)“"
                            },
                            {
                                "example_id": "f3f5e58c-6ce3-4dfc-9c44-56d15f054cd7",
                                "sense_id": "f487995d-c336-3ad6-88dd-b99bd260debe",
                                "text": "„In der Entscheidung vom 15. April 1959 (IV ZB 286/58 in NJW 1959, Heft 36, Seite 1581 hat der Bundesgerichtshof festgestellt, daß außer dem Beivornamen Maria für Knaben keine weiblichen Vornamen zulässig sind.“"
                            },
                            {
                                "example_id": "1dfb2e91-56a9-4e65-b136-4a1580c6276b",
                                "sense_id": "f487995d-c336-3ad6-88dd-b99bd260debe",
                                "text": "„Doch gibt es hier eine in der Tradition begründete Ausnahme: Maria darf, auch durch Bindestrich mit dem vorhergehenden Vornamen verbunden, Jungen als besonderer Beivorname gegeben werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
