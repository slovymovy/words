                        "glosses": [
                            "De manière caricaturale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e1f0f87-3526-4073-9b5e-9a8517d93b4e",
                                "sense_id": "4c5aa049-6ba7-3b08-99d3-b6aa7460263f",
                                "text": "Ses yeux doux et tristes semblaient déplorer ce nez caricaturalement bourbonien qui gâtait une figure charmante, quelque effort que l’artiste eût fait pour l’atténuer."
                            }
                        ]
                    }
                ],
