                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6598f855-f52c-4477-b73e-fac1657c87fa",
                        "source_entry_id": "4058566c-a726-35a9-b385-e76f1ff190b4",
                        "source_sense_id": "7787c982-d739-3062-b3f1-7eb6188bd2b6",
                        "source_sense_description": "any of many aquatic photosynthetic organisms",
                        "target_lang_word": "algue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "algue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c18eeb5f-7eb8-3379-8fa6-26ba21eac2f3",
                                        "entry_id": "40b0178a-f522-3fc0-8903-1795554aecd8",
                                        "glosses": [
                                            "Végétal aquatique poussant sous l’eau (par opposition aux nénufars) pouvant appartenir à des groupes phylogénétiques très différents (polyphylétique) et capables de photosynthèse, donc autotrophes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec672c37-9b85-4798-b012-59656193f6ee",
                                                "sense_id": "c18eeb5f-7eb8-3379-8fa6-26ba21eac2f3",
                                                "text": "Il croît beaucoup d’algues sur les rivages de l’océan."
                                            },
                                            {
                                                "example_id": "33d74a4b-423d-4066-8929-01ed120f3519",
                                                "sense_id": "c18eeb5f-7eb8-3379-8fa6-26ba21eac2f3",
                                                "text": "Comme l’algue fugitive, Sur quelque sable de la rive la vague aura roulé mes os."
                                            },
                                            {
                                                "example_id": "833f310a-2f19-4c7c-8253-6ae4a263e015",
                                                "sense_id": "c18eeb5f-7eb8-3379-8fa6-26ba21eac2f3",
                                                "text": "Les algues forment un groupe de plantes cryptogames."
                                            },
                                            {
                                                "example_id": "144dbf04-ca55-4dea-bcb4-2f260a41c528",
                                                "sense_id": "c18eeb5f-7eb8-3379-8fa6-26ba21eac2f3",
                                                "text": "De couleur violacée, parfois à tendance verdâtre ou brunâtre, cette algue se présente comme une lame fine, plus ou moins contoumée et lobée, relativement rêche au toucher."
                                            },
                                            {
                                                "example_id": "8bc88d67-9021-4ee8-beaa-d0af5ddd846c",
                                                "sense_id": "c18eeb5f-7eb8-3379-8fa6-26ba21eac2f3",
                                                "text": "À plus long terme, la Commission appelle à développer des protéines alternatives, complémentaires aux protéines cultivées, comme les insectes ou les algues."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1197a994-6d7a-401d-8a30-70d97997ff2a",
                        "source_entry_id": "4058566c-a726-35a9-b385-e76f1ff190b4",
                        "source_sense_id": "7787c982-d739-3062-b3f1-7eb6188bd2b6",
                        "source_sense_description": "any of many aquatic photosynthetic organisms",
                        "target_lang_word": "Alge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f222a9c-5198-3114-a744-9c7c2762d0fb",
                                        "entry_id": "3255859d-a2a6-3bb7-ae31-dbf1b6bffa98",
                                        "glosses": [
                                            "niedere, meist im Wasser lebende pflanzliche Organismen, als Einzeller oder als Mehrzeller organisiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00e9e571-55ef-4c8d-bf73-32c701c3b66b",
                                                "sense_id": "5f222a9c-5198-3114-a744-9c7c2762d0fb",
                                                "text": "Algen werden eine große Bedeutung für die Ernährung der Menschheit erlangen."
                                            },
                                            {
                                                "example_id": "aaa99969-560f-42f6-b3ef-636c85c5e8ef",
                                                "sense_id": "5f222a9c-5198-3114-a744-9c7c2762d0fb",
                                                "text": "Im Badesee wachsen zu viele Algen, so dass er für dieses Jahr gesperrt bleibt."
                                            },
                                            {
                                                "example_id": "625aa0ef-6875-415e-82c5-d7af3bcd0f6e",
                                                "sense_id": "5f222a9c-5198-3114-a744-9c7c2762d0fb",
                                                "text": "„An regnerischen Tagen trug der Westwind den Geruch von Motorenöl, Algen und Laich, der sich im Herbst mit Kohl und Porree mischte, über den Damm und die Auen bis zum Kirchberg hinauf.“"
                                            },
                                            {
                                                "example_id": "d453d940-99b3-410d-818e-fd39fcbec5c7",
                                                "sense_id": "5f222a9c-5198-3114-a744-9c7c2762d0fb",
                                                "text": "„Der Pool war so stark mit Chlor versetzt worden, dass jetzt zwar alle Algen eliminiert waren, aber auch alle Haare der Badenden sich in Gestrüpp verwandelten.“"
                                            },
                                            {
                                                "example_id": "92a11f9c-08e6-4c2d-adf8-fe4034ac26f4",
                                                "sense_id": "5f222a9c-5198-3114-a744-9c7c2762d0fb",
                                                "text": "„Eine arme Witfrau gab ihm gleichwohl in einer Holzschale ein wenig Magermilch, eine Handvoll Algen sowie einen getrockneten Kabeljaukopf, den sie selber ihm abgepellt, denn er erinnerte sich plötzlich, daß er ein allzu großer Mann sei, um sich dazu herabzulassen, einen getrockneten Kabeljaukopf selber abzupellen.“"
                                            },
                                            {
                                                "example_id": "e2b1c279-988f-418e-9b04-6960e03d9fdc",
                                                "sense_id": "5f222a9c-5198-3114-a744-9c7c2762d0fb",
                                                "text": "„Ein paar hundert Schritt weiter hatte Harbert an einem Felsbrocken zwischen Tang und Algen eine Kolonie doppelschaliger Muscheln entdeckt, die wenigstens den gröbsten Hunger stillen konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Alge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d7bdf78-c283-3417-8fe2-9fa17297ec7e",
                                        "entry_id": "7474bc5a-5661-3f33-aff4-abdfab904b6c",
                                        "glosses": [
                                            "deutscher Nachname, Familienname, seltener Familienname in Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e42b9235-631f-4d5a-95c3-09145cc1594f",
                                                "sense_id": "4d7bdf78-c283-3417-8fe2-9fa17297ec7e",
                                                "text": "„Sines Alge, der schweizerische Pionier der Anschauungsmethode, meint, die Semantisierung in der Fremdsprache werde vor allem durch den verbalen Kontext erleichtert: …“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
