                        "entry_id": "d08079f0-7270-3a46-8540-8fd8eb9e55c5",
                        "glosses": [
                            "een onderneming of een bedrijf dat eigenaar is van een of meer andere bedrijven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af026c68-a662-4ba4-a829-fce08b445028",
                                "sense_id": "4e13be86-bae4-397d-9479-ab9022d51d42",
                                "text": "Cisco Systems gaf ook een kijkje in de boeken. De producent van netwerkapparatuur heeft zijn omzet voor het zevende kwartaal op rij zien terugvallen en voorziet een verdere omzetdaling in het lopende kwartaal. Cisco tekende een min van 4 procent op. L Brands, het moederbedrijf van Victoria’s Secret, dook ruim 5 procent in het rood, na een winstwaarschuwing."
                            },
                            {
                                "example_id": "a35780eb-d57f-445e-9c13-c5fd7a9ea580",
                                "sense_id": "4e13be86-bae4-397d-9479-ab9022d51d42",
                                "text": "Seeran Holding in Oldenzaal. Het gaat om het moederbedrijf van Energiemakelaars, een tussenhandelaar met 13 freelance verkopers, die in april al failliet ging. Het bedrijf werd gerund door het echtpaar Segerink uit Oldenzaal, dat een conflict had met het personeel. Curator is mr. Arco Blankestijn."
                            }
                        ]
                    }
