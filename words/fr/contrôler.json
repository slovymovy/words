{
    "word_family": [
        "contrôle",
        "contrôleur",
        "contrôlable",
        "incontrôlable",
        "autocontrôle"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a93b162c-278f-3e4b-bd9b-a45bb92549c4",
                    "sense_definition": "Vérifier la validité d'un titre de transport, d'un document ou l'identité d'une personne.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'agent monte dans le train pour <w>contrôler</w> tous les billets des voyageurs."
                        },
                        {
                            "text": "La police a décidé de <w>contrôler</w> son identité à la sortie de la gare."
                        }
                    ],
                    "synonyms": [
                        "vérifier"
                    ],
                    "common_phrases": [
                        "contrôler les billets",
                        "contrôler l'identité",
                        "se faire contrôler"
                    ]
                },
                {
                    "sense_id": "2aad7a35-3a05-3452-97c8-734f793e715d",
                    "sense_definition": "Examiner minutieusement afin de vérifier l'exactitude, la qualité ou la conformité de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'expert doit <w>contrôler</w> la qualité des pièces avant la mise en vente."
                        },
                        {
                            "text": "Le directeur comptable prend le temps de <w>contrôler</w> chaque dépense de l'entreprise."
                        }
                    ],
                    "synonyms": [
                        "examiner",
                        "vérifier",
                        "inspecter"
                    ],
                    "common_phrases": [
                        "contrôler la qualité",
                        "contrôler les comptes"
                    ]
                },
                {
                    "sense_id": "ba4f6c77-0a80-3f87-bca9-3f0328270c55",
                    "sense_definition": "Garder la maîtrise de ses émotions, d'un phénomène ou de la trajectoire d'un véhicule.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "maitrise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conducteur a réussi à <w>contrôler</w> son véhicule sur cette route très glissante."
                        },
                        {
                            "text": "Les pompiers ont lutté toute la nuit pour enfin <w>contrôler</w> cet incendie violent."
                        }
                    ],
                    "synonyms": [
                        "maîtriser",
                        "dominer",
                        "contenir"
                    ],
                    "common_phrases": [
                        "contrôler la situation",
                        "contrôler ses émotions",
                        "se contrôler"
                    ]
                },
                {
                    "sense_id": "ccf6e132-91c3-30eb-8e3d-bf5210c66283",
                    "sense_definition": "Exercer son autorité, une influence déterminante ou une domination sur un groupe ou un secteur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "domination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette grande entreprise cherche à <w>contrôler</w> l'ensemble du marché des télécommunications."
                        },
                        {
                            "text": "L'armée tente de reprendre position afin de <w>contrôler</w> cette route stratégique."
                        }
                    ],
                    "synonyms": [
                        "diriger",
                        "dominer",
                        "régir"
                    ],
                    "common_phrases": [
                        "contrôler le marché",
                        "contrôler la région"
                    ]
                },
                {
                    "sense_id": "387aad3b-3090-3f67-a042-013aefce9c90",
                    "sense_definition": "Aux échecs, être en position d'attaquer une case ou d'en interdire l'accès aux pièces adverses.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "jeu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le joueur avance son cavalier pour <w>contrôler</w> le centre de l'échiquier."
                        },
                        {
                            "text": "Cette tour blanche permet de <w>contrôler</w> toute la colonne ouverte face au roi."
                        }
                    ],
                    "common_phrases": [
                        "contrôler le centre",
                        "contrôler une case"
                    ]
                }
            ]
        }
    ]
}