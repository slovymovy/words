                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f11b01ea-674e-4579-a5af-c183113ab4d9",
                                "sense_id": "c1772e01-c382-393c-9162-37ca80759c01",
                                "text": "De keizers verlagen voortdurend het zilvergehalte van de denarius waardoor hij uiteindelijk uit evenveel zilver als koper bestaat. Vanaf de regering van Septimus Severus (193-211) versnelt de muntontwaarding nog; ze bereikt haar hoogtepunt omstreeks 270."
                            }
                        ]
                    }
                ],
