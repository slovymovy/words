                "senses": [
                    {
                        "sense_id": "89630d24-d9a1-3359-a371-a0b82c0c6b25",
                        "entry_id": "35392c08-502a-391a-b354-3d0a052f182a",
                        "glosses": [
                            "Stoß als Reaktion auf einen vorhergehenden Stoß"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dc446cc5-5ba9-33e3-b8b2-447baa3edcb5",
                        "entry_id": "35392c08-502a-391a-b354-3d0a052f182a",
                        "glosses": [
                            "Angriff, der direkt auf einen vom Gegner ausgeführten Angriff folgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b09e0c8-86e2-4ddc-9e67-d60872fdbdf7",
                                "sense_id": "dc446cc5-5ba9-33e3-b8b2-447baa3edcb5",
                                "text": "„In den ersten Augusttagen stießen russische Truppen mal nach Westen vor, zogen sich dann wieder zurück und ließen deutsche Gegenstöße ins Leere laufen.“"
                            },
                            {
                                "example_id": "09a387f9-55d9-4392-8150-5591a70e63b5",
                                "sense_id": "dc446cc5-5ba9-33e3-b8b2-447baa3edcb5",
                                "text": "„Ancelottis Plan war es wohl, das Zentrum zu stärken, um Neymar, Mbappé und Cavani keinen Raum zu schnellen Gegenstößen zu bieten.“"
                            },
                            {
                                "example_id": "be653802-0eb8-4c93-8f51-b83a941ec3b0",
                                "sense_id": "dc446cc5-5ba9-33e3-b8b2-447baa3edcb5",
                                "text": "„Ich ziehe den meinen, und kaum habe ich ihn in der Hand, macht er gegen mich einen weiten Ausfall, den ich pariere; mein Gegenstoß durchbohrt ihn ganz.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
