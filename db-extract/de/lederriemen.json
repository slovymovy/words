                ],
                "senses": [
                    {
                        "sense_id": "e4f8efcc-ae09-35b5-baa1-9463e419d071",
                        "entry_id": "6f20db91-6da4-343c-8855-f58904ae06ef",
                        "glosses": [
                            "aus Leder bestehender Riemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acac8c8a-740b-4f48-97ef-7b336d28d248",
                                "sense_id": "e4f8efcc-ae09-35b5-baa1-9463e419d071",
                                "text": "„Als die 72 Jahre alte Germaine Cohen-Tanouji am 4. Oktober 1984 mit einem Lederriemen erwürgt auf ihrem Bett gefunden wurde, den Kopf mit Kissen zugedeckt, war der Tod dieser Frau für die Nicots fast eine logische Folge für deren Menschensucht.“"
                            },
                            {
                                "example_id": "6527ed76-fb19-4ea9-be1c-2cb04e2b4958",
                                "sense_id": "e4f8efcc-ae09-35b5-baa1-9463e419d071",
                                "text": "„Es war seine Pflicht als Hausvater, sie zu bestrafen, und er nahm die Jungen mit ins Schlafzimmer und schlug sie mit einem Lederriemen auf den nackten Hintern.“"
                            },
                            {
                                "example_id": "25802246-f011-4a82-8c97-7b9b743cacde",
                                "sense_id": "e4f8efcc-ae09-35b5-baa1-9463e419d071",
                                "text": "„Er stellte seinen Kanonen in breiter Front auf und ließ sie mit Lederriemen verbinden.“"
                            },
                            {
                                "example_id": "da612bfb-9d68-4672-af3b-2f8325b226e3",
                                "sense_id": "e4f8efcc-ae09-35b5-baa1-9463e419d071",
                                "text": "„Er versuchte, sich auf die Seite zu drehen, stellte aber fest, dass er mit einem Lederriemen über der Brust fixiert war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
