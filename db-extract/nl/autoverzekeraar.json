                        "examples": [
                            {
                                "example_id": "4f3995dc-7faf-4047-af2e-f5a1abffd960",
                                "sense_id": "4ab74e67-219c-303d-bbf0-d2d2936f827b",
                                "text": "De premie is volgens de toezichthouder te laag, waardoor de financiële positie van de verzekeraar in gevaar kan komen. Dit jaar ging autoverzekeraar Ineas failliet."
                            },
                            {
                                "example_id": "ae9daec6-ce07-4723-a25b-75c92e6e700f",
                                "sense_id": "4ab74e67-219c-303d-bbf0-d2d2936f827b",
                                "text": "Edmond Hilhorst van Independer zegt dat veel consumenten \"een beetje lamlendig zijn geworden\". Hilhorst zegt dat twintig tot dertig procent jaarlijks van autoverzekeraar wisselt, wat heeft geleid tot een prijsdaling van bijna dertig procent. \"Overstappen houdt de markt veel scherper\", zegt Hilhorst."
                            }
