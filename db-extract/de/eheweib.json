                                                "sense_id": "c7a4c4b7-fa36-3b9b-9479-0a5dd2f293cf",
                                                "text": "Vzal telefon a zavolal svojí choti."
                                            },
                                            {
                                                "example_id": "6dc2801e-6466-481d-b234-ba4967729e93",
                                                "sense_id": "c7a4c4b7-fa36-3b9b-9479-0a5dd2f293cf",
