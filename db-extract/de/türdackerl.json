                ],
                "senses": [
                    {
                        "sense_id": "13f6d2a8-51f7-35ca-93f0-12e4421c0f24",
                        "entry_id": "f6031e11-5e66-3656-827f-003faff3aa1e",
                        "glosses": [
                            "vor dem Eingang liegendes Rechteck zum Reinigen der Schuhe durch Abstreifen"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "303c11f4-e295-45ee-b4d5-bd1bd2b6f276",
                                "sense_id": "13f6d2a8-51f7-35ca-93f0-12e4421c0f24",
                                "text": "„… sah sie doch ihren Mann auf dem Türdackerl knien, mit einem großen Strauß roter Rosen in der Hand …“"
                            },
                            {
                                "example_id": "80b53134-f2c5-4488-963f-9b78ca2b8eeb",
                                "sense_id": "13f6d2a8-51f7-35ca-93f0-12e4421c0f24",
                                "text": "„Das Türdackerl vor dem Tor zur Freiheit sind mir, aber wegen dem braucht sich keiner die Schuh' abputzen an uns.“"
                            },
                            {
                                "example_id": "24442fc3-6d0a-4d5f-83b8-fd1cb6bd2f57",
                                "sense_id": "13f6d2a8-51f7-35ca-93f0-12e4421c0f24",
                                "text": "„[Gemeinderat Richard Gollatsch:] Ich war am Dienstag in der Früh, so um halb sieben, baß erstaunt, wie ich – ja um halb sieben, da habe ich meine Zeitung am Türdackerl und beim Frühstück lese ich die Zeitung und lese dann bei den OÖ. Nachrichten: ‚Steyr – Debatte um Abgabe.‘“"
                            },
                            {
                                "example_id": "e1fbd232-2c37-474e-bc33-d1534e8f979a",
                                "sense_id": "13f6d2a8-51f7-35ca-93f0-12e4421c0f24",
                                "text": "„In Österreich ist auch die Bezeichnung Türdacke oder Türdackerl geläufig. Verewige in wenigen Klicks deinen Hund auf deiner Fußmatte.“"
                            },
                            {
                                "example_id": "d8f74922-8e10-4e48-96aa-746d328e7c5d",
                                "sense_id": "13f6d2a8-51f7-35ca-93f0-12e4421c0f24",
                                "text": "„Das Resultat meiner Verpackungsversuche ist entsprechend peinlich, darf in der herrschenden Pandemie aber sowieso nur ansteckungsvermeidend über das Türdackerl, möglicherweise korrekter Fußabstreifer, nach terminvereinbarendem Handykontakt weitergereicht werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
