                                            {
                                                "example_id": "8127c524-69d6-4dd3-b0b9-733aac380dd4",
                                                "sense_id": "5a683950-79d9-3ce5-adda-e9bd8411c7c9",
                                                "text": "Some of the most important points went unarticulated, as meaningful looks conveyed them."
                                            }
