                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4bf53878-9574-3877-959d-fc8373a1915e",
                        "entry_id": "5e90b617-061d-3e29-a36b-6006ff34fe90",
                        "glosses": [
                            "Reducing engine's capacity at same power or increasing engine's power without increasing capacity."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "95612776-e104-4f6f-9c31-2cbe66218b0a",
                                "sense_id": "4bf53878-9574-3877-959d-fc8373a1915e",
                                "text": "Downsizing is one of the leading trends in automotive engine design."
                            }
                        ]
                    }
                ],
