                                        "entry_id": "a67502f8-1ec3-304e-85ee-4baac3d557d9",
                                        "glosses": [
                                            "To normalise in order to account for inflation; to correct for inflation by linking to a price index in order to maintain real levels."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "294682eb-0a14-3708-9ae7-c31571ebe975",
                                        "entry_id": "a67502f8-1ec3-304e-85ee-4baac3d557d9",
                                        "glosses": [
                                            "To measure by an associated value."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65a5c02a-7c5d-4938-b2ef-ac10b7ddf07b",
                                                "sense_id": "294682eb-0a14-3708-9ae7-c31571ebe975",
                                                "text": "For thousands of years, human progress was indexed to the ease and speed of our mobility: our capacity to walk on two legs, and then to ride on animals, sail on boats, chug across the land and fly through the air, all to procure for ourselves the food and materials we wanted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f48ebf68-96a3-3cdc-a4e2-989a0f91b2e8",
                                        "entry_id": "a67502f8-1ec3-304e-85ee-4baac3d557d9",
                                        "glosses": [
                                            "To be indexical for (some situation or state of affairs); to indicate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8824fea2-2647-4435-aa9c-549817533907",
                                                "sense_id": "f48ebf68-96a3-3cdc-a4e2-989a0f91b2e8",
                                                "text": "For example, the feature I indexes the current speaker in the speech event and you, the current addressee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "553cee78-4260-3654-8d75-03a5ccaa68d7",
                                        "entry_id": "a67502f8-1ec3-304e-85ee-4baac3d557d9",
                                        "glosses": [
                                            "To access a value in a data container by an index."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c43f8c3f-1b3b-3311-a055-fb1e85d55f78",
                                        "entry_id": "a67502f8-1ec3-304e-85ee-4baac3d557d9",
                                        "glosses": [
                                            "To use a mechanism to move an object to a precise location."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
