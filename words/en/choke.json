{
    "word_family": [
        "choker",
        "choking"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c3c647af-f117-3866-949d-9b2b9cb9358c",
                    "sense_definition": "To be unable to breathe because the passage to the lungs is blocked by food, liquid, or an object.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_blockage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He started to <w>choke</w> on a piece of dry bread.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>давиться</w> куском сухого хлеба.",
                                "zh": "他被一块干面包噎得开始<w>窒息</w>。"
                            }
                        },
                        {
                            "text": "The thick smoke from the fire made us cough and <w>choke</w>.",
                            "target_lang_translations": {
                                "ru": "Густой дым от пожара заставил нас кашлять и <w>задыхаться</w>.",
                                "zh": "火灾产生的浓烟呛得我们咳嗽，还几乎<w>窒息</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "suffocate",
                        "asphyxiate"
                    ],
                    "common_phrases": [
                        "choke on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Задыхаться или давиться из-за перекрытия дыхательных путей пищей, жидкостью или посторонним предметом.",
                        "zh": "因食物、液体或异物堵住呼吸道而无法呼吸。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подавиться",
                                "target_lang_sense_clarification": "пищей или жидкостью"
                            },
                            {
                                "target_lang_word": "задыхаться",
                                "target_lang_sense_clarification": "испытывать нехватку воздуха"
                            },
                            {
                                "target_lang_word": "давиться",
                                "target_lang_sense_clarification": "испытывать затруднение при глотании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "窒息",
                                "target_lang_sense_clarification": "被食物、液体等卡住而无法呼吸"
                            },
                            {
                                "target_lang_word": "噎住",
                                "target_lang_sense_clarification": "被食物噎住"
                            },
                            {
                                "target_lang_word": "呛住",
                                "target_lang_sense_clarification": "口语，也可指呼吸困难"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3986163d-fa7a-33a9-bdd3-42569019c191",
                    "sense_definition": "To stop someone from breathing by squeezing their throat or blocking their windpipe.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_blockage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The attacker tried to <w>choke</w> him, but he managed to escape.",
                            "target_lang_translations": {
                                "ru": "Нападавший пытался <w>задушить</w> его, но ему удалось вырваться.",
                                "zh": "袭击者试图<w>掐住</w>他的脖子让他无法呼吸，但他设法逃脱了。"
                            }
                        },
                        {
                            "text": "This tight collar is <w>choking</w> me.",
                            "target_lang_translations": {
                                "ru": "Этот тугой воротник <w>душит</w> меня.",
                                "zh": "这个太紧的衣领<w>勒</w>得我喘不过气来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strangle",
                        "throttle",
                        "suffocate",
                        "asphyxiate"
                    ],
                    "common_phrases": [
                        "choke to death",
                        "choke the life out of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перекрывать кому-либо дыхание, сжимая горло или блокируя трахею.",
                        "zh": "通过掐住喉咙或堵住气管使某人无法呼吸。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "душить",
                                "target_lang_sense_clarification": "сжимать горло"
                            },
                            {
                                "target_lang_word": "задушить",
                                "target_lang_sense_clarification": "убить удушением"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "掐",
                                "target_lang_sense_clarification": "掐住脖子使人不能呼吸"
                            },
                            {
                                "target_lang_word": "勒住",
                                "target_lang_sense_clarification": "勒住颈部使人窒息"
                            },
                            {
                                "target_lang_word": "使窒息",
                                "target_lang_sense_clarification": "造成窒息，书面语较强"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9d1688d-4125-3438-97d1-152ee8d55280",
                    "sense_definition": "To have difficulty speaking or to stop speaking because of strong emotion, such as sadness or anger.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tried to speak, but her voice <w>choked</w> with emotion.",
                            "target_lang_translations": {
                                "ru": "Она пыталась говорить, но её голос <w>прерывался</w> от волнения.",
                                "zh": "她试着说话，但声音因情绪激动而<w>哽咽</w>了。"
                            }
                        },
                        {
                            "text": "He managed to <w>choke</w> back his tears and continue the speech.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>сдержать</w> слёзы и продолжить речь.",
                                "zh": "他设法<w>忍住</w>眼泪，继续把演讲讲下去。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "choke back",
                        "choke up",
                        "choke with emotion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать трудности с речью или прерываться из-за сильных эмоций.",
                        "zh": "因悲伤、愤怒等强烈情绪而说话困难，或说不下去。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задыхаться",
                                "target_lang_sense_clarification": "от волнения или эмоций"
                            },
                            {
                                "target_lang_word": "давиться",
                                "target_lang_sense_clarification": "слезами или смехом"
                            },
                            {
                                "target_lang_word": "прерываться",
                                "target_lang_sense_clarification": "о голосе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哽咽",
                                "target_lang_sense_clarification": "因悲伤、激动等说不出话或声音发涩"
                            },
                            {
                                "target_lang_word": "忍住",
                                "target_lang_sense_clarification": "强忍住眼泪、情绪等"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86fb0b73-0c8b-35b0-9294-13bb68fcd1be",
                    "sense_definition": "To fill a space, passage, or channel so completely that movement is difficult or impossible.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "obstruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The river was <w>choked</w> with weeds and rubbish.",
                            "target_lang_translations": {
                                "ru": "Река была <w>забита</w> водорослями и мусором.",
                                "zh": "河道里长满了杂草、堆满了垃圾，整个河流都被<w>堵塞</w>了。"
                            }
                        },
                        {
                            "text": "During rush hour, the narrow streets are <w>choked</w> with traffic.",
                            "target_lang_translations": {
                                "ru": "В час пик узкие улицы <w>забиты</w> транспортом.",
                                "zh": "在高峰时段，狭窄的街道总是被车流<w>堵得水泄不通</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clog",
                        "congest",
                        "block up",
                        "jam",
                        "obstruct"
                    ],
                    "common_phrases": [
                        "choke with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью заполнять пространство или проход, препятствуя движению.",
                        "zh": "把空间、通道或水道塞得满满的，以致移动变得困难或不可能。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забивать",
                                "target_lang_sense_clarification": "заполнять до отказа"
                            },
                            {
                                "target_lang_word": "загромождать",
                                "target_lang_sense_clarification": "создавать препятствия"
                            },
                            {
                                "target_lang_word": "душить",
                                "target_lang_sense_clarification": "заглушать рост (о растениях)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "堵塞",
                                "target_lang_sense_clarification": "被杂物、植物、车辆等塞满而不通"
                            },
                            {
                                "target_lang_word": "堵住",
                                "target_lang_sense_clarification": "多用于道路、水管等被堵住"
                            },
                            {
                                "target_lang_word": "塞满",
                                "target_lang_sense_clarification": "强调挤满、妨碍通行"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03bc0d4f-cbf1-37ff-add1-b845b8fa27dd",
                    "sense_definition": "To fail to perform well at a critical moment in a competition because of nervousness or pressure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a lot of talent, but he tends to <w>choke</w> under pressure.",
                            "target_lang_translations": {
                                "ru": "У него большой талант, но он склонен <w>проваливаться</w> под давлением.",
                                "zh": "他很有天赋，但一到压力之下就容易<w>掉链子</w>。"
                            }
                        },
                        {
                            "text": "The team <w>choked</w> in the final minutes of the game and lost the lead.",
                            "target_lang_translations": {
                                "ru": "Команда <w>провалилась</w> на последних минутах игры и упустила лидерство.",
                                "zh": "这支球队在比赛最后几分钟<w>掉链子</w>了，丢掉了领先优势。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "choke under pressure"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in sports contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не справиться с волнением и выступить плохо в ответственный момент (обычно в спорте).",
                        "zh": "因紧张或压力过大，在比赛关键时刻发挥失常。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провалиться",
                                "target_lang_sense_clarification": "потерпеть неудачу"
                            },
                            {
                                "target_lang_word": "перенервничать",
                                "target_lang_sense_clarification": "не справиться с нервами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "掉链子",
                                "target_lang_sense_clarification": "口语，尤指在关键时刻顶不住压力"
                            },
                            {
                                "target_lang_word": "崩盘",
                                "target_lang_sense_clarification": "比赛关键时刻失常"
                            },
                            {
                                "target_lang_word": "失常",
                                "target_lang_sense_clarification": "没发挥好而失败"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56249c26-a636-31be-9e61-5b2897eb7bf3",
                    "sense_definition": "To hold a bat, racket, or tool higher up the handle than usual to gain better control.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "grip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>choke</w> up on the bat to make contact with the ball more easily.",
                            "target_lang_translations": {
                                "ru": "Тебе следует <w>перехватить</w> биту повыше, чтобы легче попасть по мячу.",
                                "zh": "你应该把球棒<w>往上握一点</w>，这样更容易击中球。"
                            }
                        },
                        {
                            "text": "Artists often <w>choke</w> the pencil for fine detail work.",
                            "target_lang_translations": {
                                "ru": "Художники часто <w>перехватывают</w> карандаш ближе к грифелю для прорисовки мелких деталей.",
                                "zh": "画细节时，艺术家常常把铅笔<w>握得更靠前</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "choke up",
                        "choke down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Держать спортивный снаряд или инструмент выше по рукоятке для лучшего контроля.",
                        "zh": "把球棒、球拍或工具握在比平常更靠前的位置，以获得更好的控制。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перехватить",
                                "target_lang_sense_clarification": "взять выше или ближе"
                            },
                            {
                                "target_lang_word": "укоротить хват",
                                "target_lang_sense_clarification": "спортивный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "往上握一点",
                                "target_lang_sense_clarification": "把手往工具或球棒前端挪，以便更好控制"
                            },
                            {
                                "target_lang_word": "握得靠前",
                                "target_lang_sense_clarification": "握得更靠前"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b321f3b1-49a0-3ad3-b956-970f48990b8a",
                    "sense_definition": "A device in a vehicle engine that reduces the air supply to create a richer fuel mixture, helping the engine start when cold.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mechanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to pull out the <w>choke</w> before you try to start the old motorcycle.",
                            "target_lang_translations": {
                                "ru": "Нужно вытянуть <w>подсос</w>, прежде чем пытаться завести старый мотоцикл.",
                                "zh": "你得先拉出<w>阻风门</w>，再试着发动这辆旧摩托车。"
                            }
                        },
                        {
                            "text": "The mechanic adjusted the <w>choke</w> to help the car run smoother in winter.",
                            "target_lang_translations": {
                                "ru": "Механик отрегулировал <w>заслонку</w>, чтобы машина работала ровнее зимой.",
                                "zh": "机械师调节了<w>阻风门</w>，让这辆车在冬天运转得更平稳。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство в двигателе (воздушная заслонка), ограничивающее подачу воздуха для обогащения топливной смеси.",
                        "zh": "车辆发动机中的一种装置，通过减少进气量来使燃油混合气更浓，帮助冷启动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заслонка",
                                "target_lang_sense_clarification": "технический термин"
                            },
                            {
                                "target_lang_word": "подсос",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阻风门",
                                "target_lang_sense_clarification": "发动机冷启动时调节进气的装置"
                            },
                            {
                                "target_lang_word": "阻风装置",
                                "target_lang_sense_clarification": "机动车口语说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f47f3f0-e9fa-316c-a800-ef00e04fd573",
                    "sense_definition": "A hold in wrestling or martial arts that restricts an opponent's breathing or blood flow.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_blockage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He won the match by forcing his opponent to submit with a <w>choke</w>.",
                            "target_lang_translations": {
                                "ru": "Он выиграл матч, заставив противника сдаться с помощью <w>удушающего приема</w>.",
                                "zh": "他用一个<w>绞技</w>迫使对手认输，赢下了比赛。"
                            }
                        },
                        {
                            "text": "The fighter applied a tight <w>choke</w> from behind.",
                            "target_lang_translations": {
                                "ru": "Боец применил жесткий <w>удушающий захват</w> сзади.",
                                "zh": "那名选手从背后使出了一个很紧的<w>绞技</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rear naked choke"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удушающий прием в борьбе, ограничивающий дыхание или кровоток противника.",
                        "zh": "摔跤或武术中的一种擒拿动作，通过限制对手呼吸或血流来制服对方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удушающий прием",
                                "target_lang_sense_clarification": "в единоборствах"
                            },
                            {
                                "target_lang_word": "захват",
                                "target_lang_sense_clarification": "прием борьбы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "绞技",
                                "target_lang_sense_clarification": "格斗、柔术等中通过压迫颈部或阻断血流使对手屈服的招式"
                            },
                            {
                                "target_lang_word": "裸绞",
                                "target_lang_sense_clarification": "泛指使人窒息的格斗技法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb77e5a2-0161-36a7-9d44-afc6edba3a23",
                    "sense_definition": "A failure to perform effectively at a crucial stage of a competition due to nervousness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a massive <w>choke</w> for the team to lose after being so far ahead.",
                            "target_lang_translations": {
                                "ru": "Это был грандиозный <w>провал</w> для команды — проиграть, ведя с таким отрывом.",
                                "zh": "这支球队领先那么多最后却输了，真是一次巨大的<w>崩盘</w>。"
                            }
                        },
                        {
                            "text": "Critics called his performance in the final round a <w>choke</w>.",
                            "target_lang_translations": {
                                "ru": "Критики назвали его выступление в финальном раунде <w>провалом</w>.",
                                "zh": "评论员称他在最后一轮的表现是一次<w>崩盘</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in sports contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Провал или неудача в решающий момент состязания из-за нервного напряжения.",
                        "zh": "在比赛关键阶段因紧张而表现失常的一次失败。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провал",
                                "target_lang_sense_clarification": "неудача"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "崩盘",
                                "target_lang_sense_clarification": "口语，比赛关键阶段的重大失误或失常"
                            },
                            {
                                "target_lang_word": "失常",
                                "target_lang_sense_clarification": "泛指失败，但不如前者贴近体育语境"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7116b328-8461-3fd7-b76c-3fd1e639c259",
                    "sense_definition": "The inedible mass of fuzzy fibers in the center of an artichoke heart.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
