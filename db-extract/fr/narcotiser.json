                "senses": [
                    {
                        "sense_id": "194cfc4f-997e-3c4f-b059-05788b7f5467",
                        "entry_id": "3821d257-50bf-31a8-875f-c955177fcd86",
                        "glosses": [
                            "Donner un caractère narcotique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "740467d8-c567-439c-abf5-e93f92b936ba",
                                "sense_id": "194cfc4f-997e-3c4f-b059-05788b7f5467",
                                "text": "Le festoiement à la faveur duquel Vautrin avait fait boire à Eugène et au père Goriot du vin narcotisé décida de la perte de cet homme, Bianchon, à moitié gris, oublia de questionner mademoiselle Michonneau sur Trompe-la-Mort."
                            }
                        ]
                    },
                    {
                        "sense_id": "783250a9-c2c6-3bfd-93c8-02f354b950f6",
                        "entry_id": "3821d257-50bf-31a8-875f-c955177fcd86",
                        "glosses": [
                            "Endormir avec un narcotique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23f67140-e2d6-469d-8059-dd55261b043c",
                                "sense_id": "783250a9-c2c6-3bfd-93c8-02f354b950f6",
                                "text": "En narcotisant nos cerveaux si vifs de l’Occident, en les imprégnant, en les pénétrant de ces subtiles et énervantes vapeurs, auxquelles on s’accoutume avec la lâcheté qui fait de la passion un vice, la tabac précède de bien peu l’invasion de l’opium, un jour nécessaire."
                            }
                        ]
                    }
                ],
