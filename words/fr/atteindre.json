{
    "word_family": [
        "atteinte",
        "inatteignable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "739aa6e5-2339-3d2d-81c3-c3e7665724dd",
                    "sense_definition": "Arriver à un lieu ou parvenir à une destination après un déplacement ou un effort.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "destination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs heures de marche en montagne, les randonneurs ont enfin <w>atteint</w> le sommet."
                        },
                        {
                            "text": "Le train a pris un peu de retard mais il <w>atteindra</w> la gare avant midi."
                        }
                    ],
                    "synonyms": [
                        "parvenir",
                        "arriver"
                    ],
                    "common_phrases": [
                        "atteindre le sommet",
                        "atteindre son but",
                        "atteindre la côte"
                    ]
                },
                {
                    "sense_id": "3cd7dab8-54a5-3036-ae55-21aabdf4aefa",
                    "sense_definition": "S'élever jusqu'à une certaine valeur, une température ou un montant chiffré.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant la canicule estivale, le mercure peut <w>atteindre</w> quarante degrés à l'ombre."
                        },
                        {
                            "text": "Les ventes de l'entreprise ont <w>atteint</w> un niveau record durant le dernier trimestre."
                        }
                    ],
                    "common_phrases": [
                        "atteindre un record",
                        "atteindre un chiffre",
                        "atteindre un niveau"
                    ]
                },
                {
                    "sense_id": "530ef8f4-13ae-3793-80d5-401cbbf9d338",
                    "sense_definition": "Parvenir à un âge précis ou à une étape déterminée de sa vie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon grand-père est très heureux d'<w>atteindre</w> l'âge de quatre-vingts ans en bonne santé."
                        },
                        {
                            "text": "Elle attend d'<w>atteindre</w> la majorité pour signer son premier bail d'appartement."
                        }
                    ],
                    "common_phrases": [
                        "atteindre la majorité",
                        "atteindre un âge"
                    ]
                },
                {
                    "sense_id": "5126f157-8da5-3044-a467-309b15b30078",
                    "sense_definition": "Toucher une personne ou un objet avec un projectile ou un coup tiré à distance.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tireur sportif a parfaitement <w>atteint</w> la cible dès son premier essai."
                        },
                        {
                            "text": "La flèche a <w>atteint</w> l'arbre situé tout au fond du jardin."
                        }
                    ],
                    "synonyms": [
                        "frapper",
                        "toucher"
                    ],
                    "antonyms": [
                        "manquer",
                        "rater"
                    ],
                    "common_phrases": [
                        "atteindre la cible",
                        "atteindre le but"
                    ]
                },
                {
                    "sense_id": "f8ce4c78-b460-387c-bb7d-a1bfcd1a7e72",
                    "sense_definition": "Rattraper une personne ou un véhicule en marche après l'avoir poursuivi.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "poursuite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En accélérant le pas, nous pourrons <w>atteindre</w> le groupe parti quelques minutes plus tôt."
                        },
                        {
                            "text": "Le policier courait très vite mais il n'a pas pu <w>atteindre</w> le voleur."
                        }
                    ],
                    "synonyms": [
                        "rattraper",
                        "rejoindre"
                    ],
                    "common_phrases": [
                        "atteindre les fuyards"
                    ]
                },
                {
                    "sense_id": "27dd0403-bd90-36d7-bfc0-384cbd7270ae",
                    "sense_definition": "Causer un dommage physique, moral ou matériel ; affecter profondément.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "blessure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces critiques injustes ne parviennent pas à l'<w>atteindre</w> car il a confiance en lui."
                        },
                        {
                            "text": "Plusieurs villages ont été gravement <w>atteints</w> par cette terrible épidémie."
                        }
                    ],
                    "synonyms": [
                        "affecter",
                        "blesser"
                    ],
                    "antonyms": [
                        "épargner"
                    ],
                    "common_phrases": [
                        "atteint par la maladie",
                        "atteindre au moral"
                    ]
                }
            ]
        }
    ]
}