                "senses": [
                    {
                        "sense_id": "a4bd252f-8e3f-3ffc-8814-414d725fc08d",
                        "entry_id": "b8b2a2a9-65b9-3ede-bc8b-49e547d8873b",
                        "glosses": [
                            "Veröffentlichung einer Information"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e85f3f9-83ca-49b8-8735-140922c3314f",
                                "sense_id": "a4bd252f-8e3f-3ffc-8814-414d725fc08d",
                                "text": "Er las die neueste Verlautbarung des Bundespräsidialamtes."
                            },
                            {
                                "example_id": "647f56c1-27e4-406f-a7e5-3e6bb4535f3e",
                                "sense_id": "a4bd252f-8e3f-3ffc-8814-414d725fc08d",
                                "text": "„Damit war die Verlautbarung beendet.“"
                            },
                            {
                                "example_id": "66a57b89-2271-4d20-a8c1-e7cf76b96aa7",
                                "sense_id": "a4bd252f-8e3f-3ffc-8814-414d725fc08d",
                                "text": "„Wie hart treffen die massiven westlichen Sanktionen Russland? Glaubt man den Verlautbarungen aus Moskau, handelt es sich zwar um schmerzliche Einschnitte, die aber den Urhebern mehr schadeten als der mächtigen russischen Ökonomie.“"
                            },
                            {
                                "example_id": "02a5127c-a188-4a93-9a89-500785bb503b",
                                "sense_id": "a4bd252f-8e3f-3ffc-8814-414d725fc08d",
                                "text": "„Diese im Mordprozess vorgebrachte Verlautbarung war zur Entlastung des Angeklagten O. J. Simpson gedacht – und wird zu einer belastenden Information, wenn man genauer darüber nachdenkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
