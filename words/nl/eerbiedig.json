{
    "word_family": [
        "eerbied",
        "eerbiedigen"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "02b8439a-82d4-325b-a3b8-214483f94c70",
                    "sense_definition": "Met veel respect en beleefdheid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leerling sprak op een <w>eerbiedige</w> toon tegen de oude leraar.",
                            "target_lang_translations": {
                                "fr": "L'élève parlait au vieux professeur sur un ton <w>respectueux</w>."
                            }
                        },
                        {
                            "text": "Zij luisterde in een <w>eerbiedige</w> stilte naar het verhaal van haar grootvader.",
                            "target_lang_translations": {
                                "fr": "Elle écoutait le récit de son grand-père dans un silence <w>respectueux</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "respectvol"
                    ],
                    "antonyms": [
                        "oneerbiedig"
                    ],
                    "common_phrases": [
                        "eerbiedige houding",
                        "eerbiedige stilte"
                    ],
                    "target_lang_definitions": {
                        "fr": "Qui témoigne d'un grand respect et de politesse."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "respectueux",
                                "target_lang_sense_clarification": "Adjectif courant pour décrire une attitude pleine de respect."
                            },
                            {
                                "target_lang_word": "révérencieux",
                                "target_lang_sense_clarification": "Adjectif plus soutenu, impliquant une déférence marquée."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "78c56001-aac4-3249-99ec-ba83d0a3f391",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>eerbiedigen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>eerbiedig</w> de wens van mijn ouders om de traditie voort te zetten.",
                            "target_lang_translations": {
                                "fr": "Je <w>respecte</w> le souhait de mes parents de perpétuer la tradition."
                            }
                        },
                        {
                            "text": "Ik <w>eerbiedig</w> altijd de regels van de club waar ik lid van ben.",
                            "target_lang_translations": {
                                "fr": "Je <w>respecte</w> toujours les règles du club dont je suis membre."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vervoegde vorm van het werkwoord."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Première personne du singulier du présent du verbe respecter."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "respecte",
                                "target_lang_sense_clarification": "Forme conjuguée du verbe respecter."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a1dfd8e-32cc-37ad-a8ae-d4304501474a",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>eerbiedigen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jij <w>eerbiedig</w> de afspraken die we gisteren samen hebben gemaakt.",
                            "target_lang_translations": {
                                "fr": "Tu <w>respectes</w> les accords que nous avons conclus ensemble hier."
                            }
                        },
                        {
                            "text": "Waarom <w>eerbiedig</w> jij de beslissing van de rechter niet?",
                            "target_lang_translations": {
                                "fr": "Pourquoi ne <w>respectes</w>-tu pas la décision du juge ?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vervoegde vorm van het werkwoord."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Deuxième personne du singulier du présent du verbe respecter."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "respectes",
                                "target_lang_sense_clarification": "Forme conjuguée du verbe respecter."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8ba54e0-09f3-3687-baad-3b98a9ae4763",
                    "sense_definition": "Gebiedende wijs van <w>eerbiedigen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Eerbiedig</w> de wet en houd je aan de verkeersregels op de weg.",
                            "target_lang_translations": {
                                "fr": "<w>Respecte</w> la loi et conforme-toi au code de la route."
                            }
                        },
                        {
                            "text": "<w>Eerbiedig</w> de privacy van anderen in deze openbare ruimte.",
                            "target_lang_translations": {
                                "fr": "<w>Respecte</w> la vie privée d'autrui dans cet espace public."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vervoegde vorm van het werkwoord."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Impératif du verbe respecter."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "respecte",
                                "target_lang_sense_clarification": "Forme impérative du verbe respecter."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}