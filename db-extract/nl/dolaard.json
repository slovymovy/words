                            {
                                "example_id": "05326a14-a3ac-4283-bb29-a6bc404b8bd9",
                                "sense_id": "e6444f6e-53bc-3cb1-980b-ee3dfc73f4e0",
                                "text": "Dan is het doel bereikt, dan leert gij eerst wat reizen betekent voor de dolaards en de ware wijzen."
                            },
                            {
                                "example_id": "1af5ad9f-57ad-4faa-b16c-20addf430fef",
                                "sense_id": "e6444f6e-53bc-3cb1-980b-ee3dfc73f4e0",
                                "text": "Als ik voorbij Gojo de laagvlakte verlaat en aan de uiteindelijke bedevaart begin, zit hij langs de rand van de weg rijstwijn te drinken. De universele dolaard. Waar men ook komt ter wereld, de Franse chemineau, de Amerikaanse hobo, ze zijn allemaal onderweg naar nergens."
                            }
                        ]
