                    },
                    {
                        "form_id": "2e23fd20-358d-405d-aca8-a286e28d6eb8",
                        "entry_id": "80998367-93a3-337a-8aab-4f6390f3ddd6",
                        "tags": [
                            "diminutive",
                            "singular"
                        ],
                        "form": "poppenhuisje"
                    },
                    {
                        "form_id": "faed3e5b-05b8-49ff-9292-4f93b48d9531",
                        "entry_id": "80998367-93a3-337a-8aab-4f6390f3ddd6",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "poppenhuisjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c32429ed-fbdd-3298-b252-6370c5951424",
                        "entry_id": "80998367-93a3-337a-8aab-4f6390f3ddd6",
                        "glosses": [
                            "een in het klein uitgevoerde versie van een huis (met of voor poppen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faf0031c-d155-47de-8dc7-f47a15ce2687",
                                "sense_id": "c32429ed-fbdd-3298-b252-6370c5951424",
                                "text": "Ze zijn met zorg en met een opmerkzame blik gemaakt, en ze zet ze stuk voor stuk op verborgen plaatsen in het poppenhuis."
                            },
                            {
                                "example_id": "8f5bd67e-e708-4547-b7f6-7c9cd4ab218d",
                                "sense_id": "c32429ed-fbdd-3298-b252-6370c5951424",
                                "text": "Nu zal ze de miniatuur-Nella - getooid met de gouden sleutel - van de sprei pakken en weer in het poppenhuis zetten."
                            }
                        ]
                    },
                    {
                        "sense_id": "7559d03f-0693-3113-92bb-e1e9c2e68248",
                        "entry_id": "80998367-93a3-337a-8aab-4f6390f3ddd6",
                        "glosses": [
                            "popperig, klein huisje"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c224c771-905a-42b1-9272-8544a1c72a2b",
                        "source_entry_id": "80998367-93a3-337a-8aab-4f6390f3ddd6",
                        "source_sense_id": "c32429ed-fbdd-3298-b252-6370c5951424",
                        "source_sense_description": "een in het klein uitgevoerde versie",
                        "target_lang_word": "Puppenhaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Puppenhaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10215353-6d78-3120-9515-fa650865bea5",
                                        "entry_id": "5a452aab-0a8e-37be-97a6-de1a683169b4",
                                        "glosses": [
                                            "ein Kinderspielzeug, das eine Miniatur eines (Teil-)Hauses darstellt und als Behausung für Puppen dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdbad465-8789-4ed4-b00b-652002930d6a",
                                                "sense_id": "10215353-6d78-3120-9515-fa650865bea5",
                                                "text": "Das Puppenhaus ist technisch so ausgereift, dass es sogar einen echten Miniaturflachbildschirm besitzt."
                                            },
                                            {
                                                "example_id": "f3489f49-6ac2-4c76-9ea6-89e957549030",
                                                "sense_id": "10215353-6d78-3120-9515-fa650865bea5",
                                                "text": "„Sie hatte ein schönes rosa Zimmer und ein riesiges Puppenhaus voller Möbel und Puppen, mit denen sie spielten und denen sie Puppenkleider anzogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02eef8b4-cc11-4207-bcd1-b63b014f547c",
                        "source_entry_id": "80998367-93a3-337a-8aab-4f6390f3ddd6",
                        "source_sense_id": "c32429ed-fbdd-3298-b252-6370c5951424",
                        "source_sense_description": "een in het klein uitgevoerde versie",
                        "target_lang_word": "Puppenstube",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Puppenstube",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "288d3f2b-96ae-377c-b902-bf5989878f76",
                                        "entry_id": "3efdeda8-674d-386a-a0cc-bf618b819314",
                                        "glosses": [
                                            "Nachbildung einer Wohnung oder Hauses im Kleinformat mit Miniaturpuppen als Spielzeug für Kinder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e8f824f-c5a2-44eb-b033-db5b5a0f4f81",
                                                "sense_id": "288d3f2b-96ae-377c-b902-bf5989878f76",
                                                "text": "Das Mädchen spielt mit seiner Puppenstube."
                                            },
                                            {
                                                "example_id": "8653cec3-705a-4a04-98f0-5d8e550e70bd",
                                                "sense_id": "288d3f2b-96ae-377c-b902-bf5989878f76",
                                                "text": "„Unter einem blechernen Giebel, in einer Puppenstube hinter Glas hockt die Wahrsagerin, eine alte Frau mit zottigem Haar, ein paar Zahnstummel im grinsenden Mund.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6a66d4e-3c23-4cb3-9212-05bd049cd8cb",
                        "source_entry_id": "80998367-93a3-337a-8aab-4f6390f3ddd6",
                        "source_sense_id": "c32429ed-fbdd-3298-b252-6370c5951424",
                        "source_sense_description": "een in het klein uitgevoerde versie",
                        "target_lang_word": "doll's house",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doll's house",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b6c9279-aa0a-385c-ab15-1e6dd0568cb3",
                                        "entry_id": "d647d2f3-293f-3b5d-b691-d94f7e38e299",
                                        "glosses": [
                                            "A miniature house used by children as a toy for recreating domestic settings."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7952f3e-8e0c-4dde-832c-eb9414c2b47b",
                                                "sense_id": "0b6c9279-aa0a-385c-ab15-1e6dd0568cb3",
                                                "text": "Adam Stockhausen's doll's-house production design is eye-wateringly precise, the black-and-white images of the city's ancient buildings (shot in Angouleme) deserve their own coffee table book"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4f5d752-f88a-323c-abbb-7ceecee0b378",
                                        "entry_id": "d647d2f3-293f-3b5d-b691-d94f7e38e299",
                                        "glosses": [
                                            "A small, cramped, dwelling-place."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cbb55c8-d000-4c22-aa89-c49162a60ab9",
                                                "sense_id": "c4f5d752-f88a-323c-abbb-7ceecee0b378",
                                                "text": "A slightly incongruous note is struck by the National Westminster Bank beside the Vine [pub], a tiny dolls' house of a building, about the size of a garden shed, in herringbone-patterned brick."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e551884-678c-4ac3-b73c-b7fc05b3697e",
                        "source_entry_id": "80998367-93a3-337a-8aab-4f6390f3ddd6",
