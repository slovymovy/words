                    {
                        "sense_id": "49c15011-e97b-308d-b7a1-7bcc2ccb269d",
                        "entry_id": "c50b867a-bed0-31e6-a1f8-acb29622bec7",
                        "glosses": [
                            "небольшая часть чего-либо, дополняющая взвешиваемое до требуемого веса"
                        ],
