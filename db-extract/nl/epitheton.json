                ],
                "senses": [
                    {
                        "sense_id": "8cea9173-3d72-3e0b-83d3-f89810503931",
                        "entry_id": "dae0622f-9084-346c-9bc5-08b9e200d4cc",
                        "glosses": [
                            "bijvoeglijk naamwoord of bijvoeglijke bepaling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4a299f7-e10c-40ea-929c-e8c451ed1fc5",
                                "sense_id": "8cea9173-3d72-3e0b-83d3-f89810503931",
                                "text": "Richard Groenendijk wilde het aan het slot van zijn optreden bij Jinek (KRO-NCRV) toch even aan de orde stellen. Waarom was hij daar geïntroduceerd als „de Rotterdamse cabaretier”, terwijl je bij Youp van ‘t Hek of Sanne Wallis de Vries toch nooit het epitheton „Amsterdams” zult horen?"
                            }
                        ]
                    },
                    {
                        "sense_id": "95441975-acdb-3609-a9f6-b520f6b90950",
                        "entry_id": "dae0622f-9084-346c-9bc5-08b9e200d4cc",
                        "glosses": [
                            "aanvullende aanduiding die een onderscheidende eigenschap benadrukt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2c617c8-ce69-4fd5-9587-f9f6e736bb43",
                                "sense_id": "95441975-acdb-3609-a9f6-b520f6b90950",
                                "text": "Honderden commentaren verbinden Enaits naam intussen aan het epitheton „orthodoxe moslim”."
                            }
                        ]
                    },
                    {
                        "sense_id": "16ecebc6-b9bf-37b0-88d1-cc311577c860",
                        "entry_id": "dae0622f-9084-346c-9bc5-08b9e200d4cc",
                        "glosses": [
                            "tweede woord in officiële soortnamen volgens de binaire nomenclatuur, woord dat de precieze soort aangeeft na het eerste dat het geslacht aanduidt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8cbb4e0-0561-4e46-b239-333b47cea8af",
                                "sense_id": "16ecebc6-b9bf-37b0-88d1-cc311577c860",
                                "text": "Linnaeus besloot radicaal orde op zaken te stellen. Hij benoemde iedere soort met een combinatie van twee Latijnse woorden: een genusnaam die het geslacht van de soort aanduidt en een zogeheten epitheton dat de soort specificeert."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e68f730-9585-48d7-902b-1ef2b60f09ee",
                        "source_entry_id": "dae0622f-9084-346c-9bc5-08b9e200d4cc",
                        "target_lang_word": "epithet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epithet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a11a4b62-0430-34e5-bd6f-104cd263197f",
                                        "entry_id": "4ebea930-4284-3d3c-8ca6-c4d5a9891998",
                                        "glosses": [
                                            "A term used to characterize a person or thing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "809c8161-b66e-4aff-8e41-6c0365c4e0aa",
                                                "sense_id": "a11a4b62-0430-34e5-bd6f-104cd263197f",
                                                "text": "She would lean her head for hours on Beatrice's shoulder, only now and then applying to her some childish and endearing epithet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91786aa5-8be6-324a-bf64-1c709e9cdf9f",
                                        "entry_id": "4ebea930-4284-3d3c-8ca6-c4d5a9891998",
                                        "glosses": [
                                            "A term used as a qualifier of the name of a deity in order to designate said deity in a particular aspect or role."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41838a3e-22d8-362b-9240-04fd8f5c85cb",
                                        "entry_id": "4ebea930-4284-3d3c-8ca6-c4d5a9891998",
                                        "glosses": [
                                            "A term used as a descriptive substitute for the name or title of a person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1dbf9007-7b0c-3c1d-8ac2-7dbad05e63d5",
                                        "entry_id": "4ebea930-4284-3d3c-8ca6-c4d5a9891998",
                                        "glosses": [
                                            "One of many formulaic words or phrases used in the Iliad and Odyssey to characterize a person, a group of people, or a thing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f3c555f-1dbb-329d-a577-70736be9c6a6",
                                        "entry_id": "4ebea930-4284-3d3c-8ca6-c4d5a9891998",
                                        "glosses": [
                                            "An abusive or contemptuous word or phrase."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25690631-c57b-4a2a-aa2b-352dd2652ab8",
                                                "sense_id": "8f3c555f-1dbb-329d-a577-70736be9c6a6",
                                                "text": "Part of this process was the elaboration of new terms for the Jew, especially the increasingly popular epithet “kike”."
                                            },
                                            {
                                                "example_id": "9ac1b6d4-874d-4771-be16-5de416a7958e",
                                                "sense_id": "8f3c555f-1dbb-329d-a577-70736be9c6a6",
                                                "text": "Counterprotesters shouted epithets as they walked by, but the opposing groups kept it nonviolent."
                                            },
                                            {
                                                "example_id": "b2a4b555-d49c-48f2-a12d-8abb2753804e",
                                                "sense_id": "8f3c555f-1dbb-329d-a577-70736be9c6a6",
                                                "text": "Politico reported that epithets appeared more than 251 times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77f2e65a-078f-3b11-a1fc-895d2c551884",
                                        "entry_id": "4ebea930-4284-3d3c-8ca6-c4d5a9891998",
                                        "glosses": [
                                            "A word in the scientific name of a taxon following the name of the genus or species. This applies only to formal names of plants, fungi and bacteria. In formal names of animals the corresponding term is the specific name."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "epithet",
                                "target_lang_code": "en",
