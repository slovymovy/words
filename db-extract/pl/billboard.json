                "senses": [
                    {
                        "sense_id": "d8eee9f9-26a4-3632-8d4b-a0752ca62084",
                        "entry_id": "01660d14-cb99-3621-bd41-3434e9ca2edb",
                        "glosses": [
                            "duża przydrożna tablica reklamowa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a134028f-e93c-4e9c-9e21-13061bcc5dce",
                                "sense_id": "d8eee9f9-26a4-3632-8d4b-a0752ca62084",
                                "text": "Radni cztery godziny dyskutowali o billboardach zawieszonych w centrum miasta."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00606078-4cb7-43b9-96a4-3ca27241a897",
                        "source_entry_id": "01660d14-cb99-3621-bd41-3434e9ca2edb",
                        "source_sense_id": "d8eee9f9-26a4-3632-8d4b-a0752ca62084",
                        "target_lang_word": "billboard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "billboard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6afa6811-9c98-3f45-8d65-e4f41879f36b",
                                        "entry_id": "797c7e38-9259-336f-8dd4-901002ac6f58",
                                        "glosses": [
                                            "A very large outdoor sign, generally used for advertising."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62418480-e5cc-4212-9868-544663b389d9",
                                                "sense_id": "6afa6811-9c98-3f45-8d65-e4f41879f36b",
                                                "text": "He could see it like a printed sentence, fullborn and already dead God loves me too like the faded and weathered letters on last year's billboard God loves me too"
                                            },
                                            {
                                                "example_id": "e73cd494-98e8-4de6-9803-9f7bd53fbaa3",
                                                "sense_id": "6afa6811-9c98-3f45-8d65-e4f41879f36b",
                                                "text": "The land refuses to change. The more he drives the more the region resembles the country around Mt. Judge. The same scruff on the embankments, the same weathered billboards for the same products you wondered anybody would ever want to buy."
                                            },
                                            {
                                                "example_id": "a440bb5f-0cf1-4b48-82df-91f013438e3a",
                                                "sense_id": "6afa6811-9c98-3f45-8d65-e4f41879f36b",
                                                "text": "All America was on the verge of spring and the countryside was coming to glory, what we could see of the countryside through the smoke and billboards."
                                            },
                                            {
                                                "example_id": "22c9a890-7632-428e-bebd-42961d5ade16",
                                                "sense_id": "6afa6811-9c98-3f45-8d65-e4f41879f36b",
                                                "text": "Bleak factory buildings and billboard-cluttered avenues look as beautiful, through the camera’s eye, as churches and pastoral landscapes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50648352-75e5-346d-bd11-061a7e088919",
                                        "entry_id": "797c7e38-9259-336f-8dd4-901002ac6f58",
                                        "glosses": [
                                            "A flat surface, such as a panel or fence, on which bills are posted; a bulletin board."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cb0d088-65af-49f1-b1e2-57b010e49617",
                                                "sense_id": "50648352-75e5-346d-bd11-061a7e088919",
                                                "text": "When a show leaves New York, it carries posters wherewith to embellish each fence and bill board in the land [...]"
                                            },
                                            {
                                                "example_id": "755f8a8a-a282-47c3-91ff-88e082a6064a",
                                                "sense_id": "50648352-75e5-346d-bd11-061a7e088919",
                                                "text": "Toward the end of April, the billboards, which I watched anxiously in those days, bloomed out one morning with gleaming white posters on which two names were impressively printed in blue Gothic letters: the name of an actress of whom I had often heard, and the name “Camille.”"
                                            },
                                            {
                                                "example_id": "739ba317-4ac2-4b39-95a5-241bb6bcfe4d",
                                                "sense_id": "50648352-75e5-346d-bd11-061a7e088919",
                                                "text": "Until the recent rash of North London line maps appeared on station billboards in the London area of BR, the service undoubtedly suffered from meagre and ineffectual publicity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e6e27e0-ec8a-3587-b2ac-f48388260dab",
                                        "entry_id": "797c7e38-9259-336f-8dd4-901002ac6f58",
                                        "glosses": [
                                            "A piece of thick plank, armed with iron plates, and fixed on the bow or fore-channels of a vessel, for the bill or fluke of the anchor to rest on."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "797a6267-2f67-3959-9425-5dc9c25ce7dd",
                                        "entry_id": "797c7e38-9259-336f-8dd4-901002ac6f58",
                                        "glosses": [
                                            "An opening or closing portion of a program, often including credits and sponsors' names."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "639307e4-987d-411c-88c0-dc33133257a7",
                                                "sense_id": "797a6267-2f67-3959-9425-5dc9c25ce7dd",
                                                "text": "The closing billboard features Como as the spokesman."
                                            },
                                            {
                                                "example_id": "35c8bd9f-e4b9-4680-921c-b9c89e6128ec",
                                                "sense_id": "797a6267-2f67-3959-9425-5dc9c25ce7dd",
                                                "text": "[…] the opening billboard identifying Chase as the sponsor […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a583c680-99b2-3e38-9e64-aae86e8c32b1",
                                        "entry_id": "797c7e38-9259-336f-8dd4-901002ac6f58",
                                        "glosses": [
                                            "A sprite that always faces the screen, no matter which direction it is viewed from."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "billboard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53fcbf28-a94a-3de8-9227-50d1730cf35f",
                                        "entry_id": "cf643537-0915-33d1-9c6b-b34e0745a217",
                                        "glosses": [
                                            "To advertise on a billboard."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "367f37c8-4787-440c-a5ec-5c28602534a6",
                                                "sense_id": "53fcbf28-a94a-3de8-9227-50d1730cf35f",
                                                "text": "The upcoming concert was billboarded all over the city."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "142de51c-fcd8-42c3-b458-73a0fdd5dfe8",
                        "source_entry_id": "01660d14-cb99-3621-bd41-3434e9ca2edb",
                        "source_sense_id": "d8eee9f9-26a4-3632-8d4b-a0752ca62084",
                        "target_lang_word": "hoarding",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hoarding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a6a3c46-9093-3e3e-8333-0ee4443d058c",
                                        "entry_id": "c7590c3f-6dcb-3e46-a628-d057162b10ad",
                                        "glosses": [
                                            "A roofed wooden shield placed over the battlements of a castle and projecting from them."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4e6929d-9c84-3c84-9e92-821b95788b76",
                                        "entry_id": "c7590c3f-6dcb-3e46-a628-d057162b10ad",
                                        "glosses": [
                                            "A temporary fence-like structure built around building work to add security and prevent accidents to the public."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "Hong-Kong",
                                            "Ireland",
                                            "New-Zealand",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50b3c657-b0e1-4489-be4d-369b796ec43c",
                                                "sense_id": "d4e6929d-9c84-3c84-9e92-821b95788b76",
                                                "text": "Making inquiries she came to a hoarding, within which were excavations denoting the foundations of a building; and on the boards without one or two large posters announcing that the foundation-stone of the chapel about to be erected would be laid that afternoon at three o’clock by a London preacher of great popularity among his body."
                                            },
                                            {
                                                "example_id": "25512c55-d11e-4c83-8c41-52089f757eba",
                                                "sense_id": "d4e6929d-9c84-3c84-9e92-821b95788b76",
                                                "text": "A hoarding is a legal requirement for the safety of the public on a building site. There are rules about its height and construction. But of course it is also the perfect opportunity: a blank canvas on which to show a vision of the life soon to be lived behind it."
                                            },
                                            {
                                                "example_id": "ec785ee3-2a00-47e4-880c-ba914f25626f",
                                                "sense_id": "d4e6929d-9c84-3c84-9e92-821b95788b76",
                                                "text": "They’re a familiar sight to many: the eye-roll-inducing, over-the-top development hoardings and adverts that celebrate the (inevitably luxury and, to most people, unaffordable) developments soon to be added to the city skyline."
                                            },
                                            {
                                                "example_id": "d8035cf5-affb-4ba4-a5a9-2797c13db588",
                                                "sense_id": "d4e6929d-9c84-3c84-9e92-821b95788b76",
                                                "text": "The west side is one massive building site, although it's hard to appreciate what's going on behind all the hoardings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "872dd066-03cc-39a9-a6b7-8c51e287f153",
                                        "entry_id": "c7590c3f-6dcb-3e46-a628-d057162b10ad",
                                        "glosses": [
                                            "A billboard."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2e2b29c-c6af-4118-82ad-64dc7934f76d",
                                                "sense_id": "872dd066-03cc-39a9-a6b7-8c51e287f153",
                                                "text": "Nobody has ever seen Big Brother. He is a face on the hoardings, a voice on the telescreen. We may be reasonably sure that he will never die, and there is already considerable uncertainty as to when he was born."
                                            },
                                            {
                                                "example_id": "39910aab-1573-4d6c-adf2-5b7eb6639cb7",
                                                "sense_id": "872dd066-03cc-39a9-a6b7-8c51e287f153",
                                                "text": "Today, by radio, and also on giant hoardings, a rabbi, an admiral notorious for his links to Masonry, a trio of cardinals, a trio, too, of insignificant politicians (bought and paid for by a rich and corrupt Anglo-Canadian banking corporation), inform us all of how our country now risks dying of starvation."
                                            },
                                            {
                                                "example_id": "39a57882-2e64-4074-bbff-aa89c3e4f104",
                                                "sense_id": "872dd066-03cc-39a9-a6b7-8c51e287f153",
                                                "text": "But holidaymakers arriving this weekend in Positano, on the Amalfi coast, are more likely to find their gaze captured by a vast Volkswagen Golf. The car, pictured on a giant hoarding, has launched the latest row over intrusive advertising in Italy's historic towns and cities."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hoarding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5aaf7fbb-895a-38bd-8ef1-2a5d6506c049",
