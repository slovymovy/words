                "senses": [
                    {
                        "sense_id": "9b6515b3-0742-374a-91bf-a9caacf81b66",
                        "entry_id": "2517da50-66d0-3b84-b478-ebd05a2541da",
                        "glosses": [
                            "dichtes Geflecht aus Draht oder Kunststoff zur Abscheidung feinster Flüssigkeitströpfchen aus Gasen, Dämpfen oder Nebeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f438ab0-2e61-4e92-be37-756cd1c8a035",
                                "sense_id": "9b6515b3-0742-374a-91bf-a9caacf81b66",
                                "text": "„Neben der Anwendung als Tropfenabscheider eignet sich der Demister auch als Ölnebelabscheider, Luftfilter Flammensperre, Füllkörper, Schalldämpfer, Isolationsmatte und Koaleszenz-Abscheider zur Phasentrennung von nicht mischbaren Flüssigkeiten.“"
                            },
                            {
                                "example_id": "3560ae05-5507-42a0-baeb-6d4b7c9f81c0",
                                "sense_id": "9b6515b3-0742-374a-91bf-a9caacf81b66",
                                "text": "„Im Gegensatz zum Agglomerator wird der Demister mit geringerer Luftgeschwindigkeit durchströmt.“"
                            },
                            {
                                "example_id": "fca6fa93-5896-4d09-9f4b-30caf9ca4b08",
                                "sense_id": "9b6515b3-0742-374a-91bf-a9caacf81b66",
                                "text": "„Eine weitere Verbesserung, insbesondere bei sehr feinen Tropfen, wird durch Zwischensetzen eines Demisters erreicht.“"
                            },
                            {
                                "example_id": "3df65579-f2ec-43a0-9b13-c499001e3356",
                                "sense_id": "9b6515b3-0742-374a-91bf-a9caacf81b66",
                                "text": "„Demister sind Wasserabscheider, die feuchte Luft, von einem großen Teil der Luftfeuchtigkeit, trennen.“"
                            },
                            {
                                "example_id": "e8081cd3-523c-4310-a939-c9b34f39b4ae",
                                "sense_id": "9b6515b3-0742-374a-91bf-a9caacf81b66",
                                "text": "„Das anhaltend hohe Fertigungsniveau lässt uns bestmögliche Ergebnisse, z. B. bei Demistern, Tröpfchen und Prall-Abscheidern, erzielen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
