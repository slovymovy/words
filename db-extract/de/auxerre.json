                        ]
                    },
                    {
                        "translation_id": "b712ad55-714d-40ed-8bc8-c4b35e5bbe7f",
                        "source_entry_id": "fa9d9337-4386-3fb1-9ffa-4d19e22c3418",
                        "source_sense_id": "1bc28c71-ffcd-3dee-aae7-5b7ef9e345ff",
                        "source_sense_description": "Stadt in Frankreich",
                        "target_lang_word": "Auxerre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auxerre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6765ae7b-a203-3da8-9000-c3b2c7e1d1f2",
                                        "entry_id": "c66b2a08-5df8-39db-96b2-45d390aaa13a",
                                        "glosses": [
                                            "Commune, ville et chef-lieu de département français, situé dans le département de l’Yonne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3d3d17a-3c8e-4652-a6fc-36d07b3c0e98",
                                                "sense_id": "6765ae7b-a203-3da8-9000-c3b2c7e1d1f2",
                                                "text": "Messieurs, je lève mon verre à la ville d’Auxerre, qui me reçoit avec un entrain si cordial et si chaleureux, et j’adresse à son Maire tous mes compliments."
                                            },
                                            {
                                                "example_id": "f1e277e1-2b2d-4a35-b4f0-8344d7c1e5b4",
                                                "sense_id": "6765ae7b-a203-3da8-9000-c3b2c7e1d1f2",
                                                "text": "— Cristi, les belles roses ! C’est épatant. Elles ne vont pas se faner, d’ici Auxerre, Claudine ? Nous couchons à Auxerre ce soir, vous savez. C’est à côté d’ici, cinquante kilomètres. Deux sales côtes, par exemple !"
                                            },
                                            {
                                                "example_id": "179f3d16-64b5-467f-9fed-efd1b2dca1c3",
                                                "sense_id": "6765ae7b-a203-3da8-9000-c3b2c7e1d1f2",
                                                "text": "Une vie difficile à suivre tellement Théo Perrot, né à Arquian (Nièvre) en plein pays potier, mort à Auxerre, a été instable : Paris, Londres, Lyon, Arquian, Auxerre ont à un moment ou à un autre abrité l’artiste."
                                            },
                                            {
                                                "example_id": "c52b393f-c5e1-47ac-9fb2-5e595e01e1c0",
                                                "sense_id": "6765ae7b-a203-3da8-9000-c3b2c7e1d1f2",
                                                "text": "En revanche pour Bruxelles, Auxerre, Auxonne, Auxey-Duresses et d’autres —villes et villages de Bourgogne— il convient de faire entendre le « x » pour ce qu’il est : un double « s ». On prononcera donc Brusselles, Ausserre, Aussonne, Aussey-Duresses. Restons dans les sifflantes."
                                            },
                                            {
                                                "example_id": "b655cd36-b01d-4a26-bff8-1a37152b9f55",
                                                "sense_id": "6765ae7b-a203-3da8-9000-c3b2c7e1d1f2",
                                                "text": "À Charbuy, dans l’Yonne, Anaïs Sanjuan, maraîchère, a testé un appareil génération, rapporte France Bleu Auxerre : un robot, autonome, s’est ainsi occupé, pendant un mois, des semis de carottes, puis du désherbage des rangées de légumes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
