                        "translation_id": "f718c0bd-abb5-45a2-8118-16b7dc7d08e3",
                        "source_entry_id": "c5ba7ddb-03a1-3b16-a951-3235d25023ca",
                        "source_sense_id": "532e339c-6940-32b6-b3f9-14e324e9bed0",
                        "target_lang_word": "Bötchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bötchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d38db76-7d43-394e-a58d-61f91b5066a7",
                                        "entry_id": "5492031e-7689-3bb2-a661-60ed532e6085",
                                        "glosses": [
                                            "kleines Boot"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47a19a86-5af5-49ec-a125-a01bef6055c8",
                                                "sense_id": "6d38db76-7d43-394e-a58d-61f91b5066a7",
                                                "text": "Komm, wir nehmen das Bötchen!"
                                            },
                                            {
                                                "example_id": "fea0859f-6a6f-4ba7-8f60-e9aaafacd387",
                                                "sense_id": "6d38db76-7d43-394e-a58d-61f91b5066a7",
                                                "text": "Schon im Frühling kann man Bötchen fahren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54e40112-8a8f-4b0e-86e6-4e4d921591b8",
                        "source_entry_id": "c5ba7ddb-03a1-3b16-a951-3235d25023ca",
                        "source_sense_id": "532e339c-6940-32b6-b3f9-14e324e9bed0",
                        "target_lang_word": "лодочка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лодочка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "355b453f-4726-30b2-a066-b1b00bf0c5b7",
                                        "entry_id": "53b8c7ee-cb65-3fc9-88d2-ae1f81323afe",
                                        "glosses": [
                                            "уменьш. к лодка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53f9ea77-7274-4d7b-9ace-f83c398bbc12",
                                                "sense_id": "355b453f-4726-30b2-a066-b1b00bf0c5b7",
                                                "text": "Вода в пруде почернела, и лёгкая лодочка уже скользила по ней, и слышался плеск весла и смешки какой-то гражданки в лодочке."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a3756ea-156d-3361-90db-375235e48d05",
                                        "entry_id": "53b8c7ee-cb65-3fc9-88d2-ae1f81323afe",
                                        "glosses": [
                                            "открытая (как правило, дамская) туфля без ремешка и застёжки"
                                        ],
                                        "tags": [
                                            "обычно мн. ч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "420e4918-a666-4b20-83b0-0716e6370c7a",
                                                "sense_id": "7a3756ea-156d-3361-90db-375235e48d05",
                                                "text": "У песочницы стояли чёрные лодочки на высоких каблуках, будто сняла женщина туфли ненужные и побежала дальше."
                                            },
                                            {
                                                "example_id": "88b9e7c1-d6d0-48a1-8596-cff5741a25b9",
                                                "sense_id": "7a3756ea-156d-3361-90db-375235e48d05",
                                                "text": "Мама переодевалась в лёгкое ситцевое платье и в бежевых лодочках легко сбегала по шаткому трапу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d16bef42-1411-35e9-ba15-ca3c9af58364",
                                        "entry_id": "53b8c7ee-cb65-3fc9-88d2-ae1f81323afe",
                                        "glosses": [
                                            "ботан. один из двух нижних лепестков растений семейства мотыльковых"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "05608912-edd4-3072-ba43-149e79e926a5",
                                        "entry_id": "53b8c7ee-cb65-3fc9-88d2-ae1f81323afe",
                                        "glosses": [
                                            "перен. любой предмет продолговатой формы, расширяющийся к середине и сужающийся к концам (часто — сосуд или углубление такой формы)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bc903f2-4563-444a-9b4d-005819dd58d9",
                                                "sense_id": "05608912-edd4-3072-ba43-149e79e926a5",
                                                "text": "Шея вытянута, обе руки согнуты в локтях и поставлены на стол, ладонь и пальцы образуют лодочку."
                                            },
                                            {
                                                "example_id": "2b9a4c6f-5298-400d-a66d-fb8394774d47",
                                                "sense_id": "05608912-edd4-3072-ba43-149e79e926a5",
                                                "text": "Для этой цели производители разработали всевозможные ролики и резаки для различных видов теста. Это и стандартные круглые, овальные, шестиугольные, восьмиугольные, гофрированные и прямые резаки, и резаки-сердечки, лодочки, лепестки, рыбки ― словом, любые формы, вплоть до мифологических заморских чудовищ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
