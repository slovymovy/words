        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "127405e4-69bb-34ad-9731-0ca8f939ab65",
                "word": "organoleptic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9f18fb20-466d-31c9-9511-4801ed9e7171",
                        "entry_id": "127405e4-69bb-34ad-9731-0ca8f939ab65",
                        "glosses": [
                            "Of or pertaining to the sensory properties of a particular food or chemical, the taste, colour, odour, and feel."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4085585e-6a7d-484f-b54c-2e590ac21d8a",
                                "sense_id": "9f18fb20-466d-31c9-9511-4801ed9e7171",
                                "text": "The organoleptic assessment of the wine showed that it was spoiled."
                            },
                            {
                                "example_id": "d82fa60d-aa1d-47a5-81a8-af238da7d6c1",
                                "sense_id": "9f18fb20-466d-31c9-9511-4801ed9e7171",
                                "text": "At some point in the history of QC evaluations of alcohol beverages the phrase ‘organoleptic testing’ crept into the industry's vocabulary. Though organoleptic testing does refer to the use of the senses for product evaluations, that is where the comparison to sensory evaluation stops."
                            }
                        ]
                    }
                ],
                "translations": [
