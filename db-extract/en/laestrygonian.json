                                        "examples": [
                                            {
                                                "example_id": "c62d2b53-b70e-4b4c-9617-f90cd3a0c822",
                                                "sense_id": "416dd7ef-ac7b-35be-a953-fc98ad55bb13",
                                                "text": "Crocodile trompeur, de qui le cœur félon\nEst pire qu'un satrape ou bien qu'un Lestrygon."
                                            }
                                        ]
                                    }
                                ]
                            }
