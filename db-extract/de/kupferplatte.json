                        "examples": [
                            {
                                "example_id": "037a372b-e3d2-4b3c-8fd6-10df9310fd37",
                                "sense_id": "70faf744-0874-3e1d-9786-e8ddc4adc81a",
                                "text": "„Für die Experimente wurde eine Kupferplatte mit einer dünnen Kunststoffschicht überzogen.“"
                            },
                            {
                                "example_id": "fe9f1657-64e0-4876-b75a-9d9eb80f3f82",
                                "sense_id": "70faf744-0874-3e1d-9786-e8ddc4adc81a",
                                "text": "„Von den Längsseiten des Dachfirstes hingen, grün in der Sonne aufleuchtend, gewaltige Kupferplatten herab, die zu einer schrundigen Masse mit ausgezackten Kanten verschmolzen waren.“"
                            }
                        ],
