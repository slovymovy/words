                        "examples": [
                            {
                                "example_id": "68e54eca-41cc-4183-9c2d-8b835e57f029",
                                "sense_id": "b66b8d7e-4692-3632-9bad-7289619dc8ed",
                                "text": "T’as réussi à te dépatouiller de tes problèmes de voiture? – Ouais! je l’ai mise à la casse!",
