                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc766d68-6447-42b9-b93e-09983893e5ef",
                                                "sense_id": "c81abd56-62c3-3a63-a2fc-c0129c557555",
                                                "text": "I was a bit under the weather last night: out with a party of friends, you know. Dare say we all had a bit more than we could carry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1711a610-0487-3185-9843-ac2f8df2055a",
                                        "entry_id": "714a0ddf-3f12-3169-a61c-2aeada808fba",
                                        "glosses": [
                                            "Experiencing adversity."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ee17e9d-9149-4c4b-bf3f-d3cb69d820a7",
                                                "sense_id": "1711a610-0487-3185-9843-ac2f8df2055a",
                                                "text": "The Hawkinses are under the weather now, but their Tennessee property is millions when it comes into market."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a32795e-5395-4417-bff7-3ef1a4e5001c",
