                        "glosses": [
                            "In Norse and Icelandic culture, a duel to the death."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5b2166fb-1c80-4b72-8140-080d4ddac424",
                                "sense_id": "7e08a479-4075-3930-8872-4ef219c86f47",
                                "text": "A man could no longer be challenged for his lands or his women-folk, since the only result of holmgang which the law would allow, apart from wounds or death, was a claim for the payment of the agreed stakes."
                            },
                            {
                                "example_id": "525467aa-e206-4b11-b75f-b988c2277c6a",
                                "sense_id": "7e08a479-4075-3930-8872-4ef219c86f47",
                                "text": "The influence of Christianity may have hastened the end of holmgang in Iceland, but long before the conversion of the country enlightened public opinion had come to see the absurdity of single combat as a method of settling disputes."
                            },
                            {
                                "example_id": "c8e1defa-c998-4d28-9e01-f2d8c67af63b",
                                "sense_id": "7e08a479-4075-3930-8872-4ef219c86f47",
                                "text": "Some members of the council suggested a holmgang."
                            }
                        ]
                    }
                ],
