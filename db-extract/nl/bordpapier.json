                                            "Publicité"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bebd66d3-8392-3ae1-9058-0ee81a2dd424",
                                        "entry_id": "a9e7a240-db4e-30aa-9d30-36295b68c149",
                                        "glosses": [
                                            "Carte complémentaire d’une carte principale, figurant sur la même feuille et souvent établie à une échelle différente."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f4f6741f-d728-3aa9-b28c-ca052ec113ea",
                                        "entry_id": "a9e7a240-db4e-30aa-9d30-36295b68c149",
                                        "glosses": [
                                            "Carte de bristol placée devant chaque couvert d'une table et indiquant les noms des convives."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a8919fa-b378-4bf2-9c18-570ccb480b9a",
                                                "sense_id": "f4f6741f-d728-3aa9-b28c-ca052ec113ea",
                                                "text": "Après, il y a les petites tables rondes, et, quand on a trouvé son carton, l’inquiétude d’avoir à estimer l’intensité de la contrainte à la lecture des cartons voisins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ce2a3bf-69d1-39c2-8b45-271cacf82539",
                                        "entry_id": "a9e7a240-db4e-30aa-9d30-36295b68c149",
                                        "glosses": [
                                            "Se dit de quelqu'un ou de quelque chose de faux, de factice."
                                        ],
                                        "tags": [],
                                        "examples": [
