                        "glosses": [
                            "Joueur disputant sa première année dans une division."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7297528d-9e08-4798-8d75-f1c2f01a7936",
                                "sense_id": "b6fd0652-1c59-318c-8457-bfa9a9da7c79",
                                "text": "C’est la meilleure position : le rookie, s’il perd aux points, on dira que c’est un beau combat, si le champion perd, ce sera moyen."
                            },
                            {
                                "example_id": "25659eaf-04de-4c44-9454-1ea316a6c037",
                                "sense_id": "b6fd0652-1c59-318c-8457-bfa9a9da7c79",
                                "text": "Mais sincèrement, n’étant même pas rookie, je n’ai pas mon mot à dire."
                            },
                            {
                                "example_id": "e8172d8a-12e3-4d86-bdc4-ca50d3885ddd",
                                "sense_id": "b6fd0652-1c59-318c-8457-bfa9a9da7c79",
                                "text": "Premier rookie depuis Shaquille O’Neal avec plus de 100 points et 10 contres sur ses cinq premiers matchs, Wembayana a réussi son examen de passage, adoubé par les cadors, comme Kevin Durant, qui ne voit « personne comme lui en NBA. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "7738f0be-e5c2-3f48-ad0c-55d9a7a581d9",
                        "entry_id": "b56493ed-7fb2-3285-a408-b8a8ceec2196",
                        "glosses": [
                            "Amateur, débutant."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
