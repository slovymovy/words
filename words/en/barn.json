                            {
                                "target_lang_word": "kůlna",
                                "target_lang_sense_clarification": "menší hospodářská stavba"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3300a02-ad0c-3dd4-bc10-4b90c8be3f40",
                    "sense_definition": "An arena, especially a large or old building used for sports events.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "building",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hockey team plays their home games in a drafty old <w>barn</w> downtown.",
                            "target_lang_translations": {
                                "ru": "Хоккейная команда играет свои домашние матчи на старой, продуваемой сквозняками <w>арене</w> в центре города.",
                                "zh": "冰球队在市中心那座四面透风的旧<w>体育馆</w>里进行主场比赛。",
                                "cs": "Hokejový tým hraje své domácí zápasy v průvanem zmítané staré <w>aréně</w> v centru města."
                            }
                        },
                        {
                            "text": "Fans packed the <w>barn</w> to watch the championship match.",
                            "target_lang_translations": {
                                "ru": "Болельщики заполнили <w>стадион</w>, чтобы посмотреть финальный матч.",
                                "zh": "球迷们挤满了<w>竞技场</w>观看冠军赛。",
                                "cs": "Fanoušci zaplnili <w>arénu</w>, aby sledovali finálový zápas."
                            }
                        }
                    ],
                    "common_phrases": [
                        "old barn"
                    ],
                    "traits": [
                        {
