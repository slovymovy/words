                "forms": [],
                "senses": [
                    {
                        "sense_id": "d9d8e0df-2668-3c20-afed-824ce25c8173",
                        "entry_id": "178bf026-2c49-3107-a5c0-2a5ebb62ca57",
                        "glosses": [
                            "赶紧，马上，快快"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "005f00c2-b002-4a53-87b6-a5b1cdb88560",
                                "sense_id": "d9d8e0df-2668-3c20-afed-824ce25c8173",
                                "text": "Wenn er ’n bisschen dalli macht, könnte er’s noch schaffen.",
                                "translation": "如果他抓紧点，他还能赶得上。"
                            },
                            {
                                "example_id": "868eaa0b-a47e-4ab2-8e7f-9a2891e36a50",
                                "sense_id": "d9d8e0df-2668-3c20-afed-824ce25c8173",
                                "text": "Ja, los! Dalli!",
                                "translation": "对，走！赶紧的！"
                            },
                            {
                                "example_id": "56ae9291-40e3-49d6-a529-6a9fdd9252a6",
                                "sense_id": "d9d8e0df-2668-3c20-afed-824ce25c8173",
                                "text": "Wenn du dich dalli anziehst, nehm ich dich mit.",
                                "translation": "如果你赶紧穿好衣服，我可以带你一起走。"
                            }
                        ]
                    }
