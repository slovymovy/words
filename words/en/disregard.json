{
    "word_family": [
        "regard",
        "regardless",
        "regardful"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "817c27ef-0c0a-3c79-8f6d-78bc473680ab",
                    "sense_definition": "To pay no attention to something; to ignore.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "group_ignore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>disregard</w> the previous email as it contained an error.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>не обращайте внимания</w> на предыдущее письмо, так как оно содержало ошибку.",
                                "zh": "请<w>忽略</w>之前的电子邮件，因为它包含错误。",
                                "nl": "Gelieve de vorige e-mail te <w>negeren</w>, aangezien deze een fout bevatte."
                            }
                        },
                        {
                            "text": "He chose to <w>disregard</w> the advice of his doctor.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>пренебречь</w> советом своего врача.",
                                "zh": "他选择<w>无视</w>医生的建议。",
                                "nl": "Hij koos ervoor om het advies van zijn dokter <w>naast zich neer te leggen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ignore"
                    ],
                    "antonyms": [
                        "heed",
                        "pay attention to",
                        "mind"
                    ],
                    "common_phrases": [
                        "disregard the warning",
                        "please disregard",
                        "disregard instructions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не обращать внимания на что-либо; игнорировать.",
                        "zh": "不予理会；忽视。",
                        "nl": "Geen aandacht schenken aan iets; iets opzettelijk negeren of naast zich neerleggen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "игнорировать",
                                "target_lang_sense_clarification": "умышленно не замечать"
                            },
                            {
                                "target_lang_word": "пренебрегать",
                                "target_lang_sense_clarification": "относиться без должного внимания или уважения"
                            },
                            {
                                "target_lang_word": "не обращать внимания",
                                "target_lang_sense_clarification": "оставлять без реакции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "忽视",
                                "target_lang_sense_clarification": "不注意或不重视"
                            },
                            {
                                "target_lang_word": "不理会",
                                "target_lang_sense_clarification": "对某事不予理睬"
                            },
                            {
                                "target_lang_word": "无视",
                                "target_lang_sense_clarification": "故意不看或不理睬"
                            },
                            {
                                "target_lang_word": "忽略",
                                "target_lang_sense_clarification": "指对某事不予理会、略过不看。"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "negeren",
                                "target_lang_sense_clarification": "geen aandacht aan besteden"
                            },
                            {
                                "target_lang_word": "veronachtzamen",
                                "target_lang_sense_clarification": "verwaarlozen of niet in acht nemen"
                            },
                            {
                                "target_lang_word": "naast zich neerleggen",
                                "target_lang_sense_clarification": "een advies, waarschuwing of verzoek negeren"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "19d5bb92-d55c-3d29-a11c-2997630ea639",
                    "sense_definition": "The act of deliberately ignoring or not caring about something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_ignore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver showed a reckless <w>disregard</w> for the safety of others.",
                            "target_lang_translations": {
                                "ru": "Водитель проявил безрассудное <w>пренебрежение</w> безопасностью окружающих.",
                                "zh": "那名司机表现出对他人安全极其鲁莽的<w>漠视</w>。",
                                "nl": "De bestuurder toonde een roekeloze <w>veronachtzaming</w> van de veiligheid van anderen."
                            }
                        },
                        {
                            "text": "Her complete <w>disregard</w> for the rules led to her dismissal.",
                            "target_lang_translations": {
                                "ru": "Её полное <w>пренебрежение</w> правилами привело к её увольнению.",
                                "zh": "她对规则的完全<w>不顾</w>导致了她被解雇。",
                                "nl": "Haar totale <w>minachting</w> voor de regels leidde tot haar ontslag."
                            }
                        }
                    ],
                    "antonyms": [
                        "attention",
                        "concern",
                        "regard"
                    ],
                    "common_phrases": [
                        "disregard for",
                        "total disregard",
                        "reckless disregard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт намеренного игнорирования или безразличия к чему-либо.",
                        "zh": "故意忽视或漠不关心的行为。",
                        "nl": "Het opzettelijk negeren van of geen rekening houden met iets."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пренебрежение",
                                "target_lang_sense_clarification": "отсутствие уважения или заботы"
                            },
                            {
                                "target_lang_word": "игнорирование",
                                "target_lang_sense_clarification": "намеренное оставление без внимания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "漠视",
                                "target_lang_sense_clarification": "冷淡地对待，不放在心上"
                            },
                            {
                                "target_lang_word": "不顾",
                                "target_lang_sense_clarification": "不考虑或不理会"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "veronachtzaming",
                                "target_lang_sense_clarification": "het nalaten van zorg of aandacht"
                            },
                            {
                                "target_lang_word": "minachting",
                                "target_lang_sense_clarification": "het volkomen niet respecteren van iets"
                            },
                            {
                                "target_lang_word": "negeren",
                                "target_lang_sense_clarification": "het buiten beschouwing laten (als handeling)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}