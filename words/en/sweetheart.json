                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fraternity elected their new <w>sweetheart</w> at the annual spring formal.",
                            "target_lang_translations": {
                                "ru": "Братство выбрало свою новую <w>королеву</w> на ежегодном весеннем балу.",
                                "zh": "兄弟会在年度春季舞会上选出了他们的新<w>会花</w>。"
                            }
                        },
                        {
                            "text": "She served as the chapter <w>sweetheart</w> during her senior year of college.",
                            "target_lang_translations": {
                                "ru": "Она была <w>любимицей</w> отделения на последнем курсе колледжа.",
                                "zh": "她在大学四年级时担任了分会的<w>会花</w>。"
                            }
                        }
