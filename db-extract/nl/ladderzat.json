                                                "sense_id": "d54f1338-a767-352a-a34f-67a34b1cc67d",
                                                "text": "I was so smashed last night, I don’t remember how I got home!"
                                            },
                                            {
                                                "example_id": "3f4152ad-4cf4-44c3-b29a-640ed3353713",
                                                "sense_id": "d54f1338-a767-352a-a34f-67a34b1cc67d",
