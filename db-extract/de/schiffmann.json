                ],
                "senses": [
                    {
                        "sense_id": "f6520ad6-3220-3f27-9720-fe4cbcfcecef",
                        "entry_id": "839c0b53-d569-32ee-8e96-463be239bf81",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c732c9e-27bf-4e1a-8003-e7871fc63af7",
                                "sense_id": "f6520ad6-3220-3f27-9720-fe4cbcfcecef",
                                "text": "Frau Schiffmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "081766c9-de3f-486f-a19c-c93cb84a790c",
                                "sense_id": "f6520ad6-3220-3f27-9720-fe4cbcfcecef",
                                "text": "Herr Schiffmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "493f64cb-41e1-4db7-9258-c9a3596fb208",
                                "sense_id": "f6520ad6-3220-3f27-9720-fe4cbcfcecef",
                                "text": "Die Schiffmanns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "ef6f961c-dd80-44f5-adec-4864acc1f9b7",
                                "sense_id": "f6520ad6-3220-3f27-9720-fe4cbcfcecef",
                                "text": "Der Schiffmann trägt nie die Schals, die die Schiffmann ihm strickt."
                            },
                            {
                                "example_id": "fcf685da-1094-4fa9-b748-b14396823f54",
                                "sense_id": "f6520ad6-3220-3f27-9720-fe4cbcfcecef",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schiffmann kommt, geht der Herr Schiffmann.“"
                            },
                            {
                                "example_id": "2f669ef2-f68d-4d15-a854-384738361b29",
                                "sense_id": "f6520ad6-3220-3f27-9720-fe4cbcfcecef",
                                "text": "Schiffmann kommt und geht."
                            },
                            {
                                "example_id": "29da9c21-7f1a-4114-9864-412ead1e77f4",
                                "sense_id": "f6520ad6-3220-3f27-9720-fe4cbcfcecef",
                                "text": "Schiffmanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
