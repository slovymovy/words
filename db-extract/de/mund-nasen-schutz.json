                ],
                "senses": [
                    {
                        "sense_id": "885064db-121a-3f21-a06a-c10bad434db6",
                        "entry_id": "8198203a-494b-304d-a12a-7d2f31b79354",
                        "glosses": [
                            "Textil, das Mund und Nasenlöcher bedeckt beziehungsweise professionelle Atemschutzmaske zur Verringerung von Atemtröpfchen durch Husten, Niesen und beim Sprechen"
                        ],
                        "tags": [
                            "Infektionsschutz"
                        ],
                        "examples": [
                            {
                                "example_id": "78ad0be6-3c61-46a1-b10d-3e7f3258bb03",
                                "sense_id": "885064db-121a-3f21-a06a-c10bad434db6",
                                "text": "„Um die Ausbreitung des Corona-Virus einzudämmen, gilt in allen Bundesländern eine Pflicht zum Tragen eines Mund-Nasen-Schutzes in Geschäften und in öffentlichen Verkehrsmitteln.“"
                            },
                            {
                                "example_id": "cebec91c-b57f-4e35-9707-9bbcc1595bcd",
                                "sense_id": "885064db-121a-3f21-a06a-c10bad434db6",
                                "text": "„Vor Betreten der Krankenräume frische, ggf. sterile Kleidung (Kittel, Mund-Nasen-Schutz, Überschuhe, Handschuhe) anlegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
