                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65cc5a2c-aff6-4d71-8fd0-9c8e04fc7fc4",
                                                "sense_id": "b3bd96c1-3563-3026-9628-85ca59a3f46a",
                                                "text": "Ik weet nog goed dat ik zijn rechterarm vasthield en bezig was om die op zijn rug te draaien. Ik had daartoe mijn linkerhand om zijn bovenarm en met mijn rechterhand zijn pols beet. Terwijl ik zijn arm omdraaide merkte ik dat hij zich verzette tegen de aanhouding. Ik voelde hem kracht zetten. Ik voelde en hoorde een kraak."
                                            }
                                        ]
