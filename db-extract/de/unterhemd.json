                        "form": "die Unterhemden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "69609807-ecac-3203-b1e3-0efcd0245cb2",
                        "entry_id": "5ee5d32f-1250-329e-834d-b57ee69cad86",
                        "glosses": [
                            "ein Hemd, das direkt auf der Haut unter der anderen Kleidung getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5d07f23-3054-481c-8238-7e6a37dd61bb",
                                "sense_id": "69609807-ecac-3203-b1e3-0efcd0245cb2",
                                "text": "Nicht jeder mag Unterhemden tragen."
                            },
                            {
                                "example_id": "4b4b2ffa-75aa-4c44-89bd-f5eaffe01837",
                                "sense_id": "69609807-ecac-3203-b1e3-0efcd0245cb2",
                                "text": "„Später traf ich auf Daníel, der in seinem zerlöcherten Unterhemd in der Küche saß und unter dem Weihnachtsstern rauchte.“"
                            },
                            {
                                "example_id": "379a8563-58ee-45f7-91d0-ebc96eedc159",
                                "sense_id": "69609807-ecac-3203-b1e3-0efcd0245cb2",
                                "text": "„Er war im Unterhemd und hustete.“"
                            },
                            {
                                "example_id": "725a6d5b-6b7d-4a2c-bc8f-48b8150eb944",
                                "sense_id": "69609807-ecac-3203-b1e3-0efcd0245cb2",
                                "text": "„Sie sitzen in ihren Unterhemden zwischen den Obstkisten und lassen eine Flasche Wein herumgehen.“"
                            },
                            {
                                "example_id": "918f4d45-48bf-4cc3-9644-73dfbc186684",
                                "sense_id": "69609807-ecac-3203-b1e3-0efcd0245cb2",
                                "text": "„Auf gut Glück klopfte er an irgendeine Tür, worauf ein muskulöser Glatzkopf im Unterhemd öffnete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d02935e0-3c22-47d5-8201-528c0537d1f6",
