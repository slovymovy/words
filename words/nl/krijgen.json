{
    "word_family": [
        "verkrijgen",
        "krijger",
        "krijgsmacht",
        "krijgskunst",
        "krijgsgevangene"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "af6b0699-1e5f-3087-b867-632bd0243d37",
                    "sense_definition": "iets ontvangen of in bezit nemen, variërend van concrete objecten tot abstracte zaken zoals nieuws of een cadeau",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "ontvangen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze heeft van haar familie een mooi huwelijkskado <w>gekregen</w>.",
                            "target_lang_translations": {
                                "en": "She <w>received</w> a beautiful wedding gift from her family."
                            }
                        },
                        {
                            "text": "Ik weet niet waar hij dat vreemde idee heeft <w>gekregen</w>.",
                            "target_lang_translations": {
                                "en": "I don't know where he <w>got</w> that strange idea."
                            }
                        }
                    ],
                    "synonyms": [
                        "bekomen"
                    ],
                    "antonyms": [
                        "geven",
                        "schenken"
                    ],
                    "common_phrases": [
                        "een cadeau krijgen",
                        "antwoord krijgen",
                        "straf krijgen"
                    ],
                    "target_lang_definitions": {
                        "en": "to receive or take possession of something, ranging from concrete objects to abstract things like news or a gift"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get",
                                "target_lang_sense_clarification": "to obtain or acquire"
                            },
                            {
                                "target_lang_word": "receive",
                                "target_lang_sense_clarification": "to be given something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18b4950a-4c1e-3126-8910-9dc38f8b1239",
                    "sense_definition": "een ziekte oplopen of beginnen te lijden aan een lichamelijke kwaal",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ziekte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb een zware verkoudheid <w>gekregen</w> door de kou.",
                            "target_lang_translations": {
                                "en": "I <w>caught</w> a bad cold because of the cold weather."
                            }
                        },
                        {
                            "text": "Vlak voor het belangrijke examen <w>kreeg</w> hij plotseling de griep.",
                            "target_lang_translations": {
                                "en": "Just before the important exam, he suddenly <w>got</w> the flu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de griep krijgen",
                        "een ziekte krijgen"
                    ],
                    "target_lang_definitions": {
                        "en": "to contract a disease or start suffering from a physical ailment"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get",
                                "target_lang_sense_clarification": "to become ill with"
                            },
                            {
                                "target_lang_word": "catch",
                                "target_lang_sense_clarification": "to contract an illness"
                            },
                            {
                                "target_lang_word": "come down with",
                                "target_lang_sense_clarification": "to start to suffer from"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "057d69ec-6292-3631-be9f-0591f80af6e8",
                    "sense_definition": "iets of iemand in een bepaalde toestand of positie doen belanden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "veroorzaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>krijg</w> mijn oude auto vanmorgen echt niet gestart.",
                            "target_lang_translations": {
                                "en": "I really can't <w>get</w> my old car started this morning."
                            }
                        },
                        {
                            "text": "Maak je geen zorgen, ik <w>krijg</w> dat wel in orde.",
                            "target_lang_translations": {
                                "en": "Don't worry, I will <w>get</w> that sorted out."
                            }
                        }
                    ],
                    "common_phrases": [
                        "klaar krijgen",
                        "aan de praat krijgen",
                        "in orde krijgen"
                    ],
                    "target_lang_definitions": {
                        "en": "to cause something or someone to end up in a certain state or position"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get",
                                "target_lang_sense_clarification": "to cause to become or move"
                            },
                            {
                                "target_lang_word": "make",
                                "target_lang_sense_clarification": "to cause to be in a state"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b596c85d-9d93-3426-a0db-f31808af5ece",
                    "sense_definition": "hulpwerkwoord gebruikt om een passieve zin te vormen waarbij het indirect object het onderwerp wordt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De winnaar <w>kreeg</w> gisteren een gouden medaille uitgereikt.",
                            "target_lang_translations": {
                                "en": "The winner <w>was</w> presented with a gold medal yesterday."
                            }
                        },
                        {
                            "text": "Hij <w>kreeg</w> de instructies duidelijk uitgelegd door zijn manager.",
                            "target_lang_translations": {
                                "en": "He <w>had</w> the instructions clearly explained to him by his manager."
                            }
                        }
                    ],
                    "common_phrases": [
                        "uitgereikt krijgen",
                        "toegestuurd krijgen"
                    ],
                    "target_lang_definitions": {
                        "en": "auxiliary verb used to form a passive sentence where the indirect object becomes the subject"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get",
                                "target_lang_sense_clarification": "used to form the dynamic passive voice"
                            },
                            {
                                "target_lang_word": "have",
                                "target_lang_sense_clarification": "to experience something being done to you"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5af4d4a9-fbdb-326b-8633-c61cb7d8e03f",
                    "sense_definition": "oorlog voeren of strijd leveren tegen een vijand",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "oorlog",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij trokken op om tegen de vijandige stammen te <w>krijgen</w>.",
                            "target_lang_translations": {
                                "en": "They marched out to <w>wage war</w> against the hostile tribes."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Voornamelijk in bijbelse of historische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to wage war or engage in battle against an enemy"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wage war",
                                "target_lang_sense_clarification": "to carry on a battle"
                            },
                            {
                                "target_lang_word": "fight",
                                "target_lang_sense_clarification": "to engage in combat"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cc88ccb2-ea2e-3286-85a6-71cfa7aaf51f",
                    "sense_definition": "meervoud van <w>krijg</w>; gewapende strijd of oorlog",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "oorlog",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude verhalen spreken over vele bloedige <w>krijgen</w> tussen de volkeren.",
                            "target_lang_translations": {
                                "en": "The old stories speak of many bloody <w>wars</w> between the peoples."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Verouderd meervoud van krijg"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of 'krijg'; armed conflict or war"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wars",
                                "target_lang_sense_clarification": "armed conflicts"
                            },
                            {
                                "target_lang_word": "battles",
                                "target_lang_sense_clarification": "fights between armies"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
