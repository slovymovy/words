                ],
                "senses": [
                    {
                        "sense_id": "7957b679-d893-3cee-9e95-5d196805a59a",
                        "entry_id": "0981f6a7-d3d5-3e71-bef0-5670cc1b1d64",
                        "glosses": [
                            "zum Umweltrecht gehöriger Rechtsbereich, der unter anderem den Umgang mit Abfall regelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "912eb12b-dc1d-49fc-bc01-7ffbafb10608",
                                "sense_id": "7957b679-d893-3cee-9e95-5d196805a59a",
                                "text": "„Nach deutschem Abfallrecht sind Abfälle bewegliche Sachen, deren sich der Besitzer entledigen will oder deren geordnete Entsorgung zur Wahrung des Wohls der Allgemeinheit geboten ist, insbesondere zum Schutz der Umwelt.“"
                            },
                            {
                                "example_id": "883138a3-a439-478f-b2e7-d8ae5816ffef",
                                "sense_id": "7957b679-d893-3cee-9e95-5d196805a59a",
                                "text": "„Im Gegensatz zum früheren Abfallrecht werden auch Rest- oder Wertstoffe wie ungebrauchte Produktionsreste oder recyclingfähiges Altpapier vom Abfallbegriff erfasst.“"
                            },
                            {
                                "example_id": "a4d6a237-27fb-4556-9866-5870fd8b688f",
                                "sense_id": "7957b679-d893-3cee-9e95-5d196805a59a",
                                "text": "„Ausgenommen vom allgemeinen Abfallrecht sind Sachen, die nach spezielleren Rechtsvorschriften zu beseitigen sind (z. B. Kernbrennstoffe, Kampfmittel, Tierkörper).“"
                            },
                            {
                                "example_id": "cde50430-f337-4c9d-b733-c6240c781fd8",
                                "sense_id": "7957b679-d893-3cee-9e95-5d196805a59a",
                                "text": "„Gefahrenkennzeichnungen sind im Abfallrecht, Chemikalienrecht, Gerätesicherheitsrecht und Gefahrenguttransportrecht vorgeschrieben, können jedoch im Einzelfall voneinander abweichen.“"
                            },
                            {
                                "example_id": "3a5182de-1636-4f5e-8633-bf1e065f3768",
                                "sense_id": "7957b679-d893-3cee-9e95-5d196805a59a",
                                "text": "„Das Abfallrecht dient dazu, die natürlichen Ressourcen zu schonen und die umweltverträgliche Beseitigung von Abfällen zu sichern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
