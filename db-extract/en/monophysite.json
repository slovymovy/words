                "senses": [
                    {
                        "sense_id": "912660e2-9c7d-3ed1-a5b9-c3e48c6474c7",
                        "entry_id": "473f975b-6e56-3eb7-8ed3-b823890bfb80",
                        "glosses": [
                            "Describing the beliefs of a Μonophysite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14ca4e46-0339-499b-bb98-b49f874d2946",
                                "sense_id": "912660e2-9c7d-3ed1-a5b9-c3e48c6474c7",
                                "text": "It followed that however orthodox the Emperor might desire to be, he was forced, if he was a wise man, to take account of the strong bodies of monophysite opinion, which were to be found in Constantinople, in Mesopotamia, in Syria and in Egypt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ded8b987-b4c7-45aa-8d45-9d073059e84f",
                        "source_entry_id": "473f975b-6e56-3eb7-8ed3-b823890bfb80",
                        "source_sense_id": "912660e2-9c7d-3ed1-a5b9-c3e48c6474c7",
                        "source_sense_description": "Describing the beliefs of a Μonophysite",
                        "target_lang_word": "monophysite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monophysite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07abc3e8-dae7-3d1c-9389-9d696a267d7a",
                                        "entry_id": "6ad36d0e-1bbe-39d0-ae21-adcf69689070",
                                        "glosses": [
                                            "Relatif du monophysisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ef4be16-31f7-4783-9bfc-f596fd94c2eb",
                                                "sense_id": "07abc3e8-dae7-3d1c-9389-9d696a267d7a",
                                                "text": "Les groupes religieux minoritaires ne sont pas forcément rejetés : les adeptes de la religion monophysite, ou les quakers ou les amishs, ne sont l'objet d'aucune suspicion."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "monophysite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ca3e4f7-c5ff-3e81-935d-a27fd09699ec",
                                        "entry_id": "040f61a8-5b06-35d8-a245-1fbb0bda45ca",
                                        "glosses": [
                                            "Partisan du monophysisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a8480db-c049-4229-9652-f61b464a43d1",
                                                "sense_id": "9ca3e4f7-c5ff-3e81-935d-a27fd09699ec",
                                                "text": "Plusieurs prélats l’avaient prévenus, dont Ephrem, le patriarche d’Antioche, indéfectible chalcédonien : Anthime, le détenteur du siège de Constantinople, récemment investi, était un monophysite, et un monophysite actif !"
                                            },
                                            {
                                                "example_id": "19ca51d1-e7f1-416d-a84f-6239c2625060",
                                                "sense_id": "9ca3e4f7-c5ff-3e81-935d-a27fd09699ec",
                                                "text": "Alors que le concile de Chalcédoine en 451 reconnaissait dans l'unique personne du Christ deux natures distinctes, divine et humaine, les monophysites, qui ne reconnaissaient qu'une seule nature divine, étaient encore nombreux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
