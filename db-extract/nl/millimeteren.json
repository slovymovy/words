                                        "sense_id": "d0cedede-4158-34f2-a083-dd47a2bb895b",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "A photograph or other image that has been reduced by removing the outer parts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a25f51ac-6b27-4f5a-b2f2-1d33e3e4f245",
                                                "sense_id": "d0cedede-4158-34f2-a083-dd47a2bb895b",
                                                "text": "This indicates to the engraver that the subject may be cropped to yield the size desired, but it is advisable that the position for the crop also be determined and marked, else some essential feature of the copy may be cut off by arbitrary cropping to get the required size."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4877e70-af82-351c-80a1-fbd13a233b53",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "A short haircut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a05fd2c3-6375-41e6-ae8f-0c5cd1c9c954",
                                                "sense_id": "a4877e70-af82-351c-80a1-fbd13a233b53",
                                                "text": "She went from a ponytail to a crop."
