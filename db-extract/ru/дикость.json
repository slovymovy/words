                    },
                    {
                        "translation_id": "6a4156d5-09d7-4e67-9c57-652489397883",
                        "source_entry_id": "8bc05422-4d38-3e2c-9025-32f915caf9bf",
                        "target_lang_word": "savagery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "savagery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdd3ca49-4c31-3ca2-9e8c-9524686a3240",
                                        "entry_id": "ab903226-18a0-3c27-852c-a4503c830ffe",
                                        "glosses": [
                                            "Savage or brutal behaviour; barbarity."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84ebee89-d875-442c-9069-a949bddb1ed4",
                                                "sense_id": "cdd3ca49-4c31-3ca2-9e8c-9524686a3240",
                                                "text": "“For some reason the women have not reverted to savagery so rapidly as the men.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4472ba2-1aff-3f00-9a27-324e5947367b",
                                        "entry_id": "ab903226-18a0-3c27-852c-a4503c830ffe",
                                        "glosses": [
                                            "A violent act of cruelty."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3cdb5a4f-2b12-3287-8f9c-895b724af8b2",
                                        "entry_id": "ab903226-18a0-3c27-852c-a4503c830ffe",
                                        "glosses": [
                                            "Savages collectively; the world of savages."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "087ca7f9-2952-4a2d-9d36-79c61ff1b6db",
                                                "sense_id": "3cdb5a4f-2b12-3287-8f9c-895b724af8b2",
                                                "text": "They spring out of an element of diffused homosexuality which is at least as marked in civilization as it is in savagery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d520e752-d6e0-3e4f-8673-a8ed64629cdc",
                                        "entry_id": "ab903226-18a0-3c27-852c-a4503c830ffe",
                                        "glosses": [
                                            "Wild growth of plants."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ab8e667-9a9c-4a02-b02e-2597a46d391c",
                                                "sense_id": "d520e752-d6e0-3e4f-8673-a8ed64629cdc",
                                                "text": "[…] they […] made, amongst other features, lead ponds. With their departure these lands once more reverted to savagery; gardening, along with virtually all aspects of culture, disappeared and with it the man-made water gardens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29df1ab6-d71e-4cf0-a3c0-3441690f9153",
                        "source_entry_id": "8bc05422-4d38-3e2c-9025-32f915caf9bf",
                        "target_lang_word": "sauvagerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sauvagerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a4469da4-31b5-37f2-9526-82c58d49d59c",
                                        "entry_id": "c2416e8f-0585-3da1-821a-7dc701a415f3",
                                        "glosses": [
                                            "État des hommes sauvages."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54af16a7-90a5-3657-a64c-693a71364b2b",
                                        "entry_id": "c2416e8f-0585-3da1-821a-7dc701a415f3",
                                        "glosses": [
                                            "Manière, humeur, habitudes sauvages."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8725a1fa-aead-4aa3-8f1c-5677042b6ca2",
                                                "sense_id": "54af16a7-90a5-3657-a64c-693a71364b2b",
                                                "text": "Cette enfant, dont le père mourut fou, était une grande créature, mince, pâle, aux regards effarés, d’une singularité d’allures qu’on put prendre pour de la sauvagerie tant qu’elle resta petite fille."
                                            },
                                            {
                                                "example_id": "0c7af513-db15-4f15-9a0c-c91d8b44b329",
                                                "sense_id": "54af16a7-90a5-3657-a64c-693a71364b2b",
                                                "text": "J’avais commencé par refuser, me souciant assez peu de le revoir. … Mais Rouché revint à la charge et, devant son aimable insistance, céda ma sauvagerie."
                                            },
                                            {
                                                "example_id": "df8aaaf6-785b-40b5-ae09-f5601db74c72",
                                                "sense_id": "54af16a7-90a5-3657-a64c-693a71364b2b",
                                                "text": "Il est d’une sauvagerie peu commune."
                                            },
                                            {
                                                "example_id": "7bb92873-ed7a-47e5-93b0-4d1c7080f7d4",
                                                "sense_id": "54af16a7-90a5-3657-a64c-693a71364b2b",
                                                "text": "Je savais que Madame Linton avait une nature impérieuse et obstinée, criai-je, mais je ne savais pas que vous désiriez encourager la sauvagerie de son caractère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e200a65-9b70-3d3a-a02b-2177ce9652d5",
                                        "entry_id": "c2416e8f-0585-3da1-821a-7dc701a415f3",
                                        "glosses": [
                                            "Caractère sauvage, inhospitalier, d'un lieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4c43f4d-0814-4738-95f3-62a08d4457a7",
                                                "sense_id": "6e200a65-9b70-3d3a-a02b-2177ce9652d5",
                                                "text": "Rien n’a pu effacer le souvenir de la sauvagerie de la pointe du Raz et de la Baie des Trépassés, et l’horreur fascinante de la mer mugissant dans l’enfer de Plogoff."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
