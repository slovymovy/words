                        "glosses": [
                            "Bande dessinée produite en Chine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18ad4d25-462a-44b7-8830-764bf7edd89c",
                                "sense_id": "c1ce1e65-7a86-398b-bb7a-9a2e7e5532cf",
                                "text": "Des centaines d’auteurs de manhuas venus de Chine produisent désormais des séries à succès dont les ventes dépassent les 20 millions d’exemplaires."
                            },
                            {
                                "example_id": "f77f47e4-e0f3-4749-b29e-413d4c11780a",
                                "sense_id": "c1ce1e65-7a86-398b-bb7a-9a2e7e5532cf",
                                "text": "L’univers du manhua fait déjà un carton en Chine mais séduit également le Japon et la Corée."
                            },
                            {
                                "example_id": "1e8cc4c9-ef4a-4009-880f-f96c85eb0bda",
                                "sense_id": "c1ce1e65-7a86-398b-bb7a-9a2e7e5532cf",
                                "text": "La part de la BD chinoise, le manhua, est encore marginale, très loin derrière le manga japonais, sur les marchés français et européen."
                            }
                        ]
                    }
