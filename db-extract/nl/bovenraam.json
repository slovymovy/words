                        "sense_id": "2d0d1d03-10e1-3a8e-a222-d48a6c311190",
                        "entry_id": "c73e084c-729d-3afe-8e8a-26f91d4c35f5",
                        "glosses": [
                            "een raam op een bovenverdieping; een raam dat boven een ander raam, of deur zit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ee9452d-1fb7-43b2-93ee-726baa3f086f",
                                "sense_id": "2d0d1d03-10e1-3a8e-a222-d48a6c311190",
                                "text": "Bewoners van de Rembrandtstraat waren even daarvoor wakker geworden, omdat een inbreker via een bovenraampje probeerde hun huis binnen te dringen."
                            },
                            {
                                "example_id": "8ac2fb01-2ecf-43d9-9312-e8e2d74d3e9e",
                                "sense_id": "2d0d1d03-10e1-3a8e-a222-d48a6c311190",
                                "text": "Wood woonde sinds haar geboorte in het pand en leidde volgens de buren een zeer teruggetrokken leven. Het huis was jaren niet onderhouden. Overal zaten spinnenwebben en uit een van de bovenramen groeide een boom."
                            }
                        ]
                    }
