                        "source_entry_id": "9d9e48df-5467-3d87-a8d2-d305d25e57ab",
                        "source_sense_id": "f45706a7-b7d5-31dc-a9d1-178be83607cc",
                        "source_sense_description": "vorgeschichtliche Periode, in der Menschen Werkzeug aus Stein fertigten und nicht aus Metall",
                        "target_lang_word": "âge de pierre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "âge de pierre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a4ab87c-a403-303e-8052-fdbe0741be4a",
                                        "entry_id": "4cdaf484-8ebf-308d-b35a-3c1e183d6c1e",
                                        "glosses": [
                                            "Période de la préhistoire où l’humanité n’a eu pour instruments de travail et de guerre que des pierres ou des silex façonnés. Elle eut lieu entre 2,5 millions d’années av. J.-C. et 2500 av. J.-C."
                                        ],
                                        "tags": [
                                            "Préhistoire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "150a2cee-3e09-4ad0-a072-cab50b65152f",
                                                "sense_id": "7a4ab87c-a403-303e-8052-fdbe0741be4a",
                                                "text": "A Guignicourt-sur-Vence, près de Mézières, en travaillant dans un champ, un jeune cultivateur, M. Raymond Champenois, a découvert un certain nombre d'objets de calcaire dur, remontant, semble-t-il, à la période de l’âge de pierre, notamment un poinçon et de curieuses pierres plates triangulaires."
                                            },
                                            {
                                                "example_id": "88579543-51f2-4050-94be-e91abe450aab",
                                                "sense_id": "7a4ab87c-a403-303e-8052-fdbe0741be4a",
                                                "text": "[…] : trois mille ans plus tôt, le préhistorien nous a fait assister à la formation du fossé du Pas-de-Calais ; il nous a fait visiter la caverne de Lascaux, ce Louvre de l’Âge de pierre remontant à vingt mille ans ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "041e17a3-03ef-3052-b49d-16341853be13",
                                        "entry_id": "4cdaf484-8ebf-308d-b35a-3c1e183d6c1e",
                                        "glosses": [
                                            "Époque primitive."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bd400ad-6bf0-447e-88db-7c7c69ca6cab",
                                                "sense_id": "041e17a3-03ef-3052-b49d-16341853be13",
                                                "text": "C’était une ferme abandonnée, et dans ces parages où même les fermes habitées semblent appartenir à l’âge de pierre, une ferme abandonnée prend aussitôt l’aspect d’un repaire de brigands."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
