                                        "entry_id": "d8c84d45-96e4-34ac-a1ae-a9fcebb7f158",
                                        "glosses": [
                                            "(ohne Gegenleistung) zur Mitnahme erhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fb4fab2-7772-4df1-8333-dcb1153b2d48",
                                                "sense_id": "7c28e925-5ac8-31ab-8f8b-f4a91494e6e5",
                                                "text": "„Taduhepa hätte dann, als Amenophis IV. sie noch ganz »frisch« übernahm, eine völlig feminin geartete Mitgift mitbekommen, nämlich […].“"
                                            },
                                            {
                                                "example_id": "3f789670-fe35-4af6-9d86-51f9855ea60f",
                                                "sense_id": "7c28e925-5ac8-31ab-8f8b-f4a91494e6e5",
                                                "text": "„Frauen haben eine viel größere Mitgift an Muttervorbildern mitbekommen als Männer an Vatervorbildern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "43d79285-dcfa-3501-9283-455232145bc4",
                                        "entry_id": "d8c84d45-96e4-34ac-a1ae-a9fcebb7f158",
                                        "glosses": [
                                            "zur Kenntnis nehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b46b9785-ef3d-48b0-9a0c-4a49ea57e8c4",
                                                "sense_id": "43d79285-dcfa-3501-9283-455232145bc4",
                                                "text": "„Natürlich hatte er mitbekommen, dass sie die Spurensicherung angefordert hatte, obwohl ihm kein aktueller Fall bekannt war.“"
                                            },
                                            {
                                                "example_id": "db324d44-fb88-4886-91c7-8cb90af1545c",
                                                "sense_id": "43d79285-dcfa-3501-9283-455232145bc4",
                                                "text": "„Die großen Reiche Asiens – die Osmanen, Perser, Moguln und Chinesen – bekamen sehr bald mit, dass die Europäer einen neuen Kontinent entdeckt hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70d3f1e1-b480-423b-802f-5024f63dd8a6",
                        "source_entry_id": "6ddc7907-30a3-3cba-bf2e-5dd26b4e1ac4",
                        "source_sense_id": "080f82c2-629f-3ca8-89ee-0f79de7ce421",
                        "source_sense_description": "to hear something that wasn't meant for one's ears",
                        "target_lang_word": "mitkriegen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mitkriegen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ce309a7-0604-3f7b-8959-eb84385c3534",
                                        "entry_id": "d73f5619-9a71-351d-84d6-2593dd5c769c",
                                        "glosses": [
                                            "für einen Weg oder Lebensabschnitt erhalten"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60bd3901-d478-4ea6-b204-f7a723ce2277",
                                                "sense_id": "7ce309a7-0604-3f7b-8959-eb84385c3534",
                                                "text": "„Nach ihrer Aussteuer frage ich: was kriegt sie mit?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d647cc90-d98c-35cc-9391-0fd17999e405",
                                        "entry_id": "d73f5619-9a71-351d-84d6-2593dd5c769c",
                                        "glosses": [
                                            "Geschehnisse der Umwelt richtig einordnen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f5c1c8e-e7de-43a8-8665-b6064d74c858",
                                                "sense_id": "d647cc90-d98c-35cc-9391-0fd17999e405",
                                                "text": "„Jens kriegt echt nichts mehr mit, dachte Babsi, ich möchte echt nicht wissen, was der momentan für Gedanken hat, unglaublich, was in dem abgeht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "eefca593-1829-3d45-9763-66f751a7eece",
                                        "entry_id": "d73f5619-9a71-351d-84d6-2593dd5c769c",
                                        "glosses": [
                                            "in der Lage sein, teilnehmen zu können"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49a1e964-1737-47d9-be49-f6afa02ec5a9",
                                                "sense_id": "eefca593-1829-3d45-9763-66f751a7eece",
                                                "text": "Den Abschlussball kriege ich gerade noch mit, aber am Montag drauf breche ich nach Australien auf."
                                            },
                                            {
                                                "example_id": "e265e176-f3ad-42d3-8b3b-9c60202ead35",
                                                "sense_id": "eefca593-1829-3d45-9763-66f751a7eece",
                                                "text": "„Die Kehrseite moderner Kommunikationsmöglichkeiten: Jeder kriegt alles mit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
