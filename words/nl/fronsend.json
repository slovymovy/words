    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6b037bdb-7d09-3a16-9ba4-856478bdad49",
                    "sense_definition": "met de wenkbrauwen naar elkaar toe getrokken als teken van verbazing, boosheid of diepe concentratie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gezichtsuitdrukking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar keek met een <w>fronsende</w> blik naar het slordige handschrift van de leerling.",
                            "target_lang_translations": {
                                "en": "The teacher looked at the student's messy handwriting with a <w>frowning</w> gaze."
                            }
                        },
                        {
                            "text": "Naast de bekende lachende drol komt er ook een <w>fronsende</w> versie die nogal droevig kijkt.",
                            "target_lang_translations": {
                                "en": "In addition to the well-known smiling poop, there is also a <w>frowning</w> version that looks quite sad."
                            }
                        }
                    ],
                    "synonyms": [
                        "gefronst",
                        "zorgelijk"
                    ],
                    "antonyms": [
                        "lachend",
                        "vrolijk"
                    ],
                    "common_phrases": [
                        "fronsende blik",
                        "fronsende wenkbrauwen"
                    ],
                    "target_lang_definitions": {
                        "en": "with the eyebrows drawn together as a sign of surprise, anger, or deep concentration"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "frowning",
                                "target_lang_sense_clarification": "facial expression"
                            },
                            {
                                "target_lang_word": "scowling",
                                "target_lang_sense_clarification": "angry or serious expression"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4b9b902b-f378-3843-a8b4-15bd3001541d",
                    "sense_definition": "onvoltooid deelwoord van <w>fronsen</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hoe dat zou moeten met een kapotte telefoon, vroeg ik mij <w>fronsend</w> af.",
                            "target_lang_translations": {
                                "en": "I wondered <w>frowning</w> how that would work with a broken phone."
                            }
                        },
                        {
                            "text": "Hij zat aan zijn bureau en las de brief terwijl hij <w>fronsend</w> nadacht over een oplossing.",
                            "target_lang_translations": {
                                "en": "He sat at his desk and read the letter while <w>frowning</w> as he thought about a solution."
                            }
