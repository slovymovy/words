                        "glosses": [
                            "Angehöriger der Vogelgattungen Puffinus oder Calonectris"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b0477fa-5b3e-47ea-8285-69429ef5354f",
                                "sense_id": "8ac1ee25-ac3b-3514-8328-ceb229260c22",
                                "text": "Sturmtaucher sind ausgeprägte Hochseevögel."
                            },
                            {
                                "example_id": "36e578e4-59da-40ae-ae82-d2f9933603e8",
                                "sense_id": "8ac1ee25-ac3b-3514-8328-ceb229260c22",
                                "text": "„Im Sommer leuchten die flechtenbewachsenen Felswände orange, gelb und rostrot, und die Vogelklippen wimmeln von Möwen, Sturmtauchern und Sturmschwalben.“"
                            }
