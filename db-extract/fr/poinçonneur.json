                "senses": [
                    {
                        "sense_id": "dc387e04-6e17-376f-8dc2-e6f3f6057b6a",
                        "entry_id": "d2db03d1-aa00-3574-bb35-4a08d905914c",
                        "glosses": [
                            "Employé qui compostait le titre de transport des voyageurs avec un poinçon, une pince à composter."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "13dee250-7ae1-436a-b70c-3b80c101d12d",
                                "sense_id": "dc387e04-6e17-376f-8dc2-e6f3f6057b6a",
                                "text": "Je suis le poinçonneur des Lilas\nLe gars qu’on croise et qu’on n’regarde pas\nY a pas de soleil sous la terre\nDrôle de croisière\nPour tuer l’ennui j’ai dans ma veste\nLes extraits du Reader Digest\nEt dans c’bouquin y a écrit\nQue des gars s’la coulent douce à Miami\nPendant c’temps que j’fais le zouave\nAu fond de la cave\nParaît qu’il y a pas de sots métiers\nMoi j’fais des trous dans les billets"
                            },
                            {
                                "example_id": "a3e593c1-5687-47ee-9db5-ea855f3125ef",
                                "sense_id": "dc387e04-6e17-376f-8dc2-e6f3f6057b6a",
                                "text": "L'orateur constate que l’État n'a d’autre rôle dans rémission de la monnaie que celui de poinçonneur."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3153b50-6263-393c-a20e-77465e9c9f6a",
                        "entry_id": "d2db03d1-aa00-3574-bb35-4a08d905914c",
                        "glosses": [
                            "Personne qui utilise un poinçon, une perforeuse pour faire des trous dans divers matériaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fba7487f-4e11-465a-a954-f20822f68cab",
                                "sense_id": "b3153b50-6263-393c-a20e-77465e9c9f6a",
                                "text": "Le travail est exécuté, pour les grandes tôles , par un poinçonneur et deux aides, et pour les fers par poinçonneur et un aide."
                            }
                        ]
                    }
