                                                "example_id": "24b40681-ccc9-4064-90b4-147892c5b91a",
                                                "sense_id": "a4f94348-6462-3dfd-8ad9-628ddc9ab50c",
                                                "text": "The lecturers are expert on lecturing on the subject, but they offer the splatterdash method of disseminating information with no point of view of their own."
                                            },
