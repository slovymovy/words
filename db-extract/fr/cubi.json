                "senses": [
                    {
                        "sense_id": "506cf2b2-4d62-34d9-a335-cea4ab990c6f",
                        "entry_id": "4b62815a-28cf-34ec-bbfc-4b6460aeeda6",
                        "glosses": [
                            "Appellation courante d’un cubiteneur."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "eb4c692e-b491-48af-a05a-b95bc275678a",
                                "sense_id": "506cf2b2-4d62-34d9-a335-cea4ab990c6f",
                                "text": "Et dans la foulée, si le raccourci cubi ne vous convient pas, n’hésitez pas davantage à faire usage d’un cubiteneur en remplacement du cubitainer. Aucune raison pour que le vin s’aigrisse davantage dans l’un que dans l’autre."
                            },
                            {
                                "example_id": "ce954c76-28b7-48bc-89b2-b16e7c2a2ff3",
                                "sense_id": "506cf2b2-4d62-34d9-a335-cea4ab990c6f",
                                "text": "Elle se resservit un verre au cubi de vin rouge avant de s’occuper de celui d’Amela, encore à moitié plein."
                            },
                            {
                                "example_id": "bcb72c1f-e898-48ae-b684-ac5e16f1f3b3",
                                "sense_id": "506cf2b2-4d62-34d9-a335-cea4ab990c6f",
                                "text": "Même pas la moindre petite taxe pour les deux cubis de Château Monderche, ces mecs-là étaient en règle maitrisant la loi sur le bout des ongles."
                            }
                        ]
                    }
