                    },
                    {
                        "translation_id": "d8efe693-4baf-4ac0-adff-235f54057c2f",
                        "source_entry_id": "85d77f35-9b43-3a72-9e0b-c79010f2047b",
                        "source_sense_id": "5428e85d-1932-343b-b635-7f7316706c62",
                        "source_sense_description": ", 2., 3. of 3. (zaad, bladeren of knol van) plant Foeniculum vulgare",
                        "target_lang_word": "Fenchel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fenchel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "453ad567-e9cd-3459-a14d-9c2f07483f06",
                                        "entry_id": "a0ceeaa1-af59-3a67-b778-6aeb226dbe94",
                                        "glosses": [
                                            "Gemüse-, Gewürz- und Heilpflanze aus der Familie der Doldenblütler"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "277cd631-ac84-427e-bbf8-1988ab1260cf",
                                                "sense_id": "453ad567-e9cd-3459-a14d-9c2f07483f06",
                                                "text": "Man kann Fenchel auch in Salaten verwenden oder als Gemüsebeilage servieren."
                                            },
                                            {
                                                "example_id": "66f48f5e-009c-41ba-be46-fc386b3b51e1",
                                                "sense_id": "453ad567-e9cd-3459-a14d-9c2f07483f06",
                                                "text": "„Gegen Blähungen helfen zum Beispiel Fenchel oder Anis.“"
                                            },
                                            {
                                                "example_id": "28e7426a-dc8d-42a2-963f-89de469941da",
                                                "sense_id": "453ad567-e9cd-3459-a14d-9c2f07483f06",
                                                "text": "„Unmerklich war der geschlossene Raum in freies Gelände übergegangen, nur der Grundriß des Gebäudeflügels ragte mit kargem Gemäuer etwa halbmannshoch aus der Erde, von Gras und wildem Fenchel überwuchert.“"
                                            },
                                            {
                                                "example_id": "c444e090-e7bd-41ba-b0e3-57eee7caf104",
                                                "sense_id": "453ad567-e9cd-3459-a14d-9c2f07483f06",
                                                "text": "„Die Frage ist halb ernst gemeint, aber Lampe fängt sofort an zu plappern, über seine Erfahrungen mit Gänsen, die mit Fenchel gefüllt werden müßten, der Verdauung wegen; oder Hasen, die in Buttermilch eingelegt, schneller gar würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
