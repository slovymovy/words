                        "cross_references": [
                            {
                                "target_word": "xenofeminism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1eea069a-1b34-35bd-837e-e3ae53265578",
                                        "entry_id": "f87ff6dc-c469-3219-9dba-2eb3c4acc11e",
                                        "glosses": [
                                            "A branch of feminism which rejects naturalism and posits the abolition of gender and/or gendered oppression through the posthumanist embrace of technology."
                                        ],
                                        "tags": [
                                            "neologism",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "286328eb-100f-41dc-a479-e558867c1dcf",
                                                "sense_id": "1eea069a-1b34-35bd-837e-e3ae53265578",
                                                "text": "Even if they were to incorporate feminist perspectives, however, tensions remain between the desire to use technology for change, as in feminist posthumanism and xenofeminism, and the recognition of its embeddedness within both militarism and capitalism."
                                            },
                                            {
                                                "example_id": "1c2e5396-3187-4d82-af24-6e258f0244c7",
                                                "sense_id": "1eea069a-1b34-35bd-837e-e3ae53265578",
                                                "text": "Xenofeminism sees the rising wave of technocracy but instead of searching for a buoy, it wants to catch the surf."
                                            },
                                            {
                                                "example_id": "00e14617-a44a-4b5c-b6ed-ebd6d33d9949",
                                                "sense_id": "1eea069a-1b34-35bd-837e-e3ae53265578",
                                                "text": "Rejecting the claim that science and technology are inherently masculine or patriarchal, Xenofeminism looks at attempts to repurpose technology to liberate women."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
