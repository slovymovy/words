                "senses": [
                    {
                        "sense_id": "4ca09f94-d3e5-3974-92c9-315e295899db",
                        "entry_id": "197145d2-228b-3610-96ad-c765ddb04e0a",
                        "glosses": [
                            "Libérer des contraintes de copyright."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6777d41b-80a8-452d-9503-c5920a8b4ac6",
                                "sense_id": "4ca09f94-d3e5-3974-92c9-315e295899db",
                                "text": "Mais le plus dérangeant dans le fait de décopyrighter un script, est le manque de respect, de considération affligeant."
                            },
                            {
                                "example_id": "c8bbd3cc-06d7-4901-8dff-2c87b2b1e0f8",
                                "sense_id": "4ca09f94-d3e5-3974-92c9-315e295899db",
                                "text": "Télécharger ces vieux jeux est légal seulement si tu as déjà un original ou si l'éditeur a \"décopyrighté\" le jeu."
                            },
                            {
                                "example_id": "bffbc3c7-4f75-4a05-8ebd-ec1e53418831",
                                "sense_id": "4ca09f94-d3e5-3974-92c9-315e295899db",
                                "text": "je suis copié, plagié, décopyrighté, j'irai me plaindre..."
                            },
                            {
                                "example_id": "008274c7-89e2-49a1-976b-4f952178869c",
                                "sense_id": "4ca09f94-d3e5-3974-92c9-315e295899db",
                                "text": "je sais aussi que peu même très peu de gens se sont amusés (par innocence ou par individualisme) à décopyrighter le CMS"
                            }
                        ]
                    }
