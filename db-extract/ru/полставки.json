                        "examples": [
                            {
                                "example_id": "67c7efee-1bd6-4f4b-befd-dc512efd6381",
                                "sense_id": "a880b9d3-5457-3278-b66d-9a1dd1ec7712",
                                "text": "Теперь с 1-го ноября я буду получать полную ставку, а то уже много месяцев получала только полставки."
                            },
                            {
                                "example_id": "35040743-9e6c-48b1-ba15-9e9e2ddc1a16",
                                "sense_id": "a880b9d3-5457-3278-b66d-9a1dd1ec7712",
                                "text": "А на работе я добился зачисления меня на полставки, то есть ходил через день."
                            },
                            {
                                "example_id": "d099578d-1a30-419a-9242-8ec39cb1b14d",
                                "sense_id": "a880b9d3-5457-3278-b66d-9a1dd1ec7712",
                                "text": "…К сожалению, в нашем подразделении сейчас работают «два с половиной маляра», поскольку один оформлен на полставки."
                            }
                        ]
                    }
