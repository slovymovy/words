                                            {
                                                "example_id": "1900dec6-401f-44ea-8dba-4c51a583174f",
                                                "sense_id": "a7e8d8b0-1f1a-3633-b0a6-5fac155eb125",
                                                "text": "On voit en particulier qu’il faut toujours commencer par accorder le récepteur sur le signal en utilisant la bande la plus étroite du filtre, sans crevasse, même s’il y a un brouilleur."
                                            }
                                        ]
