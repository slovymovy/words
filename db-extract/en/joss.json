                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "0288db67-48de-48a8-9249-ba9d80844dfe",
                                "sense_id": "600bf9b5-ac19-308a-b87e-0d5fe113e021",
                                "text": "Don't forget they're mostly just joss-worshipping heathen an' they don't get no kick out of the more classy breeds o' religion. Though I guess there ain't that much diff'rence. It ain't many's so Lord Almighty in theirselves that they don't need a joss of some sort, an' I guess it's what yu think about him matters not the sort o' joss."
                            }
                        ]
                    },
                    {
                        "sense_id": "10f82e33-8503-3294-98ce-743b52f3edc8",
                        "entry_id": "c88545b8-b1f8-39be-ada4-daa5565188b0",
