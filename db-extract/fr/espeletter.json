                        "glosses": [
                            "Assaisonner au piment d’Espelette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ea5b354-c281-4069-ac94-a9cd4a7f69d5",
                                "sense_id": "6edecb70-ddf1-327d-8758-b575460a7f7e",
                                "text": "Je nappai un plat passant au four d’huile d’olive que j’espelettai et saupoudrai de gros sel."
                            },
                            {
                                "example_id": "2f0b29af-a853-44fe-bb98-72112e67b083",
                                "sense_id": "6edecb70-ddf1-327d-8758-b575460a7f7e",
                                "text": "Arroser de vinaigre balsamique et d'huile d'olive, saler et « espeletter »."
                            },
                            {
                                "example_id": "26a84fb3-4094-4f18-b809-05b4feea2abb",
                                "sense_id": "6edecb70-ddf1-327d-8758-b575460a7f7e",
                                "text": "Saler et espeletter selon le goût."
                            }
                        ]
                    }
