                "senses": [
                    {
                        "sense_id": "eae56b8f-f592-311b-929f-df7ed9c1feb9",
                        "entry_id": "45fae433-d077-3ebd-9d37-0f86708b05f9",
                        "glosses": [
                            "ein Rätsel, das die Welt aufgibt"
                        ],
                        "tags": [
                            "metaphysisch"
                        ],
                        "examples": [
                            {
                                "example_id": "e10b10f2-313c-41b7-8a10-482846892811",
                                "sense_id": "eae56b8f-f592-311b-929f-df7ed9c1feb9",
                                "text": "„Während Schopenhauer in seiner pessimistisch-idealistischen Leidensmetaphysik das Ding an sich im vernunftlosen durch die Ewigkeit schweifenden Willen erblickte und ihn als „Lösung des Rätsels der Welt“ betrachtete, glaubte Friedrich Nietzsche des Welträtsels Lösung im Willen zur Macht entdeckt zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ea9f2292-0b70-30d9-ba72-a898f24da386",
                        "entry_id": "45fae433-d077-3ebd-9d37-0f86708b05f9",
                        "glosses": [
                            "die Sieben Welträtsel, ein vom Jungen Deutschland 1834 den Sieben Weltwundern nachgeprägtes Wort, das besonders von Emil Dubois-Reymond ab 1882 als Bezeichnung der letzten offenen (naturwissenschaftlichen) Fragen nach der/dem … verwendet wurde"
                        ],
                        "tags": [
                            "naturwissenschaftlich"
                        ],
                        "examples": [
                            {
                                "example_id": "d7ff895f-34da-43e4-8baf-5c92a71b6b6a",
                                "sense_id": "ea9f2292-0b70-30d9-ba72-a898f24da386",
                                "text": "„Im Gegensatz zu Du Bois-Reymonds hielt der deutsche Zoologe Ernst Haeckel die Welträtsel für lösbar.“"
                            },
                            {
                                "example_id": "d8f5ec8a-7879-4919-9227-94b3179f256b",
                                "sense_id": "ea9f2292-0b70-30d9-ba72-a898f24da386",
                                "text": "Im Jahr 1899 veröffentlichte Ernst Haeckel seine materialistisch-monistische Schrift Welträtsel."
                            },
                            {
                                "example_id": "ca1f5054-53b3-4af5-b086-693a0accb302",
                                "sense_id": "ea9f2292-0b70-30d9-ba72-a898f24da386",
                                "text": "„Der Zoologe und Naturphilosoph E. Haeckel (>Die Welträthsel<, 1899) versuchte eine Beantwortung“ der sieben Fragen E. Dubois-Reymonds „im Sinne eines auf den Darwinschen Entwicklungsgedanken gegründeten Materialismus.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "50c8d096-38f0-3221-b754-4ed8cbcbc4c1",
                        "entry_id": "45fae433-d077-3ebd-9d37-0f86708b05f9",
                        "glosses": [
                            "Im Bezug auf einige dieser Fragen kam Dubois-Reymond zu der Antwort: Ignoramus et ignorabimus (deutsch: „Wir wissen es nicht und werden es prinzipiell niemals wissen!“)"
                        ],
