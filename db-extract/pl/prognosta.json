                "senses": [
                    {
                        "sense_id": "6e993d68-6173-35a3-b717-7745de59d154",
                        "entry_id": "585201f1-e624-3f88-b1d6-47a0f79fb6f3",
                        "glosses": [
                            "osoba przewidująca przyszłość"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed572347-4e41-4ab9-b8a3-ed7bdd0f6816",
                                "sense_id": "6e993d68-6173-35a3-b717-7745de59d154",
                                "text": "Z tymi przewidywaniami nie zgadzają się progności z naszego instytutu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf206bdc-f37b-41f7-a772-f27a3bb5eafa",
                        "source_entry_id": "585201f1-e624-3f88-b1d6-47a0f79fb6f3",
                        "source_sense_id": "6e993d68-6173-35a3-b717-7745de59d154",
                        "target_lang_word": "forecaster",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forecaster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10b57508-ed93-3b57-ae80-17e96b34c5cc",
                                        "entry_id": "a08f2bc0-016c-357b-aa5b-c89bec57abe6",
                                        "glosses": [
                                            "A person who forecasts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca9ce587-c35c-4ccf-acbe-e7c173ba9b3a",
                                                "sense_id": "10b57508-ed93-3b57-ae80-17e96b34c5cc",
                                                "text": "Students will be surprised to see the weather forecaster is not really standing in front of the maps. These are keyed in electronically; the forecaster stands in front of a green/blue screen."
                                            },
                                            {
                                                "example_id": "e65ae22a-b3cd-4141-97d2-1dd34f143150",
                                                "sense_id": "10b57508-ed93-3b57-ae80-17e96b34c5cc",
                                                "text": "Flooding occurs in areas where the ground is unable to absorb all of the water, according to forecasters, who explained that flash flooding can also be caused by mudslides or breaks in dams or levees."
                                            },
                                            {
                                                "example_id": "875bc9b9-524c-4059-a71c-eaaeb8647813",
                                                "sense_id": "10b57508-ed93-3b57-ae80-17e96b34c5cc",
                                                "text": "Many NWS forecast offices have ceased launching their twice-a-day weather balloons, which provide critical data that can alert forecasters to the potential for flooding and other hazardous weather."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "121e67d6-27f9-325b-b94a-87332d8d06fc",
                                        "entry_id": "a08f2bc0-016c-357b-aa5b-c89bec57abe6",
                                        "glosses": [
                                            "A software program or algorithm that forecasts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
