                "senses": [
                    {
                        "sense_id": "24c1c03e-ae5c-392d-bdf3-acea7123e495",
                        "entry_id": "dbdbffff-3d1e-39c8-bf7f-d808c6992ace",
                        "glosses": [
                            "Untersuchung einer Sprache/von Texten daraufhin, welche grammatischen, lexikalischen und sonstigen Mittel sie aufweist, woher sie stammen, wie sie verwendet werden, undsoweiter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0c19064-e8bf-45e8-a826-2d97482fa9ab",
                                "sense_id": "24c1c03e-ae5c-392d-bdf3-acea7123e495",
                                "text": "„Das Vorurteil ließ sich anhand einer Sprachanalyse mit beigefügten Beispielen unschwer widerlegen.“"
                            },
                            {
                                "example_id": "88db4515-0253-4bc6-90f1-807f3bb8a7d9",
                                "sense_id": "24c1c03e-ae5c-392d-bdf3-acea7123e495",
                                "text": "„Der systematische Aspekt jedoch, der in der synchronen Sprachanalyse im Zentrum steht, spielt dabei nur begrenzt eine Rolle, obwohl sich immer mehr die Auffassung durchsetzt, daß in der historischen Grammatik nicht die Geschichte isolierter Einheiten, sondern die Entwicklung der Sprachsysteme zu beschreiben sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
