                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42dd3619-3251-3028-be34-19b56937f2ef",
                                        "entry_id": "cdc94fd5-a623-3844-bc29-981dbda73ff6",
                                        "glosses": [
                                            "A word which forms a different word when spelled backwards."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "195dba43-260e-4a85-997d-da0f9986f62a",
                                                "sense_id": "42dd3619-3251-3028-be34-19b56937f2ef",
                                                "text": "\"Desserts\" and \"stressed\" are believed to be the longest common English anadromes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bddc2c8-6720-3415-a4ce-edf693b2829f",
                                        "entry_id": "cdc94fd5-a623-3844-bc29-981dbda73ff6",
                                        "glosses": [
                                            "An anadromous fish."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e024b46-c8f7-46c8-b50c-cac66dc51b17",
                        "source_entry_id": "14d1c423-f03a-31c7-9b43-1e78e6877463",
                        "source_sense_id": "8b38bf43-a061-3ac8-9ff0-7e5c1f2cbdc1",
                        "target_lang_word": "semordnilap",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "semordnilap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "831fb6cf-cc50-3473-9f3a-a38ddcbd1a6b",
                                        "entry_id": "b1887641-36e9-373e-b2ad-86876f2a43ee",
                                        "glosses": [
                                            "A word, phrase, or sentence that has the property of forming another word, phrase, or sentence when its letters are reversed. A semordnilap differs from a palindrome in that the word or phrase resulting from the reversal is different from the original word or phrase."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffee546c-1062-4ae2-800f-78be78f95bb5",
                                                "sense_id": "831fb6cf-cc50-3473-9f3a-a38ddcbd1a6b",
                                                "text": "[He] then goes on to credit us with giving him some of the best examples of semordnilaps."
                                            },
                                            {
                                                "example_id": "745b12d9-ea5a-4661-ac14-04563e45348b",
                                                "sense_id": "831fb6cf-cc50-3473-9f3a-a38ddcbd1a6b",
                                                "text": "This song is a semordnilap. It can be played forward and then sounds different when it is played backwards."
                                            },
                                            {
                                                "example_id": "9fe404c3-a6ce-4e56-8426-6d288849d2e6",
                                                "sense_id": "831fb6cf-cc50-3473-9f3a-a38ddcbd1a6b",
                                                "text": "ACE is an acronym for Analysis of Concepts for Epidemiologists, and a semordnilap for ECA, Epidemiological Concept Analysis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
