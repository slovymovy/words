                "senses": [
                    {
                        "sense_id": "cb402b11-6a68-3094-b0c8-532ff5caa0a1",
                        "entry_id": "14ffacb0-5bcf-3a89-98bd-480f82a5146e",
                        "glosses": [
                            "Arzt, der grundsätzlich Privatpatienten behandelt, also Patienten, die ihre Gesundheitskosten selbst zahlen beziehungsweise von einer dafür abgeschlossenen privaten Krankenversicherung zahlen lassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f59b2b4d-838e-4d3c-a1f8-a1222c32b8f7",
                                "sense_id": "cb402b11-6a68-3094-b0c8-532ff5caa0a1",
                                "text": "„Der Privatarzt des Musikers, Conrad Murray, hatte ihm über Wochen täglich Propofol und andere Medikamente wie Valium verabreicht.“"
                            },
                            {
                                "example_id": "cfb96cc8-e748-493b-9cae-10a6470bb2f2",
                                "sense_id": "cb402b11-6a68-3094-b0c8-532ff5caa0a1",
                                "text": "„Er darf Privatärzte aufsuchen oder sich nach der privatärztlichen Gebührenordnung behandeln lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
