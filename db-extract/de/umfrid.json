                "senses": [
                    {
                        "sense_id": "abbb98ee-0a22-314a-ad14-d4a915f47749",
                        "entry_id": "59cfd0e1-2542-3de8-b00e-78d8cc9cea95",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2581ff8-4ed7-4c5a-aa9a-19bb255baa90",
                                "sense_id": "abbb98ee-0a22-314a-ad14-d4a915f47749",
                                "text": "Frau Umfrid ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6247bfca-4863-4af6-9f5e-6ac45e6b751b",
                                "sense_id": "abbb98ee-0a22-314a-ad14-d4a915f47749",
                                "text": "Herr Umfrid wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "608f7f10-0523-425a-9800-1020c2ea0155",
                                "sense_id": "abbb98ee-0a22-314a-ad14-d4a915f47749",
                                "text": "Die Umfrids fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "2588f965-e24b-4bd9-84f2-087513974017",
                                "sense_id": "abbb98ee-0a22-314a-ad14-d4a915f47749",
                                "text": "Der Umfrid trägt nie die Schals, die die Umfrid ihm strickt."
                            },
                            {
                                "example_id": "91106751-dbda-474b-9371-05ae8c4e2e6d",
                                "sense_id": "abbb98ee-0a22-314a-ad14-d4a915f47749",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Umfrid kommt, geht der Herr Umfrid.“"
                            },
                            {
                                "example_id": "8db73817-9518-4d21-9922-567101e27f00",
                                "sense_id": "abbb98ee-0a22-314a-ad14-d4a915f47749",
                                "text": "Umfrid kommt und geht."
                            },
                            {
                                "example_id": "2605482b-ea40-4df8-adc0-1da2bfaaf418",
                                "sense_id": "abbb98ee-0a22-314a-ad14-d4a915f47749",
                                "text": "Umfrids kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
