                "senses": [
                    {
                        "sense_id": "1c974617-6df9-3e90-a767-eff123585a4d",
                        "entry_id": "f2247eae-9065-3715-bf44-97d292c96cb0",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3fb0010-1014-4221-a89e-73bd84290112",
                                "sense_id": "1c974617-6df9-3e90-a767-eff123585a4d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Temming kommt, geht der Herr Temming.“"
                            },
                            {
                                "example_id": "ab52fc1d-03c3-4684-8870-781f332f20bf",
                                "sense_id": "1c974617-6df9-3e90-a767-eff123585a4d",
                                "text": "Temming kommt und geht."
                            },
                            {
                                "example_id": "aa47ce4b-bc45-4096-a917-bed333467590",
                                "sense_id": "1c974617-6df9-3e90-a767-eff123585a4d",
                                "text": "Temmings kamen, sahen und siegten."
                            },
                            {
                                "example_id": "541227c9-8298-45ba-aac6-2b1a993f9a0f",
                                "sense_id": "1c974617-6df9-3e90-a767-eff123585a4d",
                                "text": "Frau Temming ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0be05a6e-7128-4f2a-ac4c-9aabbdd8d2cc",
                                "sense_id": "1c974617-6df9-3e90-a767-eff123585a4d",
                                "text": "Herr Temming wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "93764aef-8ff9-47ac-8322-0f664def608b",
                                "sense_id": "1c974617-6df9-3e90-a767-eff123585a4d",
                                "text": "Die Temmings kommen heute aus dem Emsland."
                            },
                            {
                                "example_id": "ef0df59b-65a9-4ded-a843-5f01a9d27354",
                                "sense_id": "1c974617-6df9-3e90-a767-eff123585a4d",
                                "text": "Der Temming trägt nie die Schals, die die Temming ihm strickt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
