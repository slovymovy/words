                                "ru": "Спортсмен столкнулся с <w>яростной</w> критикой после поражения в финальном матче."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ferocious competition",
                        "ferocious heat"
                    ],
                    "target_lang_definitions": {
