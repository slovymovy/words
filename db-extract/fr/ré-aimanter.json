                "senses": [
                    {
                        "sense_id": "0af85421-ea27-3378-aa17-31aa9023e957",
                        "entry_id": "bbf75ba5-9585-33a2-b250-f603a49934a6",
                        "glosses": [
                            "Aimanter une nouvelle fois."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "265d6c24-06fd-4949-bf5f-cafa134fc5e9",
                                "sense_id": "0af85421-ea27-3378-aa17-31aa9023e957",
                                "text": "Après avoir corrigé le diaphragme thoracique supérieur, il nous faut ré-aimanter le diaphragme."
                            },
                            {
                                "example_id": "dd5f2649-b8d1-43e1-9cf3-182a18ce9883",
                                "sense_id": "0af85421-ea27-3378-aa17-31aa9023e957",
                                "text": "Aussi Kazantzaki va-t-il devoir ré-investir le mythe d’une charge symbolique nouvelle, le re-sémantiser, ou le ré-aimanter."
                            },
                            {
                                "example_id": "46eaf8d7-761a-4187-8369-4cfe8d193c46",
                                "sense_id": "0af85421-ea27-3378-aa17-31aa9023e957",
                                "text": "Comme tout se réoriente, se ré-aimante selon la verticale père-fils !"
                            }
                        ]
                    }
