                        "renseigner un champ"
                    ]
                },
                {
                    "sense_id": "1fb77e47-54ce-3e7f-93ad-8bf3d92b1354",
                    "sense_definition": "Être au courant ou détenir des faits précis sur une situation.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce détective privé semblait particulièrement bien <w>renseigné</w> sur les activités suspectes du suspect."
                        },
                        {
                            "text": "Avant de signer le contrat, assurez-vous d'être bien <w>renseigné</w> sur les clauses juridiques."
