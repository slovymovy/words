                        "source_sense_description": "keine Scham kennend: schamlos, unverschämt, frech, unverfroren, dreist, unanständig",
                        "target_lang_word": "unanständig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
