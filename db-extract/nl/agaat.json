                                        "glosses": [
                                            "minerál s rozmanitým zbarvením řazený mezi polodrahokamy, směs chalcedonu, křemene a opálu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dca06e9b-71c4-440e-8954-be8277940136",
                                                "sense_id": "732eff01-d35c-342e-877e-3f1decb4b339",
                                                "text": "V jedné velké hrobce byla vzácná nádoba z alabastru východního, popelem a kostmi naplněná; pak byl nalezen prsten zlatý s achátem, na kterém jelen kopytem se drbající čistě vyrytý byl."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1b4c002-3bb0-4089-8df6-8ec7d87b0a50",
                        "source_entry_id": "530e0057-9207-3c50-af5c-1c164414587a",
