                "senses": [
                    {
                        "sense_id": "9b1be9f2-7776-3831-8a3d-278eafeca935",
                        "entry_id": "50bfb9d1-e2b4-373f-b5d6-3e5aca2c0170",
                        "glosses": [
                            "Mollir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bca0077b-c4c8-48d0-8f52-1344bcc7e9b0",
                                "sense_id": "9b1be9f2-7776-3831-8a3d-278eafeca935",
                                "text": "Il y a dilatation de l'aorte dans sa portion ascendante ; en examinant sa surface interne, on remarque des commencements d'athérôme, c'est-à-dire le dépôt, dans les parois artérielles, de petits amas de substance jaune, friable, ayant la consistance du fromage, et qui, pour M. Gluge, est composée de graisse, de cholestérine et d'albumine, et a pour effet de remollir les parois artérielles"
                            },
                            {
                                "example_id": "2178e248-fa18-4094-b7fe-6ecefe2da641",
                                "sense_id": "9b1be9f2-7776-3831-8a3d-278eafeca935",
                                "text": "Quant aux effets de ces eaux, la brochure annonce que les bains d'Ussat sont très-efficaces pour assouplir et remollir les fibres, dans le cas de trop de tension et contraction des muscles ;"
                            }
                        ]
                    }
