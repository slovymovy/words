                        "entry_id": "9f998d29-1932-31d5-87ea-c344cfd70c64",
                        "glosses": [
                            "Redonner un caractère sectaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4959a77-26c4-4780-9a3c-b6534db074a3",
                                "sense_id": "5c31e6b9-ebc1-3ab9-aae9-851364870242",
                                "text": "Soyez à la hauteur de vos propres attentes, vous ne pouvez pas vous dire du renouveau si vous voulez vous resectariser aujourd’hui au travers des ethnies après l’avoir fait au travers de la politique."
                            },
                            {
                                "example_id": "00d10321-8912-49d2-a668-3e2a66b9016e",
                                "sense_id": "5c31e6b9-ebc1-3ab9-aae9-851364870242",
                                "text": "Mais bon heureusement qu'à chaque coup de cymbale, un tigre ne surgit pas pour \"resectariser\" le secteur."
                            }
                        ]
                    }
