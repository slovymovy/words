                                    {
                                        "sense_id": "c607b326-cb1f-31f3-983e-2ddd3a383413",
                                        "entry_id": "0d24bf23-b61e-39eb-82ce-1ff3996d82e4",
                                        "glosses": [
                                            "The act of inaugurating, or inducting into office with solemnity; investiture by appropriate ceremonies."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
