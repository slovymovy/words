                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24986809-a18c-4dbe-af40-dd5f8abe9cbc",
                                                "sense_id": "45474708-6e4b-3ed4-8a4a-0153f9a6e326",
                                                "text": "Sabemos y comprendemos lo que está bien, pero no lo ponemos en práctica, unos por indolencia, otros por preferir cualquier clase de placer al bien."
                                            }
