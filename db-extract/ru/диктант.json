                "senses": [
                    {
                        "sense_id": "048024bb-c95e-34fa-974f-ae68c2619704",
                        "entry_id": "276db010-7620-329e-afb7-4fa43c01b63e",
                        "glosses": [
                            "работа по обучению орфографии и пунктуации, состоящая в записывании текста под диктовку"
                        ],
                        "tags": [],
