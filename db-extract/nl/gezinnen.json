        "nl-extract.jsonl": [
            {
                "entry_id": "f2448480-45a5-3fc0-81a0-05a8d67dc22a",
                "word": "gezinnen",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8a86ef0c-a881-3675-8503-e3e978b670fc",
                        "entry_id": "f2448480-45a5-3fc0-81a0-05a8d67dc22a",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord gezin"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "98ea81eb-9610-40d6-bca0-2cfc8a20fa5e",
                                "sense_id": "8a86ef0c-a881-3675-8503-e3e978b670fc",
                                "text": "In mijn jeugd trokken we elke zomer met vier gezinnen door de bergen."
                            },
                            {
                                "example_id": "e281d515-7261-4a46-b84a-794ebea24482",
                                "sense_id": "8a86ef0c-a881-3675-8503-e3e978b670fc",
                                "text": "Een bepalend moment in mijn leven: nog voor de armagnac bij de koffie vroeg Arend of ik niet voor hem en Casper wilde komen werken, want hun familiebedrijf had inmiddels meer dan honderd gezinnen te onderhouden en op hr-gebied viel er nog veel te verbeteren."
                            },
                            {
                                "example_id": "de9da0f5-35df-4522-863e-e387969a11ce",
                                "sense_id": "8a86ef0c-a881-3675-8503-e3e978b670fc",
                                "text": "'Alle gelukkige gezinnen lijken op elkaar."
                            },
                            {
                                "example_id": "abad004b-bdbe-44be-aadf-80d446c1de80",
                                "sense_id": "8a86ef0c-a881-3675-8503-e3e978b670fc",
                                "text": "Iedereen heeft ideeën over ouders, kinderen en gezinnen, maar hoe zit het echt? Die vraag stelt Lynn Berger zich als ze voor de tweede keer in verwachting is."
                            }
                        ]
                    }
                ],
