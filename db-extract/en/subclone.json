                        "entry_id": "c07e3330-0647-3586-a3c5-027182a64dc9",
                        "glosses": [
                            "A clone or descendant of a mutant occurring in a previous clone"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29d53eb4-5d9e-46ce-a4c3-f1280b0093a0",
                                "sense_id": "3f6c49b6-2f64-3fd5-9e6d-f291cd438134",
                                "text": "During this process it is possible that additional mutations occur in one of the transformed cells, which then may result in a subclone of cells with a more aggressive behavior."
                            }
                        ]
                    },
                    {
                        "sense_id": "f143ba55-aaa6-303a-b4f3-28a6f6b2d2e2",
                        "entry_id": "c07e3330-0647-3586-a3c5-027182a64dc9",
                        "glosses": [
                            "A partial segment of DNA, cloven from a previously-cloned segment, which is then cloned into another vector"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95030d37-85fc-436a-82a0-3e71848b33b9",
                                "sense_id": "f143ba55-aaa6-303a-b4f3-28a6f6b2d2e2",
                                "text": "While Shelly was away from the lab, Rene decided that it would be easier to divide the lengthy segment into smaller pieces, or subclones, and to insert each fraction into plasmids, little circles of DNA and protein."
                            }
                        ]
                    }
                ],
