                    {
                        "sense_id": "e0cef330-4caa-3617-b8ba-f89ad49c7d0b",
                        "entry_id": "e98f85fb-81b0-3de5-bfbf-baffa24d2f58",
                        "glosses": [
                            "De sorcière, envoûtant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b259f51-f4fd-417e-9fcf-ece0f5fcf6b0",
                                "sense_id": "e0cef330-4caa-3617-b8ba-f89ad49c7d0b",
                                "text": "Il y avait la jolie dame de la région Centre et ses yeux mélusine, Graziella la savoyarde incendiaire ou encore le diamant océan venu de Tahiti."
                            }
                        ]
