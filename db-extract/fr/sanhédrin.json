                                "target_senses": [
                                    {
                                        "sense_id": "c3dcf87a-fb31-3b42-bb46-8d82321f1e02",
                                        "entry_id": "a0693a94-5c6f-32e5-8fd8-3d893e47371a",
                                        "glosses": [
                                            "jüdische religiöse und/oder politische Instanz, deren konkrete Aufgaben und Einflussbereich sich nicht mit Sicherheit rekonstruieren lassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5714025f-b450-45bc-8344-9c64a05fa3f0",
                                                "sense_id": "c3dcf87a-fb31-3b42-bb46-8d82321f1e02",
                                                "text": "„Gegen Ende des Jahrzehnts hatte er sich Schabtai Ben Dovs (S.193–196) religiös gefärbter Utopie vom künftigen israelischen Staat verschrieben, in der die Wiedererrichtung des Sanhedrin, des in griechisch-römischer Zeit existierenden jüdischen Hohen Rats in Palästina, sowie der Wiederaufbau des Tempels eine zentrale Rolle spielten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
