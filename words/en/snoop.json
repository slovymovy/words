{
    "word_family": [
        "snooper",
        "snoopy",
        "snooping"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "453fe214-c5a6-3ee7-8fdb-0e533f1422e5",
                    "sense_definition": "To secretly spy on or investigate, especially into the private personal life of others.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "investigation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If I had not <w>snooped</w> on her, I wouldn't have found out that she lied about her degree.",
                            "target_lang_translations": {
                                "ru": "Если бы я не <w>шпионил</w> за ней, я бы не узнал, что она солгала о своем дипломе."
                            }
                        },
                        {
                            "text": "He decided to <w>snoop</w> around the office to see if he could find the missing documents.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>повынюхивать</w> в офисе, чтобы проверить, не удастся ли найти пропавшие документы."
                            }
                        }
                    ],
                    "synonyms": [
                        "pry",
                        "spy",
                        "nose around"
                    ],
                    "antonyms": [
                        "ignore",
                        "disregard"
                    ],
                    "common_phrases": [
                        "snoop around",
                        "snoop on someone"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in informal contexts regarding privacy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тайно следить или выведывать информацию, особенно касающуюся частной жизни других людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вынюхивать",
                                "target_lang_sense_clarification": "разузнавать секреты"
                            },
                            {
                                "target_lang_word": "шпионить",
                                "target_lang_sense_clarification": "тайно следить"
                            },
                            {
                                "target_lang_word": "совать нос",
                                "target_lang_sense_clarification": "вмешиваться в чужие дела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7777a5e9-883b-3ce7-8f66-b272de25693d",
                    "sense_definition": "To be devious and cunning so as not to be seen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "stealth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief tried to <w>snoop</w> through the shadows to avoid the security cameras.",
                            "target_lang_translations": {
                                "ru": "Вор пытался <w>прокрасться</w> в тенях, чтобы его не заметили камеры наблюдения."
                            }
                        },
                        {
                            "text": "She had to <w>snoop</w> quietly past the sleeping guard to reach the exit.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось тихо <w>прошмыгнуть</w> мимо спящего охранника, чтобы добраться до выхода."
                            }
                        }
                    ],
                    "synonyms": [
                        "sneak",
                        "skulk",
                        "prowl"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действовать скрытно и хитро, чтобы остаться незамеченным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "красться",
                                "target_lang_sense_clarification": "идти тихо и незаметно"
                            },
                            {
                                "target_lang_word": "прокрадываться",
                                "target_lang_sense_clarification": "тайно проникать куда-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd32ad27-3738-3d4a-9f9e-c604061acefa",
                    "sense_definition": "To steal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The schoolboy was caught trying to <w>snoop</w> some sweets from the local shop.",
                            "target_lang_translations": {
                                "ru": "Школьника поймали, когда он пытался <w>стащить</w> сладости в местном магазине."
                            }
                        },
                        {
                            "text": "You're not thinking of <w>snooping</w> his tuck, I suppose, like Bunter.",
                            "target_lang_translations": {
                                "ru": "Я полагаю, ты не думаешь <w>своровать</w> его еду, как Бантер."
                            }
                        }
                    ],
                    "synonyms": [
                        "swipe",
                        "pilfer",
                        "filch"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British school slang"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Украсть что-либо (британский школьный сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стащить",
                                "target_lang_sense_clarification": "мелкая кража"
                            },
                            {
                                "target_lang_word": "стянуть",
                                "target_lang_sense_clarification": "незаметно украсть"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0066141d-cbd8-3e5d-b1e9-ff438ef78c8d",
                    "sense_definition": "A person who secretly spies on others or pries into their business.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful what you say around Gene because he's the bosses' <w>snoop</w>.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен в словах при Джине, потому что он — <w>ищейка</w> босса."
                            }
                        },
                        {
                            "text": "The neighborhood <w>snoop</w> is always watching from behind her curtains.",
                            "target_lang_translations": {
                                "ru": "Местная <w>любопытная особа</w> вечно следит за всеми из-за своих штор."
                            }
                        }
                    ],
                    "synonyms": [
                        "busybody",
                        "nosy parker"
                    ],
                    "common_phrases": [
                        "neighborhood snoop"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal term for a prying person"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который тайно следит за другими или вмешивается в их дела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ищейка",
                                "target_lang_sense_clarification": "о человеке, который всё вынюхивает"
                            },
                            {
                                "target_lang_word": "любопытный",
                                "target_lang_sense_clarification": "человек, сующий нос в чужие дела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa3ff138-5377-35c7-94d8-e650461ea20d",
                    "sense_definition": "The act of spying or prying into someone's private affairs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I caught him having a quick <w>snoop</w> through my desk drawers.",
                            "target_lang_translations": {
                                "ru": "Я поймал его за быстрым <w>осмотром</w> ящиков моего стола."
                            }
                        },
                        {
                            "text": "She went for a <w>snoop</w> around the house while the owners were away.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>пошпионить</w> в доме, пока хозяева отсутствовали."
                            }
                        }
                    ],
                    "synonyms": [
                        "look-around",
                        "prying"
                    ],
                    "common_phrases": [
                        "have a snoop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт слежки или вмешательства в чьи-либо частные дела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подглядывание",
                                "target_lang_sense_clarification": "тайное наблюдение"
                            },
                            {
                                "target_lang_word": "вынюхивание",
                                "target_lang_sense_clarification": "поиск скрытой информации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c32845d-6806-3b8d-970d-b5a76074ebf8",
                    "sense_definition": "A private detective.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She hired a <w>snoop</w> to find out if her husband was having an affair.",
                            "target_lang_translations": {
                                "ru": "Она наняла <w>сыщика</w>, чтобы узнать, нет ли у её мужа романа на стороне."
                            }
                        },
                        {
                            "text": "The professional <w>snoop</w> followed the suspect for three days without being noticed.",
                            "target_lang_translations": {
                                "ru": "Профессиональный <w>детектив</w> следил за подозреваемым три дня, оставаясь незамеченным."
                            }
                        }
                    ],
                    "synonyms": [
                        "private eye",
                        "gumshoe",
                        "investigator"
                    ],
                    "common_phrases": [
                        "professional snoop"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal or noir-style term for a detective"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Частный детектив."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сыщик",
                                "target_lang_sense_clarification": "профессиональный детектив"
                            },
                            {
                                "target_lang_word": "частный детектив",
                                "target_lang_sense_clarification": "нанятый расследователь"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}