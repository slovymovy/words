        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c4652591-97df-3106-ab4d-b66498b59c27",
                    "sense_definition": "aanvoegende wijs van <w>zeggen</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Men <w>zegge</w> het voort aan iedereen die het horen wil.",
                            "target_lang_translations": {
                                "ru": "Пусть <w>передадут</w> это каждому, кто хочет слушать.",
                                "en": "Let it <w>be told</w> to everyone who wants to hear it."
                            }
                        },
                        {
                            "text": "Wie het weet die <w>zegge</w> het nu maar.",
                            "target_lang_translations": {
                                "ru": "Кто знает, тот пусть сейчас и <w>скажет</w>.",
                                "en": "Whoever knows it, let them <w>say</w> it now."
                            }
                        }
                    ],
                    "common_phrases": [
                        "men zegge het voort"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in formal or fixed expressions"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "сослагательное наклонение глагола 'zeggen' (сказать), используемое в устойчивых выражениях",
                        "en": "The subjunctive mood of the verb 'zeggen' (to say), used in formal or fixed expressions to express a wish or command."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пусть скажет",
                                "target_lang_sense_clarification": "в призывах или устойчивых оборотах"
                            },
                            {
                                "target_lang_word": "да скажет",
                                "target_lang_sense_clarification": "архаичная форма призыва"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "let them say",
                                "target_lang_sense_clarification": "in formal commands or exhortations"
                            },
                            {
                                "target_lang_word": "may one say",
                                "target_lang_sense_clarification": "archaic or formal expression"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "630fa02b-5020-353f-9555-0d60f3c41dd9",
                    "sense_definition": "singularis presens conjunctief van <w>zeggen</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "God <w>zegge</w> u dank voor deze gulle gave.",
                            "target_lang_translations": {
                                "ru": "Да <w>воздаст</w> вам Бог благодарностью за этот щедрый дар.",
                                "en": "May God <w>render</w> you thanks for this generous gift."
                            }
                        },
                        {
                            "text": "Wat men ook <w>zegge</w> over hem, hij blijft een eerlijk man.",
                            "target_lang_translations": {
                                "ru": "Что бы о нем ни <w>говорили</w>, он остается честным человеком.",
                                "en": "Whatever one <w>may say</w> about him, he remains an honest man."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "subjunctive mood"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "форма конъюнктива настоящего времени единственного числа глагола 'zeggen'",
                        "en": "The singular present subjunctive form of the verb 'zeggen', typically found in religious contexts or concessive clauses."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "да воздаст",
                                "target_lang_sense_clarification": "в религиозном контексте благодарности"
                            },
                            {
                                "target_lang_word": "что бы ни говорили",
                                "target_lang_sense_clarification": "в уступительных оборотах"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "may say",
                                "target_lang_sense_clarification": "in religious or formal blessings"
                            },
                            {
                                "target_lang_word": "whatever one may say",
                                "target_lang_sense_clarification": "in concessive phrases"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
