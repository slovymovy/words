                    {
                        "translation_id": "3a3c3af1-6633-40b7-bc02-526f26571149",
                        "source_entry_id": "d6d68409-a593-367d-9e8e-0e27e8d1a11c",
                        "source_sense_id": "073b846f-b36f-3928-85e0-273b8d6cecc8",
                        "source_sense_description": "device used in film",
                        "target_lang_word": "clap",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clap",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff845006-4dc4-366f-a4dd-28bc63f724b6",
                                        "entry_id": "d1876fc9-5700-3b67-b57a-20551a30a0f0",
                                        "glosses": [
                                            "Outil de cinématographie composé de deux planchettes reliées par une charnière, que l'on filme en train d'être rabattu, et en enregistre simultanément le son du claquement sec, en début de séquence de tournage, ceci permettant une synchronisation ultérieure de l'image et du son."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0fc42a8-c975-4def-9651-e1fcc6d29269",
                                                "sense_id": "ff845006-4dc4-366f-a4dd-28bc63f724b6",
                                                "text": "Le clap a retenti et les acteurs entrent en scène devant la caméra vidéo de Christophe, un éducateur spécialisé passionné d’image et de mise en scène."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clap",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ab8cb30-b64a-312b-8ce3-c0fae2b3e530",
                                        "entry_id": "eee4e3d8-64c9-37f9-9377-1edaa61c58b3",
                                        "glosses": [
                                            "Applaudissement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dfb72fb-2283-4f4d-a342-66a2a50f1685",
                                                "sense_id": "9ab8cb30-b64a-312b-8ce3-c0fae2b3e530",
                                                "text": "Jef posa son verre de poire et applaudit calmement, clap, clap, clap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2592f600-6105-330b-be78-b60b107bb2c2",
                                        "entry_id": "eee4e3d8-64c9-37f9-9377-1edaa61c58b3",
                                        "glosses": [
                                            "Claquement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e6911a0-6413-4dc4-8566-08f50a1350fe",
                                                "sense_id": "2592f600-6105-330b-be78-b60b107bb2c2",
                                                "text": "Le bond de la Grenouille l’avait fait tomber dans l’eau. Aussitôt, un gros Brochet qui rôdait par là monta comme une flèche vers elle et l’engloutit dans sa large gueule qui se referma avec le bruit d’un coffre dont on jette le couvercle : clap ! dans un bouillonnement de l’eau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1f45f92-af32-42d2-8644-61873927c7c7",
                        "source_entry_id": "d6d68409-a593-367d-9e8e-0e27e8d1a11c",
