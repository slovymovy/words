                    {
                        "sense_id": "31100764-eb21-3f3d-b39e-d9c645ab6d79",
                        "entry_id": "ac666bbc-fad3-36e4-a4fc-8cdd57a34084",
                        "glosses": [
                            "Not dyed or discolored; not marred by any stains, marks, or spotting."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3f158367-a354-4f0d-83f6-374356705720",
                                "sense_id": "31100764-eb21-3f3d-b39e-d9c645ab6d79",
                                "text": "The unstained hardwood floor was pale, but the finish soaked in and made the room seem dark."
                            },
                            {
                                "example_id": "36e8f02b-39e9-40e5-bf7d-f387da6cb1da",
                                "sense_id": "31100764-eb21-3f3d-b39e-d9c645ab6d79",
                                "text": "The water shone pacifically; the sky, without a speck, was a benign immensity of unstained light; the very mist on the Essex marshes was like a gauzy and radiant fabric, hung from the wooded rises inland, and draping the low shores in diaphanous folds."
                            }
                        ]
                    },
                    {
                        "sense_id": "4878e88e-d5c7-3f19-8884-793f20cde83a",
                        "entry_id": "ac666bbc-fad3-36e4-a4fc-8cdd57a34084",
                        "glosses": [
                            "Pure, pristine, clean, immaculate, unadulterated."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2a5422b1-bf16-4289-af2d-8b9a2847dae9",
                                "sense_id": "4878e88e-d5c7-3f19-8884-793f20cde83a",
                                "text": "She arrived at the chapel for her marriage with unstained honor."
                            }
                        ]
                    }
