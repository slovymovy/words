                "senses": [
                    {
                        "sense_id": "c4bd5b64-c11e-3e57-8be1-ee6958ea5ed6",
                        "entry_id": "122e3bea-f591-3f7d-864c-4526a39e1c35",
                        "glosses": [
                            "Person, die immer schlechte Laune hat und wenig Freude am Leben zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7070534e-4c70-4424-94f2-bca2c2a579b7",
                                "sense_id": "c4bd5b64-c11e-3e57-8be1-ee6958ea5ed6",
                                "text": "„Tolldrastische Geschichten: wie sie in den Abteien und Klöstern der Touraine gesammelt und ans Licht gebracht der edle Herr Honoré de Balzac, zu Ergötzen, Kurzweil und Erbauung aller derer Pantagruelisten und mitnichten der Banausen und griesgrämigen Sauertöpfe.“"
                            },
                            {
                                "example_id": "cab001fe-bff5-4f02-be3e-7c8e1bad295a",
                                "sense_id": "c4bd5b64-c11e-3e57-8be1-ee6958ea5ed6",
                                "text": "„Andernfalls droht ein Ende im Dauerhader oder als Sauertopf.“"
                            },
                            {
                                "example_id": "af429a8e-f16b-4e17-b3ac-e222d07e0fca",
                                "sense_id": "c4bd5b64-c11e-3e57-8be1-ee6958ea5ed6",
                                "text": "„Sie wurde traurig oder tat wenigstens so, als ich mir herausnahm, ihr zu sagen, daß ihr Zukünftiger, den ihr Vater Mardochai für sie ausgewählt habe, vielleicht ein Mann sei, den die Natur schlecht ausgerüstet habe, oder einer jener Sauertöpfe mit schlechter Verdauung, die ihre ehelichen Pflichten nur einmal in der Woche erfüllen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe5e0615-4600-4f3d-ab95-3b491656c6db",
                        "source_entry_id": "122e3bea-f591-3f7d-864c-4526a39e1c35",
                        "source_sense_id": "c4bd5b64-c11e-3e57-8be1-ee6958ea5ed6",
                        "source_sense_description": "Person, die immer schlechte Laune hat und wenig Freude am Leben zeigt",
                        "target_lang_word": "grouch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grouch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "378ea67a-41bd-3d15-b198-6d16334909c3",
                                        "entry_id": "1de59ddc-f511-3f15-8d99-788ec0131d4c",
                                        "glosses": [
                                            "A complaint, a grumble, a fit of ill-humor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15bbc36a-e433-427f-98e7-8b68e300f12b",
                                                "sense_id": "378ea67a-41bd-3d15-b198-6d16334909c3",
                                                "text": "But today he had noticed from the moment he had got out of bed that something was amiss with the world. Either he was in the grip of some divine discontent due to the highly developed condition of his soul, or else he had a grouch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bff1079-fc57-311f-914b-e1f6ee0ec124",
                                        "entry_id": "1de59ddc-f511-3f15-8d99-788ec0131d4c",
                                        "glosses": [
                                            "One who is grumpy or irritable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52e2ce0c-7ec8-43bd-96d8-044a8625bc63",
                                                "sense_id": "9bff1079-fc57-311f-914b-e1f6ee0ec124",
                                                "text": "I don't feel like hanging around with that grouch."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grouch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92782cda-cdce-3c6e-b73d-6e85f206bd8f",
                                        "entry_id": "6cfa1575-1ff5-36ae-939c-dc75f2f907a4",
                                        "glosses": [
                                            "To be grumpy or irritable; to complain."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f27c28f-5034-47f4-ba1d-14e5a078ccfd",
                                                "sense_id": "92782cda-cdce-3c6e-b73d-6e85f206bd8f",
                                                "text": "He spent all his time grouching about the problem instead of fixing it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
