                                "target_senses": [
                                    {
                                        "sense_id": "dd0d7590-906c-3e2c-b525-acae7acdd271",
                                        "entry_id": "76b87cac-47ad-3b64-ac80-1c031bbae58d",
                                        "glosses": [
                                            "Fotografie aus der Luft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f81a9c36-3e6c-4f64-a47e-dcea6ba7b82a",
                                                "sense_id": "dd0d7590-906c-3e2c-b525-acae7acdd271",
                                                "text": "Obwohl dieses Luftbild aus 11.000 Metern gemacht wurde, kann man fast alle Details erkennen."
                                            },
                                            {
                                                "example_id": "e1cafbac-fa15-4f50-976c-2eb035a3a226",
                                                "sense_id": "dd0d7590-906c-3e2c-b525-acae7acdd271",
                                                "text": "„Noch heute lässt sich auf dem Luftbild erahnen, dass die Stadtmauer einen fast perfekten Kreis bildete, man muss demnach von einer planmäßigen Erbauung ausgehen.“"
                                            },
                                            {
                                                "example_id": "c5d7858e-2aa0-43c1-859b-c9171b00cc41",
                                                "sense_id": "dd0d7590-906c-3e2c-b525-acae7acdd271",
                                                "text": "„Gerade hat Posluschny eine Drohne für gestochen scharfe Luftbilder angeschafft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27b4592c-0e29-4f02-917a-d5a9bf1cbb84",
                        "source_entry_id": "efece623-6bc2-3942-9813-a4e61fcefb23",
                        "source_sense_id": "9008bf7a-b1cb-3267-b270-f704ca6124b6",
                        "source_sense_description": "sdÜ",
