                "senses": [
                    {
                        "sense_id": "cba63963-bb0e-3c1c-a6ef-477cac9cd5fb",
                        "entry_id": "f279c05a-34be-33bd-90b9-8cfbf3f97b00",
                        "glosses": [
                            "истор. старинная серебряная монета достоинством в один рубль"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b1a8eae7-3b5a-37d1-bf65-f0b33fa4a782",
                        "entry_id": "f279c05a-34be-33bd-90b9-8cfbf3f97b00",
                        "glosses": [
                            "разг. один рубль (обычно одной монетой или бумажной купюрой)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14cd898b-d9aa-4af0-9560-3075d98100f4",
                                "sense_id": "b1a8eae7-3b5a-37d1-bf65-f0b33fa4a782",
                                "text": "Подрушный товарищ пошел целковым, я помирил этот целковый, да два под другого товарища, тот тоже, и выставил уж пять, так у нас и пошла круговая."
                            },
                            {
                                "example_id": "6d22d9eb-439a-4eb2-93d5-6b040aff0d31",
                                "sense_id": "b1a8eae7-3b5a-37d1-bf65-f0b33fa4a782",
                                "text": "Еще Маяковский когда-то сказал: «Я не целковый, чтобы всем нравиться!..»"
                            }
                        ]
                    }
                ],
