                    "frequency": "High",
                    "semantic_group_id": "Beanspruchung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die vielen Überstunden und der ständige Schlafmangel <w>belasten</w> seine Gesundheit schon seit Wochen."
                        },
                        {
                            "text": "Abgase und giftige Chemikalien <w>belasten</w> die Umwelt in dieser Region sehr stark."
                        }
                    ],
                    "synonyms": [
