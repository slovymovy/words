                    {
                        "translation_id": "127a5dbb-6211-4a8b-b1bd-74cb7ca893d3",
                        "source_entry_id": "e5266379-30fb-312b-85e7-0beffa02f05b",
                        "source_sense_id": "b14add8c-183f-3cff-8a06-d86dbd3ab8e4",
                        "source_sense_description": "Religion: jemand, der glaubt, es gebe mehrere Götter",
                        "target_lang_word": "polythéiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polythéiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31406671-0af7-3bdf-8008-0c120da4d631",
                                        "entry_id": "3a962b55-68a2-327a-95d2-d189ca6fe711",
                                        "glosses": [
                                            "Caractérisé par la croyance en plusieurs divinités (et non en une seule ou aucune)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "344e5d63-0f5d-442a-a29e-bd0082e61c88",
                                                "sense_id": "31406671-0af7-3bdf-8008-0c120da4d631",
                                                "text": "Les religions polythéistes."
                                            },
                                            {
                                                "example_id": "af1616c1-c076-4b61-8a00-835d756b10a6",
                                                "sense_id": "31406671-0af7-3bdf-8008-0c120da4d631",
                                                "text": "Les Hébreux retomberont à plusieurs reprises dans ces « travers » polythéistes, occasionnant chaque fois la punition de ce dieu exclusif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87804ae4-44ef-3b31-b37b-6f84ec19fc60",
                                        "entry_id": "3a962b55-68a2-327a-95d2-d189ca6fe711",
                                        "glosses": [
                                            "Adepte du polythéisme."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21e03549-6d8e-42ff-aa01-d19afbb0d867",
                                                "sense_id": "87804ae4-44ef-3b31-b37b-6f84ec19fc60",
                                                "text": "On risque autant à croire trop, qu’à croire trop peu. Il n’y a ni plus ni moins de danger à être polythéiste qu’athée : or, le scepticisme peut seul garantir également, en tout temps et en tout lieu, de ces deux excès opposés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "polythéiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b057e4e-9693-36c9-889e-cb56799a9246",
                                        "entry_id": "f712a079-2443-3913-a971-7142dc80e15f",
                                        "glosses": [
                                            "Personne qui croit en plusieurs dieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cb0ed91-c568-4c87-9576-5343c233747d",
                                                "sense_id": "0b057e4e-9693-36c9-889e-cb56799a9246",
                                                "text": "Je revis le père Éphraïm sous les traits d’un polythéiste qui sacrifiait des animaux pour les dieux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
