                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historical records mention a merchant named Thomas <w>Dire</w> who lived in London.",
                            "target_lang_translations": {
                                "ru": "В исторических записях упоминается купец по имени Томас <w>Дайр</w>, живший в Лондоне.",
                                "nl": "In de historische verslagen wordt een koopman genaamd Thomas <w>Dire</w> genoemd die in Londen woonde."
