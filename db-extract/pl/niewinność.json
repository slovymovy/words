                "senses": [
                    {
                        "sense_id": "1eeefa79-3803-3d38-ae09-91ce7e5283dd",
                        "entry_id": "29c46d9b-b0fb-3bf0-990e-313d1ec49a54",
                        "glosses": [
                            "cecha tego, co niewinne, nie ma w sobie winy; brak popełnienia przestępstwa, grzechu, określonego błędu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2e36a10-8ecc-4dae-b1d7-da90d0560c10",
                                "sense_id": "1eeefa79-3803-3d38-ae09-91ce7e5283dd",
                                "text": "Niechaj cię nie zwiedzie jej udawana niewinność – ona niejedno już widziała."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "aecc3118-2bd9-3126-92b8-4178b7cf1850",
                        "entry_id": "29c46d9b-b0fb-3bf0-990e-313d1ec49a54",
                        "glosses": [
                            "osoba niewinna, nieśmiała, naiwna lub skromna"
                        ],
