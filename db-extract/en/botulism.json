                                        "sense_id": "d90157e7-c782-3cad-af55-325f253557bb",
                                        "entry_id": "dc8890ae-7877-38b8-909c-f201c80b8192",
                                        "glosses": [
                                            "paralytické onemocnění, otrava klobásovým jedem – botulinem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6cff08f-1a11-41a3-9b74-ba50cd9f3eda",
                                                "sense_id": "d90157e7-c782-3cad-af55-325f253557bb",
                                                "text": "Med by se neměl podávat dětem do jednoho roku, a to kvůli velmi výjimečnému, ale závažnému riziku botulismu."
                                            }
                                        ]
                                    }
                                ]
