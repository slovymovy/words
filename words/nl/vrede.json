                {
                    "sense_id": "fb66d3b4-dbe9-35a2-a9cd-c2d3a92abd39",
                    "sense_definition": "Een toestand van innerlijke rust, kalmte of harmonie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tranquility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de stilte van het bos vond hij eindelijk <w>vrede</w>.",
                            "target_lang_translations": {
                                "en": "In the silence of the forest, he finally found <w>peace</w>.",
                                "ru": "В тишине леса он наконец обрел <w>покой</w>.",
                                "pl": "W ciszy lasu odnalazł w końcu <w>spokój</w>.",
                                "de": "In der Stille des Waldes fand er endlich <w>Frieden</w>.",
                                "fr": "Dans le silence de la forêt, il a enfin trouvé la <w>paix</w>.",
                                "it": "Nel silenzio del bosco trovò finalmente la <w>pace</w>.",
                                "cs": "V tichu lesa konečně našel <w>klid</w>.",
                                "tr": "Ormanın sessizliğinde nihayet <w>huzur</w> buldu.",
                                "es": "En el silencio del bosque encontró finalmente la <w>paz</w>."
                            }
                        },
                        {
                            "text": "Ik wil gewoon dat je me met <w>vrede</w> laat.",
                            "target_lang_translations": {
                                "en": "I just want you to leave me in <w>peace</w>.",
                                "ru": "Я просто хочу, чтобы ты оставил меня в <w>покое</w>.",
                                "pl": "Chcę tylko, żebyś dał mi <w>święty spokój</w>.",
                                "de": "Ich will einfach nur, dass du mich in <w>Ruhe</w> lässt.",
                                "fr": "Je veux juste que tu me laisses en <w>paix</w>.",
                                "it": "Voglio solo che tu mi lasci in <w>pace</w>.",
                                "cs": "Jen chci, abys mě nechal na <w>pokoji</w>.",
                                "tr": "Sadece beni <w>rahat</w> bırakmanı istiyorum.",
                                "es": "Solo quiero que me dejes en <w>paz</w>."
                            }
                        }
                    ],
