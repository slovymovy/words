                ],
                "senses": [
                    {
                        "sense_id": "36d55c94-d7e5-33b0-b90d-116cb8712848",
                        "entry_id": "aa035263-593b-3678-ae70-f43d7168ebc5",
                        "glosses": [
                            "pedantische, rechthaberische Kritik, die sich auf nebensächliche Kleinigkeiten (z. B. Regelverletzungen) konzentriert und dabei das Ganze aus den Augen verliert"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "ae2466d5-f766-40fb-ac8b-5535c898555c",
                                "sense_id": "36d55c94-d7e5-33b0-b90d-116cb8712848",
                                "text": "„Von irgendwelcher gedanklichen Erfassung des Problems weit entfernt und mit einer Beckmesserei wütend, die ziemlich konsequent das Falsche für richtig und das Richtige für falsch befindet, begnügt er sich, die ‚echt hochdeutsche Aussprache‘ als das Kriterium des Reimwertes aufzustellen.“"
                            },
                            {
                                "example_id": "5d3bf9b9-7bc4-4312-9bde-76e57cda4c0c",
                                "sense_id": "36d55c94-d7e5-33b0-b90d-116cb8712848",
                                "text": "„Der Autor selbst ist ein virtuoser, einfallsreicher, sensibler Sprachkünstler, ihm Konstruktionsmängel in der Anlage seiner Hauptfigur anzukreiden hat etwas von Beckmesserei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
