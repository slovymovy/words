                "senses": [
                    {
                        "sense_id": "58ade461-cca7-344c-8c63-432497633a0f",
                        "entry_id": "36a14acf-2353-33f5-ac6f-2200363aaf21",
                        "glosses": [
                            "mit Träuble (Johannisbeeren) gefüllter Kuchen"
                        ],
                        "tags": [
                            "Swabian"
                        ],
                        "examples": [
                            {
                                "example_id": "11a2a5ba-7d38-4bcc-9d7a-ec3ab31f37e2",
                                "sense_id": "58ade461-cca7-344c-8c63-432497633a0f",
                                "text": "„Aber mit Mürbeteig und ein paar Zutaten vereinen sie sich zu einem leckeren Träubleskuchen“."
                            },
                            {
                                "example_id": "0d002a03-a62e-4b32-9c99-b95621247c74",
                                "sense_id": "58ade461-cca7-344c-8c63-432497633a0f",
                                "text": "„Entdecken Sie die köstliche Welt des schwäbischen Träubleskuchens, einem traditionellen Johannisbeerkuchen, der in der Region Schwaben fest verankert ist.“."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
