                },
                {
                    "sense_id": "ac6dbf3b-f3eb-3619-ba97-0b0d879ef364",
                    "sense_definition": "een systeem van communicatie gebruikt door een bepaalde gemeenschap; taal",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "taal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dit oude boek wordt verwezen naar de menselijke <w>spraak</w> als een goddelijk geschenk.",
                            "target_lang_translations": {
                                "en": "In this old book, human <w>speech</w> is referred to as a divine gift."
                            }
