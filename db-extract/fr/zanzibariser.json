                "senses": [
                    {
                        "sense_id": "c939d336-60ba-3374-aa59-b794ecd0cecd",
                        "entry_id": "3a23a2b1-ef50-376a-bb7a-f7ef4e60df74",
                        "glosses": [
                            "Donner un caractère zanzibari à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec2f83aa-9bb4-41b9-a531-c4d992fb5ef2",
                                "sense_id": "c939d336-60ba-3374-aa59-b794ecd0cecd",
                                "text": "Dans une logique de résistance face aux velléités assimilatrices du continent, la société insulaire s’est d’une certaine façon « zanzibarisée »."
                            },
                            {
                                "example_id": "3f418386-1d39-45d7-8bea-9ceb3c148521",
                                "sense_id": "c939d336-60ba-3374-aa59-b794ecd0cecd",
                                "text": "Non pas que le thé et les gâteaux manquassent dans la maison, mais parce que, je suppose, c’est l’habitude d’un Européen zanzibarisé de mettre dans son vin un peu d’eau de Seltz, comme stimulant aux fins caquetages que, sous cette piquante influence, il débite à ses auditeurs."
                            }
                        ]
                    }
                ],
