                "senses": [
                    {
                        "sense_id": "476bff2b-8efc-36b9-8ca1-a2b6fd032e4a",
                        "entry_id": "3df46b3e-cdbb-35a1-8627-5577a9e37510",
                        "glosses": [
                            "Modus zur Ermittlung des Meisters eines Mannschaftswettbewerbs, bei dem die Mannschaften in einer Reihe von Spielen gegeneinander antreten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f96db090-4e08-405c-bfc2-5b125495d220",
                                "sense_id": "476bff2b-8efc-36b9-8ca1-a2b6fd032e4a",
                                "text": "„Noch weitere drei Jahre war der SB Rosenheim Spitze, und dreimal in Folge konnte die DEG sich rächen, indem sie den Meister von 1989 aus dem Play-off warf: 1991 im Halbfinale, 1990 und 1992 im Finale.“"
                            },
                            {
                                "example_id": "60b7e728-3f25-4c43-bcdb-ccb4489336ea",
                                "sense_id": "476bff2b-8efc-36b9-8ca1-a2b6fd032e4a",
                                "text": "„Durch athletisch und konditionell anspruchsvollen Tempobasketball stürmten die Niedersachsen zweimal in Folge in die Play-offs und gewannen zudem in der Saison 2009/2010 die Euro-Challenge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
