                "senses": [
                    {
                        "sense_id": "6f170643-ab11-35c9-83db-c84c4747add4",
                        "entry_id": "ac85729f-7aa1-3007-b0cd-a5df48f51764",
                        "glosses": [
                            "besonders widerstandsfähige Burg"
                        ],
                        "tags": [
                            "auch übertragen"
                        ],
                        "examples": [
                            {
                                "example_id": "d652afb9-9b75-4ad8-be7a-49a76f180421",
                                "sense_id": "6f170643-ab11-35c9-83db-c84c4747add4",
                                "text": "Die Trutzburg überstand die Belagerung monatelang."
                            },
                            {
                                "example_id": "0e90aa5c-b905-4c97-b57c-40cdd3b980f4",
                                "sense_id": "6f170643-ab11-35c9-83db-c84c4747add4",
                                "text": "„Papa sagte, dass diese Ruine der Rest einer alten Trutzburg sei, und als ich ihn fragte, was das Wort »Trutzburg« bedeute, erzählte er mir eine Geschichte.“"
                            },
                            {
                                "example_id": "0340c590-78e8-4cd8-8dcf-8b7ae53bb616",
                                "sense_id": "6f170643-ab11-35c9-83db-c84c4747add4",
                                "text": "„Das sich idyllisch selbstverliebt im Wasser spiegelnde Mespelbrunn wurde ursprünglich als Trutzburg errichtet, das über dem Main prunkende Renaissanceschloss Johannisburg entstand erst Anfang des 17. Jahrhunderts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ebd3a55-0f3c-4fc0-98b0-af03db9ad5c3",
                        "source_entry_id": "ac85729f-7aa1-3007-b0cd-a5df48f51764",
                        "source_sense_id": "6f170643-ab11-35c9-83db-c84c4747add4",
                        "source_sense_description": "auch übertragen: besonders widerstandsfähige Burg",
                        "target_lang_word": "forteresse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forteresse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16c8ecb2-a78d-3827-b4a7-fb713895c805",
                                        "entry_id": "d0263ff1-3e3b-3322-8f2d-d004aa500071",
                                        "glosses": [
                                            "Lieu ou ville fortifiée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9373622b-1177-4d2a-ba77-3797012b3e2e",
                                                "sense_id": "16c8ecb2-a78d-3827-b4a7-fb713895c805",
                                                "text": "Je combattrai au premier rang ; mais mes honnêtes voisins savent bien que je ne suis pas un soldat habile dans les règles de la guerre, ni dans l’attaque des forteresses."
                                            },
                                            {
                                                "example_id": "6eb9d746-01e1-4c0f-a2a5-b20100f4bf67",
                                                "sense_id": "16c8ecb2-a78d-3827-b4a7-fb713895c805",
                                                "text": "Le gouverneur de la forteresse avait fait ses préparatifs de défense. Des monceaux de pavés garnissaient le haut des tours, entourant les canons, pour lesquels on avait élargit les meurtrières."
                                            },
                                            {
                                                "example_id": "70da0537-091f-4c3f-b533-4de89604bc05",
                                                "sense_id": "16c8ecb2-a78d-3827-b4a7-fb713895c805",
                                                "text": "Louis IX, attachant une grande importance à la place de Carcassonne qui couvrait cette partie du domaine royal devant l’Aragon, […], voulut en faire une forteresse inexpugnable."
                                            },
                                            {
                                                "example_id": "78a6323f-d931-418c-bf86-47815a9f975b",
                                                "sense_id": "16c8ecb2-a78d-3827-b4a7-fb713895c805",
                                                "text": "Belgrade est une ville ouverte, car son ancienne forteresse turque ne peut pas être considérée comme un ouvrage de défense moderne."
                                            },
                                            {
                                                "example_id": "98335c24-c055-471d-b384-a24b607491a0",
                                                "sense_id": "16c8ecb2-a78d-3827-b4a7-fb713895c805",
                                                "text": "Une vraie petite forteresse flottante avec trois canons de 20 mm disposés en triangle à l'arrière, deux mitrailleuses latérales et deux piats […] qui se trouvent juste à portée de main du chef mécanicien Denard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ebd20a4-0461-329c-9f6f-cde5ea0d6e2b",
                                        "entry_id": "d0263ff1-3e3b-3322-8f2d-d004aa500071",
                                        "glosses": [
                                            "Prison militaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3ad5aa0-e94f-40d0-9e82-d189bd82d4d2",
                                                "sense_id": "4ebd20a4-0461-329c-9f6f-cde5ea0d6e2b",
                                                "text": "Faut pas prendre les gens pour des cons, qu’ils diront les médecins militaires, et ça t’empêchera pas, mon vieux, d’y aller à la manœuvre, avec la bande à Velpeau, et un coup de pied dans l’arrière-train, plus quatre-vingt-dix jours de forteresse pour couronner le tout, si c’est pas le conseil de guerre, Biribi, Foum, Tataouine et compagnie, et nous, les marrons du feu, on aura la police au cul pendant quelques lustres, tu comprends ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "699a3b19-f981-3a17-ab94-3340184bac29",
                                        "entry_id": "d0263ff1-3e3b-3322-8f2d-d004aa500071",
                                        "glosses": [
                                            "Position d’un camp en infériorité mais ne pouvant être délogé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3dfec450-5aa2-3741-9f1c-2a75e6bdc90e",
                                        "entry_id": "d0263ff1-3e3b-3322-8f2d-d004aa500071",
                                        "glosses": [
                                            "Forteresse volante, gros bombardier en usage durant la Seconde Guerre mondiale."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f5b4d92-2a92-46a0-86eb-d9610f454816",
                                                "sense_id": "3dfec450-5aa2-3741-9f1c-2a75e6bdc90e",
                                                "text": "Deux mille forteresses venaient de passer sur ma tête, gardées par des appareils de chasse dansants, lumineux et minuscules tellement ils virevoltaient à une hauteur prodigieuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
