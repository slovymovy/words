                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a20eac8b-cd1d-4e1a-86fc-035681c963d1",
                                                "sense_id": "94b7403a-5aa5-394d-bc7d-7b6253c9d460",
                                                "text": "Ist die Konfiguration korrupt, hilft oft nur noch Deinstallieren und Neuinstallieren."
                                            }
                                        ],
