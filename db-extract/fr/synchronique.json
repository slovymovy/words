                    }
                ],
                "senses": [
                    {
                        "sense_id": "472ba2be-c54f-3b31-901e-e1db88bbe829",
                        "entry_id": "57e115a5-1710-360c-9e0b-c378ee5bf94f",
                        "glosses": [
                            "Qui est relatif à ce qui se fait dans le même temps."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "3b632236-cfb8-4d7b-8a28-ce2f7843de37",
                                "sense_id": "472ba2be-c54f-3b31-901e-e1db88bbe829",
                                "text": "L’histoire de l’humanité n’est nullement synchronique en ses diverses parties. Tremblons. En ce moment peut-être la religion de l’avenir se fait et se fait sans nous."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5be34f0-c708-30cf-ae0a-26d4a9111e1a",
                        "entry_id": "57e115a5-1710-360c-9e0b-c378ee5bf94f",
                        "glosses": [
                            "Relatif à un système linguistique à un moment donné, sans considérer les évolutions dans le passé."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ef67ea4-2903-487f-8c21-e5ae03cdf751",
                        "source_entry_id": "57e115a5-1710-360c-9e0b-c378ee5bf94f",
                        "target_lang_word": "synchron",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "synchron",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c59a5f22-b563-3ee4-87f6-7777f98ec8c9",
                                        "entry_id": "4c021135-d5fe-3e00-bbf9-0dbd7d19bcbb",
                                        "glosses": [
                                            "zeitlich beziehungsweise vom Ablauf her übereinstimmend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77a186d7-0c7f-433e-ab4d-fa46e46da177",
                                                "sense_id": "c59a5f22-b563-3ee4-87f6-7777f98ec8c9",
                                                "text": "Die Prozesse müssen genau synchron ablaufen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "466b0a33-0b78-3f24-a9bb-b028617937be",
                                        "entry_id": "4c021135-d5fe-3e00-bbf9-0dbd7d19bcbb",
                                        "glosses": [
                                            "Linguistik: in einem begrenzten Zeitabschnitt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14bd84b3-8910-4216-8f80-d75ce0306131",
                                                "sense_id": "466b0a33-0b78-3f24-a9bb-b028617937be",
                                                "text": "„Eine Methode, die in dem von Rindler-Schjerve geschilderten Projekt verwendet wird und die - wie sich in den Beiträgen von Dittmar und Lainio zeigt - auch in synchronen Untersuchungen zunehmend als Methode an Bedeutung gewinnt, ist die der Diskurs- und Korpusanalyse.“"
                                            },
                                            {
                                                "example_id": "e2e9b27e-ec1f-46c6-a242-b2d256f689ce",
                                                "sense_id": "466b0a33-0b78-3f24-a9bb-b028617937be",
                                                "text": "„Die synchrone Sprachbetrachtung erforscht die Sprache zu einem bestimmten Zeitpunkt.“"
                                            },
                                            {
                                                "example_id": "b5e0c5c8-40e5-45de-a258-1bd75e4777d5",
                                                "sense_id": "466b0a33-0b78-3f24-a9bb-b028617937be",
                                                "text": "Die synchrone Linguistik befasst sich mit dem Zustand einer Sprache in einer begrenzten Entwicklungsphase."
                                            },
                                            {
                                                "example_id": "f9758cf6-ae38-48aa-a381-28dc6f884acb",
                                                "sense_id": "466b0a33-0b78-3f24-a9bb-b028617937be",
                                                "text": "„Erst mit de Saussure etablierte sich in der modernen Sprachwissenschaft die synchrone Betrachtungsweise.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53864f83-663f-4e90-bbf1-e5883730ed1d",
