                "senses": [
                    {
                        "sense_id": "199d288c-ab59-3b87-8d5b-06a780bce4ff",
                        "entry_id": "5254cd6e-8225-3198-bbd4-0836e3ef779b",
                        "glosses": [
                            "Bestattungsort; letzte Ruhestätte; Stelle, an der ein oder mehrere Verstorbene einer Pestepidemie beigesetzt wurden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26ee3194-2ad6-4104-b157-5f3fb669f95b",
                                "sense_id": "199d288c-ab59-3b87-8d5b-06a780bce4ff",
                                "text": "„Das erhaltene Pestgrab in Mondsee stammt aus dem Jahre 1649 und gilt dem verstorbenen Pater Franz Soier.“"
                            },
                            {
                                "example_id": "7c0f3b42-6714-4101-87a9-c79723071698",
                                "sense_id": "199d288c-ab59-3b87-8d5b-06a780bce4ff",
                                "text": "„Da diese Ziegel aus dem frühen 18. Jh. stammen, könnten die beiden vermauerten Särge tatsächlich Pestgräber von 1713 sein, was nur weitere Forschung beweisen kann.“"
                            },
                            {
                                "example_id": "4dc4d3bc-82b8-4524-98ee-8d668bfc017f",
                                "sense_id": "199d288c-ab59-3b87-8d5b-06a780bce4ff",
                                "text": "„Archäologen entdeckten direkt unter dem Fußboden ein Pestgrab mit rund 200 Skeletten.“"
                            },
                            {
                                "example_id": "b622defb-ae8b-4304-b2c3-928b0a386711",
                                "sense_id": "199d288c-ab59-3b87-8d5b-06a780bce4ff",
                                "text": "„Sie wurden allgemein die Pestgräber genannt, und die Waldhöhe darüber hieß der Siechberg.“"
                            },
                            {
                                "example_id": "26a1b533-224e-4d68-a265-fa2e10f55d35",
                                "sense_id": "199d288c-ab59-3b87-8d5b-06a780bce4ff",
                                "text": "„Der Hügel an der Nordseite der Kirche ist ein Pestgrab aus dem Jahre 1635, in dem rund 300 Tote bestattet sein sollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
