                        "entry_id": "a0ddb2ff-10ce-31fd-8d63-0c33e9d99e03",
                        "glosses": [
                            "unterhalb der Lendenwirbel aus Wirbeln zusammengewachsener Knochen"
                        ],
                        "tags": [
                            "bei Landwirbeltieren und beim Menschen"
                        ],
                        "examples": [
                            {
                                "example_id": "dbcaa9ec-aead-418e-9943-a57abe4bad07",
                                "sense_id": "83c3f4b0-bcf6-3e1a-8866-c1a73aa6cbfc",
                                "text": "Während der Entwicklung wachsen die fünf Kreuzbeinwirbel (Sakralwirbel, S1 - S5) zu einem einheitlichen Knochen zusammen."
                            },
                            {
                                "example_id": "91c950cc-8604-45a3-9a29-2c7cc44b62c8",
                                "sense_id": "83c3f4b0-bcf6-3e1a-8866-c1a73aa6cbfc",
                                "text": "Die schwach ausgeprägte Crista sacralis intermedia wird durch die fusionierten Gelenkfortsätze der Sakralwirbel gebildet."
                            },
                            {
                                "example_id": "527c505b-4fae-4d16-9a5d-aa04b570c1e4",
                                "sense_id": "83c3f4b0-bcf6-3e1a-8866-c1a73aa6cbfc",
                                "text": "Die Kreuzwirbel (Sakralwirbel) stehen über das sog. Iliosakralgelenk mit dem Becken in Verbindung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
