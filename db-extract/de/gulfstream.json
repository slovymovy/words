                "senses": [
                    {
                        "sense_id": "d39c53a1-5ea8-3e44-bfe1-157573ccf793",
                        "entry_id": "d31ed80f-57db-37f4-8dce-f1fa73dee4b4",
                        "glosses": [
                            "Luftfahrzeug, das vom Hersteller Gulfstream Aerospace produziert wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5663a7b4-3571-401f-8fd6-9ac34394857f",
                                "sense_id": "d39c53a1-5ea8-3e44-bfe1-157573ccf793",
                                "text": "„Wenige Minuten später musterte Savoy seine drei jungen Passagiere, während die Gulfstream abhob.“"
                            },
                            {
                                "example_id": "5a612b9c-fe98-4816-9763-59cd90f8db87",
                                "sense_id": "d39c53a1-5ea8-3e44-bfe1-157573ccf793",
                                "text": "„Die Gulfstream setzte um kurz vor fünf Uhr morgens in Kairo auf und rollte zu einem lackierten Container unweit der Landepiste.“"
                            },
                            {
                                "example_id": "7412c898-4e8d-4146-a179-c07a080e73a4",
                                "sense_id": "d39c53a1-5ea8-3e44-bfe1-157573ccf793",
                                "text": "„Wir konnten verifizieren, dass eine seiner Gulfstreams auf dem Flughafen gelandet ist.“"
                            },
                            {
                                "example_id": "f8113c67-a4dc-45c0-b603-143621215234",
                                "sense_id": "d39c53a1-5ea8-3e44-bfe1-157573ccf793",
                                "text": "„›Nein. Ich habe eine weitere Gulfstream bestellt. Sie wird in sechs Stunden zum ursprünglich geplanten Zeitpunkt am Flughafen auf ihn warten.‹“"
                            },
                            {
                                "example_id": "45d8cda2-9b3b-4b05-97ee-60334dad3a69",
                                "sense_id": "d39c53a1-5ea8-3e44-bfe1-157573ccf793",
                                "text": "„In diesem Moment hielt ein weiterer Privatjet neben der Bombardier, eine kleinere und wesentlich ältere Gulfstream.“"
                            },
                            {
                                "example_id": "1a4d0d31-c146-4988-8ee4-483a40e14c57",
                                "sense_id": "d39c53a1-5ea8-3e44-bfe1-157573ccf793",
                                "text": "„Um fünf Uhr morgens landete die Gulfstream von Townsend Government Services auf dem Brüsseler Flughafen.“"
                            },
                            {
                                "example_id": "2988a6e1-6a8b-43dc-a6ed-42a88febeebf",
                                "sense_id": "d39c53a1-5ea8-3e44-bfe1-157573ccf793",
                                "text": "„Als Lebende wurde ich in einer Gulfstream auf dem Flug von Brisbane über Berlin nach Boston geboren; katzbuckelnde Lakaien stopften mein gieriges Maul mit geschälten Weintrauben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
