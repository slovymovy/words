                "senses": [
                    {
                        "sense_id": "138e9975-ea13-3139-8994-0ecdf03e0482",
                        "entry_id": "dbc19a01-f165-3d33-9e54-c087f57500fb",
                        "glosses": [
                            "Zusatzschild an Ampeln mit einem grünen nach rechts zeigenden Pfeil, der das Rechtsabbiegen auch bei roter Ampel erlaubt"
                        ],
                        "tags": [
                            "Verkehrswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "a36300fc-a3a7-4758-9071-2f1d539288f4",
                                "sense_id": "138e9975-ea13-3139-8994-0ecdf03e0482",
                                "text": "„Der Grünpfeil stammt ursprünglich aus der DDR, wo er schon 1978 eingeführt wurde. Seit dem 1. März 1994 findet er in der gesamten Bundesrepublik Verwendung.“"
                            },
                            {
                                "example_id": "99a58311-fb4a-40ff-a0f6-0b27ef8b94c4",
                                "sense_id": "138e9975-ea13-3139-8994-0ecdf03e0482",
                                "text": "„Die meisten Grünpfeile hängen übrigens in Dresden. Dort sind rund zwei Drittel der Ampelkreuzungen mit dem Symbol ausgerüstet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
