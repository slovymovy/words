                ],
                "senses": [
                    {
                        "sense_id": "a37da535-d3d2-3c2e-ad14-6f42fb55d757",
                        "entry_id": "af7c11d5-1f0e-3fd6-87c3-dfd69b2cecdd",
                        "glosses": [
                            "ein aus den Traubensorten „Mammolo“ und „San Gioveto“ im Süden der Toskana um den gleichnamigen Ort „Montepulciano“ hergestellter Rotwein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b3c4c80-660d-4d7c-bf7f-34de7bcf48f0",
                                "sense_id": "a37da535-d3d2-3c2e-ad14-6f42fb55d757",
                                "text": "Der Montepulciano zählt zu den besten Weinen der Toskana."
                            },
                            {
                                "example_id": "fdc8ccf7-5ec4-4769-8e54-0882b8c609d1",
                                "sense_id": "a37da535-d3d2-3c2e-ad14-6f42fb55d757",
                                "text": "„Vollgestopft mit Makkaroni und beschwipst vom Chianti und Montepulciano, hatten wir kein Verlangen nach Liebe, und beim Erwachen waren unsere Tollheiten nicht der Rede wert.“"
                            },
                            {
                                "example_id": "fbf2c0ed-f847-45e2-b1c5-da3039b57de4",
                                "sense_id": "a37da535-d3d2-3c2e-ad14-6f42fb55d757",
                                "text": "„Nach dem dritten Montepulciano kam die Sprache auf das Ende des Kapitalismus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7148323c-90d8-360f-bf33-0d6db5605972",
                        "entry_id": "af7c11d5-1f0e-3fd6-87c3-dfd69b2cecdd",
                        "glosses": [
                            "süditalienische Rotwein-Rebsorte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7462282-a52f-43b4-b9dd-72b98e84464a",
                                "sense_id": "7148323c-90d8-360f-bf33-0d6db5605972",
                                "text": "Aus der Montepulciano-Traube wird ein recht ordentlicher, süditalienischer Rotwein bereitet."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
