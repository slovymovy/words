                        }
                    ],
                    "common_phrases": [
                        "passionate clinch"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een hartstochtelijke of romantische omhelzing."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "omhelzing",
                                "target_lang_sense_clarification": "hartstochtelijke omarming"
                            },
                            {
                                "target_lang_word": "omarming",
                                "target_lang_sense_clarification": "romantische omarming"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5336fb2-b93e-36da-92a8-95802fb775fc",
                    "sense_definition": "A position in combat sports where one or both combatants hold each other.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The referee separated the fighters from the <w>clinch</w>.",
                            "target_lang_translations": {
                                "nl": "De scheidsrechter haalde de vechters uit de <w>clinch</w>."
                            }
                        },
                        {
                            "text": "He used a strong <w>clinch</w> to neutralize his opponent's strikes.",
                            "target_lang_translations": {
                                "nl": "Hij gebruikte een stevige <w>clinch</w> om de slagen van zijn tegenstander te neutraliseren."
                            }
