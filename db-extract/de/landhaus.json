                        "source_entry_id": "2ab88812-0f76-3a32-a1a3-349205557733",
                        "source_sense_id": "83f3e343-c9ae-3460-a226-86b5c930682b",
                        "source_sense_description": "Haus auf dem Land",
                        "target_lang_word": "maison de campagne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maison de campagne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "15e6e8f0-c214-3186-afa6-350bb0bd596f",
                                        "entry_id": "98ceddbc-2272-3f2e-9e43-dafee23e4620",
                                        "glosses": [
                                            "Résidence de repos ou de loisir, en zone rurale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df22f40d-3c9c-4421-affc-08586b5122c1",
                                                "sense_id": "15e6e8f0-c214-3186-afa6-350bb0bd596f",
                                                "text": "Nous avons notre petite ferme-modèle, absolument comme le gouvernement, c’est notre maison de campagne, elle est à trois lieues d’ici, sur la route d’Italie, près de Villeneuve-Saint-Georges."
                                            },
                                            {
                                                "example_id": "4edb9e0f-ba8c-4fb9-b4af-f42c7355becc",
                                                "sense_id": "15e6e8f0-c214-3186-afa6-350bb0bd596f",
                                                "text": "Son épouse, avertie de cet accident, étant venue le prendre dans une basterne pour le conduire dans une maison de campagne, il recouvra son bon sens."
                                            },
                                            {
                                                "example_id": "8d9d85f9-7e19-4736-be7b-ae9d4445d92f",
                                                "sense_id": "15e6e8f0-c214-3186-afa6-350bb0bd596f",
                                                "text": "Il n'y a de sécurité nulle part. Jean Oudin de Verpel, abbé de Mouzon, s'était retiré au Petit-Remilly, où les Bénédictins avaient une maison de campagne, avec une chapelle qui subsista jusqu'au XVIIIᵉ siècle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
