                        "examples": [
                            {
                                "example_id": "8ff2b34a-4eb2-4562-8036-5726810b0924",
                                "sense_id": "c8a3038c-7207-304a-ac1c-a6bd58ccd6a5",
                                "text": "Het is weer de tweeëntwintig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "735844a4-82a7-4aa9-ab06-d37370388b92",
                                "sense_id": "c8a3038c-7207-304a-ac1c-a6bd58ccd6a5",
                                "text": "Haar drieëntwintigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de tweeëntwintig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea2defbb-a4fc-32bf-aa10-7134583ab517",
                        "entry_id": "e0aa36e4-b6ce-311e-b543-4e0711c4ce97",
                        "glosses": [
                            "groep van 22 eenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce1aa53f-09f0-4b48-a9c5-5ec72c004e98",
                                "sense_id": "ea2defbb-a4fc-32bf-aa10-7134583ab517",
                                "text": "De tweeëntwintig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
                ],
