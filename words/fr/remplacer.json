{
    "word_family": [
        "remplacement",
        "remplaçant",
        "remplaçable",
        "irremplaçable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f7164a1c-e927-3d37-85cf-4560133a96d2",
                    "sense_definition": "Mettre un objet ou un élément à la place d'un autre.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "choses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons <w>remplacer</w> la vieille ampoule de la cuisine parce qu'elle ne fonctionne plus."
                        },
                        {
                            "text": "Le cuisinier a décidé de <w>remplacer</w> le beurre par de l'huile d'olive dans cette recette."
                        }
                    ],
                    "common_phrases": [
                        "remplacer une pièce",
                        "remplacer par du neuf"
                    ]
                },
                {
                    "sense_id": "2a9b24e9-8a2d-3edc-9823-c6636cd9e1aa",
                    "sense_definition": "Prendre provisoirement la place de quelqu'un dans son travail ou ses fonctions.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "personnes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Julie va <w>remplacer</w> son collègue malade pendant toute la semaine prochaine."
                        },
                        {
                            "text": "Le professeur absent est <w>remplacé</w> par un enseignant venu d'une autre école."
                        }
                    ],
                    "common_phrases": [
                        "remplacer un collègue",
                        "se faire remplacer"
                    ]
                },
                {
                    "sense_id": "78959e49-75fe-3664-b1ab-2138da6e0d00",
                    "sense_definition": "Succéder définitivement à une personne dans un poste ou un emploi.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "personnes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après son départ à la retraite, un jeune ingénieur le <w>remplaça</w> à la tête du service."
                        },
                        {
                            "text": "L'entreprise cherche un nouveau responsable pour <w>remplacer</w> la directrice démissionnaire."
                        }
                    ]
                },
                {
                    "sense_id": "2be7d7b2-4258-311f-9e26-a3560afdfad1",
                    "sense_definition": "Tenir lieu de quelque chose d'autre, en faire office.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "equivalence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette simple pomme ne peut pas <w>remplacer</w> un véritable déjeuner après l'effort."
                        },
                        {
                            "text": "Pour beaucoup de gens, la lecture sur écran ne <w>remplace</w> pas le plaisir du papier."
                        }
                    ],
                    "common_phrases": [
                        "rien ne remplace",
                        "remplacer un repas"
                    ]
                },
                {
                    "sense_id": "7d15c151-96fa-34ba-90e9-adfe60eda13f",
                    "sense_definition": "Prendre mutuellement ou successivement la place l'un de l'autre.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "alternance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux sentinelles se <w>remplacent</w> toutes les deux heures pour surveiller la porte d'entrée."
                        },
                        {
                            "text": "Dans ce jeu de société, les joueurs se <w>remplacent</w> à chaque nouveau tour de table."
                        }
                    ],
                    "synonyms": [
                        "intervertir",
                        "permuter"
                    ],
                    "common_phrases": [
                        "se remplacer tour à tour"
                    ]
                }
            ]
        }
    ]
}