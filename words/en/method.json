{
    "word_family": [
        "methodical",
        "methodology",
        "methodize",
        "methodically",
        "methodist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3325da42-8c9d-3624-b7d0-b27e04778933",
                    "sense_definition": "A planned way of doing something, especially one that is systematic, established, or logical.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "process_way",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to find a more effective <w>method</w> for solving this problem.",
                            "target_lang_translations": {
                                "ru": "Нам нужно найти более эффективный <w>метод</w> решения этой проблемы.",
                                "zh": "我们需要找到一种更有效的<w>方法</w>来解决这个问题。"
                            }
                        },
                        {
                            "text": "The scientific <w>method</w> involves observing, hypothesizing, and testing theories.",
                            "target_lang_translations": {
                                "ru": "Научный <w>метод</w> включает в себя наблюдение, выдвижение гипотез и проверку теорий.",
                                "zh": "科学<w>方法</w>包括观察、假设和验证理论。"
                            }
                        },
                        {
                            "text": "She prefers the traditional <w>method</w> of making coffee over using a machine.",
                            "target_lang_translations": {
                                "ru": "Она предпочитает традиционный <w>способ</w> приготовления кофе использованию кофемашины.",
                                "zh": "她比起用机器，更喜欢传统的咖啡制作<w>方式</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "way",
                        "technique",
                        "approach",
                        "procedure",
                        "system",
                        "process",
                        "manner",
                        "strategy"
                    ],
                    "common_phrases": [
                        "scientific method",
                        "teaching method",
                        "payment method",
                        "working method",
                        "method of operation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ действия, методика или процедура, применяемые для достижения цели, особенно систематические или логически обоснованные.",
                        "zh": "一种做事的计划方式，尤指系统化、既定或合乎逻辑的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "метод",
                                "target_lang_sense_clarification": "систематический подход"
                            },
                            {
                                "target_lang_word": "способ",
                                "target_lang_sense_clarification": "образ действия"
                            },
                            {
                                "target_lang_word": "приём",
                                "target_lang_sense_clarification": "отдельное действие или техника"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "方法",
                                "target_lang_sense_clarification": "系统化的途径"
                            },
                            {
                                "target_lang_word": "方式",
                                "target_lang_sense_clarification": "做事的形式"
                            },
                            {
                                "target_lang_word": "手段",
                                "target_lang_sense_clarification": "为达到目的所采取的措施"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "024a0328-f162-31f4-8184-bc211c4120fb",
                    "sense_definition": "A programmed procedure or function that is defined within a class or object in object-oriented programming.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing_function",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should call the update <w>method</w> to refresh the data on the screen.",
                            "target_lang_translations": {
                                "ru": "Вам следует вызвать <w>метод</w> обновления, чтобы обновить данные на экране.",
                                "zh": "你应该调用更新<w>方法</w>来刷新屏幕上的数据。"
                            }
                        },
                        {
                            "text": "This private <w>method</w> calculates the total cost but cannot be accessed from outside the class.",
                            "target_lang_translations": {
                                "ru": "Этот приватный <w>метод</w> рассчитывает общую стоимость, но к нему нельзя обратиться извне класса.",
                                "zh": "这个私有<w>方法</w>用于计算总成本，但无法从类外部访问。"
                            }
                        }
                    ],
                    "synonyms": [
                        "member function"
                    ],
                    "common_phrases": [
                        "static method",
                        "private method",
                        "public method",
                        "class method"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Функция или процедура, принадлежащая классу или объекту в объектно-ориентированном программировании.",
                        "zh": "在面向对象编程中，定义在类或对象内部的程序过程或函数。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "метод",
                                "target_lang_sense_clarification": "в программировании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "方法",
                                "target_lang_sense_clarification": "编程术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bff89ad5-017e-30a3-824b-772774a992dc",
                    "sense_definition": "The quality of being orderly, systematic, and logical in arrangement, thought, or action.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "orderliness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Although his desk looks messy, there is a <w>method</w> to his organization.",
                            "target_lang_translations": {
                                "ru": "Хотя его стол выглядит неопрятно, в его организации есть своя <w>система</w>.",
                                "zh": "虽然他的桌子看起来很乱，但他的整理方式自有其<w>条理</w>。"
                            }
                        },
                        {
                            "text": "She lacks <w>method</w> in her daily work, which often leads to unnecessary mistakes.",
                            "target_lang_translations": {
                                "ru": "Ей не хватает <w>организованности</w> в повседневной работе, что часто приводит к ненужным ошибкам.",
                                "zh": "她日常工作中缺乏<w>条理</w>，这常导致不必要的错误。"
                            }
                        }
                    ],
                    "synonyms": [
                        "order",
                        "orderliness",
                        "system",
                        "organization",
                        "systematicity"
                    ],
                    "antonyms": [
                        "chaos",
                        "disorder",
                        "confusion"
                    ],
                    "common_phrases": [
                        "method in madness",
                        "lack of method"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество, выражающееся в упорядоченности, системности и логичности в мыслях или действиях.",
                        "zh": "在安排、思想或行动中表现出的有序、系统和逻辑性的品质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "система",
                                "target_lang_sense_clarification": "упорядоченность"
                            },
                            {
                                "target_lang_word": "организованность",
                                "target_lang_sense_clarification": "свойство характера или работы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "条理",
                                "target_lang_sense_clarification": "逻辑性和秩序感"
                            },
                            {
                                "target_lang_word": "系统性",
                                "target_lang_sense_clarification": "有条不紊的特质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "521d5658-8c66-365e-9945-4dfe55cbbf32",
                    "sense_definition": "A specific acting technique where the actor attempts to authentically experience the inner emotions and thoughts of the character.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "acting_technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many famous actors use the <w>method</w> to deliver powerful and realistic performances.",
                            "target_lang_translations": {
                                "ru": "Многие известные актёры используют этот <w>метод</w>, чтобы их игра была мощной и реалистичной.",
                                "zh": "许多著名演员使用<w>方法派表演</w>来呈现震撼且逼真的演出。"
                            }
                        },
                        {
                            "text": "The director was known for encouraging his cast to study the <w>method</w> deeply.",
                            "target_lang_translations": {
                                "ru": "Режиссёр был известен тем, что поощрял своих актёров глубоко изучать этот <w>метод</w>.",
                                "zh": "这位导演以鼓励演员深入钻研<w>方法派表演</w>而闻名。"
                            }
                        }
                    ],
                    "synonyms": [
                        "method acting"
                    ],
                    "common_phrases": [
                        "Stanislavski method"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "theater"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Актёрская техника, при которой исполнитель стремится достоверно пережить внутренние эмоции и мысли персонажа.",
                        "zh": "一种表演技巧，演员试图真实地体验角色的内心感受和思想。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "метод",
                                "target_lang_sense_clarification": "актёрская техника"
                            },
                            {
                                "target_lang_word": "система",
                                "target_lang_sense_clarification": "система Станиславского"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "方法派表演",
                                "target_lang_sense_clarification": "戏剧表演流派"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "117ee248-d069-3c64-a737-58bb2498bf94",
                    "sense_definition": "To apply a specific industrial treatment or design process to a casting mold to ensure quality.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineers <w>methoded</w> the new component to prevent defects during the cooling process.",
                            "target_lang_translations": {
                                "ru": "Инженеры <w>разработали технологию</w> для нового компонента, чтобы предотвратить дефекты в процессе охлаждения.",
                                "zh": "工程师们为新组件<w>制定</w>了工艺，以防止冷却过程中出现缺陷。"
                            }
                        },
                        {
                            "text": "Properly <w>methoding</w> the casting is essential for structural integrity.",
                            "target_lang_translations": {
                                "ru": "Правильное <w>проектирование</w> литья имеет важное значение для структурной целостности.",
                                "zh": "正确地<w>设计</w>铸造工艺对于结构完整性至关重要。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "manufacturing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрабатывать технологический процесс или проектировать литейную форму для обеспечения качества изделия.",
                        "zh": "对铸造模具应用特定的工业处理或设计流程以确保质量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрабатывать технологию",
                                "target_lang_sense_clarification": "производственный процесс"
                            },
                            {
                                "target_lang_word": "проектировать",
                                "target_lang_sense_clarification": "техническая обработка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "制定工艺",
                                "target_lang_sense_clarification": "工业制造流程"
                            },
                            {
                                "target_lang_word": "设计",
                                "target_lang_sense_clarification": "技术处理"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}