                                    },
                                    {
                                        "sense_id": "ee8a06c7-05b8-3b27-978c-b8174c0aa387",
                                        "entry_id": "53290039-eadd-3035-820d-ba2ab9199aa3",
                                        "glosses": [
                                            "vlees van de patrijs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7276ccd1-7f50-4983-8e47-debce714f04f",
                                                "sense_id": "ee8a06c7-05b8-3b27-978c-b8174c0aa387",
                                                "text": "De jongens in de keuken hebben het vak nog van de oude Jon Sistermans geleerd en hebben een stevige wildkaart in elkaar geknutseld: patrijs met rauwe zuurkool en walnootmayonaise, gebraden reebout met spruitjes en herfstbock, fazant met bloedworst, eendenlever en kweepeer en op het karkas gebraden hazenrug met schorseneren en chocoladesaus"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c96d907-8345-4cca-9892-1fbc17e13c9c",
                        "source_entry_id": "b078e6f6-5b82-3a73-a026-eb58746994ce",
                        "source_sense_description": "circular window",
                        "target_lang_word": "patrijspoort",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patrijspoort",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5cb03b07-638e-3802-b194-4f08c5b45e6b",
                                        "entry_id": "0ce53a45-2e34-335e-a387-1828fc445d6e",
                                        "glosses": [
                                            "klein rond raam in een scheepswand dat waterdicht kan worden afgesloten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c05b7e4f-0a25-490f-a7f8-23f3bb613d36",
                                                "sense_id": "5cb03b07-638e-3802-b194-4f08c5b45e6b",
                                                "text": "In de vertrekhal vreesde ik de sfeer van een pannenkoekenboot, met liedjes en wafels onderweg. Tot ik de Viking Grace zag. Nog nooit had ik zo’n groot schip gezien, twaalf dekken, 218 meter lang! Mijn kajuit had niet het piepgaatje van een patrijspoort, maar een groot raam om in stijl uit te kijken naar Åland, mijn koninkrijk."
                                            },
                                            {
                                                "example_id": "c4013603-672e-4d44-a127-1b39ea766641",
                                                "sense_id": "5cb03b07-638e-3802-b194-4f08c5b45e6b",
                                                "text": "Nachts wakker geworden met een droge mond nam hij een slok water, gooide het glas walgend uit de patrijspoort, waarna het in het ochtendlicht duidelijk werd dat het het kunstgebit van zijn kajuitgenoot bevat had, een politicus die in Indië toespraken moest houden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51687baf-4b25-4dcf-98a8-bc84d7412bad",
                        "source_entry_id": "b078e6f6-5b82-3a73-a026-eb58746994ce",
                        "source_sense_description": "circular window",
                        "target_lang_word": "hublot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hublot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c7cde351-7bc8-3af3-bb4f-539229840702",
                                        "entry_id": "bbf23da5-25a9-3a4c-873a-95fb9e1f79b7",
                                        "glosses": [
                                            "Petit sabord, petite ouverture, généralement ronde, percée dans la muraille d’un vaisseau, pour donner du jour et de l’air, pour laisser passer les câbles, la barre du gouvernail, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17e1af76-d46b-42ea-b25a-3b3337788d40",
                                                "sense_id": "c7cde351-7bc8-3af3-bb4f-539229840702",
                                                "text": "Le bruit mélancolique du vaisseau gémissant, l’éclat des vagues qui venaient se briser en jaillissant contre le hublot."
                                            },
                                            {
                                                "example_id": "8cb87c9c-777a-4c43-ba72-70d534d3b0fe",
                                                "sense_id": "c7cde351-7bc8-3af3-bb4f-539229840702",
                                                "text": "Quelquefois, par les hublots, on voyait glisser le flanc d’une barque qui accostait le navire pour prendre ou déposer des voyageurs."
                                            },
                                            {
                                                "example_id": "75f8f4b4-b3df-4751-8693-1a9ad9a36cff",
                                                "sense_id": "c7cde351-7bc8-3af3-bb4f-539229840702",
                                                "text": "Elle était demeurée longtemps debout devant ces hautes coques dont les hublots laissaient voir l'intérieur des cabines éclairées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "770e1d49-71a6-30a5-af35-25b208107115",
                                        "entry_id": "bbf23da5-25a9-3a4c-873a-95fb9e1f79b7",
                                        "glosses": [
                                            "Ouverture vitrée dans les parois de la carlingue d’un avion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cd3b07b-fd7c-432b-a172-4a2cb97337f7",
                                                "sense_id": "770e1d49-71a6-30a5-af35-25b208107115",
                                                "text": "À six heures du matin, on atterrissait à l'aérodrome du Caire, après que chacun se fut penché vers les hublots pour regarder les Pyramides."
                                            },
                                            {
                                                "example_id": "cc43ef2c-a7ae-47d8-841b-363800c1fc1f",
                                                "sense_id": "770e1d49-71a6-30a5-af35-25b208107115",
                                                "text": "La fenêtre, au bout du hall, m’aspira comme l’eût fait le hublot brisé d’un avion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26e6ee1d-cfe5-3aea-95e9-fe9cfc179c80",
                                        "entry_id": "bbf23da5-25a9-3a4c-873a-95fb9e1f79b7",
                                        "glosses": [
                                            "Fenêtre ronde."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af9de645-3c0c-47fd-b4b5-5abb93660b16",
                                                "sense_id": "26e6ee1d-cfe5-3aea-95e9-fe9cfc179c80",
                                                "text": "Il me désigna sur la droite un immeuble de couleur sable avec des fenêtres-hublots et de grands balcons en demi-cercle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1d1d568-8828-3336-83bf-e9346ffe6d58",
                                        "entry_id": "bbf23da5-25a9-3a4c-873a-95fb9e1f79b7",
                                        "glosses": [
                                            "Partie vitrée d’un appareil qui permet de regarder à l’intérieur de l’appareil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f76dd68d-518f-43e3-b8b4-e7f3c371d102",
                                                "sense_id": "e1d1d568-8828-3336-83bf-e9346ffe6d58",
                                                "text": "Portes du four avec hublot d’observation, température de surface de la charge mesurée par un pyromètre.",
                                                "translation": "Four Chambre Haute température, Ceradel Industries, 2021"
                                            },
                                            {
                                                "example_id": "adcd7e5a-b0e6-44a6-8e2a-faf2245746e3",
                                                "sense_id": "e1d1d568-8828-3336-83bf-e9346ffe6d58",
                                                "text": "À chargement par devant, les lave-linge hublot, aussi appelés frontaux, sont désormais les plus vendus sur le marché français."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebfd127d-56a5-4560-8881-3c41b51e63e0",
