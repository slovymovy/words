                    "sense_definition": "wydać oficjalne rozstrzygnięcie, uchwałę lub zarządzenie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prawo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sąd <w>postanowił</w> odroczyć rozprawę do następnego miesiąca.",
