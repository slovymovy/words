                        "examples": [
                            {
                                "example_id": "89a69361-a1d8-4767-ba34-d8ec675fdbc1",
                                "sense_id": "4a17f921-12c3-3a78-bdb1-315790eaf8cb",
                                "text": "RICHARD III (DUKE OF GLOUCESTER): Stifle the villain whose unstanched thirst York and young Rutland could not satisfy."
                            },
                            {
                                "example_id": "ff8489a9-71ea-43d0-8577-ab1da5fd73a0",
                                "sense_id": "4a17f921-12c3-3a78-bdb1-315790eaf8cb",
                                "text": "GONZALO: I'll warrant him for drowning, though the ship were no stronger than a nutshell and as leaky as an unstanched wench."
                            },
                            {
                                "example_id": "9ee7d8ce-f974-488f-a8f7-d70aae72bf51",
                                "sense_id": "4a17f921-12c3-3a78-bdb1-315790eaf8cb",
                                "text": "Covered with dust and blood — the thick gore slowly dropping from his unstanched wounds, his head swollen, his right eye closed — the poor brute presented a deplorable spectacle."
                            }
                        ]
                    }
