{
    "word_family": [
        "reik",
        "reiking",
        "reikwijdte"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "210b4b9a-0dd7-3b67-90e0-b65a7ad4e149",
                    "sense_definition": "Iets aan iemand geven door het in de richting van die persoon te houden of uit te steken.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "geven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ober <w>reikte</w> de menukaart aan de gasten <w>aan</w>.",
                            "target_lang_translations": {
                                "it": "Il cameriere ha <w>porso</w> il menù agli ospiti."
                            }
                        },
                        {
                            "text": "Zou je mij het zout even kunnen <w>aanreiken</w>?",
                            "target_lang_translations": {
                                "it": "Potresti <w>passarmi</w> il sale?"
                            }
                        }
                    ],
                    "synonyms": [
                        "overhandigen",
                        "geven",
                        "aanreiken"
                    ],
                    "common_phrases": [
                        "iets aanreiken"
                    ],
                    "target_lang_definitions": {
                        "it": "Dare qualcosa a qualcuno tenendolo verso di lui o porgendolo."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "porgere",
                                "target_lang_sense_clarification": "Offrire o dare qualcosa a qualcuno tendendo la mano."
                            },
                            {
                                "target_lang_word": "passare",
                                "target_lang_sense_clarification": "Dare un oggetto a qualcuno che si trova vicino."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a48d389-34e4-38b2-b4c2-8c85245fa775",
                    "sense_definition": "Iets aan iemand geven waarbij men zich moet uitrekken of over iets heen moet buigen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij moest ver over de balie buigen om het formulier aan het kind <w>aan</w> te <w>reiken</w>.",
                            "target_lang_translations": {
                                "it": "Ha dovuto sporgersi molto oltre il bancone per <w>allungare</w> il modulo al bambino."
                            }
                        },
                        {
                            "text": "Ze <w>reikte</w> hem het zakdoekje <w>aan</w> terwijl ze haar tranen wegveegde.",
                            "target_lang_translations": {
                                "it": "Gli ha <w>teso</w> il fazzoletto mentre si asciugava le lacrime."
                            }
                        }
                    ],
                    "synonyms": [
                        "overreiken"
                    ],
                    "common_phrases": [
                        "over de balie aanreiken"
                    ],
                    "target_lang_definitions": {
                        "it": "Dare qualcosa a qualcuno allungandosi o sporgendosi verso di lui."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "tendere",
                                "target_lang_sense_clarification": "Allungare la mano o il braccio per dare qualcosa."
                            },
                            {
                                "target_lang_word": "allungare",
                                "target_lang_sense_clarification": "Sporgersi per consegnare un oggetto a qualcuno."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}