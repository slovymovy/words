                ],
                "senses": [
                    {
                        "sense_id": "5fab1463-1433-3ec7-b3af-28fca1fc0f2a",
                        "entry_id": "f9795f6d-6cdd-3a50-b4bc-c0d2ea12bc0b",
                        "glosses": [
                            "Bootstyp, dessen Rumpf aus einem ausgehöhlten Baumstamm besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef4c8e24-57d5-46e5-adf6-b0d665b4c393",
                                "sense_id": "5fab1463-1433-3ec7-b3af-28fca1fc0f2a",
                                "text": "„Die Vermutung liegt nahe, dass der Einbaum zu den ersten Booten gehört, die der Mensch gebaut hat.“"
                            },
                            {
                                "example_id": "cc610389-bd9d-4d79-bb96-f8fa3f592dbe",
                                "sense_id": "5fab1463-1433-3ec7-b3af-28fca1fc0f2a",
                                "text": "„Der Einbaum liegt ganz leicht oben auf dem Wasser wie eine Ente, aber er hat einen Ausleger und kentert nicht leicht, wenn man stillsitzt.“"
                            },
                            {
                                "example_id": "d66f8432-cd15-4e28-82a8-554c77142489",
                                "sense_id": "5fab1463-1433-3ec7-b3af-28fca1fc0f2a",
                                "text": "„Handelswaren wurden in großen Einbäumen von den Schiffen an Land gebracht: Die Eingeborenen verstanden es, ihre Boote geschickt durch die heimtückische Brandung zu steuern.“"
                            },
                            {
                                "example_id": "3c3e9019-11a8-4202-b92a-ca52e050ddff",
                                "sense_id": "5fab1463-1433-3ec7-b3af-28fca1fc0f2a",
                                "text": "„Afrikaner stakten ursprünglich in wackeligen Einbäumen an Mangrovenküsten umher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9dcf19e7-8a8a-48a6-9956-d4f1b7d4760a",
                        "source_entry_id": "f9795f6d-6cdd-3a50-b4bc-c0d2ea12bc0b",
                        "source_sense_id": "5fab1463-1433-3ec7-b3af-28fca1fc0f2a",
                        "source_sense_description": "Bootstyp, dessen Rumpf aus einem ausgehöhlten Baumstamm besteht",
                        "target_lang_word": "dugout",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dugout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50c3c052-42e0-3d7b-a747-3923e09e2d15",
                                        "entry_id": "f6d3ca2d-09ea-36c0-87a8-4c35dd37c457",
                                        "glosses": [
                                            "A canoe made from a hollowed-out log."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13f404b8-da38-4039-b489-3d9edbd815ae",
                                                "sense_id": "50c3c052-42e0-3d7b-a747-3923e09e2d15",
                                                "text": "The other explained that it had come with a fleet of canoes in charge of an English half-caste clerk Kurtz had with him; that Kurtz had apparently intended to return himself, the station being by that time bare of goods and stores, but after coming three hundred miles, had suddenly decided to go back, which he started to do alone in a small dug-out with four paddlers, leaving the half-caste to continue down the river with the ivory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41ccef88-7588-314c-9a37-e938e17ed892",
                                        "entry_id": "f6d3ca2d-09ea-36c0-87a8-4c35dd37c457",
                                        "glosses": [
                                            "A pit dug into the ground as a shelter, especially from enemy fire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "253e1b47-ffe1-4900-88b7-a961c4b8c07d",
                                                "sense_id": "41ccef88-7588-314c-9a37-e938e17ed892",
                                                "text": "The key unit of life here is the dugout – what the soldiers call a ‘blindage’ – an underground burrow where half a dozen men share the narrow space between the bunks with weapons, ammunition, biscuits, tea bags, and a jumble of other essentials (there is also usually a cat, not to mention the mice)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad599fc0-21c0-30f3-ba3a-8b2218f53375",
                                        "entry_id": "f6d3ca2d-09ea-36c0-87a8-4c35dd37c457",
                                        "glosses": [
                                            "A sunken shelter at the side of a sports field where non-playing team members and staff sit during a game."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33301195-38cf-4cd2-8538-abb9e9828c0e",
                                                "sense_id": "ad599fc0-21c0-30f3-ba3a-8b2218f53375",
                                                "text": "Spurs, who were without boss Harry Redknapp after his heart surgery, failed to create a clear-cut chance. Redknapp is expected to be back in the dugout when Spurs play Fulham at Craven Cottage on Sunday but it was left to his assistant Kevin Bond to take a young team to Russia looking for the win that would put them through to the last 32."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14e97424-52e9-3436-954a-8b9cc6200282",
                                        "entry_id": "f6d3ca2d-09ea-36c0-87a8-4c35dd37c457",
                                        "glosses": [
                                            "A small portable case for equipment used to smoke marijuana."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28afd8e1-bb29-3e8c-9907-9ac55d7e4440",
                                        "entry_id": "f6d3ca2d-09ea-36c0-87a8-4c35dd37c457",
                                        "glosses": [
                                            "A pit used to catch and store rainwater or runoff."
                                        ],
                                        "tags": [
                                            "Canadian-Prairies"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
