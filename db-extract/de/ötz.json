                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1e44bcc-bd17-4c5c-841a-88644ea688f9",
                                "sense_id": "20ba2986-c65e-32b8-b8e8-7badab3a3eaf",
                                "text": "„Am Sonntagnachmittag nahm ich ein Kanderl, ging hinauf zur ‚Kälberhalt‘, einer Ötz am obersten Ende des Hatzengutes, wo im Sommer immer die Kälber weideten.“"
                            },
                            {
                                "example_id": "384c0eb6-b751-473e-8c29-7ed936aa22a2",
                                "sense_id": "20ba2986-c65e-32b8-b8e8-7badab3a3eaf",
                                "text": "„Im Sommer durfte ich mit Großmutter in die Ötz gehen, um mit einer Sichel das Farnkraut abzumähen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
