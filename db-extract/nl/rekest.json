                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e17ba14-2859-4cbf-98dd-2504f1b365a5",
                                                "sense_id": "b48548a2-9aa1-327f-9056-032e44c6ea14",
                                                "text": "„Militärdienstpflichtige, die keinen Militärdienst leisten wollen, können jederzeit ein Gesuch für Zulassung zum Zivilen Ersatzdienst stellen, Stellungspflichtige nach dem Besuch der Orientierungsveranstaltung der Militärbehörde.“"
                                            },
                                            {
                                                "example_id": "d87ea8c1-6a73-47d7-9e44-8689becbb80a",
                                                "sense_id": "b48548a2-9aa1-327f-9056-032e44c6ea14",
                                                "text": "„Die Bürgerschaft hatte nach langen Gesuchen und mit hohen Gebühren vom Burgherrn die Erlaubnis bekommen, ihre Schafe auf den Wiesen außerhalb der Mauer weiden zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
