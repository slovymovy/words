                                    {
                                        "sense_id": "41128a2c-2b91-30c9-9044-5bc6a734383e",
                                        "entry_id": "65298957-730d-3cd7-a200-b2cdf0fbe870",
                                        "glosses": [
                                            "Rock or other material that contains valuable or utilitarian materials; primarily a rock containing metals or gems for which it is typically mined and processed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "189e6420-4a60-46f9-b4e4-0009cdd1a695",
                                                "sense_id": "41128a2c-2b91-30c9-9044-5bc6a734383e",
                                                "text": "Manganism has been known about since the 19th century, when miners exposed to ores containing manganese, a silvery metal, began to totter, slur their speech and behave like someone inebriated."
                                            },
                                            {
                                                "example_id": "89b9dd9b-22b0-4b0d-8656-eeaf3ff14593",
                                                "sense_id": "41128a2c-2b91-30c9-9044-5bc6a734383e",
                                                "text": "Stepnohirsk grew into a town from the village of Sukhoivanivka in the 1980s after vast deposits of manganese ore nearby were discovered."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac98037c-cf01-3262-9433-369544041bff",
                                        "entry_id": "1d0add1e-c933-3b71-9df1-07cdfdcdd94b",
                                        "glosses": [
                                            "A unit of currency used in England around the 10th to 12th centuries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cecd2fb-f127-4b28-b6f0-48796abfba2b",
                                                "sense_id": "ac98037c-cf01-3262-9433-369544041bff",
                                                "text": "In the time of Æthelred the Unready when the pound contained 240 pence, the ore was reckoned at 16 pence, but in earlier times there was probably much variation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
