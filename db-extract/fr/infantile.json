                                                "example_id": "bbb2b477-61f4-4687-8b27-7d7ddd102496",
                                                "sense_id": "933c2da5-dad2-358a-bbc5-c3e347435abb",
                                                "text": "Diese Phase gehört zum kindlichen Entwicklungsprozess."
                                            },
                                            {
                                                "example_id": "4287ea20-49fd-4a44-9e8f-76ec7e6d9de4",
                                                "sense_id": "933c2da5-dad2-358a-bbc5-c3e347435abb",
                                                "text": "Sie hat ein ausgesprochen kindliches Gesicht."
                                            },
                                            {
                                                "example_id": "d5f1ec8e-a391-42e4-8f6b-9da9040cde28",
                                                "sense_id": "933c2da5-dad2-358a-bbc5-c3e347435abb",
                                                "text": "In einer ruhigen Ecke steht eine kindlich aussehende Frau."
                                            },
                                            {
                                                "example_id": "020b5cf7-7808-4eff-8d1a-3a8bfe979312",
                                                "sense_id": "933c2da5-dad2-358a-bbc5-c3e347435abb",
                                                "text": "Ihre Lieder sind etwas zu kindlich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
