                                                "sense_id": "b95ab4fa-de8b-3a82-8168-245c64104f0f",
                                                "text": "Sardinien liegt südlich von Korsika."
                                            },
                                            {
                                                "example_id": "f71591d9-0b9b-434c-9543-cae9777d137a",
                                                "sense_id": "b95ab4fa-de8b-3a82-8168-245c64104f0f",
                                                "text": "Das Sardinien des 19. Jahrhunderts bereitete mir schlaflose Nächte."
                                            },
                                            {
                                                "example_id": "7f247358-9d4e-4163-b281-e3864b4ba713",
                                                "sense_id": "b95ab4fa-de8b-3a82-8168-245c64104f0f",
                                                "text": "Unseren letzten Urlaub verbrachten wir auf Sardinien."
                                            },
                                            {
                                                "example_id": "2818e22b-de8a-401c-9201-db7a2128536a",
                                                "sense_id": "b95ab4fa-de8b-3a82-8168-245c64104f0f",
                                                "text": "Das Lagerfeuer auf Sardinien erlosch erst am frühen Morgen."
                                            }
                                        ],
