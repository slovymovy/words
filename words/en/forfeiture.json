{
    "word_family": [
        "forfeit",
        "forfeiter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "97ae1d79-891f-3a55-b0de-71f3e4c001a7",
                    "sense_definition": "The loss or giving up of property, rights, or privileges as a penalty for a wrongdoing or breach of contract.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "loss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Failing to pay the fine within thirty days will result in the <w>forfeiture</w> of your deposit."
                        },
                        {
                            "text": "The contract warned that breach of confidentiality risked immediate <w>forfeiture</w> of stock options."
                        }
                    ],
                    "synonyms": [
                        "confiscation",
                        "loss",
                        "relinquishment"
                    ],
                    "antonyms": [
                        "recovery",
                        "retention"
                    ],
                    "common_phrases": [
                        "result in the forfeiture of",
                        "risk of forfeiture"
                    ]
                },
                {
                    "sense_id": "970cbdcb-70ea-394e-abfc-01c33c52abbd",
                    "sense_definition": "A formal legal proceeding or order by which a person loses rights or interest in property.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court ordered the asset <w>forfeiture</w> after the defendant was convicted of fraud."
                        },
                        {
                            "text": "Civil <w>forfeiture</w> laws allow authorities to seize property suspected of being tied to illegal activity."
                        }
                    ],
                    "synonyms": [
                        "seizure",
                        "impoundment",
                        "expropriation"
                    ],
                    "antonyms": [
                        "restitution"
                    ],
                    "common_phrases": [
                        "asset forfeiture",
                        "civil forfeiture"
                    ]
                },
                {
                    "sense_id": "394cbe11-f4bb-3c9a-ba9c-46eecccd3205",
                    "sense_definition": "Any loss or sacrifice caused by one's own actions, errors, or failure to act.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "loss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His decision to ignore company policy led to the <w>forfeiture</w> of his peers' respect."
                        },
                        {
                            "text": "The government argued that the company's delay amounted to a complete <w>forfeiture</w> of its claim."
                        }
                    ],
                    "synonyms": [
                        "surrender",
                        "deprivation"
                    ],
                    "common_phrases": [
                        "forfeiture of rights",
                        "forfeiture of claim"
                    ]
                },
                {
                    "sense_id": "2531df10-4e06-3afd-81a2-c519095382b3",
                    "sense_definition": "Something that is lost, surrendered, or handed over as a penalty.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The seized vehicle served as a <w>forfeiture</w> to cover the unpaid damages."
                        },
                        {
                            "text": "They demanded a heavy financial <w>forfeiture</w> before allowing the vessel to leave port."
                        }
                    ],
                    "synonyms": [
                        "penalty",
                        "fine",
                        "forfeit"
                    ]
                }
            ]
        }
    ]
}