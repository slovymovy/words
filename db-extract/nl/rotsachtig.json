                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rocky",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b684fa6f-8404-3fb6-b7bd-bf0559443693",
                                        "entry_id": "8f8a0742-9330-354a-b9f9-18f0176787e0",
                                        "glosses": [
                                            "Abounding in, or full of, rocks; consisting of rocks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adb933ec-e80e-42c5-96bd-a4e1251c16c5",
                                                "sense_id": "b684fa6f-8404-3fb6-b7bd-bf0559443693",
                                                "text": "a rocky mountain    a rocky shore"
                                            },
                                            {
                                                "example_id": "92069848-20ed-4813-afcd-3f72d21ec98b",
                                                "sense_id": "b684fa6f-8404-3fb6-b7bd-bf0559443693",
                                                "text": "The pihoihoi live in the island's interior, and the torea on its rocky shore."
                                            },
                                            {
                                                "example_id": "a0203b8a-4ad9-4cce-bb7c-11e8ddaeabac",
                                                "sense_id": "b684fa6f-8404-3fb6-b7bd-bf0559443693",
                                                "text": "When faced with a rockier or muddier section, look ahead for the easiest way across. This might involve hopping from one rock to another, or looking for flat sections or patches of vegetation that might be grippier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afb1623e-9667-34dc-b18c-32d167fd3a74",
                                        "entry_id": "8f8a0742-9330-354a-b9f9-18f0176787e0",
                                        "glosses": [
                                            "Like a rock; rigid, solid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be9c0956-a575-42f8-b744-6b3c133a1c68",
                                                "sense_id": "afb1623e-9667-34dc-b18c-32d167fd3a74",
                                                "text": "Marsh went on as his prisoner drank. \"Because you're caught in the middle of my alternate plan, Ram-Jam, which ram-jams your ass between the rockiest rock and the hardest hard place you ever imagined."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a3f2164-105f-3f4d-8e19-b2c526c1cfe0",
                                        "entry_id": "8f8a0742-9330-354a-b9f9-18f0176787e0",
                                        "glosses": [
                                            "Having a habitat around or on rocks."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "745b321e-9bfe-3056-af87-2e66222897b9",
                                        "entry_id": "8f8a0742-9330-354a-b9f9-18f0176787e0",
                                        "glosses": [
                                            "Not easily affected or impressed; stony; hard; obdurate; unfeeling."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df2cc8a9-94e0-469f-b970-a269a31bdaa3",
                                                "sense_id": "745b321e-9bfe-3056-af87-2e66222897b9",
                                                "text": "to have a rocky heart"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rocky",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87c358a1-07c7-3638-8114-814937eabb5e",
                                        "entry_id": "143b4715-11d6-376c-8241-cfaf686efbbb",
                                        "glosses": [
                                            "Easily rocked; unstable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9697e9b-2759-4438-8c87-de585ca83cab",
                                                "sense_id": "87c358a1-07c7-3638-8114-814937eabb5e",
                                                "text": "The table was rocky, so we put a book under one leg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9a8f709-4e3f-34fe-b35c-dd4130db7a80",
                                        "entry_id": "143b4715-11d6-376c-8241-cfaf686efbbb",
                                        "glosses": [
                                            "Encountering many problems; difficult, troubled; also, in danger or distress."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "417e0314-a26d-46d4-a766-7623f3efb3b1",
                                                "sense_id": "b9a8f709-4e3f-34fe-b35c-dd4130db7a80",
                                                "text": "Their relationship had weathered some rocky times, but they loved each other."
                                            }
                                        ]
                                    },
