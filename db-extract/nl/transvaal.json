                                        "entry_id": "01d90df1-aaef-3c8c-9fbe-203714edf7c2",
                                        "glosses": [
                                            "A geographical region and former province (until 1994) of South Africa between the Vaal and Limpopo rivers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2269c9c3-0359-38fa-92f6-8e57110b361d",
                                        "entry_id": "01d90df1-aaef-3c8c-9fbe-203714edf7c2",
                                        "glosses": [
                                            "A former country in Southern Africa; the Transvaal \\\"Boer republic\\\" state from 1852 to the United Kingdom of Great Britain and Ireland's annexation of it in 1902."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7bec2373-daf5-41e6-a725-424eb48fa0b9",
                        "source_entry_id": "19246dda-48df-3bcd-9d74-ab9107583e7d",
                        "target_lang_word": "Transvaal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Transvaal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f1602dd-6232-3a34-9010-d6664a909ede",
                                        "entry_id": "06078c9f-45c6-38c1-b11c-241920a2906c",
                                        "glosses": [
                                            "Région et ancienne province du nord-est de l’Afrique du Sud ayant connu divers statuts politiques au cours de l’histoire."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e8963ff-d754-43f3-953d-1603105fa28c",
                                                "sense_id": "7f1602dd-6232-3a34-9010-d6664a909ede",
                                                "text": "Le 12 avril 1877, le Transvaal en Afrique du Sud, est annexé par le Royaume-Uni."
                                            },
                                            {
                                                "example_id": "1e7f861b-4301-4f26-bd61-a8482fb8ca77",
                                                "sense_id": "7f1602dd-6232-3a34-9010-d6664a909ede",
                                                "text": "Depuis l’annexion du Transvaal par les Britanniques en avril 1877, ces derniers n’avaient eu de cesse de s’inquiéter des risques de rébellion des Boers. Mais une autre menace, qui les préoccupait tout autant, était celle que représentait l’armée zouloue aux portes du Natal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cfd5a8f-802d-3b46-af7a-57a38f12a966",
                                        "entry_id": "06078c9f-45c6-38c1-b11c-241920a2906c",
                                        "glosses": [
                                            "Quartier de la ville de Lyon situé dans le huitième arrondissement, au sud-est de Lyon."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95c06bf0-7eac-447d-bb2c-0bf938ec3f08",
                                                "sense_id": "3cfd5a8f-802d-3b46-af7a-57a38f12a966",
                                                "text": "Desservis par le métro, le secteur Laënnec-Mermoz passe la barre des 4000 euros (4050 euros), comme Transvaal (4724 euros) et Monplaisir donc."
                                            }
                                        ]
                                    }
                                ]
                            }
