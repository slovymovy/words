                        "examples": [
                            {
                                "example_id": "9f7e9eee-de00-4d5e-8f3e-30da0b16e875",
                                "sense_id": "7c94f21c-5419-35a8-a748-543d19ef541b",
                                "text": "Ces moûts très siropeux ne fermentent qu'avec une extrême lenteur, et cette fermentation se prolonge durant plusieurs années."
                            },
                            {
                                "example_id": "a173e1af-2ed9-429a-b00d-80d9a9d8de26",
                                "sense_id": "7c94f21c-5419-35a8-a748-543d19ef541b",
                                "text": "Si, à cette époque, on retire le feu de dessous la cornue, la liqueur prendra en refroidissant une consistance siropeuse ; […]."
