                    "frequency": "High",
                    "semantic_group_id": "empecher_fonctionnement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La banque a décidé de <w>bloquer</w> ma carte bancaire après une tentative suspecte."
                        },
                        {
                            "text": "Tu devrais <w>bloquer</w> ce numéro de téléphone pour ne plus recevoir de messages."
