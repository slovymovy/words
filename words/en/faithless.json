{
    "word_family": [
        "faith",
        "faithful",
        "faithlessly",
        "faithlessness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8a7294f7-0a75-3b4c-b3fa-85c34e09c6d9",
                    "sense_definition": "Unfaithful or disloyal to a romantic partner or spouse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disloyalty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to divorce his <w>faithless</w> partner after discovering the affair.",
                            "target_lang_translations": {
                                "de": "Er beschloss, sich von seiner <w>untreuen</w> Partnerin scheiden zu lassen, nachdem er die Affäre entdeckt hatte."
                            }
                        },
                        {
                            "text": "The classic play tells the dramatic story of a <w>faithless</w> spouse and betrayal.",
                            "target_lang_translations": {
                                "de": "Das klassische Theaterstück erzählt die dramatische Geschichte eines <w>untreuen</w> Ehepartners und von Verrat."
                            }
                        }
                    ],
                    "synonyms": [
                        "disloyal"
                    ],
                    "antonyms": [
                        "faithful"
                    ],
                    "common_phrases": [
                        "faithless spouse",
                        "faithless partner",
                        "faithless lover"
                    ],
                    "target_lang_definitions": {
                        "de": "Untreu oder illoyal gegenüber einem romantischen Partner oder Ehepartner."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "untreu",
                                "target_lang_sense_clarification": "in einer Partnerschaft oder Ehe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e28a83c-f6c1-38c9-aac9-b9c5d6c0d72e",
                    "sense_definition": "Having no religious faith or belief in God.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The preacher warned the congregation against falling into a <w>faithless</w> way of life.",
                            "target_lang_translations": {
                                "de": "Der Prediger warnte die Gemeinde davor, in eine <w>ungläubige</w> Lebensweise zu verfallen."
                            }
                        },
                        {
                            "text": "In ancient times, people often viewed strangers from other lands as <w>faithless</w> outsiders.",
                            "target_lang_translations": {
                                "de": "In der Antike betrachteten die Menschen Fremde aus anderen Ländern oft als <w>glaubenslose</w> Außenseiter."
                            }
                        }
                    ],
                    "antonyms": [
                        "faithful",
                        "religious"
                    ],
                    "common_phrases": [
                        "faithless generation"
                    ],
                    "target_lang_definitions": {
                        "de": "Ohne religiösen Glauben oder Vertrauen in Gott."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "ungläubig",
                                "target_lang_sense_clarification": "ohne religiösen Glauben"
                            },
                            {
                                "target_lang_word": "glaubenslos",
                                "target_lang_sense_clarification": "keiner Religion folgend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bb7a20d-a3d5-3078-ad64-d8e7ae7d6663",
                    "sense_definition": "Not true to allegiance, duty, or vows; treacherous and disloyal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disloyalty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king punished the <w>faithless</w> knight who betrayed the kingdom during the war.",
                            "target_lang_translations": {
                                "de": "Der König bestrafte den <w>treulosen</w> Ritter, der das Königreich während des Krieges verraten hatte."
                            }
                        },
                        {
                            "text": "He proved to be a <w>faithless</w> ally when he secretly sided with our enemies.",
                            "target_lang_translations": {
                                "de": "Er erwies sich als ein <w>illoyaler</w> Verbündeter, als er sich heimlich auf die Seite unserer Feinde schlug."
                            }
                        }
                    ],
                    "synonyms": [
                        "disloyal",
                        "perfidious",
                        "treacherous"
                    ],
                    "antonyms": [
                        "loyal",
                        "faithful"
                    ],
                    "common_phrases": [
                        "faithless ally",
                        "faithless friend"
                    ],
                    "target_lang_definitions": {
                        "de": "Nicht pflicht- oder treu ergeben; verräterisch und illoyal gegenüber einer Pflicht, Treue oder einem Gelübde."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "treulos",
                                "target_lang_sense_clarification": "die Treue oder Loyalität brechend"
                            },
                            {
                                "target_lang_word": "verräterisch",
                                "target_lang_sense_clarification": "hinterhältig oder illoyal"
                            },
                            {
                                "target_lang_word": "illoyal",
                                "target_lang_sense_clarification": "Verpflichtungen oder Verbündeten gegenüber"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "370daf47-c6c7-30c3-a5e8-194e0194df86",
                    "sense_definition": "Not observant of promises, covenants, or obligations.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disloyalty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company proved to be a <w>faithless</w> partner when it broke every agreement.",
                            "target_lang_translations": {
                                "de": "Das Unternehmen erwies sich als <w>wortbrüchiger</w> Partner, als es jede Vereinbarung brach."
                            }
                        },
                        {
                            "text": "Historians described the treaty as ruined by a <w>faithless</w> leader who ignored his word.",
                            "target_lang_translations": {
                                "de": "Historiker beschrieben den Vertrag als ruiniert durch einen <w>wortbrüchigen</w> Anführer, der sein Wort nicht hielt."
                            }
                        }
                    ],
                    "synonyms": [
                        "perfidious",
                        "treacherous"
                    ],
                    "antonyms": [
                        "trustworthy"
                    ],
                    "target_lang_definitions": {
                        "de": "Versprechen, Abkommen oder Verpflichtungen nicht einhaltend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "wortbrüchig",
                                "target_lang_sense_clarification": "ein gegebenes Versprechen brechend"
                            },
                            {
                                "target_lang_word": "vertragsbrüchig",
                                "target_lang_sense_clarification": "eine Vereinbarung nicht einhaltend"
                            },
                            {
                                "target_lang_word": "unzuverlässig",
                                "target_lang_sense_clarification": "nicht an Absprachen gebunden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a15c44f-7d9a-3865-9314-fa22c1ebdfeb",
                    "sense_definition": "Lacking trust, confidence, or belief in something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was entirely <w>faithless</w> about modern medicine and refused all treatment.",
                            "target_lang_translations": {
                                "de": "Er stand der modernen Medizin völlig <w>skeptisch</w> gegenüber und verweigerte jede Behandlung."
                            }
                        },
                        {
                            "text": "Her cynical attitude made her deeply <w>faithless</w> regarding any political promises.",
                            "target_lang_translations": {
                                "de": "Ihre zynische Haltung machte sie zutiefst <w>misstrauisch</w> gegenüber jeglichen politischen Versprechen."
                            }
                        }
                    ],
                    "antonyms": [
                        "trusting"
                    ],
                    "target_lang_definitions": {
                        "de": "Kein Vertrauen oder keine Zuversicht in etwas besitzend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "misstrauisch",
                                "target_lang_sense_clarification": "ohne Vertrauen"
                            },
                            {
                                "target_lang_word": "skeptisch",
                                "target_lang_sense_clarification": "zweifelnd, ohne Zuversicht"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df8327fb-2806-3231-a3a9-709807da3f59",
                    "sense_definition": "Deceptive, unreliable, or serving to disappoint.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They sailed across the <w>faithless</w> sea beneath a sky of sudden storms.",
                            "target_lang_translations": {
                                "de": "Sie segelten über die <w>tückische</w> See unter einem Himmel voller plötzlicher Stürme."
                            }
                        },
                        {
                            "text": "The travelers were misled by the <w>faithless</w> mirage of water in the desert.",
                            "target_lang_translations": {
                                "de": "Die Reisenden wurden durch die <w>trügerische</w> Fata Morgana von Wasser in der Wüste in die Irre geführt."
                            }
                        }
                    ],
                    "synonyms": [
                        "delusive",
                        "unsatisfying",
                        "treacherous"
                    ],
                    "antonyms": [
                        "reliable"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in literary or archaic contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Trügerisch, unberechenbar oder enttäuschend; häufig in literarischem Kontext."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "tückisch",
                                "target_lang_sense_clarification": "unberechenbar und gefährlich"
                            },
                            {
                                "target_lang_word": "trügerisch",
                                "target_lang_sense_clarification": "täuschend, falschen Schein erweckend"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}