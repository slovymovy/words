                        ],
                        "form": "ястыке́"
                    },
                    {
                        "form_id": "52487577-601d-4a74-84d8-a8d79f9d06c1",
                        "entry_id": "f86f7d64-f72e-3f17-95bf-e81368d0eebf",
                        "tags": [
                            "plural",
