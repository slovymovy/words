                                        "entry_id": "a0ce844a-c67c-31b6-9998-804706ebc70f",
                                        "glosses": [
                                            "The act or process of sissifying."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "907323de-191d-4d08-9233-b06912ee4d72",
                                                "sense_id": "ebb83fdc-b505-3de2-9da9-4b9639bc0d48",
                                                "text": "The spirit of adventure is supplanted by \"all the comforts of home\". The progressive \"sissyfication\" of the American people is abetted."
                                            },
                                            {
                                                "example_id": "9992a421-228c-4293-92d4-9570076fc480",
                                                "sense_id": "ebb83fdc-b505-3de2-9da9-4b9639bc0d48",
                                                "text": "Indeed, with the internationalization and “Europeanization” of the NHL, many Canadian traditionalists feared the game's violent character might change and that hockey's internationalization might mean its “sissyfication.”"
                                            },
                                            {
                                                "example_id": "52dcca0a-b310-436d-84f6-59deb7df53be",
                                                "sense_id": "ebb83fdc-b505-3de2-9da9-4b9639bc0d48",
                                                "text": "I showed Mickey Mantle, Johnny Unitas, Wilt Chamberlain, Ray Nitschke, Oscar Robertson and Don Meredith, all in one television spot crying for their Maypo and shedding likelike tears, here was the ultimate sissyfication of the American macho sports hero, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "610dc604-2597-3996-a0bc-66e9a395d8b3",
                                        "entry_id": "a0ce844a-c67c-31b6-9998-804706ebc70f",
                                        "glosses": [
                                            "A situation where a submissive is forced to take on a feminine role, that of a sissy."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
