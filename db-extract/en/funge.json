                    {
                        "sense_id": "8f59db5f-0d80-3f19-8cb4-97033217bda0",
                        "entry_id": "25efd9ac-24a3-3c6a-9c81-acea82ca47f7",
                        "glosses": [
                            "To steal an NFT; to copy the image or other data associated with the NFT."
                        ],
                        "tags": [
                            "humorous",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d30c7922-fb05-401f-a9ea-64738843baa9",
                                "sense_id": "8f59db5f-0d80-3f19-8cb4-97033217bda0",
                                "text": "The most expensive NFT to date was sold for $91.8 million. If that doesn’t make you want to throw up, regain your composure, then enlist in the noble crusade to funge tokens until the day you die, then I’m afraid you’re already a willing prisoner to the blockchain and my sworn enemy."
                            },
                            {
                                "example_id": "93434c75-87d3-4da8-bc77-26aa47ea373c",
                                "sense_id": "8f59db5f-0d80-3f19-8cb4-97033217bda0",
                                "text": "Look, here's 15 memes about non-fungible tokens, and I guess technically the memes themselves have been funged because they all come from places on the internet, but really, that's getting into the weeds."
                            },
                            {
                                "example_id": "56062e6b-4673-4665-b0df-b4d4226840ed",
                                "sense_id": "8f59db5f-0d80-3f19-8cb4-97033217bda0",
                                "text": "Python script to Funge NFTs. It scrapes OpenSea for a given list of NFT collections and downloads a certain number of NFTs from each collection or the entire collections."
                            }
                        ]
                    },
                    {
                        "sense_id": "06e9abfe-51de-318b-8f16-fb6ebee26941",
                        "entry_id": "25efd9ac-24a3-3c6a-9c81-acea82ca47f7",
                        "glosses": [
                            "Euphemistic form of fuck."
                        ],
                        "tags": [
                            "euphemistic",
                            "form-of",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "bee4465d-a44f-4192-9072-6f2479e8f1f1",
                                "sense_id": "06e9abfe-51de-318b-8f16-fb6ebee26941",
                                "text": "GET FUNGED"
                            },
                            {
                                "example_id": "3fcc1104-7fcb-48c5-a9d1-c8f7e72310e0",
                                "sense_id": "06e9abfe-51de-318b-8f16-fb6ebee26941",
                                "text": "Luckily, MSNBC reported in May that NFTs are in low demand and high supply, which means the entire non-fungible market is non-fungibly funged up."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd55fe9d-716e-3c6b-90c3-f558d08e3c31",
                        "entry_id": "25efd9ac-24a3-3c6a-9c81-acea82ca47f7",
                        "glosses": [
                            "A meaningless nonce word used to make fun of NFTs."
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "a61306e5-d290-46f0-a417-06f42d559a33",
                                "sense_id": "bd55fe9d-716e-3c6b-90c3-f558d08e3c31",
                                "text": "Why is it non-fungible? Why don’t I want it to be funged?"
                            },
                            {
                                "example_id": "b59d4214-1d4b-4307-94ea-f0b2cca4bf3f",
                                "sense_id": "bd55fe9d-716e-3c6b-90c3-f558d08e3c31",
                                "text": "True Love Will Funge You in the End"
                            }
                        ]
                    }
