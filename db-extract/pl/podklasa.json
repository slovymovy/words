                    },
                    {
                        "translation_id": "9cd70405-c7b0-410a-9e99-c3647fd5b7de",
                        "source_entry_id": "38805919-5d16-390a-a1c7-9664211d8fb9",
                        "source_sense_id": "40b85337-b158-3aeb-905a-b5a54f7a9100",
                        "target_lang_word": "Unterklasse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterklasse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e14860d-faf7-35df-bd00-e31e84d050a9",
                                        "entry_id": "644ea5ed-08d6-3a56-a104-bcd4b3259036",
                                        "glosses": [
                                            "eine hierarchische Stufe der Biologie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ec0cad3-1391-4cf4-adcc-e9feee3cb2d0",
                                                "sense_id": "3e14860d-faf7-35df-bd00-e31e84d050a9",
                                                "text": "Es ist nicht immer gut, Unterklassen durch Vererbung zu erzeugen, da man lieber von Schnittstellen ableiten sollte, damit keine größeren Abhängigkeiten zwischen interagierenden Klassen entstehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7628d282-684e-3fe7-98ca-d3e24b6b63ea",
                                        "entry_id": "644ea5ed-08d6-3a56-a104-bcd4b3259036",
                                        "glosses": [
                                            "spezielle Klasse in der objektorientierten Programmierung"
                                        ],
                                        "tags": [
                                            "objektorientierte Programmierung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2bd2f59-d740-4f09-b71b-fb5ec7e0e486",
                                                "sense_id": "7628d282-684e-3fe7-98ca-d3e24b6b63ea",
                                                "text": "Das wird auch von der formalen Sprache sichergestellt, indem zunächst sämtliche Operationen der Oberklasse automatisch von der Unterklasse übernommen werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a166ce57-46c7-34b6-8cd2-5258633415ec",
                                        "entry_id": "644ea5ed-08d6-3a56-a104-bcd4b3259036",
                                        "glosses": [
                                            "soziale Gruppe"
                                        ],
                                        "tags": [
                                            "Soziologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb883dcd-7c98-422a-81be-cb4d8018f6b9",
                                                "sense_id": "a166ce57-46c7-34b6-8cd2-5258633415ec",
                                                "text": "„Dabei beruft sie sich auf den ehemaligen US-Präsidenten Theodore Roosevelt, der Amerika nicht als \"polyglottes Hotel\" sehen wollte. Die Englischpflicht löse einen Assimilationsdruck aus, und der vermeide Gettos der Unterklasse, lautet das Argument von \"ProEnglish\". Die Gegner wenden ein, dass die USA immer ein vielsprachiges Land gewesen sei. Sprachgesetze wären früher oft genutzt worden, um Immigranten aus Italien oder Osteuropa von Behördenjobs fernzuhalten.“"
                                            },
                                            {
                                                "example_id": "7ff09d45-dd4d-42fd-8378-521442e5ed5c",
                                                "sense_id": "a166ce57-46c7-34b6-8cd2-5258633415ec",
                                                "text": "„Die Gefahr ist, dass eine permanente Unterklasse entsteht, wenn es die Mehrheit der Migranten in mehreren Generationen nicht schafft, sich über den Faktor 'Bildung' zu integrieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "322921b7-ee0d-393f-b484-faccac2a0dbf",
                                        "entry_id": "644ea5ed-08d6-3a56-a104-bcd4b3259036",
                                        "glosses": [
                                            "Unterteilung für explosive Stoffe"
                                        ],
                                        "tags": [
                                            "Transportwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb050ded-920e-4388-8e69-c27fe0807466",
                                                "sense_id": "322921b7-ee0d-393f-b484-faccac2a0dbf",
                                                "text": "Die Gefahrgut Kennzeichnungen der Unterklasse 1.1 kennzeichnen feste oder flüssige Stoffe oder Stoffgemische, die massenexplosionsfähig sind."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
