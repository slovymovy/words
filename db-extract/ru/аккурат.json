                                        "examples": [
                                            {
                                                "example_id": "f971e597-a2cc-4203-b07c-7c571055cd29",
                                                "sense_id": "5ecd47fd-68f1-313b-a51d-8ecc3f41d123",
                                                "text": "Comme toutes les réformes monétaires, la stabilisation de la monnaie allemande a provoqué une crise économique, ou plus exactement, elle n'a pas suffi à en préserver le Reich."
                                            },
                                            {
                                                "example_id": "0344f036-230e-40be-a83b-4145a656978f",
                                                "sense_id": "5ecd47fd-68f1-313b-a51d-8ecc3f41d123",
                                                "text": "Par contre nous nous sommes attaché à représenter l’orographie et l’hydrographie de la région aussi exactement qu'il nous a été possible de le faire."
                                            },
                                            {
                                                "example_id": "5c190caa-5cc0-45cb-839a-c49f7835f7a6",
                                                "sense_id": "5ecd47fd-68f1-313b-a51d-8ecc3f41d123",
                                                "text": "Elle ne sait pas exactement ce qu’elle veut, mais elle sait très bien ce qu’elle refuse : retourner à Aix et devenir la parfaite épouse d’un pinardier."
                                            },
                                            {
                                                "example_id": "d19daa0a-0d3f-4630-824f-9944d355baf9",
                                                "sense_id": "5ecd47fd-68f1-313b-a51d-8ecc3f41d123",
                                                "text": "Pour moi, monseigneur, qui vous connais jusque dans l’âme, et qui sais combien exactement vous vous acquittez de tous les devoirs de toutes sortes d’amitiés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd4fd596-980a-4cf9-b35b-fc0886796248",
                        "source_entry_id": "8b63000d-9b9d-3c5c-b268-ee34cd2633ac",
                        "source_sense_id": "aabc35c1-6463-3abb-ad2e-7da41178e32c",
                        "target_lang_word": "ponctuellement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ponctuellement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68b94b2a-8255-33ee-b8c2-d8943ca5f2c2",
                                        "entry_id": "f47c3392-c7a6-3fce-8917-d03026a99d68",
                                        "glosses": [
                                            "Avec ponctualité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "619504ee-6bdc-4852-a651-44c44aacbc43",
                                                "sense_id": "68b94b2a-8255-33ee-b8c2-d8943ca5f2c2",
                                                "text": "Il y aurait assez de compliment dans la lettre que j'ai reçue pour m’ôter à jamais la parole, et me faire fuir jusqu'aux Indes, s’il m’y fallait répondre ponctuellement,"
                                            },
                                            {
                                                "example_id": "3d1f8bc0-327a-4312-9da7-27b6442dafe1",
                                                "sense_id": "68b94b2a-8255-33ee-b8c2-d8943ca5f2c2",
                                                "text": "Je ne savais que trop que Pythias reviendrait ponctuellement, et qu’il craindrait bien plus de manquer à sa parole que de perdre la vie."
                                            },
                                            {
                                                "example_id": "87eb3cd2-790a-42ff-b65f-d48f84cf6b4d",
                                                "sense_id": "68b94b2a-8255-33ee-b8c2-d8943ca5f2c2",
                                                "text": "Adieu le temps où les fêtes duraient ponctuellement sept jours après le mariage!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49d7285d-1e13-33bd-96df-7a3b7bbd8ddc",
                                        "entry_id": "f47c3392-c7a6-3fce-8917-d03026a99d68",
                                        "glosses": [
                                            "D'une manière peu fréquente, ponctuelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1321929c-fb72-4a4c-8d99-2de75803b655",
                                                "sense_id": "49d7285d-1e13-33bd-96df-7a3b7bbd8ddc",
                                                "text": "Le revêtement en place, souvent recouvert de gravillons, n'est pas conçu pour être normalement circulable, mais seulement ponctuellement emprunté dans le cadre d'interventions de maintenance."
                                            },
                                            {
                                                "example_id": "cbc0d4ad-b025-4499-bf19-604cb2331272",
                                                "sense_id": "49d7285d-1e13-33bd-96df-7a3b7bbd8ddc",
                                                "text": "Le chargement des grumiers est le plus souvent effectué au moyen d'un chargeur frontal, mais il peut également être effectué ponctuellement au moyen d'un tracteur à chenille équipé d'une pelle […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
