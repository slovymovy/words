                                ]
                            },
                            {
                                "target_word": "agglomerate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a4f696d-beeb-3f7c-8f9c-3bc979dc92af",
                                        "entry_id": "56785715-2fc1-33c5-b292-eaace194d268",
                                        "glosses": [
                                            "To wind or collect into a ball; hence, to gather into a mass or anything like a mass."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8261baba-4aa6-4b10-bbb7-8f89e72e6aca",
                                                "sense_id": "1a4f696d-beeb-3f7c-8f9c-3bc979dc92af",
                                                "text": "The bustle of a croud is not ill-adapted to the pencil: but the management of it requires great artifice. The whole must be massed together, and considered as one body. ¶ I mean not to have the whole body so agglomerated, as to consist of no detached groups: but to have these groups […] appear to belong to one whole, by the artifice of composition, and the effect of light."
                                            },
                                            {
                                                "example_id": "b5737235-c9f5-4e57-8cdd-5738a56c161a",
                                                "sense_id": "1a4f696d-beeb-3f7c-8f9c-3bc979dc92af",
                                                "text": "1820, William Hazlitt, “Explanations—Conversation on the Drama with Coleridge” in Dramatic Essays London: Scott, 1895, p. 197,\nHis [Jean Racine’s] tragedies are not poetry, are not passion, are not imagination: they are a parcel of set speeches, of epigrammatic conceits, of declamatory phrases, without any of the glow, and glancing rapidity, and principle of fusion in the mind of the poet, to agglomerate them into grandeur, or blend them into harmony."
                                            },
                                            {
                                                "example_id": "c3c60909-8458-426f-b7f4-d29427e2ca96",
                                                "sense_id": "1a4f696d-beeb-3f7c-8f9c-3bc979dc92af",
                                                "text": "There were few white friends in the social life of the peasants. The white colony agglomerated in the towns and the peasants were 80 per cent of a population of a million."
                                            },
                                            {
                                                "example_id": "d2f2ba62-b03e-401f-a234-59e4dc453974",
                                                "sense_id": "1a4f696d-beeb-3f7c-8f9c-3bc979dc92af",
                                                "text": "It feels like doing eighty on the freeway / as little towns agglomerate and blur:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8551a9f3-efa8-3859-a242-b3856c508e72",
                                        "entry_id": "56785715-2fc1-33c5-b292-eaace194d268",
                                        "glosses": [
                                            "To extend an urban area by contiguous development, so as to merge the built-up area of one or more central cities or settlements and their suburbs (thus creating an agglomeration)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
