                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b99e1286-2d1f-457e-a873-48662a511419",
                                "sense_id": "374c7331-8ad3-3242-ab83-235d5ac74093",
                                "text": "Wszyscy jednonodzy pracowali na siedząco: kruszyli kamienie na żwir, sortowali odpadki drzewne"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
