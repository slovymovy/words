                "senses": [
                    {
                        "sense_id": "b2c1a96b-dd5c-3a83-9ff4-ab14307b8d96",
                        "entry_id": "52b35339-13d7-3019-914f-24764333d319",
                        "glosses": [
                            "Donner un caractère scriptural à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69eecec5-16d5-4b9c-b655-e995177170b9",
                                "sense_id": "b2c1a96b-dd5c-3a83-9ff4-ab14307b8d96",
                                "text": "Penser que les premiers auditeurs du discours coranique associaient le terme kitâb à un document écrit dont ils auraient pu disposer, c’est « scripturaliser » (c’est-à-dire mettre par écrit) le Coran avant l’heure."
                            },
                            {
                                "example_id": "7af17a8d-42ae-4ace-809c-9f5767ecf8b6",
                                "sense_id": "b2c1a96b-dd5c-3a83-9ff4-ab14307b8d96",
                                "text": "La nouvelle culture islamique ne pouvait scripturaliser le legs du paganisme arabe qu’en se scripturalisant elle-même."
                            }
                        ]
                    }
                ],
