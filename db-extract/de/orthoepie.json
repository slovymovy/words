                "senses": [
                    {
                        "sense_id": "4bc40ffa-52e6-3dca-ad87-c2c75a52dfab",
                        "entry_id": "1237a20d-3043-33ac-a5d7-3e0e4f9dd500",
                        "glosses": [
                            "normgerechte Aussprache, Lautung; korrekte Standardlautung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8a15f4b-8092-4494-91be-47bfea6f9143",
                                "sense_id": "4bc40ffa-52e6-3dca-ad87-c2c75a52dfab",
                                "text": "Mit Orthoepie ist eine genormte Standardlautung (Standardaussprache) gemeint, die frei ist von regionalen Einflüssen."
                            },
                            {
                                "example_id": "da39a7d1-8376-40ea-a6f3-39719d0c9e0a",
                                "sense_id": "4bc40ffa-52e6-3dca-ad87-c2c75a52dfab",
                                "text": "„Die Orthoepie dient nicht nur ästhetischen Zwecken (vgl. Goethes »Regeln für Schauspieler« 1803), sondern vor allem kommunikativen und sprachökonomischen Zwecken.“"
                            },
                            {
                                "example_id": "dfb44b1c-d9d7-4919-a01d-45bdb4b3e9f5",
                                "sense_id": "4bc40ffa-52e6-3dca-ad87-c2c75a52dfab",
                                "text": "„Die Orthographie und die Orthoepie sind zwar strenger kodifiziert als die anderen sprachlichen Ebenen, doch kann auch in diesen Bereichen, zum Beispiel bei der Eindeutschung von Fremdwörtern (…), die zeitliche, mitunter sogar die räumliche Dimension einer Veränderung beobachtet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
