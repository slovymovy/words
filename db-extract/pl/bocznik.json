                "senses": [
                    {
                        "sense_id": "1e429707-0fb3-3957-b285-8086bdc07d59",
                        "entry_id": "fbf7b07c-ecc8-3a35-9c8b-cbab0c9546e1",
                        "glosses": [
                            "rezystor włączony równolegle do głównego obwodu, zmniejszający prąd pobierany przez ten obwód"
                        ],
                        "tags": [],
