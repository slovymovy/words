                    }
                ],
                "senses": [
                    {
                        "sense_id": "89af97f3-e871-3626-a380-eba6f346b473",
                        "entry_id": "a15ce287-c46c-38f1-842a-5dc1c0f5617a",
                        "glosses": [
                            "Hälfte eines Studien- oder Schuljahres"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6f8fc0a-f0e4-409d-b9d1-4ec5bf377363",
                                "sense_id": "89af97f3-e871-3626-a380-eba6f346b473",
                                "text": "Ein Studium an einer Universität dauert etwa 8–10 Semester."
                            },
                            {
                                "example_id": "8ead6317-3d09-4b65-9530-3ccd24887e1e",
                                "sense_id": "89af97f3-e871-3626-a380-eba6f346b473",
                                "text": "„Lilith hat gerade das Semester geschmissen.“"
                            },
                            {
                                "example_id": "3d980a17-5102-423c-b7ce-e6277127400d",
                                "sense_id": "89af97f3-e871-3626-a380-eba6f346b473",
                                "text": "„Mein erstes Semester verging wie im Flug.“"
                            },
                            {
                                "example_id": "b8acd224-b21d-46d8-8b8e-1062256438f1",
                                "sense_id": "89af97f3-e871-3626-a380-eba6f346b473",
                                "text": "„Das Gymnasium für Berufstätige, das Realgymnasium für Berufstätige und das Wirtschaftskundliche Realgymnasium für Berufstätige umfassen acht Semester.“"
                            },
                            {
                                "example_id": "281ca5cf-2256-4639-ad8b-77667419bb1f",
                                "sense_id": "89af97f3-e871-3626-a380-eba6f346b473",
                                "text": "„Nach jedem Semester ist ein Test zur Überprüfung geplant: Reichen die Fortschritte aus, wechseln die Kinder in den Förderkurs in der normalen Klasse, wenn nicht, verbleiben sie in der separaten Klasse – insgesamt bis zu zwei Jahre lang.“"
                            },
                            {
                                "example_id": "e2357948-8e92-4726-aac0-ace249855db8",
                                "sense_id": "89af97f3-e871-3626-a380-eba6f346b473",
                                "text": "„In die normale Klasse einsteigen können Schüler nach jedem Semester, wenn sie einen standardisierten Sprachtest bestehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c277caed-cd67-32e4-a241-7f0173dcea04",
                        "entry_id": "a15ce287-c46c-38f1-842a-5dc1c0f5617a",
                        "glosses": [
                            "jemand, der in einem bestimmten Teil seiner Studienzeit ist"
                        ],
                        "tags": [
                            "Studentensprache"
                        ],
                        "examples": [
                            {
                                "example_id": "970d3c60-6735-4142-b9e8-b6e6d94f2664",
                                "sense_id": "c277caed-cd67-32e4-a241-7f0173dcea04",
                                "text": "Die alten Semester helfen den Neulingen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0b9b8d23-e963-3f1c-aa20-08e402ffecae",
                        "entry_id": "a15ce287-c46c-38f1-842a-5dc1c0f5617a",
                        "glosses": [
                            "Mensch bestimmten Alters"
                        ],
                        "tags": [
                            "colloquial",
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "7ff77dfa-fe37-4886-bd15-5d43dd09dea8",
                                "sense_id": "0b9b8d23-e963-3f1c-aa20-08e402ffecae",
                                "text": "„Als ich den Saal betrete, ist er bereits gut gefüllt. Eigentlich unüblich für die frühe Uhrzeit. Ich stelle fest, dass die meisten der Anwesenden ältere Semester sind: Gasthörer über 50 Jahre.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
