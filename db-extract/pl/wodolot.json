                                                "example_id": "694211d1-b13a-4764-89cb-ea995ec2ef73",
                                                "sense_id": "f9230ae0-c332-3aad-bbea-8c1cc92d7071",
                                                "text": "L’épave d’un hydravion qui a coulé dans un lac situé à 50 kilomètres au nord de Sept-Îles, il y près de 100 ans, a été découverte au cours des dernières semaines."
                                            }
