                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sterile",
                                "target_lang_sense_clarification": "incapable of producing offspring"
                            },
                            {
                                "target_lang_word": "infertile",
                                "target_lang_sense_clarification": "unable to conceive or reproduce"
