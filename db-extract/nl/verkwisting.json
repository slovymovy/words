                            },
                            {
                                "target_word": "waste",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "563a1c8a-64c6-3b68-9cfe-3bb95305ce82",
                                        "entry_id": "96759dd1-c3c6-315b-b754-a26ae537bee3",
                                        "glosses": [
                                            "Useless and contemptible."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9cffb2b-465d-4fa9-8232-683fdef6f595",
                                                "sense_id": "563a1c8a-64c6-3b68-9cfe-3bb95305ce82",
                                                "text": "Niggas moves so waste / Please, come outside the house and show yourself / So I can say it to your face"
                                            },
                                            {
                                                "example_id": "0d2454e4-8366-4c83-b0dd-99db74efb44a",
                                                "sense_id": "563a1c8a-64c6-3b68-9cfe-3bb95305ce82",
                                                "text": "Waste / Don't talk to me / You're so waste"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "waste",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d88ae654-8cb5-306d-8108-791cff67dfe2",
                                        "entry_id": "d2cf82dd-bbd9-3ded-b77c-baa978562aa4",
                                        "glosses": [
                                            "Uncultivated, uninhabited."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a486fc61-0e08-4544-ac4d-39a651ac7971",
                                                "sense_id": "d88ae654-8cb5-306d-8108-791cff67dfe2",
                                                "text": "SOo whanne syr Galahad was departed from the castel of maydens / he rode tyl he came to a waste forest / & there he mette with syre launcelot and syr Percyuale but they knewe hym not / for he was newe desguysed / Ryghte so syr launcelot his fader dressid his spere and brake it vpon syr Galahad"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2e3b51f-dfc0-34e0-b926-6c0738dfb9f9",
                                        "entry_id": "d2cf82dd-bbd9-3ded-b77c-baa978562aa4",
                                        "glosses": [
                                            "Barren; desert; empty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e1e179e-51d1-4357-96c7-074c160e7b93",
                                                "sense_id": "c2e3b51f-dfc0-34e0-b926-6c0738dfb9f9",
                                                "text": "‘The stars,’ she whispers, ‘blindly run;\n⁠A web is wov’n across the sky;\n⁠From out waste places comes a cry,\nAnd murmurs from the dying sun: […]"
                                            },
                                            {
                                                "example_id": "569e5161-f536-4f89-a0a6-92348f8b4779",
                                                "sense_id": "c2e3b51f-dfc0-34e0-b926-6c0738dfb9f9",
                                                "text": "For centuries the shrine at Mecca had been of merely local importance, far outshone by the Temple of the Jews in Jerusalem, whose cult Christians had in good measure renewed by their pilgrimage in honour of Christ's crucifixion and resurrection, while leaving the actual site of the Jerusalem Temple dishonoured and waste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "087f57bc-fcbe-3bdb-8252-f8edcbbaa26a",
                                        "entry_id": "d2cf82dd-bbd9-3ded-b77c-baa978562aa4",
                                        "glosses": [
                                            "Rejected as being defective; eliminated as being worthless; produced in excess."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2097fb46-a44a-4dfa-9562-bca8e7ea7c85",
                                                "sense_id": "087f57bc-fcbe-3bdb-8252-f8edcbbaa26a",
                                                "text": "Oxygen levels on Earth skyrocketed 2.4 billion years ago, when cyanobacteria evolved photosynthesis: the ability to convert water and carbon dioxide into carbohydrates and waste oxygen using solar energy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1540098-e2a6-3dd3-8c7b-05545fb8d5ed",
                                        "entry_id": "d2cf82dd-bbd9-3ded-b77c-baa978562aa4",
                                        "glosses": [
                                            "Superfluous; needless."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "405f2de4-1698-32b3-a677-276a4ed699d1",
                                        "entry_id": "d2cf82dd-bbd9-3ded-b77c-baa978562aa4",
                                        "glosses": [
                                            "Dismal; gloomy; cheerless."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2eeba27-6775-46c0-bd5d-3b9434f5c860",
                                                "sense_id": "405f2de4-1698-32b3-a677-276a4ed699d1",
                                                "text": "the savage Baron's heart[…] became appalled as he gazed forward into the waste darkness of futurity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a53924e-4097-3125-a782-99bfa29d4856",
                                        "entry_id": "d2cf82dd-bbd9-3ded-b77c-baa978562aa4",
                                        "glosses": [
                                            "Unfortunate; disappointing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "waste",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13e320bf-98d4-335c-b298-13be9a5699fe",
                                        "entry_id": "e337c973-cd97-3ce5-b1bb-8dcdd2a2c037",
                                        "glosses": [
                                            "To devastate; to destroy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e9dad98-706b-4de6-b831-3db2c02a9401",
                                                "sense_id": "13e320bf-98d4-335c-b298-13be9a5699fe",
                                                "text": "Thou barrein ground, whome winters wrath hath wasted, / Art made a myrrour to behold my plight."
                                            },
                                            {
                                                "example_id": "2818af83-3e29-415d-88c9-9f945d3f0a4d",
                                                "sense_id": "13e320bf-98d4-335c-b298-13be9a5699fe",
                                                "text": "The Tiber / Insults our walls, and wastes our fruitful grounds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b870481-49a6-359d-9790-41916aa5c2d8",
                                        "entry_id": "e337c973-cd97-3ce5-b1bb-8dcdd2a2c037",
                                        "glosses": [
                                            "To squander (money or resources) uselessly; to spend (time) idly; to dissipate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "859c99d7-cdfa-4c3a-a5a2-cd89d3ebacbf",
                                                "sense_id": "0b870481-49a6-359d-9790-41916aa5c2d8",
                                                "text": "We wasted millions of dollars and several years on that project."
                                            },
                                            {
                                                "example_id": "e2b2e2c4-06ed-4d16-aa78-e51616886201",
                                                "sense_id": "0b870481-49a6-359d-9790-41916aa5c2d8",
                                                "text": "I like this place, / And willingly could waste my time in it."
                                            },
                                            {
                                                "example_id": "9ab9c95f-c92a-4203-9c79-f9a2176453b8",
                                                "sense_id": "0b870481-49a6-359d-9790-41916aa5c2d8",
                                                "text": "Full many a flower is born to blush unseen, / And waste its sweetness on the desert air."
                                            },
                                            {
                                                "example_id": "078686d0-1b17-4f45-a550-990c261960dd",
                                                "sense_id": "0b870481-49a6-359d-9790-41916aa5c2d8",
                                                "text": "A “moving platform” scheme[…]is more technologically ambitious than maglev trains even though it relies on conventional rails.[…]This set-up solves several problems […]. Stopping high-speed trains wastes energy and time, so why not simply slow them down enough for a moving platform to pull alongside?"
                                            },
                                            {
                                                "example_id": "eb6b053e-e62c-47a5-9c27-3ecccf80ab71",
                                                "sense_id": "0b870481-49a6-359d-9790-41916aa5c2d8",
                                                "text": "E. Kay (1822-1897), afterwards Lord Justice of Appeal, had rooms on the same staircase as myself, and we wasted a great deal of time together, both in term and in my second summer vacation. ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73342183-3298-33b3-ad24-32ed93a33ce8",
                                        "entry_id": "e337c973-cd97-3ce5-b1bb-8dcdd2a2c037",
                                        "glosses": [
                                            "To kill; to murder."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "048f56a5-e944-31fb-9013-469d8c5dc3ba",
                                        "entry_id": "e337c973-cd97-3ce5-b1bb-8dcdd2a2c037",
                                        "glosses": [
                                            "To wear away by degrees; to impair gradually; to deteriorate; to diminish by constant loss; to use up; to consume; to spend; to wear out."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb316c7a-c90c-4641-885c-9484c7c6ae26",
                                                "sense_id": "048f56a5-e944-31fb-9013-469d8c5dc3ba",
                                                "text": "until your carcases be wasted in the wilderness"
                                            },
                                            {
                                                "example_id": "fd30b89f-5228-4b83-8dd0-2643b089673a",
                                                "sense_id": "048f56a5-e944-31fb-9013-469d8c5dc3ba",
                                                "text": "Wasted by such a course of life, the infirmities of age daily grew on him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adb4f2f9-9cd9-3bbd-a1a0-eb526f0151bb",
                                        "entry_id": "e337c973-cd97-3ce5-b1bb-8dcdd2a2c037",
                                        "glosses": [
                                            "To gradually lose weight, weaken, become frail."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f2bc88b9-ac12-3491-8d72-a460bbf1ccbe",
                                        "entry_id": "e337c973-cd97-3ce5-b1bb-8dcdd2a2c037",
                                        "glosses": [
                                            "To be diminished; to lose bulk, substance, strength, value etc. gradually."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "245e2a9d-f080-4fb3-97a1-3b2344f59dee",
                                                "sense_id": "f2bc88b9-ac12-3491-8d72-a460bbf1ccbe",
                                                "text": "[…]The barrell of meale shall not waste, neither shall the cruse of oile faile, vntill the day that the Lord sendeth raine vpon the earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea6e0252-cc05-3f7e-bf95-ca5963093578",
