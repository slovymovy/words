{
    "word_family": [
        "dooi",
        "dooier",
        "dooiweer",
        "dooipunt",
        "ontdooien"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7f850022-4f1d-3790-9bf5-2145063195b2",
                    "sense_definition": "het stijgen van de temperatuur boven het vriespunt waardoor ijs en sneeuw smelten",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weersomstandigheden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>dooide</w> gedurende de dag, maar 's nachts vroor het weer.",
                            "target_lang_translations": {
                                "en": "It <w>thawed</w> during the day, but at night it froze again."
                            }
                        },
                        {
                            "text": "Als het begint te <w>dooien</w>, worden de wegen vaak erg glad door de smeltende sneeuw.",
                            "target_lang_translations": {
                                "en": "When it starts to <w>thaw</w>, the roads often become very slippery due to the melting snow."
                            }
                        }
                    ],
                    "synonyms": [
                        "smelten"
                    ],
                    "antonyms": [
                        "vriezen"
                    ],
                    "common_phrases": [
                        "beginnen te dooien",
                        "het gaat dooien"
                    ],
                    "target_lang_definitions": {
                        "en": "the rise of the temperature above freezing point, causing ice and snow to melt"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thaw",
                                "target_lang_sense_clarification": "weather condition"
                            },
                            {
                                "target_lang_word": "melt",
                                "target_lang_sense_clarification": "general process of ice turning to water"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf155352-0e4c-3d04-911d-f0a520c48b7c",
                    "sense_definition": "vloeibaar worden van bevroren stoffen door warmte",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke verandering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De sneeuw op het dak begon langzaam te <w>dooien</w> in de zon.",
                            "target_lang_translations": {
                                "en": "The snow on the roof slowly began to <w>melt</w> in the sun."
                            }
                        },
                        {
                            "text": "Je moet het vlees eerst laten <w>dooien</w> voordat je het in de pan doet.",
                            "target_lang_translations": {
                                "en": "You must first let the meat <w>defrost</w> before putting it in the pan."
                            }
                        }
                    ],
                    "synonyms": [
                        "smelten",
                        "ontdooien"
                    ],
                    "antonyms": [
                        "bevriezen",
                        "stollen"
                    ],
                    "common_phrases": [
                        "laten dooien"
                    ],
                    "target_lang_definitions": {
                        "en": "the process of frozen substances becoming liquid due to heat"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thaw",
                                "target_lang_sense_clarification": "gradually becoming fluid"
                            },
                            {
                                "target_lang_word": "defrost",
                                "target_lang_sense_clarification": "specifically for food or equipment"
                            },
                            {
                                "target_lang_word": "melt",
                                "target_lang_sense_clarification": "turning from solid to liquid"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "594ea349-aadf-349f-8abb-522e00f4e962",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>dooie</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "personen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er vielen bij dat ernstige ongeluk helaas drie <w>dooien</w>.",
                            "target_lang_translations": {
                                "en": "Unfortunately, there were three <w>dead</w> in that serious accident."
                            }
                        },
                        {
                            "text": "De krant schreef over de vele <w>dooien</w> die tijdens de oorlog zijn gevallen.",
                            "target_lang_translations": {
                                "en": "The newspaper wrote about the many <w>dead</w> who fell during the war."
                            }
                        }
                    ],
                    "synonyms": [
                        "doden",
                        "overledenen"
                    ],
                    "antonyms": [
                        "levenden"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt in plaats van het formele 'doden'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of the noun 'dead person'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dead",
                                "target_lang_sense_clarification": "plural noun referring to deceased people"
                            },
                            {
                                "target_lang_word": "fatalities",
                                "target_lang_sense_clarification": "people killed in an accident or war"
                            },
                            {
                                "target_lang_word": "casualties",
                                "target_lang_sense_clarification": "people killed or injured"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}