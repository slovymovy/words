                        "sense_id": "ede4ece4-a255-33c5-84b3-f37fb4896a46",
                        "entry_id": "9dc87235-d922-300f-bf27-adebc2d97e77",
                        "glosses": [
                            "Salvia plantengeslacht uit de familie van de lipbloemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "260511ec-ec37-49cb-9327-f5993e21811f",
                                "sense_id": "ede4ece4-a255-33c5-84b3-f37fb4896a46",
                                "text": "Verpleeghuisarts Marianne Abbink strijkt liefdevol met haar vingertoppen over het grijze, viltachtige blad van de salvia officinalis."
                            },
                            {
                                "example_id": "ba3cb803-4d72-4bd9-9370-deee0bb8f6ec",
                                "sense_id": "ede4ece4-a255-33c5-84b3-f37fb4896a46",
                                "text": "(Salvia Divinorum is ‘een bewustzijnsveranderend kruid dat gebruikt kan worden voor hallucinogene doeleinden of in een genezingsritueel, waarbij men, afhankelijk van de inname, geheel in beslag kan worden genomen door innerlijke beleving en alle realiteits- of identiteisgevoel tijdelijk verliest.’)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6e2b025-0ffe-4bda-91d8-66442f7a331e",
                        "source_entry_id": "9dc87235-d922-300f-bf27-adebc2d97e77",
                        "source_sense_id": "ede4ece4-a255-33c5-84b3-f37fb4896a46",
                        "source_sense_description": "plantengeslacht uit de familie van de lipbloemen",
                        "target_lang_word": "sage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea72e5f4-f37c-3967-a62a-12104513059d",
                                        "entry_id": "3261a0f4-b531-3149-80c9-b73705a680b6",
                                        "glosses": [
                                            "Wise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba30ae20-8c00-481a-8147-af04086eed54",
                                                "sense_id": "ea72e5f4-f37c-3967-a62a-12104513059d",
                                                "text": "Harry the fift is crownd, vp vanitie, / Downe royall ſtate, all you ſage counſailers, hence, / And to the Engliſh Court aſſemble now / From euery region, apes of idleneſſe: […]"
                                            },
                                            {
                                                "example_id": "99d05329-a42d-4333-bc5e-25360132c808",
                                                "sense_id": "ea72e5f4-f37c-3967-a62a-12104513059d",
                                                "text": "Howbeit the Caledonians with great preparation, and by rumor, as of things unknown much greater, taking Armes, and of thir own accord begining Warr by the aſſault of ſundry Caſtles, ſent back ſome of thir fear to the Romans themſelves: and there were of the Commanders, who cloaking thir fear under ſhew of ſage advice, counſel’d the General to retreat back on this ſide Bodotria."
                                            },
                                            {
                                                "example_id": "c038bc63-b83f-415d-8329-7c1827d416fc",
                                                "sense_id": "ea72e5f4-f37c-3967-a62a-12104513059d",
                                                "text": "CHAPTER VII. In which Jack makes some very sage reflections, and comes to a very unwise decision."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "454469e4-bdad-3211-9514-07dd956e8563",
                                        "entry_id": "3261a0f4-b531-3149-80c9-b73705a680b6",
                                        "glosses": [
                                            "Grave; serious; solemn."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa707082-4a5f-3ad6-bf74-c9666c76d52e",
                                        "entry_id": "5b086d02-d304-3063-bce6-1e7488b62907",
                                        "glosses": [
                                            "A very wise person or spiritual teacher; someone of gravity and wisdom, especially, a teacher venerable for years, and of sound judgment and prudence; a grave or stoic philosopher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f2d2a17-7038-4ed7-b2ab-d168311809d0",
                                                "sense_id": "fa707082-4a5f-3ad6-bf74-c9666c76d52e",
                                                "text": "’Tis certain, that, while we aſpire to the magnanimous Firmneſs of the philoſophic Sage, and endeavour to confine our Pleaſures altogether within our own Minds, we may, at laſt, render our Philoſophy, like that of Epictetus and other Stoics, only a more refin’d Syſtem of Selfiſhneſs, and reaſon ourſelves out of all Virtue, as well as ſocial Enjoyment."
                                            },
                                            {
                                                "example_id": "a68375b0-bc6a-4505-8095-e213f98adca0",
                                                "sense_id": "fa707082-4a5f-3ad6-bf74-c9666c76d52e",
                                                "text": "All sages and physicians agree in saying that the ills which afflict man originate with the abuse of coition."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sage",
