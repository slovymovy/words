                            {
                                "example_id": "ad6db1da-34a5-4215-a016-32642bdc2cc8",
                                "sense_id": "6a6ae56a-8ca7-34f2-898c-e4a9938f00e2",
                                "text": "Je le comprends d’autant mieux, sire, répondit le colonel des gardes françaises, que j’ai grand’faim moi-même."
                            },
                            {
                                "example_id": "00e3bf48-e1ab-4e40-913e-eca0eb02ca8c",
                                "sense_id": "6a6ae56a-8ca7-34f2-898c-e4a9938f00e2",
                                "text": "Bien qu’ils eussent grand’faim, ils ne pouvaient guère manger ; et elle observait à l’écart le tremblement de leurs mains osseuses, en prenant les gobelets."
                            }
                        ]
