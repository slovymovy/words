                        "examples": [
                            {
                                "example_id": "438ad118-9d60-4240-b85d-89e4133e8a25",
                                "sense_id": "0104b851-669b-36ff-a1d6-b92c3d55f432",
                                "text": "Les diverses maladies qu'on a signalées depuis quelques années, telles que la pyrale, le gribouri, le conchylis omphucelia ou la teigne de la vigne, l'oïdium, le mans ou ver blanc, la jaunisse ou chlorose, le rongeot, enfin l'anthracnose, ont toutes été observées à des degrés divers."
                            },
                            {
                                "example_id": "a0340d1f-fbe0-4a59-bbca-ac675257fe64",
                                "sense_id": "0104b851-669b-36ff-a1d6-b92c3d55f432",
                                "text": "Les larves d'un papillon, la pyrale, après avoir anéanti les vignes de Lucey et de Bruley, ravagèrent celles de la Seille (1900); puis la conchylis ou ver de la vigne, se mit à sévir à l'état endémique dans le Pays Messin."
                            }
                        ]
                    }
