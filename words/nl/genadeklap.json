            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c119c615-2804-3f9d-9841-c1a7bb91a265",
                    "sense_definition": "de laatste van een serie gebeurtenissen die het definitieve einde of de ondergang van iets veroorzaakt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finaal effect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De stijgende energieprijzen gaven het kleine familiebedrijf helaas de <w>genadeklap</w>.",
                            "target_lang_translations": {
                                "en": "The rising energy prices unfortunately dealt the small family business the <w>death blow</w>."
                            }
                        },
                        {
                            "text": "Veel beleggers vrezen dat een nieuwe oorlog de <w>genadeklap</w> uitdelen zal aan de wereldhandel.",
                            "target_lang_translations": {
                                "en": "Many investors fear that a new war will deal the <w>final blow</w> to world trade."
                            }
                        }
                    ],
                    "synonyms": [
                        "nekslag",
                        "genadeslag",
                        "genadestoot"
                    ],
                    "common_phrases": [
                        "de genadeklap uitdelen",
                        "de genadeklap betekenen",
                        "de genadeklap krijgen"
                    ],
                    "target_lang_definitions": {
                        "en": "The final event in a series that causes the definitive end, failure, or downfall of something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "death blow",
                                "target_lang_sense_clarification": "figurative, causing final failure"
                            },
                            {
                                "target_lang_word": "final blow",
                                "target_lang_sense_clarification": "the last in a series of negative events"
                            },
                            {
                                "target_lang_word": "finishing blow",
                                "target_lang_sense_clarification": "the act that completes a destruction"
                            },
                            {
                                "target_lang_word": "coup de grâce",
                                "target_lang_sense_clarification": "a final act that settles or finishes something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f05957b5-a015-3661-a046-947ec6b6cb6a",
                    "sense_definition": "het doden van een levend wezen om het uit een uitzichtloos lijden te verlossen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verlossing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jager gaf het zwaargewonde dier een <w>genadeklap</w> om verdere pijn te voorkomen.",
                            "target_lang_translations": {
                                "en": "The hunter gave the severely wounded animal a <w>mercy blow</w> to prevent further pain."
                            }
                        },
                        {
                            "text": "In historische context werd de <w>genadeklap</w> vaak met een dolk toegediend op het slagveld.",
                            "target_lang_translations": {
                                "en": "In a historical context, the <w>coup de grâce</w> was often administered with a dagger on the battlefield."
                            }
                        }
                    ],
                    "synonyms": [
                        "coup de grâce",
                        "genadestoot",
                        "genadeslag"
                    ],
                    "common_phrases": [
                        "een genadeklap toedienen"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of killing a living being to end its hopeless suffering."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mercy blow",
                                "target_lang_sense_clarification": "killing to end suffering"
                            },
                            {
                                "target_lang_word": "coup de grâce",
                                "target_lang_sense_clarification": "a death blow to end suffering"
                            },
                            {
                                "target_lang_word": "mercy killing",
                                "target_lang_sense_clarification": "the act of ending a life to stop pain"
                            },
                            {
                                "target_lang_word": "finishing stroke",
                                "target_lang_sense_clarification": "historical context of ending a life"
                            }
                        ]
                    }
                }
            ]
        }
