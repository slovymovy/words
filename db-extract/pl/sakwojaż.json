                                "target_senses": [
                                    {
                                        "sense_id": "17ef087f-c48a-3222-aed0-ca9f752046a3",
                                        "entry_id": "1ca31f5a-de1b-3699-97b1-e5529cfa57a9",
                                        "glosses": [
                                            "Tasche für Reisegepäck"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "686d7e88-4567-4993-8f4e-a03fa6356921",
                                                "sense_id": "17ef087f-c48a-3222-aed0-ca9f752046a3",
                                                "text": "„Schließlich sah sie auf ihrer Uhr, dass sie in genau einer halben Stunde fliegen würde, und als sie zu ihrer Reisetasche ging, entdeckte sie Stefan.“"
                                            },
                                            {
                                                "example_id": "0ba4ee9f-5f57-42c5-8ab0-ef5c73d0cb1a",
                                                "sense_id": "17ef087f-c48a-3222-aed0-ca9f752046a3",
                                                "text": "„Ein paar hatten Koffer bei sich; die meisten riesige Reisetaschen.“"
                                            },
                                            {
                                                "example_id": "e3d9d622-faa4-4e97-a113-d0f913dc1506",
                                                "sense_id": "17ef087f-c48a-3222-aed0-ca9f752046a3",
                                                "text": "„Ich wickle die Fernbedienung in ein T-Shirt und verstaue sie in meiner Reisetasche.“"
                                            },
                                            {
                                                "example_id": "09185cbe-c928-4dc9-a40d-d85816a74908",
                                                "sense_id": "17ef087f-c48a-3222-aed0-ca9f752046a3",
                                                "text": "„Joseph, der Kammerdiener, reichte Anatol Reisetasche und Säbel, und nun gingen alle ins Vorzimmer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc07e2cd-8883-46e6-acd5-6f0cc3849fb9",
