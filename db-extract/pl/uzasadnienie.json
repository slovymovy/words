                                        "glosses": [
                                            "A justification or rationalization for something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2a8749e-3343-4397-a725-d00d96f32f3e",
                                                "sense_id": "3cdc764a-c809-3048-8c3e-d7c97de88252",
                                                "text": "He confirmed that Bashir successfully manipulated Diana’s paranoia by showing her brother, Earl Spencer, forged documents that “proved” her closest advisers had betrayed her to the palace, inflaming her desire to speak out for herself. Bashir lied his way to the biggest TV scoop of the 20th century. Dyson’s censure at least gave her two sons some rationale for why Diana did something so destructive to their happiness."
                                            }
                                        ]
                                    }
                                ]
                            },
