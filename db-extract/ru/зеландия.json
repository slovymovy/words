                "senses": [
                    {
                        "sense_id": "027c6c55-bbc5-337d-810a-4452c584a920",
                        "entry_id": "c3be0952-4cbd-38ce-b066-aac5d785f7a6",
                        "glosses": [
                            "остров в Балтийском море, на котором расположена столица Дании Копенгаген"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8ce2733-8fb3-42f5-a9da-7eaa47225288",
                                "sense_id": "027c6c55-bbc5-337d-810a-4452c584a920",
                                "text": "Своеобразная скандинавская метрополия — расположенный на острове Зеландия Копенгаген — город колоколен и каналов, королей и купцов, злых троллей и добрых фей."
                            }
                        ]
                    },
                    {
                        "sense_id": "887fd0a3-70c8-3e79-bad5-3c9f3b8d92a7",
                        "entry_id": "c3be0952-4cbd-38ce-b066-aac5d785f7a6",
                        "glosses": [
                            "провинция Нидерландов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4eb860cd-9ef8-42b0-8e53-4eefd9a341c3",
                                "sense_id": "887fd0a3-70c8-3e79-bad5-3c9f3b8d92a7",
                                "text": "Проехав через несколько таких дамб, мы прибыли на первый остров в провинции Зеландия — Шоувен-Дювеланд, где расположен старинный городок Зирикзее."
                            }
                        ]
                    }
                ],
