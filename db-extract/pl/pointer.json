                "senses": [
                    {
                        "sense_id": "f9450f3f-8299-3f31-b30b-4ebc682e5dcb",
                        "entry_id": "ebd113f4-d68f-32aa-b3a9-fcd11b9459ca",
                        "glosses": [
                            "rasa psów myśliwskich; pies należący do tej rasy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6055934-2393-4da4-9f05-c7def90901da",
                                "sense_id": "f9450f3f-8299-3f31-b30b-4ebc682e5dcb",
                                "text": "Adam uwielbiał polować ze swoim pointerem na kuropatwy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aec26d80-b041-443a-9f29-e7f8669bbbfc",
                        "source_entry_id": "ebd113f4-d68f-32aa-b3a9-fcd11b9459ca",
                        "source_sense_id": "f9450f3f-8299-3f31-b30b-4ebc682e5dcb",
                        "target_lang_word": "pointer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pointer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f53c61dd-a24e-36fa-b5e0-34c9d62c764d",
                                        "entry_id": "90d2cf2c-5d6d-3818-b39a-61717c1ea92c",
                                        "glosses": [
                                            "Anything that points or is used for pointing.",
                                            "One who points."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03b20555-fb3c-49e7-8b75-10af7230e112",
                                                "sense_id": "f53c61dd-a24e-36fa-b5e0-34c9d62c764d",
                                                "text": "The talkers and pointers had undermined him. They had touched him with the acid of their suspicions, and the corrosion spread until he himself had lost sight of the truth."
                                            },
                                            {
                                                "example_id": "3f7bf5b3-ebbe-4b1e-84ff-e26df37f18cb",
                                                "sense_id": "f53c61dd-a24e-36fa-b5e0-34c9d62c764d",
                                                "text": "The man he addressed drew back in horror, but answered the musketeer’s words by pointing his finger. Athos offered the man a half pistole to accompany him, but the man refused. Athos went down the street that the pointer had indicated to him with his finger; […]"
                                            },
                                            {
                                                "example_id": "f954618d-95d9-484d-b8f0-5cce56cf6d2a",
                                                "sense_id": "f53c61dd-a24e-36fa-b5e0-34c9d62c764d",
                                                "text": "“Hey,” the finger pointer said, re-pointing his finger at Joe, “are you a joke or what?” / “I don't think I'm a joke.” / “Well I think you're a joke.” He dropped his hand and then lifted it again and pointed his finger at Joe's chest."
                                            },
                                            {
                                                "example_id": "6e36a63f-b839-4063-8b3c-24e842252b35",
                                                "sense_id": "f53c61dd-a24e-36fa-b5e0-34c9d62c764d",
                                                "text": "One man pointed his finger at another, nearly poking the tip of it into the man’s chest. I sidled closer and heard the pointer accuse the other man of cheating."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "981c894b-3e2f-3c81-9644-ac76c7272b68",
                                        "entry_id": "90d2cf2c-5d6d-3818-b39a-61717c1ea92c",
                                        "glosses": [
                                            "Anything that points or is used for pointing.",
                                            "A teacher's pointer, pointing stick, a rod with an arrow."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb4a0f9f-89a0-31d9-872e-366005dd73ba",
                                        "entry_id": "90d2cf2c-5d6d-3818-b39a-61717c1ea92c",
                                        "glosses": [
                                            "Anything that points or is used for pointing.",
                                            "A needlelike component of a timepiece or measuring device that indicates the time or the current reading of the device."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "796153cf-836f-3987-ab6f-550d460969aa",
                                        "entry_id": "90d2cf2c-5d6d-3818-b39a-61717c1ea92c",
                                        "glosses": [
                                            "Anything that points or is used for pointing.",
                                            "A breed of hunting dog, trained to point out game."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb87b35d-2753-483e-b153-5a387a9660ed",
                                                "sense_id": "796153cf-836f-3987-ab6f-550d460969aa",
                                                "text": "Most of the early wirehaired pointers represented a combination of Griffon, Stichelhaar, Pudelpointer, and German Shorthair. The Pudelpointer was a cross between a Poodle dog and an English Pointer bitch; the Griffon and the Stichelhaar were composed of Pointer, Foxhound, Pudelpointer, and a Polish water dog."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c41b66e3-96eb-300c-b930-56663994aad7",
                                        "entry_id": "90d2cf2c-5d6d-3818-b39a-61717c1ea92c",
                                        "glosses": [
                                            "Anything that points or is used for pointing.",
                                            "A variable that holds the address of a memory location where a value can be stored."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35f56fdf-b6c4-46c0-a7c1-2997c10ea087",
                                                "sense_id": "c41b66e3-96eb-300c-b930-56663994aad7",
                                                "text": "I do consider assignment statements and pointer variables to be among computer science's \"most valuable treasures.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8762c1ca-ff9f-3ab6-8569-9af387405e07",
                                        "entry_id": "90d2cf2c-5d6d-3818-b39a-61717c1ea92c",
                                        "glosses": [
                                            "Anything that points or is used for pointing.",
                                            "An icon that indicates the position of the pointing device, such as a mouse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceaddf0d-6f45-4884-95ed-af4474e0d508",
                                                "sense_id": "8762c1ca-ff9f-3ab6-8569-9af387405e07",
                                                "text": "The system notifies the user of the progress of a task by changing the appearance of the pointer. System-busy pointers usually adopt a timepiece metaphor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84dbc5ce-b57b-3824-b8eb-3a8146b66a14",
                                        "entry_id": "90d2cf2c-5d6d-3818-b39a-61717c1ea92c",
                                        "glosses": [
                                            "A tip, a bit of advice."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0eaebb5f-0687-40b8-a084-ad4cc980a338",
                                                "sense_id": "84dbc5ce-b57b-3824-b8eb-3a8146b66a14",
                                                "text": "The instructor gave me some pointers on writing a good paper."
                                            },
                                            {
                                                "example_id": "52920d0f-cfcc-4e38-8c34-c7407dd0d6b9",
                                                "sense_id": "84dbc5ce-b57b-3824-b8eb-3a8146b66a14",
                                                "text": "In a paper to the Institute of Locomotive Engineers on February 17 which ranged over the whole subject of auxiliary services on London Transport rolling stock, Mr. R. I. D. Arthurton, Mechanical Engineer (Development—Railways) London Transport Board, gave some pointers to the future on the Victoria Line and elsewhere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c59b2034-5813-318b-b148-f3f479a53cef",
                                        "entry_id": "90d2cf2c-5d6d-3818-b39a-61717c1ea92c",
                                        "glosses": [
                                            "Something that gives a point (sharp end) to something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "751fdc06-03fd-43b8-9c3a-e826c5e7cce7",
                                                "sense_id": "c59b2034-5813-318b-b148-f3f479a53cef",
                                                "text": "pencil pointer"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "051227d7-3685-3574-98ae-f8709876ab61",
                                        "entry_id": "90d2cf2c-5d6d-3818-b39a-61717c1ea92c",
                                        "glosses": [
                                            "Something worth a given number of points."
                                        ],
                                        "tags": [
                                            "in combinations"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77e90858-6a85-49ae-a8d5-250a361f72c7",
                                                "sense_id": "051227d7-3685-3574-98ae-f8709876ab61",
                                                "text": "a ten-pointer"
                                            },
                                            {
                                                "example_id": "a8308ce4-2583-45f0-b6ef-c37ebb035776",
                                                "sense_id": "051227d7-3685-3574-98ae-f8709876ab61",
                                                "text": "After another penalty miss, Kvirikashvili finally found the target on 27 minutes before Flood hit back with a three-pointer of his own."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ed35755-7b34-4f46-af0b-98f52541fd25",
                        "source_entry_id": "ebd113f4-d68f-32aa-b3a9-fcd11b9459ca",
                        "source_sense_id": "f9450f3f-8299-3f31-b30b-4ebc682e5dcb",
