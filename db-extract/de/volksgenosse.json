                "senses": [
                    {
                        "sense_id": "b72948c6-007e-3935-82dd-95d2953447a2",
                        "entry_id": "da8300a9-fd5a-31e6-a921-078ce2e7fc7d",
                        "glosses": [
                            "historisch, Angehöriger der sogenannten deutschen Volksgemeinschaft"
                        ],
                        "tags": [
                            "nationalsozialistisch"
                        ],
                        "examples": [
                            {
                                "example_id": "d485de14-bfb5-4758-bca9-b02f3cbe3da6",
                                "sense_id": "b72948c6-007e-3935-82dd-95d2953447a2",
                                "text": "„Denn er sah es bei jeder Gelegenheit, wie sie ständig einen Unterschied zwischen Volksgenossen und Parteigenossen machten.“"
                            },
                            {
                                "example_id": "9d7ddb31-cbd4-4ab0-9d2d-d593e04b408d",
                                "sense_id": "b72948c6-007e-3935-82dd-95d2953447a2",
                                "text": "Definition nach Punkt 4 des 25-Punkte-Programms der NSDAP: „Volksgenosse kann nur sein, wer deutschen Blutes ist, ohne Rücksichtnahme auf Konfession. Kein Jude kann daher Volksgenosse sein.“"
                            },
                            {
                                "example_id": "55f08514-2fdb-4f42-8926-51c8d22ea886",
                                "sense_id": "b72948c6-007e-3935-82dd-95d2953447a2",
                                "text": "„Das hätte er als zuverlässiger Volksgenosse tun müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
