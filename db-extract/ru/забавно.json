        "ru-extract.jsonl": [
            {
                "entry_id": "9f23d66d-7c3f-35ea-b50b-e1c16ca1f94c",
                "word": "забавно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "14556437-cbf9-3a13-bf0b-9d3cbb3c378d",
                        "entry_id": "9f23d66d-7c3f-35ea-b50b-e1c16ca1f94c",
                        "glosses": [
                            "наречие к забавный; увлекательно, смешно"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "f3767580-c282-489b-9cc4-298e16aead7b",
                                "sense_id": "14556437-cbf9-3a13-bf0b-9d3cbb3c378d",
                                "text": "Она умела очень забавно рассказывать то, что было с нею, или то, что она слыхала от других."
                            }
                        ]
                    },
                    {
                        "sense_id": "41cbefc0-8716-3420-a24a-331e0f4a1bfc",
                        "entry_id": "9f23d66d-7c3f-35ea-b50b-e1c16ca1f94c",
                        "glosses": [
                            "оценочная характеристика ситуации, чьих-либо действий как могущих развлечь, рассмешить, возбудить интерес"
                        ],
                        "tags": [
                            "в знач. сказуемого"
                        ],
                        "examples": [
                            {
                                "example_id": "37d90eb0-7324-4fa8-9b9b-dd82b043c912",
                                "sense_id": "41cbefc0-8716-3420-a24a-331e0f4a1bfc",
                                "text": "Перед отъездом мальчик подстригся, и мне забавно видеть, как, по привычке вытягивая губы, он продолжает сдувать со лба несуществующий чуб."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81c8f36a-097b-4d55-a37d-2e6f273e4cef",
                        "source_entry_id": "9f23d66d-7c3f-35ea-b50b-e1c16ca1f94c",
