                        "sense_id": "f0a3b43c-afe1-3cd0-b7ed-21c4824d5a7f",
                        "entry_id": "d9902e76-66e8-3d46-8140-18ecccee693e",
                        "glosses": [
                            "A shamanistic cairn found in Mongolia, usually made from rocks or wood and found on or around mountains."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49378f8d-1922-494f-95bb-5adfee1a2921",
                                "sense_id": "f0a3b43c-afe1-3cd0-b7ed-21c4824d5a7f",
                                "text": "Bayan Obo, Inner Mongolia, China"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e3e654b-354c-49a3-a8e0-7bdaae7a4fe8",
                        "source_entry_id": "d9902e76-66e8-3d46-8140-18ecccee693e",
                        "source_sense_id": "f0a3b43c-afe1-3cd0-b7ed-21c4824d5a7f",
                        "source_sense_description": "a shamanistic cairn found in Mongolia",
                        "target_lang_word": "обо́",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "обо́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cee33d60-c86c-3ee6-bac8-370fab9fde89",
                                        "entry_id": "91b9179d-2baa-3906-b2fa-218818905b91",
                                        "glosses": [
                                            "вариант предлога о, об; используется перед группами согласных звуков вс, мн и чт: вместо о в сочетаниях обо мне, обо (что, что-то, что-либо, что-нибудь), обо всё и наряду с о в сочетаниях перед местоименными прилагательными весь, всякий, всяческий, многий в винительном и предложном падежах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21f151a2-e505-4797-9cb3-92280253f77a",
                                                "sense_id": "cee33d60-c86c-3ee6-bac8-370fab9fde89",
                                                "text": "Он знал обо мне столько, что с такими знаниями опасно оставаться в живых."
                                            },
                                            {
                                                "example_id": "51749d30-9f67-485d-8ea5-c4bad8a4933b",
                                                "sense_id": "cee33d60-c86c-3ee6-bac8-370fab9fde89",
                                                "text": "Есть, на что поглядеть, что послушать, обо что кулаки размять."
                                            },
                                            {
                                                "example_id": "dada0d42-4ee5-4bfd-8691-eb0d3c2f81cf",
                                                "sense_id": "cee33d60-c86c-3ee6-bac8-370fab9fde89",
                                                "text": "Следователю я симпатизировал, он был не сволочь, и мы давно обо всём договорились: я сижу, он шьёт дело, у меня своя дорога, у него своя."
                                            },
                                            {
                                                "example_id": "b767a051-3ee3-4d90-8d6d-15b399ee2859",
                                                "sense_id": "cee33d60-c86c-3ee6-bac8-370fab9fde89",
                                                "text": "Пластун рванулся наверх, ободравшись обо всё, что только можно, благо, что не захлопнул тяжеленную крышку."
                                            },
                                            {
                                                "example_id": "c582f484-b097-410d-aa45-1bc00554a1dc",
                                                "sense_id": "cee33d60-c86c-3ee6-bac8-370fab9fde89",
                                                "text": "Пишут о банкирах, артистах да обо всякой вынюхивающей сволочи, а о рабочих — ни слова."
                                            },
                                            {
                                                "example_id": "1a3b08dd-6c95-407b-8c0b-790a0565f7b3",
                                                "sense_id": "cee33d60-c86c-3ee6-bac8-370fab9fde89",
                                                "text": "Сейчас европейские рынки засыпаны стихами и прозой обо всяческих «Цепелинах»…"
                                            },
                                            {
                                                "example_id": "c98d9a5e-58c5-418d-be57-1dc58a517ca2",
                                                "sense_id": "cee33d60-c86c-3ee6-bac8-370fab9fde89",
                                                "text": "Тогда это было обидно, а теперь вспоминать об этом приятнее, чем обо многих позднейших похвалах."
                                            }
                                        ]
                                    }
                                ]
                            },
