                        "sense_id": "7380f04b-bcb9-35fc-95de-806db2c451d0",
                        "entry_id": "61575666-6d28-34a2-b4ca-421eb07b4e70",
                        "glosses": [
                            "iets heel erg leuk vinden, ergens verrukt van raken"
                        ],
