                    {
                        "sense_id": "ea6d929b-935a-3b64-be5e-0f8d312c97e8",
                        "entry_id": "c8223089-19cd-37c7-8f04-5443f1a04a83",
                        "glosses": [
                            "Qui se rapporte à l'art, aux œuvres, du sculpteur grec Praxitèle ; digne de son ciseau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "775616f9-dba9-411d-adb9-129d9b00f7d0",
                                "sense_id": "ea6d929b-935a-3b64-be5e-0f8d312c97e8",
                                "text": "Récemment, visite d'un ami d'outre-Manche, très élégant dans son costume de velours noir. Son visage est d'une régularité praxitélienne, ce qui est fréquent chez les gens de sa race."
                            },
                            {
                                "example_id": "69b0250d-78f8-4132-8fc2-e3f04c78308e",
                                "sense_id": "ea6d929b-935a-3b64-be5e-0f8d312c97e8",
                                "text": "D’avance, il la savait belle ; il n’avait pourtant pas imaginé ce visage d’ambre pâle, ce corps praxitélien aux contours discrètement marqués par le long tailleur de velours rose, ce grand chapeau de feutre rose couvrant à demi la nuit des cheveux et les tranquilles yeux sombres."
                            }
                        ]
                    }
