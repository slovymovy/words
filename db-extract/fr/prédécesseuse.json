                                "target_senses": [
                                    {
                                        "sense_id": "caee8954-e858-3cdd-99b4-ff6d45588dba",
                                        "entry_id": "1307ce45-a607-3da9-b618-fe9e8a494832",
                                        "glosses": [
                                            "weibliche Person, die jemandes Amt, Stellung oder Ähnliches zuvor innehatte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a4132ac-a849-458c-be08-29d0c7455f76",
                                                "sense_id": "caee8954-e858-3cdd-99b4-ff6d45588dba",
                                                "text": "Die Vorgängerin hinterließ der Nachfolgerin einen Berg Schulden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
