        "nl-extract.jsonl": [
            {
                "entry_id": "cd1d755b-dd44-33b8-8373-24b2f3564045",
                "word": "röntgen",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0f2e0140-8550-3233-8342-7949d26409cc",
                        "entry_id": "cd1d755b-dd44-33b8-8373-24b2f3564045",
                        "glosses": [
                            "eenheid van hoeveelheid röntgenstraling (geen SI-eenheid)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0357090-c15a-4683-9a53-cd23a439357c",
                                "sense_id": "0f2e0140-8550-3233-8342-7949d26409cc",
                                "text": "Maar ze had levercirrose. De dosis straling in haar lever was achtentwintig röntgen."
                            }
                        ]
                    },
                    {
                        "sense_id": "72d76c09-4272-3b82-9b3d-117dfcb343a0",
                        "entry_id": "cd1d755b-dd44-33b8-8373-24b2f3564045",
                        "glosses": [
                            "vooral als linkerdeel van samenstellingen: elektromagnetische straling met een golflengte groter dan die van ultraviolet licht, maar kleiner dan die van gammastraling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a7ced65-524c-4de8-8f16-0454537bbc0e",
                                "sense_id": "72d76c09-4272-3b82-9b3d-117dfcb343a0",
                                "text": "„Röntgen blijft toch schadelijke straling: artsen staan met een loodschort aan”, zegt Van Meurs."
                            },
                            {
                                "example_id": "51353508-6c64-4212-b793-e11a5820d5de",
                                "sense_id": "72d76c09-4272-3b82-9b3d-117dfcb343a0",
                                "text": "„Een van de problemen van radiotherapie met röntgen is dat een groot deel van de stralingsenergie niet in de tumor terechtkomt, maar in het gezonde weefsel ervóór en – in mindere mate – erachter”, zegt Hans Langendijk, hoogleraar radiotherapie in het Universitair Medisch Centrum Groningen en voorzitter van het Landelijk Platform Protonentherapie."
                            }
                        ]
                    },
                    {
                        "sense_id": "72bd474b-25d1-329d-a409-5b854bfc13c4",
                        "entry_id": "cd1d755b-dd44-33b8-8373-24b2f3564045",
                        "glosses": [
                            "plaats waar x-stralen worden gebruikt om foto's te maken die de binnenkant van een lichaam of voorwerp laten zien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd3409f6-6870-40b0-933b-907c624b757d",
                                "sense_id": "72bd474b-25d1-329d-a409-5b854bfc13c4",
                                "text": "„Dergelijk handelen brengt de veiligheid van de burgerluchtvaart ernstig in gevaar’’, staat in de ontslagbrief van het bedrijf. Dat rekent het de man ook aan niet te hebben gemeld dat tijdens het desbetreffende weekend niet alle vracht door de röntgen is gegaan."
                            },
                            {
                                "example_id": "e21d2498-0681-46ed-a359-4f71930920ba",
                                "sense_id": "72bd474b-25d1-329d-a409-5b854bfc13c4",
                                "text": "Dankzij röntgendiagnostiek, radiotherapie en nucleaire geneeskunde zijn heel wat patiëntenlevens gered. Maar ioniserende straling kan ook kanker veroorzaken. De kans daarop is gering doordat meestal lage stralingsdoses worden gebruikt en vooral oudere mensen naar de röntgen gaan."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
