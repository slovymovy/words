                        "glosses": [
                            "Qui ne peut s’acclimater."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0958e69f-d42c-47ca-83bb-29385c270148",
                                "sense_id": "1a83414f-6357-3ab9-8c5f-bbcfb58f3160",
                                "text": "La race indo-européenne s’est constamment trouvée inacclimatable dans ses nombreuses et persévérantes tentatives sur les versants méditerranéens de la côte d’Afrique et plus particulièrement en Égypte."
                            },
                            {
                                "example_id": "2de5d455-827f-4597-9265-3076e3859c87",
                                "sense_id": "1a83414f-6357-3ab9-8c5f-bbcfb58f3160",
                                "text": "Cette plante, à l’aspect très étrange, d’un port curieux, de formes raides et de couleur terne, est fort intéressante, mais inacclimatable."
                            },
                            {
                                "example_id": "547763c4-f54b-4284-b9d0-e8e199243e6a",
                                "sense_id": "1a83414f-6357-3ab9-8c5f-bbcfb58f3160",
                                "text": "Sagement, il est là avec une jolie petite épouse de son pays, habillée à la mode de Paris, mais l’air effarouché et inacclimatable."
                            }
                        ]
                    }
