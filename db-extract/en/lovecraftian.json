                        ],
                        "form": "more Lovecraftian"
                    },
                    {
                        "form_id": "c34831ac-c5e5-4fc4-9630-4b5f4dc87e53",
                        "entry_id": "71fd7ce9-74f5-39b9-b920-4f7555e595d7",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most Lovecraftian"
