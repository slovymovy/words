                                            {
                                                "example_id": "182c433f-48e0-49af-a5a0-65e61b883111",
                                                "sense_id": "0ec336ea-3d31-320b-8de6-881493b6ef7f",
                                                "text": "Někdy turniket podlézala, jindy zas přeskakovala - přece nebude utrácet za jízdenky."
                                            },
                                            {
                                                "example_id": "f259b7eb-5932-4f59-b12c-a407c4228650",
                                                "sense_id": "0ec336ea-3d31-320b-8de6-881493b6ef7f",
                                                "text": "Zrovna podlézal zábradlí kolem kampusu, když tu jej přepadla jakási nevysvětlitelná nevolnost."
                                            }
                                        ]
                                    },
