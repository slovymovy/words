                                    {
                                        "sense_id": "af40ba32-86a5-3dd0-a1df-8bd5f3b384b9",
                                        "entry_id": "9da2ce60-3424-3b77-bb29-66baf5a5837c",
                                        "glosses": [
                                            "Rendre plus profond, creuser plus avant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c00b13cb-05ae-4abc-ba53-c0e9ccce5296",
                                                "sense_id": "af40ba32-86a5-3dd0-a1df-8bd5f3b384b9",
                                                "text": "Approfondir un puits qui n’a pas assez d’eau."
                                            },
                                            {
                                                "example_id": "46bd7b0c-0581-4209-bc28-1b1313f61b9f",
                                                "sense_id": "af40ba32-86a5-3dd0-a1df-8bd5f3b384b9",
                                                "text": "Il ne faut pas les approfondir davantage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c80ff101-0237-30ea-a0a0-c97bb531dacc",
                                        "entry_id": "9da2ce60-3424-3b77-bb29-66baf5a5837c",
                                        "glosses": [
                                            "étudier à fond."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e8c74d5-02bc-4107-9bad-6ce743e4080a",
                                                "sense_id": "c80ff101-0237-30ea-a0a0-c97bb531dacc",
                                                "text": "Il a approfondi cette science."
                                            },
                                            {
                                                "example_id": "19258743-ca6b-4222-8208-e50b6a9f7ed7",
                                                "sense_id": "c80ff101-0237-30ea-a0a0-c97bb531dacc",
                                                "text": "Approfondir une question, une matière, un sujet d’ouvrage."
                                            },
                                            {
                                                "example_id": "8d9c389e-c6ce-4514-8769-282efb6cde6c",
                                                "sense_id": "c80ff101-0237-30ea-a0a0-c97bb531dacc",
                                                "text": "Un examen approfondi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccfcf35e-2787-3e51-8571-d6fe18bc0161",
                                        "entry_id": "9da2ce60-3424-3b77-bb29-66baf5a5837c",
                                        "glosses": [
                                            "Devenir plus profond."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a90dab0-64c3-44d2-b01f-4b614485aea1",
                                                "sense_id": "ccfcf35e-2787-3e51-8571-d6fe18bc0161",
                                                "text": "La crevasse s’approfondit chaque hiver."
                                            },
                                            {
                                                "example_id": "67012e0e-f1ca-4768-96ad-e6dd5659de6e",
                                                "sense_id": "ccfcf35e-2787-3e51-8571-d6fe18bc0161",
                                                "text": "Il est nécessaire de s’approfondir soi-même pour bien se connaître."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
