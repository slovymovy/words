                        "glosses": [
                            "The state of being a colt; the youth of a (male) horse."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bdc8b2cd-1d4a-4971-94d3-842be3e4a96c",
                                "sense_id": "9d51bbe6-ff54-3f6c-8c18-a4ffd9251e7a",
                                "text": "Their ruddy faces and somewhat cumbrous forms belong to the animal period of life that links together boyhood, colthood and calfhood."
                            },
                            {
                                "example_id": "3c4c059c-fea3-4c1a-8113-fd038f661460",
                                "sense_id": "9d51bbe6-ff54-3f6c-8c18-a4ffd9251e7a",
                                "text": "She had a vague notion that all horses nowadays were trained from their colthood to buck--whatever that was."
                            },
                            {
                                "example_id": "1197590d-c482-479c-ae62-8dd021b3d8b8",
                                "sense_id": "9d51bbe6-ff54-3f6c-8c18-a4ffd9251e7a",
                                "text": "In the old days of his colthood, a barelegged boy used to come into the pasture and jump on his bare back."
                            }
                        ]
                    }
