                        "entry_id": "36528278-5cd2-3528-9616-c0d611d1a6ef",
                        "glosses": [
                            "längliche Frucht, eine Gurke, die in Stücke geschnitten in einer Lake aus Wasser, Essig und Gewürzen (Senfkörnern) eingelegt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93a09d6d-cd9d-437f-9da0-73b8dbb752f0",
                                "sense_id": "936cdca1-b61f-3eed-98a3-102789bd5aaa",
                                "text": "Eine grüne Gurke mit festem Fleisch und wenig Kernen ist gut geeignet, um daraus Senfgurken herzustellen."
                            },
                            {
                                "example_id": "1c75c950-fafb-4291-bf47-ed19f3721d23",
                                "sense_id": "936cdca1-b61f-3eed-98a3-102789bd5aaa",
                                "text": "„Ich deutete auf eine Senfgurke.“"
                            }
                        ],
