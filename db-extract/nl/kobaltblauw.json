                                "sense_id": "f3b7bd21-7855-3bea-bd27-66d62fc89232",
                                "text": "De zijkant was een egaal kobaltblauw vlak."
                            },
                            {
                                "example_id": "e871238c-e36e-47e2-b54a-d38cad02df12",
                                "sense_id": "f3b7bd21-7855-3bea-bd27-66d62fc89232",
                                "text": "Hij rijdt in een kobaltblauwe auto."
                            }
                        ]
