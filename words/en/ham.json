                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in a slightly derogatory or humorous way"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Актер или исполнитель, который переигрывает или использует преувеличенный, показной стиль.",
                        "zh": "表演夸张、做作，喜欢卖弄的演员或表演者。"
