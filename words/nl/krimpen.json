                            "trait_type": "form",
                            "comment": "nautical or meteorological context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the gradual change of wind direction in a counter-clockwise direction"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "back",
                                "target_lang_sense_clarification": "of wind, to shift counter-clockwise"
