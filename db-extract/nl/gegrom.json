                    },
                    {
                        "translation_id": "bd05a9fa-4f6b-49e6-bf55-b64ee5bb7fc2",
                        "source_entry_id": "720666b7-fd45-36a1-aeae-dcebce0a4424",
                        "source_sense_id": "710ec871-9720-33e7-80fe-52c8ee60aaa7",
                        "source_sense_description": "brommend geluid voortbrengen",
                        "target_lang_word": "snarling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snarling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e7f47df-8ac6-31bd-9953-df1d4fe300ff",
                                        "entry_id": "6282d8a4-a213-371b-af8c-9ca7e556014a",
                                        "glosses": [
                                            "Growling, having a snarl."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fe3d1ac-db7c-41b9-b264-54a346e64b53",
                                                "sense_id": "3e7f47df-8ac6-31bd-9953-df1d4fe300ff",
                                                "text": "The snarling dog scared me away without ever opening its mouth."
                                            },
                                            {
                                                "example_id": "3329e9a9-8329-4995-b685-ffab75fc934f",
                                                "sense_id": "3e7f47df-8ac6-31bd-9953-df1d4fe300ff",
                                                "text": "Mr. Trump’s campaign of retribution began to intensify in mid-July after an adviser stoked his snarling impatience over the slow pace of Justice Department investigations."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "snarling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29df77bb-f3eb-3193-8033-cf29a29936ea",
                                        "entry_id": "e596d112-cda8-392f-9cb7-b8dfc72d8bca",
                                        "glosses": [
                                            "The act of producing a snarl or growl."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3355b68-3d64-421a-b1e0-f00929f7ddc9",
                                                "sense_id": "29df77bb-f3eb-3193-8033-cf29a29936ea",
                                                "text": "When dogs fight, there are usually preliminaries to the actual combat — snarlings and bristlings and stiff-legged struttings. But White Fang learned to omit these preliminaries."
                                            }
                                        ]
                                    }
                                ]
                            },
