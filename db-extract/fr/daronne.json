                ],
                "senses": [
                    {
                        "sense_id": "9a26a6d8-f16c-3bb7-87c2-80a92dc12128",
                        "entry_id": "13a6a874-b3e0-3e52-ae9c-1371f56bf0ce",
                        "glosses": [
                            "Mère."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "7ee4ddac-ae08-4459-80c5-1f4538dc4afa",
                                "sense_id": "9a26a6d8-f16c-3bb7-87c2-80a92dc12128",
                                "text": "Le mec, c’était un petit nougat blanc tout bridé de la tronche avec une voix de vieille daronne, tout futé, menu, il portait aussi une robe de soie à ramages, et des babouches sur planchettes, enfin le véritable magot, sauf le chapeau mou…"
                            },
                            {
                                "example_id": "3f3efc2c-eb96-4bc2-83e4-5d6f80ee7320",
                                "sense_id": "9a26a6d8-f16c-3bb7-87c2-80a92dc12128",
                                "text": "Ma daronne m'a avancé la thune pour le billet. Elle aurait fait portnawak pour que je taffe. Portnawak pour que j'arrête de glander à la téci."
                            },
                            {
                                "example_id": "d2822e10-3727-4215-8a95-d1b398a056bf",
                                "sense_id": "9a26a6d8-f16c-3bb7-87c2-80a92dc12128",
                                "text": "Remember le gratin de chou-fleur à la béchamel de la daronne ou du lycée."
                            },
                            {
                                "example_id": "56a87aad-5b42-4902-9385-70e0bf804a5d",
                                "sense_id": "9a26a6d8-f16c-3bb7-87c2-80a92dc12128",
                                "text": "Et vos daronnes ils boivent du Sprite sa mère"
                            }
                        ]
                    },
                    {
                        "sense_id": "99c3043f-f3ec-3e55-913b-7619a0982d5c",
                        "entry_id": "13a6a874-b3e0-3e52-ae9c-1371f56bf0ce",
                        "glosses": [
                            "Patronne ou épouse du daron, patron."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "05da7b2d-13f2-4135-adb1-829dc6fdf2c1",
                                "sense_id": "99c3043f-f3ec-3e55-913b-7619a0982d5c",
                                "text": "C’est une fille qui arrive de Paris, où elle sert chez un avocat, frère de nos daronnes, Mᵐᵉ Minon et Mᵐᵉ Parangon."
                            }
                        ]
                    }
                ],
