                "senses": [
                    {
                        "sense_id": "ec947a12-beb9-3960-b80c-1c71e64d0358",
                        "entry_id": "1072b249-f34f-382e-a0dd-b9190181b67b",
                        "glosses": [
                            "Erwerbstätigkeit der Jugendlichen"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "f28f085e-74cd-4550-965a-0f2475c620a7",
                                "sense_id": "ec947a12-beb9-3960-b80c-1c71e64d0358",
                                "text": "In der Jugendarbeit gibt es eine Vielzahl von Schutzvorschriften zugunsten der Jugendlichen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cfd877d5-1a15-3c53-b665-0ee4a9e19159",
                        "entry_id": "1072b249-f34f-382e-a0dd-b9190181b67b",
                        "glosses": [
                            "sämtliche Tätigkeiten, die von Staat, Kirche, Gewerkschaften und anderen Organisationen zugunsten von Jugendlichen ausgeführt werden"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "fccd8e15-01a6-4b55-a018-c9d4ea5a4672",
                                "sense_id": "cfd877d5-1a15-3c53-b665-0ee4a9e19159",
                                "text": "Die Mittel für die Jugendarbeit wurden gekürzt."
                            },
                            {
                                "example_id": "75090b4c-0f51-492f-880e-25742609bee2",
                                "sense_id": "cfd877d5-1a15-3c53-b665-0ee4a9e19159",
                                "text": "„Hier, auf dem Gebiet des Theaters wie auch auf dem Gebiete des Films, ist bisher viel zuwenig in Bezug auf die Jugend und Jugendarbeit getan und erreicht worden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e016ac1c-6ce4-3949-9701-88f8d2d3a9ce",
                        "entry_id": "1072b249-f34f-382e-a0dd-b9190181b67b",
                        "glosses": [
                            "Werk, das während der Jugendzeit etwa eines Künstlers, eines Wissenschaftlers oder eines Handwerkers angefertigt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c6078de-a11c-4a66-a6a3-a82591b8f70f",
                                "sense_id": "e016ac1c-6ce4-3949-9701-88f8d2d3a9ce",
                                "text": "Dieses Museum zeigt einige Jugendarbeiten eines berühmten Holzschnitzers aus dem 19. Jahrhundert."
                            },
                            {
                                "example_id": "bb8d480b-984c-4b40-81eb-70a12e157d6b",
                                "sense_id": "e016ac1c-6ce4-3949-9701-88f8d2d3a9ce",
                                "text": "An seiner Jugendarbeit, seinem ersten Roman, gefällt dem Autor heute nicht einmal mehr der Titel, geschweige denn der Inhalt."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
