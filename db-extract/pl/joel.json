                    {
                        "translation_id": "24e91dab-3f3c-4dac-a232-13fe308ca2cc",
                        "source_entry_id": "691e0d07-898f-39c7-958e-679209068c02",
                        "source_sense_id": "5041c1e3-ed0d-39a0-94f9-c9c7651b912a",
                        "target_lang_word": "Joël",
