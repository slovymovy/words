                "senses": [
                    {
                        "sense_id": "62cbfa02-bce2-3d03-8c5b-b28541e09eda",
                        "entry_id": "78d57591-cbaf-3950-8489-760bc3f71b1d",
                        "glosses": [
                            "Very bright (as if to cause blindness)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91aef17a-3ed1-4fcf-b0d1-8dbe901f91ea",
                                "sense_id": "62cbfa02-bce2-3d03-8c5b-b28541e09eda",
                                "text": "On it came, and with it came the glorious blinding cloud of many-coloured light, and stood before us for a space, turning, as it seemed to us, slowly round and round, and then, accompanied by its attendant pomp of sound, passed away I know not whither."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c23dd11-74a8-39f4-97b2-1ef8fd2f7780",
                        "entry_id": "78d57591-cbaf-3950-8489-760bc3f71b1d",
                        "glosses": [
                            "Making blind or as if blind; depriving of sight or of understanding."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf4d8dde-8cc7-467f-ac3a-576e98ac8d67",
                                "sense_id": "9c23dd11-74a8-39f4-97b2-1ef8fd2f7780",
                                "text": "blinding tears;  blinding snow"
                            },
                            {
                                "example_id": "99f55e4a-fc9d-4132-bdff-bbf126f79738",
                                "sense_id": "9c23dd11-74a8-39f4-97b2-1ef8fd2f7780",
                                "text": "Turning back, then, toward the basement staircase, she began to grope her way through blinding darkness, but had taken only a few uncertain steps when, of a sudden, she stopped short and for a little stood like a stricken thing, quite motionless save that she quaked to her very marrow in the grasp of a great and enervating fear."
                            }
                        ]
                    },
                    {
                        "sense_id": "c509d8de-d743-3713-badb-164a984a5c59",
                        "entry_id": "78d57591-cbaf-3950-8489-760bc3f71b1d",
                        "glosses": [
                            "Brilliant; marvellous."
                        ],
                        "tags": [
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "85206418-e51e-41dc-a7fc-d7ed01501513",
                                "sense_id": "c509d8de-d743-3713-badb-164a984a5c59",
                                "text": "“How’s it going?” “Blinding, mate.”"
                            }
                        ]
                    }
                ],
