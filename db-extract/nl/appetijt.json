                "translations": [
                    {
                        "translation_id": "f49da40e-8ec6-4f3d-82a6-ff3ca66cc476",
                        "source_entry_id": "afc75cd8-a3e2-31d1-8a99-2493d36b0ca8",
                        "source_sense_id": "4fb7df22-22ef-3444-8027-b4e303b840e6",
                        "source_sense_description": "eetlust",
                        "target_lang_word": "appetite",
                        "target_lang_code": "en",
