                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca4d495b-7744-3536-ad43-ae89d7a0a18a",
                                        "entry_id": "5b795a4c-8793-3eef-bb8c-150bf777a472",
                                        "glosses": [
                                            "A staff topped with a conical ornament, carried by Bacchus or his followers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "256d5b3a-f106-4eeb-af37-84aa29a9d9fd",
                                                "sense_id": "ca4d495b-7744-3536-ad43-ae89d7a0a18a",
                                                "text": "1882, Henry Wadsworth Longfellow, The Poet's Calendar\nIn my hand I bear / The thyrsus, tipped with fragrant cones of pine."
                                            },
                                            {
                                                "example_id": "61aa5fd8-da2b-4f88-b766-522015b304f0",
                                                "sense_id": "ca4d495b-7744-3536-ad43-ae89d7a0a18a",
                                                "text": "As good to grow on graves / As twist about a thyrsus."
                                            },
                                            {
                                                "example_id": "18f439dd-984d-47a2-a38a-c6fe067ace8a",
                                                "sense_id": "ca4d495b-7744-3536-ad43-ae89d7a0a18a",
                                                "text": "The champagne was done, and she upturned the bottle to hold it like a thyrsus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cefe76fd-6821-3809-9ef9-f6bac787060a",
                                        "entry_id": "5b795a4c-8793-3eef-bb8c-150bf777a472",
                                        "glosses": [
                                            "A species of inflorescence; a dense panicle, as in the lilac and horse-chestnut."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
