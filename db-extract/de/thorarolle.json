                        "sense_id": "2eea0226-5fb4-3bb3-b88b-0e7085585a1c",
                        "entry_id": "2a19355f-be31-3d82-b32c-4a9c72df6af9",
                        "glosses": [
                            "aufgerolltes beschriebenes Material mit dem Text des bedeutendsten der drei Hauptteile des Tanach, welcher die fünf Bücher Mose umfasst, der Tora/Thora"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b198d68-30d1-4a5b-9ed5-2d33f1871e14",
                                "sense_id": "2eea0226-5fb4-3bb3-b88b-0e7085585a1c",
                                "text": "„Die Thorarollen waren nach besonderen Gesetzmäßigkeiten und Regeln geschrieben, sie durften weder verletzt, beschädigt oder fehlerhaft sein.“"
                            },
                            {
                                "example_id": "f12190ba-5a5c-4067-a98e-da5aed055e10",
                                "sense_id": "2eea0226-5fb4-3bb3-b88b-0e7085585a1c",
                                "text": "„Sehr verschieden ist die Länge der zu einer Rolle zusammengenähten Blätter; ebenso die Breite, die 78 cm bei der größten mir bekannten Thorarolle aus Pergament, 5 cm bei der kleinsten von mir gesehnen Megilla betrug.“"
                            }
                        ],
