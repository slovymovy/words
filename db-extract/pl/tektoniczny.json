                        "entry_id": "3edd7125-202b-307e-91a2-9310eee04da9",
                        "glosses": [
                            "związany z tektoniką, odnoszący się do tektoniki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "543f415f-3ba2-4a78-a004-97672ca0f3e9",
                                "sense_id": "d3e04df6-5ed0-34e3-b455-a2a6ee6c37cc",
                                "text": "Skorupa ziemska składa się z kilkunastu wielkich płyt tektonicznych."
                            },
                            {
                                "example_id": "7283b139-475f-47a3-b2d7-7193a0bdc1bc",
                                "sense_id": "d3e04df6-5ed0-34e3-b455-a2a6ee6c37cc",
                                "text": "Trzęsienie ziemi może powstać wskutek zderzenia dwóch płyt tektonicznych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d1a822e-c905-4c93-90fe-c96a5dd7e6d8",
                        "source_entry_id": "3edd7125-202b-307e-91a2-9310eee04da9",
                        "source_sense_id": "d3e04df6-5ed0-34e3-b455-a2a6ee6c37cc",
