                        "glosses": [
                            "Feier anlässlich der Thronbesteigung eines Monarchen oder einer Monarchin, wenn sich das Datum der Thronbesteigung jährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0be76642-acf6-46e4-a688-7c4914fcb930",
                                "sense_id": "449afea1-b04d-3ebf-b16e-c2466dc0a5ac",
                                "text": "„König Bhumipol aus der seit 1782 regierenden Chakri-Dynastie, der 2006 sein 60-jähriges Thronjubiläum feierte, verfügt dank seines Ansehens in der Bevölkerung über innenpolitischen Einfluss, der weit über seine verfassungsmäßigen Rechte hinausgeht.“"
                            },
                            {
                                "example_id": "c2a79c9b-f221-41c4-a989-8cc373dd6130",
                                "sense_id": "449afea1-b04d-3ebf-b16e-c2466dc0a5ac",
                                "text": "„Als Akbar nur wenige Wochen vor seinem 50. Thronjubiläum 1605 starb, wurde sein Sohn Selim neuer Großmogul.“"
                            }
                        ],
