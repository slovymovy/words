                        "glosses": [
                            "Any of many (often decorative) trees, shrubs and woody vines, of the genus Euonymus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c593685f-2ba5-4061-9f8d-ef5b7a1063b0",
                                "sense_id": "d2453b6e-5f7a-38e9-a743-22d09dbd1cb6",
                                "text": "Her father's euonymus shines as we walk,\nAnd swing past the summer-house, buried in talk,\nAnd cool the verandah that welcomes us in\nTo the six-o'clock news and a lime-juice and gin."
                            }
                        ]
                    }
