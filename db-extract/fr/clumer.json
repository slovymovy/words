                "senses": [
                    {
                        "sense_id": "6b81fdb3-484d-321c-8ca4-17d12ed53137",
                        "entry_id": "fa73e14f-74f4-3808-b96a-f27998575aef",
                        "glosses": [
                            "Faire la sieste, s’endormir dans la journée."
                        ],
                        "tags": [
                            "Aquitaine"
                        ],
                        "examples": [
                            {
                                "example_id": "3fdddea6-c4b8-4e7b-8dbc-a6092ca56611",
                                "sense_id": "6b81fdb3-484d-321c-8ca4-17d12ed53137",
                                "text": "Elle souffrit de la sieste qu’elle ne savait plus faire et compta les longues heures de silence de l’après-midi … Un mois dut passer avant qu’elle ne se prenne enfin à clumer au beau milieu d’une page décisive."
                            }
                        ]
                    },
                    {
                        "sense_id": "660b2b68-2384-377c-a02b-6fdb08e621bb",
                        "entry_id": "fa73e14f-74f4-3808-b96a-f27998575aef",
                        "glosses": [
                            "Dans le jeu de cache-cache, compter jusqu’à dix (ou plus) pendant que les autres joueurs vont se cacher."
                        ],
                        "tags": [
                            "Aquitaine"
                        ],
                        "examples": [
                            {
                                "example_id": "a354f3a3-f686-4830-ba42-def986a1c981",
                                "sense_id": "660b2b68-2384-377c-a02b-6fdb08e621bb",
                                "text": "Tu clumes ! : injonction, de la part des autres joueurs, envers celui qui devra les trouver une fois qu'ils seront cachés."
                            }
                        ]
                    }
                ],
