                        "translation_id": "74b0b43e-1227-433d-b712-32e0f39749db",
                        "source_entry_id": "37fab380-d481-3151-a5c4-c6c3efc3566a",
                        "source_sense_description": "тот, кто снимает у кого-либо на определённых условиях жилое помещение, квартиру для временного проживания",
                        "target_lang_word": "Mieter",
                        "target_lang_code": "de",
