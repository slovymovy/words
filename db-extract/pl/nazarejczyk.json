                "senses": [
                    {
                        "sense_id": "54391a60-0504-3d8c-b815-1807cbb8dc8f",
                        "entry_id": "4366e03b-9b17-325c-824b-da74328f6cf4",
                        "glosses": [
                            "Jezus Chrystus"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "abecc9eb-7f22-45de-87e2-75b3b0f27f97",
                                "sense_id": "54391a60-0504-3d8c-b815-1807cbb8dc8f",
                                "text": "Tak miało się spełnić słowo Proroków: Nazwany będzie Nazarejczykiem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5bf7faa2-c9a0-3bce-a872-ac1f551fd902",
                        "entry_id": "4366e03b-9b17-325c-824b-da74328f6cf4",
                        "glosses": [
                            "określenie chrześcijanina stosowane przez żydów"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "29facb5b-25b8-484c-a1dd-0ab568be5bd9",
                                "sense_id": "5bf7faa2-c9a0-3bce-a872-ac1f551fd902",
                                "text": "Stwierdziliśmy, że człowiek ten jest przywódcą sekty nazarejczyków, szerzy zarazę i wzbudza niepokoje wśród wszystkich Żydów na świecie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "cd8c5f38-4178-3202-bef2-5b3192f90e34",
                        "entry_id": "4366e03b-9b17-325c-824b-da74328f6cf4",
                        "glosses": [
                            "członek sekty judeochrześcijańskiej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a45a8c9-6976-4817-9922-be938121baf2",
                                "sense_id": "cd8c5f38-4178-3202-bef2-5b3192f90e34",
                                "text": "Opis nazarejczyków z IV wieku podaje Epifaniusz z Salaminy."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "f958f0ed-d391-3d11-8c59-92ff9bcab297",
                        "entry_id": "4366e03b-9b17-325c-824b-da74328f6cf4",
