                ],
                "senses": [
                    {
                        "sense_id": "cab8f087-186c-3dcd-8e09-1a763bed7750",
                        "entry_id": "8053578b-8833-325b-b7f7-4100f1043cd7",
                        "glosses": [
                            "Bewegung von Personen und Gütern mit Straßen- oder Schienenfahrzeugen oder Binnenschiffen über kurze Strecken"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "a0496cad-8d14-4d7c-9632-e37b1f34b80c",
                                "sense_id": "cab8f087-186c-3dcd-8e09-1a763bed7750",
                                "text": "Die Privatinvestoren müssten bei Laune gehalten werden, indem der teilprivatisierte DB-Fernverkehr entlastet werde - zu Lasten der Nahverkehre, für die die Bundesländer geradestehen müssen."
                            },
                            {
                                "example_id": "be01ff95-a76a-4692-be3b-8f7cbb75886e",
                                "sense_id": "cab8f087-186c-3dcd-8e09-1a763bed7750",
                                "text": "Paris bekommt ab Juni auch eine Fährverbindung im öffentlichen Nahverkehr."
                            },
                            {
                                "example_id": "d4ebf246-a5cf-4e1f-bc64-0a8c1d2ec4ea",
                                "sense_id": "cab8f087-186c-3dcd-8e09-1a763bed7750",
                                "text": "„An einem Kiosk kaufe ich mir eine Dreitageskarte für den öffentlichen Nahverkehr.“"
                            },
                            {
                                "example_id": "20d9a1b3-7d6e-41b2-8609-d9aea4da9a3c",
                                "sense_id": "cab8f087-186c-3dcd-8e09-1a763bed7750",
                                "text": "„So sah es das Amtsgericht in Bonn angesichts eines Streitfalles im öffentlichen Nahverkehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
