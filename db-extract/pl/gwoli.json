            {
                "entry_id": "a2517d3a-1eec-3bf2-8fd3-eef85dea5041",
                "word": "gwoli",
                "pos": "prep",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8b0e56fb-8204-3e84-9600-8887d751139a",
                        "entry_id": "a2517d3a-1eec-3bf2-8fd3-eef85dea5041",
                        "glosses": [
                            "przyimek wskazujący na cel czynności lub przyczynę jej wykonania"
                        ],
                        "tags": [
                            "elevatedly",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "22e494b6-72aa-44a6-8a47-1aa17d9ad3d3",
                                "sense_id": "8b0e56fb-8204-3e84-9600-8887d751139a",
                                "text": "Nie sporządził protokołu gwoli zasady, lecz z czystej chęci zemsty."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "221214e0-96af-3317-9c9d-4aa60847d98e",
                        "entry_id": "a2517d3a-1eec-3bf2-8fd3-eef85dea5041",
                        "glosses": [
                            "według woli, zgodnie z wolą"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "483ad881-cb70-4738-85ac-7a90880be2b8",
                                "sense_id": "221214e0-96af-3317-9c9d-4aa60847d98e",
                                "text": "Gwoli pani matki wyjdziem z paniczem na przechadzkę przy ruczaju."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9760fc66-682f-48f5-a4ec-39e993138ff7",
                        "source_entry_id": "a2517d3a-1eec-3bf2-8fd3-eef85dea5041",
                        "source_sense_id": "8b0e56fb-8204-3e84-9600-8887d751139a",
                        "target_lang_word": "because of",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "because of",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "745480bd-b00c-3f95-84e5-e38ee20e1f3d",
                                        "entry_id": "a1da993f-3358-32c3-b7e1-93a159e6cce6",
                                        "glosses": [
                                            "On account of; due to, for the purpose of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75770620-24b4-453c-872c-8781c65cb488",
                                                "sense_id": "745480bd-b00c-3f95-84e5-e38ee20e1f3d",
                                                "text": "Because of being tired, she left earlier than the rest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3af5faf-8bad-4b34-9511-dc3f32b59f5f",
                        "source_entry_id": "a2517d3a-1eec-3bf2-8fd3-eef85dea5041",
                        "source_sense_id": "8b0e56fb-8204-3e84-9600-8887d751139a",
                        "target_lang_word": "willen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "willen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d4278b3-d7b1-33de-98af-b13bfd662c22",
                                        "entry_id": "04f271f2-0a40-3fab-8147-c57d8ac30ccf",
                                        "glosses": [
                                            "wegen etwas"
                                        ],
                                        "tags": [
                                            "mit Genitiv",
                                            "nur in fester Verbindung „um … willen“"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce6f3ba2-7dfb-4517-8118-b4e5ba8f5870",
                                                "sense_id": "2d4278b3-d7b1-33de-98af-b13bfd662c22",
                                                "text": "„Oft allerdings nicht als Söldner um des Geldes willen, sondern aus Überzeugung.“"
                                            },
                                            {
                                                "example_id": "6a0ed9b1-bfd3-4d7f-a75f-05becdce7000",
                                                "sense_id": "2d4278b3-d7b1-33de-98af-b13bfd662c22",
                                                "text": "„Wären Sie auch bereit, in Kauf zu nehmen, wie Schröder als Regierungschef um der Reformen willen abgewählt zu werden?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1eafadce-64b7-4a36-8143-5fb96d813a53",
                        "source_entry_id": "a2517d3a-1eec-3bf2-8fd3-eef85dea5041",
                        "source_sense_id": "8b0e56fb-8204-3e84-9600-8887d751139a",
                        "target_lang_word": "ради",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ради",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "695e6519-818f-352c-a22c-65bdcb5424b0",
                                        "entry_id": "85494026-1560-3909-80a3-9205612216f9",
                                        "glosses": [
                                            "для кого-либо или чего-либо, в интересах кого-либо или чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8db9bd05-82a6-4042-a470-0162ab3ef8c3",
                                                "sense_id": "695e6519-818f-352c-a22c-65bdcb5424b0",
                                                "text": "Он сделал это ради любимой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cc3cf7e-2c96-3829-80cb-fa84d376e5c3",
                                        "entry_id": "85494026-1560-3909-80a3-9205612216f9",
                                        "glosses": [
                                            "во имя кого-либо или чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dceafe96-ac52-42ae-81d2-2b827e3abec0",
                                                "sense_id": "4cc3cf7e-2c96-3829-80cb-fa84d376e5c3",
                                                "text": "Григорий Иваныч, ну да займитесь же мною бога ради!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e24f8c98-b232-3f98-a0bb-230ffbc8be3c",
                                        "entry_id": "85494026-1560-3909-80a3-9205612216f9",
                                        "glosses": [
                                            "с целью чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ea129a4-157a-40ba-8279-3116f49c8386",
                                                "sense_id": "e24f8c98-b232-3f98-a0bb-230ffbc8be3c",
                                                "text": "К этому прибавляли, в виде современной характеристики нравов, что бестолковый молодой человек действительно любил свою невесту, генеральскую дочь, но отказался от неё единственно из нигилизма и ради предстоящего скандала."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20728de8-f245-3a6f-b89a-13fb26b56507",
                                        "entry_id": "85494026-1560-3909-80a3-9205612216f9",
                                        "glosses": [
                                            "из-за, по причине"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d48b922-d33d-4fd4-994b-c14344910e86",
                                                "sense_id": "20728de8-f245-3a6f-b89a-13fb26b56507",
                                                "text": "Другая сестра, Соня, девочка шести лет, с кудрявой головкой и с цветом лица, какой бывает только у очень здоровых детей, у дорогих кукол и на бонбоньерках, играет в лото ради процесса игры."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0beaef3-d934-41ef-a104-fc767a3122d7",
                        "source_entry_id": "a2517d3a-1eec-3bf2-8fd3-eef85dea5041",
                        "source_sense_id": "8b0e56fb-8204-3e84-9600-8887d751139a",
                        "target_lang_word": "из-за",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "из-за",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0c82dc28-dffe-340b-a17a-384d13864cd1",
                                        "entry_id": "c855a9db-0b9b-3948-b16f-a2b59df1f209",
                                        "glosses": [
                                            "соединяя в себе значения предлогов «из» и «за», обозначает направление действия или движения откуда-либо и притом с обратной или с другой, противоположной, стороны чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a2124f0-62ea-4015-90d3-ba679d8ab113",
                                                "sense_id": "0c82dc28-dffe-340b-a17a-384d13864cd1",
                                                "text": "Смотреть из-за двери."
                                            },
                                            {
                                                "example_id": "af2059eb-b9ee-4d5c-a42a-5a9547a0e2a8",
                                                "sense_id": "0c82dc28-dffe-340b-a17a-384d13864cd1",
                                                "text": "Из-за стены слышны голоса."
                                            },
                                            {
                                                "example_id": "347a9f57-65d7-4bd9-9493-0c42a33b51c2",
                                                "sense_id": "0c82dc28-dffe-340b-a17a-384d13864cd1",
                                                "text": "Выскочить из-за угла."
                                            },
                                            {
                                                "example_id": "ea962dcc-c7d4-4c79-8110-1f615412f928",
                                                "sense_id": "0c82dc28-dffe-340b-a17a-384d13864cd1",
                                                "text": "Из-за облака опять выплыла луна."
                                            },
                                            {
                                                "example_id": "f3ba5d99-b353-4f89-877f-85cf1b2f82fd",
                                                "sense_id": "0c82dc28-dffe-340b-a17a-384d13864cd1",
                                                "text": "Приехал из-за мо́ря."
                                            },
                                            {
                                                "example_id": "3ffbe1f7-7dec-4b5b-b341-a64cc6dd1ccf",
                                                "sense_id": "0c82dc28-dffe-340b-a17a-384d13864cd1",
                                                "text": "Из-за границы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79e7193f-c3a7-3254-94c6-b38a803a8316",
                                        "entry_id": "c855a9db-0b9b-3948-b16f-a2b59df1f209",
                                        "glosses": [
                                            "употребляется для обозначения движения от какого-либо предмета, около которого кто-либо находился для какого-нибудь дела, занятия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b60881c1-c8c5-43b0-9a91-12255a82da95",
                                                "sense_id": "79e7193f-c3a7-3254-94c6-b38a803a8316",
                                                "text": "Встать из-за стола, рояля."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44ffc8a8-03cf-3631-a304-4c1a7bcac157",
                                        "entry_id": "c855a9db-0b9b-3948-b16f-a2b59df1f209",
                                        "glosses": [
                                            "вследствие, по причине, по вине"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77a2a583-46b4-4381-9c14-ba0dd4930ed2",
                                                "sense_id": "44ffc8a8-03cf-3631-a304-4c1a7bcac157",
                                                "text": "Мы опоздали из-за дождя."
                                            },
                                            {
                                                "example_id": "040e0b00-0f2b-4e8d-a106-291f07f61516",
                                                "sense_id": "44ffc8a8-03cf-3631-a304-4c1a7bcac157",
                                                "text": "Разошлись из-за пустяков."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddad7677-7eae-33a6-8ddd-f3b0a2b01edf",
                                        "entry_id": "c855a9db-0b9b-3948-b16f-a2b59df1f209",
                                        "glosses": [
                                            "употребляется для указания лица, которое является виновником, причиной чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b58dd540-6d7e-464c-b057-79302aeabb11",
                                                "sense_id": "ddad7677-7eae-33a6-8ddd-f3b0a2b01edf",
                                                "text": "Только из-за тебя мы опоздали."
                                            },
                                            {
                                                "example_id": "f882edd3-959b-4f69-a371-8c94ad322a51",
                                                "sense_id": "ddad7677-7eae-33a6-8ddd-f3b0a2b01edf",
                                                "text": "Из-за тебя нас могут отсюда выгнать."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0d14fe0-43c2-4eb7-a336-affbc966218a",
