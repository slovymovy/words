                "translations": [
                    {
                        "translation_id": "0f11a60e-ffae-484b-a4bf-619c5f6c9fe8",
                        "source_entry_id": "a7ba900b-36da-36d2-bd73-fdb8bbc99acd",
                        "source_sense_id": "e770ee45-93e4-3acb-9100-a51ce6ffcc5c",
                        "source_sense_description": "genaue Beschreibung, die etwas eingrenzt",
                        "target_lang_word": "précision",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "précision",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ffac234-3057-3bbd-b98a-21b5b5a9f64f",
                                        "entry_id": "ee3d679f-a7e8-30b5-b3fe-440300da5538",
                                        "glosses": [
                                            "Recherche d'exactitude de netteté dans la pensée et dans l’expression, par accumulation de détails, de distinctions, d'explications, de preuves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "875b0399-406b-4b37-984f-2d8b591ecc13",
                                                "sense_id": "3ffac234-3057-3bbd-b98a-21b5b5a9f64f",
                                                "text": "C’est un homme qui s’exprime, qui écrit avec une grande précision."
                                            },
                                            {
                                                "example_id": "883dd7e2-c505-45f5-9be1-be357cb40dc8",
                                                "sense_id": "3ffac234-3057-3bbd-b98a-21b5b5a9f64f",
                                                "text": "Cet ouvrage est un modèle de précision."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fd053eb-4fa4-3836-b166-7c1166e9b8e5",
                                        "entry_id": "ee3d679f-a7e8-30b5-b3fe-440300da5538",
                                        "glosses": [
                                            "Justesse ; exactitude dans l’action ; détermination stricte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82d165b1-98d1-497b-959f-71c91fff4d62",
                                                "sense_id": "8fd053eb-4fa4-3836-b166-7c1166e9b8e5",
                                                "text": "— Voici la mairie ! dit Omer. Nous ne nous sommes pas pressés ; nous n’avons demandé de renseignements à personne, et nous arrivons avec la précision d’une éclipse."
                                            },
                                            {
                                                "example_id": "9cee8e9d-8dce-4dc3-9b6b-47531f68a167",
                                                "sense_id": "8fd053eb-4fa4-3836-b166-7c1166e9b8e5",
                                                "text": "Jusque-là, nous avions navigué avec une grande sûreté : le poste de Fernando de Noronha et le bâtiment Cigogne firent des relèvements avec beaucoup de précision."
                                            },
                                            {
                                                "example_id": "a68eb5db-f097-4eb1-b6da-8f8b741a8fc7",
                                                "sense_id": "8fd053eb-4fa4-3836-b166-7c1166e9b8e5",
                                                "text": "Le bruit du bombardement au-dessus de l’abri devient formidable. Les obus tombent sur la Chancellerie avec une précision inquiétante."
                                            },
                                            {
                                                "example_id": "5e0c0f5c-fa80-4fef-92f2-f8f871efbbd6",
                                                "sense_id": "8fd053eb-4fa4-3836-b166-7c1166e9b8e5",
                                                "text": "Les estimations furent faites avec toute la précision possible."
                                            },
                                            {
                                                "example_id": "50e6c5a8-b598-44d4-9958-c2a34d57959a",
                                                "sense_id": "8fd053eb-4fa4-3836-b166-7c1166e9b8e5",
                                                "text": "Il s’inclina devant les précisions qui lui étaient données."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97ce8db9-2b3b-323d-bd9e-ac59b5f04846",
                                        "entry_id": "ee3d679f-a7e8-30b5-b3fe-440300da5538",
                                        "glosses": [
                                            "Information supplémentaire pour préciser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "748e5f41-19c9-4ade-b08b-744f6f473de1",
                                                "sense_id": "97ce8db9-2b3b-323d-bd9e-ac59b5f04846",
                                                "text": "Je voudrais vous donner quelques précisions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f49b564-5fe3-3bae-88ea-f4dbd5fd7353",
                                        "entry_id": "ee3d679f-a7e8-30b5-b3fe-440300da5538",
                                        "glosses": [
                                            "En reconnaissance des formes et recherche documentaire, fraction des retours qui sont pertinents."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70532072-6a2c-3042-9fee-086f767cb081",
                                        "entry_id": "ee3d679f-a7e8-30b5-b3fe-440300da5538",
                                        "glosses": [
                                            "Mesure de l’aptitude à distinguer des valeurs très voisines. Étroitesse de l’accord entre les résultats obtenus en appliquant le procédé expérimental à plusieurs reprises dans des conditions déterminées."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ee0a266-02a1-4193-b32a-3d03507db06c",
                                                "sense_id": "70532072-6a2c-3042-9fee-086f767cb081",
                                                "text": "Il ne faut pas confondre précision et exactitude : une mesure précise permet d’obtenir un plus grand nombre de chiffres significatifs, mais peut très bien être erronée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfa8c448-11c7-3d56-818e-172dae4c1545",
                                        "entry_id": "ee3d679f-a7e8-30b5-b3fe-440300da5538",
                                        "glosses": [
                                            "Qualité d’une carte dont l’erreur cartographique est faible."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
