{
    "word_family": [
        "abatement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f80954fb-8e32-360d-88e6-261b3b584e54",
                    "sense_definition": "To decrease in force or intensity; to subside.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decrease_intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We waited in the shelter for several hours until the storm began to <w>abate</w>.",
                            "target_lang_translations": {
                                "cs": "Čekali jsme v úkrytu několik hodin, dokud bouře nezačala <w>polevovat</w>."
                            }
                        },
                        {
                            "text": "As the fever started to <w>abate</w>, the patient finally fell into a peaceful sleep.",
                            "target_lang_translations": {
                                "cs": "Jakmile horečka začala <w>ustupovat</w>, pacient konečně upadl do klidného spánku."
                            }
                        }
                    ],
                    "synonyms": [
                        "decline",
                        "ebb",
                        "slacken",
                        "soften",
                        "wane",
                        "decrease",
                        "lessen"
                    ],
                    "antonyms": [
                        "increase",
                        "intensify"
                    ],
                    "common_phrases": [
                        "storm began to abate",
                        "wind abated"
                    ],
                    "target_lang_definitions": {
                        "cs": "Ztrácet na síle nebo intenzitě; ustupovat."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "polevit",
                                "target_lang_sense_clarification": "snížit svou intenzitu (např. bouře, bolest)"
                            },
                            {
                                "target_lang_word": "zeslábnout",
                                "target_lang_sense_clarification": "ztratit na síle"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "190179b0-04dc-3338-aa01-f83127eff4e7",
                    "sense_definition": "To lessen (something) in force or intensity; to moderate.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decrease_intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nothing could <w>abate</w> his anger after he discovered the truth.",
                            "target_lang_translations": {
                                "cs": "Nic nemohlo <w>zmírnit</w> jeho hněv poté, co zjistil pravdu."
                            }
                        },
                        {
                            "text": "The new medicine helped to <w>abate</w> the severe pain in her joints.",
                            "target_lang_translations": {
                                "cs": "Nový lék pomohl <w>ztlumit</w> silnou bolest v jejích kloubech."
                            }
                        }
                    ],
                    "synonyms": [
                        "alleviate",
                        "assuage",
                        "diminish",
                        "mitigate",
                        "temper",
                        "ease",
                        "lessen"
                    ],
                    "antonyms": [
                        "aggravate",
                        "amplify",
                        "augment",
                        "foment",
                        "increase",
                        "intensify"
                    ],
                    "common_phrases": [
                        "abate the pain",
                        "abate the anger"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zmírnit nebo utlumit sílu či intenzitu něčeho."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zmírnit",
                                "target_lang_sense_clarification": "učinit méně intenzivním"
                            },
                            {
                                "target_lang_word": "ztlumit",
                                "target_lang_sense_clarification": "snížit intenzitu (např. bolesti, emocí)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "240196b6-ca60-31a4-a2bb-5461483619ff",
                    "sense_definition": "To reduce (something) in amount or size.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reduce_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company had to <w>abate</w> its production levels due to the sudden shortage of raw materials.",
                            "target_lang_translations": {
                                "cs": "Společnost musela <w>snížit</w> úroveň své produkce kvůli náhlému nedostatku surovin."
                            }
                        },
                        {
                            "text": "They agreed to <w>abate</w> the noise levels during the late evening hours.",
                            "target_lang_translations": {
                                "cs": "Dohodli se, že v pozdních večerních hodinách <w>omezí</w> hluk."
                            }
                        }
                    ],
                    "synonyms": [
                        "diminish",
                        "lower",
                        "decrease",
                        "lessen"
                    ],
                    "antonyms": [
                        "increase",
                        "enlarge"
                    ],
                    "common_phrases": [
                        "abate the noise"
                    ],
                    "target_lang_definitions": {
                        "cs": "Snížit množství nebo velikost něčeho."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "snížit",
                                "target_lang_sense_clarification": "redukovat množství nebo úroveň"
                            },
                            {
                                "target_lang_word": "omezit",
                                "target_lang_sense_clarification": "udržet v menším rozsahu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9563273-75c2-372d-9dd0-758fadfcae5c",
                    "sense_definition": "To decrease in amount or size.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reduce_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the flood, it took several days for the high waters to <w>abate</w>.",
                            "target_lang_translations": {
                                "cs": "Po povodni trvalo několik dní, než vysoká voda <w>opadla</w>."
                            }
                        },
                        {
                            "text": "The swelling in his ankle began to <w>abate</w> after he applied an ice pack.",
                            "target_lang_translations": {
                                "cs": "Otok na jeho kotníku začal <w>ustupovat</w> poté, co si přiložil ledový obklad."
                            }
                        }
                    ],
                    "synonyms": [
                        "decrease",
                        "lessen",
                        "diminish"
                    ],
                    "antonyms": [
                        "increase",
                        "enlarge"
                    ],
                    "common_phrases": [
                        "waters abated"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zmenšit se v množství nebo velikosti."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "opadnout",
                                "target_lang_sense_clarification": "zmenšit se (např. otok, hladina vody)"
                            },
                            {
                                "target_lang_word": "zmenšit se",
                                "target_lang_sense_clarification": "ubýt na objemu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "565efda4-4232-346c-a9e8-26c77e53cf03",
                    "sense_definition": "To put an end to (a nuisance).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The property owner was legally ordered to <w>abate</w> the nuisance caused by the trash.",
                            "target_lang_translations": {
                                "cs": "Majitel nemovitosti byl soudně vyzván, aby <w>odstranil</w> obtěžování způsobené odpadky."
                            }
                        },
                        {
                            "text": "The city council took immediate action to <w>abate</w> the environmental hazard.",
                            "target_lang_translations": {
                                "cs": "Městská rada podnikla okamžité kroky k <w>odstranění</w> ekologického rizika."
                            }
                        }
                    ],
                    "synonyms": [
                        "stop",
                        "suppress",
                        "terminate"
                    ],
                    "common_phrases": [
                        "abate the nuisance"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Used in legal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Odstranit nebo ukončit obtěžující jev (právní termín)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "odstranit",
                                "target_lang_sense_clarification": "zlikvidovat příčinu obtěžování"
                            },
                            {
                                "target_lang_word": "ukončit",
                                "target_lang_sense_clarification": "zastavit trvání nepříjemného stavu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52a8452a-220d-3a67-b7fa-ce41f9afb3bd",
                    "sense_definition": "To make (a writ or other legal document) void; to nullify.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defense attorney filed a motion to <w>abate</w> the writ on procedural grounds.",
                            "target_lang_translations": {
                                "cs": "Obhájce podal návrh na <w>zrušení</w> příkazu z procesních důvodů."
                            }
                        },
                        {
                            "text": "If the paperwork is filled out incorrectly, the court may <w>abate</w> the entire action.",
                            "target_lang_translations": {
                                "cs": "Pokud jsou dokumenty vyplněny nesprávně, soud může celou žalobu <w>zrušit</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "terminate"
                    ],
                    "common_phrases": [
                        "abate a writ"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Used in legal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Zneplatnit nebo zrušit právní dokument či úkon."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zrušit",
                                "target_lang_sense_clarification": "ukončit platnost právního úkonu"
                            },
                            {
                                "target_lang_word": "zneplatnit",
                                "target_lang_sense_clarification": "zbavit právní účinnosti"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "70684642-a39d-3039-8b16-bee4f13f4c00",
                    "sense_definition": "Abatement; reduction; (countable) an instance of this.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reduction_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>abate</w> in tax rates was welcomed by small business owners.",
                            "target_lang_translations": {
                                "cs": "Náhlé <w>snížení</w> daňových sazeb bylo majiteli malých firem uvítáno."
                            }
                        },
                        {
                            "text": "We noticed a significant <w>abate</w> of the noise once the construction crew left.",
                            "target_lang_translations": {
                                "cs": "Zaznamenali jsme výrazné <w>snížení</w> hluku, jakmile stavební četa odešla."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used as a noun in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Snížení nebo redukce."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "snížení",
                                "target_lang_sense_clarification": "proces zmenšení intenzity či množství"
                            },
                            {
                                "target_lang_word": "redukce",
                                "target_lang_sense_clarification": "zmenšení rozsahu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
