                    "sense_definition": "Een hoeveelheid die toereikend is; niet te veel en niet te weinig.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zijn mensen <w>genoeg</w> die niet van thee houden.",
                            "target_lang_translations": {
                                "ru": "Есть <w>достаточно</w> людей, которые не любят чай.",
                                "en": "There are <w>enough</w> people who don't like tea.",
                                "pl": "Jest <w>wystarczająco</w> dużo ludzi, którzy nie lubią herbaty.",
                                "de": "Es gibt <w>genug</w> Menschen, die keinen Tee mögen.",
                                "fr": "Il y a <w>assez</w> de gens qui n'aiment pas le thé.",
                                "it": "Ci sono <w>abbastanza</w> persone a cui non piace il tè.",
                                "cs": "Je <w>dost</w> lidí, kteří nemají rádi čaj.",
                                "tr": "Çay sevmeyen <w>yeterince</w> insan var.",
                                "es": "Hay <w>bastantes</w> personas a las que no les gusta el té."
                            }
                        },
                        {
                            "text": "We hebben <w>genoeg</w> tijd om rustig te ontbijten.",
                            "target_lang_translations": {
                                "ru": "У нас <w>достаточно</w> времени, чтобы спокойно позавтракать.",
                                "en": "We have <w>enough</w> time to have a quiet breakfast.",
                                "pl": "Mamy <w>dość</w> czasu, aby spokojnie zjeść śniadanie.",
                                "de": "Wir haben <w>genug</w> Zeit, um in Ruhe zu frühstücken.",
                                "fr": "Nous avons <w>assez</w> de temps pour prendre le petit-déjeuner tranquillement.",
                                "it": "Abbiamo <w>abbastanza</w> tempo per fare colazione con calma.",
                                "cs": "Máme <w>dost</w> času na to, abychom se v klidu nasnídali.",
                                "tr": "Sakin bir şekilde kahvaltı yapmak için <w>yeterli</w> vaktimiz var.",
                                "es": "Tenemos <w>suficiente</w> tiempo para desayunar tranquilamente."
                            }
                        }
                    ],
                    "synonyms": [
