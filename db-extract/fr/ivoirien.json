                                        "sense_id": "5b1db90c-7f18-3c78-b30f-12e164e34684",
                                        "entry_id": "62e3a3de-1210-3af1-9322-c4d2839cc17b",
                                        "glosses": [
                                            "A person from Côte d'Ivoire or of Ivorian descent."
                                        ],
                                        "tags": [],
