                "senses": [
                    {
                        "sense_id": "585b746b-7a37-39d7-ab0f-76f3b698f931",
                        "entry_id": "5817e824-b3b2-3b08-b9e1-817cd02e5343",
                        "glosses": [
                            "Metalle mit Hilfe von Feuer und Schlagwerkzeugen bearbeitende Handwerkerin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3af9ce2-8830-4802-8fe0-640ccb87e23d",
                                "sense_id": "585b746b-7a37-39d7-ab0f-76f3b698f931",
                                "text": "„Wir sahen, daß die irische Göttin Brigit erstens als Dichterin (banfile) und Gelehrte (bä n-äxe), zweitens als Ärztin (bä legisf'), drittens als Schmiedin (bä Goibne) verehrt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "094c7c91-8979-3c09-a91a-c014d0158f9f",
                        "entry_id": "5817e824-b3b2-3b08-b9e1-817cd02e5343",
                        "glosses": [
                            "die Ehefrau des Schmieds"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "cdca593d-288d-4535-8ba9-a6e251d63187",
                                "sense_id": "094c7c91-8979-3c09-a91a-c014d0158f9f",
                                "text": "Die Schmiedin war für das leibliche Wohl aller Mitarbeiter der Dorfschmiede zuständig."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
