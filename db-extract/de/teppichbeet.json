                "senses": [
                    {
                        "sense_id": "0befac78-34c0-3b9f-b120-55eba7134abb",
                        "entry_id": "892edce3-9def-3e5a-ae1d-d55ca21caf3f",
                        "glosses": [
                            "flächig, dicht bepflanztes Beet, das in seiner Gesamtheit ein Muster/Motiv zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af1d5f3a-3b31-4361-81c0-672d63bd2141",
                                "sense_id": "0befac78-34c0-3b9f-b120-55eba7134abb",
                                "text": "„Die regelmäßige, ornamentale Gestaltung der Platzfläche mit Teppichbeet und Denkmal unterstreicht den repräsentativen Charakter der umliegenden Bebauung.“"
                            },
                            {
                                "example_id": "1f5c8d0b-a93e-4bd5-a1ed-23e0cc27580c",
                                "sense_id": "0befac78-34c0-3b9f-b120-55eba7134abb",
                                "text": "„Im Mittelgrund kontrastieren hell und dunkellaubige Gehölze, Silberpappeln betonen besondere Punkte in der künstlichen Natur, während sich im Vordergrund das leuchtende Teppichbeet auf grünem Gras bettet.“"
                            }
                        ],
