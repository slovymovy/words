        "fr-extract.jsonl": [
            {
                "entry_id": "e07d6aea-d160-3689-b35b-3e505a2d4e07",
                "word": "éploré",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6f32096d-4816-45f0-afd5-710470419740",
                        "entry_id": "e07d6aea-d160-3689-b35b-3e505a2d4e07",
                        "tags": [
                            "plural",
                            "masculine"
                        ],
                        "form": "éplorés"
                    },
                    {
                        "form_id": "2ddbab2d-d577-4dcc-8413-ac8250ab4246",
                        "entry_id": "e07d6aea-d160-3689-b35b-3e505a2d4e07",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "éplorée"
                    },
                    {
                        "form_id": "3d31c4f8-c471-4a6e-895f-ccecbeedaeef",
                        "entry_id": "e07d6aea-d160-3689-b35b-3e505a2d4e07",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "éplorées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "81493ef8-4149-3ce2-920d-a1df2aa4aef2",
                        "entry_id": "e07d6aea-d160-3689-b35b-3e505a2d4e07",
                        "glosses": [
                            "Qui est tout en pleurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f86d65a6-12b0-4598-8080-d0f2b8224a72",
                                "sense_id": "81493ef8-4149-3ce2-920d-a1df2aa4aef2",
                                "text": "Il vit, non loin du grand chemin, une femme éplorée qui appelait le Ciel et la Terre à son secours, et un homme furieux qui la suivait […] Cet homme l’accablait de coups et de reproches."
                            },
                            {
                                "example_id": "1b558370-f867-448d-b970-241f5dc18117",
                                "sense_id": "81493ef8-4149-3ce2-920d-a1df2aa4aef2",
                                "text": "Les deux chevaliers s’inclinèrent profondément devant la mère éplorée, et se retirèrent avec leur guide."
                            },
                            {
                                "example_id": "35809c07-bc41-4d18-8de9-ec4bf3666b9b",
                                "sense_id": "81493ef8-4149-3ce2-920d-a1df2aa4aef2",
                                "text": "— Ta dernière lettre était comme toutes les autres, et rien ne me faisait prévoir que tu allais m’arriver ainsi éplorée."
                            },
                            {
                                "example_id": "cbce7ac4-2d63-4c60-a644-f17eca1f43ff",
                                "sense_id": "81493ef8-4149-3ce2-920d-a1df2aa4aef2",
                                "text": "Le spectacle d’une femme éplorée me soulève le cœur. Elles sanglotent comme si elles satisfaisaient un besoin physique. C’est vulgaire, abondant et monotone."
                            }
                        ]
                    },
                    {
                        "sense_id": "d18f2d31-97a1-361f-a5b0-460c19f6b9ae",
                        "entry_id": "e07d6aea-d160-3689-b35b-3e505a2d4e07",
                        "glosses": [
                            "Qualifie le branchage et le feuillage du saule pleureur."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4d866f5d-192c-473a-8ff0-3b37566a4669",
                                "sense_id": "d18f2d31-97a1-361f-a5b0-460c19f6b9ae",
                                "text": "Le cyprès, l’if au feuillage sombre, le saule aux rameaux éplorés, semblent bannis de ce parterre, où les rosiers festonnent les marbres, auxquels ils ont à regret cédé une place."
                            },
                            {
                                "example_id": "cecb07a2-3e6d-4c8b-b340-6d01006b364d",
                                "sense_id": "d18f2d31-97a1-361f-a5b0-460c19f6b9ae",
                                "text": "Karol s’approcha, perdu sous les branches éplorées des vieux saules, et il écouta."
                            },
                            {
                                "example_id": "70390214-36c8-40e8-bab3-4861f0327feb",
                                "sense_id": "d18f2d31-97a1-361f-a5b0-460c19f6b9ae",
                                "text": "Il se proposait de couper une branche à l'un des vieux saules qui, à cet endroit, trempent au fil de l'eau leurs branches éplorées."
                            },
                            {
                                "example_id": "e81ebdff-02c8-4ff3-819f-af9c1cdd9fd5",
                                "sense_id": "d18f2d31-97a1-361f-a5b0-460c19f6b9ae",
                                "text": "On cultive dans toute l'Europe le bel arbre que nous appelons Saule pleureur à cause de ses longs et flexibles rameaux, qui pendent éplorés comme la chevelure d'une personne accablée d’affliction."
                            },
                            {
                                "example_id": "5bf8b877-7ee5-46b6-aca7-03cfaa3972dd",
                                "sense_id": "d18f2d31-97a1-361f-a5b0-460c19f6b9ae",
                                "text": "Mes chers amis, quand je mourrai,\nPlantez un saule au cimetière.\nJ’aime son feuillage éploré ;\nLa pâleur m’en est douce et chère, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0269f009-2a2a-4930-9c88-91ea6c73ec32",
                        "source_entry_id": "e07d6aea-d160-3689-b35b-3e505a2d4e07",
                        "target_lang_word": "tearful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tearful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe499b1b-0d3c-36f2-86d8-fd6b05178f6b",
                                        "entry_id": "a1468301-e974-3048-8a1a-ae0a57df1f45",
                                        "glosses": [
                                            "Accompanied by tears; crying, or about to cry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4762eb59-7d71-4afb-9084-6892ce470b15",
                                                "sense_id": "fe499b1b-0d3c-36f2-86d8-fd6b05178f6b",
                                                "text": "Aaron got a little tearful until Laura came to reassure him."
                                            },
                                            {
                                                "example_id": "8a6bb657-913f-4e86-b124-097d17089f7f",
                                                "sense_id": "fe499b1b-0d3c-36f2-86d8-fd6b05178f6b",
                                                "text": "The week that was yet to elapse, she spent in wandering through her uncle's favourite walks in hours of tearful vigil, beside his tomb, and in collecting together every trifle on which he had set a value."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4aba2a0d-5afd-349e-ae09-04f78d4e402a",
                                        "entry_id": "a1468301-e974-3048-8a1a-ae0a57df1f45",
                                        "glosses": [
                                            "Sorrowful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f83d4fa2-464a-4690-b443-ec5460465a6f",
                                                "sense_id": "4aba2a0d-5afd-349e-ae09-04f78d4e402a",
                                                "text": "Receiving the news of Joseph Beam's death two days after Christmas was a piercing blow that sent me into a tearful and contemplative stupor from which I have not yet emerged."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
