                "senses": [
                    {
                        "sense_id": "7f387574-ba09-313c-a397-5b7c528c5509",
                        "entry_id": "f6acd36f-5b38-325c-8a79-e42213143161",
                        "glosses": [
                            "Qualifie une émulsion photographique noir et blanc, sensible aux mêmes longueurs d’onde que l’œil humain et parfois même à l’ultra-violet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39c2db38-6574-44de-8011-26f2922e225e",
                                "sense_id": "7f387574-ba09-313c-a397-5b7c528c5509",
                                "text": "Vous relâchez alors votre étreinte pour le porter à la base intermédiaire du panchromatique flouzeur gauche, à condition toutefois que son obédience intercalaire n’empiète pas sur le genouflexeur de torsion : auquel cas, vous exercez ladite étreinte sur le morfondeur de vitesse droit."
                            },
                            {
                                "example_id": "118daf58-fce9-4019-a295-b8e7e0952fc7",
                                "sense_id": "7f387574-ba09-313c-a397-5b7c528c5509",
                                "text": "En superposant les données infrarouges du télescope James Webb et la lumière visible par le télescope Hubble, l’agence spatiale a pu créer une image panchromatique qui offre l’un des points de vue les plus complets jamais vus de notre univers."
                            }
                        ]
                    }
