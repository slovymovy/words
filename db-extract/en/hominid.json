                        "source_entry_id": "8b7b6d3b-abf3-310f-b9fc-056b50c2f033",
                        "source_sense_description": "primate of the taxonomic family Hominidae",
                        "target_lang_word": "Menschenaffe",
                        "target_lang_code": "de",
