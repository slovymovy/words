                "senses": [
                    {
                        "sense_id": "c03cfa2b-ed50-394a-be30-aee8f6b172eb",
                        "entry_id": "df48b143-193d-3991-99f6-d9e2fb084bc0",
                        "glosses": [
                            "busdienst tussen verschillende (grote) plaatsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f453dc67-dd1d-4ca4-a657-f9a4bf0683ea",
                                "sense_id": "c03cfa2b-ed50-394a-be30-aee8f6b172eb",
                                "text": "Van Connexxion rijdt de Interliner 315 (Lelystad-Groningen) alleen het traject tussen Lelystad en Emmeloord. In Noord-Holland hebben de bussen van Connexxion, met uitzondering van de kop van Noord-Holland, grotendeels gewoon kunnen rijden. Op het eiland Texel heeft een deel van de dag het busvervoer stilgelegen. De NS heeft op een aantal trajecten afgelopen nacht treinen laten rijden om te voorkomen dat de wissels zouden vastvriezen. Net als gisteren is er een aangepaste dienstregeling. Er rijden minder intercity's en stoptreinen."
                            },
                            {
                                "example_id": "8c253fc2-179b-488a-91d0-1e12d60b07da",
                                "sense_id": "c03cfa2b-ed50-394a-be30-aee8f6b172eb",
                                "text": "In ruil daarvoor mocht Van Oeveren nog honderd jaar de buslijnen uitvoeren van de RTM en haar rechtsopvolgers. Nu rijdt het bedrijf onder meer de interliner Zierikzee - Rotterdam voor Connexxion. Ook de lijnen naar Goes en Middelburg rijden gewoon."
                            }
                        ]
                    }
                ],
