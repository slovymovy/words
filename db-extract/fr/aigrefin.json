                            "singular",
                            "feminine"
                        ],
                        "form": "aigrefine"
                    },
                    {
                        "form_id": "9c9089f6-1f7d-4a6c-bf30-378130bf958e",
                        "entry_id": "e8e819e5-0d2f-347f-97a2-e4a1dde1ab1f",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "aigrefines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "182eb746-0de3-3a12-81e9-87ae1eae2c83",
                        "entry_id": "e8e819e5-0d2f-347f-97a2-e4a1dde1ab1f",
                        "glosses": [
                            "Qui utilise la ruse et l’habilité à duper autrui pour parvenir à ses fins."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "cbec823c-e736-419a-8077-af7b7bd2a2b9",
                                "sense_id": "182eb746-0de3-3a12-81e9-87ae1eae2c83",
                                "text": "Dès que nous nous écartons de la droiture et de la générosité, nous sommes ridicules et déplaisants ; nos mesures sont étroites, nos projets mal concertés, notre maintien même devient aigrefin."
                            },
                            {
                                "example_id": "73874ac5-feef-4f3a-ba6b-884e62b54d9d",
                                "sense_id": "182eb746-0de3-3a12-81e9-87ae1eae2c83",
                                "text": "Robert ne pouvait guère prétendre qu’à la bonne bourgeoisie dans la hiérarchie aigrefine."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "53c158dc-3c01-3534-bacf-721bd5573c50",
                "word": "aigrefin",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ef3c5f40-f1cd-4c2a-a9c6-7ed0be629c89",
                        "entry_id": "53c158dc-3c01-3534-bacf-721bd5573c50",
                        "tags": [
                            "plural"
                        ],
                        "form": "aigrefins"
                    },
                    {
                        "form_id": "3b30b35e-187b-4333-a7f3-43531db797e0",
                        "entry_id": "53c158dc-3c01-3534-bacf-721bd5573c50",
                        "tags": [
                            "feminine"
                        ],
                        "form": "aigrefine"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "86f72eca-5075-3cb1-ae39-7bee3e6d5581",
                        "entry_id": "53c158dc-3c01-3534-bacf-721bd5573c50",
                        "glosses": [
                            "Autre nom de l’aiglefin, poisson proche de la morue."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "324e3569-6630-4222-9889-02269172486d",
                                "sense_id": "86f72eca-5075-3cb1-ae39-7bee3e6d5581",
                                "text": "Pêle-mêle, au hasard du coup de filet, les algues profondes, où dort la vie mystérieuse des grandes eaux, avaient tout livré : les cabillauds, les aigrefins, les carrelets, les plies."
                            }
                        ]
                    },
                    {
                        "sense_id": "b65bccb3-ca8c-3256-85ff-5a8022f49b6c",
                        "entry_id": "53c158dc-3c01-3534-bacf-721bd5573c50",
                        "glosses": [
                            "Homme pratiquant la tromperie pour parvenir à ses fins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79ed91bc-d78d-4659-8750-9c01b7393b3a",
                                "sense_id": "b65bccb3-ca8c-3256-85ff-5a8022f49b6c",
                                "text": "Mes nièces Éva et Juliette me donnent beaucoup de soucis parce qu’elles sont bonnes à marier et qu’elles ont des dots exceptionnellement tentantes pour les aigrefins."
                            },
                            {
                                "example_id": "bed20ff7-fe51-4425-bd33-f14108410052",
                                "sense_id": "b65bccb3-ca8c-3256-85ff-5a8022f49b6c",
                                "text": "Imaginez un peu ce que doit être alors un homme qui, selon les critères soviétiques, est un aigrefin, un requin, un arriviste !"
                            },
                            {
                                "example_id": "91c11bb3-c0f6-409f-aa7f-bd205060f211",
                                "sense_id": "b65bccb3-ca8c-3256-85ff-5a8022f49b6c",
                                "text": "Il n’a rien de commun avec ces aigrefins qui construisent n’importe quoi et n’importe comment, avec le seul souci de rogner sur la qualité des matériaux et de truquer les devis : ce qui l’intéresse, c’est de « penser » ce qu’il édifie."
                            },
                            {
                                "example_id": "5e20bd62-e2a0-4a3f-9883-37ccd9df2859",
                                "sense_id": "b65bccb3-ca8c-3256-85ff-5a8022f49b6c",
                                "text": "Beaucoup d’argent sera distribué. Et, probablement, beaucoup d’aigrefins seront aussi au rendez-vous."
                            },
                            {
                                "example_id": "12058d33-6102-4c9f-96ec-3a788d71986f",
                                "sense_id": "b65bccb3-ca8c-3256-85ff-5a8022f49b6c",
                                "text": "On s'imagine qu'il est moins dangereux de combattre de biais un fléau, que de le combattre de front; alors que c'est le contraire qui est vrai. Le biais est un parage dangereux, où foisonnent les dupeurs du peuple et les aigrefins."
                            },
                            {
                                "example_id": "c4c36965-9e1d-499d-b465-10165cf0528f",
                                "sense_id": "b65bccb3-ca8c-3256-85ff-5a8022f49b6c",
                                "text": "Le mécanisme est simple: l'aigrefin se fait passer au téléphone pour le dirigeant de l'entreprise et demande à un comptable d'effectuer un virement à l'étranger pour financer une acquisition confidentielle."
                            }
                        ]
                    },
                    {
