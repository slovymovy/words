                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "8819139e-d676-3d38-b9d3-d8e6921353aa",
                                        "entry_id": "9fce08cd-ab99-3073-9a9a-17f089a139f9",
                                        "glosses": [
                                            "forma organizace společnosti, v níž vládne nejbohatší vrstva"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ad12654-43c1-4a4b-9d5e-42e84eb0612c",
                                                "sense_id": "8819139e-d676-3d38-b9d3-d8e6921353aa",
                                                "text": "Plutokracie byla častou formou vlády ve starověkých městských státech, např. v Aténách."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51c2ac4f-60e9-3003-b443-a180bb163367",
