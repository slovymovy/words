        "fr-extract.jsonl": [
            {
                "entry_id": "025ddc70-f981-3d45-995c-d2ab3db3b692",
                "word": "sandale",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "531b174b-5a82-431f-b8ac-cec911ddb936",
                        "entry_id": "025ddc70-f981-3d45-995c-d2ab3db3b692",
                        "tags": [
                            "plural"
                        ],
                        "form": "sandales"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b6c1681f-0393-3873-9602-22a4d1e8c625",
                        "entry_id": "025ddc70-f981-3d45-995c-d2ab3db3b692",
                        "glosses": [
                            "Chaussure qui découvre en partie le dessus du pied."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56bc57c2-aa9b-4225-96fd-cf5fe89ca550",
                                "sense_id": "b6c1681f-0393-3873-9602-22a4d1e8c625",
                                "text": "À ses pieds, on fixa des semelles de sandales qui s’attachaient à ses jambes brunes par des lanières de cuir croisées."
                            },
                            {
                                "example_id": "c5763273-c06c-4ddb-8f7e-4d4e1327216a",
                                "sense_id": "b6c1681f-0393-3873-9602-22a4d1e8c625",
                                "text": "Victorin examina d’un œil défiant ce soi-disant ermite en pèlerinage, et vit un superbe modèle de ces moines napolitains dont les robes sont sœurs des guenilles du lazzarone, dont les sandales sont les haillons de cuir, comme le moine est lui-même un haillon humain."
                            },
                            {
                                "example_id": "0241ac1f-0a0b-4593-97bd-8c66fba83ee9",
                                "sense_id": "b6c1681f-0393-3873-9602-22a4d1e8c625",
                                "text": "À l'intérieur, trois douzaines et demie de paires de souliers alignés étincellent. Des ballerines blanches. Plusieurs sortes d'escarpins noirs, des sandales vernies, des chaussures brunes à lacets qui font penser à Mary Poppins, des richelieus, des tongs, des Converse rouges, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "600a3909-2d49-4974-9c32-b7bbc2b288b0",
                        "source_entry_id": "025ddc70-f981-3d45-995c-d2ab3db3b692",
                        "source_sense_id": "b6c1681f-0393-3873-9602-22a4d1e8c625",
                        "target_lang_word": "Sandale",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sandale",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2b1f635-f258-3144-aeef-733671756363",
                                        "entry_id": "3e677e28-dd01-374f-8908-f9bad5b5fe84",
                                        "glosses": [
                                            "sehr einfacher Schuh, dessen Sohle von einer einfachen Riemenkonstruktion gehalten wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b6dc5ed-00d2-4f28-aaa6-e4eaf5025e17",
                                                "sense_id": "e2b1f635-f258-3144-aeef-733671756363",
                                                "text": "Ich habe mir diesen Sommer neue Sandalen gekauft."
                                            },
                                            {
                                                "example_id": "462cf28c-af57-4f0a-b344-cb5e4dd9f517",
                                                "sense_id": "e2b1f635-f258-3144-aeef-733671756363",
                                                "text": "„Unsere Welt ist für die Birkenstocks gemacht, sagte ich mir am Abend, als ich endlich meine violetten Sandalen für immer ausziehen konnte.“"
                                            },
                                            {
                                                "example_id": "39e2990f-0984-4bbc-81c1-984393278b31",
                                                "sense_id": "e2b1f635-f258-3144-aeef-733671756363",
                                                "text": "„Die Wände waren ihr lieber als die Sandalen, mit denen sie manchmal ebenfalls spielte.“"
                                            },
                                            {
                                                "example_id": "24f9cae6-4b11-4077-b6eb-aeb6e1781708",
                                                "sense_id": "e2b1f635-f258-3144-aeef-733671756363",
                                                "text": "„Sein Blick ruhte auf ihren nackten Füßen in den Sandalen, und sie zuckten einen antwortenden Rhythmus.“"
                                            },
                                            {
                                                "example_id": "e051ffb6-0024-47c0-b363-5d5d28424a86",
                                                "sense_id": "e2b1f635-f258-3144-aeef-733671756363",
                                                "text": "„Er hatte jetzt die Stiefel ausgezogen, lief in schlichten Sandalen und einem hellen Hemd umher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7fb9664-e8e9-4349-bcbe-a14ba9ac7f36",
                        "source_entry_id": "025ddc70-f981-3d45-995c-d2ab3db3b692",
