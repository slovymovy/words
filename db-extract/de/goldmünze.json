                "senses": [
                    {
                        "sense_id": "6199d552-5b6d-3bb2-932d-ff0bb863ab51",
                        "entry_id": "1d80d24b-ac04-3f67-89e0-c3dd29697d23",
                        "glosses": [
                            "Münze, die aus Gold oder einer Legierung mit Goldanteil besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7166fff3-7101-47e1-8c9f-ddc529d14b26",
                                "sense_id": "6199d552-5b6d-3bb2-932d-ff0bb863ab51",
                                "text": "Heutzutage werden nur noch wenige Goldmünzen geprägt."
                            },
                            {
                                "example_id": "cae7f40e-cc63-4763-8a71-7ae415da9394",
                                "sense_id": "6199d552-5b6d-3bb2-932d-ff0bb863ab51",
                                "text": "„Das ist eine Goldmünze im Wert einer Viertelzechine.“"
                            },
                            {
                                "example_id": "f3660042-7366-496f-8002-a67d9edebee4",
                                "sense_id": "6199d552-5b6d-3bb2-932d-ff0bb863ab51",
                                "text": "„Zwei schwere Koffer voller Goldmünzen und Goldbarren stellte der schmale, bleiche Louis Monico auf den Rokokotisch im Salon des Appartements im Hotel »Victoria«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a89d6116-6fde-4826-9cf8-136df46c5459",
                        "source_entry_id": "1d80d24b-ac04-3f67-89e0-c3dd29697d23",
