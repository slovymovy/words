                        "sense_id": "dee15931-770e-36e7-b1e7-ac44d319365d",
                        "entry_id": "0d197ff4-11d6-379c-a85c-dd59c3b78db2",
                        "glosses": [
                            "iets waarmee iemand zijn brood verdient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a23d9c6-2d29-4ba9-8bcd-317fdaca86b4",
                                "sense_id": "dee15931-770e-36e7-b1e7-ac44d319365d",
                                "text": "Niet een gevaarlijk dansend leven vol beweging, maar een ordinair dagelijks bestaan dat draait om de allereenzijdigste kostwinning."
                            },
                            {
                                "example_id": "8466240e-171a-4942-8633-0ffc396fdd66",
                                "sense_id": "dee15931-770e-36e7-b1e7-ac44d319365d",
                                "text": "De aanklagers hebben aangegeven in beroep te gaan bij het Braziliaanse hooggerechtshof. 'Alle onderzoeken kwamen tot dezelfde conclusie. De dam zal drastische gevolgen hebben voor de voedselketen en de kostwinning van de inheemse bevolking', aldus de aanklagers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52acb2dd-c65d-4290-b0ff-95dc7f1b1278",
                        "source_entry_id": "0d197ff4-11d6-379c-a85c-dd59c3b78db2",
                        "source_sense_id": "dee15931-770e-36e7-b1e7-ac44d319365d",
                        "source_sense_description": "iets waarmee iemand zijn brood verdient",
                        "target_lang_word": "bread winning",
                        "target_lang_code": "en",
