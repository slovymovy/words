                                "sense_id": "be0a1153-e3ed-331b-9bb6-c0a9be4582cb",
                                "text": "„Ein Quintett wie im Don Giovanni steht uns näher als die epische Bewegung im Tristan.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
