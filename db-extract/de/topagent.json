                                "example_id": "a1f28c07-e15c-4142-9085-b26f20f2264f",
                                "sense_id": "f031f696-5b46-3724-a36d-b95f950dc815",
                                "text": "„Dieser eine Topagent am Telefon reitet auf der Frage herum, was, wenn ich nun nicht der einzige Überlebende wäre.“"
                            },
                            {
                                "example_id": "a9bcf962-bab3-4b9e-bb6c-05a2e1b1816f",
                                "sense_id": "f031f696-5b46-3724-a36d-b95f950dc815",
                                "text": "„Also vermutete er in ihm einen CIA-Mann, einen Topagenten für Spezialeinsätze einschließlich geheimer Mordkommandos oder irgendeinen anderen Elitesoldaten oder Geheimdienstler.“"
                            }
