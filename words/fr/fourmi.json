            "senses": [
                {
                    "sense_id": "9637f08f-876a-39e1-95f0-beeb95594cb0",
                    "sense_definition": "Petit insecte social sans ailes vivant en colonie organisée dans une fourmilière.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "insecte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une petite <w>fourmi</w> transporte une miette de pain sur le trottoir."
                        },
                        {
                            "text": "Les enfants observent une longue colonne de <w>fourmis</w> dans le jardin."
                        }
                    ],
                    "synonyms": [
                        "froumi"
                    ],
                    "common_phrases": [
                        "reine des fourmis"
                    ]
                },
                {
                    "sense_id": "7e4c0dfd-9659-31f7-b437-8bdb297f9e77",
                    "sense_definition": "Sensation de picotement ou d'engourdissement ressentie dans un membre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après être resté assis trop longtemps, j'ai des <w>fourmis</w> dans les jambes."
                        },
                        {
                            "text": "Il ressent des <w>fourmis</w> dans la main après avoir porté ce sac lourd."
                        }
                    ],
                    "common_phrases": [
                        "avoir des fourmis dans",
                        "des fourmis dans les jambes"
                    ]
                },
                {
                    "sense_id": "46e27c87-8856-340c-85ce-a301b5fa2cae",
                    "sense_definition": "Personne laborieuse et prévoyante qui économise pour l'avenir, par opposition à la cigale.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Contrairement à son frère dépensier, elle est une vraie <w>fourmi</w> qui épargne chaque mois."
                        },
                        {
                            "text": "En période de crise économique, les ménages adoptent un comportement de <w>fourmi</w>."
                        }
                    ],
                    "common_phrases": [
                        "être une fourmi"
                    ]
                },
                {
                    "sense_id": "282582e7-76b7-341f-86b0-03258013a0bf",
                    "sense_definition": "Meuble ou figure représentant cet insecte dans un blason ou des armoiries.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le blason de cette ancienne famille présente une <w>fourmi</w> de sable sur fond d'or."
                        },
                        {
                            "text": "Cette ville arbore fièrement une <w>fourmi</w> au centre de ses armoiries."
                        }
                    ]
                }
