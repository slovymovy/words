                    {
                        "sense_id": "53e327eb-2ae3-3693-8812-cdf06dac55b0",
                        "entry_id": "a9413762-3077-3d68-84fd-78537f4fb139",
                        "glosses": [
                            "Qui est vêtu d'un ou de jupons."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "2921c13d-562b-4ce6-a57e-182d555ff7a6",
                                "sense_id": "53e327eb-2ae3-3693-8812-cdf06dac55b0",
                                "text": "Derrière cette jeune personne amplement enjuponnée, j’aperçois les hardies filles en braies rayées qui suivaient leurs hommes en Macédoine ou sur les pentes du Capitole, et celles qui furent vendues à l’encan après les campagnes de César."
                            },
                            {
                                "example_id": "7c1aaf9e-3bd5-4a7a-a48d-ed0c828b77ea",
                                "sense_id": "53e327eb-2ae3-3693-8812-cdf06dac55b0",
                                "text": "Mais la figure de la quarante-huitarde en culottes partage dans l’imagination des humoristes la place avec des révoltées enjuponnées, montrant sans pudeur leurs jambes."
                            },
                            {
                                "example_id": "9b4fcd69-0864-4103-a1a4-3742d4e63228",
                                "sense_id": "53e327eb-2ae3-3693-8812-cdf06dac55b0",
                                "text": "On voit des champs de tabac sous un ciel d'orage, des silhouettes féminines enjuponnées, peaux mates, moiteurs sombres."
                            }
                        ]
                    }
                ],
