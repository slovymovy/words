                                        "entry_id": "c8533e37-51f2-3a29-9075-2b66ca36429c",
                                        "glosses": [
                                            "An antimalarial drug C₁₇H₁₆F₆N₂O similar to quinine that consists of a fluorinated derivative of quinoline and is used in the form of its hydrochloride for the prevention and treatment of malaria."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cbe6b0d-10cd-494e-95f4-81819b882fc2",
                                                "sense_id": "80f91991-0a6e-3d34-b86e-7218cbaa39dd",
                                                "text": "The same year the UN banned mefloquine for peacekeeping troops in Cambodia because of concern about the drug's \"neuropsychiatric side effects… in military personnel\"."
                                            },
                                            {
                                                "example_id": "062e24dc-7574-4f9e-a577-5d41e2307da9",
                                                "sense_id": "80f91991-0a6e-3d34-b86e-7218cbaa39dd",
                                                "text": "I take thalazole to control the stools, mefloquine for the malaria."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
