        "fr-extract.jsonl": [
            {
                "entry_id": "3c68412e-f17d-383b-8939-fcb170b89245",
                "word": "inviolable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e9473e1e-0986-46a4-b2df-1e26615d2076",
                        "entry_id": "3c68412e-f17d-383b-8939-fcb170b89245",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "inviolables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0d693f08-d594-3652-9cff-70fa718664b4",
                        "entry_id": "3c68412e-f17d-383b-8939-fcb170b89245",
                        "glosses": [
                            "Que l’on ne peut profaner ou pénétrer (en parlant d’un lieu, d’un monument, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "842286f1-9bef-41e3-906b-c7c54f0a4253",
                                "sense_id": "0d693f08-d594-3652-9cff-70fa718664b4",
                                "text": "Peut-être s’est-il jeté dans le lac, dont les eaux sont le plus discret et inviolable des tombeaux."
                            },
                            {
                                "example_id": "5f2c128d-a918-4c26-a62f-dfd9616cf533",
                                "sense_id": "0d693f08-d594-3652-9cff-70fa718664b4",
                                "text": "Elle ressemblait à un coffret à cigares mais, en fait, c’était une boîte antihacking. Une sorte de cage de Faraday qui assurait une confidentialité presque inviolable des conversations."
                            }
                        ]
                    },
                    {
                        "sense_id": "70814f2a-8e1f-353c-a503-43f9231f3993",
                        "entry_id": "3c68412e-f17d-383b-8939-fcb170b89245",
                        "glosses": [
                            "Qu’on ne doit jamais violer, auquel on ne doit jamais attenter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c079c9a9-6058-4c1a-b979-fba2bbed7444",
                                "sense_id": "70814f2a-8e1f-353c-a503-43f9231f3993",
                                "text": "[…], elle lui assurerait une existence tranquille, à la condition de garder un secret inviolable sur le service réclamé."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2a1ba3e-458d-3a78-b884-e349c9dc5b06",
                        "entry_id": "3c68412e-f17d-383b-8939-fcb170b89245",
                        "glosses": [
                            "Qu’il est impossible de violer (au sens sexuel)."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "6ebb4419-772a-4f86-a6e3-0a1c137390e8",
                                "sense_id": "d2a1ba3e-458d-3a78-b884-e349c9dc5b06",
                                "text": "Je vois alors, et quoi qu’on ose tenter, que la majesté royale est décidément… inviolable !!!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72ab2a72-c480-4c3a-b2ec-a4f9809cb77e",
                        "source_entry_id": "3c68412e-f17d-383b-8939-fcb170b89245",
                        "target_lang_word": "inviolable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inviolable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a7ac80e-9cc0-38b5-9f41-2f0283c98d9b",
                                        "entry_id": "e7abce9b-d023-3e95-8a8f-0ee665a4b160",
                                        "glosses": [
                                            "Not violable; not to be infringed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a744102c-5f67-4cb4-aba0-0af430e93363",
                                                "sense_id": "3a7ac80e-9cc0-38b5-9f41-2f0283c98d9b",
                                                "text": "But come, for thou, be ſure, ſhalt give account / To him who ſent us, whoſe charge is to keep / This place inviolable, and therefore theſe from harm."
                                            },
                                            {
                                                "example_id": "031fa211-d941-4f2c-9fff-453951826e9c",
                                                "sense_id": "3a7ac80e-9cc0-38b5-9f41-2f0283c98d9b",
                                                "text": "But honeſt men’s words are Stygian oaths, and promiſes inviolable."
                                            },
                                            {
                                                "example_id": "5f6a08d8-8a62-400b-8017-54cf08093cf3",
                                                "sense_id": "3a7ac80e-9cc0-38b5-9f41-2f0283c98d9b",
                                                "text": "One more request, and I am lost, / If you its earnest prayer deny ; / It is, that you preserve the most / Inviolable secrecy / As to my plan."
                                            },
                                            {
                                                "example_id": "d865255d-dae8-4067-86b2-2ca6ce6857b2",
                                                "sense_id": "3a7ac80e-9cc0-38b5-9f41-2f0283c98d9b",
                                                "text": "\"Now, Mr. Jones, having obtained your promise of inviolable secrecy, I come down to the essential point.\""
                                            },
                                            {
                                                "example_id": "baa25ec1-3bb0-434f-b8f9-03f6a77dc239",
                                                "sense_id": "3a7ac80e-9cc0-38b5-9f41-2f0283c98d9b",
                                                "text": "\"As defined by the first founders of Aya, this world and all who live on it agree to abide by the laws, customs, and regulations of a civilized society that has existed for centuries on other worlds. These rules of conduct ensure a voice for each family within our society and gives them certain inviolable rights...\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97afe238-c8e0-3e5a-a5ff-6c55d7dc05e8",
                                        "entry_id": "e7abce9b-d023-3e95-8a8f-0ee665a4b160",
                                        "glosses": [
                                            "Not susceptible to violence, or of being profaned, corrupted, or dishonoured."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6295fa87-77ae-30d8-88c1-b919666ca8a6",
                                        "entry_id": "e7abce9b-d023-3e95-8a8f-0ee665a4b160",
                                        "glosses": [
                                            "Incapable of being injured or invaded; indestructible."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
