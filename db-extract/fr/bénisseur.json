                "senses": [
                    {
                        "sense_id": "2ddb9f02-0747-3aad-b521-0ea3fe30f796",
                        "entry_id": "4cb4cdbb-de80-3d9c-b6da-cc12624c8f1e",
                        "glosses": [
                            "Celui qui bénit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "072e8006-032e-4458-9a55-7566771dafee",
                                "sense_id": "2ddb9f02-0747-3aad-b521-0ea3fe30f796",
                                "text": "Le bénisseur ne prescrit pas de médicament et prie en faisant le signe de croix; il donne sa bénédiction dans la maison même du malade ou sur des vêtements."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2fc6270-472a-3f99-a840-662c72b101b2",
                        "entry_id": "4cb4cdbb-de80-3d9c-b6da-cc12624c8f1e",
                        "glosses": [
                            "Celui qui excuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e39be232-39d6-4e63-bcec-28a8d0b42f44",
                                "sense_id": "e2fc6270-472a-3f99-a840-662c72b101b2",
                                "text": "Dans les pays conquis, autour des camps retranchés de ces civilisateurs armés, se formaient ensuite les villes allemandes. au milieu d’eux venait s’établir le saint évêque, le bénisseur quand même de tous les attentats commis ou entrepris par ces nobles brigands."
                            }
                        ]
                    }
                ],
