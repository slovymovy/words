                "senses": [
                    {
                        "sense_id": "65cb8aa3-1ced-362c-b2cb-6ef3db4b3c83",
                        "entry_id": "1913f179-cbf7-3e45-8897-0de4e86dd922",
                        "glosses": [
                            "Wort, das Kinder in der frühen Phase des Spracherwerbs, der Lallphase, verwenden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2120210b-0a2c-457f-91f2-c2ee2932776c",
                                "sense_id": "65cb8aa3-1ced-362c-b2cb-6ef3db4b3c83",
                                "text": "„Der Nachweis für diese natürliche Symbolik der kindlichen Lallwörter kann aus ihrer großen Verbreitung geführt werden.“"
                            },
                            {
                                "example_id": "bd745959-9eb7-4a7d-a69a-338fd45ac397",
                                "sense_id": "65cb8aa3-1ced-362c-b2cb-6ef3db4b3c83",
                                "text": "„…; die Sache mit den Lallwörtern kann und muß vom Kinde her auf eine exakte Beobachtungsbasis gestellt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0cd9223-c6a7-402f-bcdb-460dbdb81d1b",
                        "source_entry_id": "1913f179-cbf7-3e45-8897-0de4e86dd922",
                        "source_sense_id": "65cb8aa3-1ced-362c-b2cb-6ef3db4b3c83",
                        "source_sense_description": "Linguistik: Wort, das Kinder in der frühen Phase des Spracherwerbs, der Lallphase, verwenden",
                        "target_lang_word": "babble word",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "babble word",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57733390-a020-3823-916e-7d3b29f1d604",
                                        "entry_id": "b75d6648-ac75-3679-b28b-22cc7b49debb",
                                        "glosses": [
                                            "A phonemically basic word, one which is easy for small children to pronounce and which therefore tends to be produced by them early on (for example, mama): A word from baby talk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1820e378-d9f1-4abd-946d-906ce34c1092",
                                                "sense_id": "57733390-a020-3823-916e-7d3b29f1d604",
                                                "text": "Holonyms: babble, child language, childspeak; baby talk (child-directed speech)"
                                            },
                                            {
                                                "example_id": "8fed1d79-5916-4362-8710-02848daca302",
                                                "sense_id": "57733390-a020-3823-916e-7d3b29f1d604",
                                                "text": "The first primitive bi-syllabic babble words of the 'mama', 'dada', 'baba' variety are the product of a near approximation of simple words in the language environment, and are reinforced by delighted parental response."
                                            },
                                            {
                                                "example_id": "30571082-6e96-4c9a-a4f9-b6d11f940dc6",
                                                "sense_id": "57733390-a020-3823-916e-7d3b29f1d604",
                                                "text": "Jesus called God \"Abba,\" a word that originated as a \"babble word\" originally used by little children but later adopted as an affectionate and respectful way by which adult children also spoke to their fathers."
                                            },
                                            {
                                                "example_id": "07ecfa38-89e6-447a-bb94-c9723a46e68b",
                                                "sense_id": "57733390-a020-3823-916e-7d3b29f1d604",
                                                "text": "As such a babble word, it really translates into English as \"papa\" or \"dada\" or some other equivalent. Every language has these little words that children use before they can really speak, […]"
                                            },
                                            {
                                                "example_id": "b172a1a3-3260-434a-a282-cab100abbc2f",
                                                "sense_id": "57733390-a020-3823-916e-7d3b29f1d604",
                                                "text": "Label the bear “Teddy” aloud to confirm his babble word. Smile and express your pride as you bring over Teddy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
