                                                "sense_id": "09832a01-24d0-3c35-8a59-5cd091d5523f",
                                                "text": "Beim Laden löste sich ein Schuss."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5e087caa-763c-39df-b1c1-21420bfbd1e4",
                                        "entry_id": "0650f1f3-6fef-340a-9929-3b9be824bce4",
                                        "glosses": [
