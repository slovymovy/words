                                        "glosses": [
                                            "Sammlung literarischer Texte, die in der Regel vom gleichen Autoren oder zu einem bestimmten Thema verfasst wurden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64b28f23-571a-4ee7-bcfc-d4201c2bf0d1",
                                                "sense_id": "0621bad4-d202-3430-b1cd-9074b2b5012d",
                                                "text": "Anthologien wurden früher häufig mit dem Ziel erstellt eine Kanonisierung von Literatur zu schaffen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
