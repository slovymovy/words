                        ],
                        "examples": [
                            {
                                "example_id": "931b78a9-4cc8-4473-ab84-63e4bcb94580",
                                "sense_id": "7d5acc2d-9615-3f2b-8a7d-769ee59bdadb",
                                "text": "Alors, datif : au mur ! pour écrire de pareilles machines, parfilage d’Huysmans généreusement retissé avec le vieux coton du stock le plus prudhomme de l’immassacrable Hugo."
                            },
                            {
                                "example_id": "20be1776-446f-4b45-92fb-9b3087a45796",
                                "sense_id": "7d5acc2d-9615-3f2b-8a7d-769ee59bdadb",
                                "text": "Si vous aviez pu vous rendre immassacrables, vous n’auriez même pas mérité d’être massacrés. Or pour vous rendre immassacrables, il fallait et il suffisait que vous massacriez vous-mêmes qui vous massacrait."
                            }
                        ]
