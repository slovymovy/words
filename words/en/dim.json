{
    "word_family": [
        "dimly",
        "dimness",
        "dimmer",
        "dim-witted",
        "undimmed"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3c0ad451-99ab-3017-8a8b-25ea51d75769",
                    "sense_definition": "Not bright or colorful; having a low level of light.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "light_intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lighting was too <w>dim</w> for me to make out his facial features.",
                            "target_lang_translations": {
                                "ru": "Освещение было слишком <w>тусклым</w>, чтобы я мог разглядеть черты его лица."
                            }
                        },
                        {
                            "text": "We sat in a <w>dim</w> corner of the restaurant where it was hard to read the menu.",
                            "target_lang_translations": {
                                "ru": "Мы сидели в <w>темном</w> углу ресторана, где было трудно читать меню."
                            }
                        }
                    ],
                    "synonyms": [
                        "dull",
                        "faint",
                        "lackluster"
                    ],
                    "antonyms": [
                        "bright"
                    ],
                    "common_phrases": [
                        "dim light",
                        "dim room",
                        "dim glow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неяркий или некрасочный; имеющий низкий уровень освещенности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тусклый",
                                "target_lang_sense_clarification": "о свете или цвете"
                            },
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "об источнике света"
                            },
                            {
                                "target_lang_word": "приглушенный",
                                "target_lang_sense_clarification": "о мягком свете"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21b0fd00-61b2-3578-9ca6-026711667df4",
                    "sense_definition": "Indistinct, hazy, or not clearly seen or remembered.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His vision grew <w>dimmer</w> as he aged, making it difficult to drive at night.",
                            "target_lang_translations": {
                                "ru": "С возрастом его зрение стало более <w>слабым</w>, из-за чего ему стало трудно водить машину ночью."
                            }
                        },
                        {
                            "text": "I have a <w>dim</w> recollection of visiting this park when I was a very small child.",
                            "target_lang_translations": {
                                "ru": "У меня осталось <w>смутное</w> воспоминание о посещении этого парка, когда я был совсем маленьким ребенком."
                            }
                        }
                    ],
                    "synonyms": [
                        "vague",
                        "hazy",
                        "indistinct",
                        "obscure"
                    ],
                    "common_phrases": [
                        "dim recollection",
                        "dim memory",
                        "dim outline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неотчетливый, туманный или плохо видимый/запоминающийся."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смутный",
                                "target_lang_sense_clarification": "о воспоминаниях или очертаниях"
                            },
                            {
                                "target_lang_word": "неясный",
                                "target_lang_sense_clarification": "о зрении или памяти"
                            },
                            {
                                "target_lang_word": "туманный",
                                "target_lang_sense_clarification": "о представлении или образе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3b8e8cc-c817-3d59-be92-a90f363841fe",
                    "sense_definition": "Not smart or intelligent; slow to understand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intelligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He may be a bit <w>dim</w>, but he's not entirely stupid.",
                            "target_lang_translations": {
                                "ru": "Может, он и <w>туповат</w>, но он не совсем дурак."
                            }
                        },
                        {
                            "text": "The character in the movie is portrayed as a <w>dim</w> but well-meaning individual.",
                            "target_lang_translations": {
                                "ru": "Персонаж в фильме изображен как <w>недалекий</w>, но доброжелательный человек."
                            }
                        }
                    ],
                    "synonyms": [
                        "thick",
                        "slow-witted",
                        "unintelligent",
                        "dense"
                    ],
                    "antonyms": [
                        "bright"
                    ],
                    "common_phrases": [
                        "bit dim"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не сообразительный или не умный; медленно понимающий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "туповатый",
                                "target_lang_sense_clarification": "разговорное, о человеке"
                            },
                            {
                                "target_lang_word": "недалекий",
                                "target_lang_sense_clarification": "об интеллектуальных способностях"
                            },
                            {
                                "target_lang_word": "тупой",
                                "target_lang_sense_clarification": "грубое, о человеке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2763c36-0fe7-342a-9f58-8331baa7c26d",
                    "sense_definition": "Disapproving or unfavorable; used almost exclusively in the idiom 'take a <w>dim</w> view of'.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school authorities take a <w>dim</w> view of students who skip classes without a valid reason.",
                            "target_lang_translations": {
                                "ru": " Руководство школы <w>не одобряет</w> учеников, которые прогуливают занятия без уважительной причины."
                            }
                        },
                        {
                            "text": "My parents always took a <w>dim</w> view of my desire to become a professional musician.",
                            "target_lang_translations": {
                                "ru": "Мои родители всегда <w>скептически</w> относились к моему желанию стать профессиональным музыкантом."
                            }
                        }
                    ],
                    "synonyms": [
                        "unfavorable"
                    ],
                    "common_phrases": [
                        "take a dim view"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неодобрительный или неблагоприятный; используется почти исключительно в идиоме 'take a dim view of'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скептический",
                                "target_lang_sense_clarification": "в контексте отношения к чему-либо"
                            },
                            {
                                "target_lang_word": "неблагоприятный",
                                "target_lang_sense_clarification": "о взгляде на ситуацию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd14bddf-bc11-3927-91f8-cb548759ce2a",
                    "sense_definition": "A shortened form of <w>diminished</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clipping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In certain technical contexts, the word is used as a <w>dim</w> version of the original term.",
                            "target_lang_translations": {
                                "ru": "В определенных технических контекстах это слово используется как <w>сокращенная</w> версия оригинального термина."
                            }
                        },
                        {
                            "text": "The musician referred to the chord as a <w>dim</w> seventh during the rehearsal.",
                            "target_lang_translations": {
                                "ru": "Во время репетиции музыкант назвал этот аккорд <w>уменьшенным</w> септаккордом."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "clipping"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенная форма слова 'diminished' (уменьшенный)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уменьшенный",
                                "target_lang_sense_clarification": "музыкальный термин, о септаккорде"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "de12d59b-ecf5-3a3e-ac36-859ef45b0e6a",
                    "sense_definition": "To make something less bright or to reduce the intensity of light.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "light_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>dimmed</w> the lights and put on soft music to create a relaxing atmosphere.",
                            "target_lang_translations": {
                                "ru": "Он <w>приглушил</w> свет и включил негромкую музыку, чтобы создать расслабляющую атмосферу."
                            }
                        },
                        {
                            "text": "Please <w>dim</w> the lights before the movie starts so everyone can see the screen.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>выключите</w> свет перед началом фильма, чтобы все могли видеть экран."
                            }
                        }
                    ],
                    "synonyms": [
                        "lower",
                        "soften"
                    ],
                    "common_phrases": [
                        "dim the lights"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-либо менее ярким или уменьшить интенсивность света."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приглушить",
                                "target_lang_sense_clarification": "свет"
                            },
                            {
                                "target_lang_word": "затемнить",
                                "target_lang_sense_clarification": "сделать менее освещенным"
                            },
                            {
                                "target_lang_word": "убавить",
                                "target_lang_sense_clarification": "яркость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06c5123b-bca2-3831-9c14-5599db4dc7ee",
                    "sense_definition": "To become darker or less bright.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "light_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lights <w>dimmed</w> briefly when the air conditioning was turned on.",
                            "target_lang_translations": {
                                "ru": "Свет ненадолго <w>померк</w>, когда включили кондиционер."
                            }
                        },
                        {
                            "text": "As the sun began to set, the natural light in the room started to <w>dim</w>.",
                            "target_lang_translations": {
                                "ru": "Когда солнце начало садиться, естественный свет в комнате стал <w>угасать</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "fade",
                        "darken"
                    ],
                    "common_phrases": [
                        "lights dimmed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться темнее или менее ярким."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тускнеть",
                                "target_lang_sense_clarification": "о свете или блеске"
                            },
                            {
                                "target_lang_word": "меркнуть",
                                "target_lang_sense_clarification": "постепенно угасать"
                            },
                            {
                                "target_lang_word": "померкнуть",
                                "target_lang_sense_clarification": "о свете солнца или ламп"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82c3fc95-2dc9-3741-8c99-4082a003e974",
                    "sense_definition": "To diminish, weaken, or make something like hope or prospects less certain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All these setbacks had started to <w>dim</w> the hopes of the students.",
                            "target_lang_translations": {
                                "ru": "Все эти неудачи начали <w>омрачать</w> надежды студентов."
                            }
                        },
                        {
                            "text": "The recent economic crisis will likely <w>dim</w> the outlook for new business ventures.",
                            "target_lang_translations": {
                                "ru": "Недавний экономический кризис, вероятно, <w>ухудшит</w> перспективы для новых бизнес-проектов."
                            }
                        }
                    ],
                    "synonyms": [
                        "dull",
                        "curtail",
                        "diminish"
                    ],
                    "common_phrases": [
                        "dim the hopes",
                        "dim the outlook"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшать, ослаблять или делать что-либо (например, надежду или перспективы) менее определенным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "омрачать",
                                "target_lang_sense_clarification": "надежды или перспективы"
                            },
                            {
                                "target_lang_word": "ослаблять",
                                "target_lang_sense_clarification": "веру или шансы"
                            },
                            {
                                "target_lang_word": "угасать",
                                "target_lang_sense_clarification": "о надежде"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d99152b7-646e-32ff-abf8-629031b36ffb",
                    "sense_definition": "A state of partial darkness or lack of light.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "darkness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat's eyes glowed brightly in the <w>dim</w> of the hallway.",
                            "target_lang_translations": {
                                "ru": "Глаза кошки ярко светились в <w>полумраке</w> коридора."
                            }
                        },
                        {
                            "text": "It was hard to recognize anyone standing in the <w>dim</w> of the evening.",
                            "target_lang_translations": {
                                "ru": "Было трудно узнать кого-либо, стоящего в вечернем <w>сумраке</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "gloom",
                        "dusk",
                        "twilight"
                    ],
                    "common_phrases": [
                        "in the dim"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used with 'the'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние частичной темноты или нехватки света."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полумрак",
                                "target_lang_sense_clarification": "состояние освещенности"
                            },
                            {
                                "target_lang_word": "сумрак",
                                "target_lang_sense_clarification": "вечерний или предрассветный свет"
                            },
                            {
                                "target_lang_word": "темнота",
                                "target_lang_sense_clarification": "недостаток света"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "56b6069b-c50a-390c-81c3-93146164b452",
                    "sense_definition": "A male given name of Bashkir origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the study is a man named <w>Dim</w>.",
                            "target_lang_translations": {
                                "ru": "Автор исследования — человек по имени <w>Дим</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Bashkir"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское имя башкирского происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Дим",
                                "target_lang_sense_clarification": "имя собственное"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}