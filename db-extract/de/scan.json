                "senses": [
                    {
                        "sense_id": "718d49d0-6cc0-337e-af41-cdb3e7d4d8cc",
                        "entry_id": "296d40ec-9943-3601-9686-223d05fd54c8",
                        "glosses": [
                            "Kopie beziehungsweise das Abbild einer Vorlage, die mit Hilfe eines Scanners erstellt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bf3949f-75a1-483f-aff7-0f068f42fa02",
                                "sense_id": "718d49d0-6cc0-337e-af41-cdb3e7d4d8cc",
                                "text": "Es sollen mit dem Scan Fertigungsaufträge für die Baugruppen erzeugt werden, die alle relevanten Daten speichern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07a810cc-ae11-4cd2-9806-9925fac8feb8",
                        "source_entry_id": "296d40ec-9943-3601-9686-223d05fd54c8",
                        "source_sense_id": "718d49d0-6cc0-337e-af41-cdb3e7d4d8cc",
                        "source_sense_description": "Kopie beziehungsweise das Abbild einer Vorlage, die mit Hilfe eines Scanners erstellt wurde",
                        "target_lang_word": "scan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "392c2a0f-0c09-31a1-8998-bccbea2005b1",
                                        "entry_id": "518c2b83-8222-3003-85d8-11c9daa3ed35",
                                        "glosses": [
                                            "To examine sequentially, carefully, or critically; to scrutinize; to behold closely."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef25aa61-13f8-407d-96f1-e90c3d94f1d3",
                                                "sense_id": "392c2a0f-0c09-31a1-8998-bccbea2005b1",
                                                "text": "She scanned the passage carefully but could not find what she was looking for."
                                            },
                                            {
                                                "example_id": "89370833-5ebe-478f-87d5-8d66b4efa3a1",
                                                "sense_id": "392c2a0f-0c09-31a1-8998-bccbea2005b1",
                                                "text": "He scanned the horizon."
                                            },
                                            {
                                                "example_id": "b63bd7d6-f747-4876-89c7-8507bf97b134",
                                                "sense_id": "392c2a0f-0c09-31a1-8998-bccbea2005b1",
                                                "text": "Yet the incident did not in the least diminish my respect for my teacher. I was by nature blind to the faults of elders. Later I came to know of many other failings of this teacher, but my regard for him remained the same. For I had learnt to carry out the orders of elders, not to scan their actions."
                                            },
                                            {
                                                "example_id": "4b2442e3-5e64-4ae7-b67a-177ccd008812",
                                                "sense_id": "392c2a0f-0c09-31a1-8998-bccbea2005b1",
                                                "text": "Slowly, he scanned the horizon, listening, watching for the signs he had been taught."
                                            },
                                            {
                                                "example_id": "36f99312-2abd-4efb-b4a2-15b27557ac14",
                                                "sense_id": "392c2a0f-0c09-31a1-8998-bccbea2005b1",
                                                "text": "As the 1857 to Manchester Piccadilly rolls in, I scan the windows and realise there are plenty of spare seats, so I hop aboard. The train is a '221'+'220' combo to allow for social distancing - a luxury on an XC train as normally you're playing sardines, so I make the most of it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53cf3fa4-abbc-34eb-85e0-927e290fbce1",
                                        "entry_id": "518c2b83-8222-3003-85d8-11c9daa3ed35",
                                        "glosses": [
                                            "To examine sequentially, carefully, or critically; to scrutinize; to behold closely.",
                                            "To inspect, analyse or go over, often to find something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f15b2d3-995c-43d5-b148-2754f3dc7ae1",
                                                "sense_id": "53cf3fa4-abbc-34eb-85e0-927e290fbce1",
                                                "text": "to scan the hard drive for errors"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "858f3e53-b194-3961-a85d-03ca00c7f8a2",
                                        "entry_id": "518c2b83-8222-3003-85d8-11c9daa3ed35",
                                        "glosses": [
                                            "To look about for; to look over quickly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0603679a-25a1-3b0f-a7cd-f626ee7766fc",
                                        "entry_id": "518c2b83-8222-3003-85d8-11c9daa3ed35",
                                        "glosses": [
                                            "To look about for; to look over quickly.",
                                            "To perform lexical analysis; to tokenize."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f2dee30-7125-39d9-8253-5b2d838edc85",
                                        "entry_id": "518c2b83-8222-3003-85d8-11c9daa3ed35",
                                        "glosses": [
                                            "To create an image of something with the use of a scanner."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65e6e8da-c848-4e66-b9b3-7bfd432a8541",
                                                "sense_id": "0f2dee30-7125-39d9-8253-5b2d838edc85",
                                                "text": "to scan a photograph"
                                            },
                                            {
                                                "example_id": "5c649811-6401-4cd2-9c13-23f131e7f446",
                                                "sense_id": "0f2dee30-7125-39d9-8253-5b2d838edc85",
                                                "text": "to scan internal organs by means of computed tomography"
                                            },
                                            {
                                                "example_id": "fb7d1a66-3160-43f5-804f-b91495ccd8ef",
                                                "sense_id": "0f2dee30-7125-39d9-8253-5b2d838edc85",
                                                "text": "Pencil drawings don't scan very well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f38ccd5-de72-3ae4-bf11-abb288cad71b",
                                        "entry_id": "518c2b83-8222-3003-85d8-11c9daa3ed35",
                                        "glosses": [
                                            "To read with an electronic device."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8f9a94b-2e37-4a33-9deb-d09375f6df68",
                                                "sense_id": "4f38ccd5-de72-3ae4-bf11-abb288cad71b",
                                                "text": "to scan a barcode"
                                            },
                                            {
                                                "example_id": "1fa053d9-9bb6-4b75-a9fe-1df6cc32a78d",
                                                "sense_id": "4f38ccd5-de72-3ae4-bf11-abb288cad71b",
                                                "text": "to scan a QR code"
                                            },
                                            {
                                                "example_id": "263b5bef-012b-48f0-941c-b634decf2449",
                                                "sense_id": "4f38ccd5-de72-3ae4-bf11-abb288cad71b",
                                                "text": "In the dispute with the RMT about scanning tickets, Jackson said it was the right thing to do to pay conductors something to scan tickets. Northern pays two pence per scan, Jackson noted, adding that ticket scanning helps to cut fraud and increase staff visibility."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c961f18a-c93a-34ac-9dc9-d642260206bf",
                                        "entry_id": "518c2b83-8222-3003-85d8-11c9daa3ed35",
                                        "glosses": [
                                            "To mount by steps; to go through with step by step."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0397489d-0c6d-49f9-a2bd-4aa669439f84",
                                                "sense_id": "c961f18a-c93a-34ac-9dc9-d642260206bf",
                                                "text": "But ere these matchless heights I dare to scan, / There is a spot should not be pass'd in vain,— / Morat ! the proud, the patriot field ! where man / May gaze on ghastly trophies of the slain,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96011033-8308-3d97-bae7-a44c403746b7",
                                        "entry_id": "518c2b83-8222-3003-85d8-11c9daa3ed35",
                                        "glosses": [
                                            "To read or mark so as to show a specific metre."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02a33b61-ca4a-4e80-80c1-8a4d30dfd3d2",
                                                "sense_id": "96011033-8308-3d97-bae7-a44c403746b7",
                                                "text": "In such cases as these, almost any one with a good ear will \"scan\" the verse correctly enough without instruction. It is not proposed to give here a list of Shakspere's slurred and contracted words; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a324d126-50fb-3b5f-88dc-e1dd9a577f17",
                                        "entry_id": "518c2b83-8222-3003-85d8-11c9daa3ed35",
                                        "glosses": [
                                            "To conform to a metrical structure."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d323ae1-74d3-46f5-9e23-98022d305a4c",
                                                "sense_id": "a324d126-50fb-3b5f-88dc-e1dd9a577f17",
                                                "text": "You're right, sir, it doesn't scan very well in the English, but in the Gaelic it's sheer poetry. Have you the Gaelic?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a109af5-4018-3d1b-ad63-4cf12bb078af",
