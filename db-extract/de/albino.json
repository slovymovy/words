                    },
                    {
                        "translation_id": "2fe59328-8585-4c61-b26e-b0aa33624b75",
                        "source_entry_id": "787c7737-be64-3cfb-9d54-ce7d33b4823a",
                        "source_sense_id": "942e0d98-3241-3b76-b064-9a9f75f53c53",
                        "source_sense_description": "Lebewesen mit der angeborenen Störung Albinismus",
                        "target_lang_word": "альбинос",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "альбинос",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6dd41687-129e-3517-b40a-3037019c9628",
                                        "entry_id": "1f7945c3-9590-3495-81d4-882e2c6d7caa",
                                        "glosses": [
                                            "человек, животное или растение с признаками альбинизма"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fc30cba-3aa1-4a5b-aaa2-0061a9794405",
                                                "sense_id": "6dd41687-129e-3517-b40a-3037019c9628",
                                                "text": "И молчал избиваемый солдат, белорус-альбинос, на голову выше подполковника."
                                            },
                                            {
                                                "example_id": "5d7d8b82-8a82-4563-8131-8c16ec5a75f3",
                                                "sense_id": "6dd41687-129e-3517-b40a-3037019c9628",
                                                "text": "Или то высокое окно кондитерской в Дельфте, где между двумя синими вазами, среди белых орхидей на подоконнике сидела кошка-альбинос, тишайшая, ласковая; приподнималась и деликатно трогала лапкой стекло, словно внимания просила: а вот что сейчас скажу."
                                            },
                                            {
                                                "example_id": "5a23e6b8-7eaa-4cea-9ca4-481450666b2d",
                                                "sense_id": "6dd41687-129e-3517-b40a-3037019c9628",
                                                "text": "Ему показалось, что и сам он такая же травинка-альбинос."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
