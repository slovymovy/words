                                "target_senses": [
                                    {
                                        "sense_id": "5040700a-86ad-3fa0-b5a7-c632147da47f",
                                        "entry_id": "cce93b3a-99be-3ad9-8716-74c5dd3d152d",
                                        "glosses": [
                                            "Cheval utilisé pour une course de cheval, généralement un cheval à sang chaud : pur-sang ou demi-sang."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26c5294a-fa76-4afd-86c2-52501f63b854",
                                                "sense_id": "5040700a-86ad-3fa0-b5a7-c632147da47f",
                                                "text": "Le cheval de course est un cheval de rêve. Il gagne en cinq minutes d’incroyables fortunes. Désormais millionnaire, il prend des mœurs de riche : il ne voyage plus qu’en première dans le métro."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1956aaa7-e430-4d82-ab61-240d2e293c54",
                        "source_entry_id": "1152d406-b123-3b2f-b638-ca52c8b6a247",
                        "source_sense_id": "245d76d1-bbd4-32a9-8070-fb1e3e6e2bfa",
                        "source_sense_description": "horse that competes in races",
                        "target_lang_word": "Rennpferd",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rennpferd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fca60fe6-fee9-374a-9e67-76383b69ad50",
                                        "entry_id": "68a138a0-4eca-3503-9eb3-4e7ada63d810",
                                        "glosses": [
                                            "sehr schnelles Pferd, das speziell für den Einsatz bei Pferderennen gezüchtet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a63fb39b-b02a-421f-91f1-f7e539325475",
                                                "sense_id": "fca60fe6-fee9-374a-9e67-76383b69ad50",
                                                "text": "„Zwei Rennpferde sind vor dem Start eines Galopprennens in England unter mysteriösen Umständen tot zusammengebrochen.“"
                                            },
                                            {
                                                "example_id": "e4d4c408-dcb8-4c52-afad-c813f37d6db6",
                                                "sense_id": "fca60fe6-fee9-374a-9e67-76383b69ad50",
                                                "text": "„So werden etwa Trüffel, Hundefutter und Rennpferde mit 7 Prozent, Babywindeln hingegen mit 19 Prozent voll besteuert.“"
                                            },
                                            {
                                                "example_id": "d761fecb-7083-4bd0-a0e6-3857f61362da",
                                                "sense_id": "fca60fe6-fee9-374a-9e67-76383b69ad50",
                                                "text": "„Ein paar Arbeiter diskutierten über Rennpferde in Nizza, zwei Postschaffner studierten den Wetterbericht aus Paris, und ein Kutscher renommierte mit seinen Zeiten als Trabrennfahrer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
