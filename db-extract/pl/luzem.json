                    {
                        "translation_id": "f685d7eb-79de-43c8-8159-efc52a6d38f8",
                        "source_entry_id": "aa599f06-0625-3851-9657-f5c73fabbe83",
                        "source_sense_id": "4281d691-5eb2-3515-8d69-c65f3b483c76",
