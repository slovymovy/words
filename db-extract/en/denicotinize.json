                "senses": [
                    {
                        "sense_id": "a1c6be69-9416-39fd-92a0-ae28136c5c49",
                        "entry_id": "15dfbcfa-d093-34c9-bbcb-dd7c603e9f02",
                        "glosses": [
                            "to remove some or all of the nicotine from tobacco."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "945547fe-c6e4-4571-937d-0ce861dc3328",
                                "sense_id": "a1c6be69-9416-39fd-92a0-ae28136c5c49",
                                "text": "My invention relates to a chemical preparation, compound, or mixture to be used in pipes, pipe-stems, and cigar-holders, in any convenient mode or form, to denicotinize and deodorize tobacco-smoke,"
                            },
                            {
                                "example_id": "88d47724-21ec-4645-9476-01e02923581b",
                                "sense_id": "a1c6be69-9416-39fd-92a0-ae28136c5c49",
                                "text": "The solution of the problem how to denicotinize without destroying flavour is extraordinarily difficult and appears to be only partially solved."
                            },
                            {
                                "example_id": "86b5f3be-8c4a-4e70-bc01-9f4c4fe9dcb3",
                                "sense_id": "a1c6be69-9416-39fd-92a0-ae28136c5c49",
                                "text": "Kessler was extremely careful to avoid any suggestion that FDA was prepared to take radical action to prohibit — or denicotinize — cigarettes."
                            }
                        ]
                    }
                ],
