    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "282267f1-80f6-3d6b-8bf8-453e8a638722",
                "word": "leveret",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c5f3fb33-6357-441d-8c86-6d7ec123ba67",
                        "entry_id": "282267f1-80f6-3d6b-8bf8-453e8a638722",
                        "tags": [
                            "plural"
                        ],
                        "form": "leverets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c62fc7ce-c5b4-3e67-9e74-e36218750b54",
                        "entry_id": "282267f1-80f6-3d6b-8bf8-453e8a638722",
                        "glosses": [
                            "A young hare less than one year old."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea112873-a782-4af9-8698-4e9959998bf4",
                                "sense_id": "c62fc7ce-c5b4-3e67-9e74-e36218750b54",
                                "text": "[…] Shall I die like a leveret,\nWithout any resistance?—Help, help, help!\nI am slain!"
                            },
                            {
                                "example_id": "2667d94c-d1cf-412a-b461-9b35a39a0313",
                                "sense_id": "c62fc7ce-c5b4-3e67-9e74-e36218750b54",
                                "text": "Fair Hand that can on Virgin-paper write,\n Yet from the stain of Ink preserve it white,\nWhose travel o’er that Silver Field does show,\nLike track of Leveretts in morning Snow;"
                            },
                            {
                                "example_id": "8018b632-164f-4b90-b84c-9f009cd50526",
                                "sense_id": "c62fc7ce-c5b4-3e67-9e74-e36218750b54",
                                "text": "As when two skilful hounds the leveret wind;\nOr chase through woods obscure the trembling hind;\nNow lost, now seen, they intercept his way,\nAnd from the herd still turn the flying prey:\nSo fast, and with such fears, the Trojan flew;\nSo close, so constant, the bold Greeks pursue."
                            },
                            {
                                "example_id": "0304cd76-0d04-4ade-a658-b20c60cc8bc6",
                                "sense_id": "c62fc7ce-c5b4-3e67-9e74-e36218750b54",
                                "text": "They heard Marvel squeal like a caught leveret, and forthwith they were clambering over the bar to his rescue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "391a2d91-384b-4386-8826-6b9f0c296f7e",
