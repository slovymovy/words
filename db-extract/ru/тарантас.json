                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "013f13d2-1ff7-4e9e-b798-38bf13ead703",
                        "source_entry_id": "74686f63-18b2-32ba-8d50-b1bd5881e18d",
                        "source_sense_description": "повозка",
                        "target_lang_word": "tarantass",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tarantass",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "03d9785c-fb89-3033-acf4-a5aa77c0c5af",
                                        "entry_id": "483e4f0a-c58f-3f62-894b-192750641b7b",
                                        "glosses": [
                                            "Voiture hippomobile qui était utilisée en Russie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36e2f34c-4edc-4309-a63a-129dfb39276a",
                                                "sense_id": "03d9785c-fb89-3033-acf4-a5aa77c0c5af",
                                                "text": "Michel Strogoff aurait bien été forcé d’employer la télègue, s’il n’eût été assez heureux pour découvrir un tarentass."
                                            },
                                            {
                                                "example_id": "8c1e3c22-7630-4f41-94b8-960eb7a7636c",
                                                "sense_id": "03d9785c-fb89-3033-acf4-a5aa77c0c5af",
                                                "text": "Ayez donc appris que le « tarantass » est une sorte de berline, reposant sur cinq pièces de bois assez élastiques, entre des roues largement espacées et de moyenne hauteur, que cette voiture est conduite par un « yemtchik »."
                                            },
                                            {
                                                "example_id": "d3b43cc1-2b72-4e82-8c2f-14b9ab0631fa",
                                                "sense_id": "03d9785c-fb89-3033-acf4-a5aa77c0c5af",
                                                "text": "Préparez-vous, et moi je vais donner ordre qu’on attelle le tarantass."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e37e2cd-f046-40ff-befc-e72657e467e8",
                        "source_entry_id": "74686f63-18b2-32ba-8d50-b1bd5881e18d",
                        "source_sense_description": "старая машина",
                        "target_lang_word": "Kutsche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kutsche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33b8d578-1c31-3510-8951-b742a7b6841d",
                                        "entry_id": "451ca8c9-4749-3803-a13f-d2d8b4c6682c",
                                        "glosses": [
                                            "ein- oder zweiachsiges Fuhrwerk mit Karosserie oder beweglichem Verdeck; (ursprünglich) durch Nutztiere wie Pferde oder Ochsen gezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5e14925-9970-43f2-b8e6-68cf2d8e8acd",
                                                "sense_id": "33b8d578-1c31-3510-8951-b742a7b6841d",
                                                "text": "In Wien ist es für viele Besucher unerlässlich, mit einer Kutsche durch die Stadt zu fahren."
                                            },
                                            {
                                                "example_id": "82ecf1f8-72bf-4d34-b12e-c6c34a981dd2",
                                                "sense_id": "33b8d578-1c31-3510-8951-b742a7b6841d",
                                                "text": "„Schon der Anblick einer Kutsche macht mich ja ganz krank.“"
                                            },
                                            {
                                                "example_id": "81a7b6f7-c840-4f7a-91e5-74f19271eba0",
                                                "sense_id": "33b8d578-1c31-3510-8951-b742a7b6841d",
                                                "text": "„Droschken und leichte Kutschen waren die einzigen von den Ordnungsbehörden noch zugelassenen Fahrzeuge.“"
                                            },
                                            {
                                                "example_id": "6ce216a8-064d-4ae6-9be9-25fc75cad405",
                                                "sense_id": "33b8d578-1c31-3510-8951-b742a7b6841d",
                                                "text": "„Andere wandten ein, es werde die Gemeinde zehn Pfund und zwölf Schilling für die Kutsche und die Dienste eines Wärters kosten, das Mädchen zur Einschiffung nach London zu schaffen.“"
                                            },
                                            {
                                                "example_id": "9f3b3d9a-6447-47af-a091-ce6dc3c56552",
                                                "sense_id": "33b8d578-1c31-3510-8951-b742a7b6841d",
                                                "text": "„Isa und ich stiegen in die Kutsche, und auf rumpeligem Kopfsteinpflaster ging es nach Müggenburg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9741682f-8f13-31d2-bdda-8859b55227c2",
                                        "entry_id": "451ca8c9-4749-3803-a13f-d2d8b4c6682c",
                                        "glosses": [
                                            "ein Auto"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
