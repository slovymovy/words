                                    {
                                        "sense_id": "ae3b2780-dc88-3308-bd38-ab7be82dc7d9",
                                        "entry_id": "8c69cee3-a98a-3638-8776-9469d27a7b56",
                                        "glosses": [
                                            "w sposób bezwładny"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e605419e-eed2-4c3d-b3c9-092f790b8a50",
                                                "sense_id": "ae3b2780-dc88-3308-bd38-ab7be82dc7d9",
                                                "text": "Jeżeli sprawy dadzą się w ten sposób ułożyć, opuszczam ramiona, rzucam się bezwładnie kolejom losu, niech wszystko ginie, przepada, niech się raz kończą piekielne udręczenia"
                                            },
                                            {
                                                "example_id": "e5125916-04dc-4339-a12f-58ab0c6c34fa",
                                                "sense_id": "ae3b2780-dc88-3308-bd38-ab7be82dc7d9",
                                                "text": "Spoczywał bezwładnie na stole oparty"
                                            },
                                            {
                                                "example_id": "41415ca9-84e2-4995-bbb1-afc300224c77",
                                                "sense_id": "ae3b2780-dc88-3308-bd38-ab7be82dc7d9",
                                                "text": "Chciał coś powiedzieć, ale się zatoczył nagle jak pijany i ciężko, bezwładnie zwalił się na podłogę"
                                            },
                                            {
                                                "example_id": "1f0035a6-7fd4-42f8-897d-b131dc9a3e4f",
                                                "sense_id": "ae3b2780-dc88-3308-bd38-ab7be82dc7d9",
                                                "text": "Polluks poruszył jeszcze kilka razy wiosłami i — jak Sotion — osunął się bezwładnie na deski"
                                            },
                                            {
                                                "example_id": "25b8bb38-f4aa-48f7-8b45-83669b19bb55",
                                                "sense_id": "ae3b2780-dc88-3308-bd38-ab7be82dc7d9",
                                                "text": "Kij wypadł mi na ziemię, ręce obwisły bezwładnie"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
