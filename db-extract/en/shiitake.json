                                "target_senses": [
                                    {
                                        "sense_id": "02470957-16ec-33a5-8625-5ab6db532e85",
                                        "entry_id": "7fec9f49-d477-3cdb-a1ab-e49025128fdd",
                                        "glosses": [
                                            "Espèce de champignon comestible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "702b9edc-6849-4ee2-8334-73fb63b09b8b",
                                                "sense_id": "02470957-16ec-33a5-8625-5ab6db532e85",
                                                "text": "Ainsi, la Station de recherche forestière de Kumamoto étudie la culture du Shiitaké mais également les techniques de lutte contre la « bactérie pernicieuse » du Shiitaké."
                                            },
                                            {
                                                "example_id": "f493d036-6114-45a8-ac82-e378e983d704",
                                                "sense_id": "02470957-16ec-33a5-8625-5ab6db532e85",
                                                "text": "Ajouter les shiitakés sur un côté de la casserole, cuire environ 1 min."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
