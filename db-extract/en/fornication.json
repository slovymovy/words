                                "target_senses": [
                                    {
                                        "sense_id": "bf2d6fca-edde-30ab-be24-6da68efe53c0",
                                        "entry_id": "d8b41bfe-79bc-3e6f-bd14-c68305422856",
                                        "glosses": [
                                            "устар. нарушение супружеской верности мужем или женой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "639fc99a-2a53-47ac-9120-c5f520cb8e37",
                                                "sense_id": "bf2d6fca-edde-30ab-be24-6da68efe53c0",
                                                "text": "О разводе же говорю вам, что кто разведется с женою, тот сам прелюбодействует и жену вводит в прелюбодеяние."
                                            },
                                            {
