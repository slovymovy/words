                "translations": [
                    {
                        "translation_id": "3978a607-afae-4c51-af52-8dec778589a9",
                        "source_entry_id": "e4322c65-c896-3b8d-9914-816f73e8a561",
                        "source_sense_id": "1ddebdcc-a73c-3454-ad19-c5ffe9f5bcfe",
                        "target_lang_word": "Öffentlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Öffentlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cdd01fe4-494e-3752-8723-9c40ee7e04f1",
                                        "entry_id": "743d6512-c896-3a49-9c03-bb71757fe6ac",
                                        "glosses": [
                                            "breite Masse der Leute"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2f018c7-cd42-403c-9ceb-fdc5adf0eaae",
                                                "sense_id": "cdd01fe4-494e-3752-8723-9c40ee7e04f1",
                                                "text": "Die Öffentlichkeit reagiert auf solche Äußerungen meist empfindlich."
                                            },
                                            {
                                                "example_id": "dc36e299-8f57-43da-8de7-11a9465fae5b",
                                                "sense_id": "cdd01fe4-494e-3752-8723-9c40ee7e04f1",
                                                "text": "„Einige namhafte Fachvertreter beschäftigen sich mit der Frage, welche Möglichkeiten es für die Sprachwissenschaft gibt, das berechtigte und aus linguistischer Sicht durchaus wünschenswerte Interesse der Öffentlichkeit an Sprache ernst zu nehmen, ohne dabei Gefahr zu laufen, die komplexen Zusammenhänge unzulässig zu vereinfachen.“"
                                            },
                                            {
                                                "example_id": "713d0369-af85-4a87-b954-539a33c08699",
                                                "sense_id": "cdd01fe4-494e-3752-8723-9c40ee7e04f1",
                                                "text": "„Der Aufstand auf dem Maidan hat dazu geführt, dass der Staat erstmals Angst vor der Öffentlichkeit bekam.“"
                                            },
                                            {
                                                "example_id": "03bd8678-0893-41ef-8f1e-f5513a90e1a9",
                                                "sense_id": "cdd01fe4-494e-3752-8723-9c40ee7e04f1",
                                                "text": "„Am letzten Julitag, einem Freitag, steigerte sich die Unruhe der Öffentlichkeit abermals.“"
                                            },
                                            {
                                                "example_id": "6ba02e8b-302b-40d6-b821-8355bfad3ca7",
                                                "sense_id": "cdd01fe4-494e-3752-8723-9c40ee7e04f1",
                                                "text": "„Die Öffentlichkeit erfuhr davon zunächst nichts.“"
                                            },
                                            {
                                                "example_id": "3b64e73f-daba-43a5-bf91-a3fd17cb945d",
                                                "sense_id": "cdd01fe4-494e-3752-8723-9c40ee7e04f1",
                                                "text": "„Die Lausitz ist seit dem beschlossenen Kohleausstieg spätestens im Jahr 2038 in den Fokus der Öffentlichkeit geraten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cd05c14c-75bc-3d03-8d3f-f658dee0a2c1",
                                        "entry_id": "743d6512-c896-3a49-9c03-bb71757fe6ac",
                                        "glosses": [
                                            "für die Menschen frei zugänglicher Platz oder frei zugängliche Umgebung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf50fd2a-dee3-47dc-ac57-7b528c724eb9",
                                                "sense_id": "cd05c14c-75bc-3d03-8d3f-f658dee0a2c1",
                                                "text": "In vielen Ländern ist es verboten, in der Öffentlichkeit Alkohol zu konsumieren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
