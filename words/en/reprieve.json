    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "366b0ebe-1574-3864-8797-f41b0621744d",
                    "sense_definition": "The cancellation or postponement of a punishment, especially a death sentence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_relief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoner was granted a <w>reprieve</w> just hours before his scheduled execution."
                        },
                        {
                            "text": "The governor signed the <w>reprieve</w> to stop the punishment."
                        }
                    ],
                    "synonyms": [
                        "pardon",
                        "stay"
                    ],
                    "common_phrases": [
                        "grant a reprieve"
                    ]
                },
                {
                    "sense_id": "7c15fba6-631b-3548-819c-7dade5b69d7c",
                    "sense_definition": "A temporary relief from something unpleasant, such as pain or a difficult situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "general_relief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cool breeze provided a brief <w>reprieve</w> from the intense summer heat."
                        },
                        {
                            "text": "Winning the game offered a short <w>reprieve</w> from their recent string of losses."
                        }
                    ],
                    "synonyms": [
                        "respite",
                        "relief"
                    ],
                    "common_phrases": [
                        "brief reprieve"
                    ]
                },
                {
                    "sense_id": "aa4d794e-9cdd-34f0-a988-ec6259e1c9c7",
                    "sense_definition": "The cancellation or postponement of a planned closure or removal of a service.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "general_relief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local library received a <w>reprieve</w> after the community protested the planned closure."
                        },
                        {
                            "text": "The train station was saved by a last-minute <w>reprieve</w> from the city council."
                        }
                    ]
                },
                {
                    "sense_id": "529e4cd2-6f3c-3193-b070-95001c6bdbd6",
                    "sense_definition": "A formal document that officially authorizes the postponement of a punishment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_relief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer arrived at the prison carrying the signed <w>reprieve</w>."
                        },
                        {
                            "text": "The official <w>reprieve</w> was delivered to the warden by a special messenger."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6dce405b-830e-335a-8071-f9bb22a9be13",
                    "sense_definition": "To officially cancel or delay the punishment of someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_relief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge decided to <w>reprieve</w> the prisoner due to new evidence."
                        },
                        {
                            "text": "The governor chose to <w>reprieve</w> the convict from his death sentence."
                        }
                    ],
                    "synonyms": [
                        "pardon"
                    ]
                },
                {
                    "sense_id": "3a9f1972-e9a1-385d-a21f-9b46eac59993",
                    "sense_definition": "To stop or delay plans to close or abolish something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "general_relief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>reprieve</w> the factory for another year."
                        },
                        {
                            "text": "Officials <w>reprieve</w> the historic building from demolition to study its architecture."
                        }
                    ]
                },
                {
                    "sense_id": "764b535a-b08a-300d-9480-dcfed7704cc4",
                    "sense_definition": "To provide temporary relief or comfort to someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "general_relief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Music can often <w>reprieve</w> a person from their daily worries."
                        },
                        {
                            "text": "A short vacation helped to <w>reprieve</w> him from his exhaustion."
                        }
                    ],
                    "synonyms": [
                        "relieve"
                    ]
                },
                {
                    "sense_id": "51714150-f8cb-37bc-8c81-53ca6a32e2a5",
                    "sense_definition": "To return a prisoner to jail instead of carrying out an execution.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_relief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court ordered the guards to <w>reprieve</w> the inmate back to his cell."
                        },
                        {
                            "text": "They had to <w>reprieve</w> the prisoner after the last-minute appeal."
                        }
                    ]
                }
            ]
        }
    ]
