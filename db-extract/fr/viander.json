                    }
                ],
                "senses": [
                    {
                        "sense_id": "86fe3471-1cfc-3f28-8461-fe3c6cd3dc0e",
                        "entry_id": "5d040ef1-00b7-342c-9877-849dbcfd5f2e",
                        "glosses": [
                            "Pâturer, en parlant des cerfs et autres bêtes fauves."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b8b5eac-c429-4f02-ac57-306b86365f31",
                                "sense_id": "86fe3471-1cfc-3f28-8461-fe3c6cd3dc0e",
                                "text": "Le cerf va viander la nuit."
                            },
                            {
                                "example_id": "d918866d-fbc9-4fa0-a719-743302f56a40",
                                "sense_id": "86fe3471-1cfc-3f28-8461-fe3c6cd3dc0e",
                                "text": "Leur nourriture est différente suivant les différentes saisons ; en automne, après le rut ils cherchent les boutons des arbustes verts, les fleurs de bruyères, les feuilles de ronces, etc. en hiver, lorsqu'il neige, ils pèlent les arbres et se nourrissent d'écorces, de mousse, etc. et lorsqu'il fait un temps doux, ils vont viander dans les blés ; au commencement du printemps, ils cherchent les chatons des trembles, des marsaules, des coudriers, les fleurs et les boutons du cornouiller, etc. en été, ils ont de quoi choisir, mais ils préfèrent les seigles à tous les autres grains, et la bourgenne à tous les autres bois."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1e6fc2f-c113-304e-b668-c907c98fe62f",
                        "entry_id": "5d040ef1-00b7-342c-9877-849dbcfd5f2e",
                        "glosses": [
                            "Se tuer, se blesser, notamment d’une façon violente, souvent au volant ou au guidon d’un véhicule, et d’une manière générale « avoir un accident »."
                        ],
                        "tags": [
                            "pronominal",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "10728b12-cd34-4821-97a2-30a8199c6f51",
                                "sense_id": "e1e6fc2f-c113-304e-b668-c907c98fe62f",
                                "text": "À Viña del Mar, des terroristes viennent de se viander en manipulant des explosifs."
                            }
                        ]
                    },
                    {
                        "sense_id": "90388044-a955-36af-8b3a-221af9b48e5b",
                        "entry_id": "5d040ef1-00b7-342c-9877-849dbcfd5f2e",
                        "glosses": [
                            "Tomber violemment."
                        ],
                        "tags": [
                            "familiar",
                            "pronominal"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54210518-950b-416e-b891-4f308d631d91",
                        "source_entry_id": "5d040ef1-00b7-342c-9877-849dbcfd5f2e",
                        "source_sense_id": "86fe3471-1cfc-3f28-8461-fe3c6cd3dc0e",
                        "source_sense_description": "(Vénerie) Pâturer, en parlant des cerfs et autres bêtes fauves.",
                        "target_lang_word": "äsen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "äsen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a312eb51-f683-3cb6-b0e2-5f31e49ab5b3",
                                        "entry_id": "dab01e9b-55cb-32d2-8156-0a976d1415e2",
                                        "glosses": [
                                            "Gras fressen, weiden"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cd3c368-a01b-4031-a8ef-b5ae8c64d7a8",
                                                "sense_id": "a312eb51-f683-3cb6-b0e2-5f31e49ab5b3",
                                                "text": "Die Vöglein zwitschern im Walde, einige Kletterer versuchen sich an einem nahen Felszacken, friedlich äsen Rehe auf der Lichtung, eine kleine Hochzeitsgesellschaft ergeht sich spazierend."
                                            },
                                            {
                                                "example_id": "76d467d4-0c56-4e4d-b7fc-bca7e8e67035",
                                                "sense_id": "a312eb51-f683-3cb6-b0e2-5f31e49ab5b3",
                                                "text": "Zwischen Rotwand und Taubenstein zum Beispiel kann man im Frühjahr ganze Rudel der kräftigen, ziegengroßen Wildtiere mit ihren markant nach hinten gebogenen Hörnern beobachten, wie sie auf den Almwiesen äsen."
                                            },
                                            {
                                                "example_id": "465e7e96-0d81-4ddf-940b-028f75ce47d2",
                                                "sense_id": "a312eb51-f683-3cb6-b0e2-5f31e49ab5b3",
                                                "text": "Im 35 ha großen, von Mauern umgebenen Park La Mandria äsen Hirsche und Rehe unbesorgt auf den Wiesen, denn schießen darf hier keiner mehr."
                                            },
                                            {
                                                "example_id": "d9f60c27-498d-4f68-99e6-9bbeb316c4ba",
                                                "sense_id": "a312eb51-f683-3cb6-b0e2-5f31e49ab5b3",
                                                "text": "Sie erblicken nämlich hinter dem Gebäude zwei kapitale Hirsche, die in aller Ruhe in einem Maisacker äsen."
                                            },
                                            {
                                                "example_id": "7b76260f-04cd-4e21-8663-62c48cd758c3",
                                                "sense_id": "a312eb51-f683-3cb6-b0e2-5f31e49ab5b3",
                                                "text": "Nebenan der Wald, wo Fuchs und Hase sich gute Nacht sagen, Rehe in der Lichtung äsen und Kühe auf der Wiese unterhalb des Hauses weiden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
