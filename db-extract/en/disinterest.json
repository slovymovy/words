                "senses": [
                    {
                        "sense_id": "1e96a454-f0e0-38c9-8ac8-48cbdf7d1c0c",
                        "entry_id": "d3a26def-4704-3828-9f95-1fa181d03f54",
                        "glosses": [
                            "Free of personal bias."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f184f37c-ceca-4df8-b630-e25e602d4d4e",
                                "sense_id": "1e96a454-f0e0-38c9-8ac8-48cbdf7d1c0c",
                                "text": "[…] if they [weaker people] can be rul’d by an understanding without, when they have none within, they shall receive this advantage, that their owne passions shall not transport their mindes, and the divisions and weaknesse of their owne sense and notices shall not make them uncertaine, and indeterminate; and the measures they shall walke by, shall be disinterest and even, and dispassionate, and full of observation."
                            }
                        ]
                    }
