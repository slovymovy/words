                    {
                        "sense_id": "dcd9aba2-658b-34ed-b1a0-1839ee10b1af",
                        "entry_id": "4bc39836-c2d1-3698-bde5-cb1f9c64e53f",
                        "glosses": [
                            "Tic de langage consistant à répéter souvent « en même temps »."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b9b5e301-ac22-3446-8742-c4e6bb01cf53",
                        "entry_id": "4bc39836-c2d1-3698-bde5-cb1f9c64e53f",
                        "glosses": [
                            "Fait d’être en même temps de gauche et de droite."
                        ],
                        "tags": [
                            "ironic",
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "ddb07443-2fc8-46b4-9922-28b100472cdf",
                                "sense_id": "b9b5e301-ac22-3446-8742-c4e6bb01cf53",
                                "text": "C’est le premier acte du « en-même-tempisme ». Un pari osé, qui peut réussir… et en même temps qui peut échouer."
                            },
                            {
                                "example_id": "cdc785ac-45e7-4dce-a984-219d793abf76",
                                "sense_id": "b9b5e301-ac22-3446-8742-c4e6bb01cf53",
                                "text": "La réforme du droit du travail qui vient d’être présentée est caractéristique des limites de l’ « en-même-tempisme », cet avatar du centrisme dont Emmanuel Macron a fait la marque de son action : bien intentionné, il manque sa cible… parce qu’il est trop bien-intentionné."
                            },
                            {
                                "example_id": "f6ddc587-0982-44b9-95ea-11f08932c3be",
                                "sense_id": "b9b5e301-ac22-3446-8742-c4e6bb01cf53",
                                "text": "L’argument de la complexité ne tient pas plus que celui de l’horreur des obligations. Aujourd’hui, le « en-même-tempisme » fait une nouvelle victime : l’égalité d’accès aux soins."
                            }
                        ]
                    }
