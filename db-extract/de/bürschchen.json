                ],
                "senses": [
                    {
                        "sense_id": "b7fde185-ba80-381a-8d3c-0c7ff708ef4d",
                        "entry_id": "1d1373e5-5166-3d5c-af62-07d206c05c78",
                        "glosses": [
                            "kleiner Bursche"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "d9d7f734-5f7e-475f-b3a3-02af2cbd4aba",
                                "sense_id": "b7fde185-ba80-381a-8d3c-0c7ff708ef4d",
                                "text": "„»Geige spielen«, erwiderte das Bürschchen, gleichfalls ohne sein Spiel zu unterbrechen.“"
                            },
                            {
                                "example_id": "212b0d28-8f96-42ac-9b5b-daa3f7b00aa4",
                                "sense_id": "b7fde185-ba80-381a-8d3c-0c7ff708ef4d",
                                "text": "„Ein mageres Bürschchen, mit eingefallenem Brustkasten, und was hält das Bürschchen unter dem Arm?“"
                            },
                            {
                                "example_id": "7439c446-0631-4d0d-92ab-e758f3c93e8c",
                                "sense_id": "b7fde185-ba80-381a-8d3c-0c7ff708ef4d",
                                "text": "„Mit dem Gewehrkolben traktierte ein junger Cop das Kinn eines Bürschchens, das gar nicht geplündert hatte und nur hinter den Flüchtenden hergezockelt war.“"
                            },
                            {
                                "example_id": "eaafc4f2-0381-49f3-828e-26dfa81bcb8b",
                                "sense_id": "b7fde185-ba80-381a-8d3c-0c7ff708ef4d",
                                "text": "„Seht euch das an, in dem Bürschchen erwacht die sexuelle Neugier, sagten sie in meiner Familie, als ich mit zwölf anfing, in den Büchern von Kristmann Guđmundsson zu lesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
