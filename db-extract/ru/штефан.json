                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3a2a6c3-2d6f-4b27-a8ca-4672ec2c70d2",
                        "source_entry_id": "0bd4b628-93f1-3ba0-b38e-33bcfc0d39d4",
                        "source_sense_id": "95966fe1-cfce-3181-8f7a-76e737218ff9",
                        "target_lang_word": "Stefan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stefan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29ca7bd3-6c7b-3919-853c-bb8cf6076c75",
                                        "entry_id": "4b9e46f5-336e-3e1a-b0ed-4c72c5c8d12b",
                                        "glosses": [
                                            "männlicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75150da2-d5fa-4b54-8fe5-d715b970ae50",
                                                "sense_id": "29ca7bd3-6c7b-3919-853c-bb8cf6076c75",
                                                "text": "Stefan könnte wirklich einmal rangehen, wenn man ihn anruft."
                                            },
                                            {
                                                "example_id": "dad7c50c-dd8d-4dfb-a15a-315d82f5a1ad",
                                                "sense_id": "29ca7bd3-6c7b-3919-853c-bb8cf6076c75",
                                                "text": "„Zudem wird ihn Extremkletterer Stefan Glowacz, kürzlich Gast beim Nationalteam, gewarnt haben.“"
                                            },
                                            {
                                                "example_id": "6987f31d-455f-4593-8d14-3cd83d3557dc",
                                                "sense_id": "29ca7bd3-6c7b-3919-853c-bb8cf6076c75",
                                                "text": "„Richter Stefan Ortmann, der Staatsanwalt und alle fünf Verteidiger führen hinter verschlossenen Türen ein Rechtsgespräch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "455a63ed-e2df-458f-afc1-e8fc147f218e",
                        "source_entry_id": "0bd4b628-93f1-3ba0-b38e-33bcfc0d39d4",
                        "source_sense_id": "95966fe1-cfce-3181-8f7a-76e737218ff9",
                        "target_lang_word": "Stephan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stephan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95b0d85c-a6bc-3ff6-9562-9df98303d038",
                                        "entry_id": "6a63a381-39e6-37c7-a01a-093733bf8a31",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f039d6f0-0652-45dd-b047-002603161a62",
                                                "sense_id": "95b0d85c-a6bc-3ff6-9562-9df98303d038",
                                                "text": "Frau Stephan ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "10031383-a0b7-42ac-8606-8982bc492a78",
                                                "sense_id": "95b0d85c-a6bc-3ff6-9562-9df98303d038",
                                                "text": "Herr Stephan wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "bd1d1f85-d91b-40a7-a486-2f3cd4d5dd33",
                                                "sense_id": "95b0d85c-a6bc-3ff6-9562-9df98303d038",
                                                "text": "Die Stephans fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "3fa155fb-00f2-4ee3-98e6-cbc2d89a23ca",
                                                "sense_id": "95b0d85c-a6bc-3ff6-9562-9df98303d038",
                                                "text": "Der Stephan trägt nie die Schals, die die Stephan ihm strickt."
                                            },
                                            {
                                                "example_id": "b1d8b000-2503-42b3-878c-463615c39f0f",
                                                "sense_id": "95b0d85c-a6bc-3ff6-9562-9df98303d038",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stephan kommt, geht der Herr Stephan.“"
                                            },
                                            {
                                                "example_id": "d403b108-f1e4-4ec1-a7f7-a4ce670c544e",
                                                "sense_id": "95b0d85c-a6bc-3ff6-9562-9df98303d038",
                                                "text": "Stephan kommt und geht."
                                            },
                                            {
                                                "example_id": "8f53f7a8-2a1d-4865-b833-27462efa9242",
                                                "sense_id": "95b0d85c-a6bc-3ff6-9562-9df98303d038",
                                                "text": "Stephans kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Stephan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d6d79f7-3d56-3210-8bf3-a050c2242ad3",
                                        "entry_id": "bbad474a-8ccd-3ef9-adb8-e63431b40c2e",
                                        "glosses": [
                                            "männlicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "249709c5-b089-47c3-8fbf-f4be79af6ba0",
                                                "sense_id": "4d6d79f7-3d56-3210-8bf3-a050c2242ad3",
                                                "text": "Mit Stephan gehe ich Anfang August traditionell Sternschnuppen schauen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
