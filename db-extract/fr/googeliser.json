                "senses": [
                    {
                        "sense_id": "7f7787d3-1f97-398a-9d62-c294c8bdd55b",
                        "entry_id": "bf4f91cc-e73e-344b-b76e-bf200ff1b7c0",
                        "glosses": [
                            "Rechercher sur Internet en utilisant Google."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "12482172-fcc9-414a-8578-3bf5ef50b9dd",
                                "sense_id": "7f7787d3-1f97-398a-9d62-c294c8bdd55b",
                                "text": "En vérité, il ne sait à peu près rien d’elle, quelques on-dit, des résumés de résumés de livres. Au mieux, il l’« aura googelisé ». C’est dire…"
                            },
                            {
                                "example_id": "9645e678-ad15-4461-a0e6-d18d0730d44d",
                                "sense_id": "7f7787d3-1f97-398a-9d62-c294c8bdd55b",
                                "text": "Faut-il «googeliser» les candidats au recrutement?"
                            },
                            {
                                "example_id": "47cc1ef6-8496-431e-8a0b-b5c31b154194",
                                "sense_id": "7f7787d3-1f97-398a-9d62-c294c8bdd55b",
                                "text": "Lorsqu'une entreprise s'intéresse à un territoire à l'occasion, elle va systématiquement googeliser le territoire sur Internet (êtes-vous sûre de votre image?), l’entité avec qui il est en contact (votre site Internet est-il à la hauteur de votre discours ?) et ses interlocuteurs (Votre présence sur les réseaux sociaux est-elle à jour et cohérente ?)."
                            },
                            {
                                "example_id": "8c63075d-2c44-4b05-be73-b89cdaaaf5ac",
                                "sense_id": "7f7787d3-1f97-398a-9d62-c294c8bdd55b",
                                "text": "Voilà un nouveau groupe au nom pas évident à googeliser qui risque bien de faire parler de lui très bientôt !"
                            }
                        ]
                    }
                ],
