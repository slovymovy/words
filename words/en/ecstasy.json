{
    "word_family": [
        "ecstatic",
        "ecstatically"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "68d01996-5a09-313a-a7a1-69dbf34d4b21",
                    "sense_definition": "An overwhelming feeling of great happiness, joyful excitement, or intense pleasure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intense_feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd gasped in pure <w>ecstasy</w> when their team scored the winning goal.",
                            "target_lang_translations": {
                                "zh": "当主队踢进致胜一球时，人群陷入了一片纯粹的<w>狂喜</w>之中，不禁倒吸一口气。"
                            }
                        },
                        {
                            "text": "Listening to the orchestra perform live filled her with sheer <w>ecstasy</w>.",
                            "target_lang_translations": {
                                "zh": "现场聆听管弦乐队的演奏让她感到无与伦比的<w>陶醉</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rapture"
                    ],
                    "antonyms": [
                        "agony"
                    ],
                    "common_phrases": [
                        "pure ecstasy",
                        "sheer ecstasy"
                    ],
                    "target_lang_definitions": {
                        "zh": "极大的快乐、狂喜或极度兴奋的状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "狂喜",
                                "target_lang_sense_clarification": "极度的快乐与兴奋"
                            },
                            {
                                "target_lang_word": "陶醉",
                                "target_lang_sense_clarification": "沉浸于极乐或喜悦之中"
                            },
                            {
                                "target_lang_word": "欣喜若狂",
                                "target_lang_sense_clarification": "极度高兴"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5a999ce-217a-3ced-bf15-ef8d0d53500c",
                    "sense_definition": "An illegal psychoactive drug, MDMA, taken especially in tablet form to induce feelings of euphoria and empathy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was arrested for attempting to sell tablets of <w>ecstasy</w> outside the nightclub.",
                            "target_lang_translations": {
                                "zh": "他因企图在夜总会外贩卖<w>摇头丸</w>片剂而被捕。"
                            }
                        },
                        {
                            "text": "Police warned partygoers about dangerous chemical batches of <w>ecstasy</w> circulating in the city.",
                            "target_lang_translations": {
                                "zh": "警方警告派对参加者，市内流窜着一批成分危险的<w>摇头丸</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "MDMA",
                        "molly",
                        "E",
                        "XTC",
                        "X"
                    ],
                    "target_lang_definitions": {
                        "zh": "摇头丸，一种常为片剂的非法精神类毒品（学名亚甲二氧甲基苯丙胺，简称MDMA）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "摇头丸",
                                "target_lang_sense_clarification": "毒品MDMA的通称"
                            },
                            {
                                "target_lang_word": "迷魂药",
                                "target_lang_sense_clarification": "致幻或精神药物的俗称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec46fcf1-7420-3998-a0dd-a2ec9c0779d4",
                    "sense_definition": "A state of emotion so intense that it overpowers rational thought and self-control.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intense_feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Upon hearing the terrible news, she fell into an <w>ecstasy</w> of grief and wept uncontrollably.",
                            "target_lang_translations": {
                                "zh": "听到这个噩耗后，她陷入了<w>极度狂乱</w>的悲痛之中，止不住地痛哭。"
                            }
                        },
                        {
                            "text": "The discovery threw the suspicious guards into an <w>ecstasy</w> of anger.",
                            "target_lang_translations": {
                                "zh": "这一发现让疑心重重的守卫们陷入了<w>情绪失控</w>的狂怒之中。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ecstasy of grief"
                    ],
                    "target_lang_definitions": {
                        "zh": "（悲伤、愤怒等情感的）极度失控或爆发状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "极度狂乱",
                                "target_lang_sense_clarification": "情绪压倒理智的失控状态"
                            },
                            {
                                "target_lang_word": "情绪失控",
                                "target_lang_sense_clarification": "感情极度爆发"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cacf2bd-2ca3-31c7-b91f-00c56f258972",
                    "sense_definition": "A state of trance or rapture associated with mystical, religious, or prophetic exaltation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "altered_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medieval saint reportedly fell into a religious <w>ecstasy</w> while praying alone.",
                            "target_lang_translations": {
                                "zh": "据传，这位中世纪圣人在独自祈祷时进入了宗教性的<w>出神</w>状态。"
                            }
                        },
                        {
                            "text": "He described an inner vision that came over him during an intense mystical <w>ecstasy</w>.",
                            "target_lang_translations": {
                                "zh": "他描述了在一次强烈的神秘<w>神魂超拔</w>体验中所见到的内心幻象。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rapture"
                    ],
                    "common_phrases": [
                        "religious ecstasy",
                        "mystical ecstasy"
                    ],
                    "target_lang_definitions": {
                        "zh": "（宗教或神秘体验中的）出神、神魂超拔状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "出神",
                                "target_lang_sense_clarification": "神秘或宗教性的超脱状态"
                            },
                            {
                                "target_lang_word": "神魂超拔",
                                "target_lang_sense_clarification": "宗教狂喜或入神"
                            },
                            {
                                "target_lang_word": "入迷",
                                "target_lang_sense_clarification": "恍惚入神的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc062f1c-7438-3fa4-afcb-1a66effaee76",
                    "sense_definition": "A cataleptic or trance-like state in which voluntary motion and normal consciousness are suspended.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "altered_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the medical paroxysm of <w>ecstasy</w>, the patient remained completely rigid and insensible.",
                            "target_lang_translations": {
                                "zh": "在病理性的<w>恍惚状态</w>发作期间，患者身体完全僵硬且失去知觉。"
                            }
                        },
                        {
                            "text": "The doctor observed that the physical symptoms of <w>ecstasy</w> closely mirrored catalepsy.",
                            "target_lang_translations": {
                                "zh": "医生观察到，这种<w>僵住发作</w>的身体症状与僵住症非常相似。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used historically in medical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（医学史上的）恍惚状态或僵住症样发作，失去自主运动及正常意识。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "恍惚状态",
                                "target_lang_sense_clarification": "自主意识与活动暂停的医学状态"
                            },
                            {
                                "target_lang_word": "僵住发作",
                                "target_lang_sense_clarification": "僵直且无知觉的发作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f0d127d-ea8e-3e35-a9f3-c368acb51dd1",
                    "sense_definition": "A state of madness, frenzy, or severe mental distraction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "altered_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tragic prince appeared blasted with <w>ecstasy</w> as reason deserted him.",
                            "target_lang_translations": {
                                "zh": "随着理智离去，这位悲剧王子似乎已陷入了<w>发狂</w>状态。"
                            }
                        },
                        {
                            "text": "They feared his sudden <w>ecstasy</w> would drive him to commit desperate deeds.",
                            "target_lang_translations": {
                                "zh": "他们担心他突发的<w>精神错乱</w>会驱使他做出铤而走险的事。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical and literary sense meaning distraction or madness"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（文学或古义）发狂，精神错乱，丧失理智。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "发狂",
                                "target_lang_sense_clarification": "理智丧失的疯狂状态"
                            },
                            {
                                "target_lang_word": "精神错乱",
                                "target_lang_sense_clarification": "发疯或严重心智紊乱"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ceaba110-cd44-372c-84c1-ef72a7edafdf",
                    "sense_definition": "To experience intense delight or pleasure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intense_feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The music lovers were <w>ecstasying</w> at the magnificent rendition of the symphony.",
                            "target_lang_translations": {
                                "zh": "乐迷们对交响乐宏伟的演绎感到无比<w>陶醉</w>。"
                            }
                        },
                        {
                            "text": "He closed his eyes and began <w>ecstasying</w> over the exquisite dessert.",
                            "target_lang_translations": {
                                "zh": "他闭上眼睛，为这道精致的甜点<w>狂喜</w>不已。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or obsolete verbal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（罕用动词）感到极度喜悦或陶醉。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "狂喜",
                                "target_lang_sense_clarification": "感到极度高兴"
                            },
                            {
                                "target_lang_word": "陶醉",
                                "target_lang_sense_clarification": "沉浸于极乐中"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acc468af-08c1-3dc2-a97b-674da679c8b2",
                    "sense_definition": "To fill someone with intense pleasure or delight.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intense_feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The breathtaking landscape quite <w>ecstasied</w> the weary travelers.",
                            "target_lang_translations": {
                                "zh": "摄人心魄的美景让疲惫的旅人们深深<w>沉醉</w>。"
                            }
                        },
                        {
                            "text": "She was deeply <w>ecstasied</w> by the beautiful poem recited by her companion.",
                            "target_lang_translations": {
                                "zh": "同伴朗诵的美丽诗篇让她深深为之<w>陶醉</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or obsolete transitive verbal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（罕用及物动词）使狂喜，使极度陶醉。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使狂喜",
                                "target_lang_sense_clarification": "使某人极度欢愉"
                            },
                            {
                                "target_lang_word": "使陶醉",
                                "target_lang_sense_clarification": "使某人沉醉"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}