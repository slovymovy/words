                "senses": [
                    {
                        "sense_id": "f7129ed6-3a77-3736-b7a9-9847346f79c0",
                        "entry_id": "a7314a02-eec6-3019-b0b2-ec22a0099f70",
                        "glosses": [
                            "Entièrement ou partiellement sous licence libre."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "09df6d4f-0ddd-4d7b-8125-72967fe52aa8",
                                "sense_id": "f7129ed6-3a77-3736-b7a9-9847346f79c0",
                                "text": "Dans un premier temps (en mai 2009), Google Wave était réservé à un cercle restreint, principalement composé de développeurs – le projet est open-source."
                            },
                            {
                                "example_id": "4e11dc33-dd6e-46a0-842b-d00b16e9fd93",
                                "sense_id": "f7129ed6-3a77-3736-b7a9-9847346f79c0",
                                "text": "Les applicatifs Cobol existant ont été repris dans le compilateur open-source Cobol-IT Compiler Suite de l’éditeur français Cobol-IT sans aucun changement d’architecture."
                            },
                            {
                                "example_id": "ae11da04-f158-4d5d-bfc5-aebb6d2a3a5a",
                                "sense_id": "f7129ed6-3a77-3736-b7a9-9847346f79c0",
                                "text": "Les bases du succès financier de Mozilla, pris sur l’échelle d’un projet open-source, a été rapide."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e2687b5-f46e-4665-9cd2-418b76953466",
                        "source_entry_id": "a7314a02-eec6-3019-b0b2-ec22a0099f70",
                        "source_sense_id": "f7129ed6-3a77-3736-b7a9-9847346f79c0",
                        "target_lang_word": "open-source",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "open-source",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd72c538-5b5e-34db-a81e-9f22f2b98430",
                                        "entry_id": "a092e6a5-3947-31c2-9bc3-898b67fc9fdf",
                                        "glosses": [
                                            "Of or relating to software where the source code is freely available and licensed in a manner that permits modification and redistribution."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b99efcd4-e60d-4b97-bcdf-8623d6b2e787",
                                                "sense_id": "bd72c538-5b5e-34db-a81e-9f22f2b98430",
                                                "text": "Linux is an open-source operating system."
                                            },
                                            {
                                                "example_id": "0a4a9855-706f-4520-a0aa-535697566b33",
                                                "sense_id": "bd72c538-5b5e-34db-a81e-9f22f2b98430",
                                                "text": "ASP.NET MVC has been under an open-source license since the initial release, but it was just open-source code instead of a full open-source project."
                                            },
                                            {
                                                "example_id": "64c7a77c-a4ed-46af-aab0-c20fd5bbe6fb",
                                                "sense_id": "bd72c538-5b5e-34db-a81e-9f22f2b98430",
                                                "text": "OpenSNP constituted a rare example of how open-source projects can successfully operate on a low budget, having repeatedly rejected offers from corporations to sell control of the data."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19185fb9-ac54-38ee-890c-72598b90fd60",
                                        "entry_id": "a092e6a5-3947-31c2-9bc3-898b67fc9fdf",
                                        "glosses": [
                                            "Describing any product whose composition or method of manufacturing is public knowledge and not proprietary."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4822499-184c-4b77-ba19-bb9b8666a18d",
                                                "sense_id": "19185fb9-ac54-38ee-890c-72598b90fd60",
                                                "text": "open-source cola"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e05df6c7-a106-3956-b38e-27dfc5141d2e",
                                        "entry_id": "a092e6a5-3947-31c2-9bc3-898b67fc9fdf",
                                        "glosses": [
                                            "Relying on publicly available information (open sources)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ed9fc28-449f-44fd-91f7-b33e6eb3a993",
                                                "sense_id": "e05df6c7-a106-3956-b38e-27dfc5141d2e",
                                                "text": "open-source intelligence"
                                            },
                                            {
                                                "example_id": "280827bc-25fd-40bd-b94c-6263aa810707",
                                                "sense_id": "e05df6c7-a106-3956-b38e-27dfc5141d2e",
                                                "text": "The ramifications of disinformation spill on to the streets with tangible, often devastating real-world consequences. These processes were already under way in 2014, when I founded the open-source investigative group Bellingcat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "open-source",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea257b92-796a-3aca-af59-d67eab0d8e00",
                                        "entry_id": "4a3da6f0-9cab-3a53-92fc-494b6b9170cb",
                                        "glosses": [
                                            "To release the source code of, so as to permit modification and redistribution."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0be8069-d073-4c6e-8769-e02fe08d4d68",
                                                "sense_id": "ea257b92-796a-3aca-af59-d67eab0d8e00",
                                                "text": "The big Unix company Sun Microsystems bought the code for StarOffice in 1999, and some time afterward they open-sourced as much of it as they could."
                                            }
                                        ]
                                    }
