                        "form": "sie sind schweißbedeckt"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0c85d8d5-0ca1-36f3-8788-7dea89a6e56e",
                        "entry_id": "af2e31a4-613e-3d56-8efe-9405bdc246a1",
                        "glosses": [
                            "von Schweiß bedeckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3128209a-bd5a-4b61-a64e-2f761abccc9a",
                                "sense_id": "0c85d8d5-0ca1-36f3-8788-7dea89a6e56e",
                                "text": "„Als er seine zu Fäusten geballten Hände öffnete, waren die Handflächen schweißbedeckt.“"
                            },
                            {
                                "example_id": "eb789bd7-3634-447f-9990-bce1af2f96c3",
                                "sense_id": "0c85d8d5-0ca1-36f3-8788-7dea89a6e56e",
                                "text": "„Am Morgen des dritten Tages riss ihn ein grauenhafter Albtraum aus dem Schlaf, sodass er zitternd und schweißbedeckt in seinem Bett lag.“"
                            },
                            {
                                "example_id": "1e46cb61-018a-4172-926d-634c54e4873a",
                                "sense_id": "0c85d8d5-0ca1-36f3-8788-7dea89a6e56e",
                                "text": "„Jack steckte die Hand in die Tasche und befummelte den Schlüssel und rieb an ihm, bis seine Finger schweißbedeckt waren und einen kräftigen metallischen Geruch angenommen hatten, dann hob er sie an die Nase und atmete intensiv ein.“"
                            },
                            {
