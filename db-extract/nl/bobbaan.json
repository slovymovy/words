                            "wintersport"
                        ],
                        "examples": [
                            {
                                "example_id": "24a8a357-18a4-4258-948c-5d18763ee2cb",
                                "sense_id": "a9cc772c-bc8f-35c6-a544-636b94ab590b",
                                "text": "De veiligheidsbeugels van de Bobbaan, de Python, de Vogelrok en de Vliegende Hollander worden voortaan ook gecontroleerd, ook al is dat niet verplicht. Om te voorkomen dat wachttijden toenemen wordt extra personeel ingezet, aldus de woordvoerder."
                            },
                            {
                                "example_id": "3b8b1252-93c0-44c6-bbfa-172f7a85f14a",
                                "sense_id": "a9cc772c-bc8f-35c6-a544-636b94ab590b",
                                "text": "Nog voor de eerste slee naar beneden is gegaan, heeft zich al een ernstig ongeluk voorgedaan op de olympische bobbaan in Sotsji."
                            },
                            {
                                "example_id": "67f9b872-b32e-425b-a2f6-40eb46fbf8fb",
                                "sense_id": "a9cc772c-bc8f-35c6-a544-636b94ab590b",
                                "text": "Kamphuis moest over vier runs 1,66 toegeven. 4 jaar geleden eindigde ze op de bobbaan van Whistler nog als achtste, toen met remster Tine Veenstra."
                            }
                        ]
                    }
