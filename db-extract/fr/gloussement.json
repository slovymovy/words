        "fr-extract.jsonl": [
            {
                "entry_id": "05b0b40f-d0eb-3011-9eea-c5acd9c9ce8a",
                "word": "gloussement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9e644ee8-1334-421c-8921-e652b7daac9d",
                        "entry_id": "05b0b40f-d0eb-3011-9eea-c5acd9c9ce8a",
                        "tags": [
                            "plural"
                        ],
                        "form": "gloussements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f215f20f-d6cd-3a64-95dd-bf1692c067d5",
                        "entry_id": "05b0b40f-d0eb-3011-9eea-c5acd9c9ce8a",
                        "glosses": [
                            "Cri de la poule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c3e35e5-4047-4b36-a8b6-9b3127f95ed2",
                                "sense_id": "f215f20f-d6cd-3a64-95dd-bf1692c067d5",
                                "text": "Des femmes qu’on chatouillait poussaient des cris, pareils à des gloussements de volaille."
                            },
                            {
                                "example_id": "24667276-488f-4eee-8d2e-5a3df76a0a7a",
                                "sense_id": "f215f20f-d6cd-3a64-95dd-bf1692c067d5",
                                "text": "Autrefois l'Adhuy était un riche domaine des Templiers; ce n'est plus aujourd'hui qu'une modeste ferme : ses granges encadrent la cour d'où montent l'odeur des fumiers et le gloussement des volatiles."
                            }
                        ]
                    },
                    {
                        "sense_id": "244972c4-1dbb-3ffa-8963-6049f4324a6f",
                        "entry_id": "05b0b40f-d0eb-3011-9eea-c5acd9c9ce8a",
                        "glosses": [
                            "Cri humain semblable au cri de la poule."
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "e8806dd0-5f26-497d-9619-b59b5da3b208",
                                "sense_id": "244972c4-1dbb-3ffa-8963-6049f4324a6f",
                                "text": "Il faisait, en avalant sa soupe, un gloussement à chaque gorgée."
                            },
                            {
                                "example_id": "ca1247b1-b084-4f35-a1f2-f7cf691dc26a",
                                "sense_id": "244972c4-1dbb-3ffa-8963-6049f4324a6f",
                                "text": "Joseph Rivet, un pied tendu sur le brancard, l’autre jambe repliée sous lui, les coudes très élevés, tenait les rênes, et de sa gorge s’échappait à tout instant une sorte de gloussement qui, faisant dresser les oreilles au bidet, accélérait son allure."
                            },
                            {
                                "example_id": "7ed8ce1f-493e-4d40-ad64-aadf70a6bd3c",
                                "sense_id": "244972c4-1dbb-3ffa-8963-6049f4324a6f",
                                "text": "Des messieurs parfumés, que d’affreux gigolos embrassaient sur la bouche, poussaient des gloussements et, tournoyant avec ivresse, s’abandonnaient."
                            },
                            {
                                "example_id": "55cc93d8-ea18-4941-8efc-40fdb2c5fb5e",
                                "sense_id": "244972c4-1dbb-3ffa-8963-6049f4324a6f",
                                "text": "Rien ne lui échappait : le susurrement sucré de la jeune vedette héroïne, le parler guttural du caïd sans scrupules, les nasillements du faux-frère, les jacassements de la commère, le jargon du bellâtre amoureux, les caracoulements du jeune premier, les gémissements de l’orpheline, les piaulements des villageois, les babillements des ouvrières, les graillements de la douairière, les braillements du nouveau riche en train de se pavaner, les sifflements du beau-parleur, les craillements des hommes avides, les croassements des maîtres-chanteurs, les coqueriquements des hâbleurs, les jabotements de la fille de joie, les cacardements de l’oie blanche, les pépiements des enfants, les gazouillements de l’alerte soubrette, les glatissements du foudre de guerre, les glapissements de la grue de service, les piaillements de la valetaille, les gloussements de la poule émoustillée, les hôlements du maître-chanteur, les frigottements de sa victime, les glougloutements du dindon de la farce, les coucoulements du pique-assiette, les frouements de la vieille femme acariâtre, les pupulements de la coquette, les gringottements du jeune chanteur, les cajolements du faraud, les grisolements de la mauviette, les margottements de la petite caille grassouillette, les criaillements de la grande pintade efflanquée, les trissements de l’hirondelle des faubourgs […]"
                            },
                            {
                                "example_id": "d741556f-e0a7-4b2f-b29e-7dfbdc30fb2d",
                                "sense_id": "244972c4-1dbb-3ffa-8963-6049f4324a6f",
                                "text": "Gloussements, pouffements, puis les rires finissent par éclater. Forcés, produits artificiellement, ils n’en sont pas moins communicatifs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae6647bb-cb96-4618-83f4-d13fab758e19",
                        "source_entry_id": "05b0b40f-d0eb-3011-9eea-c5acd9c9ce8a",
                        "source_sense_id": "f215f20f-d6cd-3a64-95dd-bf1692c067d5",
                        "source_sense_description": "Cri de la poule.",
                        "target_lang_word": "Glucksen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glucksen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2303c72-a063-3f49-afc9-ba69d29f9969",
                                        "entry_id": "1640bf11-8519-3ef2-a0a4-1ca06ee4f653",
                                        "glosses": [
                                            "glucksendes Geräusch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "027fcca4-fe86-4f9c-b26d-e5024b0d29df",
                                                "sense_id": "f2303c72-a063-3f49-afc9-ba69d29f9969",
                                                "text": "„Unentwegt, unermüdlich trug das scheußlich geschuppte Monster seinen hilflosen Reiter voran und kicherte verdreht über das hysterische Glucksen, zu dem der Sphärengesang der Nacht inzwischen geworden war.“"
                                            },
                                            {
                                                "example_id": "7231e9af-385f-4d5b-b179-bbb8da5a0fd9",
                                                "sense_id": "f2303c72-a063-3f49-afc9-ba69d29f9969",
                                                "text": "„Dann liefen plötzlich große Tränen seine verknitterten Wangen hinab und er gab ein wiederkehrendes, hicksendes Glucksen von sich, das ich erst nach einem Moment erstaunten Zuschauens als Schluchzen identifizieren konnte.“"
                                            },
                                            {
                                                "example_id": "ff82025d-9521-4898-bc16-5a9a89e47f24",
                                                "sense_id": "f2303c72-a063-3f49-afc9-ba69d29f9969",
                                                "text": "„Alle taten desgleichen, der Herr Pfarrer gab eine Art Glucksen von sich, Hurel hustete, dem Doktor liefen die Tränen herunter, seine Frau bekam einen nervösen Lachkrampf – und Foureau, ein Mann, der keine Scheu kannte, brach einen Abd-el-Kader ab und steckte ihn als Andenken in die Tasche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
