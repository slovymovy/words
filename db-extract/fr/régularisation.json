                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regularization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d35f659-a675-3d74-9b30-465c13fa9beb",
                                        "entry_id": "eed0b253-d502-3112-b8da-7a76f3d5fcba",
                                        "glosses": [
                                            "The act of making regular, of regularizing."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a272612-4f5f-42e7-b3b4-8dbbf0997b0b",
                                                "sense_id": "9d35f659-a675-3d74-9b30-465c13fa9beb",
                                                "text": "The history of the regularization of rivers, both in Russia and in Western Europe, hardly shows us anything but failures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d51a8386-4be1-3b5a-9188-271c3251482d",
                                        "entry_id": "eed0b253-d502-3112-b8da-7a76f3d5fcba",
                                        "glosses": [
                                            "a process that simplifies results, often used to obtain results for ill-posed problems or to prevent overfitting."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1031e84-cd34-4a8c-9a98-e0dcd542ba8c",
                                                "sense_id": "d51a8386-4be1-3b5a-9188-271c3251482d",
                                                "text": "A large regularization parameter may over-smoothen the solution, while a small regularization parameter may lose the ability to stabilize the solution."
                                            }
                                        ]
                                    }
                                ]
                            }
