                ],
                "senses": [
                    {
                        "sense_id": "60d0c5cb-03e5-3910-8de6-3fbefaccf0a4",
                        "entry_id": "93b59747-0808-3a74-89e0-2f4e539b0c59",
                        "glosses": [
                            "Kopf eines Kalbes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54b823e1-f9c0-4981-a766-71277da0b98c",
                                "sense_id": "60d0c5cb-03e5-3910-8de6-3fbefaccf0a4",
                                "text": "„In die Münchner Weißwurst gehört ein Anteil feinst gekutterten Kalbfleischs von mindestens 51 Prozent, dazu gegarter Kalbskopf, Schweinerückenspeck, Eischnee, Salz, Petersilie, Pfeffer, Zwiebel und Zitrone.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d365351b-f451-49f1-a622-03b6d84c40e2",
                        "source_entry_id": "93b59747-0808-3a74-89e0-2f4e539b0c59",
                        "source_sense_id": "60d0c5cb-03e5-3910-8de6-3fbefaccf0a4",
                        "source_sense_description": "Kopf eines Kalbes",
                        "target_lang_word": "tête de veau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tête de veau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1c6ccad2-45a0-3421-9bef-a1e387366313",
                                        "entry_id": "215c3a13-29bc-37ae-89ef-8d17d4256744",
                                        "glosses": [
                                            "Plat préparé avec les chairs de la tête d'un veau, bouilli et servi tiède avec une sauce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffa038a9-7c38-44e4-8624-a09a22db6c1a",
                                                "sense_id": "1c6ccad2-45a0-3421-9bef-a1e387366313",
                                                "text": "Il me manquait un citron entre les dents, et du persil dans les narines, comme aux têtes de veau. J’avais leur reflet bleuâtre, fade et mollasse, mais j’étais propre, par exemple."
                                            },
                                            {
                                                "example_id": "509a60bb-1eb7-4617-83f2-e7b78b289a54",
                                                "sense_id": "1c6ccad2-45a0-3421-9bef-a1e387366313",
                                                "text": "L’attention générale se porte alors sur Ernestine, qui présente à M. le Grand Doyen un plat sur lequel sont disposées, entre des bouquets de persil, la langue, la joue, les narines piquées de la tête de veau. L’œil se trouve au milieu comme dans le poème de Hugo :\n— Notre grand-oncle, qui était cardinal, proclame Telcide, considérait l’œil comme un mets de choix..."
                                            },
                                            {
                                                "example_id": "c8d72813-ec94-42c1-a1b5-1dcee00a94cd",
                                                "sense_id": "1c6ccad2-45a0-3421-9bef-a1e387366313",
                                                "text": "[…] ; les convives d'un repas funèbre devant bientôt s'attabler en cette maison, il importe que je prépare consciencieusement la tête de veau dont ils m'ont passé commande."
                                            },
                                            {
                                                "example_id": "0e0af8e1-5b19-4ad4-934e-aa2249054481",
                                                "sense_id": "1c6ccad2-45a0-3421-9bef-a1e387366313",
                                                "text": "Certains plats restent à la carte toute l'année : frisée aux lardons, bouquet de crevettes sauce cocktail, gambas flambées au pastis, bavette d'aloyau à l'échalote, tête de veau sauce gribiche […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa134cd9-c77c-3cb2-933c-2389f978dec7",
                                        "entry_id": "215c3a13-29bc-37ae-89ef-8d17d4256744",
                                        "glosses": [
                                            "Désignation injurieuse d'une personne."
                                        ],
                                        "tags": [
                                            "dated",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c2192b5-2b7f-4143-a6d8-a1f2ad8bcb51",
                                                "sense_id": "fa134cd9-c77c-3cb2-933c-2389f978dec7",
                                                "text": "Mon copain Tronche eut droit également à leurs quolibets avec des : ah ! la tronche, face de rat, tête de noix, tête de veau, tête de mule et trognon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c64d75e4-9b50-354a-803a-83532cdb9bd4",
                                        "entry_id": "215c3a13-29bc-37ae-89ef-8d17d4256744",
                                        "glosses": [
                                            "Nom que donnaient les habitants des communes voisines aux habitants de Rambervillers."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f850184-ccc7-475a-89ce-d7691aa257d8",
                                                "sense_id": "c64d75e4-9b50-354a-803a-83532cdb9bd4",
                                                "text": "Entre la poire et le fromage, nous blaguerons un peu les habitants de Rambervillers ! ... Les « gens de Rambervillers », ou, comme on dit dédaigneusement, les « têtes de veau » !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
