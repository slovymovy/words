                                                "example_id": "04eb4a0a-66a9-4036-868d-b172e168a724",
                                                "sense_id": "1434e986-bdc4-3174-b584-a1a1200bee9d",
                                                "text": "Some 64,000 people have been arrested since the state of emergency began, some of whom have been transferred to a megaprison earlier this year."
                                            },
