                        "glosses": [
                            "живоп., искусств. трещина красочного слоя или лака (в произведении живописи)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51a9aebe-1b8b-4160-b823-294c9a1dc01f",
                                "sense_id": "6d516675-8519-33d7-ad9d-e775387259ae",
                                "text": "И со специальными составами работали, – и с желатином, и с яичным белком и даже на клее ПВА искали что-то похожее на кракелюр."
                            }
                        ]
                    }
                ],
                "translations": [
