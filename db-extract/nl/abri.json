                "translations": [
                    {
                        "translation_id": "f84d3c8a-6976-4b27-aa6f-2ade9e4fb3ed",
                        "source_entry_id": "56c9ca06-d973-3e95-8fc7-84e1ae5ff269",
                        "source_sense_id": "3ac49d0d-cebc-38c3-b709-0004e90f4b6f",
                        "source_sense_description": "een wachthuisje bij een halte van het openbaar vervoer",
                        "target_lang_word": "Wartehäuschen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wartehäuschen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5093170f-e45d-372d-aaf6-25ada543f19d",
                                        "entry_id": "ca41e67e-6f10-35c6-be85-310798159b96",
                                        "glosses": [
                                            "Unterstand an einer Haltestelle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9f11a94-9d2e-4f13-9d88-2ddc3933a044",
                                                "sense_id": "5093170f-e45d-372d-aaf6-25ada543f19d",
                                                "text": "„Ich ging den langen Hang am Feld hinab, passierte die Bushaltestelle mit dem Wartehäuschen, wo ich so oft allein gewartet hatte, und die Transformatorstation, die halb Finneide mit Strom versorgte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "323c6af0-00da-4a92-84ff-ed2028c34936",
                        "source_entry_id": "56c9ca06-d973-3e95-8fc7-84e1ae5ff269",
                        "source_sense_id": "3ac49d0d-cebc-38c3-b709-0004e90f4b6f",
                        "source_sense_description": "een wachthuisje bij een halte van het openbaar vervoer",
                        "target_lang_word": "abri",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abri",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c1cdd1b4-3176-30f7-9cc8-e45c5f13f76e",
                                        "entry_id": "dfef0d13-b27a-3bdc-8f1a-8a9c24c5cfe4",
                                        "glosses": [
                                            "Lieu où on peut se mettre à couvert, se protéger des intempéries ou d'un danger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2a6558b-a00e-4487-ba15-dd9f87958897",
                                                "sense_id": "c1cdd1b4-3176-30f7-9cc8-e45c5f13f76e",
                                                "text": "Pourquoi construire d’inconfortables maisons en planches et en tôle ondulée quand le feuillage des cocotiers peut vous fournir des abris toujours frais?"
                                            },
                                            {
                                                "example_id": "0d3af13a-f8a5-4570-8733-65d71bf182cd",
                                                "sense_id": "c1cdd1b4-3176-30f7-9cc8-e45c5f13f76e",
                                                "text": "Si misérable que soit l’abri dont on dispose, il est encore préférable à la bise glacée."
                                            },
                                            {
                                                "example_id": "2ba663a2-d552-42f4-a552-df2c71f6caa3",
                                                "sense_id": "c1cdd1b4-3176-30f7-9cc8-e45c5f13f76e",
                                                "text": "Le bruit du bombardement au-dessus de l’abri devient formidable. Les obus tombent sur la Chancellerie avec une précision inquiétante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9953aedd-2581-3edf-92cf-33a5c1113dbb",
                                        "entry_id": "dfef0d13-b27a-3bdc-8f1a-8a9c24c5cfe4",
                                        "glosses": [
                                            "Construction équipée d’un toit qui protège les utilisateurs de transports en commun, le matériel sensible…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a599e882-8a2c-41dc-b865-4e101b8a881b",
                                                "sense_id": "9953aedd-2581-3edf-92cf-33a5c1113dbb",
                                                "text": "Rejoignons l’abri pour attendre l’autobus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f5f0a19-978c-3e7a-b42b-3d19a14630ba",
                                        "entry_id": "dfef0d13-b27a-3bdc-8f1a-8a9c24c5cfe4",
                                        "glosses": [
                                            "Ce qui préserve de l’adversité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee8a3f44-e731-44ab-8d6c-606e9fb14128",
                                                "sense_id": "2f5f0a19-978c-3e7a-b42b-3d19a14630ba",
                                                "text": "Ce coin perdu de Jan-Mayen n’est pas à l’abri des cancans, des mystères, des intrigues et même des complications diplomatiques."
                                            },
                                            {
                                                "example_id": "cdbdb99d-b3e6-4057-a599-93909cd91870",
                                                "sense_id": "2f5f0a19-978c-3e7a-b42b-3d19a14630ba",
                                                "text": "Chaque semaine, des paquebots arrivaient de New-York et débarquaient des touristes américains qui venaient se reposer de leurs affaires, à l’abri des lois de la prohibition."
                                            },
                                            {
                                                "example_id": "f1da56ba-ee02-41b3-b461-a9a6ce2cfc55",
                                                "sense_id": "2f5f0a19-978c-3e7a-b42b-3d19a14630ba",
                                                "text": "Se mettre à l’abri. — Être à l’abri du besoin. — Nul n’est à l’abri d’un accident."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e78e6bae-3397-354c-b300-25564893f1f4",
                                        "entry_id": "dfef0d13-b27a-3bdc-8f1a-8a9c24c5cfe4",
                                        "glosses": [
                                            "Tout ce qui sert à garantir, soit de l’action désastreuse des vents, soit de la trop grande ardeur du soleil, soit du gel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a20f8c9-d60c-4f89-b1a7-4b20565d0e47",
                                                "sense_id": "e78e6bae-3397-354c-b300-25564893f1f4",
                                                "text": "Les abris sont ou naturels, comme les montagnes, les forêts, les plantations en lignes et les haies; ou artificiels, comme les murs et les paillassons."
                                            },
                                            {
                                                "example_id": "e8339c2c-3640-448e-86bb-ee939c6201f6",
                                                "sense_id": "e78e6bae-3397-354c-b300-25564893f1f4",
                                                "text": "Sylvius, tant que le cornouiller au tronc noir restera debout, nos âmes vivront dans cet abri de verdure où nous nous sommes aimés, elles fleuriront avec les roses et se pencheront sur les bordures épaisses des buis."
                                            },
                                            {
                                                "example_id": "974dc9b1-5cbc-474e-9437-e9adcce12e57",
                                                "sense_id": "e78e6bae-3397-354c-b300-25564893f1f4",
                                                "text": "Depuis fort longtemps, on recommande le maintien d’un abri […] lors des toutes premières années d’installation du jeune hêtre, prenant appui sur son comportement d’essence d’ombre, et sur les « classiques » difficultés de renouvellement rencontrées en plein découvert (coups de chaleur estivale, gels tardifs, forme défavorable). En régénération naturelle comme en plantation sous abri, la mise en pleine lumière intervient ensuite souvent rapidement, dans un délai proche d’une dizaine d’années, parfois moins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77a60c2b-881e-3547-a0ac-68ab1176d46c",
                                        "entry_id": "dfef0d13-b27a-3bdc-8f1a-8a9c24c5cfe4",
                                        "glosses": [
                                            "Installation destinée à protéger des projectiles ennemis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38f4ed83-a806-4ec1-8bbb-0817d3e72cd6",
                                                "sense_id": "77a60c2b-881e-3547-a0ac-68ab1176d46c",
                                                "text": "Vers 15 heures, alors que le défilé de la débâcle continuait, un bruit d'avions inquiéta la population. Trois ou quatre chasseurs bombardiers survolaient la ville, et les habitants gagnèrent en hâte les abris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b66716b7-02c7-351a-a432-1e4ff1e1ad3f",
                                        "entry_id": "dfef0d13-b27a-3bdc-8f1a-8a9c24c5cfe4",
                                        "glosses": [
                                            "Enceinte en forme de caissette montée sur socle, exposée au nord, et contenant divers appareils de mesure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e46e2f9-b788-4e83-b402-c4768cf2d93f",
                                                "sense_id": "b66716b7-02c7-351a-a432-1e4ff1e1ad3f",
                                                "text": "Le 29 avril, j'ai installé un second poste d’ozonoscopie à la rampe de notre belvédère, à 20 mètres au-dessus du poste établi dans l’abri des thermomètres qui servent aux observations météorologiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
