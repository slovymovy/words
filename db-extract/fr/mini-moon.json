                        "form": "minimoon"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f423ae44-6df7-3f3f-8a36-98eac405538e",
                        "entry_id": "896e6875-a1be-3119-8e15-e40801300c07",
                        "glosses": [
                            "Voyage de noces court, de quelques jours."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95918734-ae74-4777-914b-c3dfede91931",
                                "sense_id": "f423ae44-6df7-3f3f-8a36-98eac405538e",
                                "text": "Ils sont de plus en plus à préférer partir en mini-moon plutôt qu’à l’autre bout du monde."
                            },
                            {
                                "example_id": "64139c83-9d63-41bd-8b22-32d1d4f9088a",
                                "sense_id": "f423ae44-6df7-3f3f-8a36-98eac405538e",
                                "text": "Escapade romantique courte mais magique, la mini-moon permet de s'évader sans se ruiner."
                            },
                            {
                                "example_id": "25784d50-871c-43d5-bbc2-5c850cca913f",
                                "sense_id": "f423ae44-6df7-3f3f-8a36-98eac405538e",
                                "text": "La Mini-moon est tout simplement une lune de miel de quelques jours."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df80cfaf-9ddf-49ae-abcd-9aee7cda265a",
                        "source_entry_id": "896e6875-a1be-3119-8e15-e40801300c07",
                        "source_sense_id": "f423ae44-6df7-3f3f-8a36-98eac405538e",
                        "target_lang_word": "minimoon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "minimoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "639039aa-f2d6-3aff-8e5e-e73f71b5c619",
                                        "entry_id": "9a8b9176-095d-375a-9338-6241df34a5a3",
                                        "glosses": [
                                            "A brief honeymoon or holiday taken after a wedding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e6841cb-3bee-4781-aae7-f291fb7fa8ae",
                                                "sense_id": "639039aa-f2d6-3aff-8e5e-e73f71b5c619",
                                                "text": "But weddings are stressful, and it makes sense to take a day or two after saying “I do” to relax and make mad, passionate love (read: sleep in and watch TV). So consider a minimoon: a quick two-night getaway close to home."
                                            },
                                            {
                                                "example_id": "9dd3b39d-2ecf-4468-9ea6-834a63b809bd",
                                                "sense_id": "639039aa-f2d6-3aff-8e5e-e73f71b5c619",
                                                "text": "Rachel Moschke, Editor of Wedding Ideas magazine, said: ‘Most of us worry about saving up for our wedding day, but it seems we’re reluctant to give up the quality time together that a honeymoon offers. A minimoon is the perfect way to start married life, without busting the budget.’"
                                            },
                                            {
                                                "example_id": "805084a7-22de-4d3c-ad6b-83aa8fe5e688",
                                                "sense_id": "639039aa-f2d6-3aff-8e5e-e73f71b5c619",
                                                "text": "The couple are yet to go on their honeymoon because of their strict working schedules but did find time for a ‘minimoon’ after tying the knot."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "minimoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aea9b3f4-298f-310b-bced-1cf3b773088f",
                                        "entry_id": "449609d2-89bd-3355-bbb0-49dff54a3db9",
                                        "glosses": [
                                            "A small asteroid captured by the Earth's gravity and temporarily acting as a second moon of Earth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faf38c61-de1e-4528-a646-0e09683804eb",
                                                "sense_id": "aea9b3f4-298f-310b-bced-1cf3b773088f",
                                                "text": "This photo of Earth's newest minimoon was taken by the 8-meter Gemini North telescope on Hawaii's Maunakea."
                                            },
                                            {
                                                "example_id": "5a1c948e-b17c-4891-b9ab-ff30969721ba",
                                                "sense_id": "aea9b3f4-298f-310b-bced-1cf3b773088f",
                                                "text": "Earth has only had two minimoons on record – one in February 2020 and the other in 2006."
                                            },
                                            {
                                                "example_id": "8724db31-632d-4a9e-8c04-0e4f20a9b1c3",
                                                "sense_id": "aea9b3f4-298f-310b-bced-1cf3b773088f",
                                                "text": "These included a rare 'minimoon' named 2020 CD3, a tiny asteroid less than 3 metres in diameter that had been temporarily captured by Earth's gravity. The minimoon broke away from Earth's pull last April."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cc05197-8e5f-3489-8adf-2bdbd2ebd380",
                                        "entry_id": "449609d2-89bd-3355-bbb0-49dff54a3db9",
                                        "glosses": [
                                            "Synonym of micromoon (“a full moon which appears unusually small due to coinciding with the Moon's apogee”)."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f248591-0402-47e1-89d0-97dd4cdf19bf",
                                                "sense_id": "8cc05197-8e5f-3489-8adf-2bdbd2ebd380",
                                                "text": "The trouble is, the difference in size between Supermoon and Minimoon, though apparent when placed side-by-side, is only 14 percent, too small to be seen with the naked eye."
                                            },
                                            {
                                                "example_id": "d575897a-470e-4b34-b2b0-984d38935da0",
                                                "sense_id": "8cc05197-8e5f-3489-8adf-2bdbd2ebd380",
                                                "text": "At its closest point, perigee, the moon will obviously appear largest. Such a \"maximoon\" has an apparent diameter about 13% larger than a \"minimoon\" at its most distant point, apogee."
                                            },
                                            {
                                                "example_id": "61b17a34-0014-439b-98e0-9e2dbee56487",
                                                "sense_id": "8cc05197-8e5f-3489-8adf-2bdbd2ebd380",
                                                "text": "For those interested in a longer-term project, Professor Horner said taking a photo of the supermoon and comparing it to the 'minimoon' in December can be an interesting experiment to compare the size."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
