                                "sense_id": "c4c976f1-3e7b-3518-8e2a-f7c9026f6332",
                                "text": "détacheur d’antivol de vêtement"
                            },
                            {
                                "example_id": "d34ac12a-6593-4a1e-87f5-57b8ca39436c",
                                "sense_id": "c4c976f1-3e7b-3518-8e2a-f7c9026f6332",
                                "text": "On distingue trois familles de détacheurs, ceux à friction, ceux à fouettement et ceux à turbine."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae40c807-4ed3-3796-917c-8ab5eff5e756",
