                                            {
                                                "example_id": "80f8446a-a204-4310-bb35-8915c7f4567d",
                                                "sense_id": "0eba2e47-9d50-34eb-b42a-0cf2ea96f824",
                                                "text": "Ooh, that looks delicious!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d06e242-5bcc-37d2-b0b8-7023500c352e",
