                        "entry_id": "c83d888e-e99c-3bb4-8236-245b8f10b891",
                        "glosses": [
                            "placówka służby zdrowia, w której lekarze różnych specjalności przyjmują chorych, udzielają im porad i w której wykonuje się podstawowe badania"
                        ],
                        "tags": [],
                        "examples": [
