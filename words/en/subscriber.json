{
    "word_family": [
        "subscribe",
        "subscription",
        "subscribable",
        "unsubscriber"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3b23d137-08c8-390e-957a-86c1c7e53c2c",
                    "sense_definition": "A person who pays for or signs up to receive a regular publication or service.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "customer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The popular magazine has over ten thousand <w>subscribers</w> who receive the print edition every month.",
                            "target_lang_translations": {
                                "ru": "У популярного журнала более десяти тысяч <w>подписчиков</w>, которые ежемесячно получают печатное издание."
                            }
                        },
                        {
                            "text": "If you are a new <w>subscriber</w>, you can enjoy a fifty percent discount on your first year.",
                            "target_lang_translations": {
                                "ru": "Если вы новый <w>подписчик</w>, вы можете воспользоваться пятидесятипроцентной скидкой на первый год."
                            }
                        }
                    ],
                    "synonyms": [
                        "member",
                        "follower",
                        "reader"
                    ],
                    "common_phrases": [
                        "new subscriber",
                        "loyal subscriber",
                        "monthly subscriber",
                        "active subscriber"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который оплачивает или подписывается на регулярное получение издания или услуги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подписчик",
                                "target_lang_sense_clarification": "лицо, подписанное на издание или интернет-ресурс"
                            },
                            {
                                "target_lang_word": "абонент",
                                "target_lang_sense_clarification": "пользователь услуг связи или сервиса по договору"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b274dc8c-48d3-315d-87b1-aaa0dd428f5a",
                    "sense_definition": "A software component or system that receives specific data or events from a publisher.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The object triggering the event does not care if there are any <w>subscribers</w> listening for the update.",
                            "target_lang_translations": {
                                "ru": "Объекту, инициирующему событие, все равно, есть ли <w>подписчики</w>, ожидающие обновления."
                            }
                        },
                        {
                            "text": "In this architecture, the event <w>subscriber</w> processes incoming messages as soon as they are published.",
                            "target_lang_translations": {
                                "ru": "В этой архитектуре <w>подписчик</w> событий обрабатывает входящие сообщения сразу после их публикации."
                            }
                        }
                    ],
                    "synonyms": [
                        "listener",
                        "consumer"
                    ],
                    "antonyms": [
                        "publisher"
                    ],
                    "common_phrases": [
                        "event subscriber",
                        "data subscriber"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Программный компонент или система, получающая определенные данные или события от издателя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подписчик",
                                "target_lang_sense_clarification": "в программировании: объект, принимающий уведомления"
                            },
                            {
                                "target_lang_word": "слушатель",
                                "target_lang_sense_clarification": "компонент, ожидающий наступления события"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}