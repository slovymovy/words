                                        "examples": [
                                            {
                                                "example_id": "8953a9fe-274b-4855-bba0-478140eccddf",
                                                "sense_id": "866f608c-1521-322d-aff9-d8f76f485786",
                                                "text": "I had occasion […] to make a somewhat long business trip to Chicago, and on my return […] I found Farrar awaiting me in the railway station. He smiled his wonted fraction by way of greeting, […], and finally leading me to his buggy, turned and drove out of town."
                                            },
                                            {
                                                "example_id": "28070543-f362-4829-9822-0c9aaca65f8a",
                                                "sense_id": "866f608c-1521-322d-aff9-d8f76f485786",
                                                "text": "Iron and coal were the magnets that drew railways to this land of lovely valleys and silent mountains—for such it was a century-and-a-half ago, before man blackened the valleys with the smoke of his forges, scarred the green hills with his shafts and waste-heaps, and drove the salmon from the quiet Rhondda and the murmuring Taff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa820dde-4c45-3edc-85d7-a7721ed8fe77",
                                        "entry_id": "7b4e12e7-2f4c-3a26-ad3f-c79e1a6f94ba",
                                        "glosses": [
                                            "past participle of drive"
                                        ],
