                                    },
                                    {
                                        "sense_id": "b5312fcc-fb67-3fae-aedb-e6981d862502",
                                        "entry_id": "ee4714c6-d77f-3072-b9a7-8693b15028b5",
                                        "glosses": [
                                            "A group of houses created by the same builder or in the same general area."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2718abd6-8d5b-41d1-9a0c-41622c7b2fcc",
                                                "sense_id": "b5312fcc-fb67-3fae-aedb-e6981d862502",
                                                "text": "They're putting in a new subdivision out past Black Ranch Road."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9232ed8-141a-3d49-a499-f2b448ae44a5",
                                        "entry_id": "ee4714c6-d77f-3072-b9a7-8693b15028b5",
                                        "glosses": [
                                            "A gated community located within a barangay."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73fe8a2a-b510-4850-aa5d-02d3c139f575",
                                                "sense_id": "b9232ed8-141a-3d49-a499-f2b448ae44a5",
                                                "text": "... By the 1970s, cattle rustling had fallen by the wayside, as tractors replaced carabaos and industrial estates and residential subdivisions supplanted rice fields as the mainstays of Cavite's suburban northern towns."
                                            },
                                            {
                                                "example_id": "b55569e5-2234-4e90-b10a-4a10485f8e2e",
                                                "sense_id": "b9232ed8-141a-3d49-a499-f2b448ae44a5",
                                                "text": "As the farms give way to the residential subdivisions and industrial estates, the centuries-old traditional Filipino houses, slightly raised above grounds and standing on stilts, are abandoned in the quest for more living space."
                                            }
                                        ]
                                    }
                                ]
                            },
