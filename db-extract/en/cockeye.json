                            {
                                "example_id": "ad96916b-cd08-46c3-848d-35f4c06e76ca",
                                "sense_id": "097e98fe-fd76-3b81-af26-d4e269393f28",
                                "text": "“Fine day, gents,” said he, focusing his cockeye."
                            },
