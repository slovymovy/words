                        "entry_id": "8b8b77e3-6d0b-30b6-ad47-eec9ffe0aed9",
                        "glosses": [
                            "A small conical pile of hay, or a heap of hay thrown up in a hayfield while the hay is being cured or awaiting relocation to a haystack or barn."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71d162ee-2b0d-49ef-bb3d-25390cf62564",
                                "sense_id": "3b3e9a96-265d-3e17-bb87-48c60e713ca2",
                                "text": "Brother Kempe, as many alhailes to thy perſon as there be haicocks in Iuly at Pancredge: […]"
                            },
                            {
                                "example_id": "c99da4f1-7b0b-4788-9906-204688426d1c",
                                "sense_id": "3b3e9a96-265d-3e17-bb87-48c60e713ca2",
                                "text": "[T]hey perceived lying closely concealed beneath the thick foliage of a Haycock, a beautifull little Girl not more than 3 months old."
                            },
                            {
                                "example_id": "fbff323c-9d30-4f07-99a4-4a2c82fdda98",
                                "sense_id": "3b3e9a96-265d-3e17-bb87-48c60e713ca2",
                                "text": "And willows, willow-herb, and grass, / And meadowsweet, and haycocks dry, / No whit less still and lonely fair / Than the high cloudlets in the sky."
                            }
                        ]
                    }
