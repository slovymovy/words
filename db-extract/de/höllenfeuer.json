                            },
                            {
                                "target_word": "hellfire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ea5802e-79a6-3e1e-8360-adcedadc9217",
                                        "entry_id": "3b1c945b-5721-3ceb-a3a4-a2437cd2349d",
                                        "glosses": [
                                            "Of or relating to a violent, apocalyptic and ultimate day of reckoning and judgment; usually characterizing a form of Christian preaching."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9c88ac2-964d-4358-b08e-710335722981",
                                                "sense_id": "5ea5802e-79a6-3e1e-8360-adcedadc9217",
                                                "text": "The advance of liberalism, so-called, in Christianity, during the past fifty years, may fairly be called a victory of healthy-mindedness within the church over the morbidness with which the old hell-fire theology was more harmoniously related."
                                            },
                                            {
                                                "example_id": "3e6c43c9-006a-4ca4-8238-f232f6e3dc0d",
                                                "sense_id": "5ea5802e-79a6-3e1e-8360-adcedadc9217",
                                                "text": "Sermons such as The Eternity of Hell Torments and The Future Punishment of the Wicked Unavoidable and Intolerable, as well as several manuscript examples, serve to mark the distinction between a true hellfire sermon and the proto-eschatological concerns of Sinners [in the Hands of an Angry God], consumed as it is with the here and now."
                                            }
                                        ]
                                    }
                                ]
                            },
