{
    "word_family": [
        "scherpte",
        "scherpen",
        "scherper"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1fc1116a-ac11-3076-926d-849578c7bca7",
                    "sense_definition": "Niet scherp of wazig in beeld gebracht",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "visueel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gemaakte foto van de groep was helaas erg <w>onscherp</w>.",
                            "target_lang_translations": {
                                "en": "The photo taken of the group was unfortunately very <w>blurry</w>."
                            }
                        },
                        {
                            "text": "Door de beweging is het beeld op de camera <w>onscherp</w> geworden.",
                            "target_lang_translations": {
                                "en": "Due to the movement, the image on the camera has become <w>out of focus</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "wazig",
                        "nevelig"
                    ],
                    "antonyms": [
                        "scherp",
                        "duidelijk"
                    ],
                    "common_phrases": [
                        "onscherp beeld"
                    ],
                    "target_lang_definitions": {
                        "en": "Not sharp or blurred in appearance"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blurry",
                                "target_lang_sense_clarification": "referring to an image or vision that lacks clarity"
                            },
                            {
                                "target_lang_word": "out of focus",
                                "target_lang_sense_clarification": "specifically regarding photography or optical lenses"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5d1922a-2b83-3c0b-a143-7d28bedbe6c9",
                    "sense_definition": "Niet in staat om goed te snijden",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "snijgereedschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is gevaarlijk om met een <w>onscherp</w> mes te werken.",
                            "target_lang_translations": {
                                "en": "It is dangerous to work with a <w>blunt</w> knife."
                            }
                        },
                        {
                            "text": "Deze schaar is <w>onscherp</w> en knipt het papier niet goed door.",
                            "target_lang_translations": {
                                "en": "These scissors are <w>dull</w> and do not cut the paper well."
                            }
                        }
                    ],
                    "synonyms": [
                        "bot"
                    ],
                    "antonyms": [
                        "scherp"
                    ],
                    "common_phrases": [
                        "onscherp mes"
                    ],
                    "target_lang_definitions": {
                        "en": "Not capable of cutting well"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blunt",
                                "target_lang_sense_clarification": "having a dull edge that does not cut easily"
                            },
                            {
                                "target_lang_word": "dull",
                                "target_lang_sense_clarification": "lacking a sharp edge or point"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a479eba5-5d2c-3411-a40e-8e835cc3ade1",
                    "sense_definition": "Zonder duidelijke focus of stellingname",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het betoog van de spreker bleef erg <w>onscherp</w> en vaag.",
                            "target_lang_translations": {
                                "en": "The speaker's argument remained very <w>vague</w> and unclear."
                            }
                        },
                        {
                            "text": "De politieke visie van de partij is nog te <w>onscherp</w> voor de kiezers.",
                            "target_lang_translations": {
                                "en": "The party's political vision is still too <w>unclear</w> for the voters."
                            }
                        }
                    ],
                    "synonyms": [
                        "vaag",
                        "onduidelijk"
                    ],
                    "antonyms": [
                        "duidelijk",
                        "scherp"
                    ],
                    "target_lang_definitions": {
                        "en": "Lacking a clear focus or defined position"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vague",
                                "target_lang_sense_clarification": "lacking clear detail or definition"
                            },
                            {
                                "target_lang_word": "unclear",
                                "target_lang_sense_clarification": "not easy to understand or define"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}