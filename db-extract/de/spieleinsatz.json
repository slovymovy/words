                ],
                "senses": [
                    {
                        "sense_id": "0cd17c2b-ed16-3c55-a980-30f6f01995d1",
                        "entry_id": "23fd179c-592a-3558-a3e4-753142590961",
                        "glosses": [
                            "Einbringen eines Pfands beziehungsweise einer Person in ein Wettspiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53983f07-7c23-46a7-a11e-7ee79695cd3c",
                                "sense_id": "0cd17c2b-ed16-3c55-a980-30f6f01995d1",
                                "text": "„Die Jungen und Mädchen benötigten viele Knöchelchen, da diese auch bei anderen Spielen der Spieleinsatz waren.“"
                            },
                            {
                                "example_id": "3cc13a0a-d6c6-4a57-9752-a28ee9a6e2be",
                                "sense_id": "0cd17c2b-ed16-3c55-a980-30f6f01995d1",
                                "text": "„Jeder Spieler benötigt einen Würfel und als Spieleinsatz Chips, Streichhölzer oder Münzen.“"
                            },
                            {
                                "example_id": "31ae5113-e72b-4c4d-b1f3-1bd19f71fb87",
                                "sense_id": "0cd17c2b-ed16-3c55-a980-30f6f01995d1",
                                "text": "„Es sei ihm auch nicht bekannt, daß Minister Ruhstrat Silbergeld der Referendare als Spieleinsatz verächtlich beiseite geschoben habe.“"
                            },
                            {
                                "example_id": "eabe061c-1b68-4aae-a914-c3859b3228a6",
                                "sense_id": "0cd17c2b-ed16-3c55-a980-30f6f01995d1",
                                "text": "„Auch sein Bayern-Kollege Thomas Müller sieht trotz einer Risswunde am Auge keine Gefahr für seine Spieleinsätze.“"
                            },
                            {
                                "example_id": "75638318-dc0a-4000-a828-796f9dff3673",
                                "sense_id": "0cd17c2b-ed16-3c55-a980-30f6f01995d1",
                                "text": "„Der deutsche Nationalteam-Center Chris Kaman musste sich dagegen in nur etwas mehr als sieben Minuten Spieleinsatz mit drei Punkten für den Gastgeber begnügen, der das siebte Spiel nacheinander und das zwölfte der letzten 13 verlor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
