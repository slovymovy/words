                                                "sense_id": "e69e1d7d-2479-3dd0-b4e2-cabb0be7d097",
                                                "text": "Kirk Hammet ist Gitarrist bei der überregional bekannten Band Metallica."
                                            },
                                            {
                                                "example_id": "7d2db9bf-510b-497b-ba3f-17549eb0e90d",
                                                "sense_id": "e69e1d7d-2479-3dd0-b4e2-cabb0be7d097",
                                                "text": "„Mein Vater ist ein gewiefter Gitarrist, hat als junger Kerl in mehreren Bands gespielt, ich schätze, manchmal tut er es immer noch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
