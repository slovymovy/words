                    },
                    {
                        "translation_id": "16aa9201-7148-483f-a9b3-b929aaf27d07",
                        "source_entry_id": "410168a7-637e-385c-b6df-e0bc6c6a798e",
                        "source_sense_id": "4a09e66f-1d2b-3db2-82c2-bbe7aeca621c",
                        "target_lang_word": "stink",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stink",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2924a025-35f8-38c9-8be5-5c955f2e56b8",
                                        "entry_id": "ed82a92c-a2cb-3b19-8e28-6e536cc8cb72",
                                        "glosses": [
                                            "To have a strong bad smell."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9f318c5-e23e-3ca9-8427-700adec07b21",
                                        "entry_id": "ed82a92c-a2cb-3b19-8e28-6e536cc8cb72",
                                        "glosses": [
                                            "To be greatly inferior; to perform badly."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive",
                                            "stative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd488018-e645-47c5-964f-f9b6df982773",
                                                "sense_id": "c9f318c5-e23e-3ca9-8427-700adec07b21",
                                                "text": "That movie stinks. I didn't even stay for the end."
                                            },
                                            {
                                                "example_id": "30e8d5db-3827-4d94-bff7-91a212fbe65e",
                                                "sense_id": "c9f318c5-e23e-3ca9-8427-700adec07b21",
                                                "text": "They gave me Out of Africa, by Isak Dinesen. I thought it was going to stink, but it didn't. It was a very good book."
                                            },
                                            {
                                                "example_id": "2182cab5-edff-4198-9c09-7a6b2c04bc6d",
                                                "sense_id": "c9f318c5-e23e-3ca9-8427-700adec07b21",
                                                "text": "My French stinks, Langdon thought, but my zodiac iconography is pretty good. Taurus was always the bull. Astrology was a symbolic constant all over the world."
                                            },
                                            {
                                                "example_id": "0f6ff5ed-b8b0-4442-9e44-5bedd0d0d4ef",
                                                "sense_id": "c9f318c5-e23e-3ca9-8427-700adec07b21",
                                                "text": "Improve your golf swing by taking your mate to the driving range. If you're good, you can show off and give her some tips. If you stink, play it for laughs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9593e10b-bd4e-3d83-a03d-2e633d7579bb",
                                        "entry_id": "ed82a92c-a2cb-3b19-8e28-6e536cc8cb72",
                                        "glosses": [
                                            "To give an impression of dishonesty, untruth, or sin."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51788603-47ff-4ec9-bbf0-7ca5ba313c4f",
                                                "sense_id": "9593e10b-bd4e-3d83-a03d-2e633d7579bb",
                                                "text": "Something stinks about the politician's excuses."
                                            },
                                            {
                                                "example_id": "5b3aa21e-b272-424b-a3a4-b64a97928ded",
                                                "sense_id": "9593e10b-bd4e-3d83-a03d-2e633d7579bb",
                                                "text": "The parish stank of idolatry, abominable rites were practiced in secret, and in all the bounds there was no one had a more evil name for the black traffic than one Alison Sempill, who bode at the Skerburnfoot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f79b94d2-e290-3d75-ae37-1cbad1b6c40d",
                                        "entry_id": "ed82a92c-a2cb-3b19-8e28-6e536cc8cb72",
                                        "glosses": [
                                            "To cause to stink; to affect by a stink."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "stink",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ebd7dbd-ac56-3c07-8af2-f8ae78ee2812",
                                        "entry_id": "8acd13a5-02c7-3b64-8c69-9348e9e9f73b",
                                        "glosses": [
                                            "A strong bad smell."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39eeae85-7591-44fc-954a-6a155c0af8bf",
                                                "sense_id": "8ebd7dbd-ac56-3c07-8af2-f8ae78ee2812",
                                                "text": "“I’m thankful for this beautiful morning!” He points toward the sky. “See that sunrise? Smell that air—” / “That’s stink from the rendering plant.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ccbb6b6-ad4b-300b-b5c6-8b1a73d1999a",
                                        "entry_id": "8acd13a5-02c7-3b64-8c69-9348e9e9f73b",
                                        "glosses": [
                                            "A complaint or objection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f45ec400-ea9b-4319-8821-67cdbab4f4f4",
                                                "sense_id": "5ccbb6b6-ad4b-300b-b5c6-8b1a73d1999a",
                                                "text": "If you don't make a stink about the problem, nothing will be done."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stink",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d8491c1-26c2-31cc-82e2-4020b79dd51d",
                                        "entry_id": "fc8d1d88-25f4-303e-816f-b319a6b7ce22",
                                        "glosses": [
                                            "Bad; inferior; worthless."
                                        ],
                                        "tags": [
                                            "New-Zealand",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f35dd023-d4c4-4db6-a092-98191eb12d27",
                                                "sense_id": "6d8491c1-26c2-31cc-82e2-4020b79dd51d",
                                                "text": "The concert was stink. / That was a stink concert."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "911f5e07-06de-3d22-be5d-a88747b4b1ad",
                                        "entry_id": "fc8d1d88-25f4-303e-816f-b319a6b7ce22",
                                        "glosses": [
                                            "Bad-smelling, stinky."
                                        ],
                                        "tags": [
                                            "Caribbean",
                                            "Guyana",
                                            "Jamaica"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea550713-94bf-49a6-bb2e-08c7acd53992",
                                                "sense_id": "911f5e07-06de-3d22-be5d-a88747b4b1ad",
                                                "text": "2013, Stabroek News, 19 February 2013, cited by Deborah Jan Osman Backer in a speech delivered in the National Assembly during the Budget Debate, 2013,\nEveryone is up in arms but it smells stink because it smells of racism…"
                                            },
                                            {
                                                "example_id": "bd24f65d-1b71-407c-8d2f-9dddd3ba7f2e",
                                                "sense_id": "911f5e07-06de-3d22-be5d-a88747b4b1ad",
                                                "text": "Spending hours in a “stink\" morgue, being called “Taliban”, thinking of getting shot in the head by officers—memories of Venezuela that have left Hamza Mohammed, imam of the Montrose mosque, still trembling today."
                                            },
                                            {
                                                "example_id": "cac8074a-6e18-4c99-9ad5-d8c9c432346b",
                                                "sense_id": "911f5e07-06de-3d22-be5d-a88747b4b1ad",
                                                "text": "2016, Kei Miller, Augustown, New York: Pantheon, Chapter 1, p. 5,\n[…] what Ma Taffy smells on this early afternoon makes her sit up straight. She smells it high and ripe and stink on the air, like a bright green jackfruit in season being pulled to the rocky ground below."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f5173bf-702b-43d4-a144-3a5504e8e9fa",
                        "source_entry_id": "410168a7-637e-385c-b6df-e0bc6c6a798e",
                        "source_sense_id": "4a09e66f-1d2b-3db2-82c2-bbe7aeca621c",
                        "target_lang_word": "Gestank",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gestank",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e143b47-66e3-3f34-92df-cf9292007b3d",
                                        "entry_id": "e0e50b74-15f9-3291-9c2a-60358311e237",
                                        "glosses": [
                                            "übler, unangenehmer Geruch; verstärktes stank"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "767319d6-cefc-4d9d-9fad-aa30be9189e1",
                                                "sense_id": "6e143b47-66e3-3f34-92df-cf9292007b3d",
                                                "text": "Dieser Gestank ist unausstehlich."
                                            },
                                            {
                                                "example_id": "8b6144a3-f7f9-4cbd-a23a-b63f52bb768c",
                                                "sense_id": "6e143b47-66e3-3f34-92df-cf9292007b3d",
                                                "text": "Verfaulte Eier verströmen einen unerträglichen Gestank."
                                            },
                                            {
                                                "example_id": "c06773be-3d14-49fd-a329-ed0935321610",
                                                "sense_id": "6e143b47-66e3-3f34-92df-cf9292007b3d",
                                                "text": "„Den Besuchern schlagen das Dröhnen der Schmieden und der Gestank von Tausend Misthaufen entgegen.“"
                                            },
                                            {
                                                "example_id": "2d719d90-57b1-4542-9c67-f73010517dcf",
                                                "sense_id": "6e143b47-66e3-3f34-92df-cf9292007b3d",
                                                "text": "„Doch sie brauchten nicht lange, um der Armut, dem Gestank und dem Elend zu begegnen.“"
                                            },
                                            {
                                                "example_id": "d61365bd-037c-4a1d-87de-f54e2bf199a2",
                                                "sense_id": "6e143b47-66e3-3f34-92df-cf9292007b3d",
                                                "text": "„Der Gestank allein könnte einen Plazebo-Effekt auslösen wie der Anblick eines Stethoskops.\""
                                            },
                                            {
                                                "example_id": "3901924c-59cc-4aa8-8624-3e9382b0a1ba",
                                                "sense_id": "6e143b47-66e3-3f34-92df-cf9292007b3d",
                                                "text": "„Hier ist die frische Meeresluft mit dem Gestank von Abfällen vermischt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
