                "senses": [
                    {
                        "sense_id": "2f9a62c2-9f66-318f-a921-d76bd8111329",
                        "entry_id": "b8952098-a9ee-3235-96ae-800f834f2321",
                        "glosses": [
                            "ботан. травянистое декоративное растение семейства паслёновых с крупными цветками различной окраски"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ec764ca-fc83-47d4-8b78-1d0adb26fa40",
                                "sense_id": "2f9a62c2-9f66-318f-a921-d76bd8111329",
                                "text": "Тут были всевозможные цветы, встречающиеся в малороссийских садиках: высокие розы, яркие петунии, кусты высокого табаку с небольшими розовыми цветами, мята, бархатцы, настурции, и мак."
                            },
                            {
                                "example_id": "96cf92c3-8c7f-40a3-b6ab-f121d2c0557b",
                                "sense_id": "2f9a62c2-9f66-318f-a921-d76bd8111329",
                                "text": "С берега донесся запах петунии и ночной красавицы."
                            }
                        ]
                    }
