                ],
                "senses": [
                    {
                        "sense_id": "1317968e-3945-3c5a-b4ed-20bf153bdd96",
                        "entry_id": "d1ee7cbd-ece9-30a8-b503-2e135fffb91f",
                        "glosses": [
                            "aus den einer Person bekannten Sichtwörtern bestehender Wortschatz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c13c9349-ca79-4339-8633-e29068a1ea11",
                                "sense_id": "1317968e-3945-3c5a-b4ed-20bf153bdd96",
                                "text": "„Je größer der Sichtwortschatz des jeweiligen Lesers ist, desto flüssiger kann er lesen.“"
                            },
                            {
                                "example_id": "19f10982-2184-4ffb-ada1-27e85cac275f",
                                "sense_id": "1317968e-3945-3c5a-b4ed-20bf153bdd96",
                                "text": "„Sie schreibt lautbasiert und verfügt zudem über einen sehr eingeschränkten Sichtwortschatz.“"
                            },
                            {
                                "example_id": "142687bc-04d6-4e30-9076-ebf85fe63ec6",
                                "sense_id": "1317968e-3945-3c5a-b4ed-20bf153bdd96",
                                "text": "„Dieser indirekte Weg muss von Leseanfängern gewählt werden, solange noch kein ausreichender Sichtwortschatz zur Verfügung steht, und ebenso müssen schwache Leser diesen mühsamen Zugangsweg verwenden.“"
                            },
                            {
                                "example_id": "a3f516f4-8c30-4e92-b61a-4f5384ee00c4",
                                "sense_id": "1317968e-3945-3c5a-b4ed-20bf153bdd96",
                                "text": "„Nach Aufbau eines Sichtwortschatzes folgte die Analyse der Wortbedeutungen in Form möglichst bedeutungstragender Phonem-Graphem-Korrespondenzcluster.“"
                            },
                            {
                                "example_id": "7751deb2-e46d-4feb-8b3f-cd44b3fb7ebb",
                                "sense_id": "1317968e-3945-3c5a-b4ed-20bf153bdd96",
                                "text": "„Ein ausgeprägter Sichtwortschatz befähigt die Leser dazu, auf einem Blick die Bedeutung der memorierten Wörter zu erschließen und gleichzeitig Informationen über Aussprache, Schreibweise und typische syntaktische Satzkonstellationen des Wortes zu extrahieren […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
