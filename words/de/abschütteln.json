                    "semantic_group_id": "entfernen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vor der Haustür <w>schüttelte</w> er den nassen Schnee von seiner Jacke <w>ab</w>."
                        },
                        {
                            "text": "Der Hund stieg aus dem kalten Wasser und <w>schüttelte</w> die Tropfen gründlich <w>ab</w>."
                        }
                    ],
