                        "entry_id": "24fdde35-3aa9-35a6-8aa9-52f71d098cb7",
                        "glosses": [
                            "definierter Grad der Wirksamkeit von Maßnahmen, die eine Veränderung (Risiko / Chance) herbeiführen; Effektivität"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38d00cde-7fee-4124-8818-d67afc00bb88",
                                "sense_id": "15ea0314-16b3-31f7-89c6-12f1e32ddf6f",
                                "text": "„Effektivität im engeren Sinne definiert den Wirksamkeitsgrad: Liegt die Zielerreichung über einem vorab formulierten Zielniveau?“"
                            },
                            {
                                "example_id": "7aafa914-3757-48c9-83bd-665eae973937",
                                "sense_id": "15ea0314-16b3-31f7-89c6-12f1e32ddf6f",
                                "text": "„Durch die so erreichte Zielgenauigkeit des Medikaments kann die Dosierung reduziert und der Wirksamkeitsgrad gesteigert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
