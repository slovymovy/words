                ],
                "senses": [
                    {
                        "sense_id": "53a86267-50ba-3efc-b6da-b70647e05506",
                        "entry_id": "bda3108e-0f5b-3587-b7a9-c28b5fce38b6",
                        "glosses": [
                            "Se commémorer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b2ef6c8-81ce-47ab-8c2e-1ff0e724af3f",
                                "sense_id": "53a86267-50ba-3efc-b6da-b70647e05506",
                                "text": "Ainsi, du côté de la narration, le dernier numéro aime autobiographier ou autocommémorer le titre archi-énonciateur."
                            },
                            {
                                "example_id": "7978293c-4358-43ae-80f4-94bfc5eb076a",
                                "sense_id": "53a86267-50ba-3efc-b6da-b70647e05506",
                                "text": "Il faut que M. Giscard d’Estaing apprenne son métier et cesse de passer son temps à s’autocommémorer."
                            },
                            {
                                "example_id": "7195a18a-bea8-44af-bca3-327e67ea8c5b",
                                "sense_id": "53a86267-50ba-3efc-b6da-b70647e05506",
                                "text": "Ecrire toujours la même chanson, cela donnerait l'idée de s'autocommémorer avant la mort."
                            }
                        ]
                    }
                ],
