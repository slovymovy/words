                "senses": [
                    {
                        "sense_id": "d16ecfc2-2199-3eb2-ad7c-68124fd4f9f8",
                        "entry_id": "cc8a0b3b-42d9-32b7-b848-e0494e60a95a",
                        "glosses": [
                            "Raclure."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "6cbe4e35-8d33-44d5-820c-08d6d088a6bc",
                                "sense_id": "d16ecfc2-2199-3eb2-ad7c-68124fd4f9f8",
                                "text": "Quand on voulait faire l’essai d'une masse d'argent, on en tirait quelques grains, par le moyen d’un petit instrument nommé échoppe ; on mettait cette petite quantité d’argent sur des charbons ardents, et on jugeait de son titre par sa couleur plus ou moins blanche ; cette méthode s’appelait faire l’essai à la rature ou à l’échoppe."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8509f53-96db-3a95-9b3d-cd82d1f4aabb",
                        "entry_id": "cc8a0b3b-42d9-32b7-b848-e0494e60a95a",
                        "glosses": [
                            "Raclure.",
                            "Ce qu’on enlève des peaux en les raclant."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e34f1612-6d0f-4c2e-acda-d3c3218a7b2e",
                                "sense_id": "c8509f53-96db-3a95-9b3d-cd82d1f4aabb",
                                "text": "Les ratures servent à faire de la colle."
                            }
                        ]
                    },
                    {
                        "sense_id": "8cd57234-4453-35ac-a1cc-2cb0e3d22541",
                        "entry_id": "cc8a0b3b-42d9-32b7-b848-e0494e60a95a",
                        "glosses": [
                            "Raclure.",
                            "Petite bande qu'on enlève en tournant l’étain sur la roue."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ab155228-2d3d-3f2a-99a1-799d47d98f11",
                        "entry_id": "cc8a0b3b-42d9-32b7-b848-e0494e60a95a",
                        "glosses": [
                            "Rayure(s), ajout d'un ou plusieurs traits pour barrer ou masquer une partie d'un texte à corriger, à rectifier."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3ad290ef-5e50-32c5-9cc3-cd09359dff86",
                        "entry_id": "cc8a0b3b-42d9-32b7-b848-e0494e60a95a",
                        "glosses": [
                            "Voici un exemple : ce texte est une rature sur Wikipédia."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d73916da-3a0d-3c7d-8500-7a9cfd1ab380",
                        "entry_id": "cc8a0b3b-42d9-32b7-b848-e0494e60a95a",
