                                    {
                                        "sense_id": "f6e55c81-bc3d-31c7-bf7c-9aa31de7f579",
                                        "entry_id": "3b60045a-d39a-382c-b7da-5d44a2ef6a22",
                                        "glosses": [
                                            "Eigenschaft, überzeugend/stichhaltig zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb2a8061-7efc-4581-8442-5bbf5f0725a5",
                                                "sense_id": "f6e55c81-bc3d-31c7-bf7c-9aa31de7f579",
                                                "text": "„Dieser Grund leuchtete ihm ein, und da er von seiner Stichhaltigkeit überzeugt war, sagte er mir, er sei reich, und ich müsse ihm ohne Hemmungen gestatten, mich zu einem Schneider zu führen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
