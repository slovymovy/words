                                    {
                                        "sense_id": "b64ac84c-25bc-30bc-9226-2fb9cb104d84",
                                        "entry_id": "f579f31b-a08e-3210-b1bb-c33220bce9bc",
                                        "glosses": [
                                            "A small opening; a small pit or depression, especially in bone."
