                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wczesnym rankiem spacerowaliśmy po <w>mglistym</w> lesie.",
                            "target_lang_translations": {
                                "en": "Early in the morning, we walked through the <w>misty</w> forest.",
                                "ru": "Ранним утром мы гуляли по <w>туманному</w> лесу.",
                                "nl": "'s Ochtends vroeg wandelden we door een <w>mistig</w> bos.",
                                "de": "Am frühen Morgen spazierten wir durch den <w>nebligen</w> Wald.",
                                "fr": "Tôt le matin, nous nous promenions dans une forêt <w>brumeuse</w>.",
                                "it": "La mattina presto camminavamo in un bosco <w>nebbioso</w>.",
                                "cs": "Brzy ráno jsme se procházeli <w>mlhavým</w> lesem.",
                                "tr": "Sabahın erken saatlerinde <w>sisli</w> bir ormanda yürüyüş yaptık.",
                                "es": "Temprano por la mañana paseábamos por un bosque <w>neblinoso</w>.",
                                "zh": "清晨，我们在<w>大雾弥漫的</w>森林里散步。"
                            }
                        },
                        {
                            "text": "Był <w>mglisty</w> poranek i na drodze prawie nic nie było widać.",
                            "target_lang_translations": {
                                "en": "It was a <w>foggy</w> morning, and almost nothing could be seen on the road.",
                                "ru": "Было <w>туманное</w> утро, и на дороге почти ничего не было видно.",
                                "nl": "Het was een <w>mistige</w> ochtend en op de weg was bijna niets te zien.",
                                "de": "Es war ein <w>nebliger</w> Morgen und auf der Straße war fast nichts zu sehen.",
                                "fr": "C'était un matin <w>brumeux</w> et on n'y voyait presque rien sur la route.",
                                "it": "Era una mattina <w>nebbiosa</w> e sulla strada non si vedeva quasi nulla.",
                                "cs": "Bylo <w>mlhavé</w> ráno a na silnici nebylo skoro nic vidět.",
                                "tr": "<w>Sisli</w> bir sabahtı ve yolda neredeyse hiçbir şey görünmüyordu.",
                                "es": "Era una mañana <w>brumosa</w> y en la carretera casi no se veía nada.",
                                "zh": "那是一个<w>多雾的</w>早晨，路上几乎什么也看不清。"
                            }
                        }
                    ],
