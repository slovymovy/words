                    "sense_id": "56c4ac35-5761-3c69-b07f-2a2674502e20",
                    "sense_definition": "De eigenschap of houding waarbij men zichzelf niet op de voorgrond plaatst en geen aanspraak maakt op macht of eer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "karaktereigenschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>nederigheid</w> doet bijna vergeten wat een groot kunstenaar hij in werkelijkheid is.",
                            "target_lang_translations": {
                                "en": "His <w>humility</w> almost makes one forget what a great artist he actually is."
                            }
                        },
                        {
                            "text": "De bergen dwongen de klimmers om de natuur met diepe <w>nederigheid</w> te bejegenen.",
                            "target_lang_translations": {
                                "en": "The mountains forced the climbers to treat nature with deep <w>humility</w>."
                            }
                        }
                    ],
