    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "fb12a1d5-22bb-30eb-8a8e-a018ee531702",
                "word": "бы",
                "pos": "particle",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9c321764-c756-37e3-bfb0-228613de15ed",
                        "entry_id": "fb12a1d5-22bb-30eb-8a8e-a018ee531702",
                        "glosses": [
                            "A verbal particle used to render conditional and subjunctive mood"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "096e9175-614d-47a6-80ed-504ff76461bb",
                                "sense_id": "9c321764-c756-37e3-bfb0-228613de15ed",
                                "text": "Я говори́л(а).",
                                "translation": "I spoke.",
                                "english": "I spoke."
                            },
                            {
                                "example_id": "d87eccd6-afab-41d6-8379-d387910d9aab",
                                "sense_id": "9c321764-c756-37e3-bfb0-228613de15ed",
                                "text": "Я бы говори́л(a).",
                                "translation": "I would (should) have spoken.; I would speak.; I might speak.",
                                "english": "I would (should) have spoken.; I would speak.; I might speak."
                            },
                            {
                                "example_id": "5f2694f0-94b6-4a72-9569-1769af527bf4",
                                "sense_id": "9c321764-c756-37e3-bfb0-228613de15ed",
                                "text": "— Сказа́л бы слове́чко, да волк недале́чко, — сказа́л, нахму́рясь, Гаври́ла Афана́сьевич.",
                                "translation": "“I’d add a word or two of my own, but even the walls have ears,” said Gavrila Afanasevich, frowning.",
                                "english": "“I’d add a word or two of my own, but even the walls have ears,” said Gavrila Afanasevich, frowning."
                            },
                            {
                                "example_id": "eaafc049-950a-413f-b030-335cf44ff56e",
                                "sense_id": "9c321764-c756-37e3-bfb0-228613de15ed",
                                "text": "Забо́та у нас проста́я,\nЗабо́та на́ша така́я:\nЖила́ бы страна́ родна́я,\nИ не́ту други́х забо́т!",
                                "translation": "Our concern is simple;\nOur concern is this:\nThat our dear country would live,\nAnd there are no other concerns!",
                                "english": "Our concern is simple;\nOur concern is this:\nThat our dear country would live,\nAnd there are no other concerns!"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
        "ru-extract.jsonl": [
            {
                "entry_id": "56fdf9aa-34ae-34aa-b086-2ca2052b2a7a",
                "word": "бы",
                "pos": "particle",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f75f5f2a-b1b0-303f-ae17-84239ae86b30",
                        "entry_id": "56fdf9aa-34ae-34aa-b086-2ca2052b2a7a",
                        "glosses": [
                            "употребляется при образовании сослагательного наклонения (в сочетании с глаголами в форме прошедшего времени)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bdc0b4e-83d4-42bb-b579-afae817c27e6",
                                "sense_id": "f75f5f2a-b1b0-303f-ae17-84239ae86b30",
                                "text": "Лучше бы ты вовсе об этом не начинал разговора…"
                            },
                            {
                                "example_id": "281b1793-e590-4a09-b234-5b4d4cd791a9",
                                "sense_id": "f75f5f2a-b1b0-303f-ae17-84239ae86b30",
                                "text": "Было бы несправедливо сказать, что природа обидела Ивана Акиндиныча Бергамотова, в своей официальной части именовавшегося «городовой бляха № 20», а в неофициальной — попросту «Баргамот»."
                            },
                            {
                                "example_id": "f7ac322e-ba72-439e-9e16-b31b03b9454d",
                                "sense_id": "f75f5f2a-b1b0-303f-ae17-84239ae86b30",
                                "text": "— Если бы я вчера, убегая переулками, оглянулся, то, может быть, не поверил бы вам, но я не оглядывался и не знаю, видел ли меня кто-нибудь."
                            }
                        ]
                    },
                    {
                        "sense_id": "9aaef16e-d466-32ec-a37f-104d76b0bd19",
                        "entry_id": "56fdf9aa-34ae-34aa-b086-2ca2052b2a7a",
                        "glosses": [
                            "употребляется при обозначении предположительной или условно-предположительной возможности действия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5691efa-41c0-4ea8-9aa4-c583e582c7f4",
                                "sense_id": "9aaef16e-d466-32ec-a37f-104d76b0bd19",
                                "text": "Ведь и я мог бы сделать то же самое!"
                            },
                            {
                                "example_id": "7b863626-6a02-4d1b-8d16-d25e87c633e9",
                                "sense_id": "9aaef16e-d466-32ec-a37f-104d76b0bd19",
                                "text": "Я бы никогда не позволил себе преподнести Вам что-либо, выбранное мною лично: для этого у меня нет ни права, ни тонкого вкуса и — признаюсь — ни денег."
                            },
                            {
                                "example_id": "25a054c3-872f-4186-ae42-bf01a3176678",
                                "sense_id": "9aaef16e-d466-32ec-a37f-104d76b0bd19",
                                "text": "Шестой ребенок, прижитый от проезжего цыгана, была девочка, и участь её была бы та же, но случилось так, что одна из двух старых барышень зашла в скотную, чтобы сделать выговор скотницам за сливки, пахнувшие коровой."
                            }
                        ]
                    },
                    {
                        "sense_id": "6fa6906c-fbea-3d40-a168-7965e081a1ee",
                        "entry_id": "56fdf9aa-34ae-34aa-b086-2ca2052b2a7a",
                        "glosses": [
                            "употребляется при обозначении различных оттенков желаемости действия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f11ec03a-9e3c-4f50-b570-8192809ae6e5",
                                "sense_id": "6fa6906c-fbea-3d40-a168-7965e081a1ee",
                                "text": "Если она здесь без мужа и без знакомых, — соображал Гуров, — то было бы не лишнее познакомиться с ней."
                            },
                            {
                                "example_id": "190937d4-0a50-4739-9593-3c844a7b755c",
                                "sense_id": "6fa6906c-fbea-3d40-a168-7965e081a1ee",
                                "text": "— Глаза бы мои на тебя не глядели!"
                            },
                            {
                                "example_id": "ff1aa949-a7ca-4d24-b2be-29f037d90f1f",
                                "sense_id": "6fa6906c-fbea-3d40-a168-7965e081a1ee",
                                "text": "— Хорошее у тебя сердце, мать! — тихо проговорил Павел. — Только бы тебе, — и всем вам, — хоть как-нибудь помогла я! Сумела бы!.. — Не бойся — сумеешь!.."
                            },
                            {
                                "example_id": "f34bbbef-8512-4c32-af5f-a9812c1adc85",
                                "sense_id": "6fa6906c-fbea-3d40-a168-7965e081a1ee",
                                "text": "— У моей Дарьи тиф брюшной. Мне бы её в больницу."
                            }
                        ]
                    },
                    {
                        "sense_id": "08a62d56-d280-3329-bedc-5acbbbf076fe",
                        "entry_id": "56fdf9aa-34ae-34aa-b086-2ca2052b2a7a",
                        "glosses": [
                            "указывает на вежливо-предупредительное пожелание кому-либо, совет, предложение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1087cf3e-ab2b-4299-a5d2-c2b9e5fe320b",
                                "sense_id": "08a62d56-d280-3329-bedc-5acbbbf076fe",
                                "text": "— Вы бы сходили в театр, душечка, или в цирк."
                            },
                            {
                                "example_id": "c7b65dc9-f516-4acb-adc9-43514aecd5de",
                                "sense_id": "08a62d56-d280-3329-bedc-5acbbbf076fe",
                                "text": "— Ты бы, дядя Гильом, придерживался, на всякий случай, открытых мест."
                            }
                        ]
                    },
                    {
                        "sense_id": "3adc68b8-6832-3785-8cc6-bdb3e1546d37",
                        "entry_id": "56fdf9aa-34ae-34aa-b086-2ca2052b2a7a",
                        "glosses": [
                            "употребляется при выражении опасения по поводу какого-либо нежелательного действия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d59e3a5f-9752-4de0-b1c1-f51956a34d9a",
                                "sense_id": "3adc68b8-6832-3785-8cc6-bdb3e1546d37",
                                "text": "Я к Рагулиным поспею сегодня, не опоздать бы только к поезду…"
                            }
                        ]
                    },
                    {
                        "sense_id": "8dbeebcc-4050-3ad6-bb7d-8d909ecd77fd",
                        "entry_id": "56fdf9aa-34ae-34aa-b086-2ca2052b2a7a",
                        "glosses": [
                            "указывает на обусловленность действия"
                        ],
                        "tags": [
                            "в придаточном предложении"
                        ],
                        "examples": [
                            {
                                "example_id": "0e66d236-259c-417c-953c-0287bac83736",
                                "sense_id": "8dbeebcc-4050-3ad6-bb7d-8d909ecd77fd",
                                "text": "В самом деле, экономия времени благодаря машинам дала возможность людям произвести много хлеба, фруктов и изделий, которых не было бы, если бы не осталось свободного времени."
                            }
                        ]
                    },
                    {
                        "sense_id": "3abeac94-9155-3c96-bb82-262bc2f214a6",
                        "entry_id": "56fdf9aa-34ae-34aa-b086-2ca2052b2a7a",
                        "glosses": [
                            "указывает на различные оттенки условности, предположительности, желаемости действия"
                        ],
                        "tags": [
                            "в составе сложных союзов, частиц и наречий"
                        ],
                        "examples": [
                            {
                                "example_id": "c3a8d8a5-8783-4658-aa77-7dfda05cdd9e",
                                "sense_id": "3abeac94-9155-3c96-bb82-262bc2f214a6",
                                "text": "— А знаешь ли, друг мой, какой я сон сегодня видела? Что будто бы твой Коля и наш Ипполит уже взрослые и оба гусары."
                            },
                            {
                                "example_id": "1856e4c9-2f87-40d3-bdc0-c3e4fbae2e7f",
                                "sense_id": "3abeac94-9155-3c96-bb82-262bc2f214a6",
                                "text": "А что он погуляет, выпьет иногда после трудов, так и то мужчине не беда, лишь бы не забывал своего дела."
                            }
                        ]
                    }
                ],
