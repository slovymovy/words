                    {
                        "sense_id": "a2d7abdd-63d8-38fa-a276-81824acb1f68",
                        "entry_id": "a99927e0-1faf-3608-9fd9-d3807ed5061c",
                        "glosses": [
                            "Action de dessécher ou état d’une chose desséchée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19adbe89-380d-4a75-be9d-c8e8d9f25a0b",
                                "sense_id": "a2d7abdd-63d8-38fa-a276-81824acb1f68",
                                "text": "Le tragique est que là, devant moi, le passé reste mort en sa permanence et permanent en son dessèchement, tache ineffaçable ou parfum irretrouvable."
                            },
                            {
                                "example_id": "e104efd9-c91c-4106-a579-6a4a6a1bbd08",
                                "sense_id": "a2d7abdd-63d8-38fa-a276-81824acb1f68",
                                "text": "Le sarclage de prélevée à plat, et dans une moindre mesure l'enfouissement de matière organique par le sarclobuttage de prélevée accélèrent le dessèchement par évaporation de l'horizon de surface, comparés au sarclobuttage de prélevée seul."
                            }
                        ]
                    }
                ],
