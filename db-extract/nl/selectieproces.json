                        "glosses": [
                            "serie opeenvolgende handelingen die leiden tot een verkiezing van iets of iemand uit een grotere groep zaken of personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "149f8389-f0b8-4e5c-bf47-5353908178c9",
                                "sense_id": "1dcb55cf-f9e9-37db-a13a-eb5dca2aab5a",
                                "text": "De PIA-medewerkers kregen instructies van hun respectieve landen om extra voorzichtig te zijn tijdens het selectieproces voor de kandidaat voor het Trapproject en geen politieke fouten te maken die hun land in verlegenheid zouden brengen."
                            },
                            {
                                "example_id": "7f728136-f8da-48d4-9801-a7d73fa4c288",
                                "sense_id": "1dcb55cf-f9e9-37db-a13a-eb5dca2aab5a",
                                "text": "We vinden alleen dat hier iets is fout gegaan in het selectieproces dat bij de totstandkoming van elk willekeurig kunstwerk plaatsvindt en dat enkele aspecten die we als een wezenlijk deel van onze persoonlijkheid beschouwen niet de aandacht hebben gekregen die ze verdienen."
                            },
                            {
                                "example_id": "3b05a3fe-6f2b-4644-94d5-ca823084d9fc",
                                "sense_id": "1dcb55cf-f9e9-37db-a13a-eb5dca2aab5a",
                                "text": "Het selectieproces voor de Nederlandse afvaardiging is afgelopen zomer tegen het licht gehouden door AVROTROS nadat het duo Mia Nicolai en Dion Cooper in de halve finale was gestrand met hun nummer Burning Daylight, mede geschreven werd door oud-winnaar Duncan Laurence. Dat was sinds 2015 niet meer voorgekomen bij de Nederlandse inzending."
                            }
                        ]
                    }
