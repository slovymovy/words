                                    {
                                        "sense_id": "207459be-dcf5-36ea-854a-db0efd4b0850",
                                        "entry_id": "ac24a981-5046-3dbe-ba47-14d13149ae4a",
                                        "glosses": [
                                            "Relatif à la vannerie et aux vanniers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c17abba-01b7-40a8-8b32-65f68739d5d7",
                                                "sense_id": "207459be-dcf5-36ea-854a-db0efd4b0850",
                                                "text": "Je possède aussi, et suis prêt à vous céder en prime car vous m’avez l’air bonne pâte, ajouta le bateleur passant de la coque à l'âne, une très belle crèche en rotin datant de 1982, pure expression de la tradition vannière quinocéenne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vannier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e591ed8-d613-3420-87ee-c17c6b755aaa",
                                        "entry_id": "86015b04-a15b-3dbf-8cca-ca862e864fc2",
                                        "glosses": [
                                            "Ouvrier qui travaille les fibres d'origine végétales et qui fait des vans, des corbeilles, des paniers, des hottes, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b744201-67a1-41b7-b026-10fa8323e14a",
                                                "sense_id": "6e591ed8-d613-3420-87ee-c17c6b755aaa",
                                                "text": "Il avait fait connaissance, dans un cabaret du faubourg, d’un ouvrier vannier qui travaillait en chambre."
                                            },
                                            {
                                                "example_id": "24737683-7924-4b4f-9df7-ded73ceae424",
                                                "sense_id": "6e591ed8-d613-3420-87ee-c17c6b755aaa",
                                                "text": "Son allure et ses manières n'étaient pourtant pas celles d'une paysanne et encore moins d'une ancienne vannière du village ; pour qui ne la connaissait pas, elle avait tout d'une soixante-huitarde ayant opéré un retour à la campagne."
                                            },
                                            {
                                                "example_id": "fbadefd0-f1ac-4d61-9830-43cc8bc2c181",
                                                "sense_id": "6e591ed8-d613-3420-87ee-c17c6b755aaa",
                                                "text": "La mémoire s’effeuille au vent des derniers froids\nComme un épouvantail avec les bras en croix\nL’oubli courbe sa paille aux doigts bruns des vanniers\nL’oubli courbe sa paille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
