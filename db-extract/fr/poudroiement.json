                    },
                    {
                        "sense_id": "964b0c70-987b-3481-9439-07c405b58c66",
                        "entry_id": "6986c8c0-45b5-37cc-8612-4c99f4d61d23",
                        "glosses": [
                            "Caractère de ce qui est fortement réduit, avec des tons artistiquement atténués."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4331b0aa-4303-4de7-b60d-74d77230dc83",
                                "sense_id": "964b0c70-987b-3481-9439-07c405b58c66",
                                "text": "Car c’est un éblouissement devant la beauté des femmes que cette peinture célébre, avec des poudroiements de pastels."
                            },
                            {
                                "example_id": "41f9e07b-70b3-4596-894c-015dbe7da63d",
                                "sense_id": "964b0c70-987b-3481-9439-07c405b58c66",
                                "text": "Le poudroiement de notre sujet ne fera qu'embellir l'aimable démarche de Madame et de Mademoiselle dans nos dominicales avenues."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ef1e0cf-d9e1-3c9a-aa98-9b226e5291c6",
                        "entry_id": "6986c8c0-45b5-37cc-8612-4c99f4d61d23",
                        "glosses": [
                            "Soulèvement de la poussière rendue visible par les rayons du soleil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3df4075-0da5-4d10-be6c-8e2f56b3ea3f",
                                "sense_id": "3ef1e0cf-d9e1-3c9a-aa98-9b226e5291c6",
                                "text": "Le soleil sous les arbres faisait des ronds, et sur les dunes à sa gauche, il produisait un poudroiement ocre, avec de brusques scintillements comme sur la mer."
                            }
                        ]
                    }
