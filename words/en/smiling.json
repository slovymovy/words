                    "examples": [
                        {
                            "text": "She is <w>smiling</w> at the camera for the photo.",
                            "target_lang_translations": {
                                "ru": "Она <w>улыбается</w> в камеру для фотографии.",
                                "zh": "她正对着镜头<w>微笑</w>拍照。",
                                "nl": "Ze is <w>glimlachend</w> naar de camera aan het kijken voor de foto.",
