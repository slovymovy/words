                "senses": [
                    {
                        "sense_id": "6365b03f-c5d7-3820-a7f2-d637da3d4913",
                        "entry_id": "b44dcf52-b19d-32ff-8b06-e0cc69503109",
                        "glosses": [
                            "een bedrijf dat tegen betaling van een premie een bepaald risico in ziektezaken voor een klant dekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c821f0f-4016-41dd-9468-253c6f58b34c",
                                "sense_id": "6365b03f-c5d7-3820-a7f2-d637da3d4913",
                                "text": "Zorgverzekeraar XYZ biedt u de zorgverzekering die bij u past."
                            },
                            {
                                "example_id": "2bd78dc0-f2bc-48c8-8e9a-3f89dbeab3b0",
                                "sense_id": "6365b03f-c5d7-3820-a7f2-d637da3d4913",
                                "text": "Gelukkig dekte mijn zorgverzekeraar mijn avontuur, maar voor de zekerheid had ik een aanvullende search and rescue-polis afgesloten mocht ik met de helikopter geëvacueerd moeten worden."
                            },
                            {
                                "example_id": "939e7e64-3901-40a8-8d0e-845eb9123536",
                                "sense_id": "6365b03f-c5d7-3820-a7f2-d637da3d4913",
                                "text": "De toekomstplannen van de directie liggen nu ter advies bij vertegenwoordigers van medewerkers en patiënten. Ook gaat de ziekenhuisgroep erover praten met zorgverzekeraars en banken. De raad van toezicht komt naar verwachting in juli met een oordeel. Daarna volgt het definitieve besluit."
                            },
                            {
                                "example_id": "2b4a7294-bcc3-4b51-b21c-449105cec4e4",
                                "sense_id": "6365b03f-c5d7-3820-a7f2-d637da3d4913",
                                "text": "De NZa wil met de gegevens van uiteindelijk 800.000 ggz-patiënten een beter beeld creëren van de zorg die nodig is. Daartoe moeten behandelaars per patiënt een online scorelijst invullen. Ook zorgverzekeraars kunnen van de informatie gebruikmaken bij het inkopen van zorg. Behandelaars die geen of onjuiste gegevens aanleveren, kunnen na een waarschuwing een dwangsom opgelegd krijgen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dfa53d12-9861-48b5-a598-f830c3da54f7",
                        "source_entry_id": "b44dcf52-b19d-32ff-8b06-e0cc69503109",
                        "source_sense_id": "6365b03f-c5d7-3820-a7f2-d637da3d4913",
                        "source_sense_description": "een bedrijf dat tegen betaling van een premie een bepaald risico in ziektezaken voor een klant dekt",
                        "target_lang_word": "Krankenkasse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krankenkasse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7214e526-6155-39f7-b942-aed1bdf5f4d1",
                                        "entry_id": "939d9585-56ff-300f-8c3e-3e3b66286446",
                                        "glosses": [
                                            "Träger der gesetzlichen Krankenversicherung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c46715c-10d3-48af-a975-71e068ace4be",
                                                "sense_id": "7214e526-6155-39f7-b942-aed1bdf5f4d1",
                                                "text": "Ich muss den Antrag noch zur Krankenkasse schicken."
                                            },
                                            {
                                                "example_id": "fb8bf018-a1be-4def-8931-bc314aa8cf4d",
                                                "sense_id": "7214e526-6155-39f7-b942-aed1bdf5f4d1",
                                                "text": "Sie ist Mitglied bei einer Krankenkasse."
                                            },
                                            {
                                                "example_id": "d8cc3b85-d9a0-4673-8c83-a86048d38b8f",
                                                "sense_id": "7214e526-6155-39f7-b942-aed1bdf5f4d1",
                                                "text": "In Deutschland sind die meisten Bürger als Pflichtversicherte Mitglied einer Krankenkasse."
                                            },
                                            {
                                                "example_id": "d47847ca-f4aa-4b45-aca8-8808fbf2b604",
                                                "sense_id": "7214e526-6155-39f7-b942-aed1bdf5f4d1",
                                                "text": "„Es hat nie jemand behauptet, dass Spitzensport auf Kufen den entscheidenden Beitrag zur Entlastung der Krankenkassen leisten kann.“"
                                            },
                                            {
                                                "example_id": "ce4ecd21-1339-4f77-9ab6-66acdb36629a",
                                                "sense_id": "7214e526-6155-39f7-b942-aed1bdf5f4d1",
                                                "text": "„Auch für die Renten- und Krankenkassen sieht die Rechnung makaber günstig aus, denn nichts belastet ein Solidarsystem so stark wie eine hohe Lebenserwartung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9598aa5a-b8db-4b8a-a62a-eb3f52b7cc78",
                        "source_entry_id": "b44dcf52-b19d-32ff-8b06-e0cc69503109",
                        "source_sense_id": "6365b03f-c5d7-3820-a7f2-d637da3d4913",
                        "source_sense_description": "een bedrijf dat tegen betaling van een premie een bepaald risico in ziektezaken voor een klant dekt",
                        "target_lang_word": "Krankenversicherer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krankenversicherer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "153cdcf2-917b-3982-9c64-ed69f2f8c8c1",
                                        "entry_id": "ef17da63-cb8e-3f0b-b6f7-4b4477afddef",
                                        "glosses": [
                                            "Unternehmen oder Institution, die Krankenversicherungen anbietet"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45df514f-879a-40c1-bfb1-e406cf17127f",
                                                "sense_id": "153cdcf2-917b-3982-9c64-ed69f2f8c8c1",
                                                "text": "„Krankenversicherer müssen gemäss KVG nur Leistungen übernehmen, die in der Schweiz erbracht werden, sagte die Rechtsvertreterin der Krankenversicherung.“"
                                            },
                                            {
                                                "example_id": "18bb968a-b9c6-45e2-a522-577e86673202",
                                                "sense_id": "153cdcf2-917b-3982-9c64-ed69f2f8c8c1",
                                                "text": "„Sie war auch einer Steuererhöhung zu Gunsten der Krankenversicherung der Kinder nicht abgeneigt, will aber die Privilegien der privaten Krankenversicherer nicht antasten.“"
                                            },
                                            {
                                                "example_id": "80314e9b-01db-4952-942c-22b606244ecd",
                                                "sense_id": "153cdcf2-917b-3982-9c64-ed69f2f8c8c1",
                                                "text": "„Die Zahl der an Demenz erkrankten Menschen wird bis zum Jahr 2025 im Wetteraukreis um rund 47 Prozent stiegen, das teilt der Krankenversicherer DAK mit, er beruft sich hierbei eine aktuelle Untersuchung des Berlin-Instituts.“"
                                            },
                                            {
                                                "example_id": "f4b78017-9f9c-41d2-9b95-4e3bc27d493d",
                                                "sense_id": "153cdcf2-917b-3982-9c64-ed69f2f8c8c1",
                                                "text": "„Die Debeka ist als Krankenversicherer Bestandteil der kritischen Infrastruktur und überwacht deshalb das Sicherheitsumfeld rund um die Uhr.“"
                                            },
                                            {
                                                "example_id": "5114cac5-b4d5-4ce9-af12-c8ea3f0f2dd9",
                                                "sense_id": "153cdcf2-917b-3982-9c64-ed69f2f8c8c1",
                                                "text": "„Die Aufregung ausgelöst haben die Krankenversicherer, die Ende Juni die kantonalen Verträge mit den Präventionsprogrammen kündigten, auch jene mit «donna».“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
