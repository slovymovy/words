                "senses": [
                    {
                        "sense_id": "1c5c22fc-b9a3-37f6-807c-3d06231eee7e",
                        "entry_id": "5bd1bbc4-c356-32c5-8387-3180f2b9239a",
                        "glosses": [
                            "Familie des Ehegatten oder der Ehegattin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cc41b91-378d-4667-9251-ad2f76ad2057",
                                "sense_id": "1c5c22fc-b9a3-37f6-807c-3d06231eee7e",
                                "text": "„Nach der Skizzierung der Vorstellungen über Paarbeziehungen maghrebinisch-europäischer Paare und der familialen Lebenswelten, stehen nun die Herkunfts- und Schwiegerfamilien zur Diskussion.“"
                            },
                            {
                                "example_id": "5e683d43-adaa-455c-9d9f-cb7261f9cddd",
                                "sense_id": "1c5c22fc-b9a3-37f6-807c-3d06231eee7e",
                                "text": "„Offene oder verdeckte Ablehnung der Schwiegerfamilien wird oft zu einer Quelle ständiger Konflikte oder einer schwer zu überwindenden Distanz der Partner.“"
                            },
                            {
                                "example_id": "7762aa2e-0900-4719-9878-c94f7b01a79a",
                                "sense_id": "1c5c22fc-b9a3-37f6-807c-3d06231eee7e",
                                "text": "„Eine etwas günstigere Situation besteht, wenn die Schwiegerfamilie die Homosexualität der Tochter oder des Sohnes weitgehend ignoriert.“"
                            },
                            {
                                "example_id": "10437452-4fac-411a-940d-bcdb376f81bd",
                                "sense_id": "1c5c22fc-b9a3-37f6-807c-3d06231eee7e",
                                "text": "„Der gesellschaftliche Status ändert sich, vielleicht die Wohnsituation, der Kontostand, der Freundes- und Bekanntenkreis, die Beziehung zur Schwiegerfamilie, die Nachbarschaft.“"
                            },
                            {
                                "example_id": "331155f1-0572-47e1-9df8-6ec7d1c2626f",
                                "sense_id": "1c5c22fc-b9a3-37f6-807c-3d06231eee7e",
                                "text": "„Mit ihrer Heirat tritt eine junge Frau dann in den Verbund der Schwiegerfamilie ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
