                    {
                        "translation_id": "c6af2047-284e-4d5e-9f45-9d0aac9a4127",
                        "source_entry_id": "9e89b11f-ffe2-3b5a-989d-c2f9a78b1799",
                        "source_sense_id": "55e069e1-8c25-32ea-be22-c48d84d62907",
                        "source_sense_description": "Stelle, an der bestimmte Dinge entgegengenommen werden oder abgegeben werden können",
                        "target_lang_word": "consigne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consigne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "226363df-7e87-3baa-89ff-d4fda4e2ba51",
                                        "entry_id": "ca0c042f-2215-3a08-a1c2-16bd54ff6252",
                                        "glosses": [
                                            "Ordre, instruction que l’on donne à une sentinelle, à un soldat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e972f066-8222-4089-9426-3d9a3347dff1",
                                                "sense_id": "226363df-7e87-3baa-89ff-d4fda4e2ba51",
                                                "text": "Les factionnaires se transmettent la consigne."
                                            },
                                            {
                                                "example_id": "38bfa3d3-398e-4044-84c9-b26516d3c1c8",
                                                "sense_id": "226363df-7e87-3baa-89ff-d4fda4e2ba51",
                                                "text": "La consigne est de ne laisser entrer personne."
                                            },
                                            {
                                                "example_id": "4bdc3d69-fd45-4707-bf3f-45dd2b37102c",
                                                "sense_id": "226363df-7e87-3baa-89ff-d4fda4e2ba51",
                                                "text": "Le soldat des guerres de la Liberté attachait une importance presque supersti­tieuse à l’accomplissement des moindres consignes. De là résulte qu’il n'éprouvait aucune pitié pour les généraux ou les fonctionnaires qu’il voyait guillotiner après quelque défaite, sous l’inculpation de manquement à leur devoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "674da1a8-f194-3c89-bbed-225777ca22e8",
                                        "entry_id": "ca0c042f-2215-3a08-a1c2-16bd54ff6252",
                                        "glosses": [
                                            "Ordre, instruction que l’on donne à quelqu'un."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a70cffc1-f3ed-4e48-954b-827d4ee80d5e",
                                                "sense_id": "674da1a8-f194-3c89-bbed-225777ca22e8",
                                                "text": "Coup sur coup, à trois reprises, la vieille madame Rougon se présenta. Elle tempêtait au rez-de-chaussée, il l’entendait qui élevait la voix, s’irritant, voulant forcer la consigne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccf6203f-1345-3b19-a72d-da45ba30eb01",
                                        "entry_id": "ca0c042f-2215-3a08-a1c2-16bd54ff6252",
                                        "glosses": [
                                            "Privation de sortie donnée à des soldats ou à des écoliers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a57e67ac-1eb0-4e10-84f3-24d9a83ce96f",
                                                "sense_id": "ccf6203f-1345-3b19-a72d-da45ba30eb01",
                                                "text": "Donner une consigne."
                                            },
                                            {
                                                "example_id": "d1905b71-f410-432b-8265-de51af672d11",
                                                "sense_id": "ccf6203f-1345-3b19-a72d-da45ba30eb01",
                                                "text": "Lever une consigne."
                                            },
                                            {
                                                "example_id": "36e5cc0b-0b40-4e2c-ba0b-c416448063e5",
                                                "sense_id": "ccf6203f-1345-3b19-a72d-da45ba30eb01",
                                                "text": "C’était la semaine de soixante heures, qui pouvait encore être allongée par la demi-consigne du jeudi ou la consigne entière du dimanche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0f762e9-095c-3d13-97c1-a041b111c2f9",
                                        "entry_id": "ca0c042f-2215-3a08-a1c2-16bd54ff6252",
                                        "glosses": [
                                            "Dépôt pour bagages, dans les gares, les aéroports, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1df0b1bf-c363-47f6-8b65-e255402ec579",
                                                "sense_id": "c0f762e9-095c-3d13-97c1-a041b111c2f9",
                                                "text": "Il me faut repasser par la gare où j’ai laissé mon léger bagage en consigne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f8ab2a1-bdc9-3b5c-8325-0b2bd33807e3",
                                        "entry_id": "ca0c042f-2215-3a08-a1c2-16bd54ff6252",
                                        "glosses": [
                                            "Somme remboursable versée à la personne qui consigne un emballage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64df92c0-f56a-48a0-aa88-f3adfc325b8f",
                                                "sense_id": "7f8ab2a1-bdc9-3b5c-8325-0b2bd33807e3",
                                                "text": "En 2019, les discussions autour de la loi antigaspillage pour une économie circulaire (Agec) ont été l’occasion de reparler de la consigne en France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc8334b5-51c4-3882-81cf-0e98357585ec",
                                        "entry_id": "ca0c042f-2215-3a08-a1c2-16bd54ff6252",
                                        "glosses": [
                                            "Informations ou directives présentées aux différents acteurs d’une opération avant le début de celle-ci."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ba22018-ef5e-47d8-9665-6ea345ac3a0f",
                                                "sense_id": "dc8334b5-51c4-3882-81cf-0e98357585ec",
                                                "text": "Un élève demande des précisions sur les consignes données par le professeur."
                                            },
                                            {
                                                "example_id": "03981940-69fd-4965-b9d7-b4cdef97f823",
                                                "sense_id": "dc8334b5-51c4-3882-81cf-0e98357585ec",
                                                "text": "En fonction des objectifs fixés, le guide propose simplement des référentiels vers lesquels le forestier doit chercher à conduire son peuplement. Pour adapter les consignes à un peuplement précis, le guide propose des outils et des méthodes de diagnostic qui aident le gestionnaire à élaborer les consignes de l’intervention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9112ee8e-a76f-3e04-8a4c-f28e2d1ea0c8",
                                        "entry_id": "ca0c042f-2215-3a08-a1c2-16bd54ff6252",
                                        "glosses": [
                                            "Valeur souhaitée d’un processus contrôlé par une régulation automatique, comme la vitesse d’un mouvement ou la température ambiante."
                                        ],
                                        "tags": [
                                            "Automatique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89b59c7b-cdef-41c8-81ee-abd6857e06f4",
                                                "sense_id": "9112ee8e-a76f-3e04-8a4c-f28e2d1ea0c8",
                                                "text": "Toutefois, les robinets thermostatiques les plus rustiques ne permettent pas de régler une température, la température de consigne restera tributaire de la température de l'eau de chauffage."
                                            }
                                        ]
                                    }
                                ]
                            },
