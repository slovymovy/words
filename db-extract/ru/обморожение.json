                    {
                        "translation_id": "e8e784e8-3db2-4322-bd84-e869b7d71fcf",
                        "source_entry_id": "d22f9a0c-fd49-3e27-9c0a-60524c18c2bb",
                        "source_sense_description": "действие",
                        "target_lang_word": "congélation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "congélation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b70d876f-9c49-30e3-af83-983df658c032",
                                        "entry_id": "a660b510-edde-3c0f-ac7e-2c9e08e45929",
                                        "glosses": [
                                            "Action de congeler ou de se congeler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64e231e8-51e7-4b25-ba07-a2bf3dfbf58d",
                                                "sense_id": "b70d876f-9c49-30e3-af83-983df658c032",
                                                "text": "On sait que la congélation s'opère par la partie supérieure des liquides; puis, si le froid persévère, l'épaisseur de la carapace solide s'accroît en allant de haut en bas. Du moins, il en est ainsi pour les eaux tranquilles."
                                            },
                                            {
                                                "example_id": "7782fe60-3490-42e1-93c0-c9bbfcdf3323",
                                                "sense_id": "b70d876f-9c49-30e3-af83-983df658c032",
                                                "text": "Une conservation prolongée exigera la congélation, qui s'opère à des températures allant jusqu'à - 12 °. C'est une opération qui ne pourra se faire qu'au frigo même."
                                            },
                                            {
                                                "example_id": "bcd4e6ce-bc7f-493e-8e69-f75fa90ab240",
                                                "sense_id": "b70d876f-9c49-30e3-af83-983df658c032",
                                                "text": "Jusqu’ici, une femme ne pouvait avoir recours à la congélation de ses propres ovocytes, sauf nécessité médicale."
                                            },
                                            {
                                                "example_id": "80b30590-9923-41fd-86cd-9b248cd49333",
                                                "sense_id": "b70d876f-9c49-30e3-af83-983df658c032",
                                                "text": "Pour comprendre la portée de cette découverte, cerner les travaux de Greg Fahy, cryobiologiste issu de l'université de Californie, inventeur de la congélation de tissus sans détérioration et plus grand spécialiste mondial de la vitrification, est essentiel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c120b03-d7ea-3211-838a-c59ecb77d484",
                                        "entry_id": "a660b510-edde-3c0f-ac7e-2c9e08e45929",
                                        "glosses": [
                                            "Mortification des parties vivantes par l’effet du froid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "077684db-8258-4969-8689-b2bf416f86da",
                                                "sense_id": "1c120b03-d7ea-3211-838a-c59ecb77d484",
                                                "text": "Plusieurs des hôtes du fort se laissèrent prendre de congélation subite, entre autres Garry, Belcher, Hope; mais, frictionnés à temps, ils échappèrent au danger."
                                            },
                                            {
                                                "example_id": "14485db6-a91b-4f79-98e7-5e2f7997bf88",
                                                "sense_id": "1c120b03-d7ea-3211-838a-c59ecb77d484",
                                                "text": "- Et tout en me faisant ces réflexions qu'entretenait ma congélation croissante, je pensais à un escabeau que j'avais remarqué dans la cheminée de la cuisine, et sur lequel, au moment où j'avais quitté l'auberge, s'épanouissait, à quarante cinq degrés de chaleur, un énorme chat de gouttière dont j'avais admiré l'incombustibilité, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
