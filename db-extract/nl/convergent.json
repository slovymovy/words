                    {
                        "translation_id": "486fa091-beb2-4751-a224-bd0733bf8ecd",
                        "source_entry_id": "52022271-af99-30ae-b633-d4854185ae40",
                        "source_sense_id": "cf73edda-9089-3b98-a5e6-cc2da667c2fc",
