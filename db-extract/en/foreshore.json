    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "644b5889-b7b9-3c0a-8cc9-a7d654fa2401",
                "word": "foreshore",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0b95e8f8-ed0c-4dfc-8365-c43ec389c66d",
                        "entry_id": "644b5889-b7b9-3c0a-8cc9-a7d654fa2401",
                        "tags": [
                            "plural"
                        ],
                        "form": "foreshores"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8a2de180-1ba1-38c3-b32b-d6b5c97de322",
                        "entry_id": "644b5889-b7b9-3c0a-8cc9-a7d654fa2401",
                        "glosses": [
                            "The part of a shore between high water and low water."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b29ff67-aa71-46a5-ba51-5ce8a1d7933c",
                                "sense_id": "8a2de180-1ba1-38c3-b32b-d6b5c97de322",
                                "text": "The line was constructed at a cost of £8,000, and ascended from the foreshore, near the Spa, to the Esplanade in 284 ft. at a gradient of 1 in 1.75."
                            },
                            {
                                "example_id": "521b0b60-dfb1-40b4-ae89-469bcc2d46e8",
                                "sense_id": "8a2de180-1ba1-38c3-b32b-d6b5c97de322",
                                "text": "It was a blessed little realm. I stopped often in the country towns – Donnybrook, Bridgetown, Busselton, Margaret River — to sit with a cup of coffee or browse through stacks of secondhand books or take a walk along a wooden pier or duney foreshore."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce4394dc-45b0-41de-8576-97dd6abf9405",
                        "source_entry_id": "644b5889-b7b9-3c0a-8cc9-a7d654fa2401",
                        "source_sense_id": "8a2de180-1ba1-38c3-b32b-d6b5c97de322",
                        "source_sense_description": "The intertidal zone",
                        "target_lang_word": "estran",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "estran",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56c5a7b0-61d2-3d8f-b820-ef23e42cb0ed",
                                        "entry_id": "823466d7-cb66-37a0-87c9-185353ac4ec8",
                                        "glosses": [
                                            "Bande de terre qui est couverte à marée haute et découverte par la mer à marée basse ; zone de marnage. Il est divisé entre slikke et schorre."
                                        ],
                                        "tags": [
                                            "Hydrobiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e586157-2ed5-4237-b65e-66657d20047b",
                                                "sense_id": "56c5a7b0-61d2-3d8f-b820-ef23e42cb0ed",
                                                "text": "Le bécasseau variable picore son estran au gré des marées, tel un Sisyphe des sables."
                                            },
                                            {
                                                "example_id": "cc357990-5248-4a92-afc6-e8793f5fc2d0",
                                                "sense_id": "56c5a7b0-61d2-3d8f-b820-ef23e42cb0ed",
                                                "text": "Les mangroves sont des écosystèmes forestiers couvrant près des trois quarts des côtes tropicales, où leur capacité à s’adapter leur permet de prospérer dans des estrans soumis aux variations des courants marins, des flux sédimentaires et de la salinité."
                                            },
                                            {
                                                "example_id": "3f9bf488-aeb7-4916-9810-7279ae6e6e6c",
                                                "sense_id": "56c5a7b0-61d2-3d8f-b820-ef23e42cb0ed",
                                                "text": "Mais la mer n’est pas un non-lieu, pas plus qu’elle est un espace indéterminé, une continuité fluide – c’est une chose que tu devrais savoir non ? aurait dit mon père, moqueur ou agacé - : en elle coexistent des zones diverses, de l’estran familier au gouffre de l’inconnu – grève, bande des rouleaux, mer côtière, mer libre et grand large -, en elle cohabitent différents espaces régis par le droit maritime – mer territoriale, zone contiguë, zone économique exclusive, plateaux continentaux, haute mer."
                                            },
                                            {
                                                "example_id": "60a7ef76-4943-42c3-ab21-765e67bb2469",
                                                "sense_id": "56c5a7b0-61d2-3d8f-b820-ef23e42cb0ed",
                                                "text": "Elle regarde les vagues et l’écume molle et irisée qui s’abat sur l’estran."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a97bef1-603a-3a72-9549-ef447873d71c",
                                        "entry_id": "823466d7-cb66-37a0-87c9-185353ac4ec8",
                                        "glosses": [
                                            "Différence entre le plus haut et le plus bas niveau de la mer visible en fonction de la marée en un point précis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c52615e-964f-4f99-9855-d26db6155293",
                                                "sense_id": "5a97bef1-603a-3a72-9549-ef447873d71c",
                                                "text": "Dans l’Aven, l’estran est de six mètres."
                                            },
                                            {
                                                "example_id": "3902c19e-2e9a-49a3-9b11-34c141a3e03b",
                                                "sense_id": "5a97bef1-603a-3a72-9549-ef447873d71c",
                                                "text": "L'immensité de l'estran désert, l'élasticité ferme des sables ourlés d'écume, les cris des mouettes dans le vent, les grosses méduses échouées sur lesquelles nous sautions à pieds joints, tout était nôtre, et la liberté même."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9fb1dc9-56c6-3265-ad3a-d4934f53899c",
                                        "entry_id": "823466d7-cb66-37a0-87c9-185353ac4ec8",
                                        "glosses": [
                                            "Partie de la surface terrestre alternativement immergée ou émergée par suite de la marée astronomique, limitée par les plus grandes hautes mers et les plus grandes basses mers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
