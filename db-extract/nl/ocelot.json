                                    {
                                        "sense_id": "e30e5aaa-9d45-34a8-bc83-e9f98b3b2ebf",
                                        "entry_id": "d36e93cf-1d5d-3c95-9fcc-c4ef8ae07401",
                                        "glosses": [
                                            "in Süd- und Mittelamerika vorkommende Katzenart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cc0b0a2-3543-4789-9d94-4707917565fe",
                                                "sense_id": "e30e5aaa-9d45-34a8-bc83-e9f98b3b2ebf",
                                                "text": "„Das Fell der Ozelots ist mit schwarzen, ring- bis rosettenartigen Flecken bedeckt, die streifenförmig angeordnet sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
