                                    {
                                        "sense_id": "0d32138b-e997-3995-b25c-0111ee4899eb",
                                        "entry_id": "4f3ed385-8cbf-3203-b1fe-b4838cde3759",
                                        "glosses": [
                                            "Someone who brews, or whose occupation is to prepare malt liquors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c72fb72-df0c-4b06-b27f-1d2b034e56fb",
                                                "sense_id": "0d32138b-e997-3995-b25c-0111ee4899eb",
                                                "text": "But through the oligopoly, charcoal fuel proliferated throughout London's trades and industries. By the 1200s, brewers and bakers, tilemakers, glassblowers, pottery producers, and a range of other craftsmen all became hour-to-hour consumers of charcoal."
                                            },
                                            {
                                                "example_id": "6adfa049-c54a-4e95-a81d-68ee710a4071",
                                                "sense_id": "0d32138b-e997-3995-b25c-0111ee4899eb",
                                                "text": "Danish brewer Carlsberg (CABGY)plans to send its CEO, a spokesman confirmed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57300da0-7131-4e86-98b2-afa01170e46e",
                        "source_entry_id": "81e04b80-aea5-3940-b6ab-92af24c3d01c",
                        "source_sense_id": "fcf63c4f-ae7f-3dcd-acc9-4deae991556a",
