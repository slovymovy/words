                ],
                "senses": [
                    {
                        "sense_id": "604a5c48-2134-3832-baaf-6d514586883e",
                        "entry_id": "70d50c43-056c-3cd7-9fc0-92438e275f08",
                        "glosses": [
                            "italienische Halbinsel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b27867f-02f7-492f-add8-4e408f7f27d0",
                                "sense_id": "604a5c48-2134-3832-baaf-6d514586883e",
                                "text": "Die italienische Halbinsel Sorrent liegt in Kampanien. Sorrent gilt als das Eingangstor zur Amalfiküste, auch wenn sie nicht zu dieser gehört."
                            },
                            {
                                "example_id": "e959b200-8230-4825-af4f-7e351108a0fd",
                                "sense_id": "604a5c48-2134-3832-baaf-6d514586883e",
                                "text": "„Sie versprach mir, das Mädchen zu einem Ausflug einzuladen, den wir bald nach Sorrent machen sollten; in der Nacht, die wir in dieser reizenden Gegend würden verbringen müssen, würde ich leicht Fortschritte machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7ca12485-60eb-3fef-9c15-6fbb9ebe1ab1",
                        "entry_id": "70d50c43-056c-3cd7-9fc0-92438e275f08",
                        "glosses": [
                            "Stadt auf der Halbinsel von ^([1])"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "beea010c-7ff0-4c2f-a4b6-62ca90e3d2aa",
                                "sense_id": "7ca12485-60eb-3fef-9c15-6fbb9ebe1ab1",
                                "text": "Sorrent ist seit 2000 Jahren einer der beliebtesten Ferienorte in Süditalien. Ideal für Ausflüge nach Capri, Pompeji, Neapel, Ischia und Amalfi."
                            },
                            {
                                "example_id": "259b701d-9c42-49cc-a474-923ded497f06",
                                "sense_id": "7ca12485-60eb-3fef-9c15-6fbb9ebe1ab1",
                                "text": "„Sie versprach mir, das Mädchen zu einem Ausflug einzuladen, den wir bald nach Sorrent machen sollten; in der Nacht, die wir in dieser reizenden Gegend würden verbringen müssen, würde ich leicht Fortschritte machen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
