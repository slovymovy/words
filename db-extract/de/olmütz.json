                "senses": [
                    {
                        "sense_id": "1a6991ee-1cbd-35d1-a0c5-86c154a3e0c4",
                        "entry_id": "466ba131-b5bd-3f50-9b4f-2488ea28864c",
                        "glosses": [
                            "große Stadt im Osten von Tschechien"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "7d6b7553-9da2-40c5-97c1-660ce3084b17",
                                "sense_id": "1a6991ee-1cbd-35d1-a0c5-86c154a3e0c4",
                                "text": "Die Stadt Olmütz war bis ins 17. Jahrhundert das historische Zentrum Mährens und ist heute ein Handels-, Kultur- und Verwaltungszentrum."
                            },
                            {
                                "example_id": "623a0a6f-8f69-4805-ba0a-4226c157fe14",
                                "sense_id": "1a6991ee-1cbd-35d1-a0c5-86c154a3e0c4",
                                "text": "„Rostow konnte das Geld gerade jetzt besonders gut brauchen, wo die Truppen nach Beendigung des Feldzuges bei Olmütz in Ruhe lagen und wohlversehene Marketender und österreichische Juden, die allerhand verführerische Dinge anboten, das Lager erfüllten.“"
                            },
                            {
                                "example_id": "0995f4f9-2bd3-4dcb-8412-c882ab8beeca",
                                "sense_id": "1a6991ee-1cbd-35d1-a0c5-86c154a3e0c4",
                                "text": "„Er schreibt für Zeitungen in Pressburg und Olmütz, wird Sekretär der Liga für Menschenrechte in Brünn, findet seine erste große Liebe, wird ohne Mühe wegen seines eher zufälligen Geburtsorts Deutsch-Diosek bei Pressburg tschechoslowakischer Staatsbürger, holt seine Eltern und vier Geschwister zu sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
