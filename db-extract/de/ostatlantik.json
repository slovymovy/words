                "senses": [
                    {
                        "sense_id": "b5682079-0b96-31f0-b5ff-c33541b829c4",
                        "entry_id": "1a6cbd48-c445-3c58-9e36-e44a3e53bcce",
                        "glosses": [
                            "der auf der östlichen Erdhalbkugel liegende Teil des Atlantiks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd93cf6d-72eb-4b96-bf48-920c9c0a4cfa",
                                "sense_id": "b5682079-0b96-31f0-b5ff-c33541b829c4",
                                "text": "„Der U-Boot-Krieg im Ostatlantik führt zu einer totalen Isolation der Kanarischen Inseln von der Außenwelt.“"
                            },
                            {
                                "example_id": "53013774-a4ea-40d1-94de-2c04f2c8f01a",
                                "sense_id": "b5682079-0b96-31f0-b5ff-c33541b829c4",
                                "text": "„Wenn ein Hoch über dem Ostatlantik und ein Tief über Norditalien aufeinandertrafen, entstand der Mistral und drängte als Fallwind aus dem Norden in das Rhonetal hinein und an der Küste wieder hinaus.“"
                            },
                            {
                                "example_id": "6e03dfe5-3c09-4984-b506-d61e6d4061d4",
                                "sense_id": "b5682079-0b96-31f0-b5ff-c33541b829c4",
                                "text": "„Noronha kannte den Ostatlantik bereits, da er über São Tomé und Elmina mit Sklaven handelte.“"
                            },
                            {
                                "example_id": "cf182387-69a4-479e-89a5-498c09e6fb22",
                                "sense_id": "b5682079-0b96-31f0-b5ff-c33541b829c4",
                                "text": "„Die Barbaresken-Korsaren kaperten regelmäßig englische Schiffe im Mittelmeer und Ostatlantik (die meist nach Amerika unterwegs waren oder von dort kamen) und versklavten die Besatzung.“"
                            },
                            {
                                "example_id": "f2115518-18f8-4e68-821b-d4cf427047b4",
                                "sense_id": "b5682079-0b96-31f0-b5ff-c33541b829c4",
                                "text": "„Die Tropikluft stammt entweder aus dem südlichen Ostatlantik (Azorenraum) oder aus dem Mittelmeergebiet.“"
                            },
                            {
                                "example_id": "e0ea04e1-cbf5-47b6-b76b-59b1ac5f55b2",
                                "sense_id": "b5682079-0b96-31f0-b5ff-c33541b829c4",
                                "text": "„Sie gehört zu den wärmeliebenden Arten des mediterranen Faunenkreises und kommt im Mittelmeer, im Schwarzen Meer, bei den Kanarischen Inseln und im Ostatlantik bis zum Senegal vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
