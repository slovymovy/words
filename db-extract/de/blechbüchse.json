                    },
                    {
                        "form_id": "e8cda3b1-a63f-41b8-9e82-aa998f6dc311",
                        "entry_id": "01b03b16-8967-306c-a8a6-e774dbdb689a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Blechbüchsen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3fc2c87c-6e6d-36ca-a3ef-36664956ac6d",
                        "entry_id": "01b03b16-8967-306c-a8a6-e774dbdb689a",
                        "glosses": [
                            "Büchse aus Blech"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "102bfc96-39f2-4ee7-a1a7-15163888cfb9",
                                "sense_id": "3fc2c87c-6e6d-36ca-a3ef-36664956ac6d",
                                "text": "„Ich stand auf und schob mich auf den Raum zu, aber kurz vor der Tür stieß ich mit dem Fuß an eine leere Blechbüchse, und das hatte ein kurzes huschendes Geräusch im nächsten Zimmer zur Folge.“"
                            },
                            {
                                "example_id": "190615fe-7e20-4a19-bf72-db5c90528529",
                                "sense_id": "3fc2c87c-6e6d-36ca-a3ef-36664956ac6d",
                                "text": "„Unterdessen nahm Pécuchet, den das Mißgeschick mit dem Malaga wurmte, die Blechbüchsen aus dem Schrank, öffnete den Deckel der ersten, dann der zweiten, der dritten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "509ab67c-b0a2-4aee-92b2-ff20f9b828c5",
                        "source_entry_id": "01b03b16-8967-306c-a8a6-e774dbdb689a",
                        "source_sense_id": "3fc2c87c-6e6d-36ca-a3ef-36664956ac6d",
                        "source_sense_description": "Büchse aus Blech",
                        "target_lang_word": "жестянка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "жестянка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0202f8db-0b20-3871-9a57-a2588b55478c",
                                        "entry_id": "e5870f33-7bd2-3556-87c6-bb98354f32fe",
                                        "glosses": [
                                            "разг. жестяная коробка, банка, вообще предмет обихода из жести"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09491bce-26c6-4cb2-a5d3-bbd9320121b3",
                                                "sense_id": "0202f8db-0b20-3871-9a57-a2588b55478c",
                                                "text": "Офицер скомандовал «feu!», и два свистящие звука жестянок раздались один за другим."
                                            },
                                            {
                                                "example_id": "f380e247-85b4-48a5-b8e2-26a7b460bbb9",
                                                "sense_id": "0202f8db-0b20-3871-9a57-a2588b55478c",
                                                "text": "Она разложила возле себя спички, жестянку с махоркой, курила и глядела на Парашку, возившуюся в пыли возле неё."
                                            },
                                            {
                                                "example_id": "acfbabf2-08ee-461f-b6c0-7a407322abbd",
                                                "sense_id": "0202f8db-0b20-3871-9a57-a2588b55478c",
                                                "text": "Она стала открывать жестянку немецким тесаком."
                                            },
                                            {
                                                "example_id": "c2c42fdf-fb31-4ade-b7f2-3f9c54851494",
                                                "sense_id": "0202f8db-0b20-3871-9a57-a2588b55478c",
                                                "text": "Если можно назвать бомбой бутылку керосина, обмотанную тряпкой, гранатой ― жестянку с гайками или болтами или просто отрезок трубы, набитый динамитом, то такие бомбы и гранаты они могли изготовлять, даже не пользуясь учебником химии или энциклопедией Брокгауза и Ефрона."
                                            },
                                            {
                                                "example_id": "c7f71d88-0c89-4a2e-8045-04059c237640",
                                                "sense_id": "0202f8db-0b20-3871-9a57-a2588b55478c",
                                                "text": "Ведь могила-то когда хошь приют даст, жить бы надо, да что-то как жестянка ломается жизнь моя, и не моя одна."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76c062bf-e5ca-3482-b3ff-b62aced89d9f",
                                        "entry_id": "e5870f33-7bd2-3556-87c6-bb98354f32fe",
                                        "glosses": [
                                            "разг. кусочек, пластинка жести"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea1efdff-cc17-499a-9569-654210b16bd8",
                                                "sense_id": "76c062bf-e5ca-3482-b3ff-b62aced89d9f",
                                                "text": "Наворотная жестянка гласила, что дом сей принадлежит отставному майору Петру Петровичу Лубянскому."
                                            },
                                            {
                                                "example_id": "6970fc50-2d04-48ba-a659-71942996c73a",
                                                "sense_id": "76c062bf-e5ca-3482-b3ff-b62aced89d9f",
                                                "text": "Блестят на асфальте жестянки, бутылки, всё засыпано рваными, скомканными талонами, целлофаном сигаретных пачек."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1711285-e911-32aa-b58b-7d212153f8c3",
                                        "entry_id": "e5870f33-7bd2-3556-87c6-bb98354f32fe",
                                        "glosses": [
                                            "прост., пренебр. о легковом автомобиле (обычно старом, изношенном), его корпусе"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6380df7f-1981-3894-af66-0117ad9ca917",
                                        "entry_id": "e5870f33-7bd2-3556-87c6-bb98354f32fe",
                                        "glosses": [
                                            "жарг. безрадостная жизнь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0ee6f5f-5005-4b4e-91b2-6891b3cddeee",
                                                "sense_id": "6380df7f-1981-3894-af66-0117ad9ca917",
                                                "text": "Не жизнь, а жестянка ― никак не могу устроиться!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
