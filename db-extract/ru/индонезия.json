                        "translation_id": "45f21937-8d96-469b-bdbd-1e77bbe6443f",
                        "source_entry_id": "becb1094-e708-32d8-91c2-0a2ffdbf95e6",
                        "source_sense_id": "46faaf84-5a7f-30c7-b068-745bd03a656c",
                        "target_lang_word": "Indonesia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Indonesia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d411a658-7a50-32e5-a247-604ff007eda9",
                                        "entry_id": "16c40d3c-a29f-3823-a1c5-aebc2b226446",
                                        "glosses": [
                                            "A country and archipelago in maritime Southeast Asia. Official name: Republic of Indonesia (since 1950). Capital: Jakarta."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe504030-bc7b-45ae-9083-8143d5a81cd0",
                                                "sense_id": "d411a658-7a50-32e5-a247-604ff007eda9",
                                                "text": "Nearly 80% of people in Indonesia are connected to the internet and people aged 16 to 64 spend an average of more than three hours a day on social media, according to the We Are Social 2023 Digital Report, which provides global social media insights."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07bc0390-5ee1-436b-8851-760162b69d46",
                        "source_entry_id": "becb1094-e708-32d8-91c2-0a2ffdbf95e6",
                        "source_sense_id": "46faaf84-5a7f-30c7-b068-745bd03a656c",
                        "target_lang_word": "Indonesien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Indonesien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30699ca4-b66a-398d-89cb-50fe92ec010a",
                                        "entry_id": "f06cf3c6-3924-330b-a729-6276f6498861",
                                        "glosses": [
                                            "ein Staat in Südostasien, der Inseln des Malaiischen Archipels und Westneuguinea (geografisch dem australischen Kontinent zugehörig) umfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a73b70a-96a2-4bab-8b2e-3bfeab9f455d",
                                                "sense_id": "30699ca4-b66a-398d-89cb-50fe92ec010a",
                                                "text": "Wir fahren nach Indonesien."
                                            },
                                            {
                                                "example_id": "dfa12916-59b6-4889-a602-7956d025e885",
                                                "sense_id": "30699ca4-b66a-398d-89cb-50fe92ec010a",
                                                "text": "In Indonesien gilt Reis neben Maniok und Mais als Grundnahrungsmittel."
                                            },
                                            {
                                                "example_id": "9c9afb70-7a60-4be6-9c67-26510d31e37f",
                                                "sense_id": "30699ca4-b66a-398d-89cb-50fe92ec010a",
                                                "text": "Jakarta ist die Hauptstadt von Indonesien."
                                            },
                                            {
                                                "example_id": "1445ba2b-7a1d-4c95-b1dc-37d248d923e6",
                                                "sense_id": "30699ca4-b66a-398d-89cb-50fe92ec010a",
                                                "text": "„Die niederländische Staatsbürgerschaft bekamen sie nicht, denn auch die früheren Kolonisten gingen davon aus, dass die Molukker nach Indonesien zurückkehren würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
