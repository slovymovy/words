                {
                    "sense_id": "0d3ac779-b2a0-361c-a696-610f6bddae7d",
                    "sense_definition": "À ce moment-là, en ce temps-là.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'étais encore étudiant <w>alors</w>, et je n'avais pas beaucoup d'argent.",
                            "target_lang_translations": {
                                "en": "I was still a student <w>then</w>, and I didn't have much money.",
                                "ru": "<w>Тогда</w> я ещё был студентом, и денег у меня было немного.",
                                "nl": "Ik was <w>toen</w> nog student, en ik had niet veel geld.",
                                "de": "Ich war <w>damals</w> noch Student, und Geld hatte ich nicht viel.",
                                "pl": "Byłem <w>wtedy</w> jeszcze studentem i nie miałem zbyt dużo pieniędzy.",
                                "it": "Ero ancora studente <w>allora</w>, e non avevo molti soldi.",
                                "cs": "<w>Tehdy</w> jsem byl ještě student a peněz jsem neměl moc.",
                                "tr": "<w>O zamanlar</w> hâlâ öğrenciydim, pek param da yoktu.",
                                "es": "Todavía era estudiante <w>por aquel entonces</w>, y no tenía mucho dinero.",
                                "zh": "<w>那时</w>我还是学生，手头也没有多少钱。"
                            }
                        },
                        {
                            "text": "La vie dans ce petit village était <w>alors</w> bien différente d'aujourd'hui.",
                            "target_lang_translations": {
                                "en": "Life in that small village was <w>then</w> very different from today.",
                                "ru": "Жизнь в этой небольшой деревне <w>тогда</w> была совсем не такой, как сегодня.",
                                "nl": "Het leven in dat kleine dorp was <w>toen</w> heel anders dan vandaag.",
                                "de": "Das Leben in diesem kleinen Dorf war <w>damals</w> ganz anders als heute.",
                                "pl": "Życie w tej małej wiosce było <w>wtedy</w> zupełnie inne niż dzisiaj.",
                                "it": "La vita in quel piccolo villaggio era <w>all'epoca</w> molto diversa da oggi.",
                                "cs": "Život v té malé vesnici byl <w>tehdy</w> docela jiný než dnes.",
                                "tr": "Bu küçük köydeki hayat <w>o dönemde</w> bugünkünden çok farklıydı.",
                                "es": "<w>En aquella época</w>, la vida en aquel pequeño pueblo era muy distinta de la de hoy.",
                                "zh": "<w>当时</w>这个小村子的生活和现在很不一样。"
                            }
