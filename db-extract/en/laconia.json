                                            {
                                                "example_id": "9c59ddf2-7bbd-49c5-bcea-66d215ed7a33",
                                                "sense_id": "5398e5bd-e7bc-3371-9076-e3edde65ff0f",
                                                "text": "„Sparta und Messene waren keine friedlichen Nachbarn – sie waren Feinde, sie bekriegten sich bis aufs Blut. Doch das ist vorbei. Heute ruhen Messenien und Lakonien vereint unter der milden Herrschaft des Olivenbaums.“"
                                            },
                                            {
                                                "example_id": "91b40319-485a-43b6-929c-4f500801405b",
                                                "sense_id": "5398e5bd-e7bc-3371-9076-e3edde65ff0f",
                                                "text": "„Zur Sicherung der Herrschaft über Lakonien wurde jeder Spartiat benötigt: Dafür waren die Spartiaten von jeglicher Arbeit befreit, dies um den Preis der konsequenten Militarisierung ihres ganzen Lebens.“"
                                            }
                                        ],
