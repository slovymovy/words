                                        "entry_id": "14cff146-8da2-3250-b0c8-dabd84a2647c",
                                        "glosses": [
                                            "een medisch instrument waarmee men geluiden in het lichaam zoals hartslag en ademhaling kan beluisteren (ausculteren)"
                                        ],
                                        "tags": [],
