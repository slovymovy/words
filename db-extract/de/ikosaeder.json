                                    },
                                    {
                                        "sense_id": "7a988689-b60c-3ba4-96f9-7e3d1b5a490f",
                                        "entry_id": "a43afa09-fb1c-3650-bc81-6f515d6662fc",
                                        "glosses": [
                                            "A regular icosahedron: one of the Platonic solids, all of whose faces are regular (equilateral) triangles"
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
