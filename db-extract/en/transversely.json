                        "source_sense_description": "In a transverse manner",
                        "target_lang_word": "kruiselings",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kruiselings",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7d608cfb-bdb0-3e97-a99e-949436bccace",
                                        "entry_id": "6ac6ca77-e9ee-35d4-86b8-6c9f2716d2bf",
                                        "glosses": [
                                            "twee lijnen die elkaar kruisen in de vorm van een kruis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1992d221-d299-46f0-a7a5-c8284c43b535",
                                                "sense_id": "7d608cfb-bdb0-3e97-a99e-949436bccace",
                                                "text": "Een pictogram met kruiselings een mes en een vork is het teken voor een restaurant."
                                            },
                                            {
                                                "example_id": "2063bbb3-7cf5-4878-bae8-ca55d0254bed",
                                                "sense_id": "7d608cfb-bdb0-3e97-a99e-949436bccace",
                                                "text": "Bestrooi de zalmfilet rondom licht met zout en peper. Snijd de zalm in stukken van circa 2,5 x 5 cm. Rol ze of pak ze in met plakjes ontbijtspek en steek in elk spek-zalmpakketje kruiselings 2 satéprikkers. Leg de zalmspiesen tot gebruik afgedekt in de koelkast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95965b27-a9fc-34c3-8624-95f1838c3a22",
                                        "entry_id": "6ac6ca77-e9ee-35d4-86b8-6c9f2716d2bf",
                                        "glosses": [
                                            "over en weer, bij elkaar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d37d4ab0-aa58-4fa3-a9d4-ee4518ce06cc",
                                                "sense_id": "95965b27-a9fc-34c3-8624-95f1838c3a22",
                                                "text": "Maandag was de Duitse Milieuminister Barbara Hendricks nog in ons land. Zij kwam met minister van Binnenlandse Zaken Jan Jambon en energieminister Marie-Christine Marghem overeen dat België en Duitsland kruiselingse inspecties gaan organiseren van elkaars kerncentrales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6fe01285-feec-4264-a0b9-bce668e52ea3",
                        "source_entry_id": "9c7b32e2-9260-3c36-9825-e171e977bace",
                        "source_sense_id": "754b7a9d-5622-37b6-b626-815ba07da3b6",
                        "source_sense_description": "In a transverse manner",
                        "target_lang_word": "dwars",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dwars",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ca554b1a-688c-383e-a004-4bb904c14b31",
                                        "entry_id": "9367dc4b-ec6c-3c27-af97-6c8a380629dc",
                                        "glosses": [
                                            "in de breedterichting"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53118c56-dacb-471d-a337-f71e3fa928ae",
                                                "sense_id": "ca554b1a-688c-383e-a004-4bb904c14b31",
                                                "text": "Schouderbinnenwaarts is dus eigenlijk iets dwarser dan schoudervoor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec55ec93-b20e-381d-851b-0f9ec724dee5",
                                        "entry_id": "9367dc4b-ec6c-3c27-af97-6c8a380629dc",
                                        "glosses": [
                                            "geneigd medewerking te weigeren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53d48daa-7067-4568-be1f-911856429026",
                                                "sense_id": "ec55ec93-b20e-381d-851b-0f9ec724dee5",
                                                "text": "In maanden die volgden werd Daantje steeds dwarser en dwarser."
                                            },
                                            {
                                                "example_id": "1130d3cb-c25f-46c6-a053-7242905bec36",
                                                "sense_id": "ec55ec93-b20e-381d-851b-0f9ec724dee5",
                                                "text": "Ze legde uit dat ze een gedachbij de gevangene had geplant dat nog kon groeien als ze hem niet te hard aanpakten, daar zou hij alleen nog maar dwarser van worden en zijn adrenaline zou erdoor toenemen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3926b08c-003f-338a-949b-28e6c4157d4f",
                                        "entry_id": "9367dc4b-ec6c-3c27-af97-6c8a380629dc",
                                        "glosses": [
                                            "ergens helemaal doorheen dus ook door het midden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cecba0e7-90ec-4911-83dc-f815ea1b804d",
                                                "sense_id": "3926b08c-003f-338a-949b-28e6c4157d4f",
                                                "text": "We lopen al lang niet meer over een pad, maar dwars over een akker heen, de ruïne steeds verder achter ons latend."
                                            },
                                            {
                                                "example_id": "4ff95d62-9743-4287-8e6c-7c3cdd57e060",
                                                "sense_id": "3926b08c-003f-338a-949b-28e6c4157d4f",
                                                "text": "Waarom ging ik zes maanden op de Pacific Crest Trail (PCT) dwars door Amerika lopen?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dwars",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "792eabdf-4f44-356e-8f2f-f9310282d31b",
                                        "entry_id": "d2765d8d-77f2-385f-a534-d9fd89dfd004",
                                        "glosses": [
                                            "in de breedterichting"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39b4490d-12f3-43c2-b43e-925044f639b3",
                                                "sense_id": "792eabdf-4f44-356e-8f2f-f9310282d31b",
                                                "text": "Dwars door de sloot lag een omgevallen knotwilg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6beb5bff-914f-309f-8f17-464a0fa60377",
                                        "entry_id": "d2765d8d-77f2-385f-a534-d9fd89dfd004",
                                        "glosses": [
                                            "~ liggen: niet meewerken, tegenstand bieden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fdd7a5b-d3fe-4b6a-8d3a-3448c089195a",
                                                "sense_id": "6beb5bff-914f-309f-8f17-464a0fa60377",
                                                "text": "Het voorstel kreeg veel bijval, maar er lagen twee landen dwars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edba0d61-6b23-3546-82e8-7be01924bf2b",
                                        "entry_id": "d2765d8d-77f2-385f-a534-d9fd89dfd004",
                                        "glosses": [
                                            "iemand iets ~ zitten: een wrok koesteren over iets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1c2f55b-705c-4fad-b849-46ecdb6ec7b3",
                                                "sense_id": "edba0d61-6b23-3546-82e8-7be01924bf2b",
                                                "text": "Het zat hem dwars dat hij daarvan valselijk beschuldigd werd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
