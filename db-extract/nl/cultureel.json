                                "sense_id": "51789864-164a-3559-8d3c-e11c3335611b",
                                "text": "De culturele verschillen tussen landen kunnen significant zijn.",
                                "translation": "The cultural differences between countries can be significant.",
                                "english": "The cultural differences between countries can be significant."
                            },
                            {
                                "example_id": "c6fc1d0a-5b63-43ba-8315-67b71ebf7492",
                                "sense_id": "51789864-164a-3559-8d3c-e11c3335611b",
                                "text": "Ze nam deel aan een cultureel uitwisselingsprogramma.",
                                "translation": "She participated in a cultural exchange program.",
                                "english": "She participated in a cultural exchange program."
                            },
                            {
                                "example_id": "9257d449-bbc0-4a45-aa83-a3b405fc4c6d",
                                "sense_id": "51789864-164a-3559-8d3c-e11c3335611b",
                                "text": "Het museum organiseert verschillende culturele activiteiten.",
                                "translation": "The museum organizes various cultural activities.",
