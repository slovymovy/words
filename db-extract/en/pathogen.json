                                        "examples": [
                                            {
                                                "example_id": "6b2d1c02-db35-40d4-ba3d-22897ef7d175",
                                                "sense_id": "16b14d7a-46b0-3f89-b6f5-e8107a4a1603",
                                                "text": "Sommige virussen, bacteriën, schimmels en eencelligen zoals de malariaparasiet zijn pathogenen."
