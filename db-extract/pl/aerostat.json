                                "target_senses": [
                                    {
                                        "sense_id": "d17b5c64-258f-3470-b38a-13219fa06fd3",
                                        "entry_id": "1283d941-f933-30aa-9fab-de08ccd17f88",
                                        "glosses": [
                                            "An aircraft, such as a dirigible or balloon, that derives its lift from buoyancy rather than from wings or rotors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43a0cfd5-e8f0-41d1-b180-e9c8faa433f9",
                                                "sense_id": "d17b5c64-258f-3470-b38a-13219fa06fd3",
                                                "text": "With its molten temperatures, sulphuric acid clouds, and crushing carbon dioxide atmosphere, Venus has only a handful of aerostat research outposts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70138256-d71a-3622-ad5c-204d179c17db",
                                        "entry_id": "1283d941-f933-30aa-9fab-de08ccd17f88",
                                        "glosses": [
                                            "A moored balloon flown in a semi-permanent manner, such as a border patrol monitoring balloon affixed at 18,000 feet (~6 km)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f8922cb-6bdd-41c7-8ae3-537dd5b2968d",
                        "source_entry_id": "88afffb8-886b-3c00-b5fa-9f9b806da419",
                        "source_sense_id": "d459b882-71bb-32b0-a7a6-c6c394013ded",
                        "target_lang_word": "aérostat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aérostat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9b1129d-d722-314d-af1c-e3f64b8f411f",
                                        "entry_id": "19389801-70e8-33ff-998d-0bc4aefb229f",
                                        "glosses": [
                                            "Aéronef qui se maintient en altitude grâce à de l’air chaud ou d’autres gaz plus légers que l’air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd9e590b-c6a1-4716-ab33-8eaf85b846aa",
                                                "sense_id": "c9b1129d-d722-314d-af1c-e3f64b8f411f",
                                                "text": "L’aérostat demeurait presque immobile, à l’abri des vents de l’est."
                                            },
                                            {
                                                "example_id": "1b4d4cbc-dbf0-4747-a626-0df9af56b15c",
                                                "sense_id": "c9b1129d-d722-314d-af1c-e3f64b8f411f",
                                                "text": "À la manière des aérostats soulagés d’une partie de leur poids par un contact quelconque, le ballon avait bondi avec une sorte d’impertinence, […]."
                                            },
                                            {
                                                "example_id": "526882cf-e425-4d05-ae54-626061f1675a",
                                                "sense_id": "c9b1129d-d722-314d-af1c-e3f64b8f411f",
                                                "text": "L’aire sémantique de aéronef avec cette signification y est délimitée par rapport à aérostat désignant un ballon non dirigeable et aéronat réservé au ballon dirigeable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d22d0d2-ac12-4f87-9ebf-5b64215e5712",
                        "source_entry_id": "88afffb8-886b-3c00-b5fa-9f9b806da419",
