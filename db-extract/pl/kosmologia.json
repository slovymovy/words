                    {
                        "sense_id": "f83a0370-1282-3e2b-a9d6-248f0118709d",
                        "entry_id": "b8b82b9b-6cd6-34a5-94e6-63645b7f9440",
                        "glosses": [
                            "dział astronomii, który zajmuje się kosmosem; nauka o wszechświecie"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f18bed09-77fc-3887-8958-fb66365b09dd",
                        "entry_id": "b8b82b9b-6cd6-34a5-94e6-63645b7f9440",
