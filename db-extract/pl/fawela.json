                "senses": [
                    {
                        "sense_id": "97457ac7-60e2-3280-bcbf-d30512ac65ed",
                        "entry_id": "073e0e49-aa70-3bde-9d91-db17ff384b44",
                        "glosses": [
                            "rozległa dzielnica nędzy powstała wokół miast Brazylii, brazylijski slums"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd7b6d33-6a4b-4d67-b185-198316cbf501",
                                "sense_id": "97457ac7-60e2-3280-bcbf-d30512ac65ed",
                                "text": "UPP zakładają posterunki, których wcześniej nie było, bo w faweli rządził gang. Fawela zamienia się, przynajmniej teoretycznie, w „normalną” dzielnicę"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4253d75f-e526-4d85-87bc-5f482c2fb460",
                        "source_entry_id": "073e0e49-aa70-3bde-9d91-db17ff384b44",
                        "source_sense_id": "97457ac7-60e2-3280-bcbf-d30512ac65ed",
                        "target_lang_word": "favela",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "favela",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1250a207-8160-3453-b957-5875d4afc6fb",
                                        "entry_id": "ec52a3d1-9219-3541-8931-4a7714a48758",
                                        "glosses": [
                                            "A slum or shantytown, especially in Brazil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d51b2f2e-70f1-4f6d-a0a1-2ebee462d538",
                                                "sense_id": "1250a207-8160-3453-b957-5875d4afc6fb",
                                                "text": "The favela is now the model for most of the world's cities, as vast numbers of people continue to migrate to them in order to survive."
                                            },
                                            {
                                                "example_id": "4f7b089d-5edb-4856-a5bd-4025dadeb14a",
                                                "sense_id": "1250a207-8160-3453-b957-5875d4afc6fb",
                                                "text": "security forces in November of 2010 stormed one of the city's most notorious favelas, the complex of the Morro do Alemão in the northern zone of the city"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa3b36a8-77af-4075-8cf4-f81ad7a1a55e",
                        "source_entry_id": "073e0e49-aa70-3bde-9d91-db17ff384b44",
                        "source_sense_id": "97457ac7-60e2-3280-bcbf-d30512ac65ed",
                        "target_lang_word": "favela",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "favela",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa8638dd-33ee-3e61-8c36-98ecb4919d1a",
                                        "entry_id": "2dcab1fc-84ce-30de-b762-1090697e7b0b",
                                        "glosses": [
                                            "Bidonville brésilien."
                                        ],
                                        "tags": [
                                            "Urbanisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25645734-144b-41e0-82a8-e36625b6cb42",
                                                "sense_id": "aa8638dd-33ee-3e61-8c36-98ecb4919d1a",
                                                "text": "Dans la perspective des Jeux olympiques, Rio de Janeiro « pacifie » ses favelas, un euphémisme qui masque la nature ambiguë d’une politique conduite à la pointe du fusil."
                                            },
                                            {
                                                "example_id": "920db013-2266-4662-af57-a7e664e34b27",
                                                "sense_id": "aa8638dd-33ee-3e61-8c36-98ecb4919d1a",
                                                "text": "Le Brésil, où la violence et la corruption règnent en maîtres, réussira-t-il à se distinguer autrement que par le futebol et ses favelas?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce0ff41e-52bb-4bf7-9f81-c82906e6d7a0",
                        "source_entry_id": "073e0e49-aa70-3bde-9d91-db17ff384b44",
                        "source_sense_id": "97457ac7-60e2-3280-bcbf-d30512ac65ed",
                        "target_lang_word": "favéla",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "favéla",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3977ab34-91ef-3ce2-8fe7-d0bc8f7461ac",
                                        "entry_id": "2c7caaf5-41fb-35ae-bce5-c41f9725940f",
                                        "glosses": [
                                            "Variante orthographique de favela."
                                        ],
                                        "tags": [
                                            "orthographe traditionnelle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16cd90c2-0ae7-4900-b1bc-9401c2da23d9",
                                                "sense_id": "3977ab34-91ef-3ce2-8fe7-d0bc8f7461ac",
                                                "text": "Maria Alveira, plutôt anémique malgré un certain embonpoint, n’osait jamais intervenir en faveur de son ainé de peur qu’un reproche malencontreux n’indispose son « protecteur », ce dont toute femme seule avait besoin dans une favéla."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa5c5c2f-662d-4a5e-a9f5-62a8d9255300",
                        "source_entry_id": "073e0e49-aa70-3bde-9d91-db17ff384b44",
                        "source_sense_id": "97457ac7-60e2-3280-bcbf-d30512ac65ed",
                        "target_lang_word": "фавела",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "фавела",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d7b46adc-8bb6-3c8a-8adc-1bb9bf98975d",
                                        "entry_id": "01da0be7-18d6-3100-a670-be663cb00985",
                                        "glosses": [
                                            "бедняцкий район на окраине крупного города Бразилии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b1586ef-5866-4034-ac2a-09193e51b138",
                                                "sense_id": "d7b46adc-8bb6-3c8a-8adc-1bb9bf98975d",
                                                "text": "В одной из фавел (бедняцких окраинных районов) Рио-де-Жанейро он обнаружил сиротский приют, в котором дети буквально погибали от голода, и решил добыть для них денег любым путём."
                                            },
                                            {
                                                "example_id": "e9d6766e-3fc7-4f5f-8616-2807ce508999",
                                                "sense_id": "d7b46adc-8bb6-3c8a-8adc-1bb9bf98975d",
                                                "text": "Наконец, журналист и архитектурный обозреватель Джастин МакГирк (Великобритания) устраивает нам экскурсию «по окраинам Сан-Паулу» ― гигантского бразильского мегаполиса, периферия которого куда больше ― и разнообразнее ― центра. Он показывает «город на грани» ― в его маргинальных, черновых формах: дешёвое муниципальное жильё, трущобы, фавелы…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
