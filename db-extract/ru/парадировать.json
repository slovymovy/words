                        "tags": [],
                        "examples": [
                            {
                                "example_id": "227c8ad5-f75c-4a89-b3db-36b9c7f7fa1c",
                                "sense_id": "8d1ffc07-a594-3a05-8623-4076d9ccafb7",
                                "text": "Выехал на ней на смотр, а она вдруг перед самим командующим войсками начала испанским шагом парадировать."
                            },
                            {
                                "example_id": "6db1a69b-ecb7-46cd-9c77-b38b2c975f2a",
                                "sense_id": "8d1ffc07-a594-3a05-8623-4076d9ccafb7",
                                "text": "Приняв рапорт, я, к удивлению великого князя, обошёл фронт, а затем парадировал на правом фланге — чтобы показать, что я не только номинальный начальник."
                            }
                        ]
                    },
