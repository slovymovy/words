    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "27268fec-1285-391e-9ec2-38347cfdebac",
                "word": "Armageddon",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "50b4ce1a-19b7-384c-9dab-c2039cd8a007",
                        "entry_id": "27268fec-1285-391e-9ec2-38347cfdebac",
                        "glosses": [
                            "Mount Megiddo, the site of a prophesied final battle between the forces of good and evil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e11fbf58-2c6f-4a37-8ba3-737387280521",
                                "sense_id": "50b4ce1a-19b7-384c-9dab-c2039cd8a007",
                                "text": "And so, unfortunately, this great and spreading network of railways, that recently showed such promise as a major instrument in the modern development of China, must be left for the time being in the melting-pot of Armageddon."
                            }
                        ]
                    },
                    {
                        "sense_id": "8fa7290e-da33-3f7a-bd8c-23bff2e40aeb",
                        "entry_id": "27268fec-1285-391e-9ec2-38347cfdebac",
                        "glosses": [
                            "The battle itself."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c1ea1711-e15e-3579-a9bd-e6aa46554a12",
                        "entry_id": "27268fec-1285-391e-9ec2-38347cfdebac",
                        "glosses": [
                            "Any end of the world, especially by way of a cataclysmic battle or something analogous to one."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "62121c7d-12f3-46fb-be3a-e7c1e6500007",
                                "sense_id": "c1ea1711-e15e-3579-a9bd-e6aa46554a12",
                                "text": "Some say the end is near\nSome say we'll see Armageddon soon\nI certainly hope we will\nI sure could use a vacation from this ..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f0515e4-1433-4bf8-a19f-0a4baf0bcc4f",
                        "source_entry_id": "27268fec-1285-391e-9ec2-38347cfdebac",
                        "source_sense_description": "site",
                        "target_lang_word": "Armageddon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Armageddon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54a6a996-71ce-3ac6-83f0-f343c10608db",
                                        "entry_id": "5e9564ab-429b-35c3-a408-cad167cfbcf8",
                                        "glosses": [
                                            "Lieu de la bataille finale entre le bien et le mal, pour les religions issues de la Bible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a813dc1a-c83f-491d-b464-870c2f63913a",
                                                "sense_id": "54a6a996-71ce-3ac6-83f0-f343c10608db",
                                                "text": "Et je vis sortir de la gueule du dragon, et de la gueule de la bête, et de la bouche du faux prophète, trois esprits immondes, semblables à des grenouilles ;\ncar ce sont des esprits diaboliques, faisant des prodiges, et qui s’en vont vers les rois de la terre et du monde universel, pour les assembler pour le combat de ce grand jour du Dieu tout-puissant. […] Et il les assembla au lieu qui est appelé en hébreu, Armageddon."
                                            },
                                            {
                                                "example_id": "e8c5c8e8-61db-43ea-ab0b-95d0378b64f6",
                                                "sense_id": "54a6a996-71ce-3ac6-83f0-f343c10608db",
                                                "text": "J'ai osé me demander pourquoi les gigantesques démons Enakim et Héphilim venaient toujours combattre les chérubins dans les champs apocalyptiques d’Armageddon. J'ignore comment les Satans peuvent encore discuter avec les Anges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6358e770-d9db-3125-98af-27d2c160542f",
                                        "entry_id": "5e9564ab-429b-35c3-a408-cad167cfbcf8",
                                        "glosses": [
                                            "Scène d’un combat gigantesque et décisif."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0a2bcf6-fb75-4273-8622-126ce8ecced5",
                                                "sense_id": "6358e770-d9db-3125-98af-27d2c160542f",
                                                "text": "Mais après l'ultime Armageddon (la « lutte finale »), les « méchants » seront défaits, jetés en enfer ou envoyés en Sibérie, et ce sera la Révolution, le Jugement dernier, l'instauration du royaume de Dieu ou de la société sans classes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
