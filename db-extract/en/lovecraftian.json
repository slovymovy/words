                                "target_senses": [
                                    {
                                        "sense_id": "0fe2ca8c-201f-3d77-9a28-facbe3cbe5cb",
                                        "entry_id": "b17ac118-beac-34e3-ac03-8c9883712bb8",
                                        "glosses": [
                                            "Qui appartient, s'inspire, ou ressemble aux espaces imaginaires, à l’œuvre, de l’écrivain américain Howard Phillips Lovecraft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eceba6c-7b38-48fd-8798-4844148bcd3a",
                                                "sense_id": "0fe2ca8c-201f-3d77-9a28-facbe3cbe5cb",
                                                "text": "Dans l’univers lovecraftien, il faut réserver une place spéciale aux perceptions auditives."
                                            },
                                            {
                                                "example_id": "47d285c0-c68c-4a66-95fc-9e99ecce3c3f",
                                                "sense_id": "0fe2ca8c-201f-3d77-9a28-facbe3cbe5cb",
                                                "text": "En 1981, L’Appel de Cthulu, jeu de rôle culte, a commencé à répandre l’imaginaire lovecraftien, inspiré de la nouvelle publiée en 1928."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
