                        "entry_id": "74eed4a5-63d8-355d-a4bf-bdbe946f3fb5",
                        "glosses": [
                            "niebiałkowy związek organiczny niezbędny do działania niektórych enzymów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9690c386-d5f1-4ab5-b944-a1e3453eee69",
                                "sense_id": "6b64da2d-83b2-3518-9c9f-799f402026d9",
                                "text": "Mechanizm działania witamin jest różny, jednak wszystkie wpływają w sposób bezpośredni lub pośredni na komórkowe procesy metaboliczne, najczęściej jako koenzymy lub biologiczne aktywne składniki o charakterze hormonów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b2f10fe-63e9-4c0d-b640-7d05d1e005f5",
                        "source_entry_id": "74eed4a5-63d8-355d-a4bf-bdbe946f3fb5",
                        "source_sense_id": "6b64da2d-83b2-3518-9c9f-799f402026d9",
                        "target_lang_word": "coenzyme",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coenzyme",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78645d91-bd35-36c9-891b-f4b4b90e1b87",
                                        "entry_id": "24156c31-eaf6-30c4-a3dd-87ab891b974d",
                                        "glosses": [
                                            "Any small molecule that is necessary for the functioning of an enzyme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9eb6278-d8f2-43e3-b042-0e6561ea9310",
                                                "sense_id": "78645d91-bd35-36c9-891b-f4b4b90e1b87",
                                                "text": "A coenzyme that exists in all living cells, NAD+ plays a central role in the body’s biological processes, such as regulating cellular energy, increasing insulin sensitivity and reversing mitochondrial dysfunction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9ed754b-760f-431e-aef7-d654ff9e5b9e",
                        "source_entry_id": "74eed4a5-63d8-355d-a4bf-bdbe946f3fb5",
                        "source_sense_id": "6b64da2d-83b2-3518-9c9f-799f402026d9",
