{
    "word_family": [
        "semantics",
        "semantically",
        "semanticist",
        "semantical"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5590052f-e0af-3822-b724-e8ef39a7a4cd",
                    "sense_definition": "Of or relating to the meanings of words and language.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher explained the <w>semantic</w> differences between the two similar verbs.",
                            "target_lang_translations": {
                                "ru": "Учитель объяснил <w>семантические</w> различия между двумя похожими глаголами."
                            }
                        },
                        {
                            "text": "A <w>semantic</w> change occurred over time as the word's meaning shifted from positive to negative.",
                            "target_lang_translations": {
                                "ru": "Со временем произошло <w>семантическое</w> изменение, так как значение слова сменилось с положительного на отрицательное."
                            }
                        }
                    ],
                    "common_phrases": [
                        "semantic change",
                        "semantic field",
                        "semantic analysis"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к значению слов и языка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "семантический",
                                "target_lang_sense_clarification": "лингвистический термин"
                            },
                            {
                                "target_lang_word": "смысловой",
                                "target_lang_sense_clarification": "относящийся к смыслу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d99056a-0c28-3f42-a002-6a1db9794ba9",
                    "sense_definition": "Relating to the intended structure and meaning of data or code, especially in computing.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Using <w>semantic</w> HTML helps search engines understand the content of your webpage better.",
                            "target_lang_translations": {
                                "ru": "Использование <w>семантического</w> HTML помогает поисковым системам лучше понимать содержание вашей веб-страницы."
                            }
                        },
                        {
                            "text": "The developer focused on <w>semantic</w> markup to improve the accessibility of the site.",
                            "target_lang_translations": {
                                "ru": "Разработчик сосредоточился на <w>семантической</w> разметке, чтобы улучшить доступность сайта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "semantic markup",
                        "semantic web",
                        "semantic data"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к структуре и значению данных или кода, особенно в программировании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "семантический",
                                "target_lang_sense_clarification": "о разметке или коде"
                            },
                            {
                                "target_lang_word": "смысловой",
                                "target_lang_sense_clarification": "о логической структуре данных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8d63869-cc18-3c00-a2e5-0dac5d5fc67a",
                    "sense_definition": "Focusing on trivial distinctions in word choice rather than the actual issue; quibbling.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "argumentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They wasted hours in a <w>semantic</w> argument over the definition of the word 'success'.",
                            "target_lang_translations": {
                                "ru": "Они потратили часы в <w>терминологическом</w> споре об определении слова «успех»."
                            }
                        },
                        {
                            "text": "Stop being so <w>semantic</w> and just address the main point of my complaint.",
                            "target_lang_translations": {
                                "ru": "Перестань так <w>цепляться к словам</w> и просто ответь на суть моей жалобы."
                            }
                        }
                    ],
                    "synonyms": [
                        "quibbling",
                        "niggling"
                    ],
                    "common_phrases": [
                        "semantic argument",
                        "semantic dispute"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сосредоточенный на незначительных различиях в выборе слов, а не на самой сути вопроса; придирчивый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "терминологический",
                                "target_lang_sense_clarification": "о споре по поводу определений"
                            },
                            {
                                "target_lang_word": "семантический",
                                "target_lang_sense_clarification": "формальный спор о словах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dc49e838-8c60-34dc-9118-53cbab17e79f",
                    "sense_definition": "The part of a complex character in writing systems like Chinese that indicates its meaning.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "writing systems",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this particular case, the <w>semantic</w> is on the left of its host sinogram.",
                            "target_lang_translations": {
                                "ru": "В данном конкретном случае <w>семантик</w> находится слева от основного иероглифа."
                            }
                        },
                        {
                            "text": "The student learned to identify the <w>semantic</w> to guess the meaning of new characters.",
                            "target_lang_translations": {
                                "ru": "Студент научился определять <w>семантический элемент</w>, чтобы угадывать значение новых иероглифов."
                            }
                        }
                    ],
                    "synonyms": [
                        "radical",
                        "determinative"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "linguistic technicality"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть сложного иероглифа в системах письма (например, китайской), указывающая на его значение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "семантик",
                                "target_lang_sense_clarification": "смысловой элемент иероглифа"
                            },
                            {
                                "target_lang_word": "детерминатив",
                                "target_lang_sense_clarification": "указатель категории значения"
                            },
                            {
                                "target_lang_word": "ключ",
                                "target_lang_sense_clarification": "смысловой радикал"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}