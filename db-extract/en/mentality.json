                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mentalność",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "63e64a6a-6107-3ffb-9071-a91ea29aa101",
                                        "entry_id": "15970f08-5891-3367-9b12-7dde4cd0fb16",
                                        "glosses": [
                                            "właściwy komuś sposób myślenia i postrzegania rzeczywistości"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1de5a43-8127-44ba-b9bb-38ae9491f774",
                                                "sense_id": "63e64a6a-6107-3ffb-9071-a91ea29aa101",
                                                "text": "Z perspektywy kategoryzacji trzeba więc podkreślić, że mentalność postkomunistyczna wpływa na większy segment społeczeństwa, niż „tylko\" na sferę gospodarki."
                                            },
                                            {
                                                "example_id": "52348cfb-ddb6-4303-8b5e-d5441bf36c27",
                                                "sense_id": "63e64a6a-6107-3ffb-9071-a91ea29aa101",
                                                "text": "Moja mentalność była jednak inna – nie należy okazywać bólu, tylko go znosić. Nie wolno być słabym i trzeba grać nawet z kontuzją."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fef6266c-d145-4474-a83c-e774afa25cf4",
                        "source_entry_id": "f66752cb-3d5c-3f3f-bb78-1930e629b238",
