                            {
                                "example_id": "dfaee077-a3a2-47e0-8182-155f753666bb",
                                "sense_id": "74e930d1-370c-3a0b-8d30-a89c5b9b3503",
                                "text": "Gebruikte bakolie wordt steeds vaker en op steeds grotere schaal gestolen uit horecagelegenheden in New York. De olie vormt een belangrijk bestanddeel van biodiesel, een duurzame energiebron. De bakolie verdwijnt tot woede van restauranthouders en legale ophalers steeds sneller uit de opslagtanks, berichtte maandag de New York Post."
                            },
                            {
                                "example_id": "54e1ac62-c3f1-4724-9c53-9b4c69b29cf8",
                                "sense_id": "74e930d1-370c-3a0b-8d30-a89c5b9b3503",
                                "text": "De sluiting van een te volle stortplaats leidde tot deze ’vuilniscrisis’. Buurtbewoners hadden genoeg van de troep en blokkeerden de toegang daar. De ophalers legden hun werk neer. Het was de bedoeling van autoriteiten om de afval naar Rusland te sturen. Dat ging niet door. Nu komen er twee stortplaatsen bij, net buiten de stad."
                            }
                        ]
                    },
