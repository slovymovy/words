                                        "sense_id": "ed118cd2-b890-3b8c-82d2-55d564a9ced6",
                                        "entry_id": "6d7f3506-9b1a-362e-8fac-9677e1672286",
                                        "glosses": [
                                            "Any of several types of fastener comprising a bent piece of wire.",
                                            "A wire fastener, made of thin wire, used to secure stacks of paper by penetrating all the sheets and curling around."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ac3cfd1-a1c3-4561-95cd-577c462779bf",
                                                "sense_id": "ed118cd2-b890-3b8c-82d2-55d564a9ced6",
                                                "text": "They stapled the documents with an office stapler, putting a staple in the top left corner of each one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9bab614-5167-36de-9bca-1688e1853cbf",
                                        "entry_id": "6d7f3506-9b1a-362e-8fac-9677e1672286",
                                        "glosses": [
                                            "Any of several types of fastener comprising a bent piece of wire.",
                                            "A wire fastener, in any of various sizes, used to secure something else by penetrating and curling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1372274e-5347-4b9b-aab2-802014b6fcb2",
                                                "sense_id": "f9bab614-5167-36de-9bca-1688e1853cbf",
                                                "text": "They stapled the housewrap with a staple gun firing large staples."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d908ad2e-6c13-37fb-b6b1-1459a273cf1f",
                                        "entry_id": "6d7f3506-9b1a-362e-8fac-9677e1672286",
                                        "glosses": [
                                            "Any of several types of fastener comprising a bent piece of wire.",
                                            "A U-shaped wire fastener, made of thick wire, used to attach fence wire or other material to posts or structures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ec083cc-849b-4548-80c8-3ebf7092ae73",
                                                "sense_id": "d908ad2e-6c13-37fb-b6b1-1459a273cf1f",
                                                "text": "The rancher used staples to attach the barbed wire to the fence posts."
                                            },
                                            {
                                                "example_id": "1ff08897-49a6-4938-8bd9-30b19d6a8565",
                                                "sense_id": "d908ad2e-6c13-37fb-b6b1-1459a273cf1f",
                                                "text": "Esther's wrists were firmly tied, and the twisted rope was fastened to a strong staple in a heavy wooden joist above, near the fire-place. Here she stood, on a bench, her arms tightly drawn over her breast. Her back and shoulders were bare to the waist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8e124ba-c6f8-3dfc-bce3-04d6318dcc4e",
                                        "entry_id": "6d7f3506-9b1a-362e-8fac-9677e1672286",
                                        "glosses": [
                                            "One of a set of U-shaped metal rods hammered into a structure, such as a piling or wharf, which serve as a ladder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c55e553e-b950-4ca8-b787-44c6ca510e45",
                                                "sense_id": "a8e124ba-c6f8-3dfc-bce3-04d6318dcc4e",
                                                "text": "Fortunately, there were staples in the quay wall, and she was able to climb out of the water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcc6864f-71a3-3384-87ae-02f9456a32cf",
                                        "entry_id": "6d7f3506-9b1a-362e-8fac-9677e1672286",
                                        "glosses": [
                                            "A shaft, smaller and shorter than the principal one, joining different levels."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "153ec386-3878-33fb-aa15-b10030c50460",
                                        "entry_id": "6d7f3506-9b1a-362e-8fac-9677e1672286",
                                        "glosses": [
                                            "A small pit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1c7fc34d-2a6e-3417-a612-44662e6b3e17",
                                        "entry_id": "6d7f3506-9b1a-362e-8fac-9677e1672286",
                                        "glosses": [
                                            "A district granted to an abbey."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc27a19c-b292-4453-abe9-b26b56f57ab6",
                                                "sense_id": "1c7fc34d-2a6e-3417-a612-44662e6b3e17",
                                                "text": "[Henry II] also granted liberty of coyning to certain Cities and Abbies, allowing them one staple and two puncheons at a rate, with certain restrictions."
                                            }
