        "nl-extract.jsonl": [
            {
                "entry_id": "f779b60b-8373-3719-b42e-5ed0b64c1ea4",
                "word": "ijlheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5d991fa0-dbfe-3949-9ec9-4442d539ddbe",
                        "entry_id": "f779b60b-8373-3719-b42e-5ed0b64c1ea4",
                        "glosses": [
                            "lichtheid, dunheid van een atmosfeer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6e2ec1f-8dbd-4e7a-b3ba-a967ff831f8d",
                                "sense_id": "5d991fa0-dbfe-3949-9ec9-4442d539ddbe",
                                "text": "Die ijlheid én de afwezigheid van ozon brengt met zich mee dat ultraviolette straling van de zon vrijwel ongehinderd het Marsoppervlak bereikt."
                            }
                        ]
                    },
                    {
                        "sense_id": "89d0cb50-9906-3893-8309-b090c3980d49",
                        "entry_id": "f779b60b-8373-3719-b42e-5ed0b64c1ea4",
                        "glosses": [
                            "zwakheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13142f77-b6ec-468c-b94c-62e1ef5ee00e",
                                "sense_id": "89d0cb50-9906-3893-8309-b090c3980d49",
                                "text": "Kusters boek bestaat uit vier delen, waarbij elk deel een specifiek soort waan behandelt die op zijn beurt weer is verbonden met de vier elementen uit de alchemie en een getal. In volgorde van oplopende ijlheid: de Ø-waan met de aarde en de nul, de unowaan met het water en de een, de zijnswaan met de lucht en het veel, en de de ?-waan met het vuur en de oneindigheid."
                            },
                            {
                                "example_id": "7536695d-3440-46b8-8784-4dd391e897f9",
                                "sense_id": "89d0cb50-9906-3893-8309-b090c3980d49",
                                "text": "Zelfs de kleinste expansie van het zelf, een invulling, en deze definitie aan het oppervlak, het zou allemaal zo geruststellend zijn geweest, iets groters dan de ijlheid en leegte van de lucht, de zwakte van ons licht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81f53178-2237-4e0a-b429-7130fbc2e34e",
                        "source_entry_id": "f779b60b-8373-3719-b42e-5ed0b64c1ea4",
                        "source_sense_id": "5d991fa0-dbfe-3949-9ec9-4442d539ddbe",
                        "target_lang_word": "rarity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rarity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b129a328-f6ad-361e-bddb-a57124ebe462",
                                        "entry_id": "cde02766-4f8f-3426-a8b2-dc9825c9e0f3",
                                        "glosses": [
                                            "A measure of the scarcity of an object."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "68914b0b-eae5-3a32-a92b-af6fc755ab86",
                                        "entry_id": "cde02766-4f8f-3426-a8b2-dc9825c9e0f3",
                                        "glosses": [
                                            "Thinness; the property of having low density"
                                        ],
                                        "tags": [
                                            "of a gas"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4584b76-1788-4966-b14f-76509e447550",
                                                "sense_id": "68914b0b-eae5-3a32-a92b-af6fc755ab86",
                                                "text": "Only the increasing rarity bothered him, and he thought that perhaps it was this which had turned the heads of other travellers and excited those absurd tales of night-gaunts whereby they explained the loss of such climbers as fell from these perilous paths."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f60eb8e-067e-357a-9772-37e2d8db8af7",
                                        "entry_id": "cde02766-4f8f-3426-a8b2-dc9825c9e0f3",
                                        "glosses": [
                                            "A rare object."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c6fefce-4dc4-40c5-ac17-c63b852d63d5",
                                                "sense_id": "2f60eb8e-067e-357a-9772-37e2d8db8af7",
                                                "text": "Plant breeding is always a numbers game.[…]In addition, we are looking for rare alleles, so the more plants we try, the better. These rarities may be new mutations, or they can be existing ones that are neutral—or are even selected against—in a wild population. A good example is mutations that disrupt seed dispersal, leaving the seeds on the heads long after they are ripe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70e79161-2c8c-46f4-9403-d48fae2bed7c",
                        "source_entry_id": "f779b60b-8373-3719-b42e-5ed0b64c1ea4",
                        "source_sense_id": "5d991fa0-dbfe-3949-9ec9-4442d539ddbe",
                        "target_lang_word": "thinness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thinness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9040525a-282c-34ab-9d52-91a974f647d6",
                                        "entry_id": "77866b2d-4a68-3478-9a7b-6769cd43e7c7",
                                        "glosses": [
                                            "The state or quality of being thin."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bbf48c0-64fc-4cfb-afd4-e40c55d22168",
                                                "sense_id": "9040525a-282c-34ab-9d52-91a974f647d6",
                                                "text": "The beautiful prismatic colours seen on the Labrodore stone are owing to a similar cause, viz. the thinness of the laminæ of which it consists […]."
                                            },
                                            {
                                                "example_id": "ed267a84-7b98-4eff-8889-b5afaac2aace",
                                                "sense_id": "9040525a-282c-34ab-9d52-91a974f647d6",
                                                "text": "Beyond celebrating the aesthetic value of thinness, pro-anas claim that thinness is a reflection of excellence in other areas of one's life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
