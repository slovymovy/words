                                                "sense_id": "d33211cb-830d-3aed-bb49-c4c4f3b7cd25",
                                                "text": "Do sosu zużyłem całą główkę czosnku."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "2aba19a8-2b14-3968-97df-4b46df873594",
                                        "entry_id": "e3af6c09-c969-3d53-98d1-2aace7077850",
                                        "glosses": [
                                            "zaokrąglone zakończenie jakiejś rzeczy"
