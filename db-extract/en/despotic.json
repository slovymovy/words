                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3cd5918b-5344-43f1-be2f-9aa8aa585f4e",
                        "entry_id": "19f1b396-793f-302c-add4-55aeafecc7d0",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more despotic"
                    },
                    {
                        "form_id": "e46d6ca2-e735-44bd-896d-7b01fde0ceba",
                        "entry_id": "19f1b396-793f-302c-add4-55aeafecc7d0",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most despotic"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5a1701b9-5987-3c1b-8007-506f87db21d6",
                        "entry_id": "19f1b396-793f-302c-add4-55aeafecc7d0",
                        "glosses": [
                            "Of or pertaining to a despot or tyrant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "493d7530-d103-4e43-8956-c5c13f45d1f6",
                                "sense_id": "5a1701b9-5987-3c1b-8007-506f87db21d6",
                                "text": "This despotic age of the empire ended in a revolt."
                            }
                        ]
                    },
                    {
                        "sense_id": "34dd180d-a714-32ca-8f67-f042ae0f4270",
                        "entry_id": "19f1b396-793f-302c-add4-55aeafecc7d0",
                        "glosses": [
                            "Acting or ruling as a despot, tyrannical."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "065692a4-86b8-4ea5-a513-a43015c20133",
                                "sense_id": "34dd180d-a714-32ca-8f67-f042ae0f4270",
                                "text": "The despotic king dissolved the parliament, and took personal control of the country."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d196f969-0871-4b72-8ff8-5e46fbccef62",
                        "source_entry_id": "19f1b396-793f-302c-add4-55aeafecc7d0",
                        "source_sense_description": "of or pertaining to a despot",
                        "target_lang_word": "despotický",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "despotický",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "53d211a8-a88d-3922-8d21-f7492477e700",
                                        "entry_id": "438b1521-4f8c-306d-9f3f-137364da812b",
                                        "glosses": [
                                            "prosazující bezohledně jen svoji vůli; nepřipouštějící námitky, kritiku či opozici; připomínající despotu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27156c01-4c2b-4a5a-98f4-d03370bd9850",
                                                "sense_id": "53d211a8-a88d-3922-8d21-f7492477e700",
                                                "text": "Leckdy despotické chování předsedů JZD zřejmě v mnoha případech nahrazovalo absenci zemědělského vzdělání a slabé odborné znalosti, chybějící manažerské předpoklady i zkušenosti s řízením zemědělských podniků, což zákonitě vedlo k malému či nulovému respektu mezi ostatními zemědělci v obci."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c862481-a899-4836-91be-5f5cedf59579",
                        "source_entry_id": "19f1b396-793f-302c-add4-55aeafecc7d0",
                        "source_sense_description": "of or pertaining to a despot",
                        "target_lang_word": "despotique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "despotique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a229523-5ac1-3d72-a89f-8413f3c6942e",
                                        "entry_id": "4eba651e-bbff-3e10-9d93-0f05698fc33a",
                                        "glosses": [
                                            "Qui est propre au despote."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef4dc050-5974-42d0-833a-b242f7bba0d6",
                                                "sense_id": "1a229523-5ac1-3d72-a89f-8413f3c6942e",
                                                "text": "Enfin, c’est celui qui veut remplacer la loi tutélaire de la majorité par l'arbitraire tyrannique du petit nombre, faire le peuple esclave du parti & écraser la démocratie tout entière sous une despotique kakistocratie."
                                            },
                                            {
                                                "example_id": "4fa38e4a-def9-4dee-b484-eeb7d13b5f7a",
                                                "sense_id": "1a229523-5ac1-3d72-a89f-8413f3c6942e",
                                                "text": "Passant ensuite aux détails techniques de la composition et de l’instrumentation, Liszt caractérise la manière incisive dont Wagner a rendu les attractions lascives du Venusberg : […]. « Il y a des notes qui sifflent à l’oreille comme certains regards chatoient à la vue : longues, désarmantes, perfides ! Sous le velouté de leur artificielle douceur on saisit des intonations despotiques, on sent trembler la colère. Çà et là des mordantes de violon s’échappent de l’archet comme des étincelles phosphoriques. […] »"
                                            },
                                            {
                                                "example_id": "2a035668-06d6-4d6f-8dac-02c891206ff7",
                                                "sense_id": "1a229523-5ac1-3d72-a89f-8413f3c6942e",
                                                "text": "À vrai dire, la République romaine n’était qu’une oligarchie despotique et pillarde dont les chefs s’enrichissaient en dépouillant le monde par les guerres et les rapines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ace2174-390c-4bd8-858b-52a7c1802a4f",
                        "source_entry_id": "19f1b396-793f-302c-add4-55aeafecc7d0",
                        "source_sense_description": "of or pertaining to a despot",
                        "target_lang_word": "despotisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "despotisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db0070c5-8b39-37cc-9b6c-7ca7bb725bf8",
                                        "entry_id": "1971e75f-dac0-3141-8653-3513da398b17",
                                        "glosses": [
                                            "in der Art eines Despoten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8e23e32-1f45-49a6-8edf-e95e255da77b",
                                                "sense_id": "db0070c5-8b39-37cc-9b6c-7ca7bb725bf8",
                                                "text": "Der Vorgesetzte geht mit seinem despotischen Gehabe allen Angestellten auf die Nerven."
                                            },
                                            {
                                                "example_id": "d6ddfa84-d9f0-4043-ba1c-e603a4ab40a8",
                                                "sense_id": "db0070c5-8b39-37cc-9b6c-7ca7bb725bf8",
                                                "text": "„Es geht darum, despotische Herrscher in ihre Schranken zu weisen, Gewaltexzesse gegen Zivilbevölkerungen zu unterbinden, leidenden und hungernden Menschen zu helfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
