                    },
                    {
                        "translation_id": "5cb6d38e-2832-4405-9932-fcaed53ffa52",
                        "source_entry_id": "29968b0d-ecd1-3251-a3c8-f71f6c10d938",
                        "target_lang_word": "ramification",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ramification",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de2918b6-2df5-37fa-ab0a-b13ba4cb12a2",
                                        "entry_id": "26ea204d-3380-35bd-bd8c-fced38ad5f3f",
                                        "glosses": [
                                            "Division en plusieurs rameaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0588fb54-5978-48a2-a541-acc58b569da2",
                                                "sense_id": "de2918b6-2df5-37fa-ab0a-b13ba4cb12a2",
                                                "text": "La ramification d’une tige, des artères des veines, des nerfs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "226feb59-373c-3917-9ee5-c16afd1b47ea",
                                        "entry_id": "26ea204d-3380-35bd-bd8c-fced38ad5f3f",
                                        "glosses": [
                                            "Chacun des rameaux produits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3324e6fb-201d-4c06-873c-b2ebdd284bc0",
                                                "sense_id": "226feb59-373c-3917-9ee5-c16afd1b47ea",
                                                "text": "Cerclée d’une triple enceinte de murailles noirâtres à créneaux, cette ville est bâtie près du cap Apchéron, sur les extrêmes ramifications de la chaîne du Caucase."
                                            },
                                            {
                                                "example_id": "244f2923-4679-43dc-900d-0d5bb5c0d40a",
                                                "sense_id": "226feb59-373c-3917-9ee5-c16afd1b47ea",
                                                "text": "Ramifications vasculaires, nerveuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e8b37d9-2e85-3e7f-8aa6-bb3d73ea2054",
                                        "entry_id": "26ea204d-3380-35bd-bd8c-fced38ad5f3f",
                                        "glosses": [
                                            "Subdivisions d’une science, d’une étude."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90c036f8-8f29-43e6-b501-da67c245a40c",
                                                "sense_id": "0e8b37d9-2e85-3e7f-8aa6-bb3d73ea2054",
                                                "text": "Il a étudié son sujet jusqu’aux moindres ramifications."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0d46132-4a09-396f-ba72-383e2adcb6a2",
                                        "entry_id": "26ea204d-3380-35bd-bd8c-fced38ad5f3f",
                                        "glosses": [
                                            "Embranchement, extension d’une secte, d’un complot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b29cddad-d1a5-480b-954d-251250cf07f5",
                                                "sense_id": "b0d46132-4a09-396f-ba72-383e2adcb6a2",
                                                "text": "L’association prit un accroissement rapide ; elle étendit ses ramifications jusqu’aux villages les plus reculés."
                                            },
                                            {
                                                "example_id": "d2646388-6cc7-4574-a9e2-58e2cdaf281e",
                                                "sense_id": "b0d46132-4a09-396f-ba72-383e2adcb6a2",
                                                "text": "Une sérieuse contre-révolution qui se mijote de l’autre côté, mais qui, malheureusement, possède d’importantes ramifications en France…"
                                            },
                                            {
                                                "example_id": "85dead88-6a88-4a9b-95c8-b42b8ca71b0a",
                                                "sense_id": "b0d46132-4a09-396f-ba72-383e2adcb6a2",
                                                "text": "Autre donnée à prendre en compte, le montant du préjudice : 350 000 euros pour le MoDem contre plus de six millions pour le RN, dont les ramifications révélées notamment par Mediapart semblent bien plus denses que ce qui a été reproché au MoDem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67514b29-bfb8-35bd-815c-c38d91a09ba6",
                                        "entry_id": "26ea204d-3380-35bd-bd8c-fced38ad5f3f",
                                        "glosses": [
                                            "Branche formée par des atomes qui se distinguent par rapport à la chaîne principale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdf1c1bf-bc9e-45c5-a922-9ff87209133e",
                                                "sense_id": "67514b29-bfb8-35bd-815c-c38d91a09ba6",
                                                "text": "La molécule d’iso-octane a de nombreuses ramifications : elle est ramifiée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a66cdd31-5774-322d-9a04-ad7d4957ee1d",
                                        "entry_id": "26ea204d-3380-35bd-bd8c-fced38ad5f3f",
                                        "glosses": [
                                            "Division d’un projet en plusieurs branches, et par métonymie, l’une de ces branches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd94283f-bea7-4c36-8964-e25465b6c984",
                                                "sense_id": "a66cdd31-5774-322d-9a04-ad7d4957ee1d",
                                                "text": "La branche 1.8 devait être créée à l’origine fin juillet mais la ramification pour la 1.8 a été retardée après qu’il est devenu évident que tout le travail nécessaire ne pourrait être terminé à temps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
