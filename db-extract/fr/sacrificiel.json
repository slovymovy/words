                ],
                "senses": [
                    {
                        "sense_id": "5da468ef-3ad9-3455-8e3e-a335afd989e7",
                        "entry_id": "03552554-919a-3c65-8e4f-c4cb269e3948",
                        "glosses": [
                            "En rapport avec le sacrifice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "beb217e1-8da6-4db8-a1f6-c0c914de9df4",
                                "sense_id": "5da468ef-3ad9-3455-8e3e-a335afd989e7",
                                "text": "Ils reprirent leur chemin jusqu’au centre de la place où ils appuyèrent le mât du palanquin contre le poteau sacrificiel, tandis que la pluie de fleurs reprenait, plus dense encore."
                            },
                            {
                                "example_id": "f31acd74-cbe9-4b50-adaf-d878e61977ea",
                                "sense_id": "5da468ef-3ad9-3455-8e3e-a335afd989e7",
                                "text": "Halte au vulgaire mot de « ralliement » ! Cet esprit sacrificiel veut seulement faire don de sa personne […]."
                            },
                            {
                                "example_id": "832733c2-7dbd-44de-8775-6820815880b8",
                                "sense_id": "5da468ef-3ad9-3455-8e3e-a335afd989e7",
                                "text": "Citant plusieurs cas similaires, il perçoit la génération actuelle de retraités comme \"des agneaux sacrificiels de la grande économie\". Il dit avoir interpellé Eric Girard à plusieurs reprises pour la constitution d'une assurance-retraite."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d50cf893-7fc2-4174-bc20-0188a0af2957",
                        "source_entry_id": "03552554-919a-3c65-8e4f-c4cb269e3948",
                        "source_sense_id": "5da468ef-3ad9-3455-8e3e-a335afd989e7",
                        "target_lang_word": "sacrificial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sacrificial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6ad58ee-ecd8-36e6-a984-34a1fdfeda60",
                                        "entry_id": "ccd6da9a-7252-3d64-99e1-81403bed6857",
                                        "glosses": [
                                            "Relating to sacrifice"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ebb1570-2aed-4e64-999b-b736c6e27874",
                                                "sense_id": "d6ad58ee-ecd8-36e6-a984-34a1fdfeda60",
                                                "text": "The old sacrificial well is still there, but animals aren't thrown into it to appease monsters anymore."
                                            },
                                            {
                                                "example_id": "d451a3ec-f5fc-4b53-9b58-44f3537c7dbf",
                                                "sense_id": "d6ad58ee-ecd8-36e6-a984-34a1fdfeda60",
                                                "text": "Rabban Yoḥanan could have succumbed to despair like many at that time. Instead, he looked for alternatives to the sacrificial system, because he understood that it would take a long time to rebuild the Temple and the Jewish people needed other ways to worship God."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fb1ed86-4c41-3213-a992-a512e94d624f",
                                        "entry_id": "ccd6da9a-7252-3d64-99e1-81403bed6857",
                                        "glosses": [
                                            "Used as a sacrifice."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d71d78fc-afaf-4fe7-b8fa-a5a695300bc8",
                                                "sense_id": "8fb1ed86-4c41-3213-a992-a512e94d624f",
                                                "text": "The ceremony involves the ritual slaying of a sacrificial lamb."
                                            },
                                            {
                                                "example_id": "bebfe0be-4c54-4ca5-9826-198fd417f96a",
                                                "sense_id": "8fb1ed86-4c41-3213-a992-a512e94d624f",
                                                "text": "The sacrificial coating protects the hull, but because it takes the damage the hull doesn't, we must replace it annually."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
