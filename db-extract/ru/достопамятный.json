                "senses": [
                    {
                        "sense_id": "8496c778-440b-3e06-a6d0-95a0bada217b",
                        "entry_id": "bdd3235f-d06a-32d3-9b89-5d76f621c90f",
                        "glosses": [
                            "memorable"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4376ddc-3928-4952-b4b4-d00a227be7f0",
                                "sense_id": "8496c778-440b-3e06-a6d0-95a0bada217b",
                                "text": "В оживлённости, кото́рою все мы бы́ли охва́чены в э́тот достопа́мятный весе́нний ве́чер, нам представля́лось, что все мы смелы́ и мо́жем соверши́ть отча́янную шту́ку безопа́сно.",
                                "translation": "In the animation that gripped us all on that memorable spring evening, it seemed to us that we were all brave and could pull off the desperate stunt safely.",
                                "english": "In the animation that gripped us all on that memorable spring evening, it seemed to us that we were all brave and could pull off the desperate stunt safely."
                            }
                        ]
                    }
                ],
