                                "target_senses": [
                                    {
                                        "sense_id": "d983c96e-9178-320e-9963-ba0a3f3b54a9",
                                        "entry_id": "f6eef12e-c5ed-32b1-8700-a486e6c93652",
                                        "glosses": [
                                            "A release of emotional tension after an overwhelming vicarious experience, resulting in the purging or purification of the emotions, as through watching a dramatic production (especially a tragedy)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "424516e7-6c2a-4b03-b8e1-d49215fe9ea1",
                                                "sense_id": "d983c96e-9178-320e-9963-ba0a3f3b54a9",
                                                "text": "True, as the show has entered its later years, there have been more inspired moments of catharsis, but fewer unpredictable arcs and story beats, as a narrative nearing its conclusion is no longer attempting to shock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3a4445d-fc1c-3b13-b761-d70168249a55",
                                        "entry_id": "f6eef12e-c5ed-32b1-8700-a486e6c93652",
                                        "glosses": [
                                            "Any release of emotional tension to the same effect, more widely."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b14e344-fb97-385d-95b2-01b4c25c5b1b",
                                        "entry_id": "f6eef12e-c5ed-32b1-8700-a486e6c93652",
                                        "glosses": [
                                            "A purification or cleansing, especially emotional."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf32f36c-f6cb-300c-b0a6-24df5865248f",
                                        "entry_id": "f6eef12e-c5ed-32b1-8700-a486e6c93652",
                                        "glosses": [
                                            "A therapeutic technique to relieve tension by reestablishing the association of an emotion with the memory or idea of the event that first caused it, and then eliminating it by complete expression (called the abreaction)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
