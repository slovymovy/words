                                    {
                                        "sense_id": "eacd7ebb-2c05-344f-805d-904255aebbae",
                                        "entry_id": "ef27d4fa-7d11-30f2-82dc-6ebb866b1e23",
                                        "glosses": [
                                            "meist kleiner Krebs mit charakteristischer gegensätzlicher Stellung der Brustbeine, von denen die vorderen vier Paar nach vorne und die hinteren drei Paar nach hinten abgewinkelt sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b511073d-210f-4540-aec5-034bb1ad83af",
                                                "sense_id": "eacd7ebb-2c05-344f-805d-904255aebbae",
                                                "text": "„Das Licht nach der langen Polarnacht lässt die Eisalgen erblühen. Von diesen ernähren sich dann die Flohkrebse, die wiederum den Polardorschen als Futter dienen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "46405c11-98aa-3077-820d-64317858fcf8",
                                        "entry_id": "ef27d4fa-7d11-30f2-82dc-6ebb866b1e23",
                                        "glosses": [
                                            "artenreiche Ordnung der Krebstiere, die zur Klasse der Höheren Krebse (Malacostraca) gehört"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1591dc3-e662-49c6-836f-660a6cbf00c1",
                                                "sense_id": "46405c11-98aa-3077-820d-64317858fcf8",
                                                "text": "„Das Licht nach der langen Polarnacht lässt die Eisalgen erblühen. Von diesen ernähren sich dann die Flohkrebse, die wiederum den Polardorschen als Futter dienen.“"
