                                ]
                            },
                            {
                                "target_word": "triangulaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dea48c5e-aa30-3b3e-a80e-547cf75e9a7d",
                                        "entry_id": "2b0a09f1-bec3-3341-b96f-1464975779c2",
                                        "glosses": [
                                            "Qui a trois angles, qui a la forme d’un triangle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b08c23c-d5a9-4a2f-9ab3-5e97df57a271",
                                                "sense_id": "dea48c5e-aa30-3b3e-a80e-547cf75e9a7d",
                                                "text": "2°- Les alluvions dites des hautes terrasses, formant une immense plate-forme triangulaire au relief largement étalé et dont les sommets seraient marqués par les villages de Franchevelle, La Chapelle-lès-Luxeuil et Froideconche."
                                            },
                                            {
                                                "example_id": "e070505f-cd41-4dea-beaf-5e50b9657099",
                                                "sense_id": "dea48c5e-aa30-3b3e-a80e-547cf75e9a7d",
                                                "text": "Je trouve ma nouvelle grand'voile triangulaire très facile à amener, […]."
                                            },
                                            {
                                                "example_id": "c1b1a9f9-b5eb-488b-beea-d528a5057f6e",
                                                "sense_id": "dea48c5e-aa30-3b3e-a80e-547cf75e9a7d",
                                                "text": "Plus instruit, j’aurais reconnu à coup sûr le sens caché de ces figures triangulaires dans la culture berbère, et conservées par l’artisanat gafsien : l’allusion au « delta fertile du corps de la femme », au « principe primaire de la vie », […]."
                                            },
                                            {
                                                "example_id": "a707d631-0b6b-4e08-af37-7487ad18169a",
                                                "sense_id": "dea48c5e-aa30-3b3e-a80e-547cf75e9a7d",
                                                "text": "— Coupé par un immense béret, son petit visage bien rasé, triangulaire et anguleux comme celui d'un fennec, souriait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eb69f38-a587-3236-9898-8ccdd2dd30ab",
                                        "entry_id": "2b0a09f1-bec3-3341-b96f-1464975779c2",
                                        "glosses": [
                                            "Dont la base est un triangle."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca179bc3-2b71-4409-a882-d9730b2486b6",
                                                "sense_id": "7eb69f38-a587-3236-9898-8ccdd2dd30ab",
                                                "text": "Mal éclairée d'un quinquet nu, la famille veillait autour du poêle triangulaire."
                                            },
                                            {
                                                "example_id": "7b6f38cd-ef25-4181-9862-d27d8e3b15c4",
                                                "sense_id": "7eb69f38-a587-3236-9898-8ccdd2dd30ab",
                                                "text": "Prisme triangulaire, pyramide triangulaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11d6d3e2-3999-357d-8aa2-e197fae766be",
                                        "entry_id": "2b0a09f1-bec3-3341-b96f-1464975779c2",
                                        "glosses": [
                                            "À trois éléments."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35a2760f-4b79-4542-bd5c-c35e8eaa0e11",
                                                "sense_id": "11d6d3e2-3999-357d-8aa2-e197fae766be",
                                                "text": "Le couple le conserve dans sa chambre à coucher, à la faveur d’une relation triangulaire pour le moins bizarre. — (Mikal Hem, Et si je devenais dictateur, traduit du norvégien par Jean-Baptiste Coursaud, Gaïa, 2017, page 219)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e156accf-2077-39ae-b48d-19c3b7a09f1f",
                                        "entry_id": "2b0a09f1-bec3-3341-b96f-1464975779c2",
                                        "glosses": [
                                            "[En parlant d’une élection] Qui se dispute entre trois candidats ou listes au second tour de scrutin."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
