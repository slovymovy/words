                    {
                        "sense_id": "754f1217-2d0c-3ff4-aa24-295304123e63",
                        "entry_id": "46e0af8e-5a2b-3fe6-a2a0-dd475e2490af",
                        "glosses": [
                            "een elektrisch apparaat om bewegende beelden en geluid te ontvangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a033ea93-6d48-49ad-9c04-941449e960c2",
                                "sense_id": "754f1217-2d0c-3ff4-aa24-295304123e63",
                                "text": "In de woonkamer staat een tv."
                            },
                            {
                                "example_id": "63d06afc-e100-4550-a29a-e050a0b99cf9",
                                "sense_id": "754f1217-2d0c-3ff4-aa24-295304123e63",
                                "text": "In een dorp waar ze je bij je naam noemen bij de bakker en de slager, gewoon omdat je daar vaak komt, niet omdat ze je van tv kennen."
                            },
                            {
                                "example_id": "d75725d0-8048-4981-91ed-f667b61833fa",
                                "sense_id": "754f1217-2d0c-3ff4-aa24-295304123e63",
                                "text": "Binnen de hut was de tijd meer dan 50 jaar stil blijven staan en er was dan ook geen tv of wifi."
                            }
                        ]
                    },
                    {
                        "sense_id": "3cbe1f3d-7805-32c3-be27-d776a51cbb3c",
                        "entry_id": "46e0af8e-5a2b-3fe6-a2a0-dd475e2490af",
                        "glosses": [
                            "een programma dat op dit apparaat getoond wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbccd026-e62e-4092-be19-1b27ed4b729f",
                                "sense_id": "3cbe1f3d-7805-32c3-be27-d776a51cbb3c",
                                "text": "Deze nieuwe samenwerking kan mooie tv opleveren."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e36f372-821d-3959-8521-d30bad0d21e5",
                        "entry_id": "46e0af8e-5a2b-3fe6-a2a0-dd475e2490af",
                        "glosses": [
                            "het communicatiemedium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2186f1db-b386-4641-9a7c-7184d1119ef8",
                                "sense_id": "4e36f372-821d-3959-8521-d30bad0d21e5",
                                "text": "Wat is er op tv?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8472d0d2-78e9-4767-853d-bd300fd91b38",
                        "source_entry_id": "46e0af8e-5a2b-3fe6-a2a0-dd475e2490af",
                        "source_sense_id": "754f1217-2d0c-3ff4-aa24-295304123e63",
                        "source_sense_description": "een elektrisch apparaat om bewegende beelden en geluid te ontvangen",
                        "target_lang_word": "Fernsehapparat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fernsehapparat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4862b851-3317-331a-8288-27a76a23ac01",
                                        "entry_id": "593cd0e0-f5f0-3603-b64c-b66726d98033",
                                        "glosses": [
                                            "elektronisches Gerät, das von Fernsehanstalten ausgestrahlte Sendungen über terrestrische Wellen, Satelliten oder Glasfaserkabel empfangen und wiedergeben kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57cb6fd4-e32a-448b-9870-1d5e1b70b7e2",
                                                "sense_id": "4862b851-3317-331a-8288-27a76a23ac01",
                                                "text": "Dieser Fernsehapparat beinhaltet die neueste Digitaltechnik."
                                            },
                                            {
                                                "example_id": "59381c20-6bb2-4f2a-a44f-c6c5b3a5e38f",
                                                "sense_id": "4862b851-3317-331a-8288-27a76a23ac01",
                                                "text": "„Helena und Moritz, die Eltern, überlegen, den beiden Größeren einen eigenen Fernsehapparat ins Zimmer zu stellen.“"
                                            },
                                            {
                                                "example_id": "6f007320-396e-44f4-ac63-6fa45c9f2ae8",
                                                "sense_id": "4862b851-3317-331a-8288-27a76a23ac01",
                                                "text": "„Austragungsort war der Keller meines Elternhauses, in dem ich einen alten Fernsehapparat aufgestellt hatte, eine riesige Kiste mit Schwarz-Weiss-Bild, Seitenwänden aus Holzimitat und massiven Knöpfen, an denen man drehen konnte.“"
                                            },
                                            {
                                                "example_id": "3fb943c4-861f-4071-a951-8c05b0ada171",
                                                "sense_id": "4862b851-3317-331a-8288-27a76a23ac01",
                                                "text": "„Dem Inseratenteil einer führenden Tageszeitung entnahm ich kürzlich, dass man diesen kostbaren Kräften nicht nur Rundfunkgeräte, Fernsehapparate und Theaterkarten aufdrängt.“"
                                            },
                                            {
                                                "example_id": "e64e2ac9-ff80-4243-8974-79b88ea3db95",
                                                "sense_id": "4862b851-3317-331a-8288-27a76a23ac01",
                                                "text": "„Die Schwägerin setzte sich mit dem Stiefbruder vor den Fernsehapparat und verfolgte mit ihm das Programm bis gegen Mitternacht und äußerte gelegentlich eine Vermutung über das Scheitern von Rotermunds Plänen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad54f27d-57a7-4615-a234-52459bb48c80",
                        "source_entry_id": "46e0af8e-5a2b-3fe6-a2a0-dd475e2490af",
                        "source_sense_id": "754f1217-2d0c-3ff4-aa24-295304123e63",
