{
    "word_family": [
        "bath",
        "bather",
        "bathing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d946c21d-01ef-3b36-8a5b-ac27a120e5de",
                    "sense_definition": "To clean oneself by immersion in water or using water; to take a bath.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I usually <w>bathe</w> in the evening to relax after a long day.",
                            "target_lang_translations": {
                                "zh": "我通常在晚上<w>洗澡</w>，以便在漫长的一天后放松身心。"
                            }
                        },
                        {
                            "text": "It is refreshing to <w>bathe</w> in warm water after working outside.",
                            "target_lang_translations": {
                                "zh": "在户外工作后，用温水<w>洗澡</w>让人感到神清气爽。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wash"
                    ],
                    "common_phrases": [
                        "bathe daily"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过浸泡在水中或用水来清洁自己；洗澡。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "洗澡",
                                "target_lang_sense_clarification": "指通过淋浴或盆浴清洁身体。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3876cb1d-3e03-3319-a5bc-b3ef32a58dcc",
                    "sense_definition": "To clean another person by immersion in water or using water.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Parents often <w>bathe</w> their baby before putting them to sleep.",
                            "target_lang_translations": {
                                "zh": "父母通常在哄宝宝睡觉前给他们<w>洗澡</w>。"
                            }
                        },
                        {
                            "text": "The nurse helped <w>bathe</w> the patient carefully.",
                            "target_lang_translations": {
                                "zh": "护士小心地帮病人<w>洗澡</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bathe baby"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过浸泡在水中或用水来清洁他人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "给……洗澡",
                                "target_lang_sense_clarification": "指帮助他人或动物进行清洁。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b926b763-f176-3b8e-a005-66f40bcf9c52",
                    "sense_definition": "To immerse oneself in water for pleasure or refreshment; to swim.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "swimming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to <w>bathe</w> in the lake during the hot afternoon.",
                            "target_lang_translations": {
                                "zh": "我们决定在炎热的午后去湖里<w>游泳</w>。"
                            }
                        },
                        {
                            "text": "Many tourists <w>bathe</w> in the sea when the weather is sunny.",
                            "target_lang_translations": {
                                "zh": "天气晴朗时，许多游客会在海里<w>游泳</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "swim"
                    ],
                    "common_phrases": [
                        "bathe in sea"
                    ],
                    "target_lang_definitions": {
                        "zh": "为了娱乐或清凉而浸泡在水中；游泳。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "游泳",
                                "target_lang_sense_clarification": "指在自然水域中戏水或游泳。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f54939e4-f215-37ec-b27d-0a3acf578beb",
                    "sense_definition": "To apply liquid to a part of the body, often for medical or cleaning purposes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had to <w>bathe</w> her injured eye with a clean cloth.",
                            "target_lang_translations": {
                                "zh": "她不得不拿干净的布<w>清洗</w>她受伤的眼睛。"
                            }
                        },
                        {
                            "text": "The doctor told him to <w>bathe</w> the wound with warm salt water.",
                            "target_lang_translations": {
                                "zh": "医生告诉他用温盐水<w>清洗</w>伤口。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rinse",
                        "wash"
                    ],
                    "common_phrases": [
                        "bathe wound"
                    ],
                    "target_lang_definitions": {
                        "zh": "将液体涂抹在身体部位上，通常用于医疗或清洁目的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "清洗",
                                "target_lang_sense_clarification": "指用液体对伤口或特定部位进行局部清洁。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3be21ea3-1f14-312b-8b30-81030f43dbce",
                    "sense_definition": "To cover or surround completely with something, such as light or fog.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire valley was <w>bathed</w> in golden morning sunlight.",
                            "target_lang_translations": {
                                "zh": "整个山谷都被金色的晨光<w>笼罩</w>着。"
                            }
                        },
                        {
                            "text": "Thick fog <w>bathed</w> the city streets in a mysterious glow.",
                            "target_lang_translations": {
                                "zh": "浓雾将城市街道<w>笼罩</w>在神秘的光晕中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "envelop",
                        "drench"
                    ],
                    "common_phrases": [
                        "bathed in light"
                    ],
                    "target_lang_definitions": {
                        "zh": "完全覆盖或包围，如光线或雾气。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "笼罩",
                                "target_lang_sense_clarification": "指光线或雾气覆盖在某物之上。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f446dfd5-e7eb-3945-9880-29f9531cd238",
                    "sense_definition": "To lie in the sun to get a tan.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "swimming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tourists <w>bathed</w> on the beach all afternoon.",
                            "target_lang_translations": {
                                "zh": "游客们整个下午都在海滩上<w>晒太阳</w>。"
                            }
                        },
                        {
                            "text": "They <w>bathed</w> in the sun to enjoy the warm weather.",
                            "target_lang_translations": {
                                "zh": "他们躺在阳光下<w>晒太阳</w>，享受温暖的天气。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sunbathe"
                    ],
                    "common_phrases": [
                        "bathe in sun"
                    ],
                    "target_lang_definitions": {
                        "zh": "躺在阳光下晒太阳以获得古铜色皮肤。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "晒太阳",
                                "target_lang_sense_clarification": "指在阳光下休息以享受温暖或晒黑皮肤。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e40c157d-61a9-3d39-bc49-09756bf564c5",
                    "sense_definition": "The act of swimming or washing oneself in water.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "swimming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am going to have a quick <w>bathe</w> in the river.",
                            "target_lang_translations": {
                                "zh": "我打算去河里快速<w>游泳</w>一下。"
                            }
                        },
                        {
                            "text": "After a long hike, a cold <w>bathe</w> felt wonderful.",
                            "target_lang_translations": {
                                "zh": "长途跋涉后，洗个冷水澡感觉棒极了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "swim",
                        "dip"
                    ],
                    "common_phrases": [
                        "have a bathe"
                    ],
                    "target_lang_definitions": {
                        "zh": "游泳或洗澡的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "洗澡",
                                "target_lang_sense_clarification": "指洗澡这一动作。"
                            },
                            {
                                "target_lang_word": "游泳",
                                "target_lang_sense_clarification": "指游泳这一动作。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}