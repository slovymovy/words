                        "glosses": [
                            "A felt-tip pen, of the Nikko brand or of any other brand, or the marks left by such a pen."
                        ],
                        "tags": [
                            "Australia",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "b272d374-034b-4829-a8e2-6800937ca39d",
                                "sense_id": "b19983a3-8d7f-348c-9adf-2a66ad90a727",
                                "text": "A time line had been drawn in a bright red Nikko across the entire length of the board, indicating her movements from when she left the Leagues Club to when she was found dead in the shed."
                            },
                            {
                                "example_id": "4d3a48d2-9c70-4d09-b7e9-f9be6c37ab02",
                                "sense_id": "b19983a3-8d7f-348c-9adf-2a66ad90a727",
                                "text": "I picked it up and smiled when I saw a message scrawled across the mug in black Nikko."
                            },
                            {
                                "example_id": "5bfc9561-04a1-44f2-8bfd-0c53912edeff",
                                "sense_id": "b19983a3-8d7f-348c-9adf-2a66ad90a727",
                                "text": "The headline read TANNER STONE, A MAN BIGGER THAN THE MYTH. And, lower down, there was a ring of bright red Nikko around the very last sentence."
                            }
                        ]
                    }
                ],
