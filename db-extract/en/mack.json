                                "target_senses": [
                                    {
                                        "sense_id": "342215cf-13d8-3057-beae-a2bf3d5285a2",
                                        "entry_id": "e9726f48-2972-393f-bf75-88b56bc2b472",
                                        "glosses": [
                                            "dohlížet na své nebo svěřené ovce, dobytek (či drůbež), když se samostatně krmí v neoploceném prostoru"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11c3e798-5c06-41db-99b8-67ea742b63ca",
                                                "sense_id": "342215cf-13d8-3057-beae-a2bf3d5285a2",
                                                "text": "Když jsem husy pásala, zimou jsem se třásala – teď už husy nepasu, zimou už se netřesu."
                                            },
                                            {
                                                "example_id": "69e71686-d83d-432e-bb41-4f7d55e66677",
                                                "sense_id": "342215cf-13d8-3057-beae-a2bf3d5285a2",
                                                "text": "Pásla ovečky v zeleném háječku, pásla ovečky v černém lese."
                                            },
                                            {
                                                "example_id": "ef98dc13-b950-46d0-941c-30a02f29a469",
                                                "sense_id": "342215cf-13d8-3057-beae-a2bf3d5285a2",
                                                "text": "Šimone Jonášův, miluješ-li mne více než tito? Řekl jemu: Ovšem, Pane, ty víš, že tě miluji. Dí jemu: Pasiž beránky mé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "867284a3-4421-3af8-9adc-de12fc469f23",
                                        "entry_id": "e9726f48-2972-393f-bf75-88b56bc2b472",
                                        "glosses": [
                                            "pod záminkou ochrany finančně vykořisťovat prostitutku"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6b95e71-4532-4d49-b23e-b0734788b986",
                                                "sense_id": "867284a3-4421-3af8-9adc-de12fc469f23",
                                                "text": "Pasák pase kurvu, aby sloužila všem, kmotr pase politika, aby sloužil pouze jemu!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df673969-924f-3f1f-865e-3a91243d5c0b",
                                        "entry_id": "e9726f48-2972-393f-bf75-88b56bc2b472",
                                        "glosses": [
                                            "(pást po + lokál) usilovat o, usilovně hledat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9657d934-96bd-4035-82f2-0eb21ec42cf4",
                                                "sense_id": "df673969-924f-3f1f-865e-3a91243d5c0b",
                                                "text": "Jsi-li už tak dlouho nezaměstnaný, jaktože nepaseš po každé příležitosti si přivydělat?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
