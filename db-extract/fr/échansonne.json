                        "tags": [
                            "masculine"
                        ],
                        "form": "échanson"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "615f75c8-c9bd-36b6-a61a-2ece0f72d419",
                        "entry_id": "766ba6cb-3b52-3377-83aa-e53c1314c53e",
                        "glosses": [
                            "Officière qui était chargée de servir à boire dans une cour divine, royale ou princière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d931d05-b0fa-41de-9dcc-2ee757316e88",
                                "sense_id": "615f75c8-c9bd-36b6-a61a-2ece0f72d419",
                                "text": "La gentille échansonne\nQu’on nomme Hébé, malignement sourit,\nEt de nectar à coups pressés l’entonne."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb8cbbf1-9534-30e0-a928-f43d7959a056",
                        "entry_id": "766ba6cb-3b52-3377-83aa-e53c1314c53e",
                        "glosses": [
                            "Celle qui sert à boire."
                        ],
                        "tags": [
                            "broadly",
                            "poetic",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "49a3a603-be3b-49c6-8e54-9de1ce4db202",
                                "sense_id": "fb8cbbf1-9534-30e0-a928-f43d7959a056",
                                "text": "Exacte panetière, attentive échansonne,\nLa vieille Elvire seule anime mon foyer."
                            }
                        ]
                    },
                    {
                        "sense_id": "27d64434-dbac-3716-a04a-cabb3e2f0c8f",
                        "entry_id": "766ba6cb-3b52-3377-83aa-e53c1314c53e",
                        "glosses": [
                            "Celle qui donne quelque chose comme on sert à boire."
                        ],
                        "tags": [
                            "broadly",
                            "poetic",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "06927d09-1370-4754-b94c-c5a7346496d9",
                                "sense_id": "27d64434-dbac-3716-a04a-cabb3e2f0c8f",
                                "text": "De l’âme qu’elle verse à ces buveurs d’un jour\nElle reste à jamais l’immortelle échansonne."
                            },
                            {
                                "example_id": "4e1dfe49-2df1-431c-b820-9bc79c9a57f5",
                                "sense_id": "27d64434-dbac-3716-a04a-cabb3e2f0c8f",
                                "text": "Belles personnes,\nRayonnez, fleurissez, soyez des échansonnes\nDe rêve, d’un sourire enchantez un trépas,\nInspirez-nous des vers… mais ne les jugez pas !"
                            },
                            {
                                "example_id": "97ac259a-8c8b-4f46-842d-931ceb8a4b82",
                                "sense_id": "27d64434-dbac-3716-a04a-cabb3e2f0c8f",
                                "text": "Horrible Vierge aux entrailles inaccessibles, Verseuse de poison, Echansonne de la mort, Brute sublime !"
                            }
                        ]
                    }
                ],
