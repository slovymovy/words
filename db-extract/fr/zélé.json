        "fr-extract.jsonl": [
            {
                "entry_id": "44d45ea7-8176-3778-96a4-5b55713c0cab",
                "word": "zélé",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "26eea228-42e0-4726-bbac-5d26041c22f8",
                        "entry_id": "44d45ea7-8176-3778-96a4-5b55713c0cab",
                        "tags": [
                            "plural",
