                    {
                        "sense_id": "dba30db2-70b9-3593-8901-c15b4008ac5c",
                        "entry_id": "53e185be-66ea-38ec-91e8-fa10670e7bd2",
                        "glosses": [
                            "A large garage-like structure where aircraft are kept."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04d65669-3d03-43a9-9afe-81462e45b3bf",
                                "sense_id": "dba30db2-70b9-3593-8901-c15b4008ac5c",
                                "text": "The plane taxied on over to the hangar for repairs."
                            },
                            {
                                "example_id": "1c547c5d-9e4d-40c2-8418-92dd52d6ea55",
                                "sense_id": "dba30db2-70b9-3593-8901-c15b4008ac5c",
                                "text": "By the side of it ran an open hangar upheld by a score of rough tarred posts."
                            },
                            {
                                "example_id": "e5754abf-b425-4759-98cf-08a7674f9042",
                                "sense_id": "dba30db2-70b9-3593-8901-c15b4008ac5c",
                                "text": "\"Yeah. That's only thing they're good for.\"\n \"Let's do it the other way around,\" Juanita says. She gets up and walks off the hangar deck."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1617ccd-b0c0-3c84-899a-fd013ed42bae",
