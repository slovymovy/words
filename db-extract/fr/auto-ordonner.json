                        "sense_id": "2ced3628-59ba-3859-aa73-a10569cbd9e4",
                        "entry_id": "127c3f90-a090-3908-9368-9a0f40d75c81",
                        "glosses": [
                            "Ordonner automatiquement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a13b70a4-3d63-4d6b-afb7-ccf26ef0f344",
                                "sense_id": "2ced3628-59ba-3859-aa73-a10569cbd9e4",
                                "text": "Est-il possible d'auto-ordonner les mots, à mesure que je les ajoute à la base ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "e9a94050-83d5-3fea-91f9-e60b3fc7f508",
                        "entry_id": "127c3f90-a090-3908-9368-9a0f40d75c81",
                        "glosses": [
                            "S’ordonner par soi-même."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "ec7babe0-2a20-4c72-b61c-0c78131eb4ef",
                                "sense_id": "e9a94050-83d5-3fea-91f9-e60b3fc7f508",
                                "text": "Ça sonne mieux à mon oreille que de s'auto-ordonner de faire quelque chose."
                            },
                            {
                                "example_id": "4fbb2982-03af-43b8-b6f6-b048997060d6",
                                "sense_id": "e9a94050-83d5-3fea-91f9-e60b3fc7f508",
                                "text": "Dans la mesure où la matière n'est pas intelligente, comment a-t-elle pu s'auto-ordonner ?"
                            }
                        ]
                    }
