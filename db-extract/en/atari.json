            {
                "entry_id": "2e56e4e8-4b15-3ac5-8fc8-f5eea1368b32",
                "word": "Atari",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "89c81485-b379-4a86-a31c-3bc6035fe44d",
                        "entry_id": "2e56e4e8-4b15-3ac5-8fc8-f5eea1368b32",
                        "tags": [
                            "plural"
                        ],
                        "form": "Ataris"
