                "senses": [
                    {
                        "sense_id": "f5576416-bf34-3ab9-9956-d10c38277bed",
                        "entry_id": "594ee4c9-c654-3e79-9b4d-31909a6d7425",
                        "glosses": [
                            "die Kardinalzahl, die sich aus Addition von tausend und hundert ergibt; elf mal hundert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a71baa53-b026-440a-9853-c6f0be515c06",
                                "sense_id": "f5576416-bf34-3ab9-9956-d10c38277bed",
                                "text": "„Der Mönch erklärte uns, die Skulptur sei mindestens tausendeinhundert Jahre alt.“"
                            },
                            {
                                "example_id": "8bf5e608-f682-4caf-938b-d40d5374774b",
                                "sense_id": "f5576416-bf34-3ab9-9956-d10c38277bed",
                                "text": "„Vielleicht zieht sie später in den Nordosten, in die Mandschurei, wo die Löhne zwar etwas höher — tausendundfünfzig bis tausendeinhundert Yuan - sind, die Arbeit aber auch anstrengender ist.“"
                            },
                            {
                                "example_id": "70960376-013f-4519-9f3c-cc83bbbc6ebf",
                                "sense_id": "f5576416-bf34-3ab9-9956-d10c38277bed",
                                "text": "„1873 hatte die Wertschöpfung innerhalb von dreiundzwanzig Jahren um tausendeinhundert Prozent auf 537.5 Millionen Mark zugenommen.“"
                            },
                            {
                                "example_id": "b3d9e2a3-70ae-49d4-84be-f99a525508a5",
                                "sense_id": "f5576416-bf34-3ab9-9956-d10c38277bed",
                                "text": "„In diesem Zusammenhang teilt der Abt mit, dass Bischof Meinwerk bereits zuvor seiner Kirche tausendeinhundert Hufen unter dem Vorbehalt übertragen habe, dass von einem Teil dieser Güter, deren Genuss seiner Mutter auf Lebenszeit verbleiben sollte, neue Kirchen zu stiften seien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
