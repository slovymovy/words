                    }
                ],
                "senses": [
                    {
                        "sense_id": "c40051de-6b83-3c90-924b-4b4e6a095312",
                        "entry_id": "1c81fa0a-0792-3177-8f19-f0f4c7109735",
                        "glosses": [
                            "stopień oficerski w kawalerii, będący odpowiednikiem rangi kapitana"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3bb4cbd-7cdd-423f-9fce-67ded6f242e4",
                                "sense_id": "c40051de-6b83-3c90-924b-4b4e6a095312",
                                "text": "Stopień rotmistrza jest odpowiednikiem kapitana."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ed996dc7-2115-387b-99d1-23b02cb662e1",
                        "entry_id": "1c81fa0a-0792-3177-8f19-f0f4c7109735",
                        "glosses": [
                            "oficer mający stopień rotmistrza (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d9f0ea2-f2ef-416b-972a-e33fcc78da36",
                                "sense_id": "ed996dc7-2115-387b-99d1-23b02cb662e1",
                                "text": "Po rotmistrzu Witoldzie Pileckim, bohaterze Oświęcimia, zacierano wszelkie ślady na ziemi i w polskiej historii"
                            },
                            {
                                "example_id": "4d2e6f7a-a872-4bf1-937f-5d2cbf936b3e",
                                "sense_id": "ed996dc7-2115-387b-99d1-23b02cb662e1",
                                "text": "Na Starem Mieście koło Pijarów, / Gdzie hymny Bogu lud wierny śpiewa, / Mieszka inwalid spod trzech sztandarów: / Ułański rotmistrz Jacek Cholewa"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "ebec368a-ee72-3c17-a95a-1420e2f65d47",
                        "entry_id": "1c81fa0a-0792-3177-8f19-f0f4c7109735",
                        "glosses": [
                            "dowódca roty piechoty, chorągwi jazdy lub szwadronu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fae69c0a-0a0e-496b-a21c-62e70d70cc9d",
                                "sense_id": "ebec368a-ee72-3c17-a95a-1420e2f65d47",
                                "text": "Dla rotmistrza, dowódcy szwadronu, wybrał sierżant kwaterę w nowej, najparadniejszej w całej wsi chacie Hnata"
                            },
                            {
                                "example_id": "4b553622-7718-4e2a-97e7-122bf378c8bb",
                                "sense_id": "ebec368a-ee72-3c17-a95a-1420e2f65d47",
                                "text": "I posłał do niego rotmistrza pięćdziesiątnika i pięćdziesiąt, którzy byli pod nim: który poszedł do niego, i siedzącemu na wierzchu góry, rzekł: Człowiecze Boży, król rozkazał, abyś zszedł"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5edf1c7a-5c64-4a10-9372-62eb3c024dce",
                        "source_entry_id": "1c81fa0a-0792-3177-8f19-f0f4c7109735",
