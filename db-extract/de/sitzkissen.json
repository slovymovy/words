                "senses": [
                    {
                        "sense_id": "197e17f4-fb86-36fa-9d25-5f85ce164e24",
                        "entry_id": "61aedb21-66ca-34f0-8cee-826abd512a68",
                        "glosses": [
                            "flaches Polster, das auf einer (harten) Oberfläche aufliegt und das Sitzen angenehmer macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42f48cba-f51a-4a49-8a38-46b04137065b",
                                "sense_id": "197e17f4-fb86-36fa-9d25-5f85ce164e24",
                                "text": "Für die Filmaufnahmen musste Franz-Josef lange auf einem kalten Felsen sitzen, weshalb er sich schon nach kurzer Zeit sehnlichst ein Sitzkissen herbeiwünschte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "443c76ef-d8fe-3501-b0ec-0e487e8370af",
                        "entry_id": "61aedb21-66ca-34f0-8cee-826abd512a68",
                        "glosses": [
                            "hohes, mit festem Material gefülltes Kissen, das auf dem Boden liegt und als Sitzgelegenheit dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5e86882-a748-4765-8b8d-1d1270380add",
                                "sense_id": "443c76ef-d8fe-3501-b0ec-0e487e8370af",
                                "text": "Weil die Sessel und Stühle alle belegt waren, schoben die Kinder sich die runden Sitzkissen der Großeltern vor den Fernseher und nahmen jeweils zu zweit darauf Platz."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
