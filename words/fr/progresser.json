            "senses": [
                {
                    "sense_id": "41637711-d17a-38a4-9110-2a862a3b715d",
                    "sense_definition": "Faire des progrès dans un domaine, s'améliorer.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "amelioration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis qu'il suit des cours du soir, il a beaucoup <w>progressé</w> en français.",
                            "target_lang_translations": {
                                "en": "Since he started taking evening classes, he has greatly <w>improved</w> in French.",
                                "ru": "С тех пор как он стал ходить на вечерние курсы, он заметно <w>прогрессировал</w> во французском.",
                                "de": "Seit er Abendkurse besucht, ist er im Französischen stark <w>vorangekommen</w>.",
                                "es": "Desde que asiste a clases nocturnas, ha <w>mejorado</w> mucho en francés.",
                                "zh": "自从他开始上夜校，他的法语<w>进步</w>很大。"
                            }
                        },
                        {
                            "text": "Elle s'entraîne régulièrement avec son professeur pour <w>progresser</w> rapidement.",
                            "target_lang_translations": {
                                "en": "She practises regularly with her teacher so she can <w>progress</w> quickly.",
                                "ru": "Она регулярно занимается с преподавателем, чтобы быстро <w>прогрессировать</w>.",
                                "de": "Sie übt regelmäßig mit ihrem Lehrer, damit sie schnell <w>vorankommt</w>.",
                                "es": "Ella se entrena con regularidad junto a su profesor para <w>progresar</w> rápidamente.",
                                "zh": "她经常和老师一起练习，以便尽快<w>提高</w>水平。"
                            }
                        }
                    ],
                    "synonyms": [
                        "s'améliorer"
                    ],
                    "antonyms": [
                        "régresser"
                    ],
                    "common_phrases": [
                        "progresser rapidement"
                    ],
                    "target_lang_definitions": {
                        "en": "To make progress in a field or skill; to get better at something.",
                        "ru": "Добиваться успехов в каком-либо деле или навыке; становиться лучше.",
                        "de": "In einem Bereich Fortschritte machen und besser werden.",
                        "es": "Avanzar en un ámbito o habilidad y mejorar en ella.",
                        "zh": "在某一领域取得进展，使自己变得更好。"
                    },
                    "translations": {
