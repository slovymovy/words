{
    "word_family": [
        "uraczyć",
        "poraczyć",
        "wyręka"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b59b73ee-7c67-3c6a-a2ef-cef22122e7c6",
                    "sense_definition": "zechcieć coś zrobić z łaski lub uprzejmości (często używane z ironią)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deign",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dyrektor po wielu prośbach wreszcie <w>raczył</w> podpisać nasze podanie.",
                            "target_lang_translations": {
                                "ru": "Директор после долгих просьб наконец <w>соизволил</w> подписать наше заявление."
                            }
                        },
                        {
                            "text": "Pan chyba <w>raczy</w> żartować, mówiąc, że mam za to zapłacić podwójnie.",
                            "target_lang_translations": {
                                "ru": "Вы, должно быть, <w>изволите</w> шутить, говоря, что я должен заплатить за это вдвойне."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pan raczy żartować",
                        "raczyć odpowiedzieć"
                    ],
                    "target_lang_definitions": {
                        "ru": "соизволить или снизойти сделать что-либо из милости или вежливости (часто иронично)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соизволить",
                                "target_lang_sense_clarification": "книжное или ироничное согласие сделать что-либо"
                            },
                            {
                                "target_lang_word": "соблаговолить",
                                "target_lang_sense_clarification": "снизойти, милостиво согласиться"
                            },
                            {
                                "target_lang_word": "снизойти",
                                "target_lang_sense_clarification": "оказать милость или уступку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2048895a-4936-38a1-9b9b-6de96f96b77b",
                    "sense_definition": "podawać komuś jedzenie lub napoje, częstować kogoś czymś",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "treat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gospodyni chętnie <w>raczyła</w> zebranych gości domowym ciastem i herbatą.",
                            "target_lang_translations": {
                                "ru": "Хозяйка с удовольствием <w>угощала</w> собравшихся гостей домашним пирогом и чаем."
                            }
                        },
                        {
                            "text": "Przez cały wieczór <w>raczył</w> przyjaciół starym winem z własnej piwnicy.",
                            "target_lang_translations": {
                                "ru": "Весь вечер он <w>потчевал</w> друзей старым вином из собственного погреба."
                            }
                        }
                    ],
                    "synonyms": [
                        "częstować",
                        "podejmować",
                        "fundować",
                        "stawiać"
                    ],
                    "antonyms": [
                        "odmawiać",
                        "skąpić",
                        "żałować"
                    ],
                    "common_phrases": [
                        "raczyć gości"
                    ],
                    "target_lang_definitions": {
                        "ru": "предлагать кому-либо еду или напитки, угощать кого-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угощать",
                                "target_lang_sense_clarification": "предлагать еду или питьё"
                            },
                            {
                                "target_lang_word": "потчевать",
                                "target_lang_sense_clarification": "радушно или настойчиво угощать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "589903a7-2d6b-3a04-9f4c-4840b9527419",
                    "sense_definition": "jeść lub pić coś ze smakiem, delektować się czymś",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "treat_oneself",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po długim spacerze chętnie <w>raczyliśmy</w> się gorącą czekoladą w kawiarni.",
                            "target_lang_translations": {
                                "ru": "После долгой прогулки мы с удовольствием <w>лакомились</w> горячим шоколадом в кафе."
                            }
                        },
                        {
                            "text": "W każdy niedzielny poranek <w>raczy</w> się świeżą kawą na tarasie.",
                            "target_lang_translations": {
                                "ru": "Каждое воскресное утро он <w>наслаждается</w> свежим кофе на террасе."
                            }
                        }
                    ],
                    "synonyms": [
                        "delektować się",
                        "częstować się"
                    ],
                    "common_phrases": [
                        "raczyć się kawą",
                        "raczyć się winem"
                    ],
                    "target_lang_definitions": {
                        "ru": "есть или пить что-либо с удовольствием, наслаждаться чем-либо (в сочетании с «się»)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угощаться",
                                "target_lang_sense_clarification": "есть или пить предложенное с удовольствием"
                            },
                            {
                                "target_lang_word": "лакомиться",
                                "target_lang_sense_clarification": "есть или пить что-то вкусное, деликатесы"
                            },
                            {
                                "target_lang_word": "наслаждаться",
                                "target_lang_sense_clarification": "смаковать еду или напитки"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}