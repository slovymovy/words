                        "entry_id": "9ee6ad59-75ea-38ab-a50f-2c74ffe25bda",
                        "glosses": [
                            "to fill in, to supply"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97535bae-5cb7-42fc-95e6-58d9eaea64bf",
                                "sense_id": "20809c45-6a21-3286-98cc-5c97c77b0004",
                                "text": "воспо́лнить пробе́л",
                                "translation": "to make up a deficiency; meet a lack; fill a want",
                                "english": "to make up a deficiency; meet a lack; fill a want"
                            },
                            {
                                "example_id": "fe66acf6-0264-4b2e-8a1b-0b197a7d0b6b",
                                "sense_id": "20809c45-6a21-3286-98cc-5c97c77b0004",
                                "text": "воспо́лнить пробе́лы в свои́х зна́ниях",
                                "translation": "to fill in the gaps in one's knowledge",
                                "english": "to fill in the gaps in one's knowledge"
                            },
                            {
                                "example_id": "6374bf23-de94-47bb-90e1-7fb949514fce",
                                "sense_id": "20809c45-6a21-3286-98cc-5c97c77b0004",
                                "text": "воспо́лнить поте́ри",
                                "translation": "recoup one's losses",
                                "english": "recoup one's losses"
                            }
                        ]
                    },
                    {
                        "sense_id": "53e2a0e7-be92-3979-9ffd-94b1fbd66624",
