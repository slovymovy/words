                                        "sense_id": "a827174f-f300-3472-b977-0ecb4368ad95",
                                        "entry_id": "5086c809-0b30-32f3-a3cf-c72628e98996",
                                        "glosses": [
                                            "Transvestit, transsexuelle Person oder Angehöriger einer anderen Trans-Gruppe"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10ef0298-d72f-49d7-8672-e3422c793811",
                                                "sense_id": "a827174f-f300-3472-b977-0ecb4368ad95",
                                                "text": "„Hamburgs berühmteste Transe Olivia Jones gab mit dem überdimensionalen roten Schleier die Kiez-Variante von Arielle, der Meerjungfrau.“"
                                            },
                                            {
                                                "example_id": "13aaa5cf-4b38-4058-9609-267a0643b6f6",
                                                "sense_id": "a827174f-f300-3472-b977-0ecb4368ad95",
                                                "text": "„Bevor ich als Transe beschimpft wurde, wurde ich als Kampflesbe beschimpft. Ich wusste ja früher nicht, was ein Transmann ist, dass ich ein Transmann bin.“"
                                            },
                                            {
                                                "example_id": "8f12577a-a84f-4892-9b61-e67c0cabbfb2",
                                                "sense_id": "a827174f-f300-3472-b977-0ecb4368ad95",
                                                "text": "„Am 26.10.09 wurde eine Transe auf dem Weg ins nächste Seminar von einer Frau mit folgenden Worten bedroht: ‚Du Missgeburt, Mannweiber wie du wurden schon öfter Tod (sic) an der Straße gefunden.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
