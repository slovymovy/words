                                "target_senses": [
                                    {
                                        "sense_id": "5776a048-18b0-3b67-a4c6-e5dad6a908e1",
                                        "entry_id": "2771bdef-d0bd-33fb-a297-9781a2f95384",
                                        "glosses": [
                                            "de theologische aanname dat alles is in diepste wezen goddelijk is; het goddelijke is immanent en alomvattend en het universum, de natuur en god zijn hierin hetzelfde"
                                        ],
