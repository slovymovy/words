                "senses": [
                    {
                        "sense_id": "a77a1acc-328c-3b66-a12c-181e3d10c477",
                        "entry_id": "45125c7a-4eae-3ba9-91ca-79d2f9bd488f",
                        "glosses": [
                            "To question someone after a military mission in order to obtain information (especially intelligence)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "107d636a-6558-4d29-9ab0-0511b6309dcb",
                                "sense_id": "a77a1acc-328c-3b66-a12c-181e3d10c477",
                                "text": "But, for whatever combination of reasons - and, to be fair, he'd been blasted in the face by shrapnel, was probably badly concussed, and, indeed, would actually remember nothing from the battle after he'd been hit when he was later debriefed - aside from two destroyers left behind to help Hiei, the rest of the Japanese forces withdrew north just before 0300 in the morning."
                            }
                        ]
                    },
                    {
                        "sense_id": "2adc7408-c59a-39ac-a04b-adda47839f5f",
                        "entry_id": "45125c7a-4eae-3ba9-91ca-79d2f9bd488f",
                        "glosses": [
                            "To question someone, or a group of people, after the implementation of a project, in order to learn from mistakes, etc."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "abe48ee6-6325-36f8-a9eb-02435f003a1d",
                        "entry_id": "45125c7a-4eae-3ba9-91ca-79d2f9bd488f",
                        "glosses": [
                            "To inform subjects of an experiment about what has happened in a complete and accurate manner."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6774a07a-89ad-445a-aebb-3384d20e2f85",
                        "source_entry_id": "45125c7a-4eae-3ba9-91ca-79d2f9bd488f",
                        "source_sense_description": "to question someone after a military mission in order to obtain intelligence",
                        "target_lang_word": "débriefer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "débriefer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "855603cb-8296-3b23-92f6-ee177a420e3e",
                                        "entry_id": "46f2593b-5da7-31a1-a129-4365b643cce7",
                                        "glosses": [
                                            "Faire le point, faire un bilan rapide à chaud après une action, un événement, tirer la leçon des événements, des résultats de l’intervention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd7e4edf-6af5-4ba1-ae4f-fca3773b2445",
                                                "sense_id": "855603cb-8296-3b23-92f6-ee177a420e3e",
                                                "text": "Il faut que nous débriefions après cet assaut mal préparé. Il faut que nous fassions le point sur ce qui ne va pas."
                                            },
                                            {
                                                "example_id": "a0cf2dac-e753-4735-a215-6c44b82d6ad6",
                                                "sense_id": "855603cb-8296-3b23-92f6-ee177a420e3e",
                                                "text": "– Vous avez un créneau pour que je vous débriefe ou vous êtes overbookés ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70e4be1f-4492-4869-a40a-7156c6dd9132",
                        "source_entry_id": "45125c7a-4eae-3ba9-91ca-79d2f9bd488f",
                        "source_sense_description": "to question someone after a military mission in order to obtain intelligence",
                        "target_lang_word": "(eingehend) befragen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "67b42d2b-7d69-474c-b7fd-bacf6f060849",
                        "source_entry_id": "45125c7a-4eae-3ba9-91ca-79d2f9bd488f",
                        "source_sense_description": "to question someone after a military mission in order to obtain intelligence",
                        "target_lang_word": "vernehmen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vernehmen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "faf1808a-2c48-37da-b11a-4b87efde847a",
                                        "entry_id": "4b8d2dd3-5f30-38ba-bed7-5f76c625995a",
                                        "glosses": [
                                            "Schall mit den Ohren wahrnehmen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d1bd97d-d474-4aa4-9e3d-f7ebcbd48a96",
                                                "sense_id": "faf1808a-2c48-37da-b11a-4b87efde847a",
                                                "text": "Ich lausche intensiv, aber ich kann absolut nichts vernehmen, es ist völlig still hier."
                                            },
                                            {
                                                "example_id": "870d8886-6ef6-4fca-97d1-ccb8fcb9f93d",
                                                "sense_id": "faf1808a-2c48-37da-b11a-4b87efde847a",
                                                "text": "„Erzählen Sie jetzt zu Ende! Es ist eine Dummheit. Sagen Sie mir alles. Ich bin darauf gefaßt, irgendeinen bösen Streich von Ihnen zu vernehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a36050bd-facb-35c9-a3ba-d00e37b9708e",
                                        "entry_id": "4b8d2dd3-5f30-38ba-bed7-5f76c625995a",
                                        "glosses": [
                                            "bei einer Behörde einen Verdächtigen oder einen Zeugen befragen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70cd8f94-fb50-46ee-81a1-d0859fd9a901",
                                                "sense_id": "a36050bd-facb-35c9-a3ba-d00e37b9708e",
                                                "text": "Der Richter beschloss, den Zeugen durch die Justiz seines Heimatlandes vernehmen zu lassen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
