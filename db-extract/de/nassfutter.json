                "senses": [
                    {
                        "sense_id": "69807faf-1324-3797-b124-c5304f81656c",
                        "entry_id": "9df44a80-f178-3457-9446-777fed3db3e6",
                        "glosses": [
                            "Tiernahrung, die gekochte und rohe Fleischstücke in Soße, Gelee, Pastete oder Ähnlichem enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81461786-d95f-4ac4-b855-cef46090be46",
                                "sense_id": "69807faf-1324-3797-b124-c5304f81656c",
                                "text": "Kilian kauft für seine Hündin Nassfutter einer Luxusmarke, da sie nichts anderes frisst."
                            },
                            {
                                "example_id": "ef93ced0-fc0a-43ce-b50f-27fc24eff122",
                                "sense_id": "69807faf-1324-3797-b124-c5304f81656c",
                                "text": "Die Katze Tiffy mag nur das Nassfutter vom Discounter."
                            },
                            {
                                "example_id": "f56669c9-7215-40a0-958a-77664123c283",
                                "sense_id": "69807faf-1324-3797-b124-c5304f81656c",
                                "text": "Herr Schmitz spendete dem Tierheim drei Paletten Nassfutter für die Hunde und Katzen."
                            },
                            {
                                "example_id": "e6683629-dd66-41c2-9a44-3cc416f8e6be",
                                "sense_id": "69807faf-1324-3797-b124-c5304f81656c",
                                "text": "Sobald das Nassfutter im Napf anfängt auszutrocknen, wird es nicht mehr angerührt."
                            },
                            {
                                "example_id": "8d7283cc-ff03-4555-bfa6-1bb646f9d73c",
                                "sense_id": "69807faf-1324-3797-b124-c5304f81656c",
                                "text": "Für die unterschiedlichen Geschmäcker ihrer sechs Katzen muss Susi stets ein großes Sortiment verschiedener Nassfutter vorhalten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
