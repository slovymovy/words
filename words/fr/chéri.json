                    "sense_id": "40d47e49-891c-3ddb-a1ca-e947581ca71c",
                    "sense_definition": "Terme affectueux désignant la personne que l'on aime ou un proche.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "terme_affectueux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne t'inquiète pas, mon <w>chéri</w>, nous serons bientôt arrivés à la maison.",
                            "target_lang_translations": {
                                "en": "Don't worry, <w>darling</w>, we'll be home soon.",
                                "ru": "Не волнуйся, <w>дорогой</w>, мы скоро будем дома.",
                                "nl": "Maak je geen zorgen, <w>schat</w>, we zijn zo thuis.",
                                "de": "Mach dir keine Sorge, <w>Schatz</w>, wir werden bald zu Hause sein.",
                                "pl": "Nie martw się, <w>kochanie</w>, wkrótce będziemy w domu.",
                                "it": "Non preoccuparti, <w>tesoro</w>, saremo presto a casa.",
                                "cs": "Neboj se, <w>miláčku</w>, brzy budeme doma.",
                                "tr": "Merak etme <w>canım</w>, birazdan evde olacağız.",
                                "es": "No te preocupes, <w>cariño</w>, pronto estaremos en casa.",
                                "zh": "别担心，<w>宝贝</w>，我们很快就到家了。"
                            }
                        },
                        {
                            "text": "Mon <w>chéri</w> m'a préparé un délicieux dîner pour fêter notre anniversaire.",
                            "target_lang_translations": {
                                "en": "My <w>darling</w> cooked me a delicious dinner to celebrate our anniversary.",
                                "ru": "Мой <w>дорогой</w> приготовил мне вкусный ужин, чтобы отпраздновать нашу годовщину.",
                                "nl": "Mijn <w>schat</w> heeft voor me een heerlijk diner klaargemaakt om ons jubileum te vieren.",
                                "de": "Mein <w>Schatz</w> hat mir ein köstliches Abendessen gekocht, um unseren Jahrestag zu feiern.",
                                "pl": "Mój <w>kochany</w> przygotował mi pyszną kolację, żeby uczcić naszą rocznicę.",
                                "it": "Il mio <w>tesoro</w> mi ha preparato una cena deliziosa per festeggiare il nostro anniversario.",
                                "cs": "Můj <w>miláček</w> mi připravil výbornou večeři k oslavě našeho výročí.",
                                "tr": "<w>Canım</w> yıldönümümüzü kutlamak için bana lezzetli bir akşam yemeği hazırladı.",
                                "es": "Mi <w>amor</w> me preparó una cena deliciosa para celebrar nuestro aniversario.",
                                "zh": "为了庆祝我们的纪念日，我的<w>亲爱的</w>给我准备了一顿美味的晚餐。"
                            }
                        }
                    ],
