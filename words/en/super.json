                            },
                            {
                                "target_lang_word": "совершенно",
                                "target_lang_sense_clarification": "полностью"
                            },
                            {
                                "target_lang_word": "абсолютно",
                                "target_lang_sense_clarification": "совсем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "根本",
                                "target_lang_sense_clarification": "用于否定句强调"
                            },
                            {
                                "target_lang_word": "一点也不",
                                "target_lang_sense_clarification": "完全不"
                            }
                        ]
