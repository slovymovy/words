                    "sense_definition": "iemand die misdaden pleegt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "misdadiger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie heeft de gevaarlijke <w>bandiet</w> eindelijk gearresteerd.",
                            "target_lang_translations": {
