                "senses": [
                    {
                        "sense_id": "762ccedd-d561-3093-9804-33666f051632",
                        "entry_id": "6dcb42c4-a3c5-30ce-96d5-335f955f8b75",
                        "glosses": [
                            "разг. уменьш.-ласк. к бревно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "256971b1-04d4-4d02-a12f-2ed4d6604cf1",
                                "sense_id": "762ccedd-d561-3093-9804-33666f051632",
                                "text": "Бревёшками вымощенная дорога замучила мои бока; я вылез из кибитки и пошёл пешком."
                            },
                            {
                                "example_id": "43ca0ad4-3d2e-4b5b-9295-2f22145efa4a",
                                "sense_id": "762ccedd-d561-3093-9804-33666f051632",
                                "text": "…Ни один рабочий не рубил леса с своей земли, а старался срубить бревёшко или нарубить дров в господской даче, задобривая при этом лесных сторожей."
                            },
                            {
                                "example_id": "91403ae8-2432-40ad-b9d2-80f1e4cd9ad9",
                                "sense_id": "762ccedd-d561-3093-9804-33666f051632",
                                "text": "Бойцы таскали бревёшки в укрытия, связывали их попарно старыми проводами, верёвками и даже обмотками."
                            }
                        ]
                    }
                ],
