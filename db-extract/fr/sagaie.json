        "fr-extract.jsonl": [
            {
                "entry_id": "6b529944-fafb-304f-bc86-15bffb188914",
                "word": "sagaie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f3bd02ea-3929-4b5a-b050-dde6809a31aa",
                        "entry_id": "6b529944-fafb-304f-bc86-15bffb188914",
                        "tags": [
                            "plural"
                        ],
                        "form": "sagaies"
                    },
                    {
                        "form_id": "1e58eb5b-c3fc-4f2c-8ace-e19016f71ba7",
                        "entry_id": "6b529944-fafb-304f-bc86-15bffb188914",
                        "tags": [],
                        "form": "zagaie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0830fd52-78c3-3330-bf00-bc4125843a61",
                        "entry_id": "6b529944-fafb-304f-bc86-15bffb188914",
                        "glosses": [
                            "Sorte de lance ou de javelot, arme de certaines tribus de chasseurs-cueilleurs."
                        ],
                        "tags": [
                            "Préhistoire"
                        ],
                        "examples": [
                            {
                                "example_id": "9e6985d3-5d0c-4e81-a5fd-2ede4c48df31",
                                "sense_id": "0830fd52-78c3-3330-bf00-bc4125843a61",
                                "text": "Il y avait tout, dans cette boutique ; pourtant, on n'y trouvait jamais ce que l'on cherchait... Venus pour acheter un balai, nous repartions avec un cornet à piston, ou une sagaie, celle-là même — au dire de notre ami — qui avait tué le prince Bonaparte."
                            },
                            {
                                "example_id": "2c94aa18-ab5c-426c-b686-1324cd5d4936",
                                "sense_id": "0830fd52-78c3-3330-bf00-bc4125843a61",
                                "text": "Avec la hache, la sagaie constitue l’équipement sans lequel l’homme ne se hasardera jamais en forêt."
                            },
                            {
                                "example_id": "91566226-21ae-4225-9905-8f0bc9f57029",
                                "sense_id": "0830fd52-78c3-3330-bf00-bc4125843a61",
                                "text": "La sagaie est l’arme essentielle pour la chasse. Elle est généralement constituée d’une hampe en bois portant à l’une de ses extrémités une pointe que l’on appelle «pointe de sagaie»."
                            },
                            {
                                "example_id": "99ce787d-814d-4587-993a-d8cc03ef0d4e",
                                "sense_id": "0830fd52-78c3-3330-bf00-bc4125843a61",
                                "text": "Les guerriers pygmées encerclent leur proie en la menaçant de la pointe de leur sagaie."
                            },
                            {
                                "example_id": "7873f04c-c8b3-45f1-95fb-4febc4d718af",
                                "sense_id": "0830fd52-78c3-3330-bf00-bc4125843a61",
                                "text": "Abraham se retrouva au centre du laager, envoyant sa sagaie à la volée, sans discernement. La rage et l’instinct de survie animaient son bras. Trois Tuniques Rouges tombèrent sous ses coups alors qu’au moins quinze des siens gisaient sur le sol."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de0356f6-3379-4b68-ac65-196907770a46",
                        "source_entry_id": "6b529944-fafb-304f-bc86-15bffb188914",
                        "source_sense_id": "0830fd52-78c3-3330-bf00-bc4125843a61",
                        "target_lang_word": "Assegai",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Assegai",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7d6392be-ab9b-3513-b15a-afca58a3f1b1",
                                        "entry_id": "c2af69f5-f38d-3d01-b47e-f9a62786ee1b",
                                        "glosses": [
                                            "afrikanischer Speer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c54a81e7-2253-46c0-9589-f7b0c9b1b3a9",
                                                "sense_id": "7d6392be-ab9b-3513-b15a-afca58a3f1b1",
                                                "text": "„Im Inneren des kleinen Gebäudes war es dämmrig, und als seine Augen sich an die Beleuchtung gewöhnt hatten, sah er die Assegais durch, die gebündelt in Dosen standen, Schaft nach unten, die glänzenden Klingen nach oben gerichtet.“"
                                            },
                                            {
                                                "example_id": "0932cc90-578c-43a6-a6d8-2eca27f07fac",
                                                "sense_id": "7d6392be-ab9b-3513-b15a-afca58a3f1b1",
                                                "text": "„Im Dezember kam der Vergeltungsschlag der Buren: In der Schlacht am Ncome-Fluss am 16. Dezember 1838 erwiesen sich ihr Gewehrfeuer und ihre bevorzugte Verteidigungsstellung, die Wagenburg aus Planwagen (Laager), als tödliche Kombination; von den zehntausend Zulukriegern, mit Assegais, Stoßspeeren, bewaffnet, kamen bis zu dreitausend ums Leben, während auf Seiten der Buren lediglich drei Männer verwundet wurden, darunter ihr Anführer Andries Pretorius.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8338c58e-58b7-48c8-a5b5-063298bd7e15",
                        "source_entry_id": "6b529944-fafb-304f-bc86-15bffb188914",
                        "source_sense_id": "0830fd52-78c3-3330-bf00-bc4125843a61",
                        "target_lang_word": "Speer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Speer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b23b326-ebe1-37e0-9861-b34b8bdff4b7",
                                        "entry_id": "5b23dee8-e1c9-36d8-8077-dc18ca5f9f28",
                                        "glosses": [
                                            "Waffe zum Werfen und Stechen, bestehend aus einer Stange mit einer Spitze (meist aus Metall oder Stein) an einem Ende; leichter als die nur zum Stechen bestimmte Lanze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6449b1a-3716-44aa-b219-955ecfe20102",
                                                "sense_id": "2b23b326-ebe1-37e0-9861-b34b8bdff4b7",
                                                "text": "Er hat den Hirsch eigenhändig mit dem Speer erlegt."
                                            },
                                            {
                                                "example_id": "561b05bb-ce39-46a9-a146-494409c1f37e",
                                                "sense_id": "2b23b326-ebe1-37e0-9861-b34b8bdff4b7",
                                                "text": "„Speere, Lanzen und Schilde stammten aus dem gesamten skandinavischen Raum.“"
                                            },
                                            {
                                                "example_id": "c0a3ca8e-32e1-437f-b043-08179ce7281e",
                                                "sense_id": "2b23b326-ebe1-37e0-9861-b34b8bdff4b7",
                                                "text": "„Es sind furchteinflößende Krieger mit vorzüglichen Schwertern und Speeren, Hämmern und Streitäxten.“"
                                            },
                                            {
                                                "example_id": "06e21ae7-b5b8-48fe-b0c1-e6d3755c05bf",
                                                "sense_id": "2b23b326-ebe1-37e0-9861-b34b8bdff4b7",
                                                "text": "„An Waffen besitzen sie sechs Fuß lange Bogen aus Zedernholz, die an einem Ende mit einer kurzen eisernen Spitze versehen sind und auch als Speere verwendet werden können; die Pfeile haben eiserne, steinerne oder knöcherne Widerhaken.“"
                                            },
                                            {
                                                "example_id": "c7bffd9a-de87-4be6-b18c-303586cef6c6",
                                                "sense_id": "2b23b326-ebe1-37e0-9861-b34b8bdff4b7",
                                                "text": "„Während wir Touristen das Mahl genießen, erscheinen junge Männer mit Speeren und kunstvoll geflochtenem Kopfhaar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ca0666f5-bfd9-3873-ad84-73bfd8683336",
                                        "entry_id": "5b23dee8-e1c9-36d8-8077-dc18ca5f9f28",
                                        "glosses": [
                                            "kurz für die Sportart Speerwurf oder Speerwerfen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cc1f8a2-c34f-40b8-a0bd-fdb6d8340b9d",
                                                "sense_id": "ca0666f5-bfd9-3873-ad84-73bfd8683336",
                                                "text": "Beim Speer ist er der Beste."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "faf540f5-6e2c-48f3-b957-7c4612b3fd55",
                        "source_entry_id": "6b529944-fafb-304f-bc86-15bffb188914",
                        "source_sense_id": "0830fd52-78c3-3330-bf00-bc4125843a61",
                        "target_lang_word": "Wurfspieß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wurfspieß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "359dca2f-4419-3f9d-808b-436603dec336",
                                        "entry_id": "748ae427-c5c6-3d40-ac0b-039ba34faad7",
                                        "glosses": [
                                            "spitze, eher leichte Wurfwaffe des Fußvolks, die durch die Luft auf ein Ziel (den Feind) geworfen wurde"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e68b76d-fe47-4152-9bed-3e0b46c2bd98",
                                                "sense_id": "359dca2f-4419-3f9d-808b-436603dec336",
                                                "text": "Ein mit Kraft geschleuderter Wurfspieß konnte die stärksten Platten eines Brustpanzers durchbohren."
                                            },
                                            {
                                                "example_id": "286ab358-a472-49c5-9a95-c5bd359ac237",
                                                "sense_id": "359dca2f-4419-3f9d-808b-436603dec336",
                                                "text": "Der Spanier warf den Wurfspieß nach dem Stiere und verwundete ihn damit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d4e274d-3c15-4c9b-bec7-beccbadadfd2",
                        "source_entry_id": "6b529944-fafb-304f-bc86-15bffb188914",
                        "source_sense_id": "0830fd52-78c3-3330-bf00-bc4125843a61",
                        "target_lang_word": "assegai",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assegai",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04a13621-407d-308f-a442-1c587c69c878",
                                        "entry_id": "0407d954-1061-36c0-8ac2-d87dafd7e635",
                                        "glosses": [
                                            "A slim hardwood spear or javelin with an iron tip, especially those used by Bantu peoples of Southern Africa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cad09d4-6802-4a41-bdbf-780291cb826a",
                                                "sense_id": "04a13621-407d-308f-a442-1c587c69c878",
                                                "text": "But now the Moormen, stalking o'er the strand / to guard the wat'ery stores the strangers need; / this, targe on arm and assegai in hand, / that, with his bended bow, and venom'd reed[.]"
                                            },
                                            {
                                                "example_id": "d48d13b7-cae3-43d0-aef5-0bc10fa14631",
                                                "sense_id": "04a13621-407d-308f-a442-1c587c69c878",
                                                "text": "My client welcomed the judge […] and they disappeared together into the Ethiopian card-room, which was filled with the assegais and exclamation point shields Mr. Cooke had had made at the sawmill at Beaverton."
                                            },
                                            {
                                                "example_id": "30aa5bfe-eb5b-4025-b3ef-1aaef88e3677",
                                                "sense_id": "04a13621-407d-308f-a442-1c587c69c878",
                                                "text": "Native mats covered the clay walls; a collection of spears, assegais, shields, knives was hung up in trophies."
                                            },
                                            {
                                                "example_id": "afb43399-ea93-4c9f-9b04-b6a64ebd7102",
                                                "sense_id": "04a13621-407d-308f-a442-1c587c69c878",
                                                "text": "A birdchief, bluestreaked and feathered in war panoply with his assegai, striding through a crackling canebrake over beechmast and acorns."
                                            },
                                            {
                                                "example_id": "46ad3816-40a4-44f3-8b9e-667f048b6da5",
                                                "sense_id": "04a13621-407d-308f-a442-1c587c69c878",
                                                "text": "Without a word, he took my foreskin, pulled it forward, and then, in a single motion, brought down his assegai."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "870b5062-ebd7-3e78-a5c1-59fc61c1bd9e",
                                        "entry_id": "0407d954-1061-36c0-8ac2-d87dafd7e635",
                                        "glosses": [
                                            "The tree species Curtisia dentata, the wood of which is traditionally used to make assegais."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1980547-d5dc-4d15-83d7-298731aca042",
                                                "sense_id": "870b5062-ebd7-3e78-a5c1-59fc61c1bd9e",
                                                "text": "In the clearing, built around the base of an assegai tree, stood a hut, plastered in cow dung."
                                            }
                                        ]
                                    }
                                ]
                            },
