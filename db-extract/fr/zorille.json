                    {
                        "sense_id": "ab338334-233e-378b-afe2-9e9ee6d2c530",
                        "entry_id": "124d6655-b1a1-3b1a-a948-7693e9fc65ab",
                        "glosses": [
                            "Mammifère carnivore mustélidé africain (voisin de la belette) à fourrure foncée ou noire rayée de bandes longitudinales claires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "799fc107-219f-4aef-b801-e328cdb743bd",
                                "sense_id": "ab338334-233e-378b-afe2-9e9ee6d2c530",
                                "text": "Le zorille du Cap ou ratel (Mellivora capensis), qui vit dans les régions arides et subdésertique de l'Afrique du Sud."
                            },
                            {
                                "example_id": "57c54921-d769-467f-96d0-c9ada8d6d783",
                                "sense_id": "ab338334-233e-378b-afe2-9e9ee6d2c530",
                                "text": "La zorille commune (Ictonyx striatus) est une espèce de carnivores de la famille des Mustélidés, fréquente en Afrique subsaharienne."
                            }
                        ]
                    }
                ],
                "translations": [
