                ],
                "senses": [
                    {
                        "sense_id": "03763691-47fa-3262-b950-6949d71b6715",
                        "entry_id": "88333c49-c261-3612-b8f3-af1899ac5c7a",
                        "glosses": [
                            "niedrig/niedrigste"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "57b12c58-2cba-4e24-baf4-5effa77868ae",
                                "sense_id": "03763691-47fa-3262-b950-6949d71b6715",
                                "text": "„Das durchschnittliche Jahreseinkommen der Indonesier rangiert unter den allerniedrigsten der ganzen Welt.“"
                            },
                            {
                                "example_id": "ff43868c-b1f9-4c12-bba9-8d1e397dc3f4",
                                "sense_id": "03763691-47fa-3262-b950-6949d71b6715",
                                "text": "„Überdimensional sind auch die Zahlen, mit denen man nun aufwarten kann: 160-Meter-Theken bieten Kolonialwaren an, Kühltheken von 64 Meter Länge offerieren Fisch, Geflügel und Fleischwaren laut Werbung zu ‚allerniedrigsten Preisen‘.“"
                            },
                            {
                                "example_id": "68f09b47-774e-4a7f-b68c-155c7fc4c8c1",
                                "sense_id": "03763691-47fa-3262-b950-6949d71b6715",
                                "text": "„Versäumen Sie nicht, Original Meyers Gummiband mitzunehmen, das garantiert beste Gummiband, das es je gegeben hat, unverwüstlich wie kein anderes, nicht mit Gewalt aufzuarbeiten, die allerbeste Ware zum allerniedrigsten Preis!“"
                            },
                            {
                                "example_id": "8916bb1e-3496-498f-b34e-dc30fe9624ae",
                                "sense_id": "03763691-47fa-3262-b950-6949d71b6715",
                                "text": "„Im übrigen versichert das Ministerium, gerade die allerniedrigsten Dienste in den Krankenanstalten seien heute notwendiger denn je.“"
                            },
                            {
                                "example_id": "b0203249-cab7-4024-9658-1866c93bbb6c",
                                "sense_id": "03763691-47fa-3262-b950-6949d71b6715",
                                "text": "„Der Bund rechnete mit Erlösen von 5 bis 8 Milliarden Euro – eine angesichts des wahren Wertes (die allerniedrigsten Schätzungen gingen von 100 Milliarden Euro Gesamtwert aus) freilich geradezu lächerliche Summe.“"
                            }
