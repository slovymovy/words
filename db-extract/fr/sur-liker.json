                "senses": [
                    {
                        "sense_id": "7182fd08-0188-3ea9-bdcc-c5ea4403ab29",
                        "entry_id": "710c3c4b-3344-319f-8841-caa565f1865d",
                        "glosses": [
                            "Aimer vraiment beaucoup."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "345686f4-8d8b-4919-8652-4aa91796fdea",
                                "sense_id": "7182fd08-0188-3ea9-bdcc-c5ea4403ab29",
                                "text": "Grandes roues de 19 pouces fidèles à l’authentique esprit \"dirt\" américain, accastillage de rêve, belle fabrication et performances mécaniques, en voilà une que nous avons \"sur-liké\" !"
                            },
                            {
                                "example_id": "0f786ddc-1f96-4b6b-a05e-1dd598481187",
                                "sense_id": "7182fd08-0188-3ea9-bdcc-c5ea4403ab29",
                                "text": "Souvent, les contenus qu'on y partage sont creux, ou insupportables: on veut réagir, liker, sur-liker, marquer sa surprise ou son dégoût."
                            },
                            {
                                "example_id": "56e9804b-0f41-4ccf-a0e9-173439613a22",
                                "sense_id": "7182fd08-0188-3ea9-bdcc-c5ea4403ab29",
                                "text": "Les bikers sur-likent le lieu (tonton Barbiche again !)"
                            }
                        ]
                    }
