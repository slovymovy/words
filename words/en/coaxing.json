{
    "word_family": [
        "coax",
        "coaxer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a9707366-1881-33c0-8c3a-54e9c341beef",
                    "sense_definition": "present participle and gerund of <w>coax</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "coaxing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent the afternoon <w>coaxing</w> the shy kitten out from under the sofa.",
                            "target_lang_translations": {
                                "cs": "Strávila celé odpoledne tím, že <w>lákala</w> plaché kotě zpod pohovky.",
                                "de": "Sie verbrachte den Nachmittag damit, das scheue Kätzchen unter dem Sofa <w>hervorzulocken</w>."
                            }
                        },
                        {
                            "text": "He succeeded in <w>coaxing</w> a smile from the sad child.",
                            "target_lang_translations": {
                                "cs": "Podařilo se mu <w>vyloudit</w> úsměv na tváři smutného dítěte.",
                                "de": "Es gelang ihm, dem traurigen Kind ein Lächeln <w>abzuringen</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "přítomné příčestí a gerundium slovesa přemlouvat",
                        "de": "Partizip Präsens und Gerundium von coax; jemanden mit sanfter Überredung oder Geduld zu etwas bewegen"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "přemlouvání",
                                "target_lang_sense_clarification": "činnost spočívající v mírném naléhání"
                            },
                            {
                                "target_lang_word": "lákání",
                                "target_lang_sense_clarification": "snaha někoho nebo něco přimět k pohybu či akci"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "überreden",
                                "target_lang_sense_clarification": "sanft überzeugen"
                            },
                            {
                                "target_lang_word": "locken",
                                "target_lang_sense_clarification": "durch Zuspruch oder Reize anziehen"
                            },
                            {
                                "target_lang_word": "gut zureden",
                                "target_lang_sense_clarification": "jemanden durch freundliche Worte ermutigen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a7728fba-c45e-3a42-98be-d533457687e7",
                    "sense_definition": "Having a gentle, persuasive, or encouraging quality.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "coaxing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a <w>coaxing</w> tone to convince him to join the party.",
                            "target_lang_translations": {
                                "cs": "Použila <w>přemlouvající</w> tón, aby ho přesvědčila, ať jde na večírek.",
                                "de": "Sie benutzte einen <w>schmeichlerischen</w> Tonfall, um ihn davon zu überzeugen, mit zur Party zu kommen."
                            }
                        },
                        {
                            "text": "The teacher gave a <w>coaxing</w> smile to encourage the nervous student.",
                            "target_lang_translations": {
                                "cs": "Učitel se na nervózního studenta <w>povzbudivě</w> usmál.",
                                "de": "Die Lehrerin schenkte der nervösen Schülerin ein <w>aufmunterndes</w> Lächeln, um sie zu ermutigen."
                            }
                        }
                    ],
                    "synonyms": [
                        "persuasive",
                        "cajoling",
                        "enticing"
                    ],
                    "common_phrases": [
                        "coaxing tone",
                        "coaxing voice"
                    ],
                    "target_lang_definitions": {
                        "cs": "mající jemnou, přesvědčivou nebo povzbuzující povahu",
                        "de": "eine sanfte, überredende oder ermutigende Wirkung habend"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "přemlouvající",
                                "target_lang_sense_clarification": "vyjadřující snahu o přesvědčení"
                            },
                            {
                                "target_lang_word": "naléhavý",
                                "target_lang_sense_clarification": "v kontextu jemného, ale vytrvalého povzbuzování"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "schmeichlerisch",
                                "target_lang_sense_clarification": "einschmeichelnd, überredend"
                            },
                            {
                                "target_lang_word": "einschmeichelnd",
                                "target_lang_sense_clarification": "sanft gewinnend"
                            },
                            {
                                "target_lang_word": "überredend",
                                "target_lang_sense_clarification": "zu überzeugen suchend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ab6226cf-2b01-354c-81a8-64271f340be2",
                    "sense_definition": "The act of persuading someone gently or persistently to do something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "coaxing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After much <w>coaxing</w>, the toddler finally agreed to eat his vegetables.",
                            "target_lang_translations": {
                                "cs": "Po dlouhém <w>přemlouvání</w> batole konečně souhlasilo, že sní svou zeleninu.",
                                "de": "Nach vielem <w>gutem Zureden</w> erklärte sich das Kleinkind schließlich bereit, sein Gemüse zu essen."
                            }
                        },
                        {
                            "text": "It took a lot of <w>coaxing</w> to get the old engine to start again.",
                            "target_lang_translations": {
                                "cs": "Dalo hodně <w>přemlouvání</w>, než starý motor znovu naskočil.",
                                "de": "Es brauchte eine Menge <w>Überredungskunst</w>, um den alten Motor wieder zum Laufen zu bringen."
                            }
                        }
                    ],
                    "synonyms": [
                        "persuasion",
                        "cajolery",
                        "enticement"
                    ],
                    "target_lang_definitions": {
                        "cs": "akt jemného nebo vytrvalého přesvědčování někoho k něčemu",
                        "de": "der Akt, jemanden sanft oder beharrlich zu etwas zu bewegen oder zu überreden"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "přemlouvání",
                                "target_lang_sense_clarification": "obecný výraz pro vytrvalé přesvědčování"
                            },
                            {
                                "target_lang_word": "naléhání",
                                "target_lang_sense_clarification": "vytrvalá snaha dosáhnout souhlasu"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Überreden",
                                "target_lang_sense_clarification": "das sanfte Einwirken auf jemanden"
                            },
                            {
                                "target_lang_word": "Zureden",
                                "target_lang_sense_clarification": "freundliches, beharrliches Ermutigen"
                            },
                            {
                                "target_lang_word": "Locken",
                                "target_lang_sense_clarification": "das Anlocken oder Verleiten"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}