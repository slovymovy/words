                        "glosses": [
                            "En grand nombre, de manière nombreuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54eb2dc0-fbce-4bf5-98af-e7083e06779e",
                                "sense_id": "1f031321-ee98-3144-9df5-171afe1c521c",
                                "text": "Pour montrer qu’il n’était point dupe de la dignité que semblait vouloir conférer à Marcelle une toilette nombreusement boutonnée, Joseph lui prit brusquement la taille et chercha ses lèvres. Mais la jeune fille s’enfuit."
                            },
                            {
                                "example_id": "1429f4a6-9200-4ad7-a7c4-45c0b335f813",
                                "sense_id": "1f031321-ee98-3144-9df5-171afe1c521c",
                                "text": "Les cafards copulent sans grâce, et sans joie apparente ; mais ils copulent nombreusement, et leurs mutations génétiques sont rapides ; nous ne pouvons absolument rien contre les cafards."
                            }
                        ]
                    }
