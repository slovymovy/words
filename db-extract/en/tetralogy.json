                                            {
                                                "example_id": "a2c6a321-f1c5-4e14-8d60-4d8c130f6acc",
                                                "sense_id": "bd161858-1aab-39aa-a173-9e7189877b2e",
                                                "text": "Der Autor hat den letzten Band seiner Tetralogie fertiggestellt."
                                            },
                                            {
                                                "example_id": "2409d201-207b-4c61-984f-ab7c2427f6f2",
                                                "sense_id": "bd161858-1aab-39aa-a173-9e7189877b2e",
                                                "text": "„Der Walter-Verlag, der das Werk Döblins seit dessen Tod betreut, brachte zwar eine noch nicht abgeschlossene Gesamtausgabe des Dichters und seine Jubiläumausgabe zum 100. Geburtstag heraus, aber das unbequemste Werk Döblins erschien bisher nicht dort, es kam 1978 vollständig als Tetralogie beim Deutschen Taschenbuch-Verlag heraus.“"
                                            }
                                        ],
