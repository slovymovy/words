                "senses": [
                    {
                        "sense_id": "dca62a94-ed01-3515-88de-1b6240bfe9e2",
                        "entry_id": "ef1f47e4-a7ca-3204-8a01-b0723bd52584",
                        "glosses": [
                            "antike Wasseruhr, die nach dem Prinzip einer Sanduhr funktioniert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15b1537b-1087-410c-b707-0e1fe3214c79",
                                "sense_id": "dca62a94-ed01-3515-88de-1b6240bfe9e2",
                                "text": "Im antiken Griechenland wurde die Klepsydra unter anderem zur Begrenzung der Redezeit verwendet."
                            },
                            {
                                "example_id": "67d67b95-2013-43c5-8326-bce2a44b8545",
                                "sense_id": "dca62a94-ed01-3515-88de-1b6240bfe9e2",
                                "text": "Welch ein langer Weg von jenen Tempelaffen zu diesem mechanischen kostbaren Kunstwerk, geht es Cäsar durch den Sinn, während sein Blick auf der Klepsydra ruht …"
                            },
                            {
                                "example_id": "8a5272a1-3494-4dd5-b3a0-1e791c0eb616",
                                "sense_id": "dca62a94-ed01-3515-88de-1b6240bfe9e2",
                                "text": "Bei Gerichtsverhandlungen bediente man sich der klepsydra, der Wasseruhr, mit der dem Sprecher die Redezeit zugemessen wurde; …"
                            },
                            {
                                "example_id": "003b0d60-7c09-4d69-9de2-71e5b6077575",
                                "sense_id": "dca62a94-ed01-3515-88de-1b6240bfe9e2",
                                "text": "In Babylon und Ägypten waren die Wasser- und Sonnenuhren in frühester Zeit erfunden worden, aber erst Plato führte eine als Uhr wirklich verwendbare Form der Klepsydra in Athen ein, und noch später übernahm man die Sonnenuhren, lediglich als unwesentliches Gerät des Alltags, ohne daß sie das antike Lebensgefühl im geringsten verändert hätten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dbe357b9-ae1d-4148-acbe-9c24833b1c19",
                        "source_entry_id": "ef1f47e4-a7ca-3204-8a01-b0723bd52584",
                        "source_sense_id": "dca62a94-ed01-3515-88de-1b6240bfe9e2",
                        "source_sense_description": "antike Wasseruhr, die nach dem Prinzip einer Sanduhr funktioniert",
                        "target_lang_word": "clepsydra",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clepsydra",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "583c484f-4b1a-3740-816b-4cc20bae7838",
                                        "entry_id": "a5473c25-82ea-39d6-9d2d-b230a2e50cec",
                                        "glosses": [
                                            "Synonym of water clock, especially (historical) ancient Greek and Roman forms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b8910ca-6a8d-4e18-a295-40ad75b48c1d",
                                                "sense_id": "583c484f-4b1a-3740-816b-4cc20bae7838",
                                                "text": "They sat among the choiring clepsydras of the evening garden, time elapsing in a dozen ways, allowing their cigars to go out, keeping a companionable silence."
                                            },
                                            {
                                                "example_id": "fa3589a6-71ca-4949-8581-d2b31e83080c",
                                                "sense_id": "583c484f-4b1a-3740-816b-4cc20bae7838",
                                                "text": "\"The dull, unflavoured drops from life's clepsydra\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da51f768-401b-47af-8db5-91a6496a808e",
                        "source_entry_id": "ef1f47e4-a7ca-3204-8a01-b0723bd52584",
                        "source_sense_id": "dca62a94-ed01-3515-88de-1b6240bfe9e2",
                        "source_sense_description": "antike Wasseruhr, die nach dem Prinzip einer Sanduhr funktioniert",
                        "target_lang_word": "clepsydre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clepsydre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "10357021-6a99-3179-9b44-69a92a0d7c72",
                                        "entry_id": "0e60b12b-5f2e-3db2-b0da-eca8d799cc43",
                                        "glosses": [
                                            "Horloge qui indique la marche du temps par l’écoulement d’une certaine quantité d’eau."
                                        ],
                                        "tags": [
                                            "Horlogerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec91ad78-a470-482a-95bd-d03dd963f4ed",
                                                "sense_id": "10357021-6a99-3179-9b44-69a92a0d7c72",
                                                "text": "Les anciens se servaient ordinairement de clepsydres pour mesurer le temps."
                                            },
                                            {
                                                "example_id": "61c148b9-9ba0-448b-bb1c-646edcbd3e1e",
                                                "sense_id": "10357021-6a99-3179-9b44-69a92a0d7c72",
                                                "text": "Mais Daniel Soutif, directeur du développement culturel du Centre et commissaire de l’exposition, tenait au symbole : la clepsydre est l’un des plus anciens instruments de mesure du temps et elle réunit deux notions, « l’écoulement continu », celui de l’eau qu'elle contient, et sa graduation, « tentative de réduire ce flux au commensurable »."
                                            },
                                            {
                                                "example_id": "400c5367-a443-49b7-abb0-0b8a8071de86",
                                                "sense_id": "10357021-6a99-3179-9b44-69a92a0d7c72",
                                                "text": "La clepsydre est l’un des plus anciens instruments découverts pour mesurer la durée du temps."
                                            },
                                            {
                                                "example_id": "cbd1cbbc-10e5-4a80-a448-bb8f253715b7",
                                                "sense_id": "10357021-6a99-3179-9b44-69a92a0d7c72",
                                                "text": "En fait, avoir 40 ans, c’est vivre en permanence dans « Fort Boyard » : moi, j’ai l’impression qu’Olivier Minne ne cesse de me souffler dans l’oreille : « La clepsydre... la clepsydre... Sors ! Sors ! »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
