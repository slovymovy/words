                                "target_senses": [
                                    {
                                        "sense_id": "40b182f1-07e6-3218-bc0d-f5f96c53c8f4",
                                        "entry_id": "d8a3ba9b-6f85-3ce8-8374-a42e1ac4bf6e",
                                        "glosses": [
                                            "termine, concetto o costrutto introdotto di recente nella lingua"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0b92112-8e7d-4d85-a735-03b27e04dde3",
                                                "sense_id": "40b182f1-07e6-3218-bc0d-f5f96c53c8f4",
                                                "text": "il neologismo può essere riferito a nuovi concetti come nel lemma allunaggio"
                                            },
                                            {
                                                "example_id": "234fb7d1-a9fc-4c67-83c0-a7406b7db6bf",
                                                "sense_id": "40b182f1-07e6-3218-bc0d-f5f96c53c8f4",
                                                "text": "il neologismo è inerente ad oggetti o prodotti innovativi come musicassetta"
                                            },
                                            {
                                                "example_id": "7a822df3-f55d-4c5f-83ce-0e4f43fd3f7f",
                                                "sense_id": "40b182f1-07e6-3218-bc0d-f5f96c53c8f4",
                                                "text": "il neologismo può assumere nuovi significati come la \"pantera della polizia\" cioè l'auto di pronto intervento della Polizia"
                                            },
                                            {
                                                "example_id": "e4d1520d-b33d-4385-9a43-85390b8c177e",
                                                "sense_id": "40b182f1-07e6-3218-bc0d-f5f96c53c8f4",
                                                "text": "il neologismo può derivare da parole straniere come scannerizzare"
                                            },
                                            {
                                                "example_id": "33230db4-8a9e-41c7-b6a0-b07ce7a60eb8",
                                                "sense_id": "40b182f1-07e6-3218-bc0d-f5f96c53c8f4",
                                                "text": "il neologismo può essere creato dalla composizione di parole già esistenti come mangia e nastri da cui il lemma mangianastri"
                                            },
                                            {
                                                "example_id": "09004bda-6172-4c91-b70f-eeffc1432b5e",
                                                "sense_id": "40b182f1-07e6-3218-bc0d-f5f96c53c8f4",
                                                "text": "il neologismo può essere frutto di parole totalmente nuove come quark"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
