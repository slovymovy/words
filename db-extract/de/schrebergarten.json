                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd0f42c5-a51e-4920-91aa-52e47fd417d9",
                                                "sense_id": "faf14f18-fa2e-341d-ad07-fbb8476ca289",
                                                "text": "En France, depuis la fin des années 1980, l’entrepreneuriat social se développe sous la forme d’entreprises d’insertion, de jardins familiaux, de crèches parentales, de services d'aides à domicile, etc."
                                            }
                                        ]
                                    }
                                ]
