                                        "examples": [
                                            {
                                                "example_id": "110f4365-bab2-4a8b-abe6-36e5fdb86db2",
                                                "sense_id": "ac605ace-d532-392a-8f56-4af942b55262",
                                                "text": "Zu der Zeit wurden in Reihenuntersuchungen die Lungen aller Angestellten der Produktionsabteilungen durchleuchtet."
                                            },
                                            {
                                                "example_id": "6bb233bd-485d-40d2-af38-7db0d34ed172",
                                                "sense_id": "ac605ace-d532-392a-8f56-4af942b55262",
                                                "text": "Mit dem Computertomographen werden die archäologischen Fundstücke zuerst durchleuchtet, auch, um dadurch die Datierung zu erleichtern."
                                            },
                                            {
                                                "example_id": "f61c1fac-f048-40b3-acd1-304444c18f59",
                                                "sense_id": "ac605ace-d532-392a-8f56-4af942b55262",
                                                "text": "Spätestens am Flugplatz wirst du durchleuchtet, und dann fällt die Waffe auf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f15826f-580a-375e-913b-22b88a54b666",
                                        "entry_id": "6bc98b00-b797-30ba-b1ff-2034f3ba6442",
                                        "glosses": [
                                            "sorgsam viele Aspekte einer Sache oder Dinge im Zusammenhang mit einer Person anschauen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82f3ec1e-c562-4d6f-bdc4-ee9c2faf6db3",
                                                "sense_id": "6f15826f-580a-375e-913b-22b88a54b666",
                                                "text": "Hast du wirklich vor, den beruflichen Hintergrund deines Schwiegervaters in spe zu durchleuchten?"
                                            },
                                            {
                                                "example_id": "70b0d9f9-fae5-4245-8762-a24dde23af08",
                                                "sense_id": "6f15826f-580a-375e-913b-22b88a54b666",
                                                "text": "Am erfolgversprechendsten ist es, wenn Sie zuerst die gefundenen Hindernisse und Probleme auf ihre Ursachen hin durchleuchten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
