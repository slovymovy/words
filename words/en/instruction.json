                            },
                            {
                                "target_lang_word": "предписание",
                                "target_lang_sense_clarification": "официальное требование"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "instrukcja",
                                "target_lang_sense_clarification": "wytyczne lub polecenie działania"
                            },
                            {
                                "target_lang_word": "polecenie",
                                "target_lang_sense_clarification": "nakaz wykonania czegoś"
                            },
                            {
                                "target_lang_word": "wskazówka",
                                "target_lang_sense_clarification": "zalecenie jak postępować"
                            },
                            {
                                "target_lang_word": "wytyczna",
                                "target_lang_sense_clarification": "oficjalne zalecenie"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指示",
                                "target_lang_sense_clarification": "上级给下级的命令"
                            },
                            {
                                "target_lang_word": "指令",
                                "target_lang_sense_clarification": "正式的命令"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2bda2d9e-053d-3fec-8749-9c619ca9c091",
                    "sense_definition": "The act of instructing, teaching, or providing with information or knowledge.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university provides excellent <w>instruction</w> in modern languages.",
                            "target_lang_translations": {
                                "ru": "Университет обеспечивает отличное <w>обучение</w> современным языкам.",
                                "pl": "Uniwersytet zapewnia doskonałe <w>nauczanie</w> języków nowożytnych.",
                                "zh": "这所大学在现代语言方面提供优秀的<w>教学</w>。"
                            }
                        },
                        {
                            "text": "She gives private <w>instruction</w> to students who need extra help.",
                            "target_lang_translations": {
                                "ru": "Она дает частные <w>уроки</w> студентам, которым нужна дополнительная помощь.",
                                "pl": "Ona udziela prywatnych <w>lekcji</w> uczniom, którzy potrzebują dodatkowej pomocy.",
                                "zh": "她为需要额外帮助的学生提供私人<w>指导</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "teaching",
                        "education"
                    ],
                    "common_phrases": [
                        "give instruction",
                        "receive instruction",
                        "medium of instruction"
                    ],
                    "target_lang_definitions": {
