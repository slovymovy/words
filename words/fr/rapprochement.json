                    "sense_definition": "Action de mettre en relation ou de comparer des faits, des indices ou des idées afin d'établir un lien logique.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police n'a pas tardé à faire le <w>rapprochement</w> entre les deux cambriolages."
                        },
                        {
                            "text": "Le professeur a voulu établir un <w>rapprochement</w> clair entre ces deux périodes historiques."
                        }
                    ],
                    "common_phrases": [
