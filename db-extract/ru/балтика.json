                "senses": [
                    {
                        "sense_id": "9c1f0b48-aae8-3f01-99b8-5a0a02fd5cc7",
                        "entry_id": "feab5b3f-1f12-3c00-aaf8-f5b15e19bac8",
                        "glosses": [
                            "обиходное название Балтийского моря"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "172bbdb0-1af5-4c48-9b70-814b185e180b",
                                "sense_id": "9c1f0b48-aae8-3f01-99b8-5a0a02fd5cc7",
                                "text": "Когда на море подымается волна, то слышен не шум прибоя, а хрустенье льда и шорох оседающего снега. Балтика зимой пустынна и угрюма."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "593a02b5-2641-4f76-8e6c-e44b2f2de31a",
                        "source_entry_id": "feab5b3f-1f12-3c00-aaf8-f5b15e19bac8",
                        "source_sense_id": "9c1f0b48-aae8-3f01-99b8-5a0a02fd5cc7",
                        "target_lang_word": "Baltic Sea",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baltic Sea",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78149f23-728a-3a05-9f94-df1c65b3c8d6",
                                        "entry_id": "07b31e1c-6e03-3e88-99fd-80139bf2795a",
                                        "glosses": [
                                            "A sea in Northern Europe, an arm of the Atlantic enclosed by Denmark, Estonia, Finland, Germany, Latvia, Lithuania, Poland, Russia and Sweden."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cdb32b2e-4c76-4ad9-ad5f-f4e195b4b400",
                        "source_entry_id": "feab5b3f-1f12-3c00-aaf8-f5b15e19bac8",
                        "source_sense_id": "9c1f0b48-aae8-3f01-99b8-5a0a02fd5cc7",
                        "target_lang_word": "Ostsee",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ostsee",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2955c534-71cc-3cbf-a93b-e79914ea4db6",
                                        "entry_id": "b1dead72-3e9c-3229-b7d4-1ce0029b5919",
                                        "glosses": [
                                            "das Meer zwischen Mitteleuropa, Nordeuropa und Osteuropa"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7934a754-3186-4e97-ad86-bbb590d753b6",
                                                "sense_id": "2955c534-71cc-3cbf-a93b-e79914ea4db6",
                                                "text": "Die Ostsee wird spät im Jahr warm."
                                            },
                                            {
                                                "example_id": "6ee25657-986e-4643-a45b-0bc5e239c2ae",
                                                "sense_id": "2955c534-71cc-3cbf-a93b-e79914ea4db6",
                                                "text": "Unseren letzten Urlaub verbrachten wir an der Ostsee."
                                            },
                                            {
                                                "example_id": "d9410845-9dce-4b65-affa-58c1ad66d948",
                                                "sense_id": "2955c534-71cc-3cbf-a93b-e79914ea4db6",
                                                "text": "Das Lagerfeuer an der Ostsee erlosch erst am frühen Morgen."
                                            },
                                            {
                                                "example_id": "ca06fe71-87dd-44cf-8877-c260b7cd7482",
                                                "sense_id": "2955c534-71cc-3cbf-a93b-e79914ea4db6",
                                                "text": "„Die Recknitz trug später beim Vordringen der Ostsee auch zur Füllung der Boddenkette bei und ist auch heute noch ihr bedeutenster Binnenzufluß.“"
                                            },
                                            {
                                                "example_id": "355dd114-b75e-4abe-a45b-af310b9d9279",
                                                "sense_id": "2955c534-71cc-3cbf-a93b-e79914ea4db6",
                                                "text": "„An der Ostsee gab es keine Sirenen und keine Bomben.“"
                                            },
                                            {
                                                "example_id": "a8852dcc-dc2e-4a72-aca6-ec3fe5f315ba",
                                                "sense_id": "2955c534-71cc-3cbf-a93b-e79914ea4db6",
                                                "text": "„Am Tag nach dem Feuer auf einem mit Öl beladenen Tankschiff auf der Ostsee beginnt die Suche nach der Ursache.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
