                        "glosses": [
                            "in kochendem Wasser oder in einem Eierkocher zum Frühstück gekochtes Ei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ad98755-1161-4155-bdfb-382d0181f1bc",
                                "sense_id": "2eaaeb72-d282-3f2f-8c6f-bbd2a463f48a",
                                "text": "Sein Frühstücksei ist fest gekocht."
                            },
                            {
                                "example_id": "f512642e-314c-4b5b-81d4-ba9529794357",
                                "sense_id": "2eaaeb72-d282-3f2f-8c6f-bbd2a463f48a",
                                "text": "„Die Freiheitsliebe beschränkt sich in Deutschland häufig auf die Klage über zu viel Bürokratie, doch sobald etwas im Fleisch oder Frühstücksei auftaucht, was dort nicht hingehört, ergeht der Ruf nach strikteren Kontrollen und Vorschriften.“"
                            },
                            {
                                "example_id": "12756e25-54a1-4f01-af5b-a71668a72c0a",
                                "sense_id": "2eaaeb72-d282-3f2f-8c6f-bbd2a463f48a",
                                "text": "„Schließlich ist dem Frühstücksei auch eine gewisse völkerverbindende Unschuld nicht abzusprechen.“"
                            }
                        ],
