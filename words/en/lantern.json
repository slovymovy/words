{
    "word_family": [
        "lanterned"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "82261007-3299-3227-b682-70f93fb8460e",
                    "sense_definition": "A portable case with transparent sides used to protect a light source while illuminating the surroundings.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "light_source",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traveler carried a <w>lantern</w> to light the dark path through the woods.",
                            "target_lang_translations": {
                                "zh": "旅行者提着一盏<w>灯笼</w>，照亮了穿过树林的黑暗小路。"
                            }
                        },
                        {
                            "text": "They hung a <w>lantern</w> on the porch to welcome guests during the evening.",
                            "target_lang_translations": {
                                "zh": "他们在门廊上挂了一盏<w>灯笼</w>，以迎接晚间到来的客人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lamp"
                    ],
                    "common_phrases": [
                        "carry a lantern",
                        "light a lantern"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种带有透明侧壁的便携式灯具，用于保护光源并照亮周围环境。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "灯笼",
                                "target_lang_sense_clarification": "指传统的便携式照明工具。"
                            },
                            {
                                "target_lang_word": "提灯",
                                "target_lang_sense_clarification": "指可以手提的灯具。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8328c3c4-4324-33ce-80fe-56ab8b015d3c",
                    "sense_definition": "A specialized metal casing with a lens used in theater or film to direct light onto a stage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "light_source",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician adjusted the <w>lantern</w> to focus the beam on the lead actor.",
                            "target_lang_translations": {
                                "zh": "技术人员调整了<w>聚光灯</w>，将光束聚焦在主演身上。"
                            }
                        },
                        {
                            "text": "Several stage <w>lanterns</w> were mounted above the stage to provide bright illumination.",
                            "target_lang_translations": {
                                "zh": "舞台上方安装了几盏<w>舞台灯</w>，以提供明亮的照明。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spotlight",
                        "floodlight"
                    ],
                    "common_phrases": [
                        "stage lantern"
                    ],
                    "target_lang_definitions": {
                        "zh": "戏剧或电影中使用的带有透镜的金属外壳灯具，用于将光线聚焦在舞台上。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "聚光灯",
                                "target_lang_sense_clarification": "指舞台上用于聚焦光线的灯具。"
                            },
                            {
                                "target_lang_word": "舞台灯",
                                "target_lang_sense_clarification": "指舞台照明设备。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba328182-6818-3521-ae68-680ce49cc7d7",
                    "sense_definition": "An architectural structure on a roof designed to admit light and air into the building interior.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old library features a beautiful wooden <w>lantern</w> that brightens the central hall.",
                            "target_lang_translations": {
                                "zh": "这座古老的图书馆设有一个精美的木制<w>天窗</w>，照亮了中央大厅。"
                            }
                        },
                        {
                            "text": "Sunlight poured through the roof <w>lantern</w> into the atrium below.",
                            "target_lang_translations": {
                                "zh": "阳光透过屋顶的<w>天窗</w>倾泻进下方的中庭。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "roof lantern"
                    ],
                    "target_lang_definitions": {
                        "zh": "屋顶上的一种建筑结构，旨在让光线和空气进入建筑物内部。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "天窗",
                                "target_lang_sense_clarification": "指屋顶上用于采光和通风的结构。"
                            },
                            {
                                "target_lang_word": "采光顶",
                                "target_lang_sense_clarification": "指建筑顶部用于采光的结构。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d13619b5-2aab-3298-be01-c7cf556f83e3",
                    "sense_definition": "A small cupola or turret placed on top of a larger dome to provide light or decoration.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cathedral dome is topped by an ornate <w>lantern</w> visible from miles away.",
                            "target_lang_translations": {
                                "zh": "大教堂的圆顶顶部有一个华丽的<w>灯亭</w>，几英里外都能看到。"
                            }
                        },
                        {
                            "text": "Architects often design a <w>lantern</w> to add height and elegance to a large dome.",
                            "target_lang_translations": {
                                "zh": "建筑师经常设计一个<w>灯亭</w>，为大型圆顶增添高度和优雅感。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cupola"
                    ],
                    "target_lang_definitions": {
                        "zh": "放置在大型圆顶顶部的小型穹顶或塔楼，用于采光或装饰。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "灯亭",
                                "target_lang_sense_clarification": "指圆顶建筑顶部的采光小亭。"
                            },
                            {
                                "target_lang_word": "穹顶采光塔",
                                "target_lang_sense_clarification": "指圆顶顶部的装饰性采光结构。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "537821fd-3caf-3bb8-9974-99224d1a2c2e",
                    "sense_definition": "To provide or equip a space or structure with a lantern.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lighthouse keeper had to <w>lantern</w> the tower to ensure ships could see the coast.",
                            "target_lang_translations": {
                                "zh": "灯塔管理员必须为塔楼<w>装灯</w>，以确保船只能够看到海岸。"
                            }
                        },
                        {
                            "text": "They decided to <w>lantern</w> the garden path for the evening party.",
                            "target_lang_translations": {
                                "zh": "他们决定为花园小径<w>装灯</w>，以迎接晚会。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "为空间或结构提供或配备灯笼。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "装灯",
                                "target_lang_sense_clarification": "指安装灯具。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a4df7ec0-69af-37cb-a918-9f292de9a205",
                    "sense_definition": "Describing a facial feature that is large, prominent, and squarish in shape.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The character was described as having a <w>lantern</w> jaw that made him look stern.",
                            "target_lang_translations": {
                                "zh": "这个角色被描述为长着一个<w>方阔的</w>下巴，这使他看起来很严厉。"
                            }
                        },
                        {
                            "text": "He had a <w>lantern</w> nose that dominated his entire face.",
                            "target_lang_translations": {
                                "zh": "他长着一个<w>方阔的</w>鼻子，占据了他整张脸。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lantern jaw"
                    ],
                    "target_lang_definitions": {
                        "zh": "形容面部特征大、突出且呈方形。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "方阔的",
                                "target_lang_sense_clarification": "形容下巴或脸型宽大方正。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}