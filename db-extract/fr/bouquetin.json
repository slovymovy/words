                    {
                        "form_id": "c7ba10f3-ea62-47fe-ab16-aaf09cbf17f7",
                        "entry_id": "1a458a90-f77f-3e19-8560-87906e9bb085",
                        "tags": [
                            "feminine"
                        ],
                        "form": "étagne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7bedcfc7-0de9-3a2e-a935-0355e38144e4",
                        "entry_id": "1a458a90-f77f-3e19-8560-87906e9bb085",
                        "glosses": [
                            "Espèce de chèvre sauvage vivant en montagne ou en plaine, dont le mâle a de longues cornes à bourrelets et recourbées vers l'arrière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c238dfce-774a-429a-8c95-7874a707c339",
                                "sense_id": "7bedcfc7-0de9-3a2e-a935-0355e38144e4",
                                "text": "Il voulait saisir la crinière de Jehol quand il vit enfin descendre, en dansant, une famille de bouquetins."
                            },
                            {
                                "example_id": "f02c7b46-c5b7-4243-9e39-4793f8480bfa",
                                "sense_id": "7bedcfc7-0de9-3a2e-a935-0355e38144e4",
                                "text": "Le lieu exact de l'attaque n'a pas été précisé, mais l'île de Moni est reconnue comme étant un sanctuaire de cerfs dociles, de bouquetins de Crète et d'autres animaux sauvages, qui sont les seuls résidents permanents de la région."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e20e260-7eae-3602-bd9f-4e93a41e0a01",
                        "entry_id": "1a458a90-f77f-3e19-8560-87906e9bb085",
                        "glosses": [
                            "Variante de bouquetin des Alpes (caprin)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8eb720cc-94a9-3bf1-ac57-078a4776acf5",
                        "entry_id": "1a458a90-f77f-3e19-8560-87906e9bb085",
                        "glosses": [
                            "Meuble représentant l’animal du même nom dans les armoiries. Il se blasonne comme le bouc dont il se distingue par la forme des cornes. À rapprocher de bouc, chamois, chèvre et mouflon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "440604c0-9458-4325-abef-741555ee2d99",
                                "sense_id": "8eb720cc-94a9-3bf1-ac57-078a4776acf5",
                                "text": "D’argent au bouquetin de sable rampant, accorné d’or et vilené de gueules, qui est de Gais en Suisse → voir illustration « armoiries avec un bouquetin »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c99cce6-379b-4a55-9e20-09cef382e5fc",
                        "source_entry_id": "1a458a90-f77f-3e19-8560-87906e9bb085",
                        "target_lang_word": "Steinbock",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steinbock",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4b2b904-8c8f-3b01-b911-408833a49416",
                                        "entry_id": "26566168-6bee-33e1-b53c-c993c0d122f7",
                                        "glosses": [
                                            "Hochgebirgstier mit langen, gebogenen Hörnern aus der Gattung der Ziegen (Capra hibex)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28aa3364-b36c-4fce-b190-2e40c001e4ff",
                                                "sense_id": "f4b2b904-8c8f-3b01-b911-408833a49416",
                                                "text": "Als sie das Felsentor durchschritten stand über ihnen auf einem schmalen Vorsprung ein wunderschöner Steinbock."
                                            },
                                            {
                                                "example_id": "c2e1fd8d-cc90-4d44-8606-ce90988594d4",
                                                "sense_id": "f4b2b904-8c8f-3b01-b911-408833a49416",
                                                "text": "„Sie liefen den Steinböcken hinterher, verirrten sich und verdursteten in den Bergen.“"
                                            },
                                            {
                                                "example_id": "b2b8062e-ccf5-4c5c-9ade-779a077482f9",
                                                "sense_id": "f4b2b904-8c8f-3b01-b911-408833a49416",
                                                "text": "„Im Gegensatz zu den Menschen mögen die ausschließlich im Simien-Gebirge heimischen äthiopischen Steinböcke die schlauen Affen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "99157ec7-105d-34ab-b72b-9a5eab9e46de",
                                        "entry_id": "26566168-6bee-33e1-b53c-c993c0d122f7",
                                        "glosses": [
                                            "ein Sternbild"
                                        ],
                                        "tags": [
                                            "nur Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f08ab8b4-35ae-4126-a2e4-865e06e61fdf",
                                                "sense_id": "99157ec7-105d-34ab-b72b-9a5eab9e46de",
                                                "text": "Der Mars steht jetzt im Steinbock."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "394c18a3-23d3-3dc7-b1a6-22baed37bd30",
                                        "entry_id": "26566168-6bee-33e1-b53c-c993c0d122f7",
                                        "glosses": [
                                            "das zehnte Tierkreiszeichen oder ein in diesem Zeichen Geborener"
                                        ],
                                        "tags": [
                                            "Astrologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5ad0a82-2d8a-496b-bb9e-6847eb2946ec",
                                                "sense_id": "394c18a3-23d3-3dc7-b1a6-22baed37bd30",
                                                "text": "Meine Freundin ist Steinbock."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "806dc867-986a-3acd-bf15-b612d7628c4b",
                                        "entry_id": "26566168-6bee-33e1-b53c-c993c0d122f7",
                                        "glosses": [
                                            "gemeine Figur, die einen Steinbock ^([1]) darstellt"
                                        ],
                                        "tags": [
                                            "Heraldik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b81d2fa-92a3-4a72-ac64-992f3637b33f",
