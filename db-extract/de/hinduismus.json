                    {
                        "translation_id": "a8ce6767-17ec-4e49-a892-7974eece3245",
                        "source_entry_id": "b614a987-3cac-33d6-b36e-51cbbbf31d58",
                        "source_sense_id": "5811ff77-b48c-3a9d-af27-5263f39db09b",
                        "source_sense_description": "eine der Weltreligionen",
                        "target_lang_word": "Hinduism",
