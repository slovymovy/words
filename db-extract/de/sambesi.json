                                        "sense_id": "c98d919d-aad6-38dc-b208-a765178acb8c",
                                        "entry_id": "fdc0f26a-571a-36bb-8d59-d313ff7f38b9",
                                        "glosses": [
                                            "A river in Southern Africa, flowing south and west from Zambia through east Angola and Zambia and then east along the border between Zambia and Zimbabwe into and through central Mozambique to the Indian Ocean."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0b8ef7b-e658-4229-b764-c26175667107",
                        "source_entry_id": "c18c29e7-4601-37d9-a5f3-c1df26a09aff",
                        "source_sense_id": "41df1faf-38e2-3417-834c-04cffed1cb9e",
                        "source_sense_description": "Fluss in Afrika, der in den Indischen Ozean fließt",
                        "target_lang_word": "Zambèze",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zambèze",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9f808b89-29c8-306d-a8a0-ccfaece7581e",
                                        "entry_id": "45299ac1-3976-3175-abc8-47762cd440d5",
                                        "glosses": [
                                            "Très long fleuve d’Afrique australe, prenant sa source en Zambie, drainant également l’Angola, la Namibie, le Botswana, le Zimbabwe, le Malawi, le Kenya et le Mozambique, et se jetant dans l’océan Indien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7861cf0a-04c3-4a0c-a0be-3ade65dd0393",
                                                "sense_id": "9f808b89-29c8-306d-a8a0-ccfaece7581e",
                                                "text": "Le Zambèze est le 4ᵉ fleuve du continent africain par la longueur, après le Nil, le Congo et le Niger."
                                            },
                                            {
                                                "example_id": "8b03d9a4-689c-4a17-92a8-c4575b70396a",
                                                "sense_id": "9f808b89-29c8-306d-a8a0-ccfaece7581e",
                                                "text": "Sofala, Zofala, Zefala Nom propre d’une ville de la côte orientale des Cafres, en la Basse Éthiopie. Sofala, Zofala. Elle est capitale du Royaume de Sofala, & située sur une petite île près de l’embouchure de la rivière de Zambèze. Cette ville a quelques fortifications, & une citadelle construite par les Portugais, qui en sont les maîtres."
                                            },
                                            {
                                                "example_id": "59f780fd-e180-40ed-981c-ca427f044d2b",
                                                "sense_id": "9f808b89-29c8-306d-a8a0-ccfaece7581e",
                                                "text": "Le Zambère des Portugais est le Zambèze des géographes modernes. Les Portugais le prirent d’abord pour le lac de Ptolémée, prétendue source du Nil et de beaucoup d’autres fleuves, et crurent découvrir, dans les montagnes qui l’entourent, les montagnes de la Lune des anciens. […] Le Zambèze, qui tire son nom d’un peuple cafre, est navigable dans le pays de Chicowa."
                                            }
                                        ]
                                    }
                                ]
                            }
