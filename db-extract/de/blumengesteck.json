                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bc39f21-07d7-4179-abbd-bd42fa2475e0",
                                "sense_id": "bdd63e53-8e64-3b9b-a9cc-55e02850d7f0",
                                "text": "„Im großen Festsaal, am Vormittag von der Hausdame und ihren Mädchen mit einer Fülle von Blumengestecken und Girlanden dekoriert, wurden die Dessert-Teller abgeräumt.“"
                            },
                            {
                                "example_id": "f7869397-b0f1-4f5c-963f-2fe63c456eb2",
                                "sense_id": "bdd63e53-8e64-3b9b-a9cc-55e02850d7f0",
                                "text": "„Die Särge wirkten klein und kompakt, sie verschwanden fast unter den vielen Blumengestecken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
