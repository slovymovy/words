{
    "word_family": [
        "nudger"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4292935b-554f-333a-80e8-51f14e2e7a58",
                    "sense_definition": "To push against someone or something gently, especially with the elbow, to get attention or give a signal.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had to <w>nudge</w> him with her elbow to wake him up during the long meeting.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>толкнуть</w> его локтем, чтобы разбудить во время долгого совещания."
                            }
                        },
                        {
                            "text": "I saw her <w>nudge</w> her friend to point out the celebrity sitting at the next table.",
                            "target_lang_translations": {
                                "ru": "Я видел, как она <w>подтолкнула</w> подругу, чтобы показать на знаменитость за соседним столиком."
                            }
                        }
                    ],
                    "synonyms": [
                        "poke",
                        "tap",
                        "jog",
                        "push",
                        "prod",
                        "elbow"
                    ],
                    "common_phrases": [
                        "nudge someone gently",
                        "nudge with an elbow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слегка толкнуть кого-либо или что-либо, особенно локтем, чтобы привлечь внимание или подать сигнал."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толкнуть локтем",
                                "target_lang_sense_clarification": "чтобы привлечь внимание"
                            },
                            {
                                "target_lang_word": "подтолкнуть",
                                "target_lang_sense_clarification": "слегка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cda073d3-863b-3c1d-92b0-1043c22890a9",
                    "sense_definition": "To move something slightly or to influence someone toward a particular action or decision in a subtle way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government is trying to <w>nudge</w> people toward healthier eating habits by placing fruit at eye level.",
                            "target_lang_translations": {
                                "ru": "Правительство пытается <w>подтолкнуть</w> людей к более здоровому питанию, располагая фрукты на уровне глаз."
                            }
                        },
                        {
                            "text": "If you <w>nudge</w> the table just a little bit, the vase might fall off the edge.",
                            "target_lang_translations": {
                                "ru": "Если ты хоть немного <w>заденешь</w> стол, ваза может упасть с края."
                            }
                        }
                    ],
                    "synonyms": [
                        "shift",
                        "push",
                        "bump"
                    ],
                    "common_phrases": [
                        "nudge someone toward",
                        "nudge into action"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слегка сдвинуть что-либо или мягко подтолкнуть кого-либо к определенному действию или решению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подталкивать",
                                "target_lang_sense_clarification": "к решению или действию"
                            },
                            {
                                "target_lang_word": "сдвинуть",
                                "target_lang_sense_clarification": "немного"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcb1b17b-f319-335f-a206-d1cccb73cadf",
                    "sense_definition": "To approach or come very close to a particular level, amount, or state.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "proximity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The temperature is expected to <w>nudge</w> thirty degrees by the middle of the afternoon.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что к середине дня температура <w>приблизится</w> к тридцати градусам."
                            }
                        },
                        {
                            "text": "The company's annual profits are <w>nudging</w> the ten million mark for the first time.",
                            "target_lang_translations": {
                                "ru": "Годовая прибыль компании впервые <w>подбирается</w> к отметке в десять миллионов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nudge the mark",
                        "nudge the record"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приблизиться или подойти вплотную к определенному уровню, количеству или состоянию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приближаться",
                                "target_lang_sense_clarification": "к отметке или уровню"
                            },
                            {
                                "target_lang_word": "подбираться",
                                "target_lang_sense_clarification": "к значению"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6a6c338b-249d-3c56-b133-b1338ef29fc5",
                    "sense_definition": "A gentle push, usually with the elbow, intended to get someone's attention.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave his brother a quick <w>nudge</w> to tell him it was time to leave.",
                            "target_lang_translations": {
                                "ru": "Он быстро <w>толкнул</w> брата локтем, давая понять, что пора уходить."
                            }
                        },
                        {
                            "text": "A gentle <w>nudge</w> was all she needed to realize she was being too loud.",
                            "target_lang_translations": {
                                "ru": "Легкого <w>толчка</w> было достаточно, чтобы она поняла, что ведет себя слишком шумно."
                            }
                        }
                    ],
                    "synonyms": [
                        "tap",
                        "poke",
                        "push",
                        "prod"
                    ],
                    "common_phrases": [
                        "give someone a nudge",
                        "a gentle nudge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкий толчок, обычно локтем, предназначенный для привлечения чьего-либо внимания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легкий толчок",
                                "target_lang_sense_clarification": "локтем"
                            },
                            {
                                "target_lang_word": "тычок",
                                "target_lang_sense_clarification": "локтем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e197a35e-ce4b-3147-9297-70f1b81f5392",
                    "sense_definition": "A subtle encouragement or indirect suggestion intended to influence someone's behavior or choices.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new policy provides a helpful <w>nudge</w> for employees to save more for their retirement.",
                            "target_lang_translations": {
                                "ru": "Новая политика служит полезным <w>стимулом</w> для сотрудников больше откладывать на пенсию."
                            }
                        },
                        {
                            "text": "Sometimes a small <w>nudge</w> in the right direction is better than a direct command.",
                            "target_lang_translations": {
                                "ru": "Иногда небольшая <w>подсказка</w> в правильном направлении лучше прямого приказа."
                            }
                        }
                    ],
                    "synonyms": [
                        "push"
                    ],
                    "common_phrases": [
                        "nudge in the right direction",
                        "social nudge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкое поощрение или косвенное внушение, направленное на влияние на чье-либо поведение или выбор."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подсказка",
                                "target_lang_sense_clarification": "мягкое напоминание"
                            },
                            {
                                "target_lang_word": "стимул",
                                "target_lang_sense_clarification": "мягкое подталкивание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c83b3097-9ff1-3c26-aa01-f6084255243b",
                    "sense_definition": "A digital notification or alert in messaging software used to attract the attention of another user.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I sent him a <w>nudge</w> on the chat app because he hadn't replied to my message.",
                            "target_lang_translations": {
                                "ru": "Я отправил ему <w>уведомление</w> в чате, потому что он не ответил на мое сообщение."
                            }
                        },
                        {
                            "text": "The screen shook when she received a <w>nudge</w> from her colleague.",
                            "target_lang_translations": {
                                "ru": "Экран задрожал, когда она получила <w>сигнал</w> от коллеги."
                            }
                        }
                    ],
                    "common_phrases": [
                        "send a nudge"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Цифровое уведомление или оповещение в мессенджерах, используемое для привлечения внимания другого пользователя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нудл",
                                "target_lang_sense_clarification": "в мессенджерах"
                            },
                            {
                                "target_lang_word": "уведомление",
                                "target_lang_sense_clarification": "для привлечения внимания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27e67281-f065-3d76-a90e-b34632da12cc",
                    "sense_definition": "A single step rotation of a reel in a slot machine, often awarded as a bonus to the player.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gambling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I used my last <w>nudge</w> to line up the three cherry symbols on the machine.",
                            "target_lang_translations": {
                                "ru": "Я использовал свой последний <w>сдвиг</w>, чтобы выстроить три символа вишни на автомате."
                            }
                        },
                        {
                            "text": "The fruit machine gave me two <w>nudges</w> after I landed on the bonus square.",
                            "target_lang_translations": {
                                "ru": "Игровой автомат дал мне два <w>бонусных хода</w> после того, как я попал на призовой сектор."
                            }
                        }
                    ],
                    "common_phrases": [
                        "use a nudge"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "UK"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поворот барабана игрового автомата на один шаг, часто предоставляемый игроку в качестве бонуса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдвиг",
                                "target_lang_sense_clarification": "барабана в игровом автомате"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4f37df0-f2ec-3ac5-a8c8-35d28569f10a",
                    "sense_definition": "An alternative spelling of <w>nudzh</w>; a person who is a persistent pest or a nag.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop being such a <w>nudge</w> and let me finish my work in peace.",
                            "target_lang_translations": {
                                "ru": "Перестань быть таким <w>занудой</w> и дай мне спокойно закончить работу."
                            }
                        },
                        {
                            "text": "She is a bit of a <w>nudge</w> when it comes to keeping the kitchen perfectly clean.",
                            "target_lang_translations": {
                                "ru": "Она та еще <w>приставала</w>, когда дело касается идеальной чистоты на кухне."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in Jewish-American contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который постоянно надоедает или ворчит."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зануда",
                                "target_lang_sense_clarification": "назойливый человек"
                            },
                            {
                                "target_lang_word": "приставала",
                                "target_lang_sense_clarification": "разг."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
