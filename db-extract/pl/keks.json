                    {
                        "translation_id": "c4b9a0b7-0e76-47fd-87c8-96cd09a6d0f9",
                        "source_entry_id": "894bf04c-cf1e-3e8f-b00e-53215db3682c",
                        "source_sense_id": "2576ab79-51dd-388c-8398-a7fc9d802dae",
