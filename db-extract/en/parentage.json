    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "098a86b0-ed12-309b-a451-81206303f8f0",
                "word": "parentage",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9f83230a-d67d-44a4-991d-acff513730de",
                        "entry_id": "098a86b0-ed12-309b-a451-81206303f8f0",
                        "tags": [
                            "plural"
                        ],
                        "form": "parentages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5a08b5b5-2cee-3b15-9cfb-4b5ee4c1aba5",
                        "entry_id": "098a86b0-ed12-309b-a451-81206303f8f0",
                        "glosses": [
                            "The identity and nature of one's parents, and in particular, the legitimacy of one's birth."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1af6b372-b88c-45aa-ac1a-a81dc617cdf7",
                                "sense_id": "5a08b5b5-2cee-3b15-9cfb-4b5ee4c1aba5",
                                "text": "I am a Lord, for so my deedes ſhall prooue,\nAnd yet a ſhepheard by my Parentage: […]"
                            },
                            {
                                "example_id": "6e0dd7c2-b792-4179-9b6f-4211e3d9b3e1",
                                "sense_id": "5a08b5b5-2cee-3b15-9cfb-4b5ee4c1aba5",
                                "text": "English gentlemen, after all, do not discriminate against each other on the grounds of parentage, only of breeding."
                            }
                        ]
                    },
                    {
                        "sense_id": "457ff0f3-9502-391d-aceb-3de25b82ec9b",
                        "entry_id": "098a86b0-ed12-309b-a451-81206303f8f0",
                        "glosses": [
                            "The social quality of one's class in society."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "74f09b96-c0fb-417b-9d30-d3c3eeec7fc8",
                                "sense_id": "457ff0f3-9502-391d-aceb-3de25b82ec9b",
                                "text": "My fortunes parentage — good parentage — To equal mine! — was it not thus? What say you?"
                            }
                        ]
                    },
                    {
                        "sense_id": "c7ec7fc4-475d-34df-a42d-c40c5c1a355b",
                        "entry_id": "098a86b0-ed12-309b-a451-81206303f8f0",
                        "glosses": [
                            "Origin; derivation."
                        ],
                        "tags": [
                            "countable",
                            "figuratively",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1993f23c-58ef-4d2c-aaae-5bdc5e9aa588",
                        "source_entry_id": "098a86b0-ed12-309b-a451-81206303f8f0",
                        "source_sense_description": "identity of one's parents",
                        "target_lang_word": "parenté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parenté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ec68596-b5d4-33c7-b3b6-ec0058b8e75e",
                                        "entry_id": "e896e8e0-c871-3e70-9e14-490c14fd5a52",
                                        "glosses": [
                                            "Relation de consanguinité ou d’alliance qui unit deux personnes entre elles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "251db0db-75e1-4c4b-9b77-67129c1554f6",
                                                "sense_id": "7ec68596-b5d4-33c7-b3b6-ec0058b8e75e",
                                                "text": "Le noyau d’une kabila est constitué par des bonda reliées entre elles : leur relation se fonde sur la parenté et un lien qui s’est affermi au fil du temps."
                                            },
                                            {
                                                "example_id": "2436bfa8-d6fc-455a-8d8b-7f85abf605f5",
                                                "sense_id": "7ec68596-b5d4-33c7-b3b6-ec0058b8e75e",
                                                "text": "Il y a un lien de parenté entre un père et sa fille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08af265e-76dc-36fb-832c-0862701cc591",
                                        "entry_id": "e896e8e0-c871-3e70-9e14-490c14fd5a52",
                                        "glosses": [
                                            "Lignée commune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fb34f80-4b2a-4774-98c5-236717df8015",
                                                "sense_id": "08af265e-76dc-36fb-832c-0862701cc591",
                                                "text": "Les espèces géographiquement les plus voisines sont en Afrique et dans l’Inde, mais n'ont pas de parenté rapprochée avec les européennes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99cdd0f8-8617-36c8-a1bb-738b752ed6ab",
                                        "entry_id": "e896e8e0-c871-3e70-9e14-490c14fd5a52",
                                        "glosses": [
                                            "Parentèle, famille élargie, ensemble des parents et alliés d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db0ecd8a-0e91-4b2f-a7bf-0ce19939d51c",
                                                "sense_id": "99cdd0f8-8617-36c8-a1bb-738b752ed6ab",
                                                "text": "Il a une nombreuse parenté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f68787cd-283b-3af8-882b-437f195128a8",
                                        "entry_id": "e896e8e0-c871-3e70-9e14-490c14fd5a52",
                                        "glosses": [
                                            "Proximité entre deux êtres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffa711c3-9ab5-4646-813e-f5eb5c06fd03",
                                                "sense_id": "f68787cd-283b-3af8-882b-437f195128a8",
                                                "text": "Parenté spirituelle entre parrain ou marraine et filleul."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc7926ca-5b54-348a-98e4-ee255c18434e",
                                        "entry_id": "e896e8e0-c871-3e70-9e14-490c14fd5a52",
                                        "glosses": [
                                            "Ressemblance, point commun entre deux choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24f301d0-b54a-4a76-b157-3f5830db606b",
                                                "sense_id": "bc7926ca-5b54-348a-98e4-ee255c18434e",
                                                "text": "On remarquera la parenté qui existe entre le visage de la Joconde et certaines sculptures égyptiennes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "parenté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30070305-9d0d-34ce-a3d3-8f5fc502ba9d",
                                        "entry_id": "11d8a8a5-c539-3dea-8c96-c9926eab6d9e",
                                        "glosses": [
                                            "Apparenté, qui a des liens de parenté avec."
                                        ],
                                        "tags": [
                                            "Congo-Brazzaville"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a4075fb-aa52-4207-8002-4ebe83a6672a",
                                                "sense_id": "30070305-9d0d-34ce-a3d3-8f5fc502ba9d",
                                                "text": "Tous les malfrats qui, sous prétexte d’être parenté au professeur, occupaient illégalement les maisons d’honnêtes citoyens, sans payer de loyer, ont déguerpi."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "parenté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8dbef275-417c-3211-b733-c5d80b710734",
                                        "entry_id": "5afb53b9-024d-3376-9011-caecc7878032",
                                        "glosses": [
                                            "Participe passé masculin singulier de parenter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
