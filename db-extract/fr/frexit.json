        "fr-extract.jsonl": [
            {
                "entry_id": "4fad9f77-4dbe-35ef-b6d1-dbf6fa10b7a4",
                "word": "Frexit",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "009cf72e-81d1-366b-909f-c49cad6b6a9b",
                        "entry_id": "4fad9f77-4dbe-35ef-b6d1-dbf6fa10b7a4",
                        "glosses": [
                            "Scénario de sortie de la France de l’Union européenne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84097aa6-80a2-4c64-8f6a-7764d062e99f",
                                "sense_id": "009cf72e-81d1-366b-909f-c49cad6b6a9b",
                                "text": "Pas sûr, si l’on considère que les partisans d’un référendum sur le « Frexit » (rupture entre la France et l’UE) sont loin de vouloir quitter l’Union.,"
                            },
                            {
                                "example_id": "06144824-9189-4f93-ad20-4926609e34e3",
                                "sense_id": "009cf72e-81d1-366b-909f-c49cad6b6a9b",
                                "text": "Le scénario d’un « Frexit », une sortie de la France de l’euro et de l’Union européenne, apparaissait relativement improbable il y a encore quelques semaines."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf28d8c7-81d1-404f-889f-d1fa9f1be957",
                        "source_entry_id": "4fad9f77-4dbe-35ef-b6d1-dbf6fa10b7a4",
                        "source_sense_id": "009cf72e-81d1-366b-909f-c49cad6b6a9b",
                        "target_lang_word": "Frexit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1740a6e5-93ce-4500-ac17-846536bc68c7",
                        "source_entry_id": "4fad9f77-4dbe-35ef-b6d1-dbf6fa10b7a4",
                        "source_sense_id": "009cf72e-81d1-366b-909f-c49cad6b6a9b",
                        "target_lang_word": "Frexit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frexit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bace8133-6cb2-3b25-9f53-2bde1bf21d75",
                                        "entry_id": "82125ff0-f728-3d6d-950c-1beacfa6c283",
                                        "glosses": [
                                            "The possible act of France leaving the European Union."
                                        ],
                                        "tags": [
                                            "French"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "667dd4b5-89f4-4c42-af1b-002971dfbf56",
                                                "sense_id": "bace8133-6cb2-3b25-9f53-2bde1bf21d75",
                                                "text": "And while brexit is still on the agenda, after the European Parliament elections from May 22-25 it is quite legitimate to ask ourselves the question whether there is a danger of losing France - in other words is there a risk of a frexit?"
                                            },
                                            {
                                                "example_id": "1829b005-98f8-421f-92a1-6b6a780eb550",
                                                "sense_id": "bace8133-6cb2-3b25-9f53-2bde1bf21d75",
                                                "text": "The Front National won the French elections with calls for an immediate restoration of the franc and a referendum on Frexit."
                                            },
                                            {
                                                "example_id": "501488a6-b7e3-4db1-be1e-d7e79ec79750",
                                                "sense_id": "bace8133-6cb2-3b25-9f53-2bde1bf21d75",
                                                "text": "If Brexit happens can Frexit — France exiting the existing EU — be far behind?"
                                            },
                                            {
                                                "example_id": "50507458-417e-4a52-841c-48a1bd0c84b7",
                                                "sense_id": "bace8133-6cb2-3b25-9f53-2bde1bf21d75",
                                                "text": "In France, opinion polls show that the far-right National Front, led by self-styled \"Madame Frexit\" Marine Le Pen, is now more popular than the center-right Republicans or ruling Socialists."
                                            },
                                            {
                                                "example_id": "99c733dc-146a-4cfa-a55d-f1128693a482",
                                                "sense_id": "bace8133-6cb2-3b25-9f53-2bde1bf21d75",
                                                "text": "It no longer advocates Frexit from the EU or leaving the euro currency."
                                            },
                                            {
                                                "example_id": "1d954479-258b-4611-8a2b-126256dfc633",
                                                "sense_id": "bace8133-6cb2-3b25-9f53-2bde1bf21d75",
                                                "text": "Her European policy is Frexit by stealth – unilaterally reducing payments to the EU budget and breaking EU laws she does not like."
                                            },
                                            {
                                                "example_id": "9cc2cf5a-64bc-4ed9-9195-6281be36aa79",
                                                "sense_id": "bace8133-6cb2-3b25-9f53-2bde1bf21d75",
                                                "text": "In a sort of shadow “Frexit”, the one-time member of the European Parliament calls for “disobeying” EU deficit rules and regulations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
