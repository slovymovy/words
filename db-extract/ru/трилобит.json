                        "cross_references": [
                            {
                                "target_word": "Trilobit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f242796c-0622-3d93-ae55-cf447ed6d3aa",
                                        "entry_id": "1a7b119a-6bf9-354c-9215-9693c4a6ba9e",
                                        "glosses": [
                                            "Vertreter einer Klasse ausgestorbener mariner Gliederfüßer"
                                        ],
                                        "tags": [
                                            "Archäozoologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf7f04b2-9063-490d-be63-f182c3b8fb35",
                                                "sense_id": "f242796c-0622-3d93-ae55-cf447ed6d3aa",
                                                "text": "Die Trilobiten sind wichtige Leitfossilien."
                                            },
                                            {
                                                "example_id": "b093595d-674e-405b-aee2-df8aa0f12b80",
                                                "sense_id": "f242796c-0622-3d93-ae55-cf447ed6d3aa",
                                                "text": "Trilobiten haben einen Rückenpanzer und gut entwickelte Augen."
                                            },
                                            {
                                                "example_id": "47b3592c-ef51-463d-b962-a9bd9a47e046",
                                                "sense_id": "f242796c-0622-3d93-ae55-cf447ed6d3aa",
                                                "text": "Die Trilobiten sind eine sehr charakteristische Gruppe für das Paläozoikum."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ee3adbc-adf6-4691-8150-957cc33afc58",
                        "source_entry_id": "8ee1dd36-5620-3ab6-a0b4-519e400363c1",
                        "source_sense_id": "d5a8894a-3537-3439-8b01-0cfbddaa1c72",
                        "target_lang_word": "trilobiet",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trilobiet",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f4c436cb-b410-3af5-af59-01fae48dcd88",
                                        "entry_id": "07944455-45ff-37bd-8d36-6089d9506fde",
                                        "glosses": [
                                            "een klasse uitgestorven geleedpotigen, die in zee leefden in de periode van 521 tot 250 miljoen jaar geleden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55fceb18-9c2a-4743-aa85-827e4b236b79",
                                                "sense_id": "f4c436cb-b410-3af5-af59-01fae48dcd88",
                                                "text": "Verschillende keren in de wereldgeschiedenis hebben grote rampen het toenmalige leven bijna volledig uitgeroeid. Vraag maar aan de dinosaurussen, of de trilobieten."
                                            },
                                            {
                                                "example_id": "72e5fac7-4fe9-46e4-8f9c-155643503b12",
                                                "sense_id": "f4c436cb-b410-3af5-af59-01fae48dcd88",
                                                "text": "Je denkt: vast gemaakt van plastic. Maar hij is echt, dit perfect bewaarde fossiel van een prehistorische zeekakkerlak genaamd een trilobiet. Deze week meldde een Zweedse geoloog ontdekt te hebben waarom de trilobieten 466 miljoen jaar geleden opeens enorm in soortenrijkdom toenamen, net als veel andere levensvormen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44384878-a515-41d0-810c-4d7d3e522ac1",
                        "source_entry_id": "8ee1dd36-5620-3ab6-a0b4-519e400363c1",
                        "source_sense_id": "d5a8894a-3537-3439-8b01-0cfbddaa1c72",
                        "target_lang_word": "trylobity",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "065c56b6-c385-4de0-9732-0e25bae18f41",
                        "source_entry_id": "8ee1dd36-5620-3ab6-a0b4-519e400363c1",
                        "source_sense_id": "d5a8894a-3537-3439-8b01-0cfbddaa1c72",
