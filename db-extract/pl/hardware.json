                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9a5ee1a-665f-4162-9291-fe08ce585baf",
                        "source_entry_id": "9a542afb-e042-3ebd-8136-baa0e133e3ba",
                        "source_sense_id": "43c7f5f5-84d7-3a31-bec2-21e99ea4d388",
                        "target_lang_word": "железо",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "железо",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ae25f4b6-cf94-35a6-8b62-bc38d0fd407e",
                                        "entry_id": "341aa73a-f6d3-3bf8-ab45-03ed92901dce",
                                        "glosses": [
                                            "хим. химический элемент с атомным номером 26, обозначается химическим символом Fe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfee2143-5fed-4cfc-92b7-4141c255f009",
                                                "sense_id": "ae25f4b6-cf94-35a6-8b62-bc38d0fd407e",
                                                "text": "Организм взрослого человека содержит около 4 г железа, из которых приблизительно 57 % входит в состав гемоглобина."
                                            },
                                            {
                                                "example_id": "e9c9109c-ff4c-4723-b759-99e27cd5bd7d",
                                                "sense_id": "ae25f4b6-cf94-35a6-8b62-bc38d0fd407e",
                                                "text": "Расчёт атомных количеств элементов в составе данного граната позволяет предположить, что всё железо, присутствующее в минерале, находится в трёхвалентном состоянии."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "558d06f7-f2c6-36f4-9b32-fdfdd1aa29fd",
                                        "entry_id": "341aa73a-f6d3-3bf8-ab45-03ed92901dce",
                                        "glosses": [
                                            "простое вещество, твёрдый ковкий металл серебристо-белого цвета, основной компонент чугуна и стали"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39e453b1-c06f-48af-b46b-4bf47b133ba0",
                                                "sense_id": "558d06f7-f2c6-36f4-9b32-fdfdd1aa29fd",
                                                "text": "Мировая практика показывает, что в электросталеплавильном производстве для получения высококачественных марок стали применение чугуна имеет большие преимущества по сравнению с использованием других чистых загружаемых материалов, таких, как губчатое железо."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d67b2aac-da6b-3382-8950-134204bb087b",
                                        "entry_id": "341aa73a-f6d3-3bf8-ab45-03ed92901dce",
                                        "glosses": [
                                            "разг. любые сплавы железа [2]; также (редко) сплавы других металлов белого или серого цвета"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcd6e124-f600-49ba-b1da-9d202eb36968",
                                                "sense_id": "d67b2aac-da6b-3382-8950-134204bb087b",
                                                "text": "— Меня? — крикнул Азамат в бешенстве, и железо детского кинжала зазвенело об кольчугу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cb2b9b0-7ac5-37b9-b040-9cf50bdd7a9e",
                                        "entry_id": "341aa73a-f6d3-3bf8-ab45-03ed92901dce",
                                        "glosses": [
                                            "собир., спец. железные предметы, изделия из железа [2] и [3]"
                                        ],
                                        "tags": [
                                            "только ед. ч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8854507-aad5-46d5-afce-9534f271121f",
                                                "sense_id": "0cb2b9b0-7ac5-37b9-b040-9cf50bdd7a9e",
                                                "text": "Прокатился такой звук, какой бывает, когда с грузовика сбрасывают на землю листовое железо."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eddee9ea-6e14-3e89-8e20-66c84419f497",
                                        "entry_id": "341aa73a-f6d3-3bf8-ab45-03ed92901dce",
                                        "glosses": [
                                            "мед. лекарственный препарат, содержащий соединения железа [1]"
                                        ],
                                        "tags": [
                                            "только ед. ч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9157c23c-d911-4776-820e-b9ec6615a403",
                                                "sense_id": "eddee9ea-6e14-3e89-8e20-66c84419f497",
                                                "text": "Он принимает железо от малокровия."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d098cb45-64eb-39be-9636-6ff52a29ac96",
                                        "entry_id": "341aa73a-f6d3-3bf8-ab45-03ed92901dce",
                                        "glosses": [
                                            "мн. ч., устар. оковы, кандалы на заключённых; узы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "682f4f70-0ed3-4e75-a6a3-203be02eaad7",
                                                "sense_id": "d098cb45-64eb-39be-9636-6ff52a29ac96",
                                                "text": "Увы! куда ни брошу взор — // Везде бичи, везде железы, // Законов гибельный позор, // Неволи немощные сле́зы…"
                                            },
                                            {
                                                "example_id": "77d0409f-0d79-4f0b-8571-bae58d079412",
                                                "sense_id": "d098cb45-64eb-39be-9636-6ff52a29ac96",
                                                "text": "Посажение в железа в древнем русском праве обнимало собой все виды заковывания и приковывания."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df819c5b-f134-357f-9abc-259b7601c153",
                                        "entry_id": "341aa73a-f6d3-3bf8-ab45-03ed92901dce",
                                        "glosses": [
                                            "комп. жарг. аппаратное обеспечение компьютера"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c5c64df-4a70-493b-984b-875778c5490c",
                                                "sense_id": "df819c5b-f134-357f-9abc-259b7601c153",
                                                "text": "Я попросил нашего системщика поменять мне железо."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bc85630-8bbb-3e7a-94f6-d0bb00c10f8f",
                                        "entry_id": "341aa73a-f6d3-3bf8-ab45-03ed92901dce",
                                        "glosses": [
                                            "перен. твёрдый тон, не допускающий возражений"
                                        ],
                                        "tags": [
                                            "только ед. ч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69db6ac1-e8eb-4d00-ad57-92a7f92ddcbc",
                                                "sense_id": "7bc85630-8bbb-3e7a-94f6-d0bb00c10f8f",
                                                "text": "железо в голосе"
                                            },
                                            {
                                                "example_id": "740b4fda-f458-4683-96ba-879c71354b00",
                                                "sense_id": "7bc85630-8bbb-3e7a-94f6-d0bb00c10f8f",
                                                "text": "— Мама, — сказала я после долгой паузы. В голосе — железо. Внутри — съёжившийся паук."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "767acff6-4905-36a8-adc9-682afccb74f0",
                                        "entry_id": "341aa73a-f6d3-3bf8-ab45-03ed92901dce",
                                        "glosses": [
                                            "хим., техн. (с прил., характеризующим кислотный остаток) соль железа [1]"
                                        ],
                                        "tags": [
                                            "только ед. ч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b8a49a8-8967-43e5-bcf5-a9e5c345f35f",
                                                "sense_id": "767acff6-4905-36a8-adc9-682afccb74f0",
                                                "text": "В качестве реактива для травления наиболее широко применяется водный раствор технического хлорного железа."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f03c04e5-0251-3941-989d-74e21ed2d53f",
                                        "entry_id": "341aa73a-f6d3-3bf8-ab45-03ed92901dce",
                                        "glosses": [
                                            "спорт. собир. гири, гантели, штанги, тренажёры"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebf19aa5-2023-4aed-ac7c-bf0be5511724",
                                                "sense_id": "f03c04e5-0251-3941-989d-74e21ed2d53f",
                                                "text": "Считается, что неологизм качать железо, закрепившийся за занятиями бодибилдингом и тяжёлой атлетикой, придумал Чарльз Гейнс."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d051f22-16b1-301b-8bcc-0ba887d5fdba",
                                        "entry_id": "341aa73a-f6d3-3bf8-ab45-03ed92901dce",
                                        "glosses": [
                                            "жарг. нарк. крэк"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
