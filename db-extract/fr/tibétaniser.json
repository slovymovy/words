                "senses": [
                    {
                        "sense_id": "4de0bbf7-b36f-3395-992e-9a5cfac54116",
                        "entry_id": "c7df6fc5-1b96-3ef5-b35a-fd621301df99",
                        "glosses": [
                            "Donner un caractère tibétain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d3dbb66-6823-40ca-92b4-b7814126b94f",
                                "sense_id": "4de0bbf7-b36f-3395-992e-9a5cfac54116",
                                "text": "Bien que le Ladakh ait été “tibétanisé” au IXe siècle, le bouddhisme y parvint sous sa forme indienne, comme en témoignent les temples d’Alchi (p. 255)."
                            },
                            {
                                "example_id": "5b64c0ba-fc22-4e25-a1c8-eec39936dffb",
                                "sense_id": "4de0bbf7-b36f-3395-992e-9a5cfac54116",
                                "text": "La possession par des esprits a été constatée un peu partout dans le Sud de l’Himālaya, surtout lorsqu’il s’agit de populations tibétanisées."
                            }
                        ]
                    }
