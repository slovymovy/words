                                "sense_id": "858b4a60-fae9-3c64-8edf-ec8519d11378",
                                "text": "Hulot d'embossure, ouverture pratiquée à la muraille du navire, en arrière du grand cabestan, pour le passage des cordages ou des chaînes qui servent d'embossure."
                            },
                            {
                                "example_id": "ad4a8685-5a9b-4b95-a921-b70481bf68f1",
                                "sense_id": "858b4a60-fae9-3c64-8edf-ec8519d11378",
                                "text": "HULOT, ULOT, s. m. (Marine.) c’est l’ouverture où l’on met le moulinet de la barre nommée manivelle."
                            },
                            {
                                "example_id": "0454bf76-77c8-4082-8e6d-508228b56edb",
                                "sense_id": "858b4a60-fae9-3c64-8edf-ec8519d11378",
                                "text": "HULOTS, s. m. pl. (Marine.) ce sont les ouvertures qui sont dans le panneau de la fosse aux cables."
                            }
                        ]
                    }
