                        "form": "die Ölbilder"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1dfb4f93-2e32-33e9-be87-f19a34efa5c4",
                        "entry_id": "1b1c4a92-d944-3028-8bbf-b89517e4ff7d",
                        "glosses": [
                            "mit Ölfarben gemaltes Bild"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34241ed0-b35d-4571-a9b7-2b9ddf7f19e1",
                                "sense_id": "1dfb4f93-2e32-33e9-be87-f19a34efa5c4",
                                "text": "„Im großen Innenhof hängen Ölbilder lokaler Maler“ […]."
                            },
                            {
                                "example_id": "34ddac6e-4d74-4eb2-8779-c3a4d39c47fd",
                                "sense_id": "1dfb4f93-2e32-33e9-be87-f19a34efa5c4",
                                "text": "„Das wandfüllende Ölbild von Adelita Husni-Bey hängt gleich am Eingang der Schau.“"
                            },
                            {
                                "example_id": "1d515209-c11a-4a85-bc51-497be6458b39",
                                "sense_id": "1dfb4f93-2e32-33e9-be87-f19a34efa5c4",
                                "text": "„Bei einer Online-Versteigerung ist das Ölbild \"Die Mühle von Wijk\" für 550.000 Euro unter den Hammer gekommen.“"
                            },
                            {
                                "example_id": "a4fc09fe-1e55-4014-bbf7-e38875e1fb87",
                                "sense_id": "1dfb4f93-2e32-33e9-be87-f19a34efa5c4",
                                "text": "„Das Ölbild \"Les femmes d'Alger\" (Die Frauen von Algier (Version 0)\", das Picasso 1955 malte, wechselte bei einer Versteigerung des Auktionshauses Christie's den Besitzer.“"
                            },
                            {
                                "example_id": "3e91d015-e7ca-4793-a8e9-c8ec3112b769",
                                "sense_id": "1dfb4f93-2e32-33e9-be87-f19a34efa5c4",
                                "text": "„Der kleine Schuppen in dem Hamburger Hinterhof ist Konstantin Sotnikovs Atelier. Hier malt der Kunststudent seine Ölbilder.“"
                            },
                            {
                                "example_id": "3fe3ee62-ab4f-4022-b087-8b10cc6c8049",
                                "sense_id": "1dfb4f93-2e32-33e9-be87-f19a34efa5c4",
                                "text": "„Paul Klee“ […] „malte 1922 ein Ölbild mit dem Titel Das Haus zum Fliegerpfeil.“"
                            },
                            {
                                "example_id": "7f9e6409-2ee4-417c-9043-ad5935e57a1a",
                                "sense_id": "1dfb4f93-2e32-33e9-be87-f19a34efa5c4",
                                "text": "„Giovanni Battista Pittoni malte 1715/1730 das Ölbild „Opferszene: Hannibals Schwur“.“"
                            },
                            {
                                "example_id": "982cb976-b2c0-4f92-9a23-69908adbca1c",
                                "sense_id": "1dfb4f93-2e32-33e9-be87-f19a34efa5c4",
                                "text": "„Der jüdische Industrielle Julius Priester verlor 1938 seine Kunstsammlung an die Nazis, darunter das Ölbild \"Portrait eines Edelmannes\". Jetzt kommt das wertvolle Gemälde wieder in den Familienbesitz zurück.“"
                            },
                            {
                                "example_id": "3b467b66-bfd0-4985-a086-7b00687c9b71",
                                "sense_id": "1dfb4f93-2e32-33e9-be87-f19a34efa5c4",
                                "text": "„Wer sich keine Ölbilder leisten kann kauft die günstigeren Druckgrafiken.“"
                            },
                            {
                                "example_id": "5babbaa5-d9ee-4f04-837b-d88c4289d033",
                                "sense_id": "1dfb4f93-2e32-33e9-be87-f19a34efa5c4",
                                "text": "Dieses Ölbild ist zu verkaufen."
                            },
                            {
                                "example_id": "0b42cc46-635e-4f89-af94-f083bd088606",
                                "sense_id": "1dfb4f93-2e32-33e9-be87-f19a34efa5c4",
                                "text": "„Kuhnert war äußerst geschäftstüchtig, verkaufte später seine großformatigen Ölbilder an finanzkräftige Kunstsammler der oberen Gesellschaftsschichten.“"
                            },
                            {
                                "example_id": "2eabf8f9-cd3b-4122-8756-ddaa650728f1",
                                "sense_id": "1dfb4f93-2e32-33e9-be87-f19a34efa5c4",
                                "text": "„Gerade einmal 29,8 mal 22,4 Zentimeter misst das Ölbild.“"
                            },
                            {
                                "example_id": "2e83cb73-aeaf-4ffd-b992-d9361c87a3ae",
                                "sense_id": "1dfb4f93-2e32-33e9-be87-f19a34efa5c4",
                                "text": "„Das 52 cm × 78 cm messende Ölbild auf Holz befindet sich in der Alten Pinakothek in München.“"
                            },
                            {
                                "example_id": "574c3fd7-fc7a-4538-98ad-0b64517cfb21",
                                "sense_id": "1dfb4f93-2e32-33e9-be87-f19a34efa5c4",
                                "text": "„Das 86 mal 70 Zentimeter große Ölbild war wegen der Gefahr von Bombenangriffen im Herbst 1943 gemeinsam mit rund 400 anderen Kunstwerken aus dem damaligen Mecklenburgischen Landesmuseum Schwerin in das Schloß Ivenack gebracht worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
