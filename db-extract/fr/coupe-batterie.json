                "senses": [
                    {
                        "sense_id": "5a7b29c3-25b4-3bb8-936e-55b85957d499",
                        "entry_id": "aae3bfdf-2e83-31f8-9510-715dae14bf9e",
                        "glosses": [
                            "Dispositif de sécurité ou antivol permettant de déconnecter la batterie du circuit électrique d’un véhicule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae523b42-b021-4267-ad39-55e14daaef72",
                                "sense_id": "5a7b29c3-25b4-3bb8-936e-55b85957d499",
                                "text": "Pour la démarrer, il faut ouvrir le capot. \"Il y a un coupe-batterie là, montre la retraitée, le contact est mis. Et puis il faut faire un appel d’essence parce que la pompe se désamorce.\""
                            },
                            {
                                "example_id": "a8dbdef2-300a-492f-88b1-176a0222ef60",
                                "sense_id": "5a7b29c3-25b4-3bb8-936e-55b85957d499",
                                "text": "À la base de la colonne de direction, les interrupteurs pour la gestion du FAP et celui des warnings ne sont pas idéalement positionnés, tout comme celui du coupe-batterie, qui ne se voit pas au premier coup d’œil."
                            },
                            {
                                "example_id": "c099a074-dd8a-4c98-8bb8-b5f201259e25",
                                "sense_id": "5a7b29c3-25b4-3bb8-936e-55b85957d499",
                                "text": "Alors que le bus était à l’arrêt et que la conductrice à l’extérieur activait le coupe-batterie, après avoir entendu un bip, le véhicule de quinze tonnes a commencé à reculer pour aller s’échouer dans le talus qui borde le skatepark."
                            }
                        ]
                    }
