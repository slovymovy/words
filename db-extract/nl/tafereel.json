                "senses": [
                    {
                        "sense_id": "047f08dc-6fc8-3e06-9ddf-df0295c55235",
                        "entry_id": "7e8ba2cc-f619-3b53-9941-b60b1ac7e1ee",
                        "glosses": [
                            "een gebeurtenis of situatie waarnaar men kijkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3be46953-e1ed-45da-8c47-19637257cdbc",
                                "sense_id": "047f08dc-6fc8-3e06-9ddf-df0295c55235",
                                "text": "Hij zag het tafereel voor zijn ogen gebeuren."
                            },
                            {
                                "example_id": "9adf3e90-c5fb-4227-982d-9d3360d229fa",
                                "sense_id": "047f08dc-6fc8-3e06-9ddf-df0295c55235",
                                "text": "' Ze had besloten om deze keer geen diptiek te schilderen zoals Vrouwen in het graanveld, maar gewoon één tafereel af te beelden."
                            },
                            {
                                "example_id": "8d337cce-7875-4ac8-9240-774cc703f8e6",
                                "sense_id": "047f08dc-6fc8-3e06-9ddf-df0295c55235",
                                "text": "Zag Emil al de Joegoslavische oorlogen naderen? Ik zet een paar stappen terug en laat het tafereel op me inwerken."
                            },
                            {
                                "example_id": "422d4814-cf3a-43af-bc46-5178f2da1fc5",
                                "sense_id": "047f08dc-6fc8-3e06-9ddf-df0295c55235",
                                "text": "Als aan de grond genageld stond ik dat tafereel gade te slaan, het zag er zé zwaar uit."
                            }
                        ]
                    }
                ],
