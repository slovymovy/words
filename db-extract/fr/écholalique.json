                        "glosses": [
                            "Relatif à l'écholalie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f7946f1-a13f-421e-ad12-0b6057a7ebd8",
                                "sense_id": "03c8bb70-38b3-3241-8a2f-2501b124845f",
                                "text": "Les enfants qui ne savent répondre qu'en redisant fidèlement la question sur un mode écholalique ont des troubles graves de la personnalité ; ils n'arrivent pas à se situer par rapport à autrui, à distribuer les rôles des interlocuteurs."
                            },
                            {
                                "example_id": "c522df26-d735-42eb-8c9d-9d9a4aea91d9",
                                "sense_id": "03c8bb70-38b3-3241-8a2f-2501b124845f",
                                "text": "Quand l'activité langagière de l'enfant autiste s'est bien développée vont coexister des capacités combinatoires nuancées et la tendance à utiliser des morceaux de discours écholaliques."
                            }
                        ]
                    }
