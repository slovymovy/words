                "senses": [
                    {
                        "sense_id": "f393e1f6-bb0d-3cda-a178-a9b14ac0ff56",
                        "entry_id": "3cc57d94-b872-34ba-8e7e-996aaffe6f9c",
                        "glosses": [
                            "Trinkglas für Champagner"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa14a32c-74bf-400a-aec8-ac64834c0bfd",
                                "sense_id": "f393e1f6-bb0d-3cda-a178-a9b14ac0ff56",
                                "text": "„Soweit ich das sehe, kann man in der Hölle zwischen zwei Karrieremöglichkeiten wählen. Entweder man arbeitet für eine dieser Webseiten, von denen jeder glaubt, sie kämen aus Russland oder Burma, wo nackte Männer und Frauen mit glasigen Augen unverwandt in ein Webcam starren und dabei an ihren Fingern lecken und glitschige Plastikmodellflugzeuge oder Bananen in ihre rasierten Mumus oder Huhus stecken. Oder aber sie schlürfen mit falschem Lächeln ihren eigenen Urin aus Champagnerflöten.“"
                            },
                            {
                                "example_id": "d3c921af-1d63-4ff5-b502-c2914fac7407",
                                "sense_id": "f393e1f6-bb0d-3cda-a178-a9b14ac0ff56",
                                "text": "„›Sie sind wie kranke, streunende Hunde‹, sagt ein großer Mann mit einem mächtigen gelben Bart und gluckst so laut, dass er fast den Inhalt seiner Champagnerflöte verschüttet.“"
                            },
                            {
                                "example_id": "78964d67-a6f8-4af8-bdf2-16a2388abedc",
                                "sense_id": "f393e1f6-bb0d-3cda-a178-a9b14ac0ff56",
                                "text": "„Niemand beachtete ihn, und außer der Einlasskontrolle mit dem Ausweisscanner und der umherwandelnden Serviererin mit dem Silbertablett voller Champagnerflöten hatte kein Mensch bisher den geringsten Kontakt mit ihm gehabt, obwohl er sich bereits seit 90 Minuten im Gebäude aufhielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
