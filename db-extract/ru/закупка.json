                                "target_senses": [
                                    {
                                        "sense_id": "cf8a1c24-435a-3edd-bd08-51bc38e16d37",
                                        "entry_id": "e21085ad-d52b-3806-b6f9-8adb166255ab",
                                        "glosses": [
                                            "The purchasing department of a company."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "341cdf1f-e50e-3dbb-84c6-4e3bafdd35f8",
                                        "entry_id": "e21085ad-d52b-3806-b6f9-8adb166255ab",
                                        "glosses": [
                                            "The act of procuring or obtaining; obtainment; attainment."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ace0d09-bf7b-4896-b37a-7971070c76fd",
                                                "sense_id": "341cdf1f-e50e-3dbb-84c6-4e3bafdd35f8",
                                                "text": "He was responsible for the procurement of materials and supplies."
                                            },
                                            {
                                                "example_id": "eb17a51d-319a-4bc5-b99a-7bd16f485ff3",
                                                "sense_id": "341cdf1f-e50e-3dbb-84c6-4e3bafdd35f8",
                                                "text": "I have a lot of experience in the procurement of construction materials and sub-contracts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0828c5f4-cbbd-3767-896a-382a15a2509a",
                                        "entry_id": "e21085ad-d52b-3806-b6f9-8adb166255ab",
                                        "glosses": [
                                            "Efficient contrivance; management; agency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81d014de-85db-49f0-a272-24a639730722",
                                                "sense_id": "0828c5f4-cbbd-3767-896a-382a15a2509a",
                                                "text": "They think it done by her procurement."
                                            },
                                            {
                                                "example_id": "e0394597-9f41-4b3d-bab1-64923e7c6f20",
                                                "sense_id": "0828c5f4-cbbd-3767-896a-382a15a2509a",
                                                "text": "The plaintiff, in her reply, further denies that she filed the petition, or that it was filed by her procurement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e95054d5-2008-4340-806f-5e5d06a5ca42",
                        "source_entry_id": "b8dbefef-93a8-3ad0-8480-d624b05e0854",
                        "source_sense_id": "29aac957-6f3f-3d67-a509-2ef1beaeb5a0",
                        "target_lang_word": "Einkauf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einkauf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9853f9d9-70ea-3e57-b217-097536e3bb0b",
                                        "entry_id": "bb92f211-1738-3378-8fa6-f874c61f342d",
                                        "glosses": [
                                            "das Erwerben von etwas gegen Geld"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc18b864-ff9b-45cf-b196-2b55fd1afe3c",
                                                "sense_id": "9853f9d9-70ea-3e57-b217-097536e3bb0b",
                                                "text": "Der Einkauf im neuen Einkaufszentrum macht Spaß."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7aef3522-2138-314a-9b12-9a153d3ac029",
                                        "entry_id": "bb92f211-1738-3378-8fa6-f874c61f342d",
                                        "glosses": [
                                            "das gegen Geld Erworbene"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7158f8da-fed4-43ba-bb71-2040a3d6e7e7",
                                                "sense_id": "7aef3522-2138-314a-9b12-9a153d3ac029",
                                                "text": "Kaum erworben gefällt mir mein Einkauf nicht mehr."
                                            },
                                            {
                                                "example_id": "90233c6b-903b-4adf-8621-85574e3bb811",
                                                "sense_id": "7aef3522-2138-314a-9b12-9a153d3ac029",
                                                "text": "„Ich hatte Einkäufe gemacht und war beladen mit Büchern und Schallplatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54454a69-d4bf-46bd-8e3e-3c3bd9f895b4",
                        "source_entry_id": "b8dbefef-93a8-3ad0-8480-d624b05e0854",
                        "source_sense_id": "29aac957-6f3f-3d67-a509-2ef1beaeb5a0",
                        "target_lang_word": "achat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "achat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3554545-47d1-3c16-a7b3-13fee85556de",
                                        "entry_id": "9b13e957-1753-3203-8ada-ee13bad6a622",
                                        "glosses": [
                                            "Acquisition faite à prix d’argent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec093afa-9f37-429b-82cd-b4365df221d3",
                                                "sense_id": "e3554545-47d1-3c16-a7b3-13fee85556de",
                                                "text": "Faire achat de marchandises."
                                            },
                                            {
                                                "example_id": "8584e6f4-2368-451a-bd17-741d9a07d8d1",
                                                "sense_id": "e3554545-47d1-3c16-a7b3-13fee85556de",
                                                "text": "Ce jeudi 9 janvier, la plus haute juridiction de l’Union européenne a statué que le fait d’exiger des passagers ferroviaires qu’ils déclarent leur genre lors de l’ achat d’un billet était contraire au règlement général sur la protection des données (RGPD) de l’UE."
                                            },
                                            {
                                                "example_id": "5b910bf9-2b53-48e5-94b2-2b6453ca5799",
                                                "sense_id": "e3554545-47d1-3c16-a7b3-13fee85556de",
                                                "text": "Je renonce à faire des achats cette année."
                                            },
                                            {
                                                "example_id": "767b9cd6-91fe-4f90-8295-b74a8acaedcf",
                                                "sense_id": "e3554545-47d1-3c16-a7b3-13fee85556de",
                                                "text": "Un achat avantageux."
                                            },
                                            {
                                                "example_id": "88181abf-577c-4d0d-9a48-24d118feb7b9",
                                                "sense_id": "e3554545-47d1-3c16-a7b3-13fee85556de",
                                                "text": "Un achat durable est un achat qui est respectueux de l’environnement, des lois sociales et de l’éthique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82e16234-e47e-33c2-96ce-023abcbe2641",
                                        "entry_id": "9b13e957-1753-3203-8ada-ee13bad6a622",
                                        "glosses": [
                                            "Chose achetée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52052fe9-b38d-4744-82de-a872847d05ab",
                                                "sense_id": "82e16234-e47e-33c2-96ce-023abcbe2641",
                                                "text": "Je veux vous faire voir mon dernier achat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ea9bbac-05c4-4ecf-a097-65a0cde1982d",
                        "source_entry_id": "b8dbefef-93a8-3ad0-8480-d624b05e0854",
                        "source_sense_id": "29aac957-6f3f-3d67-a509-2ef1beaeb5a0",
                        "target_lang_word": "acquisition",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acquisition",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4090b1f9-c450-3945-861c-19fe73bb36b7",
                                        "entry_id": "82f6a0dd-10fb-3f60-8a06-a64c0c5255a7",
                                        "glosses": [
                                            "Action d’acquérir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fff4e866-e364-4997-8fa6-89044e536c88",
                                                "sense_id": "4090b1f9-c450-3945-861c-19fe73bb36b7",
                                                "text": "Pons n’admettait pas d’acquisition au-dessus de cent francs ; et, pour qu’il payât un objet cinquante francs, cet objet devait en valoir trois mille."
                                            },
                                            {
                                                "example_id": "58861c05-72c9-4a89-8a1e-1101bdd00474",
                                                "sense_id": "4090b1f9-c450-3945-861c-19fe73bb36b7",
                                                "text": "Par suite de l’acquisition faite par les États-Unis, en 1802, de la partie occidentale de la Géorgie, où résidaient les Chérokées, ceux-ci se trouvèrent placés sous la juridiction immédiate du gouvernement général, […]."
                                            },
                                            {
                                                "example_id": "bf6ffcac-de8d-44b4-8539-680165de5a24",
                                                "sense_id": "4090b1f9-c450-3945-861c-19fe73bb36b7",
                                                "text": "Quelquefois, au contraire, c'est le Diable qui vend des poules noires, et l'on devine à quel prix ! Alors, ce volatile infernal procure à celui qui en a fait l’acquisition tous les trésors qu'il peut désirer."
                                            },
                                            {
                                                "example_id": "c97e8126-79b9-4068-8361-9eb0fd823485",
                                                "sense_id": "4090b1f9-c450-3945-861c-19fe73bb36b7",
                                                "text": "Chaque baisse supplémentaire du cours alourdissait la facture de l’acquisition d'Orange, dans une sorte d’engrenage vicieux et compliquait le désendettement de France Télécom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f19cf7c-667f-3ec9-a800-2b25eb309377",
                                        "entry_id": "82f6a0dd-10fb-3f60-8a06-a64c0c5255a7",
                                        "glosses": [
                                            "La chose acquise elle-même."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76c48858-f037-4bcc-90fc-a705a9241813",
                                                "sense_id": "6f19cf7c-667f-3ec9-a800-2b25eb309377",
                                                "text": "Marx comparait le changement d'ère historique à une succession civile ; les temps nouveaux héritent des acquisitions antérieures."
                                            },
                                            {
                                                "example_id": "3c48fac7-5f09-409d-9586-deb06106c9e2",
                                                "sense_id": "6f19cf7c-667f-3ec9-a800-2b25eb309377",
                                                "text": "Venez voir ma nouvelle acquisition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67ed3d92-08f2-313c-b5c3-df37cacf43a5",
                                        "entry_id": "82f6a0dd-10fb-3f60-8a06-a64c0c5255a7",
                                        "glosses": [
                                            "Réception d'un signal identifiable provenant d'un émetteur artificiel ou naturel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cecff44-e5b7-4261-9945-96e583f334ea",
                                                "sense_id": "67ed3d92-08f2-313c-b5c3-df37cacf43a5",
                                                "text": "Pour vérifier la répétabilité de l’étalonnage, nous avons réalisé deux séries d’acquisitions d’images du corps noir à différentes températures (de 17°C à 23°C avec un pas de 0.25°C)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "902722a4-6cb2-324f-8d6d-75ec4c41af01",
                                        "entry_id": "82f6a0dd-10fb-3f60-8a06-a64c0c5255a7",
                                        "glosses": [
                                            "Acquisition d'un signal reflété"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a4cd98a-0146-41fc-b05d-5826f2d2a9a8",
                                                "sense_id": "902722a4-6cb2-324f-8d6d-75ec4c41af01",
                                                "text": "Tout commence par des prises de données par avion, appelées « acquisitions »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
