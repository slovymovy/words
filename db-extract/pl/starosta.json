                "senses": [
                    {
                        "sense_id": "d8a272fd-fa34-317a-b2f5-ead5eedfbcae",
                        "entry_id": "c82ac142-e640-3fd8-b00c-60e1520c735d",
                        "glosses": [
                            "zwierzchnik administracji ogólnej na szczeblu powiatu – w Galicji oraz w Polsce w okresie międzywojennym, a także w latach 1944–1950 i od 1999 do dzisiaj"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c62e58d-9027-47b7-8a38-c165197bc37f",
                                "sense_id": "d8a272fd-fa34-317a-b2f5-ead5eedfbcae",
                                "text": "Jeśli nie uda im się znaleźć nikogo takiego, starosta wyda informację o braku możliwości zaspokojenia potrzeb kadrowych twojej firmy na lokalnym rynku pracy."
                            },
                            {
                                "example_id": "f070940b-50a3-4538-9108-3a45380da19c",
                                "sense_id": "d8a272fd-fa34-317a-b2f5-ead5eedfbcae",
                                "text": "Inspektor nadzoru budowlanego sprawuje kontrolę nad działalnością starosty wynikającą ze stosowania przepisów prawa budowlanego"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
