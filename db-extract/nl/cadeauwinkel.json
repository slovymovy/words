                "senses": [
                    {
                        "sense_id": "e842db0a-243e-3a88-993f-c04dfbfe842e",
                        "entry_id": "ad3cbb0e-109c-3b29-811b-04b619340998",
                        "glosses": [
                            "winkel waar men geschenken en snuisterijen kan kopen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd9f3f21-4f8f-4c78-b697-f703a3d364e1",
                                "sense_id": "e842db0a-243e-3a88-993f-c04dfbfe842e",
                                "text": "In de cadeauwinkel worden kleurrijke prullaria verkocht."
                            },
                            {
                                "example_id": "9ca96837-83b8-4948-8e52-d04ea09c01cb",
                                "sense_id": "e842db0a-243e-3a88-993f-c04dfbfe842e",
                                "text": "De Stichting Gehandicaptenzorg Limburg uit Sittard ontvangt jaarlijks 30 miljoen euro voor zorg aan mensen met een beperking of een niet-aangeboren hersenaandoening. Tussen 2008 en 2010 ging een deel van dat geld naar een dagbesteding op een zorgboerderij, in een cadeauwinkel en in een zorgmanege."
                            },
                            {
                                "example_id": "9716c914-e005-4d4f-b95e-e399556877b6",
                                "sense_id": "e842db0a-243e-3a88-993f-c04dfbfe842e",
                                "text": "Sommige consumenten kiezen er volgens de winkeliers voor om kleinere cadeaus te kopen. \"In plaats van 20 euro per pakje geven ze nu 15 euro uit\", zegt de eigenaar van een cadeauwinkel."
                            }
                        ]
                    }
