                },
                {
                    "sense_id": "57f2a3d0-b6ea-3f52-93c9-f17589d7eff2",
                    "sense_definition": "A strong verbal or written attack involving heavy criticism or insults",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newspaper published a scathing <w>assault</w> on the government's new economic policy.",
                            "target_lang_translations": {
                                "ru": "Газета опубликовала едкий <w>выпад</w> против новой экономической политики правительства."
                            }
                        },
                        {
                            "text": "Her speech was a direct <w>assault</w> on her opponent's character and integrity.",
                            "target_lang_translations": {
                                "ru": "Ее речь была прямой <w>атакой</w> на репутацию и честность оппонента."
                            }
                        }
                    ],
                    "synonyms": [
