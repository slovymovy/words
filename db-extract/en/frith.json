            {
                "entry_id": "6787db11-3a44-3fc3-afa9-0cb82072ece9",
                "word": "frith",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3a78041d-b493-4279-9693-fd7352eef0df",
                        "entry_id": "6787db11-3a44-3fc3-afa9-0cb82072ece9",
                        "tags": [
                            "plural"
                        ],
                        "form": "friths"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0db9a7d8-cb6c-3bfd-b690-448a162a0ef8",
                        "entry_id": "6787db11-3a44-3fc3-afa9-0cb82072ece9",
                        "glosses": [
                            "Alternative form of firth (“an arm or inlet of the sea”)."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative",
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "ea04b2cb-b69f-48cb-bb97-0f7dcbf24849",
                                "sense_id": "0db9a7d8-cb6c-3bfd-b690-448a162a0ef8",
                                "text": "He [Agricola] had observed, that the island [Britannia; now Great Britain] is almost divided into two unequal parts by the opposite gulfs, or, as they are now called, the Friths of Scotland."
                            },
                            {
                                "example_id": "04d2cbcb-6479-4ba3-8612-2a633441932e",
                                "sense_id": "0db9a7d8-cb6c-3bfd-b690-448a162a0ef8",
                                "text": "/ The southern hills / That to the setting Sun, their graceful heads / Rearing, o'erlook the frith, where Vecta breaks / With her white rocks, the strong impetuous tide, / When western winds the vast Atlantic urge / To thunder on the coast"
                            },
                            {
                                "example_id": "0f448a26-8728-4bd7-bc6a-821bfb46d5fa",
                                "sense_id": "0db9a7d8-cb6c-3bfd-b690-448a162a0ef8",
                                "text": "A Low-Germanic tongue, usually called by those who spoke it Englisc, or English, but which by us is usually styled Anglo-Saxon, was the speech of all the Teutonic inhabitants of Great Britain from the Channel to the Frith of Forth."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
