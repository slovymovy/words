                                "sense_id": "008f8921-0607-3152-a6c6-eb4bdf782432",
                                "text": "Łatwym w chowie dusicielem jest boa tęczowy."
                            }
                        ],
                        "sense_index_json": "\"2.2\""
                    },
                    {
                        "sense_id": "d7296a29-3920-37f5-a5db-49140b1d0cdb",
