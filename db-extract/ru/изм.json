                                "target_senses": [
                                    {
                                        "sense_id": "2166b55a-e3bc-3ff3-8f0c-9edefd63ce0e",
                                        "entry_id": "72ce4324-2af6-3d68-9d12-347741a8778b",
                                        "glosses": [
                                            "Toute doctrine nommée par un mot se terminant par le suffixe -isme, en tant qu'approche absolue et dogmatique."
                                        ],
                                        "tags": [],
                                        "note": "Souvent entre guillemets pour la clarté typographique",
                                        "examples": [
                                            {
                                                "example_id": "9d663fa5-f007-4393-af09-f5be04b01553",
                                                "sense_id": "2166b55a-e3bc-3ff3-8f0c-9edefd63ce0e",
                                                "text": "Gauchisme, environnementalisme, socialisme, individualisme, étatisme, wokisme, alter-mondialisme, indigénisme, marxisme, nationalisme, tous ces « ismes » sont les lieux par lesquels nous poursuivons l'œuvre entamée par les ultramontains utopistes. Sortir de notre dogmatisme …, tel est l'esprit qui doit aujourd'hui nous animer plus que jamais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
