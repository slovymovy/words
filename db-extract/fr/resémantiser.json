                    {
                        "sense_id": "707f45a9-aabe-3d52-a080-eb78b063e0ed",
                        "entry_id": "6eb99236-df42-3983-95f4-330ca509ed2e",
                        "glosses": [
                            "Sémantiser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c031f205-fc43-4177-b1a6-512ab9eb97e3",
                                "sense_id": "707f45a9-aabe-3d52-a080-eb78b063e0ed",
                                "text": "Penser, c'est du même coup syntaxiser, sémantiser et pragmatiser, ou resyntaxiser, resémantiser et repragmatiser."
                            },
                            {
                                "example_id": "faabfaf2-8b6e-4a4a-9230-8187f0351149",
                                "sense_id": "707f45a9-aabe-3d52-a080-eb78b063e0ed",
                                "text": "Même si la cité l'adopte, le transforme au point de le resémantiser, le mythe n'aurait-il rien conservé de son contexte historique et social primitif?"
                            }
                        ]
                    }
