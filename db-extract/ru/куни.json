                        "target_lang_word": "cunni",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cunni",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7e21ddce-4921-3ccd-9ec3-f7182db9699b",
                                        "entry_id": "372ece4e-2d9c-3583-98d6-b6dbf0a1a89b",
                                        "glosses": [
                                            "Cunnilingus."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cc4e8b8-0d9f-4db4-a610-99b3e4427a8c",
                                                "sense_id": "7e21ddce-4921-3ccd-9ec3-f7182db9699b",
                                                "text": "L’arrivée des « cunnis » sur le petit écran est à double tranchant."
                                            },
                                            {
                                                "example_id": "37657449-e172-471f-b23c-9cc8f020ed37",
                                                "sense_id": "7e21ddce-4921-3ccd-9ec3-f7182db9699b",
                                                "text": "« Je crois qu’il aime bien le fait de pouvoir parler à une fille sans que ce soit tout de suite pris pour de la drague. Et puis, je lui file des techniques de cunni dont il n’avait même pas entendu parler ! »"
                                            },
                                            {
                                                "example_id": "4451b8eb-7146-49a3-92bd-5d5efbdabd0b",
                                                "sense_id": "7e21ddce-4921-3ccd-9ec3-f7182db9699b",
                                                "text": "Le cunni étant le terme savant bien orthographié, si vous faites une recherche pour en apprendre sur l’art du broute-minou, n’oubliez pas le deuxième N, sinon vous tomberez sur tout ce que le Web peut comporter de porno à direction masculine principalement du genre : « Deux salopes se bouffent la chatte au bord de la piscine »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
