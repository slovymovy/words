                        "glosses": [
                            "de liefde die men voelt voor de (mede)mens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92a28d33-7d27-4610-ad02-641f129a17d8",
                                "sense_id": "b9418441-90b0-3e39-aeb2-fdbb8feb08bd",
                                "text": "De zes harige bewoners van kattencafé Ditjes & Katjes in de Piet Heinstraat zijn in het Haags Dierencentrum geselecteerd op hun mensenliefde. Dieren die in de stress schieten van volk gedijen immers niet in een lunchroom."
                            },
                            {
                                "example_id": "0a9167fa-7ad5-46f9-b486-f5fdab994cc4",
                                "sense_id": "b9418441-90b0-3e39-aeb2-fdbb8feb08bd",
                                "text": "Ernst had te doen met de dames en heren van Lotus, die zoveel vakkundigheid en precisie en mensenliefde in hun werk hadden gelegd."
                            }
                        ]
                    }
                ],
