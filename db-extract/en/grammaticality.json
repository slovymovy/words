                        "entry_id": "52581740-1e85-3c9f-9304-6b0d7a3d22b3",
                        "glosses": [
                            "(of language) The state or attribute of obeying the rules of grammar (being grammatical)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4e78eb2a-c8d3-46fd-b705-52b0e96b625e",
                                "sense_id": "25a98627-61ce-3ec0-bed3-b5eb89c58378",
                                "text": "One cannot consistently judge the grammaticality of utterances without knowing what grammatical types their constituent morphemes represent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11975540-a6b8-47fa-bfc8-0f0ac4edf5fc",
