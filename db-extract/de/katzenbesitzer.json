                "senses": [
                    {
                        "sense_id": "e3f37581-f6fb-37b3-80ac-0309b927c842",
                        "entry_id": "194ec9a4-b8c2-39dd-8c95-5958401f0ebc",
                        "glosses": [
                            "Person, die eine Katze besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a2f2903-e406-44b0-94df-474e4b6671f7",
                                "sense_id": "e3f37581-f6fb-37b3-80ac-0309b927c842",
                                "text": "„Jeder Katzenbesitzer kennt diese Szene, wenn sein Tier aus der scheinbar völligen Ruhe aufschießt und eine athletische Spitzenleistung hinlegt.“"
                            },
                            {
                                "example_id": "9a2f443c-69e5-42b0-b263-57d0e971cc69",
                                "sense_id": "e3f37581-f6fb-37b3-80ac-0309b927c842",
                                "text": "„Dennoch hat der umtriebige neuseeländische Ökonom, Philanthrop und Umweltschützer Morgan mit seiner Kampagne gegen das flauschige Haustier zum Schutz der einheimischen Tierwelt vor allem die Katzenbesitzer auf die Palme gebracht.“"
                            },
                            {
                                "example_id": "4fb5ea59-0552-40e2-8638-93a338cfdab5",
                                "sense_id": "e3f37581-f6fb-37b3-80ac-0309b927c842",
                                "text": "„Die Wissenschaftler, die ihre Studie im Magazin Animal Cognition veröffentlicht haben, ließen Testpersonen mehrmals nach einer Katze rufen. Zuerst riefen drei unbekannte Menschen, dann der Katzenbesitzer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
