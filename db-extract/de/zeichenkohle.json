                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b707056-ee56-34aa-b6b7-e26e97af481f",
                                        "entry_id": "a326bdd3-45d4-3658-870d-29f18353fa00",
