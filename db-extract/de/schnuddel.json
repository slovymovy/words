                "senses": [
                    {
                        "sense_id": "3746cc11-96e0-3e58-901f-71a22dad21b1",
                        "entry_id": "f0400807-b6ec-39a0-872b-35a507656aa8",
                        "glosses": [
                            "Rotze oder Schnodder, Schleim aus der Nase"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14bf3cf4-6028-4c6d-a6b2-56e36c3f34a7",
                                "sense_id": "3746cc11-96e0-3e58-901f-71a22dad21b1",
                                "text": "Der kleine Knirps hat immer ein bisschen Schnuddel unter den Nasenlöchern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "eb19847f-2061-3446-ab90-0bcff5008354",
                        "entry_id": "f0400807-b6ec-39a0-872b-35a507656aa8",
                        "glosses": [
                            "Bürstenkopf eines Staubsaugers, das Teil mit Rollen an der Unterseite, das mit dem Ansaugrohr verknüpft werden kann, um größere Flächen sauberzusaugen"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "4e3284d7-d8cd-47bf-8adb-b3c55f73e85a",
                                "sense_id": "eb19847f-2061-3446-ab90-0bcff5008354",
                                "text": "Der Handwerker konnte den Boden schneller und effizienter mithilfe des Schnuddels säubern."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "203e48ac-5e1b-3011-9adf-cd9b8b0538af",
                        "entry_id": "f0400807-b6ec-39a0-872b-35a507656aa8",
                        "glosses": [
                            "Figur aus den Büchern des Autors Janosch"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "59d20eca-86a2-44ca-a7b6-ac85f9cd9bc5",
                                "sense_id": "203e48ac-5e1b-3011-9adf-cd9b8b0538af",
                                "text": "„Einige seiner bekanntesten Figuren sind Schnuddel oder die Tigerente, die zusammen mit dem Tiger und dem Bären in ‚Post für den Tiger‘, ‚Oh, wie schön ist Panama‘ (verfilmt unter dem gleichen Titel) und ‚Ich mach dich gesund, sagte der Bär‘ auftrat.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
