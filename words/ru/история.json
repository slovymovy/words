{
    "word_family": [
        "историк",
        "исторический",
        "доисторический"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "06d2c347-a835-3858-9c24-81344e68f401",
                    "sense_definition": "Наука, изучающая прошлое человеческого общества, факты и закономерности его развития.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Завтра у нас будет важный экзамен по <w>истории</w>.",
                            "target_lang_translations": {
                                "en": "Tomorrow we will have an important <w>history</w> exam.",
                                "zh": "明天我们要进行一场重要的<w>历史</w>考试。"
                            }
                        },
                        {
                            "text": "Мой брат очень любит читать книги по древней <w>истории</w>.",
                            "target_lang_translations": {
                                "en": "My brother loves reading books on ancient <w>history</w>.",
                                "zh": "我弟弟非常喜欢读关于古代<w>历史</w>的书。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "урок истории",
                        "учитель истории",
                        "всемирная история",
                        "история России",
                        "учебник истории"
                    ],
                    "target_lang_definitions": {
                        "en": "The branch of knowledge dealing with past events and the study of human development.",
                        "zh": "研究人类社会过去、事实及其发展规律的学科。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "history",
                                "target_lang_sense_clarification": "field of study"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "历史",
                                "target_lang_sense_clarification": "作为学科的名称"
                            },
                            {
                                "target_lang_word": "历史学",
                                "target_lang_sense_clarification": "作为学术研究领域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24c184a9-4c7a-327a-afb2-aa7e7ac574c4",
                    "sense_definition": "Рассказ или повествование о каких-либо событиях (реальных или вымышленных).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "narrative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Бабушка рассказала нам интересную <w>историю</w> о своей молодости.",
                            "target_lang_translations": {
                                "en": "Grandma told us an interesting <w>story</w> about her youth.",
                                "zh": "奶奶给我们讲了一个关于她年轻时的有趣<w>故事</w>。"
                            }
                        },
                        {
                            "text": "Это очень длинная и запутанная <w>история</w>, я расскажу её позже.",
                            "target_lang_translations": {
                                "en": "It's a very long and complicated <w>story</w>, I'll tell it later.",
                                "zh": "这是一个很长且复杂的情况，我以后再告诉你。"
                            }
                        }
                    ],
                    "synonyms": [
                        "рассказ",
                        "случай"
                    ],
                    "common_phrases": [
                        "интересная история",
                        "рассказывать историю",
                        "любовная история",
                        "страшная история",
                        "выдуманная история"
                    ],
                    "target_lang_definitions": {
                        "en": "An account of imaginary or real people and events told for entertainment.",
                        "zh": "关于真实或虚构事件的叙述或故事。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "story",
                                "target_lang_sense_clarification": "narrative"
                            },
                            {
                                "target_lang_word": "tale",
                                "target_lang_sense_clarification": "narrative"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "故事",
                                "target_lang_sense_clarification": "叙述性的内容"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ffec0df-7578-3678-bdbe-057d6bcd7e9e",
                    "sense_definition": "Совокупность фактов и событий прошлого; последовательный ход развития чего-либо.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "past_events",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это великое событие навсегда войдёт в <w>историю</w> нашей страны.",
                            "target_lang_translations": {
                                "en": "This great event will go down in the <w>history</w> of our country forever.",
                                "zh": "这一伟大事件将永远载入我国的<w>历史</w>。"
                            }
                        },
                        {
                            "text": "Врач внимательно изучил <w>историю</w> болезни нового пациента.",
                            "target_lang_translations": {
                                "en": "The doctor carefully studied the new patient's medical <w>history</w>.",
                                "zh": "医生仔细研究了新病人的<w>病史</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "прошлое"
                    ],
                    "common_phrases": [
                        "войти в историю",
                        "колесо истории",
                        "история болезни",
                        "новейшая история",
                        "ход истории"
                    ],
                    "target_lang_definitions": {
                        "en": "The whole series of past events connected with someone or something; a record of such events.",
                        "zh": "过去发生的事实和事件的总和；事物发展的过程。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "history",
                                "target_lang_sense_clarification": "past events"
                            },
                            {
                                "target_lang_word": "record",
                                "target_lang_sense_clarification": "documented facts"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "历史",
                                "target_lang_sense_clarification": "过去发生的事实"
                            },
                            {
                                "target_lang_word": "病史",
                                "target_lang_sense_clarification": "医疗记录"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed25b661-8aea-3152-82ed-5017a62265e3",
                    "sense_definition": "Случай, происшествие или событие, которое произошло с кем-либо (часто неожиданное или курьёзное).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "incident",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Со мной вчера приключилась очень забавная <w>история</w> в магазине.",
                            "target_lang_translations": {
                                "en": "A very funny <w>story</w> happened to me at the store yesterday.",
                                "zh": "昨天在商店里，我遇到了一件非常有趣的<w>事</w>。"
                            }
                        },
                        {
                            "text": "Мы долго смеялись, когда вспоминали эту нелепую <w>историю</w>.",
                            "target_lang_translations": {
                                "en": "We laughed for a long time when recalling this ridiculous <w>story</w>.",
                                "zh": "当我们回忆起那件荒唐的<w>事</w>时，笑了很久。"
                            }
                        }
                    ],
                    "synonyms": [
                        "случай",
                        "происшествие",
                        "приключение"
                    ],
                    "common_phrases": [
                        "смешная история",
                        "вот так история",
                        "целая история",
                        "вечная история"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An event or occurrence, often one that is amusing, unusual, or unexpected.",
                        "zh": "发生在某人身上的事件或经历，常指意外或有趣的事。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "story",
                                "target_lang_sense_clarification": "anecdote"
                            },
                            {
                                "target_lang_word": "incident",
                                "target_lang_sense_clarification": "occurrence"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "经历",
                                "target_lang_sense_clarification": "个人遭遇的事件"
                            },
                            {
                                "target_lang_word": "事",
                                "target_lang_sense_clarification": "口语中指代发生的事情"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60d69b6e-b619-3773-b187-c75311a3d4b7",
                    "sense_definition": "Неприятная ситуация, скандал или затруднительное положение.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "trouble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он вечно попадает в какие-то неприятные <w>истории</w> из-за своего характера.",
                            "target_lang_translations": {
                                "en": "He is always getting into some unpleasant <w>trouble</w> because of his character.",
                                "zh": "因为他的性格，他总是陷入各种<w>麻烦</w>中。"
                            }
                        },
                        {
                            "text": "Из-за твоего опоздания на работе вышла скверная <w>история</w>.",
                            "target_lang_translations": {
                                "en": "A nasty <w>mess</w> turned out at work because of your lateness.",
                                "zh": "因为你迟到，工作上出了个大<w>乱子</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "скандал",
                        "неприятность",
                        "переплёт"
                    ],
                    "common_phrases": [
                        "влипнуть в историю",
                        "попасть в историю",
                        "скверная история",
                        "неприятная история"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A difficult, unpleasant, or scandalous situation.",
                        "zh": "令人不快的情况、丑闻或困境。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "trouble",
                                "target_lang_sense_clarification": "difficult situation"
                            },
                            {
                                "target_lang_word": "mess",
                                "target_lang_sense_clarification": "problematic situation"
                            },
                            {
                                "target_lang_word": "scrape",
                                "target_lang_sense_clarification": "predicament"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "麻烦",
                                "target_lang_sense_clarification": "困境或棘手的情况"
                            },
                            {
                                "target_lang_word": "乱子",
                                "target_lang_sense_clarification": "混乱或糟糕的局面"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}