                    "target_lang_definitions": {
                        "ru": "Акт появления или выхода наружу.",
                        "tr": "Ortaya çıkma veya görünme eylemi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "появление",
