                ],
                "senses": [
                    {
                        "sense_id": "118571cc-4475-3a6f-b6f5-44df460ce346",
                        "entry_id": "96609282-1fb4-3cb5-8ec1-96160dbe1f4a",
                        "glosses": [
                            "Material, das zum Abdichten von etwas verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdcae35e-fefb-48db-9596-288f3802e442",
                                "sense_id": "118571cc-4475-3a6f-b6f5-44df460ce346",
                                "text": "„Bei dieser Technik sind in der Fahrbahn, quer zur Fahrtrichtung und meist in einem Abstand von jeweils einem Meter zueinander, drei Messingstränge mit Piezokristallen eingelassen. Diese liegen etwa zweieinhalb Zentimeter tief im Asphalt und werden von einem speziellen Dichtungsmaterial bedeckt.“"
                            },
                            {
                                "example_id": "f43c20b7-8e93-438c-b168-be780d45c424",
                                "sense_id": "118571cc-4475-3a6f-b6f5-44df460ce346",
                                "text": "„Oder in Privathäusern, in denen sich die Besitzer selbst am Verlegen von Kupfer- oder Nickelrohren versuchten und Dichtungsmaterial nutzten, das nicht gut geeignet sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
