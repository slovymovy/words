                ],
                "senses": [
                    {
                        "sense_id": "684a42ea-c0d3-3096-9df2-278c64a9cbe9",
                        "entry_id": "48940bad-636e-3325-8c5c-98757e40a530",
                        "glosses": [
                            "Eröffnung des Spiels im Mittelkreis, indem der Ball vom Schiedsrichter senkrecht zwischen zwei Spielern der beiden Mannschaften hochgeworfen wird, woraufhin diese nach dem Ball springen und ihn zu erobern versuchen"
                        ],
                        "tags": [
                            "Basketball"
                        ],
                        "examples": [
                            {
                                "example_id": "87eb149b-bc4a-4f4f-9c03-92921885d274",
                                "sense_id": "684a42ea-c0d3-3096-9df2-278c64a9cbe9",
                                "text": "„Eric und die Nummer 4 der Skorpions sprangen hoch, um den Sprungball zu fangen.“"
                            },
                            {
                                "example_id": "6932b98b-6304-459b-809e-8a9e7b9ecfe6",
                                "sense_id": "684a42ea-c0d3-3096-9df2-278c64a9cbe9",
                                "text": "„Das Spiel beginnt mit einem Sprungball im Mittelkreis.“"
                            },
                            {
                                "example_id": "3a5cab23-70f3-43ae-8b0d-4361fdce9891",
                                "sense_id": "684a42ea-c0d3-3096-9df2-278c64a9cbe9",
                                "text": "„Ein Sprungball wird nur zur Spieleröffnung durchgeführt.“"
                            },
                            {
                                "example_id": "24448113-4ff3-4e9f-8b00-05d1fb32e286",
                                "sense_id": "684a42ea-c0d3-3096-9df2-278c64a9cbe9",
                                "text": "[Alba Berlin – Bayern München] „Die Berliner gewannen zwar den Sprungball, doch die Bayern kamen deutlich besser ins Spiel.“"
                            },
                            {
                                "example_id": "6e6589c6-691b-44ed-a0f8-9be56765d470",
                                "sense_id": "684a42ea-c0d3-3096-9df2-278c64a9cbe9",
                                "text": "[…] „Williamson schien dem Publikum von Anfang an genau das geben zu wollen, was es erwartet hatte. In den ersten 30 Sekunden des Spiels gewann er den Sprungball gegen den sieben Zentimeter größeren Rocky Kreuser, kämpfte sich anschließend durch die Defense der Bisons, um sich gegen zwei Verteidiger am Korb durchzusetzen und hämmerte dann in der Defense den Wurfversuch von Sam Greisel in Richtung Zuschauertribüne.“"
                            },
                            {
                                "example_id": "19767519-cf71-4038-8823-06423945e780",
                                "sense_id": "684a42ea-c0d3-3096-9df2-278c64a9cbe9",
                                "text": "„Die Spielzeit beträgt 4 x 10 Minuten gestoppte Zeit. Die Zeit beginnt zu laufen, wenn zum Spielbeginn der Ball beim Sprungball getippt wird.“"
                            },
                            {
                                "example_id": "980afbef-653d-48ca-8cfe-ba119e24f383",
                                "sense_id": "684a42ea-c0d3-3096-9df2-278c64a9cbe9",
                                "text": "„Die Spieler der Milwaukee Bucks und der Detroit Pistons gingen nach dem Sprungball auf ein Knie und wiederholten die Geste nach dem Wechsel des Ballbesitzes ein zweites Mal.“"
                            },
                            {
                                "example_id": "d33c95e5-9304-424b-b22b-03662221471d",
                                "sense_id": "684a42ea-c0d3-3096-9df2-278c64a9cbe9",
                                "text": "„Der letzte Auftritt der deutschen Basketball-Nationalmannschaft bei der Weltmeisterschaft in China war im Grunde schon vor dem ersten Sprungball nur noch eine Formsache.“"
                            },
                            {
                                "example_id": "a82680b1-8c2c-4ad7-8f38-19cfb36162a4",
                                "sense_id": "684a42ea-c0d3-3096-9df2-278c64a9cbe9",
                                "text": "„Bereits vor dem Sprungball stand fest, dass Nigeria nach drei Pleiten ausgeschieden und Deutschland mindestens Dritter in der Vorrundengruppe B ist.“"
                            },
                            {
                                "example_id": "0b80bd6d-2ed4-49da-b9d4-d58df3a01784",
                                "sense_id": "684a42ea-c0d3-3096-9df2-278c64a9cbe9",
                                "text": "„Der Arbeitskampf in der nordamerikanischen Basketballliga ist zu Ende. Der erste Sprungball erfolgt am Weihnachtstag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
