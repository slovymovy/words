                    }
                ],
                "senses": [
                    {
                        "sense_id": "f73c6aa9-6337-3044-8e3d-07a20f69a2a1",
                        "entry_id": "f6bcb42e-83c7-3469-aaf5-cb05f74a043e",
                        "glosses": [
                            "bruut onbeschaafd gedrag"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "0a077cb9-0f74-4b17-98b8-59b5ace42d30",
                                "sense_id": "f73c6aa9-6337-3044-8e3d-07a20f69a2a1",
                                "text": "In landen met een democratische traditie is het verleidelijk om in de waan te verkeren dat het ons nooit zal overkomen: onze politieke instellingen zijn immers te sterk, of ons volk houdt zo van zijn vrijheid, of wij zijn te modern en beschaafd om in barbarisme te vervallen."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3ad7403-c8bc-3873-866c-115668e849b3",
                        "entry_id": "f6bcb42e-83c7-3469-aaf5-cb05f74a043e",
                        "glosses": [
                            "woord of uitdrukking overgenomen uit een andere taal of gevormd naar een andere taal"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "5a4581c3-d781-407a-88cb-e1a92d9a4a14",
                                "sense_id": "f3ad7403-c8bc-3873-866c-115668e849b3",
                                "text": "Weer struikelde ik over het barbarisme racisme, dit keer in de Ombudsman (…). Als Frans woord moet het als 'rasiezme' worden uitgesproken, maar het wordt doorgaans als een soort Engels beschouwd. Dan moet het als 'resism' worden verklankt, maar iedereen doet net alsof er 'rassisme' staat. Waarom schrijven we het dan niet zo, net als 'Rassismus' in het Duits?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82383f37-d628-4d10-9488-d9bf8ba19b40",
                        "source_entry_id": "f6bcb42e-83c7-3469-aaf5-cb05f74a043e",
                        "source_sense_id": "f73c6aa9-6337-3044-8e3d-07a20f69a2a1",
                        "source_sense_description": "woord of uitdrukking uit een andere taal",
                        "target_lang_word": "Barbarismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Barbarismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "38ea0dfc-37b5-3980-ac9d-dd454fde78e6",
                                        "entry_id": "0e2d2380-a0e7-3a7a-90b0-11727e9eded2",
                                        "glosses": [
                                            "fremdsprachiger Ausdruck, der ins Griechische oder Lateinische übernommen wurde, in neuerer Zeit auch generell für Fremd- und Lehnwörter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6753d0d0-f300-4fad-b253-574422a97d7a",
                                                "sense_id": "38ea0dfc-37b5-3980-ac9d-dd454fde78e6",
                                                "text": "„Es bildet im Deutschen den Höhepunkt jener jahrhundertealten Tradition sogenannter Antibarbari, die der Bekämpfung von »Barbarismen« in Sprache und Stil dienten: Negativzusammenstellungen speziell stilistischer Fehler und Unschönheiten, die vor allen Dingen abschrecken sollten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3fc05b4c-708d-3bb2-8b2f-1351ed74c7ed",
                                        "entry_id": "0e2d2380-a0e7-3a7a-90b0-11727e9eded2",
                                        "glosses": [
                                            "schwere sprachliche Fehlleistung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "594e6281-f35a-4d47-9d8e-44cacf1e7c01",
                                                "sense_id": "3fc05b4c-708d-3bb2-8b2f-1351ed74c7ed",
                                                "text": "„Es bildet im Deutschen den Höhepunkt jener jahrhundertealten Tradition sogenannter Antibarbari, die der Bekämpfung von »Barbarismen« in Sprache und Stil dienten: Negativzusammenstellungen speziell stilistischer Fehler und Unschönheiten, die vor allen Dingen abschrecken sollten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "426ae66a-e3fd-3077-a577-d2dc7b444e06",
                                        "entry_id": "0e2d2380-a0e7-3a7a-90b0-11727e9eded2",
                                        "glosses": [
                                            "grausames Verhalten"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b239cc2-4c70-46a0-b0a1-f061193b9f72",
                                                "sense_id": "426ae66a-e3fd-3077-a577-d2dc7b444e06",
                                                "text": "„Sich wehren gegen den modernen Barbarismus und seine Vertreter, nicht resignieren – das ist Remarques Botschaft an die Gefolterten, Vertriebenen und Verzagten, die vor Hitlers Mordknechten in die letzten Winkel der Erde geflohen waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50745ef8-5b20-4afd-b4fb-e44946dd4e17",
                        "source_entry_id": "f6bcb42e-83c7-3469-aaf5-cb05f74a043e",
                        "source_sense_id": "f73c6aa9-6337-3044-8e3d-07a20f69a2a1",
                        "source_sense_description": "woord of uitdrukking uit een andere taal",
                        "target_lang_word": "barbarism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barbarism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf650bd2-f043-3bd7-b216-5b53bd306ec4",
                                        "entry_id": "1ff7f523-bf98-3afb-a400-5f852149a576",
                                        "glosses": [
                                            "A barbaric act."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b88561a-4ceb-482d-b2b1-720fba69f755",
                                                "sense_id": "cf650bd2-f043-3bd7-b216-5b53bd306ec4",
                                                "text": "These barbarisms can not be allowed to continue; they must be crushed or civilization will collapse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46f6b49d-f6a7-388d-8b10-a0258b755cb1",
                                        "entry_id": "1ff7f523-bf98-3afb-a400-5f852149a576",
                                        "glosses": [
                                            "The condition of existing barbarically."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98f6e1cc-5aa8-4763-8585-4fb41941c3c1",
                                                "sense_id": "46f6b49d-f6a7-388d-8b10-a0258b755cb1",
                                                "text": "Like dancing, it is a remnant of ancient barbarism—fit for the days of the Chaldeans or the Babylonians, when people were only amused through their eyes—the sole entertainment of which savage nations are susceptible."
                                            },
                                            {
                                                "example_id": "1714fdc3-3bd1-4d86-9384-d8f111f60a73",
                                                "sense_id": "46f6b49d-f6a7-388d-8b10-a0258b755cb1",
                                                "text": "War is at best barbarism... Its glory is all moonshine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04abb23e-d992-32a7-b96b-213c0ec99a0d",
                                        "entry_id": "1ff7f523-bf98-3afb-a400-5f852149a576",
                                        "glosses": [
                                            "A word hybridizing Ancient Greek and Latin or other heterogeneous roots."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6e2a330-d57a-3b88-9130-32f927072e85",
                                        "entry_id": "1ff7f523-bf98-3afb-a400-5f852149a576",
                                        "glosses": [
                                            "An error in language use within a single word, such as a mispronunciation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd62cde1-8af9-4641-a09d-6c926c6090ac",
                                                "sense_id": "c6e2a330-d57a-3b88-9130-32f927072e85",
                                                "text": "In the jargon of the ancient grammarian, penacilin would be a barbarism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "447f4454-cad2-4921-8a4c-4ea7e60dbda4",
                        "source_entry_id": "f6bcb42e-83c7-3469-aaf5-cb05f74a043e",
                        "source_sense_id": "f73c6aa9-6337-3044-8e3d-07a20f69a2a1",
                        "source_sense_description": "woord of uitdrukking uit een andere taal",
                        "target_lang_word": "barbarisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barbarisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b8bbb559-575a-3941-8d21-c73425177c0c",
                                        "entry_id": "5cc845ef-de75-39fd-9a1f-a0c4b19accab",
                                        "glosses": [
                                            "Mot ou forme incorrecte, ou dont le sens est altéré, dévié. → voir impropriété et solécisme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd381334-e1e5-4262-83f7-055a524ac7fd",
                                                "sense_id": "b8bbb559-575a-3941-8d21-c73425177c0c",
                                                "text": "Un barbarisme heureux reste dans une langue sans la défigurer ; des solécismes ne s’y établissent jamais sans la détruire."
                                            },
                                            {
                                                "example_id": "2027f7d5-3327-4c80-8544-3b796004442b",
                                                "sense_id": "b8bbb559-575a-3941-8d21-c73425177c0c",
                                                "text": "Par un barbarisme de la basse latinité, on a dit essere au lieu de esse, pour se conformer à la terminaison ordinaire des infinitifs latins; essere ensuite a été contracté en ser; et le futur est composé de cet infinitif et du présent du verbe auxiliaire: ser-ai, ser-as, ser-a."
                                            },
                                            {
                                                "example_id": "c1006509-6dec-4fe2-a925-4c50a52593b9",
                                                "sense_id": "b8bbb559-575a-3941-8d21-c73425177c0c",
                                                "text": "Il y a (dit Voltaire sur un vers du Cid) un dictionnaire d’orthographe où il est dit qu’« invaincu » est un barbarisme. Non ; c’est un terme hasardé et nécessaire. Il y a deux sortes de barbarisme, celui des mots et celui des phrases. Égaliser les fortunes pour égaler ; éduquer, pour donner de l’éducation, voilà des barbarismes de mots."
                                            },
                                            {
                                                "example_id": "1f36dc2d-dc6e-482f-b033-cf5c3141c5a2",
                                                "sense_id": "b8bbb559-575a-3941-8d21-c73425177c0c",
                                                "text": "— Jusque midi, je corrige les devoirs de mes élèves. Ce n’est pas amusant…\n— Ah ?\n— De lire quinze copies qui, s’il y avait un barbarisme à faire, le contiennent quinze fois. Au crayon rouge, j’inscris mes notes dans le coin : mal, très mal, inepte…"
                                            },
                                            {
                                                "example_id": "62c16f0a-3520-4273-b876-fcdcc9c3f131",
                                                "sense_id": "b8bbb559-575a-3941-8d21-c73425177c0c",
                                                "text": "Quant au terme « érotisme », il n'est pas plus dans le Littré qu’humanisme, ces barbarismes étant nés au même moment engendrés par un même père ; la fascisation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dbe0069-a9e8-30d9-b183-140121fdd714",
                                        "entry_id": "5cc845ef-de75-39fd-9a1f-a0c4b19accab",
                                        "glosses": [
                                            "Faute contre la règle ou le bon goût."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "029ce124-975b-3056-b1a0-26af16ddcb78",
                                        "entry_id": "5cc845ef-de75-39fd-9a1f-a0c4b19accab",
                                        "glosses": [
                                            "Acte qui relève de la barbarie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21d27ecb-a5f6-44d1-8f16-a9e13f64a716",
                                                "sense_id": "029ce124-975b-3056-b1a0-26af16ddcb78",
                                                "text": "La première sélection des écrits de Maurras présentés en traduction au public britannique est donc condamnable à l'avance, parce que contaminée dès le point de départ par sa présupposée affinité avec le barbarisme nazi."
                                            },
                                            {
                                                "example_id": "5322d289-af25-4f11-bde5-63879ea66fa9",
                                                "sense_id": "029ce124-975b-3056-b1a0-26af16ddcb78",
                                                "text": "Dès le printemps 1940, il invite ses disciples à refuser de se « plier au barbarisme hitlérien » et publie au début de l'été 1940 un appel pour exhorter les chrétiens « à résister, du moins spirituellement, à la folie allemande qui horrifie les hommes »."
                                            },
                                            {
                                                "example_id": "5e2d8641-20ea-4f1d-b5f1-340937c94dde",
                                                "sense_id": "029ce124-975b-3056-b1a0-26af16ddcb78",
                                                "text": "Je ne supporte plus ce que l'Homme me force à faire. Sa haine, sa violence, son barbarisme, je n'en suis pas responsable."
                                            },
                                            {
                                                "example_id": "1d3f03a6-a9d8-4e36-aa06-76e5e3ce56b5",
                                                "sense_id": "029ce124-975b-3056-b1a0-26af16ddcb78",
                                                "text": "Je ne supporte plus cette violence, dit-elle. Où que j'aille à Londres, je ne vois que barbarisme et cruauté."
                                            },
                                            {
                                                "example_id": "de60850f-1fd0-491a-8ef3-7feb515747ee",
                                                "sense_id": "029ce124-975b-3056-b1a0-26af16ddcb78",
                                                "text": "Puis-je demander au lecteur, […], de se vider l'esprit des images de ce monde, ravagé par les quelques millénaires post-néolithique de barbarisme ; cet antimonde qui se mirait sans cesse dans ses miroirs déformants..."
                                            },
                                            {
                                                "example_id": "b69773a1-5068-4703-a6a9-5e87c0936f80",
                                                "sense_id": "029ce124-975b-3056-b1a0-26af16ddcb78",
                                                "text": "[…] si cette action était démontrée à l'encontre de Morelli, elle constituerait un crime de droit commun, l'achèvement d'un blessé étant un acte de barbarisme odieux, contraire aux lois de l'honneur et de la guerre, depuis longtemps indiscutées par les nations civilisées, et ce fait étant prévu par les dispositions de l'article 233 du Code pénal français."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
