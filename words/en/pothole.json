{
    "word_family": [
        "potholer",
        "potholing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a70764a5-ddc4-3c17-a8a1-571f5deda0a1",
                    "sense_definition": "A hollow depression or hole in a road surface, caused by erosion, weathering, or traffic.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pit_or_cavity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car bounced sharply after hitting a deep <w>pothole</w> in the middle of the road.",
                            "target_lang_translations": {
                                "zh": "汽车在撞上路中央一个很深的<w>坑洼</w>后猛烈颠簸了一下。"
                            }
                        },
                        {
                            "text": "The local council promised to fix every dangerous <w>pothole</w> before winter.",
                            "target_lang_translations": {
                                "zh": "地方议会承诺在入冬前修补每一个危险的<w>坑洞</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "deep pothole",
                        "pothole in the road"
                    ],
                    "target_lang_definitions": {
                        "zh": "（路面因侵蚀、风化或车流磨损而形成的）坑洼，凹坑"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "坑洼",
                                "target_lang_sense_clarification": "路面上的凹坑"
                            },
                            {
                                "target_lang_word": "路面坑洼",
                                "target_lang_sense_clarification": "道路受损形成的洞"
                            },
                            {
                                "target_lang_word": "坑洞",
                                "target_lang_sense_clarification": "路面破损凹陷处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17705f5c-c7cf-3a86-9b76-6c6af99aa8ec",
                    "sense_definition": "A deep, vertical shaft or cave system, typically found in limestone terrain.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pit_or_cavity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The adventurous team used special climbing gear to descend into the limestone <w>pothole</w>.",
                            "target_lang_translations": {
                                "zh": "这支探险队使用专门的攀爬装备下潜到石灰岩<w>落水洞</w>中。"
                            }
                        },
                        {
                            "text": "Water dripping into the <w>pothole</w> had shaped strange rock formations over centuries.",
                            "target_lang_translations": {
                                "zh": "几个世纪以来，滴入<w>落水洞</w>的水塑造出了奇特的岩石形态。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（尤指石灰岩地形中的）落水洞，垂直竖井洞穴"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "落水洞",
                                "target_lang_sense_clarification": "喀斯特地貌中的溶洞竖井"
                            },
                            {
                                "target_lang_word": "竖井",
                                "target_lang_sense_clarification": "天然形成的垂直深洞"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fcbfe24-4e2d-396d-8a50-00af306e5e92",
                    "sense_definition": "A rounded, water-worn pit carved into the rocky bed of a turbulent stream or river.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pit_or_cavity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Swirling river water slowly hollowed out a natural <w>pothole</w> in the bedrock.",
                            "target_lang_translations": {
                                "zh": "旋转的河水在基岩上慢慢冲蚀出一个天然的<w>壶穴</w>。"
                            }
                        },
                        {
                            "text": "Hikers stopped to admire a smooth <w>pothole</w> along the canyon floor.",
                            "target_lang_translations": {
                                "zh": "徒步旅行者停下来欣赏峡谷底部平滑的<w>壶穴</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "giant kettle"
                    ],
                    "target_lang_definitions": {
                        "zh": "（急流或河床岩石受水流冲刷侵蚀磨成的）壶穴"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "壶穴",
                                "target_lang_sense_clarification": "河流岩石基底受冲蚀形成的凹坑"
                            },
                            {
                                "target_lang_word": "瓯穴",
                                "target_lang_sense_clarification": "地质学中水流冲刷出的石穴"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "597c3dea-dcbf-3fd4-9cb9-82ea64b79d0a",
                    "sense_definition": "A pit dug illicitly by treasure hunters, metal detectorists, or vandals.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pit_or_cavity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Archaeologists found that looters had left an illicit <w>pothole</w> across the ancient mound.",
                            "target_lang_translations": {
                                "zh": "考古学家发现盗墓者在古墓封土上留下了一个非法的<w>盗洞</w>。"
                            }
                        },
                        {
                            "text": "Park rangers surveyed each fresh <w>pothole</w> dug by unauthorized treasure hunters.",
                            "target_lang_translations": {
                                "zh": "公园护林员勘查了未经授权的寻宝者挖出的每一个新<w>盗掘坑</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（盗墓者、寻宝者或破坏者非法挖掘的）盗洞，非法盗掘坑"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "盗洞",
                                "target_lang_sense_clarification": "非法盗掘留下的坑洞"
                            },
                            {
                                "target_lang_word": "盗掘坑",
                                "target_lang_sense_clarification": "非法寻宝挖出的小坑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5402d14-44b9-3a82-a75e-f31a3fdfbd94",
                    "sense_definition": "A shallow hole or pit dug while prospecting for gold, opal, or other minerals.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pit_or_cavity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prospector shoveled dirt from a shallow <w>pothole</w> hoping to find traces of gold.",
                            "target_lang_translations": {
                                "zh": "探矿者从一个浅浅的<w>探坑</w>里铲出泥土，希望能找到黄金的痕迹。"
                            }
                        },
                        {
                            "text": "A newly abandoned <w>pothole</w> stood as evidence of the recent opal rush.",
                            "target_lang_translations": {
                                "zh": "一个刚被废弃的<w>试掘坑</w>证明了近期掀起的蛋白石淘金热。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（勘探金矿、蛋白石等矿物时挖出的）试掘坑，勘探浅坑"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "探坑",
                                "target_lang_sense_clarification": "勘探采矿时挖掘的浅坑"
                            },
                            {
                                "target_lang_word": "试掘坑",
                                "target_lang_sense_clarification": "淘金或采矿用的浅坑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98b5dc3b-24cc-3d2c-955a-2e88804e64dc",
                    "sense_definition": "A hyperlink whose visible anchor text differs from the title of the destination page; a piped link.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor inserted a subtle <w>pothole</w> so readers could navigate to the related entry.",
                            "target_lang_translations": {
                                "zh": "编辑插入了一个隐蔽的<w>管道链接</w>，以便读者跳转到相关条目。"
                            }
                        },
                        {
                            "text": "Using a piped <w>pothole</w> in the article avoided repeating long titles unnecessarily.",
                            "target_lang_translations": {
                                "zh": "在文章中使用<w>管道链接</w>避免了不必要地重复长标题。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Internet/wiki jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（网络或维基百科用语）管道链接，显示文字与目标页面标题不一致的超链接"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "管道链接",
                                "target_lang_sense_clarification": "显示文本不同于目标标题的链接"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f83d561a-3ceb-3097-a46c-2a8474d9aba5",
                    "sense_definition": "A hole or circular recess on the surface of a traditional stove into which a cooking pot fits.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She set the iron kettle directly into the stove's <w>pothole</w> to boil water.",
                            "target_lang_translations": {
                                "zh": "她把铁壶直接放在炉灶的<w>灶眼</w>上烧水。"
                            }
                        },
                        {
                            "text": "A rustic stove typically has more than one <w>pothole</w> for cooking different dishes.",
                            "target_lang_translations": {
                                "zh": "传统的农家灶台通常不止一个<w>灶眼</w>，以便烹饪不同的菜肴。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（传统炉灶表面放置锅具的）灶眼，锅孔"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "灶眼",
                                "target_lang_sense_clarification": "传统炉灶上安放锅具的圆孔"
                            },
                            {
                                "target_lang_word": "锅孔",
                                "target_lang_sense_clarification": "炉灶上放锅的孔洞"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}