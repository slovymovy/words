                                                "example_id": "de390080-5387-4721-be31-dbc59d0cf72a",
                                                "sense_id": "a48e5758-7493-3ee3-bcce-e0db88636305",
                                                "text": "Er worden hier momenteel renovaties uitgevoerd."
                                            },
                                            {
                                                "example_id": "f4da0c63-c03a-46a2-948c-f4a370385a94",
                                                "sense_id": "a48e5758-7493-3ee3-bcce-e0db88636305",
                                                "text": "Het museum is de komende jaren nog dicht voor renovatie. Vorig jaar opende koning Willem-Alexander het internationaal geroemde Depot Boijmans van Beuningen. Het was het eerste kunstdepot ter wereld dat toegankelijk is voor publiek en kwam mede uit de koker van Ex."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32347b9b-a17e-3879-84bf-ae15d43ea1d1",
                                        "entry_id": "ca0a094e-1198-3e94-8160-72e0c1fe1032",
                                        "glosses": [
                                            "de laatste aanmaning tot betaling"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4927327-30af-4f9d-bfcf-b638438a6141",
                                                "sense_id": "32347b9b-a17e-3879-84bf-ae15d43ea1d1",
                                                "text": "De renovatie is gisteren verstuurd."
                                            }
