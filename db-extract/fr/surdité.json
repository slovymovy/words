                                        "entry_id": "602638db-c048-3cba-8057-1749c949c82f",
                                        "glosses": [
                                            "die Gefühllosigkeit und Betäubung, nicht fühlen zu können (sensorisch, nicht emotional)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
