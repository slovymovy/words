                "senses": [
                    {
                        "sense_id": "5f9bf938-af36-3403-b997-590d5adb95a1",
                        "entry_id": "d536370f-69e0-3616-b6a6-97d8d533310b",
                        "glosses": [
                            "meist auf drei Schienen verstellbare Vorrichtung zur Aufnahme der Füße / Schuhe in einem Ruderboot / auf einem Ruderergometer"
                        ],
                        "tags": [
                            "Rudern"
                        ],
                        "examples": [
                            {
                                "example_id": "5efb86e1-aa6b-4ae9-a769-fa870e5c12ed",
                                "sense_id": "5f9bf938-af36-3403-b997-590d5adb95a1",
                                "text": "Je größer der Ruderer, um so weiter wird das Stemmbrett Richtung Heck verschoben."
                            },
                            {
                                "example_id": "c18728ad-aa19-4696-86be-5df75ecb8e4f",
                                "sense_id": "5f9bf938-af36-3403-b997-590d5adb95a1",
                                "text": "Die Füße sind mit einem Stemmbrett am Boot fixiert."
                            },
                            {
                                "example_id": "e4083b35-167e-496c-9ec0-500ff94b8604",
                                "sense_id": "5f9bf938-af36-3403-b997-590d5adb95a1",
                                "text": "Man stößt sich mit den Beinen vom Stemmbrett ab und über Rumpf und Rücken überträgt sich die Kraft auf das Gerät."
                            },
                            {
                                "example_id": "2d8256e7-ac6a-4994-92d0-6bd2412b4be7",
                                "sense_id": "5f9bf938-af36-3403-b997-590d5adb95a1",
                                "text": "Der ideale Winkel des Stemmbretts zum Kielschwein beträgt knapp 45°."
                            },
                            {
                                "example_id": "fd8bcd6a-b3e6-4d82-a89e-0527eb46cbe8",
                                "sense_id": "5f9bf938-af36-3403-b997-590d5adb95a1",
                                "text": "Wenn Sie im Endzug zu wenig Platz zwischen den Griffenden haben, sollen Sie das Stemmbrett in Richtung Bug verstellen."
                            },
                            {
                                "example_id": "cf9cf953-df67-4fdd-838e-12f405f6719d",
                                "sense_id": "5f9bf938-af36-3403-b997-590d5adb95a1",
                                "text": "Jüngst ließ er [Karl Adam] an den Stemmbrettern für jeden Athleten maßgefertigte Ruderschuhe anbringen, damit beim Vor- und Zurückrollen niemand mehr abrutscht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
