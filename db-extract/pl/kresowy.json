                "translations": [
                    {
                        "translation_id": "776480d0-69bc-48d3-a880-347cba2d4d6e",
                        "source_entry_id": "1861cfa0-676d-3bd8-967f-9aa91dddd810",
                        "source_sense_id": "53097e09-b702-3fa8-b371-02936e953c7e",
                        "target_lang_word": "borderline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "borderline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdbd4cec-4e9b-33d4-867a-be42b4eb03db",
                                        "entry_id": "8439e667-c119-38c6-8f48-05bbd1f2317d",
                                        "glosses": [
                                            "Nearly; not clearly on one side or the other of a border or boundary, ambiguous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "566854e9-b59f-4087-a261-472880821d9c",
                                                "sense_id": "cdbd4cec-4e9b-33d4-867a-be42b4eb03db",
                                                "text": "I would rather hire a talented layman than a university graduate with borderline qualifications."
                                            },
                                            {
                                                "example_id": "0540f456-0a9b-46b7-a8cf-bae2cc2c013f",
                                                "sense_id": "cdbd4cec-4e9b-33d4-867a-be42b4eb03db",
                                                "text": "It recalls the business case for Scotland's reopening of the Borders Railway to Tweedbank, that British Rail closed in 1969. The review says the business case for this was at best borderline, but goes on to say that the case greatly underestimated passenger demand and that the railway Scotland built has capped its capacity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7db8e016-8e42-31ee-ad5f-182a16c23d1a",
                                        "entry_id": "8439e667-c119-38c6-8f48-05bbd1f2317d",
                                        "glosses": [
                                            "Of questionable taste or acceptability; approaching bad taste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a977c1a6-0847-448c-a128-728e95778705",
                                                "sense_id": "7db8e016-8e42-31ee-ad5f-182a16c23d1a",
                                                "text": "Your borderline remarks about my aunt’s dress destroyed my evening."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa9d8e65-f1ae-3c4b-baf2-abe7103ccff3",
                                        "entry_id": "8439e667-c119-38c6-8f48-05bbd1f2317d",
                                        "glosses": [
                                            "Exhibiting borderline personality disorder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "453e2e18-94bb-4115-b54a-1f5eeafeb843",
                                                "sense_id": "aa9d8e65-f1ae-3c4b-baf2-abe7103ccff3",
                                                "text": "She clearly has borderline and narcissistic features and she meets the criteria for a rapid cycling bipolar disorder, as well as for a generalized anxiety disorder. She has a severe binge eating disorder and has gained 65 pounds since[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "borderline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "734527dc-6e54-3156-88a2-ed945f8ee101",
                                        "entry_id": "8e36ad31-f38b-348e-8b82-917fc68fa82b",
                                        "glosses": [
                                            "Nearly; not entirely but nevertheless to a great extent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72a59403-6779-4958-a855-13a7ca841283",
                                                "sense_id": "734527dc-6e54-3156-88a2-ed945f8ee101",
                                                "text": "He is borderline hypoglycemic and needs to monitor his sugar intake."
                                            },
                                            {
                                                "example_id": "cfeb66eb-bfdc-4469-87de-0ac5bdf6da32",
                                                "sense_id": "734527dc-6e54-3156-88a2-ed945f8ee101",
                                                "text": "I expected him to be super boring but he was actually borderline funny!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "borderline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91606263-d482-3c71-aa88-8c2edb68156c",
                                        "entry_id": "d85c72fe-124e-337d-8199-709c20889ccc",
                                        "glosses": [
                                            "A boundary or accepted division; a border."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8999a4bb-df78-404c-9199-24a3b48a6b00",
                                                "sense_id": "91606263-d482-3c71-aa88-8c2edb68156c",
                                                "text": "She lives on the borderline between reality and madness."
                                            },
                                            {
                                                "example_id": "c23ef819-95f6-4a79-ba16-1a707c252146",
                                                "sense_id": "91606263-d482-3c71-aa88-8c2edb68156c",
                                                "text": "Elbow deep inside the borderline\nShow me that you love me and that we belong together\nShoulder deep within the borderline\nRelax, turn around and take my hand"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24cb1607-1a3d-3743-82f9-f141742ee6a9",
                                        "entry_id": "d85c72fe-124e-337d-8199-709c20889ccc",
                                        "glosses": [
                                            "Ellipsis of borderline personality disorder."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7a20bef-fa48-4f10-a25f-4aee57832b38",
                                                "sense_id": "24cb1607-1a3d-3743-82f9-f141742ee6a9",
                                                "text": "The four overlapping concepts of borderline were as follows : (1) A residual model […] (2) An affective disorder model, which considered BPD as an affective spectrum illness displaying prominent[…]"
                                            },
                                            {
                                                "example_id": "f17f3bec-96a4-4aae-8477-360af7dd472b",
                                                "sense_id": "24cb1607-1a3d-3743-82f9-f141742ee6a9",
                                                "text": "[...] you should consider it! People with Borderline are especially affected by the unconditional affection parenting a pet can provide."
                                            },
                                            {
                                                "example_id": "48a91679-c1ba-4382-bc3d-e879d90187ca",
                                                "sense_id": "24cb1607-1a3d-3743-82f9-f141742ee6a9",
                                                "text": "Subsequent conceptualizations of borderline were based on important contributions from psychoanalysts, […] As a result of its inclusion, appearing as “borderline personality disorder,” the construct gained legitimacy[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1701773e-3260-3d3f-ba1f-f1c7101deffe",
                                        "entry_id": "d85c72fe-124e-337d-8199-709c20889ccc",
                                        "glosses": [
                                            "A person who has borderline personality disorder."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6e66989-7167-4566-8378-2192f829b09f",
                                                "sense_id": "1701773e-3260-3d3f-ba1f-f1c7101deffe",
                                                "text": "As an example of their affective profile, borderlines are set apart from passive aggressives by having more marked social anxiety […] and greater sensitivity […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "borderline",
                                "target_lang_code": "en",
                                "target_senses": [
