                "senses": [
                    {
                        "sense_id": "1230a8b4-6745-3eec-be83-ee7f0bcf9974",
                        "entry_id": "4263dc7b-38c9-3812-b34d-f3048a0c0fb5",
                        "glosses": [
                            "Felsen aus weichem, weißem Kalkstein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15c42b95-4360-4c2d-afa2-266a7517254c",
                                "sense_id": "1230a8b4-6745-3eec-be83-ee7f0bcf9974",
                                "text": "„Die Kreidefelsen haben einen großen Symbolwert für Großbritannien, da sie am schmalsten Teil des Ärmelkanals Kontinentaleuropa zugewandt sind – dort, wo in der Vergangenheit Invasionen drohten und gegen die die Klippen einen symbolischen Schutz darstellen.“"
                            },
                            {
                                "example_id": "96129e38-f741-44c6-b967-80279f6b2f18",
                                "sense_id": "1230a8b4-6745-3eec-be83-ee7f0bcf9974",
                                "text": "„In der Ferne tauchten die Kreidefelsen von Dover auf, die selbst im schwachen Lcht der wolkenverhangenen Sonne weiß über dem grauen, unruhigen Meer erstrahlten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
