                "senses": [
                    {
                        "sense_id": "5bf0a06b-edbe-3493-8537-1cb0150c80f5",
                        "entry_id": "203bd098-4110-35b4-8fdf-d22c2611b218",
                        "glosses": [
                            "nicht gegerbt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b08af11b-8fe5-469c-869f-0de50c6168ed",
                                "sense_id": "5bf0a06b-edbe-3493-8537-1cb0150c80f5",
                                "text": "„Der Junge trug ein Paar alte Calzones und notdürftig zurechtgeflickte Sandalen aus ungegerbtem Leder, sonst war er nackt.“"
                            },
                            {
                                "example_id": "4dd7b1a7-8c39-439d-a76d-2a6abce9408e",
                                "sense_id": "5bf0a06b-edbe-3493-8537-1cb0150c80f5",
                                "text": "„Sie verhökerten vielerlei Waren aus Sisal - Schnüre, Seile, Netze und Sandalen - sowie alle Arten von Fellen, gegerbte und ungegerbte, gefärbte und ungefärbte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
