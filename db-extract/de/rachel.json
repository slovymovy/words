                                        "glosses": [
                                            "A female given name from Hebrew, a spelling variant of Rachel first recorded in the 17th century."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30f23a76-edb1-4b7e-8ba7-60f928430555",
                                                "sense_id": "54ac3dcd-0f13-3edb-a311-c542bb95463a",
