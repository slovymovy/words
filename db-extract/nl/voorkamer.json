                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da21907f-54e7-4296-94b5-0ad20599a723",
                                "sense_id": "38a56ee5-b716-38c1-abef-dbb1a0f7e4e6",
                                "text": "De voorkamer werd van nieuwe vloerbedekking voorzien."
                            },
                            {
                                "example_id": "e8bdbbca-7ac9-473e-a119-659dfc8b3537",
                                "sense_id": "38a56ee5-b716-38c1-abef-dbb1a0f7e4e6",
                                "text": "Een halfuur later had iedereen zich in de voorkamer verzameld."
                            },
                            {
                                "example_id": "2307653f-a580-463c-9148-3c2dee956441",
                                "sense_id": "38a56ee5-b716-38c1-abef-dbb1a0f7e4e6",
                                "text": "In de voorkamer stond een antiekrode leren chesterfieldfauteuil zij aan zij met een Louis xv -zetel die was voorzien van een oudroze fluwelen bekleding met een rozenmotief, en een voetbankje in ongeveer dezelfde kleur naast een prachtige achttiende-eeuwse salontafel met elegant houtsnijwerk."
                            }
                        ]
                    }
