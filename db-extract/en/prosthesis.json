                    {
                        "translation_id": "62a2103d-3185-4ce5-a47f-d06fddfd7d3a",
                        "source_entry_id": "8ff3cc0f-fb6d-3dbf-9d07-813e4c1c1225",
                        "source_sense_description": "artificial replacement for a body part",
                        "target_lang_word": "prothèse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prothèse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "97994206-e6fe-34dd-abea-290b29d26459",
                                        "entry_id": "12a3c3b6-4f13-3ee0-af62-6ded925248dc",
                                        "glosses": [
                                            "Appareil servant à remplacer un organe ou un membre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8a6be13-da6f-4543-900c-b7a46d11280a",
                                                "sense_id": "97994206-e6fe-34dd-abea-290b29d26459",
                                                "text": "La notion de raideur sur prothèse du genou est relative. Un genou normal fléchit jusqu'à 150° mais la flexion d'un genou prothétique dépasse rarement 120°."
                                            },
                                            {
                                                "example_id": "dcf7b6a8-d70a-416a-a9ca-7244b928ae1a",
                                                "sense_id": "97994206-e6fe-34dd-abea-290b29d26459",
                                                "text": "La dentisterie restauratrice en rapport avec le parodonte comprend la prothèse fixée pour le traitement de l’édentement et la prothèse unitaire ou l’odontologie restauratrice, collée ou scellée."
                                            },
                                            {
                                                "example_id": "39338257-27f9-4436-9afb-5627a5c7a58d",
                                                "sense_id": "97994206-e6fe-34dd-abea-290b29d26459",
                                                "text": "Pieter Roelfsema estime avoir prouvé que, sur le principe, une prothèse était possible pour aider les 40 millions d'aveugles dans le monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b847a78-3759-347a-b28e-bbae9d749cc4",
                                        "entry_id": "12a3c3b6-4f13-3ee0-af62-6ded925248dc",
                                        "glosses": [
                                            "Ce que l'on ajoute au corps pour améliorer ses performances."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33ea4c53-b5d2-40e0-8ea9-361f3d329906",
                                                "sense_id": "2b847a78-3759-347a-b28e-bbae9d749cc4",
                                                "text": "Moyennant quelques prothèses visuelles et tactiles, nous pouvons voyager dans des mondes virtuels, y compris celui où nous jouissons à distance par « télédildonique » d'une Barbie blonde aussi vraie que nature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b41d27a-bc33-3290-a10e-81f3b82267eb",
                                        "entry_id": "12a3c3b6-4f13-3ee0-af62-6ded925248dc",
                                        "glosses": [
                                            "Fait d’ajouter un son au début d’un mot sans en changer le sens, pour des motifs articulatoires ou stylistiques."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b2e3625-41e2-4711-84c3-b28c9e5e5b95",
                        "source_entry_id": "8ff3cc0f-fb6d-3dbf-9d07-813e4c1c1225",
                        "source_sense_description": "artificial replacement for a body part",
                        "target_lang_word": "Prothese",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prothese",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4a804f8a-17ef-3a1b-b215-3bcffc81de5b",
                                        "entry_id": "c8bbb49b-1c3a-3696-968f-f175b5e42bfa",
                                        "glosses": [
                                            "künstlich hergestelltes Ersatzobjekt für fehlende Körperteile oder Organe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "613f4c6d-cc34-4124-bb21-7c062543a806",
                                                "sense_id": "4a804f8a-17ef-3a1b-b215-3bcffc81de5b",
                                                "text": "Moderne Prothesen werden im Sport teilweise als unerlaubte Hilfsmittel angesehen."
                                            },
                                            {
                                                "example_id": "7644216f-4885-459d-81a5-03d9a5ea2c19",
                                                "sense_id": "4a804f8a-17ef-3a1b-b215-3bcffc81de5b",
                                                "text": "„Er ließ sich auf der hölzernen Kopfstütze nieder und hielt sich mit seinen ledernen Prothesen den Kopf.“"
                                            },
                                            {
                                                "example_id": "ab990e8f-7e50-4540-a542-730cec8ff4c9",
                                                "sense_id": "4a804f8a-17ef-3a1b-b215-3bcffc81de5b",
                                                "text": "„Wir sehen die Geschichte deutlich, mit blutiger, gebrochener Nase und Prothesen anstelle intakter Körperteile.“"
                                            },
                                            {
                                                "example_id": "dbecaa34-46ae-42a5-ab99-b0dea40f9042",
                                                "sense_id": "4a804f8a-17ef-3a1b-b215-3bcffc81de5b",
                                                "text": "„Der geübte Deltaflieger verwächst funktionstechnisch und erlebnismäßg so eng mit seinem Fluggerät, dass ihm der angelegte Flügel zu einer Art neuem Körperteil wird, dessen er sich wie eines verlängerten Arms oder einer gut sitzenden Prothese bedient.“"
                                            },
                                            {
                                                "example_id": "d0514a3d-2599-4ec7-94c8-12c0e2cfd689",
                                                "sense_id": "4a804f8a-17ef-3a1b-b215-3bcffc81de5b",
                                                "text": "„Rechts hat er eine eiserne Prothese, links schon ein Gestell mit einem Schuh daran.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8148e8f3-6538-3554-a4f5-99c2ae78a351",
                                        "entry_id": "c8bbb49b-1c3a-3696-968f-f175b5e42bfa",
                                        "glosses": [
                                            "herausnehmbarer Zahnersatz"
                                        ],
                                        "tags": [
                                            "Zahnmedizin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4f8a000-9e59-4079-8e42-353e046011f6",
                                                "sense_id": "8148e8f3-6538-3554-a4f5-99c2ae78a351",
                                                "text": "„Doch sie hat auch Angst, sich die letzten Zähne ziehen und sich eine Prothese verschreiben zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2adbb91b-20de-3116-8a26-44a364ab4f8a",
                                        "entry_id": "c8bbb49b-1c3a-3696-968f-f175b5e42bfa",
                                        "glosses": [
                                            "Vorschaltung eines Lautes am Wortanfang, die etymologisch nicht korrekt ist"
                                        ],
                                        "tags": [
                                            "Sprachwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a14414e-4490-4138-bcb1-b5a77f1837af",
                                                "sense_id": "2adbb91b-20de-3116-8a26-44a364ab4f8a",
                                                "text": "Ein Beispiel für eine Prothese ist das Wort „Esprit“, das aus dem Französischen entlehnt wurde. Es geht zurück auf das lateinische „spiritus“ und erhielt im Französischen ein vorgeschaltetes prothetisches [e]."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
