        "nl-extract.jsonl": [
            {
                "entry_id": "fe290396-41f1-31f0-a27f-359de461b88b",
                "word": "compromitterend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c5f5d069-0bfa-31b0-9445-1ea599bd223c",
                        "entry_id": "fe290396-41f1-31f0-a27f-359de461b88b",
                        "glosses": [
                            "van iets of iemand dat het een reputatie vernietigd; verdacht makend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5259e57-b6e8-487b-8638-d17d59d306cd",
                                "sense_id": "c5f5d069-0bfa-31b0-9445-1ea599bd223c",
                                "text": "Het is niet erg dat je faalt. Zorg alleen dat niemand erachter komt. Schuif het een collega in de schoenen of vernietig al het bewijs dat je ermee bezig was. Investeer in een hackerscursus, zodat je alle sporen op het bedrijfssysteem kunt wissen. Ook handig als je compromitterende info over de ceo of cfo zoekt."
                            },
                            {
                                "example_id": "469a3907-c4bb-4210-83ab-a52496bb2231",
                                "sense_id": "c5f5d069-0bfa-31b0-9445-1ea599bd223c",
                                "text": "Op de compromitterende foto is te zien hoe een man zich 'verlekkert' aan haar portret."
                            },
                            {
                                "example_id": "c95bcb29-3afc-44b4-907b-78039f77121b",
                                "sense_id": "c5f5d069-0bfa-31b0-9445-1ea599bd223c",
                                "text": "Een aantal spelers van Arsenal wordt door hun werkgever op het matje geroepen, nadat er een compromitterende video van hen is opgedoken. Op de beelden is te zien hoe vedettes in een nachtclub lachgas lijken te inhaleren."
                            }
                        ]
                    }
