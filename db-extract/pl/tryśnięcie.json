                "translations": [
                    {
                        "translation_id": "4f2c3b0f-370a-494d-b7a7-7476a99022c0",
                        "source_entry_id": "45d84c80-8afc-3851-a18e-d46d52491919",
                        "source_sense_id": "307132ce-0b51-3997-b35d-1f0a1b5af492",
                        "target_lang_word": "gush",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gush",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81b21dd4-ee7b-3eed-bd9c-171d3a2f0127",
                                        "entry_id": "5223e350-e5a8-39ce-a3e7-5ebca35302d5",
                                        "glosses": [
                                            "A sudden rapid outflow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d91861d1-10dd-4528-8c5f-12747634a02a",
                                                "sense_id": "81b21dd4-ee7b-3eed-bd9c-171d3a2f0127",
                                                "text": "There was a cartoon woman in an apron on the front. She stood with one hand on her hip while she used the other hand to pour a gush of drain-cleaner into something that was either an industrial sink or Orson Welles's bidet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gush",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fcca5af3-5552-32be-9419-5e6915ab7311",
                                        "entry_id": "32fb9971-1df9-321c-ac02-d13c9ecc2419",
                                        "glosses": [
                                            "To flow forth suddenly, in great volume."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "129e6477-a8a8-4135-8f8c-272fc345f1c3",
                                                "sense_id": "fcca5af3-5552-32be-9419-5e6915ab7311",
                                                "text": "Water gushed out of the broken pipe."
                                            },
                                            {
                                                "example_id": "3a58d887-9e8a-4f7f-8e29-98c3e3d6fcfd",
                                                "sense_id": "fcca5af3-5552-32be-9419-5e6915ab7311",
                                                "text": "After he was stabbed, blood came gushing out his throat."
                                            },
                                            {
                                                "example_id": "0c48763c-dd20-4dfc-a403-5eb9a79f3091",
                                                "sense_id": "fcca5af3-5552-32be-9419-5e6915ab7311",
                                                "text": "All the complaints she'd bottled up came gushing out during their marriage counselling session."
                                            },
                                            {
                                                "example_id": "2499606c-e209-4643-a89a-ee1c06f21400",
                                                "sense_id": "fcca5af3-5552-32be-9419-5e6915ab7311",
                                                "text": "Large streames of bloud out of the truncked stocke / Forth gushed, like fresh water streame from riuen rocke."
                                            },
                                            {
                                                "example_id": "1376b0c6-f282-4780-b5ef-c10eae5f93c4",
                                                "sense_id": "fcca5af3-5552-32be-9419-5e6915ab7311",
                                                "text": "On life's long round by chance I found / A dell impearled with dew, / Where hyacinths, gushing from the ground, / Lent to the earth heaven's native hue / Of holy blue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "158ab334-82f3-3f87-ab3a-b1073464a988",
                                        "entry_id": "32fb9971-1df9-321c-ac02-d13c9ecc2419",
                                        "glosses": [
                                            "To send (something) flowing forth suddenly in great volume."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a1a481c-95a6-402a-9a26-3d4006d938fb",
                                                "sense_id": "158ab334-82f3-3f87-ab3a-b1073464a988",
                                                "text": "The other was no longer capable of controlling his anger; his parasite creature amplified his passion by ten; his jaws cracked open and his great mouth gushed blood from torn gums as teeth grew out of them like bone sickles."
                                            },
                                            {
                                                "example_id": "03b779e3-390d-4bf2-8093-7cd0be092b2d",
                                                "sense_id": "158ab334-82f3-3f87-ab3a-b1073464a988",
                                                "text": "A beautiful spring gushed water from the ground in this mountainous sector of Polk County, inspiring the name of the place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21e59b64-2d85-3f51-8ad0-a2cb712d396e",
                                        "entry_id": "32fb9971-1df9-321c-ac02-d13c9ecc2419",
                                        "glosses": [
                                            "To ejaculate during orgasm."
                                        ],
                                        "tags": [
                                            "especially",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46af0856-c9b0-4ddf-8ae7-c024eef5f837",
                                                "sense_id": "21e59b64-2d85-3f51-8ad0-a2cb712d396e",
                                                "text": "[…] she pulled off an amazing orgasm, one after another, she gushed with force, […]"
                                            },
                                            {
                                                "example_id": "f69d4356-0904-4edd-8f11-c3fdc108b653",
                                                "sense_id": "21e59b64-2d85-3f51-8ad0-a2cb712d396e",
                                                "text": "Somehow, this made his ejaculations all the more exciting, sending hot tingles streaking through her as he gushed."
                                            },
                                            {
                                                "example_id": "303e2a04-dcad-4e22-ba5d-a32ca3dc28e7",
                                                "sense_id": "21e59b64-2d85-3f51-8ad0-a2cb712d396e",
                                                "text": "Her orgasm exploded over her, making her writhe and cry out his name. She gushed over his hand, her cunt gripping and releasing his invading fingers."
                                            },
                                            {
                                                "example_id": "e247968f-1452-414b-8d0e-314070b666f3",
                                                "sense_id": "21e59b64-2d85-3f51-8ad0-a2cb712d396e",
                                                "text": "Odd. She'd never managed to do that to herself before—to climax so hard she gushed. Sometimes her sex partners didn't satisfy her as well as she could on her own, but her most intense orgasms had always been with others."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2005e60-c3cc-30cd-a431-14b42deb162c",
                                        "entry_id": "32fb9971-1df9-321c-ac02-d13c9ecc2419",
                                        "glosses": [
                                            "To make an excessive display of enthusiasm, praise, or sentiment."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f80a46d-eef3-4451-bc29-73e210776419",
                                                "sense_id": "a2005e60-c3cc-30cd-a431-14b42deb162c",
                                                "text": "The young mother was gushing over a baby."
                                            },
                                            {
                                                "example_id": "cbffb823-55c4-4d12-b3e6-0a4b77117454",
                                                "sense_id": "a2005e60-c3cc-30cd-a431-14b42deb162c",
                                                "text": "Miss Johnson gushed approval with her usual air of coquettish superiority."
                                            },
                                            {
                                                "example_id": "bd895317-76b9-4669-bf24-09ecb740a37f",
                                                "sense_id": "a2005e60-c3cc-30cd-a431-14b42deb162c",
                                                "text": "Randy Thornton, a producer with Walt Disney Records, put it this way: “Walt was not a man who gushed praise. His biggest words of approval were, 'That'll work.'"
                                            },
                                            {
                                                "example_id": "7a23d6df-af10-4dcb-86e4-a675e153617d",
                                                "sense_id": "a2005e60-c3cc-30cd-a431-14b42deb162c",
                                                "text": "Nellie routinely gushed praise to students for good performance whereas Frank was much more sparing in praising students."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfa5ebb5-bb5a-4565-ab74-d8e2dfa1b67a",
                        "source_entry_id": "45d84c80-8afc-3851-a18e-d46d52491919",
                        "source_sense_id": "307132ce-0b51-3997-b35d-1f0a1b5af492",
