                        "sense_id": "1e16fbaa-429c-33f0-ac53-caad76b76498",
                        "entry_id": "2d1e27c9-96d6-3e1e-9474-34b86ee2e2ba",
                        "glosses": [
                            "Verstopfung, Stauung der Ausscheidungen im Dickdarm mit erschwerter Stuhlentleerung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a5fc7e0-2ec1-42c6-8f86-41368c39c840",
                                "sense_id": "1e16fbaa-429c-33f0-ac53-caad76b76498",
                                "text": "„Eine oft lange Zeit nicht erkannte und folgenschwere Komplikation der chronischen Obstipation ist die Koprostase/der Kotstau („fecal impaction“), die durch eine weitgehende Verlegung der Darmpassage entsteht.“"
                            },
                            {
                                "example_id": "ef9ab15e-ca50-4b49-bdee-fc7dc9896c6f",
                                "sense_id": "1e16fbaa-429c-33f0-ac53-caad76b76498",
                                "text": "„Bei Koprostase versuchen die Tiere immer wieder vergeblich, Kot abzusetzen, indem sie sich hinsetzen und auf Kot drängen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
