                "senses": [
                    {
                        "sense_id": "1b5dd0ef-c13d-3210-bf59-df5322b422ac",
                        "entry_id": "d2f0ddcc-8294-3bca-b481-ca4613b5e7cb",
                        "glosses": [
                            "to practice agriculture or horticulture"
                        ],
                        "tags": [
                            "intransitive",
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "d0d41473-b9d1-4aef-96e3-eb823d873f02",
                                "sense_id": "1b5dd0ef-c13d-3210-bf59-df5322b422ac",
                                "text": "Dit is noodig, omdat men meestal op berghellingen tuint."
                            },
                            {
                                "example_id": "adf82657-50f3-4c73-bcfb-db0225397972",
                                "sense_id": "1b5dd0ef-c13d-3210-bf59-df5322b422ac",
                                "text": "2016, Carina van Leeuwen, nachtvlinder, A.W. Bruna Uitgevers.\n‘Is er iemand aangehouden?’ ‘Een oude tuinder. Hij wist niet wat er in zijn kas gebeurde en hij verhuurde een schuur die hij niet meer gebruikte. Naïef misschien, maar die ouwe was allang blij dat hij weer wat inkomen had. Hij tuint niet meer. Heet dat zo? Tuinen? Of telen?’ ‘Tuinen of telen, wat maakt het uit? Hij is er in elk geval in getuind.’",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            }
                        ]
                    }
