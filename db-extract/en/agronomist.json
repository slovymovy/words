                    {
                        "translation_id": "2f5609ef-b8d9-4c5f-a4e7-b2e2be99c3cd",
                        "source_entry_id": "a5dc0bfa-5119-390f-af49-d0e3e3ea7ad3",
                        "source_sense_id": "c9e97970-7ad8-3477-9c59-6d361bf4bed4",
                        "source_sense_description": "scientist specialized in agronomy",
                        "target_lang_word": "agronome",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agronome",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5124a71-5832-36d3-8f33-751dababd273",
                                        "entry_id": "97322a06-e430-33dc-936d-9d1646e7c206",
                                        "glosses": [
                                            "Scientifique formé aux sciences agricoles et agronomiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "739edc17-6d48-4bb6-a6ce-2e5d648a42a7",
                                                "sense_id": "d5124a71-5832-36d3-8f33-751dababd273",
                                                "text": "Il est, davantage qu'un agronome, un chimiste de l'alimentation."
                                            },
                                            {
                                                "example_id": "73127356-fd2c-419b-9ea2-b1e02fd88222",
                                                "sense_id": "d5124a71-5832-36d3-8f33-751dababd273",
                                                "text": "Je dois dire que ces balbutiements de terrain d’agronome en herbe m'ont permis de concrétiser le contenu de nos conversations sur l'agriculture et la position de l’agronome, sur la nécessité d'une démarche d'observation rigoureuse […]."
                                            },
                                            {
                                                "example_id": "e8af3a9d-e516-4b82-ade0-59f8c1ed2ed7",
                                                "sense_id": "d5124a71-5832-36d3-8f33-751dababd273",
                                                "text": "Le désaccord qui s'est manifesté entre les agriculteurs et les agronomes , quant aux résultats plus ou moins avantageux de l’écobuage sur les terres qu'on soumet à cette opération , provient uniquement de ce qu'on n'avait pas distingué les diverses natures des sols."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "994cae70-bf6d-440a-88b0-032611c44a22",
                        "source_entry_id": "a5dc0bfa-5119-390f-af49-d0e3e3ea7ad3",
                        "source_sense_id": "c9e97970-7ad8-3477-9c59-6d361bf4bed4",
                        "source_sense_description": "scientist specialized in agronomy",
                        "target_lang_word": "Agronom",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Agronom",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0a6bc23-4e98-318a-aa10-24e1b3e5934e",
                                        "entry_id": "a6c94ea7-0dd9-37a2-9392-3e9611269d72",
                                        "glosses": [
                                            "Wissenschaftler, der im Bereich des Ackerbaus/der Landwirtschaft forscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c14f8f85-5571-43f8-8759-e73f2dbfea3a",
                                                "sense_id": "c0a6bc23-4e98-318a-aa10-24e1b3e5934e",
                                                "text": "„Unser großer Agronom ist höchst unzufrieden mit den Herbergen, in denen er abstieg, sowie mit der Kleidung und dem Benehmen der Bediensteten, die ihm Essen brachten, das er angewidert beschreibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1b0933d-0385-4c20-8e9b-2233d7a78497",
                        "source_entry_id": "a5dc0bfa-5119-390f-af49-d0e3e3ea7ad3",
                        "source_sense_id": "c9e97970-7ad8-3477-9c59-6d361bf4bed4",
                        "source_sense_description": "scientist specialized in agronomy",
                        "target_lang_word": "Agronomin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Agronomin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87af132b-00ad-3541-81ab-681a51be5221",
                                        "entry_id": "aea07cca-917d-38d3-9c68-8bb2465edf6d",
                                        "glosses": [
                                            "Wissenschaftlerin, die im Bereich des Ackerbaus/der Landwirtschaft forscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05debc66-84aa-461d-a6dc-9cc5b34a853d",
                                                "sense_id": "87af132b-00ad-3541-81ab-681a51be5221",
                                                "text": "„Das junge Mädchen ist eine Armenierin, Absolventin der Timirjasew-Akademie in Moskau, hier als Agronomin tätig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5271edaa-a312-4b27-bacf-b782a23a50bf",
                        "source_entry_id": "a5dc0bfa-5119-390f-af49-d0e3e3ea7ad3",
                        "source_sense_id": "c9e97970-7ad8-3477-9c59-6d361bf4bed4",
                        "source_sense_description": "scientist specialized in agronomy",
                        "target_lang_word": "Agraringenieur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Agraringenieur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "923043b0-1f93-32f6-a67a-983e59c53885",
                                        "entry_id": "8c564bed-32b8-3126-b026-940006f3a675",
                                        "glosses": [
                                            "ausgebildeter Ingenieur, der sich auf die Landwirtschaft spezialisiert hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b168498-dcdf-432b-89ca-5642f747f08d",
                                                "sense_id": "923043b0-1f93-32f6-a67a-983e59c53885",
                                                "text": "„Sie hat akzeptiert, dass sie niemals ein vergleichbares Einkommen wie ein angestellter Agraringenieur erwirtschaften kann – trotz der Subventionen aus Brüssel.“"
                                            },
                                            {
                                                "example_id": "18ac8250-e4f7-41a1-9527-c46d5e4e801c",
                                                "sense_id": "923043b0-1f93-32f6-a67a-983e59c53885",
                                                "text": "„Murad wollte Fußballer oder Agraringenieur werden.“"
                                            },
                                            {
                                                "example_id": "f0043899-9b87-4a44-98c6-70599fa39638",
                                                "sense_id": "923043b0-1f93-32f6-a67a-983e59c53885",
                                                "text": "„Ihre Mutter, Hausfrau, war fast fünfundvierzig und ihr Vater, Agraringenieur, noch zehn Jahre älter.“"
                                            },
                                            {
                                                "example_id": "ebc4eb1b-62eb-4468-a81e-77d3c6722a01",
                                                "sense_id": "923043b0-1f93-32f6-a67a-983e59c53885",
                                                "text": "„Entdeckt wurde der Ringelmann-Effekt vom französischen Agraringenieur Maximilian Ringelmann im Jahr 1882.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
