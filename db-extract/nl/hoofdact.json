                            {
                                "example_id": "1efdec97-d97d-40c5-89d9-4b5a165f56d1",
                                "sense_id": "b006d4a1-a6f9-316c-bdda-b9698f883364",
                                "text": "De Nederlandse mezzosopraan Christianne Stotijn (34) verzorgt dit jaar de hoofdact. Ze wordt ondersteund door de Duitse pianist Joseph Breinl en het Calefax Rietkwintet. Ook haar broer, contrabassist Rick Stotijn, begeleidt haar speciaal voor deze gelegenheid bij een aantal liederen. Christianne Stotijn staat bekend als een van de belangrijkste mezzosopranen ter wereld en treedt op in de belangrijkste concertzalen en operahuizen."
                            },
                            {
                                "example_id": "3f55f288-6241-4374-a8b1-638a1d5cc9b1",
                                "sense_id": "b006d4a1-a6f9-316c-bdda-b9698f883364",
                                "text": "De groep trad gisteravond als hoofdact op tijdens het FortaRock Festival in het Goffertpark in Nijmegen. Tijdens het festival werd Jansen door Stichting Buma verrast met de prijs."
                            }
                        ]
