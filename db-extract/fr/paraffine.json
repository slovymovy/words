                    }
                ],
                "senses": [
                    {
                        "sense_id": "81c5455a-2358-3543-b123-7757fc49c992",
                        "entry_id": "5c10db31-4ffd-31b0-bfbe-261fd8dd635c",
                        "glosses": [
                            "Fluide plus ou moins épais ou masse solide, blanche, constitué d'un mélange d'hydrocarbures en C₂₀ et plus, plus ou moins ramifiés, pouvant servir à la fabrication des bougies et aussi à divers usages industriels dont la lubrification. On l'extrait par solvatation des goudrons résiduels de raffinage du pétrole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93ea9592-bfbe-4a5d-ac56-1d2b29435be2",
                                "sense_id": "81c5455a-2358-3543-b123-7757fc49c992",
                                "text": "Huile de paraffine, huile tirée de cette substance et raffinée, qui a des propriétés laxatives. Elle sert aussi à lubrifier les rouages de certaines machines délicates, telles que les machines à coudre."
                            },
                            {
                                "example_id": "425640c5-9d51-44df-9aee-17b3a1042eb0",
                                "sense_id": "81c5455a-2358-3543-b123-7757fc49c992",
                                "text": "On couvrait les bocaux avec de la paraffine dont on faisait fondre des pains entiers. […] Plus tard, avec l'abondance de bocaux à couvercles vendues en supermarché, on n'aurait plus besoin de paraffine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc4ad6f9-e836-4dc6-b0b3-9493a5a97dda",
                        "source_entry_id": "5c10db31-4ffd-31b0-bfbe-261fd8dd635c",
                        "source_sense_id": "81c5455a-2358-3543-b123-7757fc49c992",
                        "target_lang_word": "Paraffin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paraffin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8230f674-06a8-3fad-99bf-5eb5554bf946",
                                        "entry_id": "021e9a65-c76e-34c8-9679-1bbf256c7a21",
                                        "glosses": [
                                            "wachsähnlicher, brennbarer Stoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7235f53d-5771-4525-9ec8-3446def3d4f7",
                                                "sense_id": "8230f674-06a8-3fad-99bf-5eb5554bf946",
                                                "text": "„Als sie merkte, daß Gustav sie anstarrte, erklärte sie ihm sanft, als spreche sie zu einem Kind, sie wäre nicht sicher gewesen, ob die Tonbänder brennbar seien, und habe sie deshalb mit Paraffin tränken müssen.“"
                                            },
                                            {
                                                "example_id": "bedca871-c7ed-42e1-805c-43e141aff1b3",
                                                "sense_id": "8230f674-06a8-3fad-99bf-5eb5554bf946",
                                                "text": "„Der Geist - oder was immer im Dunkeln umhergeschwebt war - hatte seine Hände in Paraffin getaucht und einen Abdruck hinterlassen.“"
                                            },
                                            {
                                                "example_id": "eacd8c82-a719-4bf8-aa37-cf082e2bd8da",
                                                "sense_id": "8230f674-06a8-3fad-99bf-5eb5554bf946",
                                                "text": "„Darauf kam es zu riesigen Warteschlangen an den Tankstellen, und selbst das Paraffin, das die Armen zum Kochen verwendeten, wurde knapp und teuer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
