                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5fae79c-898b-468c-a174-2cbebfdfbe1b",
                                                "sense_id": "77fd216c-0795-3cf4-8fd4-e7a3a5a8dcc8",
                                                "text": "D’argent à Saint Mayeul sous l’apparence d’un moine de carnation, habillé de sable, nimbé d’or, la main senestre sur son cœur, la dextre tenant une crosse du même, qui est de Cipières → voir illustration « saint habillé »"
                                            }
                                        ]
                                    }
                                ]
                            },
