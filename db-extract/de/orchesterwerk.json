                        "glosses": [
                            "ein langes Musikstück, welches von einem Orchester gespielt wird"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "746fb619-57af-4e15-9a38-629f11ac6fff",
                                "sense_id": "634c6618-7e90-3ac5-8c6c-657e43c47aeb",
                                "text": "Die Schauspielmusik zu Goethes Trauerspiel Egmont ist ein Orchesterwerk von Ludwig van Beethoven, dessen erster Teil, die Ouvertüre, besonders bekannt wurde."
                            },
                            {
                                "example_id": "d2db5996-e65f-46cd-ab5b-30ce1904fd47",
                                "sense_id": "634c6618-7e90-3ac5-8c6c-657e43c47aeb",
                                "text": "Auf dem Label erschienen bislang Schallplatten von Frank Zappa, vom London Symphony Orchestra und vom Ensemble Modern mit Orchesterwerken Zappas sowie zwei Alben von Zappa-Sohn Dweezil."
                            }
                        ],
