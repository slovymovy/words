                "translations": [
                    {
                        "translation_id": "67c53e30-e1c7-4abb-97f9-0b21069fc3fb",
                        "source_entry_id": "06beb04a-8e33-325e-ba90-fd042c86c1bd",
                        "source_sense_id": "51b8fbd4-9a7d-3078-9abe-6ce2469c83fa",
