                                    {
                                        "sense_id": "e81d4966-c35e-3499-9871-2ce6b75a8d08",
                                        "entry_id": "97c216d7-e013-30d8-b1c6-2c704c3664f7",
                                        "glosses": [
                                            "alles zusammen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6492c9e9-266a-42a2-a116-7d19f7715af4",
                                                "sense_id": "e81d4966-c35e-3499-9871-2ce6b75a8d08",
                                                "text": "Ich habe für die Arbeit pauschal 1000 Euro bezahlt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "93d55ab2-e58b-387d-9480-0dcff6036f02",
                                        "entry_id": "97c216d7-e013-30d8-b1c6-2c704c3664f7",
                                        "glosses": [
                                            "insgesamt, undifferenziert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d65f512-671b-4967-b826-23e5dfb08aa3",
                                                "sense_id": "93d55ab2-e58b-387d-9480-0dcff6036f02",
                                                "text": "Hier wird der ganze Berufsstand pauschal als Steuerhinterzieher diffamiert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32e77065-574b-4e0e-8744-a7f699c4c1de",
                        "source_entry_id": "5ea493ab-2dec-3996-a89f-80cb8e25815f",
                        "target_lang_word": "entièrement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entièrement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "55cc6ee9-8d6d-3dd9-9a71-0fde6f50ed1b",
                                        "entry_id": "5a3130ae-6d50-31e5-b55e-f78d0f206a85",
                                        "glosses": [
                                            "D'une manière entière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89cdad7d-6d07-41cd-b935-ddb760382400",
                                                "sense_id": "55cc6ee9-8d6d-3dd9-9a71-0fde6f50ed1b",
                                                "text": "En quittant Virginy, on traverse la Tourbe, on passe à Massiges où se trouve une église du XVᵉ siècle, mais entièrement dépourvue d'intérêt, et, en suivant une jolie vallée, on arrive à Minaucourt, […]."
                                            },
                                            {
                                                "example_id": "179a55fb-358c-455b-a70a-fd22414f28c3",
                                                "sense_id": "55cc6ee9-8d6d-3dd9-9a71-0fde6f50ed1b",
                                                "text": "Les pailles, dont les couches épaisses recouvraient entièrement le sol de la cour, se doraient peu à peu d'un jaune pâle sous la lueur grandissante du crépuscule."
                                            },
                                            {
                                                "example_id": "7e266b20-b2c5-472b-8f0c-31db72f8c243",
                                                "sense_id": "55cc6ee9-8d6d-3dd9-9a71-0fde6f50ed1b",
                                                "text": "Le sanctuaire, dont les piliers sont décorés des statues des Apôtres, était entièrement peint."
                                            },
                                            {
                                                "example_id": "3a591fb9-d5ee-4990-8e24-98e9a2738385",
                                                "sense_id": "55cc6ee9-8d6d-3dd9-9a71-0fde6f50ed1b",
                                                "text": "Le soin qu’elle devait avoir de son honneur cède entièrement au souvenir qu’elle a de son amour."
                                            },
                                            {
                                                "example_id": "8ec14faf-15f5-40d8-b3cb-efc474c5b68c",
                                                "sense_id": "55cc6ee9-8d6d-3dd9-9a71-0fde6f50ed1b",
                                                "text": "Le sol schisteux et argileux de la partie septentrionale des Ardennes au-delà de Charleville est entièrement privé de calcaire, […]."
                                            },
                                            {
                                                "example_id": "71ccb920-dc53-4888-810f-b8b02bec2995",
                                                "sense_id": "55cc6ee9-8d6d-3dd9-9a71-0fde6f50ed1b",
                                                "text": "Depuis sa conquête par César et jusqu'à la fin du Ve siècle, la Gaule n'a été qu'une terre romaine, entièrement latinisée et son histoire se confond avec celle de Rome."
                                            },
                                            {
                                                "example_id": "de142362-6e85-4289-a1f0-606f89bdbc87",
                                                "sense_id": "55cc6ee9-8d6d-3dd9-9a71-0fde6f50ed1b",
                                                "text": "En outre, des bandes de mitrailleuses furent trouvées, entièrement ou partiellement garnies de balles explosibles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
