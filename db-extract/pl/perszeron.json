                ],
                "senses": [
                    {
                        "sense_id": "f9fe1a42-73cc-3ce3-96a5-1440398e2530",
                        "entry_id": "07c4024d-fde2-3e15-99cd-262305772a9b",
                        "glosses": [
                            "rodzaj konia pociągowego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fef54b6c-e715-41f2-b3bc-ca1d30337c15",
                                "sense_id": "f9fe1a42-73cc-3ce3-96a5-1440398e2530",
                                "text": "Stukot kopyt perszeronów na kocich łbach słychać było w nocnej ciszy na kilometr."
                            },
                            {
                                "example_id": "229894db-07b1-47a9-94ad-aa4d26cc97d0",
                                "sense_id": "f9fe1a42-73cc-3ce3-96a5-1440398e2530",
                                "text": "Do najczęstszych umaszczeń perszeronów zalicza się siwe, jabłkowite i kare."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc7328e3-c3d3-4c4a-943d-b28d25733cb0",
                        "source_entry_id": "07c4024d-fde2-3e15-99cd-262305772a9b",
                        "source_sense_id": "f9fe1a42-73cc-3ce3-96a5-1440398e2530",
                        "target_lang_word": "percheron",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "percheron",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "10cc6d74-e310-3856-a9ba-153be73e40fd",
                                        "entry_id": "8741b1ae-2b53-3904-9796-8bac9a924df1",
                                        "glosses": [
                                            "Race de cheval de trait, originaire du Perche."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cc73d16-857f-4f84-b298-9711ccb9f76d",
                                                "sense_id": "10cc6d74-e310-3856-a9ba-153be73e40fd",
                                                "text": "Nous terminons en disant que l’élevage à l’écurie est un puissant agent de modification : le cheval de pur sang anglais, le boulonnais et le percheron en sont des exemples frappants."
                                            },
                                            {
                                                "example_id": "965b485c-5c26-48c8-abbe-f8bfedd7ba6b",
                                                "sense_id": "10cc6d74-e310-3856-a9ba-153be73e40fd",
                                                "text": "À l’entrée du canal, on attela les deux forts percherons, nourris d’avoine."
                                            },
                                            {
                                                "example_id": "25d26248-a487-411a-9652-6644ab9563a1",
                                                "sense_id": "10cc6d74-e310-3856-a9ba-153be73e40fd",
                                                "text": "Les gros camions du chemin de fer de l’Ouest, tirés par des percherons satinés, ébranlaient le pavage."
                                            },
                                            {
                                                "example_id": "5013402b-4ecf-4423-b865-f1289102830f",
                                                "sense_id": "10cc6d74-e310-3856-a9ba-153be73e40fd",
                                                "text": "Bien sûr, la race du cheval importe au premier chef : un percheron n'est pas échangeable avec un cheval de sang."
                                            },
                                            {
                                                "example_id": "9d07eab3-87e1-412b-98de-0e28ab4ea890",
                                                "sense_id": "10cc6d74-e310-3856-a9ba-153be73e40fd",
                                                "text": "Il est gras comme un jambon et il a un derrière de percheron."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4bb013a-9ec6-3f54-bd53-47dd4a2378f8",
                                        "entry_id": "8741b1ae-2b53-3904-9796-8bac9a924df1",
                                        "glosses": [
                                            "Langue d’oïl parlée dans le Perche."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
