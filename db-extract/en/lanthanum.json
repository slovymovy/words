                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "003fd6b5-95c9-3d46-bfec-688843daf942",
                                        "entry_id": "106c91e7-7f23-3042-ad9f-df0bc1a29e00",
                                        "glosses": [
                                            "Élément chimique de numéro atomique 57 et de symbole La, terre rare prototype des lanthanides."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c1dda07-8515-427b-baf5-cbf217199aec",
                                                "sense_id": "003fd6b5-95c9-3d46-bfec-688843daf942",
                                                "text": "Lors de précédents travaux, Russell Hemley et ses collègues avaient étudié des composés de lanthane et d’hydrogène à 200 gigapascals et ont notamment formé du superhydrure de lanthane LaH₁₀."
                                            },
                                            {
                                                "example_id": "d79fed31-12c9-48d5-b503-1974d58e0121",
                                                "sense_id": "003fd6b5-95c9-3d46-bfec-688843daf942",
                                                "text": "Plus récemment, l’embargo chinois envers le Japon et, dans une moindre mesure, envers les États-Unis et l’Europe, conduisait à une flambée des prix des oxydes de cérium, de lanthane et de néodyme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48ecec75-5fca-3cf5-95be-4eb7805cdcd0",
                                        "entry_id": "106c91e7-7f23-3042-ad9f-df0bc1a29e00",
                                        "glosses": [
                                            "Métal pur de cet élément, de couleur gris-argent, malléable, ductile, très mou et qui s’oxyde à l’air et dans l’eau."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "423f983c-bb6f-48aa-90bc-0d72a4189227",
                                                "sense_id": "48ecec75-5fca-3cf5-95be-4eb7805cdcd0",
                                                "text": "Le lanthane est assez mou pour être coupé au couteau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86fef7ad-d5fa-42f2-a484-294e9b31accb",
                        "source_entry_id": "48773aac-9f24-330b-9045-20fffe73bff0",
