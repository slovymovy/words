                                "target_senses": [
                                    {
                                        "sense_id": "35e38c84-83cf-3e8a-8864-773c307ecb16",
                                        "entry_id": "f9471232-3589-3f5e-bdda-b7740e3e2b8b",
                                        "glosses": [
                                            "Of or pertaining to Shanghai."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb7da6f2-2b5d-318f-96fc-1e807091d0e4",
                                        "entry_id": "f9471232-3589-3f5e-bdda-b7740e3e2b8b",
                                        "glosses": [
                                            "Of or pertaining to Shanghai and the surrounding areas like the Lower Yangtze Delta region like parts of the provinces of Jiangsu, Zhejiang, and Anhui"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86c5fe23-061e-43b4-8413-1cc0b54d6b4c",
                                                "sense_id": "cb7da6f2-2b5d-318f-96fc-1e807091d0e4",
                                                "text": "The term “Shanghainese” refers to the residents of the city of Shanghai and its surrounding culture area in the People’s Republic of China (PRC) ... When asked to identify themselves, the residents of the city readily respond “Shanghaiese,” whose connotations today reflect an attitude of superiority, confidence, and high self-esteem."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Shanghainese",
                                "target_lang_code": "en",
                                "target_senses": [
