    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fb91ea8f-8491-3e5a-9ca9-49bc7eed5cb5",
                    "sense_definition": "To cause someone to feel fear or alarm.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden loud noise from the street was enough to <w>frighten</w> the small child.",
                            "target_lang_translations": {
                                "ru": "Внезапного громкого шума с улицы было достаточно, чтобы <w>напугать</w> маленького ребенка."
                            }
                        },
                        {
                            "text": "Don't <w>frighten</w> away the birds by making too much noise while we walk.",
                            "target_lang_translations": {
                                "ru": "Не <w>отпугивай</w> птиц, создавая слишком много шума во время нашей прогулки."
                            }
                        }
                    ],
                    "synonyms": [
                        "scare",
                        "alarm",
                        "terrify",
                        "frighten",
                        "spook"
                    ],
                    "antonyms": [
                        "calm",
                        "comfort",
                        "reassure",
                        "soothe"
                    ],
                    "common_phrases": [
                        "frighten away",
                        "frighten to death"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать у кого-либо чувство страха или тревоги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пугать",
                                "target_lang_sense_clarification": "вызывать испуг или тревогу"
                            },
                            {
                                "target_lang_word": "испугать",
                                "target_lang_sense_clarification": "вызвать внезапный испуг"
                            },
                            {
                                "target_lang_word": "напугать",
                                "target_lang_sense_clarification": "внушить страх"
                            },
                            {
                                "target_lang_word": "страшить",
                                "target_lang_sense_clarification": "беспокоить, вызывать опасения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e286bc39-4875-3132-9ce4-f6e9fd8e2543",
                    "sense_definition": "To become scared or alarmed.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wild animals often <w>frighten</w> easily when they hear humans approaching their habitat.",
                            "target_lang_translations": {
                                "ru": "Дикие животные часто легко <w>пугаются</w>, когда слышат, что люди приближаются к их среде обитания."
                            }
                        },
                        {
                            "text": "You must be very quiet because these fish <w>frighten</w> easily at the slightest movement.",
                            "target_lang_translations": {
                                "ru": "Нужно вести себя очень тихо, потому что эти рыбы легко <w>пугаются</w> при малейшем движении."
                            }
                        }
                    ],
                    "synonyms": [
                        "scare",
                        "spook"
                    ],
                    "common_phrases": [
                        "frighten easily"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться испуганным или встревоженным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пугаться",
                                "target_lang_sense_clarification": "испытывать испуг"
                            },
                            {
                                "target_lang_word": "испугаться",
                                "target_lang_sense_clarification": "внезапно почувствовать страх"
                            }
                        ]
                    }
                }
            ]
        }
