                "senses": [
                    {
                        "sense_id": "b0139842-4946-3e15-a147-ebec4ca8554a",
                        "entry_id": "d6392389-b777-3428-864b-7354a6855f46",
                        "glosses": [
                            "Donner un caractère rastafari à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ace8d05-bf9b-49c5-9395-ee1eacce9a9c",
                                "sense_id": "b0139842-4946-3e15-a147-ebec4ca8554a",
                                "text": "Il décide alors de « rastafariser » son nom de famille, Molia, en Molyah : on avait imposé à ses ancêtres de porter un nom qui ne leur convenait pas, il le porterait donc, mais à sa façon."
                            },
                            {
                                "example_id": "c0260fd7-330f-4bb9-83e5-a647f83516ee",
                                "sense_id": "b0139842-4946-3e15-a147-ebec4ca8554a",
                                "text": "Ce faisant, l'enseignement des Douze Tribus semble hésiter entre christianiser le courant rastafari et « rastafariser » le credo chrétien."
                            },
                            {
                                "example_id": "cc3e02ee-baf5-4086-a449-be29db3a5c40",
                                "sense_id": "b0139842-4946-3e15-a147-ebec4ca8554a",
                                "text": "Certes, ce Original Turtle Shell Band était sympathique, mais beaucoup crurent sans doute qu’ils tenaient là un exemple de la culture traditionnelle garifuna alors qu’ils en écoutaient une version moderne et \"rastafarisée\"."
                            }
                        ]
                    }
                ],
