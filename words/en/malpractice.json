                            },
                            {
                                "target_lang_word": "халатность",
                                "target_lang_sense_clarification": "небрежное отношение к лечению"
                            },
                            {
                                "target_lang_word": "ненадлежащее лечение",
                                "target_lang_sense_clarification": "оказание помощи низкого качества"
                            }
