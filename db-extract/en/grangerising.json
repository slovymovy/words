                "senses": [
                    {
                        "sense_id": "20d24f58-ccf9-33bc-a5a8-76ed4d45248a",
                        "entry_id": "9a01a576-0ca1-32a1-ba12-53ec2ca1d8d5",
                        "glosses": [
                            "Synonym of grangerisation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c81b902c-92ae-4cf0-9d28-918bcb4780fa",
                                "sense_id": "20d24f58-ccf9-33bc-a5a8-76ed4d45248a",
                                "text": "The practice of ‘grangerising,’ or stuffing out an author with prints and pages from other works, was even praised by Dibdin as ‘useful and entertaining,’ though in our own time it is rightly condemned as a malpractice."
                            },
                            {
                                "example_id": "038d5291-c0d8-4ba3-b033-de1e1e5550a8",
                                "sense_id": "20d24f58-ccf9-33bc-a5a8-76ed4d45248a",
                                "text": "As to the practice of inserting illustrations in books that are published without them, ‘Grangerising,’ as it is called, it is perhaps best left alone."
                            }
                        ]
                    }
                ],
