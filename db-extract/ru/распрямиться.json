                ],
                "senses": [
                    {
                        "sense_id": "40c74318-c212-3dad-bb48-a32c198a6e6f",
                        "entry_id": "b31c924d-929c-38c2-ba0b-b2421d72985e",
                        "glosses": [
                            "стать прямым, принять прямое положение; разогнуться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eda5d4ae-85d9-4565-9dea-47c0e2450880",
                                "sense_id": "40c74318-c212-3dad-bb48-a32c198a6e6f",
                                "text": "Сергей в ужасе отпрянул, вытянул шею, лихорадочно искал новое прибежище; увидел окоп и бежавшего к нему бойца. Пока соображал, ноги сами напружинились, потом распрямились в гигантском прыжке, понесли его за бойцом."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eec46175-3682-49ec-aa9a-3fa1dee4fdc7",
                        "source_entry_id": "b31c924d-929c-38c2-ba0b-b2421d72985e",
                        "source_sense_id": "40c74318-c212-3dad-bb48-a32c198a6e6f",
                        "target_lang_word": "straighten up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "straighten up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29529349-e85b-3ab7-ab36-1df974b64085",
                                        "entry_id": "7472e930-f14d-3095-9665-d18c67b8be91",
                                        "glosses": [
                                            "To become straight, or straighter."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01706a1c-80b7-4562-80e6-c5e1a2a6bf23",
                                                "sense_id": "29529349-e85b-3ab7-ab36-1df974b64085",
                                                "text": "2006, American Motoryclist - Jan 2006, Victory's Kingpin goes its own way\nbank the big cruiser into the first of a series of corners, make a few quick left, right, left transitions, then the road straightens up for a stretch..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "678505ef-5663-30a9-8002-6b8a773f7a39",
                                        "entry_id": "7472e930-f14d-3095-9665-d18c67b8be91",
                                        "glosses": [
                                            "To steer straight."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7714e718-3bb5-49db-be8f-ae1801d5c4f1",
                                                "sense_id": "678505ef-5663-30a9-8002-6b8a773f7a39",
                                                "text": "13 October 2010, Blackpool Gazette, 'Bad driving' led to biker death crash\nHe said \"As I came out of the bend I went to straighten up the car and it just seemed to be carrying on turning.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "319d39dd-1c4a-327d-a569-3b598c35d606",
                                        "entry_id": "7472e930-f14d-3095-9665-d18c67b8be91",
                                        "glosses": [
                                            "To sit up straight, to stop hunching."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "659b0877-8d09-46bc-a9eb-3b5a780e363f",
                                                "sense_id": "319d39dd-1c4a-327d-a569-3b598c35d606",
                                                "text": "Horse skin smells good. Lay your cheek against his neck and have a good cuddle. Now straighten up slowly again, and sit loosely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b91f439b-03e9-3718-81a7-b9a3b479393d",
                                        "entry_id": "7472e930-f14d-3095-9665-d18c67b8be91",
                                        "glosses": [
                                            "To deal with; to put in order."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "578608ef-02ee-4cae-a05e-a96db6cb94b2",
                                                "sense_id": "b91f439b-03e9-3718-81a7-b9a3b479393d",
                                                "text": "1994, Mccook Daily Gazette, Jul 12, 1994, Mail Delivery Trying To Get Up To Speed\nThe Postal Service sent a special task force to straighten up the city's problems with a back-to-basics approach"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c16e9e6-f040-38f1-b7d3-8263d7edb460",
                                        "entry_id": "7472e930-f14d-3095-9665-d18c67b8be91",
                                        "glosses": [
                                            "To tidy; to tidy up."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a44541f-9de3-4d09-94a7-fad06f0767ad",
                                                "sense_id": "8c16e9e6-f040-38f1-b7d3-8263d7edb460",
                                                "text": "The lockers were all standing wide open with equipment and uniforms scattered all over the room, he had left a note under the bottle telling me to straighten up the room, then straighten myself up before coming to work the next day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8851998c-34eb-344a-8b57-1166d95dfdb8",
                                        "entry_id": "7472e930-f14d-3095-9665-d18c67b8be91",
                                        "glosses": [
                                            "To clarify."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5d86b7a-bf4e-35cf-9146-24f57d1a0425",
                                        "entry_id": "7472e930-f14d-3095-9665-d18c67b8be91",
                                        "glosses": [
                                            "To start living a reformed life; to adopt a more honest and respectable course of behavior."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1db0f12e-39c4-4f7a-9958-c75832ce36db",
                        "source_entry_id": "b31c924d-929c-38c2-ba0b-b2421d72985e",
                        "source_sense_id": "40c74318-c212-3dad-bb48-a32c198a6e6f",
                        "target_lang_word": "unbend",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbend",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "670bad7b-563e-3971-8cfd-0491f1b9d105",
                                        "entry_id": "f4157460-3aad-369d-803a-53e8b2dc6e7f",
                                        "glosses": [
                                            "To remove a bend so as to make, or allow to become, straight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20bdf7fc-f507-4c8e-be24-e2a851ce4e39",
                                                "sense_id": "670bad7b-563e-3971-8cfd-0491f1b9d105",
                                                "text": "to unbend a bow"
                                            },
                                            {
                                                "example_id": "32e39915-a640-41eb-aee7-54ee560edac8",
                                                "sense_id": "670bad7b-563e-3971-8cfd-0491f1b9d105",
                                                "text": "He leant tensely against the corridor wall and frowned like a man trying to unbend a corkscrew by telekinesis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "056c72df-7833-3b58-92d9-8116689fb4fa",
                                        "entry_id": "f4157460-3aad-369d-803a-53e8b2dc6e7f",
                                        "glosses": [
                                            "To release (a load) from a strain or from exertion; to set at ease for a time; to relax."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36a6b305-d606-423e-b2fe-ce8532fa7e20",
                                                "sense_id": "056c72df-7833-3b58-92d9-8116689fb4fa",
                                                "text": "You do unbend your noble strength."
                                            },
                                            {
                                                "example_id": "7ac6c97a-f026-4080-89b6-a9bbc4dc2959",
                                                "sense_id": "056c72df-7833-3b58-92d9-8116689fb4fa",
                                                "text": "to unbend the mind from study or care"
                                            }
                                        ]
                                    },
                                    {
