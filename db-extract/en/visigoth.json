    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "afa34da4-9ccb-3c05-ae7b-a1500f768060",
                "word": "Visigoth",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4e237fec-418d-4f4d-9112-780966c3f80e",
                        "entry_id": "afa34da4-9ccb-3c05-ae7b-a1500f768060",
                        "tags": [
                            "plural"
                        ],
                        "form": "Visigoths"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bd6b5ce0-7730-3e33-a6e8-746cf7b1bda2",
                        "entry_id": "afa34da4-9ccb-3c05-ae7b-a1500f768060",
                        "glosses": [
                            "Any member of an ancient East Germanic tribe, one branch of the Goths (the Ostrogoths being the other), which participated in several wars with Rome and established a kingdom with Toulouse for its capital."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff3a2a75-b7c6-4190-88c0-d71b0d45963f",
                        "source_entry_id": "afa34da4-9ccb-3c05-ae7b-a1500f768060",
                        "source_sense_id": "bd6b5ce0-7730-3e33-a6e8-746cf7b1bda2",
                        "source_sense_description": "member of an East Germanic tribe",
                        "target_lang_word": "wisigoth",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wisigoth",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c7b14e44-6ffb-30ca-a55e-90726bd52369",
                                        "entry_id": "266204bf-0d9a-32f7-8c68-6e454682cfff",
                                        "glosses": [
                                            "Relatif aux Wisigoths."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbaa8dac-e904-4803-a2ae-72dff9974bd4",
                                                "sense_id": "c7b14e44-6ffb-30ca-a55e-90726bd52369",
                                                "text": "Pratiquant avec Rome une diplomatie guerrière tantôt prudente, tantôt téméraire, les souverains wisigoths en seront soit les alliés, soit les adversaires, selon leurs intérêts stratégiques et commerciaux."
                                            },
                                            {
                                                "example_id": "e3d369c6-c9b9-4f4e-ac87-7e3b3879abfd",
                                                "sense_id": "c7b14e44-6ffb-30ca-a55e-90726bd52369",
                                                "text": "Wulfila (ou Ulfila) naquit au IVe dans le royaume wisigoth, sur les rives de la mer Noire. Ses talents lui valurent d'être ambassadeur pour son peuple d'adoption auprès de l'empire romain d'Orient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb3a2330-8083-4324-b3f5-23bc97721884",
                        "source_entry_id": "afa34da4-9ccb-3c05-ae7b-a1500f768060",
                        "source_sense_id": "bd6b5ce0-7730-3e33-a6e8-746cf7b1bda2",
                        "source_sense_description": "member of an East Germanic tribe",
                        "target_lang_word": "Wisigoth",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wisigoth",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac819c23-6218-3c5a-99f5-e35cf803d026",
                                        "entry_id": "3d3b2705-ad2d-3509-ac9d-70df9cc6adfd",
                                        "glosses": [
                                            "Membre du peuple des Wisigoths."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad190f12-cf40-4dc4-b264-cd031fbf13aa",
                                                "sense_id": "ac819c23-6218-3c5a-99f5-e35cf803d026",
                                                "text": "Un lignage de morisques tolédans, si ancien, disait-on, que lorsque les Wisigoths débarquèrent dans la péninsule Ibérique, les Guevara les regardaient déjà comme des étrangers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5fad601-2c47-40a3-8317-36088adb22e3",
                        "source_entry_id": "afa34da4-9ccb-3c05-ae7b-a1500f768060",
                        "source_sense_id": "bd6b5ce0-7730-3e33-a6e8-746cf7b1bda2",
                        "source_sense_description": "member of an East Germanic tribe",
                        "target_lang_word": "Westgote",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Westgote",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95e6e9a6-f10f-3cbd-9707-018d2a633d41",
                                        "entry_id": "60023328-955a-3fdd-ba25-908cce01b6a4",
                                        "glosses": [
                                            "Angehöriger des antiken, gleichnamigen Volkes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20f4d0a1-2b08-45a5-9396-a1037a90851e",
                                                "sense_id": "95e6e9a6-f10f-3cbd-9707-018d2a633d41",
                                                "text": "„Hispanien und Gallien befanden sich in den Händen der Sueben, Westgoten und Franken; Nordafrika war an die Vandalen verloren gegangen.“"
                                            },
                                            {
                                                "example_id": "936d5088-2d01-4c1b-acbe-b1e39fddbcf0",
                                                "sense_id": "95e6e9a6-f10f-3cbd-9707-018d2a633d41",
                                                "text": "„Nur noch selten erinnerten sich diese gesitteten Westgoten an die gar nicht so feinen Anfänge.“"
                                            },
                                            {
                                                "example_id": "8a1d7de4-ae2f-49e0-bd26-b864a2ca4be8",
                                                "sense_id": "95e6e9a6-f10f-3cbd-9707-018d2a633d41",
                                                "text": "„Die Westgoten, gegen die wir kämpften, um Spanien zu erobern, waren niemals in die Alpujarras eingedrungen.“"
                                            },
                                            {
                                                "example_id": "af417712-7c6b-4b21-beb2-769d0b24c6a0",
                                                "sense_id": "95e6e9a6-f10f-3cbd-9707-018d2a633d41",
                                                "text": "„Der Angelsachse begnügte sich mit sprachlichen Korrekturen am Text der Vulgata, während der Westgote tiefer in die textliche Gestaltung eingriff.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
