                "senses": [
                    {
                        "sense_id": "dd30b05c-f0bd-3b32-9dd4-366b2292a8eb",
                        "entry_id": "de3685c0-a826-3e09-8b5a-9c5b741e9873",
                        "glosses": [
                            "Resembling a corpse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0ca455a-9c23-4dc8-acbd-51b96db19858",
                                "sense_id": "dd30b05c-f0bd-3b32-9dd4-366b2292a8eb",
                                "text": "Upon the ground before the daïs were stretched scores of the corpselike forms of the spectators, till at last the long lines of them were lost in the gloomy background."
                            },
                            {
                                "example_id": "5dfa69f6-e57b-4b69-ac53-2fbb30861d73",
                                "sense_id": "dd30b05c-f0bd-3b32-9dd4-366b2292a8eb",
                                "text": "With Akeley’s permission I lighted a small oil lamp, turned it low, and set it on a distant bookcase beside the ghostly bust of Milton; but afterward I was sorry I had done so, for it made my host’s strained, immobile face and listless hands look damnably abnormal and corpselike."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e37ca4ea-b406-4ff8-8559-a2b9beda2edc",
                        "source_entry_id": "de3685c0-a826-3e09-8b5a-9c5b741e9873",
                        "source_sense_id": "dd30b05c-f0bd-3b32-9dd4-366b2292a8eb",
                        "source_sense_description": "resembling a corpse",
                        "target_lang_word": "cadavéreux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cadavéreux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e083f7d-07b3-31d9-b12f-a0d3f3a20ce8",
                                        "entry_id": "0c0cb13e-9673-31b8-a963-54d342f82705",
                                        "glosses": [
                                            "Qui tient du cadavre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b4807ea-1f59-40f6-809c-19f2f9fada61",
                                                "sense_id": "9e083f7d-07b3-31d9-b12f-a0d3f3a20ce8",
                                                "text": "— Je le crois bien, pensa encore le fils en s’agenouillant au chevet du lit et en baisant une des mains cadavéreuses de Bartholoméo."
                                            },
                                            {
                                                "example_id": "eb0296c0-6922-4d1c-b18f-7b84048df71c",
                                                "sense_id": "9e083f7d-07b3-31d9-b12f-a0d3f3a20ce8",
                                                "text": "J’y dépeignais les sensations d’un homme conservant sous terre toutes les passions qu’il avait eues dessus, et j’intitulai cette rêverie cadavéreuse : La vie dans la mort."
                                            },
                                            {
                                                "example_id": "3796f734-1ff7-456d-b70b-e436fab09f42",
                                                "sense_id": "9e083f7d-07b3-31d9-b12f-a0d3f3a20ce8",
                                                "text": "Je ne me souviens pas d’avoir aperçu par la pensée, soit dans les charniers de la Bible, soit dans les scènes les plus fantastiques de notre littérature cadavéreuse, un spectacle aussi épouvantablement majestueux."
                                            },
                                            {
                                                "example_id": "a3289ee1-a3da-4abc-87c8-39adaddd218b",
                                                "sense_id": "9e083f7d-07b3-31d9-b12f-a0d3f3a20ce8",
                                                "text": "Aucun rendez-vous ne s’était passé d’une manière plus décente, ni plus chaste, ni plus froide peut-être, dans un lieu plus horrible par les détails, devant une plus hideuse divinité ; car cette mère était restée dans l’imagination d’Henri comme quelque chose d’infernal, d’accroupi, de cadavéreux, de vicieux, de sauvagement féroce, que la fantaisie des peintres et des poètes n’avait pas encore deviné."
                                            },
                                            {
                                                "example_id": "3fff3692-434e-4263-9ee0-d2a8b2293fa9",
                                                "sense_id": "9e083f7d-07b3-31d9-b12f-a0d3f3a20ce8",
                                                "text": "L’expression de désespoir qui se peint sur toutes ces physionomies cadavéreuses, dans ces orbites sans yeux, qui voient que leur labeur a été inutile, est vraiment tragique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
