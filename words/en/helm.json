{
    "word_family": [
        "helmsman",
        "helmswoman",
        "helmsperson",
        "helmet",
        "helmed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eb24134f-f2d6-3679-a36b-aa74df44583c",
                    "sense_definition": "A position of control or leadership.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "leadership",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the CEO resigned, the young director was suddenly at the <w>helm</w> of the international corporation.",
                            "target_lang_translations": {
                                "ru": "После отставки генерального директора молодой директор внезапно оказался у <w>руля</w> международной корпорации.",
                                "zh": "首席执行官辞职后，这位年轻的董事突然开始<w>掌舵</w>这家跨国公司。"
                            }
                        },
                        {
                            "text": "With a new captain at the <w>helm</w>, the team finally started winning their matches.",
                            "target_lang_translations": {
                                "ru": "С новым капитаном во <w>главе</w> команда наконец начала выигрывать матчи.",
                                "zh": "随着新队长的<w>领导</w>，球队终于开始赢得比赛了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "at the helm",
                        "take the helm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Позиция контроля, руководства или власти над организацией или группой.",
                        "zh": "指代控制、领导或权力的地位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "руль",
                                "target_lang_sense_clarification": "в переносном смысле: управление"
                            },
                            {
                                "target_lang_word": "глава",
                                "target_lang_sense_clarification": "руководящая роль"
                            },
                            {
                                "target_lang_word": "кормило",
                                "target_lang_sense_clarification": "высокий стиль: власть, правление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "掌舵",
                                "target_lang_sense_clarification": "比喻处于领导地位"
                            },
                            {
                                "target_lang_word": "领导",
                                "target_lang_sense_clarification": "担任负责人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d45b399c-f562-3c4f-ad06-2b2183d895ea",
                    "sense_definition": "The wheel or tiller used to steer a ship or boat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "maritime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailor stood firmly at the <w>helm</w> as the ship navigated through the narrow channel.",
                            "target_lang_translations": {
                                "ru": "Моряк твердо стоял у <w>штурвала</w>, пока корабль шел через узкий канал.",
                                "zh": "当船只穿过狭窄的航道时，水手稳稳地站在<w>舵</w>前。"
                            }
                        },
                        {
                            "text": "He had to steady the <w>helm</w> to keep the vessel from drifting off course during the storm.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось выровнять <w>руль</w>, чтобы судно не сбилось с курса во время шторма.",
                                "zh": "在暴风雨中，他必须稳住<w>舵轮</w>，以防船只偏离航向。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "steady the helm",
                        "leave the helm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Колесо (штурвал) или рукоятка (румпель), используемые для управления судном.",
                        "zh": "用于操纵船只方向的轮盘或舵柄。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штурвал",
                                "target_lang_sense_clarification": "колесо управления"
                            },
                            {
                                "target_lang_word": "руль",
                                "target_lang_sense_clarification": "общее название устройства управления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "舵",
                                "target_lang_sense_clarification": "控制方向的装置"
                            },
                            {
                                "target_lang_word": "舵轮",
                                "target_lang_sense_clarification": "船只的操纵轮"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "997f36c4-0da0-3833-854b-f6b064a4a30d",
                    "sense_definition": "A <w>helmet</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "armor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight adjusted his heavy iron <w>helm</w> before charging into the tournament.",
                            "target_lang_translations": {
                                "ru": "Рыцарь поправил свой тяжелый железный <w>шлем</w> перед тем, как броситься в бой на турнире.",
                                "zh": "骑士在冲入赛场前调整了他沉重的铁<w>头盔</w>。"
                            }
                        },
                        {
                            "text": "A plumed <w>helm</w> was found among the ancient artifacts in the castle ruins.",
                            "target_lang_translations": {
                                "ru": "<w>Шлем</w> с плюмажем был найден среди древних артефактов в руинах замка.",
                                "zh": "在城堡废墟的古代文物中发现了一顶带羽饰的<w>头盔</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "helmet"
                    ],
                    "common_phrases": [
                        "plumed helm",
                        "great helm"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "often used in historical or fantasy contexts"
                        },
                        {
                            "trait_type": "form",
                            "comment": "shortened form of helmet"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шлем, защитный головной убор (обычно в историческом или фэнтезийном контексте).",
                        "zh": "头盔，一种防护性头饰（多用于历史或奇幻语境）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шлем",
                                "target_lang_sense_clarification": "защитный головной убор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "头盔",
                                "target_lang_sense_clarification": "防护头饰"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be4a3253-4b8e-34e9-960b-2f1abec3058b",
                    "sense_definition": "The person in charge of steering a vessel; a <w>helmsman</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "maritime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain called for a new <w>helm</w> to take over the night shift.",
                            "target_lang_translations": {
                                "ru": "Капитан вызвал нового <w>рулевого</w>, чтобы тот принял ночную смену.",
                                "zh": "船长叫了一名新的<w>舵手</w>来接替夜班。"
                            }
                        },
                        {
                            "text": "As the <w>helm</w> of the ship, she was responsible for every turn they made.",
                            "target_lang_translations": {
                                "ru": "Как <w>рулевой</w> корабля, она отвечала за каждый сделанный ими поворот.",
                                "zh": "作为船上的<w>舵手</w>，她对船只的每一次转向负责。"
                            }
                        }
                    ],
                    "synonyms": [
                        "helmsperson"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, отвечающий за управление судном; рулевой.",
                        "zh": "负责操纵船只的人；舵手。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рулевой",
                                "target_lang_sense_clarification": "человек за штурвалом"
                            },
                            {
                                "target_lang_word": "кормчий",
                                "target_lang_sense_clarification": "устаревшее или поэтическое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "舵手",
                                "target_lang_sense_clarification": "负责掌舵的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e762d6c-3d2f-3c14-852e-75686d1f4907",
                    "sense_definition": "Stalks of corn or straw, especially when used for thatching roofs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmers gathered the <w>helm</w> into neat bundles to prepare for the winter repairs.",
                            "target_lang_translations": {
                                "ru": "Фермеры собрали <w>солому</w> в аккуратные связки, готовясь к зимнему ремонту.",
                                "zh": "农民们将<w>茅草</w>捆成整齐的束，为冬季修缮做准备。"
                            }
                        },
                        {
                            "text": "They used high-quality <w>helm</w> to ensure the cottage roof remained waterproof.",
                            "target_lang_translations": {
                                "ru": "Они использовали высококачественную <w>солому</w>, чтобы крыша коттеджа оставалась водонепроницаемой.",
                                "zh": "他们使用了高质量的<w>茅草</w>，以确保小屋的屋顶保持防水。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thatch",
                        "yelm"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional agricultural term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стебли кукурузы или соломы, используемые для покрытия крыш.",
                        "zh": "用于覆盖屋顶的秸秆或茅草。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "солома",
                                "target_lang_sense_clarification": "для кровельных работ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "茅草",
                                "target_lang_sense_clarification": "用于屋顶覆盖物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eee94158-ee27-327a-8956-9d7277059a36",
                    "sense_definition": "To direct, lead, or manage a project, organization, or production.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "leadership",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The famous director will <w>helm</w> the new superhero movie scheduled for release next year.",
                            "target_lang_translations": {
                                "ru": "Знаменитый режиссер <w>возглавит</w> работу над новым фильмом о супергероях, выход которого запланирован на следующий год.",
                                "zh": "这位著名导演将<w>执掌</w>明年上映的新超级英雄电影。"
                            }
                        },
                        {
                            "text": "She was chosen to <w>helm</w> the project because of her extensive experience in marketing.",
                            "target_lang_translations": {
                                "ru": "Ее выбрали <w>руководить</w> проектом благодаря ее обширному опыту в маркетинге.",
                                "zh": "她因在市场营销方面拥有丰富的经验而被选中<w>领导</w>该项目。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "helm the project",
                        "helm the production"
                    ],
                    "target_lang_definitions": {
                        "ru": "Направлять, возглавлять или управлять проектом, организацией или производством.",
                        "zh": "指导、领导或管理项目、组织或生产。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возглавлять",
                                "target_lang_sense_clarification": "быть во главе"
                            },
                            {
                                "target_lang_word": "руководить",
                                "target_lang_sense_clarification": "управлять процессом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "执掌",
                                "target_lang_sense_clarification": "负责管理"
                            },
                            {
                                "target_lang_word": "领导",
                                "target_lang_sense_clarification": "担任领导职务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "130a3c48-b780-3f23-b594-fbbb5adafb92",
                    "sense_definition": "To steer or be in charge of the steering apparatus of a vessel.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "maritime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It takes a lot of skill to <w>helm</w> a large ship through such a narrow harbor.",
                            "target_lang_translations": {
                                "ru": "Требуется большое мастерство, чтобы <w>провести</w> большой корабль через такую узкую гавань.",
                                "zh": "需要高超的技巧才能<w>驾驶</w>一艘大船穿过如此狭窄的港口。"
                            }
                        },
                        {
                            "text": "He spent the entire afternoon <w>helming</w> the boat across the calm lake.",
                            "target_lang_translations": {
                                "ru": "Он провел весь день, <w>управляя</w> лодкой на спокойном озере.",
                                "zh": "他整个下午都在平静的湖面上<w>掌舵</w>小船。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "helm the boat",
                        "helm the ship"
                    ],
                    "target_lang_definitions": {
                        "ru": "Управлять или стоять за штурвалом судна.",
                        "zh": "操纵或负责船只的转向装置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "управлять",
                                "target_lang_sense_clarification": "вести судно"
                            },
                            {
                                "target_lang_word": "стоять за штурвалом",
                                "target_lang_sense_clarification": "быть рулевым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "掌舵",
                                "target_lang_sense_clarification": "操作舵轮"
                            },
                            {
                                "target_lang_word": "驾驶",
                                "target_lang_sense_clarification": "操纵船只"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0ece873-2c75-32b9-99b9-fbcc8e131c58",
                    "sense_definition": "To cover or provide someone with a helmet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "armor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The squire helped to <w>helm</w> the knight before the battle began.",
                            "target_lang_translations": {
                                "ru": "Оруженосец помог <w>надеть шлем</w> на рыцаря перед началом битвы.",
                                "zh": "战斗开始前，侍从帮助骑士<w>戴上头盔</w>。"
                            }
                        },
                        {
                            "text": "He <w>helmed</w> his head and prepared to face the enemy on the field.",
                            "target_lang_translations": {
                                "ru": "Он <w>надел шлем</w> и приготовился встретить врага на поле боя.",
                                "zh": "他<w>戴上头盔</w>，准备在战场上迎击敌人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "behelm"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Надевать шлем на кого-либо или обеспечивать шлемом.",
                        "zh": "为某人戴上头盔。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надевать шлем",
                                "target_lang_sense_clarification": "облачать в доспехи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "戴上头盔",
                                "target_lang_sense_clarification": "穿戴防护装备"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0664a94d-05d7-3a81-9e5d-17425c36cbf2",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
