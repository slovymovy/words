                "senses": [
                    {
                        "sense_id": "c88685b5-e435-324f-b4df-a1afbe50bda0",
                        "entry_id": "c38d40ee-6e01-3461-8f1e-b557141ac943",
                        "glosses": [
                            "Fähigkeit, gut Reime bilden zu können; poetische, verbale Begabung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2510f336-3b95-4207-be8a-003e14fdf25b",
                                "sense_id": "c88685b5-e435-324f-b4df-a1afbe50bda0",
                                "text": "„Rostand habe ihn noch gehört und sei voller Bewunderung für seine Reimfertigkeit gewesen.“"
                            },
                            {
                                "example_id": "3386eae7-b54f-466f-81f8-a5a13a9856e7",
                                "sense_id": "c88685b5-e435-324f-b4df-a1afbe50bda0",
                                "text": "„An Zierlichkeit und Glätte in der Form, an Reimfertigkeit und Sprachgewandtheit bleibt Gottfried’s Schule ausgezeichnet […].“"
                            },
                            {
                                "example_id": "efb2bc1a-222d-4173-894e-f3301d4c69fb",
                                "sense_id": "c88685b5-e435-324f-b4df-a1afbe50bda0",
                                "text": "„Zwar besaß er wenig Talent zur Poesie, doch wusste er diesen Mangel vor ungeübten Blicken durch Reimfertigkeit und Dreistigkeit zu verstecken.“"
                            },
                            {
                                "example_id": "cd774ee5-8d80-49da-908f-018dd24e5dd4",
                                "sense_id": "c88685b5-e435-324f-b4df-a1afbe50bda0",
                                "text": "„Doch befaß er eine erstaunliche Reimfertigkeit, und obgleich seine Gedichte jetzt veraltet sind, überraschen sie doch im Ganzen durch Reinheit des Ausdrucks und einfelne gelungene Naturschilderungen.“"
                            },
                            {
                                "example_id": "2408a3ef-ac8c-4a4c-9453-82ae8fd9d556",
                                "sense_id": "c88685b5-e435-324f-b4df-a1afbe50bda0",
                                "text": "„Doch wird nicht zu leugnen sein, dass sich auch in dem sachlich und poetisch unbedeutenden Buche des sehr alten Mannes eine von reicher Uebung zeigende Reimfertigkeit kundgibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
