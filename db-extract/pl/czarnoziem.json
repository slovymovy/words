                    },
                    {
                        "translation_id": "28614324-3977-4766-ae06-51d1b7c4880e",
                        "source_entry_id": "de4fe2d7-fefb-3115-8b6a-2d019e7ac4fd",
                        "source_sense_id": "216a389c-ff96-3c71-bb9a-0b2c0f15cb43",
                        "target_lang_word": "chernozem",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chernozem",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e87bb3c6-8c1d-3dcf-88e7-b96bf912b0e6",
                                        "entry_id": "7934fc49-cd43-3efd-970c-273594ff8cad",
                                        "glosses": [
                                            "A fertile black soil containing a very high percentage of humus (3% to 15%) and high percentages of phosphoric acids, phosphorus and ammonia."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68026d96-03aa-448f-a6ee-bc352dcb1da1",
                                                "sense_id": "e87bb3c6-8c1d-3dcf-88e7-b96bf912b0e6",
                                                "text": "The experiments made by the beet-root growers of the extensive tract of land in Russia, known as the Tschernosem or 'Black soil', whose fertility for corn plants is proverbial, show that this earth, though analytically proved to contain upon the whole, to the depth of twenty inches, 700 to 1000 times the quantity of potash required for a full beet-root crop, is, after three or four years' cultivation, so exhausted, that without manuring it will no longer yield a remunerative crop of beetroot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd57feb5-7bf8-4c89-bbfb-244c9ea0e986",
                        "source_entry_id": "de4fe2d7-fefb-3115-8b6a-2d019e7ac4fd",
                        "source_sense_id": "216a389c-ff96-3c71-bb9a-0b2c0f15cb43",
                        "target_lang_word": "Schwarzerde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwarzerde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7016404-e7ea-33e1-938f-196a9c082fa2",
                                        "entry_id": "64df6857-875f-31cc-88f4-81402eb53b7b",
                                        "glosses": [
                                            "nahezu schwarzer, sehr fruchtbarer Bodentyp, der reich an Humus ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8122cae0-006f-4893-91ac-ab9eee15dc80",
                                                "sense_id": "c7016404-e7ea-33e1-938f-196a9c082fa2",
                                                "text": "„Das schwarze Gold der Ukraine ist nicht flüssig. Es ist feucht, sattdunkel und schwer: Schwarzerde. Das zweitgrößte Land Europas ist gesegnet mit diesen vom Humus dunkel gefärbten Böden. Sie machen die Ukraine zum fruchtbarsten Agrarland der Erde und zur Kornkammer Europas.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "519df189-7b41-49a0-99bb-e9b123e74c2c",
                        "source_entry_id": "de4fe2d7-fefb-3115-8b6a-2d019e7ac4fd",
                        "source_sense_id": "216a389c-ff96-3c71-bb9a-0b2c0f15cb43",
                        "target_lang_word": "чернозём",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "чернозём",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "89929453-b05d-3acc-af5a-ded6c6372361",
                                        "entry_id": "ba41800c-1e23-37e7-b05e-5a3122180e62",
                                        "glosses": [
                                            "тёмноокрашенный тип почвы, богатый гумусом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b0a7608-668f-4b73-8048-d5570263f990",
                                                "sense_id": "89929453-b05d-3acc-af5a-ded6c6372361",
                                                "text": "Он с восхищением говорил о хлебородной вишенской земле, состоящей в иных местах из трехаршинного чернозёма."
                                            },
                                            {
                                                "example_id": "91a9e8f7-edb1-4502-8775-5bc9858cbda8",
                                                "sense_id": "89929453-b05d-3acc-af5a-ded6c6372361",
                                                "text": "У них земля — камень, а у нас — на сажень чернозём, да говорят, что в крайнем случае и ещё сажень на пять будет!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
