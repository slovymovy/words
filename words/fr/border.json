                    "semantic_group_id": "couture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La couturière a choisi de <w>border</w> la nappe avec un fil doré élégant."
                        },
                        {
                            "text": "Il a fait <w>border</w> son manteau d'une bande de fourrure synthétique."
