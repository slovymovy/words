                "senses": [
                    {
                        "sense_id": "62a36fa1-8305-3a2a-8af7-eab6af2d92f6",
                        "entry_id": "ae30de02-a667-353a-bdcf-7eb5cfc9bb3a",
                        "glosses": [
                            "мужской или женский домашний, спальный или больничный костюм, состоящий из широких брюк и куртки свободного покроя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd94bda4-6a4b-41cd-8b29-42301127adbc",
                                "sense_id": "62a36fa1-8305-3a2a-8af7-eab6af2d92f6",
                                "text": "Конечно, спать было уже невозможно, он вставал, одевался в пижаму, садился перед окном с книжкой в руках, но не читал, а смотрел на море."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c84044b3-fa2a-4aaf-a45f-6bc7f76555f1",
                        "source_entry_id": "ae30de02-a667-353a-bdcf-7eb5cfc9bb3a",
                        "source_sense_id": "62a36fa1-8305-3a2a-8af7-eab6af2d92f6",
                        "target_lang_word": "pyjamas",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pyjamas",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b83cfa5-a5a8-3e45-9dd9-8681a5edb459",
                                        "entry_id": "6b3d1dc8-cd40-3fc1-9353-64f635c2b7a0",
                                        "glosses": [
                                            "British standard spelling of pajamas (“clothes for sleeping in”)."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36eeab0b-8e6b-4e94-a2a0-0a0e6eaed317",
                                                "sense_id": "8b83cfa5-a5a8-3e45-9dd9-8681a5edb459",
                                                "text": "The performer opens one of the small drawers and takes out two sets of pyjamas."
                                            },
                                            {
                                                "example_id": "59a3fd4a-07d2-4990-93c3-d1d98ecc9dbe",
                                                "sense_id": "8b83cfa5-a5a8-3e45-9dd9-8681a5edb459",
                                                "text": "She wasn′t sure if Lena looked more surprised by her clobbering hug or the sight of her pyjamas on the bright New York City sidewalk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bd61d6d-8608-3793-883b-e2e9b4c985c1",
                                        "entry_id": "6b3d1dc8-cd40-3fc1-9353-64f635c2b7a0",
                                        "glosses": [
                                            "British standard spelling of pajamas (“loose trousers worn by men and women in South Asia”)."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14f355b9-03bd-40b2-b8ac-e3fab5264b8f",
                                                "sense_id": "8bd61d6d-8608-3793-883b-e2e9b4c985c1",
                                                "text": "They too revert to simpler, non-western clothes—saris, dhotis, and pyjamas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3e6befa-ac76-368a-a23a-fff52bb78deb",
                                        "entry_id": "6b3d1dc8-cd40-3fc1-9353-64f635c2b7a0",
                                        "glosses": [
                                            "British standard spelling of pajamas."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5acdd3c5-407a-4ce7-993e-eeb013e56c76",
                        "source_entry_id": "ae30de02-a667-353a-bdcf-7eb5cfc9bb3a",
