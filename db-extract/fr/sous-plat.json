                                        "examples": [
                                            {
                                                "example_id": "e9bb57f9-b349-402b-9ecf-5e8c7f87c95b",
                                                "sense_id": "dd3d4e00-9665-3636-8a00-e80c2e2efb2b",
                                                "text": "I watch as Abikok scoops two spoonsful of rice, a spoonful of broccoli, a spoonful of peas, and a large chunk of roast beef into a plate. She then lifts it with both hands and places it on my table mat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7aff667-590b-381a-9f89-6bafaca07d4c",
                                        "entry_id": "de4f1249-1a6b-380c-8aa2-4eca09bb45bd",
                                        "glosses": [
                                            "A cushion or stiff material placed on top of a table, underneath a tablecloth."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dca972af-0750-4451-9757-9810f9452f49",
                                                "sense_id": "d7aff667-590b-381a-9f89-6bafaca07d4c",
                                                "text": "After putting the leaves in the table and putting on the tablemat and tablecloth, they laid the placemats out."
                                            }
                                        ]
                                    }
                                ]
                            }
