                    "sense_definition": "iemand of iets volgend in beweging of richting",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "volgen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kleine hond rende de postbode snel <w>achterna</w> door de tuin.",
                            "target_lang_translations": {
                                "en": "The little dog quickly ran <w>after</w> the mailman through the garden.",
                                "ru": "Маленькая собака быстро побежала <w>вдогонку</w> за почтальоном через сад."
                            }
                        },
                        {
                            "text": "Toen hij zijn tas vergat, liepen wij hem direct <w>achterna</w> om hem te roepen.",
                            "target_lang_translations": {
                                "en": "When he forgot his bag, we immediately walked <w>after</w> him to call him.",
                                "ru": "Когда он забыл свою сумку, мы тут же пошли <w>вслед</w> за ним, чтобы окликнуть его."
                            }
                        }
