                        "sense_id": "cdfd0b8a-afc5-3a03-acc5-af3384d0130e",
                        "entry_id": "6e1c3e9a-8d0a-32ba-8784-7d742b9615cf",
                        "glosses": [
                            "Homme refoulé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04e995b9-bf98-4623-b92e-fdbdfe9b41cc",
                                "sense_id": "cdfd0b8a-afc5-3a03-acc5-af3384d0130e",
                                "text": "Il est intéressant de remarquer, enfin, que ce refoulé apparaît grâce à la médiation du personnage féminin du livre qui est, d’une certaine façon, un personnage maternel."
                            }
                        ]
                    }
                ],
                "translations": [],
