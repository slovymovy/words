                "senses": [
                    {
                        "sense_id": "3959cb8f-f679-35dd-9b7d-70a5ec12aa73",
                        "entry_id": "0187c4ce-e8d8-3e68-b28d-68302fd09fb1",
                        "glosses": [
                            "Raubtier, das der kleinste Vertreter der Hyänen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0da0be6-a2e6-4180-a311-e0d63115d0f1",
                                "sense_id": "3959cb8f-f679-35dd-9b7d-70a5ec12aa73",
                                "text": "„Der Erdwolf hat einen schlanken Kopf mit zugespitzter Schnauze, die Eigentlichen Hyänen hingegen einen wuchtigen Kopf, der auf einem kräftigen Nacken sitzt, ihre Schnauze ist breit gebaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6248e4e2-ea37-42fc-a9a2-0b960a9c547c",
                        "source_entry_id": "0187c4ce-e8d8-3e68-b28d-68302fd09fb1",
                        "source_sense_id": "3959cb8f-f679-35dd-9b7d-70a5ec12aa73",
                        "source_sense_description": "Zoologie: Raubtier, das der kleinste Vertreter der Hyänen ist",
                        "target_lang_word": "aardwolf",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aardwolf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "330786d3-a72d-3b9e-bcab-ff5a4481ab47",
                                        "entry_id": "6d0cfeb2-3e99-37f1-8c0a-9308ab3f3286",
                                        "glosses": [
                                            "A nocturnal, insectivorous mammal, Proteles cristatus, of southern and eastern Africa, related to and resembling the hyena."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0b9d676-cbda-4af7-9d6b-7866b9f1587a",
                                                "sense_id": "330786d3-a72d-3b9e-bcab-ff5a4481ab47",
                                                "text": "Today the only dog-like hyena is Africa’s termite-eating aardwolf."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b289a75-b3f2-40fc-81a2-492699994213",
                        "source_entry_id": "0187c4ce-e8d8-3e68-b28d-68302fd09fb1",
                        "source_sense_id": "3959cb8f-f679-35dd-9b7d-70a5ec12aa73",
                        "source_sense_description": "Zoologie: Raubtier, das der kleinste Vertreter der Hyänen ist",
                        "target_lang_word": "protèle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protèle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec8df5a1-6c09-3867-9064-9a240bcb6353",
                                        "entry_id": "78461c46-cd83-3bf4-a770-ccbf669847dc",
                                        "glosses": [
                                            "Espèce de carnivore d’Afrique proche de la hyène rayée, au museau fin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f538b4d1-9cb0-4737-a0e6-341b8d683e01",
                                                "sense_id": "ec8df5a1-6c09-3867-9064-9a240bcb6353",
                                                "text": "Il faudrait charrier dans les veines non du sang congolais mais de l’eau, comme un concombre ghanéen, pour considérer avec calme, pis que venin et crapaud, pis que le squameux pangolin enroulé à sa branche, pis que la longue langue tremblée, cautèle du protèle torve, l’indécent grouillement de l’Afrique de la trahison !"
                                            },
                                            {
                                                "example_id": "1c1f4c5e-b5ce-4b6f-9b34-e614b6f28a7a",
                                                "sense_id": "ec8df5a1-6c09-3867-9064-9a240bcb6353",
                                                "text": "Le protèle est une petite hyène au régime alimentaire hyperspécialisé. Largement insectivore, il peut consommer jusqu’à 300 000 termites en une nuit, utilisant d’autre part les termitières excavées comme abris diurnes."
                                            },
                                            {
                                                "example_id": "865579b4-05d8-4ad1-a99d-f101ebbfe5be",
                                                "sense_id": "ec8df5a1-6c09-3867-9064-9a240bcb6353",
                                                "text": "Lions, léopards, guépards, lycaons, hyènes, caracals, servals, otocyons, chacals, ratels, zorilles, protèles, civettes, genettes, chats sauvages... les savanes de l’Okavango sont le domaine des chasseurs et des opportunistes carnassiers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2114627-8d12-4491-8bd9-fcef8f558498",
                        "source_entry_id": "0187c4ce-e8d8-3e68-b28d-68302fd09fb1",
