                "senses": [
                    {
                        "sense_id": "4ac7d5af-6cd6-3ad5-8b33-ee2f6ac630b2",
                        "entry_id": "9f7429a8-8250-3181-b8f2-d781fbe8cccd",
                        "glosses": [
                            "veränderte Wahrnehmung von Sinnesreizen (zum Beispiel in Form von Kribbeln, Brennen, Taubheit)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca0de9fc-c7a2-4e2b-a66a-9146551df659",
                                "sense_id": "4ac7d5af-6cd6-3ad5-8b33-ee2f6ac630b2",
                                "text": "„Er kehrte als Rollstuhlfahrer mit einer Empfindungsstörung in den Beinen in die Familie zurück, wegen der er kaum noch laufen kann.“"
                            },
                            {
                                "example_id": "22bcdfee-ccc7-4f82-a50c-5450ad62f909",
                                "sense_id": "4ac7d5af-6cd6-3ad5-8b33-ee2f6ac630b2",
                                "text": "„Unbehandelte Verletzungen zum Beispiel durch zu kleine Schuhe, was man aufgrund der Nervenschädigung - und der damit verbundenen Empfindungsstörung - häufig nicht wahrnimmt, können übersehen werden.“"
                            },
                            {
                                "example_id": "04c65616-e464-4a8f-8798-78b503b30750",
                                "sense_id": "4ac7d5af-6cd6-3ad5-8b33-ee2f6ac630b2",
                                "text": "„Unterhalb der verletzten Stelle ist ipsilateral eine dissozierte Empfindungsstörung nachweisbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
