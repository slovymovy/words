                ],
                "senses": [
                    {
                        "sense_id": "81bb188c-e33f-3a89-a62b-b50ef62ad3b5",
                        "entry_id": "b80bb9f6-a873-38d5-b445-89d41fa47c65",
                        "glosses": [
                            "Synonym of misshape."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d6a97c65-a416-444b-a067-8d20103c13be",
                                "sense_id": "81bb188c-e33f-3a89-a62b-b50ef62ad3b5",
                                "text": "If the feet are well shaped but have some weakness, they will ultimately give way under the strain of use and lose their natural shape, often becoming distorted. This, of coarse, results in the distortion of the shoe. Few persons realize to what extent shoes are misshapened by defective feet."
                            },
                            {
                                "example_id": "9e58f63b-3551-484e-af2e-4eb018d5467a",
                                "sense_id": "81bb188c-e33f-3a89-a62b-b50ef62ad3b5",
                                "text": "Skin the fish before cooking since the skin shrinks as it cooks and misshapens the fillets."
                            },
                            {
                                "example_id": "b4abdc00-5400-43e7-8c1f-b836ce61f37c",
                                "sense_id": "81bb188c-e33f-3a89-a62b-b50ef62ad3b5",
                                "text": "Large barrel sponges are misshapened by the strong currents"
                            }
                        ]
                    }
