                                "target_senses": [
                                    {
                                        "sense_id": "59e016e4-00e7-39d9-b070-47233bec6ae0",
                                        "entry_id": "de3ab0df-7469-3e72-8912-ee73d241ce69",
                                        "glosses": [
                                            "A mistake."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "mildly",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed9613ae-0d1a-4c0d-97f7-cb81db147fcf",
                                                "sense_id": "59e016e4-00e7-39d9-b070-47233bec6ae0",
                                                "text": "And I'm sorry for all the cock-ups, my cabinet are absolute crap. We'll have to do better next year."
                                            },
                                            {
                                                "example_id": "e9388146-7dd7-4a63-8955-41ce91d0c523",
                                                "sense_id": "59e016e4-00e7-39d9-b070-47233bec6ae0",
                                                "text": "In over a quarter of a century of writing this column, there has been no end of scandals, mishaps, errors and general cock-ups resulting from ministerial incompetence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "348da12f-97c6-3820-9e82-6f2bbb9fda0d",
                                        "entry_id": "de3ab0df-7469-3e72-8912-ee73d241ce69",
                                        "glosses": [
                                            "A superior letter; a lower-case letter placed above the baseline and made smaller than ordinary script; traditionally used in abbreviations."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7338e536-f672-4003-b730-944b54a96e10",
                                                "sense_id": "348da12f-97c6-3820-9e82-6f2bbb9fda0d",
                                                "text": "The first word of every section or chapter is generally put in small capitals, after a small neat cock-up letter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58d8dc89-ddde-3982-8497-4bf0ed7d79c2",
                                        "entry_id": "de3ab0df-7469-3e72-8912-ee73d241ce69",
                                        "glosses": [
                                            "A roll or twist of hair worn at the nape of the neck; a bun."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f9580e2-f1d9-4f54-9010-b2b8fc62a745",
                                                "sense_id": "58d8dc89-ddde-3982-8497-4bf0ed7d79c2",
                                                "text": "Cockernonie, a gathering up of the hair of women, after a fashion similar to that of the modern \"chignon,\" and sometimes called a \"cock-up.\" Mr. Kirkton, of Edinburgh, preaching against \"cock-ups\"—of which chignons were the representatives a quarter of a century ago—said: \"I have been all this year preaching against the vanity of women, yet I see my own daughter in the kirk even now with as high a 'cock-up' as any one of you all.\""
                                            }
                                        ]
                                    }
                                ]
