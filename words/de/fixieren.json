                    "frequency": "Middle",
                    "semantic_group_id": "befestigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das schwere Regal sollten wir mit Schrauben an der Wand <w>fixieren</w>."
                        },
                        {
                            "text": "Die Ärztin musste das verletzte Bein mit einer Schiene stabil <w>fixieren</w>."
                        }
                    ],
