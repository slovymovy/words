                                "example_id": "3bd4bdbc-15f8-4e01-938a-0ed8b9bfc325",
                                "sense_id": "6760db5c-0444-3eee-8412-5f7f075bc091",
                                "text": "„Die Münzprägung wurde an den königlichen Pfalzen zentralisiert, was die Vereinheitlichung des Münzwesens erleichterte.“"
                            },
                            {
                                "example_id": "04296e85-0f3e-40e5-9414-310182697f74",
                                "sense_id": "6760db5c-0444-3eee-8412-5f7f075bc091",
                                "text": "„Eine weitere wichtige Vereinheitlichung kam ebenfalls durch den Zollverein: Endlich wurde es möglich, in allen Territorien dieselben Maße und Gewichte durchzusetzen.“"
                            }
                        ],
