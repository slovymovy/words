    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "072b295e-73ea-38db-805f-d6e5a0436b48",
                "word": "rouille",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5af71d33-b63f-425d-8bed-8776bf6be4a5",
                        "entry_id": "072b295e-73ea-38db-805f-d6e5a0436b48",
                        "tags": [
                            "plural"
                        ],
                        "form": "rouilles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "955e522c-1be7-3f8d-9ab3-146104870e8b",
                        "entry_id": "072b295e-73ea-38db-805f-d6e5a0436b48",
                        "glosses": [
                            "A type of sauce from Provence, France, often served with fish dishes, consisting of egg yolk and olive oil with breadcrumbs, chili peppers, garlic, and saffron."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d96e7395-1d28-4b80-8bad-1de8e656be6b",
                                "sense_id": "955e522c-1be7-3f8d-9ab3-146104870e8b",
                                "text": "Serve with grated Parmesan cheese and a rouille sauce [...]."
                            },
                            {
                                "example_id": "51d8b92b-71c8-4102-a595-905f03159eaa",
                                "sense_id": "955e522c-1be7-3f8d-9ab3-146104870e8b",
                                "text": "ROUILLE SAUCE / Strongly flavored, served with fish soups or bouillabaisse."
                            },
                            {
                                "example_id": "863f9970-052e-4980-bbc3-76cd5b675c6c",
                                "sense_id": "955e522c-1be7-3f8d-9ab3-146104870e8b",
                                "text": "Rouille: Garlic, Saffron, and Pepper Mayonnaise [...] After you have added a few drops of oil, add saffron and a pinch of cayenne. Gradually whisk in remaining oil in a slow, thin stream until sauce is thickened to a mayonnaise consistency. Taste the rouille and add additional cayenne, if desired."
                            },
                            {
                                "example_id": "50a5d91e-8e8a-47cc-95a0-e646ec382823",
                                "sense_id": "955e522c-1be7-3f8d-9ab3-146104870e8b",
                                "text": "In the Northwest one finds fritters coated with not-too-finely ground hazelnuts, with crab on the inside; in that case called crab cakes, spiked with chopped scallion and bell or hot red pepper, served with rouilles of mustard and racy mayonnaise."
                            },
                            {
                                "example_id": "fbe7f4b6-a121-46a3-9c62-a9660347efa7",
                                "sense_id": "955e522c-1be7-3f8d-9ab3-146104870e8b",
                                "text": "Chicken bouillabaisse with Rouille [...] I'm taking some liberties by calling this recipe a bouillabaisse. The classic recipe, of course, is a venerable fish stew that originated in Marseille. It's flavored with saffron and garnished with a rouille sauce. [...] To serve, divide the bouillabaisse among 4 soup plates and top with the Rouille."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03d25caf-2016-41ee-8862-17c53d3506f5",
                        "source_entry_id": "072b295e-73ea-38db-805f-d6e5a0436b48",
                        "source_sense_id": "955e522c-1be7-3f8d-9ab3-146104870e8b",
                        "source_sense_description": "type of sauce from Provence, France",
                        "target_lang_word": "rouille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rouille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "470b7ff3-4be4-317b-8c05-c1909b436dcf",
                                        "entry_id": "704e7831-6d1a-3961-993b-29f2b654897a",
                                        "glosses": [
                                            "Matière friable, composée d’hydroxyde de fer, qui se forme sur les métaux ferreux par oxydation au contact de l’eau et de l’air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d39484f2-526b-469b-847e-37d81a195076",
                                                "sense_id": "470b7ff3-4be4-317b-8c05-c1909b436dcf",
                                                "text": "La rouille mange, ronge le fer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "656cd936-052e-3f40-895d-7cd530e91deb",
                                        "entry_id": "704e7831-6d1a-3961-993b-29f2b654897a",
                                        "glosses": [
                                            "Le fait de se transformer en rouille, pour un objet en fer ou en acier. Le processus de transformation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5df591ba-27fd-392a-8d92-847b2817e5c0",
                                        "entry_id": "704e7831-6d1a-3961-993b-29f2b654897a",
                                        "glosses": [
                                            "Oxyde de cuivre et oxyde de quelques autres métaux."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e69b4999-48c4-4c18-8880-fd96dd9f39b3",
                                                "sense_id": "5df591ba-27fd-392a-8d92-847b2817e5c0",
                                                "text": "La rouille du cuivre se nomme Vert-de-gris."
                                            },
                                            {
                                                "example_id": "5fe10fd4-ac5b-4b57-b53b-cec3dda28636",
                                                "sense_id": "5df591ba-27fd-392a-8d92-847b2817e5c0",
                                                "text": "La rouille de plomb."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "714cf63d-4cc7-3fa4-8656-1b8f1d8277b3",
                                        "entry_id": "704e7831-6d1a-3961-993b-29f2b654897a",
                                        "glosses": [
                                            "Les parties d’une glace où le tain est altéré, terni par l’humidité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fab90eb1-ebde-4ec6-b17f-cefb5f723ff6",
                                                "sense_id": "714cf63d-4cc7-3fa4-8656-1b8f1d8277b3",
                                                "text": "Il y a des taches de rouille à cette glace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66551106-5424-3dca-8b10-6b8a89ff82db",
                                        "entry_id": "704e7831-6d1a-3961-993b-29f2b654897a",
                                        "glosses": [
                                            "Les causes d’altération, de dégradation, de vétusté."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56b439c9-313d-448c-b38f-415a25266fb9",
                                                "sense_id": "66551106-5424-3dca-8b10-6b8a89ff82db",
                                                "text": "La rouille des vieux préjugés."
                                            },
                                            {
                                                "example_id": "58d2ab54-9da5-462b-b367-34cec25eba08",
                                                "sense_id": "66551106-5424-3dca-8b10-6b8a89ff82db",
                                                "text": "Ses ouvrages, quoique empreints de la rouille du temps, méritent d’être étudiés."
                                            },
                                            {
                                                "example_id": "92c03e37-842e-4b39-92aa-bd53ff97d34a",
                                                "sense_id": "66551106-5424-3dca-8b10-6b8a89ff82db",
                                                "text": "Le poli parisien faisait rouille sur cette âme vigoureusement trempée."
                                            },
                                            {
                                                "example_id": "8ea60ce3-1f4f-4b32-9c3a-1c451821e22d",
                                                "sense_id": "66551106-5424-3dca-8b10-6b8a89ff82db",
                                                "text": "Je grimpais sur un tabouret, je fouillais la bibliothèque ; j’y découvrais toujours quelque Fenimore Cooper, ou quelque « Magasin pittoresque » aux feuillets piqués de rouille, que je ne connaissais pas encore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7a2901f-74c5-396d-9e34-35e6bb9231ee",
                                        "entry_id": "704e7831-6d1a-3961-993b-29f2b654897a",
                                        "glosses": [
                                            "Couleur évoquant celle de la rouille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d378842-fc9f-4115-8c42-bbd5cffb203b",
                                                "sense_id": "e7a2901f-74c5-396d-9e34-35e6bb9231ee",
                                                "text": "C’était un vieil homme fluet à la barbe de rouille qui errait dans une maison immense mais délabrée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c124b12c-8e8f-3df1-a6a4-93696f1cd6cc",
                                        "entry_id": "704e7831-6d1a-3961-993b-29f2b654897a",
                                        "glosses": [
                                            "Sauce froide provençale qui accompagne la soupe de poisson ou la bouillabaisse."
                                        ],
                                        "tags": [
                                            "Sauces"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84401733-cec1-494f-99cc-b2e463351825",
                                                "sense_id": "c124b12c-8e8f-3df1-a6a4-93696f1cd6cc",
                                                "text": "Pour préparer la rouille, pilez de l’ail avec un piment rouge, rajoutez du jaune d’œuf, montez à l’huile d'olive puis ajoutez un peu de soupe de poissons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "782dac45-1e5d-35e9-b28f-6a9f764ae0da",
                                        "entry_id": "704e7831-6d1a-3961-993b-29f2b654897a",
                                        "glosses": [
                                            "Maladie cryptogamique des végétaux supérieurs, dont il existe de nombreuses variantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35ed6e57-f053-44b4-b6bc-df41fa8a6cbf",
                                                "sense_id": "782dac45-1e5d-35e9-b28f-6a9f764ae0da",
                                                "text": "La rouille et le charbon ou nielle ne se montrent guère que dans les années pluvieuses et sur les récoltes ensemencées trop tard ; l’ergot du seigle est très-rare."
                                            },
                                            {
                                                "example_id": "f8bc9837-efcc-4f70-9a7e-fb13323e1578",
                                                "sense_id": "782dac45-1e5d-35e9-b28f-6a9f764ae0da",
                                                "text": "Les maladies de la vigne sont : la rouille, l’ortiage et la gale.\nLorsqu'une vigne est atteinte de la rouille, les feuilles paraissent fatiguées, penchantes et d'un vert froid."
                                            },
                                            {
                                                "example_id": "566619ad-1b91-46b9-9e4c-2f5af4b9aedc",
                                                "sense_id": "782dac45-1e5d-35e9-b28f-6a9f764ae0da",
                                                "text": "Les stades urédospores et téliospores de cette rouille se déroulent sur blé, tandis que le stade écidien se rencontre sur Berberis (épine vinette)."
                                            },
                                            {
                                                "example_id": "c2126f6c-a045-45dd-8882-83ca4d3160ec",
                                                "sense_id": "782dac45-1e5d-35e9-b28f-6a9f764ae0da",
                                                "text": "En conditions climatiques favorables, la rouille peut s'y maintenir indéfiniment sous sa forme II, et la forme écidienne rester très rare."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rouille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e4fe5ef3-5b6b-3623-9b3d-6b386f678d4a",
                                        "entry_id": "10a285b4-8e20-31c2-b8d8-053414e7b891",
                                        "glosses": [
                                            "Bouteille, particulièrement de champagne."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02cd8975-b72b-4222-a9e0-483136f942fa",
                                                "sense_id": "e4fe5ef3-5b6b-3623-9b3d-6b386f678d4a",
                                                "text": "Sans oublier une quille de Châteauneuf et une rouille de brut."
                                            },
                                            {
                                                "example_id": "396f1344-5285-4bd9-9662-b9acf0649db8",
                                                "sense_id": "e4fe5ef3-5b6b-3623-9b3d-6b386f678d4a",
                                                "text": "Une soirée bien remplie, la bagatelle et deux rouilles de champ’ aidant, le Grêlé commençait à fermer ses paupières de crapaud."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rouille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c564a11-ea04-38cc-ac68-fce8244b187c",
                                        "entry_id": "12e1d678-a5c3-3be8-bf3e-05b611f92b0c",
                                        "glosses": [
                                            "De couleur brun roux. #985717"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0c1cc61-a8a5-4d18-a869-3177c481830a",
                                                "sense_id": "7c564a11-ea04-38cc-ac68-fce8244b187c",
                                                "text": "Dès l’automne, la Fougère Aigle aux frondes desséchées attriste de sa teinte rouille la tonalité déjà grise de l’ensemble."
                                            }
                                        ]
                                    }
                                ]
                            },
