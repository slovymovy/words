                        "sense_id": "6d4f4c5e-5998-32dc-b661-33bf5cb0121b",
                        "entry_id": "d282ce17-c099-34d6-815e-7b1166c4db75",
                        "glosses": [
                            "Gesamtheit aus Kultur, Geschichte, Religion und Tradition der Kelten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3084d04-7ca5-4489-a690-e9f65edcc04d",
                                "sense_id": "6d4f4c5e-5998-32dc-b661-33bf5cb0121b",
                                "text": "„Drei Kulturen lagern hier übereinander - in Trümmern: Keltentum, Römertum und christliches Germanentum folgten einander in der Zerstörung.“"
                            },
                            {
                                "example_id": "44225967-f18f-4ae5-a3a4-f9efeefd30ed",
                                "sense_id": "6d4f4c5e-5998-32dc-b661-33bf5cb0121b",
                                "text": "„Das Keltentum dient der Sinnsuche, wird zur vagen Sehnsucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
