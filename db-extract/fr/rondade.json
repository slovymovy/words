                    {
                        "sense_id": "b5a08fad-3efe-3ff5-b951-8574c21b8542",
                        "entry_id": "9e2e7215-661e-3820-9fea-e6782f9f9e98",
                        "glosses": [
                            "Élément acrobatique latéral d'élan, qui commence comme une Roue et arrive avec les 2 pieds en même temps par l'action d'une courbette. Permet de créer des séries acrobatiques vers l'arrière."
                        ],
                        "tags": [
                            "Gymnastique"
                        ],
                        "examples": [
                            {
                                "example_id": "f0ac6622-4a1c-48d4-ad96-835374b3782c",
                                "sense_id": "b5a08fad-3efe-3ff5-b951-8574c21b8542",
                                "text": "Il se redresse instantanément, comme un gymnaste après une rondade."
                            },
                            {
                                "example_id": "316af765-9cd5-41b8-aac6-54a5d4210dab",
                                "sense_id": "b5a08fad-3efe-3ff5-b951-8574c21b8542",
                                "text": "Et ensuite, on a travaillé les rondades au sol."
                            },
                            {
                                "example_id": "4d63c58c-b3f1-46b1-bcf8-0da68d9fa80a",
                                "sense_id": "b5a08fad-3efe-3ff5-b951-8574c21b8542",
                                "text": "Série acrobatique arrière au sol : Rondade-flip-salto"
                            }
                        ]
                    }
                ],
