                        "glosses": [
                            "To undo the process of slicing."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9fc3b51c-9ee3-452c-9a63-7d5be211c958",
                                "sense_id": "31565c61-2a63-3e44-bbdd-77ca25e636c9",
                                "text": "While unshowering, driving in reverse, or unslicing a loaf of bread, all thoughts would proceed backward as well, so nobody would even know the difference between the strange events taking place and normal life."
                            },
                            {
                                "example_id": "a829e5e6-bf9a-4e15-815c-ee39b3d25f1f",
                                "sense_id": "31565c61-2a63-3e44-bbdd-77ca25e636c9",
                                "text": "If only sliced bread is available, you buy it, and it is both superfluous and impossible to try to unslice it; so you end up eating it, and enjoying the convenience."
                            }
                        ]
                    }
