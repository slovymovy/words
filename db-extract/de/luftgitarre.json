                        "examples": [
                            {
                                "example_id": "8b0ff675-71a6-4f03-b074-3c8deb3a8437",
                                "sense_id": "3f1d1589-db2e-3f54-8697-6f8e6fdb1fba",
                                "text": "„Ich spiele Luftgitarre zu ‚Day Tripper‘ und singe aus vollem Hals ‚Can’t Buy Me Love‘.“"
                            },
                            {
                                "example_id": "28c22645-6585-4ab5-ad4e-2fd3902ec041",
                                "sense_id": "3f1d1589-db2e-3f54-8697-6f8e6fdb1fba",
                                "text": "„Kitty spielt Luftgitarre, wiegt sich wie ein Hustinettenbär und schwenkt die Hüften im Takt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
