                "senses": [
                    {
                        "sense_id": "c633efca-8c7b-3d10-a3d8-2aff77eb9d54",
                        "entry_id": "cc05a73b-d9f9-361a-b9f0-6ccb0d037140",
                        "glosses": [
                            "eine „große kreisangehörige Stadt“ im Norden von Rheinland-Pfalz, die etwa 10 km nördlich von Koblenz am rechten Rheinufer gelegen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24e54002-68c0-47be-b304-366db88d716b",
                                "sense_id": "c633efca-8c7b-3d10-a3d8-2aff77eb9d54",
                                "text": "\"In den Kriegsjahren hatte die Stadt stark gelitten. Kein Ort der näheren und weiteren Umgebung […] war verschont geblieben. […] der Weißenthurm gegenüber gelegene Ort \"Langendorf\" verschwand fast vollständig. An seiner Stelle gründeten die Grafen von Wied die Stadt Neuwied.\""
                            },
                            {
                                "example_id": "15c05f3f-9456-4874-acef-5fb833a9818f",
                                "sense_id": "c633efca-8c7b-3d10-a3d8-2aff77eb9d54",
                                "text": "„Tatsächlich hat ihm Sophie La Roche von Plänen zur Gründung einer pädagogischen Akademie in Neuwied geschrieben, beim Grafen Friedrich Alexander zu Wied, und mit den Jacobis beredet er die Idee einer Verlagsbuchhandlung, beide Projekte kommen aber über das Planungsstadium nicht hinaus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
