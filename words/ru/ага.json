                    "sense_id": "8e55eced-2cc8-38bb-ae6f-6b791e11ff5c",
                    "sense_definition": "Разговорное слово, выражающее согласие, подтверждение или понимание; то же, что «да».",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Ты пойдешь с нами в кино? — <w>Ага</w>, с удовольствием.",
                            "target_lang_translations": {
                                "en": "— Are you coming to the movies with us? — <w>Yeah</w>, with pleasure.",
                                "nl": "— Ga je met ons mee naar de film? — <w>Ja</w>, met plezier.",
                                "pl": "— Pójdziesz z nami do kina? — <w>Aha</w>, z przyjemnością.",
                                "de": "— Kommst du mit uns ins Kino? — <w>Ja</w>, sehr gerne.",
                                "fr": "— Tu viens au cinéma avec nous ? — <w>Ouais</w>, avec plaisir.",
                                "it": "— Verrai al cinema con noi? — <w>Sì</w>, con piacere.",
                                "cs": "— Půjdeš s námi do kina? — <w>Jo</w>, s radostí.",
                                "tr": "— Bizimle sinemaya gelecek misin? — <w>Hıhı</w>, memnuniyetle.",
                                "es": "— ¿Vas a venir al cine con nosotros? — <w>Ajá</w>, con gusto.",
                                "zh": "—你跟我们一起去看电影吗？—<w>嗯</w>，很乐意。"
                            }
                        },
                        {
                            "text": "— Ты всё понял? — <w>Ага</w>, всё ясно.",
                            "target_lang_translations": {
                                "en": "— Did you understand everything? — <w>Uh-huh</w>, it's all clear.",
                                "nl": "— Heb je alles begrepen? — <w>Uh-huh</w>, het is allemaal duidelijk.",
                                "pl": "— Zrozumiałeś wszystko? — <w>Aha</w>, wszystko jasne.",
                                "de": "— Hast du alles verstanden? — <w>Aha</w>, alles klar.",
                                "fr": "— Tu as tout compris ? — <w>Ouais</w>, c'est clair.",
                                "it": "— Hai capito tutto? — <w>Già</w>, è tutto chiaro.",
                                "cs": "— Pochopil jsi všechno? — <w>Aha</w>, všechno je jasné.",
                                "tr": "— Her şeyi anladın mı? — <w>Hıhı</w>, her şey net.",
                                "es": "— ¿Entendiste todo? — <w>Ajá</w>, todo claro.",
                                "zh": "—你都明白了吗？—<w>嗯</w>，都清楚了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "да",
                        "угу́",
                        "так",
                        "хорошо",
                        "ладно"
                    ],
                    "common_phrases": [
                        "ага, конечно",
                        "ага, сейчас"
