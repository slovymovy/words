                        ],
                        "examples": [
                            {
                                "example_id": "b9a765a1-390e-46c9-8369-73c1cd40c8d5",
                                "sense_id": "2a39b1ee-a613-3caa-94b6-8da77e81cccf",
                                "text": "Manu lui marnoufla une pochette cartonnée qui contenait tous les faffes en bonnet difforme que la BITE lui avait fourni préalablement."
                            },
                            {
                                "example_id": "a17f4f71-fe88-442e-8223-8f350a4d8efa",
                                "sense_id": "2a39b1ee-a613-3caa-94b6-8da77e81cccf",
                                "text": "Tandis que je sors mes faffes, Popaul ouvre sa portière, se débrague et se met à pisser sur le beau car de flics !"
                            },
                            {
                                "example_id": "e15162fd-9052-4bd5-b1ea-47963ef58685",
                                "sense_id": "2a39b1ee-a613-3caa-94b6-8da77e81cccf",
                                "text": "Des Chleus en civil, en manteau de cuir noir, qui te l'ont embarqué... \"Kom ir\" sans ménagement. Vérification de ses faffes. On le prenait pour un youde à son allure, sa frime... ."
                            }
                        ]
                    }
