{
    "word_family": [
        "meagerness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f52a6c48-22ac-395f-9a45-97d97c2e99fb",
                    "sense_definition": "Poor, deficient or inferior in amount, quality or extent",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deficiency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family survived on a <w>meager</w> income during the winter months.",
                            "target_lang_translations": {
                                "cs": "Rodina během zimních měsíců přežívala z <w>mizerného</w> příjmu."
                            }
                        },
                        {
                            "text": "He offered a <w>meager</w> apology for his rude behavior at the party.",
                            "target_lang_translations": {
                                "cs": "Za své hrubé chování na večírku nabídl jen <w>nedostačující</w> omluvu."
                            }
                        }
                    ],
                    "synonyms": [
                        "paltry",
                        "scanty",
                        "inadequate",
                        "measly"
                    ],
                    "common_phrases": [
                        "meager amount",
                        "meager income"
                    ],
                    "target_lang_definitions": {
                        "cs": "Nedostatečný, chudý nebo neuspokojivý co do množství, kvality či rozsahu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "mizerný",
                                "target_lang_sense_clarification": "vyjadřuje nízkou úroveň nebo kvalitu"
                            },
                            {
                                "target_lang_word": "nedostačující",
                                "target_lang_sense_clarification": "vyjadřuje nedostatek v množství či rozsahu"
                            },
                            {
                                "target_lang_word": "ubohý",
                                "target_lang_sense_clarification": "vyjadřuje nedostatečnost v kvalitě nebo množství"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd8613e6-aea2-3f5c-9e62-af8c0c441e86",
                    "sense_definition": "Having little flesh; lean; thin",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>meager</w> dog struggled to find food in the cold streets.",
                            "target_lang_translations": {
                                "cs": "<w>Hubený</w> pes se v chladných ulicích snažil najít potravu."
                            }
                        },
                        {
                            "text": "His <w>meager</w> frame suggested he had not eaten in several days.",
                            "target_lang_translations": {
                                "cs": "Jeho <w>hubená</w> postava naznačovala, že několik dní nejedl."
                            }
                        }
                    ],
                    "antonyms": [
                        "dense"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající málo masa, vyzáblý, hubený."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hubený",
                                "target_lang_sense_clarification": "mající tělo úzké oproti normálu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7bd9298-f5e7-3ead-865a-d20ec9852d29",
                    "sense_definition": "Dry and harsh to the touch",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>meager</w> surface of the old stone wall felt rough against my hand.",
                            "target_lang_translations": {
                                "cs": "Drsný povrch staré kamenné zdi byl na dotek hrubý."
                            }
                        },
                        {
                            "text": "She wiped the <w>meager</w> dust from the chalkboard with a dry cloth.",
                            "target_lang_translations": {
                                "cs": "Suchým hadříkem setřela z tabule trošku prachu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Suchý a drsný na dotek."
                    },
                    "translations": {
                        "cs": []
                    }
                },
                {
                    "sense_id": "a88565d4-f18b-3449-884b-697cd196fca5",
                    "sense_definition": "Small or negligible in a mathematical or topological sense",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The set is considered <w>meager</w> within the context of the larger space.",
                            "target_lang_translations": {
                                "cs": "Množina je v kontextu většího prostoru považována za řídkou."
                            }
                        },
                        {
                            "text": "Topologists often describe such sets as <w>meager</w> to simplify their proofs.",
                            "target_lang_translations": {
                                "cs": "Topologové často popisují takové množiny jako řídké, aby si zjednodušili důkazy."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Malý nebo zanedbatelný v matematickém či topologickém smyslu."
                    },
                    "translations": {
                        "cs": []
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "92185709-4294-3ccb-b546-cc4fc55857f1",
                    "sense_definition": "To make lean",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The illness began to <w>meager</w> his once strong body.",
                            "target_lang_translations": {
                                "cs": "Nemoc začala jeho kdysi silné tělo vysilovat."
                            }
                        },
                        {
                            "text": "Hard labor and lack of food will <w>meager</w> even the strongest man.",
                            "target_lang_translations": {
                                "cs": "Těžká práce a nedostatek jídla vyčerpají i toho nejsilnějšího muže."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This verb usage is rarely encountered in modern English."
                        }
                    ],
                    "target_lang_definitions": {
