                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multiple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d70a36d1-c52f-3758-a3e0-06edee99343e",
                                        "entry_id": "42936ad7-abc7-3f4c-b39e-bd58a93fbaf5",
                                        "glosses": [
                                            "More than one (followed by plural)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb155b13-3518-4694-bfd8-11c03308e8dc",
                                                "sense_id": "d70a36d1-c52f-3758-a3e0-06edee99343e",
                                                "text": "My Swiss Army knife has multiple blades."
                                            },
                                            {
                                                "example_id": "81091cb2-e18d-46b0-a48b-a306c132e564",
                                                "sense_id": "d70a36d1-c52f-3758-a3e0-06edee99343e",
                                                "text": "Not long ago, it was difficult to produce photographs of tiny creatures with every part in focus.[…]A photo processing technique called focus stacking has changed that. Developed as a tool to electronically combine the sharpest bits of multiple digital images, focus stacking is a boon to biologists seeking full focus on a micron scale."
                                            },
                                            {
                                                "example_id": "ff537c04-9723-4dd7-822b-20fab66daa6a",
                                                "sense_id": "d70a36d1-c52f-3758-a3e0-06edee99343e",
                                                "text": "A study Kennedy discussed on multiple podcast episodes exposed male African clawed frogs to atrazine in a lab, castrating 75% of the male frogs and turning one in 10 males into females."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "multiple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "def2080c-a547-3f3b-a11d-351f9d1bd77d",
                                        "entry_id": "1013b311-391a-3c6e-be37-60243bbc8e59",
                                        "glosses": [
                                            "Having more than one element, part, component, or function, having more than one instance, occurring more than once, usually contrary to expectations (can be followed by a singular)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a3fc954-0762-43d3-8c4b-e53151c54992",
                                                "sense_id": "def2080c-a547-3f3b-a11d-351f9d1bd77d",
                                                "text": "Some states do explicitly prohibit multiple citizenship."
                                            },
                                            {
                                                "example_id": "026a559a-b20c-4c59-9d1e-cc7808bc46e3",
                                                "sense_id": "def2080c-a547-3f3b-a11d-351f9d1bd77d",
                                                "text": "It was a multiple pregnancy: the woman had triplets."
                                            },
                                            {
                                                "example_id": "db3c6ab0-ad9f-4eb1-a90d-a5e82b12d14f",
                                                "sense_id": "def2080c-a547-3f3b-a11d-351f9d1bd77d",
                                                "text": "Multiple registrations are an increasing problem for many social networking sites."
                                            },
                                            {
                                                "example_id": "ec10a534-cb81-4a82-9582-ab6a2727fd86",
                                                "sense_id": "def2080c-a547-3f3b-a11d-351f9d1bd77d",
                                                "text": "Now, let's briefly explore two different approaches for creating sites for a multiple audience: multiserving and responsive design."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22cfdb3b-1515-33ba-a48b-6249f3399007",
                                        "entry_id": "1013b311-391a-3c6e-be37-60243bbc8e59",
                                        "glosses": [
                                            "Having more than one element, part, component, or function, having more than one instance, occurring more than once, usually contrary to expectations (can be followed by a singular).",
                                            "Of a person: displaying or experiencing two or more distinct personalities or selves in one body."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e810bd2a-f8a1-4521-8677-360862381c9f",
                                                "sense_id": "22cfdb3b-1515-33ba-a48b-6249f3399007",
                                                "text": "While being multiple can cause complexity to people’s lives, as will be highlighted below, all respondents noted that they would not want to change their experiences of being multiple."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "multiple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27dfbe96-b2aa-3ee8-8712-eded86f7f939",
                                        "entry_id": "b2022f44-616a-378e-891d-d6587c031c7c",
                                        "glosses": [
                                            "A whole number that is obtained by multiplying a specific whole number by another whole number."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87d8bd9f-a9d9-47d8-85ae-e73e75975923",
                                                "sense_id": "27dfbe96-b2aa-3ee8-8712-eded86f7f939",
                                                "text": "14, 21 and 70 are multiples of 7"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f27cf92-a745-39f7-875e-56f3487c6b5b",
                                        "entry_id": "b2022f44-616a-378e-891d-d6587c031c7c",
                                        "glosses": [
                                            "Price-earnings ratio."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28e355c9-bc44-3223-9dd5-faf750bcf0d2",
                                        "entry_id": "b2022f44-616a-378e-891d-d6587c031c7c",
                                        "glosses": [
                                            "One of a set of the same thing; a duplicate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afecae67-cb05-40d0-a67f-d955f0d572f6",
                                                "sense_id": "28e355c9-bc44-3223-9dd5-faf750bcf0d2",
                                                "text": "One might view this attempt to ensure the scarcity of a multiple as both a marketing ploy and form of elitism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67b456bc-867f-3a43-b232-d3bc77f6d172",
                                        "entry_id": "b2022f44-616a-378e-891d-d6587c031c7c",
                                        "glosses": [
                                            "A single individual who displays or experiences multiple personalities or selves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89483fc6-4f84-43f6-8e7c-3cd502c2fd01",
                                                "sense_id": "67b456bc-867f-3a43-b232-d3bc77f6d172",
                                                "text": "I had seen its first show when it was a freebie, but I thought it made multiples in general look silly – no one changes clothes THAT much!"
                                            },
                                            {
                                                "example_id": "ac8016d1-8e28-4ebb-9b68-b7ec847fcc7f",
                                                "sense_id": "67b456bc-867f-3a43-b232-d3bc77f6d172",
                                                "text": "Non-abused multiples have no need of doctors, and they have carved out a foothold of their own from where they speak confidently about their utopian vision of a multiple world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94289143-6e39-399f-84e2-fa0a0b92f498",
                                        "entry_id": "b2022f44-616a-378e-891d-d6587c031c7c",
                                        "glosses": [
                                            "One of a set of siblings produced by a multiple birth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "542688a8-18d0-3961-9c32-ed031023d427",
                                        "entry_id": "b2022f44-616a-378e-891d-d6587c031c7c",
                                        "glosses": [
                                            "A chain store."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2592d6dd-d6a4-445c-be81-08daf63dd54a",
                                                "sense_id": "542688a8-18d0-3961-9c32-ed031023d427",
                                                "text": "The big advantage such multiples can offer over a purely catalogue operation is that winners can be given shopping vouchers enabling them to choose from goods on display in the multiples' many outlets (Woolworths, for example, has 1,000)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47d31503-f917-3edc-9f95-5bde7b00ff67",
                                        "entry_id": "b2022f44-616a-378e-891d-d6587c031c7c",
                                        "glosses": [
                                            "A discovery resulting from the work of many people throughout history, not merely the work of the person who makes the final connection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9a407c6-1b5c-4242-889d-c0b24359202f",
                                                "sense_id": "47d31503-f917-3edc-9f95-5bde7b00ff67",
                                                "text": "Merton's argument that all scientific discoveries are multiples would seem to contradict the theory of genius […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d5253b1-e265-393e-bf58-e92279313a0b",
                                        "entry_id": "b2022f44-616a-378e-891d-d6587c031c7c",
                                        "glosses": [
                                            "More than one piercing in a single ear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6736639d-e83a-4c40-88ab-8fe581ee8b10",
                                                "sense_id": "3d5253b1-e265-393e-bf58-e92279313a0b",
                                                "text": "First of all, the 'greenhorn' stigma of piercing has worn off. The older woman sees her daughter wearing multiples. So she's confident enough to have her ears pierced at least once."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
