                                "target_word": "icositetrachoron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59fdc1ca-5717-375c-9dce-551360b1311f",
                                        "entry_id": "e60af360-9e1d-360b-be17-7a1b1e8293e8",
                                        "glosses": [
                                            "A four-dimensional object with no regular three-dimensional analogue, constructed out of twenty-four octahedra."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2530ceb7-a263-4667-8799-298f230bcf0e",
                                                "sense_id": "59fdc1ca-5717-375c-9dce-551360b1311f",
                                                "text": "There are six convex regular 4-polytopes; five of these are the higher dimensional analogs of the Platonic solids, and one additional figure, the icositetrachoron, has no three-dimensional equivalent."
                                            },
                                            {
                                                "example_id": "dc9aa49f-f3ff-44a1-9ecc-b84b8948cbd2",
                                                "sense_id": "59fdc1ca-5717-375c-9dce-551360b1311f",
                                                "text": "The icositetrachoron (hyperdiamond, octaplex or 24-cell) is the most unique polychoron, because it has no direct analog in any other dimension."
                                            },
                                            {
                                                "example_id": "28cb5000-36ba-4de9-95d3-a5ce0e46ca6b",
                                                "sense_id": "59fdc1ca-5717-375c-9dce-551360b1311f",
                                                "text": "Shape of Nature comes from a unique, optimally symmetric geometric object: the sixth platonic element, the icositetrachoron (or 24-cell regular polytope), crystallized as a hyperdiamond network, mathematically and physically made of loops and connections."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
