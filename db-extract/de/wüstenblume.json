                ],
                "senses": [
                    {
                        "sense_id": "08aa0681-994e-316d-afa6-31d16f2fa64f",
                        "entry_id": "7d201b7b-a380-3627-bde6-80ebcf03ff35",
                        "glosses": [
                            "Blume, die in der Wüste wächst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8434fc8-2ab1-4c27-96c7-dfa2183fb880",
                                "sense_id": "08aa0681-994e-316d-afa6-31d16f2fa64f",
                                "text": "„Behutsame Farbveränderungen fanden sich in der Schwärze der Nächte und der Helligkeit der Tage und in den kräftigen Farben der winzigen Wüstenblumen, die sich in den staubigen Sträuchern versteckten, sowie den gleitenden Schlangen und huschenden Echsen, wenn sie sich im Sand eingruben.“"
                            },
                            {
                                "example_id": "9eb67cd1-484d-4758-857e-1dc5a4f84300",
                                "sense_id": "08aa0681-994e-316d-afa6-31d16f2fa64f",
                                "text": "„Der zusätzlich mit Steinen beladene Karren ruckelte übers Gefels, gezogen von Männern mit Stricken an Fußknöcheln und Stirn, begleitet von Frauen, die kleine Wüstenblumen, Sotolfackeln oder schlichte Laternen aus gelochtem Blech in den gefalteten Händen trugen.“"
                            },
                            {
                                "example_id": "7701ba28-a670-4f91-8409-d6b69ec284f5",
                                "sense_id": "08aa0681-994e-316d-afa6-31d16f2fa64f",
                                "text": "„Er brachte ihr Wüstenblumen an den Wohnwagen, ritt lange mit ihr aus, nannte sie stets ›Ma’am‹, nur nicht im Bett, und eines Nachmittags sprangen sie in seinen Pick-up, fuhren nach Vegas und heirateten dort in einer kitschigen kleinen Kapelle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
