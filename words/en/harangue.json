                        "furious harangue"
                    ]
                },
                {
                    "sense_id": "2db8b242-3139-3fbd-9765-a522c789e91a",
                    "sense_definition": "An impassioned and disputatious public speech delivered before an audience.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "speech_criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The political activist delivered an emotional <w>harangue</w> to the crowd gathered in the main square."
                        },
                        {
                            "text": "The senator ended his fiery <w>harangue</w> with an urgent appeal for systemic reform."
                        }
                    ],
                    "synonyms": [
                        "jeremiad",
                        "philippic"
                    ],
                    "common_phrases": [
