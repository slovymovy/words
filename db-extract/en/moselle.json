                        "glosses": [
                            "A department of Grand Est, France."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de3d700f-0038-4e1f-bd21-ec9b0db7b2e8",
