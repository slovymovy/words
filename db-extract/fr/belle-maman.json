            {
                "entry_id": "0dd833bb-7a6c-330a-b835-f23bd34005d1",
                "word": "belle-maman",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cd511cc2-5540-353a-a60b-4f2621c8bc65",
                        "entry_id": "0dd833bb-7a6c-330a-b835-f23bd34005d1",
                        "glosses": [
                            "Appellation affectueuse (ou ironique) pour la belle-mère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b2daae9-52a7-4a08-b5c9-af6891d97b60",
                                "sense_id": "cd511cc2-5540-353a-a60b-4f2621c8bc65",
                                "text": "Pour embarrasser sa belle-maman, avec cette ruse vicieuse qui était le trait dominant de son caractère, il lui demandait des détails sur les filles, en feignant de les prendre pour des femmes du vrai monde."
                            },
                            {
                                "example_id": "6f402bfa-88ea-4e4c-abe3-791e21cb50a4",
                                "sense_id": "cd511cc2-5540-353a-a60b-4f2621c8bc65",
                                "text": "Après un gigot flageolets avalé chez belle-maman, qu'il appelle « ma mère », monsieur met à profit l'après-midi dominical pour s'immerger dans la comptabilité familiale."
                            },
                            {
                                "example_id": "5b843580-0150-41d3-9793-bed4055b835a",
                                "sense_id": "cd511cc2-5540-353a-a60b-4f2621c8bc65",
                                "text": "Nous venions juste d'annoncer la nouvelle à Belle-Maman, un premier novembre, jour des Morts où l'on avait fait la tournée des cimetières, boulevards des allongés, en choisissant un prénom sur des pierres tombales."
                            }
                        ]
                    }
                ],
