        "fr-extract.jsonl": [
            {
                "entry_id": "94f8a921-4d5e-31cd-a0b3-1c80e85c67f6",
                "word": "calembredaine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4c487415-c289-4540-b495-564e9fcdfa59",
                        "entry_id": "94f8a921-4d5e-31cd-a0b3-1c80e85c67f6",
                        "tags": [
                            "plural"
                        ],
                        "form": "calembredaines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "db150443-ff91-3a11-870e-c7607ee94783",
                        "entry_id": "94f8a921-4d5e-31cd-a0b3-1c80e85c67f6",
                        "glosses": [
                            "Bourde, vains propos, faux-fuyant, sornette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d3edd0c-6177-4e4a-8de8-31cab1c99861",
                                "sense_id": "db150443-ff91-3a11-870e-c7607ee94783",
                                "text": "Ces calembredaines assommaient Frédéric."
                            },
                            {
                                "example_id": "21eafe58-11a9-4a95-8d11-210576fc80ea",
                                "sense_id": "db150443-ff91-3a11-870e-c7607ee94783",
                                "text": "Le peintre qui siégeait aux stalles en bas, et l’étudiant en vareuse rouge qui nichait en haut, au poulailler, s’égosillèrent de plus belle, en lazzis et en calembredaines."
                            },
                            {
                                "example_id": "e660775c-a52f-440a-9e63-438d60101b99",
                                "sense_id": "db150443-ff91-3a11-870e-c7607ee94783",
                                "text": "Aussi on l’aimait et, les jours de réjouissance, nombreux étaient les compères qui se pressaient autour de lui, heureux d’entendre ses calembredaines, ses histoires, ses drôleries, les provoquant au besoin, et le ramenant, sans en avoir l’air, aux sujets de conversations qu’il préférait. Ou bien ils commentaient ses récits d’un petit clignement d’yeux à l’adresse de la société, comme pour en faire valoir la saveur, toute la verve rare et puissante."
                            },
                            {
                                "example_id": "b19bc686-22b2-4b3f-b6cd-4228090c1df9",
                                "sense_id": "db150443-ff91-3a11-870e-c7607ee94783",
                                "text": "— Quand je vous disais qu’on ne peut pas garder son sérieux avec lui, dit Mme Verdurin à Forcheville. Au moment où on s’y attend le moins, il vous sort une calembredaine."
                            },
                            {
                                "example_id": "37c0e2c9-6476-496d-a47e-b10e7f2f2097",
                                "sense_id": "db150443-ff91-3a11-870e-c7607ee94783",
                                "text": "Et pendant que ce crétin chamarré dit des calembredaines aux femmes, savez-vous ce qui se passe à Dublin ?"
                            },
                            {
                                "example_id": "84ba9966-99c7-444a-a8ee-7362d4a40449",
                                "sense_id": "db150443-ff91-3a11-870e-c7607ee94783",
                                "text": "C’est avec de telles calembredaines que les prêtres s’imaginent piper la confiance des enfants à l’âge où, précisément, ils commencent à discerner qu’ils n’ont pas poussé dans les choux."
                            },
                            {
                                "example_id": "aef4659a-ed8d-4eda-a9d0-d6c0925505d8",
                                "sense_id": "db150443-ff91-3a11-870e-c7607ee94783",
                                "text": "Je me suis moi-même diverti, moins des calembredaines qui ont traîné les rues et dont beaucoup furent inventées, que des historiettes qui me furent contées par des témoins auriculaires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "896da5d0-b91b-4e8c-b663-bdfbabf12dcc",
                        "source_entry_id": "94f8a921-4d5e-31cd-a0b3-1c80e85c67f6",
                        "source_sense_id": "db150443-ff91-3a11-870e-c7607ee94783",
                        "source_sense_description": "Sornette",
                        "target_lang_word": "hogwash",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hogwash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bde39c3-4413-33df-81f9-f699a1e69df8",
                                        "entry_id": "93daf8d0-e694-3736-b211-4ca0c52fbdcc",
                                        "glosses": [
                                            "Foolish talk or writing; nonsense."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20f9d8ff-c5eb-4d3c-9eb9-c3f32807fb19",
                                                "sense_id": "8bde39c3-4413-33df-81f9-f699a1e69df8",
                                                "text": "We have more faith in the average American than that. It’s not true that Americans love hogwash— it’s that hogwash inundates Americans, whether they want it or not! Some Americans want the truth— they just haven’t been able to find it because it is drowned out by hogwash."
                                            },
                                            {
                                                "example_id": "9cb40ffa-1af0-47d5-82db-c1c706e94ab4",
                                                "sense_id": "8bde39c3-4413-33df-81f9-f699a1e69df8",
                                                "text": "Diplomatic hogwash aside, ‘efficiency and effectiveness’ have nothing to do with the shutting of the Consulate. The decision is but a continuation of successive US measures aimed at “taking Jerusalem off the table” – as per Trump’s own words - of any future negotiations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b966560c-4667-3c05-89bc-b0893ef62660",
                                        "entry_id": "93daf8d0-e694-3736-b211-4ca0c52fbdcc",
                                        "glosses": [
                                            "A mixture of solid and liquid food scraps fed to pigs; swill."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e45a6a7d-8fca-46db-a2c5-d826a980b306",
                        "source_entry_id": "94f8a921-4d5e-31cd-a0b3-1c80e85c67f6",
                        "source_sense_id": "db150443-ff91-3a11-870e-c7607ee94783",
                        "source_sense_description": "Sornette",
                        "target_lang_word": "twaddle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "twaddle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                        "entry_id": "29704ed7-2ab5-36ea-b81a-037408cd321b",
                                        "glosses": [
                                            "Empty or silly idle talk or writing; nonsense, rubbish."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04c6d97c-9ef2-4685-aad9-136266240963",
                                                "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                                "text": "You're talking a load of twaddle. Get your facts straight, man!"
                                            },
                                            {
                                                "example_id": "ca87bb01-20fb-41b1-8a3e-77539214a92c",
                                                "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                                "text": "\"What ineffable twaddle!\" I cried, slapping the magazine down on the table; \"I never read such rubbish in my life.\""
                                            },
                                            {
                                                "example_id": "e6dd98eb-0953-479f-9298-ae517b816273",
                                                "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                                "text": "I would rather be rude than to listen to twaddle from a man I’ve known."
                                            },
                                            {
                                                "example_id": "f834bbe0-13d3-489d-bef1-0d2aba51677f",
                                                "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                                "text": "It was her other self who had written that letter. It not only bored, it rather disgusted her real self. \"Flippant and silly,\" said her real self. Yet she knew that she'd send it and she'd always write that kind of twaddle to Nan Pym."
                                            },
                                            {
                                                "example_id": "12949f06-1ab1-4bc4-87c1-99fcf75c6a8c",
                                                "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                                "text": "I improvised for three or four minutes, speaking complete twaddle in character."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85ca7b9f-92b1-38c8-bfbc-df1bbe47b3aa",
                                        "entry_id": "29704ed7-2ab5-36ea-b81a-037408cd321b",
                                        "glosses": [
                                            "One who twaddles; a twaddler."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "twaddle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "342e586c-4a0f-3ca2-9c86-2f0601a1275f",
                                        "entry_id": "8b75e73d-354c-3d2b-b86b-71cae2344415",
                                        "glosses": [
                                            "To talk or write nonsense; to prattle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4ff4a32-5ae8-425a-bfef-b30f4fed617e",
                                                "sense_id": "342e586c-4a0f-3ca2-9c86-2f0601a1275f",
                                                "text": "To Edward […] he was terrible, nerve-inflaming, poisonously asphyxiating. He sat rocking himself in the late Mr. Churchill's swing chair, smoking and twaddling."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
