{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d7b00db6-a6fe-36a8-9b69-f541909f3ffd",
                    "sense_definition": "A net-like structure made of sticky silk strands produced by a spider to catch prey.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "spiderweb_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I walked into the dark room and walked right into a sticky <w>spiderweb</w>.",
                            "target_lang_translations": {
                                "de": "Ich betrat den dunklen Raum und lief direkt in ein klebriges <w>Spinnennetz</w>."
                            }
                        },
                        {
                            "text": "The morning dew sparkled on the delicate <w>spiderweb</w> outside the window.",
                            "target_lang_translations": {
                                "de": "Der Morgentau glitzerte auf dem zarten <w>Spinnennetz</w> vor dem Fenster."
                            }
                        }
                    ],
                    "synonyms": [
                        "cobweb",
                        "spider's web"
                    ],
                    "common_phrases": [
                        "sticky spiderweb",
                        "delicate spiderweb"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein netzartiges Gebilde aus klebrigen Seidenfäden, das von einer Spinne zum Fangen von Beute hergestellt wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Spinnennetz",
                                "target_lang_sense_clarification": "von Spinnen gewebtes Fangnetz"
                            },
                            {
                                "target_lang_word": "Spinnwebe",
                                "target_lang_sense_clarification": "Spinnengewebe, oft auch im Haus oder verstaubt"
                            },
                            {
                                "target_lang_word": "Spinngewebe",
                                "target_lang_sense_clarification": "netzartiges Gewebe einer Spinne"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63fb5940-64a1-3671-9eb7-ec485f706c38",
                    "sense_definition": "Something that resembles a spider's web, especially in being intricate, fragile, or entrapping.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "spiderweb_network",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The investigators uncovered a vast <w>spiderweb</w> of corruption spanning multiple agencies.",
                            "target_lang_translations": {
                                "de": "Die Ermittler deckten ein riesiges <w>Geflecht</w> aus Korruption auf, das mehrere Behörden umfasste."
                            }
                        },
                        {
                            "text": "A complex <w>spiderweb</w> of narrow streets filled the historic center of the city.",
                            "target_lang_translations": {
                                "de": "Ein komplexes <w>Netz</w> aus engen Gassen durchzog das historische Zentrum der Stadt."
                            }
                        }
                    ],
                    "synonyms": [
                        "network",
                        "tangle",
                        "web"
                    ],
                    "common_phrases": [
                        "spiderweb of lies",
                        "spiderweb of cracks"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas, das einem Spinnennetz ähnelt, insbesondere dadurch, dass es verschlungen, zerbrechlich oder verstrickend ist."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Geflecht",
                                "target_lang_sense_clarification": "im übertragenen Sinne, komplexes Gefüge"
                            },
                            {
                                "target_lang_word": "Netz",
                                "target_lang_sense_clarification": "verzweigtes oder verstricktes Netzwerk"
                            },
                            {
                                "target_lang_word": "Spinnennetz",
                                "target_lang_sense_clarification": "metaphorisch für ein verzweigtes System"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "30beca7e-8b6d-394e-9f4a-4f364cbc6019",
                    "sense_definition": "To cover, mark, or spread across something with a pattern resembling spiderwebs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spiderweb_network",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cracks began to <w>spiderweb</w> across the windshield after the small rock struck it.",
                            "target_lang_translations": {
                                "de": "Nachdem der kleine Stein dagegen geprallt war, begannen sich Risse netzartig über die Windschutzscheibe zu <w>ziehen</w>."
                            }
                        },
                        {
                            "text": "Fine lines started to <w>spiderweb</w> over the antique porcelain vase.",
                            "target_lang_translations": {
                                "de": "Feine Linien begannen die antike Porzellanvase netzartig zu <w>überziehen</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spiderweb across"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas mit einem spinnennetzartigen Muster überziehen, bedecken oder sich netzartig darüber ausbreiten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sich netzartig ausbreiten",
                                "target_lang_sense_clarification": "feine Risse oder Linien bilden"
                            },
                            {
                                "target_lang_word": "überziehen",
                                "target_lang_sense_clarification": "mit feinen Rissen bedecken"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}