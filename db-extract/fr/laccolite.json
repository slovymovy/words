                        "glosses": [
                            "Masse de roches intrusives bombée à la partie supérieure, s’insinuant dans une série sédimentaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0ce9687-fbc8-46d3-be7d-490b39e2545b",
                                "sense_id": "9f15ac91-b8c6-3bc7-8da9-42dce5525ce2",
                                "text": "Les « tours » d’une altitude de près de 3000 mètres forment une couronne de dents minérales acérées, issues au miocène d’un soulèvement volcanique sous la couche sédimentaire (laccolite), puis sculptées par l’érosion glaciaire."
                            }
                        ]
                    }
