                "senses": [
                    {
                        "sense_id": "214720ec-ffcf-357a-8592-9c6cbbffe847",
                        "entry_id": "6298ea40-822f-319c-87b2-9a4113e52141",
                        "glosses": [
                            "80 jaren durend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e40928d-d193-4c25-868e-4fd944c4f1f4",
                                "sense_id": "214720ec-ffcf-357a-8592-9c6cbbffe847",
                                "text": "Gedurende dit tachtigjarig tijdperk werd er geen oorlog gevoerd."
                            },
                            {
                                "example_id": "8118b5ca-81b0-4d9c-88db-a1f6496ee1f9",
                                "sense_id": "214720ec-ffcf-357a-8592-9c6cbbffe847",
                                "text": "In zijn roman uit 1998, in het Nederlands verschenen onder de titel De zon van Breda, staat hij stil bij de Tachtigjarige Oorlog - de oorlog in de Nederlanden en frist hij het historische geheugen van zijn landgenoten op."
                            }
                        ]
                    },
                    {
                        "sense_id": "7cbce2da-f88e-351a-9db4-8dcc1ecbbdb4",
                        "entry_id": "6298ea40-822f-319c-87b2-9a4113e52141",
                        "glosses": [
                            "met de leeftijd van 80 jaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d2e7cb8-3c93-4e22-851a-6e7efe7a599e",
                                "sense_id": "7cbce2da-f88e-351a-9db4-8dcc1ecbbdb4",
                                "text": "Hoewel Johanna Borski twee van haar acht kinderen in de firma opnam, gunde ze hun geen enkele zakelijke bewegingsvrijheid. Alle transacties waren voorzien van haar handtekening en ze bleef tot op tachtigjarige leeftijd als eigenares compareren."
                            }
                        ]
                    }
