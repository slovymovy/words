                {
                    "sense_id": "7365435e-5e23-3ea1-a2d2-7174f9181d58",
                    "sense_definition": "het moment van overlijden of de overgang naar het einde van het leven",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "overlijden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij woonde in dat kleine huisje tot zijn <w>dood</w>.",
                            "target_lang_translations": {
                                "en": "He lived in that little cottage until his <w>death</w>.",
                                "ru": "Он жил в этом маленьком домике до самой <w>смерти</w>."
                            }
                        },
                        {
                            "text": "Na de <w>dood</w> van de koning volgde zijn dochter hem op.",
                            "target_lang_translations": {
                                "en": "After the <w>death</w> of the king, his daughter succeeded him.",
                                "ru": "После <w>смерти</w> короля ему наследовала его дочь."
                            }
                        }
                    ],
                    "synonyms": [
                        "overlijden",
                        "sterven",
                        "heengaan",
                        "verscheiden"
                    ],
                    "antonyms": [
                        "leven"
                    ],
                    "common_phrases": [
                        "tot de dood ons scheidt"
                    ],
                    "target_lang_definitions": {
                        "en": "the moment of passing or the transition to the end of life",
                        "ru": "момент смерти или переход к концу жизни"
                    },
