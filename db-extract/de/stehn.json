                    {
                        "sense_id": "a62eb17f-e3a9-3b2f-86be-9ef248fe5bbd",
                        "entry_id": "1914e1bb-2b31-3ad2-a778-4bc82a97a405",
                        "glosses": [
                            "stehen"
                        ],
