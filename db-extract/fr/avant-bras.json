        "fr-extract.jsonl": [
            {
                "entry_id": "7f4a9444-9e78-3e54-9170-5d85b5e1e5e6",
                "word": "avant-bras",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "11f8a29e-6d13-337e-83ef-9581595c10d2",
                        "entry_id": "7f4a9444-9e78-3e54-9170-5d85b5e1e5e6",
                        "glosses": [
                            "Partie du membre supérieur des humains entre le coude (qui la relie à l'arrière-bras ou bras strict) et le poignet (qui la relie à la main)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fbc51ce-e275-4dc1-a761-5d6abb8fadc6",
                                "sense_id": "11f8a29e-6d13-337e-83ef-9581595c10d2",
                                "text": "S’attendant à la paire de claques, prélude de la raclée, l’avant-bras déjà presque levé pour la parade habituelle, Camus en demeura un instant muet de stupéfaction."
                            },
                            {
                                "example_id": "77833280-4985-4213-89c6-006bd41d6812",
                                "sense_id": "11f8a29e-6d13-337e-83ef-9581595c10d2",
                                "text": "Les mouvements de flexion et d’extension de l’avant-bras sont gérés par plusieurs muscles dont le biceps (muscle fléchisseur) et le triceps (muscle extenseur)."
                            },
                            {
                                "example_id": "4d67564f-3af8-49a4-9365-230e5e89f5f5",
                                "sense_id": "11f8a29e-6d13-337e-83ef-9581595c10d2",
                                "text": "D’un autre côté, une forte pression sur l’avant-bras peut endolorer les parties, les priver pour le moment de la pronation et de la supination, quoiqu’il n'y ait pas fracture."
                            }
                        ]
                    },
                    {
                        "sense_id": "6dfec455-c9fb-3332-bd9f-3bdf5900a941",
                        "entry_id": "7f4a9444-9e78-3e54-9170-5d85b5e1e5e6",
                        "glosses": [
                            "Pièce d’armure qui couvre et protège l’avant-bras, articulée avec la cubitière et le gantelet."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6daf8aee-d62d-4334-b927-4df59b30a2f5",
                        "source_entry_id": "7f4a9444-9e78-3e54-9170-5d85b5e1e5e6",
                        "target_lang_word": "Unterarm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterarm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48bb71b3-090b-3f4b-8933-d95991dc0f55",
                                        "entry_id": "94cbf344-9225-3e21-932e-4eb18aeddbad",
                                        "glosses": [
                                            "Abschnitt des Armes zwischen Ellbogen und Hand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "221335e8-cbf9-4605-adc4-446d83d0b74d",
                                                "sense_id": "48bb71b3-090b-3f4b-8933-d95991dc0f55",
                                                "text": "Er hat sich am Unterarm leicht verletzt."
                                            },
                                            {
                                                "example_id": "e2b331e9-680e-4ef2-b62d-7db1d3d9737e",
                                                "sense_id": "48bb71b3-090b-3f4b-8933-d95991dc0f55",
                                                "text": "„Tóvó zählte eins, zwei, drei, und während sie seinen Unterarm festhielt, warf er seinen Oberkörper zurück, und ein deutliches Knackgeräusch bewies, dass der Arm wieder im Gelenk saß.“"
                                            },
                                            {
                                                "example_id": "85521862-6013-4bd5-9abd-bd8f8a8fdef7",
                                                "sense_id": "48bb71b3-090b-3f4b-8933-d95991dc0f55",
                                                "text": "„Er hatte Maria erblickt und hielt sie am Unterarm gepackt.“"
                                            },
                                            {
                                                "example_id": "27474491-bb24-474b-a77f-6e1502f1879d",
                                                "sense_id": "48bb71b3-090b-3f4b-8933-d95991dc0f55",
                                                "text": "„Er antwortete nicht, legte nur seine Hand auf ihren Unterarm, und sie zog den Arm nicht zurück.“"
                                            },
                                            {
                                                "example_id": "c9366972-6f0e-4127-a3c8-6b4324be7572",
                                                "sense_id": "48bb71b3-090b-3f4b-8933-d95991dc0f55",
                                                "text": "„Er nickt, trinkt einen Schluck und wischt sich mit dem Unterarm über den Mund.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac5a7bff-34d3-4d76-b0ab-f4c92ac83055",
