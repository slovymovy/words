                        "sense_id": "425c2dd7-347a-3b9f-892d-9560d4de8663",
                        "entry_id": "67617bb3-1826-310d-b62d-dc3decce6aca",
                        "glosses": [
                            "Zugehörigkeit zu einer kriminellen Gruppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d99e0c2-5aa3-4dbf-9e5a-165459cb2e62",
                                "sense_id": "425c2dd7-347a-3b9f-892d-9560d4de8663",
                                "text": "„Frei, ihr Vermächtnis als ausgebildete Schamanen anzutreten, trennten die Brüder sich leichten Herzens von ihren Baseballkappen und bunten Halstüchern, den roten und blauen Insignien ihrer vorgeblichen Bandenzugehörigkeit.“"
                            },
                            {
                                "example_id": "b6835b03-d5ad-4ea7-a8ad-85e016b6a308",
                                "sense_id": "425c2dd7-347a-3b9f-892d-9560d4de8663",
                                "text": "„Alle drei hatten wahrscheinlich ein Vorstrafenregister und auf ihre Bandenzugehörigkeit zurückzuführende kriminelle Kontakte, ein guter Ansatzpunkt für den Mann fürs Grobe im Team - falls Ellis Loew je einen fand.“"
                            }
                        ],
