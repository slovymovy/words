                    "sense_definition": "Stan fizyczny charakteryzujący się wysoką temperaturą lub odczucie przyjemnej temperatury.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "ciepło_fizyczne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W domu panuje przyjemne <w>ciepło</w> dzięki kominkowi.",
                            "target_lang_translations": {
                                "en": "There is a pleasant <w>warmth</w> in the house thanks to the fireplace.",
                                "ru": "В доме царит приятное <w>тепло</w> благодаря камину.",
                                "nl": "In huis heerst een aangename <w>warmte</w> dankzij de open haard.",
                                "de": "Im Haus herrscht dank des Kamins eine angenehme <w>Wärme</w>.",
                                "fr": "Il règne une agréable <w>chaleur</w> dans la maison grâce à la cheminée.",
                                "it": "In casa c'è un piacevole <w>calore</w> grazie al camino.",
                                "cs": "V domě panuje příjemné <w>teplo</w> díky krbu.",
                                "tr": "Şömine sayesinde evde hoş bir <w>sıcaklık</w> var.",
                                "es": "En la casa hay un agradable <w>calor</w> gracias a la chimenea.",
                                "zh": "多亏了壁炉，屋子里洋溢着惬意的<w>温暖</w>。"
                            }
                        },
                        {
                            "text": "Słońce daje nam <w>ciepło</w> w letnie dni.",
                            "target_lang_translations": {
                                "en": "The sun gives us <w>warmth</w> on summer days.",
                                "ru": "Солнце дарит нам <w>тепло</w> в летние дни.",
                                "nl": "De zon geeft ons <w>warmte</w> op zomerdagen.",
                                "de": "Die Sonne schenkt uns an Sommertagen <w>Wärme</w>.",
                                "fr": "Le soleil nous apporte de la <w>chaleur</w> les jours d'été.",
                                "it": "Il sole ci dà <w>calore</w> nelle giornate estive.",
                                "cs": "Slunce nám v letních dnech dává <w>teplo</w>.",
                                "tr": "Güneş yaz günlerinde bize <w>ısı</w> verir.",
                                "es": "El sol nos da <w>calor</w> en los días de verano.",
                                "zh": "夏天太阳给我们带来<w>温暖</w>。"
                            }
                        }
