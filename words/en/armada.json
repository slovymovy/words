{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9bcb8b7a-8e6b-3e3a-8e23-e1ad16df340c",
                    "sense_definition": "A large fleet of warships.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "military_fleet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king assembled a mighty <w>armada</w> to protect the coastline from invasion.",
                            "target_lang_translations": {
                                "ru": "Король собрал могучую <w>армаду</w>, чтобы защитить побережье от вторжения."
                            }
                        },
                        {
                            "text": "Dozens of naval vessels formed an impressive <w>armada</w> in the bay.",
                            "target_lang_translations": {
                                "ru": "Десятки военных кораблей образовали в заливе внушительную <w>армаду</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "fleet",
                        "flotilla",
                        "squadron"
                    ],
                    "common_phrases": [
                        "naval armada",
                        "mighty armada"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупный военный флот кораблей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "армада",
                                "target_lang_sense_clarification": "большой военный морской флот"
                            },
                            {
                                "target_lang_word": "военно-морской флот",
                                "target_lang_sense_clarification": "крупное морское соединение кораблей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "132fec3b-7c18-3512-aab5-c895c33b42b9",
                    "sense_definition": "A large force or group of military vehicles, aircraft, or vessels.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "military_fleet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An <w>armada</w> of bombers crossed the border under cover of night.",
                            "target_lang_translations": {
                                "ru": "<w>Армада</w> бомбардировщиков пересекла границу под покровом ночи."
                            }
                        },
                        {
                            "text": "The invasion began when an <w>armada</w> of armored transports landed on the beach.",
                            "target_lang_translations": {
                                "ru": "Вторжение началось, когда <w>армада</w> бронированных транспортов высадилась на берег."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупное соединение военной техники (самолётов, танков, кораблей)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "армада",
                                "target_lang_sense_clarification": "большая группа военной техники"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "527272a4-cc80-31c1-9943-e597fe881cce",
                    "sense_definition": "A large, overwhelming gathering or crowd of things, animals, or people.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "large_gathering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An <w>armada</w> of insects attacked us every evening as soon as the sun set.",
                            "target_lang_translations": {
                                "ru": "<w>Полчища</w> насекомых атаковали нас каждый вечер, как только садилось солнце."
                            }
                        },
                        {
                            "text": "The celebrity was followed through the airport by an <w>armada</w> of reporters and photographers.",
                            "target_lang_translations": {
                                "ru": "За знаменитостью по аэропорту следовала целая <w>армада</w> репортёров и фотографов."
                            }
                        }
                    ],
                    "synonyms": [
                        "swarm",
                        "host",
                        "throng"
                    ],
                    "target_lang_definitions": {
                        "ru": "Огромное количество, масса или скопление людей, животных либо предметов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "армада",
                                "target_lang_sense_clarification": "огромная масса кого-либо или чего-либо"
                            },
                            {
                                "target_lang_word": "полчище",
                                "target_lang_sense_clarification": "о множестве людей или насекомых"
                            },
                            {
                                "target_lang_word": "туча",
                                "target_lang_sense_clarification": "огромное скопление, стая"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "aef0339e-b58f-3389-83f7-824f86b49a11",
                    "sense_definition": "The Spanish naval fleet sent in 1588 to invade England, which was famously defeated.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spanish_armada",
                    "name_type": "historical_name",
                    "examples": [
                        {
                            "text": "English ships successfully dispersed the Spanish <w>Armada</w> in the summer of 1588.",
                            "target_lang_translations": {
                                "ru": "Летом 1588 года английские корабли успешно разгромили испанскую <w>Армаду</w>."
                            }
                        },
                        {
                            "text": "Violent storms wrecked many ships of the retreating <w>Armada</w> along the Scottish coast.",
                            "target_lang_translations": {
                                "ru": "Жестокие штормы разбили множество кораблей отступающей <w>Армады</w> у побережья Шотландии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Spanish Armada"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испанский военный флот, отправленный в 1588 году для завоевания Англии и потерпевший сокрушительное поражение (Непобедимая армада)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Армада",
                                "target_lang_sense_clarification": "испанский флот 1588 года"
                            },
                            {
                                "target_lang_word": "Непобедимая армада",
                                "target_lang_sense_clarification": "историческое название флота"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdaddc58-b73c-3b41-9230-c4ff2620e083",
                    "sense_definition": "A village located in Macomb County, Michigan, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We drove through the peaceful village of <w>Armada</w> during our trip across Michigan.",
                            "target_lang_translations": {
                                "ru": "Во время нашей поездки по Мичигану мы проехали через тихую деревню <w>Армада</w>."
                            }
                        },
                        {
                            "text": "The annual county fair is held near the center of <w>Armada</w> every summer.",
                            "target_lang_translations": {
                                "ru": "Каждое лето недалеко от центра <w>Армады</w> проходит ежегодная окружная ярмарка."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревня в округе Макомб, штат Мичиган, США."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Армада",
                                "target_lang_sense_clarification": "населённый пункт в США"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}