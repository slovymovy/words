                                            },
                                            {
                                                "example_id": "c7deee01-3e50-455f-b633-6ee48059d5c2",
                                                "sense_id": "6d34f30d-ba7c-33e0-b0ef-852f4c2e0fb1",
                                                "text": "„Mit zehn galt er als musikalisches Wunderkind.“"
                                            },
                                            {
                                                "example_id": "ab517510-ce9a-4d72-8781-df25a94ed94d",
                                                "sense_id": "6d34f30d-ba7c-33e0-b0ef-852f4c2e0fb1",
                                                "text": "„Alf Bertini war zu einem mittelgroßen Jüngling herangewachsen, der sich nach wie vor für ein Wunderkind hielt.“"
                                            },
                                            {
                                                "example_id": "9a86d560-c264-4b60-b0ac-571c13bd7b55",
                                                "sense_id": "6d34f30d-ba7c-33e0-b0ef-852f4c2e0fb1",
                                                "text": "„Das Wunderkind Clara spielte den Gästen auf dem Klavier vor und beeindruckte dabei nicht nur Robert Schumann.“"
                                            },
                                            {
                                                "example_id": "3ffeb7c1-22fa-450b-a826-84efba03ebf8",
                                                "sense_id": "6d34f30d-ba7c-33e0-b0ef-852f4c2e0fb1",
                                                "text": "„Sein Ruf als Wunderkind blieb ihm lange erhalten, die Stadt Chemnitz erteilte ihm mit 17 gar einen öffentlichen Auftrag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
