                "senses": [
                    {
                        "sense_id": "670beaad-5844-372c-a060-2bc05e565bbb",
                        "entry_id": "cdcd8be9-b792-35b8-8450-944e6c3cb24d",
                        "glosses": [
                            "aus zusammengerolltem Teig mit Füllung bestehendes Gericht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b985555-a5a1-4010-8f96-b6b1993fb911",
                                "sense_id": "670beaad-5844-372c-a060-2bc05e565bbb",
                                "text": "„Dann wurden jiaozi serviert, kleine gefüllte Teigtaschen.“"
                            },
                            {
                                "example_id": "6ef4631e-9573-44ae-bc01-9e1970310c34",
                                "sense_id": "670beaad-5844-372c-a060-2bc05e565bbb",
                                "text": "„In Frankreich konnte man bei Drehorgelmusik die feine Lebensart Käse und Pastete mit einem Schlückchen Rotwein kosten, in Spanien war es Herzhaftes mit Oliven, in der Ukraine zum Beispiel leckere gefüllte Teigtaschen, ähnlich den deutschen Maultaschen.“"
                            },
                            {
                                "example_id": "b045b7af-9f3b-4c71-8910-2f61ba60d2cd",
                                "sense_id": "670beaad-5844-372c-a060-2bc05e565bbb",
                                "text": "„Die insgesamt vier größeren Schalen sind gefüllt mit Kartoffelhälften, Muscheln und Shrimps, Stockfischbällchen und Teigtaschen und Pica-Carne de porco á portuguêsa.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
