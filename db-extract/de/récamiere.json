                "senses": [
                    {
                        "sense_id": "fb810e7f-5f58-33d5-8d30-91710e75eaf4",
                        "entry_id": "a7b4a742-b12d-3f8b-b62f-79a0ca84879d",
                        "glosses": [
                            "sofaähnliches Sitz- und Liegemöbel, das keine vollständigen Rücken- und/oder Seitenlehnen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6449758b-e5c4-4ce7-8c0d-c4bcc93e8e93",
                                "sense_id": "fb810e7f-5f58-33d5-8d30-91710e75eaf4",
                                "text": "„Jacques-Louis David hat sie in seinem berühmten Gemälde, anmutig auf die Récamiere gelagert, verewigt.“"
                            },
                            {
                                "example_id": "dbae4c20-3622-48b8-8262-c4234976ae1a",
                                "sense_id": "fb810e7f-5f58-33d5-8d30-91710e75eaf4",
                                "text": "„In älteren Büchern waren Frauen nichts als Frauen, waren Töchter oder Schwestern oder Mündel und ersehnten den Richtigen in Landhäusern, Villen oder Sommerfrischen, auf Schaukelstühlen, Récamieren und Fauteuils, aber doch nicht auf einem Hocker am Fließband in der Fabrik.“"
                            }
                        ],
