                        "glosses": [
                            "Not pretty."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a9a50cb-a16b-4948-b53a-98cdab64b3d7",
                                "sense_id": "0a52fdea-5510-3b64-8e4d-5b418a44a231",
                                "text": "I wish I could tie you up in my shoes, / Make you feel unpretty too. / I was told I was beautiful / But what does that mean to you?"
                            },
                            {
                                "example_id": "dee0afe4-85be-4fb0-ba6d-a7eacd704556",
                                "sense_id": "0a52fdea-5510-3b64-8e4d-5b418a44a231",
                                "text": "It is bounded […] by Conduit Avenue, the unpretty highway that moves Brooklyn traffic to Kennedy International Airport."
                            }
                        ]
                    }
                ],
