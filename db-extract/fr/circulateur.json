                ],
                "senses": [
                    {
                        "sense_id": "7979390f-ddbc-3d45-850d-c5ca4876135b",
                        "entry_id": "b4b632fe-5937-39e4-9d2e-5d09b0763d9e",
                        "glosses": [
                            "Partisan de la circulation du sang, alors que cette découverte était controversée."
                        ],
                        "tags": [
                            "Histoire des sciences"
                        ],
                        "examples": [
                            {
                                "example_id": "c14bb888-d48d-49b5-9f46-fa7f48111fed",
                                "sense_id": "7979390f-ddbc-3d45-850d-c5ca4876135b",
                                "text": "J’ai, contre les circulateurs, soutenu une thèse…"
                            },
                            {
                                "example_id": "5c1f18a7-7ec5-48d4-97ef-5554914612f8",
                                "sense_id": "7979390f-ddbc-3d45-850d-c5ca4876135b",
                                "text": "Les circulateurs que cite Molière sont les personnes qui soutiennent les idées du médecin Harvey sur la circulation sanguine. Ceux qui sont contre ses idées sont appelés \"anti-circulateurs\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "a043ed46-9fdc-3afd-8737-08d60d1f5d20",
                        "entry_id": "b4b632fe-5937-39e4-9d2e-5d09b0763d9e",
                        "glosses": [
                            "Pompe qui active la circulation de l'eau ou de tout autre liquide caloporteur, dans le chauffage central."
                        ],
                        "tags": [
                            "Chauffage"
                        ],
                        "examples": [
                            {
                                "example_id": "493e9a28-549f-498a-90dc-1d9895309247",
                                "sense_id": "a043ed46-9fdc-3afd-8737-08d60d1f5d20",
                                "text": "Situé à la sortie de la chaudière, sur la conduite principale “départ eau chaude”, le circulateur est une petite pompe électrique à turbine qui tourne dans un carter doté d’une entrée et d’une sortie."
                            },
                            {
                                "example_id": "4a0fd463-937b-42c1-91a1-f242f16eda71",
                                "sense_id": "a043ed46-9fdc-3afd-8737-08d60d1f5d20",
                                "text": "Elle avait plusieurs commandes devant elle : un circulateur à changer chez le buraliste, un chauffe-eau à gaz qui frisait l’explosion à chaque allumage — ici, c’était le grand truc —, et une vidange qui refoulait, ici même, au café."
                            }
                        ]
                    }
