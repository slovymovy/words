                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De Nederlandse <w>achten</w> wonnen goud tijdens de internationale roeiwedstrijden.",
                            "target_lang_translations": {
                                "en": "The Dutch <w>eights</w> won gold during the international rowing competitions."
