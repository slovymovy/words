                "senses": [
                    {
                        "sense_id": "ad8d9d61-a225-3484-9f14-8784febad4d2",
                        "entry_id": "bfa1ef4e-0865-316e-b8cc-74ff0fb5f6f7",
                        "glosses": [
                            "bewohnbarer, mit Befestigungsanlagen umgebener Wachturm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6055322b-418f-40cc-bea7-b6521bb45305",
                                "sense_id": "ad8d9d61-a225-3484-9f14-8784febad4d2",
                                "text": "„Wie an der Lahnmündung in Niederlahnstein und bei Engers, so ließe sich auch hier zur Sicherung der Moselmündung ein Burgus mit Schutzhafen vermuten. Der Verdacht erhärtet sich, wenn man bedenkt, dass von einem Burgus an der Kastorkirche damals offensichtlich beide Burgi mit bloßem Auge zu erkennen waren und sich durch (Feuer-)Zeichen verständigen konnten.“"
                            },
                            {
                                "example_id": "75410ad5-a29c-40b9-8bfc-566f5c8e6a93",
                                "sense_id": "ad8d9d61-a225-3484-9f14-8784febad4d2",
                                "text": "„Auf dem Weg zum Burgus und an dem Burgus stehen Infotafeln mit der Geschichte der Anlage und des Ortes Ahegg.“"
                            },
                            {
                                "example_id": "fb41cf4d-7642-4d13-b9ec-31270f223e27",
                                "sense_id": "ad8d9d61-a225-3484-9f14-8784febad4d2",
                                "text": "„Der sogenannte \"Burgus\", ein Kleinkastell aus der Spätlimeszeit, gilt als besonderes Bauwerk, das in dieser Form nur noch in Nordafrika zu finden ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
