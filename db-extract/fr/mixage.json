                                                "example_id": "1808822a-efd3-4740-893f-f45373751e47",
                                                "sense_id": "339fbb06-c68a-3457-80cd-714c8044b186",
                                                "text": "De bevolking van Amsterdam is een mengeling van vele nationaliteiten."
                                            },
