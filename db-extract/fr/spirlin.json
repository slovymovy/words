                "forms": [
                    {
                        "form_id": "6e10e12c-15b6-4e07-8529-605db7517044",
                        "entry_id": "21b0953e-691c-345a-a02d-334bbc76efc7",
                        "tags": [
                            "plural"
                        ],
                        "form": "spirlins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f3d2c83-f6df-310d-9dd5-a37829f7eb0b",
                        "entry_id": "21b0953e-691c-345a-a02d-334bbc76efc7",
                        "glosses": [
                            "Autre nom de l’ablette de rivière, poisson de nom scientifique Alburnoides bipunctatus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ca112f6-fe3e-44a3-96e2-2f51afecd063",
                                "sense_id": "7f3d2c83-f6df-310d-9dd5-a37829f7eb0b",
                                "text": "Le spirlin est un cyprinidé de petite taille, comprise entre 10 et 15 cm, de poids moyen allant de 15 à 30 grammes et de morphologie située entre celle de l’ablette et la brème bordelière."
                            },
                            {
                                "example_id": "074ecb7f-a425-4dbe-9676-3b5ec8709c2d",
                                "sense_id": "7f3d2c83-f6df-310d-9dd5-a37829f7eb0b",
                                "text": "Le spirlin est présent en Europe, jusqu’à la mer Caspienne, mais n’atteint pas les provinces méridionales du continent."
                            },
                            {
                                "example_id": "4b19d86b-c124-4a02-95c3-58145b6090a7",
                                "sense_id": "7f3d2c83-f6df-310d-9dd5-a37829f7eb0b",
                                "text": "Des études ont permis de dimensionner cette rivière de contournement en fonction des espèces de poissons concernées par ces migrations (anguille, grande alose, lamproie marine, brochet, barbeau, hotu, vandoise et spirlin) et en fonction de l’utilisation touristique et de loisirs du Cher."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8919e6f1-c6ab-4809-b698-5b8dd2cc68c9",
                        "source_entry_id": "21b0953e-691c-345a-a02d-334bbc76efc7",
                        "source_sense_id": "7f3d2c83-f6df-310d-9dd5-a37829f7eb0b",
                        "target_lang_word": "Schneider",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schneider",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0896cb10-76d2-3773-873d-18e95612ba6d",
                                        "entry_id": "9cac1d9a-a4d7-39e4-928f-7fdec4652224",
                                        "glosses": [
                                            "meist selbstständiger Handwerker, Gewerbetreibender, der Kleidung anfertigt oder ändert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e233c5f-d473-41e5-b16a-f41750bd7b9d",
                                                "sense_id": "0896cb10-76d2-3773-873d-18e95612ba6d",
                                                "text": "Wer wird heute noch Schneider?"
                                            },
                                            {
                                                "example_id": "f8944b57-50e3-4986-ace1-fb1ec4f443be",
                                                "sense_id": "0896cb10-76d2-3773-873d-18e95612ba6d",
                                                "text": "„Der Mann meiner Schwester war Schneider, und sie schenkten mir gute Klamotten und behandelten mich mit großer Güte.“"
                                            },
                                            {
                                                "example_id": "f04011dc-9aec-45dc-8415-5e66bc848921",
                                                "sense_id": "0896cb10-76d2-3773-873d-18e95612ba6d",
                                                "text": "„Ein nicht mehr junger, aber wohlhabender Witwer hält um ihre Hand an, sie jedoch verweigert sich der Tradition einer vermittelten Heirat und gibt einem völlig mittellosen Schneider den Vorzug, der ihr nur ein Leben an der Armutsgrenze bieten kann.“"
                                            },
                                            {
                                                "example_id": "c3a15bfb-d256-41ab-92c6-a4ad79671f40",
                                                "sense_id": "0896cb10-76d2-3773-873d-18e95612ba6d",
                                                "text": "„Dieser Grund leuchtete ihm ein, und da er von seiner Stichhaltigkeit überzeugt war, sagte er mir, er sei reich, und ich müsse ihm ohne Hemmungen gestatten, mich zu einem Schneider zu führen.“"
                                            },
                                            {
                                                "example_id": "d2430d43-fb53-4f09-9aaf-d5636e625ba7",
                                                "sense_id": "0896cb10-76d2-3773-873d-18e95612ba6d",
                                                "text": "„Auf dem Heimweg schaute ich beim Schneider in der Vibes gate vorbei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c37bc286-a951-3bb7-bf2b-48c0420a8e56",
                                        "entry_id": "9cac1d9a-a4d7-39e4-928f-7fdec4652224",
                                        "glosses": [
                                            "ein Weißfisch (Alburnus bipunctatus), Schneiderfisch"
                                        ],
                                        "tags": [
                                            "auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2098632-aaa4-4b64-b8b7-461fbdacdc3f",
                                                "sense_id": "c37bc286-a951-3bb7-bf2b-48c0420a8e56",
                                                "text": "Zur Abwechslung hab ich heute einen Schneider gefangen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7f212d48-2e59-35eb-acb6-016b08a01649",
                                        "entry_id": "9cac1d9a-a4d7-39e4-928f-7fdec4652224",
                                        "glosses": [
                                            "Bezeichnung für mehrere dünne, langbeinige"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2272b15e-b71c-4bb9-a12c-114ecb4ea75d",
                                                "sense_id": "7f212d48-2e59-35eb-acb6-016b08a01649",
                                                "text": "Der große Fleck auf der Windschutzscheibe war wohl ein Schneider."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "5b2f0799-b2ad-3e66-84d7-139ab58d08ef",
                                        "entry_id": "9cac1d9a-a4d7-39e4-928f-7fdec4652224",
                                        "glosses": [
                                            "Bezeichnung für mehrere dünne, langbeinige",
                                            "wie Schnake (Tipulidae)"
                                        ],
                                        "tags": [
