                "senses": [
                    {
                        "sense_id": "1efcd9cf-b055-316a-888a-b578c11556ab",
                        "entry_id": "960ecd7d-ef57-3a8b-886e-e9bf69fc2bfc",
                        "glosses": [
                            "aus einer Blutprobe gewonnener Wert, der Leberschäden anzeigen soll"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "44480507-1942-4f87-8d69-ae09f36a76eb",
                                "sense_id": "1efcd9cf-b055-316a-888a-b578c11556ab",
                                "text": "„Weil viele Gerinnungsfaktoren in der Leber produziert werden, überprüfen die Ärzte die Funktion des Organs, aber die Leberwerte sind normal, und auch beim Ultraschall ist nichts Auffälliges zu sehen.“"
                            },
                            {
                                "example_id": "74f3a4c7-ca50-4049-aa6e-e417649830cf",
                                "sense_id": "1efcd9cf-b055-316a-888a-b578c11556ab",
                                "text": "„Ich habe Leberwerte wie ein junges Reh, aber miserable Gewissenswerte: Wenn man sich die Frage stellt, ob man weniger trinken sollte, hat man die Antwort schon gefunden, schätze ich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
