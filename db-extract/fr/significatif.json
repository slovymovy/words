                                "sense_id": "2c172620-163d-3e29-a8c8-6623f55a7015",
                                "text": "Il reste des obstacles significatifs à surmonter.",
                                "translation": "There are still significant obstacles to be overcome.",
                                "english": "There are still significant obstacles to be overcome."
                            },
                            {
                                "example_id": "121cc6dd-66cf-4a32-b345-a0ab5adda383",
                                "sense_id": "2c172620-163d-3e29-a8c8-6623f55a7015",
                                "text": "Il semblerait qu'il y ait des différences significatives entre les deux groupes.",
                                "translation": "It would seem that there are significant differences between the two groups.",
                                "english": "It would seem that there are significant differences between the two groups."
