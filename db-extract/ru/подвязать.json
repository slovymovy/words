                ],
                "senses": [
                    {
                        "sense_id": "95f305fd-e698-3e2f-a7fe-5cf608e8e521",
                        "entry_id": "e263f667-d7e1-37ba-93ae-8393aab05a22",
                        "glosses": [
                            "привязать под чем-нибудь или к чему-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d22518f4-68b1-4520-89ab-92b1e90d79f1",
                                "sense_id": "95f305fd-e698-3e2f-a7fe-5cf608e8e521",
                                "text": "Подвязать ведро под телегу. Подвязать к дуге колокольчик."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f72d19c-8eb4-34ea-a704-c194ceb75fc2",
                        "entry_id": "e263f667-d7e1-37ba-93ae-8393aab05a22",
                        "glosses": [
                            "связать или привязать с целью укрепить, предохранить от опускания, паденья"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d9ec25b-44f4-44ea-a4a4-f75098fdf12d",
                                "sense_id": "6f72d19c-8eb4-34ea-a704-c194ceb75fc2",
                                "text": "Подвязать ветки куста. Подвязать чулки шнурком. Подвязать ленты у чепца. Подвязать юбку."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9dd9606-c770-3513-88a7-ee1faef7a3e6",
                        "entry_id": "e263f667-d7e1-37ba-93ae-8393aab05a22",
                        "glosses": [
                            "укрепить на перевязи"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90e9bae7-106d-4d0d-9ea6-34f248ba4b39",
                                "sense_id": "e9dd9606-c770-3513-88a7-ee1faef7a3e6",
                                "text": "Подвязать руку."
                            }
                        ]
                    },
                    {
                        "sense_id": "34818ed4-ec72-311f-a3e5-0050c9782dbd",
                        "entry_id": "e263f667-d7e1-37ba-93ae-8393aab05a22",
                        "glosses": [
                            "повязать, обвязать снизу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c19cddc-9c13-4f76-8060-27478722aa0b",
                                "sense_id": "34818ed4-ec72-311f-a3e5-0050c9782dbd",
                                "text": "Подвязать щеку платком."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d62650a-9245-33a2-805d-065df57de612",
                        "entry_id": "e263f667-d7e1-37ba-93ae-8393aab05a22",
                        "glosses": [
                            "спец. повязать еще, продолжить вязанье; надвязать, прибавить еще к связанному, навязанному"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e3c12a4-1a40-4100-8b91-a9361e1b1367",
                                "sense_id": "6d62650a-9245-33a2-805d-065df57de612",
                                "text": "Подвязать подлиннее рукавицы. Подвязать леса."
                            }
                        ]
                    }
