                "senses": [
                    {
                        "sense_id": "dca8ad25-a99b-36ba-b588-849cc488dd40",
                        "entry_id": "5d89a613-4910-36e2-b3f6-1ccd24642bcf",
                        "glosses": [
                            "cecha tego, co jest niezawisłe; cecha tych, którzy są niezawiśli"
                        ],
                        "tags": [
                            "deadjectival"
                        ],
                        "examples": [
                            {
                                "example_id": "a1fff0c2-94f0-480b-b634-9d430d6b05f9",
                                "sense_id": "dca8ad25-a99b-36ba-b588-849cc488dd40",
                                "text": "…wszystko w demokratycznym państwie zależy od niezawisłości sędziowskiej. Sąd zawisły to nie jest sąd. Dodał: może użyję zbyt wielkich słów, ale niezawisłości sędziowskiej musimy strzec jak źrenicy oka"
                            },
                            {
                                "example_id": "f5d5d231-a248-47a2-a028-dd664773ba20",
                                "sense_id": "dca8ad25-a99b-36ba-b588-849cc488dd40",
                                "text": "Unijny Trybunał nie podzielił zarzutów sądu w Amsterdamie, który w pytaniach prejudycjalnych podważał niezawisłość wymiaru sprawiedliwości w Rzeczpospolitej."
                            }
                        ],
