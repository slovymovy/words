                "senses": [
                    {
                        "sense_id": "25c24e61-3e61-33c3-8cf0-4c9817639b1a",
                        "entry_id": "ade56909-f1bf-31c2-896a-6b9af1f21aa6",
                        "glosses": [
                            "Beeinträchtigung der Fähigkeit, ein- oder durchzuschlafen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7947cc2c-8d36-4909-8c54-abd45a98a955",
                                "sense_id": "25c24e61-3e61-33c3-8cf0-4c9817639b1a",
                                "text": "„Doch dann kamen die Schlafstörungen, die Alpträume und andere erschreckende Beschwerden.“"
                            },
                            {
                                "example_id": "623555eb-3295-4615-ad68-353b79e4f887",
                                "sense_id": "25c24e61-3e61-33c3-8cf0-4c9817639b1a",
                                "text": "„Josianne litt immer noch unter Schlafstörungen, Angel klagte über Fieber und Jacques sah blass und müde aus.“"
                            },
                            {
                                "example_id": "4b5a5133-6de8-4c46-b8f4-52674189076f",
                                "sense_id": "25c24e61-3e61-33c3-8cf0-4c9817639b1a",
                                "text": "„42 Prozent der Deutschen leiden an Schlafstörungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
