                    ]
                },
                {
                    "sense_id": "27a58be7-5111-3bb9-bfc8-02cafd91129c",
                    "sense_definition": "Ausführliche mündliche oder schriftliche Darlegung oder Erklärung eines Sachverhalts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "Erklärung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die interessierten Zuhörer konnten den detaillierten <w>Ausführungen</w> der Rednerin kaum folgen."
