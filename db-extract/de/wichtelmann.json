                "translations": [
                    {
                        "translation_id": "ae45229e-1ee6-4f0d-9770-1256a67ea39a",
                        "source_entry_id": "d16b07d4-b360-3d69-90e2-a2708124f9ff",
                        "source_sense_id": "c700f1fc-5e80-30aa-840c-e1a045cb3b00",
                        "source_sense_description": "Zwerg",
                        "target_lang_word": "dwarf",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dwarf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e9ee613-6e97-3086-a5d1-4fbc0be3a15d",
                                        "entry_id": "39e72e89-120f-3180-9369-c6fc222b4471",
                                        "glosses": [
                                            "Any member of a race of beings from (especially Scandinavian and other Germanic) folklore, usually depicted as having some sort of supernatural powers and being skilled in crafting and metalworking, often as short with long beards, and sometimes as clashing with elves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92a9e3c9-12ee-4d31-b74b-95066f96d4e5",
                                                "sense_id": "8e9ee613-6e97-3086-a5d1-4fbc0be3a15d",
                                                "text": "Nidavellir, which is sometimes called Svartalfheim, where the dwarfs (who are also known as dark elves) live beneath the mountains and build their remarkable creations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "306585d4-c525-3f57-a496-d615a52b609a",
                                        "entry_id": "39e72e89-120f-3180-9369-c6fc222b4471",
                                        "glosses": [
                                            "A person of short stature, often one whose limbs are disproportionately small in relation to the body as compared with typical adults, usually as the result of a genetic condition."
                                        ],
                                        "tags": [
                                            "offensive",
                                            "sometimes"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cef9fdbb-c50a-3231-8a2d-8daee02ab238",
                                        "entry_id": "39e72e89-120f-3180-9369-c6fc222b4471",
                                        "glosses": [
                                            "An animal, plant or other thing much smaller than the usual of its sort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb372b8f-6b22-4042-8086-55257baaf1d9",
                                                "sense_id": "cef9fdbb-c50a-3231-8a2d-8daee02ab238",
                                                "text": "dwarf tree"
                                            },
                                            {
                                                "example_id": "c279a5ee-32f2-4031-ba74-fee1cdff8bec",
                                                "sense_id": "cef9fdbb-c50a-3231-8a2d-8daee02ab238",
                                                "text": "dwarf honeysuckle"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebc453e2-5705-383a-80a4-1bede830f5e9",
                                        "entry_id": "39e72e89-120f-3180-9369-c6fc222b4471",
                                        "glosses": [
                                            "A dwarf star."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa3abd6c-cc67-4c7c-b4b9-3f2761c08a01",
                                                "sense_id": "ebc453e2-5705-383a-80a4-1bede830f5e9",
                                                "text": "But none of those brown dwarfs were speeding along on a trajectory that would carry them out of the galaxy like “runaway” hypervelocity stars observed by astronomers in the last two decades."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dwarf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c82aa017-ea62-3bb5-a86d-f7b7bbf63d45",
                                        "entry_id": "83c6ec98-9fd8-31d2-b21f-5d8a07f59bfd",
                                        "glosses": [
                                            "Miniature."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa24f5e9-88ce-457d-ae9e-1f10e47533e1",
                                                "sense_id": "c82aa017-ea62-3bb5-a86d-f7b7bbf63d45",
                                                "text": "The specimen is a very dwarf form of the plant."
                                            },
                                            {
                                                "example_id": "c5347dd4-bab3-462c-8c7b-2ee1abeff78d",
                                                "sense_id": "c82aa017-ea62-3bb5-a86d-f7b7bbf63d45",
                                                "text": "It is possible to grow the plants as dwarf as one desires."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dwarf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a2a2e9c-a29f-3901-b948-c227f222dc49",
                                        "entry_id": "2bb35784-5c78-33d9-976e-8f8858e7084c",
                                        "glosses": [
                                            "To render (much) smaller, turn into a dwarf (version)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0736dff5-8b4a-381b-85af-a17dacf6e0ad",
                                        "entry_id": "2bb35784-5c78-33d9-976e-8f8858e7084c",
                                        "glosses": [
                                            "To make appear (much) smaller, puny, tiny; to be much larger than."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f2a634b-343f-4e13-a4e5-40e22ef67f1f",
                                                "sense_id": "0736dff5-8b4a-381b-85af-a17dacf6e0ad",
                                                "text": "The newly-built skyscraper dwarfs all older buildings in the downtown skyline."
                                            },
                                            {
                                                "example_id": "a02d4e87-b2de-4261-bdeb-83ad07a2130d",
                                                "sense_id": "0736dff5-8b4a-381b-85af-a17dacf6e0ad",
                                                "text": "The train bursts from Rusher Cutting Tunnel with explosive violence, the engine's exhaust soaring high into the air, but dwarfed by the mighty limestone cliffs on either side."
                                            },
                                            {
                                                "example_id": "6fba0131-5716-41d6-ba65-dbad063aa767",
                                                "sense_id": "0736dff5-8b4a-381b-85af-a17dacf6e0ad",
                                                "text": "In the past two years, NASA’s Kepler Space Telescope has located nearly 3,000 exoplanet candidates ranging from sub-Earth-sized minions to gas giants that dwarf our own Jupiter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ee765c0-1921-3453-8d26-a043142743de",
                                        "entry_id": "2bb35784-5c78-33d9-976e-8f8858e7084c",
                                        "glosses": [
                                            "To make appear insignificant."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d76a3b4c-14f1-4d92-bdc3-18316b27edab",
                                                "sense_id": "4ee765c0-1921-3453-8d26-a043142743de",
                                                "text": "Bach dwarfs all other composers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3df98494-45a3-3389-bd09-cd437133d153",
                                        "entry_id": "2bb35784-5c78-33d9-976e-8f8858e7084c",
                                        "glosses": [
                                            "To become (much) smaller."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1feeb4f1-b700-37dd-b657-b318f1a032eb",
                                        "entry_id": "2bb35784-5c78-33d9-976e-8f8858e7084c",
                                        "glosses": [
                                            "To hinder from growing to the natural size; to make or keep small; to stunt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cd6903e-9b81-456c-971e-47d3421148d2",
                                                "sense_id": "1feeb4f1-b700-37dd-b657-b318f1a032eb",
                                                "text": "At present the whole sex is in a manner dwarfed and shrunk - into a race of beauties that seems almost another species"
                                            },
                                            {
                                                "example_id": "91325286-2626-4511-b373-790fa1930f45",
                                                "sense_id": "1feeb4f1-b700-37dd-b657-b318f1a032eb",
                                                "text": "Even the most common moral ideas and affections […] would be stunted and dwarfed, if cut off from a spiritual background."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68ddb81f-e961-4f6f-a163-5d3394cdd5c8",
                        "source_entry_id": "d16b07d4-b360-3d69-90e2-a2708124f9ff",
                        "source_sense_id": "c700f1fc-5e80-30aa-840c-e1a045cb3b00",
                        "source_sense_description": "Zwerg",
                        "target_lang_word": "wight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a0ec2b2-01a3-3b47-8dfe-6f8879135560",
                                        "entry_id": "bf085d6b-ebd3-36e8-98be-08d2d6e1403d",
                                        "glosses": [
                                            "A living creature, especially a human being."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b6d3ec0-7a11-46d0-a49c-f52e8a8aa972",
                                                "sense_id": "3a0ec2b2-01a3-3b47-8dfe-6f8879135560",
                                                "text": "He called Worsel, and, upon being informed that the recorders were ready, he started in. Characteristically, he began with Prellin of Bronseca, and memorized the data covering that wight as he transmitted it."
                                            },
                                            {
                                                "example_id": "651f31bf-8b8a-4f9e-9106-059c453d6bc5",
                                                "sense_id": "3a0ec2b2-01a3-3b47-8dfe-6f8879135560",
                                                "text": "O bace gongarian wight, wilt thou the ſpicket willd?"
                                            },
                                            {
                                                "example_id": "c0e96d16-02ff-4e86-a3d0-87399e8079d5",
                                                "sense_id": "3a0ec2b2-01a3-3b47-8dfe-6f8879135560",
                                                "text": "Oh ſay me true if thou wert mortal wight\nAnd why from us ſo quickly thou didſt take thy flight."
                                            },
                                            {
                                                "example_id": "faa120ac-5f27-4ec7-960c-09b73f559170",
                                                "sense_id": "3a0ec2b2-01a3-3b47-8dfe-6f8879135560",
                                                "text": "But woe betide the wandering wight, / That treads its circle in the night."
                                            },
                                            {
                                                "example_id": "7ed3beaa-3923-40b5-a7a8-be49ba0a0932",
                                                "sense_id": "3a0ec2b2-01a3-3b47-8dfe-6f8879135560",
                                                "text": "In this by-place of nature there abode, in a remote period of American history, that is to say, some thirty years since, a worthy wight of the name of Ichabod Crane, who sojourned, or, as he expressed it, \"tarried,\" in Sleepy Hollow, for the purpose of instructing the children of the vicinity."
                                            },
                                            {
                                                "example_id": "d78f4bb3-a563-4e19-aeca-49968e3a9703",
                                                "sense_id": "3a0ec2b2-01a3-3b47-8dfe-6f8879135560",
                                                "text": "Some gamesome wights will tell you that they have to plant weeds there, they don’t grow naturally; [...]"
                                            },
                                            {
                                                "example_id": "21749486-27d5-4d47-a1a2-e714387c8ced",
                                                "sense_id": "3a0ec2b2-01a3-3b47-8dfe-6f8879135560",
                                                "text": "\"Who is the miserable little wight?\" he asked. He was told her name and dignity."
                                            },
                                            {
                                                "example_id": "e1843e92-651a-4436-acd2-823ed452a1d2",
                                                "sense_id": "3a0ec2b2-01a3-3b47-8dfe-6f8879135560",
                                                "text": "The man that hath no love of chess/Is truth to say a sorry wight."
                                            },
                                            {
                                                "example_id": "8c8cfbd0-e225-4b35-ba02-e90adb20d80d",
                                                "sense_id": "3a0ec2b2-01a3-3b47-8dfe-6f8879135560",
                                                "text": "[…]Alaeddin ate and drank and was cheered and after he had rested and had recovered spirits he cried, \"Ah, O my mother, I have a sore grievance against thee for leaving me to that accursed wight who strave to compass my destruction and designed to take my life. Know thou that I beheld Death with mine own eyes at the hand of this damned wretch, whom thou didst certify to be my uncle;[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da177e37-bf85-3bc4-868d-0a057cfe38b8",
                                        "entry_id": "bf085d6b-ebd3-36e8-98be-08d2d6e1403d",
                                        "glosses": [
                                            "A supernatural being, often used in compounds such as the land-vættr which guard the land, especially the four guardians of Iceland."
                                        ],
                                        "tags": [
                                            "Germanic",
                                            "Old-Norse"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2f4f708-0e5f-3a5a-af11-df64fd4d47a4",
                                        "entry_id": "bf085d6b-ebd3-36e8-98be-08d2d6e1403d",
                                        "glosses": [
                                            "A ghost, deity or other supernatural entity."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db826d3f-dd0d-4267-9b42-dafdd22345a7",
                                                "sense_id": "c2f4f708-0e5f-3a5a-af11-df64fd4d47a4",
                                                "text": "But I saw a glow-worm near, / Who replied: ‘What wailing wight / Calls the watchman of the night?"
                                            },
                                            {
                                                "example_id": "ffe0ddbc-6060-4825-b4e5-4c7e22d5ce6a",
                                                "sense_id": "c2f4f708-0e5f-3a5a-af11-df64fd4d47a4",
                                                "text": "“In judging of that tempestuous wind called Euroclydon,” says an old writer—of whose works I possess the only copy extant—“it maketh a marvellous difference, whether thou lookest out at it from a glass window where the frost is all on the outside, or whether thou observest it from that sashless window, where the frost is on both sides, and of which the wight Death is the only glazier.”"
                                            },
                                            {
                                                "example_id": "6b734a9c-25e6-443a-8f93-4ee07b2af04b",
                                                "sense_id": "c2f4f708-0e5f-3a5a-af11-df64fd4d47a4",
                                                "text": "Everything in their way was kicked out of place, the barrow-wight setting on with hideous eagerness; Grettir gave back before him for a long time, till at last it came to this, that he saw it would not do to hoard his strength any more; now neither spared the other, and they were brought to where the horse-bones were, and thereabout they wrestled long."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc58a732-63cb-351b-878f-ae481e0a4318",
                                        "entry_id": "bf085d6b-ebd3-36e8-98be-08d2d6e1403d",
                                        "glosses": [
                                            "A wraith-like creature."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "wight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed365d1e-bbd5-3203-8eaa-75d73bbde3b9",
                                        "entry_id": "14a9fe8c-0b59-3eea-893d-3c266afaeb8c",
                                        "glosses": [
                                            "Brave, valorous, strong."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaa019ec-17e4-4dc1-9d0f-12d5e13f2a9d",
                                                "sense_id": "ed365d1e-bbd5-3203-8eaa-75d73bbde3b9",
                                                "text": "I haue two sones that were but late made knyghtes / and the eldest hyghte sir Tirre /[…]/ and my yongest sone hyght Lauayne / and yf hit please yow / he shalle ryde with yow vnto that Iustes / and he is of his age x stronge and wyght"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b3847ff-cf8b-3d38-8b74-c56f04c4f2df",
                                        "entry_id": "14a9fe8c-0b59-3eea-893d-3c266afaeb8c",
                                        "glosses": [
                                            "Strong; stout; active."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dialectal",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74f527d0-179e-4418-945a-9f270376b725",
                                                "sense_id": "3b3847ff-cf8b-3d38-8b74-c56f04c4f2df",
                                                "text": "Then spake Much the milner son, / Ever more well him betide! / ‘Take twelve of thy wight yeomen, / Well weapon’d by thy side. / Such one would thyselfë slon, / That twelve dare not abide.’"
                                            },
                                            {
                                                "example_id": "8f079b0f-82c6-4ccd-96d7-af7be0410bb5",
                                                "sense_id": "3b3847ff-cf8b-3d38-8b74-c56f04c4f2df",
                                                "text": "Ye do you to my father's stable, / Where steeds do stand baith wight and able; / Strike ane o' them upo' the back, / The swiftest will gie his head a wap."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
