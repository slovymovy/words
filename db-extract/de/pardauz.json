                        "entry_id": "a504d09b-38b0-3786-8bef-d9650e2995d9",
                        "glosses": [
                            "Said in surprise or confusion"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "6b1039ca-7941-4939-81bc-7eab95145151",
                                "sense_id": "1c8c7c81-0503-3b88-a657-a568339763fe",
                                "text": "„Pardauz!“ sagte das alte Mädchen. „Das ist sie. Man braucht nicht aufzusehen, um sich zu überzeugen, wer da hereingekommen ist.",
                                "translation": "The Magic Mountain",
                                "english": "The Magic Mountain"
                            }
                        ]
