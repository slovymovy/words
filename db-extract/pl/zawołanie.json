                "translations": [
                    {
                        "translation_id": "84201562-98b1-4bac-a843-88a56ae46085",
                        "source_entry_id": "c0b54e5b-c1ea-3a61-a55e-c57670a72494",
                        "source_sense_id": "f827853f-a80c-3568-8e1f-045e38e68126",
                        "target_lang_word": "cry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1dbeec7c-116a-3c95-bf01-a14ce23b6d3b",
                                        "entry_id": "cd868d2f-ff5a-3503-8f4b-6c90b29049c2",
                                        "glosses": [
                                            "To shed tears; to weep. Especially in anger or sadness"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dba94bd-2da1-4757-966b-fb92031cf9c7",
                                                "sense_id": "1dbeec7c-116a-3c95-bf01-a14ce23b6d3b",
                                                "text": "That sad movie always makes me cry."
                                            },
                                            {
                                                "example_id": "5e64c964-46fb-4563-b021-fbc15285c310",
                                                "sense_id": "1dbeec7c-116a-3c95-bf01-a14ce23b6d3b",
                                                "text": "- Emerl: “There’s nothing worse than making a girl cry!” That’s what Sonic said..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc0679dc-79d8-3704-a853-ca5688688f42",
                                        "entry_id": "cd868d2f-ff5a-3503-8f4b-6c90b29049c2",
                                        "glosses": [
                                            "To utter loudly; to call out; to declare publicly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6480b98e-f19a-47c7-b0cf-28846a391feb",
                                                "sense_id": "dc0679dc-79d8-3704-a853-ca5688688f42",
                                                "text": "All, all, cry shame against ye, yet I'll speak."
                                            },
                                            {
                                                "example_id": "491286ec-d54e-41bc-9d80-9c96a41f6eef",
                                                "sense_id": "dc0679dc-79d8-3704-a853-ca5688688f42",
                                                "text": "[T]he Man put his fingers in his Ears, and ran on crying, Life, Life, Eternal Life: [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcb5131d-5974-3d16-846c-1a37088ce107",
                                        "entry_id": "cd868d2f-ff5a-3503-8f4b-6c90b29049c2",
                                        "glosses": [
                                            "To shout, scream, yell."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a60b151b-2d71-4548-be8d-dca52f2fc1ff",
                                                "sense_id": "bcb5131d-5974-3d16-846c-1a37088ce107",
                                                "text": "And about the ninth hour, Jesus cried with a loud voice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c49039d6-55bd-31f7-a2fb-1286cb4b7ed4",
                                        "entry_id": "cd868d2f-ff5a-3503-8f4b-6c90b29049c2",
                                        "glosses": [
                                            "To forcefully attract attention or proclaim one’s presence."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5307e88e-c555-4487-9da6-38cb7c0adab9",
                                                "sense_id": "c49039d6-55bd-31f7-a2fb-1286cb4b7ed4",
                                                "text": "My secrets cry aloud.\nI have no need for tongue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67c62ffe-ade1-3acd-888d-5ee277a80f38",
                                        "entry_id": "cd868d2f-ff5a-3503-8f4b-6c90b29049c2",
                                        "glosses": [
                                            "To utter inarticulate sounds, as animals do."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a23580c-34ef-4cb4-8202-3f9f9d730ef1",
                                                "sense_id": "67c62ffe-ade1-3acd-888d-5ee277a80f38",
                                                "text": "the young ravens which cry"
                                            },
                                            {
                                                "example_id": "995a3572-e78f-4e59-927e-812b45a3de66",
                                                "sense_id": "67c62ffe-ade1-3acd-888d-5ee277a80f38",
                                                "text": "In a cowslip's bell I lie / There I couch when owls do cry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67cc9a82-2b85-399a-9a61-4272d9d96504",
                                        "entry_id": "cd868d2f-ff5a-3503-8f4b-6c90b29049c2",
                                        "glosses": [
                                            "To cause to do something, or bring to some state, by crying or weeping."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43a1b610-0595-4285-b94a-b118144dcd6d",
                                                "sense_id": "67cc9a82-2b85-399a-9a61-4272d9d96504",
                                                "text": "Tonight I’ll cry myself to sleep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a8f3716-7b20-37ee-8ec4-29e440f0fcb6",
                                        "entry_id": "cd868d2f-ff5a-3503-8f4b-6c90b29049c2",
                                        "glosses": [
                                            "To make oral and public proclamation of; to notify or advertise by outcry, especially things lost or found, goods to be sold, auctioned, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd043968-74a1-4940-8bbd-94904965f2ba",
                                                "sense_id": "6a8f3716-7b20-37ee-8ec4-29e440f0fcb6",
                                                "text": "to cry goods"
                                            },
                                            {
                                                "example_id": "f58fd409-d622-4d26-b6fb-451c1f4fb094",
                                                "sense_id": "6a8f3716-7b20-37ee-8ec4-29e440f0fcb6",
                                                "text": "Love is lost, and thus she cries him."
                                            },
                                            {
                                                "example_id": "469c479e-e54d-4ad5-b031-76aaef5a2c72",
                                                "sense_id": "6a8f3716-7b20-37ee-8ec4-29e440f0fcb6",
                                                "text": "“We're in luck. Loren Passerine, the finest auctioneer in the West, will be crying today.” “Will be what?” “We say an auctioneer ‘cries’ a sale,” Cohen said."
                                            },
                                            {
                                                "example_id": "7914f922-b669-4853-b986-71f6283be3a4",
                                                "sense_id": "6a8f3716-7b20-37ee-8ec4-29e440f0fcb6",
                                                "text": "Oh, Elcid Barrett cried the town / (How I wish I was in Sherbrooke now!) / For twenty brave men, all fishermen, who / Would make for him the Antelope's crew."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b430e4b-3c83-32b6-8c24-8fcf9260f0d9",
                                        "entry_id": "cd868d2f-ff5a-3503-8f4b-6c90b29049c2",
                                        "glosses": [
                                            "To make oral and public proclamation of; to notify or advertise by outcry, especially things lost or found, goods to be sold, auctioned, etc.",
                                            "Hence, to publish the banns of, as for marriage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37c71586-da9f-4ce7-8522-f17a41563f8f",
                                                "sense_id": "6b430e4b-3c83-32b6-8c24-8fcf9260f0d9",
                                                "text": "I should not be surprised if they were cried in church next Sabbath."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c35204c-cbe5-388d-b0ac-7d0001540d90",
                                        "entry_id": "df1195c7-cf2f-300c-8b0f-7ca63fbd65a0",
                                        "glosses": [
                                            "A shedding of tears; the act of crying."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1ac0037-31a3-44c5-8fe6-dec0721365fd",
                                                "sense_id": "3c35204c-cbe5-388d-b0ac-7d0001540d90",
                                                "text": "After we broke up, I retreated to my room for a good cry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bca53370-c457-3b90-9348-dd38ea4f7a03",
                                        "entry_id": "df1195c7-cf2f-300c-8b0f-7ca63fbd65a0",
