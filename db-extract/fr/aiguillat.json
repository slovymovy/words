                                "example_id": "b0269176-640a-4a76-af67-fa5e755dbd4e",
                                "sense_id": "2636d551-805e-3374-ba08-ef8a5a33081d",
                                "text": "La peau de l’aiguillat sert aux tourneurs pour polir leurs ouvrages."
                            },
                            {
                                "example_id": "61e427db-1476-4e22-8219-6f2c6821d9a2",
                                "sense_id": "2636d551-805e-3374-ba08-ef8a5a33081d",
                                "text": "Quant à Aristote, au cinquième livre des Parties des animaux, il dit que l'aiguillat et le notidane sont aussi des squales."
                            }
                        ]
