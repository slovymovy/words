                "translations": [
                    {
                        "translation_id": "a336bcd4-c8e9-464e-8677-661656dbf425",
                        "source_entry_id": "0de7947f-c925-373e-ab00-2292e15e28d7",
                        "source_sense_id": "18c971e1-7b3a-30d0-b0c2-28138b6af695",
                        "target_lang_word": "cutwater",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cutwater",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ab0b876-7991-35a1-8ce3-336162014532",
                                        "entry_id": "72796fec-c372-3bf0-aa77-f89382b72848",
                                        "glosses": [
                                            "The forward curve of the stem of a ship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc3eda48-9800-482d-92df-3c6cf1fce806",
                                                "sense_id": "9ab0b876-7991-35a1-8ce3-336162014532",
                                                "text": "For two hours we laboured, Mahomed, Job, and I, who was supposed to be strong enough to pull against the two of them, on the bank, while Leo sat in the bow of the boat, and brushed away the weeds which collected round the cutwater with Mahomed's sword."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35d6242a-d242-3e86-ac01-fe29190b2593",
                                        "entry_id": "72796fec-c372-3bf0-aa77-f89382b72848",
                                        "glosses": [
                                            "The wedge of a bridge pier, that resists the flow of water and ice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccd60e82-2a5d-48b6-a15d-49a975928b24",
                                                "sense_id": "35d6242a-d242-3e86-ac01-fe29190b2593",
                                                "text": "TARKA became one with the river, finding his course among the slimy stones so that his back was always covered. He rose beside the middle pier, whose cutwater was hidden by a faggot of flood sticks. Under the sticks was dimness, streaked and blurred with sunlight. Tarka hid and listened."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9307fa0f-891d-3b68-808c-00c47328b346",
                                        "entry_id": "72796fec-c372-3bf0-aa77-f89382b72848",
                                        "glosses": [
                                            "A black skimmer; a sea bird of the species Rynchops niger, that flies low over the sea, \\\"cutting\\\" the water surface with its lower mandible to catch small fish."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b768a20-2a03-4092-ad85-31123c507313",
                        "source_entry_id": "0de7947f-c925-373e-ab00-2292e15e28d7",
                        "source_sense_id": "18c971e1-7b3a-30d0-b0c2-28138b6af695",
