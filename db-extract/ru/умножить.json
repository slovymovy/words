                    }
                ],
                "senses": [
                    {
                        "sense_id": "7904b4f3-9ce1-3133-905b-15a05517a983",
                        "entry_id": "b5a90c81-4cfb-35e0-914b-cd5da6ec401d",
                        "glosses": [
                            "увеличить число или количество"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "278a03c2-e2ce-4771-a38e-d3a824790cf7",
                                "sense_id": "7904b4f3-9ce1-3133-905b-15a05517a983",
                                "text": "Это лишь умножит людские несчастья"
                            }
                        ]
                    },
                    {
                        "sense_id": "64f018dc-d5b2-3007-8f3a-3436e3da229e",
                        "entry_id": "b5a90c81-4cfb-35e0-914b-cd5da6ec401d",
                        "glosses": [
                            "матем. произвести арифметическую операцию умножения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e37ffb4c-035e-4586-95c9-d090f71034c4",
                                "sense_id": "64f018dc-d5b2-3007-8f3a-3436e3da229e",
                                "text": "Умножь это число на коэффициент."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0eb4dd2c-3cbd-4f74-b3c1-4c23cc8a7cb6",
                        "source_entry_id": "b5a90c81-4cfb-35e0-914b-cd5da6ec401d",
                        "source_sense_description": "арифм. операция",
                        "target_lang_word": "multiply",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multiply",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "084c486d-e41e-35cb-887c-bb97a58f6b92",
                                        "entry_id": "795600cc-63c4-3adc-998f-764cfa15c1fb",
                                        "glosses": [
                                            "To increase the amount, degree or number of (something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d72625e6-6e88-49e4-a99d-64ae1b2d94e5",
                                                "sense_id": "084c486d-e41e-35cb-887c-bb97a58f6b92",
                                                "text": "The motives to refuse obedience to government are many and strong ; impunity will multiply and enforce them"
                                            },
                                            {
                                                "example_id": "61e58ea2-c64a-4ab8-9bc3-bc7a8399e016",
                                                "sense_id": "084c486d-e41e-35cb-887c-bb97a58f6b92",
                                                "text": "It would indeed be easy to multiply modern authorities respecting locustal food; one more authority shall suffice, from which it will appear that the Arabs make a sort of locust bread."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1847a1bc-1eb6-3f23-b99b-d4903beb8a70",
                                        "entry_id": "795600cc-63c4-3adc-998f-764cfa15c1fb",
                                        "glosses": [
                                            "To perform multiplication on (a number)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eae7ecc1-989e-4e5d-a078-3f36943cab2b",
                                                "sense_id": "1847a1bc-1eb6-3f23-b99b-d4903beb8a70",
                                                "text": "when you multiply 3 by 7, you get 21; he multiplied several numbers"
                                            },
                                            {
                                                "example_id": "b749f34b-8d48-4f55-abd8-a832c65f8677",
                                                "sense_id": "1847a1bc-1eb6-3f23-b99b-d4903beb8a70",
                                                "text": "But that can be ignored, because the USTR has set ε at 4 and φ at 0.25, so when computed give an overall multiplier of 1 for the imports number. And multiplying by 1 makes no difference at all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c25e54de-4474-3430-a641-4bd7f2a7d6fc",
                                        "entry_id": "795600cc-63c4-3adc-998f-764cfa15c1fb",
                                        "glosses": [
                                            "To grow in number."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1c6b9fa-b7b6-3e9a-95ee-88665ace3af4",
                                        "entry_id": "795600cc-63c4-3adc-998f-764cfa15c1fb",
                                        "glosses": [
                                            "To breed or propagate."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dd46ead-fdf9-42e2-8a4b-eb890eb8e414",
                                                "sense_id": "b1c6b9fa-b7b6-3e9a-95ee-88665ace3af4",
                                                "text": "[The researchers] noticed many of their pieces of [plastic marine] debris sported surface pits around two microns across.[…]Closer examination showed that some of these pits did, indeed, contain bacteria, and that in several cases these bacteria were dividing and thus, by the perverse arithmetic of biological terminology, multiplying."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a07b6be7-7efd-36d9-bc43-966b346f4d8d",
                                        "entry_id": "795600cc-63c4-3adc-998f-764cfa15c1fb",
                                        "glosses": [
                                            "To perform multiplication."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66248255-355d-48d1-93f0-94071f2518a1",
                                                "sense_id": "a07b6be7-7efd-36d9-bc43-966b346f4d8d",
                                                "text": "He had been multiplying, but it occurred to him he needed to resolve the exponents, first."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26a97b88-5b3a-31c0-b6b7-2bfad48fc6f7",
                                        "entry_id": "795600cc-63c4-3adc-998f-764cfa15c1fb",
                                        "glosses": [
                                            "To be a factor in a multiplication with (another factor)."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ee17f1d-84e4-419c-a9a0-1c345868fba5",
                                                "sense_id": "26a97b88-5b3a-31c0-b6b7-2bfad48fc6f7",
                                                "text": "This follows a similar process, counters having to be removed and replaced at each stage of the remaining part of the calculation except the final one, where 2 multiplies 3 to give 6."
                                            },
                                            {
                                                "example_id": "3f18c4cf-d0f3-47ff-8bf4-1db1fb556d96",
                                                "sense_id": "26a97b88-5b3a-31c0-b6b7-2bfad48fc6f7",
                                                "text": "Of all the possible combinations of factors above, only (2#92;cdot4)#43;(3#92;cdot5)#61;23. Carefully arranging the factors, therefore, to ensure that 2 multiplies 4 and 3 multiplies 5, we have\n6x²#43;23x#43;20#61;(2x#43;5)(3x#43;4)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "multiply",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b5b6912-5be1-3912-ae7c-919d09ea070c",
                                        "entry_id": "06bb549e-e427-361c-bbb2-64f24b1f8c38",
                                        "glosses": [
                                            "An act or instance of multiplying."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e2c38ec-8180-45ac-8cab-8ba36149e369",
                                                "sense_id": "4b5b6912-5be1-3912-ae7c-919d09ea070c",
                                                "text": "The extended instruction set may double the speed again if a lot of multiplies and divides are done."
                                            },
                                            {
                                                "example_id": "89ede180-e6ac-4108-9983-79ddce2e46e7",
                                                "sense_id": "4b5b6912-5be1-3912-ae7c-919d09ea070c",
                                                "text": "List the number of adds and multiplies for each of the forms (6) , (7), and (8)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "multiply",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43904a73-ee4b-3c6f-bbbd-ae8f15e39822",
                                        "entry_id": "4abec900-69df-3301-a534-bd49721c479d",
                                        "glosses": [
                                            "In many or multiple ways."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52f5f6e6-494f-412d-8a41-de0186c3233c",
                        "source_entry_id": "b5a90c81-4cfb-35e0-914b-cd5da6ec401d",
                        "source_sense_description": "арифм. операция",
                        "target_lang_word": "multiplier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multiplier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc6aa95a-cb52-34a3-8a71-1e030b88c091",
                                        "entry_id": "f02fdf50-cd57-3bb3-9a6f-e50ce37c14a6",
                                        "glosses": [
                                            "Augmenter le nombre, la quantité des êtres ou des choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13391e3b-b351-4176-9e3d-9ec53816db56",
                                                "sense_id": "cc6aa95a-cb52-34a3-8a71-1e030b88c091",
                                                "text": "[…] en 1250, on voit encore les dominicains faire la chasse aux livres juifs. Tracasseries et saisies se multiplient. Aussi les écoles talmudiques se disloquent-elles."
                                            },
                                            {
                                                "example_id": "bf92d85f-ca30-4235-b7a7-6a002d9e8997",
                                                "sense_id": "cc6aa95a-cb52-34a3-8a71-1e030b88c091",
                                                "text": "En 1845, New York s’ébaudissait devant le squelette dHydrargos, « le grand serpent des mers », long de 34 mètres. Albert Koch, qui exhibait sous ce nom le cétacé fossile Basilosaurus, avait pris soin de l’allonger ''en multipliant ses vertèbres, et l’imposteur fit fortune."
                                            },
                                            {
                                                "example_id": "2365728d-4be7-4325-a35d-504c2d71f09b",
                                                "sense_id": "cc6aa95a-cb52-34a3-8a71-1e030b88c091",
                                                "text": "Les recherches portant sur l'apparition des premiers indices d’anthropisation et l’évolution du signal anthropique sur le territoire français se sont particulièrement multipliées au cours de ces dernières années […]."
                                            },
                                            {
                                                "example_id": "f9a80202-3f7e-4137-9614-d55413ce43a8",
                                                "sense_id": "cc6aa95a-cb52-34a3-8a71-1e030b88c091",
                                                "text": "Croulant sous le poids de charges trop lourdes pour son effectif squelettique, Mont-Mesly regrette de ne pouvoir multiplier à l’infini ses surveillances nocturnes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a8deddb-4ae1-34a4-bd6e-26f1e76b3523",
                                        "entry_id": "f02fdf50-cd57-3bb3-9a6f-e50ce37c14a6",
                                        "glosses": [
                                            "Faire en grand nombre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fed681f2-6047-469b-940c-b85878c463f6",
                                                "sense_id": "5a8deddb-4ae1-34a4-bd6e-26f1e76b3523",
                                                "text": "[…] et les libations en l'honneur du brave Coignet furent multipliées pendant toute l'après-midi. Le soir, on mangea la soupe à la jacobine; puis on vagua toute la nuit dans les promenades d'Auxerre."
                                            },
                                            {
                                                "example_id": "43e9b51d-a468-428f-8721-7b11702f5752",
                                                "sense_id": "5a8deddb-4ae1-34a4-bd6e-26f1e76b3523",
                                                "text": "Compte tenu des diverses possibilités de répartition des individus à l'intérieur de la population (6.121), cette condition impose de multiplier les échantillons dans les diverses parties de l'aire occupée par la population (casualisation)."
                                            },
                                            {
                                                "example_id": "1d411655-1e04-407c-a59b-e41816899f4a",
                                                "sense_id": "5a8deddb-4ae1-34a4-bd6e-26f1e76b3523",
                                                "text": "Il s'agit d'une organisation activiste, qui multiplie les opérations spectaculaires : commandos contre des fast-food halals, « apéros saucisson-pinard », ou manifestations musclées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e37d98a4-10ae-3a35-b3e3-fe9059455aaf",
                                        "entry_id": "f02fdf50-cd57-3bb3-9a6f-e50ce37c14a6",
                                        "glosses": [
                                            "Répéter un nombre autant de fois qu’il y a d’unités dans un autre nombre donné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d93e2436-7531-4684-a5d5-77512350e38a",
                                                "sense_id": "e37d98a4-10ae-3a35-b3e3-fe9059455aaf",
                                                "text": "À condition de cuber l’épandeur en multipliant la longueur par la largeur et par la hauteur du chargement pour connaître le volume de fumier qu’il contient, il est possible d’approcher le poids de fumier chargé de 2 façons."
                                            },
                                            {
                                                "example_id": "4c23a77c-1a54-4220-928a-4ea937c4824a",
                                                "sense_id": "e37d98a4-10ae-3a35-b3e3-fe9059455aaf",
                                                "text": "Si on multiplie 2 par 3 on obtient 6."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e02bcf0e-f2dd-3127-82b4-0125ba5a9540",
                                        "entry_id": "f02fdf50-cd57-3bb3-9a6f-e50ce37c14a6",
                                        "glosses": [
                                            "Augmenter en nombre par voie de génération."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f28caa6-ca00-4c9f-b788-46fcf86e1e4e",
                                                "sense_id": "e02bcf0e-f2dd-3127-82b4-0125ba5a9540",
                                                "text": "Malgré son excessive floribondité, elle donne rarement des graines, et on en est réduit à la multiplier de boutures et de couchages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df43c466-067a-39fc-aa71-824af8db5b4d",
                                        "entry_id": "f02fdf50-cd57-3bb3-9a6f-e50ce37c14a6",
                                        "glosses": [
                                            "Se reproduire."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd6e8a83-bdb8-42b4-bef0-57e85624ec5e",
                                                "sense_id": "df43c466-067a-39fc-aa71-824af8db5b4d",
                                                "text": "À l’abri du monopole et de la paix qui en résultait, les Groenlandais se multiplièrent et aujourd’hui, deux cents ans après l’arrivée de Hans Egede, ils sont au nombre de 15.000, […]."
                                            },
                                            {
                                                "example_id": "235a065f-563f-4eac-930e-03719042a2b7",
                                                "sense_id": "df43c466-067a-39fc-aa71-824af8db5b4d",
                                                "text": "L’échalote se multiplie de caïeux qui sont mis en terre dès le premier printemps, c'est-à-dire en février-mars. Ces caïeux doivent être bien formés et fermes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0bb73bf-17a1-3f81-8067-23fa84f9bcf2",
                                        "entry_id": "f02fdf50-cd57-3bb3-9a6f-e50ce37c14a6",
                                        "glosses": [
                                            "Mener plusieurs occupations simultanément, sembler être partout à la fois, en parlant de quelqu’un qui est fort actif."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e32fcde4-bcda-4b16-9a55-556afe55b999",
                                                "sense_id": "f0bb73bf-17a1-3f81-8067-23fa84f9bcf2",
                                                "text": "Et elle s’applique et se multiplie ; elle met beaucoup de temps à s’arranger, mais ce sont des heures importantes et non perdues."
                                            },
                                            {
                                                "example_id": "6408852b-c6ab-4808-81ba-73718332eca2",
                                                "sense_id": "f0bb73bf-17a1-3f81-8067-23fa84f9bcf2",
                                                "text": "Mais il se multiplia vainement, il ne pouvait se montrer partout, et les ennemis délinquaient partout à la fois."
                                            },
                                            {
                                                "example_id": "8dc4a7b0-2154-4802-ac51-e429d9d438a7",
                                                "sense_id": "f0bb73bf-17a1-3f81-8067-23fa84f9bcf2",
                                                "text": "Il prit aussi l’habitude des foires lointaines, se multiplia aux comités, aux associations qu’il présidait, s’ingénia à se créer des distractions nouvelles, des occupations éloignées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
