                "senses": [
                    {
                        "sense_id": "8634832d-6e55-3b84-8d27-d3fdea2e3450",
                        "entry_id": "8cb56651-da6c-380e-ab78-29cace769a89",
                        "glosses": [
                            "A painful inflammation of one or both testes."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9da56b6b-d0e4-4c9d-b992-3af12c98f9a3",
                                "sense_id": "8634832d-6e55-3b84-8d27-d3fdea2e3450",
                                "text": "It has been well studied, however, and helps to understand the evolution of other orchitises (197)."
                            },
                            {
                                "example_id": "e93b4c24-22e0-4dc1-ab65-ccb750578623",
                                "sense_id": "8634832d-6e55-3b84-8d27-d3fdea2e3450",
                                "text": "Avoid corticosteroids for mumps orchitis as they can reduce testosterone concentrations and increase testicular atrophy."
                            },
                            {
                                "example_id": "a4b12563-d47f-4060-b286-71160f7d7b22",
                                "sense_id": "8634832d-6e55-3b84-8d27-d3fdea2e3450",
                                "text": "This condition is encountered in Klinefelter's Syndrome, in primary hypogonadism, following orchitides, and during chronic hemodialysis."
                            }
                        ]
                    }
                ],
                "translations": [
