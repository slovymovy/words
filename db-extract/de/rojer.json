                "senses": [
                    {
                        "sense_id": "86c3914f-c4a1-39ca-be8b-412850ca9e6d",
                        "entry_id": "94c86dac-86ff-30a9-94cd-3343cf31c9d3",
                        "glosses": [
                            "Person, die auf einem Ruderschiff einen Riemen betätigt, nicht zu verwechseln mit dem Rudergänger"
                        ],
                        "tags": [
                            "Seemannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "29f2be8c-8d2f-4d1d-aeba-dc456831e8bd",
                                "sense_id": "86c3914f-c4a1-39ca-be8b-412850ca9e6d",
                                "text": "Bei den Matrosen gab es wiederum eine Unterteilung in die Rojer und den seemännischen Dienst."
                            },
                            {
                                "example_id": "d6e220bd-2e42-4927-902a-a485b61704de",
                                "sense_id": "86c3914f-c4a1-39ca-be8b-412850ca9e6d",
                                "text": "Je schneller sich die Rojer bewegen müssen, um desto mehr geht von derjenigen Kraft verloren, die sie auf das Fortbringen des Fahrzeugs verwenden können."
                            }
                        ],
                        "sense_index_json": "\"1\""
