                    {
                        "translation_id": "656875ca-a4c8-434f-b828-e21e50d9c862",
                        "source_entry_id": "829d113b-7c4c-3263-8913-c54bdc7e05f5",
                        "source_sense_id": "717f8fed-e866-38cf-b6f5-0a13b4b8d2c4",
                        "source_sense_description": "een stuk speelgoed",
                        "target_lang_word": "cheval de bois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheval de bois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c0523c45-2ef5-3f6a-a652-ae03c30a6a9f",
                                        "entry_id": "307c1abe-48cd-3757-ae3c-a9e0fe9ff18f",
                                        "glosses": [
                                            "Figure en bois pour voltiger."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7540e3da-7ffa-45c3-9c00-0672490fc151",
                                                "sense_id": "c0523c45-2ef5-3f6a-a652-ae03c30a6a9f",
                                                "text": "Faire les exercices sur le cheval de bois pour apprendre à monter à cheval & à descendre légèrement , ou à faire divers tours qui montrent l’agilité & la dextérité d’un cavalier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c151bda-63b5-374a-ac9a-6af128ef510c",
                                        "entry_id": "307c1abe-48cd-3757-ae3c-a9e0fe9ff18f",
                                        "glosses": [
                                            "Sculpture en bois de taille réduite représentant un cheval, destinée à être montée par des enfants dans un manège forain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f827168e-fa67-4cf2-a0f5-0bebfcfc45d0",
                                                "sense_id": "9c151bda-63b5-374a-ac9a-6af128ef510c",
                                                "text": "Le cheval de bois est incomestible. On ne le trouve que dans les manèges. Pour la beauté de la chose. Il monte et il descend autour d’un axe en cuivre. Il a des naseaux vermillon, une selle de pourpre, un œil de biche effarouchée. Il se plaît dans le fracas des musiques mécaniques et la fumée des tirs aux pipes. Il tourne comme les souris blanches préparées en laboratoire. C’est un grand malade du cerveau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96bdc724-7435-3e9a-8b7e-21dd57979203",
                                        "entry_id": "307c1abe-48cd-3757-ae3c-a9e0fe9ff18f",
                                        "glosses": [
                                            "Jouet d'enfant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c90aa6f3-850f-4ca4-a770-75535e5bc28a",
                                                "sense_id": "96bdc724-7435-3e9a-8b7e-21dd57979203",
                                                "text": "Mon grand cheval de bois et quelques images me suffisaient comme jouets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0012c901-cd60-38e2-a531-eed5b5d9caa6",
                                        "entry_id": "307c1abe-48cd-3757-ae3c-a9e0fe9ff18f",
                                        "glosses": [
                                            "Tréteau en arête pour le supplice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "637d8648-027b-4809-b242-074f3f4dac23",
                                                "sense_id": "0012c901-cd60-38e2-a531-eed5b5d9caa6",
                                                "text": "De plus, le cheval de bois était employé pour torturer les hommes et les déchirer cruellement en manière de châtiment — ainsi qu’on peut le constater clairement dans les cas des Martyrs Chrétiens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e977837a-5c83-3d48-a90a-0991d6b987a5",
                                        "entry_id": "307c1abe-48cd-3757-ae3c-a9e0fe9ff18f",
                                        "glosses": [
                                            "Tête-à-queue."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54edaa31-12ff-4170-8c3d-da586d00de57",
                                                "sense_id": "e977837a-5c83-3d48-a90a-0991d6b987a5",
                                                "text": "Brusquement je m’aperçois que le terrain est en pente et que, si j’atterris dans la longueur, je risque d’avoir une roue plus bas que l’autre et d’être entraîné dans un « cheval de bois » dont on ne sait d’avance les fantaisies."
                                            },
                                            {
                                                "example_id": "954327a3-c92d-4f35-8759-36b004817971",
                                                "sense_id": "e977837a-5c83-3d48-a90a-0991d6b987a5",
                                                "text": "D’un seul coup, brutalement, le flotteur gauche s’engagea. Je fus emmené dans un « cheval de bois » à gauche, que je pus contrecarrer quelque peu en accélérant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22f45c27-8654-30ec-b43f-654c2d685eb5",
                                        "entry_id": "307c1abe-48cd-3757-ae3c-a9e0fe9ff18f",
                                        "glosses": [
                                            "Sorte d'échelle utilisée par les écorceurs pour ôter les écorces de chênes sur pied."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65a687b0-c7e0-475f-8389-28010e03aabb",
                                                "sense_id": "22f45c27-8654-30ec-b43f-654c2d685eb5",
                                                "text": "On peut obtenir deux ou trois cylindres d'écorce ( \"toe\" ou \"toey\" ) dans un arbre. Quand l'arbre est sur pied, on se sert pour lever le deuxième et le troisième \"toe\" d'une sorte d'échelle appelée \"cheval\" ou \"cheval de bois\", ou \"cheval de peleur\", \"cheval de plumeur\" ou \"chevalet\". Le dernier barreau de cette échelette est une grosse hart, pour mieux embrasser le tronc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8a75574-2240-4874-ba00-41d2c6bbfde2",
                        "source_entry_id": "829d113b-7c4c-3263-8913-c54bdc7e05f5",
                        "source_sense_id": "9c41e820-0d65-376b-adf2-edaa16d28701",
                        "source_sense_description": "een favoriet gespreksonderwerp",
                        "target_lang_word": "Steckenpferd",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steckenpferd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8e90d756-e2ca-396b-8db4-6d97cbe9f462",
                                        "entry_id": "a732e30a-a2b1-3b6d-83e8-e6fa1bd6324d",
                                        "glosses": [
                                            "aus der Mode gekommenes Kinderspielzeug; Stock oder Stecken, an dem ein Pferdekopf angebracht ist und auf dem die Kinder „reiten“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71ac81ff-b4d4-44da-a8ca-1c687698c143",
                                                "sense_id": "8e90d756-e2ca-396b-8db4-6d97cbe9f462",
                                                "text": "Ich habe mein altes Steckenpferd auf dem Speicher gefunden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "64c6e55f-94cd-3c92-8c43-01b4b3f18f0c",
                                        "entry_id": "a732e30a-a2b1-3b6d-83e8-e6fa1bd6324d",
                                        "glosses": [
                                            "Beschäftigung, die der erwachsene Mensch gerne und freiwillig, meist in der Freizeit, auf sich nimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83b056a6-42a4-4e92-9509-25f23abbe480",
                                                "sense_id": "64c6e55f-94cd-3c92-8c43-01b4b3f18f0c",
                                                "text": "Meine Steckenpferde heißen Wiktionary und Wikipedia."
                                            },
                                            {
                                                "example_id": "bf534ffc-b9b9-4d88-b95e-b9fcd5f0d0f7",
                                                "sense_id": "64c6e55f-94cd-3c92-8c43-01b4b3f18f0c",
                                                "text": "Bei der Beschäftigung mit seinem Steckenpferd darf der Erwachsene noch einmal Kind sein."
                                            },
                                            {
                                                "example_id": "9e068e84-5ef1-4699-953f-21e04513ef4c",
                                                "sense_id": "64c6e55f-94cd-3c92-8c43-01b4b3f18f0c",
                                                "text": "„Seine vielerlei Steckenpferde bleiben im Bekannten- und Freundeskreis nicht verborgen, und man händigte ihm oft beschädigte alte Handschriften zum Ausbessern ein.“"
                                            },
                                            {
                                                "example_id": "10017543-1477-4a9c-8147-7176ba94221e",
                                                "sense_id": "64c6e55f-94cd-3c92-8c43-01b4b3f18f0c",
                                                "text": "„Am liebsten saß er über den Akten der andern, verglich, schlug nach, machte seitenlange Exzerpte - und sein Steckenpferd war es, sich über alles Tabellen anzulegen, endlose, minutiös durchdachte Tabellen, aus denen er seine scharfsinnigen Schlüsse zog.“"
                                            },
                                            {
                                                "example_id": "21abc621-5b4e-4e20-b8ae-291c3e8599a6",
                                                "sense_id": "64c6e55f-94cd-3c92-8c43-01b4b3f18f0c",
                                                "text": "„Man könne den lieben Gott einen guten Mann sein lassen und seinem Steckenpferd frönen.“"
                                            },
                                            {
                                                "example_id": "a41aacee-e02a-457a-8e19-f68ec626dbc0",
                                                "sense_id": "64c6e55f-94cd-3c92-8c43-01b4b3f18f0c",
                                                "text": "„Ich merkte, dass Mr. Mifflin sein Steckenpferd bestiegen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
