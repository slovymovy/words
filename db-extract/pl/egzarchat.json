                        "glosses": [
                            "jednostka podziału administracyjnego w cesarstwie bizantyńskim znajdująca się pod zarządem egzarchy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "164ff458-43c9-45d6-8458-46bf598a379f",
                                "sense_id": "48eb7b32-2a01-3927-b020-1decf9d5d131",
                                "text": "Południowa część egzarchatu weszła później w skład Katepanatu Italii"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
