                "senses": [
                    {
                        "sense_id": "915972f4-1ff7-3daa-ae25-5e4daf2dbb68",
                        "entry_id": "2b5196b2-60b8-3d75-893d-0f7a66adfa55",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbfcf9df-db64-4a4c-8c94-2a44ea5601a1",
                                "sense_id": "915972f4-1ff7-3daa-ae25-5e4daf2dbb68",
                                "text": "Frau Tack ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6ae5d5b1-b51b-4a69-99b7-5303a9e38484",
                                "sense_id": "915972f4-1ff7-3daa-ae25-5e4daf2dbb68",
                                "text": "Herr Tack wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9a07e9b5-72f7-4977-8d1c-096cb5f3583b",
                                "sense_id": "915972f4-1ff7-3daa-ae25-5e4daf2dbb68",
                                "text": "Die Tacks fahren heute nach Düsseldorf."
                            },
                            {
                                "example_id": "942bf00c-99de-4af2-8da6-9892f13d62a1",
                                "sense_id": "915972f4-1ff7-3daa-ae25-5e4daf2dbb68",
                                "text": "Der Tack trägt nie die Pullover, die die Tack ihm strickt."
                            },
                            {
                                "example_id": "f53eb63c-91a8-4b53-afac-4cba5fb001fd",
                                "sense_id": "915972f4-1ff7-3daa-ae25-5e4daf2dbb68",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Tack kommt, geht der Herr Tack.“"
                            },
                            {
                                "example_id": "8b72f92a-07fe-4fd9-a87f-6b370cf9e4c2",
                                "sense_id": "915972f4-1ff7-3daa-ae25-5e4daf2dbb68",
                                "text": "Tack kommt und geht."
                            },
                            {
                                "example_id": "2d5f3ac0-45ee-4537-97c6-1ef648f75281",
                                "sense_id": "915972f4-1ff7-3daa-ae25-5e4daf2dbb68",
                                "text": "Tacks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
