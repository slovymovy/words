                ],
                "senses": [
                    {
                        "sense_id": "4d8498d8-5b9c-3f7a-9e7c-7203d19813fa",
                        "entry_id": "856d7b92-15a6-367d-bbe6-d89b20c9b483",
                        "glosses": [
                            "mit Schlamm bedeckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0571038b-f1a4-418f-be05-a2644a4f8602",
                                "sense_id": "4d8498d8-5b9c-3f7a-9e7c-7203d19813fa",
                                "text": "„Jung-Adolf zog seine angeleinte Frau schnell durch die geschäftigen, schlammbedeckten Straßen von ____stadt in der Hoffnung, ihre Registrierung so schnell wie möglich hinter sich zu bringen.“"
                            },
                            {
                                "example_id": "944159b9-bf43-4959-8ce7-d8b4c6bdc01f",
                                "sense_id": "4d8498d8-5b9c-3f7a-9e7c-7203d19813fa",
                                "text": "„Endlich gelangten sie auf eine schlammbedeckte Straße und sahen die Sonne hervorkommen.“"
                            },
                            {
                                "example_id": "756f4e94-8bb7-4a91-b06b-c3aed69d71b6",
                                "sense_id": "4d8498d8-5b9c-3f7a-9e7c-7203d19813fa",
                                "text": "„Er versaute sein Equipment wieder im schlammbedeckten Rucksack, robbte auf den Ellbogen vorwärts durchs Gebüsch und hinunter in den Kanal, schön langsam und leise.“"
                            },
                            {
                                "example_id": "91d0ca6c-e7a6-4fcd-b831-0c6dcbe5fd14",
                                "sense_id": "4d8498d8-5b9c-3f7a-9e7c-7203d19813fa",
                                "text": "„Er geht in die Hocke und öffnet seine schlammbedeckten Schuhe.“"
                            }
