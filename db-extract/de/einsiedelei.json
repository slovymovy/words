                "senses": [
                    {
                        "sense_id": "b2cae42d-a4eb-362e-84a6-32116d092d89",
                        "entry_id": "5f440dd4-4ca0-3c11-84d6-cc38a7c55db2",
                        "glosses": [
                            "Lebensbereich eines Einsiedlers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03d39abd-82a6-4baf-988f-cdd24c56138e",
                                "sense_id": "b2cae42d-a4eb-362e-84a6-32116d092d89",
                                "text": "„Am nächsten Tag fanden mich Hirten auf dem Felde und trugen mich in diese Einsiedelei.“"
                            },
                            {
                                "example_id": "b25dfdb1-27fa-4cf8-9311-033ed06b5c70",
                                "sense_id": "b2cae42d-a4eb-362e-84a6-32116d092d89",
                                "text": "„Denn in seiner Einsiedelei sollte der Pechvogel, der bisher kein Glück im Privatleben hatte, endlich eine Gefährtin für die guten und die schlechten Tage finden.“"
                            },
                            {
                                "example_id": "f1d59df8-b3cf-4129-a966-d03b9730b287",
                                "sense_id": "b2cae42d-a4eb-362e-84a6-32116d092d89",
                                "text": "„Oft geschah es, dass sich mehrere Mönche in einer solchen Einsiedelei ansiedelten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d8f6277e-12e5-4a4c-b6f5-94e5b2496b7d",
                        "source_entry_id": "5f440dd4-4ca0-3c11-84d6-cc38a7c55db2",
                        "source_sense_id": "b2cae42d-a4eb-362e-84a6-32116d092d89",
                        "source_sense_description": "Lebensbereich eines Einsiedlers",
                        "target_lang_word": "hermitage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hermitage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4851da0f-8a97-369b-ab74-b1bed6bb7566",
                                        "entry_id": "43aeb1bb-ca38-3ddd-b103-082ea01f2fec",
                                        "glosses": [
                                            "A house or dwelling where a hermit lives."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0296aca7-86cd-4e82-92cb-6f5041f2a9bb",
                                                "sense_id": "4851da0f-8a97-369b-ab74-b1bed6bb7566",
                                                "text": "But vvhat a vvretched, and diſconſolate Hermitage is that Houſe, vvhich is not viſited by thee [God], and vvhat a VVayue, and Stray is that Man, that hath not thy Markes vpon him?"
                                            },
                                            {
                                                "example_id": "1f11460d-289e-4eaf-b031-7aabf56098e0",
                                                "sense_id": "4851da0f-8a97-369b-ab74-b1bed6bb7566",
                                                "text": "I saw the huge rocking-stone, that had been violently depressed by him as he sprang, fly back when relieved of his weight till, for the first time during all these centuries, it got beyond its balance, fell with a most awful crash right into the rocky chamber which had once served the philosopher Noot for a hermitage, and, I have no doubt, for ever sealed the passage that leads to the Place of Life with some hundreds of tons of rock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba22db81-aa26-3aa0-9f2f-5fed839bdcea",
                                        "entry_id": "43aeb1bb-ca38-3ddd-b103-082ea01f2fec",
                                        "glosses": [
                                            "A place of seclusion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39e37f2c-89a2-4c1b-9c3c-44c70278baa1",
                                                "sense_id": "ba22db81-aa26-3aa0-9f2f-5fed839bdcea",
                                                "text": "Temptation is an obsequious servant that has no objection to the country, and we know that it takes up its lodging in hermitages as well as in cities; and that in the most remote and inaccessible desert it keeps company with the fugitive solitary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb17122f-f9de-3b08-ab3f-c035aeeb221e",
                                        "entry_id": "43aeb1bb-ca38-3ddd-b103-082ea01f2fec",
                                        "glosses": [
                                            "A period of seclusion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "600e8b24-897e-41ab-9359-83898f2ad7d3",
                        "source_entry_id": "5f440dd4-4ca0-3c11-84d6-cc38a7c55db2",
