                "senses": [
                    {
                        "sense_id": "04b50924-329e-34d0-a501-73d80c6bd1a9",
                        "entry_id": "a321dca8-baa4-3711-be87-e0c8d2fc84ab",
                        "glosses": [
                            "ein schneckenförmiges eingerolltes Zierelement von Bauteilen wie Konsolen, Giebeln oder Kapitellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "770eab12-0c42-41e9-8334-c67f7a760011",
                                "sense_id": "04b50924-329e-34d0-a501-73d80c6bd1a9",
                                "text": "„In der Baukunst des Barock wurden Voluten in vielfältiger Weise als schmückende Elemente verwendet.“"
                            },
                            {
                                "example_id": "e37e200a-ca00-49fd-84bd-52dcfd61cbc8",
                                "sense_id": "04b50924-329e-34d0-a501-73d80c6bd1a9",
                                "text": "„Alles ist hier verschroben, üppig, zu Voluten eingerollt, barock und bewegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
