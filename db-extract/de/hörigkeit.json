                        "tags": [],
                        "examples": [
                            {
                                "example_id": "402a5cf9-41f0-49c2-9873-8fc6678919b2",
                                "sense_id": "a69df62f-ff8e-3ad3-aca6-dbdc3e2c1bba",
                                "text": "„Der spezifische Begriff Sadismus wurde von Krafft-Ebing geprägt, zusammen mit dem Gegenbegriff Masochismus, abgeleitet vom Namen des Schriftstellers Sacher-Masoch, der Novellen der sexuellen Hörigkeit schrieb.“"
                            },
                            {
                                "example_id": "388ea81b-8265-4c23-95e7-6af07dda4949",
                                "sense_id": "a69df62f-ff8e-3ad3-aca6-dbdc3e2c1bba",
                                "text": "„Wegen ihrer völligen Hörigkeit dem Gatten gegenüber wagte sie indessen auch diesmal kein Aufbegehren.“"
                            }
                        ],
