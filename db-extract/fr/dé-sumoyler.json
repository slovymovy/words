                "senses": [
                    {
                        "sense_id": "c62bf81b-6d44-36c0-9845-de064d1b8f0d",
                        "entry_id": "4a526eeb-609c-31eb-9ae4-2a977e81586d",
                        "glosses": [
                            "Autre orthographe de désumoyler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73f0ffe6-3bea-4a3a-8c8e-d75d16f1c1d1",
                                "sense_id": "c62bf81b-6d44-36c0-9845-de064d1b8f0d",
                                "text": "Ce système est d’ailleurs réversible car la protéine SENP1 (SUMO1/sentrin specific peptidase 1), une protéase nucléaire, a la capacité de dé-sumoyler HIF1a, et ainsi d’inhiber sa dégradation par le protéasome."
                            },
                            {
                                "example_id": "5c1750c0-8841-40aa-b435-fe20b0079129",
                                "sense_id": "c62bf81b-6d44-36c0-9845-de064d1b8f0d",
                                "text": "SENP5, une sentrin/SUMO protéase est capable de dé-sumoyler Drp1 et de restaurer une morphologie mitochondriale sauvage (Zunino et al., 2007)."
                            }
                        ]
                    }
