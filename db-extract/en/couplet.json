                    },
                    {
                        "translation_id": "3066bff7-9a80-45c6-909c-632f3cc9c9a5",
                        "source_entry_id": "0127cd8e-ba76-3ca7-8884-e1e282c2f83d",
                        "source_sense_description": "in poetry, a pair of lines with rhyming end words",
                        "target_lang_word": "couplet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "couplet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5073e124-e9e2-362c-99af-a2ab6c4ccc53",
                                        "entry_id": "b53b4506-18a9-38ef-9e70-5152d9185f63",
                                        "glosses": [
                                            "Chacune des parties dont se compose une chanson et qui d’ordinaire comprennent le même nombre de vers et se terminent par un refrain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc917916-522b-4ab5-89f8-6f98b6ffaf8b",
                                                "sense_id": "5073e124-e9e2-362c-99af-a2ab6c4ccc53",
                                                "text": "Pas difficile de se monter un répertoire… Six chansons de choix, un ou deux couplets pour les bis et les rappels… Pas difficile !"
                                            },
                                            {
                                                "example_id": "b3881d85-6a82-4c3a-b44b-376685c467eb",
                                                "sense_id": "5073e124-e9e2-362c-99af-a2ab6c4ccc53",
                                                "text": "Cette chanson n’a qu’un couplet, est de quatre couplets. - Le premier, le second couplet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f89326a6-4081-3f45-8c67-8d9ae7a9a98a",
                                        "entry_id": "b53b4506-18a9-38ef-9e70-5152d9185f63",
                                        "glosses": [
                                            "Chanson."
                                        ],
                                        "tags": [
                                            "Quelquefois"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14fea6bc-3ab1-4cf2-b8ce-27fa82bb8746",
                                                "sense_id": "f89326a6-4081-3f45-8c67-8d9ae7a9a98a",
                                                "text": "Faire des couplets contre quelqu’un. - Des couplets satiriques. - Des couplets de circonstance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4abe7d0-1530-31d9-b121-a6439dec6b49",
                                        "entry_id": "b53b4506-18a9-38ef-9e70-5152d9185f63",
                                        "glosses": [
                                            "Suite de vers sur une même rime."
                                        ],
                                        "tags": [
                                            "Chanson de geste"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "594823a8-e38a-45ed-966b-6e5b2cf75bbf",
                                                "sense_id": "e4abe7d0-1530-31d9-b121-a6439dec6b49",
                                                "text": "La plupart des chansons de geste se composent de couplets monorimes d’inégale longueur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71d58344-c066-384c-86ad-a33075f39b9f",
                                        "entry_id": "b53b4506-18a9-38ef-9e70-5152d9185f63",
                                        "glosses": [
                                            "Dans un discours ; tirade ; morceau de toute étendue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b065491-b251-43a1-949b-909aef7219a6",
                                                "sense_id": "71d58344-c066-384c-86ad-a33075f39b9f",
                                                "text": "Ils soupirent après 1919 et le wilsonnisme. Grand bien leur fasse. On sait ce que les couplets sur la dernière des guerres, le droit des nations à disposer d'elles-mêmes et ce messianisme humanitaire ont donné comme résultats."
                                            },
                                            {
                                                "example_id": "6bf50fc4-b8ff-4df8-a95a-4528b957dad4",
                                                "sense_id": "71d58344-c066-384c-86ad-a33075f39b9f",
                                                "text": "Ce couplet a été dit parfaitement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e27e6089-f6a5-31ee-96a5-d3646e708a12",
                                        "entry_id": "b53b4506-18a9-38ef-9e70-5152d9185f63",
                                        "glosses": [
                                            "Chant dialogué dans certaines comédies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ac715ef-6e8c-44ee-883e-3c6c92932dad",
                                                "sense_id": "e27e6089-f6a5-31ee-96a5-d3646e708a12",
                                                "text": "Couplet d’ensemble. - Couplet final."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77af1e4b-320b-368a-9d49-fdbce4ada1b3",
                                        "entry_id": "b53b4506-18a9-38ef-9e70-5152d9185f63",
                                        "glosses": [
                                            "Deux pattes de fer à queue d’aronde, assemblées par une charnière et servant à unir un châssis avec son dormant, un couvercle avec le corps d’une cassette, d’une boîte, etc."
                                        ],
                                        "tags": [
                                            "Serrurerie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f75adb9-556f-3e52-b622-2a84458baa18",
                                        "entry_id": "b53b4506-18a9-38ef-9e70-5152d9185f63",
                                        "glosses": [
                                            "Rengaine."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
