                "senses": [
                    {
                        "sense_id": "c9dd1255-f256-3eca-aec6-21276b788e1b",
                        "entry_id": "ad47f9a0-eeaf-389f-97cd-d1580daeda7c",
                        "glosses": [
                            "Gruppe von männlichen Sportlern, die eine Mannschaft bilden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "601b8bca-788a-48e9-b77f-0b8cc88b66db",
                                "sense_id": "c9dd1255-f256-3eca-aec6-21276b788e1b",
                                "text": "„Er hatte die Sonntagsspiele der Luruper Männermannschaft im Stadion an der Flurstraße gesehen.“"
                            },
                            {
                                "example_id": "2e9d79f8-5569-46ac-b3bc-5fcd748f1276",
                                "sense_id": "c9dd1255-f256-3eca-aec6-21276b788e1b",
                                "text": "„Und 1933 gab es eine Frau, die in der Männermannschaft spielte. Scheint damals kein Problem gewesen zu sein. Sie prügelte sich wie ihre männlichen Teamkollegen, köpfte, foulte — sie war wohl ziemlich stabil gebaut und unerschrocken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
