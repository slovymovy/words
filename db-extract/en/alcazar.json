                                "target_senses": [
                                    {
                                        "sense_id": "1b53c191-91db-3c9a-886c-8b4d12adf2cb",
                                        "entry_id": "8249af39-11a3-36c1-8c77-7b3b5ea230af",
                                        "glosses": [
                                            "Palais fortifié en Espagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2eb56e89-8fec-477b-9cf0-ddd20dad0db1",
                                                "sense_id": "1b53c191-91db-3c9a-886c-8b4d12adf2cb",
                                                "text": "Au XIIIe siècle, Alphonse X entreprit la construction d'un premier palais, de style gothique sur le site de l'alcazar musulman."
                                            },
                                            {
                                                "example_id": "a6b691af-db01-41e2-8e57-32beef091dbb",
                                                "sense_id": "1b53c191-91db-3c9a-886c-8b4d12adf2cb",
                                                "text": "Elle fut autrefois la Julia Romula des Romains et les rois maures y avaient un alcazar qui est aujourd'hui en très bon état."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10adeb1f-d90f-3828-ae3e-3678f7a57269",
                                        "entry_id": "8249af39-11a3-36c1-8c77-7b3b5ea230af",
                                        "glosses": [
                                            "Par association, établissement de style mauresque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6860f05-835a-45f4-9ca3-4e788618b5ef",
                                                "sense_id": "10adeb1f-d90f-3828-ae3e-3678f7a57269",
                                                "text": "C'était à Nantes, avec une chanteuse. Un soir, revenant de la mer, il était entré un peu gris dans un alcazar. — (Pierre Loti, Pêcheur d'Islande, 1886)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
