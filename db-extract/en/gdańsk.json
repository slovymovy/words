                    },
                    {
                        "translation_id": "20ac5aec-a215-47fc-99f9-3d78d27eba68",
                        "source_entry_id": "c7c4bf81-40ab-3df8-a2f9-19906f56c30d",
                        "source_sense_id": "83e37b5b-cc8a-3804-88e4-fbea1ad42c74",
                        "source_sense_description": "city of Poland",
                        "target_lang_word": "Dantzick",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dantzick",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "667dc35c-69b8-397a-b749-13e2a6e66a6e",
                                        "entry_id": "b7fb94be-c9a3-3b88-870d-e4d7dd05653b",
                                        "glosses": [
                                            "Dantzig, ville de Pologne et port sur la mer Baltique."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f9f486d-1ab4-47a8-8c2a-b256ed4bde79",
                                                "sense_id": "667dc35c-69b8-397a-b749-13e2a6e66a6e",
                                                "text": "Le secret, le voici : règle générale, ne vous mariez pas sergent, quand vous pouvez devenir duc de Dantzick et maréchal de France."
                                            },
                                            {
                                                "example_id": "fb0500e6-43bb-45fd-bf51-2f97b6b99e6b",
                                                "sense_id": "667dc35c-69b8-397a-b749-13e2a6e66a6e",
                                                "text": "Le commerce du blé et celui du seigle sont dans des proportions inverses pour Dantzick, et pour Kœnigsberg."
                                            },
                                            {
                                                "example_id": "7a24c299-acc2-44e5-a5e5-112aac8009c4",
                                                "sense_id": "667dc35c-69b8-397a-b749-13e2a6e66a6e",
                                                "text": "C’est après cette dernière victoire qu’il partit pour investir Dantzick, qui, après cinquante et un jours de tranchée ouverte, se rendit le 26 mai 1807. Le surlendemain, l’Empereur le créa duc de Dantzick. — (Joseph Marty, Les principaux monuments fénéraires […] de Paris, 1839, section relative au maréchal François-Joseph Lefebvre. Texte procuré par Wikisource : fr:Les principaux monuments funéraires/Lefebvre, page 212 et fr:Page:Marty - Les principaux monuments funéraires.djvu/224 pour la page)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "985ebc30-ff7b-437b-a63f-4b5880aad47f",
                        "source_entry_id": "c7c4bf81-40ab-3df8-a2f9-19906f56c30d",
                        "source_sense_id": "83e37b5b-cc8a-3804-88e4-fbea1ad42c74",
