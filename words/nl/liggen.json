                            "text": "Piano spelen <w>ligt</w> me niet zo, ik zing liever.",
                            "target_lang_translations": {
                                "ru": "Игра на пианино мне не очень <w>подходит</w>, я предпочитаю петь.",
                                "en": "Playing the piano doesn't really <w>suit</w> me, I prefer singing.",
                                "pl": "Gra na pianinie niezbyt mi <w>leży</w>, wolę śpiewać.",
                                "de": "Klavierspielen <w>liegt</w> mir nicht so, ich singe lieber.",
                                "fr": "Jouer du piano ne me <w>plaît</w> pas trop, je préfère chanter.",
                                "it": "Suonare il pianoforte non mi <w>va molto a genio</w>, preferisco cantare.",
                                "cs": "Hraní na klavír mi moc <w>nejde</w>, raději zpívám.",
                                "tr": "Piyano çalmak bana pek <w>hitap etmiyor</w>, şarkı söylemeyi tercih ederim.",
                                "es": "Tocar el piano no se me <w>da</w> muy bien, prefiero cantar."
                            }
                        }
                    ],
