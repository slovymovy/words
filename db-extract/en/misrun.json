    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e510a7bb-8624-365c-8756-868fdfb1c900",
                "word": "misrun",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6bcdb519-c167-4be3-a991-b6b1a4ef56ac",
                        "entry_id": "e510a7bb-8624-365c-8756-868fdfb1c900",
                        "tags": [
                            "plural"
                        ],
                        "form": "misruns"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4d584d53-dbc5-3f86-b0e4-a05dfbb9d4ae",
                        "entry_id": "e510a7bb-8624-365c-8756-868fdfb1c900",
                        "glosses": [
                            "A casting that does not completely fill the mold, leaving unfilled spaces."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9fed5532-d62f-4427-8803-769a14062ecf",
                                "sense_id": "4d584d53-dbc5-3f86-b0e4-a05dfbb9d4ae",
                                "text": "The reasons for cold shut or misrun may be too thin sections, improper gating system, slow and intermittent pouring, poor fluidity of metal."
                            },
                            {
                                "example_id": "a197181d-fc52-4e11-8b18-e0e0c042f0fd",
                                "sense_id": "4d584d53-dbc5-3f86-b0e4-a05dfbb9d4ae",
                                "text": "When wall thickness is decreased to less than 1/16 in., adequate mold filling becomes almost impossible, except for extremely short distances, and misruns result because of the freezing of metal before the mold is filled."
                            },
                            {
                                "example_id": "e454d81c-b8fd-4dcb-8a61-b00fce39d608",
                                "sense_id": "4d584d53-dbc5-3f86-b0e4-a05dfbb9d4ae",
                                "text": "A misrun is caused when the metal is unable to fill the mould cavity completely and thus leaves unfilled cavities."
                            },
                            {
                                "example_id": "3fdc7782-8400-4d90-a74a-b5678f9125e7",
                                "sense_id": "4d584d53-dbc5-3f86-b0e4-a05dfbb9d4ae",
                                "text": "If the molten metal is too cold or casting is too thin, entire mould may not be filled during pouring before the metal starts solidifying and result in misrun."
                            }
                        ]
                    },
                    {
                        "sense_id": "90329934-2003-3efc-9659-2241615f38f3",
                        "entry_id": "e510a7bb-8624-365c-8756-868fdfb1c900",
                        "glosses": [
                            "A failed test of oil or gas drilling equipment."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "38b2d043-73f1-4399-bc57-3578ecd857ba",
                                "sense_id": "90329934-2003-3efc-9659-2241615f38f3",
                                "text": "The experience of most drillstem testing companies indicates that the chance of a misrun in a poorly prepared hole is approximately 30 percent, whereas the chance of a misrun in a well-prepared hole has been cut down to roughly 15 percent."
                            },
                            {
                                "example_id": "48981acc-985c-46dc-aad6-548b3315b7f4",
                                "sense_id": "90329934-2003-3efc-9659-2241615f38f3",
                                "text": "In this test, the pressure curve shows clearly that a seal was not affected; therefore, this is a misrun."
                            },
                            {
                                "example_id": "010aa4c0-68de-4801-afc1-f472368c3e31",
                                "sense_id": "90329934-2003-3efc-9659-2241615f38f3",
                                "text": "Follow Schlumberger procedures for recovering guns in the event of a misrun."
                            },
                            {
                                "example_id": "dcec2424-91de-4f60-bf0a-9198fac4573b",
                                "sense_id": "90329934-2003-3efc-9659-2241615f38f3",
                                "text": "When the DST tool is set, if fluid does not stay at the surface on the outside of the hole or the drill pipe, then you have a misrun."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8d7c70de-9769-3100-b636-34c9fdb17828",
