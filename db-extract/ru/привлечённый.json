                        "examples": [
                            {
                                "example_id": "e2432b9c-9b41-4884-a7b3-1384642fb1af",
                                "sense_id": "86ea442e-4425-312c-af5f-6ff7839e2ebb",
                                "text": "Кот, сло́вно привлечённый кри́ками, вы́шел из ку́хни, пробира́ясь вдоль стен, и сел о́коло Передо́нова, гля́дя на него́ жа́дными и злы́ми глаза́ми.",
                                "translation": "The cat, as if attracted by this uproar, had left the kitchen, sidling along the walls, sat down near Peredonov and looked at him with its avid, evil eyes.",
                                "english": "The cat, as if attracted by this uproar, had left the kitchen, sidling along the walls, sat down near Peredonov and looked at him with its avid, evil eyes."
                            }
                        ]
                    }
