                "senses": [
                    {
                        "sense_id": "14d06923-8daf-3feb-a4d3-12073a8292d6",
                        "entry_id": "e30e7cdf-3947-383e-a2fa-fde63c48c182",
                        "glosses": [
                            "Person, die aus religiösen oder moralischen Gründen die Abtreibung ablehnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05638b3d-f879-4601-90e5-6f5602a951b6",
                                "sense_id": "14d06923-8daf-3feb-a4d3-12073a8292d6",
                                "text": "Ein absoluter Abtreibungsgegner ist die katholische Kirche."
                            },
                            {
                                "example_id": "f815ea3d-f157-42e9-a3a3-a2233e5d35e4",
                                "sense_id": "14d06923-8daf-3feb-a4d3-12073a8292d6",
                                "text": "„Als ich die Ehrung entgegennehmen wollte, begann eine Gruppe von Abtreibungsgegnern zu schreien und mich zu beschimpfen, die Gesichter von Hass verzerrt.“"
                            },
                            {
                                "example_id": "0e747603-cde8-41ca-9f41-64e856136fe8",
                                "sense_id": "14d06923-8daf-3feb-a4d3-12073a8292d6",
                                "text": "„Immer wieder kommt es vor, dass Abtreibungsgegner vor den Praxen und Beratungsstellen protestieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
