                "senses": [
                    {
                        "sense_id": "622576ff-a0e8-30bd-8558-0e57eeac7dee",
                        "entry_id": "aa210332-3f48-3492-90b7-172c58ab89bc",
                        "glosses": [
                            "Mathematik"
                        ],
                        "tags": [],
