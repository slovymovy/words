                                "target_senses": [
                                    {
                                        "sense_id": "69bea8bc-4de0-3b13-88da-4caf026dc789",
                                        "entry_id": "61ed3e7f-010d-372a-be37-1c19e403f820",
                                        "glosses": [
                                            "Action de remanier ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c5430ae-5355-4453-9e63-f7e9ee8a9716",
                                                "sense_id": "69bea8bc-4de0-3b13-88da-4caf026dc789",
                                                "text": "Remaniement d’un pavage."
                                            },
                                            {
                                                "example_id": "47866ce0-8866-4340-8464-38c740e4d060",
                                                "sense_id": "69bea8bc-4de0-3b13-88da-4caf026dc789",
                                                "text": "Au temps qui précède le second remaniement de l'édifice la cour a donc été ornée de portiques, au moins de deux côtés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8348af25-f395-3d9a-bdaa-1a0f0484445a",
                                        "entry_id": "61ed3e7f-010d-372a-be37-1c19e403f820",
                                        "glosses": [
                                            "Remplacement du personnel."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b255ee75-fa15-41c5-839a-3ba5f0bb8eac",
                                                "sense_id": "8348af25-f395-3d9a-bdaa-1a0f0484445a",
                                                "text": "Le remaniement du ministère."
                                            },
                                            {
                                                "example_id": "67ea9584-5211-44a9-b05f-a03c1af00914",
                                                "sense_id": "8348af25-f395-3d9a-bdaa-1a0f0484445a",
                                                "text": "La preuve, nous sommes en 2004 et au 6e remaniement ministériel pour quatre (4) ans de pouvoir libéral, mais toujours, point d'équilibre gouvernemental ou encore du pays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "456753b7-be56-3ec2-ad9f-1af28993891a",
                                        "entry_id": "61ed3e7f-010d-372a-be37-1c19e403f820",
                                        "glosses": [
                                            "Changements de quelque importance apportés par un auteur au texte de son ouvrage."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fb21da1-eae5-440a-9ba3-f54be0303233",
                                                "sense_id": "456753b7-be56-3ec2-ad9f-1af28993891a",
                                                "text": "Les corrections qu’a faites cet auteur sont de véritables remaniements."
                                            },
                                            {
                                                "example_id": "b8deb139-c879-4cb1-8b2e-49145b068aaa",
                                                "sense_id": "456753b7-be56-3ec2-ad9f-1af28993891a",
                                                "text": "On peut traiter le remaniement dans l'apparat de l'édition de l'original."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
