            "senses": [
                {
                    "sense_id": "24b4e952-a65d-3a98-ab8c-1c30230ae70a",
                    "sense_definition": "Plural of <w>mitten</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should wear your <w>mittens</w> because it is very cold outside today.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит надеть <w>варежки</w>, потому что сегодня на улице очень холодно."
                            }
                        },
                        {
                            "text": "I lost one of my wool <w>mittens</w> while I was playing in the snow.",
                            "target_lang_translations": {
                                "ru": "Я потерял одну из своих шерстяных <w>варежек</w>, пока играл в снегу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wool mittens",
                        "pair of mittens",
                        "wear mittens"
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова mitten (варежка)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "варежки",
                                "target_lang_sense_clarification": "зимняя одежда для рук"
                            },
                            {
                                "target_lang_word": "рукавицы",
                                "target_lang_sense_clarification": "плотные защитные или теплые изделия для рук"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "5cf8afb5-2bd8-3b79-9c65-23d7d412f916",
                    "sense_definition": "A common given name for a cat, often one with white paws.",
                    "learner_level": "A2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "fictional_name",
                    "examples": [
                        {
                            "text": "Our new kitten is named <w>Mittens</w> because his feet look like little white gloves.",
                            "target_lang_translations": {
                                "ru": "Нашего нового котенка зовут <w>Миттенс</w>, потому что его лапки похожи на маленькие белые перчатки."
                            }
                        },
                        {
                            "text": "I think <w>Mittens</w> is a very cute name for a fluffy house cat.",
                            "target_lang_translations": {
                                "ru": "Я думаю, что <w>Варежка</w> — это очень милое имя для пушистого домашнего кота."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенная кличка для кошек, часто имеющих белые лапки"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Миттенс",
                                "target_lang_sense_clarification": "транслитерация имени"
                            },
                            {
                                "target_lang_word": "Варежка",
                                "target_lang_sense_clarification": "перевод клички по смыслу"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9a0fad69-3af0-3104-866f-0522044f9e0c",
                    "sense_definition": "Third-person singular simple present indicative of <w>mitten</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trainer <w>mittens</w> his hands before starting the boxing session with the athlete.",
                            "target_lang_translations": {
                                "ru": "Тренер <w>надевает защитные рукавицы</w> на руки перед началом боксерской тренировки с атлетом."
                            }
                        },
                        {
                            "text": "He carefully <w>mittens</w> each delicate part to protect it from scratches during transport.",
                            "target_lang_translations": {
                                "ru": "Он осторожно <w>оборачивает в защитные чехлы</w> каждую хрупкую деталь, чтобы защитить её от царапин при транспортировке."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма третьего лица единственного числа настоящего времени глагола mitten (надевать варежки или защитные перчатки)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надевает варежки",
                                "target_lang_sense_clarification": "процесс защиты рук"
                            },
                            {
                                "target_lang_word": "защищает рукавицами",
                                "target_lang_sense_clarification": "использование специальных перчаток"
                            }
                        ]
                    }
                }
            ]
        }
    ]
