                        "examples": [
                            {
                                "example_id": "3f1be751-2a8b-4179-b329-f6362726d44c",
                                "sense_id": "5a6f0fab-293c-3d60-8ad4-fb9524d2437c",
                                "text": "Les « gonzesses », personne ne les appelait plus autrement, s’occupaient du ménage dans les piaules, briquaient les chiottes, ciraient les chaussures, raccommodaient les boutons, les épaulettes, préparaient le café à nos retours de saut ou de crapahutage."
                            },
                            {
                                "example_id": "f2ae07ac-582d-4270-ae6f-1e0d9933c93e",
                                "sense_id": "5a6f0fab-293c-3d60-8ad4-fb9524d2437c",
                                "text": "Des massifs entiers étaient ainsi bouclés et pendant des jours et des jours, c’était le \"crapahutage\" à flanc de montagne ou au creux des oueds asséchés par l’été."
                            }
                        ]
