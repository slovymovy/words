                        "sense_id": "1a282fb5-9079-3e73-88cc-1539b1ecfcf4",
                        "entry_id": "631cadc9-4a3a-3077-a069-898aa9c3271e",
                        "glosses": [
                            "Faire perdre son caractère de boulevard à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94095eaa-b437-4805-bf3e-3dd93cca917a",
                                "sense_id": "1a282fb5-9079-3e73-88cc-1539b1ecfcf4",
                                "text": "Et pourquoi Diable faudrait-il « déboulevarder » notre Boulevard en le fermant à la fonction principale pour laquelle il a été construit, contourner facilement et au plus près, notre centre-ville déjà suffisamment cadenassé ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "54bb78a2-60cb-3653-8230-ea690eba1530",
                        "entry_id": "631cadc9-4a3a-3077-a069-898aa9c3271e",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e07c0fb-56c0-4c0f-8775-168d0d47cbf3",
                                "sense_id": "54bb78a2-60cb-3653-8230-ea690eba1530",
                                "text": "Il sentit qu’il lui fallait déboulevarder son champ visuel et sa vie en chavirant d’amour en brindezingue dans le fleuve des nouvelles dissidences."
                            }
                        ]
