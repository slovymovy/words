                ],
                "senses": [
                    {
                        "sense_id": "32f80917-557c-3ee8-a39c-b671729b398e",
                        "entry_id": "2bbbf337-405a-3e10-ac44-5390838c3358",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d351960d-5db8-4dad-a649-0fcd6cb5992a",
                                "sense_id": "32f80917-557c-3ee8-a39c-b671729b398e",
                                "text": "Frau Fröhling ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "960f86a4-9eac-4da5-886d-25c2724251b4",
                                "sense_id": "32f80917-557c-3ee8-a39c-b671729b398e",
                                "text": "Herr Fröhling wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "50ab89d1-56cd-472f-a5d9-79dd3ea5b3de",
                                "sense_id": "32f80917-557c-3ee8-a39c-b671729b398e",
                                "text": "Die Fröhlings fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "5d8b5571-3102-4c22-94fa-b833a2644e33",
                                "sense_id": "32f80917-557c-3ee8-a39c-b671729b398e",
                                "text": "Der Fröhling trägt nie die Schals, die die Fröhling ihm strickt."
                            },
                            {
                                "example_id": "2cdc46d8-c16f-4811-ba81-e3f45217b096",
                                "sense_id": "32f80917-557c-3ee8-a39c-b671729b398e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Fröhling kommt, geht der Herr Fröhling.“"
                            },
                            {
                                "example_id": "151ad502-6415-415f-b7d2-430d2faff567",
                                "sense_id": "32f80917-557c-3ee8-a39c-b671729b398e",
                                "text": "Fröhling kommt und geht."
                            },
                            {
                                "example_id": "2beb0c0e-8b19-4fee-9bd6-4ea29123a26b",
                                "sense_id": "32f80917-557c-3ee8-a39c-b671729b398e",
                                "text": "Fröhlings kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
