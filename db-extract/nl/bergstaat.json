                        "examples": [
                            {
                                "example_id": "e0d8a508-99cc-4a71-a52d-33763987235f",
                                "sense_id": "2add78bd-befe-3285-9995-ef56589cf509",
                                "text": "Dat was bij de oprichting wel anders. Het vertrouwen in elkaar was zo groot dat de ondertekenaars van het Verdrag tot oprichting van de Europese Economische Gemeenschap, oftewel het Verdrag van Rome, letterlijk een blanco papier tekenden. De goederenwagen waarin de teksten lagen, werd onderweg van Brussel naar Rome in Zwitserland losgekoppeld, waardoor de teksten in de bergstaat achterbleven. Later werden de handtekeningen bij de echte teksten gevoegd."
                            },
                            {
                                "example_id": "4f3a08a1-07e3-4518-9307-437bc0b521e9",
                                "sense_id": "2add78bd-befe-3285-9995-ef56589cf509",
                                "text": "Er liggen geen landmijnen meer in de bergstaat Nepal. Dat hebben de Verenigde Naties bekendgemaakt."
                            }
                        ]
                    }
