                        "glosses": [
                            "A wastefully extravagant person; a prodigal; a spendthrift."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ec023b4a-440a-4ec2-ac79-14a4bdb6ea60",
                                "sense_id": "60c62712-1bec-3747-acde-ba67992b80ff",
                                "text": "Every promise that thou therein dost utter, / Is as sure as it were sealed with butter, / Or a mouse tyed with a threed. Every good thing / Thou lettest even slip, like a waghalter slipstring."
                            },
                            {
                                "example_id": "e29a5339-3ca8-435c-9b39-88463dd81040",
                                "sense_id": "60c62712-1bec-3747-acde-ba67992b80ff",
                                "text": "Goinfre: m. A wag, ſlipſtring, knaviſh lad; a merrie conceited whoreſonne, a notable good fellow, an excellent companion."
                            },
                            {
                                "example_id": "0e0e6f0f-3ae1-4233-95d8-dfffcf069b4a",
                                "sense_id": "60c62712-1bec-3747-acde-ba67992b80ff",
                                "text": "Well, slip-string, I shall meet with you."
                            }
                        ]
                    }
