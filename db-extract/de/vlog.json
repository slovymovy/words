                            {
                                "example_id": "d1b4a77b-25d7-4995-bedd-dbee47498136",
                                "sense_id": "092e8f9a-8f7b-3b2d-bf15-768daa457a89",
                                "text": "Joy of Ritual hat auf ihrem Vlog ihre bevorzugten Silvester-Traditionen aus der ganzen Welt zusammengetragen:",
                                "translation": "Joy of Ritual разместила на своем видео-блоге некоторые из ее любимых новогодних традиции со всего мира:"
                            },
                            {
                                "example_id": "d667ad79-7e27-452e-bdcb-d6fd164665e0",
                                "sense_id": "092e8f9a-8f7b-3b2d-bf15-768daa457a89",
                                "text": "Jedem auf unseren Blog-(oder Vlog)Seiten veröffentlichten Video ist ein Texttranskript beigefügt.",
                                "translation": "При размещении видео на наших блогах (или влогах) мы всегда включаем текстовой транскрипт."
                            }
                        ]
