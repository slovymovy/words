                                "target_senses": [
                                    {
                                        "sense_id": "4ba01619-b09b-3e6e-8fb0-deebeeeb5b2b",
                                        "entry_id": "a9b5018e-3f62-39b9-99a7-b429f2cf5c31",
                                        "glosses": [
                                            "eine Person, die während einer Theateraufführung das Drehbuch mitliest und den Darstellern im Falle eines Aussetzers ihren Text zuflüstern kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfbc5c9e-42d1-4011-8846-602277ac0461",
                                                "sense_id": "4ba01619-b09b-3e6e-8fb0-deebeeeb5b2b",
                                                "text": "Mein Bruder arbeitet schon seit zwei Jahren als Souffleur im Stadttheater."
                                            },
                                            {
                                                "example_id": "4dce4983-9cb2-401f-b583-177f5edbcf7f",
                                                "sense_id": "4ba01619-b09b-3e6e-8fb0-deebeeeb5b2b",
                                                "text": "„Als künstlerisch sind die Dienste der Schauspieler, Sänger, (…), sowie des szenischen Dienstes, das sind etwa Trainingsmeister, Repetitoren, Souffleure und Inspizienten, kurzum solche Tätigkeiten zu bezeichnen, die dem Ausführenden eine gewisse »schöpferische Persönlichkeitskräfte entfaltende Individualität« gestatten.“"
                                            },
                                            {
                                                "example_id": "c2c40cae-e79a-4019-863f-83f0f32abf51",
                                                "sense_id": "4ba01619-b09b-3e6e-8fb0-deebeeeb5b2b",
                                                "text": "„Dieses Wortgefecht stimmte uns recht heiter, und die Jünger Thalias versprachen mir, ohne Souffleur auszukommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
