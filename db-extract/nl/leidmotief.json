                "translations": [
                    {
                        "translation_id": "5eb3a25e-106b-4c04-b4c2-8f9f3d2f3ee6",
                        "source_entry_id": "98a8b079-3060-3d13-8b0d-d8e34b75c771",
                        "source_sense_id": "2c190673-be2b-3652-b22a-5570f09bccc1",
                        "target_lang_word": "主导动机",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0e824d83-51d3-41ee-8632-680a62130ec2",
                        "source_entry_id": "98a8b079-3060-3d13-8b0d-d8e34b75c771",
                        "source_sense_id": "2c190673-be2b-3652-b22a-5570f09bccc1",
                        "target_lang_word": "Leitmotiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leitmotiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e901b05-739e-3f01-8d51-7c8a588f2ee2",
                                        "entry_id": "c9b4e8da-6b81-32d7-bc82-d52d909d7740",
                                        "glosses": [
                                            "künstlerisches Mittel, das, gekoppelt an einen zunächst außerkünstlerischen Inhalt, in der Gesamtheit des Werkes immer wieder zu finden ist"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e6456ea-0bad-4a8d-9b93-bb0d7971f7d0",
                                                "sense_id": "3e901b05-739e-3f01-8d51-7c8a588f2ee2",
                                                "text": "„Der Begriff des Leitmotivs tauchte erstmals 1871 in Friedrich Wilhelm Jähns’ Verzeichnis der Werke Carl Maria von Webers auf.“"
                                            },
                                            {
                                                "example_id": "1c91842e-a56f-40a0-a717-6ab651bde30d",
                                                "sense_id": "3e901b05-739e-3f01-8d51-7c8a588f2ee2",
                                                "text": "„Womöglich war Drehbuchautor Christian Jeltsch vom Einfall dieses Leitmotivs ein kleines bisschen zu elektrisiert.“"
                                            },
                                            {
                                                "example_id": "75d65adf-4abe-4381-9eee-5f115d6caa2d",
                                                "sense_id": "3e901b05-739e-3f01-8d51-7c8a588f2ee2",
                                                "text": "„Das kulturphilosophische Leitmotiv von Koralle und Rhizom ist von dem Gedanken getragen, dass in der Sinnstruktur des Menschen tatsächlich alles mit allem zusammenhängt.“"
                                            },
                                            {
                                                "example_id": "f65f357f-2353-476e-aeb4-79a73cb61254",
                                                "sense_id": "3e901b05-739e-3f01-8d51-7c8a588f2ee2",
                                                "text": "„So ist auch das Leitmotiv des Spiegels, des Spiegelbildes oder seines Fehlens nur eine subtile Variation des Doppelgängermotivs.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8bb8a03d-7e0f-30e5-8cee-4c47e1256920",
                                        "entry_id": "c9b4e8da-6b81-32d7-bc82-d52d909d7740",
                                        "glosses": [
                                            "Prinzip, das immer wieder eine Rolle spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b262532-9144-4899-aab7-815611a1c402",
                                                "sense_id": "8bb8a03d-7e0f-30e5-8cee-4c47e1256920",
                                                "text": "„Zu den Leitmotiven von Canettis Leben gehört schließlich sein Freiheitsdrang, der sich nicht nur in der Systemlosigkeit und der Distanz zu allen Ismen des 20. Jahrhunderts zeigt, sondern auch in der Verweigerung einer erkennbaren aktiven Mitgliedschaft in den Religionen des Judentums oder des Christentums.“"
                                            },
                                            {
                                                "example_id": "b22647a3-0d9a-420b-9787-99fc0d140156",
                                                "sense_id": "8bb8a03d-7e0f-30e5-8cee-4c47e1256920",
                                                "text": "„Immer wenn mir dieses unbewußte Leitmotiv entschlüpfte, erriet ich in ihren Blicken die Ironie von jungen, zwecklosen Gelehrten, die mich wieder einmal bei einem meiner archäologischen Ausrutscher ertappt hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec0765de-aead-4d5a-9b39-714e4457b584",
                        "source_entry_id": "98a8b079-3060-3d13-8b0d-d8e34b75c771",
                        "source_sense_id": "2c190673-be2b-3652-b22a-5570f09bccc1",
                        "target_lang_word": "leitmotif",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leitmotif",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc0f96bc-d918-38bc-83bf-017b9f8fe096",
                                        "entry_id": "bf13d3ca-54eb-3776-ac87-75f022836574",
                                        "glosses": [
                                            "A melodic theme associated with a particular character, place, thing or idea in an opera."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86154578-0416-4c1b-95b9-141ca88bf447",
                                                "sense_id": "fc0f96bc-d918-38bc-83bf-017b9f8fe096",
                                                "text": "In Wagner's operas, especially his cycle of four operas known collectively as the Ring cycle, the leitmotif did not simply label or point to one particular character or object but rather conjured up a realm of ideas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d137de6-0f9b-366b-aa18-f92d183e2aca",
                                        "entry_id": "bf13d3ca-54eb-3776-ac87-75f022836574",
                                        "glosses": [
                                            "A recurring theme."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "105b6d1b-9a1f-4933-bde6-b1cb4bf141fb",
                                                "sense_id": "6d137de6-0f9b-366b-aa18-f92d183e2aca",
                                                "text": "People have pointed out the influence of Wagner’s music on my work. Certainly I do not disclaim this influence. In particular, I followed Wagner in the use of the leitmotif, which I carried over into the work of language."
                                            },
                                            {
                                                "example_id": "1ddd615a-c6f7-4455-b4f2-1016ea16578a",
                                                "sense_id": "6d137de6-0f9b-366b-aa18-f92d183e2aca",
                                                "text": "If one looks for a pattern in the political life of John Connally, one finds a leitmotif of scandals which threatened but never destroyed his career."
                                            },
                                            {
                                                "example_id": "9b6d8d91-b83b-4dc8-9506-d9f5df197d89",
                                                "sense_id": "6d137de6-0f9b-366b-aa18-f92d183e2aca",
                                                "text": "Mann's adaptation of Wagner's technique and its development throughout his writing is analysed, including how Mann uses the leitmotif in a naturalistic, characterising and mechanical sense in Buddenbrooks, attaching it to persons and situations as etiquettes."
                                            },
                                            {
                                                "example_id": "72140d5d-20a0-4c6f-a55c-90126386183a",
                                                "sense_id": "6d137de6-0f9b-366b-aa18-f92d183e2aca",
                                                "text": "Such language about an American president from a European ally would have been unthinkable before Mr. Trump made outrage the leitmotif of his presidency, along with an assault on truth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5adf308a-ebe5-461f-91f0-7ff70ab6036c",
                        "source_entry_id": "98a8b079-3060-3d13-8b0d-d8e34b75c771",
                        "source_sense_id": "2c190673-be2b-3652-b22a-5570f09bccc1",
                        "target_lang_word": "leitmotiv",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leitmotiv",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88a816da-a9af-3666-b3f5-febe3fecaf56",
                                        "entry_id": "ddefcc5e-2eca-35a0-9e42-db718ecc3f16",
                                        "glosses": [
                                            "Thème qui revient fréquemment dans une partition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7e389ad-d04e-498a-825c-d9e5347db1f9",
                                                "sense_id": "88a816da-a9af-3666-b3f5-febe3fecaf56",
                                                "text": "Les personnages des drames lyriques de Richard Wagner sont en général caractérisés par un leitmotiv."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33e1abce-6987-303d-979b-57596a58ac27",
                                        "entry_id": "ddefcc5e-2eca-35a0-9e42-db718ecc3f16",
                                        "glosses": [
                                            "Phrase ou slogan qui revient régulièrement, d’une façon symbolique, dans un discours, un écrit."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1770575-3d62-4398-9bed-60c3b5b8823a",
                                                "sense_id": "33e1abce-6987-303d-979b-57596a58ac27",
                                                "text": "Puis, très volubile, il me donna un « digest » de la pensée politique des officiers de pacification : « Nous ne partirons pas », c’était le leitmotiv."
                                            },
                                            {
                                                "example_id": "8212d12e-8536-49a4-b51d-aef3c74ec557",
                                                "sense_id": "33e1abce-6987-303d-979b-57596a58ac27",
                                                "text": "Un leitmotiv principal à travers son œuvre est sans aucun doute la grande aversion qu'il porte contre cette génération fondamentalement dégénérée de soixante-huitards."
                                            },
                                            {
                                                "example_id": "0f28388d-babf-4a94-9eb2-47eadc8f74d0",
                                                "sense_id": "33e1abce-6987-303d-979b-57596a58ac27",
                                                "text": "Lancé en 2018, le réseau social fonctionne un peu comme Twitter, avec des profils à suivre et des \"parleys\" au lieu de tweets. La liberté d'expression est son leitmotiv."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "771c4608-01fa-4065-8a48-ea9a05c49180",
                        "source_entry_id": "98a8b079-3060-3d13-8b0d-d8e34b75c771",
