                "senses": [
                    {
                        "sense_id": "fdfbb907-fab8-3118-9833-898948600e40",
                        "entry_id": "e28c5925-efea-387d-a11e-dbc44508440d",
                        "glosses": [
                            "een begraafplaats waar lichamen van overleden personen worden begraven die zijn gestorven voor hun vaderland of die zich op bijzondere wijze voor hun vaderland hebben ingezet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf8ca3c0-d498-4c38-ac86-671246cdc2b2",
                                "sense_id": "fdfbb907-fab8-3118-9833-898948600e40",
                                "text": "Een symbolische eerste opgraving op het Nationaal Ereveld Loenen. De Bergings- en Identificatiedienst Koninklijke Landmacht (BIDKL) gaat 103 onbekende doden opgraven en hen proberen alsnog te identificeren."
                            },
                            {
                                "example_id": "eed16f2b-ad52-446e-9500-cab2a797c193",
                                "sense_id": "fdfbb907-fab8-3118-9833-898948600e40",
                                "text": "Achttien bemanningsleden, van wie er zeventien konden worden geïdentificeerd, kwamen daarbij om. Ze liggen begraven op het ereveld van de algemene begraafplaats in Markelo, waar zaterdagmiddag een eerbetoon aan hen werd gebracht door onder meer hooggeplaatste vertegenwoordigers uit Australië, Nieuw Zeeland, Engeland en Nederland."
                            },
                            {
                                "example_id": "7793bf60-10fa-4d11-b22e-32af5bcb8c61",
                                "sense_id": "fdfbb907-fab8-3118-9833-898948600e40",
                                "text": "Een in de Tweede Wereldoorlog gesneuvelde soldaat die 73 jaar na zijn dood naar zijn laatste rustplaats wordt gebracht. Volgens Volkmar Cremer van het Ministerie van Defensie komt het een paar keer per jaar voor. Zoals gistermorgen op het Ereveld Loenen."
                            }
                        ]
                    }
                ],
