                "senses": [
                    {
                        "sense_id": "d64adfba-934e-3845-8c1d-319645c08f69",
                        "entry_id": "22f148fb-cc1a-3b11-9597-33e639bd8f1d",
                        "glosses": [
                            "Réguler à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "470a8add-2dd3-4f85-9e84-374178a48b6b",
                                "sense_id": "d64adfba-934e-3845-8c1d-319645c08f69",
                                "text": "Ce n’est donc pas le seul secteur financier qui doit être « re-régulé » (comme on le dit si souvent), mais toute la vision que nous avons du sens de notre vie."
                            },
                            {
                                "example_id": "dcdf6a39-7bf4-4de3-80f1-cd7d005a4819",
                                "sense_id": "d64adfba-934e-3845-8c1d-319645c08f69",
                                "text": "Pour les convaincre, les gouvernements devront préalablement s’engager officiellement à ne pas « re-réguler »."
                            },
                            {
                                "example_id": "5a6b740d-24f3-40be-8cdd-6fd78fb0313c",
                                "sense_id": "d64adfba-934e-3845-8c1d-319645c08f69",
                                "text": "Difficulté supplémentaire : à cette hypersensibilité du borderline s'ajoute le besoin d'un temps plus long pour se re-réguler et retrouver son calme."
                            }
                        ]
                    }
