                        "source_sense_id": "03c352b4-9d32-3fd8-a28e-503fe7b04ef3",
                        "source_sense_description": "Sammelmappe aus Pappe für Akten, Zeichnungen und lose Blätter",
                        "target_lang_word": "portfolio",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
