                "senses": [
                    {
                        "sense_id": "8653ea23-b12e-3452-bc52-707615e71f0b",
                        "entry_id": "600491ac-ed36-3009-bdfa-6493f38dc9f4",
                        "glosses": [
                            "weibliche Person, die das Fach Germanistik studiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69a61cb7-115b-4560-9549-ec31ed2abd46",
                                "sense_id": "8653ea23-b12e-3452-bc52-707615e71f0b",
                                "text": "„Eine Germanistikstudentin hörte durch eine Freundin von der Gruppe.“"
                            },
                            {
                                "example_id": "474baf02-73b8-49ee-90e0-78e78230789c",
                                "sense_id": "8653ea23-b12e-3452-bc52-707615e71f0b",
                                "text": "„Und weil gerade ein Geschäftslokal frei wurde, haben die Germanistikstudentin und ihr Freund, der vorher Landmaschinen verkaufte, umgeschult.“"
                            },
                            {
                                "example_id": "9cc172f4-123f-4856-a459-fd39dc052981",
                                "sense_id": "8653ea23-b12e-3452-bc52-707615e71f0b",
                                "text": "„Bei einem Straßenfest stand ich mit zwei jungen Germanistikstudentinnen und einem Cellisten aus der Nachbarschaft herum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
