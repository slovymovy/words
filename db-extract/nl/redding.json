                                "sense_id": "8c5b006e-fcc7-3823-9eca-a4386623b72d",
                                "text": "De duikers waren betrokken bij de redding van de vermiste duiker.",
                                "translation": "The divers were involved in the rescue of the missing diver.",
                                "english": "The divers were involved in the rescue of the missing diver."
                            },
                            {
                                "example_id": "f1d49691-0b2d-4f7d-ad44-f01b32003a05",
                                "sense_id": "8c5b006e-fcc7-3823-9eca-a4386623b72d",
                                "text": "De brandweermannen zetten hun leven op het spel tijdens de redding van de mensen uit het brandende gebouw.",
                                "translation": "The firefighters risked their lives during the rescue of the people from the burning building.",
                                "english": "The firefighters risked their lives during the rescue of the people from the burning building."
                            },
                            {
                                "example_id": "3905921b-be8d-4e24-97ce-82d4fd7d07fd",
                                "sense_id": "8c5b006e-fcc7-3823-9eca-a4386623b72d",
                                "text": "Hij voelde een grote opluchting na de geslaagde redding van het drenkeling.",
                                "translation": "He felt a great relief after the successful rescue of the drowning person.",
                                "english": "He felt a great relief after the successful rescue of the drowning person."
                            }
                        ]
                    }
