                    {
                        "translation_id": "8ca160cd-9076-4145-9c33-2016f779438b",
                        "source_entry_id": "9324a9f1-e6f3-34d7-952f-3fbcac6afea7",
                        "source_sense_description": "Rastafarian",
                        "target_lang_word": "rasta",
