                    {
                        "sense_id": "6cd4b21f-c6f8-3cc3-b7ef-cf3bf560f87f",
                        "entry_id": "d476789b-b748-3606-ba00-9ba90c33a421",
                        "glosses": [
                            "Qui régénère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8485c309-aae6-4032-a852-047f082a84c9",
                                "sense_id": "6cd4b21f-c6f8-3cc3-b7ef-cf3bf560f87f",
                                "text": "Métier régénérateur à détordre, déflocher, carder et filer les matières filamenteuses."
                            },
                            {
                                "example_id": "ec605e27-bfed-45a0-83c7-29e990ad48d0",
                                "sense_id": "6cd4b21f-c6f8-3cc3-b7ef-cf3bf560f87f",
                                "text": "Après avoir pilé de la substance nerveuse de mouton, dans de l’eau distillée, il avait dû décanter et filtrer. Et il venait enfin d’obtenir une petite bouteille d’un liquide trouble, opalin, irisé de reflets bleuâtres, qu’il regarda longtemps à la lumière, comme s’il avait tenu le sang régénérateur et sauveur du monde."
                            }
                        ]
                    }
                ],
