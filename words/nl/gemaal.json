            "senses": [
                {
                    "sense_id": "b6e94cae-f8d7-3453-96b8-2e1e360a7bee",
                    "sense_definition": "Een installatie of gebouw met pompen voor het drooghouden van polders.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "waterbeheer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>gemaal</w> pompt het overtollige water uit de polder naar de ringvaart.",
                            "target_lang_translations": {
                                "it": "L'<w>idrovora</w> pompa l'acqua in eccesso dal polder verso il canale di scolo."
                            }
                        },
                        {
                            "text": "Tijdens de zware regenval draaide het <w>gemaal</w> op volle toeren.",
                            "target_lang_translations": {
                                "it": "Durante le forti piogge l'<w>idrovora</w> lavorava a pieno regime."
                            }
                        }
                    ],
                    "synonyms": [
                        "pompstation"
                    ],
                    "common_phrases": [
                        "gemaal draait"
                    ],
                    "target_lang_definitions": {
                        "it": "Un impianto o edificio dotato di pompe per drenare l'acqua dai polder."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "idrovora",
                                "target_lang_sense_clarification": "Impianto di sollevamento meccanico per il drenaggio di terreni bassi."
                            },
                            {
                                "target_lang_word": "stazione di pompaggio",
                                "target_lang_sense_clarification": "Termine generale per un impianto che sposta liquidi."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e61cb10a-d0fc-3480-bcf2-0f502d789e6f",
                    "sense_definition": "Het proces van het fijnmaken van graan.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "landbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>gemaal</w> van het graan gebeurde vroeger in de windmolen.",
                            "target_lang_translations": {
                                "it": "La <w>macinazione</w> del grano avveniva un tempo nel mulino a vento."
                            }
                        },
                        {
                            "text": "Door het <w>gemaal</w> wordt het graan verwerkt tot fijn meel.",
                            "target_lang_translations": {
                                "it": "Attraverso la <w>macinazione</w> il grano viene trasformato in farina fine."
                            }
                        }
                    ],
                    "synonyms": [
                        "maling"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Wordt in deze betekenis zelden meer gebruikt."
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Il processo di macinazione del grano."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "macinazione",
                                "target_lang_sense_clarification": "Il processo di ridurre in polvere cereali o altri materiali."
                            }
                        ]
                    }
                },
                {
