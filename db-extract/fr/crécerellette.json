                                "example_id": "1f6f9bcf-8f9d-45c9-a54c-2b0f0cef6d63",
                                "sense_id": "551aa4dc-6631-3d6b-919a-4d497ce2c0a9",
                                "text": "La crécerellette a un cri rauque, on dit qu'elle huit ou qu'elle réclame."
                            },
                            {
                                "example_id": "2781bfc7-d5d7-49ab-bee8-f78eea5c673b",
                                "sense_id": "551aa4dc-6631-3d6b-919a-4d497ce2c0a9",
                                "text": "La crécerellette, qui est une crécerelle en réduction, est inutilisable en fauconnerie."
                            }
                        ]
                    }
