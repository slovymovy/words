                "senses": [
                    {
                        "sense_id": "ef685515-4b51-3080-bbe5-03cca5680e1f",
                        "entry_id": "1ff78fb8-2c51-3682-8eda-fe4f501de4a4",
                        "glosses": [
                            "предназначенный для обработки чего-л. строганием"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f313e2fe-7250-477e-811f-a14c30b54aa7",
                                "sense_id": "ef685515-4b51-3080-bbe5-03cca5680e1f",
                                "text": "Двухсторонний шипорез. Четырёхсторонний строгальный. Многошпиндельный сверлильный… Станки пока молчат."
                            },
                            {
                                "example_id": "dc9636a6-e47d-4914-be8b-97b974ff2f44",
                                "sense_id": "ef685515-4b51-3080-bbe5-03cca5680e1f",
                                "text": "На нем с большой точностью выполняются фрезерные, строгальные, расточные и сверлильные операции на деталях весом до 160 т."
                            }
                        ]
                    }
