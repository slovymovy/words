                        "glosses": [
                            "een uiterste daad waarmee men een bepaald resultaat probeert te behalen terwijl men zich realiseert dat er niet veel kans is op succes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "423bdcb7-f9a2-4818-9eee-650c1245e89f",
                                "sense_id": "f7745999-fd78-30cb-8b73-b942a21d4185",
                                "text": "Het was geen rationele keus maar een wanhoopspoging."
                            },
                            {
                                "example_id": "284c3bcc-ccc1-4408-af6a-f56bfd203d6b",
                                "sense_id": "f7745999-fd78-30cb-8b73-b942a21d4185",
                                "text": "Ik ging terug naar het Banqueting House om zeker te stellen dat er geen laatste wanhoopspoging zou worden gedaan om de koning te redden."
                            },
                            {
                                "example_id": "c16b6ca7-554f-44a5-bfc3-2fb73a4a9ffc",
                                "sense_id": "f7745999-fd78-30cb-8b73-b942a21d4185",
                                "text": "Van der Poels allerlaatste wanhoopspoging om Van Baarle te achterhalen, bleek een chasse patate. Sprinter Kooij die reed de hele dag al slim en sterk vooraan, sloop mee met Van der Poel en maakte met een tweede plek de uitstekende dag voor Jumbo-Visma compleet."
                            },
                            {
                                "example_id": "bd650781-21e2-4a61-971a-be6ca7bbca72",
                                "sense_id": "f7745999-fd78-30cb-8b73-b942a21d4185",
                                "text": "Het gevecht om de voorzittershamer zit nu muurvast. In een wanhoopspoging het Huis weer aan het werk te krijgen wilden Republikeinen interim-voorzitter Patrick McHenry meer macht toekennen, zodat hij de meest dringende voorstellen kan agenderen. De Democraten en het Witte Huis stonden daar open voor, maar ook hierover konden de Republikeinen het niet eens worden."
                            }
                        ]
                    }
