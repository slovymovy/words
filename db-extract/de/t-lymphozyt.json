                "senses": [
                    {
                        "sense_id": "86caf0c1-b3a9-3f1e-9319-68d6d4e7311e",
                        "entry_id": "587ae7e8-33eb-3cf5-82cf-c37b35a1fb5f",
                        "glosses": [
                            "im Thymus herangereiftes Leukozyt; eine Zelle, die der Immunabwehr, besonders der Bekämpfung von (bekannten) eingedrungenen Krankheitserregern dient"
                        ],
                        "tags": [
                            "Immunologie"
                        ],
                        "examples": [
                            {
                                "example_id": "0e41716b-42e4-45e1-9413-d0718e6a8cb4",
                                "sense_id": "86caf0c1-b3a9-3f1e-9319-68d6d4e7311e",
                                "text": "T-Lymphozyten und B-Lymphozyten sind Teil der erworbenen (adaptiven) Immunantwort."
                            },
                            {
                                "example_id": "5ad19f04-4155-42c9-8a83-7c082467efa9",
                                "sense_id": "86caf0c1-b3a9-3f1e-9319-68d6d4e7311e",
                                "text": "„Das 'T' steht für Thymus, ein lymphatisches Organ in dem die Reifung der T-Lymphozyten abläuft. Dagegen erfolgt die Bildung der T-Zellen, wie bei allen weißen Blutkörperchen, im Knochenmark.“"
                            },
                            {
                                "example_id": "b370611a-c690-4a5b-8dee-59e75ec4858c",
                                "sense_id": "86caf0c1-b3a9-3f1e-9319-68d6d4e7311e",
                                "text": "„T-Lymphozyten durchlaufen eine Reifungsphase in einem bestimmten, relativ kleinen Organ im Brustbereich, der Thymusdrüse. In dieser Phase lernen die T-Lymphozyten, körperfremde oder veränderte Substanzen zu erkennen wie zum Beispiel Krankheitserreger oder veränderte (mutierte) körpereigene Zellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
