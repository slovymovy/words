{
    "word_family": [
        "grabber",
        "grabby"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "44954a8a-5f5a-399c-a3b6-ef79530b14a5",
                    "sense_definition": "To take hold of something or someone suddenly, roughly, or firmly.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>grabbed</w> her hand to pull her back from the cliff edge.",
                            "target_lang_translations": {
                                "ru": "Я <w>схватил</w> её за руку, чтобы оттащить от края обрыва.",
                                "pl": "<w>Chwyciłem</w> ją za rękę, żeby odciągnąć ją od krawędzi urwiska."
                            }
                        },
                        {
                            "text": "He managed to <w>grab</w> hold of the rail just before the boat turned.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>схватиться</w> за поручень как раз перед тем, как лодка повернула.",
                                "pl": "Zdołał <w>złapać</w> się poręczy tuż przed tym, jak łódź skręciła."
                            }
                        }
                    ],
                    "synonyms": [
                        "seize",
                        "grasp",
                        "clutch",
                        "snatch",
                        "catch"
                    ],
                    "common_phrases": [
                        "grab hold of",
                        "grab someone's hand",
                        "grab someone's arm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Схватить кого-то или что-то внезапно, грубо или крепко.",
                        "pl": "Nagle, gwałtownie lub mocno chwycić kogoś lub coś."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "схватить",
                                "target_lang_sense_clarification": "совершить действие быстро"
                            },
                            {
                                "target_lang_word": "хватать",
                                "target_lang_sense_clarification": "брать руками"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "chwycić",
                                "target_lang_sense_clarification": "wykonać czynność szybko"
                            },
                            {
                                "target_lang_word": "złapać",
                                "target_lang_sense_clarification": "uchwycić dłonią"
                            },
                            {
                                "target_lang_word": "porwać",
                                "target_lang_sense_clarification": "gwałtownie zabrać"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "863240d2-6c2f-3b41-82be-c5a055eebb81",
                    "sense_definition": "To get, collect, or pick up something quickly or informally.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "obtain_informal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will just <w>grab</w> my jacket and then we can leave.",
                            "target_lang_translations": {
                                "ru": "Я просто <w>захвачу</w> свою куртку, и мы сможем идти.",
                                "pl": "Tylko <w>wezmę</w> kurtkę i możemy wychodzić."
                            }
                        },
                        {
                            "text": "Come inside and <w>grab</w> a seat before the show starts.",
                            "target_lang_translations": {
                                "ru": "Заходи внутрь и <w>займи</w> место до начала шоу.",
                                "pl": "Wejdź do środka i <w>zajmij</w> miejsce, zanim zacznie się występ."
                            }
                        }
