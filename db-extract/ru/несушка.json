                                ]
                            },
                            {
                                "target_word": "layer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9af285d-cc43-3068-801f-77f95491b4c4",
                                        "entry_id": "07457b09-dcf5-369c-b05d-9c689a2f4835",
                                        "glosses": [
                                            "To cut or divide into layers."
