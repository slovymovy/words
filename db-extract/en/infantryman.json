                                        "examples": [
                                            {
                                                "example_id": "18646fa1-19f3-45ce-a019-07f5107e1c70",
                                                "sense_id": "1d39a4bb-deb5-393d-b514-239bf9fbca0b",
                                                "text": "19 września o godz. 19 na Rynku Głównym w Krakowie rozpocznie się kolejny marszon. Tym razem piechurzy będą musieli przejść około 100 km […]"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "31843fb8-5e65-3e2e-9d35-f38e1dc13787",
                                        "entry_id": "6061aa8a-31ea-3d41-9b06-a98e892dd1f2",
                                        "glosses": [
                                            "żołnierz piechoty"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3822fa5f-5ba8-49ed-bc07-e8645dceb73f",
                                                "sense_id": "31843fb8-5e65-3e2e-9d35-f38e1dc13787",
                                                "text": "Bruzdami szarych ziemniaczysk wracały gęsiego drużyny piechurów. Karabiny nieśli niedbale na ramionach jak kosy"
                                            },
                                            {
                                                "example_id": "d4fde3e3-8bb8-4d00-a1c6-5f9beab319c7",
                                                "sense_id": "31843fb8-5e65-3e2e-9d35-f38e1dc13787",
                                                "text": "Celny ogień z daleka na pewno zepchnął część piechurów w głąb okopów: tych mniej odważnych, trzeźwiej myślących, rannych czy oszołomionych zbyt bliskimi wybuchami"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
