            {
                "entry_id": "20a2a716-7cda-345e-ad49-36f91fb2e8f6",
                "word": "chabraque",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a229ca7b-b006-457d-9c94-1a4103a73cca",
                        "entry_id": "20a2a716-7cda-345e-ad49-36f91fb2e8f6",
                        "tags": [
                            "plural"
                        ],
                        "form": "chabraques"
                    },
                    {
                        "form_id": "0314ed35-a9c3-4402-9376-83ea52b6ba82",
                        "entry_id": "20a2a716-7cda-345e-ad49-36f91fb2e8f6",
                        "tags": [],
                        "form": "schabraque"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b2b7f1a4-7298-3308-9b5e-b3e3999e8ec8",
                        "entry_id": "20a2a716-7cda-345e-ad49-36f91fb2e8f6",
                        "glosses": [
                            "Sorte de couverture qu’on étend sous ou sur la selle des chevaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d4cfa7e-a2a9-42fd-9fc7-0886b4ce9a5c",
                                "sense_id": "b2b7f1a4-7298-3308-9b5e-b3e3999e8ec8",
                                "text": "S'il commet le délit en emmenant son cheval de la compagnie, avec la selle, la housse ou la chabraque, il sera puni de la même peine pour sept ans."
                            },
                            {
                                "example_id": "60a072fb-9111-425e-97b7-f395f5b2c7c9",
                                "sense_id": "b2b7f1a4-7298-3308-9b5e-b3e3999e8ec8",
                                "text": "Son colonel l’avait chargé d’une ennuyeuse mission, achat d’équipements militaires, corvée de bottes, de selles, de schabraques."
                            },
                            {
                                "example_id": "cc6b437b-4cbb-48b2-9e4d-0878fe245a48",
                                "sense_id": "b2b7f1a4-7298-3308-9b5e-b3e3999e8ec8",
                                "text": "Bienaimé mit le pied à l’étrier et se hissa en selle avec un peu d’effort. Cette selle était la dernière splendeur qui lui restait. Mais la chabraque manquait. Un sac la remplaçait."
                            }
                        ]
                    },
                    {
                        "sense_id": "360d3ff7-d8a2-3549-97f8-744d012d3879",
                        "entry_id": "20a2a716-7cda-345e-ad49-36f91fb2e8f6",
                        "glosses": [
                            "Prostituée qui suit les armées, femme de mœurs légères."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "29954b83-c44f-4ddf-85b7-21348699e7b4",
                                "sense_id": "360d3ff7-d8a2-3549-97f8-744d012d3879",
                                "text": "Sa beauté ne diminua pas. Elle résistait à toutes les avaries. Et, cependant, la vie qu'elle menait devait faire très vite d'elle ce qu'on appelle entre cavaliers une vieille chabraque, si cette vie de perdition avait duré."
                            },
                            {
                                "example_id": "4600e2c4-043f-4ecd-b0af-74a72d1c820a",
                                "sense_id": "360d3ff7-d8a2-3549-97f8-744d012d3879",
                                "text": "— Ah ! c’est trop fort ! vous le savez bien où elle est, puisque vous l’avez envoyé chercher.\n — Moi !\n — Oui, vous, et par une gourgandine, encore… une grande chabraque habillée comme une sauteuse…[…]"
                            }
                        ]
                    },
                    {
                        "sense_id": "c8d94f2a-5f19-342c-b807-2cdef7daa9f7",
                        "entry_id": "20a2a716-7cda-345e-ad49-36f91fb2e8f6",
                        "glosses": [
                            "Femme laide, laideron."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ceb2293a-23ab-4c67-8bfa-24e6736027ea",
                        "source_entry_id": "20a2a716-7cda-345e-ad49-36f91fb2e8f6",
                        "target_lang_word": "Schabracke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schabracke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0130fa9a-4b41-3ca7-8883-bbcb01424fad",
                                        "entry_id": "bd550fe4-dff0-3af2-a7d0-ef20adabfa6d",
                                        "glosses": [
                                            "eine besondere Form der Satteldecke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4a82106-ec4e-4a30-b8cb-484155acf7be",
                                                "sense_id": "0130fa9a-4b41-3ca7-8883-bbcb01424fad",
                                                "text": "Nun, der Herr Obrist hätte ebensogut einziehen können wie einer durch den Argen Trumph (Arc de triomphe), und ich hätte dem Schimmel die neue Schabracke aufgelegt - Zacker, der hätte die Ohren gespitzt!"
                                            },
                                            {
                                                "example_id": "7e763a08-ecd0-4936-a9ed-14448979dc7d",
                                                "sense_id": "0130fa9a-4b41-3ca7-8883-bbcb01424fad",
                                                "text": "Als die acht Tage herum waren, hatte sie eine wunderschöne Schabracke gestickt, mit der schickte sie ihn auf den Markt, er dürfe sie aber nicht anders geben als für fünfhundert Gulden."
                                            },
                                            {
                                                "example_id": "6c059435-9bbc-48ae-a898-9e84d9a09a28",
                                                "sense_id": "0130fa9a-4b41-3ca7-8883-bbcb01424fad",
                                                "text": "„Wer zu den Reitern will, muss ein Pferd mitbringen, auch einen Sattel mit Schabracke und einen Woilach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "42af1cb1-a383-3d07-84a7-a2688dec082d",
                                        "entry_id": "bd550fe4-dff0-3af2-a7d0-ef20adabfa6d",
                                        "glosses": [
                                            "unattraktive, ungepflegte, auch streitsüchtige, zänkische oder ältere Frau, Ehefrau oder Schwiegermutter (Österreich, Deutschland: Niederrhein, Westfalen, Mitteldeutschland, Ostdeutschland)"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eedc4bc5-5582-4116-a815-01fbf9e5a662",
                                                "sense_id": "42af1cb1-a383-3d07-84a7-a2688dec082d",
                                                "text": "Inzwischen ist aus der Diva eine Schabracke geworden. (Der Tagesspiegel online, Alte Diva ohne Partner, 19.12.2003)"
                                            },
                                            {
                                                "example_id": "4f762b0c-7c3a-48dd-a26e-d1c157e51f2d",
                                                "sense_id": "42af1cb1-a383-3d07-84a7-a2688dec082d",
                                                "text": "Mit aufgedonnerten Haaren, schwarz anlackiert und mit Strass-Schabracke als Kleidervorhang: Prädestiniert zur Tunten-Mutti der Nation, die sie in der Tat lange war."
                                            },
                                            {
                                                "example_id": "8288f755-1df5-4c5e-9e14-21518259895d",
                                                "sense_id": "42af1cb1-a383-3d07-84a7-a2688dec082d",
                                                "text": "„…sie hatte ihr Klavier zur Verfügung gestellt, die alte Schabracke, und ihren Salon, ihre Partituren…“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "faa180a2-e713-3feb-b790-e17125b205f0",
                                        "entry_id": "bd550fe4-dff0-3af2-a7d0-ef20adabfa6d",
                                        "glosses": [
                                            "Stoffleiste an der Gardinenleiste, Übergardine"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f9ce811-325f-44d0-88f1-436eddc6c656",
                                                "sense_id": "faa180a2-e713-3feb-b790-e17125b205f0",
                                                "text": "Verwendung findet alles – die silberne Halterung für die Troddeln, die im Wohnzimmer eine Schabracke zieren, waren einmal Joghurtbecher und der scheinbar uralte geraffte Vorhang eine Mülltüte."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e0ddb209-9ad0-3a61-869d-67c6894ccaa2",
                                        "entry_id": "bd550fe4-dff0-3af2-a7d0-ef20adabfa6d",
                                        "glosses": [
                                            "Sattelfleck, ein Zeichnungsmuster bei mehreren Tierarten (abgeleitet von [1])"
                                        ],
                                        "tags": [
                                            "Jägersprache"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abb494bf-e8ad-4220-9204-668c3708c9e6",
