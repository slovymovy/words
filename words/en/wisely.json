{
    "word_family": [
        "wise",
        "wisdom",
        "wiseacre"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d944e18e-da65-3cd2-890e-8527bc92ef0c",
                    "sense_definition": "In a manner that shows good judgment or intelligence.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>wisely</w> decided to check her work before submitting it.",
                            "target_lang_translations": {
                                "ru": "Она <w>му́дро</w> решила проверить свою работу перед тем, как сдать её."
                            }
                        },
                        {
                            "text": "The manager <w>wisely</w> chose to <w>act</w> <w>wisely</w> during the crisis.",
                            "target_lang_translations": {
                                "ru": "Менеджер <w>разу́мно</w> решил действовать <w>му́дро</w> во время кризиса."
                            }
                        }
                    ],
                    "synonyms": [
                        "sensibly",
                        "judiciously",
                        "intelligently"
                    ],
                    "antonyms": [
                        "foolishly",
                        "unwisely"
                    ],
                    "common_phrases": [
                        "act wisely",
                        "choose wisely"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поступая разумно, рассудительно или проявляя здравый смысл."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "му́дро",
                                "target_lang_sense_clarification": "выражает действие, основанное на глубоком понимании и здравом смысле"
                            },
                            {
                                "target_lang_word": "разу́мно",
                                "target_lang_sense_clarification": "выражает логичный и взвешенный подход к ситуации"
                            },
                            {
                                "target_lang_word": "рассуди́тельно",
                                "target_lang_sense_clarification": "подчеркивает обдуманность и осторожность в принятии решений"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d3dd9b1d-105d-34f5-9b06-ce5d30698129",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Wisely</w> family moved to the city last year.",
                            "target_lang_translations": {
