                                        "sense_id": "f71bfbc0-be62-3c6f-9271-4e6a0405b850",
                                        "entry_id": "9733c8ec-8bb7-3cc0-a360-b42f53a726b1",
                                        "glosses": [
                                            "A dollar bill."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52e329c8-72e8-4a3c-8a41-e9c82061ae7c",
                                                "sense_id": "f71bfbc0-be62-3c6f-9271-4e6a0405b850",
                                                "text": "[…] maybe two or three twenties, a dozen tens, and twenty or thirty fins. The rest is all aces and silver."
                                            },
                                            {
                                                "example_id": "56bf5072-d5fe-47be-a7ce-11b632e58ab0",
                                                "sense_id": "f71bfbc0-be62-3c6f-9271-4e6a0405b850",
                                                "text": "If they got too many aces (dollar bills) or fives or tens, they turned them in to the vault where they became part of the reserve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba754d2f-7d0a-3be8-8c25-94894092a327",
                                        "entry_id": "9733c8ec-8bb7-3cc0-a360-b42f53a726b1",
                                        "glosses": [
                                            "A very small quantity or degree; a particle; an atom; a jot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fc94ca6-d084-4d27-80f7-cd8d0e4e56bb",
                                                "sense_id": "ba754d2f-7d0a-3be8-8c25-94894092a327",
                                                "text": "He will not bate an ace of absolute certainty."
                                            },
                                            {
                                                "example_id": "b8128505-95d2-4b34-be7b-98ec05ccbcd9",
                                                "sense_id": "ba754d2f-7d0a-3be8-8c25-94894092a327",
                                                "text": "I'LL not wag an ace farther: The whole World ſhall not bribe me to it;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49be8c24-8c26-33ed-bc07-f4c5e25d846c",
                                        "entry_id": "9733c8ec-8bb7-3cc0-a360-b42f53a726b1",
                                        "glosses": [
                                            "A serve won without the opponent hitting the ball."
