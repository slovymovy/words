                "senses": [
                    {
                        "sense_id": "f721ea09-0f5d-3d2e-b334-03b52b981681",
                        "entry_id": "9a20d18b-b468-35cb-97bf-6c32a25dcda3",
                        "glosses": [
                            "Résultat impeccable, sans erreur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8be0af11-30a2-4434-8e03-1911a647c7af",
                                "sense_id": "f721ea09-0f5d-3d2e-b334-03b52b981681",
                                "text": "Bien aidée par un sans-faute (20 / 20) derrière la carabine — surtout au moment du duel à 4 sur le dernier tir —, elle a devancé l’Italienne Dorothea Wierer et la Suédoise Elvira Öberg."
                            },
                            {
                                "example_id": "5c03ac6e-b14e-4594-be9a-28cce3ba99c3",
                                "sense_id": "f721ea09-0f5d-3d2e-b334-03b52b981681",
                                "text": "En trophée Sauffier, la paire Patrice Colas et Bastian Warin décroche elle aussi une très belle 5ᵉ place après un sans-faute lors des poules."
                            },
                            {
                                "example_id": "c64cca29-16ce-4467-9012-9b4213d08741",
                                "sense_id": "f721ea09-0f5d-3d2e-b334-03b52b981681",
                                "text": "À 27 ans, le Brestois Romain Del Castillo vit le plus beau démarrage de sa carrière en championnat et n’est pas pour rien dans le sans-faute de son équipe, surprenant leader avec Monaco."
                            }
                        ]
                    }
