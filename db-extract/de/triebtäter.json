                                            {
                                                "example_id": "63aedd13-09ee-43c6-a33d-3b8d8ccd3958",
                                                "sense_id": "bbd5e39c-ded8-3076-8c72-1f812804630c",
                                                "text": "Soon after our case, another convicted sex offender was released back into our community and was accepted as if nothing had happened."
                                            },
