{
    "word_family": [
        "nabber"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "39eb5beb-ad75-3d41-884b-eb410fa649e3",
                    "sense_definition": "To seize or arrest a criminal or fugitive",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "seize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police managed to <w>nab</w> the thief as he tried to escape through the back alley.",
                            "target_lang_translations": {
                                "cs": "Policii se podařilo zloděje <w>sebrat</w>, když se pokoušel utéct zadní uličkou."
                            }
                        },
                        {
                            "text": "Detectives worked for months to <w>nab</w> the suspect before he could leave the country.",
                            "target_lang_translations": {
                                "cs": "Detektivové pracovali měsíce na tom, aby podezřelého <w>dopadli</w>, než stihne opustit zemi."
                            }
                        }
                    ],
                    "synonyms": [
                        "nick",
                        "bust",
                        "cop"
                    ],
                    "common_phrases": [
                        "nab a criminal"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal term for arresting someone"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Dopadnout nebo zatknout zločince či uprchlíka"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "sebrat",
                                "target_lang_sense_clarification": "hovorově zatknout"
                            },
                            {
                                "target_lang_word": "sbalit",
                                "target_lang_sense_clarification": "hovorově dopadnout"
                            },
                            {
                                "target_lang_word": "čapnout",
                                "target_lang_sense_clarification": "neformálně chytit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c352076-3a68-30be-ae53-9d4e0d40b00b",
                    "sense_definition": "To grab or snatch something quickly",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "seize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I managed to <w>nab</w> the last seat on the train before it pulled away from the station.",
                            "target_lang_translations": {
                                "cs": "Podařilo se mi <w>urvat</w> poslední místo ve vlaku, než vyjel ze stanice."
                            }
                        },
                        {
                            "text": "He reached out to <w>nab</w> the falling glass before it hit the floor.",
                            "target_lang_translations": {
                                "cs": "Natáhl se, aby <w>lapil</w> padající sklenici, než dopadla na zem."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nab a seat"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal term for grabbing something"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Rychle něco uchopit nebo popadnout"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "lapnout",
                                "target_lang_sense_clarification": "rychle chytit"
                            },
                            {
                                "target_lang_word": "popadnout",
                                "target_lang_sense_clarification": "rychle vzít"
                            },
                            {
                                "target_lang_word": "urvat",
                                "target_lang_sense_clarification": "hovorově získat pro sebe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7fe2224-61c0-3e65-9d1a-a384e8579a43",
                    "sense_definition": "To steal or copy another user's online post",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "seize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some users will <w>nab</w> popular content from other forums and repost it as their own.",
                            "target_lang_translations": {
                                "cs": "Někteří uživatelé <w>ukradnou</w> populární obsah z jiných fór a znovu ho zveřejní jako svůj vlastní."
                            }
                        },
                        {
                            "text": "It is considered rude to <w>nab</w> someone else's creative post without giving them proper credit.",
                            "target_lang_translations": {
                                "cs": "Považuje se za neslušné <w>zkopírovat</w> cizí kreativní příspěvek bez uvedení autora."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in internet and social media contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Ukrást nebo zkopírovat příspěvek jiného uživatele na internetu"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ukrást",
                                "target_lang_sense_clarification": "přivlastnit si cizí obsah"
                            },
                            {
                                "target_lang_word": "zkopírovat",
                                "target_lang_sense_clarification": "převzít cizí příspěvek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eff08fbc-44bf-3e70-8530-df43e678a11f",
                    "sense_definition": "The summit or top of a hill",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers reached the <w>nab</w> just as the sun began to set over the valley.",
                            "target_lang_translations": {
                                "cs": "Turisté dorazili na <w>vrchol</w> právě ve chvíli, kdy slunce začalo zapadat za údolí."
                            }
                        },
                        {
                            "text": "From the rocky <w>nab</w>, one could see the entire coastline stretching out for miles.",
                            "target_lang_translations": {
                                "cs": "Ze skalnatého <w>vršku</w> bylo vidět celé pobřeží táhnoucí se na míle daleko."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used primarily in Northern England"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vrchol nebo horní část kopce"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vrchol",
                                "target_lang_sense_clarification": "nejvyšší bod kopce"
                            },
                            {
                                "target_lang_word": "vršek",
                                "target_lang_sense_clarification": "horní část kopce"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c5907bf-eb71-3c0c-89fd-03694a273ee0",
                    "sense_definition": "The part of a gunlock that catches the bolt",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mechanical_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The internal <w>nab</w> of the lock mechanism was worn down after years of heavy use.",
                            "target_lang_translations": {
                                "cs": "Vnitřní <w>záchyt</w> mechanismu zámku byl po letech intenzivního používání opotřebovaný."
                            }
                        },
                        {
                            "text": "He carefully inspected the <w>nab</w> to ensure the bolt would slide correctly into place.",
                            "target_lang_translations": {
                                "cs": "Pečlivě zkontroloval <w>záchyt</w>, aby se ujistil, že závora správně zapadne na své místo."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Technical term for older mechanical locks"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Část zámku zbraně, která zachytává závěr"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "záchyt",
                                "target_lang_sense_clarification": "mechanická součástka"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d86b348f-f586-3fb1-9a98-e4cc8f70e552",
                    "sense_definition": "The keeper or box into which a lock bolt is shot",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mechanical_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bolt failed to engage with the <w>nab</w> because the door was slightly misaligned.",
                            "target_lang_translations": {
                                "cs": "Závora nezapadla do <w>protiplechu</w>, protože dveře byly mírně vychýlené."
                            }
                        },
                        {
                            "text": "He replaced the old metal <w>nab</w> to make the door lock more securely.",
                            "target_lang_translations": {
                                "cs": "Vyměnil starý kovový <w>protiplech</w>, aby se dveře zamykaly bezpečněji."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Technical term for older mechanical locks"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Protikus nebo otvor, do kterého zapadá střelka zámku"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "protiplech",
                                "target_lang_sense_clarification": "část zámku v zárubni"
                            },
                            {
                                "target_lang_word": "střelkový otvor",
                                "target_lang_sense_clarification": "místo pro střelku zámku"
                            }
                        ]
                    }
                }
            ]
        },
        {
