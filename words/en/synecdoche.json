    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "934ff624-81b3-3a41-826c-da51f8c7e808",
                    "sense_definition": "A figure of speech where a part is used to represent the whole, or the whole is used to represent a part.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "rhetorical_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The phrase 'all hands on deck' is a common <w>synecdoche</w> where hands represent the entire crew."
                        },
                        {
                            "text": "Using the word 'wheels' to refer to a car is a classic <w>synecdoche</w> in everyday language."
                        }
                    ],
                    "synonyms": [
                        "synecdochy"
                    ],
                    "common_phrases": [
                        "common synecdoche",
                        "classic synecdoche"
                    ]
                },
                {
                    "sense_id": "ab096ce6-9102-3784-93a7-b07217d81a56",
                    "sense_definition": "The act or practice of using a part to represent the whole in speech or writing.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "rhetorical_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author relies heavily on <w>synecdoche</w> to create vivid imagery throughout the novel."
                        },
                        {
                            "text": "His clever use of <w>synecdoche</w> helped the audience understand the complex theme of the poem."
                        }
                    ],
                    "common_phrases": [
                        "use of synecdoche"
                    ]
                }
            ]
        }
    ]
