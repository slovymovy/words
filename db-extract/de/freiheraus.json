                                        "examples": [
                                            {
                                                "example_id": "56b57422-009b-4203-ac47-45419d9169a4",
                                                "sense_id": "182d1a54-46a4-3937-a90c-78e4ed72766e",
                                                "text": "We achieved outright domination."
                                            },
