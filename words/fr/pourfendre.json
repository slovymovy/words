                    "frequency": "Middle",
                    "semantic_group_id": "critique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le journaliste n'hésite jamais à <w>pourfendre</w> les dérives du pouvoir dans ses articles hebdomadaires."
                        },
                        {
                            "text": "Durant toute la campagne électorale, la candidate a <w>pourfendu</w> les injustices sociales avec force."
                        }
                    ],
                    "synonyms": [
