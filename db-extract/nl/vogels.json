                "forms": [],
                "senses": [
                    {
                        "sense_id": "b0b8a581-3c51-3da7-b336-2ce186db4b92",
                        "entry_id": "442fbdef-7fac-32f6-a397-481311218b5d",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord vogel"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "5cffe3ac-7c5e-4d93-863e-d4a0ba321e9a",
                                "sense_id": "b0b8a581-3c51-3da7-b336-2ce186db4b92",
                                "text": "En toen vlogen de vogels weg en veranderden hun namen in kussen, een stilte waarin een nieuwe wereld werd gespeld."
                            },
                            {
                                "example_id": "1e2a84c0-b73b-43ed-b9df-a9343bf2cffe",
                                "sense_id": "b0b8a581-3c51-3da7-b336-2ce186db4b92",
                                "text": "Overal waar je keek zag je leven in de woestijn. Duikende vogels, mieren, hagedissen en het onophoudelijke gezang van de krekels."
                            }
                        ]
                    },
                    {
                        "sense_id": "bbc7157c-da70-3191-9ccb-bf31996abdef",
                        "entry_id": "442fbdef-7fac-32f6-a397-481311218b5d",
                        "glosses": [
                            "een klasse Aves uit de chordadieren (Chordata), warmbloedige dieren met een skelet en veren waarvan de twee voorste ledematen zich tot vleugels hebben ontwikkeld"
                        ],
                        "tags": [
                            "meervoudsvorm als officiële benaming",
                            "dieren"
                        ],
                        "examples": [
                            {
                                "example_id": "1bd82df8-f7ac-483e-908c-0cc569478a64",
                                "sense_id": "bbc7157c-da70-3191-9ccb-bf31996abdef",
                                "text": "Vogels hebben relatief veel energie nodig: meer dan spinnen. Wereldwijd verbruiken ze net zoveel energie per jaar als de stad New York."
                            }
                        ]
                    }
