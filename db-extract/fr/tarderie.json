                        "examples": [
                            {
                                "example_id": "2b927bdd-4e6b-480e-a023-729826411e6d",
                                "sense_id": "5ddc03da-51b2-39e5-ba6c-a2e0b8e0998c",
                                "text": "De près elle est peut-être blèche, une tarderie loucheuse montée sur des quilles à varices."
                            },
                            {
                                "example_id": "539acf8c-fea2-4013-8cf7-a18c9aac054d",
                                "sense_id": "5ddc03da-51b2-39e5-ba6c-a2e0b8e0998c",
                                "text": "Carmant leurs soucoupes en gentleman, et sans un regard pour la tarderie agressive, il a fait aux deux frangines la bonne surprise de les emballer dans sa charrette."
                            },
                            {
                                "example_id": "141028d7-a5be-4e40-8534-e844475425ab",
                                "sense_id": "5ddc03da-51b2-39e5-ba6c-a2e0b8e0998c",
                                "text": "C’est-à-dire, dans son langage : tarderie. Et tarderie provinciale. Non seulement elle est moche, mais elle est en outre vieillissante ; et pis encore que vieillissante, elle est godiche."
                            }
                        ]
