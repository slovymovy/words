                        "entry_id": "f8183a6b-89a3-3d95-8214-7c9feb2e0e7e",
                        "glosses": [
                            "Donner des centres multiples à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4938667-72ec-47fb-bc91-e8497006ddd1",
                                "sense_id": "2dfd616d-a2c5-3160-af9f-28749cbd0378",
                                "text": "En terme de territoire, c’est presque revenir au département de la Seine et porter un regard inversé sur la périphérie : polycentrer la métropole parisienne."
                            },
                            {
                                "example_id": "c49071b4-4e10-4924-93f1-54d85733a150",
                                "sense_id": "2dfd616d-a2c5-3160-af9f-28749cbd0378",
                                "text": "Il y a nécessité de rompre avec ces modèles mentaux, de polycentrer la vision et de regarder l’avenir de plusieurs points de vue à la fois."
                            }
                        ]
                    }
