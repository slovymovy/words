                ],
                "senses": [
                    {
                        "sense_id": "aaa0cae0-52ee-3bb7-8070-c87fdadde1bf",
                        "entry_id": "0d7279f1-48a0-3b6b-97db-1c24be8c0ef7",
                        "glosses": [
                            "begründete Bewertung der Kenntnisse und Kompetenzen eines Schülers oder Beamten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2567acfc-abda-4599-9acb-7dbd6acc2e9d",
                                "sense_id": "aaa0cae0-52ee-3bb7-8070-c87fdadde1bf",
                                "text": "„Für die Beurteilung eines Landeslehrers sieht das hier unstrittig anzuwendende Landeslehrer-Dienstrechtsgesetz (LDG 1984) ein eigenes Verfahren zur Leistungsfeststellung vor (§§ 61 ff).“"
                            },
                            {
                                "example_id": "306dc351-8546-4313-86df-b2772d05c0a3",
                                "sense_id": "aaa0cae0-52ee-3bb7-8070-c87fdadde1bf",
                                "text": "„Die Notenkonferenzen zu Semesterende dienten der Leistungsfeststellung und Notengebung und stellten daher einen Teil der Nacharbeiten zum Unterricht dar.“"
                            },
                            {
                                "example_id": "2875a878-a590-47f3-b459-09b23e37ec05",
                                "sense_id": "aaa0cae0-52ee-3bb7-8070-c87fdadde1bf",
                                "text": "„Um sich anzumelden, bringen die Schüler das Zeugnis für die besondere Leistungsfeststellung zum Erwerb des qualifizierenden Abschlusses der Mittelschule mit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ea3b421a-2634-3a2c-8ce6-6b42a78507b1",
                        "entry_id": "0d7279f1-48a0-3b6b-97db-1c24be8c0ef7",
                        "glosses": [
                            "Festsetzung zustehender Zahlungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d77ba348-17c4-4ee6-8723-330ab8b912ae",
                                "sense_id": "ea3b421a-2634-3a2c-8ce6-6b42a78507b1",
                                "text": "„Werden berufliche Maßnahmen der Rehabilitation nach § 122 gewährt, so gebührt Übergangsgeld ab dem Stichtag für die Leistungsfeststellung (§ 104 Abs. 2).“"
                            },
                            {
                                "example_id": "be80d506-d4c7-4daf-a48f-6e5aebed6e72",
                                "sense_id": "ea3b421a-2634-3a2c-8ce6-6b42a78507b1",
                                "text": "„Bemessungsgrundlage für die Leistungsfeststellung in der Unfallversicherung ist ja ein sehr aktueller Wert, nämlich der letzte Jahresarbeitsverdienst, der erst einer entsprechend späteren Valorisierung bedarf.“"
                            },
                            {
                                "example_id": "cdf84b06-2a40-4046-a36a-f2d2034ebda7",
                                "sense_id": "ea3b421a-2634-3a2c-8ce6-6b42a78507b1",
                                "text": "„Der Antrag ist bei dem Versicherungsträger zu stellen, an den der letzte deutsche Beitrag gezahlt wurde oder als gezahlt gilt und der für die Leistungsfeststellung zuständig ist.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
