                "senses": [
                    {
                        "sense_id": "8925cbcc-fb8c-3896-9aba-ba4add117b7b",
                        "entry_id": "cf0f03fc-d1ec-3dbc-ae5c-a2e0a4995252",
                        "glosses": [
                            "Grabung, bei der die Grabungsstelle vorsichtig untersucht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9a98d09-0776-4bb9-8f14-bf70d0d77459",
                                "sense_id": "8925cbcc-fb8c-3896-9aba-ba4add117b7b",
                                "text": "„Auf dem römisch-germanischen Schlachtfeld bei Kalefeld im Landkreis Northeim hat jetzt die erste Sondierungsgrabung stattgefunden.“"
                            },
                            {
                                "example_id": "c8bcaf6d-3756-4ebe-be38-76feca4cfbe0",
                                "sense_id": "8925cbcc-fb8c-3896-9aba-ba4add117b7b",
                                "text": "„Regierungsvizepräsident Josef Kreuzberger stellte heute gemeinsam mit Archäologen des Landesamtes für Denkmalpflege beim Regierungspräsidium Stuttgart einen herausragenden Fund im Rahmen einer Sondierungsgrabung der Öffentlichkeit vor.“"
                            },
                            {
                                "example_id": "7af98812-48bb-4908-825b-a3959bfa6b30",
                                "sense_id": "8925cbcc-fb8c-3896-9aba-ba4add117b7b",
                                "text": "„Im Vorfeld eines Bauvorhabens in der Tocklergasse wurde eine Sondierungsgrabung unter der Leitung der Archäologin A. Köber durchgeführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
