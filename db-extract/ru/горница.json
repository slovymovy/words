                "senses": [
                    {
                        "sense_id": "ec0cc8b1-03d3-3bc2-bc30-59ed915ccd7b",
                        "entry_id": "9b60aeda-ec26-3abb-8c09-9cd029f29745",
                        "glosses": [
                            "room, chamber; cenacle; ben, ben-room"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "a15a7065-96fd-4d7d-a564-8da1eaadb23b",
                                "sense_id": "ec0cc8b1-03d3-3bc2-bc30-59ed915ccd7b",
                                "text": "Кот вы́шел из сосе́дней го́рницы, ню́хал кровь и зло́бно мяу́кал.",
                                "translation": "The cat walked out of the next room, smelt the blood, and mewed malignantly.",
                                "english": "The cat walked out of the next room, smelt the blood, and mewed malignantly."
                            },
                            {
                                "example_id": "f6af3ce4-27de-4606-9cc4-b8613e6f187b",
                                "sense_id": "ec0cc8b1-03d3-3bc2-bc30-59ed915ccd7b",
                                "text": "Уста́лость и рассе́янность его́ исче́зли, он встал и реши́тельно заходи́л по го́рнице, гля́дя в пол.",
                                "translation": "His weariness and absent-mindedness had vanished; he stood up and began walking decisively around the room, gazing at the floor.",
                                "english": "His weariness and absent-mindedness had vanished; he stood up and began walking decisively around the room, gazing at the floor."
                            }
                        ]
                    }
                ],
