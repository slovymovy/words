                        "entry_id": "329854ab-d86f-3fc5-8907-ad621c34b476",
                        "glosses": [
                            "Guilty person."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "71357958-f7a5-4243-bc8f-9d1936e8cf8a",
                                "sense_id": "01390b0b-064a-32df-82aa-e1a6ea7a8962",
                                "text": "[…] there is no reason that the innocents and nocents sufferings should be alike, for then punishments would not be so effectuall to terrifie others, nor to give future security to innocence."
                            },
                            {
                                "example_id": "6e021cfb-6ff8-4a18-ade9-23e1c7f45ceb",
                                "sense_id": "01390b0b-064a-32df-82aa-e1a6ea7a8962",
                                "text": "[…] no nocent is absolved by the verdict of himself."
                            }
                        ]
                    }
