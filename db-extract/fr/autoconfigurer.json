                "senses": [
                    {
                        "sense_id": "ae40b46e-a91b-34a0-8240-4d6f5cceaaeb",
                        "entry_id": "36ec8f5a-fbec-3565-95a6-ab72a0aadec0",
                        "glosses": [
                            "Configurer automatiquement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a803c50-79c4-4b2f-a1b0-7c89dcfcde1d",
                                "sense_id": "ae40b46e-a91b-34a0-8240-4d6f5cceaaeb",
                                "text": "Comment autoconfigurer outlook ?"
                            },
                            {
                                "example_id": "9b9c4bb7-50ea-4a77-9ae1-ead6011c0068",
                                "sense_id": "ae40b46e-a91b-34a0-8240-4d6f5cceaaeb",
                                "text": "Wyse propose une pyramide pour autoconfigurer les postes de travail virtuels (silicon.fr)"
                            }
                        ]
                    },
                    {
                        "sense_id": "e9190aa4-7c8d-326f-b4c4-9c1dcc7084f6",
                        "entry_id": "36ec8f5a-fbec-3565-95a6-ab72a0aadec0",
                        "glosses": [
                            "Se configurer soi-même."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "41f34cfb-b701-4a69-9fb7-fc3803d84714",
                                "sense_id": "e9190aa4-7c8d-326f-b4c4-9c1dcc7084f6",
                                "text": "“ Il faut que les réseaux apprennent à se débrouiller tout seuls. Ils devront s’autodétecter, s’auto-organiser, s’autoconfigurer, s’auto-optimiser mais aussi s’autoréparer et analyser eux-mêmes leurs vulnérabilités ”, précise Olivier Audouin, directeur opérationnel du laboratoire commun."
                            }
                        ]
