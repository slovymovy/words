{
    "word_family": [
        "moment",
        "momentary"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "35bd044b-0d3a-350e-89a3-6d058ff57900",
                    "sense_definition": "For a very short period of time.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She paused <w>momentarily</w> to catch her breath before continuing the climb.",
                            "target_lang_translations": {
                                "pl": "Zatrzymała się <w>na chwilę</w>, żeby złapać oddech przed kontynuowaniem wspinaczki."
                            }
                        },
                        {
                            "text": "The lights flickered <w>momentarily</w> during the heavy thunderstorm last night.",
                            "target_lang_translations": {
                                "pl": "Światła <w>chwilowo</w> zamigotały podczas silnej burzy zeszłej nocy."
                            }
                        }
                    ],
                    "synonyms": [
                        "briefly",
                        "temporarily"
                    ],
                    "common_phrases": [
                        "pause momentarily"
                    ],
                    "target_lang_definitions": {
                        "pl": "Przez bardzo krótki okres czasu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "chwilowo",
                                "target_lang_sense_clarification": "w odniesieniu do krótkiego czasu trwania czynności"
                            },
                            {
                                "target_lang_word": "na chwilę",
                                "target_lang_sense_clarification": "wyrażenie określające krótki czas trwania"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf257a63-22ff-3217-bb23-8b41d292d6a6",
                    "sense_definition": "Very soon; in a short amount of time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flight will be ready for boarding <w>momentarily</w>.",
                            "target_lang_translations": {
                                "pl": "Lot będzie gotowy do wejścia na pokład <w>za chwilę</w>."
                            }
                        },
                        {
                            "text": "Please wait here as the manager will be with you <w>momentarily</w>.",
                            "target_lang_translations": {
                                "pl": "Proszę tu zaczekać, kierownik będzie u państwa <w>za chwilę</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "presently",
                        "shortly",
                        "soon"
                    ],
                    "common_phrases": [
                        "arrive momentarily"
                    ],
                    "target_lang_definitions": {
                        "pl": "Bardzo niedługo; w krótkim czasie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "za chwilę",
                                "target_lang_sense_clarification": "wskazuje na bliską przyszłość"
                            },
                            {
                                "target_lang_word": "niebawem",
                                "target_lang_sense_clarification": "wkrótce, w niedalekim czasie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b30611a6-ea1a-30bc-addb-b4844b6f5839",
                    "sense_definition": "In a way that happens bit by bit or step by step.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "progression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The situation changed <w>momentarily</w> as new information became available.",
                            "target_lang_translations": {
                                "pl": "Sytuacja zmieniała się <w>stopniowo</w>, gdy pojawiały się nowe informacje."
                            }
                        },
                        {
                            "text": "The landscape shifted <w>momentarily</w> with every mile we traveled.",
                            "target_lang_translations": {
                                "pl": "Krajobraz zmieniał się <w>stopniowo</w> z każdą przebytą milą."
                            }
                        }
                    ],
                    "synonyms": [
                        "incrementally",
                        "progressively",
                        "step by step",
                        "gradually"
                    ],
                    "target_lang_definitions": {
                        "pl": "W sposób, który dzieje się stopniowo lub krok po kroku."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "stopniowo",
                                "target_lang_sense_clarification": "w sposób narastający lub zmieniający się etapami"
                            },
                            {
                                "target_lang_word": "krok po kroku",
                                "target_lang_sense_clarification": "w sposób sekwencyjny"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}