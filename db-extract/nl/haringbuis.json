                        "examples": [
                            {
                                "example_id": "58ba3f44-5474-4ac8-99fe-f0eeaee437da",
                                "sense_id": "32ba2f80-85a5-33fb-b13b-771d1644d5ce",
                                "text": "Van Delft: \"Nederland is bekend om zijn haring, dat vooral ook lange tijd volksvoer was. Toen de productie daar terug liep, gingen de vissers noordzeeharing vangen en verkopen. En omdat de vissers langer op zee moesten blijven werden de vissen op zee gezouten. Dit leidde tot de komst van de Haringbuis en dat gaf weer een enorme impuls aan de economie.\""
                            }
                        ]
                    }
