                "senses": [
                    {
                        "sense_id": "41655141-569d-3a08-acf7-9ddc363a3c98",
                        "entry_id": "ee0cb19d-7585-346d-b3f3-aea51e2f9ae3",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным лёгкие"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d7f354b-1ae9-48a6-9753-9699c479f119",
                                "sense_id": "41655141-569d-3a08-acf7-9ddc363a3c98",
                                "text": "Ведущая роль NO в вазорелаксации была идентифицирована в результате регистрации повышенной активности NOS в эндотелиальных клетках культуры стенки лёгочных артерий, обработанных ресвератролом."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5950de1-cab4-4856-9fb1-fff6c6549c5d",
                        "source_entry_id": "ee0cb19d-7585-346d-b3f3-aea51e2f9ae3",
                        "source_sense_id": "41655141-569d-3a08-acf7-9ddc363a3c98",
                        "target_lang_word": "pulmonal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pulmonal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "285cd739-df72-3879-81e5-ee751bd4fe05",
                                        "entry_id": "02650bba-ef9e-3f01-b75d-32ef6e51bf58",
                                        "glosses": [
                                            "die Lunge betreffend, zur Lunge gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "049fe5f9-906d-4364-bd7a-7d94f5829c2f",
                                                "sense_id": "285cd739-df72-3879-81e5-ee751bd4fe05",
                                                "text": "In Deutschland leiden bis zu zehn Prozent der Bevölkerung an Lungenhochdruck, der pulmonalen Hypertonie."
                                            },
                                            {
                                                "example_id": "c5c20476-eca0-49cd-8da6-41419f785787",
                                                "sense_id": "285cd739-df72-3879-81e5-ee751bd4fe05",
                                                "text": "Ähnlich weitgehende funktionelle Anpassungsmöglichkeiten schlummern im pulmonalen System, im Stoffwechselgeschehen und auch in der Skelettmuskulatur."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "988088e3-a6b1-352b-99c3-61028414c1b5",
                                        "entry_id": "02650bba-ef9e-3f01-b75d-32ef6e51bf58",
                                        "glosses": [
                                            "mit der ausströmenden Atemluft gebildet"
                                        ],
                                        "tags": [
                                            "bei der Artikulation von Lauten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25d61602-f90f-4c9f-89e7-802f45337be0",
                                                "sense_id": "988088e3-a6b1-352b-99c3-61028414c1b5",
                                                "text": "Die meisten Laute der menschlichen Sprachen sind pulmonal."
                                            },
                                            {
