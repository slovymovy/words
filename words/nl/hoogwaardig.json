            "senses": [
                {
                    "sense_id": "a15bce8c-947d-3d3d-9151-9ce252296702",
                    "sense_definition": "Van zeer goede kwaliteit en daardoor van grote waarde.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kwaliteit",
                    "name_type": "no",
