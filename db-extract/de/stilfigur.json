                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a372e75b-b934-4690-ac74-dfe371452d16",
                                                "sense_id": "3cb56de3-2235-3cdc-b4e1-40e67363b403",
                                                "text": "Ironie is als retorisch stijlmiddel even geraffineerd als riskant."
                                            },
                                            {
                                                "example_id": "a398481b-32c6-40bc-8dbb-d95a95c7ff80",
                                                "sense_id": "3cb56de3-2235-3cdc-b4e1-40e67363b403",
                                                "text": "Het gebruik van retorische vragen is een veelvuldig gebruikt stijlmiddel in de reclame."
                                            },
                                            {
                                                "example_id": "1db54878-fa99-4027-a5a4-6e7ca5abc524",
                                                "sense_id": "3cb56de3-2235-3cdc-b4e1-40e67363b403",
                                                "text": "De voice-over in de film is voor velen een gemakzuchtig, uitleggerig en te veel op de literatuur leunend stijlmiddel."
                                            }
                                        ]
                                    }
                                ]
                            }
