    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7532da71-5171-305c-a0b8-498a155e8746",
                "word": "Germanophobe",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "44f03ee8-9cd3-3b6a-9a27-c315ed227d3a",
                        "entry_id": "7532da71-5171-305c-a0b8-498a155e8746",
                        "glosses": [
                            "Anti-German; Germanophobic."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "bcf643ba-edcc-47f3-a8ec-75aa8dc56957",
                                "sense_id": "44f03ee8-9cd3-3b6a-9a27-c315ed227d3a",
                                "text": "I interrupted the Baron in order to observe that my personal feelings could not be of any consequence but as a matter of fact I was not Germanophobe, I was Anglomane, it was natural that you should wish to know from your observer on the spot what was the feeling in France in regard to the critical state in which the negotiations between the French and German Governments then were."
                            },
                            {
                                "example_id": "d828a419-25f7-4982-9d1d-80b05aef40e1",
                                "sense_id": "44f03ee8-9cd3-3b6a-9a27-c315ed227d3a",
                                "text": "Naturally, the always Germanophobe “Times\", Germanophobe by its own open admission, would not want justice done but injustice perpetuated so long as it serves the policies of No. 10 Downing Street and the Sanhedrin."
                            },
                            {
                                "example_id": "b3bd44bb-bba5-4328-8c31-dd371fefb45f",
                                "sense_id": "44f03ee8-9cd3-3b6a-9a27-c315ed227d3a",
                                "text": "Certainly, Ciano, growing more Germanophobe by the day, had entertained the thought."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "335c6b35-7b05-38ac-83e0-663576c960f7",
                "word": "Germanophobe",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8b803606-08ad-4510-b15e-893318ab1c57",
                        "entry_id": "335c6b35-7b05-38ac-83e0-663576c960f7",
                        "tags": [
                            "plural"
                        ],
                        "form": "Germanophobes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8651b5f2-499a-3d80-96ad-5796d3e7d8b0",
                        "entry_id": "335c6b35-7b05-38ac-83e0-663576c960f7",
                        "glosses": [
                            "Someone who dislikes or fears Germany, the German people or their culture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8578413f-0ba5-4627-bd5b-557ed4916d8d",
                                "sense_id": "8651b5f2-499a-3d80-96ad-5796d3e7d8b0",
                                "text": "Thereupon the Germanophobe interrupted me with wrathful remonstrances about our lies and denials"
                            },
                            {
                                "example_id": "da704757-b1e0-411f-8772-9e5f96e7e0d3",
                                "sense_id": "8651b5f2-499a-3d80-96ad-5796d3e7d8b0",
                                "text": "Vansittart has long been portrayed as a vehement, if not violent, Germanophobe, the leading member of a like-minded circle of Foreign Office advisers."
                            },
                            {
                                "example_id": "18ac9180-ac7c-4ffc-a8ad-0dda0c93d293",
                                "sense_id": "8651b5f2-499a-3d80-96ad-5796d3e7d8b0",
                                "text": "What we have seen is that a simple binary system of Anglophobe versus Anglophile and Germanophobe versus Germanophile grossly misrepresents the character of Anglo-German relations and antagonism in the pre-1914 era."
                            }
                        ]
                    }
                ],
