                        "examples": [
                            {
                                "example_id": "49dc04dd-12e3-4910-a635-dac616a176e6",
                                "sense_id": "b1eb0d30-e6bd-326a-bea1-a165b6616f8a",
                                "text": "„Der Übernahmeversuch misslang, der Autobauer Porsche wurde zu einer Marke im VW-Konzern.“"
                            },
                            {
                                "example_id": "95b17b05-22a7-4603-9161-e2034f6c59be",
                                "sense_id": "b1eb0d30-e6bd-326a-bea1-a165b6616f8a",
                                "text": "„Nach dem endgültigen Aus für den Übernahmeversuch durch Microsoft will Yahoo nun dauerhaft mit dem Suchmaschinenriesen Google zusammenarbeiten“."
                            },
                            {
                                "example_id": "9d05e7ef-8f52-475a-a8ad-41be3b0e2d4a",
                                "sense_id": "b1eb0d30-e6bd-326a-bea1-a165b6616f8a",
                                "text": "„In der Bank war es nach einem Übernahmeversuch, den sie gerade abgewehrt hatten, zugegangen wie in einem Irrenhaus.“"
                            },
                            {
                                "example_id": "2673378d-8a64-42fd-a6d7-9c68c3969638",
                                "sense_id": "b1eb0d30-e6bd-326a-bea1-a165b6616f8a",
                                "text": "„In der Deutschen Börse wird der feindliche Übernahmeversuch aus Stockholm als ‚ärgerlicher Störfaktor‘ gewertet.“"
                            }
                        ],
