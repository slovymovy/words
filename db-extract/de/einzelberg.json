                "senses": [
                    {
                        "sense_id": "733aa723-2a6d-3fc4-8d34-f0045bccf933",
                        "entry_id": "b0cef13a-44a4-3a6b-b016-f0e81587ff42",
                        "glosses": [
                            "Berg, der allein aus der umgebenden Landschaft herausragt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "634abb48-55d7-419d-8364-0b0b8478ec1c",
                                "sense_id": "733aa723-2a6d-3fc4-8d34-f0045bccf933",
                                "text": "„Die orographische Struktur des Mondes kann man sehr deutlich nach Gebirgsketten, Einzelbergen, Ringgebirgen und Rillen unterscheiden.“"
                            },
                            {
                                "example_id": "332dcb39-17e6-42aa-a3ec-1323e17aa391",
                                "sense_id": "733aa723-2a6d-3fc4-8d34-f0045bccf933",
                                "text": "„Der 257 Meter hohe Einzelberg liegt südöstlich von Groß Schneen an der Bundesstraße 27 als markante Erhebung im Leinetal.“"
                            },
                            {
                                "example_id": "d4c66c02-0ff1-4f95-8acb-9c0de6fc4790",
                                "sense_id": "733aa723-2a6d-3fc4-8d34-f0045bccf933",
                                "text": "„Unterwegs erzählte Papa die Geschichte vom Ritter auf dem Einzelberg“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
