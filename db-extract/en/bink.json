                        "form": "binking"
                    },
                    {
                        "form_id": "b30b578a-d13b-4c50-89a6-ee7d02438c49",
                        "entry_id": "88c71837-5f82-3fe0-af95-caa8ba08cb3d",
                        "tags": [
                            "participle",
