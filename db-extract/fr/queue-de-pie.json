                                    },
                                    {
                                        "sense_id": "81d3d895-7ee0-3352-bd51-3e20d192c627",
                                        "entry_id": "c4d73fbe-f067-32ca-968b-39ab0a981199",
                                        "glosses": [
                                            "Gerät der Holz- oder sonstigen Materialverbindung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36495cf2-0926-41c6-a562-7618ffc628ea",
                                                "sense_id": "81d3d895-7ee0-3352-bd51-3e20d192c627",
                                                "text": "Der Schrank ist mit Schwalbenschwanz verbunden."
                                            },
                                            {
                                                "example_id": "ff3f0c65-8d86-4f5c-a1e5-ec74bb97f0b7",
                                                "sense_id": "81d3d895-7ee0-3352-bd51-3e20d192c627",
                                                "text": "„Und tatsächlich sind ja die Wirbel eine Art Verbindungsteil im Innern des menschlichen Körpers, in einem Gebäude aus Stein erfüllen die Schwalbenschwänze diese Funktion und in Kleidung und Magie sind es die Knoten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "dd4cab61-a9e7-30a1-b306-3a82490bd337",
                                        "entry_id": "c4d73fbe-f067-32ca-968b-39ab0a981199",
                                        "glosses": [
                                            "geteilte untere Rückenpartie des Fracks oder der Frack selber"
                                        ],
                                        "tags": [
                                            "humorous",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01a67b35-0e7f-4985-9265-4a0cdaf3556f",
                                                "sense_id": "dd4cab61-a9e7-30a1-b306-3a82490bd337",
                                                "text": "Herr Puvogel kam in Schwalbenschwanz und Zylinder."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a5829a33-171b-3028-88c9-8288de02197b",
                                        "entry_id": "c4d73fbe-f067-32ca-968b-39ab0a981199",
                                        "glosses": [
                                            "herabhängendes Band an einer Matrosenmütze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e508ee8d-3ced-4013-9066-25c3ee9c41fc",
                                                "sense_id": "a5829a33-171b-3028-88c9-8288de02197b",
                                                "text": "Donald Duck trägt eine Matrosenmütze mit Schwalbenschwanz."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "e938b6c1-288e-3170-8b36-7230b14e084f",
                                        "entry_id": "c4d73fbe-f067-32ca-968b-39ab0a981199",
                                        "glosses": [
