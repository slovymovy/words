                    {
                        "translation_id": "bb73c853-4774-421b-86f9-eaf9cf0e9e85",
                        "source_entry_id": "8c593977-85d8-3e91-a187-2516ba7e264c",
                        "source_sense_id": "1b6b2206-af7f-39fb-8860-a1b581737003",
