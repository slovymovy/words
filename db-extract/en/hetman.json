                    {
                        "translation_id": "4196148a-37d6-48f2-8294-86ca1b82ace2",
                        "source_entry_id": "7f865626-1f36-31b0-822a-bc216a9f15d5",
                        "source_sense_description": "a historical military commander in various Eastern European countries",
                        "target_lang_word": "ге́тман",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ге́тман",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b3546090-2bde-38c1-9104-daecc41ed4d4",
                                        "entry_id": "411b440d-2a58-3289-9337-b61460639024",
                                        "glosses": [
                                            "истор. в Литве и Польше XVI—XVIII вв. — высший военный чин"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "564950a4-acd0-4fa5-bf32-dbdee3aa5709",
                                                "sense_id": "b3546090-2bde-38c1-9104-daecc41ed4d4",
                                                "text": "Возникновение этого монастыря связано с героической обороной Курска от нашествия польско-литовских интервентов под командованием гетмана Жолкевского в 1612 году."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a3756a2-dc69-375d-91b7-e360e98a899a",
                                        "entry_id": "411b440d-2a58-3289-9337-b61460639024",
                                        "glosses": [
                                            "истор. на Украине сер. XVI — сер. XVII вв. — выборный начальник казацкого войска"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cfc11dd-a091-49ab-99bd-af86bd08ebfe",
                                                "sense_id": "4a3756a2-dc69-375d-91b7-e360e98a899a",
                                                "text": "После смерти Лободы и избрания гетманом Кремпского дисциплина в лагере повстанцев на некоторое время восстановилась."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8404dbb-cc48-36b5-88ed-996052034fb1",
                                        "entry_id": "411b440d-2a58-3289-9337-b61460639024",
                                        "glosses": [
                                            "истор. с 1649 г. до 1764 г. — титул верховного правителя автономной части Украины (Гетманщины)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c600133-41fd-48c8-b279-b6072e8a2eb0",
                                                "sense_id": "f8404dbb-cc48-36b5-88ed-996052034fb1",
                                                "text": "После разорения Батурина резиденция гетмана (а им стал полковник Иван Скоропадский) по указу Петра I была перенесена в Глухов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b986014b-d0c4-38a2-9167-9767b14efa9a",
                                        "entry_id": "411b440d-2a58-3289-9337-b61460639024",
                                        "glosses": [
                                            "истор. титул главы Украинской Державы (28 апреля — 14 декабря 1918 г.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b4bb539-910f-480d-90b2-f0ce60dc3059",
                                                "sense_id": "b986014b-d0c4-38a2-9167-9767b14efa9a",
                                                "text": "Его единственным преступлением было то, что с немцами, гетманом и Петлюрой он сражался вместе с Махно."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
