                        "translation_id": "0f63f04c-7921-4060-b082-93f92b11b61c",
                        "source_entry_id": "ce3660a5-6969-327b-90ce-ce6cbaab8c0b",
                        "source_sense_id": "46953bf3-122a-34fd-8ca9-4c703f31d597",
                        "source_sense_description": "Medizin: aidskrank",
                        "target_lang_word": "aidskrank",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aidskrank",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b5362b1-0e9c-3cfd-9470-06992d51fd4f",
                                        "entry_id": "ba6e2a3c-8076-346f-bd43-b84f7a4f84fe",
                                        "glosses": [
                                            "an der Immunschwächekrankheit Aids erkrankt, an ihr leidend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd9812f6-dc74-49a5-9f50-2e854ccdfdb5",
                                                "sense_id": "3b5362b1-0e9c-3cfd-9470-06992d51fd4f",
                                                "text": "„Viele aidskranke Frauen wurden von ihren Männern verlassen, entweder schon vor den ersten Anzeichen der Krankheit oder spätestens danach.“"
                                            },
                                            {
                                                "example_id": "96e2031e-a30d-43bc-b4b8-5262596ae1ca",
                                                "sense_id": "3b5362b1-0e9c-3cfd-9470-06992d51fd4f",
                                                "text": "Demnach dürfen sich Frauen, deren Ehemänner aidskrank sind, mit Kondomen vor der Krankheit schützen."
                                            },
                                            {
                                                "example_id": "068687ad-c17a-40a1-bbb4-9c00cf2ffa82",
                                                "sense_id": "3b5362b1-0e9c-3cfd-9470-06992d51fd4f",
                                                "text": "Alexanjan befindet sich seit mehr als eineinhalb Jahren im Moskauer Untersuchungsgefängnis „Matrosenruhe“, obwohl er aidskrank ist."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
