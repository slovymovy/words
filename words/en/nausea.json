{
    "word_family": [
        "nauseate",
        "nauseous",
        "nauseating"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "94a9426d-31b1-3685-92b1-ab98e9d3320e",
                    "sense_definition": "A feeling of illness or discomfort in the stomach, often with an urge to vomit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "illness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strong smell of the chemicals caused immediate <w>nausea</w>.",
                            "target_lang_translations": {
                                "ru": "Резкий запах химикатов вызвал мгновенную <w>тошноту</w>.",
                                "cs": "Silný zápach chemikálií vyvolal okamžitou <w>nevolnost</w>.",
                                "tr": "Kimyasalların keskin kokusu anında <w>mide bulantısına</w> neden oldu."
                            }
                        },
                        {
                            "text": "She felt a wave of <w>nausea</w> after eating the spoiled food.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала приступ <w>тошноты</w> после того, как съела испорченную еду.",
                                "cs": "Poté, co snědla zkažené jídlo, pocítila vlnu <w>nevolnosti</w>.",
                                "tr": "Bozuk yemeği yedikten sonra bir <w>bulantı</w> dalgası hissetti."
                            }
                        }
                    ],
                    "synonyms": [
                        "queasiness",
                        "sickness"
                    ],
                    "common_phrases": [
                        "severe nausea",
                        "feeling of nausea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тягостное ощущение в подложечной области и глотке, часто предшествующее рвоте.",
                        "cs": "Pocit nevolnosti v žaludku, často spojený s nutkáním na zvracení.",
                        "tr": "Genellikle kusma isteğinin eşlik ettiği, midede hissedilen rahatsızlık ve fenalık hissi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тошнота",
                                "target_lang_sense_clarification": "физическое ощущение недомогания"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "nevolnost",
                                "target_lang_sense_clarification": "pocit na zvracení, žaludeční nevolnost"
                            },
                            {
                                "target_lang_word": "nauzea",
                                "target_lang_sense_clarification": "lékařský výraz pro pocit na zvracení"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "mide bulantısı",
                                "target_lang_sense_clarification": "kusma hissiyle birlikte midede duyulan rahatsızlık"
                            },
                            {
                                "target_lang_word": "bulantı",
                                "target_lang_sense_clarification": "mide bulantısı veya genel kusma isteği"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac388313-ac57-3bc1-adb1-98b49ecda0d4",
                    "sense_definition": "A feeling of illness caused by the movement of a vehicle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "illness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The winding roads on the mountain trip caused terrible <w>nausea</w>.",
                            "target_lang_translations": {
                                "ru": "Извилистые горные дороги вызвали ужасную <w>тошноту</w>.",
                                "cs": "Klikaté silnice během horského výletu způsobily strašnou <w>nevolnost</w>.",
                                "tr": "Dağ yolculuğundaki virajlı yollar feci bir <w>mide bulantısına</w> yol açtı."
                            }
                        },
                        {
                            "text": "He took medicine to prevent <w>nausea</w> during the long boat ride.",
                            "target_lang_translations": {
                                "ru": "Он принял лекарство, чтобы предотвратить <w>тошноту</w> во время долгой поездки на лодке.",
                                "cs": "Vzal si lék, aby zabránil <w>nevolnosti</w> během dlouhé plavby lodí.",
                                "tr": "Uzun tekne gezisi sırasında <w>bulantıyı</w> önlemek için ilaç aldı."
                            }
                        }
                    ],
                    "synonyms": [
                        "motion sickness"
                    ],
                    "common_phrases": [
                        "travel nausea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Болезненное состояние, вызванное укачиванием в транспорте.",
                        "cs": "Pocit žaludeční nevolnosti způsobený pohybem dopravního prostředku.",
                        "tr": "Bir taşıtın hareketi veya sallantısı nedeniyle ortaya çıkan mide bulantısı ve rahatsızlık hissi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тошнота",
                                "target_lang_sense_clarification": "при укачивании"
                            },
                            {
                                "target_lang_word": "морская болезнь",
                                "target_lang_sense_clarification": "специфическое состояние при качке"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "nevolnost",
                                "target_lang_sense_clarification": "způsobená cestováním či houpáním"
                            },
                            {
                                "target_lang_word": "mořská nemoc",
                                "target_lang_sense_clarification": "specificky při jízdě lodí"
                            },
                            {
                                "target_lang_word": "kinetóza",
                                "target_lang_sense_clarification": "odborný výraz pro nevolnost z pohybu"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "mide bulantısı",
                                "target_lang_sense_clarification": "taşıt tutması kaynaklı bulantı"
                            },
                            {
                                "target_lang_word": "taşıt tutması",
                                "target_lang_sense_clarification": "yolculuk esnasındaki hareketten kaynaklanan rahatsızlık"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c749975e-9185-36d7-bf22-157f94222cdb",
                    "sense_definition": "A feeling of intense dislike or disgust.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt a sense of <w>nausea</w> when he heard about the cruel treatment of the animals.",
                            "target_lang_translations": {
                                "ru": "Он испытал чувство <w>отвращения</w>, когда услышал о жестоком обращении с животными.",
                                "cs": "Když se doslechl o krutém zacházení se zvířaty, pocítil <w>odpor</w>.",
                                "tr": "Hayvanlara yapılan acımasız muameleyi duyduğunda içinde bir <w>iğrenti</w> hissetti."
                            }
                        },
                        {
                            "text": "The corruption in the government filled the citizens with <w>nausea</w>.",
                            "target_lang_translations": {
                                "ru": "Коррупция в правительстве вызывала у граждан <w>отвращение</w>.",
                                "cs": "Korupce ve vládě vyvolávala v občanech <w>znechucení</w>.",
                                "tr": "Hükümetteki yolsuzluk vatandaşlarda <w>tiksinti</w> uyandırdı."
                            }
                        }
                    ],
                    "synonyms": [
                        "disgust",
                        "revulsion",
                        "loathing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство сильной неприязни, отвращения или омерзения.",
                        "cs": "Pocit silného odporu, nechuti nebo hlubokého znechucení.",
                        "tr": "Bir durum, davranış veya şey karşısında hissedilen yoğun tiksinti veya nefret duygusu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отвращение",
                                "target_lang_sense_clarification": "крайняя неприязнь"
                            },
                            {
                                "target_lang_word": "омерзение",
                                "target_lang_sense_clarification": "сильное чувство гадливости"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "odpor",
                                "target_lang_sense_clarification": "silná nechuť, odpor k něčemu"
                            },
                            {
                                "target_lang_word": "hnus",
                                "target_lang_sense_clarification": "silný pocit ošklivosti"
                            },
                            {
                                "target_lang_word": "znechucení",
                                "target_lang_sense_clarification": "pocit hluboké nechuti"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "iğrenti",
                                "target_lang_sense_clarification": "bir şeyden duyulan yoğun tiksinme hissi"
                            },
                            {
                                "target_lang_word": "tiksinti",
                                "target_lang_sense_clarification": "yoğun hoşnutsuzluk ve iğrenme duygusu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}