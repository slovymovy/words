                ],
                "senses": [
                    {
                        "sense_id": "bc1f7df1-a4f7-3702-a738-763abb21b286",
                        "entry_id": "831df0ec-30af-3a2d-9f86-9a0b0afe3a7d",
                        "glosses": [
                            "To disconcert someone with an unblinking face-to-face confrontation; to stare down; to withsay"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "86a94668-08eb-41cc-8af5-186a234a229a",
                                "sense_id": "bc1f7df1-a4f7-3702-a738-763abb21b286",
                                "text": "Thou maiſt I warrant, we ſhall haue old ſwearing / That they did giue the Rings away to men, / But weele out-face them, and out-ſweare them too, [...]"
                            },
                            {
                                "example_id": "ffd1dc0c-8081-4a04-95d3-721d37374fac",
                                "sense_id": "bc1f7df1-a4f7-3702-a738-763abb21b286",
                                "text": "Weele haue a ſwaſhing and marſhall outſide, / As manie other manniſh cowards haue, / That doe outface it with their ſemblances."
                            }
                        ]
                    },
                    {
                        "sense_id": "dfb04f5d-220c-3384-969e-855e6c42e89c",
                        "entry_id": "831df0ec-30af-3a2d-9f86-9a0b0afe3a7d",
                        "glosses": [
                            "To boldly confront a situation."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "593a4baf-5e3f-4717-bc5a-b73d0e44db90",
                                "sense_id": "dfb04f5d-220c-3384-969e-855e6c42e89c",
                                "text": "Quiet people too, for I think that about this time a sort of remorseful tenderness comes over the bullies and the nagsters, so that they go about gently and deprecatingly, hoping by one day's record sweetness to outface the year's blusterings."
                            }
                        ]
                    }
