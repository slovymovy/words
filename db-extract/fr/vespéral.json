                                "target_senses": [
                                    {
                                        "sense_id": "66ca984c-99a2-35b8-af83-9a80d0e0f530",
                                        "entry_id": "baa8dd2b-560f-3058-b7cd-bab7a45a294b",
                                        "glosses": [
                                            "zum Abend gehörend; am Abend, abends stattfindend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85ae7896-e691-4814-b4a2-b968f38c0d1d",
                                                "sense_id": "66ca984c-99a2-35b8-af83-9a80d0e0f530",
                                                "text": "Er hält nichts vom abendlichen Unterhaltungsprogramm."
                                            },
                                            {
                                                "example_id": "d478f259-1dce-4f85-9510-4959eeb6b875",
                                                "sense_id": "66ca984c-99a2-35b8-af83-9a80d0e0f530",
                                                "text": "„Den Abschluss bildete der abendliche Ball mit Feuerwerk und hurrapatriotischen Reden im Übermaß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8f4eb3d-983a-49f2-8f44-fffdaeef43a5",
                        "source_entry_id": "c0db76b4-8d77-3fcb-8cd1-90cdad2871c7",
                        "source_sense_id": "8ab2db6d-cfa7-3e0b-9795-0b95ccd81f35",
                        "source_sense_description": "Qui a rapport au soir",
                        "target_lang_word": "vespertine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vespertine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6547ad4-937c-3131-be43-b96d10c3d76c",
                                        "entry_id": "9c412a6d-de5e-3fef-ada3-729136b92025",
                                        "glosses": [
                                            "Of or related to the evening; that occurs in the evening."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f818776-09d6-4728-83d0-8ee5b864890b",
                                                "sense_id": "c6547ad4-937c-3131-be43-b96d10c3d76c",
                                                "text": "1837, William Evans Burton (editor), Philadelphia in the Dog Days: An Incoherency, Burton's Gentleman's Magazine and American Monthly Review, Volume 1: July—December, page 131,\nThe peripatetics issue forth to indulge in the usual vespertine locomotion; and stroll gently down the aristocratic Chesnut and up the sedate and solid-seeming Mulberry, or vice versa."
                                            },
                                            {
                                                "example_id": "cdb328fd-cb3e-4a20-af22-108ca589cd4f",
                                                "sense_id": "c6547ad4-937c-3131-be43-b96d10c3d76c",
                                                "text": "Sovereign, majestic peace, joined to the spiritual isolation of the vespertine hour, rose up from those diaphanous, remote distances into the pure sky, where light little clouds, very much like bundles of cotton, scattered sparsely here and there, were tinged with gold."
                                            },
                                            {
                                                "example_id": "a1f1db22-3b25-4fbf-b356-473e0d51de23",
                                                "sense_id": "c6547ad4-937c-3131-be43-b96d10c3d76c",
                                                "text": "'I should be honoured, Ned. Truly honoured. Will you let me go upstairs and change into something a little more vespertine?' He pointed mournfully at his speech day garb."
                                            },
                                            {
                                                "example_id": "9ef8bccc-a25c-4a39-ab8e-6f3db7a204e6",
                                                "sense_id": "c6547ad4-937c-3131-be43-b96d10c3d76c",
                                                "text": "Although in the published version of 1815, this sylvan scene of vespertine quietude does not refer to anywhere in particular, the poem was originally written in response to a specific place: on 6 September 1780 Goethe penciled it onto the wooden wall of a hunting hut on a forested hilltop, the Kickelhahn, near Ilmenau."
                                            },
                                            {
                                                "example_id": "d61b9c13-c645-4a3a-a50b-1ecb2c807285",
                                                "sense_id": "c6547ad4-937c-3131-be43-b96d10c3d76c",
                                                "text": "As our ineffable ardor just begins, / All becomes fiery flames of desire; / Oh, welcome the dusk—and its vespertine fire!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "909f5768-9714-34c9-826e-131307965a31",
                                        "entry_id": "9c412a6d-de5e-3fef-ada3-729136b92025",
                                        "glosses": [
                                            "That sets after the sun."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d85c275e-0c09-421a-bd9a-9047c7b56bfd",
                                                "sense_id": "909f5768-9714-34c9-826e-131307965a31",
                                                "text": "But, owing to the vespertine configuration of Jupiter and Mars, as well as the masculine condition of the anterior parts of the triplicity, and the feminine condition of its latter parts, the said nations regard women with scorn and indifference."
                                            },
                                            {
                                                "example_id": "c67b9bbb-d33c-4802-afd9-d9333557cb13",
                                                "sense_id": "909f5768-9714-34c9-826e-131307965a31",
                                                "text": "Finally, he^([Ptolemy]) says that the vespertine or second stations of the planets, especially those posited in the I.C. [4th House], and in the case of Mercury and Venus, when they are vespertine in day charts but matutine in night charts, signify temperaments that are ingenious, capable of hard work, and able to discern arcane matters, such as are seen in the nativities of magicians, prestidigitators, dream interpreters, and so on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94512f0d-eb1a-3a42-8418-8a268f84aa49",
                                        "entry_id": "9c412a6d-de5e-3fef-ada3-729136b92025",
                                        "glosses": [
                                            "That is principally active at dusk."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2beb2cd5-3b2f-4201-86ee-e852e039baae",
                                                "sense_id": "94512f0d-eb1a-3a42-8418-8a268f84aa49",
                                                "text": "In both forms of this interesting plant, the medium-sized spider-like flowers are closed from morning until late afternoon when they open to attract vespertine insects."
                                            },
                                            {
                                                "example_id": "fbe72b4d-1cc4-48b4-b753-09364acd489e",
                                                "sense_id": "94512f0d-eb1a-3a42-8418-8a268f84aa49",
                                                "text": "In research involving American black bears Ursus americanus, Bridges et al. (2004b) recorded activity patterns at bait sites in Virginia and found bear activity was generally vespertine but exhibited seasonal differences with bears becoming more nocturnal in the fall, possibly in response to hunting seasons and possible pursuit by bear-hounds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e8eb532-f0b4-3037-897f-2ab67f84a79e",
                                        "entry_id": "9c412a6d-de5e-3fef-ada3-729136b92025",
                                        "glosses": [
                                            "Occurring in the evening."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "276598be-30d6-4ab7-80f0-6acc57faf81e",
                                                "sense_id": "0e8eb532-f0b4-3037-897f-2ab67f84a79e",
                                                "text": "Similarly, the flowers of the sphingophilous taxa correspond to the characteristics and habits of western American hawkmoths in many ways: in ... vespertine and nocturnal nectar production"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e4aa22e-dba6-3906-848e-731a73a1fb8d",
                                        "entry_id": "9c412a6d-de5e-3fef-ada3-729136b92025",
                                        "glosses": [
                                            "That opens or blooms in the evening."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f1bd6d5-3e26-4df2-b024-8e73ee51bfe6",
                                                "sense_id": "0e4aa22e-dba6-3906-848e-731a73a1fb8d",
                                                "text": "Herbaceous; leaves alternate, pinnatifid, asperate; flowers large, terminal and solitary, vespertine, (or expanding towards sun-set,) not deciduous or marcescent after closing, but re-opening at the usual time for several days in succession, when closed involute in a cone;[…]."
                                            },
                                            {
                                                "example_id": "d614be4a-70e9-4e19-8244-d864a6d35da5",
                                                "sense_id": "0e4aa22e-dba6-3906-848e-731a73a1fb8d",
                                                "text": "It^([Mentzelia ornata]) belongs to the vespertine section, or those in which the flowers fully expand only towards evening."
                                            },
                                            {
                                                "example_id": "45a7dfbd-14f2-415a-912e-7e2e0295374f",
                                                "sense_id": "0e4aa22e-dba6-3906-848e-731a73a1fb8d",
                                                "text": "I read of vespertine flowers, night bloomers like four o'clocks, opening like mouths in evening prayer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "079d3c77-aa30-4b3f-ba2b-28af85679193",
                        "source_entry_id": "c0db76b4-8d77-3fcb-8cd1-90cdad2871c7",
