                    },
                    {
                        "sense_id": "0975ae83-9819-3642-a799-10d090024c0c",
                        "entry_id": "defdb873-6335-37b9-95c0-ad4ddf2779ab",
                        "glosses": [
                            "To give something political characteristics; to turn into a political issue."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "df30649a-2311-4e95-a342-398564325908",
                                "sense_id": "0975ae83-9819-3642-a799-10d090024c0c",
                                "text": "My parents started politicizing the weather as soon as they opened their snowplow business."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4c35add-47c0-34a2-811b-7c7855259528",
                        "entry_id": "defdb873-6335-37b9-95c0-ad4ddf2779ab",
                        "glosses": [
                            "To make someone politically active or aware."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8c0062bf-e995-47a9-ae96-a021c9a4d0ce",
                                "sense_id": "b4c35add-47c0-34a2-811b-7c7855259528",
                                "text": "The possibility of setting up an educational arm which could politicize gays in Massachusetts through a series of seminars and through the publication of a booklet providing a background on the history of gay rights."
                            }
                        ]
                    }
                ],
                "translations": [
