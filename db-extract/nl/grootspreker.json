                    {
                        "sense_id": "87c8560c-0ae3-384a-9bf1-6301697035b0",
                        "entry_id": "8e50f9e7-c789-3345-9e03-e3ad87670653",
                        "glosses": [
                            "persoon die zich belangrijker voordoet dan bij of zijn eigenlijk is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4ef768e-328a-444b-9368-d7ce34b13ea5",
                                "sense_id": "87c8560c-0ae3-384a-9bf1-6301697035b0",
                                "text": "Dirk citeert Voltaire, Gijsbert noemt Voltaire een godloochenaar, Dirk citeert Rousseau en Gijsbert zegt dat Rousseau niets dan een zedeloze grootspreker is, die voor mensen zonder moraal een gevaarlijke aantrekkingskracht heeft."
                            },
                            {
                                "example_id": "34a3972b-174b-4429-b997-4fc41a63fc81",
                                "sense_id": "87c8560c-0ae3-384a-9bf1-6301697035b0",
                                "text": "Die grootspreker uit het apenland heeft vandaag meer dan genoeg van zijn zenuwen en geduld gevergd, hij zal nu niet met hem twisten."
                            }
                        ]
                    }
                ],
