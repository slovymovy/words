                                "example_id": "89c89fcb-cc72-4cdf-819e-57d771cfdf86",
                                "sense_id": "189e75be-723d-396d-9f29-248654374887",
                                "text": "Zusammen mit dem Nierenkanälchen bildet das Nierenkörperchen die kleinste Funktionseinheit der Niere, das Nephron."
                            }
