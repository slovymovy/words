                                    },
                                    {
                                        "sense_id": "345a9e8f-8b6a-352e-9532-0e4ab27e3ed6",
                                        "entry_id": "8d1e5431-06bf-300b-b016-0d0cd8b00e2b",
                                        "glosses": [
                                            "heel schaars"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a148bc7-01d4-452a-afe6-a66aa8952acc",
                                                "sense_id": "345a9e8f-8b6a-352e-9532-0e4ab27e3ed6",
                                                "text": "Het gras werd spaarzamer en hield tenslotte geheel op."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a287f99f-1320-4aae-a8fd-329dc37d981e",
                        "source_entry_id": "3bd0430b-f9fc-3ca3-a2a4-9ccb44581684",
                        "source_sense_id": "f4401670-2393-3a3a-ac4a-d01e54f2b596",
                        "source_sense_description": "in a sparing manner",
                        "target_lang_word": "parcimonieusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parcimonieusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dd64f476-f098-310c-bd74-156caf4aa09a",
                                        "entry_id": "9da1f4a3-588d-3c7c-bcbc-b263bfb634e4",
                                        "glosses": [
                                            "D’une manière parcimonieuse ; avec parcimonie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf922214-5fed-4211-8e88-ac014116fec5",
                                                "sense_id": "dd64f476-f098-310c-bd74-156caf4aa09a",
                                                "text": "Pourtant, il faut remplir, chaque année, ces sacs maudits, pour satisfaire le maître et payer le droit de vivre parcimonieusement et misérablement sur son domaine."
                                            },
                                            {
                                                "example_id": "4ded5049-8a86-4a7b-828c-6d0c60829e47",
                                                "sense_id": "dd64f476-f098-310c-bd74-156caf4aa09a",
                                                "text": "Je sors et vais m'asseoir près de leur feu […]. Nous l'entretenons parcimonieusement, allumant chaque nouveau sarment au sarment qui s'éteint, pour que le fagot suffise jusqu'au matin, […]."
                                            },
                                            {
                                                "example_id": "d07b5e47-f5dd-444c-9e1b-2f574738bcf9",
                                                "sense_id": "dd64f476-f098-310c-bd74-156caf4aa09a",
                                                "text": "Nous nous trouvâmes bientôt au pied du Sacré-Cœur et de roides escaliers que de vagues réverbères éclairent parcimonieusement."
                                            },
                                            {
                                                "example_id": "e7fc99c1-d764-4fab-8eec-55260ca0ba80",
                                                "sense_id": "dd64f476-f098-310c-bd74-156caf4aa09a",
                                                "text": "Le « gros » l'entretenait parcimonieusement de repas et de cadeaux mesquins et lui payait sa chambre, au coin de la rue Grange-Batelière."
                                            },
                                            {
                                                "example_id": "11679cf7-cd8c-4009-85a8-7f47aee609f6",
                                                "sense_id": "dd64f476-f098-310c-bd74-156caf4aa09a",
                                                "text": "S'ensuivirent quelques mondanités sur les mérites comparés de liqueurs d'hommes. Accord autour du Rebel Yell, un rince-cochon de première, distillé parcimonieusement par des bootleggers fous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
