                    },
                    {
                        "translation_id": "0a460be2-f321-44a7-8e86-6972461aa0a6",
                        "source_entry_id": "98f75fbe-35cc-30cb-851d-21a224b2d83b",
                        "source_sense_id": "6262fd8d-b859-3dd6-b788-f36a62d228a0",
