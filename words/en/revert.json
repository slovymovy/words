                        {
                            "text": "She spent months studying before she chose to <w>revert</w>.",
                            "target_lang_translations": {
                                "ru": "Она провела месяцы за учебой, прежде чем решила <w>обратиться</w> в новую веру."
                            }
                        }
                    ],
                    "common_phrases": [
                        "revert to Islam"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обращаться в ислам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обращаться",
                                "target_lang_sense_clarification": "в ислам"
                            },
                            {
                                "target_lang_word": "принимать ислам",
                                "target_lang_sense_clarification": "о верующих"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6dd88849-6144-3630-95d5-91b465d2134e",
                    "sense_definition": "To solve or transform a mathematical power series to express the independent variable in terms of the dependent one.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this physics proof, we must <w>revert</w> the series to find the exact variable relation.",
                            "target_lang_translations": {
                                "ru": "В этом физическом доказательстве мы должны <w>обратить</w> ряд, чтобы найти точное соотношение переменных."
                            }
                        },
                        {
                            "text": "The mathematician demonstrated how to <w>revert</w> the equation step by step.",
                            "target_lang_translations": {
                                "ru": "Математик продемонстрировал, как шаг за шагом <w>обратить</w> уравнение."
                            }
                        }
                    ],
                    "common_phrases": [
                        "revert a series"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обращать математический степенной ряд для выражения независимой переменной через зависимую."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обращать",
                                "target_lang_sense_clarification": "математический ряд"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fea2067d-1f07-34b8-9995-7a96445c3309",
                    "sense_definition": "An action or instance of returning software, data, or a database to an earlier state.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We performed a quick <w>revert</w> in the repository after detecting a bug.",
                            "target_lang_translations": {
                                "ru": "Мы выполнили быстрый <w>откат</w> в репозитории после обнаружения ошибки."
                            }
