                        "examples": [
                            {
                                "example_id": "a1b29a9d-7e66-4480-a441-e6f5f8c432f8",
                                "sense_id": "80619a6e-1a80-3df0-b11c-4414c9415d17",
                                "text": "„Der Kellner kam mit einer Flasche zurück, die er wie ein Wickelkind in den Armen hielt.“"
                            },
                            {
                                "example_id": "92c73dc1-bd23-4b76-ae93-0f01a15bc320",
                                "sense_id": "80619a6e-1a80-3df0-b11c-4414c9415d17",
                                "text": "„Zudem sei sie seit geraumer Zeit kein Wickelkind mehr.“"
                            }
                        ],
