                ],
                "senses": [
                    {
                        "sense_id": "a4e076ab-a401-3a1d-8f3f-7eea450d8ad3",
                        "entry_id": "09aa9895-6873-3bd8-a660-0c32edb6bda4",
                        "glosses": [
                            "etwas Einzelnes, eine einzelne Größe"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "9f4d4d17-4649-4790-ba6e-0e3a4a98496e",
                                "sense_id": "a4e076ab-a401-3a1d-8f3f-7eea450d8ad3",
                                "text": "Auf diesem Flip-chart sollten wir jetzt alle übriggebliebenen Items sammeln."
                            },
                            {
                                "example_id": "7ca01eeb-f511-433b-9014-e209d5b5ca1b",
                                "sense_id": "a4e076ab-a401-3a1d-8f3f-7eea450d8ad3",
                                "text": "Drei der Items erfüllen die Kriterien."
                            },
                            {
                                "example_id": "f716aff2-85ae-4798-bd3c-c21c08679248",
                                "sense_id": "a4e076ab-a401-3a1d-8f3f-7eea450d8ad3",
                                "text": "Von insgesamt 38 auf dieses Item entfallene Stimmen gaben 35 Personen an, sich mindestens „bewusst und gesund“ zu ernähren, „wenn es der Alltag zulässt“."
                            },
                            {
                                "example_id": "a2d268ee-d025-4de2-b05b-f0b993663cc7",
                                "sense_id": "a4e076ab-a401-3a1d-8f3f-7eea450d8ad3",
                                "text": "„Zum einem ist der Großteil des Wechsels von [+ plosiv] zu [+ frikativ] auf das Item ‚Weg‘ zurückzuführen, dessen finaler Plosiv entsprechend häufig als allophonische Variante [ç] realisiert wird.“"
                            },
                            {
                                "example_id": "fbb0fc09-54dc-48b2-a671-01a01c688069",
                                "sense_id": "a4e076ab-a401-3a1d-8f3f-7eea450d8ad3",
                                "text": "„Sowohl Items also auch ganze Tests können Decken- oder Bodeneffekte aufweisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
