{
    "word_family": [
        "sequestration",
        "sequestrator",
        "sequestrum"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ad192deb-2602-302b-86c3-b27e3fc415d5",
                    "sense_definition": "To isolate someone or something from external influence or contact.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "isolation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge decided to <w>sequester</w> the jury to prevent them from hearing news reports.",
                            "target_lang_translations": {
                                "cs": "Soudce se rozhodl <w>izolovat</w> porotu, aby zabránil tomu, že se dozví o zprávách v médiích."
                            }
                        },
                        {
                            "text": "The scientist chose to <w>sequester</w> herself in the lab to finish the research project.",
                            "target_lang_translations": {
                                "cs": "Vědkyně se rozhodla <w>izolovat</w> v laboratoři, aby dokončila výzkumný projekt."
                            }
                        }
                    ],
                    "synonyms": [
                        "separate",
                        "segregate"
                    ],
                    "common_phrases": [
                        "sequester the jury"
                    ],
                    "target_lang_definitions": {
                        "cs": "Izolovat někoho nebo něco od vnějších vlivů nebo kontaktu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "oddělit",
                                "target_lang_sense_clarification": "vytvořit odstup nebo izolaci od okolí"
                            },
                            {
                                "target_lang_word": "izolovat",
                                "target_lang_sense_clarification": "úplně odloučit od vnějšího prostředí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c76ad2a3-51b3-3b7d-ab99-05d031a2de4a",
                    "sense_definition": "To remove and store a substance, especially carbon, from the atmosphere or environment.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "New technologies aim to <w>sequester</w> carbon dioxide emissions deep underground.",
                            "target_lang_translations": {
                                "cs": "Nové technologie se snaží <w>zachytit</w> emise oxidu uhličitého hluboko pod zemí."
                            }
                        },
                        {
                            "text": "Forests help to <w>sequester</w> carbon, which is vital for fighting climate change.",
                            "target_lang_translations": {
                                "cs": "Lesy pomáhají <w>ukládat</w> uhlík, což je zásadní pro boj proti klimatickým změnám."
                            }
                        }
                    ],
                    "synonyms": [
                        "set aside",
                        "put aside"
                    ],
                    "common_phrases": [
                        "sequester carbon"
                    ],
                    "target_lang_definitions": {
                        "cs": "Odstranit a uložit látku, zejména uhlík, z atmosféry nebo životního prostředí."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zachytit",
                                "target_lang_sense_clarification": "v kontextu emisí a plynů"
                            },
                            {
                                "target_lang_word": "ukládat",
                                "target_lang_sense_clarification": "dlouhodobé uskladnění v přírodě"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "825ea98b-133b-34a3-b89b-a9f6888971e2",
                    "sense_definition": "To legally take and hold property until a debt or legal claim is resolved.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_seizure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court ordered the bank to <w>sequester</w> the company's assets during the investigation.",
                            "target_lang_translations": {
                                "cs": "Soud nařídil bance, aby během vyšetřování <w>zajistila</w> majetek společnosti."
                            }
                        },
                        {
                            "text": "Authorities may <w>sequester</w> property if it is suspected to be involved in illegal activities.",
                            "target_lang_translations": {
                                "cs": "Úřady mohou <w>zabavit</w> majetek, pokud existuje podezření, že je spojen s nelegální činností."
                            }
                        }
                    ],
                    "synonyms": [
                        "appropriate",
                        "set aside"
                    ],
                    "target_lang_definitions": {
                        "cs": "Právně zabavit a držet majetek, dokud není vyřešen dluh nebo právní nárok."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zabavit",
                                "target_lang_sense_clarification": "v právním smyslu"
                            },
                            {
                                "target_lang_word": "zajistit",
                                "target_lang_sense_clarification": "dočasné právní zajištění majetku"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8abc900b-4ed4-3bff-9095-487a3363b22e",
                    "sense_definition": "The act of separating or isolating something or someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "isolation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sequester</w> of the jury was necessary to ensure a fair trial.",
                            "target_lang_translations": {
                                "cs": "<w>Izolace</w> poroty byla nezbytná pro zajištění spravedlivého procesu."
                            }
                        },
                        {
                            "text": "He sought a <w>sequester</w> from the noise of the city to focus on his writing.",
                            "target_lang_translations": {
                                "cs": "Hledal <w>izolaci</w> od hluku velkoměsta, aby se mohl soustředit na psaní."
                            }
                        }
                    ],
                    "synonyms": [
                        "separate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Akt oddělení nebo izolace něčeho či někoho."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "izolace",
                                "target_lang_sense_clarification": "stav odloučení"
                            },
                            {
                                "target_lang_word": "oddělení",
                                "target_lang_sense_clarification": "proces rozdělení"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}