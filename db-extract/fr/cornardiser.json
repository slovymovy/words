                "senses": [
                    {
                        "sense_id": "9e8252a0-38cf-3892-ac5b-c0501fceb762",
                        "entry_id": "55b93cd3-6f49-373c-9c53-355eb38f9485",
                        "glosses": [
                            "Traiter comme un cornard."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "737b1965-9413-4fb6-ad10-eec2adcf1324",
                                "sense_id": "9e8252a0-38cf-3892-ac5b-c0501fceb762",
                                "text": "Le jaune étant aussi la couleur des \"cocus\", il est clair que si les mesures du CISR étaient maintenues nous serions effectivement \"cornardisés\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "4fb09dbb-ae70-312d-bb1b-886c42696475",
                        "entry_id": "55b93cd3-6f49-373c-9c53-355eb38f9485",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter) Voir Discussion:cornardiser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b33f9c6-d2db-4fd6-8b6c-69f72f06366e",
                                "sense_id": "4fb09dbb-ae70-312d-bb1b-886c42696475",
                                "text": "Ainsi, dans notre monde officiel, cornardiser quelqu’un, c’est souvent lui procurer de l’avancement, de la fortune et des honneurs; seulement nous évitons généralement l’emploi du mot propre."
                            }
                        ]
                    }
