                {
                    "sense_id": "50e968a3-0759-31cc-a375-4e528ec27cc2",
                    "sense_definition": "Provoquer un sentiment d'insatisfaction ou d'irritation chez quelqu'un en empêchant la réalisation d'un désir ou d'une attente.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette situation difficile continue de me <w>frustrer</w> au quotidien."
                        },
                        {
                            "text": "Le manque de temps <w>frustre</w> souvent les créateurs dans leur travail."
                        }
                    ],
                    "synonyms": [
                        "décevoir",
                        "contrarier",
                        "agacer"
                    ],
                    "antonyms": [
                        "satisfaire",
                        "combler"
                    ],
                    "common_phrases": [
                        "frustrer les attentes"
                    ]
                },
                {
                    "sense_id": "30cd19b7-f68c-3be8-ae63-451eff6c9fae",
                    "sense_definition": "Priver quelqu'un injustement de ce qui lui appartient légitimement ou de ce qui lui est dû.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "privation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat affirme qu'on a cherché à <w>frustrer</w> son client de ses droits."
                        },
                        {
                            "text": "Cette décision injuste risque de <w>frustrer</w> les créanciers de leur argent."
                        }
                    ],
                    "synonyms": [
