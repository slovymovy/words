                        "cross_references": [
                            {
                                "target_word": "cuckold",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a1c52de-c414-306b-bd3a-c35328d841e6",
                                        "entry_id": "4ac4c1b6-245f-3415-850a-2fb77be6bb74",
                                        "glosses": [
                                            "A man married to an unfaithful wife, especially when he is unaware or unaccepting of the fact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4999da66-c2f1-40a8-a43a-dadd5e42ece9",
                                                "sense_id": "0a1c52de-c414-306b-bd3a-c35328d841e6",
                                                "text": "If I never marry, I shall never be a cuckold."
                                            },
                                            {
                                                "example_id": "d826967f-0abb-40bb-8754-bfb3670d2163",
                                                "sense_id": "0a1c52de-c414-306b-bd3a-c35328d841e6",
                                                "text": "You see, it happened that two lieutenantesses were fighting, because their husbands had made cuckolds of them ..."
                                            },
                                            {
                                                "example_id": "4f38d44a-eb0f-4b82-a368-140d3a1ba643",
                                                "sense_id": "0a1c52de-c414-306b-bd3a-c35328d841e6",
                                                "text": "In the early English drama, no play better approximates Ovid's contemptuous portrait of the willing cuckold than does Thomas Middleton's Chaste Maid in Cheapside (ca. 1612)."
                                            },
                                            {
                                                "example_id": "aff62c8d-30f7-49a0-bcba-3c24a9c2e2ff",
                                                "sense_id": "0a1c52de-c414-306b-bd3a-c35328d841e6",
                                                "text": "Nothing captured the alt-right mentality better than cuckservative, with its taunt that moderation is unmanly and certain conservative males are cuckolds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08187ccb-23e1-3699-b22d-943f1c024fa7",
                                        "entry_id": "4ac4c1b6-245f-3415-850a-2fb77be6bb74",
                                        "glosses": [
                                            "A man who is paraphilically attracted to or aroused by the sexual infidelity of a partner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03a3243f-c57b-38f9-af3c-1f1574d3f762",
                                        "entry_id": "4ac4c1b6-245f-3415-850a-2fb77be6bb74",
                                        "glosses": [
                                            "A West Indian plectognath fish, Rhinesomus triqueter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9790faf-a8c0-3279-98ed-e3fc154ebdc9",
                                        "entry_id": "4ac4c1b6-245f-3415-850a-2fb77be6bb74",
                                        "glosses": [
                                            "The scrawled cowfish, Acanthostracion quadricornis and allied species."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "827536ed-3d2a-3c31-a052-26a9e11c82d2",
                                        "entry_id": "4ac4c1b6-245f-3415-850a-2fb77be6bb74",
