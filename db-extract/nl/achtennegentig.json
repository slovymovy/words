                    {
                        "sense_id": "4da562b4-515a-3ffe-9e91-0b4740cafacc",
                        "entry_id": "9fe3a896-cdfc-3263-adec-4da5c20a6f61",
                        "glosses": [
                            "dat wat in een (rang)ordening met 98 is aangeduid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8762dc71-230d-4fbb-a63f-83d2791e8089",
                                "sense_id": "4da562b4-515a-3ffe-9e91-0b4740cafacc",
                                "text": "Het is weer de achtennegentig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "d3deb719-3a64-4b8e-b91f-b6473e64ec93",
                                "sense_id": "4da562b4-515a-3ffe-9e91-0b4740cafacc",
                                "text": "Haar negenennegentigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de achtennegentig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "a08d0153-39ad-3f28-a8f5-41e5129b4782",
                        "entry_id": "9fe3a896-cdfc-3263-adec-4da5c20a6f61",
                        "glosses": [
                            "groep van 98 eenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66bdcae0-f38f-461c-8cdd-1a2b4aba2fd4",
                                "sense_id": "a08d0153-39ad-3f28-a8f5-41e5129b4782",
                                "text": "De achtennegentig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
                ],
