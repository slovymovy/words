                "senses": [
                    {
                        "sense_id": "d821b77e-4abe-3d6c-9f2d-71bfc9d157ab",
                        "entry_id": "0b36da43-e092-3a39-93e0-53082ee0d5d4",
                        "glosses": [
                            "abwertend: medizinische Einrichtung zur längerfristigen Behandlung/Unterbringung von psychisch Kranken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4be6d167-d162-40f4-9448-855e7c37acdd",
                                "sense_id": "d821b77e-4abe-3d6c-9f2d-71bfc9d157ab",
                                "text": "„Meine Mutter war auf dem Weg in eine Irrenanstalt und mein Vater ein schlechtgelaunter und übernächtigter Fahrer.“"
                            },
                            {
                                "example_id": "9ae6fc9a-f9f8-47b1-9f43-908b0769b994",
                                "sense_id": "d821b77e-4abe-3d6c-9f2d-71bfc9d157ab",
                                "text": "„Man wartete nur darauf, daß in der Irrenanstalt Platz wurde, denn die war auch überfüllt.“"
                            },
                            {
                                "example_id": "f7afe230-c7c7-4575-b8a0-b1caf82abcf4",
                                "sense_id": "d821b77e-4abe-3d6c-9f2d-71bfc9d157ab",
                                "text": "„An der Mauer einer Irrenanstalt floß ein Bach vorbei.“"
                            },
                            {
                                "example_id": "64490153-3211-4d55-a6bf-05808840f9d2",
                                "sense_id": "d821b77e-4abe-3d6c-9f2d-71bfc9d157ab",
                                "text": "„Nur an seinem Ende, beim Armenhause und der Irrenanstalt standen einige kleine Gruppen in weissen Kitteln herum, und einige ebenso gekleidete Leute gingen über das Feld, schrien und fuchtelten mit den Armen.“"
                            },
                            {
                                "example_id": "3f99b640-5abe-43b2-81df-357144bc06de",
                                "sense_id": "d821b77e-4abe-3d6c-9f2d-71bfc9d157ab",
                                "text": "„Einen tiefen Einblick in die teils widersinnigen Aspekte der Bevölkerungsverschiebungen gibt Saadat Hasan Manto mit seiner Kurzgeschichte Toba Tek Singh, in der Patienten einer Irrenanstalt nach der Teilung auf die nun «richtige» Seite verfrachtet werden müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
