                            }
                        },
                        {
                            "text": "Despite receiving several rejection letters, she refused to feel <w>downhearted</w> about her future.",
                            "target_lang_translations": {
                                "es": "A pesar de recibir varias cartas de rechazo, se negó a sentirse <w>descorazonada</w> respecto a su futuro."
                            }
                        }
                    ],
