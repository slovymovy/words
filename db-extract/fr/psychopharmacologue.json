                        "sense_id": "33e166be-d3b1-384e-9aa7-54993439577f",
                        "entry_id": "1770f881-b392-3609-b9e0-853ba9e0cd09",
                        "glosses": [
                            "Professionnel de santé ou professionnelle de santé spécialisé(e) en psychopharmacologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8f378f8-fec8-4727-b755-ed2af4d2ebba",
                                "sense_id": "33e166be-d3b1-384e-9aa7-54993439577f",
                                "text": "Le psychopharmacologue Matthias Liechti mène des recherches sur le LSD dans le but de créer de nouveaux médicaments pour traiter les maladies psychiques."
                            },
                            {
                                "example_id": "beb488ee-6e82-445f-bd1c-c5479e61fd2c",
                                "sense_id": "33e166be-d3b1-384e-9aa7-54993439577f",
                                "text": "Je suis tellement navré qu’il est préféré te donner du Xanax, ce n’est pas une bonne idée, la psychopharmacologue que tu connais, la dénommée Chrystal Heather Ashton (paix à son âme) préconise un arrêt avec une benzo comme le Valium ou le Lysanxia."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5237cc7-6320-465c-9b0b-ae31b5e8afd1",
                        "source_entry_id": "1770f881-b392-3609-b9e0-853ba9e0cd09",
                        "source_sense_id": "33e166be-d3b1-384e-9aa7-54993439577f",
