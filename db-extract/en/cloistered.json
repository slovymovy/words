                        "entry_id": "f6ea3324-66fc-35c0-b024-38ca376d9603",
                        "glosses": [
                            "Dwelling or raised in, or as if in, cloisters; solitary."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aafb1522-954e-4b20-b779-89b08e5af497",
                                "sense_id": "a4d2e3b8-2078-38a1-b644-ec21b873a2a4",
                                "text": "Cloistered friars and vestal nuns."
                            },
                            {
                                "example_id": "3d4be79c-f1e3-4aca-8002-caeb26229a7f",
                                "sense_id": "a4d2e3b8-2078-38a1-b644-ec21b873a2a4",
                                "text": "In cloister'd state let selfish sages dwell, / Proud that their heart is narrow as their cell."
                            }
                        ]
                    },
                    {
                        "sense_id": "efb36e8a-e066-39ac-aca7-2566150caf57",
                        "entry_id": "f6ea3324-66fc-35c0-b024-38ca376d9603",
                        "glosses": [
                            "Isolated, protected, hidden away for the sake of maintaining innocence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f43b7cda-050c-4b8c-8655-8318442e609e",
                                "sense_id": "efb36e8a-e066-39ac-aca7-2566150caf57",
                                "text": "[…]“The Vegan” is a less cloistered book, with bigger, more universal themes."
                            }
                        ]
                    },
                    {
                        "sense_id": "91b6732e-63a1-3a80-aa99-ae18820ba65c",
                        "entry_id": "f6ea3324-66fc-35c0-b024-38ca376d9603",
                        "glosses": [
                            "Naive, lacking in worldliness."
