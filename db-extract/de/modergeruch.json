                ],
                "senses": [
                    {
                        "sense_id": "25a3d295-fa03-3e06-8a0d-a5c75ee088fa",
                        "entry_id": "a4dfd8c1-5707-3cd9-90d5-78f703ec1c8c",
                        "glosses": [
                            "Geruch, der von Moder ausgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58db799d-3d26-4145-b1a0-f347cc8d22c2",
                                "sense_id": "25a3d295-fa03-3e06-8a0d-a5c75ee088fa",
                                "text": "„Wir traten ein, und mir schwanden beinahe die Sinne angesichts des uralten Modergeruchs, der uns empfing und die Frucht ganzer Jahrhunderte ungesunden Zerfalls sein musste.“"
                            },
                            {
                                "example_id": "f34719e0-09b2-414c-89f0-ecf2c737c30c",
                                "sense_id": "25a3d295-fa03-3e06-8a0d-a5c75ee088fa",
                                "text": "„Leise stand ich auf und öffnete ein Fenster, damit der Whiskydunst und der Modergeruch der uralten Bücher und Manuskripte abzogen.“"
                            },
                            {
                                "example_id": "3767cc89-4b25-494c-9154-e64605e8eeb5",
                                "sense_id": "25a3d295-fa03-3e06-8a0d-a5c75ee088fa",
                                "text": "„Mein Zimmer erwies sich als sehr bequem und schön eingerichtet, außerdem war hier nichts von dem Modergeruch oder der verstörenden Schwingung zu bemerken.“"
                            },
                            {
                                "example_id": "96a67f0b-e375-47ce-80ce-4e3b10e88e38",
                                "sense_id": "25a3d295-fa03-3e06-8a0d-a5c75ee088fa",
                                "text": "„Und die Luft schmeckte salzig, wie nach der Sole dunkler unterirdischer Gewässer, hinzu kam ein leicht unangenehmer Modergeruch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
