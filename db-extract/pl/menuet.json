                                        "sense_id": "69e5105a-2713-30ef-a908-e2ee08b41aa0",
                                        "entry_id": "93db692d-3325-3742-930b-76b5bf163686",
                                        "glosses": [
                                            "A slow graceful dance consisting of a coupé, a high step, and a balance."
                                        ],
