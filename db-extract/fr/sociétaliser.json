                        "tags": [],
                        "examples": [
                            {
                                "example_id": "826a6f8c-5963-41ac-9cb2-73e3e51e5594",
                                "sense_id": "95132a6e-2468-3015-bdb1-ab9907c3c93e",
                                "text": "Sociétaliser/étatiser est un mouvement encore peu connu en tant que tel, car souvent confondu avec le fait de pénaliser/dépénaliser."
                            },
                            {
                                "example_id": "d40ed21c-37ca-48eb-96e8-6e1946a99ae9",
                                "sense_id": "95132a6e-2468-3015-bdb1-ab9907c3c93e",
                                "text": "La différence essentielle entre le stigmate et le chevron est qu’on ne peut sociétaliser ce dernier, ou du moins difficilement."
                            }
                        ]
