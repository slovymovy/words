                "senses": [
                    {
                        "sense_id": "4a733464-7264-313b-8037-6cdcdf32bdd7",
                        "entry_id": "32f9a01a-c958-385d-bfda-649858608772",
                        "glosses": [
                            "Vorgang, bei dem etwas oder jemand eine Bewegung beendet oder die Geschwindigkeit herabsetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1f2a641-a223-49c9-a464-f03d5532713c",
                                "sense_id": "4a733464-7264-313b-8037-6cdcdf32bdd7",
                                "text": "„Bei der Abbremsung durch den Luftwiderstand entsteht infolge Reibung eine starke Aufheizung (bis zu 2000 K).“"
                            },
                            {
                                "example_id": "0b0473ef-c9a6-4659-9769-5690cd75bb1e",
                                "sense_id": "4a733464-7264-313b-8037-6cdcdf32bdd7",
                                "text": "„Nach der klassischen Elektrodynamik führt nämlich eine jede Geschwindigkeitsänderung eines geladenen Teilchens, sei es eine Beschleunigung oder eine Abbremsung, zur Ausstrahlung eines (gedämpften) Wellenzuges.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
