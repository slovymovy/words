                        "glosses": [
                            "An area of mud, possibly submerged, near the edge of a body of water."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22573140-c33f-41b5-a530-bafeb3cbfac7",
                                "sense_id": "4cafa012-53a9-3af4-bdd6-08fe09593ccf",
                                "text": "Before we had gone fifty yards we perceived that all hopes of getting further up the stream in the whale-boat were at an end, for not two hundred yards above where we had stopped were a succession of shallows and mudbanks, with not six inches of water over them."
                            },
                            {
                                "example_id": "e59ad97b-88e8-4c7d-a6d6-8e0796f4f075",
                                "sense_id": "4cafa012-53a9-3af4-bdd6-08fe09593ccf",
                                "text": "He had a view across wide fields to the Stour nearing low tide, with its mudbanks emerging from the silver water like the humped backs of monsters, and segrasses and ccircling flocks of seabirds."
                            }
                        ]
                    }
