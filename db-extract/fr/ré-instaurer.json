                "senses": [
                    {
                        "sense_id": "694b2a9f-721a-3528-ae35-e59e2be82227",
                        "entry_id": "4f9af2f1-889a-395e-bd77-3e4aadbe3490",
                        "glosses": [
                            "Instaurer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8753618-1651-4898-ac0e-ab12b9108883",
                                "sense_id": "694b2a9f-721a-3528-ae35-e59e2be82227",
                                "text": "Mais il existe aussi des groupes difficiles qui nous demandent de passer beaucoup plus de temps à parler, à re-situer les limites, à ré-instaurer des échanges vivants et non destructeurs."
                            },
                            {
                                "example_id": "5a44f4e7-5ac2-4e35-bfc4-931fb32eab09",
                                "sense_id": "694b2a9f-721a-3528-ae35-e59e2be82227",
                                "text": "Ce pic d’intensité correspond à la nécessité de ré-instaurer une prise de parole qui, sans nécessairement avoir été perdue, a néanmoins cessé."
                            }
                        ]
                    }
