                "senses": [
                    {
                        "sense_id": "e21fb198-f74a-3f12-99bf-5e03fa61d7b2",
                        "entry_id": "9290c5e7-a57e-36a8-a99c-e5f287e6570e",
                        "glosses": [
                            "von Vereisungen der Landschaft zurückgelassenes, isoliertes und von Sedimenten überdecktes Eis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce0ea215-a43e-439f-baf3-4f64beb19cac",
                                "sense_id": "e21fb198-f74a-3f12-99bf-5e03fa61d7b2",
                                "text": "„Das Toteis ist damit vor Abschmelzen geschützt und kann oft erst nach langer Zeit schmelzen.“"
                            },
                            {
                                "example_id": "9260872c-9666-40f0-b299-4fd4512fd7a9",
                                "sense_id": "e21fb198-f74a-3f12-99bf-5e03fa61d7b2",
                                "text": "„Toteis bildet in Zusammenhang mit fluvioglazialen Sedimenten Eiszerfallslandschaften. “"
                            },
                            {
                                "example_id": "b74946c5-e076-422b-802b-7298f2305bb1",
                                "sense_id": "e21fb198-f74a-3f12-99bf-5e03fa61d7b2",
                                "text": "„Meist kommt Toteis im Innern von End- und Ufermoränen vor, nachdem sich der Gletscher von diesen \"zurückgezogen\" hat. Toteis kann sich auch beim Schwund einer flachen, langen Gletscherzunge bilden. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
