                        "entry_id": "7674ebbb-388d-372a-a614-ab825bb17a27",
                        "glosses": [
                            "Acronym of Middle East respiratory syndrome, also MERS."
                        ],
                        "tags": [
                            "abbreviation",
                            "acronym",
                            "alt-of",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "aafb0e4a-aec3-49fc-b8c3-beea1db29273",
                                "sense_id": "4adef647-f0d0-312f-bd81-3e494217c2c8",
                                "text": "Coronaviruses have been causing problems for humanity for a long time. Several versions are known to trigger common colds and more recently two types have set off outbreaks of deadly illnesses: severe acute respiratory syndrome (Sars) and Middle East respiratory syndrome (Mers)."
                            }
                        ]
                    }
