                        "target_lang_word": "trickle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trickle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2af16285-b0cc-3ec3-985f-9921edd72213",
                                        "entry_id": "7504b87a-2df7-3778-9e9b-2b03a5e4cfbd",
                                        "glosses": [
                                            "A very thin river."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7196c8f2-0a1d-4907-b816-ba2063a1dec9",
                                                "sense_id": "2af16285-b0cc-3ec3-985f-9921edd72213",
                                                "text": "The brook had shrunk to a mere trickle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14cd9e09-6893-35d1-9e45-e70877cdc5e9",
                                        "entry_id": "7504b87a-2df7-3778-9e9b-2b03a5e4cfbd",
                                        "glosses": [
                                            "A very thin flow; the sound of such a flow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "594fdbf5-51de-47e6-9d39-b2c8c8b268c0",
                                                "sense_id": "14cd9e09-6893-35d1-9e45-e70877cdc5e9",
                                                "text": "The tap of the washbasin in my bedroom is leaking and the trickle drives me mad at night."
                                            },
                                            {
                                                "example_id": "3a6cb449-1e19-43b0-9f9b-178c34b27b3b",
                                                "sense_id": "14cd9e09-6893-35d1-9e45-e70877cdc5e9",
                                                "text": "The streams that run south and east from the mountains to the coast are short and rapid torrents after a storm, but at other times dwindle to feeble trickles of mud."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trickle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb6d7821-9c54-34c3-99c8-c11725008710",
                                        "entry_id": "af2933a5-a237-3a4e-9a05-a7a42c2dcdb8",
                                        "glosses": [
                                            "to pour a liquid in a very thin stream, or so that drops fall continuously."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc348a89-2eab-4564-ab46-b31c522eb304",
                                                "sense_id": "fb6d7821-9c54-34c3-99c8-c11725008710",
                                                "text": "The doctor trickled some iodine on the wound."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27fbfdc8-fb6b-39dc-8af1-b5beea654a8f",
                                        "entry_id": "af2933a5-a237-3a4e-9a05-a7a42c2dcdb8",
                                        "glosses": [
                                            "to flow in a very thin stream or drop continuously."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d522f85-feb1-4bc4-9462-7402228cb301",
                                                "sense_id": "27fbfdc8-fb6b-39dc-8af1-b5beea654a8f",
                                                "text": "Here the water just trickles along, but later it becomes a torrent."
                                            },
                                            {
                                                "example_id": "70d1326e-cee3-4a3f-9bea-8efa8bfb05cb",
                                                "sense_id": "27fbfdc8-fb6b-39dc-8af1-b5beea654a8f",
                                                "text": "The film was so bad that people trickled out of the cinema before its end."
                                            },
                                            {
                                                "example_id": "91406d5e-8a6c-4eba-adfe-5b6475aff7b8",
                                                "sense_id": "27fbfdc8-fb6b-39dc-8af1-b5beea654a8f",
                                                "text": "Her white night-dress was smeared with blood, and a thin stream trickled down the man's bare chest which was shown by his torn-open dress."
                                            },
                                            {
                                                "example_id": "ec5672b6-5c03-4ced-8ba7-0d3d53f8c7b4",
                                                "sense_id": "27fbfdc8-fb6b-39dc-8af1-b5beea654a8f",
                                                "text": "The period of intensive traffic is over by about 5.30 p.m. and for the rest of the evening steadily diminishes, the main activity being the Channel Islands boat trains which trickle in after about 6.30 p.m. and depart again for Weymouth an hour or so later."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33d2324a-7650-3b9b-b419-1b72976bdcfc",
                                        "entry_id": "af2933a5-a237-3a4e-9a05-a7a42c2dcdb8",
                                        "glosses": [
                                            "To move or roll slowly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1889c716-c38e-4b76-8fb8-6e0566e17f11",
                                                "sense_id": "33d2324a-7650-3b9b-b419-1b72976bdcfc",
                                                "text": "Some [marbles] were found in a child's grave at Nagada, Egypt […] together with a set of ninepins and three rectangular bricks which could have formed an arch through which to trickle the balls."
                                            },
                                            {
                                                "example_id": "e37303ba-7ce1-4148-a3be-b6b78cb88d22",
                                                "sense_id": "33d2324a-7650-3b9b-b419-1b72976bdcfc",
                                                "text": "Their only shot of the first period was a long-range strike from top-scorer Ebanks-Blake which trickled tamely wide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
