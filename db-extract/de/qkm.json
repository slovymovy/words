        "de-extract.jsonl": [
            {
                "entry_id": "46097f1a-114a-3c75-96d6-3bd84743e9f9",
                "word": "qkm",
                "pos": "abbrev",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3517214a-06de-39ac-baa7-2fe1ebf31725",
                        "entry_id": "46097f1a-114a-3c75-96d6-3bd84743e9f9",
                        "glosses": [
                            "Quadratkilometer"
                        ],
                        "tags": [
                            "nicht amtlich"
                        ],
                        "examples": [
                            {
                                "example_id": "95616726-a8ce-4d2a-b8d0-f4370f5073f7",
                                "sense_id": "3517214a-06de-39ac-baa7-2fe1ebf31725",
                                "text": "Fläche = 10 qkm"
                            },
                            {
                                "example_id": "bf6cd306-069e-49c4-8579-30041718b604",
                                "sense_id": "3517214a-06de-39ac-baa7-2fe1ebf31725",
                                "text": "„Von den Provinzen des Küstenstaates Mosambik ragt die Provinz Tete am weitesten in den afrikanischen Kontinent hinein. Das fast die Fläche der ehemaligen DDR umfassende, 100724 qkm große Gebiet wird von Simbabwe im Westen, Sambia im Norden und Malawi im Osten umschlossen.“"
                            },
                            {
                                "example_id": "d36f0c0d-dbc7-4ce2-b493-9b2db3ef1512",
                                "sense_id": "3517214a-06de-39ac-baa7-2fe1ebf31725",
                                "text": "„Usbekistan im Überblick […] Fläche: 447400 qkm (etwa so groß wie Marokko) davon weniger als 10 % Akkerland, 4,6 % Wasser, das restliche Territorium setzt sich aus Wüste (Kyzyl Kum) und Bergen zusammen.“"
                            },
                            {
                                "example_id": "bd0eefd4-4626-4c76-90ff-e5fe800bc269",
                                "sense_id": "3517214a-06de-39ac-baa7-2fe1ebf31725",
                                "text": "„Das Burgendland im Überblick […] Bevölkerungsdichte: 72 EW pro qkm.“"
                            },
                            {
                                "example_id": "6981db79-8d68-4ec1-8636-6ce9beab16e2",
                                "sense_id": "3517214a-06de-39ac-baa7-2fe1ebf31725",
                                "text": "„Die immer noch oft verwendete Abkürzung qkm entspricht nicht dem Internationalen Einheitensystem, den in Normen festgelegten Empfehlungen des Deutschen Instituts für Normung (DIN) und den deutschen Rechtsvorschriften über gesetzliche Einheiten im Messwesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
