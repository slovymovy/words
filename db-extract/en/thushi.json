                        "glosses": [
                            "A traditional necklace style originating from Maharashtra, India. It is a choker-like ornament made of closely knit gold beads arranged in intricate patterns, often adorned with a central decorative pendant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "363d8a7f-b947-4227-8911-98413aa1b383",
                                "sense_id": "68810828-3bb9-31b1-8083-776c39d69170",
                                "text": "Besides in its natural form, the tulsi is worn in gold by Hindu women in the ornaments known as tulsipatti or thushi."
                            },
                            {
                                "example_id": "ceadc4b6-633d-4249-8842-2c067689f2a8",
                                "sense_id": "68810828-3bb9-31b1-8083-776c39d69170",
                                "text": "The same may be said of other minor ornaments of modern date such as thushi, bindi, and others."
                            },
                            {
                                "example_id": "71da82a5-838d-4e26-826f-009a5615e935",
                                "sense_id": "68810828-3bb9-31b1-8083-776c39d69170",
                                "text": "Jewellery such as tanmani, bormal, Ranihar, kolhapuri saaj, thushi are worn on the neck;…"
                            }
                        ]
                    }
