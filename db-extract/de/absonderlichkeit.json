                                    {
                                        "sense_id": "365632c9-77ed-3e57-8c6b-ae2cbf17d829",
                                        "entry_id": "4cf0b658-20bb-3f1d-ad96-7a941cc096c0",
                                        "glosses": [
                                            "Primness, fastidiousness, preciousness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a1e8fe5-42e9-4ab8-bc14-95aacb1caa56",
                                                "sense_id": "365632c9-77ed-3e57-8c6b-ae2cbf17d829",
                                                "text": "As for good Terence, I allow the quaintnesse [translating mignardise] and grace of his Latine tongue, and judge him wonderfull conceited and apt[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5952f7ee-500c-3beb-88c6-71509765167e",
                                        "entry_id": "4cf0b658-20bb-3f1d-ad96-7a941cc096c0",
                                        "glosses": [
                                            "The state or fact of being quaint; having old-fashioned charm."
                                        ],
                                        "tags": [
