                "senses": [
                    {
                        "sense_id": "44ae25ea-3674-3ba5-98d4-a1b10832e71c",
                        "entry_id": "e70af5b4-8d92-38ca-a5a9-751facc2091b",
                        "glosses": [
                            "weibliche Person, die das Kartenspiel Poker spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa156289-14d3-4239-ab60-0d65d748ee0d",
                                "sense_id": "44ae25ea-3674-3ba5-98d4-a1b10832e71c",
                                "text": "Meine Nachbarin ist eine begeisterte Pokerspielerin."
                            },
                            {
                                "example_id": "42deec21-d56b-4614-8b8b-71adedcd0690",
                                "sense_id": "44ae25ea-3674-3ba5-98d4-a1b10832e71c",
                                "text": "„Liz Lieu ist eine professionelle Pokerspielerin, die derzeit in Los Angeles lebt.“"
                            },
                            {
                                "example_id": "2b477997-3e9e-4df5-b7a8-92934d6eef0e",
                                "sense_id": "44ae25ea-3674-3ba5-98d4-a1b10832e71c",
                                "text": "„Das Gleiche gilt fürs Lächeln. Zwar ist es manchmal ganz sinnvoll, eher wie eine kaltblütige Pokerspielerin zu gucken oder einen Widersacher mit einem eiskalten Haifischlächeln anzuschauen.“"
                            },
                            {
                                "example_id": "a515d402-4484-4287-bee8-64da654fb2c8",
                                "sense_id": "44ae25ea-3674-3ba5-98d4-a1b10832e71c",
                                "text": "„Hat ihre alten Tage in einem Altenheim am Stadtrand verbracht. Eine gute Frau. Eine raffinierte Pokerspielerin. Was hat sie getan?“"
                            },
                            {
                                "example_id": "421d486e-d9e7-4df8-8218-f25610e81ca0",
                                "sense_id": "44ae25ea-3674-3ba5-98d4-a1b10832e71c",
                                "text": "„Wie haben Ihre Eltern reagiert, als Sie Ihnen mit 27 Jahren sagten: Ich werde professionelle Pokerspielerin?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
