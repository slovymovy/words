                        "sense_id": "05113a85-724d-3ea7-b516-d47c21af0390",
                        "entry_id": "5cb0965e-5eff-355c-9fbe-6e9f58180c7c",
                        "glosses": [
                            "Action de rempoter, remettre en pot."
                        ],
                        "tags": [
                            "Jardinage"
                        ],
                        "examples": [
                            {
                                "example_id": "a8c15f98-81d0-4ce9-9fd9-598636360440",
                                "sense_id": "05113a85-724d-3ea7-b516-d47c21af0390",
                                "text": "Le rempotage successif d'une année sur l'autre évite les problèmes de chignonage des plantes en conteneur."
                            },
                            {
                                "example_id": "201c14c7-c8de-4aa2-a6c0-83b0a54bff77",
                                "sense_id": "05113a85-724d-3ea7-b516-d47c21af0390",
                                "text": "Ne fertilisez pas immédiatement après le rempotage, mais seulement 1 ou 2 mois après, pour obliger les racines à se développer vers l’extérieur de pot et à aller chercher les matières minérales dans la nouvelle couche de substrat."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e77fd04-e159-3aab-a2ba-53feb9462aab",
                        "entry_id": "5cb0965e-5eff-355c-9fbe-6e9f58180c7c",
