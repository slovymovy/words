        "fr-extract.jsonl": [
            {
                "entry_id": "bb52fb80-0195-303e-90e4-e66964587595",
                "word": "fréquentation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0ad5473b-2467-43f0-82b2-a8e0718904fa",
                        "entry_id": "bb52fb80-0195-303e-90e4-e66964587595",
                        "tags": [
                            "plural"
                        ],
                        "form": "fréquentations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7ddda4a4-d7c3-3a10-b09a-5e47e2bbd90f",
                        "entry_id": "bb52fb80-0195-303e-90e4-e66964587595",
                        "glosses": [
                            "Action de fréquenter ou de se fréquenter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e56b71e2-13f1-4fa8-b761-17db5f59b324",
                                "sense_id": "7ddda4a4-d7c3-3a10-b09a-5e47e2bbd90f",
                                "text": "Je savais, par une longue fréquentation de Jan-Mayen, qu'il y a peu de régions où tout change avec plus de brusquerie et d'inattendu."
                            },
                            {
                                "example_id": "00c8db63-1754-4e84-a906-00589c81bfaf",
                                "sense_id": "7ddda4a4-d7c3-3a10-b09a-5e47e2bbd90f",
                                "text": "Les détracteurs du nudisme - les moralistes ou hygiénistes conservateurs d’État ou d’Église - prétendent que la vue du nu, que la fréquentation entre nudistes des deux sexes exaltent le désir érotique."
                            },
                            {
                                "example_id": "633d26ee-b246-4cd8-b26c-0ae6e80d2687",
                                "sense_id": "7ddda4a4-d7c3-3a10-b09a-5e47e2bbd90f",
                                "text": "On devrait — presque — retrouver le niveau de fréquentation de 2019, qui avait battu un record."
                            },
                            {
                                "example_id": "fe8a2f0a-99c6-4600-8ee5-ab02fe9c6f16",
                                "sense_id": "7ddda4a4-d7c3-3a10-b09a-5e47e2bbd90f",
                                "text": "C'est désormais au Pakistan, ou en Iran, que la fréquentation des sites de téléchargement de films X est le plus assidue. Qui sait quelles bombes mentales s'allument dans les nuits solitaires de Kaboul ou de Karachi ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "2498f3a0-8927-3067-8e37-98035b6206c4",
                        "entry_id": "bb52fb80-0195-303e-90e4-e66964587595",
                        "glosses": [
                            "Relation de société."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd7d9d5d-918d-42a6-bf2b-befc2409e7e9",
                                "sense_id": "2498f3a0-8927-3067-8e37-98035b6206c4",
                                "text": "Vous avez, docteur, de bien curieuses fréquentations, dit-il d'un ton un peu méprisant, un représentant de ces mauvais moines adorateurs du démon ! Que les Chinois sérieux estiment un peu plus qu'un soldat, mais un peu moins qu'une prostituée !"
                            }
                        ]
                    }
                ],
