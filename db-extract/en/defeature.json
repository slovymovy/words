                        "examples": [
                            {
                                "example_id": "ab7ab9ed-27b4-4fac-acce-72a3311f2d9f",
                                "sense_id": "00d4b494-1ff1-3f6b-abe2-016f3d8c4eb1",
                                "text": "What ruins are in me that can be found, / By him not ruin'd? then is he the ground / of my defeatures."
                            },
                            {
                                "example_id": "5ceede4a-73dd-40ed-ae62-9e0e8c5d8623",
                                "sense_id": "00d4b494-1ff1-3f6b-abe2-016f3d8c4eb1",
                                "text": "But no discovery was made, for no volley of reproach was uttered, and could they have looked in their mother's face they might have seen that strange defeatures were written there."
                            }
                        ]
                    }
                ],
