                                        "examples": [
                                            {
                                                "example_id": "a83e11d5-4ef3-43d4-ac09-6336ca311af4",
                                                "sense_id": "f20ff686-5f51-30ad-8474-b5b83470c9c7",
                                                "text": "Radca chwilowo przeprosił zebranych, najwidoczniej zmierzając pospiesznie do prewetu."
                                            }
