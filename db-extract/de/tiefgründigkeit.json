                    },
                    {
                        "translation_id": "d1ff7769-6224-420c-8c02-32fde4f898c3",
                        "source_entry_id": "581a6eb1-4e3b-3eee-bb97-542294aaf8ed",
                        "source_sense_id": "e1e552b8-921f-3e7d-ae89-c4fe7742bd42",
                        "source_sense_description": "anspruchsvoller Gehalt eines Textes",
                        "target_lang_word": "profondeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "profondeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f21d27fe-0666-38ca-8698-4436d56de869",
                                        "entry_id": "0ba62ccd-4521-32e5-81cd-152e9133a751",
                                        "glosses": [
                                            "Étendue d’une chose considérée depuis la surface ou l’entrée jusqu’au fond."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "462b62a9-dd25-4eae-b0f6-5a45972e06bb",
                                                "sense_id": "f21d27fe-0666-38ca-8698-4436d56de869",
                                                "text": "Au fond d'une vallée qui semblait être d'une incommensurable profondeur, la rivière Fnjóská dessinait un ruban argenté sous un dôme de noirs nuages."
                                            },
                                            {
                                                "example_id": "1d3612b8-924a-4321-b0af-73d5db1460d8",
                                                "sense_id": "f21d27fe-0666-38ca-8698-4436d56de869",
                                                "text": "Les deux dangers à craindre en rapport avec la profondeur d’eau, sont le cabanement (arrière qui plonge) et le salut (étrave qui plonge), le lancement doit se faire à l’étale pour éviter tout courant risquant de porter le navire de travers."
                                            },
                                            {
                                                "example_id": "37390c63-3459-4874-9a37-4a856bfd4ff4",
                                                "sense_id": "f21d27fe-0666-38ca-8698-4436d56de869",
                                                "text": "La piscine de l’hôtel était quarante mètres de long, quinze mètres de large et trois mètres de profondeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84ce98c4-1d27-35f1-99cc-69a05287347c",
                                        "entry_id": "0ba62ccd-4521-32e5-81cd-152e9133a751",
                                        "glosses": [
                                            "Dimension d’un corps considéré de haut en bas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d224b40a-234c-4fe0-8859-ef49333fd0b0",
                                                "sense_id": "84ce98c4-1d27-35f1-99cc-69a05287347c",
                                                "text": "Il y a trois dimensions : longueur, largeur et profondeur."
                                            },
                                            {
                                                "example_id": "779b18da-3d50-4c4c-9149-8e05ab4df688",
                                                "sense_id": "84ce98c4-1d27-35f1-99cc-69a05287347c",
                                                "text": "Le concept a été formulé il y a des décennies : stimuler électriquement le cerveau pour qu'il \"voie\" des points lumineux ou \"phosphènes\", des sortes de pixels, mais avec de la profondeur en plus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64665e20-0dad-3560-a474-6dacbffd16b7",
                                        "entry_id": "0ba62ccd-4521-32e5-81cd-152e9133a751",
                                        "glosses": [
                                            "Étendue dans le sens horizontal perpendiculairement à la largeur."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eda946ad-baee-49a0-8ba9-4996b99e922e",
                                                "sense_id": "64665e20-0dad-3560-a474-6dacbffd16b7",
                                                "text": "Cette cour a tant de profondeur. - Ce bâtiment a plus de profondeur que de largeur. - Cette cour a tant de mètres de large et tant de mètres de profondeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c13323c3-d48f-3668-9476-34f8960e9198",
                                        "entry_id": "0ba62ccd-4521-32e5-81cd-152e9133a751",
                                        "glosses": [
                                            "Épaisseur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e95ee03-f6a1-4238-9eeb-38ff944ac7c1",
                                                "sense_id": "c13323c3-d48f-3668-9476-34f8960e9198",
                                                "text": "Une troupe rangée sur tant d’hommes de profondeur, sur une grande profondeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e484a11-f4f5-3623-b9bb-5968f1c05612",
                                        "entry_id": "0ba62ccd-4521-32e5-81cd-152e9133a751",
                                        "glosses": [
                                            "Nature de ce qui est abscons, impénétrable, incompréhensible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56993955-df4f-4f70-a0ab-aea1dd8d11e6",
                                                "sense_id": "4e484a11-f4f5-3623-b9bb-5968f1c05612",
                                                "text": "La profondeur des jugements de Dieu. - Cet homme d’état s’est révélé par la profondeur de ses desseins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce15df37-235a-3ca9-a147-03672c96b575",
                                        "entry_id": "0ba62ccd-4521-32e5-81cd-152e9133a751",
                                        "glosses": [
                                            "Grande étendue, grande pénétration."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06ce1aeb-de19-46a2-9441-168268206e90",
                                                "sense_id": "ce15df37-235a-3ca9-a147-03672c96b575",
                                                "text": "La profondeur de son savoir, de son érudition, de son esprit. - Il a de la profondeur dans l’esprit, dans les idées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19b56e00-1618-3254-98fe-db5f16f95f0c",
                                        "entry_id": "0ba62ccd-4521-32e5-81cd-152e9133a751",
                                        "glosses": [
                                            "Les parties profondes."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60557763-2121-4563-a867-5c5dcb7eb241",
                                                "sense_id": "19b56e00-1618-3254-98fe-db5f16f95f0c",
                                                "text": "Puis la corde redescend dans les profondeurs où elle va rechercher un autre fardeau, […]."
                                            },
                                            {
                                                "example_id": "d4a2f5a2-4c9f-4912-a2c3-9fc257e2b352",
                                                "sense_id": "19b56e00-1618-3254-98fe-db5f16f95f0c",
                                                "text": "Il pâlit un peu, puis, tentant un effort désespéré, réussit à dégager un pied, tandis que l’autre restait prisonnier de la glu mouvante et fétide des profondeurs."
                                            },
                                            {
                                                "example_id": "128b7f8f-baf8-41b7-a669-01d7fdb49798",
                                                "sense_id": "19b56e00-1618-3254-98fe-db5f16f95f0c",
                                                "text": "Leduc ne savait plus comment se tenir et Mᵐᵉ Maigret, plus gênée que lui, fonça vers les profondeurs de l’appartement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
