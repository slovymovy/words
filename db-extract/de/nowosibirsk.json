                    {
                        "translation_id": "84592edc-5edf-48b1-b180-0d5b44366ce8",
                        "source_entry_id": "f3edbb16-2a15-3317-a624-9105547ad029",
                        "source_sense_id": "48a204d6-bd3e-3a99-86f1-8748722e17df",
                        "source_sense_description": "am Fluss Ob gelegene Stadt in Russland",
                        "target_lang_word": "Новосибирск",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Новосибирск",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7d64a27c-e53b-3896-9001-20a3c0ae3e49",
                                        "entry_id": "a786a6a0-9689-38c2-a189-a634de92f3f7",
                                        "glosses": [
                                            "геогр. город в России, центр Новосибирской области"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4453162-7ecb-4ead-a705-570a34c4298d",
                                                "sense_id": "7d64a27c-e53b-3896-9001-20a3c0ae3e49",
                                                "text": "Нескольким парам он порекомендовал уехать на несколько лет на восток, в Новосибирск или даже в Хабаровск, — это было продолжение и развитие его мыслей, связанных с природными ритмами и часовыми поясами…"
                                            },
                                            {
                                                "example_id": "ca74b89b-45f9-410b-a038-bc21a1c80fe1",
                                                "sense_id": "7d64a27c-e53b-3896-9001-20a3c0ae3e49",
                                                "text": "В 1931 году в молодом городе Новосибирске, в 1925 году переименованном из Новониколаевска, началось строительство Дома науки и культуры с круглой цирковой ареной."
                                            },
                                            {
                                                "example_id": "d6c5d8cd-751a-4b91-bcf9-38352c9b192a",
                                                "sense_id": "7d64a27c-e53b-3896-9001-20a3c0ae3e49",
                                                "text": "Фонд борьбы с коррупцией опубликовал расследование о незаконном бизнесе чиновников Новосибирска. Над ним Алексей Навальный работал незадолго до своего отравления. // В 40-минутном фильме под названием «Кто захватил столицу Сибири и как её освободить» рассказывается о депутатах городской думы и чиновниках администрации Новосибирска, которые являются бенефициарами крупных строительных компаний и организаций ЖКХ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
