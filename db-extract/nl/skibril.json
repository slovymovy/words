                        "source_sense_id": "70afa35b-56b5-3e84-b8cc-c9d9b0f9d581",
                        "source_sense_description": "bril die tijdens het skiën gedragen wordt",
                        "target_lang_word": "Skibrille",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Skibrille",
