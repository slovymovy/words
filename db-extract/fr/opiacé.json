                    {
                        "sense_id": "a9d703b1-074d-3212-90c1-a904e0c5ff70",
                        "entry_id": "7beb950b-fa6b-300e-ad06-dc77a960d348",
                        "glosses": [
                            "Qui contient de l’opium, en parlant de certains médicaments ou de certaines substances."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57904656-1cf6-461d-8a9a-302734dba891",
                                "sense_id": "a9d703b1-074d-3212-90c1-a904e0c5ff70",
                                "text": "Électuaire opiacé."
                            },
                            {
                                "example_id": "688db40d-beab-41b2-a46a-8ab5ac1cc735",
                                "sense_id": "a9d703b1-074d-3212-90c1-a904e0c5ff70",
                                "text": "Tabac opiacé."
                            },
                            {
                                "example_id": "763fef46-3dda-49d9-b0fa-24f33c7f9a15",
                                "sense_id": "a9d703b1-074d-3212-90c1-a904e0c5ff70",
                                "text": "Elle passait la plupart de ses après-midi étendue sur le grand lit, dans des peignoirs de bain rouge vif, à fumer des cigarettes dont l’odeur était opiacée."
                            },
                            {
                                "example_id": "0e3bbc88-0eb5-4b32-8e34-4f1bc52c4a44",
                                "sense_id": "a9d703b1-074d-3212-90c1-a904e0c5ff70",
                                "text": "C’est à Perrigny que je rencontrai mon premier camion militaire américain, piloté par un énorme Noir rieur, qui me fit monter à bord, m’offrit un paquet de cigarettes Camel opiacées, tout en conduisant comme un fou sous la pluie battante d’une nuit de septembre."
                            }
                        ]
                    }
