        "fr-extract.jsonl": [
            {
                "entry_id": "3317f948-aff8-3876-b63a-07d3d22584fd",
                "word": "enrichissement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ae1f5941-02eb-4f2e-824b-c89a75679d32",
                        "entry_id": "3317f948-aff8-3876-b63a-07d3d22584fd",
                        "tags": [
                            "plural"
                        ],
                        "form": "enrichissements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7da202d3-b91b-3820-b85e-e200138c9914",
                        "entry_id": "3317f948-aff8-3876-b63a-07d3d22584fd",
                        "glosses": [
                            "Action de rendre riche, plus riche ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a24b272e-8abe-47e1-8ba0-9fb8f9698ee9",
                                "sense_id": "7da202d3-b91b-3820-b85e-e200138c9914",
                                "text": "Si le dividende n’est pas source d’enrichissement, on peut en effet se demander comment l’actionnaire peut faire grossir son patrimoine."
                            },
                            {
                                "example_id": "3f33179c-d0dc-4473-969e-36bce4c759b7",
                                "sense_id": "7da202d3-b91b-3820-b85e-e200138c9914",
                                "text": "L’enrichissement de ce pays fut rapide."
                            },
                            {
                                "example_id": "f8d20f8e-2ed5-424f-8702-d829d3a2031d",
                                "sense_id": "7da202d3-b91b-3820-b85e-e200138c9914",
                                "text": "La lecture concourt à l’enrichissement de la mémoire."
                            },
                            {
                                "example_id": "a522223c-de7d-438a-8346-093d50b77058",
                                "sense_id": "7da202d3-b91b-3820-b85e-e200138c9914",
                                "text": "Un sage emploi de mots étrangers peut contribuer à l’enrichissement d’une langue."
                            }
                        ]
                    },
                    {
                        "sense_id": "543dfca2-1a43-31d3-9262-13a47c4ec8e7",
                        "entry_id": "3317f948-aff8-3876-b63a-07d3d22584fd",
                        "glosses": [
                            "Augmentation de la teneur d'un corps en un élément, par exemple d’un minerai en métal."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "d81d21b8-2278-445e-b43f-0785f665fccd",
                                "sense_id": "543dfca2-1a43-31d3-9262-13a47c4ec8e7",
                                "text": "Ces sites représentent 80 % des réserves métalliques de fer dans le monde. Les teneurs étant classiquement comprises entre 50 et 65 %, le minerai est ainsi directement envoyé aux aciéries sans enrichissement préalable."
                            },
                            {
                                "example_id": "dbd900f0-8dbb-4097-ab12-1d74264fa5ea",
                                "sense_id": "543dfca2-1a43-31d3-9262-13a47c4ec8e7",
                                "text": "De plus, une étude menée sur trois types de sites, un lagon, une baie semi-fermée et la mer ouverte, montre que si l’impact est mesurable en baie fermée, ce qui implique un suivi de l’enrichissement en matière organique et un contrôle de la biomasse en élevage, il est faible en baie semi-ouverte et tout juste décelable en mer ouverte seulement par la concentration en ammoniaque à proximité immédiate du train de cages."
                            }
                        ]
                    },
                    {
                        "sense_id": "56cdb6e3-76ad-36fc-ac6e-0084ea130a24",
                        "entry_id": "3317f948-aff8-3876-b63a-07d3d22584fd",
                        "glosses": [
                            "Processus par lequel est accrue la teneur d’un élément chimique en un de ses isotopes."
                        ],
                        "tags": [
                            "Nucléaire"
                        ],
                        "examples": [
                            {
                                "example_id": "8a126b04-c10c-4511-bf08-e9d4d4cc7cf6",
                                "sense_id": "56cdb6e3-76ad-36fc-ac6e-0084ea130a24",
                                "text": "Téhéran n’a pas signalé à l’agence les projets de dix nouveaux sites pour l’enrichissement d’uranium annoncés le mois dernier par le chef de l'agence atomique iranienne Ali Akhbar Salehi, alors que l’accord sur les mesures de sauvegarde de l’AIEA l’y oblige."
                            },
                            {
                                "example_id": "90dcbb25-30bf-4511-a407-a7283dfb33f9",
                                "sense_id": "56cdb6e3-76ad-36fc-ac6e-0084ea130a24",
                                "text": "En 2018, le président américain Donald Trump a retiré unilatéralement les États-Unis de l'accord sur le nucléaire iranien, dans lequel Téhéran avait accepté de limiter son enrichissement d'uranium en échange de la levée des sanctions économiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a95c7e3-d984-353c-b9aa-9aaf1c7d39ab",
                        "entry_id": "3317f948-aff8-3876-b63a-07d3d22584fd",
                        "glosses": [
                            "Plantation ponctuelle d’essences plus nobles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f22b1236-b2e4-4425-8e47-7f487e7bb825",
                                "sense_id": "8a95c7e3-d984-353c-b9aa-9aaf1c7d39ab",
                                "text": "Dans certains cas, l’enrichissement des peuplements par plantation de bouquets ou parquets d’autres essences peut aussi s’avérer pertinent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec52298e-3c82-4871-bc85-f278af48dbae",
                        "source_entry_id": "3317f948-aff8-3876-b63a-07d3d22584fd",
                        "target_lang_word": "Anreicherung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anreicherung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81093c16-4d79-3f49-8754-d6bda79debea",
                                        "entry_id": "556a498e-5807-3f55-8104-5351a3be79c2",
                                        "glosses": [
                                            "Erhöhung einer Menge, insbesondere einer Konzentration"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad242c54-354f-4f1c-ad3a-95eb15e801cc",
                                                "sense_id": "81093c16-4d79-3f49-8754-d6bda79debea",
                                                "text": "Der Chemiker veranlasst eine Anreicherung der Chemikalien."
                                            },
                                            {
                                                "example_id": "836caad0-bafd-4b09-876f-c5ffcd9a93d8",
                                                "sense_id": "81093c16-4d79-3f49-8754-d6bda79debea",
                                                "text": "„Für das Kreditgewerbe kann es in dieser Lage nur eine sinnvolle Entscheidung geben: Banken und Sparkassen müssen sich mit ganzer Kraft auf die billigste Form der Eigenkapitalbeschaffung konzentrieren, auf die Anreicherung der haftenden Eigenmittel aus selbstverdienten Erträgen.“"
                                            },
                                            {
                                                "example_id": "35107728-cfbf-4c99-a85f-eff76b55420f",
                                                "sense_id": "81093c16-4d79-3f49-8754-d6bda79debea",
                                                "text": "„Ihre nahe gelegenen Mausoleen geben ein interessantes Beispiel für die Anreicherung persischer Baukunst mit Elementen der Hindu-Tempelarchitektur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f40cf9db-4285-4df9-9896-f7a3c8645549",
