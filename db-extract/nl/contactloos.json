                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e727dae-1a3c-4a19-ab84-0fcf715a5934",
                                "sense_id": "aaa24514-5a12-3254-b5ca-ab07919c5ddd",
                                "text": "Bij contactloos betalen is er geen fysiek contact tussen de pin-pas en de betaalautomaat."
                            },
                            {
                                "example_id": "1a9bcde8-7a13-4730-a864-ab452acca705",
                                "sense_id": "aaa24514-5a12-3254-b5ca-ab07919c5ddd",
                                "text": "Het is voor criminelen heel eenvoudig om misbruik te maken van de nieuwe betaalpassen waarmee consumenten contactloos kunnen afrekenen aan de kassa"
                            },
                            {
                                "example_id": "da66b7aa-baa1-4f65-a13c-890d396b3c83",
                                "sense_id": "aaa24514-5a12-3254-b5ca-ab07919c5ddd",
                                "text": "Uit onderzoek is gebleken dat mensen contactloos 30 procent meer uitgeven. Dat geldt vooral voor jongeren."
                            }
                        ]
                    }
