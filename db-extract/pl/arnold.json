                "translations": [
                    {
                        "translation_id": "e7a2e686-c040-4b1b-a528-0ee1c7d57206",
                        "source_entry_id": "6de8e84a-b690-3b66-be28-215737bff39f",
                        "source_sense_id": "d069c1f4-ffd7-3454-a2c0-c19d292ca5a3",
                        "source_sense_description": "umgangssprachlich: Muskelmann, Muskelpaket, Muskelprotz",
                        "target_lang_word": "Muskelmann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Muskelmann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "deaa70e2-650e-3504-851d-0539dc6e0f4a",
                                        "entry_id": "1ac32c8e-d73f-39f8-a5a6-c704f8b67c81",
                                        "glosses": [
                                            "Mann mit besonders ausgeprägten, trainierten Muskeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72007dce-3f73-453e-b85d-69bb8a4472f7",
                                                "sense_id": "deaa70e2-650e-3504-851d-0539dc6e0f4a",
                                                "text": "„Ein chromblitzender Geländewagen mit einer auffälligen Werbeaufschrift wurde von einem braungebrannten Muskelmann aus einer Ausfahrt gesteuert.“"
                                            },
                                            {
                                                "example_id": "a7c4cb28-b483-4642-ab43-6a9f447ece5c",
                                                "sense_id": "deaa70e2-650e-3504-851d-0539dc6e0f4a",
                                                "text": "„Ohne auch nur einen Augenblick zu zögern, ließ ihn der Muskelmann herein.“"
                                            },
                                            {
                                                "example_id": "e978450f-adb8-4201-8fcc-205c9298104d",
                                                "sense_id": "deaa70e2-650e-3504-851d-0539dc6e0f4a",
                                                "text": "„Zwei Muskelmänner, die sonst wahrscheinlich beim Bestattungsinstitut Pietät-Meyer arbeiten, tragen die Torte rein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65dce22b-359d-4a6b-8687-581345762b54",
                        "source_entry_id": "6de8e84a-b690-3b66-be28-215737bff39f",
                        "source_sense_id": "d069c1f4-ffd7-3454-a2c0-c19d292ca5a3",
                        "source_sense_description": "umgangssprachlich: Muskelmann, Muskelpaket, Muskelprotz",
                        "target_lang_word": "Muskelpaket",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Muskelpaket",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac22c3b8-3c2b-3692-9538-ac2e75ca193d",
                                        "entry_id": "1e6d1aaa-ea07-3a0a-b731-0be0f0463dd3",
                                        "glosses": [
                                            "auffallend kräftige Muskeln, die wie gebündelt wirken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dff6f31-02ee-49e3-8427-00797c6f3ccb",
                                                "sense_id": "ac22c3b8-3c2b-3692-9538-ac2e75ca193d",
                                                "text": "„Große Muskelpakete sprangen auf Nacken und Schultern heraus.“"
                                            },
                                            {
                                                "example_id": "8bff9349-0672-49b3-af6c-0e252318794c",
                                                "sense_id": "ac22c3b8-3c2b-3692-9538-ac2e75ca193d",
                                                "text": "„Die Figuren waren überlebensgroß aufgeblasen, die Muskelpakete strotzten, die Ellbogen standen spitz und böse heraus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7c1d521d-82a0-3532-9f1a-4d66f4ad9980",
                                        "entry_id": "1e6d1aaa-ea07-3a0a-b731-0be0f0463dd3",
