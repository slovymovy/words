                "senses": [
                    {
                        "sense_id": "81104ba3-281c-3d58-924b-4955e8a6cac7",
                        "entry_id": "59a63e41-b987-38cf-bfe4-55b9b2ca13a9",
                        "glosses": [
                            "eine von mehreren möglichen Formen (= signifiants) eines Morphems"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "153f9dfe-9cdb-4cae-9751-a48171175071",
                                "sense_id": "81104ba3-281c-3d58-924b-4955e8a6cac7",
                                "text": "Es gibt drei Morphemvarianten zu dem Morphem \"Gold\": [ gɔlt] (in: Gold), [gɔld]- (in: Goldes) und [gʏld]- (in: gülden)."
                            },
                            {
                                "example_id": "27176ed5-924c-4115-a9d2-6d866bf6a0e5",
                                "sense_id": "81104ba3-281c-3d58-924b-4955e8a6cac7",
                                "text": "„Die Bedeutung der Affixoide ist verallgemeinert und tritt nur in der gebundenen Morphemvariante auf.“"
                            },
                            {
                                "example_id": "6bfbd424-95fc-4d3d-b58a-7b191d69bb36",
                                "sense_id": "81104ba3-281c-3d58-924b-4955e8a6cac7",
                                "text": "„Die Morphemvarianten auge, aug, und äug in (4c) kommen durch Phonemtilgung und Vokalalternation zustande.“"
                            },
                            {
                                "example_id": "2807595d-15ff-42bc-bc5a-6849bd22e5d7",
                                "sense_id": "81104ba3-281c-3d58-924b-4955e8a6cac7",
                                "text": "„Im (…) Unterschied zu Deutsche Wortbildung 3, 1978, S. 242 schränke ich hier ein auf Varietätenspezifik dieser Morphemvariante...“"
                            },
                            {
                                "example_id": "8309c0f8-83a9-4c5d-b76e-5e0d7e9070f2",
                                "sense_id": "81104ba3-281c-3d58-924b-4955e8a6cac7",
                                "text": "„Eine im System verfestigte, durch Assimilation entstandene Art von Morphemvarianten sind Verschmelzungen zweier Morpheme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
