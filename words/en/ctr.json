                {
                    "sense_id": "b88923da-23a9-322c-b867-2e71c5f36d5a",
                    "sense_definition": "The ratio of users who click on a specific link to the number of total users who view a page, email, or advertisement.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "marketing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The marketing team analyzed the <w>CTR</w> to see if the new advertisement was effective.",
                            "target_lang_translations": {
                                "ru": "Маркетинговая команда проанализировала <w>CTR</w>, чтобы понять, была ли новая реклама эффективной."
                            }
                        },
                        {
                            "text": "A high <w>CTR</w> indicates that the content is relevant to the target audience.",
                            "target_lang_translations": {
                                "ru": "Высокий <w>CTR</w> указывает на то, что контент релевантен целевой аудитории."
                            }
