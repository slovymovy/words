                            "past"
                        ],
                        "form": "наве́сив"
                    },
                    {
                        "form_id": "fe2ea390-0888-4748-9369-b4cffbe7ab78",
                        "entry_id": "4b3440ae-329b-366d-8827-024fab92164e",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "наве́сивши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dd9ac8c3-fe0b-3157-b4a5-605c2c680ed2",
                        "entry_id": "4b3440ae-329b-366d-8827-024fab92164e",
                        "glosses": [
                            "повесить, прикрепив к чему-либо, надев на что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2c27419-0106-4917-8ccc-cd85843d8dc6",
                                "sense_id": "dd9ac8c3-fe0b-3157-b4a5-605c2c680ed2",
                                "text": "Старик надел мундир (с погонами), навесил на себя все свои ордена и таким иконостасом сошёл к ней в гостиную, что даже лакей оторопел, увидев его во всём параде."
                            },
                            {
                                "example_id": "7f4d310e-bc13-4c37-a5ff-2daced7e0a31",
                                "sense_id": "dd9ac8c3-fe0b-3157-b4a5-605c2c680ed2",
                                "text": "Женька навесил на дверь замок и положил ключ под крыльцо."
                            },
                            {
                                "example_id": "e95caff1-f838-4f0d-aac1-5ca6fd8849f7",
                                "sense_id": "dd9ac8c3-fe0b-3157-b4a5-605c2c680ed2",
                                "text": "Он начистил сапоги, привёл себя в совершенный порядок перед большим зеркалом, навесил на шею автомат, снова погляделся в зеркало, и тут Гай приказал строиться."
                            }
                        ]
                    },
                    {
                        "sense_id": "1bcbcb5e-4209-312a-b5b3-d574545604ed",
                        "entry_id": "4b3440ae-329b-366d-8827-024fab92164e",
                        "glosses": [
                            "надеть на петли (двери, ставни)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a96d0426-e2cd-4b98-9328-e43fff5e4870",
                                "sense_id": "1bcbcb5e-4209-312a-b5b3-d574545604ed",
                                "text": "Слесарь бескорыстно навесил дверь и, сняв кепку, на цыпочках покинул квартиру."
                            }
                        ]
                    },
                    {
                        "sense_id": "9cf2b377-3c4e-3214-9e3f-f959d2aff448",
                        "entry_id": "4b3440ae-329b-366d-8827-024fab92164e",
                        "glosses": [
                            "разг. то же, что навешать; повесить, развесить в каком-либо количестве"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc12a46c-c602-40e4-a502-159f7c57e619",
                                "sense_id": "9cf2b377-3c4e-3214-9e3f-f959d2aff448",
                                "text": "Полы и окна прежде стояли голые ― теперь всюду разостлали ковры и навесили портьеры."
                            }
                        ]
                    },
                    {
                        "sense_id": "f8f892f6-fd96-381c-a4c7-456439ab2cc6",
                        "entry_id": "4b3440ae-329b-366d-8827-024fab92164e",
                        "glosses": [
                            "нахмурить, насупить (брови)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d298bab1-6496-47a2-8ba8-83453d68c160",
                                "sense_id": "f8f892f6-fd96-381c-a4c7-456439ab2cc6",
                                "text": "Но Тарасу Бульбе не пришлись по душе такие слова, и навесил он ещё ниже на очи свои хмурные, исчерна-белые брови, подобные кустам, повыраставшим по высокому темени горы, которых верхушки вплоть занёс иглистый северный иней."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd0779a1-61ec-3d96-a915-c64f8c0aa636",
                        "entry_id": "4b3440ae-329b-366d-8827-024fab92164e",
                        "glosses": [
                            "спорт. сделать навесной пас, направив (мяч, шайбу) крутым ударом в сторону ворот, корзины"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8c33203-4ea0-45ab-be3e-0d71a245ec3d",
                                "sense_id": "cd0779a1-61ec-3d96-a915-c64f8c0aa636",
                                "text": "Ты навесишь на ворота, я ударю головой…"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
