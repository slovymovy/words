                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "изразца́х"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8924ae51-8af5-3a38-9a80-f3eb90544a2d",
                        "entry_id": "eb97c839-d507-3454-b74a-d78b305dd8dd",
                        "glosses": [
                            "керамическая плитка для облицовки стен, печей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db3a9b6c-8e28-43e4-bec8-16cf6c2b0c20",
                                "sense_id": "8924ae51-8af5-3a38-9a80-f3eb90544a2d",
                                "text": "Золото, серебро, цветные изразцы, как блестящая чешуя, покрывали дворец сверху донизу."
                            },
                            {
                                "example_id": "ddabe60a-7ca1-4d4c-8399-e20c96bbc0d8",
                                "sense_id": "8924ae51-8af5-3a38-9a80-f3eb90544a2d",
                                "text": "Большая лежанка была из голландских изразцов, на которых были нарисованы синей муравой люди и звери."
                            },
                            {
                                "example_id": "2d2cbf36-cc9a-4a10-9671-66e0cf5e0396",
                                "sense_id": "8924ae51-8af5-3a38-9a80-f3eb90544a2d",
                                "text": "В ней нет ничего, кроме деревянного, некрашеного стола, на котором аккуратными рядами разложены штук тридцать — сорок голландских печных кафелей, ну, вот тех самых изразцов с незатейливым синим рисунком, которые нам так были любы на наших «голанках»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1cae2b5b-3a34-4175-b99b-43d923791a7a",
                        "source_entry_id": "eb97c839-d507-3454-b74a-d78b305dd8dd",
                        "source_sense_id": "8924ae51-8af5-3a38-9a80-f3eb90544a2d",
                        "target_lang_word": "Kachel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kachel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c876ab3-8f6d-3a6a-b190-73ebb58cd9fa",
                                        "entry_id": "9e5b17fc-418c-325f-bcfa-a8a95353806c",
                                        "glosses": [
                                            "Ofenkachel; Keramikplatte als Verkleidung und Wärmespeicher für Kachelöfen"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a5c26dd-3a4a-4d50-8a25-a1756bce0d46",
                                                "sense_id": "3c876ab3-8f6d-3a6a-b190-73ebb58cd9fa",
                                                "text": "„Der Unmut des Märchenkönigs bezog sich wohl nicht nur auf die zu grelle Farbe, sondern auch auf die Qualität der Kacheln. Diese wiesen Risse auf, vermutlich wäre der gigantische Ofen gar nicht funktionstüchtig gewesen.“"
                                            },
                                            {
                                                "example_id": "0c61ff7f-a963-4b46-9d68-2685390b35c5",
                                                "sense_id": "3c876ab3-8f6d-3a6a-b190-73ebb58cd9fa",
                                                "text": "„Die Ukrainer zerschlugen diese Öfen, Kachel um Kachel, vermutlich auf der Suche nach Gold.“"
                                            },
                                            {
                                                "example_id": "90462943-e400-4452-a34d-85e7baaa898b",
                                                "sense_id": "3c876ab3-8f6d-3a6a-b190-73ebb58cd9fa",
                                                "text": "„Sie sehen Hamann die Kachel in beide Hände nehmen, um sie mit einem kurzen, aber kräftigen Druck durchzubrechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f8a737a6-e102-37ff-9278-f1effcc702d8",
                                        "entry_id": "9e5b17fc-418c-325f-bcfa-a8a95353806c",
                                        "glosses": [
                                            "Keramikplatte als Belag für Wände und Fußböden"
                                        ],
                                        "tags": [
                                            "besonders süddeutsch und österreichisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "108e9d5d-f25e-4129-ad24-7e5a33c7a386",
                                                "sense_id": "f8a737a6-e102-37ff-9278-f1effcc702d8",
                                                "text": "„Das Esszimmer im einstigen Refektorium sieht aus, als würde die königliche Familie minütlich zum Lunch erwartet […]. Der Saal ist bis unter die Decke mit portugiesischen Kacheln ausgekleidet. Die Königskinder konnten missliebige Speisen an die Wand katapultieren, ohne Schaden anzurichten.“"
                                            },
                                            {
                                                "example_id": "8f172d74-674a-40ce-ae0d-3164903612db",
                                                "sense_id": "f8a737a6-e102-37ff-9278-f1effcc702d8",
                                                "text": "„Er fängt an, die Bissen, die er mit der Gabel zu sich nimmt, zu zählen, dann die Kacheln an der Wand.“"
                                            },
                                            {
                                                "example_id": "aa8c6fa3-6976-449b-a415-182bc9ce7375",
                                                "sense_id": "f8a737a6-e102-37ff-9278-f1effcc702d8",
                                                "text": "„Das Dach ist eingestürzt, die schweren Balken liegen kreuz und quer, aber an den Wänden erkennt man noch die Kacheln, wo die Käse- oder die Fleischtheke war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "046bb0ef-23a3-3199-b7fb-fbbac8088730",
                                        "entry_id": "9e5b17fc-418c-325f-bcfa-a8a95353806c",
                                        "glosses": [
                                            "Gefäß aus Steingut (kleiner Topf, große Tasse)"
                                        ],
                                        "tags": [
                                            "South-German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8e5c4cc-d07a-43b4-aa12-f46dcfe3e0bb",
                                                "sense_id": "046bb0ef-23a3-3199-b7fb-fbbac8088730",
                                                "text": "„Er saß noch nicht lange am Tische, so ließ er ein mächtiges halbes Brot in eine Milchkachel fallen, daß die Kachel in Scherben ging und rings am Tische alles mit Milch überspritzt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b2258d1b-f472-3393-8b07-49eadd4f9182",
                                        "entry_id": "9e5b17fc-418c-325f-bcfa-a8a95353806c",
                                        "glosses": [
                                            "Nachttopf, Nachtgeschirr"
                                        ],
                                        "tags": [
                                            "Bavarian"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "7abfa7d5-a69a-3ec6-9bae-7483ece4e8a0",
                                        "entry_id": "9e5b17fc-418c-325f-bcfa-a8a95353806c",
                                        "glosses": [
                                            "Vulva"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "e3c6f959-6fda-3d0d-8bc4-e7d369b9ffe5",
                                        "entry_id": "9e5b17fc-418c-325f-bcfa-a8a95353806c",
                                        "glosses": [
                                            "bairisch und schwäbisch, abwertend: Schimpfwort für eine (alte) Frau"
                                        ],
