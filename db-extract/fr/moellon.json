        "fr-extract.jsonl": [
            {
                "entry_id": "c790f7c0-830b-3e4e-ad67-963cfff0d852",
                "word": "moellon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "94b934fe-2a8c-4ecb-94d0-c81eeae1c531",
                        "entry_id": "c790f7c0-830b-3e4e-ad67-963cfff0d852",
                        "tags": [
                            "plural"
                        ],
                        "form": "moellons"
                    },
                    {
                        "form_id": "4d8f3508-215f-4623-86b1-e6df60e82fb2",
                        "entry_id": "c790f7c0-830b-3e4e-ad67-963cfff0d852",
                        "tags": [],
                        "form": "moëllon"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4eb1f4fd-be5f-3d72-b49f-0a8c719c0b79",
                        "entry_id": "c790f7c0-830b-3e4e-ad67-963cfff0d852",
                        "glosses": [
                            "Pierre de construction très maniable par son poids et sa forme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7085ab41-e143-4251-a9fb-de3db80f23d9",
                                "sense_id": "4eb1f4fd-be5f-3d72-b49f-0a8c719c0b79",
                                "text": "Sur la rue, la maison présentait cette façade de moellons ravalée en plâtre, ondée par le temps et rayée par le crochet du maçon de manière à figurer des pierres de taille."
                            },
                            {
                                "example_id": "c8d39c45-041a-4bac-adce-43509e27b0cd",
                                "sense_id": "4eb1f4fd-be5f-3d72-b49f-0a8c719c0b79",
                                "text": "Ces moellons, qui font de grands carrés longs de cinquante à soixante pieds, haut de six ou huit, c'est le futur Paris qu'on arrache de terre."
                            },
                            {
                                "example_id": "9f7f8a2a-acf1-49c1-a02c-52d467fc6f0e",
                                "sense_id": "4eb1f4fd-be5f-3d72-b49f-0a8c719c0b79",
                                "text": "En nivelant les fortunes, le titre du Code qui régit les successions a produit ces phalanstères en moellons qui logent trente famille et qui donnent cent mille francs de rentes."
                            },
                            {
                                "example_id": "6ee52af4-d3b3-4087-9203-93f9533c9942",
                                "sense_id": "4eb1f4fd-be5f-3d72-b49f-0a8c719c0b79",
                                "text": "Autrefois, monsieur, il y avait à cette fontaine un seuil de pierre. Les cantonniers s'en sont servis comme de moellon pour la construction du pont qui est là-bas."
                            }
                        ]
                    },
                    {
                        "sense_id": "4fbe5297-9d4c-3e62-91d4-f9738ecf77ba",
                        "entry_id": "c790f7c0-830b-3e4e-ad67-963cfff0d852",
                        "glosses": [
                            "Pierre de grosseur intermédiaire entre le bloc et le caillou."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b55ee49-fdc7-4663-9fdd-0bf0b0866819",
                        "source_entry_id": "c790f7c0-830b-3e4e-ad67-963cfff0d852",
                        "target_lang_word": "Baustein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baustein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8085c277-b037-3b72-8732-22da8e73266f",
                                        "entry_id": "5456e46e-e9e4-393d-86b6-c57e08c54e87",
                                        "glosses": [
                                            "Stein zum Bauen von Mauern, Gebäuden und Ähnlichem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98a06fb8-861f-47ce-8df4-cdfea5feaedb",
                                                "sense_id": "8085c277-b037-3b72-8732-22da8e73266f",
                                                "text": "Ein Philosoph, etwas närrisch wie alle seines Schlages, verließ eines Tages die Stadt, in der viele Häuser gebaut wurden, um keinen Ziegel oder Baustein auf den Kopf zu kriegen."
                                            },
                                            {
                                                "example_id": "6f75e9fb-c9f0-4a85-a619-9d60ae6a6214",
                                                "sense_id": "8085c277-b037-3b72-8732-22da8e73266f",
                                                "text": "Da der weiße Marmor der vorherrschende Baustein ist, so hat es, wenn man die Stadt von der Höhe eines der fernen Berge betrachtet, den Anschein, als läge ein silbrig strahlendes Gestirn auf der Erde."
                                            },
                                            {
                                                "example_id": "1fd622bf-3d8b-4b07-91ad-8e6073ccf64f",
                                                "sense_id": "8085c277-b037-3b72-8732-22da8e73266f",
                                                "text": "„Und ihre Blicke irrten über den Haufen Bausteine hin, über das ekelhafte Wasser, in dem ein Strohbündel schwamm, über einen Fabrikschornstein, der sich am Horizont erhob; Kloakendünste stiegen empor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dbb8a321-044e-34ee-b123-5d0f89c49e51",
                                        "entry_id": "5456e46e-e9e4-393d-86b6-c57e08c54e87",
                                        "glosses": [
                                            "Bestandteil"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "291f752c-527a-4ab1-acf8-79a7c84f786a",
                                                "sense_id": "dbb8a321-044e-34ee-b123-5d0f89c49e51",
                                                "text": "Andrea Asch räumt ein, daß mit einem Aktionstag pro Jahr keine Umorientierung bei den Mädchen erreichbar ist. Er könne nur ein Baustein unter »sehr vielen Maßnahmen« sein."
                                            },
                                            {
                                                "example_id": "678fc487-3aac-4931-8502-c3135ac4afb3",
                                                "sense_id": "dbb8a321-044e-34ee-b123-5d0f89c49e51",
                                                "text": "Die Raumsonde \"Cassini\" lieferte Daten, wonach der Mond neben Wärme und Eis auch über organische Chemikalen verfügt - wichtige Bausteine für die Entstehung von Leben."
                                            },
                                            {
                                                "example_id": "33821bd6-c657-4762-8568-3b33d5dfe2a7",
                                                "sense_id": "dbb8a321-044e-34ee-b123-5d0f89c49e51",
                                                "text": "„So konnte von einer einheitlichen Identität auf Grundlage der populären sozialistischen Nationalitätentheorie, die Sprache, Territorium und Volk als elementare Bausteine betrachtete, nicht die Rede sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64abf1c2-9e09-46d8-9e09-f13e49993989",
                        "source_entry_id": "c790f7c0-830b-3e4e-ad67-963cfff0d852",
                        "target_lang_word": "bloksteen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bloksteen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e0be6fc4-1f82-3fd9-ae18-325094c3fbcc",
                                        "entry_id": "d86b30bb-7799-3b78-a5a3-e9ec9e43ca13",
                                        "glosses": [
                                            "voor steenglooiing geschikte stenen, die vrij regelmatig rechthoekig zijn gehakt op ongeveer gelijke afmetingen"
                                        ],
                                        "tags": [
                                            "waterbeheer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1840aa6-ce5b-4aca-bc9c-07bbccb8a67e",
                                                "sense_id": "e0be6fc4-1f82-3fd9-ae18-325094c3fbcc",
                                                "text": "⧖ In de kruin worden gewoonlijk een of twee rijen Doorniksche bloksteen in de steenbekleeding verwerkt, als voetpad over de dammen, die door het aangroeien van zeegewassen, waardoor men de onregelmatige steenen en tusschenliggende gaten niet ziet, moeilijk begaanbaar kunnen zijn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
