                    {
                        "sense_id": "a14b75bd-c75d-340e-b36d-7ec8dd10e46e",
                        "entry_id": "dc63aa74-b83c-32e2-a551-0d23ab101f68",
                        "glosses": [
                            "To scour, as a floor, with hearthstone."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3a30a7ca-87c7-4d67-a453-eaf03acc41ac",
                                "sense_id": "a14b75bd-c75d-340e-b36d-7ec8dd10e46e",
                                "text": "We've a woman come in twice a week, to scrub, and red-brick, and hearthstone, and black-lead, and the rest we manage ourselves."
                            }
                        ]
                    }
