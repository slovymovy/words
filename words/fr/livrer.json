            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c6bbc40a-224a-3d6c-96aa-b9b13d721739",
                    "sense_definition": "Remettre un colis, une commande ou des marchandises au destinataire convenu.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "distribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le facteur va <w>livrer</w> le colis directement chez vous demain matin."
                        },
                        {
                            "text": "Ce magasin peut <w>livrer</w> à domicile tous les meubles achetés en ligne."
                        }
                    ],
                    "common_phrases": [
                        "livrer à domicile",
                        "livrer un colis",
                        "livrer une commande"
                    ]
                },
                {
                    "sense_id": "f5413bcc-99f7-32d2-b7b0-829e42d90141",
                    "sense_definition": "Remettre quelqu'un entre les mains d'une autorité ou de la justice.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "remise_personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs jours de cavale, le suspect a décidé de se <w>livrer</w> à la police."
                        },
                        {
                            "text": "Les témoins ont aidé les agents à <w>livrer</w> le voleur à la justice."
                        }
                    ],
                    "common_phrases": [
                        "livrer à la justice",
                        "livrer à la police"
                    ]
                },
                {
                    "sense_id": "73acad2f-ec15-3314-bf92-c6bc1ed6e6b8",
                    "sense_definition": "Se consacrer pleinement à une activité, à une passion ou à une recherche.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consacrer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant les vacances, il aime se <w>livrer</w> à la peinture et à la lecture."
                        },
                        {
                            "text": "Les chercheurs vont se <w>livrer</w> à des tests minutieux pour vérifier cette hypothèse."
                        }
                    ],
                    "common_phrases": [
                        "se livrer à une activité",
                        "se livrer à un exercice"
                    ]
                },
                {
                    "sense_id": "7be5c0e8-fb3f-31a2-91cf-b8b07c0a9553",
                    "sense_definition": "Révéler ou confier des pensées, des sentiments intimes ou des secrets à quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confidence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a enfin accepté de <w>livrer</w> ses sentiments les plus intimes à son amie."
                        },
                        {
                            "text": "Le vieil homme refusa obstinément de <w>livrer</w> le secret de fabrication."
                        }
                    ],
                    "common_phrases": [
                        "livrer un secret",
                        "livrer ses sentiments"
                    ]
                },
                {
                    "sense_id": "354e1128-a767-37b8-bde5-2f0bc930c39d",
                    "sense_definition": "Engager et mener un combat, une lutte ou une bataille contre un adversaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "combat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux armées se préparent à <w>livrer</w> bataille près du fleuve."
                        },
                        {
                            "text": "Le boxeur a dû <w>livrer</w> un combat difficile pour conserver son titre."
                        }
                    ],
                    "common_phrases": [
                        "livrer bataille",
                        "livrer un combat"
                    ]
                },
                {
                    "sense_id": "5735382f-b181-35d9-a00c-1eb115d63208",
                    "sense_definition": "Remettre un complice, une personne ou un lieu à un ennemi par trahison.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "trahison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour éviter la prison, le bandit a choisi de <w>livrer</w> son complice aux autorités."
                        },
                        {
                            "text": "Le capitaine a trahi son pays en acceptant de <w>livrer</w> la forteresse."
                        }
                    ],
                    "synonyms": [
                        "dénoncer"
                    ],
                    "common_phrases": [
                        "livrer son complice",
                        "livrer la ville à l'ennemi"
                    ]
                },
                {
                    "sense_id": "2ef59449-7e3e-3de6-aeb4-f007a3a7a781",
                    "sense_definition": "Exposer sans défense une personne ou un lieu à une violence ou à une destruction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abandon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les envahisseurs ont décidé de <w>livrer</w> la ville au pillage pendant trois jours."
                        },
                        {
                            "text": "Le décret a fini par <w>livrer</w> ces forêts protégées aux exploitants sans scrupules."
                        }
                    ],
                    "common_phrases": [
                        "livrer au pillage",
                        "livrer aux flammes"
                    ]
                }
            ]
        }
    ]
