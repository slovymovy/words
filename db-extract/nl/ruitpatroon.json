                        "sense_id": "6770deb8-9619-37e2-8a7c-c5dfe0af84f9",
                        "entry_id": "4c05bddb-3b77-3907-b8a3-8404b670c5b5",
                        "glosses": [
                            "een patroon van elkaar schuin kruisende lijnen die samen ruitvormige hokjes vormen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4da3c897-7b28-4bf6-982c-a4c3684461ed",
                                "sense_id": "6770deb8-9619-37e2-8a7c-c5dfe0af84f9",
                                "text": "Overal hetzelfde ruitpatroon, dezelfde avenues, waar je ook rijdt; het zou net zo goed Garden City op Long Island kunnen zijn, alleen zijn de huizen hier misschien een tikje kleiner."
                            },
                            {
                                "example_id": "4977eb28-7801-4a37-b0ff-396c88b48b1b",
                                "sense_id": "6770deb8-9619-37e2-8a7c-c5dfe0af84f9",
                                "text": "Snijd intussen de aubergine overlangs doormidden en kerf een ruitpatroon in het vruchtvlees; snijd tot op de schil maar let op dat je die niet insnijdt."
                            }
                        ]
                    }
