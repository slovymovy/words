                        "glosses": [
                            "Vider de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "557c8abd-0da1-4bba-9fe5-78965cf541ec",
                                "sense_id": "94f52167-f7bc-34f5-9c7d-3d9e36c85716",
                                "text": "Mais quand elle eut revidé son verre, elle se caressa d’une main voluptueuse un bras nu, les yeux clos, les dents à peine desserrées pour gémir presque :\n— I want to live, oh ! to live, to live, vivre, vivre…"
                            }
                        ]
