                                "example_id": "2a606fd0-b36d-4260-b0cd-9f2dc60f5c62",
                                "sense_id": "19de2a02-c151-3a94-ad66-abeac9373c39",
                                "text": "Sie stützt sich mit beiden Händen am Stahlgestell des Bettes ab."
                            },
                            {
                                "example_id": "c2c253e5-9d48-41e9-9f5b-ea22b3528871",
                                "sense_id": "19de2a02-c151-3a94-ad66-abeac9373c39",
                                "text": "„Verloren: Eine Brille mit Stahlgestelle Man bittet dieselbe gegen Belohnung in D. 86 abzugeben.“ (1865)"
                            },
                            {
                                "example_id": "72f8a0ec-f010-4d5a-be32-7ead9e27be94",
                                "sense_id": "19de2a02-c151-3a94-ad66-abeac9373c39",
                                "text": "„Er ging durch die Wohnräume, vorbei am Esstisch und den Rattanstühlen mit Stahlgestell, die so fein federten, wenn man sich daraufsetzte.“"
                            }
                        ],
