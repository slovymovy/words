                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e0ff1c1-0c60-45a9-90a7-0f77d92107d3",
                                                "sense_id": "6acca00e-037a-30a2-a606-8c3ef22abef2",
                                                "text": "A lackey that […] can warble upon a crowd a little."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74a0d8ae-8100-39fa-961b-7ceb54ada1c3",
                                        "entry_id": "67a387b1-a72b-37ce-aa60-5e9c1cae7af4",
                                        "glosses": [
                                            "A fiddle."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e9a44df-2b1f-49a0-bc2b-c30d183b436c",
                                                "sense_id": "74a0d8ae-8100-39fa-961b-7ceb54ada1c3",
                                                "text": "That keep their Consciences in Cases, / As Fiddlers do their Crowds and Bases,[…]"
                                            },
                                            {
                                                "example_id": "adc9229d-61df-4c21-ba7a-6197be73b850",
                                                "sense_id": "74a0d8ae-8100-39fa-961b-7ceb54ada1c3",
                                                "text": "[…]wandering palmers, hedge-priests, Saxon minstrels, and Welsh bards, were muttering prayers, and extracting mistuned dirges from their harps, crowds, and rotes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "crowd",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c9fdc0c-99b7-3032-b8a9-ab6fe0afa274",
                                        "entry_id": "8cb3531c-738b-3ffc-815b-e5c7a5580ad1",
                                        "glosses": [
                                            "To play on a crowd; to fiddle."
                                        ],
