                                "target_senses": [
                                    {
                                        "sense_id": "63775a06-0c84-3534-a7c5-771e9f616d4a",
                                        "entry_id": "ec0128fa-ca64-361b-9677-48eefdfd86c0",
                                        "glosses": [
                                            "An institution that treats chronic diseases, and provides supervised recuperation and convalescence."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "885fbcf7-bca3-4d16-b15a-b21b12e4a7c9",
                        "source_entry_id": "593e343a-0cc1-3057-b86f-a11ee4ad6075",
                        "source_sense_id": "1f95f48f-a51e-3ed3-9904-75fa2aed0a56",
                        "source_sense_description": "Einrichtung zur Verbesserung der Gesundheit chronisch/ernsthaft Kranker oder Genesender",
                        "target_lang_word": "sanatorium",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sanatorium",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9cf2cc39-5967-3218-bfc9-ec3d7ab535b0",
                                        "entry_id": "a43229d2-4f8b-368f-b856-42e27f852400",
                                        "glosses": [
                                            "Maison de santé où l’on soigne au grand air certains malades, plus spécialement ceux atteints de tuberculose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed41ce3d-612f-4969-91b2-92bd918dec31",
                                                "sense_id": "9cf2cc39-5967-3218-bfc9-ec3d7ab535b0",
                                                "text": "Il était trop tard pour parler de campagne, de régime doux, de petit voyage : tout de suite, j’ai deviné, sur des lèvres réticentes de médecins, le mot de sanatorium…"
                                            },
                                            {
                                                "example_id": "e9b973a1-8ff7-4e8b-aa0d-36b5bb10341d",
                                                "sense_id": "9cf2cc39-5967-3218-bfc9-ec3d7ab535b0",
                                                "text": "Jean-Louis, qui a obtenu l’autorisation de correspondre avec elle, m’écrit de son sanatorium qu’elle est une grande âme, faite pour le plus haut amour."
                                            },
                                            {
                                                "example_id": "96b03e28-e5d8-4db0-bf00-c874a9b48e6b",
                                                "sense_id": "9cf2cc39-5967-3218-bfc9-ec3d7ab535b0",
                                                "text": "Thorsavn possède un hôpital moderne que lui envieraient bien des arrondissements de Paris et un Sanatorium pour les tuberculeux."
                                            },
                                            {
                                                "example_id": "a84dc25d-5817-4653-ae7e-a4a9cedf0e02",
                                                "sense_id": "9cf2cc39-5967-3218-bfc9-ec3d7ab535b0",
                                                "text": "Le département fait de louables efforts pour créer un dispensaire antituberculeux. Il organise l’inspection des écoles. Quant à un sanatorium, n’en parlons pas pour l’instant."
                                            },
                                            {
                                                "example_id": "7cc91961-a2ed-4cdd-aef6-a2ec95d7fea5",
                                                "sense_id": "9cf2cc39-5967-3218-bfc9-ec3d7ab535b0",
                                                "text": "Après tout, si l’affaire avait marché, Judas aurait probablement subventionné des sanatoria, des hôpitaux, des bibliothèques ou des laboratoires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
