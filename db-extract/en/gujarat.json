                                        "examples": [
                                            {
                                                "example_id": "11f2d541-d95b-4272-9596-ff21cb6b67de",
                                                "sense_id": "38bd9acc-1f30-30fc-ab57-57cfa40c51ac",
                                                "text": "En 2002, dans l’État du Gujarat, quelques 2,000 musulmans étaient assassinés par des extrémistes hindous, et la responsabilité du gouvernement de cet État indien, alors dirigé par Modi, était pointée par la Commission nationale consultative des droits de l’homme."
                                            },
                                            {
                                                "example_id": "e940c1a9-45fe-4ec3-ab64-fe6a037449cb",
                                                "sense_id": "38bd9acc-1f30-30fc-ab57-57cfa40c51ac",
                                                "text": "Le Gujarat est un État où la consommation et la vente d’alcool sont interdites par la loi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
