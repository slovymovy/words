                        "entry_id": "30f48895-5340-3f5b-9cd7-ff3b6a95e3b9",
                        "glosses": [
                            "weibliche Person, die das Design von Ge- und Verbrauchsgegenständen wie etwa der Bekleidung, Möbel, Haushaltsgegenstände, Automobile, Schmuck, Werkzeuge und Ähnliches entwirft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f83a2718-1de9-492e-b13c-abb974831bcf",
                                "sense_id": "b88cf453-9f7e-3855-b28c-38ef859ae07b",
                                "text": "Die Designerin präsentierte dem Vorstand ihre neuesten Entwürfe."
                            },
                            {
                                "example_id": "ca7d21e7-dc87-48c2-b4d7-c395a28fb9fb",
                                "sense_id": "b88cf453-9f7e-3855-b28c-38ef859ae07b",
                                "text": "Dieser Tisch wurde von einer bekannten Designerin entworfen."
                            },
                            {
                                "example_id": "d30b9b97-8d32-4540-8712-f65962b541d0",
                                "sense_id": "b88cf453-9f7e-3855-b28c-38ef859ae07b",
                                "text": "„Für eine gelernte Designerin war der Rest kein Problem.“"
                            }
                        ],
