            {
                "entry_id": "ace67629-f9db-36ce-9491-52e06933640f",
                "word": "malinois",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "301bd427-fabc-3e31-ab6b-78bf544b6905",
                        "entry_id": "ace67629-f9db-36ce-9491-52e06933640f",
                        "glosses": [
                            "Berger belge malinois."
                        ],
                        "tags": [
                            "Cynologie"
                        ],
                        "examples": [
                            {
                                "example_id": "066a7f7c-5359-49bc-b9f6-efa3ed2e8ba1",
                                "sense_id": "301bd427-fabc-3e31-ab6b-78bf544b6905",
                                "text": "Emmenons Atlas, le chien de garde! C’est un berger malinois, les meilleurs chiens policiers!"
                            },
                            {
                                "example_id": "c04e28f1-62ae-499a-9dec-55508f1fd044",
                                "sense_id": "301bd427-fabc-3e31-ab6b-78bf544b6905",
                                "text": "À ce moment, Convers entendit des aboiements et aussitôt vit entrer un magnifique malinois suivi par Roger Wilmort."
                            },
                            {
                                "example_id": "658fe61c-d0b0-4237-9a8b-4fbd890b13d1",
                                "sense_id": "301bd427-fabc-3e31-ab6b-78bf544b6905",
                                "text": "De nouveaux julots proposent, afin de pimenter des soirées érotiques, la location de malinois, beaucerons, lévriers et autres bergers allemands…"
                            },
                            {
                                "example_id": "606c12d0-41a6-4da5-baa7-76d1a9a85fb3",
                                "sense_id": "301bd427-fabc-3e31-ab6b-78bf544b6905",
                                "text": "Après la mode des labradors et dalmatiens, une nouvelle tendance a suivi : celle des « molosses », American Staffordshire terrier, malinois et autres dogues."
                            }
                        ]
                    }
                ],
