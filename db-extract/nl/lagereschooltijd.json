                        "examples": [
                            {
                                "example_id": "40e9439b-996a-452c-a22a-510e9a2929b6",
                                "sense_id": "77891721-cd67-3726-b403-85a73f1c06ad",
                                "text": "Mies was Katies beste vriendin. Al waren ze beiden twee jaar ouder dan Albert, ze zaten de hele lagereschooltijd bij elkaar in de klas omdat de dorpsschool niet groot genoeg was voor afzonderlijke klassen. In zijn ogen was Mies met haar asblonde haar en amandelvormige groene ogen het mooiste meisje van de klas, al beweerde Mies dat Katie dat was."
                            },
                            {
                                "example_id": "cf4e0000-142e-41bd-a15d-10cbb4727d0c",
                                "sense_id": "77891721-cd67-3726-b403-85a73f1c06ad",
                                "text": "Van Schayck: \"Als ik terugdenk aan de meesters en juffen in mijn eigen lagereschooltijd, die ons met alle goed bedoelingen met de armen over elkaar stil lieten zitten, dan was het maar een saaie, geestdodende bedoening.\""
                            }
                        ]
