{
    "word_family": [
        "honorable",
        "honorary",
        "honorarium",
        "honorific",
        "dishonor",
        "honoree"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7b3cecf3-ea2e-3998-b600-11bbde703b7d",
                    "sense_definition": "Great respect and admiration for someone, often because of their achievements or moral character.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "respect_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They held a banquet in <w>honor</w> of the visiting president.",
                            "target_lang_translations": {
                                "ru": "Они устроили банкет в <w>честь</w> визита президента.",
                                "zh": "他们举办了一场宴会，以表达对到访总统的<w>敬意</w>。"
                            }
                        },
                        {
                            "text": "The soldiers were buried with full military <w>honors</w>.",
                            "target_lang_translations": {
                                "ru": "Солдаты были похоронены с полными воинскими <w>почестями</w>.",
                                "zh": "士兵们在葬礼上获得了最高军事<w>荣誉</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "respect",
                        "esteem"
                    ],
                    "antonyms": [
                        "dishonor",
                        "contempt"
                    ],
                    "common_phrases": [
                        "in honor of",
                        "guest of honor",
                        "maid of honor",
                        "place of honor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубокое уважение и восхищение кем-либо, часто из-за их достижений или моральных качеств.",
                        "zh": "对某人因其成就或道德品质而表现出的极高尊重和敬佩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "честь",
                                "target_lang_sense_clarification": "уважение, почет"
                            },
                            {
                                "target_lang_word": "почести",
                                "target_lang_sense_clarification": "церемониальные знаки уважения (обычно во мн. ч.)"
                            },
                            {
                                "target_lang_word": "почёт",
                                "target_lang_sense_clarification": "общественное уважение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "敬意",
                                "target_lang_sense_clarification": "表示尊敬的态度"
                            },
                            {
                                "target_lang_word": "荣誉",
                                "target_lang_sense_clarification": "社会公认的尊荣"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2de86ac9-9efb-3cde-bc44-241a398dccd1",
                    "sense_definition": "The quality of knowing and doing what is morally right.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "integrity_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a man of <w>honor</w> who always keeps his promises.",
                            "target_lang_translations": {
                                "ru": "Он человек <w>чести</w>, который всегда держит свои обещания.",
                                "zh": "他是一个有<w>名誉</w>的人，总是信守承诺。"
                            }
                        },
                        {
                            "text": "She defended her family's <w>honor</w> against the false accusations.",
                            "target_lang_translations": {
                                "ru": "Она защищала <w>честь</w> своей семьи от ложных обвинений.",
                                "zh": "她捍卫了家族的<w>名誉</w>，反驳了那些虚假的指控。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chivalry",
                        "gentlemanliness"
                    ],
                    "antonyms": [
                        "dishonor"
                    ],
                    "common_phrases": [
                        "word of honor",
                        "code of honor",
                        "man of honor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество, заключающееся в знании и выполнении того, что морально правильно; моральный кодекс.",
                        "zh": "一种知道并践行道德准则的品质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "честь",
                                "target_lang_sense_clarification": "внутреннее нравственное достоинство"
                            },
                            {
                                "target_lang_word": "благородство",
                                "target_lang_sense_clarification": "высокая нравственность"
                            },
                            {
                                "target_lang_word": "порядочность",
                                "target_lang_sense_clarification": "честность, неспособность к низким поступкам"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "名誉",
                                "target_lang_sense_clarification": "个人的道德声望"
                            },
                            {
                                "target_lang_word": "节操",
                                "target_lang_sense_clarification": "高尚的道德品质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "077a8e9b-37ba-3f3d-95df-e4fef3d424fe",
                    "sense_definition": "A special privilege or pleasure.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "privilege_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had the <w>honor</w> of meeting the famous scientist last week.",
                            "target_lang_translations": {
                                "ru": "Я имел <w>честь</w> встретиться с известным ученым на прошлой неделе.",
                                "zh": "上周我有幸<w>荣幸</w>地见到了那位著名的科学家。"
                            }
                        },
                        {
                            "text": "Would you do the <w>honors</w> and cut the cake for everyone?",
                            "target_lang_translations": {
                                "ru": "Не окажешь ли ты <w>честь</w> разрезать торт для всех?",
                                "zh": "你能<w>荣幸</w>地为大家切蛋糕吗？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "have the honor",
                        "do the honors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Особая привилегия или удовольствие.",
                        "zh": "一种特殊的特权或荣幸。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "честь",
                                "target_lang_sense_clarification": "почетное право или привилегия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "荣幸",
                                "target_lang_sense_clarification": "感到光荣"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc91acb7-ea7d-381b-9fd9-d17d30aae873",
                    "sense_definition": "An award, official title, or rank given to someone as a reward for their achievements.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "award_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She received the highest <w>honor</w> the university could bestow.",
                            "target_lang_translations": {
                                "ru": "Она получила высшую <w>награду</w>, которую мог присудить университет.",
                                "zh": "她获得了大学所能授予的最高<w>荣誉</w>。"
                            }
                        },
                        {
                            "text": "The writer has won many national <w>honors</w> for his poetry.",
                            "target_lang_translations": {
                                "ru": "Писатель получил множество национальных <w>наград</w> за свою поэзию.",
                                "zh": "这位作家因其诗歌作品获得了许多国家级<w>奖项</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "with honors",
                        "roll of honor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Награда, официальный титул или звание, присуждаемые кому-либо в качестве поощрения за достижения.",
                        "zh": "为表彰某人的成就而授予的奖项、官方头衔或等级。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "награда",
                                "target_lang_sense_clarification": "знак отличия"
                            },
                            {
                                "target_lang_word": "почесть",
                                "target_lang_sense_clarification": "знак общественного признания"
                            },
                            {
                                "target_lang_word": "звание",
                                "target_lang_sense_clarification": "официальный титул"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "荣誉",
                                "target_lang_sense_clarification": "光荣的称号或奖项"
                            },
                            {
                                "target_lang_word": "奖项",
                                "target_lang_sense_clarification": "表彰成就的奖励"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2b67a25-cf0b-3665-b746-10f2deec5197",
                    "sense_definition": "A university degree of a higher standard than a basic pass degree.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "education_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He graduated with first-class <w>honours</w> in economics.",
                            "target_lang_translations": {
                                "ru": "Он окончил университет с <w>отличием</w> первой степени по экономике.",
                                "zh": "他以经济学一等<w>荣誉学位</w>毕业。"
                            }
                        },
                        {
                            "text": "The program offers an <w>honours</w> degree for advanced students.",
                            "target_lang_translations": {
                                "ru": "Программа предлагает диплом с <w>отличием</w> для продвинутых студентов.",
                                "zh": "该项目为高阶学生提供<w>荣誉学位</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "honors degree",
                        "first-class honors"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "common in UK and Commonwealth education systems"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Университетская степень более высокого уровня, чем обычная степень.",
                        "zh": "一种比普通学位标准更高的大学学位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отличие",
                                "target_lang_sense_clarification": "в контексте диплома (диплом с отличием)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "荣誉学位",
                                "target_lang_sense_clarification": "学术上的优等学位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c45a78c-ce4f-3269-b23a-8223489c8fd9",
                    "sense_definition": "A person or thing that brings credit or glory to something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "respect_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That young athlete is an <w>honor</w> to her team and her country.",
                            "target_lang_translations": {
                                "ru": "Эта юная спортсменка — <w>гордость</w> своей команды и страны.",
                                "zh": "那位年轻运动员是她团队和国家的<w>骄傲</w>。"
                            }
                        },
                        {
                            "text": "Your excellent work is an <w>honor</w> to the profession.",
                            "target_lang_translations": {
                                "ru": "Ваша отличная работа делает <w>честь</w> профессии.",
                                "zh": "你出色的工作是这一行业的<w>骄傲</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или вещь, приносящие славу или уважение чему-либо.",
                        "zh": "为某事物带来荣耀或光彩的人或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гордость",
                                "target_lang_sense_clarification": "предмет гордости"
                            },
                            {
                                "target_lang_word": "честь",
                                "target_lang_sense_clarification": "то, что делает честь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "骄傲",
                                "target_lang_sense_clarification": "引以为豪的人或物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18017081-aa37-337d-807d-2399807a6b21",
                    "sense_definition": "A high-value card (such as an ace, king, queen, or jack) in bridge and other card games.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "games_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She held three <w>honors</w> in her hand and decided to bid high.",
                            "target_lang_translations": {
                                "ru": "У нее на руках было три <w>онера</w>, и она решила сделать высокую ставку.",
                                "zh": "她手里拿着三张<w>大牌</w>，决定叫高分。"
                            }
                        },
                        {
                            "text": "Counting your <w>honors</w> is essential for evaluating your hand strength.",
                            "target_lang_translations": {
                                "ru": "Подсчет <w>онеров</w> необходим для оценки силы вашей руки.",
                                "zh": "计算手中的<w>大牌</w>对于评估牌力至关重要。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "context of card games like bridge"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Старшая карта (туз, король, дама или валет) в бридже и других карточных играх.",
                        "zh": "桥牌等纸牌游戏中的大牌（如A、K、Q、J）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "онер",
                                "target_lang_sense_clarification": "карточный термин"
                            },
                            {
                                "target_lang_word": "старшая карта",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大牌",
                                "target_lang_sense_clarification": "纸牌游戏中的高点数牌"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d98bdec3-c763-39f6-850c-28eb7b385858",
                    "sense_definition": "To show great respect or public admiration for someone.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verb_respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We gather today to <w>honor</w> the memory of our ancestors.",
                            "target_lang_translations": {
                                "ru": "Мы собрались сегодня, чтобы <w>почтить</w> память наших предков.",
                                "zh": "我们今天聚集在这里，是为了<w>纪念</w>我们的祖先。"
                            }
                        },
                        {
                            "text": "The city <w>honored</w> the firefighters for their bravery.",
                            "target_lang_translations": {
                                "ru": "Город <w>чествовал</w> пожарных за их храбрость.",
                                "zh": "市政府对消防员的英勇行为进行了<w>表彰</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "despise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявлять глубокое уважение или публичное восхищение кем-либо.",
                        "zh": "对某人表示极大的尊重或公开赞赏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чтить",
                                "target_lang_sense_clarification": "относиться с глубоким уважением"
                            },
                            {
                                "target_lang_word": "почитать",
                                "target_lang_sense_clarification": "уважать, чтить"
                            },
                            {
                                "target_lang_word": "чествовать",
                                "target_lang_sense_clarification": "оказывать почести публично"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纪念",
                                "target_lang_sense_clarification": "怀念并表示敬意"
                            },
                            {
                                "target_lang_word": "表彰",
                                "target_lang_sense_clarification": "公开赞扬"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0aeac7e-0f6f-3d7e-8de9-4834bd99b2a9",
                    "sense_definition": "To give someone a public award or title.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_award",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee <w>honored</w> him with a lifetime achievement award.",
                            "target_lang_translations": {
                                "ru": "Комитет <w>удостоил</w> его награды за жизненные достижения.",
                                "zh": "委员会<w>授予</w>他终身成就奖。"
                            }
                        },
                        {
                            "text": "She was <w>honored</w> for her contributions to science.",
                            "target_lang_translations": {
                                "ru": "Она была <w>награждена</w> за вклад в науку.",
                                "zh": "她因对科学的贡献而受到<w>表彰</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вручать кому-либо публичную награду или титул.",
                        "zh": "授予某人公开的奖项或头衔。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удостоить",
                                "target_lang_sense_clarification": "наградить чем-либо почетным"
                            },
                            {
                                "target_lang_word": "наградить",
                                "target_lang_sense_clarification": "дать награду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "授予",
                                "target_lang_sense_clarification": "给予荣誉或称号"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e334512a-4bce-398b-89c8-a0a978e006e7",
                    "sense_definition": "To do what one has agreed or promised to do.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_fulfill",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company refused to <w>honor</w> the warranty on the broken device.",
                            "target_lang_translations": {
                                "ru": "Компания отказалась <w>соблюдать</w> гарантию на сломанное устройство.",
                                "zh": "公司拒绝<w>履行</w>对损坏设备的保修承诺。"
                            }
                        },
                        {
                            "text": "You must <w>honor</w> your promise to help us move this weekend.",
                            "target_lang_translations": {
                                "ru": "Ты должен <w>сдержать</w> свое обещание помочь нам с переездом в эти выходные.",
                                "zh": "你必须<w>遵守</w>承诺，这个周末来帮我们搬家。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "honor a promise",
                        "honor a contract",
                        "honor an agreement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать то, что было согласовано или обещано.",
                        "zh": "履行已达成或承诺要做的事情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соблюдать",
                                "target_lang_sense_clarification": "придерживаться договоренности"
                            },
                            {
                                "target_lang_word": "выполнять",
                                "target_lang_sense_clarification": "исполнять обещанное"
                            },
                            {
                                "target_lang_word": "сдержать",
                                "target_lang_sense_clarification": "сдержать слово/обещание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "履行",
                                "target_lang_sense_clarification": "执行承诺或合同"
                            },
                            {
                                "target_lang_word": "遵守",
                                "target_lang_sense_clarification": "依照约定行事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "332d81f8-3aa4-3c51-a598-d97d3c263625",
                    "sense_definition": "To accept and pay a cheque or other financial order.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_pay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank will not <w>honor</w> the check if there are insufficient funds.",
                            "target_lang_translations": {
                                "ru": "Банк не <w>оплатит</w> чек, если средств недостаточно.",
                                "zh": "如果资金不足，银行将不会<w>兑付</w>这张支票。"
                            }
                        },
                        {
