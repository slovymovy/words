                        "glosses": [
                            "Annuler une enchère coinchée en faisant une enchère supérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ec4b092-50ae-4969-a072-6d23d987c334",
                                "sense_id": "1e877cd5-63f4-3f7b-9174-37b2d9927fd0",
                                "text": "Si un joueur est coinché les deux autres joueurs peuvent décoincher en faisant une enchère supérieure."
                            },
