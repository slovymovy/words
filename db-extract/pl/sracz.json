                                        "entry_id": "62f3dc57-e99c-315c-bfc6-ca5fed2d1de7",
                                        "glosses": [
                                            "An outhouse, an outbuilding used as a lavatory."
                                        ],
                                        "tags": [
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3fe584e-7a54-4bf5-9661-62c1113352a4",
                                                "sense_id": "e7cd3ad0-392b-3b7b-be5c-984e10489ff5",
                                                "text": "He would rather slop out his Punjabis' shithouses than kiss the arse of some limp-wristed war profiteer in Civvy Street, thank you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccaef279-35a7-3f05-964c-ed30dd912b98",
                                        "entry_id": "62f3dc57-e99c-315c-bfc6-ca5fed2d1de7",
                                        "glosses": [
                                            "A coward; one who is overly fearful or timid."
                                        ],
                                        "tags": [
