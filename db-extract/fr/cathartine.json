                        "glosses": [
                            "Substance purgative d’une saveur âcre et nauséabonde, qui se trouve dans le séné, dont elle est le principe actif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "094ffbf6-61f3-4b06-960e-9c3ff3f9a263",
                                "sense_id": "439bd3a5-2d97-3482-b49f-fc0bed49850a",
                                "text": "Scabia parle d’injections sub-cutanées de substances purgatives comme l’aloès, l’aloine, la cathartine, l’acide cathartinique, l’évonymine et le sulfate de magnésie; mais, comme il le dit, cela ne donne pas souvent les résultats attendus."
                            }
                        ]
                    }
