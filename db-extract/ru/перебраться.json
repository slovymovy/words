                        "target_lang_word": "umziehen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "umziehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "522c6cd1-a3a1-3a97-bc17-9a6a7c5cfa9c",
                                        "entry_id": "e621135f-5703-318b-b43c-853693768d05",
                                        "glosses": [
                                            "den Wohnsitz wechseln"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecd94cb4-5694-4be1-866d-42c2a2e05b71",
                                                "sense_id": "522c6cd1-a3a1-3a97-bc17-9a6a7c5cfa9c",
                                                "text": "Sie zieht in eine andere Stadt um."
                                            },
                                            {
                                                "example_id": "4579d56e-16fd-41c1-ba21-2bd74144445f",
                                                "sense_id": "522c6cd1-a3a1-3a97-bc17-9a6a7c5cfa9c",
                                                "text": "Sie ist gerade umgezogen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "846512ad-b3a1-3d1f-97f1-09a803a97fa9",
                                        "entry_id": "e621135f-5703-318b-b43c-853693768d05",
                                        "glosses": [
                                            "das Gewand, die Kleidung wechseln"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c44bab2f-c181-4e78-ae6d-ee65597ac322",
                                                "sense_id": "846512ad-b3a1-3d1f-97f1-09a803a97fa9",
                                                "text": "Sie zieht sich gerade für die Feier um."
                                            },
                                            {
                                                "example_id": "460ead2a-d3e2-4baa-828d-5f1de2aa7381",
                                                "sense_id": "846512ad-b3a1-3d1f-97f1-09a803a97fa9",
                                                "text": "Sie hat sich gerade umgezogen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "umziehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e77e4fc-38ea-3c3d-82c7-af8748635f59",
                                        "entry_id": "77857925-5d45-361f-830b-2ba9a80a522e",
                                        "glosses": [
                                            "etwas mit etwas umgeben, umranden"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf683509-70f7-49ff-8600-74d0b8ba110d",
                                                "sense_id": "4e77e4fc-38ea-3c3d-82c7-af8748635f59",
                                                "text": "Ungewöhnlich für omanische Forts ist es, dass der gesamte Komplex mit einem breiten Burggraben umzogen ist."
                                            },
                                            {
                                                "example_id": "bcc57dde-cb9c-4b16-b1f0-a18a333256a7",
                                                "sense_id": "4e77e4fc-38ea-3c3d-82c7-af8748635f59",
                                                "text": "Deine Zeichnung kannst du noch mit einem Filzstift umziehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a064fdd4-c8ec-3080-8097-f12401e11005",
                                        "entry_id": "77857925-5d45-361f-830b-2ba9a80a522e",
                                        "glosses": [
                                            "(sich) mit Wolken bedecken"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c66aecb-6e01-4eb5-891d-e95b825a7bc6",
                                                "sense_id": "a064fdd4-c8ec-3080-8097-f12401e11005",
                                                "text": "Die Wolken umzogen der Berge Gipfel, und wir waren lange Zeit unschlüßig, ob wir nicht unsere Reise auf einen andern Tag verschieben wollten."
                                            },
                                            {
                                                "example_id": "8e3bdaef-ee33-49df-b908-79cb8e2aa7fd",
                                                "sense_id": "a064fdd4-c8ec-3080-8097-f12401e11005",
                                                "text": "Der Himmel hat sich tiefschwarz umzogen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b02875a5-21d3-4b30-958f-100495779512",
                        "source_entry_id": "5998fe8e-b77b-3e6a-b6d4-e9128a08ee39",
                        "target_lang_word": "déménager",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déménager",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fed6fd2f-6db2-3017-bc91-7918d48de961",
                                        "entry_id": "c14d1bc9-b942-3268-87ff-065f8ba1fa86",
                                        "glosses": [
                                            "Ôter d’une maison, d’un logement ce qui le garnit pour le transporter ailleurs."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60afe521-c13d-41b2-a7b9-1ef10594638f",
                                                "sense_id": "fed6fd2f-6db2-3017-bc91-7918d48de961",
                                                "text": "Les hommes de Maycomb, plus ou moins habillés, déménageaient les meubles de Miss Maudie dans une cour de l'autre côté de la rue. Je vis Atticus transporter son lourd fauteuil à bascule en chêne et songeai que c'était bien de lui d'avoir eu la délicatesse de sauver ce qu'elle préférait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4544ffe-a5cf-38da-999b-0fb2c2ee0102",
                                        "entry_id": "c14d1bc9-b942-3268-87ff-065f8ba1fa86",
                                        "glosses": [
                                            "Quitter l’endroit où l’on demeure."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "582ce4a2-75d6-4b70-b4c0-92d9d4190fac",
                                                "sense_id": "f4544ffe-a5cf-38da-999b-0fb2c2ee0102",
                                                "text": "« Les dieux lares sont lents à pénétrer dans une maison », écrivait Lamb, un jour qu’il venait de s’installer dans un nouvel appartement ; et il disait volontiers qu’il était mort autant de fois qu’il avait déménagé, et qu’on retrouverait un peu de sa chair aux murs des maisons qu’il avait habitées."
                                            },
                                            {
                                                "example_id": "33905681-5cf9-4e94-902a-b4a785550c44",
                                                "sense_id": "f4544ffe-a5cf-38da-999b-0fb2c2ee0102",
                                                "text": "Sa famille avait ensuite déménagé à Pordic (22)."
                                            },
                                            {
                                                "example_id": "0564f5ae-b0a7-464f-81e8-2e3aff53cc8e",
                                                "sense_id": "f4544ffe-a5cf-38da-999b-0fb2c2ee0102",
                                                "text": "Le mariage eut lieu dans les jours qui suivirent. Vous déménageâtes chez le vieux, qui vous laissa à vos jeux et ne se préoccupa que de votre confort. Il était riche et laid, mais pas bête."
                                            },
                                            {
                                                "example_id": "6e335322-1cc4-429e-876c-a9f69b70ca43",
                                                "sense_id": "f4544ffe-a5cf-38da-999b-0fb2c2ee0102",
                                                "text": "Il suffisait que des locataires de la maison déménageassent pour qu'elle ne dormît plus et souffrît autant que si on l'eût privée de tout. La pensée qu'on allait et venait près d'elle, qu'on était content de partir ou de s'installer, lui était intolérable."
                                            },
                                            {
                                                "example_id": "6de7bf39-46c5-469a-af8d-aef4743085fb",
                                                "sense_id": "f4544ffe-a5cf-38da-999b-0fb2c2ee0102",
                                                "text": "Il y a longtemps qu’il est déménagé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21edf260-f7a9-344f-8187-ac8b7d894776",
                                        "entry_id": "c14d1bc9-b942-3268-87ff-065f8ba1fa86",
                                        "glosses": [
                                            "Sortir du lieu où l’on est."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "note": "Cela ne se dit guère que d’une personne contrainte de se retirer",
                                        "examples": [
                                            {
                                                "example_id": "081d9aa5-cddf-42c7-86ab-d3c3fab668d6",
                                                "sense_id": "21edf260-f7a9-344f-8187-ac8b7d894776",
                                                "text": "Le grand-oncle de Clarisse y avait habité longtemps avec sa femme et ses trois enfants avant que ses affaires ne l'incitent à déménager du côté de New-York."
                                            },
                                            {
                                                "example_id": "4349ade7-0d94-40a4-aa67-df40acd9791c",
                                                "sense_id": "21edf260-f7a9-344f-8187-ac8b7d894776",
                                                "text": "N'ayant que mon flair pour compétence médiumnique, je leur conseillais de déménager fissa, et quand l'archevêque me demanda où, je répondis où vous voulez, sur les bords de la Valoine ou dans la médina de Kairouan, ça m'est plutôt égal, mais évitez les cimetières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc1b3a1a-c913-3039-b3f0-a03562d58284",
                                        "entry_id": "c14d1bc9-b942-3268-87ff-065f8ba1fa86",
                                        "glosses": [
                                            "Perdre la raison."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57e484e6-741f-433c-8791-b7d8ed6c41b8",
                                                "sense_id": "cc1b3a1a-c913-3039-b3f0-a03562d58284",
                                                "text": "Les jours suivants, il retomba dans une sombre tristesse; il errait dans le château comme une âme en peine; parfois, on l'entendait se parler à lui-même d'une voix haute mais inintelligible, et ses compagnons d’office conclurent à l'unanimité qu'il déménageait complétement."
                                            },
                                            {
                                                "example_id": "207acc12-3301-428c-a8e2-407468f801dc",
                                                "sense_id": "cc1b3a1a-c913-3039-b3f0-a03562d58284",
                                                "text": "Comme il arrive, ses amis et ses relations mirent du temps à s’apercevoir qu’il déménageait. On disait : « C’est un fantaisiste, un être de caprice, et de rêve, comme tous les poètes. » Ou bien : « Il est amoureux. Ça passera. »"
                                            },
                                            {
                                                "example_id": "d4b134df-366f-4ebb-8535-2d46f49ee79a",
                                                "sense_id": "cc1b3a1a-c913-3039-b3f0-a03562d58284",
                                                "text": "A la justice pour me juger moi, Gavrilovna Krassavina ! Tu déménages ou quoi ! Tu crois que j'ai les jetons ? D'accord, allons-y pour un procès. Tu peux porter plainte contre moi, j'ai du répondant. Tu prends quel tribunal ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b0607d3-bf38-3438-91fc-8b0d3254ae52",
                                        "entry_id": "c14d1bc9-b942-3268-87ff-065f8ba1fa86",
                                        "glosses": [
                                            "Provoquer une réaction intense."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4aa96d4c-1989-4268-a0bb-d80561b1627d",
                                                "sense_id": "3b0607d3-bf38-3438-91fc-8b0d3254ae52",
                                                "text": "Nous nous lançons dans un rock déchaîné. Crado tient un rythme d'enfer. Dany crie autant qu'il chante, et ça déménage. Il bondit, sautille, tombe à genoux et lance un pick dans la foule. Il joue même assez bien."
                                            },
                                            {
                                                "example_id": "646e9784-1b83-4736-9983-e6f684cc8d02",
                                                "sense_id": "3b0607d3-bf38-3438-91fc-8b0d3254ae52",
                                                "text": "Nous avalons de concert ce tord-boyaux d'une traite. […]. Topaze grimace, secoue la tête, tout en lâchant d'une voix rauque :\n— Ouf, merde, ça déménage !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
