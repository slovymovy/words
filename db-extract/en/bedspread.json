                    },
                    {
                        "translation_id": "a5033a1f-069e-4554-8c80-168b963c48fc",
                        "source_entry_id": "72915675-dd15-363d-9b40-e83601a68995",
                        "source_sense_description": "topmost covering of a bed",
                        "target_lang_word": "Bettdecke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bettdecke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8289717a-3617-388f-9aa0-e79d546f9677",
                                        "entry_id": "f680a3c3-25c5-350a-8775-37d6da0bbfd5",
                                        "glosses": [
                                            "eine Decke zum Zudecken im Bett"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89130677-e8b4-42de-ac24-624cb1bf8d29",
                                                "sense_id": "8289717a-3617-388f-9aa0-e79d546f9677",
                                                "text": "Im Sommer brauche ich eine dünne Bettdecke."
                                            },
                                            {
                                                "example_id": "da6b45a3-a140-4ab1-a08d-1330ee74178e",
                                                "sense_id": "8289717a-3617-388f-9aa0-e79d546f9677",
                                                "text": "„Er hebt eine Ecke der Bettdecke.“"
                                            },
                                            {
                                                "example_id": "01e5c730-d936-4ee6-ba91-639b72138b1d",
                                                "sense_id": "8289717a-3617-388f-9aa0-e79d546f9677",
                                                "text": "„Davis, ein Genetiker, der früher biochemische Forschungen betrieb, wirft die Bettdecke beiseite und eilt über eine gewundene Holztreppe hinunter ins Erdgeschoss.“"
                                            },
                                            {
                                                "example_id": "0c043262-21f0-4654-bed3-cbd32731dd21",
                                                "sense_id": "8289717a-3617-388f-9aa0-e79d546f9677",
                                                "text": "„Tom ging hinunter und holte die Decke, die er aus dem Armeebestand stibitzt hatte, und sie gab eine prächtige Bettdecke ab.“"
                                            },
                                            {
                                                "example_id": "090079f5-33ce-49ac-84de-4ccc05f745b7",
                                                "sense_id": "8289717a-3617-388f-9aa0-e79d546f9677",
                                                "text": "„Meine Mutter dreht mir den Rücken zu und zieht sich die Bettdecke über den Kopf.“"
                                            },
                                            {
                                                "example_id": "22fc5f1e-78ee-4a4d-baa4-c98edf3085da",
                                                "sense_id": "8289717a-3617-388f-9aa0-e79d546f9677",
                                                "text": "„Dann nahm ich mir einen frischen Pyjama aus dem Schrank, schlüpfte ungeschickt, aber erfolgreich hinein, zog mir die Bettdecke bis unter das Kinn und schlief endlich ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
