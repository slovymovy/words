                        "examples": [
                            {
                                "example_id": "be449546-4ec8-4327-b102-7f4042fc90a1",
                                "sense_id": "116f657d-b2ba-3c34-a1d8-585f10e6b98b",
                                "text": "„Dazu gehörten an Männerkleidern unter anderem ein knielanger Rock, eine Schaube, ein Wams, ein kurzer Rock und ein Mantel; an Frauenkleidern ein Rock (im Sinne von Jacke) mit ausgestellten Ärmeln (Flügelärmeln), eine Schaube, ein langer Rock (im Sinne von Kleid) für eine ›ehrbare‹ Frau der Oberschicht, ein Rock für eine Handwerkerfrau, ein Mägderock.“"
                            }
                        ],
