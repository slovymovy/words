                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9aac6fb3-fab8-42ec-bb8e-1a4c79a2f4a5",
                                "sense_id": "28ec78ef-74a3-3ac4-bd4d-b98e8f75b0fd",
                                "text": "Door de jaren heen is mijn stem een krachtig en effectief gereedschap geworden. Maar mijn basisschoolleraar zei vroeger al dat ik leed aan verbale diarree, omdat ik steeds maar aan het praten was."
                            },
                            {
                                "example_id": "5d0addd2-3c64-44c7-b0d5-e848d2f07a89",
                                "sense_id": "28ec78ef-74a3-3ac4-bd4d-b98e8f75b0fd",
                                "text": ",,Het gaat om 150 docenten op een beroepsgroep van 250.000,” stelt basisschoolleraar Thijs Roovers. Dat clubje is volgens hem te klein om representatief te zijn."
                            }
                        ]
