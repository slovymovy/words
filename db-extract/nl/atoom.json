                ],
                "senses": [
                    {
                        "sense_id": "9e1342af-2636-3fac-9ada-2bac2b41b8a8",
                        "entry_id": "96709fdf-1ffb-3d44-8014-6309184a4225",
                        "glosses": [
                            "het kleinste deel van een element dat nog dezelfde eigenschappen van dat element bezit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61c10348-4529-4770-8b88-ccb2ee63b20b",
                                "sense_id": "9e1342af-2636-3fac-9ada-2bac2b41b8a8",
                                "text": "Het waterstofatoom is het kleinste atoom dat er bestaat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96e6beb8-6119-4a3e-9bd4-a46ab248a2ac",
                        "source_entry_id": "96709fdf-1ffb-3d44-8014-6309184a4225",
                        "source_sense_id": "9e1342af-2636-3fac-9ada-2bac2b41b8a8",
                        "target_lang_word": "Atom",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Atom",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e4226a40-e16a-3477-a9fc-0179b0139ad5",
                                        "entry_id": "358306a1-e2ac-318a-9b2e-a164373debf9",
                                        "glosses": [
                                            "kleinstes, nicht mehr chemisch weiter teilbares Teilchen mit ausgeglichener elektrischer Ladung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a172e153-d67f-49f2-ae9c-ac94026ebe07",
                                                "sense_id": "e4226a40-e16a-3477-a9fc-0179b0139ad5",
                                                "text": "„Es ist schwieriger, eine vorgefasste Meinung zu zertrümmern als ein Atom.“ - Albert Einstein"
                                            },
                                            {
                                                "example_id": "b290b8ad-73ba-4698-a91b-b3dd2bc2ea2b",
                                                "sense_id": "e4226a40-e16a-3477-a9fc-0179b0139ad5",
                                                "text": "Ein Atom besteht aus Atomhülle und Atomkern; der Kern besteht aus Nukleonen, die Hülle aus Elektronen."
                                            },
                                            {
                                                "example_id": "321ac30c-f030-4c6f-829f-907d4d142094",
                                                "sense_id": "e4226a40-e16a-3477-a9fc-0179b0139ad5",
                                                "text": "„Bei jeder chemischen Reaktion bleiben die Art und die Anzahl der beteiligten Atome unverändert.“"
                                            },
                                            {
                                                "example_id": "6981b22d-3313-4c5a-94d5-1c6e7787ca9c",
                                                "sense_id": "e4226a40-e16a-3477-a9fc-0179b0139ad5",
                                                "text": "„Früher hatte man jedes Atom für ein Sonnensystem im kleinen gehalten, das aus einem Kern bestand, der von kreisenden Elektronen umgeben war und die Sphärenharmonie in mikroskopischem Maßstab widerspiegelte.“"
                                            },
                                            {
                                                "example_id": "3b1bba53-709a-437f-b003-a0c4290fe1b7",
                                                "sense_id": "e4226a40-e16a-3477-a9fc-0179b0139ad5",
                                                "text": "„Der Begriff »Atom« (von atomos = unteilbar) stammt von seinem Lehrer Leukipp.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f687b6f9-cc1e-4d45-8eb9-22f9400daa76",
                        "source_entry_id": "96709fdf-1ffb-3d44-8014-6309184a4225",
                        "source_sense_id": "9e1342af-2636-3fac-9ada-2bac2b41b8a8",
                        "target_lang_word": "atom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c80deaff-4aa5-3842-a611-ca00fca7eefe",
                                        "entry_id": "8dce9d89-68b9-31ac-a5bb-4b16eb409672",
                                        "glosses": [
                                            "The smallest possible amount of matter which still retains its identity as a chemical element, now known to consist of a nucleus surrounded by electrons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21f76234-9c7c-4248-8378-e99c67716db0",
                                                "sense_id": "c80deaff-4aa5-3842-a611-ca00fca7eefe",
                                                "text": "Oxygen levels on Earth skyrocketed 2.4 billion years ago, when cyanobacteria evolved photosynthesis: the ability to convert water and carbon dioxide into carbohydrates and waste oxygen using solar energy. The evolutionary precursor of photosynthesis is still under debate, and a new study sheds light. The critical component of the photosynthetic system is the water-oxidizing complex, made up of manganese atoms and a calcium atom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1536681f-6141-37f5-89d7-6fc5e7271608",
                                        "entry_id": "8dce9d89-68b9-31ac-a5bb-4b16eb409672",
                                        "glosses": [
                                            "A hypothetical particle posited by Greek philosophers as an ultimate and indivisible component of matter."
                                        ],
                                        "tags": [
                                            "of science"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08cf03f0-89b0-3e94-b2c2-97d7742ec239",
                                        "entry_id": "8dce9d89-68b9-31ac-a5bb-4b16eb409672",
                                        "glosses": [
                                            "The smallest, indivisible constituent part or unit of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "084fd595-61fe-4def-a4a8-63c876595aaa",
                                                "sense_id": "08cf03f0-89b0-3e94-b2c2-97d7742ec239",
                                                "text": "Towards the following morning, the thermometer fell to 5°; and at daylight, there was not an atom of water to be seen in any direction."
                                            },
                                            {
                                                "example_id": "a562e57a-cf80-4c97-b621-0150cb72d431",
                                                "sense_id": "08cf03f0-89b0-3e94-b2c2-97d7742ec239",
                                                "text": "But at this critical moment the pirate astern sent a mischievous shot and knocked one of the men to atoms at the helm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b32f4db-c5eb-3a9c-b7ca-a22fb5b5043d",
                                        "entry_id": "8dce9d89-68b9-31ac-a5bb-4b16eb409672",
                                        "glosses": [
                                            "In logical atomism, a fundamental fact that cannot be further broken down."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "786f3f5a-1220-3068-8683-876188b85c52",
                                        "entry_id": "8dce9d89-68b9-31ac-a5bb-4b16eb409672",
                                        "glosses": [
                                            "The smallest medieval unit of time, equal to fifteen ninety-fourths of a second."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "554ebbdf-1b03-3c0e-99f4-57b292d67aee",
                                        "entry_id": "8dce9d89-68b9-31ac-a5bb-4b16eb409672",
                                        "glosses": [
                                            "A mote of dust in a sunbeam."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c0e25c4f-2967-3720-ac67-57035cce8ecd",
                                        "entry_id": "8dce9d89-68b9-31ac-a5bb-4b16eb409672",
                                        "glosses": [
                                            "A very small amount; a whit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30b67302-4193-436a-bc4b-5893aa55c866",
                                                "sense_id": "c0e25c4f-2967-3720-ac67-57035cce8ecd",
                                                "text": "\"Doctor, tell me one word more,\" said Theodore, quivering with suppressed emotion. \"How do you think it will end?\" / \"I have hardly the faintest atom of hope,\" answered this honest, earnest man."
                                            },
                                            {
                                                "example_id": "fd5dccef-196e-4948-86fb-db263dcc8ed3",
                                                "sense_id": "c0e25c4f-2967-3720-ac67-57035cce8ecd",
                                                "text": "We are born, we are given just so much food as will keep the breath in our bodies, and those of us who are capable of it are forced to work to the last atom of our strength; and the very instant that our usefulness has come to an end we are slaughtered with hideous cruelty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78ecf0a3-cd44-3fd6-b207-4565f5a59c71",
                                        "entry_id": "8dce9d89-68b9-31ac-a5bb-4b16eb409672",
                                        "glosses": [
                                            "An individual number or symbol, as opposed to a list; a scalar value."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "83f657f7-f389-32c7-a750-fb90f13c4015",
                                        "entry_id": "8dce9d89-68b9-31ac-a5bb-4b16eb409672",
                                        "glosses": [
                                            "An integer representing a particular string."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04526cf1-fe53-3865-bc4d-9e99f00d38e6",
                                        "entry_id": "8dce9d89-68b9-31ac-a5bb-4b16eb409672",
                                        "glosses": [
                                            "A non-zero member of a partially ordered set that has only zero below it (assuming that the poset has a least element, its \\\"zero\\\")."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "108c2901-cc74-4133-9849-88528c6b251f",
                                                "sense_id": "04526cf1-fe53-3865-bc4d-9e99f00d38e6",
                                                "text": "In a Venn diagram, an atom is depicted as an area circumscribed by lines but not cut by any line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa2af71c-bd79-3777-a697-0d583ba97d8d",
                                        "entry_id": "8dce9d89-68b9-31ac-a5bb-4b16eb409672",
                                        "glosses": [
                                            "An element of a set that is not itself a set; an urelement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "27e91d57-a203-34e6-8d40-fe6eb5cee812",
                                        "entry_id": "8dce9d89-68b9-31ac-a5bb-4b16eb409672",
                                        "glosses": [
                                            "An age group division in hockey for nine- to eleven-year-olds."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "attributive",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ece39ab-d10c-4800-a7d5-4f492b5ee249",
                        "source_entry_id": "96709fdf-1ffb-3d44-8014-6309184a4225",
                        "source_sense_id": "9e1342af-2636-3fac-9ada-2bac2b41b8a8",
                        "target_lang_word": "atome",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atome",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ddef299-e6ca-3299-8c62-59ad7d4f3435",
                                        "entry_id": "6e512a2b-a3e0-354f-b24d-9152ceaeb242",
                                        "glosses": [
                                            "Composant de la matière, plus petite partie d’un corps simple pouvant se combiner avec une autre."
                                        ],
                                        "tags": [
                                            "Chimie physique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fecd850f-e9b1-403d-ba39-f278bfa6030a",
                                                "sense_id": "6ddef299-e6ca-3299-8c62-59ad7d4f3435",
                                                "text": "Or ces atomes n’ont pas pu être créés dans les étoiles, mais seulement dans les conditions ultradenses et chaudes prévues par les modèles de Big Bang."
                                            },
                                            {
                                                "example_id": "cdf0a2a5-55dd-420e-b79f-666e7b85a565",
                                                "sense_id": "6ddef299-e6ca-3299-8c62-59ad7d4f3435",
                                                "text": "Cela me troublait alors ―\nCar alors j'étais une Enfant ―\nDe conclure qu'un atome ― tombait ―\nAlors que le ciel ― tenait ―"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7780fff-7e7f-3082-bf34-7f15d236ffc4",
                                        "entry_id": "6e512a2b-a3e0-354f-b24d-9152ceaeb242",
                                        "glosses": [
                                            "Énergie nucléaire."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb1d4bfc-7e80-45e7-b449-c9f1ea7b81e4",
                                                "sense_id": "b7780fff-7e7f-3082-bf34-7f15d236ffc4",
                                                "text": "Malgré ses atouts, l’atome est confronté à un problème d’échelle. Les 453 réacteurs nucléaires en fonctionnement dans trente pays ne fournissent qu’un peu plus de 2 % de la consommation d’énergie finale de l’humanité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bde0b65b-fa09-33cd-b113-742ce13d90d5",
                                        "entry_id": "6e512a2b-a3e0-354f-b24d-9152ceaeb242",
                                        "glosses": [
                                            "Pour exprimer l’extrême petitesse de certains corps relativement à d’autres, ou à l’espace dans lequel ils existent."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e52e6f44-8dbc-44c6-b68c-7eecd79e3033",
                                                "sense_id": "bde0b65b-fa09-33cd-b113-742ce13d90d5",
                                                "text": "Il y avait autrefois un grain de sable qui se lamentait d'être un atome ignoré dans les déserts."
                                            },
                                            {
                                                "example_id": "fcf149ee-3d8f-41a3-8db1-e38e785d0ade",
                                                "sense_id": "bde0b65b-fa09-33cd-b113-742ce13d90d5",
                                                "text": "De leur force collective, l’humanité tire une grande prospérité matérielle, tandis que l’homme pauvre n’a par lui-même absolument aucune importance. Il n’est que l’atome infinitésimal d’une force qui, loin de le respecter, le broie et d’ailleurs le préfère broyé, car plus docile."
                                            },
                                            {
                                                "example_id": "6b2d9cd3-319e-4275-9dcf-61b1fa794835",
                                                "sense_id": "bde0b65b-fa09-33cd-b113-742ce13d90d5",
                                                "text": "Quoique je n’aie pas un atome\nUne ombre de méchanceté\nS´il fouette mes chats, y a un fantôme\nQui viendra le persécuter."
                                            },
                                            {
                                                "example_id": "85b784b0-ae07-48c4-b418-5ca353a1928c",
                                                "sense_id": "bde0b65b-fa09-33cd-b113-742ce13d90d5",
                                                "text": "Les hommes sont des atomes sur le globe, qui n’est lui-même qu’un atome dans l’immensité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b72c535c-57e0-3196-8ed7-a2e2b9e9779e",
                                        "entry_id": "6e512a2b-a3e0-354f-b24d-9152ceaeb242",
                                        "glosses": [
                                            "Corps regardé comme indivisible, à cause de son extrême petitesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50547cb2-8d38-42e4-ad77-1e5b440eb10a",
                                                "sense_id": "b72c535c-57e0-3196-8ed7-a2e2b9e9779e",
                                                "text": "Il ne restera pas un atome de ce corps gracieux pour que nous puissions dire : « C’est ici que fut la vie et le mouvement ! »"
                                            },
                                            {
                                                "example_id": "ebac19f5-4ea1-4b2a-929c-e5ab709405f3",
                                                "sense_id": "b72c535c-57e0-3196-8ed7-a2e2b9e9779e",
                                                "text": "Tous les corps existants sont composés de ces atomes en contact immédiat, et peuvent conséquemment être considérés comme de simples assemblages de différences plus ou moins nombreuses ; […]."
                                            },
                                            {
                                                "example_id": "d44f7587-e10e-4f80-a734-6803f1e5afb2",
                                                "sense_id": "b72c535c-57e0-3196-8ed7-a2e2b9e9779e",
                                                "text": "L’atome était, pour Démocrite et Épicure, le plus petit élément indivisible de la matière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03af9ccf-898e-3237-87be-29726c29fe4e",
                                        "entry_id": "6e512a2b-a3e0-354f-b24d-9152ceaeb242",
                                        "glosses": [
                                            "Grains minuscules de poussière qui voltigent en l’air et que l’on aperçoit lorsqu’un rayon du soleil pénètre dans un endroit obscur ou ombragé."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e76f9a69-1e28-35b3-a042-3934f13dc8b1",
                                        "entry_id": "6e512a2b-a3e0-354f-b24d-9152ceaeb242",
                                        "glosses": [
                                            "(Arachnides) Synonyme désuet de trombidion (note: l'ancien nom du genre Trombidium était Atomus)."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
