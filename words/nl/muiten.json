    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aaf275a2-d32c-32a7-8407-dd82de22dc56",
                    "sense_definition": "In opstand komen tegen het wettige gezag, in het bijzonder door militairen of scheepsbemanningen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "opstand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De matrozen besloten te <w>muiten</w> nadat ze wekenlang slecht voedsel hadden gekregen.",
                            "target_lang_translations": {
                                "en": "The sailors decided to <w>mutiny</w> after receiving poor food for weeks."
                            }
                        },
                        {
                            "text": "De kapitein vreesde dat de bemanning zou gaan <w>muiten</w> tijdens de lange reis.",
                            "target_lang_translations": {
                                "en": "The captain feared that the crew would <w>mutiny</w> during the long voyage."
                            }
                        }
                    ],
                    "synonyms": [
                        "rebelleren",
                        "opstaan"
                    ],
                    "antonyms": [
                        "gehoorzamen"
                    ],
                    "common_phrases": [
                        "tegen de kapitein muiten"
                    ],
                    "target_lang_definitions": {
                        "en": "To rebel against lawful authority, especially by soldiers or ship crews."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mutiny",
                                "target_lang_sense_clarification": "to rebel against authority, especially at sea or in the military"
                            },
                            {
                                "target_lang_word": "rebel",
                                "target_lang_sense_clarification": "to rise in opposition or armed resistance to an established government or leader"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68830c38-f252-3e9b-b3a0-3e802d1b7793",
                    "sense_definition": "Het verliezen en vernieuwen van veren door vogels; rujen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vogel_biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In deze tijd van het jaar beginnen de jonge valken te <w>muiten</w>.",
                            "target_lang_translations": {
                                "en": "At this time of year, the young falcons begin to <w>moult</w>."
                            }
                        },
                        {
                            "text": "De vogel is erg stil omdat hij momenteel aan het <w>muiten</w> is.",
                            "target_lang_translations": {
                                "en": "The bird is very quiet because it is currently <w>moulting</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ruien"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Voornamelijk gebruikt in specifieke biologische of regionale contexten voor rujen."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The process of birds shedding and renewing their feathers; moulting."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "moult",
                                "target_lang_sense_clarification": "to shed feathers, hair, or skin to make way for new growth"
                            },
                            {
                                "target_lang_word": "molt",
                                "target_lang_sense_clarification": "American spelling of moult"
                            }
                        ]
                    }
                }
            ]
        },
        {
