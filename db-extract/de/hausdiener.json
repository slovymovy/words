                "senses": [
                    {
                        "sense_id": "5c0e9dc3-9024-3e5a-a539-1d4d530bb531",
                        "entry_id": "8b6ff3b8-9e02-3e96-b4ed-08a4719a7ced",
                        "glosses": [
                            "jemand, der in einem Haus/Hotel/Unternehmen für einfache Arbeiten beschäftigt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28e9b03b-cbfe-43d5-83e8-d2dbfa146a6c",
                                "sense_id": "5c0e9dc3-9024-3e5a-a539-1d4d530bb531",
                                "text": "„Man will sich ansehen, was am schönsten ist, man fragt den Portier, den Hausdiener, den Kellner und das Zimmermädchen und bekommt von jedem eine andere Antwort, und schließlich hält man sich an den Baedeker und läuft die Sternchen ab, jeder auf seine Weise.“"
                            },
                            {
                                "example_id": "d8c4e999-473f-4a6e-8d28-981bbdc5c22c",
                                "sense_id": "5c0e9dc3-9024-3e5a-a539-1d4d530bb531",
                                "text": "„Der Hausdiener und ein Stubenmädchen kommen auch und grinsen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a0d5647-a358-4c60-b1d7-5e2cf063f767",
                        "source_entry_id": "8b6ff3b8-9e02-3e96-b4ed-08a4719a7ced",
                        "source_sense_id": "5c0e9dc3-9024-3e5a-a539-1d4d530bb531",
                        "source_sense_description": "jemand, der in einem Haus/Hotel/Unternehmen für einfache Arbeiten beschäftigt ist",
                        "target_lang_word": "служащий",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "служащий",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "41c0d1a3-358b-32fb-bcd3-e33426dee0b8",
                                        "entry_id": "fb57cde3-18a0-3a76-aadf-a68e7b0ed09e",
                                        "glosses": [
                                            "действ. прич. наст. вр. от служить; состоящий на службе"
                                        ],
                                        "tags": [
                                            "participle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8245af1f-6e03-446d-8a2c-1d452dc6fc4a",
                                                "sense_id": "41c0d1a3-358b-32fb-bcd3-e33426dee0b8",
                                                "text": "Бабы решили, что Сидор, молодой парень из соседней деревни, служащий у меня в качестве кучера, огородника, мясника — он режет телят и баранов — и вообще по особым поручениям, непременно должен в нынешнем году жениться, потому что, за выходом замуж сидоровой сестры, в его двор нужна работница."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32c998c3-92fc-3a4c-a895-2314550617b4",
                                        "entry_id": "fb57cde3-18a0-3a76-aadf-a68e7b0ed09e",
                                        "glosses": [
                                            "предназначенный, используемый для чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78b40b7f-66ef-4b57-ae40-4d91c5b24e3a",
                                                "sense_id": "32c998c3-92fc-3a4c-a895-2314550617b4",
                                                "text": "Аппарат, служащий для усиления звука."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "112fed5c-2129-3e1e-bf92-2e196d3c97a7",
                                        "entry_id": "fb57cde3-18a0-3a76-aadf-a68e7b0ed09e",
                                        "glosses": [
                                            "субстантивир. работник, человек, занятый на службе в компании или организации"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91d034bc-8199-4e49-8030-d42e7f7743c3",
                                                "sense_id": "112fed5c-2129-3e1e-bf92-2e196d3c97a7",
                                                "text": "В конце рабочего дня служащие покидают офис."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd27fad3-7f97-4a50-83f9-b67c90afb6d6",
                        "source_entry_id": "8b6ff3b8-9e02-3e96-b4ed-08a4719a7ced",
                        "source_sense_id": "5c0e9dc3-9024-3e5a-a539-1d4d530bb531",
                        "source_sense_description": "jemand, der in einem Haus/Hotel/Unternehmen für einfache Arbeiten beschäftigt ist",
                        "target_lang_word": "прислуга",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "прислуга",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2e870cbf-fbaf-3bd2-831b-5d47c02403f5",
                                        "entry_id": "1f433926-c766-3582-9e76-085b2f2a30df",
                                        "glosses": [
                                            "служанка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd33c6c9-ed32-46a4-87d4-f9d1cd77fd07",
                                                "sense_id": "2e870cbf-fbaf-3bd2-831b-5d47c02403f5",
                                                "text": "Их встретила в прихожей новая прислуга — кругленькая девица, сразу протянувшая им красную, непропорционально большую руку."
                                            },
                                            {
                                                "example_id": "5ed01212-fff6-4f3c-b946-036a1d0ed15a",
                                                "sense_id": "2e870cbf-fbaf-3bd2-831b-5d47c02403f5",
                                                "text": "В доме Галерана жили, кроме него, шофер Груббе и девушка Тирса, сестра шофера, исполняющая обязанности прислуги и экономки."
                                            },
                                            {
                                                "example_id": "09e15a84-9aa8-460d-b07c-c89f35da6827",
                                                "sense_id": "2e870cbf-fbaf-3bd2-831b-5d47c02403f5",
                                                "text": "Сводились эти слухи к одному: он принудил прислугу к сожительству, законным образом этого сожительства в загсе не зарегистрировал; она от него забеременела; он ее бессовестно бросил; она теперь где-то такое скрывает свой позор и в конце февраля собирается рожать ребенка, а покуда торгует в Замоскворечье папиросами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c7a14ed-934a-3fce-bd99-a41c6f5e9f93",
                                        "entry_id": "1f433926-c766-3582-9e76-085b2f2a30df",
                                        "glosses": [
                                            "собир. слуги, дворня"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24e26940-31d0-4917-b22a-ad6ee794229f",
                                                "sense_id": "8c7a14ed-934a-3fce-bd99-a41c6f5e9f93",
                                                "text": "На дворе возилось человек десять прислуги, мужской и женской…"
                                            },
                                            {
                                                "example_id": "ae847888-6182-4e48-8e93-98f3b919da2a",
                                                "sense_id": "8c7a14ed-934a-3fce-bd99-a41c6f5e9f93",
                                                "text": "Как это было в прошлом и в третьем году, стали играть в короли, а вся прислуга, сколько её было в двух этажах, столпилась в дверях, чтобы поглядеть на игру."
                                            },
                                            {
                                                "example_id": "a86c91ba-9d6c-4c2d-b127-d8dae35afc65",
                                                "sense_id": "8c7a14ed-934a-3fce-bd99-a41c6f5e9f93",
                                                "text": "Кругло говоря, и Никитушка и Марина Абрамовна были отживающие типы той старой русской прислуги, которая рабски-снисходительно относилась к своим господам и гордилась своею им преданностью."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "834150cd-04ac-3072-9d8d-4ab9faff6494",
                                        "entry_id": "1f433926-c766-3582-9e76-085b2f2a30df",
                                        "glosses": [
                                            "собир., устар. работники, обслуживающие железнодорожный состав, станцию, пароход и т. п. || бойцы, обслуживающие орудие, миномет"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f2fc533-4104-42e4-af2e-c968b07cebbf",
                                                "sense_id": "834150cd-04ac-3072-9d8d-4ab9faff6494",
                                                "text": "Даже, говорят, прислуги на некоторых железных дорогах порядочной нет; администрации чуть-чуть сносной в какой-нибудь компании пароходов устроить, говорят, никак невозможно."
                                            },
                                            {
                                                "example_id": "7c873c3c-c018-40e4-af56-a9815997d61b",
                                                "sense_id": "834150cd-04ac-3072-9d8d-4ab9faff6494",
                                                "text": "Кроме того, в Оренбургском гарнизоне была отобрана пехотная рота (160 человек); ей были приданы четыре 3-фунтовых орудия с прислугой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "893f9de1-9d6b-328a-9419-71f8243a3879",
                                        "entry_id": "1f433926-c766-3582-9e76-085b2f2a30df",
                                        "glosses": [
                                            "собир., воен. бойцы, обслуживающие орудие, пулемёт, миномёт"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6fc9ee4d-39c1-3c34-9edd-688d9f64e308",
                                        "entry_id": "1f433926-c766-3582-9e76-085b2f2a30df",
                                        "glosses": [
                                            "устар. оказание услуг, услужение, обслуживание кого-либо"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
