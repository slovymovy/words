                "senses": [
                    {
                        "sense_id": "125bd515-eafa-39a8-8784-b7b90d2a059f",
                        "entry_id": "ddb6fcb2-f0e1-39aa-8f1e-76f160357934",
                        "glosses": [
                            "Wagen, der für eine Reise geeignet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9246b2ca-95b6-4666-a39d-eac16322ecc2",
                                "sense_id": "125bd515-eafa-39a8-8784-b7b90d2a059f",
                                "text": "„Der Reisewagen mit der Eskorte taucht im Flockenwirbel auf.“"
                            },
                            {
                                "example_id": "a8b16e28-4b85-4032-bef5-a0ed241b48a4",
                                "sense_id": "125bd515-eafa-39a8-8784-b7b90d2a059f",
                                "text": "„Ich nahm Platz in einem Reisewagen, zusammen mit einer Dame, die in Erfüllung eines Gelübdes, das sie während einer Krankheit getan hatte, ihre Tochter nach Loreno brachte.“"
                            }
                        ],
