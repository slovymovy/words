                ],
                "senses": [
                    {
                        "sense_id": "ffbfa692-7208-3e9a-865b-3ff6aa0d4c06",
                        "entry_id": "e2d27054-6db1-3bf2-813e-ac4fcccaa808",
                        "glosses": [
                            "als Opfer dargebrachte Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f21eb3a-e0cf-4372-9266-287919c4cb95",
                                "sense_id": "ffbfa692-7208-3e9a-865b-3ff6aa0d4c06",
                                "text": "„Von den Unterarmen dieses Leibchens hängen die Hände des Geopferten herab, so dass die Hände des Lebenden frei liegen und er sie mit geballten Fäusten auf seinen Knien aufstützen kann.“"
                            },
                            {
                                "example_id": "9bb8b7ed-aa1b-4540-b0e2-4749c0c938d1",
                                "sense_id": "ffbfa692-7208-3e9a-865b-3ff6aa0d4c06",
                                "text": "„Die Altarplattformen dienten ebenfalls diversen Zwecken, die von der Fruchtbarkeit über die Zurschaustellung von Schädeln der Geopferten bis hin zur Verehrung bestimmter Götter reichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
