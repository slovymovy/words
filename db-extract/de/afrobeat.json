                "senses": [
                    {
                        "sense_id": "c29cd7aa-da16-3217-abf5-76dfb5467c31",
                        "entry_id": "3f407f6a-1788-379b-a186-73fa0239a6a5",
                        "glosses": [
                            "Musikrichtung, die westafrikanische Musik mit amerikanischem Funk und Jazz kombiniert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c64f1c60-7264-4a6f-9907-2960d1aaa91c",
                                "sense_id": "c29cd7aa-da16-3217-abf5-76dfb5467c31",
                                "text": "„Der nigerianische Musiker, Mitbegründer des Afrobeat, sei am Donnerstag mit 79 Jahren in Paris gestorben, sagte sein Manager Eric Trosset der Nachrichtenagentur AFP.“"
                            },
                            {
                                "example_id": "4fda425f-6557-40da-b076-a2fdbc3b062a",
                                "sense_id": "c29cd7aa-da16-3217-abf5-76dfb5467c31",
                                "text": "„Sei es der staubtrockene Funk von ‚Separator‘ oder der hypnotische Afrobeat in ‚Morning Mr Magpie‘ - Phil Selway hebt seinen motorischen Krautrock-Stil auf eine neue Stufe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f38aa449-a302-4a7a-bfa7-710a277f9182",
                        "source_entry_id": "3f407f6a-1788-379b-a186-73fa0239a6a5",
                        "source_sense_id": "c29cd7aa-da16-3217-abf5-76dfb5467c31",
                        "source_sense_description": "Musikrichtung, die westafrikanische Musik mit amerikanischem Funk und Jazz kombiniert",
                        "target_lang_word": "afrobeat",
