                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "endearment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Are you feeling all right today, <w>chuck</w>?",
                            "target_lang_translations": {
                                "ru": "Ты сегодня хорошо себя чувствуешь, <w>дорогуша</w>?",
                                "zh": "你今天感觉好点了吗，亲爱的？"
                            }
                        },
                        {
                            "text": "Don't worry about it, <w>chuck</w>, we can fix it later.",
