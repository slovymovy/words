                "senses": [
                    {
                        "sense_id": "79281a82-85ae-3833-bf1c-e009544a5c40",
                        "entry_id": "dd17ce77-1398-3048-8608-9da00abc2159",
                        "glosses": [
                            "Ort, an dem Kampfhandlungen stattfinden, die weniger Wichtigkeit besitzen als andere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b318046-5ffc-48a9-9eca-547a06be77c7",
                                "sense_id": "79281a82-85ae-3833-bf1c-e009544a5c40",
                                "text": "„Die Kaukasusfront war ein Nebenkriegsschauplatz im Ersten Weltkrieg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a124f4e9-99b1-3d39-8f02-87c935ee9b93",
                        "entry_id": "dd17ce77-1398-3048-8608-9da00abc2159",
                        "glosses": [
                            "etwas von untergeordneter Bedeutung; ein weniger wichtiger Aspekt beziehungsweise ein nicht zu dem Gesichtspunkt gehörender Aspekt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "eddb6365-60a9-4341-bf2a-31c666f33dc6",
                                "sense_id": "a124f4e9-99b1-3d39-8f02-87c935ee9b93",
                                "text": "Verkehrsberuhigte Zonen in Städten sollen das Wegenetz sicherer machen. Dass der Anreiz aufs Fahrrad umzusteigen überdies die Gesundheit fördert, ist hier nur Nebenkriegsschauplatz."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "109a9e38-aac4-4d5d-a395-63c1a330d58e",
                        "source_entry_id": "dd17ce77-1398-3048-8608-9da00abc2159",
                        "source_sense_id": "79281a82-85ae-3833-bf1c-e009544a5c40",
                        "source_sense_description": "Ort, an dem Kampfhandlungen stattfinden, die weniger Wichtigkeit besitzen als andere",
                        "target_lang_word": "secondary theatre",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9afdf7bc-3cae-4ea0-97ee-8bb872a48003",
                        "source_entry_id": "dd17ce77-1398-3048-8608-9da00abc2159",
                        "source_sense_id": "a124f4e9-99b1-3d39-8f02-87c935ee9b93",
                        "source_sense_description": "etwas von untergeordneter Bedeutung",
                        "target_lang_word": "sideshow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sideshow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c47ee70-8c2e-35b4-bb50-7943b50b415f",
                                        "entry_id": "bfe813fb-7bd5-3f7f-b468-94839b710874",
                                        "glosses": [
                                            "A minor attraction at a larger event such as a circus, fair or music festival."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2022f328-c8aa-486d-9189-951adb67ee12",
                                                "sense_id": "4c47ee70-8c2e-35b4-bb50-7943b50b415f",
                                                "text": "1999 November 8, Frank Hayes, The Back Page: The main event, Computerworld, page 86,\nAnd IT people dismiss IT′s impact because, hey, we like being a sideshow to the real action."
                                            },
                                            {
                                                "example_id": "15fa51af-7115-42d2-88c0-910af41c54aa",
                                                "sense_id": "4c47ee70-8c2e-35b4-bb50-7943b50b415f",
                                                "text": "1999, Australian Bureau of Statistics, Year Book, Australia, Number 81, page 349,\nOther recreation services, including amusement parks or arcades, sideshows, circuses and agricultural shows, accounted for another 666 businesses. These businesses employed 10,318 persons and a further 3,518 volunteers."
                                            },
                                            {
                                                "example_id": "e694bd60-0553-48db-99d9-c466c1ff9c89",
                                                "sense_id": "4c47ee70-8c2e-35b4-bb50-7943b50b415f",
                                                "text": "In Australia he busked (singing on street corners), steeplejacked, was a drover and sheep shearer, did motor bike stunts in sideshows and even painted the Sydney Harbor^([sic]) Bridge."
                                            },
                                            {
                                                "example_id": "7e639f11-dacf-41f9-9722-ebacc720572d",
                                                "sense_id": "4c47ee70-8c2e-35b4-bb50-7943b50b415f",
                                                "text": "They taught the twins to play saxophone and transferred them from the sideshow to vaudeville."
                                            },
                                            {
                                                "example_id": "ff416b70-90a9-4a96-9f0e-298774600e12",
                                                "sense_id": "4c47ee70-8c2e-35b4-bb50-7943b50b415f",
                                                "text": "Entertainment features and sideshows enhanced attendance."
                                            },
                                            {
                                                "example_id": "51f66a35-bef8-473c-a218-b2a4d1f353fc",
                                                "sense_id": "4c47ee70-8c2e-35b4-bb50-7943b50b415f",
                                                "text": "Don′t miss the rusty relics dredged up from the original pier, and the spooky old sideshow machines."
                                            },
                                            {
                                                "example_id": "cd6c0073-1a80-46a4-adbd-1693c3b13c25",
                                                "sense_id": "4c47ee70-8c2e-35b4-bb50-7943b50b415f",
                                                "text": "1972 October 14, Henry Johnston, U.S. Tune Wins Rio Festival, Billboard, page 64,\nSideshows for foreign guests included one provided by Philips manager Andre Midani with his chief recording artists including Chico Buarque, Jorge Ben, Gal Costa Quintato, and Violado."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d2fcafe-62b7-3d32-a60c-c439b99bce92",
                                        "entry_id": "bfe813fb-7bd5-3f7f-b468-94839b710874",
                                        "glosses": [
                                            "An incidental spectacle that diverts attention from a larger concern."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad0f8221-5a04-48fe-ad7a-f6166dec16ba",
                                                "sense_id": "8d2fcafe-62b7-3d32-a60c-c439b99bce92",
                                                "text": "An emergency brake to limit in-work benefits for EU migrants is a “sideshow” that will fail to reduce the number of arrivals to the UK, Alan Johnson has said."
                                            },
                                            {
                                                "example_id": "53600566-6a7a-4c71-8ad6-6c73baf8623f",
                                                "sense_id": "8d2fcafe-62b7-3d32-a60c-c439b99bce92",
                                                "text": "Far from learning from the failures of ‘economic rationalism,’ the Liberals want us to swallow more of the snake oil medicine while diverting our attention to the consumption tax sideshow."
                                            },
                                            {
                                                "example_id": "87698d54-242c-43f8-aed0-616c22f88bf3",
                                                "sense_id": "8d2fcafe-62b7-3d32-a60c-c439b99bce92",
                                                "text": "Even the reality shows focused on addiction, like “Intervention,” “Rehab With Dr. Drew” (thankfully canceled) or that show where people have bizarre addictions like eating chalk or scouring powder, have done almost nothing to educate Americans. All they’ve really achieved is keeping addiction an oddity, a sideshow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1eb04b77-3fb3-329c-abcf-3dd4d433e6bf",
                                        "entry_id": "bfe813fb-7bd5-3f7f-b468-94839b710874",
                                        "glosses": [
                                            "An incident in which drivers block traffic to perform stunts like donuts and burnouts for an extended period of time."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd386493-a64c-47f1-9da1-62d63c0fa690",
                                                "sense_id": "1eb04b77-3fb3-329c-abcf-3dd4d433e6bf",
                                                "text": "The spontaneous street party is the center of Oakland's recently developing Hyphy culture, but has a long history in Oakland car culture and hip hop. A sideshow is essentially a spontaneous street party in which one might “ghostride the whip” (get out while driving), “gas brake dip,” or even “scrape” (spin donuts in the middle of the street)."
                                            },
                                            {
                                                "example_id": "d5c97609-b4f2-4d31-8210-48f22d293352",
                                                "sense_id": "1eb04b77-3fb3-329c-abcf-3dd4d433e6bf",
                                                "text": "During their patrol, the Officers found an approximately twenty-car sideshow taking place in the Santa Fe Springs Swap Meet parking lot."
                                            },
                                            {
                                                "example_id": "f554c59d-1ac0-4c59-8bf6-92576435b5ad",
                                                "sense_id": "1eb04b77-3fb3-329c-abcf-3dd4d433e6bf",
                                                "text": "Gov. Gavin Newsom of California signed a law in October threatening a six-month suspension of a driver’s license for participating in a sideshow, even as a spectator."
                                            },
                                            {
                                                "example_id": "ef8a9aeb-f6c3-48a9-bf0b-2660b177946b",
                                                "sense_id": "1eb04b77-3fb3-329c-abcf-3dd4d433e6bf",
                                                "text": "But a bodega owner in the area said that crime seemed to be rising, and that at night, the neighborhood became a backdrop for drug use and occasional sideshows."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
