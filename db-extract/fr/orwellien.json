                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "1984-ish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e0f39f3-ff80-32f1-bc58-a5eb8acfeaba",
                                        "entry_id": "572dd6b3-092e-3908-9e57-32febd19fc54",
                                        "glosses": [
                                            "Resembling or pertaining to a totalitarian society, especially one characterised by intensive surveillance of the population."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c39e597-4cfb-40c2-bfe6-bfcbba3e2dd0",
                                                "sense_id": "8e0f39f3-ff80-32f1-bc58-a5eb8acfeaba",
                                                "text": "I have no idea what this 1984-ish-sounding organization actually does, though I suspect it has something to do with industrial processes."
                                            },
                                            {
                                                "example_id": "9483d5b3-ae5b-46e8-be19-b0ad70f41420",
                                                "sense_id": "8e0f39f3-ff80-32f1-bc58-a5eb8acfeaba",
                                                "text": "The poems were then posted on a Library of Congress website, and high school principals were encouraged in the slightly 1984-ish task of reading them over their loud speakers each morning at the beginning of the school day."
                                            },
                                            {
                                                "example_id": "bd6a4dc7-b760-4841-ad8b-cc4789a720e9",
                                                "sense_id": "8e0f39f3-ff80-32f1-bc58-a5eb8acfeaba",
                                                "text": "A truly 1984-ish paradox. What had gone down the memory hole?"
                                            },
                                            {
                                                "example_id": "0a1ec97c-af43-48a6-916f-187b44ea5efd",
                                                "sense_id": "8e0f39f3-ff80-32f1-bc58-a5eb8acfeaba",
                                                "text": "All these technologies sound a bit ominous and 1984-ish when taken out of context."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
