                    {
                        "sense_id": "1a9765e1-41d7-3df4-a423-416362b96010",
                        "entry_id": "b9f97050-feae-3ec6-910b-391781b99438",
                        "glosses": [
                            "Genre d’insectes hyménoptères de la famille des ichneumons, particulièrement présents dans les régions tropicales, qui se nourrissent de larves de lépidoptères et de noctuelles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5affa616-2a6e-4910-b7d3-f294ee181fa4",
                                "sense_id": "1a9765e1-41d7-3df4-a423-416362b96010",
                                "text": "J’ai rencontré des cas où ce calchicide et l’anomalon étaient tous deux parasites d’une même chenille. En ce cas, l’anomalon était dévoré par les petits calchicides qui, alors, remplissaient le cocon de celui-là : un parasite dans un autre parasite !"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "c9972593-b936-3966-b56f-e95e58c15a91",
                "word": "anomalon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "33f912c6-82ff-446b-b6f6-12ff031dac8a",
                        "entry_id": "c9972593-b936-3966-b56f-e95e58c15a91",
                        "tags": [
