{
    "word_family": [
        "rise",
        "riser",
        "uprising",
        "sunrise",
        "moonrise",
        "arise"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "611f34fa-9bad-3913-9c1a-1421819ff2b5",
                    "sense_definition": "Past participle of <w>rise</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sun has <w>risen</w> above the horizon, signaling the start of a new day.",
                            "target_lang_translations": {
                                "ru": "Солнце <w>взошло</w> над горизонтом, возвещая о начале нового дня.",
                                "zh": "太阳已经在地平线上<w>升起</w>，预示着新的一天的开始。"
                            }
                        },
                        {
                            "text": "Prices have <w>risen</w> steadily over the last few months due to inflation.",
                            "target_lang_translations": {
                                "ru": "Цены неуклонно <w>росли</w> в течение последних нескольких месяцев из-за инфляции.",
                                "zh": "由于通货膨胀，过去几个月价格一直在稳步<w>上涨</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "has risen",
                        "have risen",
                        "had risen",
                        "Christ is risen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от глагола rise (подниматься, вставать, восходить).",
                        "zh": "动词 rise 的过去分词形式，表示上升、升起或增长。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднявшийся",
                                "target_lang_sense_clarification": "общий смысл: переместившийся вверх"
                            },
                            {
                                "target_lang_word": "взошедший",
                                "target_lang_sense_clarification": "о солнце или луне"
                            },
                            {
                                "target_lang_word": "выросший",
                                "target_lang_sense_clarification": "о ценах, числах или уровне"
                            },
                            {
                                "target_lang_word": "воскресший",
                                "target_lang_sense_clarification": "религиозный контекст (о Христе)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "升起",
                                "target_lang_sense_clarification": "指太阳、月亮等天体上升"
                            },
                            {
                                "target_lang_word": "上涨",
                                "target_lang_sense_clarification": "指价格、水平或数量的增加"
                            },
                            {
                                "target_lang_word": "复活",
                                "target_lang_sense_clarification": "宗教语境下指死而复生"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4490018c-2a0f-3f0d-94e1-0b378abc4b64",
                    "sense_definition": "Having moved upwards or expanded in volume, often used to describe dough that is ready for baking.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baker gently placed the <w>risen</w> dough into the hot oven.",
                            "target_lang_translations": {
                                "ru": "Пекарь осторожно поместил <w>подошедшее</w> тесто в горячую печь.",
                                "zh": "面包师小心地把<w>发酵好</w>的面团放进热烤箱里。"
                            }
                        },
                        {
                            "text": "We could smell the aroma of newly <w>risen</w> bread throughout the house.",
                            "target_lang_translations": {
                                "ru": "Мы чувствовали аромат только что <w>поднявшегося</w> хлеба по всему дому.",
                                "zh": "我们闻到了满屋子刚<w>发酵好</w>的面包香气。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ascended",
                        "elevated"
                    ],
                    "antonyms": [
                        "fallen"
                    ],
                    "common_phrases": [
                        "newly risen",
                        "risen dough",
                        "risen bread"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поднявшийся или увеличившийся в объеме; часто используется для описания теста, готового к выпечке.",
                        "zh": "指体积增大或膨胀，常用于描述发酵后准备烘焙的面团。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подошедший",
                                "target_lang_sense_clarification": "кулинарный термин: о тесте"
                            },
                            {
                                "target_lang_word": "поднявшийся",
                                "target_lang_sense_clarification": "увеличившийся в объеме"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发酵好",
                                "target_lang_sense_clarification": "指面团经过发酵体积增大"
                            },
                            {
                                "target_lang_word": "膨胀",
                                "target_lang_sense_clarification": "指物体体积变大"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b88d7ebd-9022-3655-93b8-28406954acfc",
                    "sense_definition": "A surname of German origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Risen</w> has lived in this neighborhood for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Ризен</w> живет в этом районе уже более двадцати лет.",
                                "zh": "<w>里森</w>先生在这个社区已经住了二十多年了。"
                            }
                        },
                        {
                            "text": "I have an appointment with Dr. <w>Risen</w> at three o'clock.",
                            "target_lang_translations": {
                                "ru": "У меня назначена встреча с доктором <w>Ризеном</w> в три часа.",
                                "zh": "我三点钟和<w>里森</w>医生有个预约。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "German origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия немецкого происхождения.",
                        "zh": "源自德语的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ризен",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "里森",
                                "target_lang_sense_clarification": "姓氏译名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}