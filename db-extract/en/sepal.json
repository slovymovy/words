    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8ee06357-ce58-315c-82ee-0a7128584ffc",
                "word": "sepal",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1a1d18b4-3b65-4817-89eb-df547f40c082",
                        "entry_id": "8ee06357-ce58-315c-82ee-0a7128584ffc",
                        "tags": [
                            "plural"
                        ],
                        "form": "sepals"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4b8bf014-4958-3fe2-878d-28d574c60bfd",
                        "entry_id": "8ee06357-ce58-315c-82ee-0a7128584ffc",
                        "glosses": [
                            "One of the component parts of the calyx, particularly when such components are not fused into a single structure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81c849e3-b436-4cb5-ab4a-ad76d37ca889",
                                "sense_id": "4b8bf014-4958-3fe2-878d-28d574c60bfd",
                                "text": "1836, The Family Magazine, Or Monthly Abstract of General Knowledge, Volume III, Redfield & Lindsay, page 367,\nWhen the sepals are distinct, or separate from each other, the calyx is said to be polysepalous."
                            },
                            {
                                "example_id": "5b6c2417-2fe1-4d28-87c8-bae1d23e9d0e",
                                "sense_id": "4b8bf014-4958-3fe2-878d-28d574c60bfd",
                                "text": "The sepal and the petal are essentially leaf-like in form and anatomy but generally simpler in detailed structure than a foliage leaf."
                            },
                            {
                                "example_id": "28817359-0f7a-4220-b392-4b7249db07db",
                                "sense_id": "4b8bf014-4958-3fe2-878d-28d574c60bfd",
                                "text": "In tomato, for example, the first sepal primordium is formed as an outgrowth at the periphery of the apex and the subsequent sepal primordia are initiated in a helical fashion at an angle of approximately 137° from the previous one."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6638a9c-fea9-452a-9110-4d018c64364c",
                        "source_entry_id": "8ee06357-ce58-315c-82ee-0a7128584ffc",
                        "source_sense_id": "4b8bf014-4958-3fe2-878d-28d574c60bfd",
                        "source_sense_description": "part of calyx",
                        "target_lang_word": "kelkblad",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kelkblad",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b19babea-89aa-3c56-93b7-b673b4b62a95",
                                        "entry_id": "93aa8448-04a5-39ae-8fde-5f437560c966",
                                        "glosses": [
                                            "de (meestal groene) bladeren van de buitenste krans van de bloem die ingeplant staan op de bloembodem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0381b959-a114-48a2-9152-5311d626e919",
                                                "sense_id": "b19babea-89aa-3c56-93b7-b673b4b62a95",
                                                "text": "Spaanse missionarissen ontdekten de passiebloem in Zuid-Amerika. De kelkbladenen kroonbladen stonden in hun ogen symbool voor apostelen, andere delen van de bloem verwezen naar het lijden van Christus. In het Amazonegebied zijn zowat vierhonderd soorten passiebloemen te vinden."
                                            },
                                            {
                                                "example_id": "a0d620ff-05db-42be-8272-7ae5650ec20a",
                                                "sense_id": "b19babea-89aa-3c56-93b7-b673b4b62a95",
                                                "text": "Hun vorm is zo dat je ze kunt opvouwen tot een gekruld kelkblad."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb2c4a90-bc4a-47e6-a802-9ecf17a4899e",
                        "source_entry_id": "8ee06357-ce58-315c-82ee-0a7128584ffc",
