                                    {
                                        "sense_id": "2fec52b7-0766-3792-8148-247367822eff",
                                        "entry_id": "ca51fd94-e416-3488-b9ca-7cdca1866d9b",
                                        "glosses": [
                                            "die Jakobiner betreffend, sich auf die Jakobiner beziehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bad08a7-7a3f-4267-94b1-d89bfe57c87c",
                                                "sense_id": "2fec52b7-0766-3792-8148-247367822eff",
                                                "text": "„Im Sommer 1794 wurden zu den Höchstpreisen auch Höchstlöhne eingeführt, weshalb sich auch das Interesse der Sansculotten an der jakobinischen Politik verringerte.“"
