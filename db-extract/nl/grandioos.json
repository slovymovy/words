                                    {
                                        "sense_id": "75fc72b0-4571-3f3b-9f9d-781436b148a1",
                                        "entry_id": "a5fbb017-5641-30f7-b8d3-709338129d42",
                                        "glosses": [
                                            "A thousand RPM."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54ca23aa-f574-4211-b511-a51d0f698bd6",
                                                "sense_id": "75fc72b0-4571-3f3b-9f9d-781436b148a1",
                                                "text": "One grand, two grand RPM"
                                            },
                                            {
                                                "example_id": "cb7d5fff-d7ab-4430-8c1b-c3b9a4588683",
                                                "sense_id": "75fc72b0-4571-3f3b-9f9d-781436b148a1",
                                                "text": "The engine, with more compression, carburetion, and cam timing than the Ambassador, could lounge comfortably below four grand and then rush to 7500 rpm, aided and abetted by a light flywheel and a close-ratio five-speed box."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc98474f-ff86-31e9-8a43-147069267c76",
                                        "entry_id": "a5fbb017-5641-30f7-b8d3-709338129d42",
                                        "glosses": [
                                            "A grand piano"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "grand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8c0a9bb-465b-3ddd-b823-493fda12cc66",
                                        "entry_id": "e0cbb5c7-dd00-300d-8551-a3225153310e",
                                        "glosses": [
                                            "A grandparent or grandchild."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad0b8060-298c-4665-a773-24c98c502a29",
                                                "sense_id": "b8c0a9bb-465b-3ddd-b823-493fda12cc66",
                                                "text": "Once, in Maryland, he met four families of slaves who had all been together for a hundred years: great-grands, grands, mothers, fathers, aunts, uncles, cousins, children."
                                            },
                                            {
                                                "example_id": "35c0b42a-d2bc-4e96-896b-194784e36592",
                                                "sense_id": "b8c0a9bb-465b-3ddd-b823-493fda12cc66",
                                                "text": "Her granddaughter and great-granddaughter went with us as chaperones. Did I ever tell you that she had six grands and two great-grands? […] And Emily agrees with me it's a shame that I don't even have a grand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
