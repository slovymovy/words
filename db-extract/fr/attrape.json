        "fr-extract.jsonl": [
            {
                "entry_id": "5ada64fb-eeed-3936-8305-e6348f78f95c",
                "word": "attrape",
                "pos": "intj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "27e0a353-e3d3-339b-8526-cf47499573c7",
                        "entry_id": "5ada64fb-eeed-3936-8305-e6348f78f95c",
                        "glosses": [
                            "Exclamation exprimée pour approuver la justesse d’un reproche qui vient d'être adressé à quelqu’un."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0878ee80-105e-4e33-9a6a-18d529e106af",
                                "sense_id": "27e0a353-e3d3-339b-8526-cf47499573c7",
                                "text": "Ayant ainsi parlé, elle murmura :\n– Attrape, la grande Hortense !"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "adf77ed1-65e6-39ea-bfed-3340cf3238b2",
                "word": "attrape",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5b21eb9a-8171-42ea-b6cf-29b94876421c",
                        "entry_id": "adf77ed1-65e6-39ea-bfed-3340cf3238b2",
                        "tags": [
                            "plural"
