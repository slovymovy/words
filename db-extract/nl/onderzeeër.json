                                            {
                                                "example_id": "2b618dc4-5d82-482b-a215-88b1fbdf452a",
                                                "sense_id": "3343b1b2-fff2-3055-8acf-9a4cb61b31c4",
                                                "text": "a submarine patent"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a7ec44e-0de6-3c4a-a704-4bd145d8bbd3",
                                        "entry_id": "0928731b-b5c8-3229-b36f-80a12ff62ec6",
                                        "glosses": [
                                            "Of a pitch, thrown with the hand lower than the elbow."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "414e3332-c086-429b-bd8a-4856b44d1a58",
                                                "sense_id": "4a7ec44e-0de6-3c4a-a704-4bd145d8bbd3",
                                                "text": "When Peterson saw the unusual pitching motion of Kent Tekulve—the submarine pitcher who threw baseballs as though they were coming right out of the rubber slab on the mound—he was the first of many who tried to change Tekulve's delivery."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "submarine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "733a7e84-c1ad-377f-862d-2f1d3beb7cf1",
                                        "entry_id": "e2b6d325-f091-36a8-b74f-e7c98ed2100d",
