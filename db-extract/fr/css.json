                            {
                                "target_word": "CSS",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b475ace0-c583-32a0-a942-b9d144e86adc",
                                        "entry_id": "9a75ea2d-a85a-3086-be37-c0cec26ab4a4",
                                        "glosses": [
                                            "Initialism of can't see shit."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07e3eb16-4e7c-4f41-a3de-6df36885160a",
                                                "sense_id": "b475ace0-c583-32a0-a942-b9d144e86adc",
                                                "text": "“I don't know. I just don't know. What is it? I suffer from CSS—that's Can't See Shit—but I don't think I could hold a cane in my hand.”"
                                            },
                                            {
                                                "example_id": "6aba20af-9aa0-48a7-9d95-214e29b8c055",
                                                "sense_id": "b475ace0-c583-32a0-a942-b9d144e86adc",
                                                "text": "Lake Michigan was out there, but invisible. We could see nothing around us but fog.\n“A CSS day,” Jeff said.\n“What's that?”\n“Can't see shit.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
