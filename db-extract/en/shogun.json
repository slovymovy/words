                    }
                ],
                "senses": [
                    {
                        "sense_id": "609392e2-f73a-3313-b844-147ce99e452a",
                        "entry_id": "099bf479-e0f1-3261-9e0c-726056835868",
                        "glosses": [
                            "The supreme generalissimo of feudal Japan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e78931d-7b1b-4304-9be5-0e8f8c3d9aca",
                                "sense_id": "609392e2-f73a-3313-b844-147ce99e452a",
                                "text": "The third is the Shogun who reygneth at the preſent, and hath rayſed the perſecution (whereof this booke intreateth) againſt the Chriſtians, and he as it ſeemeth is acknowledged as Lord of all the threeſcore and ſix Kingdomes of Iaponia."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4494e002-bdd4-48bb-9338-a591d73bae75",
                        "source_entry_id": "099bf479-e0f1-3261-9e0c-726056835868",
                        "source_sense_id": "609392e2-f73a-3313-b844-147ce99e452a",
                        "source_sense_description": "supreme generalissimo of feudal Japan",
                        "target_lang_word": "šógun",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ea79402c-4460-4425-895d-f8b9d1c21cdc",
                        "source_entry_id": "099bf479-e0f1-3261-9e0c-726056835868",
                        "source_sense_id": "609392e2-f73a-3313-b844-147ce99e452a",
                        "source_sense_description": "supreme generalissimo of feudal Japan",
                        "target_lang_word": "shogun",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shogun",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac3988fc-756b-3abc-aa22-9bce3025aad8",
                                        "entry_id": "e647890a-ea32-36da-92f9-504ce4f00cd7",
                                        "glosses": [
                                            "Chef militaire et civil du Japon, à partir de 1192 jusqu’en 1868, le commandement du pays restant à la charge de l’empereur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b378a78e-14c0-4fc0-a7db-a5e685dcd7d8",
                                                "sense_id": "ac3988fc-756b-3abc-aa22-9bce3025aad8",
                                                "text": "Un de ses descendants, Sujin (97-30 av. J.-C.), s’occupa le premier du développement de l’agriculture et constitua un rudiment de marine. Il eut quelques relations avec la Corée et divisa l’empire, encore fort mal équilibré, en quatre commandements militaires, à la tête desquels il placa un shogun."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01cc9ad9-5629-4a5d-85aa-0b6446159112",
                        "source_entry_id": "099bf479-e0f1-3261-9e0c-726056835868",
                        "source_sense_id": "609392e2-f73a-3313-b844-147ce99e452a",
                        "source_sense_description": "supreme generalissimo of feudal Japan",
                        "target_lang_word": "Feldherr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feldherr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c39f8714-26eb-3282-8325-b9fb3d019aa7",
                                        "entry_id": "9d2f93fb-53a4-38aa-92c5-4091a23d86d6",
                                        "glosses": [
                                            "Person, die den Oberbefehl über eine kämpfende Truppe führt"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e07993d6-7baf-40ea-9971-aa955bc2f345",
                                                "sense_id": "c39f8714-26eb-3282-8325-b9fb3d019aa7",
                                                "text": "„Noch drei Jahrzehnte müssen vergehen, bis der römische Feldherr Gaius Julius Caesar die rechtsrheinischen Völker endlich zum ersten Mal »Germanen« nennt und klar von den linksrheinischen Kelten unterscheidet.“"
                                            },
                                            {
                                                "example_id": "b0ba03b6-7684-4b64-8ffc-6a94487aefbc",
                                                "sense_id": "c39f8714-26eb-3282-8325-b9fb3d019aa7",
                                                "text": "„Große Feldherren und Baumeister waren die Herrscher aus dem Geschlecht der Ramsiden.“"
                                            },
                                            {
                                                "example_id": "8aca9c84-6101-438c-967d-3c851464f668",
                                                "sense_id": "c39f8714-26eb-3282-8325-b9fb3d019aa7",
                                                "text": "„Wir erreichen die Altstadt, steuern auf den Platz zu, wo das Denkmal für den Feldherrn Kleber steht, und schauen zu ihm herauf.“"
                                            },
                                            {
                                                "example_id": "daa5bdff-ecd1-49a2-97bd-33c61137c708",
                                                "sense_id": "c39f8714-26eb-3282-8325-b9fb3d019aa7",
                                                "text": "„So glauben wir denn, daß ohne Kühnheit kein ausgezeichneter Feldherr zu denken ist, d. h. daß ein solcher nie aus einem Menschen werden kann, dem diese Kraft des Gemütes nicht angeboren ist, die wir also als die erste Bedingung einer solchen Laufbahn ansehen.“"
                                            },
                                            {
                                                "example_id": "4d217122-0b6d-4296-b3ae-9e0ed6737cec",
                                                "sense_id": "c39f8714-26eb-3282-8325-b9fb3d019aa7",
                                                "text": "„Er hatte zuvor den amerikanischen Unabhängigkeitskrieg verloren und wollte nicht in Indien noch einmal als Feldherr versagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9aa2105e-a0b8-418e-b4e0-67d78384d068",
                        "source_entry_id": "099bf479-e0f1-3261-9e0c-726056835868",
