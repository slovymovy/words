                                        "sense_id": "d8a5d68b-45a4-3cb6-bb5f-0ce1972ec2cf",
                                        "entry_id": "76731f66-98c3-3178-859a-bfcf4289991b",
                                        "glosses": [
                                            "An expert who judges the manuscript of an article or book to decide if it should be published."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
