                    {
                        "sense_id": "40caa01a-a822-31e7-9ccd-cddade17e726",
                        "entry_id": "2a43d176-19f9-30b3-bf9d-fe6788c22df3",
                        "glosses": [
                            "sechzig Male"
                        ],
                        "tags": [
                            "bestimmtes Wiederholungszahlwort (Angabe",
