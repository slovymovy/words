                    }
                ],
                "translations": [
                    {
                        "translation_id": "96628711-940e-44db-ab4a-28b7d17c4224",
                        "source_entry_id": "25b4e460-8e69-38dc-9e1d-9f4a05489398",
                        "source_sense_id": "eae56a42-082e-3363-a0ee-352619b952c6",
                        "source_sense_description": "Gladiator",
                        "target_lang_word": "Gladiator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gladiator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90272c0c-93d6-3b48-a50c-378eaedaa0b8",
                                        "entry_id": "cb572621-122d-39f5-9344-cfd12d9ecc97",
                                        "glosses": [
                                            "Schaukämpfer im antiken Rom"
                                        ],
                                        "tags": [
                                            "Antike"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d13d5e7-7ebd-4c7b-a955-34393d52e9b3",
                                                "sense_id": "90272c0c-93d6-3b48-a50c-378eaedaa0b8",
                                                "text": "Die Gladiatoren kämpften um Leben und Tod."
                                            },
                                            {
                                                "example_id": "d3c40035-b6e7-4be3-9746-40a4d6aebbc5",
                                                "sense_id": "90272c0c-93d6-3b48-a50c-378eaedaa0b8",
                                                "text": "„Der Kleine blickt kurz auf, bedankt sich und reißt einem Gladiator den Arm aus.“"
                                            },
                                            {
                                                "example_id": "942d082c-b665-41ef-bf38-07730dbdaa8d",
                                                "sense_id": "90272c0c-93d6-3b48-a50c-378eaedaa0b8",
                                                "text": "„Langsam fuhren wir an den muskelbepackten Gladiatoren vorbei.“"
                                            },
                                            {
                                                "example_id": "377ac760-0efb-488b-b86f-6461d5b2d9b5",
                                                "sense_id": "90272c0c-93d6-3b48-a50c-378eaedaa0b8",
                                                "text": "„Bei diesen Worten lasse ich sie mich beschimpfen, soviel sie will, halte sie im Rücken fest und trage den vollständigsten Sieg davon, den jemals ein gewandter Gladiator davongetragen hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
