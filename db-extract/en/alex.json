                "senses": [
                    {
                        "sense_id": "dccfa09d-5b58-39a9-9b01-352dfdf0ce66",
                        "entry_id": "f1647476-4320-3947-a51c-174f83f0115d",
                        "glosses": [
                            "A unisex given name from Ancient Greek."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9724ccf-face-462b-8011-5affbf79b7d7",
                                "sense_id": "dccfa09d-5b58-39a9-9b01-352dfdf0ce66",
                                "text": "Martin was pretty dull as names went but 'Alex Blake' had a certain dash to it. His publishers hadn't considered Martin's own name to be 'punchy' enough. The pseudonym Alex Blake was chosen after much deliberation, most of which excluded Martin. 'A strong, no-nonsense sort of name', his editor said, 'to compensate'. For what, she didn't say."
                            },
                            {
                                "example_id": "46d1fb3e-a916-4a48-85f7-830f4cd9b8a9",
                                "sense_id": "dccfa09d-5b58-39a9-9b01-352dfdf0ce66",
                                "text": "'I had a Christmas card from someone calling herself Alex the year before last,' Daniel said. 'I couldn't think who it was.'\n'Oh, yes, she's changed again,' Alice said. 'I never got used to Alexandra, either. It never occurred to me that Sandra was short for Alexandra - anyway, she's Sandra on her birth certificate.'"
                            },
                            {
                                "example_id": "7c0e758a-f893-4804-b1a9-83463a133d61",
                                "sense_id": "dccfa09d-5b58-39a9-9b01-352dfdf0ce66",
                                "text": "CEO and cofounder Alex Karp distanced Palantir from other Silicon Valley technology companies in a letter included in the filing, writing that “we seem to share fewer and fewer of the technology sector’s values and commitments.”"
                            }
                        ]
                    }
                ],
