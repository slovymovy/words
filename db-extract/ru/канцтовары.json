                        "sense_id": "0be71ef5-2ff4-3851-800d-e701d0c6a066",
                        "entry_id": "4045b5e9-feb3-3c15-9947-cbbed7ee6eaf",
                        "glosses": [
                            "сокр. от канцелярские товары"
                        ],
                        "tags": [
                            "abbreviation"
                        ],
                        "examples": [
                            {
                                "example_id": "4efdad3b-dfcf-4e44-8859-ff128af46e8c",
                                "sense_id": "0be71ef5-2ff4-3851-800d-e701d0c6a066",
                                "text": "На покупку канцтоваров выдано под отчёт 20 рублей."
                            },
                            {
                                "example_id": "c1f6d541-6076-4ec1-8635-eb5df6cfc749",
                                "sense_id": "0be71ef5-2ff4-3851-800d-e701d0c6a066",
                                "text": "Зайди в магазин кацтоваров и купи скрепок, карандашей, ручек и писчей бумаги."
                            },
                            {
                                "example_id": "eebc63dc-b419-469a-9a3d-731d3798402e",
                                "sense_id": "0be71ef5-2ff4-3851-800d-e701d0c6a066",
                                "text": "У нас есть импортные канцтовары из разных стран мира."
                            }
                        ]
                    }
