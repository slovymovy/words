                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij schreef een romantisch <w>gedicht</w> voor zijn vriendin.",
                            "target_lang_translations": {
                                "en": "He wrote a romantic <w>poem</w> for his girlfriend.",
                                "ru": "Он написал романтическое <w>стихотворение</w> для своей девушки.",
                                "pl": "Napisał romantyczny <w>wiersz</w> dla swojej dziewczyny.",
                                "de": "Er schrieb ein romantisches <w>Gedicht</w> für seine Freundin.",
                                "fr": "Il a écrit un <w>poème</w> romantique pour sa petite amie.",
                                "it": "Ha scritto una romantica <w>poesia</w> per la sua ragazza.",
                                "cs": "Napsal pro svou přítelkyni romantickou <w>báseň</w>.",
