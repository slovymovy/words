{
    "word_family": [
        "leed",
        "beklagen",
        "jammer"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ffbf5f25-d15b-3f8a-8c36-98cb273e4d3c",
                    "sense_definition": "op een manier die spijtig of jammer is",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "spijt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hebben er alles aan gedaan, maar het is <w>helaas</w> niet gelukt.",
                            "target_lang_translations": {
                                "en": "We did everything we could, but <w>unfortunately</w> it didn't work out."
                            }
                        },
                        {
                            "text": "Ik kan vanavond <w>helaas</w> niet mee gaan eten naar het restaurant.",
                            "target_lang_translations": {
                                "en": "I <w>unfortunately</w> can't join you for dinner at the restaurant tonight."
                            }
                        }
                    ],
                    "synonyms": [
                        "jammer genoeg",
                        "spijtig genoeg"
                    ],
                    "antonyms": [
                        "gelukkig"
                    ],
                    "common_phrases": [
                        "helaas niet gelukt",
                        "helaas geen nieuws"
                    ],
                    "target_lang_definitions": {
                        "en": "in a way that is regrettable or unfortunate"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unfortunately",
                                "target_lang_sense_clarification": "used to say that something is regrettable"
                            },
                            {
                                "target_lang_word": "regrettably",
                                "target_lang_sense_clarification": "used to express that a situation is disappointing"
                            },
                            {
                                "target_lang_word": "sadly",
                                "target_lang_sense_clarification": "used to express sorrow or regret about a fact"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "e3cfbf8a-e1f6-3001-bfc9-73e9720b496c",
                    "sense_definition": "een uitroep om spijt, teleurstelling of verdriet uit te drukken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "spijt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Helaas</w>, zo werkt dat kennelijk niet in de praktijk.",
                            "target_lang_translations": {
                                "en": "<w>Alas</w>, that is apparently not how it works in practice."
                            }
                        },
                        {
                            "text": "Ik wilde graag komen, maar <w>helaas</w>, ik moet werken.",
                            "target_lang_translations": {
                                "en": "I would have liked to come, but <w>unfortunately</w>, I have to work."
                            }
                        }
                    ],
                    "synonyms": [
                        "jammer",
                        "helaas pindakaas"
                    ],
                    "common_phrases": [
                        "maar helaas"
                    ],
                    "target_lang_definitions": {
                        "en": "an exclamation used to express regret, disappointment, or sorrow"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "alas",
                                "target_lang_sense_clarification": "a formal or literary exclamation of grief or regret"
                            },
                            {
                                "target_lang_word": "unfortunately",
                                "target_lang_sense_clarification": "used as an exclamation to express disappointment"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}