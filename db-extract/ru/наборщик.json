                                "target_word": "compositeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7e1f5758-77c3-3b1b-941c-6c5d3965a58b",
                                        "entry_id": "66d82575-4bcd-3bd0-baeb-d30a83069788",
                                        "glosses": [
                                            "Celui qui compose en musique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00f6e25a-15c4-490d-9b06-0b3339acca61",
                                                "sense_id": "7e1f5758-77c3-3b1b-941c-6c5d3965a58b",
                                                "text": "Avec Sophie Belloir, mezzo-soprano ; Maël Fauvy, guitariste et compositeur, et Chani Stroobant, violoniste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b07ce173-1190-3fd0-9218-a9c3cb6d00d5",
                                        "entry_id": "66d82575-4bcd-3bd0-baeb-d30a83069788",
                                        "glosses": [
                                            "Auteur d’une œuvre artistique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26f87afb-ea6d-3410-844f-c1eb3489cb33",
                                        "entry_id": "66d82575-4bcd-3bd0-baeb-d30a83069788",
                                        "glosses": [
                                            "Personne qui assemble, qui arrange les caractères pour en former des mots, des lignes et des pages."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5400a1c9-0bd2-4e6b-aa9a-412abb240245",
                                                "sense_id": "26f87afb-ea6d-3410-844f-c1eb3489cb33",
                                                "text": "La justification prise, le compositeur prend une galée ou in-fol. ou in-4° ou in-8°. suivant le format de l'ouvrage sur lequel il va travailler , & la place sur les petites capitales de sa casse de romain."
                                            },
                                            {
                                                "example_id": "df59bb48-14a1-4e95-bd01-d318535f67b2",
                                                "sense_id": "26f87afb-ea6d-3410-844f-c1eb3489cb33",
                                                "text": "Le compositeur particulièrement désigné comme homme de conscience doit être excellent ouvrier, minutieux, et d'une conduite régulière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc98b1c9-cde5-312f-82c8-65b6a4aa628f",
                                        "entry_id": "66d82575-4bcd-3bd0-baeb-d30a83069788",
                                        "glosses": [
                                            "Logiciel intégré à un gestionnaire de fenêtres pour réaliser des effets visuels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "964db921-d873-40e2-807f-4a3be693da57",
                                                "sense_id": "dc98b1c9-cde5-312f-82c8-65b6a4aa628f",
                                                "text": "Cette méthode permet d’indiquer au compositeur quelle partie de la surface a évolué. Dans vos applications essayez, au moins un petit peu, d’optimiser vos rendus !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
