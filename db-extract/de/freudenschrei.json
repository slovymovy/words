                    {
                        "sense_id": "9e3193ba-a6be-3f22-af9a-2821e804b4dd",
                        "entry_id": "a490ca5e-4696-37c2-bf0e-b5f60d566901",
                        "glosses": [
                            "Schrei, der vor lauter Freude ausgestoßen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46983b80-ed8c-4b24-9dae-cebb348a36f4",
                                "sense_id": "9e3193ba-a6be-3f22-af9a-2821e804b4dd",
                                "text": "„Von allen Seiten hörte er die Freudenschreie seiner Gefährten.“"
                            },
                            {
                                "example_id": "dffcb1bf-eccc-4164-b1f9-651406e5490d",
                                "sense_id": "9e3193ba-a6be-3f22-af9a-2821e804b4dd",
                                "text": "„Diese aber sprang jubelnd auf und flog mit einem Freudenschrei der zu neuem Leben erwachten Mutter um den Hals.“"
                            },
                            {
                                "example_id": "d3f9ac92-9186-4774-aeda-cd2ce8eb63ba",
                                "sense_id": "9e3193ba-a6be-3f22-af9a-2821e804b4dd",
                                "text": "„Sie stieß einen spitzen Freudenschrei aus.“"
                            }
                        ],
