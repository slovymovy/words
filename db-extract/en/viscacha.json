                "word": "viscacha",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0e82f095-16ad-4102-ac94-a8b0c5e4575b",
                        "entry_id": "9f814eab-7aa5-36ed-a99c-8f1686ee3c1c",
                        "tags": [
                            "plural"
