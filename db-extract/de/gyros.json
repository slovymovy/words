                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfe7f4a0-938a-4b67-afd7-50d4fda980d1",
                                                "sense_id": "1cf385d9-9743-32c5-9453-09c0871c82fe",
                                                "text": "ο γύρος του κόσμου σε ογδόντα ημέρες"
                                            },
                                            {
                                                "example_id": "f370cd6e-eedc-4d2f-b844-dc7653b52da6",
                                                "sense_id": "1cf385d9-9743-32c5-9453-09c0871c82fe",
                                                "text": "ο γύρος του νησιού γίνεται και με καραβάκι"
                                            },
                                            {
                                                "example_id": "d0f2f0b7-de84-40c9-bd93-5a3f8f5deed5",
                                                "sense_id": "1cf385d9-9743-32c5-9453-09c0871c82fe",
                                                "text": "κάναμε το γύρο της λαϊκής, αλλά δε βρήκαμε φρέσκα κρεμμυδάκια πουθενά"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aee77ce5-b406-3465-bcd0-f3ab07b08814",
                                        "entry_id": "515b4ef1-afd1-3b7b-a38e-c97e7e717d99",
                                        "glosses": [
                                            "ολοκληρωμένη φάση μιας διαδικασίας"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9ca8e8f-d4f1-46b9-94ac-68a4eedb4c51",
                                                "sense_id": "aee77ce5-b406-3465-bcd0-f3ab07b08814",
                                                "text": "δε θα υπάρξει επόμενος γύρος συνομιλιών"
                                            },
                                            {
                                                "example_id": "17d9fe66-7d15-4f95-a681-06397e18c902",
                                                "sense_id": "aee77ce5-b406-3465-bcd0-f3ab07b08814",
                                                "text": "στον επόμενο γύρο θα περάσουν οχτώ αθλητές"
                                            },
                                            {
                                                "example_id": "b52883aa-d5f3-4382-8cbd-07fba7338ccc",
                                                "sense_id": "aee77ce5-b406-3465-bcd0-f3ab07b08814",
                                                "text": "στον πρώτο γύρο συμμετέχουν όλες οι ομάδες της πρώτης εθνικής"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d378ddc6-b9c4-339b-a348-54c544016e54",
