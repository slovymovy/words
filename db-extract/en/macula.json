                    {
                        "translation_id": "4f710831-f96a-41cf-a379-a9f878635449",
                        "source_entry_id": "06ebf507-e453-3409-94a2-a9694558cc6d",
                        "source_sense_description": "anatomy: yellow spot near the center of retina",
                        "target_lang_word": "macula",
