                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4c7e9eb-9c09-4f78-a7f6-422f7ae5e4c4",
                                                "sense_id": "e9637001-fbe1-3355-82a7-3bb8e357c2d3",
                                                "text": "„Am Nachmittag verteilten Zeitungsjungen erste Extrablätter.“"
                                            },
                                            {
                                                "example_id": "b53c5644-a5da-4f14-8156-38f7a8d03303",
                                                "sense_id": "e9637001-fbe1-3355-82a7-3bb8e357c2d3",
                                                "text": "„Draußen riefen die Zeitungsjungen die Morgennachrichten aus.“"
                                            },
                                            {
                                                "example_id": "3c25379b-90a4-49f0-b2de-c927ba7df663",
                                                "sense_id": "e9637001-fbe1-3355-82a7-3bb8e357c2d3",
                                                "text": "„An einem heißen Abend im Sommer 1953 rannte ein kleiner, sommerprossiger Zeitungsjunge namens James Bozart, was haste, was kannste, durch das Treppenhaus einer Mietskaserne im New Yorker Stadtteil Brooklyn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
