                        ],
                        "form": "egg-crates"
                    },
                    {
                        "form_id": "3a61e33a-8423-4ad3-be8b-ba0405f31e26",
                        "entry_id": "f2c2bb98-65d8-3e6c-846e-3235708f6982",
                        "tags": [
                            "participle",
                            "present"
                        ],
                        "form": "egg-crating"
                    },
                    {
                        "form_id": "b0de5ebc-5fbe-4b2d-ab2a-ad67f6b183f4",
                        "entry_id": "f2c2bb98-65d8-3e6c-846e-3235708f6982",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "egg-crated"
                    },
                    {
                        "form_id": "63d835e7-dc57-41ad-9581-4b63ebc9f8cb",
                        "entry_id": "f2c2bb98-65d8-3e6c-846e-3235708f6982",
                        "tags": [
                            "past"
                        ],
                        "form": "egg-crated"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b607d3e2-00b1-3278-b78a-265a2f692d6f",
                        "entry_id": "f2c2bb98-65d8-3e6c-846e-3235708f6982",
                        "glosses": [
                            "To put into egg crates."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d47454c5-91f2-3aac-a492-6aa26d301c40",
                        "entry_id": "f2c2bb98-65d8-3e6c-846e-3235708f6982",
                        "glosses": [
                            "To compartmentalize; to separate into isolated or self-contained groups, containers, or modules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8d03b54-2e9f-44f4-ac73-830e32f5ec69",
                                "sense_id": "d47454c5-91f2-3aac-a492-6aa26d301c40",
                                "text": "We have found that with adequate internal egg-crating, no killing agent is needed, and providing that the light is set to go out about dawn no damage due to restlessness is caused to the moths inside."
                            },
                            {
                                "example_id": "6f500719-2e63-4dc8-92a5-d3df8b6ec221",
                                "sense_id": "d47454c5-91f2-3aac-a492-6aa26d301c40",
                                "text": "Parts that are egg-crated are placed in individual cells made of cardboard sheets, like egg packaging or Christmas ornament packaging."
                            },
                            {
                                "example_id": "a075cb74-512b-49fb-8d81-047afe68bee2",
                                "sense_id": "d47454c5-91f2-3aac-a492-6aa26d301c40",
                                "text": "I'm not talking about enough templates to egg-crate the car."
                            },
                            {
                                "example_id": "45710bbb-fd2e-45e8-a576-57ceb643a199",
                                "sense_id": "d47454c5-91f2-3aac-a492-6aa26d301c40",
                                "text": "When we examine model cyberschools, however, we find that despite their innovations in technology and space utilization, they still rely on age-grading, (virtual) egg-crating, predetermined curriculum, and standardized tests."
                            }
                        ]
                    },
                    {
                        "sense_id": "139435de-79be-32b8-83b7-066bf5cb0d5a",
                        "entry_id": "f2c2bb98-65d8-3e6c-846e-3235708f6982",
                        "glosses": [
                            "To provide with a texture that is typical of an egg carton: either a lattice or having a pattern of regular depressions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a50a5e1-8e84-44b6-9b7d-c4d687363651",
                                "sense_id": "139435de-79be-32b8-83b7-066bf5cb0d5a",
                                "text": "This extension allows you to egg-crate any geometry."
                            }
                        ]
                    },
                    {
                        "sense_id": "fce2401c-eb3f-3027-9e8b-e982c3e70d08",
                        "entry_id": "f2c2bb98-65d8-3e6c-846e-3235708f6982",
                        "glosses": [
                            "To attach two surfaces together using multiple points of attachment in a lattice pattern, often in order to provide strength while minimizing weight."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc6ccb00-19bc-442e-9ba5-0c3946735d55",
                                "sense_id": "fce2401c-eb3f-3027-9e8b-e982c3e70d08",
                                "text": "The hulls are four-compartment vessels with thwartships framing, longitudinally braced, with continuous engineroom girders, \"egg-crated\" into transverse floors."
                            },
                            {
                                "example_id": "82d52ca2-1c2e-46d6-85a4-ee0668311831",
                                "sense_id": "fce2401c-eb3f-3027-9e8b-e982c3e70d08",
                                "text": "The inner bottom of the ship is \"egg-crated\" with transverse floors at every frame, and is enormously strong."
                            },
                            {
                                "example_id": "78e790d8-6bb7-4ea3-8704-b86e1795c29c",
                                "sense_id": "fce2401c-eb3f-3027-9e8b-e982c3e70d08",
                                "text": "While most builders assemble a bottom-support system using plywood stringers and floors egg-crated together, then glassed into the hull, Thunderbird has switched to a molded-fiberglass grid for most of its FASTECH hulls."
                            },
                            {
                                "example_id": "5774149b-77ac-45d5-b74d-1a5b6dbc12d8",
                                "sense_id": "fce2401c-eb3f-3027-9e8b-e982c3e70d08",
                                "text": "Egg-crating can also be used to support metal molds where the thickness of the metal has been reduced to improve weight savings and costs."
                            },
                            {
                                "example_id": "a15991b6-0560-4e90-855f-0a18058dbbbe",
                                "sense_id": "fce2401c-eb3f-3027-9e8b-e982c3e70d08",
                                "text": "But three boards cannot be “egg-crated” together without cutting some conductors, thereby necessitating pigtail or wire bond connections."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f870fce-8afe-3fc0-befe-4946c0d5a3fa",
                        "entry_id": "f2c2bb98-65d8-3e6c-846e-3235708f6982",
                        "glosses": [
                            "To equip with an egg crate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94ba1fe1-4bed-491a-b2e6-3b7902532f75",
                                "sense_id": "8f870fce-8afe-3fc0-befe-4946c0d5a3fa",
                                "text": "Front- and backlights are egg-crated Chimera Lightbanks."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c9165eb-2feb-375e-9775-f09616c1f236",
                        "entry_id": "f2c2bb98-65d8-3e6c-846e-3235708f6982",
                        "glosses": [
                            "To display multiple images on a single screen separated by sharp edges."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
