                        "entry_id": "e8265c86-1488-37ec-b493-293db8b899d6",
                        "glosses": [
                            "Lycopersicon esculentum (var. cerasiforme) een trostomaat zo groot als een kers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ec506c3-ff9c-4ba8-a0c9-88005a526618",
                                "sense_id": "cd9ad123-5ca0-38ba-94ec-65f453268067",
                                "text": "Hij vindt kerstomaten erg lekker om te eten."
                            },
                            {
                                "example_id": "b4129347-bc77-44a8-9f0f-2dcc19854aad",
                                "sense_id": "cd9ad123-5ca0-38ba-94ec-65f453268067",
                                "text": "\"Hennep is ongeveer net zo gevaarlijk als een kerstomaatje. Een puur product, made in Italy\", zegt Cusani. \"Als ons product 'kerstomaatje' zou heten, zou de regering vechten voor ons.\""
                            }
                        ]
                    }
                ],
                "translations": [
