                ],
                "senses": [
                    {
                        "sense_id": "b0187594-6ab4-351e-92f5-1e02c164065a",
                        "entry_id": "80d04053-6d2b-3f02-ae4c-6c508730106b",
                        "glosses": [
                            "Action d’enlever à quelque chose ou quelqu’un son caractère sacré, de ne plus considérer cette chose ou cette personne comme sacrée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df9493e9-7d25-48cf-a136-62b4d203d44b",
                                "sense_id": "b0187594-6ab4-351e-92f5-1e02c164065a",
                                "text": "La désacralisation de Hiro Hito a été beaucoup moins traumatisante que la bombe pour le peuple japonais, malgré le culte de la personnalité dont il avait fait l’objet."
                            },
                            {
                                "example_id": "e4a1198c-36a3-4bac-ab3b-5bc014aa44c4",
                                "sense_id": "b0187594-6ab4-351e-92f5-1e02c164065a",
                                "text": "Depuis le XXᵉ siècle, nombreux ont été les chantres de la désacralisation et de la démocratisation de la lecture."
                            },
                            {
                                "example_id": "ce44db91-85e2-4cbc-aa17-1963698d1060",
                                "sense_id": "b0187594-6ab4-351e-92f5-1e02c164065a",
                                "text": "A tout bien considérer, la thèse de la désacralisation du monde paraît bien être une généralisation hâtive inspirée par une idéologie du progrès en opposition avec une théorie mythique de l’ancien sacré."
                            }
                        ]
                    }
                ],
