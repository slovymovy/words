                ],
                "senses": [
                    {
                        "sense_id": "bb84529e-e877-3c6d-9bbf-1151b6ee2cd2",
                        "entry_id": "bba060f6-a170-3961-941c-6e448504aeeb",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e4d793f-c36d-4784-8a01-e848dba5d3d9",
                                "sense_id": "bb84529e-e877-3c6d-9bbf-1151b6ee2cd2",
                                "text": "Frau Eckelmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "13f79ce1-41ef-4a61-93e6-7a6f021e5809",
                                "sense_id": "bb84529e-e877-3c6d-9bbf-1151b6ee2cd2",
                                "text": "Herr Eckelmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3f2d3bbe-a4cd-4c20-8687-f34b43b056b9",
                                "sense_id": "bb84529e-e877-3c6d-9bbf-1151b6ee2cd2",
                                "text": "Die Eckelmanns kommen heute aus Thüringen."
                            },
                            {
                                "example_id": "8eaaea30-c9b4-4032-b320-8e9199dbb06c",
                                "sense_id": "bb84529e-e877-3c6d-9bbf-1151b6ee2cd2",
                                "text": "Der Eckelmann trägt nie die Schals, die die Eckelmann ihm strickt."
                            },
                            {
                                "example_id": "1409aeff-9815-42a9-96e0-1a8701238de5",
                                "sense_id": "bb84529e-e877-3c6d-9bbf-1151b6ee2cd2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Eckelmann kommt, geht der Herr Eckelmann.“"
                            },
                            {
                                "example_id": "c11c4fa1-ef1b-4e62-866f-c0267f31ef17",
                                "sense_id": "bb84529e-e877-3c6d-9bbf-1151b6ee2cd2",
                                "text": "Eckelmann kommt und geht."
                            },
                            {
                                "example_id": "1f6f2a0d-c942-4cf5-a609-08a791a26566",
                                "sense_id": "bb84529e-e877-3c6d-9bbf-1151b6ee2cd2",
                                "text": "Eckelmanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
