                                        "entry_id": "a3a4ed70-6e07-3ddb-8bfe-435ef458e863",
                                        "glosses": [
                                            "En parlant d’un organe, d’une partie d’une plante, capable de prendre, de saisir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cf47d47-caa3-4950-b7a2-a8546ba7ecd8",
                                                "sense_id": "9a23e562-85f6-325a-a1b1-2c3c5b92ec1c",
                                                "text": "La libellule a agencé un appareil préhensif d’une conformation extraordinaire."
                                            },
                                            {
                                                "example_id": "e2270b54-e735-46b1-bf85-e89a6fee6ebe",
                                                "sense_id": "9a23e562-85f6-325a-a1b1-2c3c5b92ec1c",
                                                "text": "Dans l’histoire humaine la prise sur le monde ne se définit jamais par le corps nu : la main, avec son pouce préhensif, déjà se dépasse vers l’instrument qui multiplie son pouvoir ; dès les plus anciens documents de la préhistoire, l’homme nous apparaît toujours comme armé."
                                            }
                                        ]
                                    }
