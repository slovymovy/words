{
    "word_family": [
        "humility",
        "humiliation",
        "humiliating"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6def7261-2cc4-31f2-8b42-542b47181750",
                    "sense_definition": "To cause someone to feel ashamed, embarrassed, or foolish, injuring their dignity and self-respect.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bully tried to publicly <w>humiliate</w> the new student in front of the whole class. Normally, he would never <w>humiliate</w> anyone.",
                            "target_lang_translations": {
                                "ru": "Хулиган пытался публично <w>унизить</w> нового ученика перед всем классом. Обычно он никого не <w>унижал</w>."
                            }
                        },
                        {
                            "text": "Her harsh words served to <w>humiliate</w> him during the meeting.",
                            "target_lang_translations": {
                                "ru": "Её резкие слова были призваны <w>унизить</w> его во время собрания."
                            }
                        }
                    ],
                    "synonyms": [
                        "shame",
                        "demean",
                        "mortify",
                        "embarrass",
                        "degrade"
                    ],
                    "antonyms": [
                        "honor",
                        "dignify"
                    ],
                    "common_phrases": [
                        "publicly humiliate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять кого-либо чувствовать стыд, смущение или неловкость, задевая его достоинство и самоуважение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "унижать",
                                "target_lang_sense_clarification": "задевать достоинство кого-либо (несовершенный вид)"
                            },
                            {
                                "target_lang_word": "унизить",
                                "target_lang_sense_clarification": "задеть достоинство кого-либо (совершенный вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7bdc8b6-98d9-3cce-8902-42377f1c96de",
                    "sense_definition": "To lower someone's pride, condition, or status to make them humble.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defeat served to <w>humiliate</w> the arrogant champion. You should <w>humiliate</w> yourself before expecting forgiveness.",
                            "target_lang_translations": {
                                "ru": "Поражение послужило тому, чтобы <w>укротить гордыню</w> высокомерного чемпиона. Тебе следует <w>смириться</w>, прежде чем рассчитывать на прощение."
                            }
                        },
                        {
                            "text": "The unexpected loss humbled and <w>humiliated</w> the confident leader.",
                            "target_lang_translations": {
                                "ru": "Неожиданное поражение сбило спесь и <w>унизило</w> уверенного в себе лидера."
                            }
                        }
                    ],
                    "synonyms": [
                        "abase",
                        "bring low",
                        "humble",
                        "lower"
                    ],
                    "common_phrases": [
                        "humiliate yourself"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сбивать с кого-либо спесь, умалять чью-либо гордость или статус, заставляя проявить смирение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укрощать гордыню",
                                "target_lang_sense_clarification": "принуждать к смирению"
                            },
                            {
                                "target_lang_word": "унижать",
                                "target_lang_sense_clarification": "заставлять чувствовать себя смиренным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fe89120-5e93-3f24-b79d-2ca0fc09687a",
                    "sense_definition": "To defeat an opponent overwhelmingly in a competition or conflict.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The visiting team managed to <w>humiliate</w> the home team in a one-sided victory. The champion will completely <w>humiliate</w> his opponent.",
                            "target_lang_translations": {
                                "ru": "Гостевой команде удалось <w>разгромить</w> хозяев поля в односторонней игре. Чемпион полностью <w>опозорит</w> своего оппонента."
                            }
                        },
                        {
                            "text": "A five-goal loss will completely <w>humiliate</w> the defending champions.",
                            "target_lang_translations": {
                                "ru": "Поражение с разницей в пять мячей полностью <w>разгромит</w> действующего чемпиона."
                            }
                        }
                    ],
                    "synonyms": [
                        "put to shame"
                    ],
                    "common_phrases": [
                        "completely humiliate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разгромить соперника в соревновании или конфликте с подавляющим преимуществом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разгромить",
                                "target_lang_sense_clarification": "нанести разгромное поражение"
                            },
                            {
                                "target_lang_word": "Опозорить",
                                "target_lang_sense_clarification": "заставить сокрушительно проиграть"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}