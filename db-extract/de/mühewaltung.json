                "senses": [
                    {
                        "sense_id": "5453d374-2de3-3d94-81d0-6398048dbb88",
                        "entry_id": "c6818f81-e00f-324a-80ce-7cda8c3bb3e2",
                        "glosses": [
                            "aufgewendete Arbeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdb1dd43-62f5-435c-85dd-550529ac4da9",
                                "sense_id": "5453d374-2de3-3d94-81d0-6398048dbb88",
                                "text": "„Gemäß § 35 Abs. 2 GebAG hat der Sachverständige Anspruch auf eine weitere Gebühr für Mühewaltung, wenn der Sachverständige das schriftlich erstattete Gutachten in der Verhandlung ergänzt oder er darüber wesentliche Aufklärungen oder Erläuterungen gibt; …“"
                            },
                            {
                                "example_id": "dcc04522-dc37-408c-80aa-f35069a53348",
                                "sense_id": "5453d374-2de3-3d94-81d0-6398048dbb88",
                                "text": "„Es war eine gelungene, gut vorbereitete Veranstaltung, und man kann allen dafür Verantwortlichen nur auf das Herzlichste für deren Mühewaltung danken.“"
                            },
                            {
                                "example_id": "3c49e996-821a-4d60-8ffe-fd56c3274ff9",
                                "sense_id": "5453d374-2de3-3d94-81d0-6398048dbb88",
                                "text": "„Geschuldet werden die Dienste, also die Mühewaltung des Arbeitnehmers, nicht aber die Herstellung des Akkordarbeitsstückes, zu der die Dienste führen soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
