                        "glosses": [
                            "Donner un caractère nodulaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "654b5130-ada7-43be-ae09-221205341e94",
                                "sense_id": "d61df34f-bf4a-3f8d-b487-deb1a6e6d60e",
                                "text": "La présente invention porte sur un procédé visant à nodulariser le traitement du fer ductile à l'aide d'une méthode de traitement par poche de coulée de façon à nodulariser un alliage magnésium-ferrosilicium."
                            },
                            {
                                "example_id": "4f7f9301-cdfc-4d90-8e1e-9d4df7b1bcb0",
                                "sense_id": "d61df34f-bf4a-3f8d-b487-deb1a6e6d60e",
                                "text": "Les bactéries Bradyrhizobium fixatrices de N2 nodularisent efficacement l'arachide."
                            },
                            {
                                "example_id": "f82727d2-5561-45d7-8c80-7f41fe2be2a9",
                                "sense_id": "d61df34f-bf4a-3f8d-b487-deb1a6e6d60e",
                                "text": "Procédé selon l'une quelconque des revendications 1 à 3, dans lequel le fer métallique désulfuré, est nodularisé."
                            }
                        ]
                    }
