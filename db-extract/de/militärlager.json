                ],
                "senses": [
                    {
                        "sense_id": "66d850dc-6dcb-3f24-b5b6-ff387ac3cc6c",
                        "entry_id": "fe7fcd00-a123-39e1-b9b9-40be600a1da8",
                        "glosses": [
                            "Anlage des Militärs, in der Sachen (Waffen, Fahrzeuge, …) aufbewahrt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96832a9a-3b05-4f21-89c3-5c17c63495d7",
                                "sense_id": "66d850dc-6dcb-3f24-b5b6-ff387ac3cc6c",
                                "text": "„Es war ein großes Militärlager, das mit seinen Panzern und Kriegsgeräten, seinen Baracken und Soldaten gewiß nicht an den Rand einer Oase paßte.“"
                            },
                            {
                                "example_id": "c6b9a285-0eee-4ef1-ad3d-397341a122b1",
                                "sense_id": "66d850dc-6dcb-3f24-b5b6-ff387ac3cc6c",
                                "text": "„Am Nachmittag des 25. Juni bombardierte die CIA den Exerzierplatz des größten Militärlagers in Guatemala-Stadt.“"
                            },
                            {
                                "example_id": "0e34acb8-f19f-4af6-9ee8-a7c8ab5c25b1",
                                "sense_id": "66d850dc-6dcb-3f24-b5b6-ff387ac3cc6c",
                                "text": "„Marc Aurel konnte sein Hauptquartier im Jahr 171 nach Carnuntum verlegen, ein großes Militärlager an der Donau zwischen dem heutigen Wien und Bratislava.“"
                            },
                            {
                                "example_id": "1d4e3250-d1a4-4535-98e9-e79f8419efca",
                                "sense_id": "66d850dc-6dcb-3f24-b5b6-ff387ac3cc6c",
                                "text": "„Vier Tage später wird Lumumba jedoch von Mobutu-Truppen unter logistischer Hilfe von CIA und belgischem Geheimdienst gefasst und anschließend in einem Militärlager interniert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
