                        "cross_references": [
                            {
                                "target_word": "nuthatch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41f06f55-24f6-3d06-b3ad-6e7e5645bc88",
                                        "entry_id": "0b41a2d6-e17a-321c-8b54-bb1e066508e5",
                                        "glosses": [
                                            "Any of various small passerine birds from the genus Sitta, found throughout the northern hemisphere and noted for their unusual proclivity for climbing down trees head first."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bf96e60-b06d-4aae-a702-2b9a34208907",
                                                "sense_id": "41f06f55-24f6-3d06-b3ad-6e7e5645bc88",
                                                "text": "Nuthatches have rather a habit of entering houses through open windows, probably out of curiosity; and we owed to this habit a pet nuthatch, which became extremely tame, and used to take flies from our finger."
                                            },
                                            {
                                                "example_id": "6cd0aada-ec00-4c43-8d5a-8ed970a02304",
                                                "sense_id": "41f06f55-24f6-3d06-b3ad-6e7e5645bc88",
                                                "text": "The bird was in very faded plumage with only a slight rusty wash to the underparts, and had I not heard the call, I might have mistaken it for a Pygmy Nuthatch."
                                            },
                                            {
                                                "example_id": "d892092b-c41a-4ae2-871b-7b54effbcdbf",
                                                "sense_id": "41f06f55-24f6-3d06-b3ad-6e7e5645bc88",
                                                "text": "Considered a resident bird, the red-breasted nuthatch usually winters in the coniferous forests within its breeding range."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2afc015e-761e-4ad7-83ed-d754d76ca3a4",
                        "source_entry_id": "c9dbe3f6-c26c-3d34-994f-df79a080259d",
                        "source_sense_id": "0a07f930-a360-3e72-9691-25204f0e692e",
                        "target_lang_word": "trepador azul",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "519fbf02-0917-4797-8e41-c2f994203851",
                        "source_entry_id": "c9dbe3f6-c26c-3d34-994f-df79a080259d",
                        "source_sense_id": "0a07f930-a360-3e72-9691-25204f0e692e",
                        "target_lang_word": "поползень",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "поползень",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1367f838-cd9e-30bf-86a0-6a92b644bc57",
                                        "entry_id": "49316209-d09a-373b-aa6e-70fd3f361307",
                                        "glosses": [
                                            "орнитол. небольшая птица из отряда воробьинообразных, отличающаяся манерой быстро и ловко передвигаться по стволам и ветвям деревьев, зачастую вниз головой (Sitta)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66b1ae47-e60f-41ae-ba4c-383254338d26",
                                                "sense_id": "1367f838-cd9e-30bf-86a0-6a92b644bc57",
                                                "text": "Любил он птиц, и они не боялись его; умилительно вспомнить, как, бывало, бегает поползень ― птица очень дикая ― по рыжей голове его и путается в огневых волосах."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
