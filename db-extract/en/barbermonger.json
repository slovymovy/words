                "senses": [
                    {
                        "sense_id": "b0ed782d-a71f-3ab1-9e25-53a3884df4e3",
                        "entry_id": "637f0fa5-99fd-32c1-b0b7-fde90328c6c4",
                        "glosses": [
                            "A fop; a dandy."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "5f939c07-f67a-4c05-a358-565a7720a0d0",
                                "sense_id": "b0ed782d-a71f-3ab1-9e25-53a3884df4e3",
                                "text": "Ile make a sop oth' Moonshine of you, you whoreson, Culyenly barbermonger, draw."
                            },
                            {
                                "example_id": "69eb0b97-b069-488c-ae81-5999d87227f0",
                                "sense_id": "b0ed782d-a71f-3ab1-9e25-53a3884df4e3",
                                "text": "Those who live in this century, have an invincible antipathy to every thing natural an original, and I call for nothing else in justification of this, than any girl of fifteen, and boy of twenty, within hearing of this place--only look at the paint on her cheeks, and observe his dress, the poor girl stands trembling with cold, (nothing under heavens on but a little muslin hardly decent in appearance !) and he! an unmannerly barber-monger, has all her cloths stuffed into his 'neckerchief! Ah, young man, you need not try to stick your hair up, only look in the glass, and if it don't go up itself, I'm very much mistaken."
                            }
                        ]
                    }
                ],
