                            {
                                "target_lang_word": "портить",
                                "target_lang_sense_clarification": "нарушать правильную работу"
                            },
                            {
                                "target_lang_word": "запороть",
                                "target_lang_sense_clarification": "жарг., испортить систему или код"
                            }
                        ]
