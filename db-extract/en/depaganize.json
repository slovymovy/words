                        "glosses": [
                            "To remove the pagan qualities or elements of."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d00a40a-51b9-4089-8098-9616abc45f7d",
                                "sense_id": "4b39ed4f-53ba-3968-af69-0f8a1af5dc85",
                                "text": "He was also a geographer and astronomer who tried to depaganize the heavens by introducing Biblical figures and symbols as constellations."
                            },
                            {
                                "example_id": "de923fac-d78f-4d1a-9a8e-85b0f75ba00f",
                                "sense_id": "4b39ed4f-53ba-3968-af69-0f8a1af5dc85",
                                "text": "Muhammad related Islām to Abraham considered as its religious ancestor, and by proclaiming this patriarch the founder of the Ka'ba, he was confident that he could depaganize the old Mekkan sanctuary and consecrate it to the worship of Allah."
                            },
                            {
                                "example_id": "7e444ea6-0952-4fb5-848e-792a2154e16c",
                                "sense_id": "4b39ed4f-53ba-3968-af69-0f8a1af5dc85",
                                "text": "Her prescription sought to magically depaganize the root so that it would sedate the users, not excite them."
                            }
                        ]
                    }
