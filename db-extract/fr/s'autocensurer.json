                ],
                "senses": [
                    {
                        "sense_id": "622efbfc-17a8-3930-a61b-d9f9ee8c5ead",
                        "entry_id": "54355c5e-53e1-381a-9fb0-eac652835c92",
                        "glosses": [
                            "Se censurer soi-même, par pudeur ou, préventivement, pour éviter la censure étatique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0597a48-7645-4c20-a7f8-02b2bd0c3e94",
                                "sense_id": "622efbfc-17a8-3930-a61b-d9f9ee8c5ead",
                                "text": "Les journalistes biélorusses s’autocensurent pour ne pas risquer de finir en prison."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "181e6c95-320e-40ab-9fa1-3b2e468169f3",
                        "source_entry_id": "54355c5e-53e1-381a-9fb0-eac652835c92",
                        "source_sense_id": "622efbfc-17a8-3930-a61b-d9f9ee8c5ead",
                        "target_lang_word": "self-censor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-censor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a559bba-38b6-3282-b3c9-c4c6a7cfc06b",
                                        "entry_id": "efea5997-ff8f-3a4b-93c0-95657349c0c5",
                                        "glosses": [
                                            "To censor one's own words or works; to engage in self-censorship."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c0542ca-4af6-4e08-b481-d92273e9d39e",
                                                "sense_id": "3a559bba-38b6-3282-b3c9-c4c6a7cfc06b",
                                                "text": "There's been a lot of talk recently about the problem of \"libel chill\" on British science writing, that people self-censor for fear they'd be sued (as Simon Singh was by British Chiropractic Association)."
                                            },
                                            {
                                                "example_id": "e704a9d3-94d5-487f-92ae-556c257f30c5",
                                                "sense_id": "3a559bba-38b6-3282-b3c9-c4c6a7cfc06b",
                                                "text": "An antimeme is an idea with self-censoring properties; an idea which, by its intrinsic nature, discourages or prevents people from spreading it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
