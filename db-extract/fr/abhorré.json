                ],
                "senses": [
                    {
                        "sense_id": "57d9034c-6d8a-384a-80a8-f0307c8deec8",
                        "entry_id": "74ea0668-5bfa-3fd4-a63e-d7cee1794658",
                        "glosses": [
                            "Qui est considéré comme une horreur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31f10f3c-b9c9-4cac-8316-da3dde5d22e9",
                                "sense_id": "57d9034c-6d8a-384a-80a8-f0307c8deec8",
                                "text": "Abhorrés partout comme des bêtes sinistres, leur rencontre seule est regardée comme un mauvais augure; et malgré cela, ils s’admirent comme des gens extraordinaires."
                            },
                            {
                                "example_id": "dd901fa7-35ac-4bc4-9389-15336ecbca13",
                                "sense_id": "57d9034c-6d8a-384a-80a8-f0307c8deec8",
                                "text": "A les lire, il n’y avait de peuple plus barbare, plus détestable que les Serbes. Pouilleux, voleurs, régicides, ces Serbes abhorrés étaient encore des massacreurs."
                            },
                            {
                                "example_id": "d02ddb6f-cab9-4afd-8d4c-209231bd0209",
                                "sense_id": "57d9034c-6d8a-384a-80a8-f0307c8deec8",
                                "text": "Je suis un cimetière abhorré de la lune"
                            },
                            {
                                "example_id": "a8bba883-e606-4b1b-872d-e512196f78a2",
                                "sense_id": "57d9034c-6d8a-384a-80a8-f0307c8deec8",
                                "text": "Un magicien juif était peut-être aussi abhorré qu’un usurier juif, mais il ne pouvait être méprisé au même degré."
                            }
                        ]
                    }
                ],
