                                    {
                                        "sense_id": "e7f87a0c-dcc7-34ef-a1e5-eaa2436c6a92",
                                        "entry_id": "7722bb45-b368-36a5-9076-673ce5e18c10",
                                        "glosses": [
                                            "A person who is not a computer programmer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecfff45f-88cd-41e3-a124-dd1a5580f9b3",
                                                "sense_id": "e7f87a0c-dcc7-34ef-a1e5-eaa2436c6a92",
                                                "text": "To nonprogrammers and nonoperators the most important thing about computers is that they are making us think again about the nature of problem solving."
                                            },
                                            {
                                                "example_id": "e0359a82-7334-44f1-87dd-2170ef52991c",
                                                "sense_id": "e7f87a0c-dcc7-34ef-a1e5-eaa2436c6a92",
                                                "text": "[…] the value of time-sharing and easy access to computing power for the nonprogrammer."
                                            },
                                            {
                                                "example_id": "faa65541-c446-4b22-83bb-eae13903c4e0",
                                                "sense_id": "e7f87a0c-dcc7-34ef-a1e5-eaa2436c6a92",
                                                "text": "In the recent past it was cheaper to hire programmers than to buy computers powerful enough to allow nonprogrammer programming."
                                            },
                                            {
                                                "example_id": "aaf26a8f-e7d9-44be-9143-0d7e7f0e78b1",
                                                "sense_id": "e7f87a0c-dcc7-34ef-a1e5-eaa2436c6a92",
                                                "text": "We have seen, in the earlier chapters, various ways in which human-computer interaction can be broadened to include the nonprogrammer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
