                ],
                "translations": [
                    {
                        "translation_id": "a8c67e6c-1c6d-4e2f-976b-3fd67b3c5b6b",
                        "source_entry_id": "670ca65d-38fa-3140-8d9c-6a47c358a0d0",
                        "source_sense_id": "da7119e6-23e0-36df-8cd8-67f6394f021e",
                        "source_sense_description": "benaming voor vogels uit de familie Passeridae",
                        "target_lang_word": "Spatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb3af1a8-02ae-303d-bc56-9ad284a0dc98",
                                        "entry_id": "2ca996aa-8f8e-3152-b545-9d39838f0787",
                                        "glosses": [
                                            "der Sperling (Passer), ein körnerfressender Singvogel, speziell der Haussperling"
                                        ],
                                        "tags": [
                                            "P. domesticus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e0f83d1-b0b3-4c36-bfc5-1c3b5da60e6d",
                                                "sense_id": "fb3af1a8-02ae-303d-bc56-9ad284a0dc98",
                                                "text": "“Ich bin ein armer Schreiber nur, / Hab weder Haus noch Acker, / Doch freut mich jede Kreatur, / Sogar der Spatz, der Racker.”"
                                            },
                                            {
                                                "example_id": "080de86c-e44d-400a-93fd-23291760ee3c",
                                                "sense_id": "fb3af1a8-02ae-303d-bc56-9ad284a0dc98",
                                                "text": "Früher traten die Spatzen in großen Schwärmen auf."
                                            },
                                            {
                                                "example_id": "5814fafe-63a7-4c22-9f3b-3c120a51a337",
                                                "sense_id": "fb3af1a8-02ae-303d-bc56-9ad284a0dc98",
                                                "text": "„Sie hat ein unglaubliches Klangvolumen. So laut und durchdringend, dass bei jedem Orgelkonzert die Spatzen tot vom Baum fallen.“"
                                            },
                                            {
                                                "example_id": "38157bea-d544-4467-86c7-1f445f64c234",
                                                "sense_id": "fb3af1a8-02ae-303d-bc56-9ad284a0dc98",
                                                "text": "„Ein paar Spatzen flogen schilpend auf das Vogelbad in der Mitte des Rasens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "31a15a22-d936-3278-a79e-659fa7f334d2",
                                        "entry_id": "2ca996aa-8f8e-3152-b545-9d39838f0787",
                                        "glosses": [
                                            "Kosewort für einen geliebten Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "182090fd-2c79-4ecd-bd88-37ad0ed4e271",
                                                "sense_id": "31a15a22-d936-3278-a79e-659fa7f334d2",
                                                "text": "Komm auf meinen Schoß, mein Spatz!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "74e34eac-a66c-31af-8351-a1ea4f26e470",
                                        "entry_id": "2ca996aa-8f8e-3152-b545-9d39838f0787",
                                        "glosses": [
                                            "von einem Brett geschabte Nudeln"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b0964b8-7b13-40cb-954f-28f0aded3b25",
                                                "sense_id": "74e34eac-a66c-31af-8351-a1ea4f26e470",
                                                "text": "Ein beliebtes schwäbisches Gericht heißt Kartoffelschnitz und Spatzen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b779949-7530-4455-9930-42b245963dce",
                        "source_entry_id": "670ca65d-38fa-3140-8d9c-6a47c358a0d0",
