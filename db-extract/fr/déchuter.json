                        "entry_id": "704f0c8e-57a1-31ab-b591-c15d4bea1b00",
                        "glosses": [
                            "Chuter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "408deabb-3cb6-45e9-9bbc-33ebbcc7689a",
                                "sense_id": "1c4d3fdc-8bbc-340e-b471-f7d84a809c47",
                                "text": "C’est aussi comme ça quand les opposants sont prêts à tout pour faire déchuter le président."
                            },
                            {
                                "example_id": "d0306c95-8544-44d2-bf5e-5ddbabce4581",
                                "sense_id": "1c4d3fdc-8bbc-340e-b471-f7d84a809c47",
                                "text": "Le garde hoche la tête et nous laisse… je pose un regard assassin sur mes deux qui me servent de gardes du corps et ne cessent de déchuter dans mon estime…"
                            }
                        ]
                    },
                    {
                        "sense_id": "f2ab2685-f514-3de1-8a12-4963cfcbe644",
                        "entry_id": "704f0c8e-57a1-31ab-b591-c15d4bea1b00",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12204f7c-6f8b-4b87-b892-b5104740a7be",
                                "sense_id": "f2ab2685-f514-3de1-8a12-4963cfcbe644",
                                "text": "Comme de déchuter la vigne, c’était un sapristi de boulot, c’était… la première fois que j’ai pris la dévideuse avec le cheval, les deux premiers, ils ont sauté hein ! ah oui !"
                            }
                        ]
                    }
