{
    "word_family": [
        "polyphony",
        "polyphonically",
        "polyphonist"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b4fe80cc-c748-35e9-9996-1b5e1c5fdf04",
                    "sense_definition": "Able to play or produce more than one musical note at the same time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Modern synthesizers are <w>polyphonic</w> and can play complex chords easily.",
                            "target_lang_translations": {
                                "ru": "Современные синтезаторы — <w>полифонические</w>, и на них легко можно играть сложные аккорды."
                            }
                        },
                        {
                            "text": "The musician preferred a <w>polyphonic</w> instrument to create a richer sound.",
                            "target_lang_translations": {
                                "ru": "Музыкант предпочел <w>полифонический</w> инструмент, чтобы создать более насыщенное звучание."
                            }
                        }
                    ],
                    "synonyms": [
                        "multiphonic"
                    ],
                    "antonyms": [
                        "monophonic"
                    ],
                    "common_phrases": [],
                    "target_lang_definitions": {
                        "ru": "Способный воспроизводить или исполнять более одной музыкальной ноты одновременно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полифонический",
                                "target_lang_sense_clarification": "о музыкальных инструментах и синтезаторах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4650aec-e811-3531-8ebe-8c5e1ed933fd",
                    "sense_definition": "Having two or more independent but harmonic melodies played together.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The choir performed a <w>polyphonic</w> texture where each voice had its own melody.",
                            "target_lang_translations": {
                                "ru": "Хор исполнил <w>полифоническое</w> произведение, где у каждого голоса была своя мелодия."
                            }
                        },
                        {
                            "text": "Bach is famous for his <w>polyphonic</w> compositions that weave multiple lines together.",
                            "target_lang_translations": {
                                "ru": "Бах знаменит своими <w>полифоническими</w> композициями, в которых переплетаются несколько линий."
                            }
                        }
                    ],
                    "synonyms": [
                        "contrapuntal"
                    ],
                    "antonyms": [
                        "homophonic"
                    ],
                    "common_phrases": [],
                    "target_lang_definitions": {
                        "ru": "Имеющий две или более независимые, но гармоничные мелодии, исполняемые одновременно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полифонический",
                                "target_lang_sense_clarification": "о многоголосной музыке"
                            },
                            {
                                "target_lang_word": "многоголосный",
                                "target_lang_sense_clarification": "состоящий из нескольких голосов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66addda6-58a6-34d7-99a7-0e20050f7d60",
                    "sense_definition": "Of or relating to the style or technique of polyphony.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Early mobile phones were famous for their <w>polyphonic</w> ringtone options.",
                            "target_lang_translations": {
                                "ru": "Первые мобильные телефоны были известны своими вариантами <w>полифонических</w> рингтонов."
                            }
                        },
                        {
                            "text": "The students studied the <w>polyphonic</w> music of the Renaissance period.",
                            "target_lang_translations": {
                                "ru": "Студенты изучали <w>полифоническую</w> музыку эпохи Возрождения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "polyphonic ringtone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к стилю или технике полифонии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полифонический",
                                "target_lang_sense_clarification": "относящийся к полифонии как стилю"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdfc66db-1e11-318f-b09e-664f40d264a0",
                    "sense_definition": "Capable of being read or interpreted in more than one way, especially in linguistics or literature.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "interpretation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scholar argued that the ancient script was <w>polyphonic</w> in nature.",
                            "target_lang_translations": {
                                "ru": "Ученый утверждал, что древняя письменность была <w>полифонической</w> по своей природе."
                            }
                        },
                        {
                            "text": "A <w>polyphonic</w> novel allows for multiple perspectives and voices to coexist.",
                            "target_lang_translations": {
                                "ru": "<w>Полифонический</w> роман позволяет сосуществовать множеству точек зрения и голосов."
                            }
                        }
                    ],
                    "synonyms": [
                        "multivocal"
                    ],
                    "common_phrases": [
                        "polyphonic novel"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный интерпретироваться или читаться более чем одним способом, особенно в лингвистике или литературе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полифонический",
                                "target_lang_sense_clarification": "о многоголосии в литературе или многозначности знаков"
                            },
                            {
                                "target_lang_word": "многозначный",
                                "target_lang_sense_clarification": "имеющий несколько значений"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}