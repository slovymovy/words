                    "sense_definition": "To participate in a group discussion to solve a problem or produce ideas.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "generate_ideas",
                    "name_type": "no",
                    "examples": [
                        {
