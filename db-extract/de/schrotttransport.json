                "senses": [
                    {
                        "sense_id": "68d1257f-43ba-396a-afdf-89803248ef4d",
                        "entry_id": "c9eb7730-05bb-31d1-a157-07aa5deacbcc",
                        "glosses": [
                            "der Transport von Schrott"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "291a665c-f21d-4960-b0cc-2934b88deb2f",
                                "sense_id": "68d1257f-43ba-396a-afdf-89803248ef4d",
                                "text": "„Beamte der Kontrolleinheit Verkehrswege (KEV) des Hauptzollamtes Münster verhinderten jetzt bei Ahaus einen illegalen Schrotttransport von den Niederlanden in die Bundesrepublik.“"
                            },
                            {
                                "example_id": "2566bd2e-515d-4166-b226-15d3b27e86d5",
                                "sense_id": "68d1257f-43ba-396a-afdf-89803248ef4d",
                                "text": "„Im Grundsatz geht es darum, die für den Schrotttransport eingesetzten Bahnwagen besser zu koordinieren, ihren Umlauf zu erhöhen und dadurch die Standgelder zu reduzieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
