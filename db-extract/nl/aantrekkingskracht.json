                "senses": [
                    {
                        "sense_id": "aae5fd15-ff64-30d8-9474-738b80b2f9fe",
                        "entry_id": "6f866eed-a6c9-3dfd-ac9e-45212e21a342",
                        "glosses": [
                            "een kracht waarmee alle stoffelijke lichamen elkaar proberen te naderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96c7c4ab-abd5-4a44-9d25-ccea3bdaab37",
                                "sense_id": "aae5fd15-ff64-30d8-9474-738b80b2f9fe",
                                "text": "De aantrekkingskracht tussen de twee planeten was niet erg groot."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd549c93-fa74-339d-acb6-ff9a64d5b64c",
                        "entry_id": "6f866eed-a6c9-3dfd-ac9e-45212e21a342",
                        "glosses": [
                            "het vermogen van een persoon of zaak om iemand tot zich te trekken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0684b327-22c4-4f06-880c-f2dcb29fe4a9",
                                "sense_id": "fd549c93-fa74-339d-acb6-ff9a64d5b64c",
                                "text": "Dankzij de grote aantrekkingskracht tussen die twee kregen ze een relatie."
                            },
                            {
                                "example_id": "b7bb28b1-3367-4452-a4db-ca33afa9b76e",
                                "sense_id": "fd549c93-fa74-339d-acb6-ff9a64d5b64c",
                                "text": "Het geluidje had een grote aantrekkingskracht op het baby'tje."
                            },
                            {
                                "example_id": "1ae406e8-b710-4b1c-9113-aa73b2bd2b48",
                                "sense_id": "fd549c93-fa74-339d-acb6-ff9a64d5b64c",
                                "text": "De romantici gingen ervan uit dat ware liefde een combinatie was van seksuele aantrekkingskracht en geestverwantschap."
                            },
                            {
                                "example_id": "d8ddb9b6-ef9e-4155-8891-520a09e6a64e",
                                "sense_id": "fd549c93-fa74-339d-acb6-ff9a64d5b64c",
                                "text": "Anna Boleyn had naast die sterke lichamelijke aantrekkingskracht nog een berekenende trek gehad die haar eerzuchtig maakte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abc256de-12a7-4aa7-8c1b-749ec112018a",
                        "source_entry_id": "6f866eed-a6c9-3dfd-ac9e-45212e21a342",
