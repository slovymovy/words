                        "entry_id": "e22115bf-3e31-3fe2-abbd-16aa862f3ece",
                        "glosses": [
                            "Faire sortir du fil qui le retient, en parlant d'une chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1a7744c-0196-499b-a8df-e5966adcffeb",
                                "sense_id": "486f3e27-1129-38ab-a80d-be246356172e",
                                "text": "Désenfiler des perles."
                            },
                            {
                                "example_id": "f2dc430d-77f3-4120-8949-76de262ddf6a",
                                "sense_id": "486f3e27-1129-38ab-a80d-be246356172e",
                                "text": "Ces perles se sont désenfilées."
                            },
                            {
                                "example_id": "f6f87a79-acd8-429e-97ee-d48ecebfeb1a",
                                "sense_id": "486f3e27-1129-38ab-a80d-be246356172e",
                                "text": "Toutes ces fêtes, toutes ces saisons qui apportaient elles-mêmes leur joie alors qu’il ne le connaissait point, s’étaleraient maintenant sans but par l’année, comme des perles désenfilées."
                            }
                        ]
                    }
