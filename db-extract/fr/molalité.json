                        "glosses": [
                            "Concentration molaire massique. C'est à dire le nombre de moles dissoutes dans 1kg de solvant, on l'exprime en molal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dc2b832-9363-4d9d-8492-0f626d077f3c",
                                "sense_id": "0f62dc6b-3cb3-3b66-bacb-76540dc36b70",
                                "text": "La molalité est généralement donnée en moles de soluté par kilogramme de solvant, mol.kg⁻¹ !."
                            }
                        ]
