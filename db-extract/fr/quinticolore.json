                        "target_lang_word": "fünffarbig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fünffarbig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d4059cda-523f-3bd2-85f3-ea866ebb3a0e",
                                        "entry_id": "553db996-b371-306d-b9d4-d0845ca2c696",
                                        "glosses": [
                                            "fünf Farben enthaltend oder verwendend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76432aea-5732-4398-91a4-8cdfe6978c14",
                                                "sense_id": "d4059cda-523f-3bd2-85f3-ea866ebb3a0e",
                                                "text": "„Viele Teilnehmer schwenkten auf dem zentralen Rabin-Platz israelische Fahnen und zugleich die fünffarbige Flagge der Drusen.“"
                                            },
                                            {
                                                "example_id": "96d7eb3b-bdd9-480f-b65f-26f0b03551d8",
                                                "sense_id": "d4059cda-523f-3bd2-85f3-ea866ebb3a0e",
                                                "text": "[Regenbogenflagge:] „Entworfen und angeblich erfunden wurde sie von dem US-amerikanischen Künstler Gilbert Baker. Er hatte als Vorbild die fünffarbige „Flag of Race“.“"
                                            },
                                            {
                                                "example_id": "cc725228-31b0-4eb5-a326-5ef146ceef2c",
                                                "sense_id": "d4059cda-523f-3bd2-85f3-ea866ebb3a0e",
                                                "text": "„Die „österreichische“ Feldmütze ist seit 1990 im fünffarbigen Flecktarn die Standard-Kopfbedeckung zum Feldanzug.“"
                                            },
                                            {
                                                "example_id": "d83e4e5b-252e-4628-b276-f435cc8fc920",
                                                "sense_id": "d4059cda-523f-3bd2-85f3-ea866ebb3a0e",
                                                "text": "„Nehm' ich den fünffarbigen Siebdruck? Oder lieber das schwarz-weiße Porträt?“"
                                            },
                                            {
                                                "example_id": "79145d82-847a-422d-96d5-1902a69e693f",
                                                "sense_id": "d4059cda-523f-3bd2-85f3-ea866ebb3a0e",
                                                "text": "[Nutri-Score:] „Die fünffarbige Ernährungsampel soll im Supermarkt Licht ins Dunkle der Lebensmittel-Qualität bringen und zwar schnell und auf einen Blick.“"
                                            },
                                            {
                                                "example_id": "ce870f48-6040-40b2-b863-8f07dd021e5a",
                                                "sense_id": "d4059cda-523f-3bd2-85f3-ea866ebb3a0e",
                                                "text": "„»Er hat eines Tages gebetet und fünffarbige Wolken über einen Berg schweben sehen, ist auf diesen Berg gepilgert, fand einen alten Mann an einer frischen Wasserquelle und dieser Mann offenbarte sich als Gott dieses Berges.«“"
                                            },
                                            {
                                                "example_id": "96bc9fae-d378-4257-b6eb-2f3667d245bf",
                                                "sense_id": "d4059cda-523f-3bd2-85f3-ea866ebb3a0e",
                                                "text": "„Es ist dieser Tage überall zu sehen. In der U-Bahn, als Nadel am Revers der zahllosen Anzugträger, in Werbespots und im Supermarkt. Das runde, fünffarbige Arrangement von Kirschblüten, das für den Versuch steht, die Olympischen Spiele 2020 nach Tokio zu holen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
