                        "cross_references": [
                            {
                                "target_word": "coing",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b6d0e7f-bc97-30b7-8d4e-fb7e29cd09b7",
                                        "entry_id": "2fb4692d-a7a8-3557-91c1-489ada2ec6c4",
                                        "glosses": [
                                            "Fruit piriforme du cognassier, de couleur jaune, au goût âpre et souvent utilisé pour faire des gelées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15910f2a-4a5f-4979-9b0e-56ddf6feceb6",
                                                "sense_id": "8b6d0e7f-bc97-30b7-8d4e-fb7e29cd09b7",
                                                "text": "Jaune comme un coing."
                                            },
                                            {
                                                "example_id": "5ba9b901-4811-4b63-aedb-59202241ac20",
                                                "sense_id": "8b6d0e7f-bc97-30b7-8d4e-fb7e29cd09b7",
                                                "text": "Il sentit dès les paliers inférieurs une entêtante odeur de fruit et trouva dans l’atelier Élodie, qui aidait la citoyenne Gamelin à faire de la confiture de coings."
                                            },
                                            {
                                                "example_id": "f9176b61-d843-42e5-afbe-113591987796",
                                                "sense_id": "8b6d0e7f-bc97-30b7-8d4e-fb7e29cd09b7",
                                                "text": "Les coings sont de gros fruits plus ou moins bosselés, tronconiques, ovoïdes ou piriformes suivant les variétés. A l’âge adulte, un arbre peut donner jusqu’à 100 kilos de fruits."
                                            },
                                            {
                                                "example_id": "90765489-83ec-47af-a7df-b9e309552b6e",
                                                "sense_id": "8b6d0e7f-bc97-30b7-8d4e-fb7e29cd09b7",
                                                "text": "Les coings se récoltent à partir d’octobre, après la chute des premiers fruits, quand ils exhalent un arôme puissant et agréable, qu’ils sont jaune et bien lourds… mais au plus tard avant les fortes gelées de novembre."
                                            },
                                            {
                                                "example_id": "18e50d2c-936d-48e2-9784-516786f31c7d",
                                                "sense_id": "8b6d0e7f-bc97-30b7-8d4e-fb7e29cd09b7",
                                                "text": "Le coing est un fruit étonnant, avec son jaune mat sous une couche pelucheuse. Très doux au toucher, mais pas irritant comme la pêche. Si lourd, il aime s’affaler dans l’herbe. Si dur, il résiste même au couteau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
