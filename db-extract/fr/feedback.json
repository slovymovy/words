                                                "sense_id": "73b5c9ec-083a-36f0-8996-df3edc53cbb4",
                                                "text": "The show ended with a riot of feedbacking guitars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87b1477c-3981-36b6-83cf-4f5cf729176f",
                                        "entry_id": "6c42f122-f7f1-3a78-9624-c7fee4a847ef",
                                        "glosses": [
                                            "To provide informational feedback to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
