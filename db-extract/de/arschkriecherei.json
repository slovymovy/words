                        "entry_id": "98de9413-2f16-372e-8c08-6efa9d902d2a",
                        "glosses": [
                            "Vorgang, bei dem man sich jemandem gegenüber unterwürfig verhält, um Vorteile erreichen oder nutzen zu können"
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "77a8052e-0441-4498-8947-e0803c08fdca",
                                "sense_id": "3ea292c2-0f2e-3e15-b4a2-c8f8fd015850",
                                "text": "David hält die Arschkriecherei für ein probates Mittel."
                            },
                            {
                                "example_id": "708c4808-bfd0-4a3a-9181-ad61e2d39fe1",
                                "sense_id": "3ea292c2-0f2e-3e15-b4a2-c8f8fd015850",
                                "text": "Die Kunst der Arschkriecherei wird hier ausgiebig zur Schau gestellt."
                            }
                        ],
