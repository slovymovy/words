                "senses": [
                    {
                        "sense_id": "fc88ce54-c9fe-35fe-b2f5-dab6436f6046",
                        "entry_id": "a1f7b995-8de1-34a5-9571-cbcaee8f316e",
                        "glosses": [
                            "A surgical procedure in which an incision is made into the trachea, through the neck, and a tube inserted so as to make an artificial opening in order to assist breathing."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d94e48a-7360-4ae1-9bc8-7143fb9a1bc5",
                        "source_entry_id": "a1f7b995-8de1-34a5-9571-cbcaee8f316e",
                        "source_sense_id": "fc88ce54-c9fe-35fe-b2f5-dab6436f6046",
                        "source_sense_description": "surgery to insert a tube into the neck",
                        "target_lang_word": "trachéotomie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trachéotomie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "66d33d83-ff2e-38c7-9d17-b0a6d2303cef",
                                        "entry_id": "bfcf897f-48b9-39ab-9915-17c99e5b66ca",
                                        "glosses": [
                                            "Opération qui consiste à ouvrir la trachée-artère pour permettre le passage de l’air vers les poumons lorsque les voies aériennes sont bouchées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb559441-ef90-4599-9eb6-c92fac854783",
                                                "sense_id": "66d33d83-ff2e-38c7-9d17-b0a6d2303cef",
                                                "text": "L’hypertrophie thyroïdienne dont est atteint le sujet, et peut-être aussi un certain degré de sthénose de la trachée, consécutive à la trachéotomie, rendirent la chloroformisation très difficile."
                                            },
                                            {
                                                "example_id": "e2a0852c-fe38-4d62-8f1d-d22b8835cd59",
                                                "sense_id": "66d33d83-ff2e-38c7-9d17-b0a6d2303cef",
                                                "text": "Dans le premier cas il s'agissait d'un blessé dont le larynx fut traversé par une balle; on fit une trachéotomie pour des accidents respiratoires inquiétants, puis on décanula le malade quelques jours après sans pratiquer un examen du larynx."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d8aa1a9-43a0-47f4-b069-0e9d6962afcb",
                        "source_entry_id": "a1f7b995-8de1-34a5-9571-cbcaee8f316e",
                        "source_sense_id": "fc88ce54-c9fe-35fe-b2f5-dab6436f6046",
                        "source_sense_description": "surgery to insert a tube into the neck",
                        "target_lang_word": "Luftröhrenschnitt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Luftröhrenschnitt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41523fc5-ae7d-398a-bf62-d19bd103e098",
                                        "entry_id": "f5ed3b77-ec93-34d7-b75d-a978c0adeed1",
                                        "glosses": [
                                            "chirurgischer Eingriff, bei dem durch die Halsweichteile ein Zugang zur Luftröhre geschaffen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13a7595b-ac88-444c-88b3-2d39ff45566f",
                                                "sense_id": "41523fc5-ae7d-398a-bf62-d19bd103e098",
                                                "text": "„Um einen Luftröhrenschnitt durchzuführen, ertastet man zunächst einmal die Delle unterhalb des Adamsapfels, unmittelbar oberhalb des Ringknorpels.“"
                                            },
                                            {
                                                "example_id": "d32ee17f-7fb4-4eab-9604-530872db7e8a",
                                                "sense_id": "41523fc5-ae7d-398a-bf62-d19bd103e098",
                                                "text": "„Na gut, genau genommen hatte es nicht damit geendet; das eigentliche Ende war gekommen, als er ein Messer in ihren Hals rammte und ihr einen Luftröhrenschnitt verpasste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
