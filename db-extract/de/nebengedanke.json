                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5586d2de-b45e-475d-8a41-d2c029a29425",
                                "sense_id": "988a819f-1310-3604-9b1a-adb43a14dba8",
                                "text": "„Es sind oft die lautlosesten Nebengedanken, die einen auf die Spur führen, auf das eigene, einspurige Wahrnehmen der Wirklichkeit.“"
                            },
                            {
                                "example_id": "b47bdfe5-b985-4f8b-801e-22cbb9ed2d41",
                                "sense_id": "988a819f-1310-3604-9b1a-adb43a14dba8",
                                "text": "„Alles Hallodrihafte war fern und die Nebengedanken und Hintergedanken machten mal Pause.“"
                            }
                        ],
