                    },
                    {
                        "translation_id": "997e138e-1cc9-454d-9c4e-21d9db13b0a1",
                        "source_entry_id": "02129660-4c1f-36a0-9701-6e92b281c340",
                        "source_sense_id": "b133edc1-53a7-301f-8dc3-cefc6d022271",
                        "target_lang_word": "букинист",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "букинист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "35c2f336-d204-370b-822a-3d409dca0678",
                                        "entry_id": "9ca3cfe3-185e-3045-9419-28a439198fea",
                                        "glosses": [
                                            "истор. торговец, занимающийся покупкой и продажей подержанных, редких и старинных книг и других печатных изданий"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69d2c029-ec9e-41c0-b9e9-c89ee3ea0b8d",
                                                "sense_id": "35c2f336-d204-370b-822a-3d409dca0678",
                                                "text": "В моём рассказе студент с голодухи понёс продавать книжки Паустовского, но букинист, не желая, чтоб молодой человек пал жертвой вещизма, мещанства и бездуховности, книжки у него не купил."
                                            },
                                            {
                                                "example_id": "e8d4bef7-64e8-4eb0-9a35-04bc0c421060",
                                                "sense_id": "35c2f336-d204-370b-822a-3d409dca0678",
                                                "text": "В издании не хватало одного тома, поэтому букинист отдавал сто за бесценок: все одиннадцать томов за пятьдесят миллионов рублей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e592757-88a1-3d87-b039-748a06a58b7d",
                                        "entry_id": "9ca3cfe3-185e-3045-9419-28a439198fea",
                                        "glosses": [
                                            "торг. продавец книжной торговли, специалист в области бывших в пользовании, редких и старинных книг, произведений, печати"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb909cd9-4813-45bc-bf8b-4a5703595b71",
                                                "sense_id": "5e592757-88a1-3d87-b039-748a06a58b7d",
                                                "text": "В каждом городе он непременно обходил все книжные магазины, стараясь завести знакомство с букинистами."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
