                "senses": [
                    {
                        "sense_id": "1c1dd728-2e54-36b4-8a04-eae1e13b7fbb",
                        "entry_id": "47040fd0-05aa-3ad8-af80-c8c6f4dc2619",
                        "glosses": [
                            "Porter à l’écran, montrer au cinéma."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f7f6a06b-1381-4084-9096-a3e197d9ed27",
                                "sense_id": "1c1dd728-2e54-36b4-8a04-eae1e13b7fbb",
                                "text": "La Guerre du Faux (clin d’œil : au cinéma, Le Nom de la rose est écranifié par Jean-Jacques Annaud qui fit La Guerre du feu…) est un recueil d’articles, parus çà et là, ces vingt dernières années."
                            },
                            {
                                "example_id": "5c3696e4-d6de-4017-aace-1b3553aa705f",
                                "sense_id": "1c1dd728-2e54-36b4-8a04-eae1e13b7fbb",
                                "text": "Des dizaines de millions de spectateurs connaissaient Max « écranifié dans toutes les villes », tandis que le chiffre des lecteurs de Verhaeren se mesurait en quelques milliers."
                            }
                        ]
                    }
