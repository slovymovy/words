                    {
                        "sense_id": "a3e5180e-b992-3b77-93a1-e747481b951e",
                        "entry_id": "4fa9f45f-ee1c-3bd2-8a7a-6d6c91a6a5c5",
                        "glosses": [
                            "Relatif à la divination."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e1e81ee-503b-4d61-aadd-d593bb1e3109",
                                "sense_id": "a3e5180e-b992-3b77-93a1-e747481b951e",
                                "text": "La troisième classe de prêtres était les ovates ou eubages, fidèles dépositaires des rites sacrés et des cérémonies religieuses ; cette dernière classe exerçait aussi l'art divinatoire, et remplissait ainsi le même office que les augures et les aruspices de Rome."
                            },
                            {
                                "example_id": "42bd24bb-3081-41b3-9ade-1f7d1a70acde",
                                "sense_id": "a3e5180e-b992-3b77-93a1-e747481b951e",
                                "text": "Art, science divinatoire."
                            },
                            {
                                "example_id": "9fe80ee6-6abf-4524-9c09-3f4a695a0248",
                                "sense_id": "a3e5180e-b992-3b77-93a1-e747481b951e",
                                "text": "La baguette divinatoire des chercheurs de sources. (→ voir sourcier)"
                            }
                        ]
                    }
                ],
