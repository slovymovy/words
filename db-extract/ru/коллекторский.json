                                                "example_id": "7ecc03cd-2573-43d5-a7de-84cd65911173",
                                                "sense_id": "56b3902c-83c3-32d5-9d11-4c2c44470467",
                                                "text": "Collection of trash will occur every Thursday."
                                            }
