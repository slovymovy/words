                    }
                ],
                "senses": [
                    {
                        "sense_id": "cbdf3899-9bdf-34fc-9f9e-4117f7ac7c05",
                        "entry_id": "ebaff285-eea2-3f3a-b101-e90d5874ed81",
                        "glosses": [
                            "протянуться, просуществовать какое-либо время, до какого-либо срока"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "02f6d01d-fe72-3e84-8059-ab252e1497ed",
                        "entry_id": "ebaff285-eea2-3f3a-b101-e90d5874ed81",
                        "glosses": [
                            "растянуться на более продолжительное время, стать более длительным по времени"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ede8997-a2a5-4c23-a48e-3aa7dbce32b0",
                        "source_entry_id": "ebaff285-eea2-3f3a-b101-e90d5874ed81",
                        "target_lang_word": "durer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "durer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80b30d4f-f921-3b6e-b315-25d8f369a991",
                                        "entry_id": "b42d2f6b-e012-311b-ab10-5a78fbe1772e",
                                        "glosses": [
                                            "Continuer d’être, se prolonger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fc002e1-13c4-43f5-9627-a4eaa6f9da32",
                                                "sense_id": "80b30d4f-f921-3b6e-b315-25d8f369a991",
                                                "text": "Les charrettes et les chars étaient là dès potron-minet, voire dès la veille, car le marché était clappé dès prime ; il durait jusqu’à midi."
                                            },
                                            {
                                                "example_id": "f99edf83-670e-4d9f-ac12-b2b04aaf20d8",
                                                "sense_id": "80b30d4f-f921-3b6e-b315-25d8f369a991",
                                                "text": "Arthur ? C'est moi... Justine. Je craque, envie de te voir, plus possible ces ouikendes. Six mois que ça dure, me sens comme une back-street vieillissant dans le formol."
                                            },
                                            {
                                                "example_id": "823e8e9b-3821-4a40-9867-ef1eb513897a",
                                                "sense_id": "80b30d4f-f921-3b6e-b315-25d8f369a991",
                                                "text": "Toutes les choses de ce monde durent peu. — L’hiver dure encore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "038a8142-0552-3f82-a69a-bc3c569241b6",
                                        "entry_id": "b42d2f6b-e012-311b-ab10-5a78fbe1772e",
                                        "glosses": [
                                            "Persister, rester, durer longtemps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05c669b8-a5a7-4c2f-a20c-6815bbdbff73",
                                                "sense_id": "038a8142-0552-3f82-a69a-bc3c569241b6",
                                                "text": "Cela ne durera pas."
                                            },
                                            {
                                                "example_id": "d260fd3c-352b-43b5-81a7-62d829856efe",
                                                "sense_id": "038a8142-0552-3f82-a69a-bc3c569241b6",
                                                "text": "Cette fantaisie vous dure-t-elle encore ?"
                                            },
                                            {
                                                "example_id": "0babdbe1-d872-4cef-bf6f-29c61dd12869",
                                                "sense_id": "038a8142-0552-3f82-a69a-bc3c569241b6",
                                                "text": "Il faut faire vie qui dure, faire feu qui dure, il faut ménager son bien, ne pas faire trop de dépense."
                                            },
                                            {
                                                "example_id": "02ddee4c-d868-4fbd-b7a2-7b1b6bde2b5e",
                                                "sense_id": "038a8142-0552-3f82-a69a-bc3c569241b6",
                                                "text": "Ne pouvoir durer en place, être si inquiet, si tourmenté qu’on ne peut demeurer dans le même lieu, dans la même situation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee023b59-504e-3117-a1ba-073deb725b65",
                                        "entry_id": "b42d2f6b-e012-311b-ab10-5a78fbe1772e",
                                        "glosses": [
                                            "Résister au temps, à l’usure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00c70859-acf3-48e9-8dbe-0b333e575b94",
                                                "sense_id": "ee023b59-504e-3117-a1ba-073deb725b65",
                                                "text": "Cela ne durera pas."
                                            },
                                            {
                                                "example_id": "1e3c8756-384b-4f70-86f9-6602301dd635",
                                                "sense_id": "ee023b59-504e-3117-a1ba-073deb725b65",
                                                "text": "Ne pouvoir durer à la peine, à la fatigue, à la douleur, ne pouvoir y résister."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "047e2340-36dd-3354-a054-d5b4e3bb5ad8",
                                        "entry_id": "b42d2f6b-e012-311b-ab10-5a78fbe1772e",
                                        "glosses": [
                                            "Supporter, endurer."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0b0ccbf-34ce-4cea-b31f-0c82638f6591",
                                                "sense_id": "047e2340-36dd-3354-a054-d5b4e3bb5ad8",
                                                "text": "Ne pouvoir durer avec quelqu’un, Ne pouvoir vivre avec lui, ne pouvoir le supporter."
                                            },
                                            {
                                                "example_id": "644366bd-1d7a-4df8-94e5-1b5c4f96dc90",
                                                "sense_id": "047e2340-36dd-3354-a054-d5b4e3bb5ad8",
                                                "text": "On ne peut durer avec cet homme-là, tant il est fâcheux et difficile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcadb006-b51a-355a-acc6-0f9751acbac7",
                                        "entry_id": "b42d2f6b-e012-311b-ab10-5a78fbe1772e",
                                        "glosses": [
                                            "Paraître long et ennuyeux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a6f943d-45d5-489e-a686-6d7f5750ccdc",
                                                "sense_id": "dcadb006-b51a-355a-acc6-0f9751acbac7",
                                                "text": "Le temps lui dure, se dit d’une personne à qui l’impatience, l’ennui, ou quelque autre cause fait paraître le temps long."
                                            },
                                            {
                                                "example_id": "7a2fed2d-1a11-4bbf-924f-b8fb82c005d2",
                                                "sense_id": "dcadb006-b51a-355a-acc6-0f9751acbac7",
                                                "text": "Elle disait : « Les médecins veulent me garder encore un mois. » — « Le temps me dure, » disait Maurice. — « Que veux-tu, il faut que je me guérisse. » Il répondait : « Oh ! je sais, tu veux toujours faire à ta tête. »"
                                            },
                                            {
                                                "example_id": "2f1a9e99-4e37-4dea-ba3e-003759bdd5ca",
                                                "sense_id": "dcadb006-b51a-355a-acc6-0f9751acbac7",
                                                "text": "Mais, quand Odette était partie, Swann souriait en pensant qu’elle lui avait dit combien le temps lui durerait jusqu’à ce qu’il lui permît de revenir."
                                            },
                                            {
                                                "example_id": "f82b4842-66d1-4655-8e77-d80485a47fdc",
                                                "sense_id": "dcadb006-b51a-355a-acc6-0f9751acbac7",
                                                "text": "Les copains étaient dans une impatience à la fois si aiguë et si attentive que le temps ne leur durait pas."
                                            },
                                            {
                                                "example_id": "44c80e54-2be6-4061-9a93-d564cd425e5c",
                                                "sense_id": "dcadb006-b51a-355a-acc6-0f9751acbac7",
                                                "text": "– Nous la voilà pour trois semaines, oui, et ce n’est pas assez, vois-tu. Trois semaines vont vite quand on a sa fille, et le temps nous dure après."
                                            },
                                            {
