                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dichotom",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aec44d95-71ab-386e-9237-dd359396b1c8",
                                        "entry_id": "b461d2f0-74c9-3d9f-9956-97da74afcce7",
                                        "glosses": [
                                            "zweigeteilt, zweiteilig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f6a74c2-4ac9-4031-87fa-2e2af31736dc",
                                                "sense_id": "aec44d95-71ab-386e-9237-dd359396b1c8",
                                                "text": "Eine dichotome Frage ist eine Frage, die man nur mit „Ja“ oder „Nein“ beantworten kann, wie beispielsweise: „Hast du Hunger?“"
                                            },
                                            {
                                                "example_id": "407d112e-a5a6-4288-bf8b-233c2116c52b",
                                                "sense_id": "aec44d95-71ab-386e-9237-dd359396b1c8",
                                                "text": "„Das dichotome Modell der Psychosen wurde international akzeptiert und bestimmte die psychiatrische Nosologie im 20. Jahrhundert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6e6dbec9-8264-319c-8a55-a4b29f4e25a4",
                                        "entry_id": "b461d2f0-74c9-3d9f-9956-97da74afcce7",
                                        "glosses": [
                                            "verzweigt, gegabelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "329f17ec-07e5-426a-b1bc-700790c82776",
                                                "sense_id": "6e6dbec9-8264-319c-8a55-a4b29f4e25a4",
                                                "text": "Von einer dichotomen Teilung spricht man in der Botanik, einem Teilgebiet der Biologie, wenn sich die Sprossachse (bei einem Blatt, Baumstamm, Moosen, Farnen) in zwei annähernd gleiche Teile verzweigt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
