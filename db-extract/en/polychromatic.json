                                            {
                                                "example_id": "03ad049b-4190-49c7-8e2e-95f591a34ab9",
                                                "sense_id": "95c2dff6-d7e6-3067-8a71-382d8f35267a",
                                                "text": "Die Maskeraden ergaben ein buntes Bild."
                                            },
                                            {
                                                "example_id": "a8008d33-9a8f-420d-96c9-8886a2dc5045",
                                                "sense_id": "95c2dff6-d7e6-3067-8a71-382d8f35267a",
                                                "text": "Was klingt besser: \"ein bunter Blumenstrauß\" oder \"ein farbiger Blumenstrauß\"? Die meisten von uns würden wahrscheinlich für den bunten Strauß plädieren. Farbig ist ein Strauß sowieso."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8c6385f5-e4b2-3029-ac98-d53cbe808029",
                                        "entry_id": "298f23b2-3937-3409-b53e-3f103d520c16",
                                        "glosses": [
                                            "voller Ereignisse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "575acc4d-65db-434e-9c27-259ec8f28f25",
                                                "sense_id": "8c6385f5-e4b2-3029-ac98-d53cbe808029",
                                                "text": "Was klingt besser: \"ein bunter Blumenstrauß\" oder \"ein farbiger Blumenstrauß\"? Die meisten von uns würden wahrscheinlich für den bunten Strauß plädieren. Farbig ist ein Strauß sowieso."
                                            },
                                            {
                                                "example_id": "f67df3a3-f557-4ca5-ab63-35ea2e473ff7",
                                                "sense_id": "8c6385f5-e4b2-3029-ac98-d53cbe808029",
                                                "text": "Wir führten damals ein buntes Leben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ea9b66a-cb61-4952-b486-d6dca33f55f5",
