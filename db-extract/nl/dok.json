                        "entry_id": "fe649c08-53b6-314c-9a33-01d30867f947",
                        "glosses": [
                            "onderdeel van een klavecimbelmechaniek waarmee een snaar in trilling wordt gebracht door deze met een plectrum (kiel) opzij te duwen en dan te laten schieten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c050b8d-a7c2-435a-8edd-1c566d91d9e0",
                                "sense_id": "2996a041-672c-3053-baa7-133659e5950c",
                                "text": "De plectra aan de dokken maakte men vroeger van ravenpennen."
                            }
                        ]
                    },
                    {
                        "sense_id": "9945b637-6f03-393e-ba06-61b2cd7cef92",
                        "entry_id": "fe649c08-53b6-314c-9a33-01d30867f947",
                        "glosses": [
                            "voor buitenwater afsluitbaar gedeelte van een scheepswerf of een drijvende (ponton-)constructie waarmee, door het in- of uitlaten van water, schepen voor inspectie, onderhoud en reparatie kunnen worden drooggezet"
                        ],
                        "tags": [
                            "waterbeheer"
                        ],
                        "examples": [
                            {
                                "example_id": "45ee25c5-2909-4217-ab4b-435c233b049b",
                                "sense_id": "9945b637-6f03-393e-ba06-61b2cd7cef92",
                                "text": "Het schip ligt nu in dok voor reparatie."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b0dd95e-b44e-3a19-9c65-8b625a36c03d",
                        "entry_id": "fe649c08-53b6-314c-9a33-01d30867f947",
                        "glosses": [
                            "een haven in een havencomplex waar schepen kunnen worden afgemeerd, wachten, geladen of gelost"
                        ],
                        "tags": [
                            "waterbeheer"
                        ],
                        "examples": [
                            {
                                "example_id": "9e9f6cda-3e83-4d0e-a365-a86c6641c2bc",
