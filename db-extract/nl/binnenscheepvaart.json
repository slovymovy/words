                        "examples": [
                            {
                                "example_id": "331a1a58-a683-4490-b03a-502931bd8117",
                                "sense_id": "803184d6-04f7-38b0-8442-11ef80c35586",
                                "text": "De gemeente onderzoekt nog hoe hoog het bouwwerk moet worden, zodat de binnenscheepvaart er zo min mogelijk last van heeft. De brug krijgt een klep die open en dicht kan, zodat ook bijzondere transporten en schepen met een hoge mast door kunnen varen."
                            },
                            {
                                "example_id": "a0bd3755-c175-4811-8cac-9e18b397c19c",
                                "sense_id": "803184d6-04f7-38b0-8442-11ef80c35586",
                                "text": "De matrozen zouden maar zo'n 350 euro per maand salaris krijgen. De binnenscheepvaart kampt met een tekort aan personeel."
                            }
                        ]
                    }
