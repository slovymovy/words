                        "sense_id": "9a6b7fbf-f5d5-32e2-9e81-0f92175f4516",
                        "entry_id": "a4c23c59-4a7a-32ce-843b-4d7548cb2f6a",
                        "glosses": [
                            "истор. французская золотая, а с середины XVII века — серебряная монета (изначально — с изображением щита, герба)"
                        ],
                        "tags": [],
