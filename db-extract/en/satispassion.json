                "senses": [
                    {
                        "sense_id": "4e06f75c-35f8-3392-9990-a211af66a197",
                        "entry_id": "afa91a3a-5920-391f-960e-e210bcd01826",
                        "glosses": [
                            "Atonement by suffering to an adequate degree."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "54e67d9c-9098-4075-b2de-59618e1d2db3",
                                "sense_id": "4e06f75c-35f8-3392-9990-a211af66a197",
                                "text": "This, this is the great \"with us;\" […] \"with us\" in all the virtues and merits of His life; \"with us\" in the satisfaction and satispassion (both) of His death; […]"
                            },
                            {
                                "example_id": "0886b522-19d9-4c15-8366-84303cb3bada",
                                "sense_id": "4e06f75c-35f8-3392-9990-a211af66a197",
                                "text": "He muſt pay to Gods juſtice the temporal Puniſhment which he ows, and this is don either by Satispaſsion ſuffering the pains of Purgatorie for a certain time; or by the ſuffrages and penal works of the Living which they apply to him; or by Indulgence, applying from the treaſure of the Church, that’s of the ſuperabundant Satisfaction of Chriſt and his Saints, as much as will anſwer to the pains which they are to ſuffer there."
                            },
                            {
                                "example_id": "46a8b647-9f67-43eb-909b-24655f180f7f",
                                "sense_id": "4e06f75c-35f8-3392-9990-a211af66a197",
                                "text": "This [reparation for sin] may be made…by satispassion, or sufferings simply endured."
                            },
                            {
                                "example_id": "be124d56-51ac-4e95-9019-4a7b2e9e82a7",
                                "sense_id": "4e06f75c-35f8-3392-9990-a211af66a197",
                                "text": "Like His satispassion, so His satisfaction embraces the whole earthly career of the Saviour."
                            }
                        ]
                    }
                ],
