                ],
                "senses": [
                    {
                        "sense_id": "f7e36dd7-997b-3534-9d8f-1de5bdeee27a",
                        "entry_id": "4c30d557-2533-3e46-91a1-16d74cbba739",
                        "glosses": [
                            "The principle or practice of corporate action; (in later use chiefly) specifically, a political ideology which advocates for government and social organization by collective interest groups."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "84c58a23-df67-389d-8f0d-a2b152551282",
                        "entry_id": "4c30d557-2533-3e46-91a1-16d74cbba739",
                        "glosses": [
                            "The influence or effects of large business corporations."
                        ],
                        "tags": [
                            "countable",
                            "derogatory",
                            "nonstandard",
                            "possibly",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "821594ff-cd25-4fca-8f07-09ec3a8501e3",
                                "sense_id": "84c58a23-df67-389d-8f0d-a2b152551282",
                                "text": "The fear of corporatism, consumerism, middle-browism and a mass reading public has driven twentieth-century cultural hierarchists."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d27080a-2cdf-4e95-baba-4dd1ee214f5b",
                        "source_entry_id": "4c30d557-2533-3e46-91a1-16d74cbba739",
                        "source_sense_description": "political ideology",
                        "target_lang_word": "corporatisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corporatisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f30ea7c6-eac0-3ceb-b030-6e2adb41d787",
                                        "entry_id": "14775589-3e9e-3fb4-88b8-abb6f737fcbb",
                                        "glosses": [
                                            "Doctrine qui donne à des corporations, formées par les patrons et les salariés d’une même profession, un rôle déterminant dans le domaine social, économique et politique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b3c637bc-352f-3e8f-9780-d2ffe73ab68c",
                                        "entry_id": "14775589-3e9e-3fb4-88b8-abb6f737fcbb",
                                        "glosses": [
                                            "Organisation professionnelle basée sur les corporations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7596a896-5dd8-4d66-b47b-80afd46a122f",
                                                "sense_id": "b3c637bc-352f-3e8f-9780-d2ffe73ab68c",
                                                "text": "Leur sympathie pour le corporatisme, tel qu'avait tenté de l'établir le gouvernement Pétain sur le modèle de l’Italie fasciste et du Reich hitlérien, et qui, soumettant le travailleur au règne unique des traditions et des coutumes, c'est à dire de l’habitude, tend à ruiner en lui tout exercice de la liberté et de la raison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f995b8be-0cf3-3ded-9f4a-ba7242d887f1",
                                        "entry_id": "14775589-3e9e-3fb4-88b8-abb6f737fcbb",
                                        "glosses": [
                                            "Attitude qui consiste à défendre exclusivement les intérêts des membres d’une profession au détriment de l’intérêt général."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ffa8bd0-a816-4a2d-a5e8-1703b063c2d1",
                                                "sense_id": "f995b8be-0cf3-3ded-9f4a-ba7242d887f1",
                                                "text": "L'aberration du résultat ne s'est pas fait attendre: les féodalités, les corporatismes, les communautarismes, les réseaux sont souvent les plus forts."
                                            },
                                            {
                                                "example_id": "a9751fcf-5617-41f7-a9be-10d755240730",
                                                "sense_id": "f995b8be-0cf3-3ded-9f4a-ba7242d887f1",
                                                "text": "Et pour que les usagers de base puissent aider les décideurs à dissoudre les poches de résistance des corporatismes intermédiaires de tous poils ?"
                                            },
                                            {
                                                "example_id": "64359e56-ffc9-48e9-bdc4-21959e255a21",
                                                "sense_id": "f995b8be-0cf3-3ded-9f4a-ba7242d887f1",
                                                "text": "On souhaiterait que les rapports entre un gouvernement élu et ses médecins se passent autrement qu’à coup de lois contraignantes. Malheureusement, le corporatisme médical est fort, les gouvernements sont désorganisés et les systèmes de santé du Canada favorisent la bureaucratie plutôt que les services."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
