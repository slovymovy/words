{
    "word_family": [
        "pampering",
        "pampered",
        "pamperer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "57471663-bd71-3aa9-9e2a-f9769ab59afb",
                    "sense_definition": "To treat someone with excessive care, attention, or indulgence, often to make them feel comfortable or special.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "care",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long week at work, she decided to <w>pamper</w> herself with a relaxing spa day.",
                            "target_lang_translations": {
                                "ru": "После долгой рабочей недели она решила <w>побаловать</w> себя расслабляющим днем в спа."
                            }
                        },
                        {
                            "text": "The grandparents love to <w>pamper</w> their grandchildren by buying them whatever toys they want.",
                            "target_lang_translations": {
                                "ru": "Бабушка с дедушкой обожают <w>баловать</w> своих внуков, покупая им любые игрушки, которые те захотят."
                            }
                        }
                    ],
                    "synonyms": [
                        "coddle",
                        "spoil",
                        "cosset",
                        "mollycoddle"
                    ],
                    "antonyms": [
                        "neglect",
                        "mistreat"
                    ],
                    "common_phrases": [
                        "pamper yourself",
                        "pamper someone with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относиться к кому-либо с чрезмерной заботой, вниманием или потакать желаниям, чтобы человек почувствовал себя особенным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "баловать",
                                "target_lang_sense_clarification": "уделять чрезмерную заботу, потакать желаниям"
                            },
                            {
                                "target_lang_word": "нежить",
                                "target_lang_sense_clarification": "окружать лаской и комфортом"
                            },
                            {
                                "target_lang_word": "ублажать",
                                "target_lang_sense_clarification": "угождать, доставляя удовольствие"
                            },
                            {
                                "target_lang_word": "холить",
                                "target_lang_sense_clarification": "заботливо ухаживать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5f9e2d7-e310-38e2-90ac-60d8a8ba4f6c",
                    "sense_definition": "To feed someone or something with very rich, luxurious, or high-quality food.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "care",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef would <w>pamper</w> his guests with the finest truffles and vintage wines available.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар <w>потчевал</w> своих гостей лучшими трюфелями и выдержанными винами."
                            }
                        },
                        {
                            "text": "They <w>pamper</w> their prize-winning horses with only the most expensive organic grains.",
                            "target_lang_translations": {
                                "ru": "Своих призовых лошадей они <w>балуют</w> только самым дорогим органическим зерном."
                            }
                        }
                    ],
                    "synonyms": [
                        "pander"
                    ],
                    "antonyms": [
                        "starve"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кормить кого-либо или что-либо очень изысканной, роскошной или высококачественной пищей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потчевать",
                                "target_lang_sense_clarification": "угощать изысканной едой"
                            },
                            {
                                "target_lang_word": "баловать",
                                "target_lang_sense_clarification": "давать что-то вкусное и дорогое"
                            },
                            {
                                "target_lang_word": "кормить деликатесами",
                                "target_lang_sense_clarification": "давать роскошную пищу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9565ef53-c215-3728-a8c9-470d47c48afa",
                    "sense_definition": "To put a diaper on someone, specifically referring to the brand name or its genericized use.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hygiene",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse had to <w>pamper</w> the infant before handing him back to his mother.",
                            "target_lang_translations": {
                                "ru": "Медсестре пришлось <w>надеть памперс</w> на младенца, прежде чем вернуть его матери."
                            }
                        },
                        {
                            "text": "It is time to <w>pamper</w> the baby again because he has been crying for several minutes.",
                            "target_lang_translations": {
                                "ru": "Пора снова <w>сменить памперс</w> малышу, потому что он плачет уже несколько минут."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "derived from brand name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Надевать подгузник на кого-либо (ироничное или разговорное использование названия бренда)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надевать памперс",
                                "target_lang_sense_clarification": "использование подгузника"
                            },
                            {
                                "target_lang_word": "пеленать",
                                "target_lang_sense_clarification": "в контексте смены подгузника"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a0bc12a2-2679-3191-b078-8819e8028afb",
                    "sense_definition": "A singular form of <w>pampers</w>, used to refer to a disposable diaper.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hygiene",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The toddler was running around the garden wearing nothing but a <w>pamper</w>.",
                            "target_lang_translations": {
                                "ru": "Малыш бегал по саду в одном только <w>памперсе</w>."
                            }
                        },
                        {
                            "text": "She realized she forgot to pack a clean <w>pamper</w> in the diaper bag before leaving.",
                            "target_lang_translations": {
                                "ru": "Она поняла, что забыла положить чистый <w>памперс</w> в сумку с вещами ребенка перед выходом."
                            }
                        }
                    ],
                    "synonyms": [
                        "nustle"
                    ],
                    "common_phrases": [
                        "wear a pamper",
                        "change a pamper"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "genericized trademark"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "common in some dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговорное обозначение одноразового подгузника."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "памперс",
                                "target_lang_sense_clarification": "одноразовый подгузник"
                            },
                            {
                                "target_lang_word": "подгузник",
                                "target_lang_sense_clarification": "общее название"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}