                    {
                        "sense_id": "19dfefff-5345-33f8-8b26-6974afa4e91a",
                        "entry_id": "818c0476-45f0-3758-bbc1-cc80ea2eae40",
                        "glosses": [
                            "Massage effectué à l’aide de jets d’eau, de bulles d’air ou de pression dans l’eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3430b6ac-66c4-4ed3-9c08-7dc29e44cf9f",
                                "sense_id": "19dfefff-5345-33f8-8b26-6974afa4e91a",
                                "text": "La douche sous un autre angle avec cet innovant système d’hydromassage personnalisable qui s’encastre totalement dans le mur et/ou dans le plafond."
                            },
                            {
                                "example_id": "6872472d-194d-480a-af60-ad6604a94f1a",
                                "sense_id": "19dfefff-5345-33f8-8b26-6974afa4e91a",
                                "text": "À la surface, le spa propose une large gamme de traitements, Certains, comme les inhalations thermales, sont destinés à des affections particulières. D’autres, come les hydromassages et les enveloppements, ont le plaisir pour seul objectif."
                            },
                            {
                                "example_id": "652fd7c2-9ff8-4aff-968d-ad4d7e0e3e94",
                                "sense_id": "19dfefff-5345-33f8-8b26-6974afa4e91a",
                                "text": "Le lendemain : hydromassage manuel pour une bonne circulation sanguine, complété par une douche à jet."
                            }
                        ]
                    }
                ],
