                "senses": [
                    {
                        "sense_id": "f52e37f5-a997-3def-9c88-e2614492e0b5",
                        "entry_id": "7a5e52e1-d582-3be9-922b-a1110f81ea69",
                        "glosses": [
                            "биол. способ воспроизведения потомства, при котором зародыш развивается в материнском организме, питается веществами, которые производит организм матери, и рождается в виде более или менее развитого живого детёныша, свободного от яйцевых оболочек"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "237f893e-9e4f-42d2-95c4-9f0c22e23858",
                                "sense_id": "f52e37f5-a997-3def-9c88-e2614492e0b5",
                                "text": "Живорождением называется такой способ размножения, при котором животное не несёт яиц, а рождает прямо детёнышей или личинок на разных стадиях развития; развитие зародыша из яйца протекает при этом ещё внутри материнского организма."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02bb5454-6582-4586-a4b2-c45253c784a3",
                        "source_entry_id": "7a5e52e1-d582-3be9-922b-a1110f81ea69",
                        "source_sense_id": "f52e37f5-a997-3def-9c88-e2614492e0b5",
                        "target_lang_word": "viviparity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "viviparity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee522fb3-7a4e-3558-8fcf-7b857d9bffa7",
                                        "entry_id": "2356140b-7d13-3d29-a0fb-254490e969c3",
                                        "glosses": [
                                            "The condition of being viviparous."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b3f95bf-c979-47e8-a862-038806d1a0bc",
                                                "sense_id": "ee522fb3-7a4e-3558-8fcf-7b857d9bffa7",
                                                "text": "Not all of the wholly viviparous lygosomine genera are likely to represent independent origins of viviparity; some may have inherited viviparity from a live-bearing ancestor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
