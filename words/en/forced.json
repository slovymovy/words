{
    "word_family": [
        "force",
        "forceful",
        "forcibly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "564f15de-94bd-3786-8f23-ad40f03c30ba",
                    "sense_definition": "Obtained or achieved through the use of physical power or coercion rather than naturally.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "coercion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>forced</w> labor continued for many years under the harsh regime.",
                            "target_lang_translations": {
                                "zh": "在这种严酷的政权下，<w>强制</w>劳动持续了很多年。"
                            }
                        },
                        {
                            "text": "They were subjected to <w>forced</w> migration during the conflict.",
                            "target_lang_translations": {
                                "zh": "冲突期间，他们被迫经历了<w>强制</w>迁移。"
                            }
                        }
                    ],
                    "synonyms": [
                        "forcible"
                    ],
                    "common_phrases": [
                        "forced labor",
                        "forced migration"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过武力、胁迫或非自然手段获得的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "强迫的",
                                "target_lang_sense_clarification": "指通过外力或压力强加的。"
                            },
                            {
                                "target_lang_word": "强制的",
                                "target_lang_sense_clarification": "指由权威或力量施加的。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4bbef8c-1b76-3cba-8b70-a6551154cfe8",
                    "sense_definition": "Produced by effort or strain; lacking spontaneity or sincerity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "insincerity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor gave a <w>forced</w> smile during the awkward interview.",
                            "target_lang_translations": {
                                "zh": "在尴尬的采访中，这位演员露出了<w>勉强</w>的微笑。"
                            }
                        },
                        {
                            "text": "Her <w>forced</w> laughter made everyone in the room feel uncomfortable.",
                            "target_lang_translations": {
                                "zh": "她那<w>勉强</w>的笑声让房间里的每个人都感到不自在。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "forced smile",
                        "forced laughter"
                    ],
                    "target_lang_definitions": {
                        "zh": "因努力或紧张而产生，缺乏自发性或真诚。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "勉强的",
                                "target_lang_sense_clarification": "指不情愿或不自然的。"
                            },
                            {
                                "target_lang_word": "做作的",
                                "target_lang_sense_clarification": "指虚假或不真诚的。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e38dfdf9-7156-3717-bb5a-d3b9fe0b7dda",
                    "sense_definition": "Opened or accessed by breaking or using physical force.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "coercion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police discovered a <w>forced</w> entry at the back of the building.",
                            "target_lang_translations": {
                                "zh": "警方在建筑物后方发现了<w>强行进入</w>的痕迹。"
                            }
                        },
                        {
                            "text": "The <w>forced</w> door showed clear signs of a break-in.",
                            "target_lang_translations": {
                                "zh": "那扇被<w>强行</w>打开的门上有明显的破门痕迹。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "forced entry"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过破坏或使用物理力量打开或进入的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "强行进入的",
                                "target_lang_sense_clarification": "指通过破坏手段进入的。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "61e54b04-a5e0-3597-b8f6-ec1984ab9108",
                    "sense_definition": "Simple past and past participle of <w>force</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strong wind <w>forced</w> the tree to bend over.",
                            "target_lang_translations": {
                                "zh": "大风<w>迫使</w>树木弯下了腰。"
                            }
                        },
                        {
                            "text": "He <w>forced</w> himself to finish the difficult task on time.",
                            "target_lang_translations": {
                                "zh": "他<w>强迫</w>自己按时完成了这项艰巨的任务。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "强迫、迫使（force的过去式和过去分词）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "强迫",
                                "target_lang_sense_clarification": "指施加压力使某人做某事。"
                            },
                            {
                                "target_lang_word": "迫使",
                                "target_lang_sense_clarification": "指因某种力量而不得不做某事。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}