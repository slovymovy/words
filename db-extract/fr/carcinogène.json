                    {
                        "sense_id": "59814c54-0098-370b-8ab0-b8c884dde707",
                        "entry_id": "1254e411-90b8-30d5-83ff-610c4ef51c96",
                        "glosses": [
                            "Substance qui peut provoquer un cancer."
                        ],
                        "tags": [
                            "Toxicologie"
                        ],
                        "examples": [
                            {
                                "example_id": "57db397f-2562-4e9c-9d6f-28b64883bc1a",
                                "sense_id": "59814c54-0098-370b-8ab0-b8c884dde707",
                                "text": "Au cours des années 1970, des résultats d'études ont démontré que le sacharrinate de sodium constitue un carcinogène pour les rats de laboratoire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83f1b2c4-f3e2-43b1-ad84-90d4af2f3f39",
