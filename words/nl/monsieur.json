            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1cd89905-6080-334a-a6a0-98d848de5228",
                    "sense_definition": "Een aanspreektitel of aanduiding voor een aanzienlijk man, vaak met een Franse achtergrond of in een formele context.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "aanspreektitel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de achttiende eeuw woonde zij in Den Haag ten huize van <w>Monsieur</w> Tak.",
                            "target_lang_translations": {
                                "en": "In the eighteenth century, she lived in The Hague at the home of <w>Monsieur</w> Tak."
                            }
                        },
                        {
                            "text": "De bediende kondigde de komst van <w>monsieur</w> Le Grand plechtig aan.",
                            "target_lang_translations": {
                                "en": "The servant solemnly announced the arrival of <w>Monsieur</w> Le Grand."
                            }
                        }
                    ],
                    "synonyms": [
                        "heer",
                        "meneer"
                    ],
                    "antonyms": [
                        "madame"
                    ],
                    "common_phrases": [
                        "monsieur en madame"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt voor personen met een Franse achtergrond"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A title of address or designation for a man of standing, often with a French background or in a formal context."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Monsieur",
                                "target_lang_sense_clarification": "French title of respect"
                            },
                            {
                                "target_lang_word": "Sir",
                                "target_lang_sense_clarification": "formal address for a man"
                            },
                            {
                                "target_lang_word": "Mr.",
                                "target_lang_sense_clarification": "formal title before a name"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2163442-c817-3672-9725-e1f0a2b92439",
                    "sense_definition": "Een specifieke benaming voor een leraar Frans op een middelbare school.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "onderwijs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de Franse les van <w>monsieur</w> Zwaard leerden we de gedichten van Rimbaud.",
                            "target_lang_translations": {
                                "en": "During <w>Monsieur</w> Zwaard's French class, we learned the poems of Rimbaud."
                            }
                        },
                        {
                            "text": "De leerlingen noemden hun leraar Frans altijd respectvol <w>monsieur</w>.",
                            "target_lang_translations": {
                                "en": "The students always respectfully called their French teacher <w>Monsieur</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "leraar"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "specifiek in de context van onderwijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A specific designation for a French teacher at a secondary school."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Monsieur",
                                "target_lang_sense_clarification": "title for a French teacher"
                            },
                            {
                                "target_lang_word": "French teacher",
                                "target_lang_sense_clarification": "the profession itself"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c75f1a49-863d-38eb-979b-78e207d1f775",
                    "sense_definition": "Een overdreven plechtige of ironische aanspreekvorm voor een man.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "aanspreektitel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kijk eens hier <w>Monsieur</w>, zei zijn vader terwijl hij met het geld zwaaide.",
                            "target_lang_translations": {
                                "en": "Look at this, <w>Monsieur</w>, his father said while waving the money."
                            }
                        },
                        {
                            "text": "Doe niet zo gewichtig <w>monsieur</w>, we weten allemaal wie je bent.",
                            "target_lang_translations": {
                                "en": "Don't act so important, <w>Monsieur</w>, we all know who you are."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak ironisch of spottend bedoeld"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An overly solemn or ironic form of address for a man."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Monsieur",
                                "target_lang_sense_clarification": "ironic or mock-formal title"
                            },
                            {
                                "target_lang_word": "Mr. Important",
                                "target_lang_sense_clarification": "sarcastic designation"
                            },
                            {
                                "target_lang_word": "Sir",
                                "target_lang_sense_clarification": "mocking formal address"
                            }
                        ]
                    }
                }
            ]
        }
    ]
