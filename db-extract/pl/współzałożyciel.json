                        "entry_id": "7693b5cc-5413-374b-bd90-1652a691c0d6",
                        "glosses": [
                            "osoba mająca współudział w założeniu czegoś"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ad305c1-fcce-47be-9c58-5486484c29c8",
                                "sense_id": "bd5dbca1-dfc2-3fd3-938b-2bdac836624d",
                                "text": "W Kościele katolickim na 29 czerwca przypada święto ku czci św. św. Piotra i Pawła, współzałożycieli gminy chrześcijańskiej w Rzymie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8568f2a3-6625-4b9e-b4a9-676a013483d1",
                        "source_entry_id": "7693b5cc-5413-374b-bd90-1652a691c0d6",
                        "source_sense_id": "bd5dbca1-dfc2-3fd3-938b-2bdac836624d",
                        "target_lang_word": "cofounder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cofounder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83956229-d7f7-3329-9e54-98f48639e650",
                                        "entry_id": "96225067-9afe-362c-aaf3-9d2de1e78525",
                                        "glosses": [
                                            "A joint founder; one of several people involved with the creation of a business, organization, union, or entity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dcd7610-89ec-4551-8fca-a952c3ba48a6",
                                                "sense_id": "83956229-d7f7-3329-9e54-98f48639e650",
                                                "text": "The two cofounders both attended the ceremony."
                                            },
                                            {
                                                "example_id": "dd9fee13-4008-4b07-8e86-48b1c9092ac5",
                                                "sense_id": "83956229-d7f7-3329-9e54-98f48639e650",
                                                "text": "Miramax Films cofounders Bob and Harvey Weinstein will end their successful, but often tumultuous, 12-year relationship with The Walt Disney Company to launch their own media company."
                                            },
                                            {
                                                "example_id": "ea82f5bd-174f-4384-bdab-73d12908c78a",
                                                "sense_id": "83956229-d7f7-3329-9e54-98f48639e650",
                                                "text": "Maria Ressa, the chief executive and cofounder of Rappler, and Dmitry Muratov, the editor-in-chief of Novaya Gazeta, were named as this year’s laureates by Berit Reiss-Andersen, the chair of the Norwegian Nobel committee."
                                            },
                                            {
                                                "example_id": "7ef00a73-4646-4ff1-b847-49b51e6d6d4b",
                                                "sense_id": "83956229-d7f7-3329-9e54-98f48639e650",
                                                "text": "Details of Thunberg’s charge came as Just Stop Oil said its cofounders, Indigo Rumbelow and Roger Hallam, were arrested on Wednesday morning following dawn raids at their homes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d37f7e6-4f3f-4101-9eb4-4aa58b598640",
                        "source_entry_id": "7693b5cc-5413-374b-bd90-1652a691c0d6",
                        "source_sense_id": "bd5dbca1-dfc2-3fd3-938b-2bdac836624d",
                        "target_lang_word": "cofondateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cofondateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "238d535c-99f7-3c36-966f-204ddd281179",
                                        "entry_id": "842add76-c7aa-3115-a90a-d7f302255e57",
                                        "glosses": [
                                            "Personne qui est a fondé quelque chose avec d’autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac40d73e-d3cd-462c-87df-b54cfd61c59c",
                                                "sense_id": "238d535c-99f7-3c36-966f-204ddd281179",
                                                "text": "P… forma, avec le concours de plusieurs cofondateurs, une société d'assurances à primes fixes contre l'incendie."
                                            },
                                            {
                                                "example_id": "3a1ff5b2-fe2d-4936-b924-1830a26f7f73",
                                                "sense_id": "238d535c-99f7-3c36-966f-204ddd281179",
                                                "text": "Nous développons une “tokenisation” de licence de jeux vidéo, explique David Hanson, cofondateur et PDG d’Ultra.io."
                                            },
                                            {
                                                "example_id": "21f57355-5662-470c-a4f0-e5241cad222c",
                                                "sense_id": "238d535c-99f7-3c36-966f-204ddd281179",
                                                "text": "Mattel, provenant de la contraction du nom de ses deux cofondateurs (Harold « Matt » Matson et Elliot Handler), a vu le jour en 1945 et concevait à l’origine des accessoires pour poupées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
