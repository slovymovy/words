                        "glosses": [
                            "That which comes off or the act or process of coming off; emission."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "749d40ec-ca65-4107-9b6f-e2b58723c93f",
                                "sense_id": "fdded082-b50f-3efa-aed5-e63a2c9a3fcf",
                                "text": "[…] to observe as regards exact direction, owing (especially in the instance of pretty bright meteors) to the dense offcome of sparks from the nucleus, or to the phosphorescence it generates as the result of concussion with the air."
                            }
                        ]
                    },
                    {
