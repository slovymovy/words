                "senses": [
                    {
                        "sense_id": "b9a3e022-4555-3981-ade6-dd77bcd4a99b",
                        "entry_id": "4019db6b-cad8-31ff-82cb-d0c5d5f80653",
                        "glosses": [
                            "Surveiller à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08228929-34f0-42c4-b933-4569ae409e25",
                                "sense_id": "b9a3e022-4555-3981-ade6-dd77bcd4a99b",
                                "text": "Le foret à surveiller, le disque à surveiller, le disque à changer après trois minutes, ce foret à resurveiller, le sillon à surveiller pendant qu'on joue, penser que ça fait un morceau quand justement on n'aime pas les morceaux, mais les répétitions, les longueurs, le petit bonhomme de chemin, et pas de chemin, revenir, retenir à la même chose, être litanie, litanie comme la vie, être longtemps avant de finir, ne pas tellement se décider à faire musique d'homme et surtout pas de compositeur, et surtout pas d'Occidental et plutôt faisant musique de moineau, de moineau pas très décidé, perché sur une branche, de moineau qui essaierait d'appeler un homme..."
                            },
                            {
                                "example_id": "5f29e4c7-ed15-4560-8b7f-da25df3a5599",
                                "sense_id": "b9a3e022-4555-3981-ade6-dd77bcd4a99b",
                                "text": "Il faut tout surveiller et resurveiller soi-même."
                            }
                        ]
                    }
