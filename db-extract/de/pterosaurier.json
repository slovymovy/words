                        "entry_id": "d562044f-9267-3a52-b73f-b22513cb67e1",
                        "glosses": [
                            "ausgestorbenes Reptil, das in der Lage war zu fliegen und etwa gleichzeitig mit den Dinosauriern lebte"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "c9e2dae5-bf62-40e0-99c4-94be2ed10575",
                                "sense_id": "5daed9ac-46f3-30b8-bf1c-cfe74a85eeff",
                                "text": "„Während der Kreide dominierten Pterosaurier die Lüfte, während Haie schon im Meer unterwegs waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
