                        "glosses": [
                            "Donner un caractère ventral à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1f113f8-f147-456c-92af-0b8000ab5737",
                                "sense_id": "254e2aa0-c8c4-313f-b6a7-040b450eded7",
                                "text": "Cela suggère que l’acide rétinoïque agit pour ventraliser le blastème, et les parties régénérées naissent après une interaction entre le blastème et le tissu du moignon nouvellement dédifférencié."
                            },
                            {
                                "example_id": "9a7fb79b-71cd-451f-848a-255b5d8ec52f",
                                "sense_id": "254e2aa0-c8c4-313f-b6a7-040b450eded7",
                                "text": "L’une d’elles consista à découvrir un facteur qui, très tôt, induit les cellules « dorsalisantes par défaut » à se « ventraliser »."
                            }
                        ]
                    }
