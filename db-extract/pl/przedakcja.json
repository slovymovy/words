                "translations": [
                    {
                        "translation_id": "15606670-ccdf-4a59-ada0-56f1c9b5f90d",
                        "source_entry_id": "16b2ed64-9abb-3656-88f4-ca67f9d107d8",
                        "source_sense_id": "096ef22f-c97e-3879-9656-8b62b768df10",
                        "target_lang_word": "backstory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "backstory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb538391-9fdd-3c88-be41-a422d4f345ab",
                                        "entry_id": "61faa5c9-46e3-37f2-9e9e-0267657d6f16",
                                        "glosses": [
                                            "The previous experiences and life of a person, specifically (narratology, especially in film, television) a character in a dramatic work."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e5c723e-b399-4412-9ab5-6a53280bb58c",
                                                "sense_id": "eb538391-9fdd-3c88-be41-a422d4f345ab",
                                                "text": "Inexplicably, and at great risk to the integrity of the movie, the filmmakers have burdened him with a psychological back story pulled out of a folder in some studio filing cabinet. Why does [Willy] Wonka spend his days confecting sweets?"
                                            },
                                            {
                                                "example_id": "200da8ed-b9b7-4bcf-bb21-43c8bfdfc2c2",
                                                "sense_id": "eb538391-9fdd-3c88-be41-a422d4f345ab",
                                                "text": "What’s the backstory of our new colleague?"
                                            },
                                            {
                                                "example_id": "5857fbc8-4f8d-435d-b03b-2174dfad3616",
                                                "sense_id": "eb538391-9fdd-3c88-be41-a422d4f345ab",
                                                "text": "These backstories cast the characters' behavior in a new light: of course Gertrude would promptly marry the man who saved her from abuse; of course Ophelia would be desperate and indiscreet in seeking Hamlet's love."
                                            },
                                            {
                                                "example_id": "6e5b568e-ff15-4cba-bacb-d88013bb09db",
                                                "sense_id": "eb538391-9fdd-3c88-be41-a422d4f345ab",
                                                "text": "Agent Lyla: Enough back story! / Dr. Doofenshmirtz: Actually, that's not, uh … that's not really a back story, it's just expositional flashback. It doesn't, uh, have any childhood trauma, it's doesn't really inform who he is, it's not … it's just flashback. There's a difference. It's subtle, but there's a difference."
                                            },
                                            {
                                                "example_id": "adb0d8a0-db85-4143-8c08-1e61b14e1704",
                                                "sense_id": "eb538391-9fdd-3c88-be41-a422d4f345ab",
                                                "text": "Prince Harry may yet turn out to be the crown’s best insurance policy. By marrying Meghan Markle, he is linking royalty with a 21st-century celebrity who has a backstory that many people in Britain can identify with."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dffa3018-b1ea-3cc4-9ae6-0b1eaacd172b",
                                        "entry_id": "61faa5c9-46e3-37f2-9e9e-0267657d6f16",
                                        "glosses": [
                                            "A fictitious account of a person's history designed to conceal their actual history and motives."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
