{
    "word_family": [
        "intend",
        "intentional",
        "intentionally",
        "unintentional",
        "unintentionally",
        "intent",
        "intended",
        "unintended"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "80094402-ad50-3f99-9711-cb941b183911",
                    "sense_definition": "A course of action or plan that a person has decided to follow.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have no <w>intention</w> of changing my plans just to please him.",
                            "target_lang_translations": {
                                "ru": "У меня нет никакого <w>намерения</w> менять свои планы только ради того, чтобы угодить ему.",
                                "zh": "我没有<w>打算</w>仅仅为了取悦他就改变我的计划。"
                            }
                        },
                        {
                            "text": "Her <w>intention</w> was to finish the project before the weekend.",
                            "target_lang_translations": {
                                "ru": "Её <w>намерением</w> было закончить проект до выходных.",
                                "zh": "她的<w>打算</w>是在周末前完成这个项目。"
                            }
                        },
                        {
                            "text": "He went to the meeting with the <w>intention</w> of resigning.",
                            "target_lang_translations": {
                                "ru": "Он пошёл на собрание с <w>намерением</w> уволиться.",
                                "zh": "他带着辞职的<w>意图</w>去参加了会议。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plan",
                        "intent",
                        "aim",
                        "purpose",
                        "goal"
                    ],
                    "antonyms": [
                        "chance"
                    ],
                    "common_phrases": [
                        "have no intention",
                        "good intentions",
                        "with the intention"
                    ],
                    "target_lang_definitions": {
                        "ru": "План действий или решение, которое человек принял для выполнения.",
                        "zh": "一个人决定要执行的行动方针或计划。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "намерение",
                                "target_lang_sense_clarification": "желание или решение сделать что-либо"
                            },
                            {
                                "target_lang_word": "замысел",
                                "target_lang_sense_clarification": "задуманный план действий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打算",
                                "target_lang_sense_clarification": "指经过考虑后决定要做某事"
                            },
                            {
                                "target_lang_word": "意图",
                                "target_lang_sense_clarification": "指做某事的想法或目的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67c48aab-1430-3bec-9f4d-0f127d147ee6",
                    "sense_definition": "The goal, purpose, or objective of something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>intention</w> of this new law is to reduce traffic accidents.",
                            "target_lang_translations": {
                                "ru": "<w>Целью</w> этого нового закона является снижение количества дорожно-транспортных происшествий.",
                                "zh": "这项新法律的<w>目的</w>是减少交通事故。"
                            }
                        },
                        {
                            "text": "It was not the <w>intention</w> of the author to offend anyone.",
                            "target_lang_translations": {
                                "ru": "В <w>намерения</w> автора не входило кого-либо оскорбить.",
                                "zh": "作者并无冒犯任何人的<w>意图</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aim",
                        "intent",
                        "plan"
                    ],
                    "common_phrases": [
                        "intention of",
                        "original intention"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цель, назначение или задача чего-либо.",
                        "zh": "某事物的目标、目的或宗旨。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цель",
                                "target_lang_sense_clarification": "то, к чему стремятся; назначение"
                            },
                            {
                                "target_lang_word": "намерение",
                                "target_lang_sense_clarification": "осознанная цель или мотив"
                            },
                            {
                                "target_lang_word": "замысел",
                                "target_lang_sense_clarification": "основная идея или план создания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "目的",
                                "target_lang_sense_clarification": "想要达到的境地或结果"
                            },
                            {
                                "target_lang_word": "宗旨",
                                "target_lang_sense_clarification": "主要的目的或意图"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28ae7e6b-4da4-3e85-9a35-eb1fd18b4305",
                    "sense_definition": "The process by which a wound heals.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clean surgical cut healed by primary <w>intention</w> without infection.",
                            "target_lang_translations": {
                                "ru": "Чистый хирургический разрез зажил первичным <w>натяжением</w> без инфекции.",
                                "zh": "干净的手术切口通过一期<w>愈合</w>，没有发生感染。"
                            }
                        },
                        {
                            "text": "Wounds that are left open to heal by secondary <w>intention</w> take longer to close.",
                            "target_lang_translations": {
                                "ru": "Раны, оставленные открытыми для заживления вторичным <w>натяжением</w>, закрываются дольше.",
                                "zh": "敞开进行二期<w>愈合</w>的伤口需要更长时间才能闭合。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "primary intention",
                        "secondary intention"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "medicine"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс заживления раны (медицинский термин).",
                        "zh": "伤口愈合的过程（医学术语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "натяжение",
                                "target_lang_sense_clarification": "способ соединения краев раны при заживлении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "愈合",
                                "target_lang_sense_clarification": "伤口闭合的过程"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "258c60d6-7ba0-3e56-9ef9-993a58c4ac4c",
                    "sense_definition": "To have as a plan or purpose; to intend.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>intentioned</w> to visit the museum, but it was closed.",
                            "target_lang_translations": {
                                "ru": "Он <w>намеревался</w> посетить музей, но тот был закрыт.",
                                "zh": "他本<w>打算</w>去参观博物馆，但博物馆关门了。"
                            }
                        },
                        {
                            "text": "They had <w>intentioned</w> a different outcome for the project.",
                            "target_lang_translations": {
                                "ru": "Они <w>планировали</w> другой исход для проекта.",
                                "zh": "他们原本为这个项目<w>打算</w>了不同的结果。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "rare or non-standard"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь в качестве плана или цели; намереваться.",
                        "zh": "有计划或目的；打算。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "намереваться",
                                "target_lang_sense_clarification": "иметь намерение сделать что-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打算",
                                "target_lang_sense_clarification": "计划做某事"
                            },
                            {
                                "target_lang_word": "企图",
                                "target_lang_sense_clarification": "打算做某事（多含贬义）"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}