                },
                {
                    "sense_id": "f7685690-0e86-324d-af60-08d13ef08d85",
                    "sense_definition": "Cortège qui accompagne le corps du défunt jusqu'au lieu de son inhumation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>enterrement</w> avançait lentement le long de la rue principale bordée de cyprès."
                        },
                        {
                            "text": "Les passants se sont arrêtés et ont ôté leur chapeau au passage de l'<w>enterrement</w>."
