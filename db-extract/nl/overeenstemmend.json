                    {
                        "sense_id": "b1d42687-bca6-3cf0-9928-8e9bdce578f3",
                        "entry_id": "0c99ab7e-37c3-3629-8b8a-df632707e807",
                        "glosses": [
                            "twee of meer zaken die gelijk aan elkaar zijn; twee of meer zaken die bij elkaar passen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b978f56-5fad-41aa-a763-eb92bfda19f3",
                                "sense_id": "b1d42687-bca6-3cf0-9928-8e9bdce578f3",
                                "text": "Onderwijsdirecteur HAVO/VWO van Het Assink Lyceum Lea Meijnen: „We hebben twee niet overeenstemmende visies en daarom willen we deze kwestie niet verder uitvechten en laten we de waarheid in het midden”, aldus Meijnen."
                            },
                            {
                                "example_id": "3537115e-f137-4720-8b79-b74359368c1e",
                                "sense_id": "b1d42687-bca6-3cf0-9928-8e9bdce578f3",
                                "text": "Door verder te bouwen op een snel oplaadbaar kathode-ontwerp van professor Paul Braun kon een overeenstemmende anode gebouwd worden. De microbatterijen zouden tot duizend keer sneller kunnen laden dan de huidige technologie. In theorie zou een flinterdunne telefoon binnen minder dan een seconde opgeladen zijn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3765a7c2-e2f4-476f-aca5-929b448540c1",
                        "source_entry_id": "0c99ab7e-37c3-3629-8b8a-df632707e807",
