                    {
                        "sense_id": "134820f6-5ba0-3cb6-ac5b-16900a88cb28",
                        "entry_id": "61671106-9eef-3409-8ae0-76525c546ed3",
                        "glosses": [
                            "of uitvaartstoet is een stoet gevormd door rouwende mensen, die de overledene naar zijn laatste rustplaats vergezellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa62e940-9f69-4436-8669-c2af822d13a0",
                                "sense_id": "134820f6-5ba0-3cb6-ac5b-16900a88cb28",
                                "text": "Het afscheid van de gestorven graaf is officieel een privéaangelegenheid. Maar een rouwstoet met vijfhonderd genodigden die van de Grote Kerk in het centrum van Almelo naar het mausoleum op het grafelijke landgoed ten oosten van de stad wandelt is ook een publieke aangelegenheid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53b55a20-1c3b-41e5-b7f4-9ab0dccf5d26",
                        "source_entry_id": "61671106-9eef-3409-8ae0-76525c546ed3",
                        "source_sense_id": "134820f6-5ba0-3cb6-ac5b-16900a88cb28",
                        "target_lang_word": "Trauerzug",
                        "target_lang_code": "de",
