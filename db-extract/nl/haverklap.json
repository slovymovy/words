                            {
                                "example_id": "d8637dc3-fa5e-4906-8866-f166ff0a7e05",
                                "sense_id": "643685f2-963c-33a7-a0ae-4ad797ee4ff6",
                                "text": "Hij was om de haverklap verkouden."
                            },
                            {
                                "example_id": "d1af08f9-9ea1-4477-996f-84166db1a0b5",
                                "sense_id": "643685f2-963c-33a7-a0ae-4ad797ee4ff6",
                                "text": "Dagenlang liep ik door bergweides die bezaaid waren met ontelbare bosbessenstruiken. Om de haverklap stopte ik om de zoete bessen te plukken waardoor mijn handen paars kleurden van hun sap."
                            },
                            {
                                "example_id": "534fbbaa-1ca2-4e73-aee4-eb3fa79b711a",
                                "sense_id": "643685f2-963c-33a7-a0ae-4ad797ee4ff6",
                                "text": "Oscar gebruikte die uitdrukking om de haverklap toen ze in Berlijn woonden."
                            }
                        ]
                    }
