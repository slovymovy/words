                        "cross_references": []
                    },
                    {
                        "translation_id": "43ca2c40-1c75-4968-8823-98cec1a91880",
                        "source_entry_id": "bd13579b-9cae-3b5a-96f0-2684275c4f47",
                        "source_sense_id": "a63c4a77-acc9-331f-a702-dc44faadefc1",
                        "target_lang_word": "vitral",
                        "target_lang_code": "es",
