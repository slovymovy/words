                    {
                        "sense_id": "f27b9d3d-8660-3d46-b05a-e487f9c7d05c",
                        "entry_id": "ce85ac8e-15f0-3687-b069-710233ebb704",
                        "glosses": [
                            "eenvoudig rond kapje dat op het hoofd wordt gedragen, vooral over een tonsuur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1ebf668-1d85-4af1-a128-03284b289dda",
                                "sense_id": "f27b9d3d-8660-3d46-b05a-e487f9c7d05c",
                                "text": "De 79-jarige Duitse kerkvorst liep door de zwarte ijzeren poort van Auschwitz met daarop de wereldberoemde tekst 'Arbeit Macht Frei'. Daarna zette hij zijn witte kalot af om te bidden bij de muur waar talloze gevangenen van de nazi's werden terechtgesteld."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b0d2e30-bcef-31ef-b31d-fdb9362bd66c",
                        "entry_id": "ce85ac8e-15f0-3687-b069-710233ebb704",
                        "glosses": [
                            "verlaagd plafond in de vorm van een rond gewelf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe189bba-2fc6-482a-918c-bd83fec92e09",
                                "sense_id": "3b0d2e30-bcef-31ef-b31d-fdb9362bd66c",
                                "text": "De middenbeuk heeft een tongewelf van stucwerk op latten, de zijbeuken hebben koofplafonds, en de halfronde apsis een kalot met cassetteversiering."
                            }
                        ]
                    }
