                        "form": "die Ortschaften"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "134a0dd1-0e84-3d6f-9a82-520ce2456c25",
                        "entry_id": "07892e04-9d93-3dbc-b308-c2de7bc1a50b",
                        "glosses": [
                            "zusammenhängendes Siedlungsgebiet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b082db08-6c7b-4c58-b642-c62504f516c7",
                                "sense_id": "134a0dd1-0e84-3d6f-9a82-520ce2456c25",
                                "text": "Nach 10 km taucht dann linker Hand eine Ortschaft auf."
                            },
                            {
                                "example_id": "9219fcaf-a2b1-4fb8-a55d-58f145379aa1",
                                "sense_id": "134a0dd1-0e84-3d6f-9a82-520ce2456c25",
                                "text": "„Doch auch die Bertinis waren auf seltsame Weise mit der Ortschaft verbunden.“"
                            },
                            {
                                "example_id": "1a24e9c5-aa77-473c-af57-bfaa1b73d940",
                                "sense_id": "134a0dd1-0e84-3d6f-9a82-520ce2456c25",
                                "text": "„Am Ende hatte man die Ortschaft offenbar von der tief gelegenen Straße aus verteidigt, nur wenige oder gar keine Österreicher hatten sich dorthin zurückziehen können.“"
                            },
                            {
                                "example_id": "c9dae7d7-f45b-48de-a712-65555cd1cb72",
                                "sense_id": "134a0dd1-0e84-3d6f-9a82-520ce2456c25",
                                "text": "„Während die Herero den überwiegenden Teil ihres Landes befreiten, mussten sich die Deutschen in die Ortschaften zurückziehen und sich dort verschanzen.“"
                            },
                            {
                                "example_id": "53e80d73-43da-42aa-86a9-8a5078df5bdc",
                                "sense_id": "134a0dd1-0e84-3d6f-9a82-520ce2456c25",
                                "text": "„Der Name der Ortschaft prangte fetter auf den Landkarten, als die Südafrikanischen Verteidigungsstreitkräfte 1978 dort einen Militärposten errichteten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "206e8ca9-f1e6-3318-a9d9-c0a52048379f",
                        "entry_id": "07892e04-9d93-3dbc-b308-c2de7bc1a50b",
                        "glosses": [
                            "Teil einer Gemeinde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11754b10-6014-4a46-8a61-46325c34c892",
                                "sense_id": "206e8ca9-f1e6-3318-a9d9-c0a52048379f",
                                "text": "Hunteburg ist mit knapp 4.000 Einwohnern die zweitgrößte Ortschaft in der Gemeinde Bohmte."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b311d59-a3f3-4c12-8a6e-50b476d622f3",
                        "source_entry_id": "07892e04-9d93-3dbc-b308-c2de7bc1a50b",
                        "source_sense_id": "134a0dd1-0e84-3d6f-9a82-520ce2456c25",
                        "source_sense_description": "zusammenhängendes Siedlungsgebiet",
                        "target_lang_word": "village",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "village",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6dbb08ec-1a56-31c6-afa9-aecbcc4aa373",
                                        "entry_id": "26ea3d09-ee9f-37fc-afd3-647dcd5a0c24",
                                        "glosses": [
                                            "A rural habitation of size between a hamlet and a town."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb8f093d-78cf-4b06-8e7f-811320c300e9",
                                                "sense_id": "6dbb08ec-1a56-31c6-afa9-aecbcc4aa373",
                                                "text": "There are 2 churches and 3 shops in our village."
                                            },
                                            {
                                                "example_id": "1073d7df-2b2a-48f1-85d5-7bdf53ebb8b1",
                                                "sense_id": "6dbb08ec-1a56-31c6-afa9-aecbcc4aa373",
                                                "text": "[…]belts of thin white mist streaked the brown plough land in the hollow where Appleby could see the pale shine of a winding river. Across that in turn, meadow and coppice rolled away past the white walls of a village bowered in orchards,[…]"
                                            },
                                            {
                                                "example_id": "a37b78fc-af8b-4cd4-9902-e49b5f2de17e",
                                                "sense_id": "6dbb08ec-1a56-31c6-afa9-aecbcc4aa373",
                                                "text": "The principal economic activity is copra production, the Government copra plantation covering some 5,170 ha. The population in 1989 was estimated at 2,000, the great majority of whom live in London, Banana and Poland villages in the west."
                                            },
                                            {
                                                "example_id": "c7b63bab-a7b4-4044-9f12-d3d136400ef5",
                                                "sense_id": "6dbb08ec-1a56-31c6-afa9-aecbcc4aa373",
                                                "text": "Floods in northern India, mostly in the small state of Uttarakhand, have wrought disaster on an enormous scale. The early, intense onset of the monsoon on June 14th swelled rivers, washing away roads, bridges, hotels and even whole villages."
                                            },
                                            {
                                                "example_id": "11d30e64-baf1-4548-95b1-0ea6bf9e8607",
                                                "sense_id": "6dbb08ec-1a56-31c6-afa9-aecbcc4aa373",
                                                "text": "It’s just offshore from private property inaccessible to the general public, so a good way to approach the rock is by kayak, which can be rented in the small village of Port Austin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f69ef7dd-dd38-3a5a-9fed-dd5338794462",
                                        "entry_id": "26ea3d09-ee9f-37fc-afd3-647dcd5a0c24",
                                        "glosses": [
                                            "A rural habitation that has a church, but no market."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e738d21-d1c1-395b-b985-8d6ccdade342",
                                        "entry_id": "26ea3d09-ee9f-37fc-afd3-647dcd5a0c24",
                                        "glosses": [
                                            "A planned community such as a retirement community or shopping district."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4082b44-c79e-3d47-8bc9-7528d2c6906a",
                                        "entry_id": "26ea3d09-ee9f-37fc-afd3-647dcd5a0c24",
                                        "glosses": [
                                            "An exclusive gated community; a subdivision."
                                        ],
                                        "tags": [
                                            "Philippines"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55747db8-28da-4c44-858e-36af92b68198",
                                                "sense_id": "a4082b44-c79e-3d47-8bc9-7528d2c6906a",
                                                "text": "There are six blocks in our village, each having ten lots."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8354f37d-9aa7-423d-99ba-23fedab2b27a",
                        "source_entry_id": "07892e04-9d93-3dbc-b308-c2de7bc1a50b",
                        "source_sense_id": "134a0dd1-0e84-3d6f-9a82-520ce2456c25",
                        "source_sense_description": "zusammenhängendes Siedlungsgebiet",
                        "target_lang_word": "localité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "localité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e8d6282d-cece-3ab9-a83c-e130521bb5d6",
                                        "entry_id": "2c97b26f-75fe-3502-bee0-1e5234bad3ca",
                                        "glosses": [
                                            "Lieu habité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98171ba5-09cf-4f50-b2ee-5e8c719420fa",
                                                "sense_id": "e8d6282d-cece-3ab9-a83c-e130521bb5d6",
                                                "text": "L’arrivée du steamer est une fête pour les marchands danois exilés dans cette localité, qu'aucun fil télégraphique ne relie au reste du monde ; […]."
                                            },
                                            {
                                                "example_id": "2942c921-fb51-4a63-b121-2f7b359f08f6",
                                                "sense_id": "e8d6282d-cece-3ab9-a83c-e130521bb5d6",
                                                "text": "De même, pour le département de Seine-et-Marne, le dictionnaire topographique paru en 1954 permet de relever les noms de 87 localités disparues : 4 seulement sont données pour paroisses ou villages ; les autres sont des hameaux ou encore des écarts de 3 ou 4 maisons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "361b316a-bdc0-3747-9ab2-e91c390491a1",
                                        "entry_id": "2c97b26f-75fe-3502-bee0-1e5234bad3ca",
                                        "glosses": [
                                            "Petite ville, village, etc."
                                        ],
                                        "tags": [
                                            "Surtout"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cd8c74d-7a39-4ad4-b9ec-b4df2dd5f13a",
                                                "sense_id": "361b316a-bdc0-3747-9ab2-e91c390491a1",
                                                "text": "Le nom de la première localité rencontrée en entrant par le sud sur cet opulent territoire du Vouzinois sonne mal, avouons-le : Pauvres !"
                                            },
                                            {
                                                "example_id": "4be51907-c09c-426b-ab68-c5438b7657c0",
                                                "sense_id": "361b316a-bdc0-3747-9ab2-e91c390491a1",
                                                "text": "Rares et maigres, pauvres et silencieuses étaient les localités traversées et, dans celles-ci, nombreuses étaient les demeures manifestement abandonnées, les bicoques délabrées où tout en fait des ruines."
                                            },
                                            {
                                                "example_id": "52ea6206-a51f-4b18-b93a-e7e209afd90e",
                                                "sense_id": "361b316a-bdc0-3747-9ab2-e91c390491a1",
                                                "text": "Des localités aussi éloignées qu’Aussonce, Le Ménil, Lépinois, Germigny-pend-la-pie, entre Suippe et Retourne, acquittent également le droit de poiture."
                                            },
                                            {
                                                "example_id": "562bf3c3-bf40-4980-94b1-bc5d3d3844e8",
                                                "sense_id": "361b316a-bdc0-3747-9ab2-e91c390491a1",
                                                "text": "« (...). J'invite la population à faire preuve d'une extrême prudence et à diminuer de façon importante les contacts familiaux, et ce, dès maintenant, dans l'ensemble des villes et localités de la région.»"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39f61614-83c4-3616-bc5e-9c2ec9ec7b6c",
                                        "entry_id": "2c97b26f-75fe-3502-bee0-1e5234bad3ca",
                                        "glosses": [
                                            "Particularité ou circonstance locale : lieu, milieu."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c176839-a9f3-418e-a5f8-128e03e0cf8c",
                                                "sense_id": "39f61614-83c4-3616-bc5e-9c2ec9ec7b6c",
                                                "text": "On commence à comprendre de nos jours que la localité exacte est un des premiers éléments de la réalité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
