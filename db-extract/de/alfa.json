                "senses": [
                    {
                        "sense_id": "15f8b788-0b74-30f8-ace8-4e6a8300adfa",
                        "entry_id": "54d2ac56-53f7-32fd-8d3d-9c2b6f0a5c83",
                        "glosses": [
                            "im westlichen und südlichen Mittelmeerraum verbreitete Grasart, deren Blattfasern zur Herstellung von Seilen und Papier verwendet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "594952f7-1bd5-4f50-9c0f-ccb9f0d95274",
                                "sense_id": "15f8b788-0b74-30f8-ace8-4e6a8300adfa",
                                "text": "„Im gebrochenen Lichte der kurzen Dämmerung hatten die Gefangenen den Hof besichtigt und dann sich in eines der Zimmer zurückgezogen, wo mehrere Haufen getrockneter Alfa ihnen als Lagerstätten dienten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
