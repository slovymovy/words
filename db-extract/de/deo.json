                            "kurz"
                        ],
                        "examples": [
                            {
                                "example_id": "0294220f-0f9d-469a-b715-6ff5358bc67e",
                                "sense_id": "1b159b46-2d6f-3c08-9cf9-f49c4a3083a9",
                                "text": "Sein neues Deo hat einen sehr starken Duft."
                            },
                            {
                                "example_id": "64e351d4-e5d0-432e-9d0e-f7f1da7f3c52",
                                "sense_id": "1b159b46-2d6f-3c08-9cf9-f49c4a3083a9",
                                "text": "„Elma war froh, dass die Musik ihr pochendes Herz übertönte und sie daran gedacht hatte, Deo zu benutzen.“"
                            },
                            {
                                "example_id": "5529d6c4-053b-40a4-8c65-f612c4c28942",
                                "sense_id": "1b159b46-2d6f-3c08-9cf9-f49c4a3083a9",
                                "text": "„Mama besorgte die Deos bei Sara im Laden, bei Sachen, die für uns bestimmt waren, kam es nicht so drauf an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
