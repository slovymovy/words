                "senses": [
                    {
                        "sense_id": "c3f4e690-9024-32b5-8b9c-d65894da80b8",
                        "entry_id": "8f8d3c18-8bfa-369b-b8d7-4f9dec129f7f",
                        "glosses": [
                            "Homme responsable d’un établissement de bains."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "df9b4f3c-500a-4637-8810-8f567b7f76fc",
                                "sense_id": "c3f4e690-9024-32b5-8b9c-d65894da80b8",
                                "text": "En 1292, on comptait dans la capitale vingt-cinq patrons étuveurs et une étuveuse."
                            },
                            {
                                "example_id": "5d7cd3d6-8c2a-4888-81aa-e0eee840ac3b",
                                "sense_id": "c3f4e690-9024-32b5-8b9c-d65894da80b8",
                                "text": "L’argent que l’étuveur avait dépensé pour le peintre fut un excellent investissement : bien qu’il y eût plusieurs établissements de bains dans la rue aux Moulins et que les clients eussent l’embarras du choix, Chez Côme et Damien était régulièrement bondé."
                            }
                        ]
                    },
                    {
                        "sense_id": "9319f9b6-773e-36e7-b98c-eda3131b6748",
                        "entry_id": "8f8d3c18-8bfa-369b-b8d7-4f9dec129f7f",
                        "glosses": [
                            "Appareil servant à étuver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c08c385-cde2-498b-b38c-74db3455887f",
                                "sense_id": "9319f9b6-773e-36e7-b98c-eda3131b6748",
                                "text": "Puis, après avoir été encore une fois égoutté, le riz était placé dans un étuveur pour cuire complètement par l’action de la vapeur."
                            }
                        ]
                    }
                ],
