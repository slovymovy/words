                            {
                                "example_id": "a6144f31-ce47-43d0-aa8b-86c53ae6293d",
                                "sense_id": "859e4b63-7023-3269-adfd-c49cf573400a",
                                "text": "There are six broodies in that coop."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33b98b45-e5e5-4222-90a8-1cfe267b24cf",
                        "source_entry_id": "3ffb6c15-d6a8-30af-918d-38987d8d11f3",
                        "source_sense_id": "859e4b63-7023-3269-adfd-c49cf573400a",
                        "source_sense_description": "female bird in the condition to incubate eggs",
                        "target_lang_word": "Glucke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glucke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fce122a3-d2cb-3b79-95a5-afcdeb44f11c",
                                        "entry_id": "44051d6c-00ea-3607-a234-4f6e44806c08",
                                        "glosses": [
                                            "Brütender oder Küken führender weiblicher Vogel, vor allem bei Haushühnern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3820d8f-901b-444b-88e7-1d6f61436c6d",
                                                "sense_id": "fce122a3-d2cb-3b79-95a5-afcdeb44f11c",
                                                "text": "Die Glucke führt ihr Völklein aus, der Storch baut und bewohnt sein Haus, das Schwälblein speist die Jungen. (Aus dem Lied \"Geh' aus mein Herz\" von Paul Gerhard)"
                                            },
                                            {
                                                "example_id": "ec7b8d08-7842-4341-833c-570346526208",
                                                "sense_id": "fce122a3-d2cb-3b79-95a5-afcdeb44f11c",
                                                "text": "„Obwohl ich ihn zu meiden suchte, rannte er mir bei jedem Krawall wie eine Glucke ihren Küchlein nach, um mich zu bevormunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "25d00383-fa51-39ef-a473-3569025df8b2",
                                        "entry_id": "44051d6c-00ea-3607-a234-4f6e44806c08",
                                        "glosses": [
                                            "übertrieben fürsorgliche Mutter"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12ac5c48-5f4a-44f1-b650-5c66b2cf5cdf",
                                                "sense_id": "25d00383-fa51-39ef-a473-3569025df8b2",
                                                "text": "Seit der Geburt ihrer Tochter ist Sabine zu einer richtigen Glucke geworden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "24cb7db6-21ae-3721-b38e-bc25cef6f8e3",
                                        "entry_id": "44051d6c-00ea-3607-a234-4f6e44806c08",
                                        "glosses": [
                                            "Vertreter der Nachtfalter-Familie Lasiocampidae"
                                        ],
                                        "tags": [
                                            "Entomologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31853b39-f0d1-43a9-b1c9-21000059f2a8",
                                                "sense_id": "24cb7db6-21ae-3721-b38e-bc25cef6f8e3",
                                                "text": "Glucken sind, wie die meisten Nachtfalter, eher unauffällig gefärbt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "eeb72f2f-70ab-30a9-ab52-5c4dc567471c",
                                        "entry_id": "44051d6c-00ea-3607-a234-4f6e44806c08",
                                        "glosses": [
                                            "Pilz, Vertreter der Gattung Sparassis aus der Ordnung der Porenpilze"
                                        ],
                                        "tags": [
                                            "Mykologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fea60c27-0674-4399-9ca6-76869d5b2659",
                                                "sense_id": "eeb72f2f-70ab-30a9-ab52-5c4dc567471c",
                                                "text": "Die Krause Glucke ist ein guter Speisepilz."
                                            }
                                        ],
