                        "glosses": [
                            "in het bezit zijnde van twee allelen van een gen bij een (diploïd) organisme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f23921c-4061-4f91-a260-6b269dc6af3f",
                                "sense_id": "8be9a5ba-c1da-3403-a243-0b136a0d6ca9",
                                "text": "Die bloem is heterozygoot voor het gen dat voor rode bloemen codeert."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f109fc19-c3ca-48f8-9df7-a8a0cf842efa",
