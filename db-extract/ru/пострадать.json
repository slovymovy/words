                    }
                ],
                "senses": [
                    {
                        "sense_id": "05150e17-43ea-3f5e-b830-f51cd26a5f78",
                        "entry_id": "4b0e4608-64d3-36cd-ba95-b7e2a7699a1f",
                        "glosses": [
                            "потерпеть страдания, оказаться жертвой чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae32ef06-1f51-40dc-b36b-c69cc279d4ee",
                                "sense_id": "05150e17-43ea-3f5e-b830-f51cd26a5f78",
                                "text": "В результате аварии пострадало 12 человек."
                            },
                            {
                                "example_id": "3dc0f44e-4fb9-4eb4-a38b-2fcee60f600d",
                                "sense_id": "05150e17-43ea-3f5e-b830-f51cd26a5f78",
                                "text": "сказав, что Сыну Человеческому должно много пострадать, и быть отвержену старейшинами, первосвященниками и книжниками, и быть убиту, и в третий день воскреснуть."
                            }
                        ]
                    },
                    {
                        "sense_id": "05f719a7-0ab2-3966-8472-1380ae62e48a",
                        "entry_id": "4b0e4608-64d3-36cd-ba95-b7e2a7699a1f",
                        "glosses": [
                            "провести некоторое время, страдая"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7b271db-8e2b-4a15-bbf7-cdddd61a86a2",
                                "sense_id": "05f719a7-0ab2-3966-8472-1380ae62e48a",
                                "text": "Так она пострадала ещё с полчаса, и наконец успокоилась."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bb4f732-2461-4ef7-a953-ce728b31508e",
                        "source_entry_id": "4b0e4608-64d3-36cd-ba95-b7e2a7699a1f",
