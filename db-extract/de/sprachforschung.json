                ],
                "senses": [
                    {
                        "sense_id": "a6a8b197-a473-329f-9edc-456bec53cae2",
                        "entry_id": "5efa21f0-30e9-3293-98ba-ad37a34110da",
                        "glosses": [
                            "wissenschaftliche Untersuchung von Sprache/Sprachen und ihrer Verwendung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85f8a3e1-1872-466e-bf7e-73648a4da0bd",
                                "sense_id": "a6a8b197-a473-329f-9edc-456bec53cae2",
                                "text": "„Dennoch sind historische Wörterbücher noch selten zum Gegenstand wissenschaftlicher Forschung gemacht worden, sondern wurden vielmehr als empirische Instrumente, um nicht zu sagen: als Materialsteinbruch unterschiedlichster Ausprägungen der Sprachforschung - von der Philologie bis zur Computerlinguistik - sowie anderer Kulturwissenschaften genutzt.“"
                            },
                            {
                                "example_id": "02536189-1d05-4159-adcc-d00c734865fb",
                                "sense_id": "a6a8b197-a473-329f-9edc-456bec53cae2",
                                "text": "„Die Ausstellung ermöglicht es - so im Konzept zu erkennen - den Besucherinnen und Besuchern, sich sowohl mit aktuellen sprachlichen Alltagsthemen zu beschäftigen als auch erstaunliche Phänomene aus der Sprachforschung kennenzulernen.“"
                            },
                            {
                                "example_id": "ae55cd6f-1da6-4ca2-815e-0725fcda854f",
                                "sense_id": "a6a8b197-a473-329f-9edc-456bec53cae2",
                                "text": "„Vielleicht wird sich die Sprachforschung hier einmal von der Musik inspirieren lassen, aber die Textologie muss auch ohne sie auskommen.“"
                            },
                            {
                                "example_id": "cb1a3f17-47cb-4fb4-a3c2-3e46e92b2dff",
                                "sense_id": "a6a8b197-a473-329f-9edc-456bec53cae2",
                                "text": "„Es ist richtig, daß sich die Sprachforschung (und gerade der Strukturalismus) lange Zeit lieber und mit größerem Erfolg um die Analyse des Ausdrucks als um die Analyse des Inhalts bemüht hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
