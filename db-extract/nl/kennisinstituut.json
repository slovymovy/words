                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8453320-1530-43fb-b8b5-48248f196700",
                                "sense_id": "664c09d8-1871-3ec5-9c86-5113027292fb",
                                "text": "De totale maatschappelijke kosten van verstoringen op het spoor bedragen 400 à 500 miljoen euro per jaar, bleek uit eerder onderzoek van het Kennisinstituut voor Mobiliteitsbeleid (KiM)."
                            },
                            {
                                "example_id": "aab41064-7125-4363-a0e3-762322a295d0",
                                "sense_id": "664c09d8-1871-3ec5-9c86-5113027292fb",
                                "text": "De kwaliteit van onze drinkwaterbronnen is in gevaar. Uit onderzoek van KWR, het kennisinstituut van de drinkwatersector, blijkt dat het grond- en oppervlaktewater met steeds meer stoffen zijn verontreinigd. Dat bevestigt geohydroloog Arnaut van Loon van KWR in het NOS Radio 1 Journaal naar aanleiding van berichtgeving in het AD."
                            }
                        ]
