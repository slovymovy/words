                                                "sense_id": "a8bb1256-ad6c-30fb-aa41-514fa5051b48",
                                                "text": "Das Adjektiv »laufend« ist ein inkomparables Adjektiv."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
