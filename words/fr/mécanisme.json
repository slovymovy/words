                        "déclencher un mécanisme"
                    ]
                },
                {
                    "sense_id": "55f36cf1-9746-34dc-b9d1-8dc9000f980b",
                    "sense_definition": "Manière dont s'agencent ou fonctionnent les éléments d'un système abstrait, d'un organisme ou d'un phénomène.",
