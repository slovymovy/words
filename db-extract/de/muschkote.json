                ],
                "senses": [
                    {
                        "sense_id": "06892dd4-936c-3918-901f-00b5082e55fe",
                        "entry_id": "47daf028-21bd-3358-8d97-af462641c5af",
                        "glosses": [
                            "Soldat, dessen Waffe die Muskete ist, ein Musketier"
                        ],
                        "tags": [
                            "casual",
                            "derogatory",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "ec5c2c50-f861-4b4c-b509-bc2f1f70060a",
                                "sense_id": "06892dd4-936c-3918-901f-00b5082e55fe",
                                "text": "„Sie sind ja nur Muschkoten, und er ist ein hohes Tier.“"
                            },
                            {
                                "example_id": "3c7b5115-914e-4db3-a8bc-1467836ebd71",
                                "sense_id": "06892dd4-936c-3918-901f-00b5082e55fe",
                                "text": "„Denn da klappt noch alles, da bewegt noch jener Gehorsam, der allen andren Teilnehmern des Staates fehlt, automatisch die Glieder. Disziplin –? Ja, der Muschkote hat sie. Aber auch die Herren Generale?“"
                            },
                            {
                                "example_id": "a0e4db0f-4d2d-42a6-b671-cd2bb6c1f44a",
                                "sense_id": "06892dd4-936c-3918-901f-00b5082e55fe",
                                "text": "„»…Mall-Gruen nennen sie ihn, weil er verrückt ist, seit ihn die Muschkoten November achtzehn an die Wand gestellt haben.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "520eca75-e1fa-3963-9df1-e34cbb1873b8",
                        "entry_id": "47daf028-21bd-3358-8d97-af462641c5af",
                        "glosses": [
                            "(rangloser) Soldat"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "20ddb3fe-9e53-4a0e-ae2f-24110d90e1f9",
                                "sense_id": "520eca75-e1fa-3963-9df1-e34cbb1873b8",
                                "text": "„Sie sind ja nur Muschkoten, und er ist ein hohes Tier.“"
                            },
                            {
                                "example_id": "a50b20aa-3799-429c-bfe1-f6b07996d06c",
                                "sense_id": "520eca75-e1fa-3963-9df1-e34cbb1873b8",
                                "text": "„Denn da klappt noch alles, da bewegt noch jener Gehorsam, der allen andren Teilnehmern des Staates fehlt, automatisch die Glieder. Disziplin –? Ja, der Muschkote hat sie. Aber auch die Herren Generale?“"
                            },
                            {
                                "example_id": "4fef864a-1862-4a95-baf7-05b261949d05",
                                "sense_id": "520eca75-e1fa-3963-9df1-e34cbb1873b8",
                                "text": "„»…Mall-Gruen nennen sie ihn, weil er verrückt ist, seit ihn die Muschkoten November achtzehn an die Wand gestellt haben.«“"
                            },
                            {
                                "example_id": "a61ded1a-4332-4c05-89dd-4a7e01c4138f",
                                "sense_id": "520eca75-e1fa-3963-9df1-e34cbb1873b8",
                                "text": "„Auf kurzem Kommißurlaub - in entlaustem Uniformzeug, Kanonenstiebeln, Hänge an der Hosennaht - traute ich mich an die Bücher nicht mehr heran, die mir den Rücken zukehrten: dem Muschkoten.“"
                            },
                            {
                                "example_id": "e466a378-4586-46e1-aa7d-f00d9e8efb18",
                                "sense_id": "520eca75-e1fa-3963-9df1-e34cbb1873b8",
                                "text": "„Ich war schließlich Muschkote wie er, mit einem halben Schlag in den Hosenbeinen, einem schlecht sitzenden Kulani am Leib und einer Matrosenmütze wie in meinem fünften Lebensjahr auf dem Kopf.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
