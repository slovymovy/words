                        "tags": [],
                        "form": "post-colonialisme"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7e3cc26c-a910-3ba3-ae29-ee290edf210b",
                        "entry_id": "1bc1e583-68cb-3cc2-a258-f3898d3df2a0",
                        "glosses": [
                            "Courant de pensée qui vise, pour les peuples décolonisés, à renverser le système de valeurs coloniales lequel suppose la supériorité du conquérant et dans lequel ils (s')étaient définis comme étant inférieurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "020de4e9-00cf-48c3-9f12-a472baa198c8",
                                "sense_id": "7e3cc26c-a910-3ba3-ae29-ee290edf210b",
                                "text": "Les théoriciens du postcolonialisme."
                            },
                            {
                                "example_id": "afb2c4c7-cb32-459f-a651-0bdb36118c6e",
                                "sense_id": "7e3cc26c-a910-3ba3-ae29-ee290edf210b",
                                "text": "Le postcolonialisme ne comprend pas que la culture d’un peuple atteint son point paroxystique d’ébullition lorsque ce peuple accède à la conscience nationale, c’est-à-dire à la majorité historique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05abfc68-c668-48a0-a139-2dc6ceebc95f",
                        "source_entry_id": "1bc1e583-68cb-3cc2-a258-f3898d3df2a0",
                        "source_sense_id": "7e3cc26c-a910-3ba3-ae29-ee290edf210b",
                        "target_lang_word": "postcolonialism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "postcolonialism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d5d0224-39e8-39f5-9ad8-fb4a0cd70c7c",
                                        "entry_id": "22659384-a3b2-3c81-b723-9237d113e338",
                                        "glosses": [
                                            "An era or attitude relating to the period after the settlement of one country by another, or very broadly, after the 1960s, when many colonised countries gained their independence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "def9677c-8414-366a-98c5-20ef9e99b31a",
                                        "entry_id": "22659384-a3b2-3c81-b723-9237d113e338",
                                        "glosses": [
                                            "An academic discipline that attempts to analyse, explain, and respond to the cultural legacies of colonialism and imperialism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaa20e9a-341e-4f02-9229-7e87af543dca",
                                                "sense_id": "def9677c-8414-366a-98c5-20ef9e99b31a",
                                                "text": "As a literary theory, postcolonialism examines literature produced both by authors in colonial countries and by colonized peoples responding to colonial legacies by ‘writing back’, or challenging colonial cultural attitudes through literature."
                                            },
                                            {
                                                "example_id": "5ed21538-7502-4067-b902-1556de8822ae",
                                                "sense_id": "def9677c-8414-366a-98c5-20ef9e99b31a",
                                                "text": "There can be no doubt that Derrida's contribution to postcolonialism is not as clearly politicized as that of Fanon, Sartre or Gandhi, but it is nevertheless crucial in its careful consideration of the contrasting ethics and politics that might inform postcolonial thought."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
