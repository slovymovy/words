                    }
                ],
                "translations": [
                    {
                        "translation_id": "5289363d-571e-4232-8bc6-9b6b5e526cc0",
                        "source_entry_id": "87e6fea1-c11f-33b7-acb9-09782e5dbb99",
                        "source_sense_id": "98719239-edd2-30f8-9113-0b99ba9d35a2",
                        "source_sense_description": "Biologie, Medizin: Blutkörperchen ohne Hämoglobin",
                        "target_lang_word": "leukocyte",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leukocyte",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a61a2eb7-3426-3924-926c-acce163eabd0",
                                        "entry_id": "5a71b604-883f-326b-9058-a2706eed004b",
                                        "glosses": [
                                            "Any of a class of blood cells that play various roles in cell-mediated immunity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fcfda1d-050f-4241-9c68-ee007f6ce84c",
                                                "sense_id": "a61a2eb7-3426-3924-926c-acce163eabd0",
                                                "text": "In disease of the spleen, especially Banti's disease or fibro-adenia of the spleen, the increase of leukocytes is absent or slight, with no relative lymphocytosis."
                                            },
                                            {
                                                "example_id": "42fd31c4-ad31-4279-aa80-6df8d6f73d06",
                                                "sense_id": "a61a2eb7-3426-3924-926c-acce163eabd0",
                                                "text": "Iberdomide, a cereblon modulator promoting degradation of the transcription factors Ikaros and Aiolos, which affect leukocyte development and autoimmunity, is being evaluated for the treatment of systemic lupus erythematosus (SLE)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e830d67-c9e9-4684-ae9d-0e4ae9118c12",
                        "source_entry_id": "87e6fea1-c11f-33b7-acb9-09782e5dbb99",
                        "source_sense_id": "98719239-edd2-30f8-9113-0b99ba9d35a2",
                        "source_sense_description": "Biologie, Medizin: Blutkörperchen ohne Hämoglobin",
                        "target_lang_word": "white blood cell",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "white blood cell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "417aef0c-48b3-333d-bae8-195a1b27c5ec",
                                        "entry_id": "9f5660e6-3abd-3c30-be11-2b7817ab00fd",
                                        "glosses": [
                                            "A type of blood cell that is involved with an immune response, or part of the immune system."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "680fb496-7fe0-4d39-bf35-28d2b4137404",
                        "source_entry_id": "87e6fea1-c11f-33b7-acb9-09782e5dbb99",
                        "source_sense_id": "98719239-edd2-30f8-9113-0b99ba9d35a2",
                        "source_sense_description": "Biologie, Medizin: Blutkörperchen ohne Hämoglobin",
                        "target_lang_word": "leucocyte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leucocyte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40e1bead-2e02-3806-8205-945c01b32c34",
                                        "entry_id": "1db42ec7-1466-3889-a460-75c8e9490746",
                                        "glosses": [
                                            "Globule blanc du sang, de la lymphe et de nombreux tissus, qui est pourvu d’un noyau, contrairement aux hématies ou globules rouges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c149ea71-255d-465b-9412-d8f3c198d5e4",
                                                "sense_id": "40e1bead-2e02-3806-8205-945c01b32c34",
                                                "text": "Mais outre ces leucocytes, il y a dans le pus sécrété par les plaies un bactérien qui possède aussi la propriété de provoquer la formation du pus en plus grande quantité, quand il est introduit dans les tissus vivants ; […]."
                                            },
                                            {
                                                "example_id": "2493d702-6f54-42aa-9701-cb481199ec17",
                                                "sense_id": "40e1bead-2e02-3806-8205-945c01b32c34",
                                                "text": "Finalement cette formation s’est dégagée du leucocyte."
                                            },
                                            {
                                                "example_id": "71e1e35e-6551-47a0-b6a8-1e9f03b37e5f",
                                                "sense_id": "40e1bead-2e02-3806-8205-945c01b32c34",
                                                "text": "La première ligne de défense est composée d’un ensemble de cellules appelées leucocytes (ou globules blancs) qui circulent dans les tissus et le flux sanguin. Ces cellules sont plus grandes et moins nombreuses que les érythrocytes ou globules rouges, qui transportent l’oxygène."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f03c8a2e-1873-42f2-a0f9-fac4d9c33f06",
                        "source_entry_id": "87e6fea1-c11f-33b7-acb9-09782e5dbb99",
