            {
                "entry_id": "a60339b8-81ef-33c2-b566-0342c744ce0b",
                "word": "Nice",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "60fcb228-b7d2-34c4-a4cf-9ccde7421204",
                        "entry_id": "a60339b8-81ef-33c2-b566-0342c744ce0b",
                        "glosses": [
                            "Commune, ville et chef-lieu de département français, situé dans le département des Alpes-Maritimes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe3aec52-8f97-4e76-bc7e-a7a98e1de2fe",
                                "sense_id": "60fcb228-b7d2-34c4-a4cf-9ccde7421204",
                                "text": "Le Roi a une entrevue à Nice avec le Pape Paul III, qui ménage une trêve de dix ans entre les Puissances belligérantes."
                            },
                            {
                                "example_id": "9f668296-8ca3-41d6-8f72-428416b4b9d7",
                                "sense_id": "60fcb228-b7d2-34c4-a4cf-9ccde7421204",
                                "text": "À Cannes et à Nice, les hôtels et les maisons particulières sont peuplées de peu de Français et de beaucoup d’étrangers divers par l’origine, semblables par l’argent qui leur sort des mains."
                            },
                            {
                                "example_id": "09bdab95-d6d2-4818-984a-20e582e23564",
                                "sense_id": "60fcb228-b7d2-34c4-a4cf-9ccde7421204",
                                "text": "Né à Puget-Théniers (Alpes-Maritimes), Blanqui est d'origine italienne, sa famille avait été francisée par l’annexion du comté de Nice en 1792."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "384b4628-e0b7-48ef-b58d-8b1fe27d7014",
                        "source_entry_id": "a60339b8-81ef-33c2-b566-0342c744ce0b",
                        "source_sense_id": "60fcb228-b7d2-34c4-a4cf-9ccde7421204",
