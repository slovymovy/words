                "translations": [
                    {
                        "translation_id": "eecea9bd-199d-43e2-b675-b8ea3db1e19d",
                        "source_entry_id": "24678ddd-d039-36aa-abc2-7c9f00b1d63e",
                        "source_sense_id": "0685457f-5f30-3bc8-a52d-6a92be5eaa55",
                        "source_sense_description": "glückselig, glücklich, selig, wunderschön",
                        "target_lang_word": "glückselig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glückselig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f46eaf5d-d9e6-3071-9baf-4000473cb743",
                                        "entry_id": "e516551f-79f1-3ff0-9252-6f83ccec22d0",
                                        "glosses": [
                                            "sehr glücklich; meist auf äußere Einflüsse zurückzuführen"
                                        ],
                                        "tags": [
                                            "im landläufigen Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c9df4da-fbf2-406b-9abf-b4de635ec84b",
                                                "sense_id": "f46eaf5d-d9e6-3071-9baf-4000473cb743",
                                                "text": "Die Erfolge versetzten ihn in eine glückselige Stimmung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e32c46c1-76c6-30ac-b460-54bfb335893f",
                                        "entry_id": "e516551f-79f1-3ff0-9252-6f83ccec22d0",
                                        "glosses": [
                                            "eine innere Zufriedenheit verspürend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cfaae7c-c2ea-46a9-accc-9bf92d211b59",
                                                "sense_id": "e32c46c1-76c6-30ac-b460-54bfb335893f",
                                                "text": "„[…], glückselig ist, wer mit dem Gegenwärtigen, wie es auch immer sei, zufrieden und mit seinen Verhältnissen befreundet ist, […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab784b68-905f-4694-9878-781bad850e27",
                        "source_entry_id": "24678ddd-d039-36aa-abc2-7c9f00b1d63e",
                        "source_sense_id": "0685457f-5f30-3bc8-a52d-6a92be5eaa55",
                        "source_sense_description": "glückselig, glücklich, selig, wunderschön",
                        "target_lang_word": "glücklich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glücklich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35154ff5-754a-3cd3-b9f8-1ea4b9de6fac",
                                        "entry_id": "835c4543-961f-3b63-98b4-f67842beb053",
                                        "glosses": [
                                            "(Zufalls-)Glück oder Erfolg habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f512a748-549e-4ca8-bb63-6391ad3b9092",
                                                "sense_id": "35154ff5-754a-3cd3-b9f8-1ea4b9de6fac",
                                                "text": "In Erzählungen enden die meisten Abenteuer glücklich."
                                            },
                                            {
                                                "example_id": "5049dd91-8bab-4315-a5e4-6871d3ae5be6",
                                                "sense_id": "35154ff5-754a-3cd3-b9f8-1ea4b9de6fac",
                                                "text": "„Jeder glücklich erreichte Gipfel vermittelt das Bewusstsein, sich ein nicht jedermann zugängliches, dem Bergsteiger wichtiges Stück Bergwelt unseres Globus selbst erarbeitet und damit zu eigen gemacht zu haben.“"
                                            },
                                            {
                                                "example_id": "6ef6656a-eaed-4f59-95a6-e8066b876bcc",
                                                "sense_id": "35154ff5-754a-3cd3-b9f8-1ea4b9de6fac",
                                                "text": "Odysseus kehrte nach Jahren glücklich zu seiner Penelope zurück."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c24172ae-1f3f-30d1-bbc3-8df5c3b1cfa5",
                                        "entry_id": "835c4543-961f-3b63-98b4-f67842beb053",
                                        "glosses": [
                                            "von großer Freude, Zufriedenheit, vom (Wohlfühl-)Glück erfüllt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3805a823-b63a-452f-9092-5e264baddece",
                                                "sense_id": "c24172ae-1f3f-30d1-bbc3-8df5c3b1cfa5",
                                                "text": "„Jeder glücklich erreichte Gipfel vermittelt das Bewusstsein, sich ein nicht jedermann zugängliches, dem Bergsteiger wichtiges Stück Bergwelt unseres Globus selbst erarbeitet und damit zu eigen gemacht zu haben.“"
                                            },
                                            {
                                                "example_id": "bb00e28a-8bfd-42d5-922a-5245c306504b",
                                                "sense_id": "c24172ae-1f3f-30d1-bbc3-8df5c3b1cfa5",
                                                "text": "Odysseus kehrte nach Jahren glücklich zu seiner Penelope zurück."
                                            },
                                            {
                                                "example_id": "6df53a76-569c-41cf-9457-7eabfc6f0963",
                                                "sense_id": "c24172ae-1f3f-30d1-bbc3-8df5c3b1cfa5",
                                                "text": "Sie war so glücklich, als ich sie in meinen Armen hielt."
                                            },
                                            {
                                                "example_id": "03711893-355c-45bf-b49c-cc901712af24",
                                                "sense_id": "c24172ae-1f3f-30d1-bbc3-8df5c3b1cfa5",
                                                "text": "Willst du glücklich sein im Leben, trage bei zu andrer Glück, denn die Freude, die wir geben, kehrt ins eig'ne Herz zurück."
                                            },
                                            {
                                                "example_id": "9c1a176c-7ce0-4c32-b02c-edb404d78c68",
                                                "sense_id": "c24172ae-1f3f-30d1-bbc3-8df5c3b1cfa5",
                                                "text": "„Das Adoptivkaisertum ist vielfach als die glücklichste Zeit der antiken Geschichte bezeichnet worden.“"
                                            },
                                            {
                                                "example_id": "734174fe-97cb-4942-9b55-886dce5594e7",
                                                "sense_id": "c24172ae-1f3f-30d1-bbc3-8df5c3b1cfa5",
                                                "text": "„… ich lief weiter und war glücklich, daß ich endlich rechts und links in der Ferne Mauern sah.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1eb22e15-fe65-325d-9642-c13a0aa3887d",
                                        "entry_id": "835c4543-961f-3b63-98b4-f67842beb053",
                                        "glosses": [
                                            "vorteilhaft, günstig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7f47ad5-588a-4bfa-84b2-c0575e37fb41",
                                                "sense_id": "1eb22e15-fe65-325d-9642-c13a0aa3887d",
                                                "text": "Nur aufgrund glücklicher Umstände kamen wir mit geringen Verletzungen davon."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d63c760b-8ec6-323b-8657-b7d6fab8b053",
                                        "entry_id": "835c4543-961f-3b63-98b4-f67842beb053",
                                        "glosses": [
                                            "schließlich, zu guter Letzt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58c0bdf6-6232-43e0-9aba-1093d1409286",
                                                "sense_id": "d63c760b-8ec6-323b-8657-b7d6fab8b053",
                                                "text": "Nach langen Versuchen hat er das Radio doch noch glücklich zum Laufen gebracht."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ace536b-0eb6-4c3d-bf9a-46c249800334",
                        "source_entry_id": "24678ddd-d039-36aa-abc2-7c9f00b1d63e",
                        "source_sense_id": "0685457f-5f30-3bc8-a52d-6a92be5eaa55",
                        "source_sense_description": "glückselig, glücklich, selig, wunderschön",
                        "target_lang_word": "selig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "selig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42f4147a-44f3-3701-87d7-b86f017f8852",
                                        "entry_id": "f09c37eb-fba2-36d6-a7c7-f5807943dd15",
                                        "glosses": [
                                            "himmlischer Wonnen teilhaftig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad6e3b70-beed-4e90-bcec-f96eb3358c54",
                                                "sense_id": "42f4147a-44f3-3701-87d7-b86f017f8852",
                                                "text": "„Selig die Trauernden; denn sie werden getröstet werden.“ (Aus den Seligpreisungen der Bergpredigt)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0071d79b-9a25-3d47-a346-b6cbfed725ca",
                                        "entry_id": "f09c37eb-fba2-36d6-a7c7-f5807943dd15",
                                        "glosses": [
                                            "aller Widrigkeiten des Lebens enthoben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03d84bb4-c98f-46e8-b1f4-0ac86d1412ae",
                                                "sense_id": "0071d79b-9a25-3d47-a346-b6cbfed725ca",
                                                "text": "„Dr. Adenauer bestieg sein Bett, drehte sich – so der sicherlich authentische Bericht meines Vaters selig – etwas herum, und fragte sodann: ‚Bete mer nicht, lieber Joest?‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cc44f22a-4fe0-3c32-8109-e5fe94856e02",
                                        "entry_id": "f09c37eb-fba2-36d6-a7c7-f5807943dd15",
                                        "glosses": [
                                            "von starkem Hochgefühl erfüllt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39d30557-00c9-46e3-b782-4edfa8f6391c",
                                                "sense_id": "cc44f22a-4fe0-3c32-8109-e5fe94856e02",
                                                "text": "Nach dem gelungenen Fest war sie nur noch selig."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
