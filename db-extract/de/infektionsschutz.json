                "senses": [
                    {
                        "sense_id": "2b65fb4f-9974-3219-bf66-09c4655ff8d7",
                        "entry_id": "aea891af-deab-344a-9a65-8831ff857c1d",
                        "glosses": [
                            "Summe der Maßnahmen und Regeln, die vor Ansteckung mit einer Infektionskrankheit bewahren sollen"
                        ],
                        "tags": [
                            "Infektiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "4eb59241-a13d-4dfc-97d5-2ec3508d09ae",
                                "sense_id": "2b65fb4f-9974-3219-bf66-09c4655ff8d7",
                                "text": "„Der Infektionsschutz hat die Verhütung und Bekämpfung von Infektionskrankheiten zum Ziel. Schwerpunkte der Arbeit sind die Überwachung der nach Infektionsschutzgesetz meldepflichtigen Erkrankungen.“"
                            },
                            {
                                "example_id": "7bc754fb-a0fe-47d2-adca-15680a560b76",
                                "sense_id": "2b65fb4f-9974-3219-bf66-09c4655ff8d7",
                                "text": "„Im Falle einer Meldung ist sicherzustellen, dass in der medizinischen Einrichtung die erforderlichen Maßnahmen zum Infektionsschutz getroffen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
