                ],
                "senses": [
                    {
                        "sense_id": "b4206722-2f3e-312a-bf78-96212a5253c2",
                        "entry_id": "f9989c4b-0308-3587-b58d-661da71778f1",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a453ffe-9257-448c-9bb7-1703a06642d1",
                                "sense_id": "b4206722-2f3e-312a-bf78-96212a5253c2",
                                "text": "Frau Spahr ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d33d64a3-58a7-4cdc-b976-61f28003d4b0",
                                "sense_id": "b4206722-2f3e-312a-bf78-96212a5253c2",
                                "text": "Herr Spahr wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b3511c63-2ba5-4161-aff6-34e4d2ce896a",
                                "sense_id": "b4206722-2f3e-312a-bf78-96212a5253c2",
                                "text": "Die Spahrs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a3368a67-a231-4b6d-9016-972e3688cd42",
                                "sense_id": "b4206722-2f3e-312a-bf78-96212a5253c2",
                                "text": "Der Spahr trägt nie die Schals, die die Spahr ihm strickt."
                            },
                            {
                                "example_id": "3644f3c8-c425-4c93-a025-4cb891dc475e",
                                "sense_id": "b4206722-2f3e-312a-bf78-96212a5253c2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Spahr kommt, geht der Herr Spahr.“"
                            },
                            {
                                "example_id": "6159e6dc-1241-4bd0-a652-975dcc86322f",
                                "sense_id": "b4206722-2f3e-312a-bf78-96212a5253c2",
                                "text": "Spahr kommt und geht."
                            },
                            {
                                "example_id": "999a4c76-1651-48df-8abf-6551d0b3b6c8",
                                "sense_id": "b4206722-2f3e-312a-bf78-96212a5253c2",
                                "text": "Spahrs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
