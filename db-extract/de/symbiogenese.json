                "senses": [
                    {
                        "sense_id": "4586a327-25e2-3b76-beec-bba402e6cc61",
                        "entry_id": "36f6254c-fd9c-344d-806b-6af890ce9d8a",
                        "glosses": [
                            "Form der Fortpflanzung, bei der zwei vollkommen verschiedene Lebensformen auf Ebene der DNS verschmelzen und so eine vollkommen neue Art bilden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3152f9c9-9d3c-466c-9eb0-e7ec6f3e7ba6",
                                "sense_id": "4586a327-25e2-3b76-beec-bba402e6cc61",
                                "text": "Im Gegensatz zu Charles Darwin vermutete Konstantin Mereschkowski in seiner Theorie der Symbiogenese, dass Evolution auf Kooperation und nicht auf Wettbewerb beruhe."
                            },
                            {
                                "example_id": "5155bf88-149c-4cba-a1d0-0cd97b3e8c8b",
                                "sense_id": "4586a327-25e2-3b76-beec-bba402e6cc61",
                                "text": "Die Kombination vorher selbständiger Partner bei ITC und nachfolgender Symbiogenese hat nur dann auf dem Prüfstand der Selektion Bestand, wenn sie sich in mindestens einer Hinsicht entscheidend ergänzen können, weil nur dann das neue Übersystem emergente Eigenschaften aufweist, die den einzelnen Partnern nicht zukamen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
