                    {
                        "sense_id": "74e0d378-ca87-3c7b-a0af-4ee2804ab068",
                        "entry_id": "839ec41d-20d1-39ad-822d-4e05c61debf3",
                        "glosses": [
                            "Vagabond, excentrique."
                        ],
