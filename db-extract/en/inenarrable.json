                                            {
                                                "example_id": "ab751544-2170-4f52-9b35-22fd73fdca89",
                                                "sense_id": "9813065c-aa72-3c5c-96b5-838e08177be4",
                                                "text": "Der längste Ortsname Europas \"Llanfairpwllgwyngyllgogerychwyrndrobwllllantysiliogogogoch\" ist unaussprechlich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "65e1fca4-ec07-3db7-a84f-1c4495ebcb90",
                                        "entry_id": "435f040a-a431-37e6-9221-19720b335af1",
                                        "glosses": [
                                            "sich nicht beschreiben lassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bff3232-d9df-4151-a690-e177f9df5969",
                                                "sense_id": "65e1fca4-ec07-3db7-a84f-1c4495ebcb90",
                                                "text": "Man sagt, in der alten Burg seien unaussprechliche Dinge geschehen."
                                            },
                                            {
                                                "example_id": "77793a4d-4c6b-49ac-b3b7-30f3615dd32b",
                                                "sense_id": "65e1fca4-ec07-3db7-a84f-1c4495ebcb90",
                                                "text": "„Einige Wochen lang konnte ich mich noch so weit beherrschen, die Katze weder zu schlagen noch sonstwie absichtlich schlecht zu behandeln, aber allmählich – mit jedem Tage mehr – sah ich sie nur noch mit unaussprechlichem Abscheu und floh bei ihrem unerträglichen Anblick so entsetzt davon wie vor dem Gifthauch der Pestilenz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
