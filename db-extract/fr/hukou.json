                        "sense_id": "1679be4e-f63c-3756-9165-4d24c7c6638f",
                        "entry_id": "6f3c1245-887f-357d-b2fb-0bbe5c6ceba0",
                        "glosses": [
                            "Permis de résidence intérieur en Chine."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5186713c-647d-4fdd-9864-f93b2333da96",
                                "sense_id": "1679be4e-f63c-3756-9165-4d24c7c6638f",
                                "text": "Faute d’un permis de résidence urbain (ou « hukou »), les quelque 245 millions de ruraux venus travailler dans les métropoles chinoises n'ont qu'un accès restreint aux services publics, notamment d'éducation et de santé."
                            },
                            {
                                "example_id": "0fb19d60-b501-4737-a9a4-a087bc6b75e2",
                                "sense_id": "1679be4e-f63c-3756-9165-4d24c7c6638f",
                                "text": "Même si les gens peuvent désormais travailler loin de chez eux, l’obtention du hukou s’avère difficile. Et, sans lui, la vie peut vraiment devenir compliquée."
                            }
                        ]
                    }
                ],
