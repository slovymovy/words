                                        "sense_id": "65627d75-be87-36e6-819a-1d9ec9d040bc",
                                        "entry_id": "21c7863e-b743-38f2-b737-b68c784726ea",
                                        "glosses": [
                                            "eine Übereinstimmung der Meinungen oder Standpunkte; Einigkeit, Einmütigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8266cd0-de7e-45e8-b560-6c206d59f853",
                                                "sense_id": "65627d75-be87-36e6-819a-1d9ec9d040bc",
                                                "text": "Na, hoffentlich herrscht jetzt ein Konsens. Anscheinend hat das Gegenüber mir zugestimmt."
                                            },
                                            {
                                                "example_id": "0ae34fe8-7048-4a43-aa3a-52d6e9d2bc06",
                                                "sense_id": "65627d75-be87-36e6-819a-1d9ec9d040bc",
                                                "text": "„In seiner Zeit bei den Vereinten Nationen hat er die Kunst perfektioniert, die unterschiedlichsten Menschen zum Konsens zu bringen und Gegner einzubinden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7245d8b3-bdc1-3324-a2ab-2d23ce855e10",
                                        "entry_id": "21c7863e-b743-38f2-b737-b68c784726ea",
                                        "glosses": [
                                            "eine Zustimmung, die Einwilligung, Genehmigung, Erlaubnis"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1859e662-7b39-4f54-abda-204cad450ca3",
                                                "sense_id": "7245d8b3-bdc1-3324-a2ab-2d23ce855e10",
                                                "text": "Ohne den Konsens meines Chefs kann ich das Bauteil nicht bestellen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d289fee0-9d03-48f0-ad0c-0e2f001f9a8b",
                        "source_entry_id": "f54313c3-b9b1-38ff-8022-cc3828cd1cad",
                        "target_lang_word": "Einvernehmen",
