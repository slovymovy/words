                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two distinct sounds were heard <w>instantly</w> by the observer.",
                            "target_lang_translations": {
                                "ru": "Наблюдатель услышал два разных звука <w>одновременно</w>.",
                                "zh": "观察者<w>同时</w>听到了这两个不同的声音。"
                            }
                        },
                        {
                            "text": "Both events occurred <w>instantly</w>, making it hard to separate them.",
                            "target_lang_translations": {
                                "ru": "Оба события произошли <w>одновременно</w>, из-за чего их было трудно разделить.",
                                "zh": "两件事<w>同时</w>发生，很难将它们区分开来。"
                            }
                        }
                    ],
                    "traits": [
