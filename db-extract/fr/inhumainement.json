        "fr-extract.jsonl": [
            {
                "entry_id": "54c4ce78-3608-3fa6-bb07-d625a38ca746",
                "word": "inhumainement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "08cb994a-3de9-35cc-88ad-6f844e35370b",
                        "entry_id": "54c4ce78-3608-3fa6-bb07-d625a38ca746",
                        "glosses": [
                            "D’une manière inhumaine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0526bb1-f016-4b3b-a653-a8210cb01288",
                                "sense_id": "08cb994a-3de9-35cc-88ad-6f844e35370b",
                                "text": "Quand j'aurais de ma main fait périr votre amant, Pourriez-vous me traiter plus inhumainement ?"
                            },
                            {
                                "example_id": "3cc7a6d4-2606-4c22-aabd-31a3023d52f1",
                                "sense_id": "08cb994a-3de9-35cc-88ad-6f844e35370b",
                                "text": "À l’égard des Moscovites, ils demandèrent la vie à genoux, mais on les massacra inhumainement plus de six heures après le combat."
                            }
                        ]
                    },
                    {
                        "sense_id": "be0f6035-3bf0-38b2-9dba-e830488f0d4b",
                        "entry_id": "54c4ce78-3608-3fa6-bb07-d625a38ca746",
                        "glosses": [
                            "Il se dit, par exagération, dans les rapports des personnes entre elles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7acb7f6-541e-4f7b-b9c6-d5028edb7509",
                                "sense_id": "be0f6035-3bf0-38b2-9dba-e830488f0d4b",
                                "text": "Il [mon fils] fait attendre M. d’Harouys à Nantes pour s’en revenir ensemble à Paris ; je les admire tous deux, l’un à être si bon et si obligeant, et l’autre d’en abuser inhumainement."
                            },
                            {
                                "example_id": "5505598d-6fa6-49b4-8f85-1a50d6a362d9",
                                "sense_id": "be0f6035-3bf0-38b2-9dba-e830488f0d4b",
                                "text": "Je vous écrivis mercredi […] j'oubliai inhumainement, contre l’ordinaire des grand'mères, à vous parler de ma pauvre petite d’Aix."
                            }
                        ]
                    }
                ],
