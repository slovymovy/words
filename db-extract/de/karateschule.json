                "senses": [
                    {
                        "sense_id": "9b6bfa32-01c6-39bf-8c12-0569eabd8583",
                        "entry_id": "14ff2ed4-578b-3bcd-809f-087837e7e5ed",
                        "glosses": [
                            "Ausbildungsstätte, in der Karate unterrichtet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5b223ed-93e3-4e45-8a3d-87b94ef7b75b",
                                "sense_id": "9b6bfa32-01c6-39bf-8c12-0569eabd8583",
                                "text": "In unserer Stadt gibt es keine Karateschule."
                            },
                            {
                                "example_id": "f1a0b8c4-304b-46ae-a0db-e1f9d673fe46",
                                "sense_id": "9b6bfa32-01c6-39bf-8c12-0569eabd8583",
                                "text": "„Der Leiter der Schule, Fabio Cabiddu, ist mit seiner Karateschule schon eine Kooperation mit dem TSV Allershausen eingegangen.“"
                            },
                            {
                                "example_id": "6f2eb959-614b-4705-b14a-98f3627aeb18",
                                "sense_id": "9b6bfa32-01c6-39bf-8c12-0569eabd8583",
                                "text": "„Im syrischen Dorf Aljiina, in der Nähe der Stadt Aleppo, hat Wasim Satot eine Karateschule für Kinder eröffnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
