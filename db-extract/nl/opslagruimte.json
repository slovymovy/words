                        "entry_id": "b1f8519d-e5dd-3408-b1c4-2428de774c24",
                        "glosses": [
                            "een fysieke of virtuele plaats waar men iets kan bewaren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d81bc308-abb8-48c8-8aa2-831076963272",
                                "sense_id": "00710880-9424-337a-ad85-41a397ff1fd3",
                                "text": "Flickr geeft iedere gebruiker een terabyte opslagruimte."
                            }
                        ]
