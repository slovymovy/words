{
    "word_family": [
        "accuracy",
        "accurately",
        "inaccurate",
        "inaccuracy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1e332250-42a0-3a69-a64d-ab8d4a99b72b",
                    "sense_definition": "Correct in all details; exact and without any errors.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "precision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist provided an <w>accurate</w> description of the experiment's results.",
                            "target_lang_translations": {
                                "ru": "Ученый предоставил <w>точное</w> описание результатов эксперимента.",
                                "zh": "科学家对实验结果提供了<w>准确</w>的描述。"
                            }
                        },
                        {
                            "text": "It is difficult to get <w>accurate</w> information during a fast-moving crisis.",
                            "target_lang_translations": {
                                "ru": "Трудно получить <w>достоверную</w> информацию во время быстро развивающегося кризиса.",
                                "zh": "在瞬息万变的危机中，很难获得<w>可靠</w>的信息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "correct",
                        "exact"
                    ],
                    "antonyms": [
                        "inaccurate"
                    ],
                    "common_phrases": [
                        "accurate information",
                        "accurate description",
                        "highly accurate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Правильный во всех деталях; точный и не содержащий ошибок.",
                        "zh": "在所有细节上都是正确的；精确且没有任何错误。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "точный",
                                "target_lang_sense_clarification": "соответствующий истине или фактам"
                            },
                            {
                                "target_lang_word": "правильный",
                                "target_lang_sense_clarification": "верный, без ошибок"
                            },
                            {
                                "target_lang_word": "достоверный",
                                "target_lang_sense_clarification": "основанный на фактах, заслуживающий доверия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "准确",
                                "target_lang_sense_clarification": "符合事实或标准，没有偏差"
                            },
                            {
                                "target_lang_word": "精确",
                                "target_lang_sense_clarification": "非常细致、严密"
                            },
                            {
                                "target_lang_word": "可靠",
                                "target_lang_sense_clarification": "信息真实可信"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a3c0140-3f1c-3a62-b77e-e3ac4cd2559f",
                    "sense_definition": "Matching a standard or reality very closely, even if not perfectly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "precision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather forecast was surprisingly <w>accurate</w> this week.",
                            "target_lang_translations": {
                                "ru": "Прогноз погоды на этой неделе был на удивление <w>точным</w>.",
                                "zh": "这周的天气预报出奇地<w>准确</w>。"
                            }
                        },
                        {
                            "text": "His <w>accurate</w> prediction about the stock market impressed everyone.",
                            "target_lang_translations": {
                                "ru": "Его <w>верный</w> прогноз относительно фондового рынка впечатлил всех.",
                                "zh": "他对股市的<w>准确</w>预测令所有人印象深刻。"
                            }
                        }
                    ],
                    "synonyms": [
                        "exact"
                    ],
                    "antonyms": [
                        "inaccurate"
                    ],
                    "common_phrases": [
                        "accurate prediction",
                        "surprisingly accurate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень близко соответствующий стандарту или реальности, даже если не идеально.",
                        "zh": "与标准或现实非常吻合，即使并非完美无缺。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "точный",
                                "target_lang_sense_clarification": "о прогнозах или предсказаниях"
                            },
                            {
                                "target_lang_word": "верный",
                                "target_lang_sense_clarification": "соответствующий действительности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "准确",
                                "target_lang_sense_clarification": "用于预测或估算"
                            },
                            {
                                "target_lang_word": "正确",
                                "target_lang_sense_clarification": "符合实际情况"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b45a460-7e88-3410-9ce9-ff61c8711280",
                    "sense_definition": "Performed or executed with great care and attention to detail.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "precision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist made an <w>accurate</w> drawing of the historical building.",
                            "target_lang_translations": {
                                "ru": "Художник сделал <w>точный</w> рисунок исторического здания.",
                                "zh": "艺术家为这座历史建筑画了一幅<w>精确</w>的素描。"
                            }
                        },
                        {
                            "text": "She is known for her <w>accurate</w> work in restoring old manuscripts.",
                            "target_lang_translations": {
                                "ru": "Она известна своей <w>аккуратной</w> работой по реставрации старинных рукописей.",
                                "zh": "她以修复古籍时<w>细致</w>的工作而闻名。"
                            }
                        }
                    ],
                    "synonyms": [
                        "particular",
                        "nice"
                    ],
                    "common_phrases": [
                        "accurate work",
                        "accurate drawing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполненный с большой тщательностью и вниманием к деталям.",
                        "zh": "以极大的细心和对细节的关注来执行或完成。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аккуратный",
                                "target_lang_sense_clarification": "тщательный и детальный"
                            },
                            {
                                "target_lang_word": "точный",
                                "target_lang_sense_clarification": "воспроизведенный с высокой детализацией"
                            },
                            {
                                "target_lang_word": "тщательный",
                                "target_lang_sense_clarification": "выполненный с особым вниманием"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "细致",
                                "target_lang_sense_clarification": "注重细节，工作认真"
                            },
                            {
                                "target_lang_word": "严谨",
                                "target_lang_sense_clarification": "态度严肃，一丝不苟"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}