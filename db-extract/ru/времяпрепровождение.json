                "senses": [
                    {
                        "sense_id": "ab7215e0-4a0f-33d8-9c89-d03708816164",
                        "entry_id": "fc6af926-49a7-3964-ae2f-9591473b3837",
                        "glosses": [
                            "pastime"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e250b40c-977c-48fe-8720-8136a69aac74",
                                "sense_id": "ab7215e0-4a0f-33d8-9c89-d03708816164",
                                "text": "Моё люби́мое времяпрепровожде́ние — фехтова́ние.",
                                "translation": "My favorite pastime is fencing.",
                                "english": "My favorite pastime is fencing."
                            },
                            {
                                "example_id": "2b48982e-10c9-4ce5-94c4-fd7158bc6f33",
                                "sense_id": "ab7215e0-4a0f-33d8-9c89-d03708816164",
                                "text": "Чем отвлечённее ста́вились вопро́сы, чем ме́нее вторга́лось в них жи́зненных счето́в и подро́бностей, тем успокои́тельнее бы́ло их де́йствие, тем бо́льшую полноту́ придава́ли они́ челове́ческому времяпрепровожде́нию.",
                                "translation": "Mikhail Saltykov-Shchedrin",
                                "english": "Mikhail Saltykov-Shchedrin"
                            }
                        ]
                    }
                ],
