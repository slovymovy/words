                ],
                "senses": [
                    {
                        "sense_id": "13e58c31-a188-3b1b-a329-0cfa6f5f33e8",
                        "entry_id": "ed79e4cc-88f3-3243-9e60-819caaa5038d",
                        "glosses": [
                            "Essayer de donner à ses acheteurs l’impression d’être des favorisés, en donnant un caractère tendant vers le luxe à (quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "534f0221-1bda-4c83-8622-15f69555efe8",
                                "sense_id": "13e58c31-a188-3b1b-a329-0cfa6f5f33e8",
                                "text": "Denis Boudard, créateur de la bouteille, a expliqué : « J'ai voulu revisiter la bonbonne, la prémiumiser et la moderniser."
                            },
                            {
                                "example_id": "f440b55e-779b-499d-9b8f-1e84f85f2dd3",
                                "sense_id": "13e58c31-a188-3b1b-a329-0cfa6f5f33e8",
                                "text": "Cette innovation a permis au brasseur de \"prémiumiser\" sa bière et de devenir nᵒ 1 en France en 2009."
                            },
                            {
                                "example_id": "03072ab0-7ada-449f-b18c-e20e4e9858b9",
                                "sense_id": "13e58c31-a188-3b1b-a329-0cfa6f5f33e8",
                                "text": "Soit il faut \"simplifier\" et tirer les prix vers le bas soit il faut se \"prémiumiser\", enfin c'est mon analyse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63d85435-9e6b-4390-a4d4-8bd795033a59",
                        "source_entry_id": "ed79e4cc-88f3-3243-9e60-819caaa5038d",
