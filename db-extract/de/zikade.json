                        "source_sense_id": "d5507ec4-a6cc-3719-85a1-892c85db4c86",
                        "source_sense_description": "Entomologie: an Pflanzen saugende Insekten der Gruppe der Gleichflügler (Homoptera)",
                        "target_lang_word": "цикада",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "цикада",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "edb5d4d6-f56f-3923-82f5-72c611522ef5",
                                        "entry_id": "182a0510-f288-308d-a078-c07d8af910e3",
                                        "glosses": [
                                            "энтомол. хоботное прыгающее насекомое с выпуклыми глазами, с яркими или чёрными передними крыльями, самцы которого издают характерное стрекотание (Cicada)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f97013b6-8fa3-4458-96b4-f68e56a39e03",
                                                "sense_id": "edb5d4d6-f56f-3923-82f5-72c611522ef5",
                                                "text": "И отовсюду, из садов, виноградников, со всех деревьев слышится несмолкаемый, оглушительный треск цикад."
                                            },
                                            {
                                                "example_id": "04307c4b-ecba-4e35-bfb8-993649833303",
                                                "sense_id": "edb5d4d6-f56f-3923-82f5-72c611522ef5",
                                                "text": "Листва не шевелилась на деревьях, кричали цикады, и однообразный, глухой шум моря, доносившийся снизу, говорил о покое, о вечном сне, какой ожидает нас."
                                            },
                                            {
                                                "example_id": "c2f7b640-3709-494e-8c17-601f3c594259",
                                                "sense_id": "edb5d4d6-f56f-3923-82f5-72c611522ef5",
                                                "text": "Ширился, густел и как бы приближался с полей звук цикад."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
