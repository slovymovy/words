                ],
                "senses": [
                    {
                        "sense_id": "a042d4bc-07d5-31a7-8eb4-35614c23d834",
                        "entry_id": "7788fa38-ad06-3562-9093-dea71ac7fded",
                        "glosses": [
                            "die Oberfläche von Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "963f6674-4b82-4ba1-bf7d-4a94489a2778",
                                "sense_id": "a042d4bc-07d5-31a7-8eb4-35614c23d834",
                                "text": "Auch die von stärkeren Wellen bewegte Wasseroberfläche wurde keineswegs gemieden, selbst wenn einige Individuen von brechenden Wellen erfasst und etwas stromaufwärts davon getragen wurden."
                            },
                            {
                                "example_id": "70939c75-b2f5-4e86-89e7-41ea0a2c873d",
                                "sense_id": "a042d4bc-07d5-31a7-8eb4-35614c23d834",
                                "text": "So können Objekte auf einer Wasseroberfläche schwimmen, so lange ihr Gewicht nicht ausreicht, um die Oberflächenspannung zu überwinden."
                            },
                            {
                                "example_id": "51b56e8b-856a-448c-977e-c1c00d048e57",
                                "sense_id": "a042d4bc-07d5-31a7-8eb4-35614c23d834",
                                "text": "Zum ersten Mal haben Wissenschaftler gefilmt, wie sich ein Süßwasserfisch einen Vogel schnappt, der über der Wasseroberfläche fliegt."
                            },
                            {
                                "example_id": "7142c80f-709e-42c7-bea7-e85172527252",
                                "sense_id": "a042d4bc-07d5-31a7-8eb4-35614c23d834",
                                "text": "„Die bewegte Wasseroberfläche warf kein Spiegelbild zurück.“"
                            },
                            {
                                "example_id": "47a8fe3d-37ad-41bf-a55c-b5052fba61ce",
                                "sense_id": "a042d4bc-07d5-31a7-8eb4-35614c23d834",
                                "text": "„Auch er zitterte stark, war blau angelaufen und legte bereits den Kopf in den Nacken, um knapp über der Wasseroberfläche noch Luft holen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
