                        "tags": [],
                        "examples": [
                            {
                                "example_id": "741c9f00-c09f-4dad-8ec6-f7833685e785",
                                "sense_id": "1cd2e412-ea5e-35b5-960b-3723f3e3fba9",
                                "text": "„Drei Tage nach der Messerattacke eines ultraorthodoxen Juden auf eine Parade für Lesben und Schwule in Jerusalem ist eine der Verletzten gestorben.“"
                            },
                            {
                                "example_id": "c20abf0e-4c7d-4ea5-9418-59819060aed0",
                                "sense_id": "1cd2e412-ea5e-35b5-960b-3723f3e3fba9",
                                "text": "„Bei einer Messerattacke in Hamburg sind am Freitagabend mehrere Menschen schwer verletzt worden. Die Polizei gab später erste Informationen zur mutmaßlichen Täterin bekannt.“"
                            }
                        ],
