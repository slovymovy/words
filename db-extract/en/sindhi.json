                    {
                        "sense_id": "398e40e8-12e9-3f08-9ca3-70a63dc1ba1c",
                        "entry_id": "519ba83f-edcd-36c4-be61-796e720a0cf0",
                        "glosses": [
                            "An Indo-Aryan language spoken in four main dialects in Pakistan and India. There are around 35 million Sindhi speakers in Sindh سنڌ and more than 40 million throughout the world. Sindhi is written with a modified Arabic script that has 52 letters, and in a modified Devanagari script too."
                        ],
                        "tags": [],
                        "examples": []
                    }
