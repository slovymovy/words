                ],
                "senses": [
                    {
                        "sense_id": "9fbf7255-859a-3051-97ec-0a58c5e84296",
                        "entry_id": "0ee2b43b-fd2b-33d5-9921-d7fdd4e748c9",
                        "glosses": [
                            "Rendre propre de nouveau."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "36808b1e-3630-34ad-9f71-fe3082d3c2d5",
                        "entry_id": "0ee2b43b-fd2b-33d5-9921-d7fdd4e748c9",
                        "glosses": [
                            "Reprendre possession de quelque chose."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "2e1fb8e7-6562-4015-8278-51afbd172549",
                                "sense_id": "36808b1e-3630-34ad-9f71-fe3082d3c2d5",
                                "text": "En cherchant à reconnecter le corps et les émotions, ces techniques ont aussi pour but de permettre au malade de ré-apprivoiser et de se ré-approprier son corps et de mieux s’en servir."
                            },
                            {
                                "example_id": "678cb3b0-925f-4359-88aa-bf507912a389",
                                "sense_id": "36808b1e-3630-34ad-9f71-fe3082d3c2d5",
                                "text": "La parole du psychanalyste touche le patient parce qu'elle renvoie à ce dernier quelque chose de lui qu'il va reconnaître comme lui appartenant et qu'il va re-trouver et se ré-approprier."
                            },
                            {
                                "example_id": "342a6e0b-28a8-4b7f-8530-bdc0f435bfd1",
                                "sense_id": "36808b1e-3630-34ad-9f71-fe3082d3c2d5",
                                "text": "Le collectif se ré-approprie ce concept en replaçant la notion de “re-documentariser un document” dans sa perspective historique et comme correspondant au travail des professionnels de l’information et de l’archivage, des bibliothécaires, documentalistes et des archivistes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
