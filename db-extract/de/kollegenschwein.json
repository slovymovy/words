                ],
                "senses": [
                    {
                        "sense_id": "85d6ee0f-138e-31af-a5ed-ada208570695",
                        "entry_id": "96774403-3dd0-3fff-babd-7d653bc147ef",
                        "glosses": [
                            "Person, die im gleichen Unternehmen, in der gleichen Organisation, Einrichtung tätig ist, sich aber unsolidarisch verhält"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "37e00618-58c4-4009-839f-e02097899af0",
                                "sense_id": "85d6ee0f-138e-31af-a5ed-ada208570695",
                                "text": "„Zudem hätte der Disziplinarbeschuldigte RevInsp NN seit Dezember 2017 bei fast jedem Dienst als krank, Dodel, Kollegenschwein, Drecksau, Irrer usw. bezeichnet.“"
                            },
                            {
                                "example_id": "be697ab8-b0f5-408c-aec6-0ca54e555981",
                                "sense_id": "85d6ee0f-138e-31af-a5ed-ada208570695",
                                "text": "„Im Mittelpunkt stand vielmehr die mysteriöse Vergangenheit von Kommissar Karow, der einmal auf Frauen steht, dann wieder auf Männer, der den Ruf als Kollegenschwein weg hat, mit präzisen Analysen aber jeden dieser Kollegen in den Schatten stellt.“"
                            },
                            {
                                "example_id": "11c9bec2-cc2d-493c-a9ad-fa9c3786976e",
                                "sense_id": "85d6ee0f-138e-31af-a5ed-ada208570695",
                                "text": "„Herr G. ist ein Kollegenschwein und eine Rampensau noch dazu, um bildlich im Zoo zu bleiben.“"
                            },
                            {
                                "example_id": "c9e3c417-422a-468d-9da2-ac3b4eba18fc",
                                "sense_id": "85d6ee0f-138e-31af-a5ed-ada208570695",
                                "text": "„Er nannte seinen Teamleiter ein Kollegenschwein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
