                "senses": [
                    {
                        "sense_id": "e7ed9949-93ec-3db1-abe5-65bb2838ec4c",
                        "entry_id": "e2782557-25e4-3510-84bf-1d6db018d11c",
                        "glosses": [
                            "Fureter, fouiller, fouiner."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "14724a80-db8a-4668-9fa4-6621df73c71a",
                                "sense_id": "e7ed9949-93ec-3db1-abe5-65bb2838ec4c",
                                "text": "Béru, tel un chien de chasse de l’espèce fin limier, fouinasse dans la cave, le groin survolté."
                            },
                            {
                                "example_id": "7b8e2a9a-73ee-4841-b6a4-6f66a8334bfe",
                                "sense_id": "e7ed9949-93ec-3db1-abe5-65bb2838ec4c",
                                "text": "Mais la formule car, ça ne pouvait pas marcher, avec ma pomme arrivant dans un petit bled, couchant tout seul et passant ses journées à fouinasser dans la nature ; autant porter la casquette !"
                            },
                            {
                                "example_id": "45fcc49e-97ac-4ce2-8aa8-1cd987298183",
                                "sense_id": "e7ed9949-93ec-3db1-abe5-65bb2838ec4c",
                                "text": "Quelques abois montèrent des fourrés.\n- On dérange le renard, fit Raoul. Demain, y viendra fouinasser ici dès qu’on aura levé le camp."
                            }
                        ]
                    }
                ],
