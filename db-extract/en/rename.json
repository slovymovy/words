                    {
                        "translation_id": "a79c8d9c-87c4-4d9e-a084-dea3b7ffbb76",
                        "source_entry_id": "1d52f71e-ad5e-3161-b509-dec4ddc218f1",
                        "source_sense_id": "5dbd5ee6-292c-38f5-a7ae-3118e4c6f956",
