                    {
                        "sense_id": "3f2b460c-9e21-3666-9e40-d66078fcef01",
                        "entry_id": "10dfa9e6-b6c1-37e5-af34-710b4b1e3c39",
                        "glosses": [
                            "спорт. женск. к пловец"
