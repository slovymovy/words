                    "frequency": "Middle",
                    "semantic_group_id": "allure_animale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cheval blanc <w>galope</w> à toute allure à travers la vaste plaine verdoyante."
                        },
