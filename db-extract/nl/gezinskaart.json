                        "examples": [
                            {
                                "example_id": "2c88f1be-4421-4619-8d24-dd521e2b41e1",
                                "sense_id": "0929c1a0-cc40-3940-84bb-abf878548dc7",
                                "text": "Meedoen kost 12 euro per persoon. Losse dagkaarten kopen kan ook: dat kost 5 euro. Een gezinskaart voor de hele week kost 25 euro. Dagelijks kan tussen 8.30 en 11.00 uur worden gestart; ‘finishen’ bij de eindcontrole kan tot 17.00 uur en op de slotdag op vrijdag tot 15.30 uur."
                            }
