{
    "word_family": [
        "convincing",
        "convincingly",
        "conviction",
        "unconvinced",
        "unconvincing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "48785e7b-91b9-3cdb-a0d9-83312ae343f6",
                    "sense_definition": "To make someone believe or feel sure about something by using logic, argument, or evidence.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "persuasion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer tried to <w>convince</w> the jury that his client was innocent.",
                            "target_lang_translations": {
                                "ru": "Адвокат пытался <w>убедить</w> присяжных в том, что его подзащитный невиновен.",
                                "tr": "Avukat, jüriyi müvekkilinin suçsuz olduğuna <w>ikna etmeye</w> çalıştı."
                            }
                        },
                        {
                            "text": "It is hard to <w>convince</w> someone who refuses to listen to reason.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>убедить</w> того, кто отказывается прислушиваться к доводам разума.",
                                "tr": "Mantığın sesini dinlemeyi reddeden birini <w>ikna etmek</w> zordur."
                            }
                        }
                    ],
                    "synonyms": [
                        "satisfy",
                        "assure"
                    ],
                    "common_phrases": [
                        "convince someone",
                        "hard to convince"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить кого-либо поверить во что-либо или почувствовать уверенность в чем-либо, используя логику, аргументы или доказательства.",
                        "tr": "Mantık, kanıt veya argümanlar kullanarak birinin bir şeye inanmasını veya emin olmasını sağlamak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убедить",
                                "target_lang_sense_clarification": "заставить поверить в истинность чего-либо"
                            },
                            {
                                "target_lang_word": "убеждать",
                                "target_lang_sense_clarification": "процесс приведения аргументов"
                            },
                            {
                                "target_lang_word": "уверить",
                                "target_lang_sense_clarification": "заставить не сомневаться"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ikna etmek",
                                "target_lang_sense_clarification": "birinin bir şeyin doğruluğuna inanmasını sağlamak"
                            },
                            {
                                "target_lang_word": "inandırmak",
                                "target_lang_sense_clarification": "şüpheleri gidermek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdf518c8-0c1b-3c81-941e-84c54c2aa00b",
                    "sense_definition": "To persuade someone to do something or to take a particular course of action.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "persuasion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She managed to <w>convince</w> him to join the team for the upcoming project.",
                            "target_lang_translations": {
                                "ru": "Ей удалось <w>убедить</w> его присоединиться к команде для работы над будущим проектом.",
                                "tr": "Gelecek proje için takıma katılması konusunda onu <w>ikna etmeyi</w> başardı."
                            }
                        },
                        {
                            "text": "I hope I can <w>convince</w> you to stay for dinner tonight.",
                            "target_lang_translations": {
                                "ru": "Надеюсь, мне удастся <w>уговорить</w> вас остаться сегодня на ужин.",
                                "tr": "Umarım bu akşam akşam yemeğine kalmanız için sizi <w>ikna edebilirim</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "persuade",
                        "win over"
                    ],
                    "common_phrases": [
                        "convince to join",
                        "try to convince"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уговорить кого-либо сделать что-либо или принять определенное решение.",
                        "tr": "Birini bir şey yapmaya veya belirli bir yönde hareket etmeye razı etmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убедить",
                                "target_lang_sense_clarification": "склонить к действию"
                            },
                            {
                                "target_lang_word": "уговорить",
                                "target_lang_sense_clarification": "склонить к согласию просьбами или доводами"
                            },
                            {
                                "target_lang_word": "склонить",
                                "target_lang_sense_clarification": "заставить принять сторону или решение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ikna etmek",
                                "target_lang_sense_clarification": "bir eylemi yapmaya razı etmek"
                            },
                            {
                                "target_lang_word": "razı etmek",
                                "target_lang_sense_clarification": "kabul ettirmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5acb9c9b-e2f0-340f-9fdc-1a7d78b9f801",
                    "sense_definition": "To perform a role in a way that is believable to an audience.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor failed to <w>convince</w> in the role of the tragic hero.",
                            "target_lang_translations": {
                                "ru": "Актеру не удалось <w>быть убедительным</w> в роли трагического героя.",
                                "tr": "Oyuncu, trajik kahraman rolünde <w>inandırıcı olamadı</w>."
                            }
                        },
                        {
                            "text": "She didn't quite <w>convince</w> as a seasoned detective in the new play.",
                            "target_lang_translations": {
                                "ru": "Она не совсем <w>вписалась</w> в образ опытного детектива в новой пьесе.",
                                "tr": "Yeni oyunda deneyimli bir dedektif olarak pek <w>inandırıcı değildi</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "convince in the role"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исполнить роль так, чтобы зрители поверили в образ персонажа.",
                        "tr": "Bir rolü seyircinin inanacağı bir şekilde canlandırmak, inandırıcı olmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть убедительным",
                                "target_lang_sense_clarification": "о качестве игры актера"
                            },
                            {
                                "target_lang_word": "вжиться в роль",
                                "target_lang_sense_clarification": "достоверно изобразить персонажа"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "inandırıcı olmak",
                                "target_lang_sense_clarification": "oyunculukta gerçekçi hissettirmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "571e58a4-a0aa-30c1-8f90-d2a386ebfa1b",
                    "sense_definition": "To prove someone wrong or to refute an argument.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "refutation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used the ancient scriptures to <w>convince</w> his opponents of their errors.",
                            "target_lang_translations": {
                                "ru": "Он использовал древние писания, чтобы <w>изобличить</w> своих оппонентов в их заблуждениях.",
                                "tr": "Rakiplerini hataları konusunda <w>haksız çıkarmak</w> için kadim yazıtları kullandı."
                            }
                        },
                        {
                            "text": "The philosopher sought to <w>convince</w> the skeptics through rigorous logical proofs.",
                            "target_lang_translations": {
                                "ru": "Философ стремился <w>опровергнуть</w> сомнения скептиков с помощью строгих логических доказательств.",
                                "tr": "Filozof, sıkı mantıksal kanıtlarla şüphecilerin iddialarını <w>çürütmeye</w> çalıştı."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in the sense of refuting or proving wrong"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Доказать чью-либо неправоту или опровергнуть аргумент (устаревшее значение).",
                        "tr": "Birinin yanıldığını kanıtlamak veya bir argümanı çürütmek (eski kullanım)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изобличить",
                                "target_lang_sense_clarification": "показать ложность взглядов"
                            },
                            {
                                "target_lang_word": "опровергнуть",
                                "target_lang_sense_clarification": "доказать ложность утверждения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "haksız çıkarmak",
                                "target_lang_sense_clarification": "yanıldığını kanıtlamak"
                            },
                            {
                                "target_lang_word": "çürütmek",
                                "target_lang_sense_clarification": "iddiasını boşa çıkarmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0bd7e2a3-d5d8-3969-be8d-fc2005c7642b",
                    "sense_definition": "To prove someone is guilty of a crime; to convict.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The evidence was not strong enough to <w>convince</w> him of the crime.",
                            "target_lang_translations": {
                                "ru": "Улик было недостаточно, чтобы <w>уличить</w> его в преступлении.",
                                "tr": "Kanıtlar onu suçtan dolayı <w>mahkum etmeye</w> yeterince güçlü değildi."
                            }
                        },
                        {
                            "text": "They sought to <w>convince</w> the prisoner of his sins before the trial.",
                            "target_lang_translations": {
                                "ru": "Они пытались заставить заключенного <w>раскаяться</w> в своих грехах перед судом.",
                                "tr": "Duruşmadan önce mahkuma günahlarını <w>kabul ettirmeye</w> çalıştılar."
                            }
                        }
                    ],
                    "common_phrases": [
                        "convince of a crime"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in the sense of convicting or proving guilt"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Доказать виновность кого-либо в преступлении; осудить (устаревшее значение).",
                        "tr": "Birinin bir suçtan suçlu olduğunu kanıtlamak; mahkum etmek (eski kullanım)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уличить",
                                "target_lang_sense_clarification": "доказать вину"
                            },
                            {
                                "target_lang_word": "осудить",
                                "target_lang_sense_clarification": "признать виновным"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "suçlamak",
                                "target_lang_sense_clarification": "suçunu kanıtlamak"
                            },
                            {
                                "target_lang_word": "mahkum etmek",
                                "target_lang_sense_clarification": "suçlu bulmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a53b16d6-5c50-3104-a1b2-c1a719aec9e2",
                    "sense_definition": "To overcome, conquer, or vanquish.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "conquest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king intended to <w>convince</w> his enemies through sheer military might.",
                            "target_lang_translations": {
                                "ru": "Король намеревался <w>покорить</w> своих врагов одной лишь военной мощью.",
                                "tr": "Kral, sadece askeri gücüyle düşmanlarına <w>boyun eğdirmeyi</w> amaçladı."
                            }
                        },
                        {
                            "text": "He hoped that the wine would <w>convince</w> the guards' senses and allow him to escape.",
                            "target_lang_translations": {
                                "ru": "Он надеялся, что вино <w>одурманит</w> чувства стражников и позволит ему сбежать.",
                                "tr": "Şarabın muhafızların duyularını <w>alt edeceğini</w> ve kaçmasına izin vereceğini umuyordu."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in the sense of overcoming or conquering"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Преодолеть, победить или покорить (устаревшее значение).",
                        "tr": "Yenmek, mağlup etmek veya fethetmek (eski kullanım)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покорить",
                                "target_lang_sense_clarification": "подчинить своей воле"
                            },
                            {
                                "target_lang_word": "одолеть",
                                "target_lang_sense_clarification": "победить силой"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "boyun eğdirmek",
                                "target_lang_sense_clarification": "hakkından gelmek"
                            },
                            {
                                "target_lang_word": "alt etmek",
                                "target_lang_sense_clarification": "yenilgiye uğratmak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}