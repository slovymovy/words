                                "example_id": "7795cc49-a793-4a5a-9efb-1a769acbb02a",
                                "sense_id": "14543cb1-382d-3dc4-a38c-1bffb4ba14a5",
                                "text": "Les Canadiens qui se rendent en Moldova doivent être en possession d’un passeport canadien encore valide pendant au moins six mois après la date d’arrivée au pays."
                            }
                        ]
