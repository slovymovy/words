                                    {
                                        "sense_id": "a8365656-3585-3d4d-af96-64ee26d422c6",
                                        "entry_id": "fe1dc8c8-994f-3d78-9a12-cc65ef099fc1",
                                        "glosses": [
                                            "Avorter."
                                        ],
                                        "tags": [
                                            "euphemism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dbcdc40-f8fb-4573-b2b9-d75aef2ca883",
                                                "sense_id": "a8365656-3585-3d4d-af96-64ee26d422c6",
                                                "text": "Dans les quarante-huit heures, Laurent se serait arrangé pour faire passer l’enfant et aurait regagné le bercail, dégrisé, soulagé et reconnaissant."
                                            },
                                            {
                                                "example_id": "5a36fcaf-4289-4d6d-83b2-cc96a96b7949",
                                                "sense_id": "a8365656-3585-3d4d-af96-64ee26d422c6",
                                                "text": "Il fallait « faire passer » d’une façon – en Suisse pour les riches – ou d’une autre – dans la cuisine d’une femme inconnue sans spécialité sortant une sonde bouillie d’un fait-tout. Avoir lu Simone de Beauvoir ne servait à rien qu’à vérifier le malheur d’avoir un utérus."
                                            },
                                            {
                                                "example_id": "6346e470-07f3-49af-8808-8c79eaa218c8",
                                                "sense_id": "a8365656-3585-3d4d-af96-64ee26d422c6",
                                                "text": "Je voulais faire passer l’enfant, j’ai pris rendez-vous avec une faiseuse d’anges..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
