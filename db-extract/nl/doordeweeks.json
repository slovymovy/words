                        "entry_id": "946cc1b4-0540-3f18-92a2-b3f5fbaf671d",
                        "glosses": [
                            "op een dag die in de werkweek valt: maandag, dinsdag, woensdag, donderdag en vrijdag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3782c8a9-d093-4909-acda-e80e5e610538",
                                "sense_id": "6f280b71-ccf4-3c32-8744-2e1d764a680f",
                                "text": "Op doordeweekse dagen is het hier altijd erg druk, maar niet op zaterdag en zondag."
                            },
                            {
                                "example_id": "4dc45b4d-6832-4498-b187-0fbd92af467f",
                                "sense_id": "6f280b71-ccf4-3c32-8744-2e1d764a680f",
                                "text": "‘s Lands grootste doordeweekse wielertoertocht werd onder prima weersomstandigheden verreden, al stelde de stevige bries de conditie van menig deelnemer behoorlijk op de proef."
                            }
                        ]
                    }
