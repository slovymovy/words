                                        "sense_id": "1c8225dc-73d3-35d7-b51c-e1495f47b761",
                                        "entry_id": "bf55609b-fdf8-3cb4-914d-cf31e72c02de",
                                        "glosses": [
                                            "jemand, der tote Tiere ausstopft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d19b444-8243-46db-8c97-b456bbfa1cf5",
                                                "sense_id": "1c8225dc-73d3-35d7-b51c-e1495f47b761",
                                                "text": "Ich brachte den toten Bären zum Taxidermisten."
                                            }
                                        ],
