                                                "sense_id": "329b0ea7-c638-3989-be4a-d9dc4571e8b7",
                                                "text": "Na znak kapitulacji wywiesili na wieży białą flagę."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "d00cd164-f9aa-36a0-a714-8141a803734b",
                                        "entry_id": "e9317bb3-48b7-3a4b-aab8-57cb9ce06fcb",
                                        "glosses": [
                                            "rezygnacja ze swoich zamiarów, przyznanie racji stronie przeciwnej"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57139b22-3ce3-4f92-a56f-36c7803431d6",
                                                "sense_id": "d00cd164-f9aa-36a0-a714-8141a803734b",
                                                "text": "Miał słabe argumenty, więc jego kapitulacja była nieuchronna."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "963497c7-a245-37c6-be89-bcc8112718bc",
                                        "entry_id": "e9317bb3-48b7-3a4b-aab8-57cb9ce06fcb",
