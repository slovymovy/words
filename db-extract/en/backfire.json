                        "examples": []
                    },
                    {
                        "sense_id": "bd2dd5d5-8b7d-38f9-9cde-23e16b28587e",
                        "entry_id": "761d4852-7ac0-3ee1-a57d-d3e29986f5f0",
                        "glosses": [
                            "A premature explosion in the cylinder of a gas or oil engine during the exhaust or the compression stroke, tending to drive the piston in the wrong direction."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "92d81e85-7224-31ea-abb3-07f0d6155197",
                        "entry_id": "761d4852-7ac0-3ee1-a57d-d3e29986f5f0",
                        "glosses": [
                            "An explosion in the exhaust passages of an internal combustion engine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69242cc5-de2a-420d-8f63-65441404edd2",
                                "sense_id": "92d81e85-7224-31ea-abb3-07f0d6155197",
                                "text": "As much of Seattle tries to sleep, the Hellcat supercar goes on the prowl, the howls of its engine and the explosive backfires from its tailpipes echoing off the high-rise towers downtown."
                            }
                        ]
                    },
                    {
                        "sense_id": "170bb202-8373-3c46-8e11-a23c81fd2bd8",
                        "entry_id": "761d4852-7ac0-3ee1-a57d-d3e29986f5f0",
                        "glosses": [
                            "An explosion in other equipment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd52d01a-dca4-4625-89b1-242a2b73d88a",
                                "sense_id": "170bb202-8373-3c46-8e11-a23c81fd2bd8",
                                "text": "The chief causes of rectifier backfiring in the Glasgow units were overheating or unfavourable anode/cathode temperature differential; it has proved possible to overcome these, although occasional backfires do still occur."
                            }
                        ]
                    }
                ],
