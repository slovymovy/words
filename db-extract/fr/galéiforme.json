                                "example_id": "6c9a0205-b4ab-422d-8c8b-b0ea5f77f54b",
                                "sense_id": "869c8029-5aaf-32a9-b8cb-aad6f4b8b097",
                                "text": "Le pétale supérieur des aconits est galéiforme."
                            }
