                "senses": [
                    {
                        "sense_id": "8e83df2f-0745-3398-9da8-464c25225fff",
                        "entry_id": "af14a5b0-5bc6-3b9d-ba3a-72e5ec13c092",
                        "glosses": [
                            "op een manier die je zelf duidelijk ervaart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53996a3a-9d96-492b-b135-8d33d075760e",
                                "sense_id": "8e83df2f-0745-3398-9da8-464c25225fff",
                                "text": "Het leven in een psychiatrisch ziekenhuis kan men zich pas goed voorstellen wanneer men het heeft meegemaakt, het bevindelijk heeft leren kennen zoals de ‘oude schrijvers’ zeggen."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2fe8cf8-6115-3183-8c04-9362a7dc119b",
                        "entry_id": "af14a5b0-5bc6-3b9d-ba3a-72e5ec13c092",
                        "glosses": [
                            "met een geloof dat voortkomt uit de persoonlijke ervaring van de gelovige zelf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8499dbd1-09e7-4655-a1a5-fc79733c6698",
                                "sense_id": "a2fe8cf8-6115-3183-8c04-9362a7dc119b",
                                "text": "Bevindelijk gereformeerden vormen een orthodox-protestantse groepering, die zich binnen het gereformeerd protestantisme en specifiek van orthodox-gereformeerden onderscheidt door grote nadruk te leggen op het belang van bevinding of persoonlijke geloofservaring. Door het vasthouden aan oude gebruiken en het afwijzen van bepaalde technologische en wetenschappelijke ontwikkelingen zijn zij tevens als sociologische groep in de samenleving te onderscheiden."
                            }
                        ]
                    }
