                                        "sense_id": "7cb72447-a2d4-38ea-8600-e0a83a87dd31",
                                        "entry_id": "744d92ba-eb92-3f05-a50b-ebb3d2cad0f3",
                                        "glosses": [
                                            "Que compila materiales de distintas fuentes para producir una colección."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1abf597d-1055-42bd-a862-472d5f336018",
                                                "sense_id": "7cb72447-a2d4-38ea-8600-e0a83a87dd31",
                                                "text": "Vivía a la sazón en París otro médico, llamado Antonio Mizaldo, bien conocido de los curiosos de secretos de naturaleza, por el libro que escribió de Arcanis naturae, hombre docto, pero mui crédulo, y gran compilador de quanto llegaba a su noticia, perteneciente a maravillas y arcanos."
                                            }
                                        ],
