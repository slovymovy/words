                "senses": [
                    {
                        "sense_id": "40d9c411-7f0f-370a-a3e1-aa70164d6e76",
                        "entry_id": "76c3d522-bf8e-3d82-b165-11316761b345",
                        "glosses": [
                            "od: owca"
                        ],
                        "tags": [
                            "colloquial",
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "7d38df26-2dc0-43e3-8ff8-2e2d5ce9702d",
                                "sense_id": "40d9c411-7f0f-370a-a3e1-aa70164d6e76",
                                "text": "Czy ta owieczka nie jest urocza?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "cf2ce13b-25c5-31c2-8d4b-e113d803cff3",
                        "entry_id": "76c3d522-bf8e-3d82-b165-11316761b345",
                        "glosses": [
                            "młoda owca"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "6a1d91a6-2c84-3a19-b189-fe3f913d22f5",
                        "entry_id": "76c3d522-bf8e-3d82-b165-11316761b345",
                        "glosses": [
                            "członek chrześcijańskiej wspólnoty religijnej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9e3e434-87d6-470d-8516-5f32265d4359",
                                "sense_id": "6a1d91a6-2c84-3a19-b189-fe3f913d22f5",
                                "text": "Potem bardzo wymownie i z wielkim przejęciem się ostrzegał swoje owieczki, aby jako prostaczkowie, ubodzy niby owi ptakowie niebiescy, a zatem mili Bogu, nie słuchali rozmaitych fałszywych mędrców…"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8edacc2c-38bb-41bb-b5ce-74d1eeb0b4b4",
                        "source_entry_id": "76c3d522-bf8e-3d82-b165-11316761b345",
                        "source_sense_id": "cf2ce13b-25c5-31c2-8d4b-e113d803cff3",
                        "target_lang_word": "Schäfchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schäfchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0bb7445-0966-32da-bde9-7e7b6751bfd5",
                                        "entry_id": "e962f4c4-fea6-3799-ad9d-e8eb07fda477",
                                        "glosses": [
                                            "kleines Schaf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c79e8ff1-0193-4418-a502-4c61f4d57dea",
                                                "sense_id": "f0bb7445-0966-32da-bde9-7e7b6751bfd5",
                                                "text": "Das kleine Schäfchen steht mit dem Mutterschaf auf der Weide."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dd9cdb56-c74f-39a2-8811-ffae8ba2b233",
                                        "entry_id": "e962f4c4-fea6-3799-ad9d-e8eb07fda477",
                                        "glosses": [
                                            "Menschen, die in jemandes Obhut stehen, die Gläubigen einer religiösen Gemeinschaft oder Kinder"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c045115b-79a8-40ad-8c6a-cdc8d65c09dc",
                                                "sense_id": "dd9cdb56-c74f-39a2-8811-ffae8ba2b233",
                                                "text": "Der Lehrer bemüht sich, seinen Schäfchen etwas beizubringen."
                                            },
                                            {
                                                "example_id": "e0c3504d-2169-4523-957b-112015d2566e",
                                                "sense_id": "dd9cdb56-c74f-39a2-8811-ffae8ba2b233",
                                                "text": "Andachtsvoll hören die Schäfchen in der Kirche der Predigt zu."
                                            },
                                            {
                                                "example_id": "d4f1fb65-ddb9-4cc1-81c5-5824f44131fc",
                                                "sense_id": "dd9cdb56-c74f-39a2-8811-ffae8ba2b233",
                                                "text": "„Wiederum kam den örtlichen Pfarrern bei der Beurteilung der individuellen Schuld ihrer Schäfchen eine tragende Rolle zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "43e07f3c-bd26-393f-afcc-f5af25773e7c",
                                        "entry_id": "e962f4c4-fea6-3799-ad9d-e8eb07fda477",
                                        "glosses": [
                                            "Schäfchenwolke"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca1345f6-4bcc-4753-be04-3e782acaafff",
                                                "sense_id": "43e07f3c-bd26-393f-afcc-f5af25773e7c",
                                                "text": "Kleine, weiße Schäfchen ziehen über den blauen Himmel."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "05fe7b7c-280b-36ef-8b4f-9a466d4ab3fe",
                                        "entry_id": "e962f4c4-fea6-3799-ad9d-e8eb07fda477",
                                        "glosses": [
                                            "Kosewort (meist für ein Kind)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40a0d160-6cdc-4c83-acf2-279602577f68",
                                                "sense_id": "05fe7b7c-280b-36ef-8b4f-9a466d4ab3fe",
                                                "text": "Komm her, mein Schäfchen!"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
