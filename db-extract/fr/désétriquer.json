                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a48b7a23-477b-4bd6-9dc0-09361b7ae3e6",
                                "sense_id": "5b93f6f6-539d-39e3-9553-44668344d49d",
                                "text": "On te demande pas d’être rationnel, mais de désétriquer ton cerveau, et d’accepter la dimension presque irréelle et émotionnelle d’une histoire qui n’est pas vraiment la vie mais l’est quand même un peu…"
                            },
                            {
                                "example_id": "8ef2a4fe-2d7f-4f7c-93bc-e804689ca1ce",
                                "sense_id": "5b93f6f6-539d-39e3-9553-44668344d49d",
                                "text": "J’ai beaucoup changé : je me suis désétriqué, si vous voulez !"
                            }
                        ]
                    }
