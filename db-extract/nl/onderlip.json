                ],
                "senses": [
                    {
                        "sense_id": "4d8a3a0a-4d78-30fe-acf2-db00f31be8b4",
                        "entry_id": "89eff3a7-e3ea-35fb-939e-5ce52a135038",
                        "glosses": [
                            "de onderste van de twee lippen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99b43fec-2365-47c6-a92e-597486eb1312",
                                "sense_id": "4d8a3a0a-4d78-30fe-acf2-db00f31be8b4",
                                "text": "Een lipschotel is een ronde schijf van klei of hout die in sommige Afrikaanse en Amerikaanse culturen traditioneel in een gat in de boven- of onderlip wordt aangebracht om deze op te rekken."
                            },
                            {
                                "example_id": "136445a7-4871-4225-a2e2-ff3eb80928d0",
                                "sense_id": "4d8a3a0a-4d78-30fe-acf2-db00f31be8b4",
                                "text": "Ik keek naar zijn dikke onderlip, die opvallend vlezig leek in zijn smalle gezicht, en waar spuug op glinsterde. Hij had zulke grote tanden en kiezen dat hij zijn lippen niet helemaal op elkaar kreeg. Ik wilde het liefst achteruitdeinzen voor zijn onaangename adem."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b27a48fd-6bae-4557-b9f4-8fe141a46406",
                        "source_entry_id": "89eff3a7-e3ea-35fb-939e-5ce52a135038",
                        "source_sense_id": "4d8a3a0a-4d78-30fe-acf2-db00f31be8b4",
                        "target_lang_word": "Unterlippe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterlippe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "413b05f5-a40e-36fe-b5f6-c88c2a6fb3d3",
                                        "entry_id": "2c9677b7-2e73-3e8a-b6bf-539579ee1752",
                                        "glosses": [
                                            "der untere Teil der Lippen von Säugetieren und des Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee29dd70-6e24-499f-871c-20d1efecc25b",
                                                "sense_id": "413b05f5-a40e-36fe-b5f6-c88c2a6fb3d3",
                                                "text": "Ich habe mir auf die Unterlippe gebissen."
                                            },
                                            {
                                                "example_id": "4b93151d-0175-46db-812e-c6be462d32bd",
                                                "sense_id": "413b05f5-a40e-36fe-b5f6-c88c2a6fb3d3",
                                                "text": "„Die Unterlippe hing so weit herunter, dass man das Zahnfleisch und seine gleichmäßig abgeschliffenen Zähne im Unterkiefer sah.“"
                                            },
                                            {
                                                "example_id": "0c99ad55-7e83-4878-9c3c-4d110eedd24a",
                                                "sense_id": "413b05f5-a40e-36fe-b5f6-c88c2a6fb3d3",
                                                "text": "„Der junge Mann zieht die Unterlippe tief zwischen die Zähne und wendet sich halb ab.“"
                                            },
                                            {
                                                "example_id": "b85f7f1b-79d9-41df-9b15-8228877446d1",
                                                "sense_id": "413b05f5-a40e-36fe-b5f6-c88c2a6fb3d3",
                                                "text": "„Dann schiebt er den Unterkiefer vor, stülpt die Unterlippe über die Oberlippe, in der einen Hand den Hammer, in der anderen einen Nagel.“"
                                            },
                                            {
                                                "example_id": "57583005-92c8-4488-abf3-dacd7bd6029f",
                                                "sense_id": "413b05f5-a40e-36fe-b5f6-c88c2a6fb3d3",
                                                "text": "„Dem Einarmigen war plötzlich die Unterlippe hinuntergerutscht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7695eb5-4346-45f9-81b4-02e24b6dad63",
                        "source_entry_id": "89eff3a7-e3ea-35fb-939e-5ce52a135038",
