            "senses": [
                {
                    "sense_id": "5d25df93-14e0-3931-a4ab-3774bc8a10e0",
                    "sense_definition": "Great sadness, distress, or misery.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sadness_and_trouble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man's face was a picture of <w>woe</w> as he spoke of his lost home.",
                            "target_lang_translations": {
                                "pl": "Twarz starca była obrazem <w>żałości</w>, gdy mówił o swoim utraconym domu."
                            }
                        },
                        {
                            "text": "She listened to his tale of <w>woe</w> with deep sympathy and patience.",
                            "target_lang_translations": {
                                "pl": "Wysłuchała jego opowieści o <w>niedoli</w> z głębokim współczuciem i cierpliwością."
