                    }
                ],
                "senses": [
                    {
                        "sense_id": "c63dbf57-1492-32cd-a302-94c3c441c4c1",
                        "entry_id": "b91a6fa7-565c-3658-b170-bb4ad58ac3c8",
                        "glosses": [
                            "verplaatsing per rijwiel"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "a9a76a2c-4243-4340-9ca7-5e88ed26925b",
                                "sense_id": "c63dbf57-1492-32cd-a302-94c3c441c4c1",
                                "text": "Uit de omschrijving, die ik daarna moest geven concludeerde de Edelachtbare, dat het tweewielig voortbewegingsinstrument toch inderdaad een ding was, dat men in de wandeling of liever in de fietseling een rijwiel pleegt te noemen."
                            }
                        ]
                    },
                    {
                        "sense_id": "c668744d-3543-3be6-aa5e-6806f447fe45",
                        "entry_id": "b91a6fa7-565c-3658-b170-bb4ad58ac3c8",
                        "glosses": [
                            "tocht per rijwiel door een grote groep mensen als middel om de aandacht op een bepaald probleem te vestigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a8a17c6-6960-4c15-bace-a93d14333017",
                                "sense_id": "c668744d-3543-3be6-aa5e-6806f447fe45",
                                "text": "Op zondag 11 augustus viert het Lappersfort één jaar bezetting met gidsbeurten door het bos, een boottocht en een nieuwe fietseling tegen de Zuidelijke Ontsluiting."
                            },
                            {
                                "example_id": "767a83a5-6e0d-4c88-8b09-ada57498c6d2",
                                "sense_id": "c668744d-3543-3be6-aa5e-6806f447fe45",
                                "text": "Daarnaast fietste hij reeds vanaf de eerste fietseling in 1973 te Antwerpen mee met de Groene Fietsers en was hij actief in Tram voor Alleman, Werkgroep Verkeer Antwerpen, het FietsOntlastingsFonds (FOFO) en de Mortselse Verkeerscommissie."
                            },
                            {
                                "example_id": "93e78dc4-2259-4c6f-bfd7-e41772ef2f64",
                                "sense_id": "c668744d-3543-3be6-aa5e-6806f447fe45",
                                "text": "Fietseling is het woord, dat de aanhangers van de Vlaamse Agalev-beweging (anders gaan leven) geven aan hun milieu-manifestaties. Deze vinden zonder uitzondering op de tweewieler plaats."
                            }
                        ]
                    },
                    {
                        "sense_id": "e98244fc-d917-3e7f-b028-2a4659f56ca2",
                        "entry_id": "b91a6fa7-565c-3658-b170-bb4ad58ac3c8",
                        "glosses": [
                            "evenement waarbij recreanten een uitgezette tocht per rijwiel maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58d164fa-1896-481f-9107-d03ff4ff0c7e",
                                "sense_id": "e98244fc-d917-3e7f-b028-2a4659f56ca2",
                                "text": "Fietseling, de wielerklassieker voor het hele gezin, vindt dit jaar plaats op zondag 2 juni. Drie routes gaan langs de mooiste plekjes in en rondom Merksem."
                            },
                            {
                                "example_id": "0da19b82-1c08-414c-ba69-c72f8daeb13d",
                                "sense_id": "e98244fc-d917-3e7f-b028-2a4659f56ca2",
                                "text": "Die dinsdag 23/08 sluiten we voor de dagtocht aan bij de regionale fietseling, georganiseerd door OKRA Zoersel. Daardoor hebben we op 30 augustus nog een gewone namiddagtocht vanaf 13.30 u. Kom bij ons: fiets je gezond met plezier!"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "452d3d62-7c54-3c5f-91e3-34d4dafd9eaa",
