                        "glosses": [
                            "trichterförmiger Behälter aus zumeist (zusammengedrehtem) Papier (besonders für Lebensmittel)"
                        ],
                        "tags": [
                            "Bavarian",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "c24f16a2-b0b1-4750-a9c0-3fbca0ff807c",
                                "sense_id": "82fdce95-457a-3eea-98f1-bb6bd6686d9f",
                                "text": "„Früher gab es noch andere Namen für das vielgenutzte packpapierene Behältnis, Skarnitzel, Gestattel oder auch Krämerhäuslein, aber am Ende hat die Tüte sie geschluckt. Skarnitzel, Gestattel, Krämerhäuslein, selbdritt sind sie verschwunden in der ordinären Tüte, die heutzutage meist aus Plastik ist.“"
                            }
                        ],
