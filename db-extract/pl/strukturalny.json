                ],
                "senses": [
                    {
                        "sense_id": "5ab87df7-d7ce-3321-bc29-aab4e4ecdbfd",
                        "entry_id": "849504ff-6a8d-3c5e-8637-5c6125b5ef4d",
                        "glosses": [
                            "dotyczący struktury"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52422728-60f8-48ac-a616-2e8ed88ba2ea",
                                "sense_id": "5ab87df7-d7ce-3321-bc29-aab4e4ecdbfd",
                                "text": "Głównym motywem strukturalnym krzemianów są czworościany zbudowane z krzemu znajdującego się w środku i otoczonego czterema atomami tlenu umieszczonymi na wierzchołkach."
                            },
                            {
                                "example_id": "ecc5101f-d864-48e7-800a-d098dcf71357",
                                "sense_id": "5ab87df7-d7ce-3321-bc29-aab4e4ecdbfd",
                                "text": "Konsekwencją erozji jest zmniejszenie obiektu, zniknięcie wąskich gałęzi i małych obiektów, likwidacja szumu, rozszerzenie się „dziur” w niespójnym obszarze – przyjmują one kształt elementu strukturalnego."
                            },
                            {
                                "example_id": "57bedc7b-c9ca-4dff-b542-4dbf549c4bc9",
                                "sense_id": "5ab87df7-d7ce-3321-bc29-aab4e4ecdbfd",
                                "text": "Strukturalne podobieństwa składu osobowego, form organizacyjnych czy faz rozwojowych nie muszą bynajmniej przesądzać o zbieżnościach pod innymi względami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "410f1af3-b232-44f8-9521-57dd104ec91d",
                        "source_entry_id": "849504ff-6a8d-3c5e-8637-5c6125b5ef4d",
                        "source_sense_id": "5ab87df7-d7ce-3321-bc29-aab4e4ecdbfd",
                        "target_lang_word": "structural",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "structural",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0755e384-b80a-3e2d-8507-1cef03626180",
                                        "entry_id": "89a6634d-cf56-3462-8ffd-a2d2b0a71c43",
                                        "glosses": [
                                            "Of, relating to, or having structure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51bc2629-ff1b-40f0-8150-3aa0dbf64ab1",
                                                "sense_id": "0755e384-b80a-3e2d-8507-1cef03626180",
                                                "text": "Class 1. consists of nervous diseases, such as depend on the nervous and muscular systems; the second, of sanguine diseases, such as depend on the sanguiferous system; the third, of secretory diseases, or such as are connected with the state of the secretions; and the fourth, of structural diseases, or those that are connected with the nutritive powers."
                                            },
                                            {
                                                "example_id": "f94433c5-af4d-45f9-9435-40505bbf20c7",
                                                "sense_id": "0755e384-b80a-3e2d-8507-1cef03626180",
                                                "text": "These structural differences, the authors suggest, support previous reports of differences in personality: liberals tend to be better at managing conflicting information, while conservatives are though to be better at recognizing threats, researchers said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fac459e-6eae-3eb0-b770-bd26d0773afe",
                                        "entry_id": "89a6634d-cf56-3462-8ffd-a2d2b0a71c43",
                                        "glosses": [
                                            "Involving the mechanics of construction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "structural",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c0588ed-0165-3efb-bf47-09292dd9de06",
                                        "entry_id": "f0097247-45aa-3cdd-aa7f-6db6cc605557",
                                        "glosses": [
                                            "Structural steel, used in construction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a934f697-2767-466d-9587-9580ad267761",
                                                "sense_id": "2c0588ed-0165-3efb-bf47-09292dd9de06",
                                                "text": "Freight differentials often increased the spread in favor of the imported structurals. Purchasers repeatedly emphasized that their purchases of imported structurals were split among a number of sources, including Spain, France, West Germany, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6adc4f5-1db7-47e4-a8dd-957d5352701b",
                        "source_entry_id": "849504ff-6a8d-3c5e-8637-5c6125b5ef4d",
                        "source_sense_id": "5ab87df7-d7ce-3321-bc29-aab4e4ecdbfd",
                        "target_lang_word": "structural",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "structural",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d796943-5389-3a0b-8006-ed1c2113abac",
                                        "entry_id": "ac23a09e-952a-35f2-b53a-e164083c1b2b",
                                        "glosses": [
                                            "Structurel, qui touche à la structure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "554de50e-0c09-4b8e-81d9-87557bc488b4",
                                                "sense_id": "0d796943-5389-3a0b-8006-ed1c2113abac",
                                                "text": "La Scolastique […] a accrédité une mentalité qui n'a pas prise sur le réel, qui tient pour légitimes certaines illusions structurales de notre esprit : notre tendance à réaliser nos concepts et à réifier toutes choses."
                                            },
                                            {
                                                "example_id": "ec839f7b-0f67-427d-add5-8f62a6e933f8",
                                                "sense_id": "0d796943-5389-3a0b-8006-ed1c2113abac",
                                                "text": "Si on dispose orthogonalement entre elles deux voûtes en berceau et que l'on élimine les parties qui se trouvent en dessous de l'intersection, on obtient une nouvelle figure structurale appelée voûte d'arêtes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0cda4a2-fe65-4312-bf17-e2bc5341e76b",
                        "source_entry_id": "849504ff-6a8d-3c5e-8637-5c6125b5ef4d",
                        "source_sense_id": "5ab87df7-d7ce-3321-bc29-aab4e4ecdbfd",
