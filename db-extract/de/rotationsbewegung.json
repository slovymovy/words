                "senses": [
                    {
                        "sense_id": "37c51a3a-615b-3a8d-8c74-9035e25d54df",
                        "entry_id": "7e20c46c-37f7-3850-ae77-88ab5833966f",
                        "glosses": [
                            "Bewegung eines Punktes oder Körpers um eine Drehachse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52ca8c05-632d-4598-9fcd-f5ad15324b2e",
                                "sense_id": "37c51a3a-615b-3a8d-8c74-9035e25d54df",
                                "text": "„Die Rotationsbewegungen um die Querachse werden bei Flugzeugen als Nicken bezeichnet, da hier eine ähnliche Bewegung wie beim Nicken des Kopfes ausgeführt wird.“"
                            },
                            {
                                "example_id": "9d23618d-9825-4c38-aeee-0b9ba5e96e47",
                                "sense_id": "37c51a3a-615b-3a8d-8c74-9035e25d54df",
                                "text": "„Gleichzeitig erhält das Geschoss bei der Beschleunigung eine Rotationsbewegung in Längsrichtung, also den Drall, was sich auf die Präzision der Flugbahn auswirkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
