                    },
                    {
                        "translation_id": "ed42fd19-87fa-4a87-a6ac-bd367c04f24a",
                        "source_entry_id": "d1dc0593-3ff0-3849-9b80-ce40effa648c",
                        "source_sense_id": "aa583156-ec6e-3cec-9cae-bf2e57f731e7",
                        "target_lang_word": "Halluzination",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Halluzination",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb4b73a2-d368-37c9-8eb5-574b4390f535",
                                        "entry_id": "9435fd98-ffa5-3c97-b7ec-9a6c2ab67720",
                                        "glosses": [
                                            "Sinneseindruck ohne nachweisbaren äußeren Reiz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65ea0a56-59a5-4a02-93ed-adad44ba476b",
                                                "sense_id": "bb4b73a2-d368-37c9-8eb5-574b4390f535",
                                                "text": "Typisch für eine Schizophrenie sind vor allem akustische Halluzinationen."
                                            },
                                            {
                                                "example_id": "0823e3f6-f759-4499-8435-d7d4212da438",
                                                "sense_id": "bb4b73a2-d368-37c9-8eb5-574b4390f535",
                                                "text": "„Das war einfach eine Halluzination gewesen.“"
                                            },
                                            {
                                                "example_id": "4847b2d8-4ee6-495e-83c4-61d9b8e1bae8",
                                                "sense_id": "bb4b73a2-d368-37c9-8eb5-574b4390f535",
                                                "text": "„Bei Halluzinationen handelt es sich meist um sehr zahlreich auftretende Bilder, die entweder der gewünschten Zukunft oder der analysierten Vergangenheit, je nach Krankheitsintensität oder Erschöpfung des Gehirns gestuft, entspringen.“"
                                            },
                                            {
                                                "example_id": "e868cdd0-3fa0-4414-9dc3-295549bc7441",
                                                "sense_id": "bb4b73a2-d368-37c9-8eb5-574b4390f535",
                                                "text": "„Hitze und Langeweile führten zu mancherlei Halluzinationen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40e8c799-84bb-4fbb-b5e3-caa304876871",
                        "source_entry_id": "d1dc0593-3ff0-3849-9b80-ce40effa648c",
                        "source_sense_id": "aa583156-ec6e-3cec-9cae-bf2e57f731e7",
                        "target_lang_word": "галлюцина́ция",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "галлюцина́ция",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "082c99d0-e568-32c7-b16f-cc44a895c27f",
                                        "entry_id": "8fa0b238-8f99-3781-947a-bab05c6af62e",
                                        "glosses": [
                                            "психиатр. расстройство восприятия, выражающееся в обманном появлении зрительных, слуховых и т. п. ощущений без наличия реальных объектов и являющееся следствием нарушения деятельности мозга при психических заболеваниях, травмах и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c166dc84-b5c1-4b78-a848-7b31853abcc1",
                                                "sense_id": "082c99d0-e568-32c7-b16f-cc44a895c27f",
                                                "text": "При такой температуре у человека часто появляются бред и галлюцинации."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80756120-15ea-3519-88bb-b0a339db764d",
                                        "entry_id": "8fa0b238-8f99-3781-947a-bab05c6af62e",
                                        "glosses": [
                                            "перен. зрительный, слуховой и т. п. образ, являющийся следствием такого расстройства, а не вызванный реально увиденным, услышанным и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07df49d4-4fb2-4fe7-8fd7-19c6274a94be",
                                                "sense_id": "80756120-15ea-3519-88bb-b0a339db764d",
                                                "text": "Достаточно надавить пальцем на глазное яблоко, и все реальные предметы ― в отличие от галлюцинаций ― раздвоятся."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc258919-da2f-35b1-b163-0503c71a36f5",
                                        "entry_id": "8fa0b238-8f99-3781-947a-bab05c6af62e",
                                        "glosses": [
                                            "информ. сгенерированный искусственным интеллектом ответ, который содержит ложную или вводящую в заблуждение информацию, представленную в качестве факта"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
