                                                "sense_id": "4b215342-2bd1-3b73-b317-e8967cb84c03",
                                                "text": "Ich habe gestern zu viel Alkohol getrunken."
                                            },
                                            {
                                                "example_id": "de7089b7-5e72-447a-b083-82cf50f4469a",
                                                "sense_id": "4b215342-2bd1-3b73-b317-e8967cb84c03",
                                                "text": "„Mir ist Alkohol nicht so wichtig, ich trinke ihn selten.“"
                                            }
