                                                "sense_id": "24940c0f-7052-3b08-b2c9-272cf70353da",
                                                "text": "Viele Kuscheltiere bestehen aus Plüsch."
                                            },
                                            {
                                                "example_id": "a31f0425-f54d-4c08-b85b-0557d70bed8a",
                                                "sense_id": "24940c0f-7052-3b08-b2c9-272cf70353da",
                                                "text": "Ohne sein Kuscheltier war Paul kaum ins Bett zu bekommen."
                                            },
                                            {
                                                "example_id": "c6c8cd1e-9c02-4d9a-816c-f528c372e282",
                                                "sense_id": "24940c0f-7052-3b08-b2c9-272cf70353da",
                                                "text": "Das Kuscheltier fiel aus dem Kinderwagen, und das Geschrei war groß."
                                            },
                                            {
                                                "example_id": "9e1f09af-46d6-4c81-a564-b01e3e727fdb",
                                                "sense_id": "24940c0f-7052-3b08-b2c9-272cf70353da",
                                                "text": "Wir haben ihm einen Pikachu® als Kuscheltier geschenkt."
                                            },
                                            {
                                                "example_id": "bba16a65-74ce-452b-984b-29e66c3c9115",
                                                "sense_id": "24940c0f-7052-3b08-b2c9-272cf70353da",
                                                "text": "„Florian suchte noch sein Kuscheltier zwischen den Bücherstapeln, als ich einen letzten Kontrollblick in meine Handtasche warf.“"
