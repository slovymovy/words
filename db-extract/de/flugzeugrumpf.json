                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Flugzeugrümpfe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c2a16902-d292-3e58-a35e-db3e9c738784",
                        "entry_id": "c6adf2ec-7d1c-34cc-9c96-109f51df6c51",
                        "glosses": [
                            "Bauteil eines Flugzeugs, der das Cockpit und den Raum für Passagiere und Nutzlast beinhaltet"
                        ],
                        "tags": [
                            "Luftfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "b701d953-7975-457b-9387-b34630419fe2",
                                "sense_id": "c2a16902-d292-3e58-a35e-db3e9c738784",
                                "text": "„Zehn Fans, deren Portraitfotos letztendlich auf den Flugzeugrumpf aufgeklebt wurden, wurden aus 400 Einsender ausgewählt.“"
                            },
                            {
                                "example_id": "1f456915-03c1-4d91-91eb-56233db7993f",
                                "sense_id": "c2a16902-d292-3e58-a35e-db3e9c738784",
                                "text": "„Für die Techniker in Hamburg wiederum bedeutete die Generalüberholung vor allem eine Menge Arbeit. So wurden die beiden Tragflächen vom Flugzeugrumpf gelöst und in große, eigens dafür konstruierte Gerüste gehängt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "927a34b4-4264-4e02-832f-181114636cad",
                        "source_entry_id": "c6adf2ec-7d1c-34cc-9c96-109f51df6c51",
                        "source_sense_id": "c2a16902-d292-3e58-a35e-db3e9c738784",
                        "source_sense_description": "Bauteil eines Flugzeugs, der das Cockpit und den Raum für Passagiere und Nutzlast beinhaltet",
                        "target_lang_word": "фюзеляж",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "фюзеляж",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3733b5ed-8b5b-3537-89cc-2ecf3c0209a1",
                                        "entry_id": "ee272ae0-c918-3110-9a76-30065f741941",
                                        "glosses": [
                                            "авиац. корпус летательного аппарата тяжелее воздуха"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a5d83b7-dea4-43f1-991e-06fff3ebd877",
                                                "sense_id": "3733b5ed-8b5b-3537-89cc-2ecf3c0209a1",
                                                "text": "Фюзеля́ж авиалайнера Ил-18 был выполнен герметичным и создавал на высоте необходимый комфорт для пассажиров."
                                            },
                                            {
                                                "example_id": "ad29ccd9-eee2-48ee-83ad-7f75fdae6654",
                                                "sense_id": "3733b5ed-8b5b-3537-89cc-2ecf3c0209a1",
                                                "text": "Камовскому вертолету хвостовой винт не нужен, а следовательно, не нужна длинная, через весь фюзеля́ж, трансмиссия к нему."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
