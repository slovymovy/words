                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "arts_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She worked hard for many years to become a <w>principal</w> with the Royal Ballet.",
                            "target_lang_translations": {
                                "ru": "Она́ мно́го лет усе́рдно рабо́тала, что́бы стать <w>при́мой</w> Короле́вского бале́та.",
                                "nl": "Ze werkte vele jaren hard om <w>eerste solist</w> te worden bij het Koninklijk Ballet.",
                                "de": "Sie arbeitete viele Jahre hart, um <w>Erste Solistin</w> beim Royal Ballet zu werden."
                            }
                        },
                        {
                            "text": "The <w>principal</w> performed the solo with incredible grace and skill.",
                            "target_lang_translations": {
                                "ru": "<w>Премье́р</w> испо́лнил со́льную па́ртию с невероя́тной гра́цией и мастерство́м.",
                                "nl": "De <w>eerste solist</w> voerde de solo uit met ongelooflijke gratie en vaardigheid.",
                                "de": "Der <w>Erste Solist</w> führte das Solo mit unglaublicher Anmut und Geschicklichkeit aus."
                            }
                        }
                    ],
                    "common_phrases": [
