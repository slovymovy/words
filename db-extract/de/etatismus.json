                        "form": "dem Etatismus"
                    },
                    {
                        "form_id": "8d475df3-c142-4798-a5e5-082812c16504",
                        "entry_id": "1a7378d0-e1d0-32e4-b9d0-8d024e909df3",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Etatismus"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bf39f872-8c7c-3eae-8f60-165f1caac13d",
                        "entry_id": "1a7378d0-e1d0-32e4-b9d0-8d024e909df3",
                        "glosses": [
                            "eine politische Anschauung beziehungsweise Theorie, welche dem Staat eine besondere Bedeutung im wirtschaftlichen und sozialen Leben einräumt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03f1710d-e12e-4558-a029-6daaabed5e24",
                                "sense_id": "bf39f872-8c7c-3eae-8f60-165f1caac13d",
                                "text": "„Der französische Etatismus kommt in der Banlieue an eine seltsame sozialpsychologische Grenze.“"
                            },
                            {
                                "example_id": "60f2c8de-ed79-4599-b1a7-79de77fdffb3",
                                "sense_id": "bf39f872-8c7c-3eae-8f60-165f1caac13d",
                                "text": "„Nationalistische Integration und Etatismus in der Wirtschaftsplanung reichen hier zur Krisenbewältigung nicht mehr aus.“"
                            },
                            {
                                "example_id": "82d1c873-6ca5-400d-afeb-6e2c728383d8",
                                "sense_id": "bf39f872-8c7c-3eae-8f60-165f1caac13d",
                                "text": "„Man kann auf jeden Fall sagen, dass der Etatismus nicht geschadet hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dff55b17-b291-464a-8ea0-4b9dd8b28e6c",
                        "source_entry_id": "1a7378d0-e1d0-32e4-b9d0-8d024e909df3",
                        "source_sense_id": "bf39f872-8c7c-3eae-8f60-165f1caac13d",
                        "target_lang_word": "statism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "statism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ed1f313-6bc5-39db-b1f5-c61a0d1d2805",
                                        "entry_id": "d11a47cf-ce14-3a56-965e-08c96d4e7540",
                                        "glosses": [
                                            "Synonym of secularism: subservience of religious issues to political officials and expediency."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4f2429c-2a40-4f58-8d00-dee0ca9af34b",
                                                "sense_id": "0ed1f313-6bc5-39db-b1f5-c61a0d1d2805",
                                                "text": "Religion turned into Statisme, will soone prooue Atheisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0845963f-ae94-390e-8543-625f9f46b289",
                                        "entry_id": "d11a47cf-ce14-3a56-965e-08c96d4e7540",
                                        "glosses": [
                                            "Synonym of statecraft or statesmanship."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d50371d9-1265-480d-9073-2ac8864044f7",
                                                "sense_id": "0845963f-ae94-390e-8543-625f9f46b289",
                                                "text": "My great Cousin hauing euermore\nFrom my greene yeares accepted my aduise\nIn points of statisme..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "171472f5-5836-3086-a49b-958b45b9a8f6",
                                        "entry_id": "d11a47cf-ce14-3a56-965e-08c96d4e7540",
                                        "glosses": [
                                            "Synonym of government or governance."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d34390ef-1216-4147-9661-38ad0512a928",
                                                "sense_id": "171472f5-5836-3086-a49b-958b45b9a8f6",
                                                "text": "[The Ten Commandments] have formed the basis of every system of statism adopted by the civilized communities of the earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b10039e3-8479-333c-85bd-5ab89cc645a4",
                                        "entry_id": "d11a47cf-ce14-3a56-965e-08c96d4e7540",
                                        "glosses": [
                                            "The belief that most or all political power should be centralized in national governments."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07900c7e-621f-413a-9c5e-6a8bbe617349",
                                                "sense_id": "b10039e3-8479-333c-85bd-5ab89cc645a4",
                                                "text": "Near-synonyms: big government, dirigisme"
                                            },
                                            {
                                                "example_id": "a61cd29a-106f-4bcf-826a-582cd7d53f86",
                                                "sense_id": "b10039e3-8479-333c-85bd-5ab89cc645a4",
                                                "text": "Bismarck... believes in State insurance in State activities, in place of individual action. But this is not Socialism. It is Statism."
                                            },
                                            {
                                                "example_id": "fedcb242-ca77-4f42-9d2f-9436426d5fd7",
                                                "sense_id": "b10039e3-8479-333c-85bd-5ab89cc645a4",
                                                "text": "Republican Senator Charles L. McNary concluded his Vice-Presidential campaign tonight with the charge the New Deal is ‘taking deeper and deeper refuge in paternalism and statism’."
                                            },
                                            {
                                                "example_id": "fd50c57e-83cd-4811-aef4-e81eef441db6",
                                                "sense_id": "b10039e3-8479-333c-85bd-5ab89cc645a4",
                                                "text": "As the economic derivative of libertarianism, laissez-faire capitalism is an economics of life, of rationality. […] And, like libertarianism, it is the only viable solution to the catastrophe of statism in the modern age."
                                            },
                                            {
                                                "example_id": "0f01d0fd-75b2-4c90-8e5a-a3632fb4bd92",
                                                "sense_id": "b10039e3-8479-333c-85bd-5ab89cc645a4",
                                                "text": "[…]; social welfare policies reward parasitical living rather than risk-taking; a truly atavistic, sick attachment to the compulsion and non-meritocratic elitism of statism as a way of life; […] have all retarded and will continue to retard Europeans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5969b423-0201-3918-9fa6-5280e5fbc314",
                                        "entry_id": "d11a47cf-ce14-3a56-965e-08c96d4e7540",
                                        "glosses": [
                                            "The belief that most or nearly all political power should be decentralized to provincial governments."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bbdf28d-dedd-4b9d-b2f4-4c5a4e1383f7",
                                                "sense_id": "5969b423-0201-3918-9fa6-5280e5fbc314",
                                                "text": "The joint note of Austria and Prussia... appears thus to have worked more good than moderation and good sense generally achieve over faction and petty-Statism."
                                            },
                                            {
                                                "example_id": "04d1abad-7f0c-4f29-9292-8643ef6c9f64",
                                                "sense_id": "5969b423-0201-3918-9fa6-5280e5fbc314",
                                                "text": "To him... we owe that sentiment of nationalism prevailing over statism... without which the Union would have parted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dade62e-8cc2-3cae-987b-eb766cc254b9",
                                        "entry_id": "d11a47cf-ce14-3a56-965e-08c96d4e7540",
                                        "glosses": [
                                            "The belief that the state is a legitimate societal organization."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
