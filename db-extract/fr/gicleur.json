                        "entry_id": "94f0f941-6828-337c-ad69-389c071c1cf7",
                        "glosses": [
                            "Pièce généralement amovible, comportant un trou calibré, servant à gérer le débit d’un fluide atomisé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd41a09d-565f-4452-ae56-61e0566e70dd",
                                "sense_id": "20ca7d1e-264d-316e-939e-761d26b5e8b0",
                                "text": "Les gicleurs d’une gazonnière."
