                {
                    "sense_id": "031f213b-0051-3cd0-a514-d97ef54053ea",
                    "sense_definition": "Arrêt ou rétention anormale d'une évacuation ou d'une sécrétion physiologique ordinaire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin s'inquiète de la <w>suppression</w> d'urine constatée chez ce patient depuis hier."
                        },
                        {
                            "text": "Une <w>suppression</w> brutale des règles peut révéler un trouble hormonal sérieux."
