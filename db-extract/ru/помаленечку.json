                        "target_lang_word": "little by little",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "little by little",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b79b4e5-4cc1-38b4-a801-844f9600bb8e",
                                        "entry_id": "e26f6f72-a2d5-3d57-8be2-0da540b66c9d",
                                        "glosses": [
                                            "A small amount at a time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddf96de4-5e0e-4d44-84f8-218a580455b2",
                                                "sense_id": "5b79b4e5-4cc1-38b4-a801-844f9600bb8e",
                                                "text": "\"[…]Everything else has gone from me, little by little, but I have kept this.[…]\""
                                            },
                                            {
                                                "example_id": "e5efcccc-ac06-432b-a08f-fb8d2d846ea8",
                                                "sense_id": "5b79b4e5-4cc1-38b4-a801-844f9600bb8e",
                                                "text": "Little by little his head cleared, and he began once more to take a personal interest in the battle."
                                            },
                                            {
                                                "example_id": "7b7dcc75-b754-4bad-97d0-4179f46a50b7",
                                                "sense_id": "5b79b4e5-4cc1-38b4-a801-844f9600bb8e",
                                                "text": "Cos little by little / We gave you everything / You ever dreamed of. / Little by little / The wheels of your life / Have slowly fallen off."
                                            },
                                            {
                                                "example_id": "9d0f0796-1320-498e-b021-11c36c91b5c0",
                                                "sense_id": "5b79b4e5-4cc1-38b4-a801-844f9600bb8e",
                                                "text": "Iraq's government has been removing blast walls little by little since late 2008, trying to restore a semblance of normalcy to this bunker city."
                                            },
                                            {
                                                "example_id": "d908bc45-7a7b-4565-b66f-9f296830913d",
                                                "sense_id": "5b79b4e5-4cc1-38b4-a801-844f9600bb8e",
                                                "text": "What came instead over the following years were many of the same projects delivered individually to little-by-little add capacity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
