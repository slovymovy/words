        "fr-extract.jsonl": [
            {
                "entry_id": "fa00ddaa-5824-3aa6-a538-f5c8eee753a8",
                "word": "répondant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "03533b9b-8216-4395-ab75-1f7e3a8cdda6",
                        "entry_id": "fa00ddaa-5824-3aa6-a538-f5c8eee753a8",
                        "tags": [
                            "plural"
                        ],
                        "form": "répondants"
                    },
                    {
                        "form_id": "1d1cb93c-0c2f-4106-a2ae-cacbd8624918",
                        "entry_id": "fa00ddaa-5824-3aa6-a538-f5c8eee753a8",
                        "tags": [
                            "feminine"
                        ],
                        "form": "répondante"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9d8798a0-bfb1-3f94-8185-edce7df54858",
                        "entry_id": "fa00ddaa-5824-3aa6-a538-f5c8eee753a8",
                        "glosses": [
                            "Celui qui répond."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "51846ed9-86d2-329f-b626-fdbf51da32c6",
                        "entry_id": "fa00ddaa-5824-3aa6-a538-f5c8eee753a8",
                        "glosses": [
                            "Celui qui subit un examen public, qui soutient une thèse, qui répond à un sondage ou à une enquête sociologique."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "8238dd58-6420-41fb-a1d4-cc8a543309d7",
                                "sense_id": "51846ed9-86d2-329f-b626-fdbf51da32c6",
                                "text": "Ainsi, 23 % de ceux ayant répondu ont perdu du poids – 2 kg en moyenne – ; les répondants ont été 40 % à passer plus de temps à cuisiner des plats « faits maison » ; 17 % ont cherché à équilibrer leur alimentation pour compenser la perte d’activité physique ; près d’un sur cinq a même pu augmenter celle-ci."
                            },
                            {
                                "example_id": "fbc97c95-9f55-43ed-b9bf-012d10888faa",
                                "sense_id": "51846ed9-86d2-329f-b626-fdbf51da32c6",
                                "text": "Lundi, un sondage Léger publié dans nos pages soulignait que 63 % des répondants étaient préoccupés par la situation du français au Québec."
                            },
                            {
                                "example_id": "857ffb3a-241b-4ebd-93ac-f9562def969d",
                                "sense_id": "51846ed9-86d2-329f-b626-fdbf51da32c6",
                                "text": "En 2018, près de 22 % des répondants de l’enquête EROPP de l’Observatoire français des drogues et des tendances addictives citaient spontanément le tabac comme une drogue."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a5b956a-f658-3741-bb56-99bc2919ad80",
                        "entry_id": "fa00ddaa-5824-3aa6-a538-f5c8eee753a8",
                        "glosses": [
                            "Celui qui répond la messe."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8c04d560-91e3-377d-994a-48aabcdbe1b5",
                        "entry_id": "fa00ddaa-5824-3aa6-a538-f5c8eee753a8",
                        "glosses": [
                            "Celui qui se rend caution, garante pour quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09d2fc31-2e13-426e-96b9-71f7c91bf4dd",
                                "sense_id": "8c04d560-91e3-377d-994a-48aabcdbe1b5",
                                "text": "Se rendre caution et répondant pour quelqu’un."
                            },
                            {
                                "example_id": "5bbab100-3f1e-462d-a777-472820e5c25a",
                                "sense_id": "8c04d560-91e3-377d-994a-48aabcdbe1b5",
                                "text": "Je vous servirai volontiers de répondant."
                            },
                            {
                                "example_id": "5b768764-c83f-41d4-b7e5-bb2905f59aa0",
                                "sense_id": "8c04d560-91e3-377d-994a-48aabcdbe1b5",
                                "text": "Je serai votre répondant."
                            },
                            {
                                "example_id": "18072ca4-18b4-42ff-89c3-8724fb2cd889",
                                "sense_id": "8c04d560-91e3-377d-994a-48aabcdbe1b5",
                                "text": "Ce domestique a de bons répondants."
                            },
                            {
                                "example_id": "eff73362-3659-4f0b-a1a9-f4db34c505b6",
                                "sense_id": "8c04d560-91e3-377d-994a-48aabcdbe1b5",
                                "text": "et Voilà un bon répondant !"
                            },
                            {
                                "example_id": "9d779d0c-fa65-46ba-94a1-bbdff098d29c",
                                "sense_id": "8c04d560-91e3-377d-994a-48aabcdbe1b5",
                                "text": "Messieurs, je suis heureux de vous présenter le comte Charles Forestier, une des personnalités françaises les plus en vue, mon répondant."
                            }
                        ]
                    },
                    {
                        "sense_id": "535c59ae-0a82-34cb-ba5b-3a70852a703b",
                        "entry_id": "fa00ddaa-5824-3aa6-a538-f5c8eee753a8",
                        "glosses": [
                            "Capacité à répondre aisément et avec virulence à une question, à une attaque, à un embarras."
                        ],
                        "tags": [
                            "common"
                        ],
                        "examples": [
                            {
                                "example_id": "dd80db41-64c0-46d2-aea3-ce2f5d7d6535",
                                "sense_id": "535c59ae-0a82-34cb-ba5b-3a70852a703b",
                                "text": "A la justice pour me juger moi, Gavrilovna Krassavina ! Tu déménages ou quoi ! Tu crois que j'ai les jetons ? D'accord, allons-y pour un procès. Tu peux porter plainte contre moi, j'ai du répondant. Tu prends quel tribunal ?"
                            },
                            {
                                "example_id": "235692e2-7c6b-4a94-bd5a-343d6d515b71",
                                "sense_id": "535c59ae-0a82-34cb-ba5b-3a70852a703b",
                                "text": "Moi j’avais parlé comme un perroquet et je ne trouvais pas en moi le moindre répondant."
                            },
                            {
                                "example_id": "ce6621d7-444c-4b49-b11f-b1514699b29a",
                                "sense_id": "535c59ae-0a82-34cb-ba5b-3a70852a703b",
                                "text": "Le sultan retrouva son calme. Je m'aperçus qu'il n’aimais rien tant que la joute verbale. Il aimait le répondant. Il aimait aussi que son interlocuteur jouât avec sa vie."
                            }
                        ]
                    }
                ],
