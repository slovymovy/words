                "senses": [
                    {
                        "sense_id": "b2d709e3-0aaa-305f-a85a-e888b65848da",
                        "entry_id": "4b8b0b28-c1a2-3572-8b51-cea3ac65e200",
                        "glosses": [
                            "Stromleitung, die unter Hochspannung steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4827f8e0-9c04-4395-a702-585fd7deff33",
                                "sense_id": "b2d709e3-0aaa-305f-a85a-e888b65848da",
                                "text": "Der Stromausfall wurde von einer gerissene Hochspannungsleitung ausgelöst."
                            },
                            {
                                "example_id": "0d9eecea-4028-4ac0-9a56-4f2ff6294a53",
                                "sense_id": "b2d709e3-0aaa-305f-a85a-e888b65848da",
                                "text": "„Erstaunlich, daß die Masten der Hochspannungsleitungen dicht an der Straße nicht gelitten haben.“"
                            },
                            {
                                "example_id": "e013f185-cd6b-4ca3-9c1b-4fdee179982a",
                                "sense_id": "b2d709e3-0aaa-305f-a85a-e888b65848da",
                                "text": "„Der Mann war mit schwersten Verbrennungen eingeliefert worden. Um ihn zu bergen, hatte zunächst die Hochspannungsleitung abgeschaltet werden müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
