                ],
                "senses": [
                    {
                        "sense_id": "e10d5c3f-b306-3374-9e00-7cbbe64963c7",
                        "entry_id": "f166d388-6918-3de6-aa85-f302a6479397",
                        "glosses": [
                            "To thoroughly chew (dozens or hundreds of times) before swallowing."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "95da7b9f-fffc-46c7-b82c-97e51beed5cb",
                                "sense_id": "e10d5c3f-b306-3374-9e00-7cbbe64963c7",
                                "text": "If you have learned to chew your food, continue to fletcherize, be enthusiastic about it."
                            },
                            {
                                "example_id": "8687d8fa-0846-4202-b353-b18ecde97eb5",
                                "sense_id": "e10d5c3f-b306-3374-9e00-7cbbe64963c7",
                                "text": "William, how many times must I tell you to fletcherize your bones before you swallow them? You might as well be eating bread and butter, or roast beef, if you don't fletcherize your bones properly. Chew each bite of bone four hundred times, young man, or I'll get a jaw-meter and make you wear it!"
                            },
                            {
                                "example_id": "d8c7425f-4c7d-45b3-a4cc-c3e4e917b0e6",
                                "sense_id": "e10d5c3f-b306-3374-9e00-7cbbe64963c7",
                                "text": "I am assured that if a man chews it in the manner invented by M. Fletcher of the United States, he can live for an unlimited period on four ounces a day .... We have therefore food for one man for forty days, food for two for twenty days. ... at the end of that twenty days, one of us will Fletcherise the other!"
                            },
                            {
                                "example_id": "3267616f-5c25-4824-b741-072bcc2e4f05",
                                "sense_id": "e10d5c3f-b306-3374-9e00-7cbbe64963c7",
                                "text": "We all knew that for years he had suffered from the evil effects of a dangerous dietary system, called (after the name of its egregious inventor) “Fletcherizing”."
                            }
                        ]
                    },
                    {
                        "sense_id": "91aa0d9a-60a0-35d1-a814-93ac3ba56263",
                        "entry_id": "f166d388-6918-3de6-aa85-f302a6479397",
                        "glosses": [
                            "To consume, to devour, to bite, to chew over."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "13952913-9802-4844-8eeb-abe49e7409c3",
                                "sense_id": "91aa0d9a-60a0-35d1-a814-93ac3ba56263",
                                "text": "Annette Fletcherized large numbers of romantic novels which she obtained at a free public library branch (donated by one of the biggest caliphs in the business)."
                            },
                            {
                                "example_id": "7d9d49a8-c45c-4c9a-a389-dd31659ca5ff",
                                "sense_id": "91aa0d9a-60a0-35d1-a814-93ac3ba56263",
                                "text": "Indeed he may fletcherize a truth mentally, all day long, and not get action. Thus he will not grow and develop."
                            },
                            {
                                "example_id": "267d2e87-9506-4de5-8897-ecfab2d9137b",
                                "sense_id": "91aa0d9a-60a0-35d1-a814-93ac3ba56263",
                                "text": "The terrier had got the poodle by the left hind-leg and was restating his war-aims. The raffish mongrel was apparently endeavouring to fletcherize a complete stranger of the Sealyham family."
                            }
                        ]
                    }
                ],
