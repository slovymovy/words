                                        "examples": [
                                            {
                                                "example_id": "d3918aa0-09ec-40c7-a876-a9fdf2c1158e",
                                                "sense_id": "2aa6cce4-a84d-3306-8e95-9f9a531d6d37",
                                                "text": "„Aber ihren Dialekten zufolge war der erste ein Ägypter, der zweite ein Iraker und der dritte ein Syrer.“"
                                            },
                                            {
                                                "example_id": "29a844b6-7aee-4fa5-8a1b-1ce3680bc148",
                                                "sense_id": "2aa6cce4-a84d-3306-8e95-9f9a531d6d37",
                                                "text": "„Die Syrer waren in der Stadt in einem verlassenen Kloster einquartiert worden, dicke Mauern, saubere Böden.“"
                                            },
                                            {
                                                "example_id": "a09278e9-8b14-4814-b28b-8d8e5bed5e67",
                                                "sense_id": "2aa6cce4-a84d-3306-8e95-9f9a531d6d37",
                                                "text": "„Der eine Syrer nahm hinter dem Tresen Platz, sein Freund und der exjugoslawische Taxifahrer holten die Bierflaschen aus dem Kühlschrank.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "fd0976e0-d3f5-3fd3-8ae2-54d25500a4c2",
                                        "entry_id": "0fdda0e1-ae0c-30d7-8c5b-25fa0787c6de",
                                        "glosses": [
                                            "ursprünglich ein Synonym für das christianisierte Volk der Aramäer"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
