                "senses": [
                    {
                        "sense_id": "4e96c6d2-d3a1-34a6-9cf3-7c9179ad8346",
                        "entry_id": "5adb565e-e4c6-31d4-a1c0-6cc470f8ca6a",
                        "glosses": [
                            "natürliches Vorkommen von Wasser (meist von Süßwasser im Boden als Grundwasser, als Oberflächenwasser in Flüssen oder gefroren in Gletschern )"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "28311af3-bafa-45a1-b78f-25bde60892d4",
                                "sense_id": "4e96c6d2-d3a1-34a6-9cf3-7c9179ad8346",
                                "text": "„Weltweit gibt es ausreichend Wasserressourcen, um alle Menschen zu versorgen.“"
                            },
                            {
                                "example_id": "9a1ee4be-41e4-4a65-ac1b-f5944d9146be",
                                "sense_id": "4e96c6d2-d3a1-34a6-9cf3-7c9179ad8346",
                                "text": "„Rodrigo Mundaca kämpft […] für die gerechte Verteilung der Wasserressourcen.“"
                            },
                            {
                                "example_id": "544dde8d-d230-4ce7-bc21-2391d4425f8f",
                                "sense_id": "4e96c6d2-d3a1-34a6-9cf3-7c9179ad8346",
                                "text": "„Wasserressourcen sind ein staatliches Gut, das nicht privatisiert werden darf.“"
                            },
                            {
                                "example_id": "9dd916d2-f843-4ab5-88be-2f10eea0c21c",
                                "sense_id": "4e96c6d2-d3a1-34a6-9cf3-7c9179ad8346",
                                "text": "„Durch die Produktion von Nestlé im französischen Vittel ist die wertvolle Wasserressource dort im Laufe der Jahre stark dezimiert worden.“"
                            },
                            {
                                "example_id": "001da0e8-4cec-4d03-9a8f-405bc78edb87",
                                "sense_id": "4e96c6d2-d3a1-34a6-9cf3-7c9179ad8346",
                                "text": "„Die wertvollen Wasserressourcen der Region weckten auch ökonomische Interessen […]“"
                            },
                            {
                                "example_id": "5c87f7b2-0783-41d1-bfd9-d0c1eb94c0c5",
                                "sense_id": "4e96c6d2-d3a1-34a6-9cf3-7c9179ad8346",
                                "text": "„Mit der Desertifikation verschwinden immer mehr fruchtbare Böden und wertvolle Wasserressourcen.“"
                            },
                            {
                                "example_id": "99d474a8-58b3-446a-8d71-a684ac520494",
                                "sense_id": "4e96c6d2-d3a1-34a6-9cf3-7c9179ad8346",
                                "text": "„[…] wir [sollten nicht] verschwenderisch mit den Wasserressourcen umgehen. In der Schweiz ist der tägliche Wasserverbrauch mit rund 140 Litern pro Person […] immer noch sehr hoch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
