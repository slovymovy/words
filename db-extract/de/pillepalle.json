                "senses": [
                    {
                        "sense_id": "68ea02f7-440b-3021-899a-dc3e90edce0f",
                        "entry_id": "0279d14f-ac37-3ce1-87a9-9e342ea94dfd",
                        "glosses": [
                            "einfach; ohne große Mühe zu erledigen; unbedeutend; nicht ernst zu nehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8079f588-a735-490e-9388-997994f0a6ca",
                                "sense_id": "68ea02f7-440b-3021-899a-dc3e90edce0f",
                                "text": "„Oh ist das schwierig.“ – „Ach Quatsch, das ist doch pillepalle!“"
                            },
                            {
                                "example_id": "d885d74f-2a31-4ae8-b4c6-b6542cef05a3",
                                "sense_id": "68ea02f7-440b-3021-899a-dc3e90edce0f",
                                "text": "Ein Gesetzentwurf ist pillepalle, wenn eine Regierung darin zur Erreichung von Klimazielen eine Abgabe von 10 Euro pro Tonne CO₂ festlegt und die Wissenschaftler vorher 180 Euro Euro pro Tonne CO₂ gefordert hatten."
                            }
                        ],
                        "sense_index_json": "\"1\""
