                                        "entry_id": "834d0c4b-d304-3641-8197-351746355780",
                                        "glosses": [
                                            "Épée tranchante et courte que les Romains utilisaient."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "741ec041-e286-4fcf-b964-715466906069",
                                                "sense_id": "72c06611-0069-3a1b-8c08-fe978581a689",
                                                "text": "Il lui plongea son glaive dans le sein."
                                            },
                                            {
                                                "example_id": "c0b070c5-689d-46f2-ab19-f220172cfb00",
                                                "sense_id": "72c06611-0069-3a1b-8c08-fe978581a689",
                                                "text": "Tirer le glaive."
                                            },
                                            {
                                                "example_id": "a25997f2-af41-4b56-ba45-cc779d513ef9",
                                                "sense_id": "72c06611-0069-3a1b-8c08-fe978581a689",
                                                "text": "Il brave en souriant le glaive meurtrier ;\nIl console et bénit, et le Dieu qu’il adore\nDescend à son appel et l’écoute prier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63bb6749-ee73-3f13-a6ae-dd4ef9bdf3f4",
                                        "entry_id": "834d0c4b-d304-3641-8197-351746355780",
                                        "glosses": [
                                            "Symbole du combat contre ce qui nuit à la société."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dd1555a-60fe-4bd2-8945-8bfcdd3e0719",
                                                "sense_id": "63bb6749-ee73-3f13-a6ae-dd4ef9bdf3f4",
                                                "text": "[…] je feins de m'intéresser à une sorte de chromo hideux qui représente une Thémis de contrebande, le glaive à la main."
                                            },
                                            {
                                                "example_id": "81acfd90-d37a-475f-8cd6-b563f8610af3",
                                                "sense_id": "63bb6749-ee73-3f13-a6ae-dd4ef9bdf3f4",
                                                "text": "Je ne suis pas venu apporter la paix, mais le glaive [Matthieu 10:34]."
                                            }
