            "pos": "noun",
            "senses": [
                {
                    "sense_id": "850d0d85-2277-38b6-85ea-89077029fc7e",
                    "sense_definition": "Eigenschaft, ungeschickt, unsicher oder nicht situationsgemäß zu handeln",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "charaktereigenschaft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seine anfängliche <w>Unbeholfenheit</w> im neuen Beruf legte sich glücklicherweise nach einigen Wochen.",
                            "target_lang_translations": {
                                "ru": "Его первоначальная <w>неуверенность</w> в новой профессии, к счастью, прошла через несколько недель."
                            }
                        },
                        {
                            "text": "Mit einer gewissen <w>Unbeholfenheit</w> versuchte das Kind, seine Schuhe ganz alleine zuzubinden.",
                            "target_lang_translations": {
                                "ru": "С некоторой <w>неуклюжестью</w> ребёнок пытался совершенно самостоятельно завязать шнурки."
                            }
                        }
                    ],
                    "synonyms": [
                        "Ungeschicklichkeit",
                        "Tollpatschigkeit",
                        "Hilflosigkeit",
                        "Plumpheit"
                    ],
                    "antonyms": [
                        "Gewandtheit",
                        "Geschicklichkeit",
                        "Fingerfertigkeit"
                    ],
                    "common_phrases": [
                        "mit gewisser Unbeholfenheit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство или состояние, проявляющееся в неуклюжести, неуверенности или неумении действовать по ситуации"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неуклюжесть",
                                "target_lang_sense_clarification": "в движениях или поведении"
                            },
                            {
                                "target_lang_word": "неловкость",
                                "target_lang_sense_clarification": "скованность или неуверенность"
                            },
                            {
                                "target_lang_word": "беспомощность",
                                "target_lang_sense_clarification": "неспособность справиться самостоятельно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dfb3fa05-5213-3ae4-88e0-344fdaf41c9e",
                    "sense_definition": "einzelne ungeschickte Handlung oder unpassende Äußerung",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "handlung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er bat um Entschuldigung für die sprachliche <w>Unbeholfenheit</w> in seinem ersten Brief.",
                            "target_lang_translations": {
                                "ru": "Он извинился за языковую <w>неловкость</w> в своём первом письме."
                            }
                        },
                        {
                            "text": "Über solche kleinen <w>Unbeholfenheiten</w> während des ersten Vortrags sah das Publikum freundlich hinweg.",
                            "target_lang_translations": {
                                "ru": "Публика доброжелательно закрыла глаза на такие мелкие <w>неловкости</w> во время первого доклада."
                            }
                        }
                    ],
                    "synonyms": [
                        "Ungeschicklichkeit"
                    ],
                    "common_phrases": [
                        "sprachliche Unbeholfenheit"
                    ],
                    "target_lang_definitions": {
