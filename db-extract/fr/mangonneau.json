                "word": "mangonneau",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a4a2d962-2e4f-471c-acdd-08306d2ec893",
                        "entry_id": "36f8220f-2ea7-30c5-860b-2c8590842f56",
                        "tags": [
                            "plural"
                        ],
                        "form": "mangonneaux"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1de35a2b-2c02-33d5-80bb-62f9b2bc7e11",
                        "entry_id": "36f8220f-2ea7-30c5-860b-2c8590842f56",
                        "glosses": [
                            "Engin de guerre utilisé dans les sièges au Moyen Âge, très proche du trébuchet dont il est une évolution permettant un tir plus précis et d’une plus grande force."
                        ],
                        "tags": [
                            "Middle-Ages"
                        ],
                        "examples": [
                            {
                                "example_id": "03b04a89-f4b1-432f-878b-e2b465a7c8fb",
                                "sense_id": "1de35a2b-2c02-33d5-80bb-62f9b2bc7e11",
                                "text": "Les assiégés, de leur côté, dans l’enceinte de cette barbacane, élèvent une pierrière turque qui bat le mangonneau. Pour être autant défilé que possible, le mangonneau devait être établi en E."
                            },
                            {
                                "example_id": "7a9ab6cc-6b7f-4f23-b463-c44dc4cb2739",
                                "sense_id": "1de35a2b-2c02-33d5-80bb-62f9b2bc7e11",
                                "text": "Ils se présentèrent à lui immédiatement et s’offrirent à faire construire, à la manière d’Occident, des mangonneaux capables de lancer des pierres pesant trois cents livres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ddd5720-90fe-45c8-8acb-9409e5908737",
                        "source_entry_id": "36f8220f-2ea7-30c5-860b-2c8590842f56",
                        "source_sense_id": "1de35a2b-2c02-33d5-80bb-62f9b2bc7e11",
                        "target_lang_word": "Mangonel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mangonel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b2c75ca6-426a-353b-b14f-93ed2c052491",
                                        "entry_id": "d8795c58-e636-3e9b-83e6-dda31cf9aadd",
                                        "glosses": [
                                            "einarmiges Katapult"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59af83cc-f357-44cd-a62b-1df8bfea5ae8",
                                                "sense_id": "b2c75ca6-426a-353b-b14f-93ed2c052491",
                                                "text": "Deshalb haben wir ein kleines und möglichst leichtes Modell konzipiert, eine Mangonel."
                                            },
                                            {
                                                "example_id": "826edee6-855f-43ad-a167-096c752561ca",
                                                "sense_id": "b2c75ca6-426a-353b-b14f-93ed2c052491",
                                                "text": "Der Mangonel. Strutt vermuthet, er sey eine Art von Katapulta (1. Abthl. §. 489) gewesen, jedoch von einer kleinern Gattung, als jene, derer weiter unten erwähnet wird."
                                            },
                                            {
                                                "example_id": "d1b3a5bb-54b2-43c3-8c0c-51f6fa095fde",
                                                "sense_id": "b2c75ca6-426a-353b-b14f-93ed2c052491",
                                                "text": "Das mangonel war eine Steinwurfmaschine auf Rädern, die bei Belagerungen eingesetzt wurde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
