                ],
                "senses": [
                    {
                        "sense_id": "bc0d49d3-afcf-34a0-b19e-fd52d23f5c59",
                        "entry_id": "80582190-ee0e-302e-ac8e-f5c9b0f0a34a",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fa28523-ca6e-4c35-8321-8aa44a0c306f",
                                "sense_id": "bc0d49d3-afcf-34a0-b19e-fd52d23f5c59",
                                "text": "Herr Mäusle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f623b41b-9c91-4e27-a020-1f10d419be6d",
                                "sense_id": "bc0d49d3-afcf-34a0-b19e-fd52d23f5c59",
                                "text": "Die Mäusles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "1ed3f2b6-d2e5-4c74-9fd4-28e60e53dd6e",
                                "sense_id": "bc0d49d3-afcf-34a0-b19e-fd52d23f5c59",
                                "text": "Frau Mäusle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "585e526c-8fa5-4522-9038-d62f958616a8",
                                "sense_id": "bc0d49d3-afcf-34a0-b19e-fd52d23f5c59",
                                "text": "Der Mäusle trägt nie die Pullover, die die Mäusle ihm strickt."
                            },
                            {
                                "example_id": "2a066c37-11bb-4a5e-8748-9927f8233064",
                                "sense_id": "bc0d49d3-afcf-34a0-b19e-fd52d23f5c59",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Mäusle kommt, geht der Herr Mäusle.“"
                            },
                            {
                                "example_id": "0a925da7-9760-4542-8ccf-e4d1714edcd4",
                                "sense_id": "bc0d49d3-afcf-34a0-b19e-fd52d23f5c59",
                                "text": "Mäusle kommt und geht."
                            },
                            {
                                "example_id": "20c8fd93-3fc5-4967-9a0f-1342915d3ef9",
                                "sense_id": "bc0d49d3-afcf-34a0-b19e-fd52d23f5c59",
                                "text": "Mäusles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
