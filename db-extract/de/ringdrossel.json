                        "glosses": [
                            "Vogel aus der Gattung der Drosseln mit überwiegend dunkler Färbung und weißer Brust, Turdus torquatus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ad04182-d35c-4b4a-b2f9-3ee2540a628d",
                                "sense_id": "f9d7fe29-578c-329c-8087-130122786e34",
                                "text": "Ringdrosseln kann man in den Hochlagen der Mittelgebirge beobachten."
                            }
                        ],
