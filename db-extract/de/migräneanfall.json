                "senses": [
                    {
                        "sense_id": "7d554b28-93cf-3bec-ae32-1e8ceaa703a5",
                        "entry_id": "0e5a0012-700d-3a68-aeb3-b8cc33bfdafd",
                        "glosses": [
                            "Anfall von Migräne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c62d7446-eb2b-4938-aa10-10f235904c48",
                                "sense_id": "7d554b28-93cf-3bec-ae32-1e8ceaa703a5",
                                "text": "„In einem akuten Migräneanfall findet Metoclopramid zur Unterdrückung der Übelkeit und zur Steigerung der schmerzbedingt abgeschwächten Darmperistaltik Anwendung.“"
                            },
                            {
                                "example_id": "6e1da42e-f3ea-45dc-976e-fbac8fdee635",
                                "sense_id": "7d554b28-93cf-3bec-ae32-1e8ceaa703a5",
                                "text": "„Migräneanfälle können durch bestimmte Nahrungmittel [sic!] wie Rotwein oder Schokolade oder klimatische Einflüsse ausgelöst werden und treten häufig nach starken psychischen Anspannungen auf („Wochenendmigräne“).“"
                            },
                            {
                                "example_id": "7996772c-2a32-459f-8e66-b5c03c4bf006",
                                "sense_id": "7d554b28-93cf-3bec-ae32-1e8ceaa703a5",
                                "text": "„Während die heißen Tage sich dahinzogen und sie sich auf die Ferien zuarbeiteten, ereilten Sylvia zwei weitere Migräneanfälle und einige schwierige Korrespondenz von ihrer Familie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
