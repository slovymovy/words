                "senses": [
                    {
                        "sense_id": "21047f2c-1555-3756-a734-447ed77d1b50",
                        "entry_id": "95fa482a-955d-3ef3-948f-f262f1d3b04e",
                        "glosses": [
                            "künstlerische Aktion, Darbietung oder Aufführung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00df6e9d-b390-4806-8bf1-38a7d5883371",
                                "sense_id": "21047f2c-1555-3756-a734-447ed77d1b50",
                                "text": "Das war eine tolle Performance."
                            },
                            {
                                "example_id": "6f0bb5d4-6f5d-4b25-81b6-41386faedc7d",
                                "sense_id": "21047f2c-1555-3756-a734-447ed77d1b50",
                                "text": "Diese Performance überzeugte Ivanka nicht."
                            },
                            {
                                "example_id": "e02a002f-9fe7-48fe-a090-67d4acc19ce7",
                                "sense_id": "21047f2c-1555-3756-a734-447ed77d1b50",
                                "text": "„Doch offenbar traf meine Performance nicht ganz den Geschmack des einheimischen Publikums.“"
                            },
                            {
                                "example_id": "80287922-1f5f-4e79-b16a-aec3845ed709",
                                "sense_id": "21047f2c-1555-3756-a734-447ed77d1b50",
                                "text": "„Es lag eine gewisse Anstrengung in dieser Performance, die den gesamten Raum erfüllte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "10d18cf3-ce48-343b-aa83-a9b2f248dfd3",
                        "entry_id": "95fa482a-955d-3ef3-948f-f262f1d3b04e",
