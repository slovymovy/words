                        "cross_references": []
                    },
                    {
                        "translation_id": "2e5f54c0-2839-49a8-8244-46fe3a5828dc",
                        "source_entry_id": "f6f735f5-6b6b-303d-92c4-d706c07846f6",
                        "source_sense_id": "61ad0014-65da-39ab-a361-bbb8038a9250",
                        "target_lang_word": "alarm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alarm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b864d838-95e7-3869-a9a2-23e7a28f8290",
                                        "entry_id": "95b5c4da-5361-3258-888d-10983be0d154",
                                        "glosses": [
                                            "A summons to arms, as on the approach of an enemy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8abaf42a-561f-48de-87ef-929cfa1b896c",
                                                "sense_id": "b864d838-95e7-3869-a9a2-23e7a28f8290",
                                                "text": "Arming to answer in a night alarm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7578cf47-afb1-3fdf-b906-e0253532dd0b",
                                        "entry_id": "95b5c4da-5361-3258-888d-10983be0d154",
                                        "glosses": [
                                            "Any sound or information intended to give notice of approaching danger; a warning sound to arouse attention; a warning of danger."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04428f27-f074-47e3-9522-afb4466d7f4a",
                                                "sense_id": "7578cf47-afb1-3fdf-b906-e0253532dd0b",
                                                "text": "Sound an alarm in my holy mountain."
                                            },
                                            {
                                                "example_id": "fc94c9af-bac5-473d-bf79-0442a03ace9e",
                                                "sense_id": "7578cf47-afb1-3fdf-b906-e0253532dd0b",
                                                "text": "She went about the house in a state of real terror, and yet lied monstrously and wilfully, and invented many of the alarms she spread, and made many of the sounds we heard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ac4ff9a-d798-3640-8379-0562071aedc7",
                                        "entry_id": "95b5c4da-5361-3258-888d-10983be0d154",
                                        "glosses": [
                                            "A device intended to warn or give notice of approaching danger."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06654063-bb51-49e8-b0a3-46286a96717f",
                                                "sense_id": "7ac4ff9a-d798-3640-8379-0562071aedc7",
                                                "text": "The fire alarm is located high on the wall to prevent tampering."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cef98ec-8b20-38d8-b6c6-bce3d0caeb03",
                                        "entry_id": "95b5c4da-5361-3258-888d-10983be0d154",
                                        "glosses": [
                                            "A sudden attack; a disturbance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80760a59-868b-470d-97cc-0f0984be830d",
                                                "sense_id": "3cef98ec-8b20-38d8-b6c6-bce3d0caeb03",
                                                "text": "Lord Marshal, command our officers-at-arms\nBe ready to direct these home alarms."
                                            },
                                            {
                                                "example_id": "1960fd3a-5d6f-4a98-aa25-fff2ddbef952",
                                                "sense_id": "3cef98ec-8b20-38d8-b6c6-bce3d0caeb03",
                                                "text": "Is it then true, as distant rumours run,\nthat crowds of rivals for thy mother's charms\nthy Palace fill with insults and alarms?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05114ed1-88f4-3f40-84d0-076984521c44",
                                        "entry_id": "95b5c4da-5361-3258-888d-10983be0d154",
                                        "glosses": [
                                            "Sudden surprise with fear or terror excited by apprehension of danger; in the military use, commonly, sudden apprehension of being attacked by surprise."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "732ebf47-3a2f-4d8d-b2c5-0997c3436172",
                                                "sense_id": "05114ed1-88f4-3f40-84d0-076984521c44",
                                                "text": "Alarm and resentment spread through the camp."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e217a6b-c772-31cd-9438-87d45459098d",
                                        "entry_id": "95b5c4da-5361-3258-888d-10983be0d154",
                                        "glosses": [
                                            "A mechanical device for awaking people, or rousing their attention."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59a6086a-7bc7-4ec3-a136-00c780601ba1",
                                                "sense_id": "7e217a6b-c772-31cd-9438-87d45459098d",
                                                "text": "The clock radio is a friendlier version of the cold alarm by the bedside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3b0cc26-9422-3165-b1b3-715b9e9e98c0",
                                        "entry_id": "95b5c4da-5361-3258-888d-10983be0d154",
                                        "glosses": [
                                            "An instance of an alarm ringing, beeping or clanging, to give a noise signal at a certain time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77c401eb-9567-4859-9ff9-23e1299eeda7",
                                                "sense_id": "d3b0cc26-9422-3165-b1b3-715b9e9e98c0",
                                                "text": "You should set the alarm on your watch to go off at seven o'clock."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "alarm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ddc3cf0b-55d0-38e1-8422-7c4cf06d527e",
                                        "entry_id": "c7b6a5fa-32b6-302b-b29a-8c146731f68a",
                                        "glosses": [
                                            "To call to arms for defense."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a9dfcc49-26fe-30ad-a65a-01fcf01063f0",
                                        "entry_id": "c7b6a5fa-32b6-302b-b29a-8c146731f68a",
                                        "glosses": [
                                            "To give (someone) notice of approaching danger or necessary action; to rouse to vigilance; to put on the alert."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb481dd8-3380-4a1b-a92c-93091f26fa44",
                                                "sense_id": "a9dfcc49-26fe-30ad-a65a-01fcf01063f0",
                                                "text": "The sudden drop in temperature should alarm you into taking precautions."
                                            },
                                            {
                                                "example_id": "a1079e56-862a-4219-9c11-d2a42716e77e",
                                                "sense_id": "a9dfcc49-26fe-30ad-a65a-01fcf01063f0",
                                                "text": "Her illness started to alarm the doctors, who ordered more tests."
                                            },
                                            {
                                                "example_id": "ac51e6ed-0087-4208-953c-903f00ef71c1",
                                                "sense_id": "a9dfcc49-26fe-30ad-a65a-01fcf01063f0",
                                                "text": "When the carriage drew up in the grass-grown court yard before the hall-door, two lazy-looking men, whose appearance well accorded with that of the place which they tenanted, alarmed by the obstreperous barking of a great chained dog, ran out from some half-ruinous out-houses, and took charge of the horses; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebcb2c33-bfc4-3cd6-9db9-4376e212bea2",
                                        "entry_id": "c7b6a5fa-32b6-302b-b29a-8c146731f68a",
                                        "glosses": [
                                            "To produce a warning of approaching danger or necessary action; to emit a signal intended to rouse a recipient to vigilance or put them on the alert."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4511a01-2f5c-4ede-8061-34fbc7501fff",
                                                "sense_id": "ebcb2c33-bfc4-3cd6-9db9-4376e212bea2",
                                                "text": "The tower cab supervisor and various pilots stated that the LLWAS system frequently alarms because of the thunderstorm activity present, and that airspeed losses are common as a result of convective wind shear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7a331f1-2f15-3395-ad11-07ece8427e9e",
                                        "entry_id": "c7b6a5fa-32b6-302b-b29a-8c146731f68a",
                                        "glosses": [
                                            "To surprise with apprehension of danger; to fill with anxiety in regard to threatening evil; to excite with sudden fear."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09813173-7e57-4f3f-95c7-0b9055997dbd",
                                                "sense_id": "c7a331f1-2f15-3395-ad11-07ece8427e9e",
                                                "text": "The loud bang in the hallway seemed to alarm everyone in the building."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2188b08c-850a-334e-a6ef-f837b628a1fc",
                                        "entry_id": "c7b6a5fa-32b6-302b-b29a-8c146731f68a",
                                        "glosses": [
                                            "To keep in excitement; to disturb."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
