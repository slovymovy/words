                        "glosses": [
                            "In a fortuitous manner; in a manner of happening by chance; coincidentally; accidentally."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bab2cd4-3a64-4074-967f-269bdc385137",
                                "sense_id": "c21aa9f6-da5c-33d2-a621-8510c8f059e5",
                                "text": "[…] For the genetic constitution of the individual may determine only a range of possible behaviour. The actual behaviour of each individual is fortuitously dependent on the total environment, and this latter can include the actual group. For example, the tendency of birds to refrain from mating may prevent the group from exhausting its food supply."
                            }
                        ]
