                    "sense_id": "6ebab62c-f867-3859-9b8d-3153821305a6",
                    "sense_definition": "Silne uczucie rozdrażnienia, gniewu lub wrogości w stosunku do kogoś lub czegoś.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego twarz poczerwieniała ze <w>złości</w>, gdy usłyszał te kłamstwa.",
                            "target_lang_translations": {
                                "ru": "Его лицо покраснело от <w>злости</w>, когда он услышал эту ложь.",
                                "en": "His face turned red with <w>anger</w> when he heard those lies.",
                                "nl": "Zijn gezicht werd rood van <w>woede</w> toen hij die leugens hoorde.",
                                "de": "Sein Gesicht lief vor <w>Wut</w> rot an, als er diese Lügen hörte.",
                                "fr": "Son visage est devenu rouge de <w>colère</w> quand il a entendu ces mensonges.",
                                "it": "Il suo viso è diventato rosso dalla <w>rabbia</w> quando ha sentito quelle bugie.",
                                "cs": "Jeho tvář zrudla <w>vztekem</w>, když uslyšel ty lži.",
                                "tr": "O yalanları duyunca yüzü <w>öfkeden</w> kıpkırmızı oldu.",
                                "es": "Su rostro enrojeció de <w>ira</w> cuando escuchó esas mentiras.",
                                "zh": "当他听到这些谎言时，气得满脸通红，心中充满了<w>愤怒</w>。"
                            }
                        },
                        {
                            "text": "Mama nie potrafiła ukryć <w>złości</w>, kiedy zobaczyła bałagan w kuchni.",
                            "target_lang_translations": {
                                "ru": "Мама не смогла скрыть <w>злость</w>, когда увидела беспорядок на кухне.",
                                "en": "Mom couldn't hide her <w>anger</w> when she saw the mess in the kitchen.",
                                "nl": "Mama kon haar <w>boosheid</w> niet verbergen toen ze de troep in de keuken zag.",
                                "de": "Mama konnte ihren <w>Ärger</w> nicht verbergen, als sie das Chaos in der Küche sah.",
                                "fr": "Maman n'a pas pu cacher sa <w>colère</w> lorsqu'elle a vu le désordre dans la cuisine.",
                                "it": "La mamma non riusciva a nascondere la <w>rabbia</w> quando ha visto il disordine in cucina.",
                                "cs": "Máma nedokázala skrýt <w>zlost</w>, když uviděla ten nepořádek v kuchyni.",
                                "tr": "Annem mutfaktaki dağınıklığı görünce <w>kızgınlığını</w> gizleyemedi.",
                                "es": "Mamá no pudo ocultar su <w>enojo</w> cuando vio el desorden en la cocina.",
                                "zh": "妈妈看到厨房里乱七八糟，掩饰不住内心的<w>怒火</w>。"
                            }
                        }
                    ],
