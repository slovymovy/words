                        ]
                    },
                    {
                        "translation_id": "14d1affe-23bb-46f1-bd46-db87636b10d0",
                        "source_entry_id": "0ee9b415-f3c2-36e9-a3fe-f8bdc775123d",
                        "source_sense_description": "Term of respect",
                        "target_lang_word": "ми́лость",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ми́лость",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "be44fd0b-ad2f-346d-89e9-0f8bb321f117",
                                        "entry_id": "54b7cd6a-8996-3ca4-b54f-4dc4fcf381c9",
                                        "glosses": [
                                            "доброе (в противоположность жестокому) отношение к кому-либо, обращение с кем-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d8491f2-fb29-466e-b96c-9f91090d72b6",
                                                "sense_id": "be44fd0b-ad2f-346d-89e9-0f8bb321f117",
                                                "text": "Его только из милости пригласили, и то потому, что он с Петром Петровичем в одной комнате стоит и знакомый его, так неловко было не пригласить."
                                            },
                                            {
                                                "example_id": "0419d528-9c28-46e8-a546-33e9ddb1d7a8",
                                                "sense_id": "be44fd0b-ad2f-346d-89e9-0f8bb321f117",
                                                "text": "Пусть лучше пропадают абонементные деньги, пусть он водку пьёт, только не мучь ты его, сделай милость!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9053954-ec0e-3359-9ff2-773b17fcf3e6",
                                        "entry_id": "54b7cd6a-8996-3ca4-b54f-4dc4fcf381c9",
                                        "glosses": [
                                            "устар. благодеяние, дар или одолжение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eeb636ff-498a-4710-af22-9a138fea674a",
                                                "sense_id": "c9053954-ec0e-3359-9ff2-773b17fcf3e6",
                                                "text": "Твою к нам милость, мать народа, // Мне всю удобно ль исчислять?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57ee5c3a-a36f-35b9-bb57-0c15f41626d2",
                                        "entry_id": "54b7cd6a-8996-3ca4-b54f-4dc4fcf381c9",
                                        "glosses": [
                                            "разг. благожелательность, благосклонность, расположение и доверие к кому-либо (заслуженное, приобретённое кем-нибудь у кого-нибудь)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3d51160-3163-44ab-a0e0-2b284731e0c3",
                                                "sense_id": "57ee5c3a-a36f-35b9-bb57-0c15f41626d2",
                                                "text": "Втереться в милость."
                                            },
                                            {
                                                "example_id": "601af185-956f-449e-bed6-c02ac8fac165",
                                                "sense_id": "57ee5c3a-a36f-35b9-bb57-0c15f41626d2",
                                                "text": "Он в милости у начальства."
                                            },
                                            {
                                                "example_id": "fbbd5ce6-f937-4868-bbd2-29f27dcc0d17",
                                                "sense_id": "57ee5c3a-a36f-35b9-bb57-0c15f41626d2",
                                                "text": "Войдёшь опять в царскую милость, и чтобы гром меня тут же прихлопнул, коли не пропадёт и Вяземский и все твои вороги!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf51f988-f20f-3f6d-bef5-a63ae33d2389",
                                        "entry_id": "54b7cd6a-8996-3ca4-b54f-4dc4fcf381c9",
                                        "glosses": [
                                            "истор., теперь ирон. или , употреблялось преимущ. в почтительном, подобострастном обращении (крестьянина к помещику, низшего служащего к начальству, купца к дворянину и т. п.)"
                                        ],
                                        "tags": [
                                            "укор.",
                                            "в сочетании с местоимением твоя, ваша, его, ее, их"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c01d970-1173-4596-8524-be8af0bb0082",
                                                "sense_id": "bf51f988-f20f-3f6d-bef5-a63ae33d2389",
                                                "text": "Как ваша милость прикажет."
                                            },
                                            {
                                                "example_id": "4eaa8c10-b81d-4992-a1b1-a30935a1ac69",
                                                "sense_id": "bf51f988-f20f-3f6d-bef5-a63ae33d2389",
                                                "text": "Что вашей милости угодно?"
                                            },
                                            {
                                                "example_id": "e360939a-9aba-44d6-b476-cc73ca1f6eaf",
                                                "sense_id": "bf51f988-f20f-3f6d-bef5-a63ae33d2389",
                                                "text": "Посвящение графу Саутгемптону гласило: «Ваша милость, я сознаю, что поступаю весьма дерзновенно, посвящая мои слабые строки вашей милости.»"
                                            },
                                            {
                                                "example_id": "a5db6ae3-74a0-4ae8-b6ec-31f3643d1c01",
                                                "sense_id": "bf51f988-f20f-3f6d-bef5-a63ae33d2389",
                                                "text": "Челом бьём вашей милости."
                                            },
                                            {
                                                "example_id": "0f106b2b-9880-405b-b404-d8fd09e951e4",
                                                "sense_id": "bf51f988-f20f-3f6d-bef5-a63ae33d2389",
                                                "text": "Народишка в твоей милости деревеньке совсем оскудел."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b42ab677-e4a7-3427-9266-b28bcd3d359b",
                                        "entry_id": "54b7cd6a-8996-3ca4-b54f-4dc4fcf381c9",
                                        "glosses": [
                                            "разг., неодобр. в значении вины, причины"
                                        ],
                                        "tags": [
                                            "употр. с предлогом «по»"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93defcd3-1e5b-4ce7-acb7-85c0fccdb6c5",
                                                "sense_id": "b42ab677-e4a7-3427-9266-b28bcd3d359b",
                                                "text": "— Да… На дуэлях дерётся, за певицами бегает, а тут жена… чахни и сохни по его милости…"
                                            }
                                        ]
                                    },
