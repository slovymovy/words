                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a1177b7-9ba3-48c5-a8e0-e1f7a9c74561",
                                "sense_id": "59ccbd38-b9d6-3026-8bd3-ec788aa6be4b",
                                "text": "Nie było jasne, czy świąd jest formą odczuwania bólu, czy też zupełnie innym rodzajem doznań"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9ad4c52-8074-4fae-952e-c77ef16a3893",
                        "source_entry_id": "03714802-77ce-3a41-8f7b-d7d03e66853d",
                        "source_sense_id": "59ccbd38-b9d6-3026-8bd3-ec788aa6be4b",
                        "target_lang_word": "itch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "itch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db63c936-1cf2-373f-a436-e7a88ed08587",
                                        "entry_id": "7503958a-b9e3-33bf-9925-4e5aac5b1b15",
                                        "glosses": [
                                            "A sensation felt on an area of the skin that causes a person or animal to want to scratch said area."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a5c4c8c-776f-384a-848a-39fa9b108e47",
                                        "entry_id": "7503958a-b9e3-33bf-9925-4e5aac5b1b15",
                                        "glosses": [
                                            "A constant teasing desire or want."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b788841-e114-4d7d-b861-566ec146d218",
                                                "sense_id": "9a5c4c8c-776f-384a-848a-39fa9b108e47",
                                                "text": "... it left, however, a bee at his ear and an itch to transfer the buzzer's attentions and tease his darling; for she had betrayed herself as right good game."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "itch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0962e801-ec36-3fde-8a12-3c6724d93b12",
                                        "entry_id": "48f158ab-45f4-32cd-9072-cc7143eea0da",
                                        "glosses": [
                                            "To feel itchy; to feel a need to be scratched."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "stative"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "faac0152-9a3e-3104-a865-bd688a78d3b8",
                                        "entry_id": "48f158ab-45f4-32cd-9072-cc7143eea0da",
                                        "glosses": [
                                            "To have a constant, teasing urge; to feel strongly motivated; to want or desire something."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0b79d83-20c8-4aec-9ecb-79ce0eeeb17e",
                                                "sense_id": "faac0152-9a3e-3104-a865-bd688a78d3b8",
                                                "text": "He started learning to drive and he has been itching for opportunities to practice ever since."
                                            },
                                            {
                                                "example_id": "518dab05-bbd1-4136-b845-8246542575ea",
                                                "sense_id": "faac0152-9a3e-3104-a865-bd688a78d3b8",
                                                "text": "Capulet: ... Speak not, reply not, do not answer me; / My fingers itch. Wife, we scarce thought us blest / That God had lent us but this only child; / But now I see this one is one too much, / And that we have a curse in having her: / Out on her, hilding!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cae4f8c5-9e9d-38d3-969b-f6608d041789",
                                        "entry_id": "48f158ab-45f4-32cd-9072-cc7143eea0da",
                                        "glosses": [
                                            "To cause to feel an itch."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8ba4368-c1cf-4c50-a2a3-b1426ac22af8",
                                                "sense_id": "cae4f8c5-9e9d-38d3-969b-f6608d041789",
                                                "text": "My head is suddenly itching me like mad."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2221bfb6-f146-3250-8bf8-88efbc9b2ab9",
                                        "entry_id": "48f158ab-45f4-32cd-9072-cc7143eea0da",
                                        "glosses": [
                                            "To scratch or rub so as to relieve an itch."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b05b042-7376-429b-8b31-903b790312a1",
                                                "sense_id": "2221bfb6-f146-3250-8bf8-88efbc9b2ab9",
                                                "text": "\"What makes you suspect him?\" Max asked as he itched his neck."
                                            },
                                            {
                                                "example_id": "d192092b-8b94-4f62-81cf-07b7fa07cde8",
                                                "sense_id": "2221bfb6-f146-3250-8bf8-88efbc9b2ab9",
                                                "text": "I have to take both shoes and socks off! If I go bare foot I'm ok! I also get itching on my r/palm of my hand. I itch it so much that it's raw!"
                                            },
                                            {
                                                "example_id": "c394523b-e5c5-4db3-9e99-948b588ee2c8",
                                                "sense_id": "2221bfb6-f146-3250-8bf8-88efbc9b2ab9",
                                                "text": "Basically I go through a half hour of trying to figure out of it is an fake OCD itch or a regular itch before I itch it (if I determine it's a \"fake\" itch, then I try not to itch it)."
                                            },
                                            {
                                                "example_id": "d6f8bee7-b394-4012-99dd-5fc53b9f4c09",
                                                "sense_id": "2221bfb6-f146-3250-8bf8-88efbc9b2ab9",
                                                "text": "Ulysses thumped his side and itched his back side, then slipped into his car."
                                            },
                                            {
                                                "example_id": "a06c9f57-33d6-425b-88a5-b88bf7abe835",
                                                "sense_id": "2221bfb6-f146-3250-8bf8-88efbc9b2ab9",
                                                "text": "But when we asked more about the famous man whose specter still commanded the heights, the guard just sneered at me, pointed his gun back toward the road with one hand, and itched his chin with the other."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "800e455b-3261-4cf1-95aa-89b16a18533a",
                        "source_entry_id": "03714802-77ce-3a41-8f7b-d7d03e66853d",
                        "source_sense_id": "59ccbd38-b9d6-3026-8bd3-ec788aa6be4b",
                        "target_lang_word": "pruritus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pruritus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5febe04-52cb-334b-87be-2104993a2ce5",
                                        "entry_id": "8f82e9e5-e2b3-3c1b-ac99-11c8d8b06330",
                                        "glosses": [
                                            "Itching; especially, severe itching of undamaged skin; caused by allergy, infection, lymphoma, etc."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef26b46f-366e-402e-a061-11edc199e153",
                                                "sense_id": "f5febe04-52cb-334b-87be-2104993a2ce5",
                                                "text": "2018, AbbVie, \"FDA Grants AbbVie's Upadacitinib Breakthrough Therapy Designation for Atopic Dermatitis\", Drug Discovery & Development\nAtopic dermatitis, a chronic inflammatory skin disease, is characterized by skin erosion, oozing and crusting, redness, intense itching (pruritus) and dry skin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9706f9a6-b4f6-46c1-9cde-cb349127bee6",
                        "source_entry_id": "03714802-77ce-3a41-8f7b-d7d03e66853d",
                        "source_sense_id": "59ccbd38-b9d6-3026-8bd3-ec788aa6be4b",
                        "target_lang_word": "prurit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prurit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc0d1e1a-aa63-300e-a0dd-b9b098477fcd",
                                        "entry_id": "01ed4c61-661e-3a3a-a9c7-39055a3afe8f",
                                        "glosses": [
                                            "Démangeaison vive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20e6131b-c5c0-4cd3-a7e1-fb0779c4e6a5",
                                                "sense_id": "dc0d1e1a-aa63-300e-a0dd-b9b098477fcd",
                                                "text": "Il se gratte le front qu'un prurit tenace ne cesse de taquiner, et où fleurissent des taches rougeâtres."
                                            },
                                            {
                                                "example_id": "be8fe86a-630a-4e63-bcff-8834bc896b1b",
                                                "sense_id": "dc0d1e1a-aa63-300e-a0dd-b9b098477fcd",
                                                "text": "Savant estimé, il avait attrapé une maladie de foie à manier les explosifs pendant la guerre et il était atteint de ce mal accablant : le prurit généralisé. Je lui avais passé une ordonnance à ce sujet de mon vieil ami le docteur Lamarre, de Saint-Germain, qui recommandait, à dose minime, le Rhus toxicodendron."
                                            },
                                            {
                                                "example_id": "ea60842b-f79d-4870-a421-e0addae83260",
                                                "sense_id": "dc0d1e1a-aa63-300e-a0dd-b9b098477fcd",
                                                "text": "Quand le prurit est trop fort, je me gratte, mais que voulez-vous, la clientèle a ses exigences, un médecin doit être optimiste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd0ce9bb-6345-3dac-8839-30b79641ec8a",
                                        "entry_id": "01ed4c61-661e-3a3a-a9c7-39055a3afe8f",
                                        "glosses": [
                                            "Désir vif et impatient."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7a600b3-f119-4e81-a37e-cae7fe6f532f",
                                                "sense_id": "bd0ce9bb-6345-3dac-8839-30b79641ec8a",
                                                "text": "Un prurit d’honneurs, d’ambition."
                                            },
                                            {
                                                "example_id": "09ba3bcd-b4da-4e72-b612-1fde0bef0ac1",
                                                "sense_id": "bd0ce9bb-6345-3dac-8839-30b79641ec8a",
                                                "text": "Elle en avait assez de cette vie solitaire, de cet éternel supplice de Tantale, de ce prurit invincible de caresses et d’or."
                                            },
                                            {
                                                "example_id": "20be5812-a17e-4bea-b909-8256e4061cbb",
                                                "sense_id": "bd0ce9bb-6345-3dac-8839-30b79641ec8a",
                                                "text": "C’est aux récits de ma mère qu’il me faut remonter, quand il me prend, comme à tous ceux qui vieillissent, la hâte, le prurit de posséder les secrets d’un être à jamais dissous."
                                            },
                                            {
                                                "example_id": "e86cb9ce-cbbc-40db-ab9a-9d435076b2df",
                                                "sense_id": "bd0ce9bb-6345-3dac-8839-30b79641ec8a",
                                                "text": "Quand je pense que c’est à nous, pauvres hommes du monde sans le sou, que les Parisiens des couches moins pures, les esthètes sans linge et les politiciens en prurit de snobisme doivent ces années de féerie et de haute mondanité !"
                                            },
                                            {
                                                "example_id": "27da4c70-d7bb-42d5-ad09-ff9e2637e0af",
                                                "sense_id": "bd0ce9bb-6345-3dac-8839-30b79641ec8a",
                                                "text": "La Personne Royale avait suscité une sorte de prolifération générale des arts plastiques, un prurit de richesse et d’exaltation, dans une manière de ferveur précieuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
