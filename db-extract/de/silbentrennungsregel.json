                ],
                "senses": [
                    {
                        "sense_id": "0bbcbd3b-ef42-323e-b78b-625d74d9c4bc",
                        "entry_id": "797cb49e-aa65-30cc-9efb-68b6550cde7b",
                        "glosses": [
                            "Regel, nach der ein Wort (oder eine andere sprachliche Einheit) in Silben zerlegt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "378d5eea-174a-47be-8a3c-44b92c9c07b6",
                                "sense_id": "0bbcbd3b-ef42-323e-b78b-625d74d9c4bc",
                                "text": "„Darüber hinaus bietet die Optimalitätstheorie einen mehr oder weniger durchdachten Apparat für das Aufstellen von Silbentrennungsregeln an, der aus einem Set von »silbenformenden« Beschränkungen besteht, denen die Silbe unterworfen ist.“"
                            },
                            {
                                "example_id": "d674765f-0717-4b15-bdf2-a8b991670325",
                                "sense_id": "0bbcbd3b-ef42-323e-b78b-625d74d9c4bc",
                                "text": "„Auch diese Wörter kann man mit dem Kochlöffel nach der Silbentrennungsregel klopfen. “"
                            },
                            {
                                "example_id": "4e339959-0100-4183-bdc6-6ef27a048f1b",
                                "sense_id": "0bbcbd3b-ef42-323e-b78b-625d74d9c4bc",
                                "text": "„Durch eine Änderung in der Silbentrennungsregel bei der Rechtschreibreform (Duden 2000) kommt man der Obstruenzregel entgegen.“"
                            },
                            {
                                "example_id": "f929f675-02ba-4c76-b249-e963fe45285d",
                                "sense_id": "0bbcbd3b-ef42-323e-b78b-625d74d9c4bc",
                                "text": "„Wird im Einstellungstest Silbentrennung verlangt, so sollte man sich strikt an die aktuell gültigen Silbentrennungsregeln halten, die seit der Einführung der neuen Rechtschreibregeln gelten. “"
                            },
                            {
                                "example_id": "433bdb37-3f67-49e1-bf87-414d097ff5a6",
                                "sense_id": "0bbcbd3b-ef42-323e-b78b-625d74d9c4bc",
                                "text": "„Da Silbentrennungsregeln sich von Sprache zu Sprache unterscheiden, lässt sich in Latex auch für einzelne Wörter eine andere Sprache auswählen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
