                ],
                "senses": [
                    {
                        "sense_id": "a70484af-00f9-3744-bdc2-bf7fe3a00493",
                        "entry_id": "0602445e-87f5-3e43-9c9d-9f0da6976855",
                        "glosses": [
                            "eine in Gelenken, Schleimbeuteln und Sehnenscheiden enthaltene visköse, fadenziehende, klare Flüssigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4668c7c-75c6-43e3-ba33-a084cee21061",
                                "sense_id": "a70484af-00f9-3744-bdc2-bf7fe3a00493",
                                "text": "„Gelenke bestehen aus Knochen, einer Knorpelschicht, die die Knochen bedeckt, Muskeln, Bändern und Gelenkflüssigkeit.“"
                            },
                            {
                                "example_id": "0b727f5d-d087-44b1-8685-be4aedba5abe",
                                "sense_id": "a70484af-00f9-3744-bdc2-bf7fe3a00493",
                                "text": "„Gelenke bestehen aus einer Gelenkkapsel, die das Gelenk nach außen abschließt. Innen sind sie mit einer Synovialmembran ausgekleidet, die die Gelenkflüssigkeit, also die sogenannte »Gelenkschmiere« (Synovia) bildet.“"
                            },
                            {
                                "example_id": "22c2f8c5-3c24-4354-8a70-908014bad8f9",
                                "sense_id": "a70484af-00f9-3744-bdc2-bf7fe3a00493",
                                "text": "„Glucosamin und Chondroitin sind wichtige Bestandteile unseres Stützknorpels und der Gelenkflüssigkeit.“"
                            },
                            {
                                "example_id": "125dcec1-64c9-4cd2-acd8-fb7c849a3447",
                                "sense_id": "a70484af-00f9-3744-bdc2-bf7fe3a00493",
                                "text": "„Beim Wandern produziert der Körper mehr Gelenkflüssigkeit, die für einen „reibungslosen“ Bewegungsablauf sorgt und Gelenkschmerzen verringert.“"
                            },
                            {
                                "example_id": "2a297f18-bca8-41a3-9972-9d47039e5e65",
                                "sense_id": "a70484af-00f9-3744-bdc2-bf7fe3a00493",
                                "text": "„Diese Entzündung führt zu einer Verdickung der Gelenkinnenhaut und zu einer Überproduktion von Gelenkflüssigkeit, die schließlich den Knorpel und den Knochen im Gelenk schädigt.“"
                            },
                            {
                                "example_id": "cdcd3107-9329-4e50-9adf-f47f8eea8029",
                                "sense_id": "a70484af-00f9-3744-bdc2-bf7fe3a00493",
                                "text": "„Durch das lange Liegen ist die Gelenkflüssigkeit etwas zäher und der Körper unbeweglicher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
