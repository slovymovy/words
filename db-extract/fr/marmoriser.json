                "senses": [
                    {
                        "sense_id": "680de5b2-0468-34f9-9973-5be1a0fc6f41",
                        "entry_id": "fd153c3f-c417-3908-8a92-28be0b8ff70f",
                        "glosses": [
                            "Transformer en marbre."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "b71e4691-f70e-4982-99a5-6094cb99b5f2",
                                "sense_id": "680de5b2-0468-34f9-9973-5be1a0fc6f41",
                                "text": "Il ne peut en tout cas s’agir de calcaires ou de dolomies massives riches en carbonates; nous savons effectivement que ces roches, sous l’action du métamorphisme, se marmorisent en donnant des cipolins et ce, jusqu'à des stades très avancés du métamorphisme."
                            },
                            {
                                "example_id": "6327000c-7e52-4bb4-a5a7-c5b748da8e81",
                                "sense_id": "680de5b2-0468-34f9-9973-5be1a0fc6f41",
                                "text": "Les Essais ne peuvent pas se marmoriser dans l’écriture livresque."
                            },
                            {
                                "example_id": "b2e08988-4d91-40f3-a6d0-8fe5761cd9ba",
                                "sense_id": "680de5b2-0468-34f9-9973-5be1a0fc6f41",
                                "text": "Si le marbre n’existait pas, Courbet inventerait le marbre; et la magie de sa peinture est précisément dans les prodigieuses énergies qu’il met à marmoriser tout ce que touche son pinceau."
                            }
                        ]
                    }
                ],
