                ],
                "senses": [
                    {
                        "sense_id": "95f7c06a-94ff-3101-982d-d7da96275189",
                        "entry_id": "8744b117-ed08-3331-8edd-398ac3889a28",
                        "glosses": [
                            "bereits im Kindesalter beginnende psychische Störung bei Aufmerksamkeit und Impulsivität, die sich durch ausgeprägte körperliche Unruhe (Hyperaktivität) äußert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "993ff2b9-c14c-4bcd-8ca1-0e37f9d231df",
                                "sense_id": "95f7c06a-94ff-3101-982d-d7da96275189",
                                "text": "„Die Aufmerksamkeitsdefizithyperaktivitätsstörung – Neurotransmittererkrankung, Modediagnose oder komplexe Problematik?“"
                            },
                            {
                                "example_id": "c514e03f-412e-4468-8e68-f35a627b5ea2",
                                "sense_id": "95f7c06a-94ff-3101-982d-d7da96275189",
                                "text": "„Die häufigste Verhaltensstörung im Kindesalter, das negativ klingende Wortungetüm Aufmerksamkeitsdefizithyperaktivitätsstörung – oder kurz ‚ADHS‘ – kann Eltern und PädagogInnen [sic] bereits im Kleinkindalter vor erhebliche Schwierigkeiten stellen und führt im Kindergartenalter häufig zu Problemen bei der sozialen Integration.“"
                            },
                            {
                                "example_id": "f7d8c379-d7cf-4f18-8482-8dbe144293a0",
                                "sense_id": "95f7c06a-94ff-3101-982d-d7da96275189",
                                "text": "„Häufige davon sind Aufmerksamkeitsdefizithyperaktivitätsstörung (ADHS), Posttraumatische Belastungsstörungen (PTBS), Essstörungen, Substanzmissbrauch, Depressionen und andere Persönlichkeitsstörungen.“"
                            },
                            {
                                "example_id": "16db0759-a68a-4677-bac6-1b9646969d0c",
                                "sense_id": "95f7c06a-94ff-3101-982d-d7da96275189",
                                "text": "„Das Wortungetüm ‚Aufmerksamkeitsdefizithyperaktivitätsstörung‘, kurz ADHS genannt, ist die aktuelle aus den USA kommende Bezeichnung für eine der am häufigsten auftretenden Störungen der gegenwärtigen Kinderpsychiatrie.“"
                            },
                            {
                                "example_id": "552f332c-5de4-4859-a2d8-ad04fd29f48e",
                                "sense_id": "95f7c06a-94ff-3101-982d-d7da96275189",
                                "text": "„Ausgeschlossen wurden Teilnehmer, die zuvor Methylphenidat eingenommen hatten oder die Diagnose Aufmerksamkeitsdefizithyperaktivitätsstörung (ADHS) hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
