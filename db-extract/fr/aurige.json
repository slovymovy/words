                "senses": [
                    {
                        "sense_id": "8c53cefe-168c-31e5-ab22-e5f77c9e2823",
                        "entry_id": "e4c926ea-290b-371b-93dc-305c3d687c65",
                        "glosses": [
                            "Conducteur de char."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "5813b626-208c-4028-81ad-c5d2ff8b2115",
                                "sense_id": "8c53cefe-168c-31e5-ab22-e5f77c9e2823",
                                "text": "On découvrit à Delphes à la fin du siècle dernier la statue d’un aurige, d’un conducteur de char."
                            },
                            {
                                "example_id": "8bea1103-d6c8-4eb9-ad7d-f6bbc8a8263c",
                                "sense_id": "8c53cefe-168c-31e5-ab22-e5f77c9e2823",
                                "text": "Le conducteur de char, appelé aurige, est habituellement un esclave ou un affranchi, car aucun citoyen qui se respecte ne peut se compromettre dans la poussière de la piste."
                            },
                            {
                                "example_id": "4e4f525c-7e71-46bc-be3e-079ed98c6f4e",
                                "sense_id": "8c53cefe-168c-31e5-ab22-e5f77c9e2823",
                                "text": "La sibylle a dit que j’allais devenir un grand aurige. (Obélix)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba94cfe5-4b34-45a0-a32a-1e76ec5cdda9",
                        "source_entry_id": "e4c926ea-290b-371b-93dc-305c3d687c65",
                        "source_sense_id": "8c53cefe-168c-31e5-ab22-e5f77c9e2823",
                        "source_sense_description": "(Antiquité) Conducteur de char",
                        "target_lang_word": "Wagenlenker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wagenlenker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "27481376-034b-3d76-a4bf-a734c840406b",
                                        "entry_id": "83ebafe8-e138-30b5-bf34-cea8e1a754a9",
                                        "glosses": [
                                            "Person, die einen von Pferden oder anderen Tieren gezogenen Wagen steuert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c05dd77-ea99-4c6f-aa86-e0b40578980e",
                                                "sense_id": "27481376-034b-3d76-a4bf-a734c840406b",
                                                "text": "„Die fleißigen Schlächter, einst in Diensten Pol Pots oder Madame Defarges, habe ich beauftragt, aus Bastelpapier und Glitzersternchen bunte Schmetterlingsflügel anzufertigen und diese künstlichen Flügel auf die echten Flügel unserer allgegenwärtigen Stubenfliegen zu kleben. Das hübscht nicht nur die ansonsten trübe Atmosphäre der Hölle auf, sondern verhindert auch die unvermeidlichen Schlachten zwischen mongolischen Horden, Nazi-Sturmtruppen und ägyptischen Wagenlenkern.“"
                                            },
                                            {
                                                "example_id": "1bb4d613-7061-4e5b-808b-b23be2210fd7",
                                                "sense_id": "27481376-034b-3d76-a4bf-a734c840406b",
                                                "text": "„Der normale, in der Innenstadt lebende Römer kann folglich niemals Schlaf finden, da der Lärm des Tages ins Getöse der Nacht übergeht, wenn Wagenlenker ihre Pferde und Ochsen antreiben und die großen Holzkarren ächzend über das Pflaster poltern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
