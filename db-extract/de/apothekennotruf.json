                ],
                "senses": [
                    {
                        "sense_id": "01ad486e-b889-3311-8b3a-ee2106ea7c3d",
                        "entry_id": "86d5501f-a2c8-334b-b9e3-53ccac16105f",
                        "glosses": [
                            "Telefonnummer einer Apotheke, die in Notfällen angerufen werden kann und Medikamente liefert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f68408f-cc8d-4b46-bc9c-9123d79912df",
                                "sense_id": "01ad486e-b889-3311-8b3a-ee2106ea7c3d",
                                "text": "„Teheran ist mit Apotheken gut versorgt und Medikamente (oft Generika) sind billig. Wer eine Nachtapotheke benötigt, bittet am besten jemanden an der Hotelrezeption, für ihn den Apothekennotruf (191) anzurufen […].“"
                            },
                            {
                                "example_id": "ba65a760-4b30-483f-9d15-d82b7c29deb7",
                                "sense_id": "01ad486e-b889-3311-8b3a-ee2106ea7c3d",
                                "text": "„Informationen über die Bereitschaftszeiten der Apotheken erhalten die Patienten im Service-Teil der NÖN, aber auch in Gemeindenachrichten, über den Apothekennotruf 1455 und im Internet […].“"
                            },
                            {
                                "example_id": "9168aa85-7b87-43e8-af93-edd1dd9ad706",
                                "sense_id": "01ad486e-b889-3311-8b3a-ee2106ea7c3d",
                                "text": "„Die Apothekerkammer, die dem Internet-Handel eher skeptisch gegenübersteht, baut zwar über den Apothekennotruf für Wien (1455) ebenfalls ein Zustellservice via Taxi und Fahrradboten auf, dämpft aber die Erwartungen.“"
                            },
                            {
                                "example_id": "cc383b24-fc93-4e71-aaaf-3faf9713c3ab",
                                "sense_id": "01ad486e-b889-3311-8b3a-ee2106ea7c3d",
                                "text": "„Es gibt diverse Notrufnummern, ärztlichen Bereitschaftsdienst über Feuerwehr und Rettungsdienst, die Polizei bis hin zum Apothekennotruf und der Nummer der Telefonseelsorge, um nur einige zu nennen.“"
                            },
                            {
                                "example_id": "dfa8dc78-5361-4d7b-bea0-bd35f856f747",
                                "sense_id": "01ad486e-b889-3311-8b3a-ee2106ea7c3d",
                                "text": "„Die aktuellen Dienste und Öffnungszeiten sind am einfachsten über den Apothekennotruf 1455 […] zu erfahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
