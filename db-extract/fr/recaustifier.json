                "senses": [
                    {
                        "sense_id": "250ef6e9-f371-3919-97bb-be548b8feee5",
                        "entry_id": "a75e1cf2-1170-3360-9893-425454b35b4f",
                        "glosses": [
                            "Caustifier à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecb5e89b-aa35-41a5-9336-2f5402e813ed",
                                "sense_id": "250ef6e9-f371-3919-97bb-be548b8feee5",
                                "text": "Comme il est question de recaustifier la lessive après usage, on peut admettre que M. Dondain emploie la soude caustique."
                            },
                            {
                                "example_id": "e6612559-10cd-432e-a6e3-43ef69fa5ce9",
                                "sense_id": "250ef6e9-f371-3919-97bb-be548b8feee5",
                                "text": "En essayant de recaustifier avec de la chaux seule, même en doses assez massives, il ne semble pas que l'on puisse transformer d'une manière appréciable la partie non caustique des corps, ayant un titre alcalimétrique, des soudes résiduaires."
                            }
                        ]
                    }
