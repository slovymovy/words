                                    {
                                        "sense_id": "aced54d9-795f-37d5-95eb-dbe47a897a24",
                                        "entry_id": "126825c2-8996-388c-b994-322ebb2ef5a9",
                                        "glosses": [
                                            "hinder die wordt veroorzaakt door stank"
                                        ],
