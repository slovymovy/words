                ],
                "senses": [
                    {
                        "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                        "entry_id": "c584931d-5e91-3649-8378-ed7772c43cc9",
                        "glosses": [
                            "(männliche^☆) Person, die in ihrer Heimat Gefahren wie Krieg, Gewalt, Verfolgung oder Naturkatastrophen erlebt und davor in einem anderen Land Schutz sucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce436fab-f1ed-414d-8eab-52c861e34ad1",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "„Schutzsuchende sind Ausländerinnen und Ausländer, die sich […] unter Berufung auf völkerrechtliche, humanitäre oder politische Gründe in Deutschland aufhalten.“"
                            },
                            {
                                "example_id": "207dcedf-0650-412d-8d1d-460a479516aa",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "„Für den unmittelbaren persönlichen Bedarf steht den Schutzsuchenden auch Taschengeld zu.“"
                            },
                            {
                                "example_id": "e602a989-1d30-45b9-bd5f-cee34623c5b4",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "„Die Unterkünfte von Schutzsuchenden sind in Deutschland wieder vermehrt Ziel von Angriffen.“"
                            },
                            {
                                "example_id": "1c545d61-86a6-44fc-9d26-c68d0b43df16",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "„Seit März 2022 wird die Turnhalle der Gerda-Taro-Schule temporär als Ankommenszentrum für Schutzsuchende nach dem russischen Überfall auf die Ukraine genutzt.“"
                            },
                            {
                                "example_id": "8da69bde-08fc-4d07-8fd9-c3f2cb4bf821",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "„Viele der vor den israelischen Angriffen Schutzsuchenden sind nach Angaben des UNHCR mittlerweile gezwungen, unter freiem Himmel zu schlafen.“"
                            },
                            {
                                "example_id": "68556ccd-a0e7-4d73-a388-a5c974077cee",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "„Unter Schutzsuchenden, die sich in Ungarn aufhielten oder sich auf der sogenannten „Balkanroute“ auf dem Weg dorthin befanden, verbreitete sich die Twitter-Nachricht schnell.“"
                            },
                            {
                                "example_id": "0892bc7b-33d4-4a74-b72e-4ab6faacf5a4",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "„Es reisten immer mehr Schutzsuchende über Ungarn nach Österreich und von diesen die meisten weiter nach Deutschland, wo sie dann einen Asylantrag stellten.“"
                            },
                            {
                                "example_id": "ad45080b-c427-4806-b828-e9ced46bb4b3",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "„Am darauffolgenden Tag, dem 1. September 2015, wurde der Budapester Hauptbahnhof abgeriegelt und Schutzsuchende wurden abgewiesen.“"
                            },
                            {
                                "example_id": "6b073d58-dd94-407c-ad09-f6964606021e",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "„Am 3. September kam im überfüllten Bahnhof Budapest Keleti ein Zug an. Schutzsuchende, die entsprechende Fahrkarten nach oder in Richtung Österreich gekauft hatten, wurde mitgeteilt, sie könnten diesen Zug nehmen. Dies war aber eine Finte: Der Zug hielt in der Stadt Bicske 35 km vor Budapest, und die Schutzsuchenden sollten sich in ein dortiges Flüchtlingslager begeben, was diese jedoch nicht taten und im Zug ausharrten. Daraufhin weigerten sich Schutzsuchende am Bahnhof Budapest Keleti, in Züge zu steigen.“"
                            },
                            {
                                "example_id": "5f9a5911-fd0b-42de-9def-c771b9e556a6",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "„Von der polizeilichen Einsatzleitung wird er zeitnah informiert, wie viele Schutzsuchende in den einzelnen Zügen erwartet werden.“",
                                "translation": "statistischer Kontext:"
                            },
                            {
                                "example_id": "e71773ff-5c56-4004-a8fe-f0ec56e39a8f",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "[Schlagzeile:] „Zahl der Schutzsuchenden im Jahr 2023 leicht gestiegen“"
                            },
                            {
                                "example_id": "a2d55f7c-76db-475f-a7a0-e8685b719963",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "„Zum Jahresende 2023 waren in Deutschland rund 3,17 Millionen Menschen als Schutzsuchende im Ausländerzentralregister (AZR) erfasst.“"
                            },
                            {
                                "example_id": "8a3d2cb4-d638-4344-8ce9-be4626d77498",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "„Wie das Statistische Bundesamt (Destatis) mitteilt, stieg die Zahl der registrierten Schutzsuchenden gegenüber dem Vorjahr um etwa 95 000 oder 3 %.“"
                            },
                            {
                                "example_id": "013cd032-b9ac-4b6b-9d45-5e3d66d294a0",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "„2,53 Millionen Schutzsuchende verfügten Ende 2023 über einen humanitären Aufenthaltstitel und damit über einen anerkannten Schutzstatus, das waren 275 000 mehr als im Vorjahr (+12 %).“"
                            },
                            {
                                "example_id": "3695e556-ca05-4faf-a41d-e7672f3af8a8",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "„Etwa die Hälfte aller Schutzsuchenden kam aus drei Herkunftsländern: Syrien (455.000), Afghanistan (191.000) und dem Irak (156.000).“"
                            },
                            {
                                "example_id": "9e2bd6cc-4c2d-4811-a40f-2c092a283c9d",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "„Etwa die Hälfte der befristet anerkannten Schutzsuchenden (1,1 Millionen Personen) erhielt ihren Schutzstatus im Rahmen eines Asylverfahrens.“",
                                "translation": "politischer Kontext:"
                            },
                            {
                                "example_id": "e8b8b042-0167-40ac-8f98-9f7e1104bb02",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "„Asylverfahren in Drittstaaten lehnt die SPD ab, Schutzsuchende müssen nach ihrer Auffassung Zugang zu „fairen und rechtsstaatlichen Verfahren in der EU“ erhalten.“"
                            },
                            {
                                "example_id": "f6ab836a-e4fd-459a-aef3-4518c417c9bb",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "„Das Abkommen tritt die Würde der Schutzsuchenden mit Füßen.“"
                            },
                            {
                                "example_id": "ebd1456f-b4ad-4035-b8f4-e952353f6390",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "„[…] Zurückweisung von Schutzsuchenden an den Grenzen halten sie für unzulässig.“"
                            },
                            {
                                "example_id": "2ab30846-2a8c-48d0-949a-aa6af0300a44",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "„Seit Jahrzehnten haben die EU und die EU-Staaten Flüchtlingen und Schutzsuchenden legale Einreisen immer mehr erschwert und so ein immer stärkeres Ausweichen auf unerlaubte Einreisen bewirkt.“"
                            },
                            {
                                "example_id": "155dd2c5-9aef-45e6-85e0-4b17f65d3cb9",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "[Luise Amtsberg setzt] „sich für legale Zugangswege nach Europa ein, damit Schutzsuchende auf lebensgefährliche Routen und die Zuhilfenahme krimineller Schleuser verzichten können.“"
                            },
                            {
                                "example_id": "a59ee9b2-61d9-4a37-a652-e998fb4fe791",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "„Das ist ein Richtungswechsel: Das Parlament will künftig nicht mehr allen Schutzsuchenden aus der Ukraine den Schutzstatus S gewähren.“"
                            },
                            {
                                "example_id": "90c22f3a-4210-4717-a008-c0dc09c45b30",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "„Özoguz äußerte sich „entsetzt“ über das Ausmaß der Ausschreitungen. »Für mich sind Menschen, die derart gegen Schutzsuchende hetzen, keine 'Asylkritiker', wir müssen hier ganz klar von Extremisten sprechen«, sagte sie.“"
                            },
                            {
                                "example_id": "2d0b3272-019e-4151-ac02-a10cb841888b",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "„Vor allem Kommunen seien durch die anhaltend hohe Zahl an Schutzsuchenden \"am Limit\", so der Minister.“",
                                "translation": "rechtlicher/behördlicher Kontext:"
                            },
                            {
                                "example_id": "c3ad51a0-6932-4862-88ea-97de0cd235e5",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "[In Deutschland gibt es] „das Asylbewerberleistungsgesetz, das festlegt, welche Unterstützungsleistungen hilfsbedürftige Schutzsuchende erhalten können.“"
                            },
                            {
                                "example_id": "cb9f4b4e-0458-4f60-a68f-4c37a0cb174d",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "„Schutzsuchende sind verpflichtet, bis zur Entscheidung über ihren Asylantrag durch das Bundesamt für Migration und Flüchtlinge (BAMF) bzw. bei negativem Bescheid bis zur Ausreise, jedoch längstens für 24 Monate in der Aufnahmeeinrichtung zu wohnen.“"
                            },
                            {
                                "example_id": "f76a5663-d838-4ebe-8fad-fafc74762d36",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "„Schutzsuchende müssen im Hoheitsgebiet des Mitgliedstaats bleiben, der für ihren Antrag zuständig ist bzw. in dem Schutz gewährt wurde.“"
                            },
                            {
                                "example_id": "e6d487c0-edc4-48d9-8c95-ef5abd28c7cf",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "„Das Gericht stellte klar, dass weder Kollektivabschiebungen noch Abschiebungen in Länder, in denen den Schutzsuchenden Folter droht, zulässig waren.“"
                            },
                            {
                                "example_id": "ad8c4ab7-3543-4350-8c41-304e3bac27aa",
                                "sense_id": "ab4357ad-a1e9-3e44-82a4-ce7dbe63573e",
                                "text": "„Im Februar 2012 sprach der Europäische Gerichtshof für Menschenrechte im Fall Hirsi Jamaa ein Grundsatzurteil, weil Italien im Mittelmeer geborgene Schutzsuchende aufgrund eines umstrittenen bilateralen Abkommens mit Libyen abgeschoben hatte und dabei mehrfach gegen die Europäische Menschenrechtskonvention verstoßen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "748e4bc0-4a9e-33f1-ba0e-625a0e7e44b0",
                        "entry_id": "c584931d-5e91-3649-8378-ed7772c43cc9",
                        "glosses": [
                            "(männliche^☆) Person, die sich vor Gewalt in Sicherheit bringen möchte (beispielsweise in einem Bunker)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a8f2de5-011a-4f7f-bb04-4311afad740d",
                                "sense_id": "748e4bc0-4a9e-33f1-ba0e-625a0e7e44b0",
                                "text": "[Schlacht um Berlin 1945:] „Frühmorgens ab fünf Uhr werden die 10.000 Schutzsuchenden über unterirdische Gänge in die S-Bahn-Station Anhalter Bahnhof evakuiert.“"
                            },
                            {
                                "example_id": "04735369-3987-4296-80be-b914258d7797",
                                "sense_id": "748e4bc0-4a9e-33f1-ba0e-625a0e7e44b0",
                                "text": "„Der Hochbunker mit seinen 2,5 Metern starken Außenmauern hat die Ausmaße 50 × 16 m und bot bei Fliegeralarm Schutzsuchenden Zuflucht auf 6 Ebenen.“"
                            },
                            {
                                "example_id": "635f1ec4-ff8f-4652-bbe1-c40d7ae53ec6",
                                "sense_id": "748e4bc0-4a9e-33f1-ba0e-625a0e7e44b0",
                                "text": "„Die Bunkeranlagen mussten seit Anfang 1944 bei Alarmen teilweise das Fünffache an Schutzsuchenden aufnehmen.“"
                            },
                            {
                                "example_id": "a0f428a4-b9b4-4f47-8d87-a5636900519f",
                                "sense_id": "748e4bc0-4a9e-33f1-ba0e-625a0e7e44b0",
                                "text": "„Für die Schutzsuchenden gab es rund 6 m² große Räume mit Pritschen und Holzbänken.“"
                            },
                            {
                                "example_id": "248f2805-0c19-45b7-8fde-7e1d255d5a2f",
                                "sense_id": "748e4bc0-4a9e-33f1-ba0e-625a0e7e44b0",
                                "text": "„Für den Zugang und die schnellere Verteilung der Schutzsuchenden auf die einzelnen Etagen wurde ein Turm mit einer stufenlosen Rampe als Aufgang angebaut.“"
                            },
                            {
                                "example_id": "4e69cb61-89c7-4849-826c-d9b600a4bc25",
                                "sense_id": "748e4bc0-4a9e-33f1-ba0e-625a0e7e44b0",
                                "text": "„Der Platz in diesen Schutzbauten wurde im Verlauf des Krieges teilweise mit der vier- bis fünffachen Zahl an Schutzsuchenden belegt.“"
                            },
                            {
                                "example_id": "149f1104-c2e4-41f7-ada7-2c3a219d2ad2",
                                "sense_id": "748e4bc0-4a9e-33f1-ba0e-625a0e7e44b0",
                                "text": "„[…] die Moskauer Metro [wurde] bereits gezielt in Hinblick auf eine mögliche Nutzung als Schutzanlage entworfen und daher in besonders großer Tiefenlage gebaut, um im Falle eines Waffengangs Schutzsuchende aufnehmen zu können.“"
                            },
                            {
                                "example_id": "85282ef1-04e8-42fd-a5e0-724313a13b3b",
                                "sense_id": "748e4bc0-4a9e-33f1-ba0e-625a0e7e44b0",
                                "text": "„Um die Gänsewiese gab es damals sehr viele Eichen, heute steht nur noch die Saueiche. Diese hat bereits mehrmals gebrannt und in dem entstandenen Loch im Stamm konnten zwei bis drei Schutzsuchende Platz finden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
