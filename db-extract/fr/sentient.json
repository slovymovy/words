                                    },
                                    {
                                        "sense_id": "389989f4-35d7-3a46-b790-2498e70ade8f",
                                        "entry_id": "49d8bc6d-8d17-3e7b-8c5c-d8a00bfe46b9",
                                        "glosses": [
                                            "Possessing human-like awareness and intelligence."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f649f16a-d3bf-42d5-9ed0-02862edbb8ed",
                                                "sense_id": "389989f4-35d7-3a46-b790-2498e70ade8f",
                                                "text": "Not even a microbe? I don't want to blow up something that could evolve into a sentient species in a couple of billion years."
                                            },
                                            {
                                                "example_id": "1338cf3e-f4aa-41ae-ba46-cfa033bb3266",
                                                "sense_id": "389989f4-35d7-3a46-b790-2498e70ade8f",
                                                "text": "Lemoine has been placed on “paid administrative leave” after publishing a transcript of conversations with LaMDA which he claims support his belief that the chatbot is sentient and comparable to a seven- or eight-year-old child. […] While Lemoine no doubt genuinely believes his claims, LaMDA is likely to be as sentient as a traffic light."
                                            },
                                            {
                                                "example_id": "ad661772-8997-4039-9da4-680f1d970cbc",
                                                "sense_id": "389989f4-35d7-3a46-b790-2498e70ade8f",
                                                "text": "After more than 25 years as an artificial intelligence researcher[…]Dr. Goertzel knew he had finally reached the end goal: Desdemona, a machine he had built, was sentient. But a few minutes later, he realized this was nonsense."
                                            }
                                        ]
                                    }
                                ]
                            },
