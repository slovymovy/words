                                        "entry_id": "f79b70fe-f620-349f-8b5f-568252fa0acd",
                                        "glosses": [
                                            "Isoligne dont le tracé est basé sur des données continues ou suffisamment denses pour ne laisser qu’un rôle négligeable à l’interprétation du cartographe."
                                        ],
                                        "tags": [],
                                        "examples": [
