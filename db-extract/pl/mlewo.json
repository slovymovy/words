                "senses": [
                    {
                        "sense_id": "b4ae9799-fe9a-3ad9-b418-ee101eb3a608",
                        "entry_id": "2d3c1523-d560-36c3-accc-6f376afdd79a",
                        "glosses": [
                            "zboże do zmielenia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab3e607c-b2c7-422b-bd51-082149f7d0af",
                                "sense_id": "b4ae9799-fe9a-3ad9-b418-ee101eb3a608",
                                "text": "Średni dostał osła Burka, / Co na mlewo nosił zboże"
                            },
                            {
                                "example_id": "fd60bc33-7489-4e8c-846c-ee1f4e994273",
                                "sense_id": "b4ae9799-fe9a-3ad9-b418-ee101eb3a608",
                                "text": "Ponakładali podatki od mlewa takie, że ubogi człek musi z plewą ziarno gryźć, jak bydlę"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "9e06f922-faea-34f1-9ec0-488c5d6f4b27",
                        "entry_id": "2d3c1523-d560-36c3-accc-6f376afdd79a",
                        "glosses": [
                            "zmielone zboże"
                        ],
                        "tags": [],
                        "examples": [
                            {
