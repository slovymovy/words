    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1d2a7d58-c9ea-346c-9a6f-d9a8287bef36",
                    "sense_definition": "Een in elkaar gedrukt stuk papier of ander materiaal, meestal in de vorm van een bal.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "prop_massa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij gooide een <w>prop</w> papier in de prullenbak.",
                            "target_lang_translations": {
                                "en": "He threw a <w>wad</w> of paper into the wastepaper basket."
                            }
                        },
                        {
                            "text": "De leraar werd boos toen de leerling een <w>prop</w> door de klas gooide.",
                            "target_lang_translations": {
                                "en": "The teacher got angry when the student threw a paper <w>ball</w> across the classroom."
                            }
                        }
                    ],
                    "synonyms": [
                        "propje",
                        "prop papier"
                    ],
                    "common_phrases": [
                        "prop papier"
                    ],
                    "target_lang_definitions": {
                        "en": "A crumpled piece of paper or other material, usually in the shape of a ball."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wad",
                                "target_lang_sense_clarification": "of paper or material"
                            },
                            {
                                "target_lang_word": "ball",
                                "target_lang_sense_clarification": "of crumpled paper"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fff4334e-6aba-37cb-b73d-bb6332fc3d70",
                    "sense_definition": "Een samengeperste massa van weefsel, slijm of ander materiaal dat een opening afsluit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prop_massa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dokter verwijderde een <w>prop</w> oorsmeer uit zijn oor.",
                            "target_lang_translations": {
                                "en": "The doctor removed a <w>plug</w> of earwax from his ear."
                            }
                        },
                        {
                            "text": "Er zat een dikke <w>prop</w> vuil in de afvoerleiding.",
                            "target_lang_translations": {
                                "en": "There was a thick <w>clog</w> of dirt in the drainpipe."
                            }
                        }
                    ],
                    "synonyms": [
                        "plug",
                        "stop"
                    ],
                    "common_phrases": [
                        "prop oorsmeer"
                    ],
                    "target_lang_definitions": {
                        "en": "A compressed mass of tissue, mucus, or other material that blocks an opening."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plug",
                                "target_lang_sense_clarification": "of earwax, dirt, or mucus"
                            },
                            {
                                "target_lang_word": "clog",
                                "target_lang_sense_clarification": "blockage of material"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "964f0122-a5bc-3987-9439-c37aee82631d",
                    "sense_definition": "Een bloedstolsel dat een bloedvat verstopt; een embolie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De patiënt kreeg een gevaarlijke <w>prop</w> in zijn longen.",
                            "target_lang_translations": {
                                "en": "The patient got a dangerous <w>clot</w> in his lungs."
                            }
                        },
                        {
                            "text": "Medicijnen kunnen helpen om een <w>prop</w> in de bloedbaan op te lossen.",
                            "target_lang_translations": {
                                "en": "Medicines can help dissolve a <w>clot</w> in the bloodstream."
                            }
                        }
                    ],
                    "synonyms": [
                        "bloedprop",
                        "embolie",
                        "trombose"
                    ],
                    "common_phrases": [
                        "prop in de longen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Medische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A blood clot that blocks a blood vessel; an embolism."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clot",
                                "target_lang_sense_clarification": "blood clot"
                            },
                            {
                                "target_lang_word": "embolus",
                                "target_lang_sense_clarification": "medical term for a blocking clot"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "19a7f385-ed15-3c99-aa98-0c16af8934b7",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>proppen</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verbuiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>prop</w> al mijn kleren snel in de koffer.",
                            "target_lang_translations": {
                                "en": "I quickly <w>stuff</w> all my clothes into the suitcase."
                            }
                        },
                        {
                            "text": "Als ik haast heb, <w>prop</w> ik mijn tas veel te vol.",
                            "target_lang_translations": {
                                "en": "When I'm in a hurry, I <w>cram</w> my bag way too full."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First person singular present tense of 'proppen' (to stuff/cram)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stuff",
                                "target_lang_sense_clarification": "first person singular present"
                            },
                            {
                                "target_lang_word": "cram",
                                "target_lang_sense_clarification": "first person singular present"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8eb20fb0-254e-33c2-91c1-0deb9e0172bb",
                    "sense_definition": "Gebiedende wijs van <w>proppen</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verbuiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Prop</w> die vuile was nou niet zo in de kast!",
                            "target_lang_translations": {
                                "en": "Don't <w>stuff</w> that dirty laundry into the closet like that!"
                            }
                        },
                        {
                            "text": "<w>Prop</w> je mond niet zo vol met eten.",
                            "target_lang_translations": {
                                "en": "Don't <w>cram</w> your mouth so full of food."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of 'proppen' (to stuff/cram)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stuff",
