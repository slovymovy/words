                        "sense_id": "5102dc88-7d3f-3b96-80c6-ade7d26a1c47",
                        "entry_id": "f270bea6-58c7-34cb-a83d-aa1b3b1adc12",
                        "glosses": [
                            "Like a young person or thing; young; youthful."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "33d8819a-c310-4a78-96fd-94f4fc790d48",
                                "sense_id": "5102dc88-7d3f-3b96-80c6-ade7d26a1c47",
                                "text": "How youngly he began to serve his country"
                            },
                            {
                                "example_id": "22ede2d3-a8b1-455a-86a8-7135c373b338",
                                "sense_id": "5102dc88-7d3f-3b96-80c6-ade7d26a1c47",
                                "text": "As I mine eye about-e cast, His larg-e beard-e then at last I saw; and thought anon therefore How that his father him before, Which stood upon the sam-e place, Was beardless, with a youngly face."
                            },
                            {
                                "example_id": "0790af19-79d7-453b-970e-16ab872c45ee",
                                "sense_id": "5102dc88-7d3f-3b96-80c6-ade7d26a1c47",
                                "text": "Preacher how dance bunny-trot. When Hon. Sadson got through, he feel quite puffed but very enjoyable and say that, if youngly men would dance with preachers, tango would seem quite sinless."
                            },
                            {
                                "example_id": "7d63c1b3-11f8-4622-8afe-70dcf4c9258e",
                                "sense_id": "5102dc88-7d3f-3b96-80c6-ade7d26a1c47",
                                "text": "By the time he was a youngly adult dragon, he had secured a position as the most ruthless and feared bounty hunter in the Realm."
                            }
                        ]
                    }
                ],
