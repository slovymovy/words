                "senses": [
                    {
                        "sense_id": "96278a6a-f4b4-3508-b5cb-294e1158300f",
                        "entry_id": "668aa52d-c4fe-32fe-bde2-b7731f0432b2",
                        "glosses": [
                            "die einheimische, volkstümliche Bezeichnung einer Tier- oder Pflanzenart im Gegensatz zu ihrer wissenschaftlich-systematischen Bezeichnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a51eee17-75ea-4869-8e6e-4bc013cc8f28",
                                "sense_id": "96278a6a-f4b4-3508-b5cb-294e1158300f",
                                "text": "Vernakularnamen verwischen aufgrund ihrer Tendenz zu rein äußerlichen Beschreibungen oft die systematischen Zusammenhänge, können aber umgekehrt auch Verwandtschaftsbeziehungen andeuten, wo keine bestehen."
                            },
                            {
                                "example_id": "8a8a1e4c-2407-4349-ae84-40dfa2df9a40",
                                "sense_id": "96278a6a-f4b4-3508-b5cb-294e1158300f",
                                "text": "Für die wissenschaftliche Bezeichnung der Kartoffel „Solanum tuberosum“ gibt es diverse Vernakularnamen wie „Erdapfel“, „Erdbirne“, „Grundbirne“ oder eben „Kartoffel“."
                            }
                        ],
