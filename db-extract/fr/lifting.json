                        "form": "liftings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "156a5c44-97c8-3e5c-9898-5c71ad171be6",
                        "entry_id": "5971dc34-d3e1-3893-bf81-67f7641f65a4",
                        "glosses": [
                            "Opération de chirurgie esthétique destinée à retendre la peau. Lissage ou remodelage sont recommandés à la place de cet anglicisme."
                        ],
                        "tags": [
                            "Faux anglicisme"
                        ],
                        "examples": [
                            {
                                "example_id": "46d6f13b-65ad-4e08-8a48-75c1c6d05919",
                                "sense_id": "156a5c44-97c8-3e5c-9898-5c71ad171be6",
                                "text": "Depuis son lifting elle arbore constamment une espèce de sourire crispé qui me met mal à l’aise."
                            }
                        ]
                    },
                    {
                        "sense_id": "df3400d6-2be7-32c4-b5ad-158b345aa123",
                        "entry_id": "5971dc34-d3e1-3893-bf81-67f7641f65a4",
                        "glosses": [
                            "Opération de réarrangement ou modification superficielle d’une chose."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "47845ae2-2419-4f08-848f-7ac07179fd96",
                                "sense_id": "df3400d6-2be7-32c4-b5ad-158b345aa123",
                                "text": "Je portais toujours cet imperméable. Les effets du petit coup de lifting que j’avais essayé de lui donner s’étaient, depuis longtemps, dissipés."
                            },
                            {
                                "example_id": "f4d4f525-1504-4de6-8d9f-18e5c82d2924",
                                "sense_id": "df3400d6-2be7-32c4-b5ad-158b345aa123",
                                "text": "Tels George Lucas sur la première trilogie Star Wars, ses producteurs se sont permis un lifting à coups d'effets spéciaux de synthèse pas très réussis, glissant des vaisseaux à rayons laser fluos ici, des kaméhaméhas translucides là, n’ajoutant qu’une couche de nanardise supplémentaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ed32364-06d0-4d96-9077-d6b0a6df66f3",
                        "source_entry_id": "5971dc34-d3e1-3893-bf81-67f7641f65a4",
                        "source_sense_id": "156a5c44-97c8-3e5c-9898-5c71ad171be6",
                        "source_sense_description": "Opération",
                        "target_lang_word": "Lift",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lift",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e8ad0e5-b9f2-3d47-a357-177c73aa53ee",
                                        "entry_id": "96218abf-d8a1-3486-b056-ab78ef69c87e",
                                        "glosses": [
                                            "in oder an einem Gebäude befindliche mechanische Vorrichtung, mit der Personen oder Lasten hinauf- beziehungsweise hinabbefördert werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9d4550f-c0fd-4d3d-97df-f2ebecfdbbf9",
                                                "sense_id": "6e8ad0e5-b9f2-3d47-a357-177c73aa53ee",
                                                "text": "„Aber die Aufzüge der Maschinerie wurden betätigt. Immer wieder erscheint eine Hauptperson aus der Versenkung. Am Ende fährt Satanas mit Don Juan per Lift in die Tiefe.“"
                                            },
                                            {
                                                "example_id": "92e8cdff-d4e7-4191-aa51-4d6765c1fdc7",
                                                "sense_id": "6e8ad0e5-b9f2-3d47-a357-177c73aa53ee",
                                                "text": "„Kaum hatte sie den Lift betreten, sackte der nach unten durch. Das war aber noch nicht das Schlimmste. Im Keller, wo sie nun im Lift eingesperrt war, hatte sich zuvor ein Rohrbruch ereignet. Das Wasser drang in die Kabine, und fast wäre die Frau im Lift ertrunken.“"
                                            },
                                            {
                                                "example_id": "90f5c09a-6022-47f1-94c6-f93cf201a93d",
                                                "sense_id": "6e8ad0e5-b9f2-3d47-a357-177c73aa53ee",
                                                "text": "„Mit den Terminals streckt sich London der Welt entgegen, versucht Ordnung in das Chaos der Bewegungen zu bringen, sie zu kanalisieren, zu ordnen. Welche Masse der unentwegt Bewegten. Welche Geduld der Bewegungserfahrenen. Wie sie sich versiert, erfahren, unaufgeregt durch die Tunnels, die Lifte, die Umleitungen, die Treppen hinauf- und hinabbewegen.“"
                                            },
                                            {
                                                "example_id": "6c2a837b-c229-4bf1-a447-a5d7615c9098",
                                                "sense_id": "6e8ad0e5-b9f2-3d47-a357-177c73aa53ee",
                                                "text": "„Als wir am Lift waren, drückte ich auf den Knopf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "045d45e2-150c-3cfc-b71c-b3d8e76f7b6c",
                                        "entry_id": "96218abf-d8a1-3486-b056-ab78ef69c87e",
                                        "glosses": [
                                            "mechanische Vorrichtung, mit der Wintersportler hangaufwärts befördert werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ea2d3d9-2d14-405e-a5c9-ceeec9857487",
                                                "sense_id": "045d45e2-150c-3cfc-b71c-b3d8e76f7b6c",
                                                "text": "„Lange Wartezeiten an den Liften sollen in Südtirol zum Schnee von gestern werden:[…]“"
                                            },
                                            {
                                                "example_id": "61e6b027-6109-4c9b-9e47-1eb672a20f0b",
                                                "sense_id": "045d45e2-150c-3cfc-b71c-b3d8e76f7b6c",
                                                "text": "„150 weitere Passagiere mussten nach dem Stillstand des Lifts mit Hubschraubern geborgen werden.“"
                                            },
                                            {
                                                "example_id": "7b41d940-ed67-447a-af73-c9b89c7c9faa",
                                                "sense_id": "045d45e2-150c-3cfc-b71c-b3d8e76f7b6c",
                                                "text": "„Zur Zeit des Unfalls befanden sich 75 Personen im Lift. […] Daher wurden die übrigen Skifahrer im Lift vom Boden aus geborgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d54b20ea-3a6b-3f99-a397-9faa04924f3a",
                                        "entry_id": "96218abf-d8a1-3486-b056-ab78ef69c87e",
                                        "glosses": [
                                            "das (geräuschvolle) Nach-oben-Ziehen des Nasenschleims"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Lift",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c5fd482a-0739-3f45-a601-06fb92d14cf2",
                                        "entry_id": "e5dfa0f5-9433-32ad-84a2-e4ad798789b4",
                                        "glosses": [
                                            "Gelegenheit / Möglichkeit zur Mitfahrt in einem privaten Fahrzeug (unter Kostenbeteiligung); Mitfahrt, Mitnahme in einem Fahrzeug; (von Anhaltern) das Sich-mitnehmen-Lassen"
                                        ],
                                        "tags": [
                                            "umgangssprachlich,",
                                            "sonst besonders Namibia",
                                            "Südafrika (KwaZulu-Natal)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e3d4ffe-aee8-4747-b5fa-352f2fb5d95b",
                                                "sense_id": "c5fd482a-0739-3f45-a601-06fb92d14cf2",
                                                "text": "„Hat man dann schließlich einen guten ‚Lift‘ erwischt - sagen wir mal Frankfurt — Hannover — und nähert sich zufrieden seinem Ziel, meint der Gastgeber unvermittelt, er müsse schon in Hannover Süd von der Autobahn, er wohne nämlich in Kleinwunstorf. Was nützt der schöne Lift Frankfurt — Hannover, wenn man von Hannover Süd bis Innenstadt zwei Stunden in Lärm und Schmutz auf Betonplatten wandern muß?“"
                                            },
                                            {
                                                "example_id": "4b4dc7b2-354b-4f6f-80d9-fb44907d25de",
                                                "sense_id": "c5fd482a-0739-3f45-a601-06fb92d14cf2",
                                                "text": "„Ein Scheiß-Kaff ist das hier: Seit drei Stunden stehe ich am Schlagbaum der Auffahrt zur Autostrada nach Rom und warte auf einen Lift. Aber niemand nimmt mich mit.“"
                                            },
                                            {
                                                "example_id": "a3700327-6d40-4c28-b058-cb6d237fcb7e",
                                                "sense_id": "c5fd482a-0739-3f45-a601-06fb92d14cf2",
                                                "text": "„Bei Sonnenaufgang und weiter ansteigenden Temperaturen, bekam er endlich von einem Farmer einen Lift auf seinem Bakkie und fuhr nach Mariental.“"
                                            },
                                            {
                                                "example_id": "3e118459-edc8-4145-bb06-ab04b8deceb8",
                                                "sense_id": "c5fd482a-0739-3f45-a601-06fb92d14cf2",
                                                "text": "„Da sprang Toxi rein und ließ sich bis zum nächsten oder übernächsten Kaff einen Lift geben, weil er so gern Auto fuhr.“"
                                            },
                                            {
                                                "example_id": "273f2e72-1d58-4bd5-8b36-f5013bbf391b",
                                                "sense_id": "c5fd482a-0739-3f45-a601-06fb92d14cf2",
                                                "text": "„Haben diese Mitmenschen dann einen Lift gefunden, bleiben Flaschen, Kisten, Windeln, Scherben und natürlich auch der übel riechende Teil des Mülls zurück.“"
                                            },
                                            {
                                                "example_id": "b1f16087-e36e-4267-b651-3601b07db75f",
                                                "sense_id": "c5fd482a-0739-3f45-a601-06fb92d14cf2",
                                                "text": "„Die anderen haben einfach einen Lift gesucht und die Bakkies bestiegen und überladen.“"
                                            },
                                            {
                                                "example_id": "65978906-d30d-4809-b4d7-4c3e1dfc359b",
                                                "sense_id": "c5fd482a-0739-3f45-a601-06fb92d14cf2",
                                                "text": "„Von denen bekam man aber immer nur einen Lift, wenn weit und breit keine weibliche Konkurrenz an der Autobahnraststätte stand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7a54c1d5-258a-387b-b2f5-b34d69f63a59",
                                        "entry_id": "e5dfa0f5-9433-32ad-84a2-e4ad798789b4",
                                        "glosses": [
                                            "aus kosmetischen Gründen durchgeführte Operation, die der Straffung alternder Haut (besonders im Gesicht) oder der Hebung des Busens dient"
                                        ],
                                        "tags": [
                                            "Chirurgie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a49602a1-d4e5-4eaf-bf83-816c4d8e73e1",
                                                "sense_id": "7a54c1d5-258a-387b-b2f5-b34d69f63a59",
                                                "text": "„Schwerste Lifts wie das Zurechtzurren des Knitterbäuchleins, niedlich ‚Tummy tuck‘ genannt, lassen die Filmstars über sich ergehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
