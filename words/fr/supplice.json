            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c4844b38-6df2-3794-a04b-bd02ff2ddf4e",
                    "sense_definition": "Douleur physique très vive ou intense souffrance morale que l'on endure péniblement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "souffrance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai une migraine affreuse depuis ce matin, c'est un véritable <w>supplice</w>."
                        },
                        {
                            "text": "Sans nouvelles de ses enfants bloqués dans la tempête, cette mère était au <w>supplice</w>."
                        }
                    ],
                    "synonyms": [
                        "calvaire",
                        "martyre",
                        "tourment"
                    ],
                    "common_phrases": [
                        "être au supplice",
                        "supplice de Tantale",
                        "vrai supplice"
                    ]
                },
                {
                    "sense_id": "745257c7-29ec-38ab-a085-0a6fe3730db2",
                    "sense_definition": "Châtiment corporel particulièrement douloureux ou exécution ordonnée par une autorité judiciaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "peine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans les temps anciens, le condamné marchait vers le lieu de son <w>supplice</w> sous les huées de la foule."
                        },
                        {
                            "text": "Le tribunal a condamné le criminel au <w>supplice</w> de la roue pour ses méfaits."
                        }
                    ],
                    "synonyms": [
                        "torture"
                    ],
                    "common_phrases": [
                        "dernier supplice",
                        "lieu du supplice",
                        "condamner au supplice"
                    ]
                },
                {
                    "sense_id": "e80b64b4-506c-3799-8ed7-423a32933485",
                    "sense_definition": "Cruauté délibérée ou acte de torture infligé à des ennemis, des captifs ou des opposants.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "peine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les prisonniers de guerre ont été soumis à d'atroces <w>supplices</w> pour livrer des secrets militaires."
                        },
                        {
                            "text": "Ce soldat courageux a enduré le pire <w>supplice</w> sans jamais trahir ses camarades de résistance."
                        }
                    ],
                    "synonyms": [
                        "torture"
                    ],
                    "common_phrases": [
                        "infliger un supplice",
                        "subir des supplices"
                    ]
                }
            ]
        }
