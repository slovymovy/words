                    },
                    {
                        "form_id": "ea2f0c3d-3d0e-480a-89c8-3d958202c8d4",
                        "entry_id": "93192abe-fea3-3119-8e47-4b8ff49d23e6",
                        "tags": [
                            "feminine"
                        ],
                        "form": "équarrisseuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4636fb4f-4458-3020-b005-68c389dcc286",
                        "entry_id": "93192abe-fea3-3119-8e47-4b8ff49d23e6",
                        "glosses": [
                            "Celui qui fait métier de tuer et d’écorcher les bêtes de somme ou de trait, par extension, quiconque équarrit un animal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39050ae5-dde4-45d1-b5b0-434c9b716694",
                                "sense_id": "4636fb4f-4458-3020-b005-68c389dcc286",
                                "text": "Les équarrisseurs déjeunent sur le pouce, assis au pied de la bouverie, les jambes allongées dans la rue des Martyrs, bas de pantalon retenus par un tortil de paille que le sang a imprégné."
                            },
                            {
                                "example_id": "72da532a-14df-40c8-a66e-d01e5126514e",
                                "sense_id": "4636fb4f-4458-3020-b005-68c389dcc286",
                                "text": "Le Vautour fauve est un nécrophage : il se nourrit essentiellement de cadavres. Il joue donc un rôle capital : c’est un équarrisseur qui fait disparaître les traces de la mort et empêche ainsi la propagation des maladies contagieuses."
                            },
                            {
                                "example_id": "e965682a-b96c-4780-88a5-bc611aba12df",
                                "sense_id": "4636fb4f-4458-3020-b005-68c389dcc286",
                                "text": "On parle ici des 10, mais aussi des relayeurs, 8 et autres « inters ». Finis les équarrisseurs. Eux ils jouaient."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "853b3ad3-6580-4745-925c-32601fd94bd7",
                        "source_entry_id": "93192abe-fea3-3119-8e47-4b8ff49d23e6",
                        "source_sense_id": "4636fb4f-4458-3020-b005-68c389dcc286",
                        "target_lang_word": "Abdecker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abdecker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ba17431-ecbd-3cc4-84db-48abf00d6cff",
                                        "entry_id": "b5b13c57-a18a-3208-9350-bfa83b42f68b",
                                        "glosses": [
                                            "Beruf; männliche Person, die Tierkadaver verwertet"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bd5e9f6-d063-4d0a-81fd-24a8635b2de1",
                                                "sense_id": "2ba17431-ecbd-3cc4-84db-48abf00d6cff",
                                                "text": "Und man mag gar nicht glauben, dass auch das Leben sehr beliebter Tiere mal zu Ende geht und sie schließlich beim Abdecker landen, weil der Ponyhof keinem müden Klepper seinen Lebensabend finanzieren will."
                                            },
                                            {
                                                "example_id": "4f93e2c0-4762-44dc-a892-8003a9b4bba1",
                                                "sense_id": "2ba17431-ecbd-3cc4-84db-48abf00d6cff",
                                                "text": "„Es ist praktisch nicht ausführbar, die Empfangnahme eines jeden todten Thieres durch den Abdecker, polizeilich überwachen zu lassen, damit dieser auch Blut und sonstige von dem Thiere abgelössten Theile desselben mit sich nehme, aber es muss der Abdecker bei seiner Concessionirung auf die Verpflichtung hierzu überhaupt, und ganz besonders in den Fällen ansteckender Uebel aufmerksam gemacht, und jede Vernachlässigung dieser Vorschrift bestraft werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4529328d-418d-4616-b710-ab677b95b815",
                        "source_entry_id": "93192abe-fea3-3119-8e47-4b8ff49d23e6",
                        "source_sense_id": "4636fb4f-4458-3020-b005-68c389dcc286",
                        "target_lang_word": "Wasenmeister",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wasenmeister",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1bd18f9-6e19-3a3f-b286-dde7d673ae62",
                                        "entry_id": "b86e6371-9b3c-3058-a694-911b82372d83",
                                        "glosses": [
                                            "Person, die für die Verwertung und Entsorgung nicht essbarer toter Nutztiere verantwortlich ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bd8d309-03e2-49b3-a085-c676c973bef7",
                                                "sense_id": "e1bd18f9-6e19-3a3f-b286-dde7d673ae62",
                                                "text": "„Ist ein solches Stück Vieh gefallen oder getötet worden, und das Fleisch desselben ungenießbar oder als ungenießbar erklärt worden, so ist binnen 6 (bei kalter Witterung binnen 12) Stunden einem Wasenmeister hiervon Anzeige zu machen.“"
                                            },
                                            {
                                                "example_id": "c7d95513-e02e-495d-9bb4-e0b2582e4788",
                                                "sense_id": "e1bd18f9-6e19-3a3f-b286-dde7d673ae62",
                                                "text": "„Der Wasenmeister nach – damaligem Herkommen war mit Fuhrwerk schnell bei der Hand.“"
                                            },
                                            {
                                                "example_id": "4718c873-7f93-4fd9-a922-3a856bf3bbfa",
                                                "sense_id": "e1bd18f9-6e19-3a3f-b286-dde7d673ae62",
                                                "text": "„Der Wasenmeister, jener Mensch mit dem Bajonett, konnte uns nicht sagen, ob der streunende Köter die Krankheit in sich trug.“"
                                            },
                                            {
                                                "example_id": "4170bde1-6e1e-4222-9e35-3fb742f544ac",
                                                "sense_id": "e1bd18f9-6e19-3a3f-b286-dde7d673ae62",
                                                "text": "„In der Neuzeit (bis 1816) fungierte der Scharfrichter zugleich als Wasenmeister (Abdecker).“",
                                                "translation": "„So sei der Neufarner Berg seit der frühen Neuzeit eine wichtige Landmarke für die von und nach München fahrenden Fuhrwerke gewesen, und es habe wohl auch schon lange einen Wasenmeister - also jemanden, der für den Erhalt der Straße zuständig war - gegeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
