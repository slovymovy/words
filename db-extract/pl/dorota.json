                "senses": [
                    {
                        "sense_id": "767bf964-59ea-3cac-9bdf-81f42bc8387f",
                        "entry_id": "385c27e2-1726-3824-89f9-3f748e1cc66f",
                        "glosses": [
                            "imię żeńskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4137efbb-32ad-45e3-b593-5febc3889d20",
                                "sense_id": "767bf964-59ea-3cac-9bdf-81f42bc8387f",
                                "text": "Dorota jest najpiękniejszą dziewczyną na świecie."
                            },
                            {
                                "example_id": "291c7221-5385-47ce-98ac-48c31dbb9ea0",
                                "sense_id": "767bf964-59ea-3cac-9bdf-81f42bc8387f",
                                "text": "Pod koniec średniowiecza w Szwecji św. Dorotę dodano jako piętnastą do grona Czternastu Świętych Wspomożycieli"
                            },
                            {
                                "example_id": "45fff4a8-e549-4163-af18-46a2e0bd3540",
                                "sense_id": "767bf964-59ea-3cac-9bdf-81f42bc8387f",
                                "text": "Córka skarży się na zachowanie wychowawczyni, pani Doroty i jej męża."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57f38bc5-152e-4e0f-9dee-2170eb96ef94",
                        "source_entry_id": "385c27e2-1726-3824-89f9-3f748e1cc66f",
                        "source_sense_id": "767bf964-59ea-3cac-9bdf-81f42bc8387f",
                        "target_lang_word": "Dorothy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dorothy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "365652e1-7d6d-3969-8768-0a3aabe1bad2",
                                        "entry_id": "4763f2de-2a58-36b8-81c1-8abba84d8685",
                                        "glosses": [
                                            "A female given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0890d4b9-964a-480b-90d3-e96fbf8cfdd5",
                                                "sense_id": "365652e1-7d6d-3969-8768-0a3aabe1bad2",
                                                "text": "Piſt[ol]. Then, to you miſtris Dorothy, I will charge you. / Doro[thy]. Charge me? I ſcorne you, ſcuruy companion: […]"
                                            },
                                            {
                                                "example_id": "03a8de37-1562-4535-be94-d9b233fc91df",
                                                "sense_id": "365652e1-7d6d-3969-8768-0a3aabe1bad2",
                                                "text": "\"My name is Dorothy,\" said the girl, \"and I am going to the Emerald City, to ask the great Oz to send me back to Kansas.\""
                                            },
                                            {
                                                "example_id": "183e4776-da2e-4d42-886a-9119bc6b97ea",
                                                "sense_id": "365652e1-7d6d-3969-8768-0a3aabe1bad2",
                                                "text": "Don't you think the world has gone steadily downhill ever since parents stopped naming their children Lucy and Dorothy and started naming them Samantha?"
                                            },
                                            {
                                                "example_id": "16850381-98e5-4d34-a58e-c42e16f3cf58",
                                                "sense_id": "365652e1-7d6d-3969-8768-0a3aabe1bad2",
                                                "text": "In recent years, Hillel chapters have also come under fire for withdrawing support from or further marginalizing queer Jewish student groups that participate in events co-sponsored by JVP, and for banning legendary civil rights activist Dorothy Zellner from speaking at campus chapters after she discussed her commitment to Palestinian human rights work in a speech at Harvard’s Hillel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f050b6ee-079d-4674-b4b5-0452480fd52a",
                        "source_entry_id": "385c27e2-1726-3824-89f9-3f748e1cc66f",
                        "source_sense_id": "767bf964-59ea-3cac-9bdf-81f42bc8387f",
