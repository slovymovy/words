                "senses": [
                    {
                        "sense_id": "741cc32d-4b9c-348f-9da9-4b81a9f2b6a3",
                        "entry_id": "98a8de60-f997-3976-8f90-ca5dfd681b87",
                        "glosses": [
                            "Étude des sens d’un mot, à partir de ce mot même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ef25502-b3bc-4efb-98f6-1de22274b676",
                                "sense_id": "741cc32d-4b9c-348f-9da9-4b81a9f2b6a3",
                                "text": "Sémasiologie et onomasiologie: opposition, recouvrement et complémentarité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "327ce189-866c-48ca-aabc-e730fe291576",
                        "source_entry_id": "98a8de60-f997-3976-8f90-ca5dfd681b87",
                        "source_sense_id": "741cc32d-4b9c-348f-9da9-4b81a9f2b6a3",
                        "target_lang_word": "Semasiologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Semasiologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81baf030-e4b2-34e6-bf17-29374b4a557c",
                                        "entry_id": "b24ee764-a312-36f0-b61d-13e7b6f5eb14",
                                        "glosses": [
                                            "Forschungsrichtung der Semantik, die danach fragt, welche Bedeutung bestimmte Wörter (Lexeme) haben. Sie geht also von den Wörtern aus und fragt danach, auf welche Sachverhalte, Gegenstände etc. sie angewendet werden können."
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e031a994-4406-451d-9e4b-c50ac4929258",
                                                "sense_id": "81baf030-e4b2-34e6-bf17-29374b4a557c",
                                                "text": "Die Semasiologie fragt z.B. danach, welche Bedeutungen das Wort \"Pferd\" im Deutschen hat."
                                            },
                                            {
                                                "example_id": "f2fb98c6-1504-4b9a-8bd9-654b9531893d",
                                                "sense_id": "81baf030-e4b2-34e6-bf17-29374b4a557c",
                                                "text": "„Onomasiologie und Semasiologie untersuchen die lexikalischen Einheiten und Beziehungen sowohl unter synchronischem als auch unter diachronischem Aspekt, also sowohl den Zustand als auch die Veränderungen des Systems der Benennungen und der Wortbedeutungen.“"
                                            },
                                            {
                                                "example_id": "b18b9b6e-eeb9-4fbd-86ac-4eaec8740d16",
                                                "sense_id": "81baf030-e4b2-34e6-bf17-29374b4a557c",
                                                "text": "„Im Bereich der Wortsemantik wird dieser Komplementarität durch die Unterscheidung von Onomasiologie (Bezeichnungslehre) und Semasiologie (Bedeutungslehre) Rechnung getragen.“"
                                            },
                                            {
                                                "example_id": "0982b98f-87e9-4585-91ba-7d622e24be77",
                                                "sense_id": "81baf030-e4b2-34e6-bf17-29374b4a557c",
                                                "text": "„Die Darstellungsfunktion des Wortschatzes ist am differenziertesten von der Semasiologie und Onomasiologie beschrieben worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "894b241b-b65a-393f-8c6e-a4a563829adf",
                                        "entry_id": "b24ee764-a312-36f0-b61d-13e7b6f5eb14",
                                        "glosses": [
                                            "früher auch Synonym für Semantik"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "790cd9fe-8883-4a30-8e28-6f6fbe1c4002",
                        "source_entry_id": "98a8de60-f997-3976-8f90-ca5dfd681b87",
                        "source_sense_id": "741cc32d-4b9c-348f-9da9-4b81a9f2b6a3",
                        "target_lang_word": "semasiology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "semasiology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb11defd-baa0-37cb-8229-c7bc7b0de06d",
                                        "entry_id": "3d2b73da-3d07-3d60-8131-7130fa066ec0",
                                        "glosses": [
                                            "Semantics; a discipline within linguistics concerned with the meaning of a word independent of its phonetic expression."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29878ef5-b16f-486c-ac92-b287567a528f",
                                                "sense_id": "fb11defd-baa0-37cb-8229-c7bc7b0de06d",
                                                "text": "Stylistics seemed to have become a four-letter-word in German semasiology, a fact that shows how far official German semasiology had shifted away from Reisig's initial outline, and how different it was from Bréal's semantics of language-use and Wegener's semantics of communication."
                                            },
                                            {
                                                "example_id": "174b46cd-c2d7-412f-8f03-a44b397e27d7",
                                                "sense_id": "fb11defd-baa0-37cb-8229-c7bc7b0de06d",
                                                "text": "\"The early theories of semasiology attempted to account for meaning shifts in language.\""
                                            },
                                            {
                                                "example_id": "a7d09429-1f68-4fa2-9418-64d965956d6f",
                                                "sense_id": "fb11defd-baa0-37cb-8229-c7bc7b0de06d",
                                                "text": "It must be left to students of musical semasiology to account for the psychological association that exists between the spiritual concept of goodness and saintliness and the notational accident of the absence of sharps and flats in the key signature, which results in the 'whiteness' of the music."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ca69285-f70a-4514-b0d8-979488989311",
                        "source_entry_id": "98a8de60-f997-3976-8f90-ca5dfd681b87",
                        "source_sense_id": "741cc32d-4b9c-348f-9da9-4b81a9f2b6a3",
