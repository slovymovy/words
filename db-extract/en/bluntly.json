                                "target_senses": [
                                    {
                                        "sense_id": "f76bbe7c-8215-3b6d-b6b0-9b298e24514d",
                                        "entry_id": "4e2f3519-16c6-37f5-9acc-17fadad36736",
                                        "glosses": [
                                            "то же, что напрямик, кратчайшим путём"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86f13fc2-b6e5-4890-a418-d1584b7d4d3d",
                                                "sense_id": "f76bbe7c-8215-3b6d-b6b0-9b298e24514d",
                                                "text": "— Напрямую до развилки, — сказал водитель, — а оттуда минут двадцать ходу…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b12dfe1-25e7-3998-a27f-a00fadec7630",
                                        "entry_id": "4e2f3519-16c6-37f5-9acc-17fadad36736",
                                        "glosses": [
                                            "без посредников, непосредственно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ca3e686-cdb3-437d-9c9b-079877aff609",
                                                "sense_id": "7b12dfe1-25e7-3998-a27f-a00fadec7630",
                                                "text": "Космический закон причины и следствия запрещает напрямую вмешиваться в человеческую судьбу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82cae847-3fa2-328e-a1a5-e627b9ebee8c",
                                        "entry_id": "4e2f3519-16c6-37f5-9acc-17fadad36736",
                                        "glosses": [
                                            "перен. не стесняясь, прямо, откровенно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c528877a-22dc-4212-8f27-6bf512edd312",
                                                "sense_id": "82cae847-3fa2-328e-a1a5-e627b9ebee8c",
                                                "text": "— Почему он мстит за тебя? — напрямую спросила мама."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "727815db-1ff3-487a-8192-707f2e1a367f",
                        "source_entry_id": "498d09ab-77c6-3f37-9bd7-80704a838c8d",
                        "source_sense_id": "9b7756ff-1470-312c-a0f3-69760e2496eb",
                        "source_sense_description": "In a blunt manner",
                        "target_lang_word": "пря́мо",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пря́мо",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0fd81b36-5e91-3d27-8ed8-b2b59c840202",
                                        "entry_id": "78e53bf5-f904-3a59-b9c2-b4c7ecfa6622",
                                        "glosses": [
                                            "наречие к прямой; ровно, без изгибов или изломов; по кратчайшему пути; по прямой линии"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9987a57b-9dfc-4ace-bdc8-ea3c8bc5fd1a",
                                                "sense_id": "0fd81b36-5e91-3d27-8ed8-b2b59c840202",
                                                "text": "Дорога до самого леса шла прямо."
                                            },
                                            {
                                                "example_id": "cb241694-3975-4918-a80a-f5267964b58a",
                                                "sense_id": "0fd81b36-5e91-3d27-8ed8-b2b59c840202",
                                                "text": "Идите прямо, потом сверните налево."
                                            },
                                            {
                                                "example_id": "5a96753e-d270-4196-9749-d241ab643168",
                                                "sense_id": "0fd81b36-5e91-3d27-8ed8-b2b59c840202",
                                                "text": "Пашка побежал от крыльца прямо вперёд."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec8fca22-31c7-3ad7-ab5a-bc07896c8d35",
                                        "entry_id": "78e53bf5-f904-3a59-b9c2-b4c7ecfa6622",
                                        "glosses": [
                                            "перен. непосредственно, без промежуточных остановок или этапов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43120280-50f0-4883-bbab-7335266cc2f3",
                                                "sense_id": "ec8fca22-31c7-3ad7-ab5a-bc07896c8d35",
                                                "text": "Он обратился с этим вопросом прямо в министерство."
                                            },
                                            {
                                                "example_id": "e3c852b1-9178-4f42-a6d0-24ecf9b4208d",
                                                "sense_id": "ec8fca22-31c7-3ad7-ab5a-bc07896c8d35",
                                                "text": "Отправляю его, моего друга, прямо к вам."
                                            },
                                            {
                                                "example_id": "8309d4f5-047e-4139-ba7b-539584d335e3",
                                                "sense_id": "ec8fca22-31c7-3ad7-ab5a-bc07896c8d35",
                                                "text": "Прикатили прямо к сроднику."
                                            },
                                            {
                                                "example_id": "1e9310de-d76e-4994-b047-a1ea17f2089c",
                                                "sense_id": "ec8fca22-31c7-3ad7-ab5a-bc07896c8d35",
                                                "text": "Начнём прямо с дела."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1f53bf6-5c96-3c14-9221-3af1ae18fbc2",
                                        "entry_id": "78e53bf5-f904-3a59-b9c2-b4c7ecfa6622",
                                        "glosses": [
                                            "перен. открыто, откровенно, без задних мыслей, без умолчаний, намёков или недомолвок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd8bb327-032e-4cf4-9684-91adccb883df",
                                                "sense_id": "b1f53bf6-5c96-3c14-9221-3af1ae18fbc2",
                                                "text": "Я буду говорить прямо, что случилось?"
                                            },
                                            {
                                                "example_id": "3395b95f-257a-4979-8545-636b8e29c4bc",
                                                "sense_id": "b1f53bf6-5c96-3c14-9221-3af1ae18fbc2",
                                                "text": "Прямо в глаза смотреть кому-нибудь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fc7447a-69c3-3f30-9ed2-300428fdf80d",
                                        "entry_id": "78e53bf5-f904-3a59-b9c2-b4c7ecfa6622",
                                        "glosses": [
                                            "разг. в сочетании с предлогами означает, что смыслу предлога придается возможно большая точность, конкретность"
                                        ],
                                        "tags": [
                                            "частица"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45266a92-0f08-452b-badc-14f4df50c535",
                                                "sense_id": "9fc7447a-69c3-3f30-9ed2-300428fdf80d",
                                                "text": "Заглянул прямо в глаза."
                                            },
                                            {
                                                "example_id": "1f39a999-4d70-4659-9226-7d2a2efcc7c7",
                                                "sense_id": "9fc7447a-69c3-3f30-9ed2-300428fdf80d",
                                                "text": "Лежал прямо на земле."
                                            },
                                            {
                                                "example_id": "8484481d-c05f-4c2b-b6ed-54c010dd15de",
                                                "sense_id": "9fc7447a-69c3-3f30-9ed2-300428fdf80d",
                                                "text": "Попал камнем прямо в глаз."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e964c7d-0a88-3611-9e50-90bee90ff47f",
                                        "entry_id": "78e53bf5-f904-3a59-b9c2-b4c7ecfa6622",
                                        "glosses": [
                                            "разг. выражает усиление с оттенком удивлённости"
                                        ],
                                        "tags": [
                                            "частица"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "714584a1-88b0-4315-b01b-7030c03e1349",
                                                "sense_id": "2e964c7d-0a88-3611-9e50-90bee90ff47f",
                                                "text": "— Ты прямо фокусник какой-то!"
                                            },
                                            {
                                                "example_id": "2778684c-abb6-4a02-8245-88018083cda5",
                                                "sense_id": "2e964c7d-0a88-3611-9e50-90bee90ff47f",
                                                "text": "— Прямо какая-то беда с этими подростками, — напоследок сказала классная."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "592b5b13-0fd5-3aa4-a317-8977b157d8a3",
                                        "entry_id": "78e53bf5-f904-3a59-b9c2-b4c7ecfa6622",
                                        "glosses": [
                                            "разг., ирон. выражает несогласие"
                                        ],
                                        "tags": [
                                            "частица"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea76c514-7c43-49da-a6f0-93f26b17a74d",
                                                "sense_id": "592b5b13-0fd5-3aa4-a317-8977b157d8a3",
                                                "text": "— Он очень опытный специалист. — Да! Прямо! Полчаса возился с этой схемой."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "пря́мо",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7dc6dfd5-f013-30c5-b5cb-58896d670115",
