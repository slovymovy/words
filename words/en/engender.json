                            },
                            {
                                "target_lang_word": "зарождаться",
                                "target_lang_sense_clarification": "начинать свое развитие или существование"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77fda6f8-7cde-3c03-b24f-675e2b9d5d04",
                    "sense_definition": "To beget or bear offspring.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reproduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient texts, kings sought to <w>engender</w> heirs to secure their legacy.",
                            "target_lang_translations": {
                                "ru": "В древних текстах короли стремились <w>родить</w> наследников, чтобы обеспечить свое наследие."
                            }
                        },
                        {
                            "text": "The couple hoped to <w>engender</w> a child after many years of waiting.",
                            "target_lang_translations": {
                                "ru": "Пара надеялась <w>зачать</w> ребенка после многих лет ожидания."
                            }
                        }
                    ],
                    "synonyms": [
                        "beget",
                        "sire"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English for this meaning."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Производить потомство, иметь детей (устар.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рождать",
                                "target_lang_sense_clarification": "производить на свет потомство"
                            },
                            {
                                "target_lang_word": "производить потомство",
                                "target_lang_sense_clarification": "официальный или биологический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adc281f5-151c-3a39-bf01-87523a8ad1cb",
                    "sense_definition": "To copulate or have sexual intercourse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reproduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The biological drive to <w>engender</w> is fundamental to many species.",
                            "target_lang_translations": {
                                "ru": "Биологический инстинкт <w>размножения</w> является фундаментальным для многих видов."
                            }
                        },
                        {
                            "text": "The text describes creatures that do not <w>engender</w> in the traditional sense.",
                            "target_lang_translations": {
                                "ru": "В тексте описываются существа, которые не <w>размножаются</w> в традиционном смысле."
                            }
                        }
                    ],
                    "synonyms": [
                        "copulate",
                        "mate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Highly formal or archaic usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вступать в половую связь (архаично, формально)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совокупляться",
                                "target_lang_sense_clarification": "биологический термин для спаривания животных"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5ed5e5d5-1003-3e18-aee5-e797fd831c83",
                    "sense_definition": "To endow with gender or to emphasize the importance of gender in a social context.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sociologists study how society <w>engender</w>s roles for men and women.",
                            "target_lang_translations": {
                                "ru": "Социологи изучают, как общество <w>гендеризирует</w> роли мужчин и женщин."
                            }
                        },
                        {
                            "text": "The curriculum was <w>engender</w>ed to reflect diverse perspectives on identity.",
                            "target_lang_translations": {
                                "ru": "Учебная программа была <w>гендерно-ориентирована</w> так, чтобы отражать различные взгляды на идентичность."
                            }
