                "senses": [
                    {
                        "sense_id": "aedd6d20-4c33-34d1-b780-bc7b487f4f67",
                        "entry_id": "786bd770-01f4-3e51-a1f8-0fea03a659b7",
                        "glosses": [
                            "Transfusion, bei der das Blut des Empfängers durch fremdes Blut fast vollständig ersetzt werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f409160-60c3-4e95-9872-387040dfcb76",
                                "sense_id": "aedd6d20-4c33-34d1-b780-bc7b487f4f67",
                                "text": "„Bei einer Austauschtransfusion wird ein Teil des Patientenblutes durch Spenderblut ersetzt.“"
                            },
                            {
                                "example_id": "de139999-4cde-4aef-b5ad-f7f6dadae5aa",
                                "sense_id": "aedd6d20-4c33-34d1-b780-bc7b487f4f67",
                                "text": "„Austauschtransfusionen werden insbesondere bei Feten […] oder bei Neugeborenen zur Behandlung eines Morbus haemolyticus neonatorum zur Entfernung der Rh- und Abo-Antikörper und der hämolysierten Erythrozyten (roten Blutkörperchen) sowie zur Substitution des Blutes mit einer normalen Sauerstofftransportkapazität durchgeführt.“"
                            },
                            {
                                "example_id": "69a87dbd-b18b-4118-9c64-b2dc12326659",
                                "sense_id": "aedd6d20-4c33-34d1-b780-bc7b487f4f67",
                                "text": "„Des weiteren werden Austauschtransfusionen bei Erwachsenen bei schweren Immunhämolysen sowie bei Vergiftungen durchgeführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
