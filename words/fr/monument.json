{
    "word_family": [
        "monumental",
        "monumentalement",
        "monumentalité"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3bf6a9dd-2965-3ed6-b752-8d2843361632",
                    "sense_definition": "Grand édifice remarquable par sa valeur historique, artistique ou architecturale.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette ville médiévale possède un <w>monument</w> célèbre que de nombreux touristes viennent admirer chaque année."
                        },
                        {
                            "text": "Pendant notre séjour à Rome, nous avons visité plusieurs <w>monuments</w> antiques très bien conservés."
                        }
                    ],
                    "synonyms": [
                        "édifice"
                    ],
                    "common_phrases": [
                        "monument historique",
                        "visiter un monument"
                    ]
                },
                {
                    "sense_id": "34f187dd-c0af-3227-aaa1-39751ded2e50",
                    "sense_definition": "Ouvrage de sculpture ou d'architecture élevé pour transmettre le souvenir d'un personnage illustre ou d'un événement marquant.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "memorial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les habitants du village se réunissent devant le <w>monument</w> aux morts pour la commémoration."
                        },
                        {
                            "text": "La municipalité a décidé d'ériger un <w>monument</w> en hommage aux fondateurs de la ville."
                        }
                    ],
                    "synonyms": [
                        "mémorial"
                    ],
                    "common_phrases": [
                        "monument aux morts",
                        "ériger un monument"
                    ]
                },
                {
                    "sense_id": "089eed69-8316-3ac9-a2e0-1a85da2c2991",
                    "sense_definition": "Construction funéraire élevée sur une sépulture.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "funeraire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La famille a fait installer un beau <w>monument</w> de marbre au cimetière communal."
                        },
                        {
                            "text": "Ce vieux cimetière abrite plusieurs <w>monuments</w> funéraires datant du dix-neuvième siècle."
                        }
                    ],
                    "synonyms": [
                        "tombe",
                        "tombeau"
                    ],
                    "common_phrases": [
                        "monument funéraire"
                    ]
                },
                {
                    "sense_id": "f3778dc0-3c30-3ec5-92e4-97968bb4ac76",
                    "sense_definition": "Œuvre majeure et durable dans le domaine des sciences, des arts ou de la littérature.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oeuvre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce dictionnaire en dix volumes est considéré comme un véritable <w>monument</w> de la lexicographie moderne."
                        },
                        {
                            "text": "Les pièces de théâtre de cet auteur représentent un des plus grands <w>monuments</w> de la littérature classique."
                        }
                    ],
                    "synonyms": [
                        "chef-d'œuvre"
                    ],
                    "common_phrases": [
                        "monument de la littérature"
                    ]
                },
                {
                    "sense_id": "668ae975-0662-3ec5-a0c3-672969f2c890",
                    "sense_definition": "Personnalité remarquable dont la carrière ou la production a marqué durablement son domaine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec le décès de ce compositeur, le monde de la musique perd un <w>monument</w> irremplaçable."
                        },
                        {
                            "text": "Cette actrice est restée un <w>monument</w> du cinéma français pendant plus de cinquante ans."
                        }
                    ],
                    "synonyms": [
                        "sommité"
                    ],
                    "common_phrases": [
                        "monument du cinéma",
                        "monument de la chanson"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Sens figuré très fréquent dans la presse et le langage courant"
                        }
                    ]
                },
                {
                    "sense_id": "7b7512eb-278a-3c0c-9eb2-130eca86dcc4",
                    "sense_definition": "Exemple frappant et poussé à un degré exceptionnel, souvent en parlant d'un défaut ou d'une absurdité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intensif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son discours électoral était un véritable <w>monument</w> d'hypocrisie que personne n'a pris au sérieux."
                        },
                        {
                            "text": "Ce rapport administratif est un <w>monument</w> de naïveté face aux défis économiques réels."
                        }
                    ],
                    "synonyms": [
                        "sommet"
                    ],
                    "common_phrases": [
                        "monument de bêtise",
                        "monument de naïveté"
                    ]
                }
            ]
        }
    ]
}