                    "frequency": "High",
                    "semantic_group_id": "kleding_stijl",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>kleedt</w> zich altijd volgens de laatste mode.",
                            "target_lang_translations": {
