                        "glosses": [
                            "werkplaats van een smid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03bc6ad3-6e89-4d3b-99f3-ac2c1f865d11",
                                "sense_id": "7979960d-d7e2-3da5-8ae8-15be7270239a",
                                "text": "De geliefkoosde droom van den smid zal niet verwezentlijkt worden: Everaart zal geen smid zijn! Alles, wat hij in zijne werkplaats zoo liefheeft, zal in de handen eens vreemdelings overgaan; misschien zal de smis, na Vanderlaen's dood, voor altijd gesloten worden!"
                            },
                            {
                                "example_id": "0d2e6694-f321-4fc9-b820-fa115fb7a3fa",
                                "sense_id": "7979960d-d7e2-3da5-8ae8-15be7270239a",
                                "text": "Ik ben de zwarte smeder,\nIk hamer bij den gloed;\nDe smis is vuil en spokig,\nMijn tronie zwart als roet.\nDoch zijn gezicht en handen zwart,\nMijn geest is hel, en rein is 't hart!"
                            }
                        ]
                    }
