                                        "entry_id": "81f607f7-4afb-3644-bd62-0ed9e143e187",
                                        "glosses": [
                                            "Ellipsis of quantum entanglement."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
