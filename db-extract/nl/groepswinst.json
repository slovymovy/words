                            {
                                "example_id": "a5872334-e2af-4d20-904c-5e303fd328e8",
                                "sense_id": "90e28c5c-5d3c-3758-a489-74bc85029edb",
                                "text": "Nederland verzekerde zich later op de dag definitief van de groepswinst, door de 10-2 voorsprong tegen Groot-Brittannië in de laatste inning over de streep te trekken. Dat duel werd zaterdag vanwege invallende duisternis afgebroken."
                            },
                            {
                                "example_id": "cdc7a872-5851-474a-84e6-4f8653aa8e29",
                                "sense_id": "90e28c5c-5d3c-3758-a489-74bc85029edb",
                                "text": "Oranje is nu al geplaatst voor de halve finales, maar kan dinsdag de groepswinst veiligstellen tegen Schotland. Dan ontloopt het België, dat vrijwel zeker winnaar is van de andere poule. Spanje of Engeland wordt dan de tegenstander."
                            }
                        ]
