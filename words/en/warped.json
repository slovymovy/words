{
    "word_family": [
        "warp",
        "warper",
        "warpage"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1f37f17d-d19c-3a8f-9e33-6f2281eb2bc1",
                    "sense_definition": "Twisted or bent out of the original shape, usually because of heat or dampness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_distortion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old wooden door is so <w>warped</w> that it no longer closes properly.",
                            "target_lang_translations": {
                                "ru": "Старая деревянная дверь настолько <w>покоробилась</w>, что больше не закрывается плотно.",
                                "it": "La vecchia porta di legno è così <w>imbarcata</w> che non si chiude più correttamente."
                            }
                        },
                        {
                            "text": "Leaving the vinyl record in the sun resulted in a <w>warped</w> disc that cannot be played.",
                            "target_lang_translations": {
                                "ru": "Из-за того, что виниловую пластинку оставили на солнце, получился <w>деформированный</w> диск, который невозможно проиграть.",
                                "it": "Lasciare il disco in vinile al sole ha causato un disco <w>deformato</w> che non può essere riprodotto."
                            }
                        }
                    ],
                    "synonyms": [
                        "distorted",
                        "twisted",
                        "bent",
                        "deformed",
                        "misshapen"
                    ],
                    "antonyms": [
                        "straight",
                        "flat",
                        "even"
                    ],
                    "common_phrases": [
                        "warped wood",
                        "warped floorboards",
                        "warped surface"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искривленный или деформированный, потерявший первоначальную форму (обычно из-за тепла или влаги).",
                        "it": "Contorto o piegato fuori dalla sua forma originale, solitamente a causa di calore o umidità."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покоробленный",
                                "target_lang_sense_clarification": "о дереве, бумаге или плоских поверхностях"
                            },
                            {
                                "target_lang_word": "деформированный",
                                "target_lang_sense_clarification": "общая физическая деформация"
                            },
                            {
                                "target_lang_word": "искривленный",
                                "target_lang_sense_clarification": "изогнутый, потерявший прямизну"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "deformato",
                                "target_lang_sense_clarification": "riferito a un oggetto che ha perso la sua forma originale"
                            },
                            {
                                "target_lang_word": "imbarcato",
                                "target_lang_sense_clarification": "specifico per legno o superfici piane che si sono incurvate"
                            },
                            {
                                "target_lang_word": "storto",
                                "target_lang_sense_clarification": "che non è più dritto o regolare"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0332294e-3a55-3fa8-8417-7d43b393351a",
                    "sense_definition": "Having ideas or attitudes that are strange, unpleasant, or abnormal.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a <w>warped</w> sense of humor that many people find offensive.",
                            "target_lang_translations": {
                                "ru": "У него <w>извращенное</w> чувство юмора, которое многие находят оскорбительным.",
                                "it": "Ha un senso dell'umorismo <w>distorto</w> che molte persone trovano offensivo."
                            }
                        },
                        {
                            "text": "The villain in the movie had a <w>warped</w> mind and wanted to destroy the world.",
                            "target_lang_translations": {
                                "ru": "У злодея в фильме был <w>извращенный</w> ум, и он хотел уничтожить мир.",
                                "it": "Il cattivo del film aveva una mente <w>perversa</w> e voleva distruggere il mondo."
                            }
                        }
                    ],
                    "synonyms": [
                        "twisted",
                        "perverse",
                        "sick",
                        "deviant",
                        "corrupt"
                    ],
                    "antonyms": [
                        "normal",
                        "wholesome",
                        "balanced"
                    ],
                    "common_phrases": [
                        "warped sense of humor",
                        "warped mind",
                        "warped perspective"
                    ],
                    "target_lang_definitions": {
                        "ru": "Странный, ненормальный или неприятный (об идеях, взглядах или характере).",
                        "it": "Che ha idee o atteggiamenti strani, spiacevoli o anormali."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извращенный",
                                "target_lang_sense_clarification": "о чувстве юмора, уме или морали"
                            },
                            {
                                "target_lang_word": "искаженный",
                                "target_lang_sense_clarification": "о восприятии реальности или фактах"
                            },
                            {
                                "target_lang_word": "больной",
                                "target_lang_sense_clarification": "разг. о фантазии или воображении"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "distorto",
                                "target_lang_sense_clarification": "riferito a una percezione o visione della realtà"
                            },
                            {
                                "target_lang_word": "perverso",
                                "target_lang_sense_clarification": "riferito a una mentalità o senso dell'umorismo deviato"
                            },
                            {
                                "target_lang_word": "malato",
                                "target_lang_sense_clarification": "riferito a una mente o fantasia malsana"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b8866182-78c3-3959-8c4d-d9a481fdc3d8",
                    "sense_definition": "Simple past and past participle of <w>warp</w>.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The intense summer heat <w>warped</w> the plastic chairs left on the patio.",
                            "target_lang_translations": {
                                "ru": "Сильная летняя жара <w>деформировала</w> пластиковые стулья, оставленные во внутреннем дворике.",
                                "it": "L'intenso calore estivo ha <w>deformato</w> le sedie di plastica lasciate nel patio."
                            }
                        },
                        {
                            "text": "Moisture from the leak <w>warped</w> the floorboards near the bathroom.",
                            "target_lang_translations": {
                                "ru": "Влага от протечки <w>покоробила</w> половицы возле ванной.",
                                "it": "L'umidità della perdita ha <w>imbarcato</w> le assi del pavimento vicino al bagno."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время глагола 'warp' (искривлять, коробить).",
                        "it": "Passato remoto e participio passato del verbo 'warp' (deformare, incurvare)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покоробил",
                                "target_lang_sense_clarification": "деформировал (обычно влагой или теплом)"
                            },
                            {
                                "target_lang_word": "деформировал",
                                "target_lang_sense_clarification": "изменил физическую форму"
                            },
                            {
                                "target_lang_word": "искривил",
                                "target_lang_sense_clarification": "сделал кривым"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "deformato",
                                "target_lang_sense_clarification": "ha alterato la forma fisica di qualcosa"
                            },
                            {
                                "target_lang_word": "incurvato",
                                "target_lang_sense_clarification": "ha reso curvo un oggetto dritto"
                            },
                            {
                                "target_lang_word": "imbarcato",
                                "target_lang_sense_clarification": "ha causato l'incurvatura di legno o materiali simili"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}