                        "sense_id": "54fc5fc5-a325-383f-ae20-c85c6ec0409a",
                        "entry_id": "6a2247bf-50a9-3d5c-a97b-8cc888e2dfa9",
                        "glosses": [
                            "To remove shackles from someone or something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "409d6fb2-ae12-432c-bf97-dde5ba8fa651",
                                "sense_id": "54fc5fc5-a325-383f-ae20-c85c6ec0409a",
                                "text": "The captain ordered that the guards unshackle and release the prisoner, as he had served his sentence."
                            },
                            {
                                "example_id": "89940fe6-172b-47a6-bcc2-45c19789a4fb",
                                "sense_id": "54fc5fc5-a325-383f-ae20-c85c6ec0409a",
                                "text": "The sooner the railway can unshackle itself from DfT the better."
                            }
                        ]
                    },
                    {
                        "sense_id": "9968c6a6-a4cc-32c4-baa2-339ec04f0826",
                        "entry_id": "6a2247bf-50a9-3d5c-a97b-8cc888e2dfa9",
                        "glosses": [
                            "To remove restrictions or inhibitions; to allow full freedom and power."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "441f3946-d537-4d5e-8087-9cddc96e7e55",
                                "sense_id": "9968c6a6-a4cc-32c4-baa2-339ec04f0826",
                                "text": "1818, Samuel Taylor Coleridge, On Poesy or Art\nPainting was, as it were, a new art, and being unshackled by old models it chose its own subjects, and took an eagle’s flight."
                            }
                        ]
                    }
                ],
