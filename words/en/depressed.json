        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f34677c8-9955-36d3-b021-b57bb30472a5",
                    "sense_definition": "Simple past and past participle of <w>depress</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant rain <w>depressed</w> everyone on the trip.",
                            "target_lang_translations": {
                                "ru": "Постоянный дождь <w>угнетал</w> всех в поездке.",
                                "zh": "连绵不断的雨让旅行中的每个人都感到<w>沮丧</w>。",
                                "es": "La lluvia constante <w>deprimió</w> a todos en el viaje.",
                                "tr": "Sürekli yağan yağmur, gezideki herkesin <w>moralini bozdu</w>.",
                                "de": "Der ständige Regen <w>deprimierte</w> alle auf der Reise."
                            }
                        },
                        {
                            "text": "He <w>depressed</w> the clutch pedal to change gears.",
                            "target_lang_translations": {
                                "ru": "Он <w>нажал</w> педаль сцепления, чтобы переключить передачу.",
                                "zh": "他<w>按下</w>离合器踏板以进行换挡。",
                                "es": "Él <w>presionó</w> el pedal del embrague para cambiar de marcha.",
                                "tr": "Vites değiştirmek için debriyaj pedalına <w>bastı</w>.",
                                "de": "Er <w>drückte</w> das Kupplungspedal, um den Gang zu wechseln."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время от глагола 'depress' (угнетать, нажимать).",
                        "zh": "动词 depress 的过去式或过去分词，意为使沮丧或按下。",
                        "es": "Pasado o participio del verbo 'deprimir' (causar tristeza o presionar hacia abajo).",
                        "tr": "Depress fiilinin geçmiş zaman hali (moralini bozmak, aşağı bastırmak).",
                        "de": "Vergangenheitsform von 'deprimieren' (niedergeschlagen machen) oder 'drücken' (nach unten bewegen)."
