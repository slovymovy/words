                                                "sense_id": "f741204f-4257-32bd-8f1f-a0257a577798",
                                                "text": "Croissance hâtive."
                                            },
                                            {
                                                "example_id": "d4cd4827-c591-40be-8c26-777ef491952a",
                                                "sense_id": "f741204f-4257-32bd-8f1f-a0257a577798",
                                                "text": "Esprit hâtif."
                                            },
                                            {
                                                "example_id": "b09fa670-a2e4-472e-98b6-677293fbaeac",
                                                "sense_id": "f741204f-4257-32bd-8f1f-a0257a577798",
                                                "text": "La puberté est toujours plus hâtive chez les peuples policés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56e5358b-6696-31d3-b39f-6f77ab0afa46",
                                        "entry_id": "891efa8c-4859-32a8-a953-e0ebd3c8d1c1",
                                        "glosses": [
                                            "Qui est en avance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78eeaed0-af70-4082-adb7-e35b4ed949ac",
                                                "sense_id": "56e5358b-6696-31d3-b39f-6f77ab0afa46",
                                                "text": "Fruit hâtif."
                                            },
                                            {
                                                "example_id": "6c5d3601-907c-4988-9170-2a797951203b",
                                                "sense_id": "56e5358b-6696-31d3-b39f-6f77ab0afa46",
                                                "text": "On avait signalé de hâtifs passages de hérons au-dessus des bois de Meudon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a60a52b4-04d4-30bd-b3d3-aab4ef35e40e",
                                        "entry_id": "891efa8c-4859-32a8-a953-e0ebd3c8d1c1",
                                        "glosses": [
                                            "Qui produit avant le temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc115ada-309e-4663-83ed-b92bc8afa9cf",
                                                "sense_id": "a60a52b4-04d4-30bd-b3d3-aab4ef35e40e",
                                                "text": "Terrain hâtif."
                                            },
                                            {
                                                "example_id": "1e009f69-f92e-4233-8025-0c329f0966a1",
                                                "sense_id": "a60a52b4-04d4-30bd-b3d3-aab4ef35e40e",
                                                "text": "Il y a des arbres hâtifs dans le jardin de notre époux."
                                            },
                                            {
                                                "example_id": "7740f1e2-2ea5-4750-bbce-d7951b56d62b",
                                                "sense_id": "a60a52b4-04d4-30bd-b3d3-aab4ef35e40e",
                                                "text": "Un printemps doux et, par conséquent, une année hâtive, toujours favorable à la vigne et à la qualité de son fruit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cbff2fc-04f0-3b3c-997a-5eb86c70bb3d",
                                        "entry_id": "891efa8c-4859-32a8-a953-e0ebd3c8d1c1",
                                        "glosses": [
                                            "Qui se développent plus tôt que l’espèce, en parlant de variétés de plantes, de fruits ou de fleurs."
                                        ],
                                        "tags": [
                                            "Arboriculture",
                                            "Jardinage",
                                            "Viticulture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "507a7524-919f-4c03-a725-fe5bae284ed6",
                                                "sense_id": "2cbff2fc-04f0-3b3c-997a-5eb86c70bb3d",
                                                "text": "Heureusement tous les cossons n'étaient pas partis. Il y a des cépages peu hâtifs qui prudemment n’ont pas « débourré » — et, chose remarquable, ce ne sont pas ceux dits « du pays » qu'on s'obstine, aveuglément, à recommander."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3789c92-4462-3b1b-8870-43a17d354486",
                                        "entry_id": "891efa8c-4859-32a8-a953-e0ebd3c8d1c1",
                                        "glosses": [
                                            "Qui hâte."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccd073a9-bd17-40d0-82b6-acfd44b06eb2",
                                                "sense_id": "d3789c92-4462-3b1b-8870-43a17d354486",
                                                "text": "Les fouets hâtifs sont déployés."
                                            }
                                        ]
                                    }
                                ]
                            }
