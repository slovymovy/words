                "senses": [
                    {
                        "sense_id": "86e743cf-5240-3dd0-b9ec-e5b1b2c25568",
                        "entry_id": "21ba6054-4155-3c81-9023-14b42b9c5331",
                        "glosses": [
                            "westlicher Teil eines Gebäudekomplexes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62f6acfe-e01d-4141-98d0-ab947f3e2cb7",
                                "sense_id": "86e743cf-5240-3dd0-b9ec-e5b1b2c25568",
                                "text": "„Ihr Wagen war schon umgeparkt worden, und so folgten sie der Auffahrt bis ans Ende des Westflügels und gingen dann hinten herum zur Garage, einem langen, schmalen ehemaligen Pferdestall mit Halbtüren.“"
                            },
                            {
                                "example_id": "42b8938e-97b9-4c5a-a84a-05c622f917c3",
                                "sense_id": "86e743cf-5240-3dd0-b9ec-e5b1b2c25568",
                                "text": "„Calibrisi folgte Jessica den niedrigen Flur entlang zu ihrem großzügigen Office im Westflügel.“"
                            },
                            {
                                "example_id": "dd2bf47f-f24f-4ca4-ada1-74ae6e10c490",
                                "sense_id": "86e743cf-5240-3dd0-b9ec-e5b1b2c25568",
                                "text": "„Es gab einen weitläufigen Westflügel, der einen Innenhof in der Nähe der Kapelle umgab und in dem gelegentlich patrouilliert werden musste, da sich auf dieser Seite kein mirador befand.“"
                            },
                            {
                                "example_id": "e1c56ceb-1c1b-48ed-b9c9-9912616e1238",
                                "sense_id": "86e743cf-5240-3dd0-b9ec-e5b1b2c25568",
                                "text": "„So war der Westflügel zum Beispiel so klein, dass er kaum eine größere Anzahl Personen beherbergen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
