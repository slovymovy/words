                    }
                ],
                "senses": [
                    {
                        "sense_id": "ca76b877-d4fd-3765-a267-9c74d3953513",
                        "entry_id": "4230d8cf-b376-38bd-8812-e1c006a52cf5",
                        "glosses": [
                            "разг. начав говорить, внезапно остановиться; запнуться на полуслове"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ff91134e-f927-33fe-af3b-31d1a18cd19e",
                        "entry_id": "4230d8cf-b376-38bd-8812-e1c006a52cf5",
                        "glosses": [
                            "перен., разг. коснуться в речи чего-либо осторожно, намёками"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13843ff8-22d0-4ac2-96c8-8f3c17a1f8b2",
                        "source_entry_id": "4230d8cf-b376-38bd-8812-e1c006a52cf5",
                        "source_sense_description": "коснуться в речи чего-либо осторожно, намёками",
                        "target_lang_word": "bring up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bring up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "858fbf8f-c62e-3734-987f-0c1552b3a166",
                                        "entry_id": "78ae456e-b474-33d6-b83b-51d0d1f5667c",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see bring, up: To bring from a lower to a higher position."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be477d31-2c7b-49e7-8e99-aa028a1995ae",
                                                "sense_id": "858fbf8f-c62e-3734-987f-0c1552b3a166",
                                                "text": "When you're in the basement, can you bring up the paints?"
                                            },
                                            {
                                                "example_id": "0c896f03-d40b-4b7b-975c-8877eadc70a2",
                                                "sense_id": "858fbf8f-c62e-3734-987f-0c1552b3a166",
                                                "text": "\"[…]and as Mr. H., with his long purse and his willingness to receive hints, is no bad card in the game, he has been brought up to Abbotsford for a week; his taciturnity has long ago fled, and he is one of the most loquacious Borderers going. […]\""
                                            },
                                            {
                                                "example_id": "15a0a6d1-a01f-4c15-bdf7-102fb852b6fd",
                                                "sense_id": "858fbf8f-c62e-3734-987f-0c1552b3a166",
                                                "text": "This case was brought up by writ of error from the Circuit Court of the United States for the District of New Jersey."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09478ce1-076e-3979-820c-6dbda781d7a2",
                                        "entry_id": "78ae456e-b474-33d6-b83b-51d0d1f5667c",
                                        "glosses": [
                                            "To mention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ceb084f-2f46-43a0-9460-595383f3c173",
                                                "sense_id": "09478ce1-076e-3979-820c-6dbda781d7a2",
                                                "text": "Don't bring up politics if you want to have a quiet conversation with that guy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0f8356b-d152-3dc6-8b21-507bc2c3f9d5",
                                        "entry_id": "78ae456e-b474-33d6-b83b-51d0d1f5667c",
                                        "glosses": [
                                            "To raise or rear (children)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c415531b-e987-4b87-8464-4789d070b531",
                                                "sense_id": "c0f8356b-d152-3dc6-8b21-507bc2c3f9d5",
                                                "text": "In the present writer's opinion there was no greater and more successful locomotive engineer in the country, during the first quarter-century, than George Jackson Churchward of the Great Western Railway. This statement is made without prejudice, for I was brought up on the other line extending from Waterloo to Padstow, and between Swindon and Eastleigh there was a great gulf fixed."
                                            },
                                            {
                                                "example_id": "669a4ca2-4c3b-4b28-b042-8eae416754fe",
                                                "sense_id": "c0f8356b-d152-3dc6-8b21-507bc2c3f9d5",
                                                "text": "‘[…] I remember a lady coming to inspect St. Mary's Home where I was brought up and seeing us all in our lovely Elizabethan uniforms we were so proud of, and bursting into tears all over us because “it was wicked to dress us like charity children”.[…]’."
                                            },
                                            {
                                                "example_id": "2b77fe98-7157-4eec-91b5-6c9091849a88",
                                                "sense_id": "c0f8356b-d152-3dc6-8b21-507bc2c3f9d5",
                                                "text": "She did well enough bringing up two sons and a daughter on her own."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45477c60-7fd8-3d24-a625-a3d14d86c0e6",
                                        "entry_id": "78ae456e-b474-33d6-b83b-51d0d1f5667c",
                                        "glosses": [
                                            "To uncover, to bring from obscurity; to resurface (e.g. a memory)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dbbb474-f09c-4368-be88-0b735d32b3c4",
                                                "sense_id": "45477c60-7fd8-3d24-a625-a3d14d86c0e6",
                                                "text": "A short Internet search brought up some amazing details of this story."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fff05fbe-788f-3681-b672-7494ae746c9a",
                                        "entry_id": "78ae456e-b474-33d6-b83b-51d0d1f5667c",
                                        "glosses": [
                                            "To turn on power or start, as of a machine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2c2cc86-0760-4207-bbe4-fa57efa63344",
                                                "sense_id": "fff05fbe-788f-3681-b672-7494ae746c9a",
                                                "text": "Wait a minute while I bring up my computer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8308bbf6-e9dd-31dc-97c1-2bcf00d85bb6",
                                        "entry_id": "78ae456e-b474-33d6-b83b-51d0d1f5667c",
                                        "glosses": [
                                            "To check (a newly-assembled printed circuit board) for errors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f266a87d-f4bf-4471-a39a-ed0acf44c6a7",
                                                "sense_id": "8308bbf6-e9dd-31dc-97c1-2bcf00d85bb6",
                                                "text": "Anyone who's been tasked with bringing up a board knows how trying it is."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5336e40-1c0b-3180-87e0-0ede73f221d1",
                                        "entry_id": "78ae456e-b474-33d6-b83b-51d0d1f5667c",
                                        "glosses": [
                                            "To vomit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c83e55e9-ca76-4c4f-955b-56badc6a623c",
                                                "sense_id": "f5336e40-1c0b-3180-87e0-0ede73f221d1",
                                                "text": "I was very ill today; I kept bringing up everything I ate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e06d59d0-e364-3928-b033-8005c5d38da4",
                                        "entry_id": "78ae456e-b474-33d6-b83b-51d0d1f5667c",
                                        "glosses": [
                                            "To stop or interrupt a flow or steady motion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62041a92-1df1-4644-96a2-a6f0ad070f17",
                                                "sense_id": "e06d59d0-e364-3928-b033-8005c5d38da4",
                                                "text": "\"[…]Mr. Wolfe, I beg you—I beg of you—\"\nI was sure she was going to cry and I didn't want her to. But Wolfe brusquely brought her up:\n\"That's all, Miss Barstow.[…]\""
                                            },
                                            {
                                                "example_id": "d788f20d-1044-4e2a-9a29-f078cb3c1b53",
