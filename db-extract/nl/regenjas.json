                                                "sense_id": "2318728c-5f2c-3ca3-8f83-47bbdd5dd10f",
                                                "text": "„Wie ein grauer Schleier legte sich der sanfte Nieselregen über meine rote Regenjacke.“"
                                            },
                                            {
                                                "example_id": "87b1a99d-be4c-419d-b9af-70baf489a92b",
                                                "sense_id": "2318728c-5f2c-3ca3-8f83-47bbdd5dd10f",
                                                "text": "„Wir ziehen die Regenjacken an, schlüpfen in festes Schuhwerk.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
