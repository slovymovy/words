                                "sense_id": "7c4e2e27-0fac-3061-a448-3ee009824177",
                                "text": "Нарядиться медведем."
                            },
                            {
                                "example_id": "71fbc459-8643-496b-aaa0-c65cbe44f670",
                                "sense_id": "7c4e2e27-0fac-3061-a448-3ee009824177",
                                "text": "Нарядиться в женское платье."
                            }
                        ]
