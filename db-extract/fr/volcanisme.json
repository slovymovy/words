                    }
                ],
                "senses": [
                    {
                        "sense_id": "a9225d2d-1ba4-36ff-9c95-3e1a1b3b4735",
                        "entry_id": "92b0435a-c7f6-393d-bd3f-e1a75c535421",
                        "glosses": [
                            "Activité volcanique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22f551a8-f67a-44b7-983d-6f4452d4124c",
                                "sense_id": "a9225d2d-1ba4-36ff-9c95-3e1a1b3b4735",
                                "text": "Dans le cadre d'un article, il ne peut évidemment être question de parler de tous les aspects du volcanisme ni des nombreux problèmes que la volcanologie soulève et que les géothermiciens auraient intérêt à connaître."
                            },
                            {
                                "example_id": "213e227e-b43e-46aa-9b20-f4ac71d74ca8",
                                "sense_id": "a9225d2d-1ba4-36ff-9c95-3e1a1b3b4735",
                                "text": "Le volcanisme est l’un des principaux processus géologiques qui modèlent la surface des planètes et des satellites ; c’est également l’un des principaux témoins de l’activité interne de ces corps."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d355c0e5-410b-46ae-accf-613ea9b961bb",
                        "source_entry_id": "92b0435a-c7f6-393d-bd3f-e1a75c535421",
                        "source_sense_id": "a9225d2d-1ba4-36ff-9c95-3e1a1b3b4735",
                        "target_lang_word": "Vulkanismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vulkanismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c404e294-918f-3f11-bf69-089d4900d767",
                                        "entry_id": "d8e00890-5ef7-3603-a36c-a7986bace4e7",
                                        "glosses": [
                                            "Gesamtheit aller geologischen Vorgänge und Erscheinungen, die im Zusammenhang mit dem Austreten von Stoffen aus dem Inneren der Erde stehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83676f7d-da86-467b-8908-4db02d9a920a",
                                                "sense_id": "c404e294-918f-3f11-bf69-089d4900d767",
                                                "text": "„Der Vulkanismus der Eifel begann vor 50 Millionen Jahren im Tertiär und hielt bis in die geologische Gegenwart an.“"
                                            },
                                            {
                                                "example_id": "1b8e86b2-44ea-45f9-b2fb-0124267d2456",
                                                "sense_id": "c404e294-918f-3f11-bf69-089d4900d767",
                                                "text": "„In enger Beziehung zur Hebung des Rheinischen Schiefergebirges und dem Zerbrechen der Erdkruste steht der Vulkanismus im Laacher-See-Vulkangebiet, dessen Schlackenkegel im Nordwesten am Horizont auftauchen (…).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14a005e8-90a0-4cd9-995f-28f2548c221e",
                        "source_entry_id": "92b0435a-c7f6-393d-bd3f-e1a75c535421",
