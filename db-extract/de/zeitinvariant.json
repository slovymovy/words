                "senses": [
                    {
                        "sense_id": "5be3945d-1e2f-3e21-90a7-9472c360b37f",
                        "entry_id": "cf76f980-f917-3b4d-a244-a08f09524655",
                        "glosses": [
                            "über einen betrachteten Zeitraum hinweg konstant, häufig im Bezug auf (physikalische) Variablen"
                        ],
                        "tags": [
                            "Systemtheorie"
                        ],
                        "examples": [
                            {
                                "example_id": "840dc596-3a4f-428a-8288-b81af09adc0a",
                                "sense_id": "5be3945d-1e2f-3e21-90a7-9472c360b37f",
                                "text": "Für eine quasistatische Nachweisführung wird die Belastung als zeitinvariant angenommen."
                            },
                            {
                                "example_id": "1dec6b5b-c312-49da-8298-1716264af977",
                                "sense_id": "5be3945d-1e2f-3e21-90a7-9472c360b37f",
                                "text": "„Fast alle Übertrager, die in diesem Buch besprochen worden sind, verhalten sich nicht nur linear, sie sind überdies auch noch als zeitinvariant angenommen worden.“"
                            }
                        ],
