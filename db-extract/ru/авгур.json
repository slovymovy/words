                                    },
                                    {
                                        "sense_id": "98f940a7-74f1-3edf-b1a5-bf40f6b04831",
                                        "entry_id": "538ff34a-c6dc-357c-bc7c-ee85c1f8ffa8",
                                        "glosses": [
                                            "jemand, der als Eingeweihter künftige Entwicklungen vorhersagt"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94b43dd4-60aa-4248-a0c0-59e7d09e8f48",
                                                "sense_id": "98f940a7-74f1-3edf-b1a5-bf40f6b04831",
                                                "text": "„Und geht es nach den Auguren verheißt die demographische Entwicklung in den westlichen Industriestaaten auf lange Sicht für die Aktienmärkte nichts Gutes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61f73a0a-32e6-428e-bf5a-3c86c716329f",
                        "source_entry_id": "a8680bfb-825f-3eab-984b-7798ea32a053",
                        "target_lang_word": "augure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "augure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1e61343-17ab-37f8-bba3-3c6de2734bb9",
                                        "entry_id": "df523101-9027-3a71-9dba-0433a1b84d66",
                                        "glosses": [
                                            "Présage par lequel on juge de l’avenir. Chez les Romains, il se disait des signes que les augures tiraient de l’observation du vol des oiseaux. Aujourd’hui il se dit de tout ce qui peut faire deviner l’avenir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e78d842-3042-42bc-9f4b-be31245bf91f",
                                                "sense_id": "a1e61343-17ab-37f8-bba3-3c6de2734bb9",
                                                "text": "Et la raison encore, dis-moi, je te prie, Sganarelle, qui peut t’inspirer une peur d’un si mauvais augure ?"
                                            },
                                            {
                                                "example_id": "60de09b1-874f-4245-aaff-336f8343d5cd",
                                                "sense_id": "a1e61343-17ab-37f8-bba3-3c6de2734bb9",
                                                "text": "Les pas lourds des ouvriers qui passaient par escouades, le bruit des voitures de laitiers et de maraîchers frappèrent son oreille comme des sons de bon augure. Elle tressaillit à ce premier réveil de la ville."
                                            },
                                            {
                                                "example_id": "3071a278-257a-4170-b673-6537452d9cbe",
                                                "sense_id": "a1e61343-17ab-37f8-bba3-3c6de2734bb9",
                                                "text": "Cet événement est bon pour notre projet, J’en conçois un heureux augure."
                                            },
                                            {
                                                "example_id": "9a4f2667-c5c9-44ea-a145-4b14ecb0bdb5",
                                                "sense_id": "a1e61343-17ab-37f8-bba3-3c6de2734bb9",
                                                "text": "Vous présumez que mon entreprise réussira, j’en accepte l’augure."
                                            },
                                            {
                                                "example_id": "383e1ca7-17a9-4116-a65e-7d9020cd6081",
                                                "sense_id": "a1e61343-17ab-37f8-bba3-3c6de2734bb9",
                                                "text": "Depuis le bord de la route, une pancarte de mauvais augure est brandie à son adresse: «bon débarras»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db7e12bd-6604-35cd-bd82-e01d11c75552",
                                        "entry_id": "df523101-9027-3a71-9dba-0433a1b84d66",
                                        "glosses": [
                                            "Prêtre dont la charge était d’observer le vol des oiseaux et la manière dont mangeaient les poulets sacrés, afin d’en tirer des présages pour la conduite des affaires publiques."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "607586bb-2656-47bf-ba4e-823d56468715",
                                                "sense_id": "db7e12bd-6604-35cd-bd82-e01d11c75552",
                                                "text": "Quintus Aucler se sentit plein d’indignation ; il maudissait ce tribun ignorant qui ne l’avait pas consulté ; il lui aurait dit : « Quel égarement te porte à t’adresser au ciel sous ces habits et sans avoir préalablement accompli aucun des rites sacrés ? Il serait simple encore de cacher ton costume risible sous la robe des flamines ; mais as-tu seulement consulté les augures ? les victimes sont-elles préparées ? les poulets sacrés ont-ils mangé l’orge ? a-t-on, du moins, orienté avec le lituus la place où tu devais accomplir le sacrifice ? C’est ainsi qu’on s’adresse aux dieux, qui ne dédaignent pas alors de répondre avec leur tonnerre."
                                            },
                                            {
                                                "example_id": "0f0af09b-2603-4b01-849f-39edc679c878",
                                                "sense_id": "db7e12bd-6604-35cd-bd82-e01d11c75552",
                                                "text": "L’augure, consulté, mit en garde les consuls contre les risques de cette guerre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e92859d-9ee6-3fd5-b4c8-f07b6e686a58",
                                        "entry_id": "df523101-9027-3a71-9dba-0433a1b84d66",
                                        "glosses": [
                                            "Personne qui se prétend habile à prévoir l’avenir avec certitude."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0ea2b58-bd9a-487d-84ac-1f67d53c33d3",
                                                "sense_id": "6e92859d-9ee6-3fd5-b4c8-f07b6e686a58",
                                                "text": "Depuis avril, les augures donnent Joe Biden en tête, même dans des Etats réputés républicains tels que la Géorgie ou le Texas."
                                            },
                                            {
                                                "example_id": "9bf64566-bd18-4523-ab04-0b5012a3bc0a",
                                                "sense_id": "6e92859d-9ee6-3fd5-b4c8-f07b6e686a58",
                                                "text": "Prendre un ton d’augure pour prédire les dernières nouvelles de demain."
                                            }
                                        ]
                                    }
                                ]
                            },
