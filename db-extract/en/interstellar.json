                                        "sense_id": "7de49128-1348-37bc-9733-3a52c4c6fd66",
                                        "entry_id": "2719da99-1219-308d-b9a7-31db54063649",
                                        "glosses": [
                                            "Situés entre les étoiles, les astres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2031646-4133-4661-8e1f-4a5b2923b390",
                                                "sense_id": "7de49128-1348-37bc-9733-3a52c4c6fd66",
                                                "text": "les déplacements intersidéraux, non exceptionnels."
                                            },
                                            {
                                                "example_id": "fb81c7c3-fe58-4a09-abe1-0f1526249f5e",
                                                "sense_id": "7de49128-1348-37bc-9733-3a52c4c6fd66",
                                                "text": "C’est une certitude qui s’inscrit en lettres de feu dans mon silence intersidéral."
                                            },
                                            {
                                                "example_id": "639295e0-b55b-40f9-9237-303b91df290b",
                                                "sense_id": "7de49128-1348-37bc-9733-3a52c4c6fd66",
                                                "text": "Llouba était devenue sous ses pinceaux une princesse intersidérale, sur un cheval blanc à roulettes."
                                            },
                                            {
                                                "example_id": "6c341b48-1b9f-4825-ab4d-d712fddde8cf",
                                                "sense_id": "7de49128-1348-37bc-9733-3a52c4c6fd66",
                                                "text": "Les voyages intersidéraux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
