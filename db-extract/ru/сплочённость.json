                ],
                "translations": [
                    {
                        "translation_id": "31405a2e-3789-4031-bc4e-40e6371cf20e",
                        "source_entry_id": "a2f1f975-ad04-3776-8594-840539935efc",
                        "source_sense_id": "c245cf96-0327-39aa-ace2-0768fac47473",
                        "target_lang_word": "solidarity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solidarity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5dce214-a44c-31a8-84a8-4d5de148f671",
                                        "entry_id": "82abda23-02fd-32f4-bccd-19792749efa2",
                                        "glosses": [
                                            "A bond of unity or agreement between individuals, united around a common goal or against a common enemy, such as the unifying principle that defines the labor movement; mutual support within a group."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "352623e6-e4bf-497d-b6be-2229dd996889",
                                                "sense_id": "b5dce214-a44c-31a8-84a8-4d5de148f671",
                                                "text": "A long time union member himself, Phil showed solidarity with the picketing grocery store workers by shopping at a competing, unionized store."
                                            },
                                            {
                                                "example_id": "4ad5645b-a111-40e6-bad7-e3226ee29979",
                                                "sense_id": "b5dce214-a44c-31a8-84a8-4d5de148f671",
                                                "text": "As a matter of fact the Enlightment culture was based on a philosophy inspired to an ethical laicism whose aim was to create a better society based on principles such as solidarity, equality of rights and duties, and full freedom."
                                            },
                                            {
                                                "example_id": "91e693f9-def0-44f5-bed9-e8c04fa73c4f",
                                                "sense_id": "b5dce214-a44c-31a8-84a8-4d5de148f671",
                                                "text": "And this year, some of the granite facades have a new addition - the blue and yellow of the flag of Ukraine. It's hardly surprising to see the Scots, a nation more attuned to independence than some, showing solidarity with a country brutally invaded by Russia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea3610a1-ad4f-3c90-82b5-c2912872511c",
                                        "entry_id": "82abda23-02fd-32f4-bccd-19792749efa2",
                                        "glosses": [
                                            "Willingness to support another person in a difficult position or needs affection."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f74d469-7cea-41b6-ab8e-e04a260269d7",
                                                "sense_id": "ea3610a1-ad4f-3c90-82b5-c2912872511c",
                                                "text": "Only the solidarity provided by her siblings allowed Margaret to cope with her mother's harrowing death."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40d2ebf2-73be-4473-8942-fd84c797cf9c",
                        "source_entry_id": "a2f1f975-ad04-3776-8594-840539935efc",
                        "source_sense_id": "c245cf96-0327-39aa-ace2-0768fac47473",
                        "target_lang_word": "unity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c2fbf58-eab0-323a-9ce3-8cc06699ae0b",
                                        "entry_id": "6b296a8a-dfba-3968-8003-c949b57181a6",
                                        "glosses": [
                                            "Oneness; the state or fact of being one undivided entity."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b5879d2-7ace-4b69-bea0-90d5a09344cb",
                                                "sense_id": "1c2fbf58-eab0-323a-9ce3-8cc06699ae0b",
                                                "text": "If any literary work is too long to be read at one sitting, we must be content to dispense with the immensely important effect derivable from unity of impression - for, if two sittings be required, the affairs of the world interfere, and everything like totality is at once destroyed."
                                            },
                                            {
                                                "example_id": "a7c946c1-9bc7-45d9-865a-c950771c92c7",
                                                "sense_id": "1c2fbf58-eab0-323a-9ce3-8cc06699ae0b",
                                                "text": "Alan Pardew's current squad has been put together with a relatively low budget but the resolve and unity within the team is priceless."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94302911-a266-3702-8010-5e09117e4a64",
                                        "entry_id": "6b296a8a-dfba-3968-8003-c949b57181a6",
                                        "glosses": [
                                            "Agreement; harmony."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bdc7540f-951c-39d9-8e9b-bebe2e182408",
                                        "entry_id": "6b296a8a-dfba-3968-8003-c949b57181a6",
                                        "glosses": [
                                            "A single undivided thing, seen as complete in itself."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "349d8a56-98f6-4f93-bc71-94359cde3b8d",
                                                "sense_id": "bdc7540f-951c-39d9-8e9b-bebe2e182408",
                                                "text": "If a single day has brought us two or more experiences suitable to initiate a dream, the dream will unite references to them both into a single whole; it obeys a compulsion to form a unity [translating Einheit] out of them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9e8ab28-6b93-3ff1-be30-95d9b518f163",
                                        "entry_id": "6b296a8a-dfba-3968-8003-c949b57181a6",
                                        "glosses": [
                                            "Any of the three classical rules of drama: unity of action (nothing should be admitted not directly relevant to the development of the plot), unity of place (the scenes should be set in the same place), and unity of time (all the events should be such as might happen within a single day)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50382e1c-8b2c-3689-9478-33201c5ab34c",
                                        "entry_id": "6b296a8a-dfba-3968-8003-c949b57181a6",
                                        "glosses": [
                                            "The number 1 or any element of a set or field that behaves under a given operation as the number 1 behaves under multiplication."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7403fd41-0730-48b0-8511-86b6350a8377",
                                                "sense_id": "50382e1c-8b2c-3689-9478-33201c5ab34c",
                                                "text": "the cube roots of unity"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d25c62b2-cd97-398f-882a-9adb4aa7f2f0",
                                        "entry_id": "6b296a8a-dfba-3968-8003-c949b57181a6",
                                        "glosses": [
                                            "The peculiar characteristics of an estate held by several in joint tenancy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "62b6c19a-b972-3b51-8004-4992d2e42db7",
                                        "entry_id": "6b296a8a-dfba-3968-8003-c949b57181a6",
                                        "glosses": [
                                            "The form of consensus in a Quaker meeting for business which signals that a decision has been reached. In order to achieve unity, everyone who does not agree with the decision must explicitly stand aside, possibly being recorded in the minutes as doing so."
                                        ],
                                        "tags": [
                                            "Quakerism",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d84a8359-134c-4663-9f22-6ed2fcd8d406",
                        "source_entry_id": "a2f1f975-ad04-3776-8594-840539935efc",
                        "source_sense_id": "c245cf96-0327-39aa-ace2-0768fac47473",
                        "target_lang_word": "cohesion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cohesion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb49efa8-fea3-3dff-a59a-16f53760a04a",
                                        "entry_id": "59722014-7814-3864-8068-c9acce08a743",
                                        "glosses": [
                                            "State of cohering, or of working together."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "259a97b7-260e-4f20-a883-aecec30f8d16",
                                                "sense_id": "bb49efa8-fea3-3dff-a59a-16f53760a04a",
                                                "text": "Unit cohesion is important in the military."
                                            },
                                            {
                                                "example_id": "58847954-4fb0-4b2b-a0d2-5d6274ed64b6",
                                                "sense_id": "bb49efa8-fea3-3dff-a59a-16f53760a04a",
                                                "text": "For divers reasons, the capitalist class lacks this cohesion or solidarity, chief among which is the optimism bred of past success. And, again, the capitalist class is divided; it has within itself a class struggle of no mean proportions, which tends to irritate and harass it and to confuse the situation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c724036-2476-3d29-8270-760526b0b594",
                                        "entry_id": "59722014-7814-3864-8068-c9acce08a743",
                                        "glosses": [
                                            "Various intermolecular forces that hold solids and liquids together."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61bd1986-0529-3415-a7cb-c4fa8b726e96",
                                        "entry_id": "59722014-7814-3864-8068-c9acce08a743",
                                        "glosses": [
                                            "Growing together of normally distinct parts of a plant."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ecf54ad-aa02-3a32-af2b-2e3bbe6f6580",
                                        "entry_id": "59722014-7814-3864-8068-c9acce08a743",
                                        "glosses": [
                                            "Degree to which functionally related elements in a system belong together."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "156d2406-b150-4aa3-a82b-e967fc88caf7",
                                                "sense_id": "8ecf54ad-aa02-3a32-af2b-2e3bbe6f6580",
                                                "text": "In general, it is neither advisable nor possible to create such maximally cohesive classes; on the other hand, we would like cohesion to be high. When cohesion is high, it means that the methods and variables of the class are co-dependent and hang together as a logical whole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bdb4002-2d57-3889-8be6-e56d0271fd66",
                                        "entry_id": "59722014-7814-3864-8068-c9acce08a743",
                                        "glosses": [
                                            "Grammatical or lexical relationship between different parts of the same text."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
