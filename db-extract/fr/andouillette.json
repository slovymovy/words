                "senses": [
                    {
                        "sense_id": "f1f5ff18-32e5-3826-b9bc-07fb1fc1ea82",
                        "entry_id": "596691da-ad14-365f-ae11-c36362d23c66",
                        "glosses": [
                            "Genre de saucisse à base d’éléments du tube digestif du porc (généralement, gros intestin et estomac) ou du veau."
                        ],
                        "tags": [
                            "Charcuterie"
                        ],
                        "examples": [
                            {
                                "example_id": "1471b929-96dd-4f6b-a4ca-2a44a7205b42",
                                "sense_id": "f1f5ff18-32e5-3826-b9bc-07fb1fc1ea82",
                                "text": "[…] une tourbe de riboteurs qui venaient se repaître de galimafrées d’andouillettes et de tripes à la mode de Caen."
                            },
                            {
                                "example_id": "7244dfbd-6667-4120-8e3a-257be54b16a2",
                                "sense_id": "f1f5ff18-32e5-3826-b9bc-07fb1fc1ea82",
                                "text": "– Une andouillette grosse comme mon bras, voilà ce qu’il me faut. Elles sont toujours bouennes-bouennes-bouennes, les andouillettes, chez Gustave ?"
                            },
                            {
                                "example_id": "2815a5f4-d7f1-4fc3-a267-f859b40fc93c",
                                "sense_id": "f1f5ff18-32e5-3826-b9bc-07fb1fc1ea82",
                                "text": "À Cambrai, l’andouillette est également de tradition."
                            }
                        ]
                    }
                ],
