                        "examples": [
                            {
                                "example_id": "834ea56a-cf94-41a9-a621-ee8da58ba4d8",
                                "sense_id": "61e852eb-a2bf-36be-84b0-87830fecf2d1",
                                "text": "Onderzoek met rubidium is duurder dan gewoon hartonderzoek. Maar volgens nucleair geneeskundige Claessens is het onderzoek veel preciezer en zijn daardoor minder vervolgonderzoeken nodig. Op die manier zou er uiteindelijk toch geld mee worden bespaard."
                            },
                            {
                                "example_id": "af91f99d-915c-4d91-8748-4e3c497f9370",
                                "sense_id": "61e852eb-a2bf-36be-84b0-87830fecf2d1",
                                "text": "Groot-Brittanië is flink geschrokken toen zaterdagavond voetballer Fabrice Muamba zomaar omviel op het veld. Een hartaanval. En dat voor een schijnbaar gezonde jongen van nog geen 23 jaar. Er gaan stemmen op om preventief hartonderzoek te verplichten voor topsporters. In Italië gebeurt dat al 30 jaar."
                            }
                        ]
                    },
                    {
                        "sense_id": "af893945-238e-3e74-bf44-0b27637e88d3",
                        "entry_id": "55afd267-91e9-31fe-8810-9d15ddc7856b",
                        "glosses": [
                            "onderzoek van hartziekten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "298bd202-6e65-4851-b14d-7d32abf29a58",
                                "sense_id": "af893945-238e-3e74-bf44-0b27637e88d3",
                                "text": "De Isala Klinieken in Zwolle gaan een groot Europees hartonderzoek coördineren. Het doel is het verbeteren van revalidatieprojecten van oudere hartpatiënten."
                            }
