                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "method",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86c45ddb-757d-358d-99fb-71e6f00696db",
                                        "entry_id": "386b797a-5638-3f33-b9b9-b660d30ec7f6",
                                        "glosses": [
                                            "To apply a method to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51857677-3bbc-4ffb-96ba-e14545276cdf",
                                                "sense_id": "86c45ddb-757d-358d-99fb-71e6f00696db",
                                                "text": "1809, Rachel Russell (baroness.), Letters. To which is prefixed, an intr. vindicating the character of lord ...\n\"Says he, there is above ten thousand brisk boys are ready to follow me, whenever I hold up my finger : — Says I, how have you methoded this, that they shall not be crushed, for there will be a great force to oppose you?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "117ee248-d069-3c64-a737-58bb2498bf94",
                                        "entry_id": "386b797a-5638-3f33-b9b9-b660d30ec7f6",
                                        "glosses": [
                                            "To apply particular treatment methods to (a mold)."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c622cca8-e60c-4efd-983a-f4b4e1fc184a",
                                                "sense_id": "117ee248-d069-3c64-a737-58bb2498bf94",
                                                "text": "The company employs extensive use of 3D modelling combined with solidification simulation to ensure that critical castings are properly methoded."
                                            }
                                        ]
                                    }
                                ]
                            },
