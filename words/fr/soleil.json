    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bf8d4756-c657-3687-bf11-89635ea97c47",
                    "sense_definition": "Étoile centrale du système planétaire qui donne sa lumière et sa chaleur à la Terre.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "astre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>soleil</w> brille dans le ciel bleu sans le moindre nuage."
                        },
                        {
                            "text": "Nous nous levons très tôt pour admirer le lever du <w>soleil</w> sur la mer."
                        }
                    ],
                    "synonyms": [
                        "astre du jour"
                    ],
                    "common_phrases": [
                        "lever du soleil",
                        "coucher de soleil"
                    ]
                },
                {
                    "sense_id": "a317ea8e-34db-3d19-b2f8-9393fa2ebe7e",
                    "sense_definition": "Clarté, lumière ou chaleur rayonnée par cet astre.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "rayonnement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut mettre de la crème pour éviter un coup de <w>soleil</w> sur la plage."
                        },
                        {
                            "text": "Elle porte toujours des lunettes de <w>soleil</w> quand elle conduit en été."
                        }
                    ],
                    "synonyms": [
                        "cagnard"
                    ],
                    "common_phrases": [
                        "coup de soleil",
                        "lunettes de soleil",
                        "plein soleil"
                    ]
                },
                {
                    "sense_id": "64b4f904-f8cb-392b-96b6-c63340b0ff0e",
                    "sense_definition": "Étoile quelconque considérée au centre de son propre système planétaire.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "astre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les astronomes ont découvert une planète qui gravite autour de deux <w>soleils</w>."
                        },
                        {
                            "text": "Chaque galaxie contient des milliards d'étoiles semblables à notre <w>soleil</w>."
                        }
                    ]
                },
                {
                    "sense_id": "313a8fa2-8290-317a-a168-dda540b4194f",
                    "sense_definition": "Grande plante herbacée à haute tige et larges fleurs radiées jaunes, appelée aussi tournesol.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "botanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les magnifiques <w>soleils</w> de ce jardin tournent leur corolle vers la lumière."
                        },
                        {
                            "text": "Le peintre a représenté un grand vase rempli de <w>soleils</w> éclatants."
                        }
                    ],
                    "synonyms": [
                        "tournesol"
                    ]
                },
                {
                    "sense_id": "e143a148-4238-3c8c-95c4-586f448cf4b0",
                    "sense_definition": "Chute brutale et spectaculaire en passant par-dessus le guidon ou un obstacle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En percutant ce gros rocher, le cycliste a fait un <w>soleil</w> mémorable."
                        },
                        {
                            "text": "Il roulait trop vite et sa roue avant s'est bloquée, provoquant un violent <w>soleil</w>."
                        }
                    ],
                    "common_phrases": [
                        "faire un soleil"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "65b9fa6d-c4a2-3ce1-bb1f-f441e9ac2864",
                    "sense_definition": "Pièce d'orfèvrerie catholique rayonnée, servant à exposer l'hostie consacrée.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "liturgie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prêtre porte le précieux <w>soleil</w> d'or lors de la procession solennelle."
                        },
                        {
                            "text": "La chapelle conserve un ancien <w>soleil</w> incrusté de pierres fines et d'argent."
                        }
                    ],
                    "synonyms": [
                        "ostensoir"
                    ]
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "4fe58884-3ef8-38ec-bd5d-d60b46d56323",
                    "sense_definition": "L'étoile du système solaire en tant qu'entité astronomique désignée par son nom propre.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "astronomie",
                    "name_type": "astronomical_name",
                    "examples": [
                        {
                            "text": "La Terre met une année complète pour accomplir sa révolution autour du <w>Soleil</w>."
                        },
                        {
                            "text": "Une éclipse totale se produit lorsque la Lune passe exactement devant le <w>Soleil</w>."
                        }
                    ]
                },
                {
                    "sense_id": "d2398059-531e-3c25-986c-675794c948cc",
                    "sense_definition": "Divinité solaire ou personnification allégorique de l'astre du jour dans les mythes et les arts.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mythologie",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "Les prêtres incas rendaient chaque matin un culte fervent au dieu <w>Soleil</w>."
                        },
                        {
                            "text": "Dans la mythologie égyptienne, Rê incarne le <w>Soleil</w> traversant les cieux."
                        }
                    ]
                }
            ]
        }
    ]
}