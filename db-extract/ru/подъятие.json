                                        "entry_id": "e75ddf23-bf86-3e2b-83ec-702a41473394",
                                        "glosses": [
                                            "Planned or destined to advance to an academic grade in the near future, after having completed the previous grade; soon-to-be."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3641ca0-ca49-4b75-8875-c1ba4836907c",
                                                "sense_id": "5fbd4615-7197-3668-a853-144ffbcd7998",
                                                "text": "A student in the rising Senior Freshman Class, who may not have passed the preceding Michaelmas Examination, will be allowed to join the School and attend Lectures during Michaelmas Term, for which he will receive credit, on condition that he passes the ensuing Hilary Examination with the Senior Freshman Class."
                                            },
                                            {
                                                "example_id": "25f13392-3a0b-4df1-ac70-ef925e266d4e",
                                                "sense_id": "5fbd4615-7197-3668-a853-144ffbcd7998",
                                                "text": "Residential colleges at Princeton are “really central to your identity on campus,” especially as a freshman, Ms. Chaffers, who is a rising junior, said in an interview on Saturday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ce40eaf-4f52-3c1a-8233-cc56c758c4cd",
                                        "entry_id": "e75ddf23-bf86-3e2b-83ec-702a41473394",
                                        "glosses": [
                                            "Having its wings raised (either addorsed or sometimes displayed), standing on the tips of its feet as if about to take flight, typically depicted in profile."
