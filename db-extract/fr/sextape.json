                "senses": [
                    {
                        "sense_id": "9fae4288-05a1-39ea-93e7-853d50b793cf",
                        "entry_id": "882e22de-49af-378f-9043-4c3b26b943a3",
                        "glosses": [
                            "Vidéo érotique ou pornographique amateur destinée à un visionnage privé."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "40e153bb-f52b-4042-8d83-7ae89185d59d",
                                "sense_id": "9fae4288-05a1-39ea-93e7-853d50b793cf",
                                "text": "Une enseignante a malencontreusement diffusé à ses élèves une sextape d’elle-même avec son fiancé."
                            },
                            {
                                "example_id": "6dfff1a7-3e85-4492-b621-e0edef2773fd",
                                "sense_id": "9fae4288-05a1-39ea-93e7-853d50b793cf",
                                "text": "Une rumeur a même circulé à l’effet que, pour se faire embaucher, Shia LaBeouf aurait fait parvenir au réalisateur un sextape dans lequel on le voit en pleine action!"
                            },
                            {
                                "example_id": "d7d59eea-f3ef-4448-9efc-78734c7b7c46",
                                "sense_id": "9fae4288-05a1-39ea-93e7-853d50b793cf",
                                "text": "L’ex de Kim Kardashian, Ray J, accuse Kris Jenner d’avoir publié la sextape de sa fille."
                            },
                            {
                                "example_id": "144bbf5b-d7d2-4a92-9ee7-f998edc31703",
                                "sense_id": "9fae4288-05a1-39ea-93e7-853d50b793cf",
                                "text": "Ils passent la nuit ensemble à réviser des positions du Kama Sutra en se filmant avec une caméra de smartphone sur une perche à selfie. Sextape bouclée, chacun repart de son côté."
                            },
                            {
                                "example_id": "9af6b4ba-e2ab-421c-bc96-fc63f791e68e",
                                "sense_id": "9fae4288-05a1-39ea-93e7-853d50b793cf",
                                "text": "C’est quoi une « sextape » ? Même si le nom me semble assez révélateur, de mon temps on appelait ça une vidéo coquine ! Dieu que le langage est devenu prétentieux et grotesque !"
                            }
                        ]
                    }
