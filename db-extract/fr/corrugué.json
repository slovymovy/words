                                "example_id": "1ff5fbd9-f3b2-4b44-bf41-4e40ed9a73af",
                                "sense_id": "8fbadd96-a3ff-3d71-ae52-539eab5ab246",
                                "text": "Des cornets corrugués servent de guides d'ondes en télécommunication hyperfréquence."
                            },
