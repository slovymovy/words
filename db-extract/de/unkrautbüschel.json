                "senses": [
                    {
                        "sense_id": "22ec0c79-cffe-3d9f-8109-f8dc0c888502",
                        "entry_id": "950297ff-78a8-3941-a64e-c9970c7fedd1",
                        "glosses": [
                            "gebündelte oder miteinander verwachsene, relativ kleine Menge von Unkraut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b97422c5-0bee-49c9-ae9c-496724ec7294",
                                "sense_id": "22ec0c79-cffe-3d9f-8109-f8dc0c888502",
                                "text": "„Vielleicht wird sie unwiederbringlich in dem dünnflüssigen Matsch versinken - vielleicht wird sie aber auch in einem der größeren Unkrautbüschel landen und später in menschliche Hände gelangen.“"
                            },
                            {
                                "example_id": "56a12fbe-d8ac-4a79-ac1d-f72520875a2f",
                                "sense_id": "22ec0c79-cffe-3d9f-8109-f8dc0c888502",
                                "text": "„Zu beiden Seiten waren die Gebäude in der Häuserreihe abgebrochen, wegplaniert worden und hatten eine Wüstenei aus festgestampftem Ziegelstaub hinterlassen, die ein paar kühne oder tollkühne Unkrautbüschel zu besiedeln suchten.“"
                            },
                            {
                                "example_id": "622458b2-1021-41f7-82ac-95a1b02e5893",
                                "sense_id": "22ec0c79-cffe-3d9f-8109-f8dc0c888502",
                                "text": "„Nebem dem Fußweg, der zum Eingang führt, liegen grüne Unkrautbüschel, an deren Wurzeln ein paar Erdklumpen kleben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
