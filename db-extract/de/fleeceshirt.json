                "senses": [
                    {
                        "sense_id": "2fa15f57-1646-3e2f-b534-a520ddf558ef",
                        "entry_id": "0407cbaf-3cef-3fc2-ab37-c71f39cde4e8",
                        "glosses": [
                            "aus Fleece gefertigtes Oberteil"
                        ],
                        "tags": [
                            "Bekleidung"
                        ],
                        "examples": [
                            {
                                "example_id": "608cb01b-305a-4f2b-924e-ef346c561a39",
                                "sense_id": "2fa15f57-1646-3e2f-b534-a520ddf558ef",
                                "text": "„Ich würde die Jacke jeder Zeit [sic !] einem Fleeceshirt vorziehen.“"
                            },
                            {
                                "example_id": "defb0b95-f3eb-4261-bbd0-94a43dd825ff",
                                "sense_id": "2fa15f57-1646-3e2f-b534-a520ddf558ef",
                                "text": "„Immer häufiger werden Primaloftjacken unter einer Hardshelljacke als zweite Schicht getragen und verdrängen ein wenig das Fleeceshirt.“"
                            },
                            {
                                "example_id": "493133a5-207f-4205-bfd6-81525fdf1de1",
                                "sense_id": "2fa15f57-1646-3e2f-b534-a520ddf558ef",
                                "text": "„Das Fleeceshirt ist aus besonders weicher Mikrofleece Qualität [sic !] und eignet sich ideal als Zwischenlage.“"
                            },
                            {
                                "example_id": "cc0b43da-db93-4b59-8c84-0a481620de9c",
                                "sense_id": "2fa15f57-1646-3e2f-b534-a520ddf558ef",
                                "text": "„Die Probanden trugen während ihres normalen Alltags acht Stunden lang ein mit Samen gespicktes Fleeceshirt, Jeans und Baumwollsocken.“"
                            },
                            {
                                "example_id": "2ffe5058-4743-4a0f-823a-7b343780203a",
                                "sense_id": "2fa15f57-1646-3e2f-b534-a520ddf558ef",
                                "text": "„Du kannst das Fleeceshirt problemlos beim Skifahren und beim anschließenden Après-Ski tragen und auch bei Wandertouren ist es super aufgehoben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
