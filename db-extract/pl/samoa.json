                                            {
                                                "example_id": "8901bc19-8cba-4f7c-a639-2df2c71d7c42",
                                                "sense_id": "68a83a40-a7d5-3634-ad84-ce9c5c49c46c",
                                                "text": "Das Samoa der Kolonialzeit hat Theo sehr gemocht."
