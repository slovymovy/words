                "senses": [
                    {
                        "sense_id": "b49d3959-3daf-3ffd-a6e9-d724f97902b7",
                        "entry_id": "f54c35f7-f210-3b3b-8156-8adbfaa08039",
                        "glosses": [
                            "Anesthésier par l’action de la cocaïne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44d38930-625f-4803-9342-fd926c8124ed",
                                "sense_id": "b49d3959-3daf-3ffd-a6e9-d724f97902b7",
                                "text": "On commence par cocaïner la muqueuse nasale sur la plus grande étendue possible, et surtout au voisinage du corps étranger …."
                            },
                            {
                                "example_id": "9fefb141-15e9-41fc-8929-f8c90ac219ae",
                                "sense_id": "b49d3959-3daf-3ffd-a6e9-d724f97902b7",
                                "text": "Et si les infatigables étaient justement ces êtres qui ne ressentent rien ou n’analysent pas, qui glissent sans accrocher dans un monde qui leur est insignifiant, qui dirigent, qui couchent, qui cocaïnent dans la plus superficielle des anesthésies?"
                            }
                        ]
                    }
                ],
