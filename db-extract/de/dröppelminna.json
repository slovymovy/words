                ],
                "senses": [
                    {
                        "sense_id": "8eccd73a-5f08-3f64-a59d-11b224d17858",
                        "entry_id": "26df2c18-238f-301e-b5f0-09046fce7499",
                        "glosses": [
                            "Kaffeekanne mit zwei Henkeln, drei Füßen und einem Ausfluss/Ventil/Zapfhahn, meist aus Zinn- oder Messingblech"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41d55a9f-136d-43d3-af7b-6945b8d26e94",
                                "sense_id": "8eccd73a-5f08-3f64-a59d-11b224d17858",
                                "text": "Meine Großmutter hat mir diese schöne Dröppelminna vererbt."
                            },
                            {
                                "example_id": "c933b583-02fa-4910-b803-c39e899bc68c",
                                "sense_id": "8eccd73a-5f08-3f64-a59d-11b224d17858",
                                "text": "Wir benutzen unsere Dröppelminna zur sonntäglichen Kaffeetafel."
                            },
                            {
                                "example_id": "3c932cd8-3e06-4757-9455-b40a7815774c",
                                "sense_id": "8eccd73a-5f08-3f64-a59d-11b224d17858",
                                "text": "Bei unserer Dröppelminna verstopft manchmal das Ventil, dann müssen wir sie reinigen."
                            },
                            {
                                "example_id": "5510c990-d055-40c0-8b9e-28ab542b32ba",
                                "sense_id": "8eccd73a-5f08-3f64-a59d-11b224d17858",
                                "text": "„Die dreibeinige, große Dröppelminna ist rundbäuchig. Rechts und links wurde jeweils ein Griff angelötet.“"
                            },
                            {
                                "example_id": "894624e2-c0d0-41c2-86cd-724230b94163",
                                "sense_id": "8eccd73a-5f08-3f64-a59d-11b224d17858",
                                "text": "„Der Tisch war gedeckt mit feinstem Porzellan und in der Mitte stand eine große Kaffeekanne aus glänzendem Zinn: die Dröppelminna.“"
                            },
                            {
                                "example_id": "ddba5eb0-4f43-4aaa-b2aa-fbcfa841acdd",
                                "sense_id": "8eccd73a-5f08-3f64-a59d-11b224d17858",
                                "text": "„Als vor ein paar Tagen eine wort- und gestenreiche Auseinandersetzung der Müllers darin mündete, dass sie ihm wutentbrannt die zinnerne Dröppelminna vor die Füße schmetterte, hätte mir klar sein können, dass es nun aus ist mit den Gemeinsamkeiten nebenan.“"
                            },
                            {
                                "example_id": "3638cbf7-61a3-4fc6-8491-9e97402a7d6c",
                                "sense_id": "8eccd73a-5f08-3f64-a59d-11b224d17858",
                                "text": "„Den Namen Dröppelminna hat diese originelle Haushaltsutensilie der Tatsache zu verdanken, dass das Zapfhähnchen aufgrund seiner einfachen Konstruktion leicht verstopft und infolgedessen zum Tropfen (Dröppeln) neigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
