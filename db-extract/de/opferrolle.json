                "senses": [
                    {
                        "sense_id": "2e363890-d342-359a-be55-4cc0b92ad00e",
                        "entry_id": "ac156349-8dd7-3247-a858-244f6c093900",
                        "glosses": [
                            "negative, pessimistische Einstellung/Haltung einer Person, die einen Schaden erlitten hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c87763a-585e-4f73-a782-ad8e7e889122",
                                "sense_id": "2e363890-d342-359a-be55-4cc0b92ad00e",
                                "text": "Um seine Resilienz zu stärken, muss man die Opferrolle verlassen."
                            },
                            {
                                "example_id": "a5ee1b8b-28c2-4f44-bc0e-6cd42db4c54f",
                                "sense_id": "2e363890-d342-359a-be55-4cc0b92ad00e",
                                "text": "„Jedes Mal, wenn wir jammern, klagen und uns in die Opferrolle begeben, räumen wir anderen Menschen Macht ein.“"
                            },
                            {
                                "example_id": "3373ad62-9e0b-4a80-972b-363956cb7421",
                                "sense_id": "2e363890-d342-359a-be55-4cc0b92ad00e",
                                "text": "„Du fühlst dich schwach oder machtlos in einer Situation und übernimmst deswegen die Opferrolle.“"
                            },
                            {
                                "example_id": "67c5d386-d940-4467-9dfe-a0e131b00068",
                                "sense_id": "2e363890-d342-359a-be55-4cc0b92ad00e",
                                "text": "„Man kann die Opferrolle auch mit einem beschränkenden Glaubenssatz vergleichen, der uns davon abhält, wieder ganz zu werden und zu heilen.“"
                            },
                            {
                                "example_id": "2f8e2d77-1467-413f-b1b0-c6597edc56de",
                                "sense_id": "2e363890-d342-359a-be55-4cc0b92ad00e",
                                "text": "„Man drückt sich selbst in eine Opferrolle, auch wenn einem das nicht bewusst ist.“"
                            },
                            {
                                "example_id": "306d4d7c-b42f-4aeb-84e6-00d0a48f730d",
                                "sense_id": "2e363890-d342-359a-be55-4cc0b92ad00e",
                                "text": "„Durch Selbsterkenntnis aus der Opferrolle rauskommen und nicht ins Selbstmitleid verfallen – das ist manchmal gar nicht so einfach, denn auch alte Gewohnheiten müssen aufgegeben werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
