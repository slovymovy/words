                            {
                                "example_id": "a4e5afeb-9b81-4850-9086-f8c9af4e0db1",
                                "sense_id": "62b47c4d-1979-3952-8228-2b76850e0bed",
                                "text": "`En hij heeft echt geen briefje achtergelaten? Ik hoef niet te weten wat erin staat, maar het zou me goeddoen als ik wist dat er een was."
                            }
                        ]
