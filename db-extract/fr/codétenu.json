                        "form": "codétenue"
                    },
                    {
                        "form_id": "870f9eb5-be26-4730-bba6-94bcec28c0b9",
                        "entry_id": "a3671c2d-5344-332b-a213-5dc94eb901bd",
                        "tags": [],
                        "form": "co-détenu"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bafffa5a-fe80-3b7e-9981-7eeeaaac956c",
                        "entry_id": "a3671c2d-5344-332b-a213-5dc94eb901bd",
                        "glosses": [
                            "Celui qui subit avec d’autres une peine d’emprisonnement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c913053-7ce5-4348-b246-c87635629309",
                                "sense_id": "bafffa5a-fe80-3b7e-9981-7eeeaaac956c",
                                "text": "S'ils veulent communiquer avec leurs codétenus, ils doivent les libérer des figures dans lesquelles ils les ont enfermés. Parce qu'ils doivent vivre et entrer personnellement en relation avec leurs codétenus, ils ont aussi besoin de croire en la possibilité d'une singularité."
                            },
                            {
                                "example_id": "18590120-894b-4aad-a45b-66c9954d7cd1",
                                "sense_id": "bafffa5a-fe80-3b7e-9981-7eeeaaac956c",
                                "text": "Cet événement extrêmement grave n’a trouvé que pour seul réponse un examen sommaire par un psychiatre avant d’être placé dans une cellule avec un codétenu lui-même atteint de troubles psychiatriques très graves."
                            },
                            {
                                "example_id": "5f1a0131-7cfc-4326-ad4c-05b00425732b",
                                "sense_id": "bafffa5a-fe80-3b7e-9981-7eeeaaac956c",
                                "text": "Il gueule du matin au soir et, quand il a commencé à tout casser dans sa cellule sous les regards horrifiés de ses deux codétenus qui voyaient déjà leur tour arriver, il a été placé à l’isolement."
                            },
                            {
                                "example_id": "5b581e26-7eb3-45e8-bb1e-2db6c938e6aa",
                                "sense_id": "bafffa5a-fe80-3b7e-9981-7eeeaaac956c",
                                "text": "... il y avait certains de nos codétenus qui étaient eux aussi de belles enflures de première classe, et c’était un peu la loi de la jungle, là-dedans..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61a1440d-bd23-4621-99d4-01486be44365",
                        "source_entry_id": "a3671c2d-5344-332b-a213-5dc94eb901bd",
                        "source_sense_id": "bafffa5a-fe80-3b7e-9981-7eeeaaac956c",
                        "target_lang_word": "Mitgefangener",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mitgefangener",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7826641-3ebf-3d15-b368-e765a2ec7cdc",
                                        "entry_id": "f87e5ed9-9291-3c70-8580-d2ea30f50519",
                                        "glosses": [
                                            "jemand, der zusammen mit anderen gefangen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3689e97-9972-4dc8-9298-239019290e94",
                                                "sense_id": "d7826641-3ebf-3d15-b368-e765a2ec7cdc",
                                                "text": "„Nguyen und seine Mitgefangenen werden unmittelbar damit beauftragt, das Gefangenenlager aufzubauen und den Wald zu roden, um Nahrungsmittel anbauen zu können.“"
                                            },
                                            {
                                                "example_id": "6f374949-ff0d-4c1a-a6b4-f0924c56ab47",
                                                "sense_id": "d7826641-3ebf-3d15-b368-e765a2ec7cdc",
                                                "text": "„Böttger hat sich wie alle Mitgefangenen einen Bart wachsen lassen.“"
                                            },
                                            {
                                                "example_id": "091638e6-3f39-460e-86bc-2667027650a5",
                                                "sense_id": "d7826641-3ebf-3d15-b368-e765a2ec7cdc",
                                                "text": "„Seine Mitgefangenen waren ein Dieb, ein kleiner Defraudant und ein russischer Professor aus Kasan, der als Landstreicher eingesperrt worden war.“"
                                            },
                                            {
                                                "example_id": "98ffa139-e637-4b57-8e5f-a068fc733743",
                                                "sense_id": "d7826641-3ebf-3d15-b368-e765a2ec7cdc",
                                                "text": "„Als seine Mitgefangenen von Mugabes bevorstehender Ankunft erfuhren, bauten sie ihm auf dem Lagergelände ein Haus in der Nähe der Wohnung seines Mentors Takawira.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
