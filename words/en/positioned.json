    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0fe9c1cc-0a55-3860-8ee4-c51ed09ded4c",
                    "sense_definition": "Simple past and past participle of <w>position</w>.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She carefully <w>positioned</w> the vase in the center of the table.",
                            "target_lang_translations": {
                                "ru": "Она аккуратно <w>поставила</w> вазу в центр стола.",
                                "zh": "她小心地把花瓶<w>放置</w>在桌子中央。"
                            }
                        },
                        {
                            "text": "The guards were <w>positioned</w> at every entrance to the building.",
                            "target_lang_translations": {
                                "ru": "Охранники были <w>размещены</w> у каждого входа в здание.",
                                "zh": "警卫被<w>部署</w>在大楼的每一个入口处。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола position (размещать, располагать).",
                        "zh": "动词 position 的过去式和过去分词，意为放置、安置或部署。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размещать",
                                "target_lang_sense_clarification": "класть или ставить в определенное место"
                            },
                            {
                                "target_lang_word": "располагать",
                                "target_lang_sense_clarification": "размещать определенным образом"
                            },
                            {
                                "target_lang_word": "ставить",
                                "target_lang_sense_clarification": "помещать в вертикальном положении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "放置",
                                "target_lang_sense_clarification": "将某物安放在特定位置"
                            },
                            {
                                "target_lang_word": "安置",
                                "target_lang_sense_clarification": "使人或物处于适当的位置"
                            },
                            {
                                "target_lang_word": "部署",
                                "target_lang_sense_clarification": "安排人员或力量处于特定位置"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b8536788-93da-37e9-a059-d56c1a1c4c5e",
                    "sense_definition": "Placed or situated in a specific location or situation, often implying readiness or suitability for a purpose.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is well <w>positioned</w> to succeed in the global market.",
                            "target_lang_translations": {
                                "ru": "Компания занимает выгодное <w>положение</w>, чтобы преуспеть на мировом рынке.",
                                "zh": "该公司在国际市场上<w>处于有利地位</w>，有望取得成功。"
                            }
                        },
                        {
                            "text": "We are strategically <w>positioned</w> to handle any sudden changes in demand.",
                            "target_lang_translations": {
                                "ru": "Мы занимаем стратегические <w>позиции</w>, чтобы справиться с любыми внезапными изменениями спроса.",
                                "zh": "我们在战略上<w>处于</w>有利<w>位置</w>，足以应对需求方面的任何突发变化。"
                            }
                        }
                    ],
                    "synonyms": [
                        "situated",
                        "placed",
                        "poised",
                        "located"
                    ],
                    "common_phrases": [
                        "well positioned",
                        "strategically positioned",
                        "uniquely positioned",
                        "better positioned"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в определенном месте или ситуации; часто подразумевает готовность или пригодность для какой-либо цели.",
                        "zh": "形容词，指处于特定的位置或状态，通常暗示为某种目的做好了准备或具备优势。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расположенный",
                                "target_lang_sense_clarification": "находящийся в определенном месте"
                            },
                            {
                                "target_lang_word": "занимающий положение",
                                "target_lang_sense_clarification": "находящийся в определенной ситуации (часто выгодной)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "处于……位置",
                                "target_lang_sense_clarification": "指处于某种特定的状态或地理位置"
                            },
                            {
                                "target_lang_word": "具备……优势",
                                "target_lang_sense_clarification": "指在竞争或形势中处于有利地位"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}