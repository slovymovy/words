                        "examples": [
                            {
                                "example_id": "a8d2c2c1-5bde-4dee-a2bf-d34831e25cff",
                                "sense_id": "f26c99e5-75d9-3479-a30b-ff40ef317d37",
                                "text": "Statt den Gesprächen seiner Kollegen lauschte der New Yorker Taxifahrer ägyptischer Herkunft dem Stargeiger Philippe Quint."
                            },
                            {
                                "example_id": "0222edda-7d6d-496b-9782-6e3b70e47301",
                                "sense_id": "f26c99e5-75d9-3479-a30b-ff40ef317d37",
                                "text": "Denn Mohammed Khalil hatte Quint eine teure Stradivari zurückgebracht, die er in seinem Taxi vergessen hatte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
