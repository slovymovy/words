                                "sense_id": "1865152f-d4b5-3cc2-9990-766e6d73ce3a",
                                "text": "The jello was gone in five minutes and the cigarette smoked."
                            },
                            {
                                "example_id": "e0320b83-9af8-445d-a59b-f46364f3d9fe",
                                "sense_id": "1865152f-d4b5-3cc2-9990-766e6d73ce3a",
                                "text": "Distribution of cherry jello was stepped up to college campus towns across America."
                            },
                            {
                                "example_id": "e8d78aad-bd68-4f8f-875e-b7f7afee8ed0",
                                "sense_id": "1865152f-d4b5-3cc2-9990-766e6d73ce3a",
                                "text": "She didn't want to eat anything heavy and decided that jello had zero fat content."
