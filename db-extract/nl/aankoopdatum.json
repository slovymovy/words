                            {
                                "example_id": "398a44d5-d14f-4888-a309-91249404e9da",
                                "sense_id": "c7280bfa-7214-3e52-a710-83f0c0be2e52",
                                "text": "De krant The Sun heeft een afbeelding van het verwassen briefje in handen gekregen. Daarop waren de winnende cijfers nog wel te zien (26, 27, 46, 47, 52, 58), maar de aankoopdatum niet meer."
                            },
                            {
                                "example_id": "bfe97b4e-2934-4915-95fc-692194b7d29f",
                                "sense_id": "c7280bfa-7214-3e52-a710-83f0c0be2e52",
                                "text": "Met unaniem aangenomen moties hebben de Provinciale Staten gisteren bepaald dat de aankoopdatum van de woning niet meer bepalend is om voor de regeling in aanmerking te komen. Ook schade die mogelijk voor 2011 is veroorzaakt, kan worden vergoed."
                            }
                        ]
