                        "glosses": [
                            "Fait de s’opposer au bruit, de rechercher le silence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98cdde76-20b3-4778-b7f5-61e905b8b497",
                                "sense_id": "1d89dfd7-756d-3227-b207-2ff549b65bc0",
                                "text": "Le silence de la nuit s’empara des trois. Ils furent enfermés en eux-mêmes. Ce que l’on appelle le silencisme."
                            }
                        ]
                    },
                    {
                        "sense_id": "9785e750-7e5b-3832-aaf5-5c36c9ca91a7",
                        "entry_id": "919d905f-3aed-3f43-b374-2eebfe925a95",
                        "glosses": [
                            "Mouvement qui privilégie le silence aux sons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bceb719-4182-4b67-bfab-5bcd5787d9c5",
                                "sense_id": "9785e750-7e5b-3832-aaf5-5c36c9ca91a7",
                                "text": "Soudain, il pétarada :\n— Jarnicoton ! Puisqu’on a lyrisé tous les bruits de la nature, depuis le murmure de l’ouragan jusqu’au beuglement du cricri, je vais mettre, moi, ses silences en musique. Le « silencisme », voilà la musique de l’avenir !"
                            }
                        ]
                    }
