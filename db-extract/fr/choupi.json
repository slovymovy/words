                    {
                        "sense_id": "cc3a45ef-52e9-324b-9f42-19d27a1ce088",
                        "entry_id": "c2245e13-5d29-3fec-8055-95443af53c2e",
                        "glosses": [
                            "Mignon, adorable."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "a3d9ea9f-d5c6-4efd-8834-537b69054225",
                                "sense_id": "cc3a45ef-52e9-324b-9f42-19d27a1ce088",
                                "text": "Disons-le, Railbound ne brille pas par son scénario, mais par son univers choupi qui donne envie de poser des (vrais) rails toute la journée pour résoudre ses puzzles ferroviaires si malins."
                            },
                            {
                                "example_id": "8b87f9ad-5885-424d-bfd5-f90a0aec3771",
                                "sense_id": "cc3a45ef-52e9-324b-9f42-19d27a1ce088",
                                "text": "Dans les commentaires, les fans sont donc unanimes face à cet adorable petit garçon. « Il est trop mignon, j’adore ! » commente un fan. « Il est trop choupi dans son costume. » ajoute un autre."
                            }
                        ]
                    }
