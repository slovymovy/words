                "senses": [
                    {
                        "sense_id": "6a44f5b7-dcc6-3999-8ccc-275bf80f95b0",
                        "entry_id": "da71b3d0-70fb-3c9b-823e-3c468e384f08",
                        "glosses": [
                            "Donner un caractère basané à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18cc8a37-a49e-4b25-9c7f-86b8e2d823d7",
                                "sense_id": "6a44f5b7-dcc6-3999-8ccc-275bf80f95b0",
                                "text": "Banacek va être content mais bon, il te dira: ils se sont basanisés avec le temps"
                            },
                            {
                                "example_id": "cc46c446-81b4-46bc-bd7e-910ce63e36b1",
                                "sense_id": "6a44f5b7-dcc6-3999-8ccc-275bf80f95b0",
                                "text": "En voyant arriver Bar-Jehoudda, les deux mille transfuges bathanéens au service d’Antipas ne s’y trompent pas : c’est l’envoyé de Dieu qui vient pour les examiner, les « basaniser », les passer à la pierre de touche avant le terme imminent du Verseau."
                            }
                        ]
                    }
