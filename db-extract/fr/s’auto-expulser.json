                        "glosses": [
                            "S’expulser soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a93123af-9721-4088-aacb-6fa165fe4fee",
                                "sense_id": "f4df56c3-d99e-3004-a6d1-84701d35504d",
                                "text": "Ces mêmes personnes qui voulaient bouter hors de France les étrangers se rendaient compte que par leur manque de réflexion et leur bêtise, étaient en train de s’auto-expulser et d’exclure leur famille."
                            },
                            {
                                "example_id": "64bc7221-6c4c-417d-9d0f-59004c3796a0",
                                "sense_id": "f4df56c3-d99e-3004-a6d1-84701d35504d",
                                "text": "Se considérant fautif, Martín décide de s’auto-expulser pour que le match, avec les deux équipes à dix, demeure équilibré."
                            },
                            {
                                "example_id": "542a91a0-7256-40e6-a1d4-f47b8133ca99",
                                "sense_id": "f4df56c3-d99e-3004-a6d1-84701d35504d",
                                "text": "C’est ce qui apparaît au niveau des pictogrammes qui englobent un moi/bouche/mère/bébé régurgité et régurgiteur, expulsé coincé dans la toux, autant de pictogrammes qui renvoient à un enfant bouche qui s’autovomit, s’autotousse, s’auto-expulse, s’autodétruit."
                            }
                        ]
                    }
