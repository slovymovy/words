                "senses": [
                    {
                        "sense_id": "b41868e3-f092-3d65-938f-201a0313919e",
                        "entry_id": "ae8072e2-88c6-3da7-ac63-2ad921f0ba6f",
                        "glosses": [
                            "germanische Volks- und Gerichtsversammlung"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "adf0ea97-122e-4ccb-8923-981f89b09f1b",
                                "sense_id": "b41868e3-f092-3d65-938f-201a0313919e",
                                "text": "„Alle freien Männer - Bauern, Handwerker, Kaufleute - dürfen an den Volksversammlungen teilnehmen, den Thingen, auf denen etwa über Verbrecher geurteilt wird.“"
                            },
                            {
                                "example_id": "d93ce941-3eae-4308-8b76-e181ffc77128",
                                "sense_id": "b41868e3-f092-3d65-938f-201a0313919e",
                                "text": "„Um die fragile Eintracht in ihrer Heimat zu wahren, haben die Siedler die Thinge geschaffen.“"
                            },
                            {
                                "example_id": "376c0cd4-73c2-4f80-9eb1-c47f0cd2d0b4",
                                "sense_id": "b41868e3-f092-3d65-938f-201a0313919e",
                                "text": "„Sie wurde während des Things und bei Hinrichtungen geläutet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1afdc6fc-50ff-4559-9223-d28bd20676b1",
                        "source_entry_id": "ae8072e2-88c6-3da7-ac63-2ad921f0ba6f",
                        "source_sense_id": "b41868e3-f092-3d65-938f-201a0313919e",
                        "source_sense_description": "historisch: germanische Volks- und Gerichtsversammlung",
                        "target_lang_word": "ding",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ding",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "fbc9b788-96b9-333d-8306-495ae1b00fe7",
                                        "entry_id": "cf1d8b54-efcd-3061-9d9c-6985123f6691",
                                        "glosses": [
                                            "voorwerp dat geen dier of mens is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d701b4de-ba64-4121-9fee-72ec875a4200",
                                                "sense_id": "fbc9b788-96b9-333d-8306-495ae1b00fe7",
                                                "text": "Hij behandelde zijn vrouw altijd als een ding, het verbaasde dan ook niemand toen zij van hem wegliep."
                                            },
                                            {
                                                "example_id": "4bf54105-3c48-4eef-8863-52520ab22cd4",
                                                "sense_id": "fbc9b788-96b9-333d-8306-495ae1b00fe7",
                                                "text": "Ik voelde me wel een beetje bekeken met die dingen in mijn handen, ook al was er niemand om het te zien."
                                            },
                                            {
                                                "example_id": "67549509-2b49-4a72-ac99-f52eafdd8b16",
                                                "sense_id": "fbc9b788-96b9-333d-8306-495ae1b00fe7",
                                                "text": "\"Op mijn leeftijd telt nog maar één ding: peace of mind\", zei Buikhuisen over de verzoening. \"Carel Stolker heeft mij die peace of mind gegeven.\" Stolker zelf zei te hopen dat de universiteit en de faculteit in de toekomst bij controversieel onderzoek de rug recht houden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "156ac2d8-16a0-32de-892c-b443b7c7b094",
                                        "entry_id": "cf1d8b54-efcd-3061-9d9c-6985123f6691",
                                        "glosses": [
                                            "persoon, slechts gezien als iemand die lichamelijk aantrekkelijk is"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc75d1c5-c472-48a0-af69-07174aba193b",
                                                "sense_id": "156ac2d8-16a0-32de-892c-b443b7c7b094",
                                                "text": "De oude rijke man trouwde voor de zoveelste keer een nieuw jong ding."
                                            },
                                            {
                                                "example_id": "aebf192b-39b6-4638-a0da-4b7ac8bdd84a",
                                                "sense_id": "156ac2d8-16a0-32de-892c-b443b7c7b094",
                                                "text": "Ik vind jouw broer een lekker ding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58cf1007-5a30-36d6-86f3-1b3a11a608f7",
                                        "entry_id": "cf1d8b54-efcd-3061-9d9c-6985123f6691",
                                        "glosses": [
                                            "mannelijk geslachtsdeel"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c504aa25-a9ba-31df-b818-4f03cf80f63c",
                                        "entry_id": "cf1d8b54-efcd-3061-9d9c-6985123f6691",
                                        "glosses": [
                                            "driedaagse volksvergadering die recht kon spreken en dus als rechtszitting fungeerde in de Oudgermaanse tijd"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5ac19d4-d820-3b89-9ce6-4607012a4fd8",
                                        "entry_id": "cf1d8b54-efcd-3061-9d9c-6985123f6691",
                                        "glosses": [
                                            "gebeurtenis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1377169b-d93a-4c46-b905-51582be267c9",
                                                "sense_id": "a5ac19d4-d820-3b89-9ce6-4607012a4fd8",
                                                "text": "De oude vrouw dacht vaak aan dingen van vroeger."
                                            }
                                        ]
                                    }
                                ]
                            },
