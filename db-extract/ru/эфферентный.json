                ],
                "senses": [
                    {
                        "sense_id": "963e1a85-220d-35aa-820e-f84461edef85",
                        "entry_id": "23f7ef5c-8112-364d-a4d6-1a8bd9a46abd",
                        "glosses": [
                            "физиол. выносящий, выводящий, передающий импульсы от нервных центров к рабочим органам"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6c72db6-01e7-4c26-ad6f-5c1eed194a16",
                                "sense_id": "963e1a85-220d-35aa-820e-f84461edef85",
                                "text": "Вторую группу составляют нейроны, передающие возбуждение от центральных отделов нервной системы к рабочим органам; они называются двигательными, или эфферентными, нейронами."
                            },
                            {
                                "example_id": "1e02dc32-3a2c-42d1-b052-4bfb62d92d30",
                                "sense_id": "963e1a85-220d-35aa-820e-f84461edef85",
                                "text": "Преобладание рецепторов над эффекторами находит себе морфологическое выражение в том гистологическом факте, что сенсорные элементы, афферентные нейроны количественно преобладают над эфферентными ещё в спинном мозгу животных, и по мере восхождения к высшим этажам нервной системы это преобладание становится всё более значительным."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82675858-6a99-44e5-8a3f-dcb0265df2b9",
                        "source_entry_id": "23f7ef5c-8112-364d-a4d6-1a8bd9a46abd",
                        "source_sense_id": "963e1a85-220d-35aa-820e-f84461edef85",
                        "target_lang_word": "efferent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "efferent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ccedd3b5-b46b-36f8-b360-d1165f66777e",
                                        "entry_id": "752572ae-87de-3686-90ac-47469b818464",
                                        "glosses": [
                                            "Carrying away from."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c624271-3b47-43de-8fdf-4fd8b4abe0b4",
                                                "sense_id": "ccedd3b5-b46b-36f8-b360-d1165f66777e",
                                                "text": "An efferent nerve carries impulses from the brain to the body."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5507fd67-2b8a-37bf-a103-dac5623c22f7",
                                        "entry_id": "752572ae-87de-3686-90ac-47469b818464",
                                        "glosses": [
                                            "Carried outward."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a771b5b-45f6-4647-bb5a-424fcabd7ef6",
                                                "sense_id": "5507fd67-2b8a-37bf-a103-dac5623c22f7",
                                                "text": "Efferent impulses are those conveyed by the motor or efferent nerves from the central nervous organ outwards."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "efferent",
                                "target_lang_code": "en",
