                ],
                "senses": [
                    {
                        "sense_id": "c2315f9c-8cf9-3dfe-8554-ca90a026c1b9",
                        "entry_id": "3046c251-09a5-3abb-851f-99e2ee686960",
                        "glosses": [
                            "Ruta, rodzaj roślin o żółtych kwiatach i charakterystycznych liściach, znalazła zastosowanie w medycynie, uprawiana także jako roślina ozdobna"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d06c0d97-48be-49e0-99c6-bd0b7d982a09",
                                "sense_id": "c2315f9c-8cf9-3dfe-8554-ca90a026c1b9",
                                "text": "Własności lecznicze ruty znane były już w starożytności, używano jej wówczas jako środka rozkurczowego i moczopędnego."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9445977a-209b-4c17-9ed0-fc69f06e8d5b",
                        "source_entry_id": "3046c251-09a5-3abb-851f-99e2ee686960",
                        "source_sense_id": "c2315f9c-8cf9-3dfe-8554-ca90a026c1b9",
                        "target_lang_word": "rue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fdf2814f-083e-3187-b41a-7d88bf4d8c68",
                                        "entry_id": "71be162a-b217-32ec-a5af-752fbc120e73",
                                        "glosses": [
                                            "Sorrow; repentance; regret."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "dialectal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "228052ba-30ad-450c-ad43-5374741fc670",
                                                "sense_id": "fdf2814f-083e-3187-b41a-7d88bf4d8c68",
                                                "text": "When I was one-and-twenty I heard him say again,\n \"The heart out of the bosom was never given in vain;\n 'Tis paid with sighs aplenty and sold for endless rue.\"\n And I am two-and-twenty, and oh, 'tis true, 'tis true."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2800acb-1f3c-3bf6-8cdb-b4f9de584b52",
                                        "entry_id": "71be162a-b217-32ec-a5af-752fbc120e73",
                                        "glosses": [
                                            "Pity; compassion."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "dialectal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d5aa73c-f71f-3b5b-a6a9-a7e43134dac6",
                                        "entry_id": "5d46686f-f5ab-3dc9-9551-ac088daa78a2",
                                        "glosses": [
                                            "To repent of or regret (some past action or event); to wish that a past action or event had not taken place."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ce15ab2-e01c-46d7-95a8-aa706fe3f28f",
                                                "sense_id": "6d5aa73c-f71f-3b5b-a6a9-a7e43134dac6",
                                                "text": "to rue the day"
                                            },
                                            {
                                                "example_id": "675bb95a-c459-476b-b111-79936be59552",
                                                "sense_id": "6d5aa73c-f71f-3b5b-a6a9-a7e43134dac6",
                                                "text": "I rued the day I crossed paths with her."
                                            },
                                            {
                                                "example_id": "d579f1ec-75b9-4d7f-82dd-f3a4e193b0f5",
                                                "sense_id": "6d5aa73c-f71f-3b5b-a6a9-a7e43134dac6",
                                                "text": "I wept to see, and rued it from my heart."
                                            },
                                            {
                                                "example_id": "6903cbb1-8b1e-47ed-9bce-57d29479d0eb",
                                                "sense_id": "6d5aa73c-f71f-3b5b-a6a9-a7e43134dac6",
                                                "text": "Thy will chose freely what it now so justly rues."
                                            },
                                            {
                                                "example_id": "59f77953-0282-4a62-88f4-2070e0d3e86f",
                                                "sense_id": "6d5aa73c-f71f-3b5b-a6a9-a7e43134dac6",
                                                "text": "And feminization of the homeland is something to be rued, while the feminized humiliation of the enemy for the sake of the fatherland is cause for commendation and celebration."
                                            },
                                            {
                                                "example_id": "9ebf36f8-aa8b-490f-90ce-ef152f3bd541",
                                                "sense_id": "6d5aa73c-f71f-3b5b-a6a9-a7e43134dac6",
                                                "text": "And was the fact she was no longer losing large chunks of time something to be celebrated or something to be rued?"
                                            },
                                            {
                                                "example_id": "18693914-acea-439c-9b57-a0bd8678b829",
                                                "sense_id": "6d5aa73c-f71f-3b5b-a6a9-a7e43134dac6",
                                                "text": "“If we get in a fight, you'll be ruing your lack of training.”"
                                            },
                                            {
                                                "example_id": "10438835-98f1-4205-acdf-6b162d2d02a3",
                                                "sense_id": "6d5aa73c-f71f-3b5b-a6a9-a7e43134dac6",
                                                "text": "Nicola Sturgeon rues descent into ‘toxic’ debate on topics such as equal marriage [title]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db288e41-62cf-3c01-87a0-bf9f66b2124e",
                                        "entry_id": "5d46686f-f5ab-3dc9-9551-ac088daa78a2",
                                        "glosses": [
                                            "To cause to repent of sin or regret some past action."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64c4f52b-f86a-3e9b-a713-c64c28595613",
                                        "entry_id": "5d46686f-f5ab-3dc9-9551-ac088daa78a2",
                                        "glosses": [
                                            "To cause to feel sorrow or pity."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b80fa9b9-a640-3ad2-8081-0466f58ecf90",
                                        "entry_id": "5d46686f-f5ab-3dc9-9551-ac088daa78a2",
                                        "glosses": [
                                            "To feel compassion or pity; to take pity (on), to have compassion (on)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5c38386-46ab-4be1-9a70-1b8dbc8fecf5",
                                                "sense_id": "b80fa9b9-a640-3ad2-8081-0466f58ecf90",
                                                "text": "[…] till our Lord's clouds rue upon the earth, and send down a watring of rain: Truly , I think Christ's misty dew a welcome message from heaven, till my Lord's rain fall : […]"
                                            },
                                            {
                                                "example_id": "8ad3a829-daef-4274-b68a-afeed3157bcc",
                                                "sense_id": "b80fa9b9-a640-3ad2-8081-0466f58ecf90",
                                                "text": "1842, Nicholas Ridley, The Life of Nicholas Ridley\nwhich stirred men's hearts to rue upon them"
                                            },
                                            {
                                                "example_id": "bd94d604-57f1-491d-9e9f-9a19e90c39b2",
                                                "sense_id": "b80fa9b9-a640-3ad2-8081-0466f58ecf90",
                                                "text": "Rue on thy despairing lover! Canst thou break his faithfu' heart?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70317659-4a80-3c31-af09-123d8135163f",
                                        "entry_id": "5d46686f-f5ab-3dc9-9551-ac088daa78a2",
                                        "glosses": [
                                            "To feel sorrow or regret."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81e9e79f-bfb0-4c8b-924b-0e1725dfcab8",
                                                "sense_id": "70317659-4a80-3c31-af09-123d8135163f",
                                                "text": "Old year, we'll dearly rue for you."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55afc74c-d752-3b85-a494-8e53c71900bb",
                                        "entry_id": "8e351987-5e3f-3afd-a797-e03ab9424de6",
                                        "glosses": [
                                            "Any of various perennial shrubs of the genus Ruta, especially the herb Ruta graveolens (common rue), formerly used in medicines."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7348250f-00b7-45ad-8926-6caae9c84936",
                                                "sense_id": "55afc74c-d752-3b85-a494-8e53c71900bb",
                                                "text": "But th'aged Nourse, her calling to her bowre, / Had gathered Rew, and Savine, and the flowre / Of Camphora, and Calamint, and Dill [...]."
                                            },
                                            {
                                                "example_id": "5950d01d-aa47-45ac-943b-ea173d8a2f83",
                                                "sense_id": "55afc74c-d752-3b85-a494-8e53c71900bb",
                                                "text": "Ophelia:\nThere’s fennel for you, and columbines: there’s rue for you; and here’s some for me: we may call it herb-grace o' Sundays: O you must wear your rue with a difference."
                                            },
                                            {
                                                "example_id": "10cd8d83-d610-424e-8867-c875023a17bf",
                                                "sense_id": "55afc74c-d752-3b85-a494-8e53c71900bb",
                                                "text": "The life of one plant would be affected by another. Rue was definitely hostile to basil, rosemary to hyssop, but coriander, dill and chervil lived on the friendliest of terms[.]"
                                            },
                                            {
                                                "example_id": "9da94d66-cdc2-4bc7-89b4-92882d4709de",
                                                "sense_id": "55afc74c-d752-3b85-a494-8e53c71900bb",
                                                "text": "Like the water lily, endive, and lettuce, rue was believed to have anti-aphrodisiac properties."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2825d7b6-9915-4ee3-8ce9-9e81ba5e7940",
                        "source_entry_id": "3046c251-09a5-3abb-851f-99e2ee686960",
