                                "target_senses": [
                                    {
                                        "sense_id": "daac6241-38c6-38e4-a728-a6d5a196d42b",
                                        "entry_id": "5063eae9-448a-361c-a92a-54ef4ce7ad5b",
                                        "glosses": [
                                            "dunkel- und gleichschalige Meeresmuschel (Mýtilus edúlis), 8 cm lang, lebt gesellig mittels Haftfäden an Pfählen und Steinen in der Nord- und Ostsee und im Mittelmeer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54bbdbdd-9a03-4d71-bc47-7015fa5af947",
                                                "sense_id": "daac6241-38c6-38e4-a728-a6d5a196d42b",
                                                "text": "Im Sommer färben sich Miesmuscheln beim Kochen rot und rufen Muschelvergiftung hervor."
                                            },
                                            {
                                                "example_id": "38b5df8c-9627-4037-8d2d-932e3ea99923",
                                                "sense_id": "daac6241-38c6-38e4-a728-a6d5a196d42b",
                                                "text": "Thema des nächsten Vortrags: \"Trägt die Miesmuschel ihren Namen zu Recht?\""
                                            },
                                            {
                                                "example_id": "a95453f3-d802-4942-b844-25683259cccd",
                                                "sense_id": "daac6241-38c6-38e4-a728-a6d5a196d42b",
                                                "text": "„Die Frauen begaben sich ins Wasser, um Muscheln zu sammeln, weiße Venusmuscheln und große dunkelgrüne Miesmuscheln."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f68920ee-4c9f-4092-8ad2-d5d4fdf0d1ca",
