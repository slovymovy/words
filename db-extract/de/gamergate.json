                "senses": [
                    {
                        "sense_id": "f27522b6-3b72-3ba4-bff6-1854fff3154f",
                        "entry_id": "c0cd3e29-711b-3af0-99c5-9dc9ac2199ba",
                        "glosses": [
                            "begattete Arbeiterin, die Eier legt"
                        ],
                        "tags": [
                            "über Ameisen"
                        ],
                        "examples": [
                            {
                                "example_id": "8685d827-c3be-4d32-9784-eef0781824d4",
                                "sense_id": "f27522b6-3b72-3ba4-bff6-1854fff3154f",
                                "text": "Eine Gamergate ist anatomisch nicht von anderen Arbeiterinnen unterscheidbar."
                            },
                            {
                                "example_id": "54fc50a8-d882-441f-a452-bf13a1a0bf81",
                                "sense_id": "f27522b6-3b72-3ba4-bff6-1854fff3154f",
                                "text": "„Es stellt sich die Frage, wie sich die Regulation der Reproduktion zwischen Kolonien mit Gamergaten und mit Königinnen unterscheidet?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "284270f2-81ac-499b-ad20-7438a109b59f",
                        "source_entry_id": "c0cd3e29-711b-3af0-99c5-9dc9ac2199ba",
                        "source_sense_id": "f27522b6-3b72-3ba4-bff6-1854fff3154f",
                        "source_sense_description": "Zoologie, über Ameisen: begattete Arbeiterin, die Eier legt",
                        "target_lang_word": "gamergate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gamergate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2a6f58c-98ac-387c-a17b-7584e7d9a53a",
                                        "entry_id": "b04dc86b-f493-37e9-ad6b-34dc7376ee87",
                                        "glosses": [
                                            "A worker insect that can become capable of reproducing when the queen has died."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "377438a4-2811-4ba6-ae66-a2f5eebc5b78",
                                                "sense_id": "c2a6f58c-98ac-387c-a17b-7584e7d9a53a",
                                                "text": "Recent studies indicate that queenless societies can have either one or several gamergates per colony, which reveals that reproductive inhibition can occur despite the absence of the queen caste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf20e912-e54c-4f4f-a3c2-59a73c8aef72",
                        "source_entry_id": "c0cd3e29-711b-3af0-99c5-9dc9ac2199ba",
                        "source_sense_id": "f27522b6-3b72-3ba4-bff6-1854fff3154f",
                        "source_sense_description": "Zoologie, über Ameisen: begattete Arbeiterin, die Eier legt",
                        "target_lang_word": "gamergate",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gamergate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "510a315c-86dd-312f-adc6-65c2b8ca8d18",
                                        "entry_id": "6e9f45b9-158f-322f-a0b7-57f1c42c5948",
                                        "glosses": [
                                            "Chez certaines espèces d'insectes sociaux (notamment environ 1% des espèces de fourmis), ouvrière qui devient capable de s’accoupler et de pondre des œufs fertilisés. Selon les espèces, le rôle de gamergate vient en complément ou en remplacement de celui de reine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bafaae4c-6222-43a1-9df5-dc19bd5178fd",
                                                "sense_id": "510a315c-86dd-312f-adc6-65c2b8ca8d18",
                                                "text": "À l’inverse de la plupart des ouvrières des autres sous-familles, celles des Ponerinae ont conservé un organe appelé spermathèque, dans lequel le sperme du mâle est accumulé et stocké, ce qui leur permet de pondre des oeufs fécondés et donc de remplacer fonctionnellement la reine. Pour marquer leur morphologie ouvrière, elles sont appelées des gamergates. Toutes les ouvrières sont des gamergates potentielles et si elles ne parviennent pas à acquérir ce statut, elles ont au moins la possibilité d’émettre des oeufs vierges qui produiront des mâles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
