                        "examples": [
                            {
                                "example_id": "1da47a53-2b78-4aa3-9b35-d0ac57bcec40",
                                "sense_id": "ef83c751-5fe9-3631-9fce-97a084e2f662",
                                "text": "Jak wyglądała dziewiętnastowieczna garncarnia, będzie się można przekonać naocznie w Rabce-Zdroju, jutro bowiem otwarta zostanie tam zrekonstruowana pracownia rodziny Rączków.",
                                "translation": "It will be possible to see what a 19th-century pottery workshop looked like for oneself in Rabka-Zdrój, as tomorrow a reconstructed workshop belonging to the Rączek family will be opened there.",
                                "english": "It will be possible to see what a 19th-century pottery workshop looked like for oneself in Rabka-Zdrój, as tomorrow a reconstructed workshop belonging to the Rączek family will be opened there."
                            }
                        ]
                    }
