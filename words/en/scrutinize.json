                    "frequency": "Low",
                    "semantic_group_id": "examine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tax authorities will <w>scrutinize</w> the accounts to ensure all income was properly reported.",
                            "target_lang_translations": {
                                "ru": "Налоговые органы будут <w>тщательно проверять</w> счета, чтобы убедиться, что весь доход был задекларирован должным образом."
                            }
                        },
                        {
                            "text": "Independent auditors were hired to <w>scrutinize</w> the records of the charity.",
                            "target_lang_translations": {
