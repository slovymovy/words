                            },
                            {
                                "target_lang_word": "address",
                                "target_lang_sense_clarification": "formal speech"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "演讲",
                                "target_lang_sense_clarification": "指正式的公开讲话"
                            },
                            {
                                "target_lang_word": "发言",
                                "target_lang_sense_clarification": "指在会议或场合中的讲话"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ebab0de-abf8-3f8c-a00b-fe7ba072ca2e",
                    "sense_definition": "Тот или иной вид, стиль языка; манера говорить или звучание голоса.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "style_manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом упражнении нужно перевести прямую <w>речь</w> в косвенную.",
                            "target_lang_translations": {
                                "en": "In this exercise, you need to convert direct <w>speech</w> into indirect.",
                                "zh": "在这道练习题中，你需要把直接引语转换成间接<w>语言</w>。"
                            }
                        },
                        {
                            "text": "Правильная письменная <w>речь</w> необходима для успешной карьеры.",
                            "target_lang_translations": {
                                "en": "Correct written <w>language</w> is necessary for a successful career.",
                                "zh": "规范的写作<w>语言</w>对职业成功至关重要。"
                            }
                        },
                        {
                            "text": "Её тихая и спокойная <w>речь</w> действовала на всех умиротворяюще.",
                            "target_lang_translations": {
                                "en": "Her quiet and calm <w>speech</w> had a soothing effect on everyone.",
                                "zh": "她那轻柔平静的<w>口吻</w>让在场的所有人都感到安宁。"
                            }
                        }
                    ],
                    "synonyms": [
                        "выговор",
                        "говор"
                    ],
                    "common_phrases": [
                        "прямая речь",
                        "косвенная речь",
                        "устная речь",
                        "письменная речь",
                        "родная речь",
                        "русская речь"
                    ],
                    "target_lang_definitions": {
                        "en": "A particular style of language or manner of speaking.",
                        "zh": "指语言的风格、表达方式或说话的语调。"
                    },
