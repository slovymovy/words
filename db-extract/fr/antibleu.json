                ],
                "senses": [
                    {
                        "sense_id": "7a99c314-eeb8-3f5b-82b3-10c97797c0d3",
                        "entry_id": "e057155e-fd66-3bef-89c2-3eab38115081",
                        "glosses": [
                            "En chromodynamique quantique, une des trois charges de couleur de l’antiquark, les deux autres étant l’antirouge et l’antivert. Il annule avec le bleu. Quelquefois appelé aussi le jaune."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "3f8931d8-4081-4e65-9bb8-d594b9d7b552",
                                "sense_id": "7a99c314-eeb8-3f5b-82b3-10c97797c0d3",
                                "text": "L’antibleu se fait aussi d’autant plus intense que l’on s’écarte du quark rouge et que les gluons virtuels conjuguent leurs effets."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0998dd4f-2a2e-4ce7-8bf0-57af90221d29",
                        "source_entry_id": "e057155e-fd66-3bef-89c2-3eab38115081",
                        "source_sense_id": "7a99c314-eeb8-3f5b-82b3-10c97797c0d3",
                        "target_lang_word": "antiblue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antiblue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d8d57d0-77b7-3dcb-a017-6eccc1c39fc9",
                                        "entry_id": "a1fb2e12-a43d-3f1b-a243-975f15c84777",
                                        "glosses": [
                                            "Describing one of the three possible colours of an antiquark, corresponding to blue in a quark."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "particle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e02bfb70-38ae-4885-bd88-e8aaaf365cf5",
                                                "sense_id": "1d8d57d0-77b7-3dcb-a017-6eccc1c39fc9",
                                                "text": "For example, the tetraquark can split up into a red antired meson and a blue antiblue meson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53bb53e0-29c3-30da-9289-17d330d89f78",
                                        "entry_id": "a1fb2e12-a43d-3f1b-a243-975f15c84777",
                                        "glosses": [
                                            "Antipolice."
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64b48a6b-3d75-480f-900e-b1a245561ad4",
                                                "sense_id": "53bb53e0-29c3-30da-9289-17d330d89f78",
                                                "text": "Anyone who allowed banned activities to take place on his owned or rented property faced police citations and fines. It took only two years, however, for anti-blue law sentiment to arise, and various exceptions to the original ordinance were passed […]"
                                            },
                                            {
                                                "example_id": "d9ceaa35-f0ab-4560-870d-ff40d423d74d",
                                                "sense_id": "53bb53e0-29c3-30da-9289-17d330d89f78",
                                                "text": "Time Warner […] was also home to Ice-T, whose “Cop Killer” was pointedly and recklessly antiblue in the wake of the 1992 L.A. riots, even if the track had been intended as a statement against police brutality—a generation before the rise of the Black Lives Matter movement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
