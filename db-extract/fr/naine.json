                        "target_lang_word": "dwerg",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dwerg",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f43809e0-4525-3036-8cc0-83afea3b66d0",
                                        "entry_id": "687bab91-974c-3965-a426-2793d8e1dd5b",
                                        "glosses": [
                                            "mensachtig wezen dat corpulent is, een baard heeft en een muts draagt, en erg kort van stuk is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a60a29d7-e80e-4d67-a0cd-cde9eaf30d12",
                                                "sense_id": "f43809e0-4525-3036-8cc0-83afea3b66d0",
                                                "text": "Nu ziet hij geen schilder, prinses, dwerg of vorst, hij ziet een portret van een hond."
                                            },
                                            {
                                                "example_id": "4dc6339d-2bc6-4a05-97dd-90888fab9d7c",
                                                "sense_id": "f43809e0-4525-3036-8cc0-83afea3b66d0",
                                                "text": "\"Sneeuwwitje en de zeven dwergen\" is een beroemd sprookje."
                                            },
                                            {
                                                "example_id": "9a4997f2-c622-4349-953c-def153c70f2a",
                                                "sense_id": "f43809e0-4525-3036-8cc0-83afea3b66d0",
                                                "text": "De dwerg stond snel weer op, keek Netelbrand nerveus aan en wees toen met een bevende vinger naar de muur achter hem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9116c74-4aa3-3945-aa29-cf346e84a1f1",
                                        "entry_id": "687bab91-974c-3965-a426-2793d8e1dd5b",
                                        "glosses": [
                                            "abnormaal klein persoon (bij verdere uitbreiding ook gezegd van dieren of dingen)"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "768dfef2-32af-4bf4-bbb2-fab88858dc57",
                                                "sense_id": "d9116c74-4aa3-3945-aa29-cf346e84a1f1",
                                                "text": "In ons Melkwegstelsel komen zeker een paar honderdduizend van zulke objecten voor ' Als gevolg van die materie- overdracht wordt de witte dwerg steeds zwaarder en als de massa ongeveer anderhalf maal zo groot is als die van de zon stort de witte dwerg verder ineen tot een neutronenster."
                                            },
                                            {
                                                "example_id": "47b5c7ca-aa44-4709-b11f-5fbf455a3de6",
                                                "sense_id": "d9116c74-4aa3-3945-aa29-cf346e84a1f1",
                                                "text": "Veel dwergen zijn patiënten met achondroplasie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41d8247e-af62-4060-832c-cfa1bcc20fe1",
                        "source_entry_id": "1853fe02-69c5-3a45-8f66-988898b90d93",
                        "source_sense_id": "3e0a27c4-8bc8-3512-85a0-431ff272a334",
                        "source_sense_description": "Astronomie (étoile naine)",
                        "target_lang_word": "dwergster",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dwergster",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2e3eb8f1-9441-3094-804f-de7e578a255b",
                                        "entry_id": "cae3e0b8-3103-3e10-9fa0-9cc4a8686ec9",
                                        "glosses": [
                                            "ster die weinig licht uitstraalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0edbd78f-9851-4139-b28b-c73e09a164a9",
                                                "sense_id": "2e3eb8f1-9441-3094-804f-de7e578a255b",
                                                "text": "Vermoedelijk verscheurde een relatief licht zwart gat een dwergster die ongeveer even groot was als de zon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7a6271c-1a16-4787-81c7-c1530b9d7643",
                        "source_entry_id": "1853fe02-69c5-3a45-8f66-988898b90d93",
                        "source_sense_id": "3e0a27c4-8bc8-3512-85a0-431ff272a334",
                        "source_sense_description": "Astronomie (étoile naine)",
                        "target_lang_word": "карлик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "карлик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8979b3ab-6cc3-3c40-8725-2207ba8b8a29",
                                        "entry_id": "b8420688-c1a9-3769-9065-893d523507dd",
                                        "glosses": [
                                            "человек низкого роста"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07f95a4c-68eb-4697-8cef-7bfc8bc078cd",
                                                "sense_id": "8979b3ab-6cc3-3c40-8725-2207ba8b8a29",
                                                "text": "Эй, взгляните-ка на уродца-карлика! Откуда взялся такой карлик? Ну и длинный же у него нос! А голова совсем ушла в плечи! А руки-то какие тёмные и безобразные!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a44ecc2-dde7-3812-9117-a5ac75bcef37",
                                        "entry_id": "b8420688-c1a9-3769-9065-893d523507dd",
                                        "glosses": [
                                            "астрон. звезда сравнительно малых размеров и светимости"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74a96197-e8db-4900-b016-f3679d46cf1b",
                                                "sense_id": "6a44ecc2-dde7-3812-9117-a5ac75bcef37",
                                                "text": "Солнце — жёлтый карлик."
                                            },
                                            {
                                                "example_id": "7aaf62e7-91f6-4919-b558-05561c6b9f8d",
                                                "sense_id": "6a44ecc2-dde7-3812-9117-a5ac75bcef37",
                                                "text": "Звёзды по их светимости делятся на семь классов: сверхгиганты, яркие и слабые гиганты, субгиганты, карлики (звёзды главной последовательности), субкарлики и белые карлики."
                                            },
                                            {
