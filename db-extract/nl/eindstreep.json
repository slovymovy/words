                    {
                        "sense_id": "66eb93fd-7d5e-308d-9248-6c249551020d",
                        "entry_id": "a8471b76-b659-3ec1-a9b5-70f2b3e19486",
                        "glosses": [
                            "streep op de grond die het einde van een wedstrijdbaan aanduidt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bc569b9-296d-4a90-8e40-701437681054",
                                "sense_id": "66eb93fd-7d5e-308d-9248-6c249551020d",
                                "text": "Op het einde van de wedstrijd ging de Kneet als eerste over de eindstreep."
                            },
                            {
                                "example_id": "2a5a4ce2-7699-4cc0-a7dd-54cae917e63d",
                                "sense_id": "66eb93fd-7d5e-308d-9248-6c249551020d",
                                "text": "Het is buiten de kwelzucht van de parcoursbouwers gerekend. Hier lag de afgelopen drie keer de eindstreep, maar verderop hebben ze een onverhard pad laten aanleggen. Nog wat verder omhoog, heren!"
                            }
                        ]
                    },
                    {
                        "sense_id": "ff856986-7178-3f70-b7ec-e11f2fc26663",
                        "entry_id": "a8471b76-b659-3ec1-a9b5-70f2b3e19486",
                        "glosses": [
                            "het einddoel"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e3ce71e3-8b3f-49d5-91a6-7d6f3b5ba133",
                                "sense_id": "ff856986-7178-3f70-b7ec-e11f2fc26663",
                                "text": "Na vele jaren hard studeren heeft hij de eindstreep gehaald."
                            }
                        ]
                    }
