                    },
                    {
                        "form_id": "1fdc8525-6da2-44b8-8f50-60be56acdeab",
                        "entry_id": "6b828409-1e15-3c56-ac64-8babdc902485",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "загоре́вшись"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c6253ed8-8886-3ca3-9b06-be4b74cd5307",
                        "entry_id": "6b828409-1e15-3c56-ac64-8babdc902485",
                        "glosses": [
                            "начать гореть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa3e99e6-791a-4c3d-a741-d97c06d32835",
                                "sense_id": "c6253ed8-8886-3ca3-9b06-be4b74cd5307",
                                "text": "Людмила кинулась зажигать свечи, когда седьмая свеча загорелась, она повернула ручку и уменьшила громкость мессы."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee4b711f-2136-3c59-a8e3-eaddfd5e5cf4",
                        "entry_id": "6b828409-1e15-3c56-ac64-8babdc902485",
                        "glosses": [
                            "начать испускать свет; начать светить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "beed79f0-01ec-4cf8-a229-9cd47f693dd3",
                                "sense_id": "ee4b711f-2136-3c59-a8e3-eaddfd5e5cf4",
                                "text": "Они проехали на жёлтый, а для меня загорелся красный, ну ничего ― что нам стоит дом построить."
                            },
                            {
                                "example_id": "a8d608df-4c14-411a-90ce-2fafa9834565",
                                "sense_id": "ee4b711f-2136-3c59-a8e3-eaddfd5e5cf4",
                                "text": "Тогда окрашенные люминофорами зёрна загорятся ярким светом, их будет легко обнаружить и подсчитать даже при малых концентрациях."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a67c385-4747-3102-b6ad-1046f40c7032",
                        "entry_id": "6b828409-1e15-3c56-ac64-8babdc902485",
                        "glosses": [
                            "начать блестеть, сиять, отражая свет, лучи и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48b960db-4c0f-4def-8bb1-cd8be2c0a07d",
                                "sense_id": "7a67c385-4747-3102-b6ad-1046f40c7032",
                                "text": "Бриллианты загорелись в глазах молодого человека, и он в один взмах исчеркал еще одну страницу."
                            }
                        ]
                    },
                    {
                        "sense_id": "9be85674-e010-33b2-ad38-0129c30e7d1e",
                        "entry_id": "6b828409-1e15-3c56-ac64-8babdc902485",
                        "glosses": [
                            "перен. озариться каким-либо чувством (о взгляде, взоре)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9caf3c6c-2e95-4de4-9f8b-98aa07364d4f",
                                "sense_id": "9be85674-e010-33b2-ad38-0129c30e7d1e",
                                "text": "Глаза Дениса загорелись, затрепетали крылья носа, на скулах проступил темный румянец."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a88a4df-19f8-3955-8447-8d61327f35c9",
                        "entry_id": "6b828409-1e15-3c56-ac64-8babdc902485",
                        "glosses": [
                            "перен. покрыться румянцем; покраснеть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52535c37-7fb2-4597-864a-50fba7453927",
                                "sense_id": "4a88a4df-19f8-3955-8447-8d61327f35c9",
                                "text": "Мне стало так стыдно, что уши загорелись огнём."
                            }
                        ]
                    },
                    {
                        "sense_id": "23978439-65b0-3fae-97aa-927e4ae9c38e",
                        "entry_id": "6b828409-1e15-3c56-ac64-8babdc902485",
                        "glosses": [
                            "перен. оказаться охваченным внезапным и сильным чувством, желанием, интересом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3429192-fce0-4d8a-b8ff-a30f634f7ca6",
                                "sense_id": "23978439-65b0-3fae-97aa-927e4ae9c38e",
                                "text": "Денег у меня тогда было крайне мало, а он мне сразу о таких суммах стал трепаться, что я тоже загорелся."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c092ad9-ef9a-4ba4-83f3-23346a8983a1",
                        "source_entry_id": "6b828409-1e15-3c56-ac64-8babdc902485",
                        "source_sense_description": "начать гореть",
                        "target_lang_word": "catch fire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catch fire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fa9812d-c00d-374d-a9f0-e91d104e6a9c",
                                        "entry_id": "885fe347-6e94-3ec9-83ee-2f6862250d6f",
                                        "glosses": [
                                            "To become engulfed in flames, to combust."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8e8cced-8fce-40c5-8489-465fe45e32cd",
                                                "sense_id": "2fa9812d-c00d-374d-a9f0-e91d104e6a9c",
                                                "text": "Ships' logs noted observations of the northern lights as far south as the Caribbean, and telegraph systems across the world were disrupted as electrical currents were induced in the copper lines. Several telegraph operators received electric shocks and some telegraph stations even caught fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b08d8c38-b054-33b7-ba45-44ad9976f8c6",
                                        "entry_id": "885fe347-6e94-3ec9-83ee-2f6862250d6f",
                                        "glosses": [
                                            "To become very popular or widespread; to take off."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80cc83f4-de0a-40ca-bc9a-67e78d2c37a6",
                                                "sense_id": "b08d8c38-b054-33b7-ba45-44ad9976f8c6",
                                                "text": "The news caught fire through the school, and Layla found herself — a mere first-year student at the secondary school — the center of attention and admiration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af88fd0f-8742-359b-b8fb-b528ec649138",
                                        "entry_id": "885fe347-6e94-3ec9-83ee-2f6862250d6f",
                                        "glosses": [
                                            "To be inspired by passion or zeal."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1bd9e35-7c1e-46d9-b9e8-748a892a28bd",
                        "source_entry_id": "6b828409-1e15-3c56-ac64-8babdc902485",
                        "source_sense_description": "начать гореть",
                        "target_lang_word": "prendre feu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prendre feu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "023c1fcc-3628-37be-9f50-8164c81ad9d2",
                                        "entry_id": "cc8b742c-79a0-30a1-86ab-ad536941ed96",
                                        "glosses": [
                                            "S'enflammer, en parlant des choses qui brûlent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bab8998-8824-45cf-a105-f54d6b58afdb",
                                                "sense_id": "023c1fcc-3628-37be-9f50-8164c81ad9d2",
                                                "text": "Ce n'est pas la première fois qu'un véhicule de la marque Tesla prend feu après un accident de la circulation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0c820b4-ef4f-3071-a649-7758663f3727",
                                        "entry_id": "cc8b742c-79a0-30a1-86ab-ad536941ed96",
                                        "glosses": [
                                            "S'émouvoir, s'enflammer, s'irriter; dans une discussion, ne souffrir aucune contradiction, aucune contrariété."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f591d87-95d5-4698-8878-506250250fbf",
                                                "sense_id": "e0c820b4-ef4f-3071-a649-7758663f3727",
                                                "text": "Vous prenez feu bien aisément. — C'est un homme qui prend feu tout de suite, qui prend feu sur les moindres choses."
                                            },
                                            {
                                                "example_id": "578f4bbd-913f-4bb0-8e1b-ccf95b1b615e",
                                                "sense_id": "e0c820b4-ef4f-3071-a649-7758663f3727",
                                                "text": "Elle est toujours triste et singulière, excepté quand elle prend feu en faveur de Henri V."
                                            },
                                            {
                                                "example_id": "601b6a2b-6bf7-447c-97db-89f45a97880c",
                                                "sense_id": "e0c820b4-ef4f-3071-a649-7758663f3727",
                                                "text": "Grâce à ton éloquence, j’avais comme toi pris feu pour cette grande idée."
                                            },
                                            {
                                                "example_id": "c0ec62be-71e1-4ad5-9810-10215bde4d0c",
                                                "sense_id": "e0c820b4-ef4f-3071-a649-7758663f3727",
                                                "text": "Ils ne discutaient pas. Une réflexion d’Isa ou de Geneviève était suivie d’un long silence. Puis soudain, sur un mot d’Hubert, Phili prenait feu, et ils parlaient tous à la fois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db265fa6-a6dc-3cec-8f09-5dae6264fc56",
                                        "entry_id": "cc8b742c-79a0-30a1-86ab-ad536941ed96",
                                        "glosses": [
                                            "S'enflammer subitement d'amour."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
