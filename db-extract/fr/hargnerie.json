                "senses": [
                    {
                        "sense_id": "593911eb-580a-3e64-871c-6b1b5199d1c7",
                        "entry_id": "4813cc41-8803-3439-94fe-4fb17a3838b4",
                        "glosses": [
                            "Attaque hargneuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47cfdada-0285-4507-ab77-bf452c29f67e",
                                "sense_id": "593911eb-580a-3e64-871c-6b1b5199d1c7",
                                "text": "Le véritable respect qu'on doit au public est de lui épargner, non de tristes vérités qui peuvent lui être utiles, mais bien les petites hargneries d'auteurs dont on remplit les écrits polémiques."
                            },
                            {
                                "example_id": "06f5a4ff-4a1b-4e94-80a0-a52efedc5c41",
                                "sense_id": "593911eb-580a-3e64-871c-6b1b5199d1c7",
                                "text": "Ses dents de lapin, clac, clac, tapaient bêtement le tempo d’une hargnerie atroce où il était question d’un ultravirus qui l’emporterait au prochain hiver."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8186a71-ed60-4324-82c7-8d55d80e79fd",
                        "source_entry_id": "4813cc41-8803-3439-94fe-4fb17a3838b4",
                        "source_sense_id": "593911eb-580a-3e64-871c-6b1b5199d1c7",
                        "target_lang_word": "Gereiztheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gereiztheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                        "entry_id": "ded93f93-8d97-37af-ae6b-9e3466fcdef5",
                                        "glosses": [
                                            "Zustand nervlich angespannter Stimmung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d728877-dd6c-4bb1-8868-5826beef17ba",
                                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                                "text": "Am Ende des Arbeitstages schleppte er den Stress und die Gereiztheit oft mit nach Hause."
                                            },
                                            {
                                                "example_id": "59841b73-b480-470a-8598-4fbca3cec0fc",
                                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                                "text": "„Als Bruni bemerkt, dass Isoldes depressive Gereiztheit zunimmt, äußert sie ihre Vermutung, dass es für Percys Reserviertheit neben der Nibelungentreue noch handfestere Gründe geben könnte, wogegen halt schärfere Aphrodisiaka eingesetzt werden müssten.“"
                                            },
                                            {
                                                "example_id": "0fbd59f4-5239-4f89-9b90-b8ea44a946ac",
                                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                                "text": "„Alle ihre Gereiztheit war plötzlich verschwunden, und ihre unruhigen, fragenden Augen hafteten in gieriger Erwartung an seinem Gesicht.“"
                                            },
                                            {
                                                "example_id": "81f7df7e-bb1f-43b2-8275-fc2405916b40",
                                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                                "text": "„Sie lachte herzlich, denn der Ton, in dem St. Armaud dies sagte, klang durchaus liebenswürdig und jedenfalls ebenso frei von Gereiztheit wie Tadel.“"
                                            },
                                            {
                                                "example_id": "9fe2e779-d03a-4b43-b29f-874837c33d3f",
                                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                                "text": "„Wenn Karl Emonds eine Siebenzimmerwohnung hätte, wäre die Gereiztheit, das Gehetztsein nicht mehr unumgänglich.“"
                                            },
                                            {
                                                "example_id": "a6a04519-9fe0-48f3-9724-46b95a17fc01",
                                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                                "text": "„Als Ferris sein Büro betrat, musterte Hoffman ihn über den Rand seiner Lesebrille hinweg mit einer Mischung aus Gereiztheit und Erstaunen, als habe er total vergessen, dass er Ferris herbestellt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
