                    {
                        "form_id": "3bd29b54-1978-4b1a-9af6-8c9fdd4f4eab",
                        "entry_id": "3e1a82e9-4d3b-315e-a903-e9410ec2b28f",
                        "tags": [
                            "poetic"
                        ],
                        "form": "chasseresse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b6fc1195-d80a-37fe-987e-06a37b39e86e",
                        "entry_id": "3e1a82e9-4d3b-315e-a903-e9410ec2b28f",
                        "glosses": [
                            "Personne ou animal s’adonnant à la chasse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6136d794-ac90-487b-bb4f-e4ca405345b7",
                                "sense_id": "b6fc1195-d80a-37fe-987e-06a37b39e86e",
                                "text": "Quand mon appétit fut un peu apaisé, j’entamai avec ma chasseuse d’insectes un dialogue que mon ignorance de la langue espagnole bornait nécessairement beaucoup."
                            },
                            {
                                "example_id": "289fc8c8-05f8-4f5c-aa04-3b68dc891158",
                                "sense_id": "b6fc1195-d80a-37fe-987e-06a37b39e86e",
                                "text": "Linnea Lindeman – une forte femme, chasseuse de phoques et accoucheuse un peu chamane …."
                            }
                        ]
                    },
                    {
                        "sense_id": "9849a60d-8463-3ec7-9d74-f8d4b5e27518",
                        "entry_id": "3e1a82e9-4d3b-315e-a903-e9410ec2b28f",
                        "glosses": [
                            "Celle cherchant passionnément une chose ou une personne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50aaa9e0-c9dd-46fb-b77e-cd97b69c5105",
                                "sense_id": "9849a60d-8463-3ec7-9d74-f8d4b5e27518",
                                "text": "Durant quelques années, j’ai été chasseuse de têtes : j’étais censée évaluer des candidats expérimentés qui occupaient des fonctions complexes et techniques, auxquelles je ne pouvais, du haut de mes vingt-deux ans, rien comprendre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0c4b42c-e03b-47f1-a64b-d2fed93696bb",
                        "source_entry_id": "3e1a82e9-4d3b-315e-a903-e9410ec2b28f",
                        "target_lang_word": "Jägerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jägerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "012ad76d-c340-3794-8fda-5caa01e06f16",
                                        "entry_id": "8341153a-be20-3843-943f-2fe0a1d0d56a",
                                        "glosses": [
                                            "weibliche Person, die auf die Jagd geht"
                                        ],
                                        "tags": [
                                            "Jagdwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "470f4f80-f30b-490b-824c-7b3526beb267",
                                                "sense_id": "012ad76d-c340-3794-8fda-5caa01e06f16",
                                                "text": "Erschöpft trat am Sonntagmorgen die Jägerin aus dem Wald."
                                            },
                                            {
                                                "example_id": "4e0ed4e2-680d-4329-bfd2-fc2ae3d4b313",
                                                "sense_id": "012ad76d-c340-3794-8fda-5caa01e06f16",
                                                "text": "„Er sah Elisabeth zum erstenmal völlig losgelöst von der Zeit, bei sich selbst, hingegeben einer unbefangenen und tiefen Spielerei, überschüttet von Licht und Zärtlichkeit und Liebe, ernst und gesammelt wie eine Jägerin, die ihre Waffen zum Kampfe prüft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffd0cbd0-2e4c-43c7-b0e3-54882a34ffa0",
                        "source_entry_id": "3e1a82e9-4d3b-315e-a903-e9410ec2b28f",
                        "target_lang_word": "huntress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "huntress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a950913b-e90b-3497-9f25-9c354b2049e3",
                                        "entry_id": "519c58d4-ada3-3ddf-9884-20b93e6e626a",
                                        "glosses": [
                                            "A female hunter."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77693f2c-47a6-402e-bddb-287ac02b086f",
                                                "sense_id": "a950913b-e90b-3497-9f25-9c354b2049e3",
                                                "text": "In those same woods ye well remember may / How that a noble hunteress did wonne [...]."
                                            },
                                            {
                                                "example_id": "7ddc2bb4-34b7-440d-a429-7f58e6c8cc90",
                                                "sense_id": "a950913b-e90b-3497-9f25-9c354b2049e3",
                                                "text": "Ashol-Pan, the daughter of a particularly celebrated hunter, may well be the country's only apprentice huntress."
                                            },
                                            {
                                                "example_id": "be6c18aa-dcfa-4118-8806-fe2c4ef696d0",
                                                "sense_id": "a950913b-e90b-3497-9f25-9c354b2049e3",
                                                "text": "Grief and fear cannot rule you;\nlet them be your faithful servants, protective of their mistress.\nLoss serves a huntress like fuel serves fire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
