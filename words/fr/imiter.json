{
    "word_family": [
        "imitable",
        "imitateur",
        "imitatif",
        "imitation",
        "inimitable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8eb64146-a5fd-3f73-a9ba-3e5037fa2f79",
                    "sense_definition": "Reproduire les gestes, les paroles, les attitudes ou la voix d'une personne.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "reproduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant adore <w>imiter</w> ses parents lorsqu'ils parlent au téléphone."
                        },
                        {
                            "text": "Ce comédien sait parfaitement <w>imiter</w> la voix des personnalités politiques."
                        }
                    ],
                    "synonyms": [
                        "singer",
                        "parodier",
                        "contrefaire"
                    ],
                    "common_phrases": [
                        "imiter la voix",
                        "imiter les gestes"
                    ]
                },
                {
                    "sense_id": "05565562-2920-3438-8f17-47325e15521a",
                    "sense_definition": "Prendre quelqu'un ou ses actions pour modèle et agir de la même manière.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "modele",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu devrais <w>imiter</w> son exemple et travailler avec plus de sérieux."
                        },
                        {
                            "text": "Les jeunes sportifs cherchent souvent à <w>imiter</w> le parcours de leurs champions."
                        }
                    ],
                    "synonyms": [
                        "suivre",
                        "émuler"
                    ],
                    "common_phrases": [
                        "imiter l'exemple"
                    ]
                },
                {
                    "sense_id": "c75e28ee-be03-3099-b2e7-857980ea9236",
                    "sense_definition": "Présenter une forte ressemblance avec une autre matière, une texture ou un son.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reproduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce matériau synthétique parvient à <w>imiter</w> le bois avec une précision étonnante."
                        },
                        {
                            "text": "Cette fausse fourrure <w>imite</w> le pelage naturel à la perfection."
                        }
                    ],
                    "synonyms": [
                        "ressembler",
                        "simuler"
                    ],
                    "common_phrases": [
                        "imiter le bois",
                        "imiter le cuir"
                    ]
                },
                {
                    "sense_id": "d934fd6d-a3ea-3f99-9324-c1553494b587",
                    "sense_definition": "Représenter artistiquement les formes, les aspects ou les sons de la nature.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peintre cherche à <w>imiter</w> fidèlement la nature dans chacune de ses toiles."
                        },
                        {
                            "text": "Cette symphonie parvient à <w>imiter</w> le bruit du vent et de la pluie."
                        }
                    ],
                    "synonyms": [
                        "reproduire",
                        "dépeindre"
                    ],
                    "common_phrases": [
                        "imiter la nature"
                    ]
                },
                {
                    "sense_id": "982be43c-e5a0-396e-8d84-da9c7c67d309",
                    "sense_definition": "Adopter délibérément le style, les procédés ou la technique d'un autre auteur ou artiste dans ses créations.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune auteur s'est efforcé d'<w>imiter</w> le style des grands écrivains classiques."
                        },
                        {
                            "text": "En refusant d'<w>imiter</w> ses contemporains, cet artiste a forgé une identité unique."
                        }
                    ],
                    "synonyms": [
                        "pasticher",
                        "plagier"
                    ],
                    "antonyms": [
                        "innover"
                    ],
                    "common_phrases": [
                        "imiter le style"
                    ]
                }
            ]
        }
    ]
}