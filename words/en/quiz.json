{
    "word_family": [
        "quizzical",
        "quizzically",
        "quizmaster",
        "quizzing-glass"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6b183685-a8cf-34c9-81a1-6fd873fb8d4e",
                    "sense_definition": "A competition or game in which people try to answer questions correctly.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "testing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our team came in second place during the weekly pub <w>quiz</w> last night.",
                            "target_lang_translations": {
                                "ru": "Наша команда заняла второе место во вчерашней еженедельной паб-<w>викторине</w>."
                            }
                        },
                        {
                            "text": "I enjoy watching a television <w>quiz</w> show to test my general knowledge.",
                            "target_lang_translations": {
                                "ru": "Мне нравится смотреть телевизионные <w>квиз</w>-шоу, чтобы проверить свой кругозор."
                            }
                        }
                    ],
                    "synonyms": [
                        "competition",
                        "contest"
                    ],
                    "common_phrases": [
                        "pub quiz",
                        "quiz show",
                        "online quiz"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соревнование или игра, в которой участники стараются правильно ответить на вопросы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "викторина",
                                "target_lang_sense_clarification": "игра-соревнование в ответах на вопросы"
                            },
                            {
                                "target_lang_word": "квиз",
                                "target_lang_sense_clarification": "современный формат интеллектуальной игры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfc0297e-0f63-3d08-83fb-c06ddd62118b",
                    "sense_definition": "A short, informal test given to students to measure their understanding of a specific topic.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "testing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher gave us a surprise <w>quiz</w> on the vocabulary words we learned yesterday.",
                            "target_lang_translations": {
                                "ru": "Учитель устроил нам внезапный <w>тест</w> по словам, которые мы выучили вчера."
                            }
                        },
                        {
                            "text": "I need to study tonight because we have a math <w>quiz</w> tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "Мне нужно позаниматься сегодня вечером, потому что завтра утром у нас <w>контрольная</w> по математике."
                            }
                        }
                    ],
                    "synonyms": [
                        "test",
                        "examination"
                    ],
                    "common_phrases": [
                        "pop quiz",
                        "math quiz",
                        "surprise quiz"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий неформальный тест для учащихся, чтобы проверить их знания по конкретной теме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тест",
                                "target_lang_sense_clarification": "проверка знаний"
                            },
                            {
                                "target_lang_word": "контрольная работа",
                                "target_lang_sense_clarification": "небольшая проверочная работа"
                            },
                            {
                                "target_lang_word": "опрос",
                                "target_lang_sense_clarification": "краткая проверка знаний в классе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a33c7e4a-ba7f-37e8-8db7-10bf29df8b29",
                    "sense_definition": "An odd, puzzling, or eccentric person or thing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "oddity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was known as quite a <w>quiz</w> in the village due to his strange habits.",
                            "target_lang_translations": {
                                "ru": "В деревне его знали как большого <w>чудака</w> из-за его странных привычек."
                            }
                        },
                        {
                            "text": "Where did you find that <w>quiz</w> of a hat that looks so unusual?",
                            "target_lang_translations": {
                                "ru": "Где ты нашел эту <w>диковинную</w> шляпу, которая выглядит так необычно?"
                            }
                        }
                    ],
                    "synonyms": [
                        "oddity",
                        "eccentric"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This sense is primarily found in 19th-century literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Странный, загадочный или эксцентричный человек или предмет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чудак",
                                "target_lang_sense_clarification": "эксцентричный человек"
                            },
                            {
                                "target_lang_word": "диковина",
                                "target_lang_sense_clarification": "необычная вещь"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "183f1535-5bd0-3b0f-aee1-eb1c1d49fc23",
                    "sense_definition": "To ask someone many questions, often in a persistent or thorough way.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "questioning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The reporters began to <w>quiz</w> the politician about the new tax policy.",
                            "target_lang_translations": {
                                "ru": "Репортеры начали <w>расспрашивать</w> политика о новой налоговой политике."
                            }
                        },
                        {
                            "text": "The police <w>quizzed</w> the suspect for several hours to find the truth.",
                            "target_lang_translations": {
                                "ru": "Полиция несколько часов <w>допрашивала</w> подозреваемого, чтобы выяснить правду."
                            }
                        }
                    ],
                    "synonyms": [
                        "question",
                        "interrogate",
                        "examine"
                    ],
                    "antonyms": [
                        "answer",
                        "reply"
                    ],
                    "common_phrases": [
                        "quiz the suspect",
                        "quiz the government"
                    ],
                    "target_lang_definitions": {
                        "ru": "Задавать кому-либо множество вопросов, часто настойчиво или тщательно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расспрашивать",
                                "target_lang_sense_clarification": "задавать много вопросов"
                            },
                            {
                                "target_lang_word": "допрашивать",
                                "target_lang_sense_clarification": "тщательно или официально опрашивать"
                            },
                            {
                                "target_lang_word": "экзаменовать",
                                "target_lang_sense_clarification": "проверять знания вопросами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "420d0787-99ca-3562-83ed-2304b465e75f",
                    "sense_definition": "To mock, tease, or make fun of someone in a playful or slightly mean way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mockery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His friends would often <w>quiz</w> him about his old-fashioned style of dress.",
                            "target_lang_translations": {
                                "ru": "Друзья часто <w>подшучивали</w> над его старомодным стилем одежды."
                            }
                        },
                        {
                            "text": "She did not appreciate being <w>quizzed</w> unmercifully by the other guests at the party.",
                            "target_lang_translations": {
                                "ru": "Ей не понравилось, что другие гости на вечеринке безжалостно её <w>подкалывали</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "tease",
                        "mock",
                        "chaff"
                    ],
                    "antonyms": [
                        "praise",
                        "compliment"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used more frequently in older English contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подшучивать, дразнить или высмеивать кого-либо в игривой или слегка злой манере."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подшучивать",
                                "target_lang_sense_clarification": "добродушно высмеивать"
                            },
                            {
                                "target_lang_word": "подкалывать",
                                "target_lang_sense_clarification": "иронично дразнить"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}