                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d9511e9-8974-44a2-b834-71a4fe00dda0",
                        "source_entry_id": "5f223ae6-f862-3b9f-9a27-395ed4404592",
                        "source_sense_id": "deec3a0d-824d-3df7-b8bc-796f71b714d1",
                        "source_sense_description": "adherent of Salafism",
                        "target_lang_word": "salafiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salafiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c57f557-5b75-3e1e-a340-cdb4525f4d71",
                                        "entry_id": "c46cb243-006f-3e53-93c4-4dab44800bc7",
                                        "glosses": [
                                            "Adepte du salafisme."
                                        ],
                                        "tags": [
                                            "Sunnisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7493ee9-93c7-40e4-8fb3-8c0347ccec16",
                                                "sense_id": "9c57f557-5b75-3e1e-a340-cdb4525f4d71",
                                                "text": "Parmi eux, j’ai reconnu Khalid, un copain d’enfance. J’étais assez étonné de voir qu’il portait la barbe et le kamis, c’est-à-dire la parfaite panoplie du bon salafiste."
                                            },
                                            {
                                                "example_id": "827a4a02-d0e4-43a7-8c8e-d66eb971d2a1",
                                                "sense_id": "9c57f557-5b75-3e1e-a340-cdb4525f4d71",
                                                "text": "Je trouvai un cybercafé deux rues plus loin, il était tenu par deux Arabes qui se ressemblaient tellement qu’ils devaient être jumeaux, et dont le look salafiste était si outré qu’ils étaient probablement inoffensifs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "salafiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8e812beb-d4c2-3997-bd25-8039ee50d14e",
                                        "entry_id": "17146dc4-966f-330c-b44e-6ac7cfea975b",
                                        "glosses": [
                                            "Relatif au salafisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1736818c-6b90-44dd-9a7c-98df00b00e63",
                                                "sense_id": "8e812beb-d4c2-3997-bd25-8039ee50d14e",
                                                "text": "Parmi les policiers surveillés, une petite dizaine se trouvent en contact avec des réseaux salafistes déjà identifiés par les flics antiterro."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4a50b8f-3799-4b1b-9521-d5a53cbebace",
                        "source_entry_id": "5f223ae6-f862-3b9f-9a27-395ed4404592",
                        "source_sense_id": "deec3a0d-824d-3df7-b8bc-796f71b714d1",
                        "source_sense_description": "adherent of Salafism",
                        "target_lang_word": "Salafist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Salafist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3109f9a-72c7-39ea-8aa9-36c8698609e7",
                                        "entry_id": "1c8cf63a-1c74-3f8a-a2ae-42bf0984a714",
                                        "glosses": [
                                            "Anhänger des Salafismus"
                                        ],
                                        "tags": [
                                            "Islam"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cc0391f-599c-409c-9299-5bf11ad01b0a",
                                                "sense_id": "e3109f9a-72c7-39ea-8aa9-36c8698609e7",
                                                "text": "„Die Salafisten wollen zur ursprünglichen Praxis des Islam zur Zeit des Propheten zurückkehren.“"
                                            },
                                            {
                                                "example_id": "74b3e378-849f-42b4-a1cd-7b83ad58d8fd",
                                                "sense_id": "e3109f9a-72c7-39ea-8aa9-36c8698609e7",
                                                "text": "„Der Streit zwischen Sunniten, Schiiten, Ibaditen, Alewiten und Salafisten um den „richtigen“ Glauben und die richtige Auslegung des Korans und der Scharia scheint ebenso unüberwindlich zu sein wie die Auseinandersetzungen zwischen katholischen, orthodoxen, koptischen, protestantisch-lutherischen, calvinistischen und sonstigen freikirchlichen Christen.“"
                                            },
                                            {
                                                "example_id": "d12b9d58-6c95-4144-9175-a3fef336454f",
                                                "sense_id": "e3109f9a-72c7-39ea-8aa9-36c8698609e7",
                                                "text": "„Theoretisch ist die Unterscheidung zwischen Islamisten und Salafisten schwierig. In der Praxis wird sie dadurch vereinfacht, dass die meisten Salafisten versuchen, sich deutlich von Islamisten abzugrenzen.“"
                                            },
                                            {
                                                "example_id": "b95876a2-509b-4eb0-a6fc-d029a8e19701",
                                                "sense_id": "e3109f9a-72c7-39ea-8aa9-36c8698609e7",
                                                "text": "„Die Salafisten rekrutieren neue Anhänger nach Angaben von Rieband bei Koran-Verteilaktionen, Islam-Seminaren oder Benefiz-Veranstaltungen für Syrien.“"
                                            },
                                            {
                                                "example_id": "c393a81f-3a90-4ffc-8d05-71b737a50934",
                                                "sense_id": "e3109f9a-72c7-39ea-8aa9-36c8698609e7",
                                                "text": "Salafisten werden meist als gefährlich eingestuft, weil ein Teil von ihnen gewaltbereit ist."
                                            },
                                            {
                                                "example_id": "0bf3e357-3741-48ad-9b51-ae54f2f9f3ce",
                                                "sense_id": "e3109f9a-72c7-39ea-8aa9-36c8698609e7",
                                                "text": "„Dem Bundesamt für Verfassungsschutz zufolge halten sich derzeit mehr Salafisten in Deutschland auf als je zuvor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0318ce26-6609-4ac2-8a22-b25292a93d63",
                        "source_entry_id": "5f223ae6-f862-3b9f-9a27-395ed4404592",
                        "source_sense_id": "deec3a0d-824d-3df7-b8bc-796f71b714d1",
                        "source_sense_description": "adherent of Salafism",
                        "target_lang_word": "Salafistin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Salafistin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "28415850-c02a-39f9-bd7e-f83a971b3879",
                                        "entry_id": "f63f2fe0-b328-34db-b456-db855dde28ce",
                                        "glosses": [
                                            "Anhängerin des Salafismus"
                                        ],
                                        "tags": [
                                            "Islam"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dfef2de-fda4-492b-905b-f3868a6c2f26",
                                                "sense_id": "28415850-c02a-39f9-bd7e-f83a971b3879",
                                                "text": "„Eine Antwortmöglichkeit »Salafi«, »Salafitin« oder »Salafist«, »Salafistin« war hierbei nicht vorgesehen.“"
                                            },
                                            {
                                                "example_id": "b1ae437d-b85b-4a5c-b3d4-7d6382fab556",
                                                "sense_id": "28415850-c02a-39f9-bd7e-f83a971b3879",
                                                "text": "„In einem Missionierungsgespräch im Internet spricht die Salafistin von dem Leid der Muslime und der Pflicht nach Syrien oder nach Afghanistan zu gehen.“"
                                            },
                                            {
                                                "example_id": "f4c281e7-2d74-4ec4-81ee-9f03438e4111",
                                                "sense_id": "28415850-c02a-39f9-bd7e-f83a971b3879",
                                                "text": "Sie wäre gerne Salafistin geworden und so wie ihr Bruder missionierend durch die Einkaufsstraßen gezogen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
