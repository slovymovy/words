                                        "glosses": [
                                            "all'interno di un ciclo frigorifero, è il componente attraverso cui il gas refrigerante assorbe calore e provvede al raffreddamento del fluido con cui si trova a contatto (aria o acqua)"
                                        ],
                                        "tags": [],
                                        "examples": []
