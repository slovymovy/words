                ],
                "translations": [
                    {
                        "translation_id": "375cfdbd-bf6b-4a24-a2d6-3828366d2f4e",
                        "source_entry_id": "a9848821-2582-3440-930d-4018a63b3774",
                        "source_sense_id": "0e1aa389-975a-3081-a47a-4f3aae743770",
                        "target_lang_word": "camper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b350ad95-8b2e-3352-9021-ce22559febd0",
                                        "entry_id": "ad29765f-5204-376d-9638-189fbc2d762a",
                                        "glosses": [
                                            "A person who camps, especially in a tent etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3f7165d-1b31-484a-b114-023d48849205",
                                                "sense_id": "b350ad95-8b2e-3352-9021-ce22559febd0",
                                                "text": "There were thousands of campers at the music festival."
                                            },
                                            {
                                                "example_id": "2732ca6e-fe17-40a5-891e-42396f130516",
                                                "sense_id": "b350ad95-8b2e-3352-9021-ce22559febd0",
                                                "text": "They're indispensable for backpackers, campers and anyone else who plans to be away from a power outlet for a while; indeed, both the Solar and the Eco Player are ruggedly built, with rubberized nonscratchable surfaces."
                                            },
                                            {
                                                "example_id": "3e0f35c4-b181-435f-bf5e-5566e5e5888d",
                                                "sense_id": "b350ad95-8b2e-3352-9021-ce22559febd0",
                                                "text": "To be sung to in this way by the entire faery kingdom, each member of it born from the heartsong of a camper, was truly a delight that not many, I believe, have known."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28e2ad95-51ce-3c64-aa07-99e36c26682b",
                                        "entry_id": "ad29765f-5204-376d-9638-189fbc2d762a",
                                        "glosses": [
                                            "A motor vehicle with a rear compartment for living and sleeping in."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c71358e2-0aee-46a1-89c5-d786b626df47",
                                                "sense_id": "28e2ad95-51ce-3c64-aa07-99e36c26682b",
                                                "text": "The moonshiners are now only a memory, but the sunrisers have grown into many hundreds, with trailers and campers pulling into Red Rock Canyon days early for a good parking spot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c27f187-4dfe-3c1e-990d-5f27e633ee87",
                                        "entry_id": "ad29765f-5204-376d-9638-189fbc2d762a",
                                        "glosses": [
                                            "A person who stays in one spot during a first-person shooting game, to guard an item etc."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
                                ]
