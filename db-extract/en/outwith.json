            {
                "entry_id": "951de336-37a1-3799-97db-8549ab9c1fb7",
                "word": "outwith",
                "pos": "prep",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1a8ef861-4018-3b86-9f33-a1a24d124a26",
                        "entry_id": "951de336-37a1-3799-97db-8549ab9c1fb7",
                        "glosses": [
                            "Outside; beyond; outside of."
                        ],
                        "tags": [
                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "9616140a-24bb-498e-acc1-fd4127cc7dec",
                                "sense_id": "1a8ef861-4018-3b86-9f33-a1a24d124a26",
                                "text": "All at once he’d wanted to buy a place there, but it had been too isolated for his wife – and outwith their means anyway."
                            },
                            {
                                "example_id": "613877c9-a1d9-4268-9458-b74a87737353",
                                "sense_id": "1a8ef861-4018-3b86-9f33-a1a24d124a26",
                                "text": "2004, Official Journal of the European Union, 24.7.2004, C190/10, reporting on a judgment of the European Court of Justice.\nFinally, the Court failed to examine, and thus to show, in what way such differentiated treatment is objectively justified. The fact that it is the result of circumstances outwith the control of the Communities does not constitute such justification […] ."
                            },
                            {
                                "example_id": "0d33c789-aa41-48ac-a931-7506fb4a60bc",
                                "sense_id": "1a8ef861-4018-3b86-9f33-a1a24d124a26",
                                "text": "It is not acceptable to have EU-US deals on extradition, information collection and exchange, and border controls which are cooked up in secret and outwith the democratic control of the European and national parliaments."
                            },
                            {
                                "example_id": "74e026a8-9f0e-463e-a4ba-770c6ef58a4f",
                                "sense_id": "1a8ef861-4018-3b86-9f33-a1a24d124a26",
                                "text": "Although Burton’s work lies outwith the scope of the current book, Cockburn’s response reveals a great deal about how Hume and his works were received in Scotland in the half century after his death […]."
                            },
                            {
                                "example_id": "7ffcdfe4-c4f0-471a-ba98-25fb6107195c",
                                "sense_id": "1a8ef861-4018-3b86-9f33-a1a24d124a26",
                                "text": "These spent convictions for most purposes only fall outwith the scope of the exception of section 4(3)(b) if they are not included in a higher level disclosure sent in connection with the profession, office, type of employment, occupation, decision or proposed decision to which the exception would otherwise apply."
                            },
                            {
                                "example_id": "c09b2daf-9768-49a5-b55f-aba13ae4be0f",
                                "sense_id": "1a8ef861-4018-3b86-9f33-a1a24d124a26",
                                "text": "To others, it is an escape, a chance to think of ways of life outwith those we experience now […]."
                            },
                            {
                                "example_id": "9e74cee8-b82f-43cc-a401-8e209c915282",
                                "sense_id": "1a8ef861-4018-3b86-9f33-a1a24d124a26",
                                "text": "Trams are one of the easiest ways to get to and from the airport with fast and frequent services to Edinburgh city centre. Trams depart every 7 minutes, between 7am and 7pm, and every 15 minutes outwith these hours, with an end-to-end journey of just 30 minutes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5945df8c-cfba-4fa5-a90b-9cebb630159f",
                        "source_entry_id": "951de336-37a1-3799-97db-8549ab9c1fb7",
                        "source_sense_id": "1a8ef861-4018-3b86-9f33-a1a24d124a26",
                        "source_sense_description": "outside; beyond; outside of",
                        "target_lang_word": "buiten",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buiten",
