        "fr-extract.jsonl": [
            {
                "entry_id": "bb9382be-1e1f-35a7-8d35-7e2efb428769",
                "word": "argumentation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "971003df-e08a-4244-bcd7-c2198afcae00",
                        "entry_id": "bb9382be-1e1f-35a7-8d35-7e2efb428769",
                        "tags": [
                            "plural"
                        ],
                        "form": "argumentations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c52e48a0-e8f7-3744-86c6-49c86c67c125",
                        "entry_id": "bb9382be-1e1f-35a7-8d35-7e2efb428769",
                        "glosses": [
                            "Action, art d’argumenter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0441b28-fe6c-4c0a-95b9-b042aab08328",
                                "sense_id": "c52e48a0-e8f7-3744-86c6-49c86c67c125",
                                "text": "L’argumentation du lieutenant Hobson, très claire, très nette, fut admise sans contestation."
                            },
                            {
                                "example_id": "a051bff2-4911-49ba-a49d-91169cdb0c3f",
                                "sense_id": "c52e48a0-e8f7-3744-86c6-49c86c67c125",
                                "text": "Le triumvirat déclenche contre lui de nouvelles polémiques, bientôt frénétiques, dans lesquelles l’argumentation fait place à une scolastique forgée pour les besoins de la cause et oppose sans fin le léninisme au trotskisme, comme la vérité révélée à l’hérésie, le mal au bien, le salut à la perdition."
                            },
                            {
                                "example_id": "a53803ba-d54b-4ec2-88f7-5b4df668b29c",
                                "sense_id": "c52e48a0-e8f7-3744-86c6-49c86c67c125",
                                "text": "Dès qu'on évoque le rôle de l'interprétation analogique dans une argumentation ou une invention scientifiques, on entend aussitôt crier haro sur la métaphore."
                            }
                        ]
                    },
                    {
                        "sense_id": "df06ccfb-5d71-3ff6-8e8c-22a5025121f3",
                        "entry_id": "bb9382be-1e1f-35a7-8d35-7e2efb428769",
                        "glosses": [
                            "Ensemble d’arguments tendant à une même conclusion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be915392-f084-473f-b603-22ea28233936",
                                "sense_id": "df06ccfb-5d71-3ff6-8e8c-22a5025121f3",
                                "text": "L’argumentation que propose cet homme politique est très faible : ce n’est que pétition de principe, arguments ad hominem et sophismes grossiers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76bb2aa4-aceb-4af6-a764-3c4b6155a4d4",
                        "source_entry_id": "bb9382be-1e1f-35a7-8d35-7e2efb428769",
                        "target_lang_word": "argumentation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "argumentation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dcec9c3f-a07f-3024-a823-ec6862157af5",
                                        "entry_id": "46330b21-acd7-3a07-a112-f1af32467613",
                                        "glosses": [
                                            "Inference based on reasoning from given propositions."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a88a044-473c-42af-b6a9-a89bbeca1f44",
                                                "sense_id": "dcec9c3f-a07f-3024-a823-ec6862157af5",
                                                "text": "His chain of argumentation is flawed."
                                            },
                                            {
                                                "example_id": "fcb357cd-fd06-40e5-9363-4fdf8d61336a",
                                                "sense_id": "dcec9c3f-a07f-3024-a823-ec6862157af5",
                                                "text": "None of the traditional proposals suffers from the weaknesses characteristic of CAW's suggestions: what CAW has to offer are mere guesses, arrived at in a totally unsystematic way and totally unsupported by rational and reasonable argumentation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15e2aa02-a972-34f8-bdba-60c7f2673d1a",
                                        "entry_id": "46330b21-acd7-3a07-a112-f1af32467613",
                                        "glosses": [
                                            "An exchange of arguments"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9cc2bfd-b311-4343-b73a-14eb23392c4d",
                                                "sense_id": "15e2aa02-a972-34f8-bdba-60c7f2673d1a",
                                                "text": "Their argumentation continued long into the night."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07e2cde1-1ffe-3cdb-ba3e-d9feb8ff32df",
                                        "entry_id": "46330b21-acd7-3a07-a112-f1af32467613",
                                        "glosses": [
                                            "The addition of arguments to a model; parameterization."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4500ee93-4b50-44c4-b3e1-5540ebf17f0f",
                                                "sense_id": "07e2cde1-1ffe-3cdb-ba3e-d9feb8ff32df",
                                                "text": "An argumentation framework has an obvious representation as a directed graph where nodes are arguments and edges are drawn from attacking to attacked arguments."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
