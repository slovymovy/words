                "senses": [
                    {
                        "sense_id": "7e302192-5f29-38f4-bdaf-a30058059428",
                        "entry_id": "f10b0df5-0004-3861-935e-c558de1f14fe",
                        "glosses": [
                            "Perdre son intérêt sentimental pour quelqu’un."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "6273e957-04bf-4deb-9e12-7c578ce4707f",
                                "sense_id": "7e302192-5f29-38f4-bdaf-a30058059428",
                                "text": "Et parfois je crushe sur un profil, j’essaye de faire bonne impression, j’y arrive et puis à un moment où à un autre je décrushe pour un détail, une impression, un essoufflement… C’est lassant, continuel, et ça finit pas ne plus être vraiment drôle."
                            },
                            {
                                "example_id": "f5cf0fad-666e-4ed2-9e5f-ec6ff37cf712",
                                "sense_id": "7e302192-5f29-38f4-bdaf-a30058059428",
                                "text": "Vous faites comment pour décrusher ?"
                            },
                            {
                                "example_id": "7861b517-f7f4-4051-80c5-4b2090492094",
                                "sense_id": "7e302192-5f29-38f4-bdaf-a30058059428",
                                "text": "Se décrusher du charos avec lequel elle n'a pas des bails... en voilà une belle mission..."
                            }
                        ]
                    }
                ],
