                        ],
                        "form": "der Elektromobilität"
                    },
                    {
                        "form_id": "a3b3d107-5655-4b18-bd09-039af257629e",
                        "entry_id": "5b43a400-6192-30f5-a297-a1d830390e0a",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Elektromobilität"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bd43d3ad-3eb3-3bb6-ae48-65b39688ee49",
                        "entry_id": "5b43a400-6192-30f5-a297-a1d830390e0a",
                        "glosses": [
                            "Teil des Verkehrs, bei dem Elektrofahrzeuge eingesetzt werden"
                        ],
                        "tags": [
                            "Transport"
                        ],
                        "examples": [
                            {
                                "example_id": "2796851a-86f8-4578-98e4-0ef36bf35c14",
                                "sense_id": "bd43d3ad-3eb3-3bb6-ae48-65b39688ee49",
                                "text": "„Die Regierung hat die Konzerne dabei gewähren lassen und sie nicht zum Einstieg in die Elektromobilität gedrängt.“"
                            },
                            {
                                "example_id": "d111bfce-fbbf-4de2-bd4d-3a6c63674f2f",
                                "sense_id": "bd43d3ad-3eb3-3bb6-ae48-65b39688ee49",
                                "text": "„Der frühere CSU-Generalsekretär gefällt sich in der Rolle des Innovationsministers, der nicht nur durch die entlegensten Gebiete des Landes Datenautobahnen ziehen, sondern auch die Elektromobilität entscheidend voranbringen möchte.“"
                            },
                            {
                                "example_id": "bf62b7bd-e0d9-47e7-a107-3020cc2bd8ac",
                                "sense_id": "bd43d3ad-3eb3-3bb6-ae48-65b39688ee49",
                                "text": "„Sexton wurde gefeuert, aber sie blieb eine Fürsprecherin der Elektromobilität – und eine Kritikerin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6659c847-452e-4096-ac0b-1a431a62789c",
                        "source_entry_id": "5b43a400-6192-30f5-a297-a1d830390e0a",
                        "source_sense_id": "bd43d3ad-3eb3-3bb6-ae48-65b39688ee49",
                        "source_sense_description": "Transport: Teil des Verkehrs, bei dem Elektrofahrzeuge eingesetzt werden",
                        "target_lang_word": "electromobility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "electromobility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5f31706-1a1a-361e-b3d7-ec0c51eb1df9",
                                        "entry_id": "f06ce7c2-7f94-3f3a-b101-0aae39290a8f",
                                        "glosses": [
                                            "electrophoretic mobility"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e869eb5d-3953-3d56-9c15-2ef6008d157b",
                                        "entry_id": "f06ce7c2-7f94-3f3a-b101-0aae39290a8f",
                                        "glosses": [
                                            "Synonym of emobility."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "201a0c18-4b02-4145-b4d9-b91ded674d62",
                                                "sense_id": "e869eb5d-3953-3d56-9c15-2ef6008d157b",
                                                "text": "Seen in this context, innovation in electromobility (eMobility) takes on a special significance. eMobility is not only an alternative drive technology that can be substituted for the combustion engine that has dominated until now, it could revolutionize transport altogether because it differs decisively from conventional automobility."
                                            },
                                            {
                                                "example_id": "0349663d-9d1e-456c-8f18-eb64b2ae7ad2",
                                                "sense_id": "e869eb5d-3953-3d56-9c15-2ef6008d157b",
                                                "text": "Between 1907 and 1941 the U.S. manufacturer “Detroit Electric” produced more than 12.000 electric cars and over 500 electric trucks. After almost one century of shadowy existence the topic of electromobility is more up to date than ever."
                                            },
                                            {
                                                "example_id": "3d1ce2fd-717e-4f96-b45b-5ddf933d0614",
                                                "sense_id": "e869eb5d-3953-3d56-9c15-2ef6008d157b",
                                                "text": "The TU Munich is broadly positioned in the field of electromobility, working across the board from basic research to application-based research."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "823ff40d-8043-436e-9a34-3b49f719aa1a",
                        "source_entry_id": "5b43a400-6192-30f5-a297-a1d830390e0a",
                        "source_sense_id": "bd43d3ad-3eb3-3bb6-ae48-65b39688ee49",
                        "source_sense_description": "Transport: Teil des Verkehrs, bei dem Elektrofahrzeuge eingesetzt werden",
                        "target_lang_word": "emobility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emobility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bfa75b6c-fb99-357e-8a6d-69f2e93421a1",
                                        "entry_id": "2399c002-ce5e-34fb-9685-dbd34761484d",
                                        "glosses": [
                                            "The use of electric vehicles, including the technology and infrastructure to support that use."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "374eeb65-c5a8-4c99-aefe-c867efd7dd22",
                                                "sense_id": "bfa75b6c-fb99-357e-8a6d-69f2e93421a1",
                                                "text": "What cannot be denied is that the Chinese government wants emobility, and is willing to spend money to get it."
                                            },
                                            {
                                                "example_id": "8752a9ee-75b5-4cc9-87a7-f482c4a237be",
                                                "sense_id": "bfa75b6c-fb99-357e-8a6d-69f2e93421a1",
                                                "text": "To make an emobility project successful, finance is required for both vehicle and service."
                                            },
                                            {
                                                "example_id": "5bece820-c2e4-4180-a73c-fcd498a32564",
                                                "sense_id": "bfa75b6c-fb99-357e-8a6d-69f2e93421a1",
                                                "text": "The ongoing emobility market development, which shows an increasing electric vehicle (EV) market coverage, is an excellent field of investigation for studying the generative potential of digitization and DT."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbbcf0a1-867f-4d37-a961-f08bd8e1062e",
                        "source_entry_id": "5b43a400-6192-30f5-a297-a1d830390e0a",
                        "source_sense_id": "bd43d3ad-3eb3-3bb6-ae48-65b39688ee49",
                        "source_sense_description": "Transport: Teil des Verkehrs, bei dem Elektrofahrzeuge eingesetzt werden",
                        "target_lang_word": "électromobilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "électromobilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cebfb2ed-1b49-310e-ae8b-03bf9d84ea45",
                                        "entry_id": "773b7b32-d67c-30a6-9469-8242df5bd7fc",
                                        "glosses": [
                                            ", Ce qui a trait à la mobilité ayant recours à l’énergie électrique, et plus particulièrement dans le domaine de l’automobile."
                                        ],
                                        "tags": [
                                            "Électrotechnique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "741dc46d-6714-442d-8532-24d6d98835d3",
                                                "sense_id": "cebfb2ed-1b49-310e-ae8b-03bf9d84ea45",
                                                "text": "Les tests vont aussi fournir des renseignements sur l’infrastructure requise pour l’électromobilité, les comportements des usagers et les demandes pour de futurs produits."
                                            },
                                            {
                                                "example_id": "2b0371d8-7bcd-4805-949a-115cea17f1a2",
                                                "sense_id": "cebfb2ed-1b49-310e-ae8b-03bf9d84ea45",
                                                "text": "Afin de contribuer à une électromobilité durable, la compatibilité écologique des batteries lithium-air joue un rôle déterminant au sein du projet."
                                            },
                                            {
                                                "example_id": "30c62860-6419-4564-98fa-1bcb0c834bb3",
                                                "sense_id": "cebfb2ed-1b49-310e-ae8b-03bf9d84ea45",
                                                "text": "Entre les acteurs publics et les usagers, les relations formelles se traduisent par des mesures fiscales nationales en défaveur des véhicules polluants (malus écologique) ou en faveur de l’équipement électromobile, mises en œuvre pour pallier le prix élevé du passage à l’électromobilité […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c76c458f-004b-4db6-a262-7589bcda6702",
                        "source_entry_id": "5b43a400-6192-30f5-a297-a1d830390e0a",
