                                "example_id": "ead59fac-35ae-42aa-a048-bf167943482d",
                                "sense_id": "2667990f-02b3-3fb2-bdd6-e86ea20c4699",
                                "text": "„Außerdem verabschiedete Schmalge Hannelore Clausjürgens, Hannelore Reckstat und Annegret Schlinkheider in den Ruhestand.“"
                            },
                            {
                                "example_id": "6bf3e1b7-8dec-4aa5-9244-186dc46af2f4",
                                "sense_id": "2667990f-02b3-3fb2-bdd6-e86ea20c4699",
                                "text": "„Dem Sozialdemokraten Otto Reckstat, der in Nordhausen zur Symbolfigur des Arbeiteraufstands am 17. Juni 1953 in der DDR wurde, gedachte am Samstag die Nordhäuser SPD.“"
                            }
