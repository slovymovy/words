                ],
                "senses": [
                    {
                        "sense_id": "d21e711c-f42e-3a9e-9421-6c80df7e8299",
                        "entry_id": "09c36e9e-f5e9-3543-aaae-760d9aff6715",
                        "glosses": [
                            "Kleidungsstücke für eine Puppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "741aa034-40c9-4a36-9da1-1cac36818d03",
                                "sense_id": "d21e711c-f42e-3a9e-9421-6c80df7e8299",
                                "text": "„Spencer war in das Stadthaus mit eingezogen und unsere Tochter liebte es, dem armen Kerl Puppenkleidung anzuziehen und ihn in den Kinderwagen zu stecken.“"
                            },
                            {
                                "example_id": "8dd72b02-6060-4893-8d4c-2e691ac30d29",
                                "sense_id": "d21e711c-f42e-3a9e-9421-6c80df7e8299",
                                "text": "„Die zwei Katzen mussten es ertragen, dass ich ihnen Puppenkleidung anzog und sie in meinem Puppenwagen durchs Dorf spazieren fuhr.“"
                            },
                            {
                                "example_id": "5af0025e-5722-499b-9f7f-0ace8705540e",
                                "sense_id": "d21e711c-f42e-3a9e-9421-6c80df7e8299",
                                "text": "„Ich wurde gebadet, im Puppenwagen herumgefahren, ich musste Puppenkleidung tragen, es war schrecklich.“"
                            },
                            {
                                "example_id": "665c7844-938c-4256-8adb-9bcbbfcfeeda",
                                "sense_id": "d21e711c-f42e-3a9e-9421-6c80df7e8299",
                                "text": "„Mir machte es richtig Spaß, Puppenkleidung herzustellen, meine Begeisterung ließ jedoch eines Tages nach, als ich eine Nadel auf dem Teppich vergaß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
