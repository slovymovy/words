                                    {
                                        "sense_id": "4c6ccc1b-6f0c-36ed-aef4-0d966536cee4",
                                        "entry_id": "4fbc5a36-0564-3932-9b2d-2faaf031bdba",
                                        "glosses": [
                                            "Zone de circulation atmosphérique autour d’un centre de haute pression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2bc095a-5903-4c4b-96ef-c78266844c8c",
                                                "sense_id": "4c6ccc1b-6f0c-36ed-aef4-0d966536cee4",
                                                "text": "Le retour de l'anticyclone nous assure de beaux jours."
                                            },
                                            {
                                                "example_id": "a55fad25-6c9a-464f-b1d1-8398a25250c8",
                                                "sense_id": "4c6ccc1b-6f0c-36ed-aef4-0d966536cee4",
                                                "text": "L’anticyclone des Açores."
                                            },
                                            {
                                                "example_id": "a7e7b94c-7967-4942-8054-d34b5b74dbcf",
                                                "sense_id": "4c6ccc1b-6f0c-36ed-aef4-0d966536cee4",
                                                "text": "On distingue deux types d’anticyclones : l’anticyclone froid et l’anticyclone chaud."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anticyclone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "125eb9ff-e219-3f17-9e0e-55ab4fac59bd",
                                        "entry_id": "9ea9f3a4-e241-30aa-8e83-1b2387af96fd",
                                        "glosses": [
                                            "La Réunion Caractérise du matériel de construction supposé résister à des vents très violents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "143925d3-1fab-4005-a885-5dfd52459d22",
                                                "sense_id": "125eb9ff-e219-3f17-9e0e-55ab4fac59bd",
                                                "text": "Quand elle eut fini, deux manœuvres vinrent fixer aussi des volets anticyclone, et ramasser les sièges qui gisaient encore sur la terrasse, renversés et trempés de pluie."
                                            },
                                            {
                                                "example_id": "64189a06-cd71-4a48-8322-3a760fbd8cd4",
                                                "sense_id": "125eb9ff-e219-3f17-9e0e-55ab4fac59bd",
                                                "text": "I1 ressort à l'évidence de ce qui précède qu'une réglementation de la construction anticyclone doit entrer en vigueur au plus tôt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
