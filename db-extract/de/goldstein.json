                ],
                "senses": [
                    {
                        "sense_id": "a24f50ca-e717-3376-a338-09b23f8c7eb7",
                        "entry_id": "634438d9-68d0-3f6d-b309-f0df4ac22455",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b904801d-6eb6-481e-ac50-6f4f45c183cb",
                                "sense_id": "a24f50ca-e717-3376-a338-09b23f8c7eb7",
                                "text": "Frau Goldstein ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "391f9dd4-f3f9-497d-bf9d-ed294f839cb6",
                                "sense_id": "a24f50ca-e717-3376-a338-09b23f8c7eb7",
                                "text": "Herr Goldstein wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0a51d0e4-1b19-422f-9508-f5e901287251",
                                "sense_id": "a24f50ca-e717-3376-a338-09b23f8c7eb7",
                                "text": "Die Goldsteins fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "e2c08da7-f313-47d9-807f-4b61bca6ec8d",
                                "sense_id": "a24f50ca-e717-3376-a338-09b23f8c7eb7",
                                "text": "Der Goldstein trägt nie die Schals, die die Goldstein ihm strickt."
                            },
                            {
                                "example_id": "5692b98c-d282-4057-8907-9394d2d98636",
                                "sense_id": "a24f50ca-e717-3376-a338-09b23f8c7eb7",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Goldstein kommt, geht der Herr Goldstein.“"
                            },
                            {
                                "example_id": "6628528a-bab1-455b-87d5-06492ee1aa67",
                                "sense_id": "a24f50ca-e717-3376-a338-09b23f8c7eb7",
                                "text": "Goldstein kommt und geht."
                            },
                            {
                                "example_id": "f67e4de8-3d4a-4d70-99f9-9545d99d40df",
                                "sense_id": "a24f50ca-e717-3376-a338-09b23f8c7eb7",
                                "text": "Goldsteins kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
