                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op dit <w>ogenblik</w> heb ik geen tijd om te praten.",
                            "target_lang_translations": {
                                "en": "At this <w>moment</w> I do not have time to talk.",
                                "ru": "В данный <w>момент</w> у меня нет времени разговаривать.",
                                "pl": "W tym <w>momencie</w> nie mam czasu na rozmowę.",
                                "de": "In diesem <w>Augenblick</w> habe ich keine Zeit zu reden.",
                                "fr": "En ce <w>moment</w>, je n'ai pas le temps de parler.",
