                        "glosses": [
                            "To undo an act of cheating."
                        ],
                        "tags": [
                            "ambitransitive",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "acd98a47-715e-453b-983e-c89aa72c2e45",
                                "sense_id": "6005a64f-debd-310a-b0e9-32ad069ed8df",
                                "text": "Those who manage it can uncheat you and give you your inheritance."
                            },
                            {
                                "example_id": "0f72099a-c672-4e62-bc0c-40fb6d7be753",
                                "sense_id": "6005a64f-debd-310a-b0e9-32ad069ed8df",
                                "text": "You can't […] uncheat on a test. Nothing can completely undo what you did—whether it's a sin or a mistake or a bit of both."
                            },
                            {
                                "example_id": "fa52e25c-1545-4134-a362-06e2bf65fd64",
                                "sense_id": "6005a64f-debd-310a-b0e9-32ad069ed8df",
                                "text": "\"Build a time machine,\" she'd said. \"And go back, and uncheat.\""
                            }
                        ]
                    }
