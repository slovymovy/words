                "senses": [
                    {
                        "sense_id": "90d90250-3fac-3603-b682-9ce0d0ece0f3",
                        "entry_id": "73cd717f-0725-36de-b6c2-47915d237a77",
                        "glosses": [
                            "ein eingeschossiges, in sich geschlossenes Wohnhaus auf dem Dach eines Hochhauses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e60db56-5240-48fe-856d-f79300c50ea9",
                                "sense_id": "90d90250-3fac-3603-b682-9ce0d0ece0f3",
                                "text": "Wann ist der Besichtigungstermin für das Penthouse?"
                            },
                            {
                                "example_id": "f68fa8f6-27af-41e8-b0e8-750934a4cd87",
                                "sense_id": "90d90250-3fac-3603-b682-9ce0d0ece0f3",
                                "text": "„Als keine drei Monate nach ihrer Heirat das Haus, in dem sie bis vor Kurzem gewohnt hatte, eingerüstet wurde, stand Mây ungläubig vor dem großen Plakat, das ein Penthouse im Dachgeschoss ankündigte und zu einer ihr unvorstellbaren Summe zum Kauf ausschrieb.“"
                            },
                            {
                                "example_id": "dfdee295-5301-4b8a-889a-3c02b9aff94f",
                                "sense_id": "90d90250-3fac-3603-b682-9ce0d0ece0f3",
                                "text": "„Die Frau bewohnte ein Penthouse am Stadtrand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf4a422f-f2a1-4f23-8081-bba0276d51fa",
                        "source_entry_id": "73cd717f-0725-36de-b6c2-47915d237a77",
                        "source_sense_id": "90d90250-3fac-3603-b682-9ce0d0ece0f3",
                        "source_sense_description": "Architektur: ein eingeschossiges, in sich geschlossenes Wohnhaus auf dem Dach eines Hochhauses",
                        "target_lang_word": "penthouse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "penthouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24811c31-7d5e-3605-b767-4c0888ccf90b",
                                        "entry_id": "53703889-add9-39cc-8a2b-cd465c9f7309",
                                        "glosses": [
                                            "A structure or annexe (especially one with a sloping roof) extending from the side of a building, sometimes as protection from the weather."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0304c1d-6f13-4535-b200-77f61aad99c6",
                                                "sense_id": "24811c31-7d5e-3605-b767-4c0888ccf90b",
                                                "text": "At length, recommending himself to God, he let go one end of his cord, and suffered himself to fall down upon an old shed or penthouse, which, with the weight of his body, fell in with great noise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e434fa3f-687b-35c4-849b-47ebb2325c31",
                                        "entry_id": "53703889-add9-39cc-8a2b-cd465c9f7309",
                                        "glosses": [
                                            "Something forming a shelter or canopy over something; an awning, shelter, etc."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31a09ef4-0fa7-4623-bdc6-e2c8f6d9ae54",
                                                "sense_id": "e434fa3f-687b-35c4-849b-47ebb2325c31",
                                                "text": "The proboscis […] is doubled up by means of the joint, and in that position lies secure under a scaly penthouse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2abbc87c-4523-3dbc-be8a-5293a99ef466",
                                        "entry_id": "53703889-add9-39cc-8a2b-cd465c9f7309",
                                        "glosses": [
                                            "Any of the sloping roofs at the side of a real tennis court."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca91b8d1-42cd-4cb8-a298-8abc83bb8e98",
                                                "sense_id": "2abbc87c-4523-3dbc-be8a-5293a99ef466",
                                                "text": "2005, Tony Collins (ed.), Encyclopaedia of Traditional British Rural Sports, Routledge, page 262,\nAn odd derivative of real tennis lasted until the latter part of the eighteenth century at Rattray in Perthshire. It was played in the churchyard by two pairs of men, and the method for starting the play was to throw the ball onto the church roof, using it like the sloping penthouse of the tennis court."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5405273f-6e37-3f4a-91cc-a9a7d93eb291",
                                        "entry_id": "53703889-add9-39cc-8a2b-cd465c9f7309",
                                        "glosses": [
                                            "An apartment or suite found on an upper floor, or floors, of a tall building, especially one that is expensive or luxurious with panoramic views."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f65bfb5-6b4d-451f-ae51-efdf3d2f30a9",
                                                "sense_id": "5405273f-6e37-3f4a-91cc-a9a7d93eb291",
                                                "text": "Night of January 16th is the story of a woman on trial for pushing her wealthy boss-lover from a Manhattan penthouse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "penthouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ca984c4-33d2-3d18-b8ef-376df0d61726",
                                        "entry_id": "24d28ec5-b740-385c-819b-0454eb817663",
                                        "glosses": [
                                            "To provide with a penthouse, shelter by means of a shed sloping from a wall, or anything similar."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "463b3432-ea35-4629-bb44-ff4706a5a642",
                        "source_entry_id": "73cd717f-0725-36de-b6c2-47915d237a77",
                        "source_sense_id": "90d90250-3fac-3603-b682-9ce0d0ece0f3",
                        "source_sense_description": "Architektur: ein eingeschossiges, in sich geschlossenes Wohnhaus auf dem Dach eines Hochhauses",
                        "target_lang_word": "attique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d978a1d9-429a-3d12-b8df-c080219bb4f7",
                                        "entry_id": "dc57053f-7dda-361c-991d-97865e3a245c",
                                        "glosses": [
                                            "Étage placé au sommet ou au milieu d’un édifice, de proportions moindres que les étages supérieurs ou inférieurs, séparé par une corniche du reste de la construction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d620e54c-883f-42b4-90f6-ecfb2202fee0",
                                                "sense_id": "d978a1d9-429a-3d12-b8df-c080219bb4f7",
                                                "text": "… deux pavillons d’angles décorés de pilastres et d’attiques."
                                            },
                                            {
                                                "example_id": "40b13ff5-a943-49e6-8856-0c9391cacd8f",
                                                "sense_id": "d978a1d9-429a-3d12-b8df-c080219bb4f7",
                                                "text": "[…]: le rez-de-chaussée avec arcades et bossages, l’étage noble, l’attique enfin, surbaissé et à fenêtres carrées."
                                            },
                                            {
                                                "example_id": "27b54580-30d0-43dc-8f33-5199a5b93787",
                                                "sense_id": "d978a1d9-429a-3d12-b8df-c080219bb4f7",
                                                "text": "Rome est une ville “renversante” – à voir aussi de bas en haut, comme New York : corniches lointaines des palazzi romains, attiques inaccessibles – ce peuple de statues à l’extrémité de certaines terrasses (à Saint-Jean-de-Latran, Saint-Pierre, sur les palais du Capitole) - ; plafonds élevés où, dans le prolongement des colonnes et pilastres, des architectures peintes ouvrent sur de faux ciels, ceux de Saint-Ignace dans l’apothéose d’Ignace de Loyola, peinte par Pozzo, ceux du palais Barberini dus à Pierre de Cortone, ou encore ceux de Michel-Ange à la Sixtine."
                                            },
                                            {
                                                "example_id": "c74852b0-a4bb-4987-be26-22fe02bb0b96",
                                                "sense_id": "d978a1d9-429a-3d12-b8df-c080219bb4f7",
                                                "text": "Au-dessus du second ordre est un attique, un petit attique."
                                            },
                                            {
                                                "example_id": "76de2e89-a91b-4ce7-858f-1e07910e7068",
                                                "sense_id": "d978a1d9-429a-3d12-b8df-c080219bb4f7",
                                                "text": "On a couronné ce bâtiment d’un attique, pour en cacher le toit."
                                            },
                                            {
                                                "example_id": "c05af1eb-56cf-49d2-8e08-5a10e6e73536",
                                                "sense_id": "d978a1d9-429a-3d12-b8df-c080219bb4f7",
                                                "text": "L’attique du palais de Versailles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc9397ee-bf98-3d6b-9dd5-cc4a146597c9",
                                        "entry_id": "dc57053f-7dda-361c-991d-97865e3a245c",
                                        "glosses": [
                                            "Ancienne dénomination du récessus épitympanique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "attique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2fcc51e6-3711-3743-8569-0b5ff2d14b21",
                                        "entry_id": "39c57c99-ea7e-37fd-9b45-03d235160024",
                                        "glosses": [
                                            "Propre à l’Attique ou, en particulier, à Athènes durant l’Antiquité"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5acba18e-9849-33ab-b072-fcce13e21a60",
                                        "entry_id": "39c57c99-ea7e-37fd-9b45-03d235160024",
                                        "glosses": [
                                            "Qui est fin, délicat, par allusion à la délicatesse et à la finesse du goût athénien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1c9e07d-9f23-4964-9bf2-a6b2ad4f71ef",
                                                "sense_id": "5acba18e-9849-33ab-b072-fcce13e21a60",
                                                "text": "La plaisanterie du paysan et de l’ouvrier est très attique, elle consiste à dire toute la pensée en la grossissant par une expression grotesque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77e71afb-24af-36a2-a28b-e221e8406f79",
                                        "entry_id": "39c57c99-ea7e-37fd-9b45-03d235160024",
                                        "glosses": [
                                            "Écrivain élégant et distingué."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "daa7900f-08e8-31e0-b87e-5032741e2aa1",
                                        "entry_id": "39c57c99-ea7e-37fd-9b45-03d235160024",
                                        "glosses": [
                                            "Qui consiste en pilastres raccourcis proportionnellement à l’étage qu’ils décorent et qui porte lui-même le nom d’étage attique ou, par ellipse, d’attique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba68edd2-1d22-3e27-ab8e-f74a893ba9dc",
                                        "entry_id": "39c57c99-ea7e-37fd-9b45-03d235160024",
                                        "glosses": [
                                            "Qualifie l’étage placé au sommet ou au milieu d’un édifice, de proportions moindres que les étages supérieurs ou inférieurs, séparé par une corniche du reste de la construction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
