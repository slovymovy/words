                "senses": [
                    {
                        "sense_id": "538af149-2c8e-3718-8f5f-c25248a2bd15",
                        "entry_id": "d6f37151-565b-3bfb-a0e2-9813741b53e7",
                        "glosses": [
                            "mit dem Verkehren verfolgtes Ziel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8252dbac-f1ca-461e-ac6f-c88037324c50",
                                "sense_id": "538af149-2c8e-3718-8f5f-c25248a2bd15",
                                "text": "„Sie (die Straße) ist Symbol für Verkehrsgeschichte und Verkehrsabsichten der betreffenden Gesellschaft und Teilgesellschaft […]."
                            },
                            {
                                "example_id": "6524abe8-65f5-4558-b639-fe8c9681822b",
                                "sense_id": "538af149-2c8e-3718-8f5f-c25248a2bd15",
                                "text": "„Zunächst einmal müssen die Verkehrsabsichten auf dem Gleis festgestellt werden.“"
                            },
                            {
                                "example_id": "15605f62-7fc8-4776-af89-fcc4063e0d1a",
                                "sense_id": "538af149-2c8e-3718-8f5f-c25248a2bd15",
                                "text": "„Das Kind muss in die Lage versetzt werden, sich selbstständig und selbstbewusst im Verkehr zu bewegen und dabei konsequent seine Verkehrsabsichten zu verfolgen.“"
                            },
                            {
                                "example_id": "72e6a53b-d6f9-4d9b-843a-5576e69b9672",
                                "sense_id": "538af149-2c8e-3718-8f5f-c25248a2bd15",
                                "text": "„Der Schüler/die Schülerin muss befähigt werden, sich selbstständig und selbstbewusst im System Verkehr zu bewegen und dabei die eigenen Verkehrsabsichten für alle nachvollziehbar zu verfolgen.“"
                            },
                            {
                                "example_id": "1e32d383-05a3-4ca3-bd09-2d9171dbdba8",
                                "sense_id": "538af149-2c8e-3718-8f5f-c25248a2bd15",
                                "text": "„Das anzuwendende Betriebskonzept beruht auf der zur Zeit angewandten Unterteilung zwischen diesen Gruppen von Verkehrsteilnehmern, die den gleichen Luftraum mit unterschiedlicher Ausrüstung und teilweise diametral entgegengesetzten Verkehrsabsichten beanspruchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
