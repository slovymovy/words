                                                "text": "In der Lotterie wird eine Auslosung gemacht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20cec6d1-6554-475e-b582-4505ef1755c5",
                        "source_entry_id": "96d80394-9d54-3e25-8f49-9b9de8122821",
                        "target_lang_word": "inlossing",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inlossing",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8583efc1-a788-35af-ad20-b3a48e7618ea",
                                        "entry_id": "61a967f2-4551-39a2-a710-a7edbef30680",
                                        "glosses": [
                                            "nakomen van een gedane belofte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6a244dc-4fd4-4ab4-9b16-766d1d8e9a07",
                                                "sense_id": "8583efc1-a788-35af-ad20-b3a48e7618ea",
                                                "text": "De weddenschap dateert al van het eerste seizoen van beide teams in de F1, dat was in 2010. Virgin van Branson eindigde daarin 12de, Fernandes' Lotus sloot het seizoen af op een tiende plek. De inlossing van de belofte werd echter uitgesteld door een ski-ongeluk van Branson."
                                            },
                                            {
                                                "example_id": "2d7ed651-5016-4b78-ae4f-d13de49c9e47",
                                                "sense_id": "8583efc1-a788-35af-ad20-b3a48e7618ea",
                                                "text": "Deze herinneringen, later gebundeld in één deel en ook in Duitsland verschenen, waren de late inlossing van een al jaren door de auteur aangekondigd boek onder de omineuze titel Kaddish voor een buurt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e3b105e-9d61-344e-924b-beb81160719c",
                                        "entry_id": "61a967f2-4551-39a2-a710-a7edbef30680",
                                        "glosses": [
                                            "afbetalen van een schuld"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dd4e306-caaf-4935-acb3-596835db027b",
                                                "sense_id": "6e3b105e-9d61-344e-924b-beb81160719c",
                                                "text": "Volgens een persbericht van AZ heeft de directie van de club de inlossing van de schuld kunnen voltooien door een percentage af te dragen van afgesloten transfers in de afgelopen 2 jaar. De commissaris die namens de curatoren zitting had in de raad van commissarissen, zal zijn taak beëindigen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
