                "senses": [
                    {
                        "sense_id": "2e3bc84a-f08f-326d-a5b6-986781d0b457",
                        "entry_id": "9c65ff25-0827-31f5-afe0-1843694bf781",
                        "glosses": [
                            "in einem an Alabaster erinnernden Weiß"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e52bd403-d4b4-4361-b056-29b511a5f726",
                                "sense_id": "2e3bc84a-f08f-326d-a5b6-986781d0b457",
                                "text": "„Da war irgendetwas an ihrer Fülle, an ihrem großen, alabasterweißen Bauch, der so einladend hervorragte, prall gespannt, und an dem üppigen, wunderschönen, beinahe schwarzen Busch zwischen ihren Beinen, und dann...“"
                            },
                            {
                                "example_id": "2f976b59-93e0-46be-9909-886d64e8f0d3",
                                "sense_id": "2e3bc84a-f08f-326d-a5b6-986781d0b457",
                                "text": "„Das milchweiße, alabasterweiße Profil liegt wie eine riesige Kamee im tiefen Blau des Pazifischen Ozeans.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
