                            {
                                "example_id": "36480a7f-ffba-4c81-93dd-0d6d8f048099",
                                "sense_id": "9d662fa7-0e95-3c18-bb38-283740a24145",
                                "text": "Er was tachtig jaar oorlog, waarna de vrede van Munster gesloten werd."
                            },
                            {
                                "example_id": "22830971-368a-4e29-b495-6c3fe848331a",
                                "sense_id": "9d662fa7-0e95-3c18-bb38-283740a24145",
                                "text": "Tussen drie tenten was nog net genoeg ruimte om mijn eigen tent op te zetten, waarna ik bij een groep rond het kampvuur ging zitten."
                            },
                            {
                                "example_id": "a2f18626-1eb1-4a16-9d79-e253965187f2",
                                "sense_id": "9d662fa7-0e95-3c18-bb38-283740a24145",
                                "text": "Vincenzo knikt, waarna ze beiden hun schoenen uit gooien en tot de enkels het water in plonsen."
                            }
                        ]
                    }
