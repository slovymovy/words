                                "target_senses": [
                                    {
                                        "sense_id": "3b9748fa-4db3-3127-8733-831723b1410e",
                                        "entry_id": "7a4247fe-3166-36ec-845d-492d83412007",
                                        "glosses": [
                                            "mehrere Jahrhunderte dauernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83884bb0-c072-4565-88f2-3f7651c75ce0",
                                                "sense_id": "3b9748fa-4db3-3127-8733-831723b1410e",
                                                "text": "Jahrhundertelang glaubten die Menschen, dass die Sonne um die Erde kreise."
                                            },
                                            {
                                                "example_id": "e146ee23-b911-493a-8f2e-5168683fc8e7",
                                                "sense_id": "3b9748fa-4db3-3127-8733-831723b1410e",
                                                "text": "„Wir haben die Regeln der Grammatik als das Ergebnis eines jahrhundertelangen Prozesses der Abstraktion von den konkreten Einzelfällen der Sprachwirklichkeit kennengelernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "588ec924-8010-4772-abbe-4b338b0df4e0",
                        "source_entry_id": "735eee36-cc84-3203-9b9a-0a71861096a8",
