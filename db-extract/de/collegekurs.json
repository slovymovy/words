                "senses": [
                    {
                        "sense_id": "7e204bcb-57ec-32ff-95b0-59a234ae48ec",
                        "entry_id": "2590c25a-d5dc-328b-8571-0ff0a69e0f65",
                        "glosses": [
                            "Kurs an einem College"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "961c1c42-7456-4416-9425-1ed54b4447d3",
                                "sense_id": "7e204bcb-57ec-32ff-95b0-59a234ae48ec",
                                "text": "„Shasta würde einen Collegekurs nach dem anderen abschließen, während ihre männlichen Kommilitonen eingezogen wurden.“"
                            },
                            {
                                "example_id": "08a8a061-8c71-4a80-a74a-1580a7cb55b8",
                                "sense_id": "7e204bcb-57ec-32ff-95b0-59a234ae48ec",
                                "text": "„Insofern glich es sehr wohl einem Collegekurs in Kriminologie, bei dem der Professor meist noch nie draußen auf der Straße war und nicht erlebt hat, wovon er spricht.“"
                            },
                            {
                                "example_id": "c58b436c-c91a-41cb-8bfa-b5391e768b8b",
                                "sense_id": "7e204bcb-57ec-32ff-95b0-59a234ae48ec",
                                "text": "„Sie verweigert es, dessen globales Geschäftimperium zu beerben und kurvt lieber als Fahrradkurier in London umher und belegt Collegekurse.“"
                            },
                            {
                                "example_id": "72bc0eb8-69e4-4b16-8d82-b4a56457e964",
                                "sense_id": "7e204bcb-57ec-32ff-95b0-59a234ae48ec",
                                "text": "„Neben der Frage durch die Agentur, ob ich nicht länger bleiben wolle, beschäftige ich mich mit der Anmeldung für neue Collegekurse und natürlich mit der Musik.“"
                            },
                            {
                                "example_id": "61f588c6-4db1-4e06-8575-3a54c251123d",
                                "sense_id": "7e204bcb-57ec-32ff-95b0-59a234ae48ec",
                                "text": "„Parallel zu diesem Unterricht besuchte Ailey Collegekurse in romanischen Sprachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
