                        "glosses": [
                            "To revolve or move around something."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "69476be7-40f7-466f-82ef-d637eb332239",
                                "sense_id": "1a1ed4cb-aba1-3052-8dcd-dfdee31a4869",
                                "text": "The oracle is now about to be\nFulfilled by circumvolving destiny;\nWhich says: “Thebes, choose reform or civil war,\nWhen through your streets, instead of hare with dogs,\nA Consort Queen shall hunt a King with Hogs,\nRiding upon the IONIAN MINOTAUR.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "2275206b-9d77-376f-98e0-3cf1c8161093",
                        "entry_id": "53a3b76e-88e5-3713-aaaa-42dcfd302634",
                        "glosses": [
                            "To roll round; to cause to revolve; to put into a circular motion."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2bdae4c1-2f83-4d46-9556-ae5d22aa2cf0",
                                "sense_id": "2275206b-9d77-376f-98e0-3cf1c8161093",
                                "text": "1647, Robert Herrick, \"Upon Master Fletcher's Incomparable Plays\", in Comedies and Tragedies by Beaumont & Fletcher\n[…] we circumvolve our Eyes […]"
                            }
                        ]
                    }
