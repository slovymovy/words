        "de-extract.jsonl": [
            {
                "entry_id": "29810f7f-4309-31d5-baa7-448a0516b0d0",
                "word": "PayPal",
                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "462ad6f1-9462-4137-89d1-0ce769557792",
                        "entry_id": "29810f7f-4309-31d5-baa7-448a0516b0d0",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "PayPals"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d700a614-bc0c-3550-8e2b-eb240aea627f",
                        "entry_id": "29810f7f-4309-31d5-baa7-448a0516b0d0",
                        "glosses": [
                            "börsennotierter Betreiber eines Online-Bezahldienstes, der zur Begleichung von Mittel- und Kleinbeträgen zum Beispiel beim Ein- und Verkauf im Online-Handel genutzt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2195d8d3-e982-45f0-ae78-26034e78efee",
                                "sense_id": "d700a614-bc0c-3550-8e2b-eb240aea627f",
                                "text": "„Zwei mutmaßliche Computer-Betrügerinnen aus Thüringen sollen die Sicherheitsvorkehrungen beim weltweiten Bezahldienstleister PayPal mit einfachsten Mitteln ausgehebelt und für kriminelle Geschäfte genutzt haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "adc35dcf-1a28-382c-a768-b7207446753d",
                        "entry_id": "29810f7f-4309-31d5-baa7-448a0516b0d0",
                        "glosses": [
                            "elektronisches Zahlungssystem des Betreibers unter [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f8302b5-9794-4b61-9fbf-2c0a707732df",
                                "sense_id": "adc35dcf-1a28-382c-a768-b7207446753d",
                                "text": "„Onlineplattformen wie Flixbus dürfen ihren Kunden nach vorläufiger Einschätzung des Bundesgerichtshofs (BGH) für bestimmte Zahlungsarten wie PayPal oder Sofortüberweisung Gebühren berechnen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8cda393b-c712-43b2-adcd-5cd71851cf65",
                        "source_entry_id": "29810f7f-4309-31d5-baa7-448a0516b0d0",
                        "source_sense_id": "d700a614-bc0c-3550-8e2b-eb240aea627f",
                        "source_sense_description": "börsennotierter Betreiber eines Online-Bezahldienstes",
                        "target_lang_word": "PayPal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "PayPal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6452de8b-c4d1-3a33-a309-82738ea72be9",
                                        "entry_id": "b3e33e3d-f5f8-3d40-8d40-c7a968fcfd42",
                                        "glosses": [
                                            "A worldwide online payment system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f66e6459-35d3-4b96-8d0a-b4fb83764a05",
                                                "sense_id": "6452de8b-c4d1-3a33-a309-82738ea72be9",
                                                "text": "Got PayPal or Visa, whatever'll please ya\nAs long as I've got the dough."
                                            },
                                            {
                                                "example_id": "8377cd46-3a3b-4b99-900e-2775fa1c5b6a",
                                                "sense_id": "6452de8b-c4d1-3a33-a309-82738ea72be9",
                                                "text": "It's still a business, particularly for ASMRtists who hold to a strict programming schedule, solicit PayPal donations or offer one-on-one Skype sessions for a fee."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "PayPal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9af74ff5-2587-3ecf-9d87-60d997c35ec0",
                                        "entry_id": "2991fd9e-c878-3a52-a78a-0577de521e81",
                                        "glosses": [
                                            "An account on the PayPal system."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f911901f-27ee-4a08-b583-9c38f605ac6d",
                                                "sense_id": "9af74ff5-2587-3ecf-9d87-60d997c35ec0",
                                                "text": "A penis with a PayPal is a dangerous thing. Never pay for hookers with online money transfers. It’s considered wire fraud, which is a federal crime."
                                            },
                                            {
                                                "example_id": "dae9469b-1565-47aa-b4ed-6d8ad82277f9",
                                                "sense_id": "9af74ff5-2587-3ecf-9d87-60d997c35ec0",
                                                "text": "Find PayPals, Venmos, or CashApps of BIPOC and randomly donate money as reparations."
                                            },
                                            {
                                                "example_id": "bd96a42c-87af-49d2-8320-2e571ccad22e",
                                                "sense_id": "9af74ff5-2587-3ecf-9d87-60d997c35ec0",
                                                "text": "Remember that so many of us click on links to CashApps, Venmos, PayPals, etc. to donate to bail funds, Flint Water reliefs, the next Ferguson, and the like without any thought of integrating ourselves into collective action?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "PayPal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cef0b10d-a1d1-3556-ab02-3157d5c0cad0",
                                        "entry_id": "4f5fa4ac-cbf7-37ae-b3b8-1fa932848df5",
                                        "glosses": [
                                            "To transfer (money) to (someone) via the PayPal system."
                                        ],
                                        "tags": [
                                            "ditransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da584238-a542-4ffe-aeba-28d7c322e116",
                                                "sense_id": "cef0b10d-a1d1-3556-ab02-3157d5c0cad0",
                                                "text": "He PayPalled $150 to my account, which was only half of what we had agreed."
                                            },
                                            {
                                                "example_id": "64437936-4af0-45ff-995f-520e6689b041",
                                                "sense_id": "cef0b10d-a1d1-3556-ab02-3157d5c0cad0",
                                                "text": "Can you PayPal me the fee?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
