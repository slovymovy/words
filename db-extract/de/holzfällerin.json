                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lumberjack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d0ae5f8-f254-34bb-8a1a-600e4e3b9430",
                                        "entry_id": "5e7e12f3-b090-33a4-b9f5-73d6f5a1306d",
                                        "glosses": [
                                            "To work as a lumberjack, cutting down trees."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b826242f-0ee2-4ef6-b535-7441361372e4",
                                                "sense_id": "1d0ae5f8-f254-34bb-8a1a-600e4e3b9430",
                                                "text": "Many of the lumberjacking memories have faded to black and white, the brightest moments colored mostly by Jim McKay’s yellow blazer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e3d4987-bd93-475c-9872-76705546444c",
                        "source_entry_id": "ecdb6f73-5b16-3061-8724-3b295895a596",
                        "source_sense_id": "fafa8bd4-2861-326d-aa32-3585df02f62d",
                        "source_sense_description": "weibliche Person, deren Beruf das Fällen von Bäumen und die Vorbereitung zum Abtransport ist",
                        "target_lang_word": "bûcheronne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bûcheronne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "02f9facf-0ac7-34f6-a576-73741f164e7f",
                                        "entry_id": "91616d98-5ee4-3f4a-b81d-cbcc69822fce",
                                        "glosses": [
                                            "Celle dont le métier est de couper du bois dans une forêt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ca7ca11-8c0f-4f1c-aacf-d6c7df2d7200",
                                                "sense_id": "02f9facf-0ac7-34f6-a576-73741f164e7f",
                                                "text": "Il était une fois un bûcheron et une bûcheronne qui avaient sept enfants, tous garçons."
                                            },
                                            {
                                                "example_id": "f80aa46b-6d2f-489b-8399-60adcc86ef69",
                                                "sense_id": "02f9facf-0ac7-34f6-a576-73741f164e7f",
                                                "text": "Cette fille est née de bûcherons et bûcheronnes dans des bois qui appartiennent à ma famille et on l’a apportée à ma mère toute petite pour qu’elle serve de jouet."
                                            },
                                            {
                                                "example_id": "a0f0c480-6e50-4bd7-ac8f-90e8f9d3fc53",
                                                "sense_id": "02f9facf-0ac7-34f6-a576-73741f164e7f",
                                                "text": "On ne sait trop pourquoi la belle fée, devenue bûcheronne, frappait de vigoureux coups de cognée cet arbre fruitier, qui n’était pas de ces arbres stériles que l’on condamne au feu, ou dont on fait « descier » le tronc pour la menuiserie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bûcheronne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "89a68c65-0ee1-380e-84e5-0d850ff4cb87",
                                        "entry_id": "3e2b612b-fe4f-3637-8ff9-83ba7e913511",
                                        "glosses": [
                                            "Féminin singulier de bûcheron."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c9409d0-0f0f-46aa-af7b-67c7b414fdbc",
                                                "sense_id": "89a68c65-0ee1-380e-84e5-0d850ff4cb87",
                                                "text": "[…] et, en fin de compte, de la disparition locale des espèces riveraines subsistant encore par l’agriculture, l’exploitation bûcheronne, le prélèvement du vin de palme, et les feux de brousse."
                                            }
                                        ]
                                    }
                                ]
