                "senses": [
                    {
                        "sense_id": "53d37bdc-1653-30ca-9e6a-c66a1e5fbd64",
                        "entry_id": "9d9b2e37-762b-3fbc-9f83-5e3a5d862fe6",
                        "glosses": [
                            "Donner un nom, une dénomination."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50a0813b-9a4d-4cc3-87be-34d19788f80f",
                                "sense_id": "53d37bdc-1653-30ca-9e6a-c66a1e5fbd64",
                                "text": "Chez les Grecs, comme encore de nos jours chez quelques peuples, on se servait des lettres de l’alphabet pour dénominer les sons."
                            },
                            {
                                "example_id": "b046fdef-7b8a-42e0-aba8-b45c71aa40b7",
                                "sense_id": "53d37bdc-1653-30ca-9e6a-c66a1e5fbd64",
                                "text": "Cela sera quelque opuscule que d'avance je dénomine : \"Préface pour un livre futur\"."
                            },
                            {
                                "example_id": "97d482a4-3cdd-4ecd-ab25-89582b2e6516",
                                "sense_id": "53d37bdc-1653-30ca-9e6a-c66a1e5fbd64",
                                "text": "Mais comment sont les mots originaires (dans la langue ancienne) pour dénominer cette parenté ?"
                            }
                        ]
                    }
