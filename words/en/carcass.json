    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "747efbe2-1ba8-3654-9a50-e93591351bc6",
                    "sense_definition": "The body of a dead animal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dead_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The forest was covered in a decaying <w>carcass</w>.",
                            "target_lang_translations": {
                                "pl": "Las był pokryty rozkładającym się <w>ścierwem</w>.",
                                "de": "Der Wald war bedeckt von einem verwesenden <w>Kadaver</w>."
                            }
                        },
                        {
                            "text": "Vultures circled above the animal <w>carcass</w> in the field.",
                            "target_lang_translations": {
                                "pl": "Sępy krążyły nad <w>padliną</w> na polu.",
                                "de": "Geier kreisten über dem <w>Tierkadaver</w> auf dem Feld."
                            }
                        }
                    ],
                    "synonyms": [
                        "corpse"
                    ],
                    "common_phrases": [
                        "animal carcass"
                    ],
                    "target_lang_definitions": {
                        "pl": "Martwe, rozkładające się ciało zwierzęcia.",
                        "de": "Der Körper eines toten Tieres."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ścierwo",
                                "target_lang_sense_clarification": "martwe, rozkładające się ciało zwierzęcia"
                            },
                            {
                                "target_lang_word": "padlina",
                                "target_lang_sense_clarification": "ciało martwego zwierzęcia"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Kadaver",
                                "target_lang_sense_clarification": "toter, oft verwesender Tierkörper"
                            },
                            {
                                "target_lang_word": "Aas",
                                "target_lang_sense_clarification": "toter und meist verwesender Tierkörper"
                            },
                            {
                                "target_lang_word": "Tierleiche",
                                "target_lang_sense_clarification": "allgemeine Bezeichnung für ein verstorbenes Tier"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75e57c7c-af80-33b6-b786-feb317557aa9",
                    "sense_definition": "The body of a dead human.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dead_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective examined the human <w>carcass</w> found in the alley.",
                            "target_lang_translations": {
                                "pl": "Detektyw zbadał <w>zwłoki</w> znalezione w alejce.",
                                "de": "Der Detektiv untersuchte die <w>Leiche</w>, die in der Gasse gefunden wurde."
                            }
                        },
                        {
                            "text": "He was horrified to discover a <w>carcass</w> while exploring the cave.",
                            "target_lang_translations": {
                                "pl": "Był przerażony, odkrywając <w>trupa</w> podczas eksploracji jaskini.",
                                "de": "Er war entsetzt, als er beim Erkunden der Höhle einen <w>Toten</w> entdeckte."
                            }
                        }
                    ],
                    "synonyms": [
                        "corpse"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in older literature to refer to a human body."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Ciało zmarłego człowieka (używane w literaturze lub w sposób lekceważący).",
                        "de": "Der Körper eines toten Menschen (oft abwertend oder in literarischem Kontext)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zwłoki",
                                "target_lang_sense_clarification": "ciało zmarłego człowieka"
                            },
                            {
                                "target_lang_word": "trup",
                                "target_lang_sense_clarification": "ciało zmarłego człowieka"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Leiche",
                                "target_lang_sense_clarification": "der Körper eines verstorbenen Menschen"
                            },
                            {
                                "target_lang_word": "Toter",
                                "target_lang_sense_clarification": "eine verstorbene Person"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e164f90-46b7-3767-9e6c-c62f626607be",
                    "sense_definition": "The body of a slaughtered animal prepared for food.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dead_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The butcher hung the beef <w>carcass</w> in the cold storage room.",
                            "target_lang_translations": {
                                "pl": "Rzeźnik powiesił <w>tuszę</w> wołową w chłodni.",
                                "de": "Der Metzger hängte den <w>Schlachtkörper</w> vom Rind in den Kühlraum."
                            }
                        },
                        {
                            "text": "Inspectors checked the <w>carcass</w> for quality before processing.",
                            "target_lang_translations": {
                                "pl": "Inspektorzy sprawdzili jakość <w>tuszy</w> przed przetworzeniem.",
                                "de": "Inspektoren prüften den <w>Schlachtkörper</w> vor der Verarbeitung auf Qualität."
                            }
                        }
                    ],
                    "common_phrases": [
                        "beef carcass"
                    ],
                    "target_lang_definitions": {
                        "pl": "Ciało ubitego zwierzęcia przygotowane do celów spożywczych.",
                        "de": "Der Körper eines geschlachteten Tieres, das für die Lebensmittelverarbeitung vorbereitet wurde."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "tusz",
                                "target_lang_sense_clarification": "ciało ubitego zwierzęcia przygotowane do przetworzenia"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Schlachtkörper",
                                "target_lang_sense_clarification": "der Körper eines geschlachteten Tieres nach der Schlachtung"
                            },
                            {
                                "target_lang_word": "Karkasse",
                                "target_lang_sense_clarification": "das Gerippe von Geflügel oder anderen Tieren nach dem Auslösen des Fleisches"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64950bad-20b0-39c9-9ffc-5b6cfc96b036",
                    "sense_definition": "The physical body of a living person or animal, often used in a derogatory or humorous way.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She struggled to move her tired <w>carcass</w> out of bed.",
                            "target_lang_translations": {
                                "pl": "Z trudem wyciągnęła swoje zmęczone <w>cielsko</w> z łóżka.",
                                "de": "Sie mühte sich ab, ihren müden <w>Kadaver</w> aus dem Bett zu bewegen."
                            }
                        },
                        {
                            "text": "He dragged his heavy <w>carcass</w> up the long flight of stairs.",
                            "target_lang_translations": {
                                "pl": "Wwlókł swoje ciężkie <w>cielsko</w> po długich schodach.",
                                "de": "Er schleppte seinen schweren <w>Leib</w> die lange Treppe hinauf."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used to refer to a body in a blunt or disrespectful manner."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Fizyczne ciało żywej osoby lub zwierzęcia, używane w sposób potoczny lub lekceważący.",
                        "de": "Der physische Körper einer lebenden Person oder eines Tieres, oft in abwertender oder humorvoller Weise verwendet."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "cielsko",
                                "target_lang_sense_clarification": "duże, ciężkie ciało"
                            },
                            {
                                "target_lang_word": "kadłub",
                                "target_lang_sense_clarification": "ciało (często w kontekście zmęczenia)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Kadaver",
                                "target_lang_sense_clarification": "umgangssprachlich für einen schwachen oder kraftlosen Körper"
                            },
                            {
                                "target_lang_word": "Leib",
                                "target_lang_sense_clarification": "der menschliche Körper, oft in einer etwas derben oder betont physischen Weise"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97d5d1cf-7a3a-3ac4-a838-354b28e06d8b",
                    "sense_definition": "The internal structural framework of an object, such as a tire or building.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tire <w>carcass</w> was damaged beyond repair.",
                            "target_lang_translations": {
                                "pl": "<w>Karkas</w> opony był uszkodzony w sposób nienaprawialny.",
                                "de": "Die <w>Karkasse</w> des Reifens war irreparabel beschädigt."
                            }
                        },
                        {
                            "text": "Engineers inspected the structural <w>carcass</w> of the old building.",
                            "target_lang_translations": {
                                "pl": "Inżynierowie sprawdzili <w>szkielet</w> konstrukcyjny starego budynku.",
                                "de": "Ingenieure untersuchten das <w>Skelett</w> des alten Gebäudes."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tire carcass"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wewnętrzna struktura nośna przedmiotu, np. opony lub budynku.",
                        "de": "Die innere tragende Struktur eines Objekts, wie zum Beispiel bei einem Reifen oder einem Gebäude."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "karkas",
                                "target_lang_sense_clarification": "wewnętrzna struktura opony"
                            },
                            {
                                "target_lang_word": "szkielet",
                                "target_lang_sense_clarification": "konstrukcja nośna budynku"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Karkasse",
                                "target_lang_sense_clarification": "das tragende Gewebe eines Reifens"
                            },
                            {
                                "target_lang_word": "Skelett",
                                "target_lang_sense_clarification": "die tragende Konstruktion eines Bauwerks"
                            },
                            {
                                "target_lang_word": "Gerippe",
                                "target_lang_sense_clarification": "die Grundstruktur einer technischen Konstruktion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e688647f-9e06-3784-b020-18af21f5a9aa",
                    "sense_definition": "An old type of incendiary projectile used in naval warfare.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship fired a <w>carcass</w> at the enemy vessel.",
                            "target_lang_translations": {
                                "pl": "Okręt wystrzelił <w>karkas</w> w stronę wrogiej jednostki.",
                                "de": "Das Schiff feuerte eine <w>Karkasse</w> auf das feindliche Schiff ab."
                            }
                        },
                        {
                            "text": "Historical records describe the <w>carcass</w> as a dangerous fire weapon.",
                            "target_lang_translations": {
                                "pl": "Zapisy historyczne opisują <w>karkas</w> jako niebezpieczną broń ogniową.",
                                "de": "Historische Aufzeichnungen beschreiben die <w>Karkasse</w> als gefährliche Brandwaffe."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to historical military technology."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Historyczny rodzaj pocisku zapalającego używanego w wojnie morskiej.",
                        "de": "Eine historische Art von Brandgeschoss, das in der Seekriegsführung verwendet wurde."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "karkas",
                                "target_lang_sense_clarification": "historyczny pocisk zapalający"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Karkasse",
                                "target_lang_sense_clarification": "historisches Brandgeschoss mit eisernem Gerippe"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}