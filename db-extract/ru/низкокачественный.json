                "senses": [
                    {
                        "sense_id": "0239fd8a-4eb1-3eb1-ad13-99d1ca0daff1",
                        "entry_id": "fc9ca5bd-c4e5-39a9-aa21-64dadb2a0c08",
                        "glosses": [
                            "имеющий низкое качество, сделанный с низким качеством"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e712cbd-9be4-40e1-ba96-8e54baa3e233",
                                "sense_id": "0239fd8a-4eb1-3eb1-ad13-99d1ca0daff1",
                                "text": "К сожалению, в условиях резкого снижения платёжеспособного спроса населения в результате «шоковой терапии» начала 1990-х годов российское правительство вместо помощи отечественному товаропроизводителю предпочло импортировать продовольствие, нередко низкокачественное."
                            },
                            {
                                "example_id": "03735dcc-e45f-4d04-93d0-5b01236a060e",
                                "sense_id": "0239fd8a-4eb1-3eb1-ad13-99d1ca0daff1",
                                "text": "Дорога приводит к карьеру, вгрызшемуся в берег Оки. Здесь добывается низкокачественный известняковый щебень."
                            }
                        ]
                    }
