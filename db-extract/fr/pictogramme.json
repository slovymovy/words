        "fr-extract.jsonl": [
            {
                "entry_id": "7f88f792-039b-3101-9337-0f7195c44564",
                "word": "pictogramme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3aa71e22-dc08-4032-a206-56be20753fc0",
                        "entry_id": "7f88f792-039b-3101-9337-0f7195c44564",
                        "tags": [
                            "plural"
                        ],
                        "form": "pictogrammes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "57cb190b-15dc-389d-9037-17bcd5afe6ac",
                        "entry_id": "7f88f792-039b-3101-9337-0f7195c44564",
                        "glosses": [
                            "Dessin schématique désignant le plus clairement possible une direction, une fonction ou une action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20cc287c-0287-4cb4-9884-6a592e4e57fc",
                                "sense_id": "57cb190b-15dc-389d-9037-17bcd5afe6ac",
                                "text": "Dans les temps historiques, la traduction spatiale du développement d’une action conduit du mythogramme au pictogramme et aux diverses formes de signes linéarisés qui sont caractéristiques de l’écriture."
                            },
                            {
                                "example_id": "c23c25a6-81be-4cfc-ae8c-86cd34f454ec",
                                "sense_id": "57cb190b-15dc-389d-9037-17bcd5afe6ac",
                                "text": "Une histoire sans mots est réellement une histoire sans mots. À partir de pictogrammes totalement inventés, voici, heure par heure, une journée de M. Noir."
                            }
                        ]
                    },
                    {
                        "sense_id": "786e0274-a4fb-38cb-bb39-63d239e8d6ae",
                        "entry_id": "7f88f792-039b-3101-9337-0f7195c44564",
                        "glosses": [
                            "Idéogramme iconique."
                        ],
                        "tags": [
                            "Sémiotique"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c02f6973-9319-3219-a960-89250c7d6b5b",
                        "entry_id": "7f88f792-039b-3101-9337-0f7195c44564",
                        "glosses": [
                            "Symbole évocateur aisément compréhensible évoquant un fait ou un objet."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d512f27-6414-4f77-a9da-a8d150ab4538",
                        "source_entry_id": "7f88f792-039b-3101-9337-0f7195c44564",
                        "target_lang_word": "Piktogramm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Piktogramm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a710f145-7dcd-30a8-bbe2-5202fb9c92c1",
                                        "entry_id": "05623b7f-b9fd-34dd-a0d1-4b3e7987c94c",
                                        "glosses": [
                                            "bildliches Zeichen, das eine Information beinhaltet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e394a325-19c7-4506-87e6-536d8e498d38",
                                                "sense_id": "a710f145-7dcd-30a8-bbe2-5202fb9c92c1",
                                                "text": "Die chinesische Schrift entwickelte sich aus Piktogrammen."
                                            },
                                            {
                                                "example_id": "b8fa86e1-3030-40a9-8119-d004794c750c",
                                                "sense_id": "a710f145-7dcd-30a8-bbe2-5202fb9c92c1",
                                                "text": "Die Steinzeitmenschen benutzten Piktogramme für ihre Höhlenmalerei, um ihre Erlebnisse niederzuschreiben."
                                            },
                                            {
                                                "example_id": "6a2a5548-3bee-46f1-b02b-b31c790c082b",
                                                "sense_id": "a710f145-7dcd-30a8-bbe2-5202fb9c92c1",
                                                "text": "„Zur Genüge kennt man ja Piktogramme in Form von Verbotsschildern…“"
                                            },
                                            {
                                                "example_id": "1d088b3f-0518-48af-93af-faea0bf79ebc",
                                                "sense_id": "a710f145-7dcd-30a8-bbe2-5202fb9c92c1",
                                                "text": "„Piktogramme haben gegenüber Schriftzeichen mehrere Vorteile: Sie sind international verständlich, sie sind Zeit sparend (sowohl beim Lesen als auch beim Schreiben) und Platz sparend (beim Schreiben).“"
                                            },
                                            {
                                                "example_id": "3b38fa4a-2ce0-43dc-a41f-1d677cd09591",
                                                "sense_id": "a710f145-7dcd-30a8-bbe2-5202fb9c92c1",
                                                "text": "„Es sind Piktogramme, die jeweils auf einen Gegenstand oder ein bestimmtes Wesen hinweisen.“"
                                            },
                                            {
                                                "example_id": "3a8769a2-aa7c-4b9a-8ef4-6271a69dd730",
                                                "sense_id": "a710f145-7dcd-30a8-bbe2-5202fb9c92c1",
                                                "text": "„Auch diese Höhlenmalereien sind Wörter, eine ganze Wand voller Piktogramme.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
