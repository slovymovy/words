                    },
                    {
                        "form_id": "4130e34a-a48b-4980-abcc-1fccd411fee0",
                        "entry_id": "5ad4d811-25dd-3806-b537-c3c457c0571b",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "pantoises"
