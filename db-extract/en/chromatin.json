                ],
                "senses": [
                    {
                        "sense_id": "3e396766-9105-3da8-8cc8-69ffb51003f6",
                        "entry_id": "3820b5b9-7a5b-34af-a5ff-459d04919e5d",
                        "glosses": [
                            "A complex of DNA, RNA and proteins within the cell nucleus out of which chromosomes condense during cell division."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
