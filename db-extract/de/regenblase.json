                "senses": [
                    {
                        "sense_id": "d1212c1d-2967-35c8-9dc4-791eb8bfdde5",
                        "entry_id": "3c61bf2b-bfde-35b6-a8e5-8c407b2cad08",
                        "glosses": [
                            "Blase die sich bei Starkregen auf der Wasseroberfläche bildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82bf5047-d599-4f1f-8091-a4d425ee27a0",
                                "sense_id": "d1212c1d-2967-35c8-9dc4-791eb8bfdde5",
                                "text": "Am folgenden Tage, bei strömenden Regen, war die Bucht mit zahllosen Regenblasen aller Größen bedeckt, während auf dem freien Wasser nur wenige, schnell verschwindende Blasen zu sehen waren."
                            },
                            {
                                "example_id": "fca4eb04-99b1-4128-a0ff-6ab724803a26",
                                "sense_id": "d1212c1d-2967-35c8-9dc4-791eb8bfdde5",
                                "text": "Vorm Zelteingang staute sich ein von Regenblasen schäumender See."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "175fe1cc-24a5-39ba-8c84-758722eeeec6",
                        "entry_id": "3c61bf2b-bfde-35b6-a8e5-8c407b2cad08",
                        "glosses": [
                            "Wasserlache in einer Zeltmulde, die sich bei Regen bildet und plötzlich entleert/ausschüttet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef8e5969-7abf-4f2e-9b54-53ee67ff081f",
                                "sense_id": "175fe1cc-24a5-39ba-8c84-758722eeeec6",
                                "text": "„So mancher der an den Rabatten zuschauenden Normalbürger mag sich insgeheim schadenfroh ausgemalt haben, wie sich eine solche Regenblase schwallend auf eine Paris Hilton ergießt.“"
                            },
                            {
                                "example_id": "571e0548-715e-42d9-b660-cd1fd4ad0951",
                                "sense_id": "175fe1cc-24a5-39ba-8c84-758722eeeec6",
                                "text": "Jetzt barst die angestochene Regenblase in einem Schwall."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "4f7e69df-9df1-3b8c-a988-a44b699c3722",
                        "entry_id": "3c61bf2b-bfde-35b6-a8e5-8c407b2cad08",
                        "glosses": [
                            "Tiefdruckgebiet welches Regen bringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f0661cf-4c59-4f7c-a73f-01a1e20781c9",
                                "sense_id": "4f7e69df-9df1-3b8c-a988-a44b699c3722",
                                "text": "„Das Regenradar auf wetteronline.de sieht schon beeindruckend aus, wie die Regenblase aus Polen über Brandenburg sich bei uns in Thüringen “reindreht” und es den Tag lang regnet.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "4eee39c4-e291-3166-bcb8-7cf6ccabce77",
                        "entry_id": "3c61bf2b-bfde-35b6-a8e5-8c407b2cad08",
                        "glosses": [
                            "Wortspielerei, übertragener Sinn, wenn etwas kommt und gleichsam schön unwiederbringlich zerplatzt/vergeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01d9f8e9-d62e-4895-a485-17c10db6d517",
                                "sense_id": "4eee39c4-e291-3166-bcb8-7cf6ccabce77",
                                "text": "„Rücksichtslose Wetterspekulanten haben den Kurs der Sonne derart nach unten gedrückt, dass der Wolkenindex ein All-Time-High hatte und die Regenblase platzen musste.“"
                            },
                            {
                                "example_id": "e51f6511-85e0-411c-9b7a-0e3d02b835d6",
                                "sense_id": "4eee39c4-e291-3166-bcb8-7cf6ccabce77",
                                "text": "Er sagt viel, aber es ist wenig Sinn darin; wie eine Regenblase die aufspringt, Lärm macht und platzt und in Nichts zusammensinkt."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
