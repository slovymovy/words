                                "example_id": "16c7cdf5-8ee8-4714-a465-6f0a40a6e5ce",
                                "sense_id": "7b2aa939-5d15-3c6e-94ad-c9060c1d6f33",
                                "text": "Der eigentliche Furor teutonicus war über ihn gekommen, die Gedankenwut, die bereit ist, für ein »Prinzip« alles zu opfern."
                            },
                            {
                                "example_id": "b2e98190-d917-4843-a7c4-a6c2e74e798b",
                                "sense_id": "7b2aa939-5d15-3c6e-94ad-c9060c1d6f33",
                                "text": "Dreimal und viermal und zehnmal mit dem Furor der Besessnen und Todgeweihten / Stürzen sie sich in die Magie dieses Feuermeers, hochtrabend und gierig."
                            },
                            {
                                "example_id": "188553d6-7975-40a6-8013-6d32b2536296",
                                "sense_id": "7b2aa939-5d15-3c6e-94ad-c9060c1d6f33",
                                "text": "Das ist jetzt der Mann des Tages in Deutschland, er macht Furor, den müßt ihr lesen!"
                            }
                        ],
                        "sense_index_json": "\"1\""
