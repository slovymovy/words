            {
                "entry_id": "6c7ce6cb-0e09-340b-b5a9-d9b835d8874e",
                "word": "bacchanalian",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2cc4865a-6e2c-3c61-aa31-59c5f457e89e",
                        "entry_id": "6c7ce6cb-0e09-340b-b5a9-d9b835d8874e",
                        "glosses": [
                            "Alternative letter-case form of Bacchanalian."
                        ],
                        "tags": [
                            "alt-of",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "47c1e422-2be8-4f5a-82dc-29e04d79bca9",
                                "sense_id": "2cc4865a-6e2c-3c61-aa31-59c5f457e89e",
                                "text": "With the help of a sleepy waiter, Little Billee got the bacchanalian into his room and lit his candle for him, and, disengaging himself from his maudlin embraces, left him to wallow in solitude."
                            },
                            {
                                "example_id": "f2f1edd3-8b76-495c-8ed7-cf89ee6839e8",
                                "sense_id": "2cc4865a-6e2c-3c61-aa31-59c5f457e89e",
                                "text": "Within three hours we'd drunk the place dry. Miraculously, we all made it back on the bus, but I've never seen a more bacchanalian scene of wanton debauchery than the ride back to the hotel."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
