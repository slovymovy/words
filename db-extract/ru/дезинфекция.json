                "translations": [
                    {
                        "translation_id": "c81be8ec-f85e-4607-a1ef-079e489a566d",
                        "source_entry_id": "1b824846-f365-3455-a16e-c0c6f714ea79",
                        "target_lang_word": "disinfection",
