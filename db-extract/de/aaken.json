                    },
                    {
                        "form_id": "75f853d6-4ed2-4e92-9177-cba206c2514f",
                        "entry_id": "261b9e00-ea2d-3581-8f5b-05550ce99efc",
                        "tags": [
                            "variant"
                        ],
                        "form": "[1] Frau Aaken ist ein Genie im Verkauf."
                    },
                    {
                        "form_id": "82ca2fb6-9636-4d1b-a7a6-bcc6c71900a7",
                        "entry_id": "261b9e00-ea2d-3581-8f5b-05550ce99efc",
                        "tags": [
                            "variant"
                        ],
                        "form": "[1] Herr Aaken wollte uns kein Interview geben."
                    },
                    {
                        "form_id": "210137c4-9f9a-427d-a83b-26ed807fd9fc",
                        "entry_id": "261b9e00-ea2d-3581-8f5b-05550ce99efc",
                        "tags": [
                            "variant"
                        ],
                        "form": "[1] Die Aakens kommen heute aus der Eifel."
                    },
                    {
                        "form_id": "16d82f5c-4e2d-4711-905f-703d74d308ce",
                        "entry_id": "261b9e00-ea2d-3581-8f5b-05550ce99efc",
                        "tags": [
                            "variant"
                        ],
                        "form": "[1] Der Aaken trägt nie die Schals, die die Aaken ihm strickt."
                    },
                    {
                        "form_id": "8a80bd7d-c195-467a-94b5-07879c86aece",
                        "entry_id": "261b9e00-ea2d-3581-8f5b-05550ce99efc",
                        "tags": [
                            "variant"
                        ],
                        "form": "[1] Das kann ich dir aber sagen: „Wenn die Frau Aaken kommt, geht der Herr Aaken.“"
                    },
                    {
                        "form_id": "10b79939-676d-46e6-a213-731ba90a068e",
                        "entry_id": "261b9e00-ea2d-3581-8f5b-05550ce99efc",
                        "tags": [
                            "variant"
                        ],
                        "form": "[1] Aaken kommt und geht."
                    },
                    {
                        "form_id": "d03fec05-663f-49f1-b16f-cfd8be6484ba",
                        "entry_id": "261b9e00-ea2d-3581-8f5b-05550ce99efc",
                        "tags": [
                            "variant"
                        ],
                        "form": "[1] Aakens kamen, sahen und siegten."
                    },
