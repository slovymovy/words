                "forms": [
                    {
                        "form_id": "1ce6b500-e8e8-4045-9ab4-65778f3a8f73",
                        "entry_id": "8ad1cff7-205f-346b-9034-8b67a0122152",
                        "tags": [
                            "plural"
                        ],
                        "form": "hydromels"
                    },
                    {
                        "form_id": "4e1fd61a-82bc-41c8-9a4e-0b1f72ef3301",
                        "entry_id": "8ad1cff7-205f-346b-9034-8b67a0122152",
                        "tags": [],
                        "form": "hydromèle"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d99913f6-c1a5-3860-994f-aa6547963734",
                        "entry_id": "8ad1cff7-205f-346b-9034-8b67a0122152",
                        "glosses": [
                            "Boisson ou breuvage, fermenté ou non, composé d’eau et de miel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e62e89d-df65-4fe0-b268-d9e4abd17109",
                                "sense_id": "d99913f6-c1a5-3860-994f-aa6547963734",
                                "text": "Il reçut néanmoins bon accueil : la Waïzoro fit circuler l’hydromel, mais sans plus s’occuper de lui; […]."
                            },
                            {
                                "example_id": "cdd2526b-0515-4c40-84b7-51e2d0f886c8",
                                "sense_id": "d99913f6-c1a5-3860-994f-aa6547963734",
                                "text": "Il déménage délicatement les essaims, il soigne les reines malades et va porter aux ruches d’hiver les bols d’hydromel délayé."
                            },
                            {
                                "example_id": "cc11fdf8-01c5-4c3c-b921-ebff0be16585",
                                "sense_id": "d99913f6-c1a5-3860-994f-aa6547963734",
                                "text": "Alors il chercha l’oubli tour à tour dans le cidre normand, le poiré manceau, l’hydromel gaulois, le cognac français, le genièvre hollandais, le gin anglais, le wiskey écossais, le kirsch germain."
                            },
                            {
                                "example_id": "1f2bf0bf-1cf2-4859-8bcc-18221242d944",
                                "sense_id": "d99913f6-c1a5-3860-994f-aa6547963734",
                                "text": "[…] ; l’hydromel y était une boisson fort en usage ; ce qui prouve que l’art d’élever les abeilles y était pratiqué en grand, et qu’on savait enlever à ces industrieux travailleurs le miel qu’ils produisaient. L’hydromel était antérieur au cidre, dont on ne fit emploi qu’assez tard en Gaule alors que la bière y était répandue depuis longtemps ; […]."
                            },
                            {
                                "example_id": "d38e92c3-5c72-4404-bd5d-ce6ede688356",
                                "sense_id": "d99913f6-c1a5-3860-994f-aa6547963734",
                                "text": "Au temps de ma jeunesse allante et vagabonde,\n J’ai gouté l’hydromel avecque Kunégonde,\n Et le vin de groseille et des ersatz aussi…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c674d3cb-e73e-430f-a2bc-683abb58015b",
                        "source_entry_id": "8ad1cff7-205f-346b-9034-8b67a0122152",
                        "source_sense_id": "d99913f6-c1a5-3860-994f-aa6547963734",
                        "target_lang_word": "Met",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Met",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd475b3b-cdff-3073-9e50-2cd635644238",
                                        "entry_id": "d74eee6e-6fa6-3965-b5b7-f35d5dd70173",
                                        "glosses": [
                                            "gewürzter, mit Wasser verdünnter, vergorener Honig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1942875-f84f-417c-b6e7-f005fee85ab6",
                                                "sense_id": "bd475b3b-cdff-3073-9e50-2cd635644238",
                                                "text": "„Ja wir trinken den Met, bis keiner mehr steht, unser Häuptling heißt Rote Locke“ — (Torfrock)"
                                            },
                                            {
                                                "example_id": "5287740c-f183-4223-a773-6efd1e18f9ce",
                                                "sense_id": "bd475b3b-cdff-3073-9e50-2cd635644238",
                                                "text": "Stilecht trinkt man seinen Met aus dem Trinkhorn."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb3089a7-e229-4ce1-9ca2-bdef8d212acb",
                        "source_entry_id": "8ad1cff7-205f-346b-9034-8b67a0122152",
                        "source_sense_id": "d99913f6-c1a5-3860-994f-aa6547963734",
                        "target_lang_word": "Honigwein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Honigwein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50e45fb7-627d-33f5-8aae-806f2aca3da2",
                                        "entry_id": "7167b6f9-9a6b-3ee1-95e0-51500939eb1b",
                                        "glosses": [
                                            "gewürzter, mit Wasser verdünnter, vergorener Honig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bc11683-c8f7-4709-bc22-362975c41b6a",
                                                "sense_id": "50e45fb7-627d-33f5-8aae-806f2aca3da2",
                                                "text": "Man kann Honigwein auch selbst herstellen."
                                            },
                                            {
                                                "example_id": "75d1eb10-14f0-48a1-b107-4987d9ee8aaf",
                                                "sense_id": "50e45fb7-627d-33f5-8aae-806f2aca3da2",
                                                "text": "„Sie fanden in früheren Untersuchungen zum Beispiel heraus, dass die Kelten am Glauberg Honigwein tranken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7bb283df-c0db-48b0-b1b5-1071f2806628",
                        "source_entry_id": "8ad1cff7-205f-346b-9034-8b67a0122152",
                        "source_sense_id": "d99913f6-c1a5-3860-994f-aa6547963734",
                        "target_lang_word": "mead",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mead",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69d1b003-5cf2-357f-924e-15a353dd563b",
                                        "entry_id": "4a502f42-680e-3cad-8f02-6f65d06c2335",
                                        "glosses": [
                                            "An alcoholic drink fermented from honey and water."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24a4d5f5-1c99-4eda-8699-09abc8d26074",
                                                "sense_id": "69d1b003-5cf2-357f-924e-15a353dd563b",
                                                "text": "\"Just come in,\" said Mrs. Churchill, \"and take one glass of my mead.\" / \"No—not even such a golden promise tempts me. I am afraid that Lord Marchmont will be at home before me—and he is not yet accustomed to be kept waiting.\""
                                            },
                                            {
                                                "example_id": "e28651f6-a74c-4c16-af80-9fb0495f96aa",
                                                "sense_id": "69d1b003-5cf2-357f-924e-15a353dd563b",
                                                "text": "No one, then or now, wanted to drink the mead that came out of Odin's arse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db6c8d38-632f-3001-b83f-01ab362d07be",
                                        "entry_id": "4a502f42-680e-3cad-8f02-6f65d06c2335",
                                        "glosses": [
                                            "A drink composed of syrup of sarsaparilla or other flavouring extract, and water, and sometimes charged with carbon dioxide."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mead",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0504f7d-a3d9-3293-8e1f-9581e47d02a0",
                                        "entry_id": "0abc36fe-bc45-304a-aa21-69c478e8e626",
                                        "glosses": [
                                            "A meadow."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f72a27f-7be4-49c3-9b42-7da5e0563019",
                                                "sense_id": "d0504f7d-a3d9-3293-8e1f-9581e47d02a0",
                                                "text": "Farewel ye crystal streams, that pass / Thro’ fragrant meads of verdant grass:"
                                            },
                                            {
                                                "example_id": "018d0967-f6b0-4707-892e-c6699476ced9",
                                                "sense_id": "d0504f7d-a3d9-3293-8e1f-9581e47d02a0",
                                                "text": "Hither, hither, love — / ‘Tis a shady mead — / Hither, hither, love! / Let us feed and feed!"
                                            },
                                            {
                                                "example_id": "50b5321b-aa15-48e7-8f7a-f0504be958db",
                                                "sense_id": "d0504f7d-a3d9-3293-8e1f-9581e47d02a0",
                                                "text": "But any man that walks the mead, / In bud, or blade, or bloom, may find, / According as his humours lead, / A meaning suited to his mind."
                                            },
                                            {
                                                "example_id": "492e9cbf-c2f1-4712-a9fa-9a268835c7e4",
                                                "sense_id": "d0504f7d-a3d9-3293-8e1f-9581e47d02a0",
                                                "text": "Four voices of four hamlets round, / From far and near, on mead and moor, / Swell out and fail, as if a door / Were shut between me and the sound […]"
                                            },
                                            {
                                                "example_id": "16515db1-ce69-44ff-9dd2-43c13ca9bb1c",
                                                "sense_id": "d0504f7d-a3d9-3293-8e1f-9581e47d02a0",
                                                "text": "'We must overhaul that mead,' he resumed; 'this mustn't continny!'"
                                            },
                                            {
                                                "example_id": "dc0040f8-2e34-44fa-9375-d49d82e16a60",
                                                "sense_id": "d0504f7d-a3d9-3293-8e1f-9581e47d02a0",
                                                "text": "There ran little streams over bright pebbles, dividing meads of green and gardens of many hues, [...]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
