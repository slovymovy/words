                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d37a059d-2a57-46ba-b139-18a50791d6d7",
                                "sense_id": "46dfad0f-5123-3cca-9d3b-e6b99c21e1e5",
                                "text": "Stąd też pragnienie zawładnięcia miejscem jest, jeśli tak można powiedzieć, bardziej uprzednie, niż chęć posiadania \"czegoś\", t[o ]zn[aczy] \"istnieje już przed wszelkim wyborem obiektu seksualnego\".",
                                "translation": "Thus, too, the longing to take one's place is, so to speak, more prior than the eagerness to possess \"something\", that is, \"it already exists before any choice of an object of sexuality\"",
                                "english": "Thus, too, the longing to take one's place is, so to speak, more prior than the eagerness to possess \"something\", that is, \"it already exists before any choice of an object of sexuality\""
                            }
                        ]
                    }
