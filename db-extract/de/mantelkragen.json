                ],
                "senses": [
                    {
                        "sense_id": "4ebe5709-f031-3f97-8cd1-79f86f398308",
                        "entry_id": "1a21d0e3-ba3a-3003-bb23-f35a58acfdd4",
                        "glosses": [
                            "Kragen an einem Mantel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0cc8265-367e-45e2-b078-6294cf1251e4",
                                "sense_id": "4ebe5709-f031-3f97-8cd1-79f86f398308",
                                "text": "„Weil das für Auswärtige aber nicht so leicht ist, wartet Wadim Kasparow mit hochgeschlagenem Mantelkragen in einer Seitenstraße hinter der Kasaner Kathedrale.“"
                            },
                            {
                                "example_id": "e42fbade-0c4a-4f22-ab26-94c3a1ea239a",
                                "sense_id": "4ebe5709-f031-3f97-8cd1-79f86f398308",
                                "text": "„Saukalt war es, nasser Schnee tropfte in den Mantelkragen, die Schuhe versanken im Gatsch.“"
                            },
                            {
                                "example_id": "da952207-92f3-45f7-9c82-f78b2a99957b",
                                "sense_id": "4ebe5709-f031-3f97-8cd1-79f86f398308",
                                "text": "„Erschrocken schlug er die Augen auf und reckte den Kopf aus dem Mantelkragen.“"
                            },
                            {
                                "example_id": "45cda5b7-a47a-48b5-9999-efb6c5cedc77",
                                "sense_id": "4ebe5709-f031-3f97-8cd1-79f86f398308",
                                "text": "„Ein zweiter Mann betrat die Diele, groß, elegant, mit grauen Schläfen und klugen Augen, den Mantelkragen aufgestellt, die Hände in den Taschen, eine Zigarette im Mundwinkel – Maurice Débras.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
