                                    {
                                        "sense_id": "04a724ac-fe99-3172-9d60-50db1a025ec2",
                                        "entry_id": "7fc63750-cbe7-3815-84b9-b85c9fa63688",
                                        "glosses": [
                                            "die Göttin der Weisheit sowie der Kriegstaktik und Strategie; auch Schirmherrin der Künste und Wissenschaften."
                                        ],
                                        "tags": [
                                            "griechische"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1d0b2df-73bd-4846-bbe1-0057f05fb3da",
                                                "sense_id": "04a724ac-fe99-3172-9d60-50db1a025ec2",
                                                "text": "„Wie viele griechische Gottheiten war Athene überaus leicht zu kränken: So verwandelte sie Arachne, die behauptete, die Göttin in der Webkunst zu übertreffen, in eine Spinne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
