                "translations": [
                    {
                        "translation_id": "b4c00715-ebb7-4050-ad2d-eefc51ae5bd3",
                        "source_entry_id": "d3c69330-27dc-37bc-8fa1-2143cecc9b01",
                        "source_sense_id": "bea86509-3475-30d0-bd56-605db7c06803",
                        "source_sense_description": "Wirtschaft: unternehmerisch, Unternehmen-, Unternehmer-",
                        "target_lang_word": "unternehmerisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unternehmerisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4317097-e2b8-32e1-a7e1-c675fb1fa5d5",
                                        "entry_id": "186cd120-115c-3aaf-9a7b-8dfa617a2340",
                                        "glosses": [
                                            "die selbständige gewerbliche Tätigkeit betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35853e40-4aeb-4d4c-a0c2-62efaaf05629",
                                                "sense_id": "f4317097-e2b8-32e1-a7e1-c675fb1fa5d5",
                                                "text": "„Das Finanzamt hingegen vermutete, dass keine unternehmerischen Tätigkeiten geplant waren und verweigerte daher die Erteilung einer Steuernummer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df5d126a-1a69-4998-b8ba-5abede402eef",
                        "source_entry_id": "d3c69330-27dc-37bc-8fa1-2143cecc9b01",
                        "source_sense_id": "bea86509-3475-30d0-bd56-605db7c06803",
                        "source_sense_description": "Wirtschaft: unternehmerisch, Unternehmen-, Unternehmer-",
                        "target_lang_word": "Unternehmen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unternehmen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8137be2-7be6-339e-9986-3561c9d9f9e5",
                                        "entry_id": "d70147cf-5052-3233-a357-96bb8b73e020",
                                        "glosses": [
                                            "Gesellschaft, die in Produktion oder Handel tätig ist oder Dienstleistungen erbringt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc624767-8678-4d86-ab06-a6546a822ecc",
                                                "sense_id": "f8137be2-7be6-339e-9986-3561c9d9f9e5",
                                                "text": "Ich leite ein Unternehmen."
                                            },
                                            {
                                                "example_id": "3986c479-a1b1-4d9a-b32b-c714eb5a1243",
                                                "sense_id": "f8137be2-7be6-339e-9986-3561c9d9f9e5",
                                                "text": "„Nach dem vorgelegten Sanierungskonzept des Raststättenbetreibers könnte das Unternehmen schon bald wieder profitabel werden.“"
                                            },
                                            {
                                                "example_id": "2fa3fa86-6422-474d-8168-8cb7d65d65c1",
                                                "sense_id": "f8137be2-7be6-339e-9986-3561c9d9f9e5",
                                                "text": "„Entschlossen, ein Haus im ›Enclos du Temple‹ zu mieten, suchte ich den Prinzen von Conti auf, der mein Unternehmen lebhaft begrüßte und mir seinen Schutz sowie alle Freihandelsrechte versprach, die ich wünschen konnte.“"
                                            },
                                            {
                                                "example_id": "fc888d57-d229-485b-9772-9c3ad2ad1f51",
                                                "sense_id": "f8137be2-7be6-339e-9986-3561c9d9f9e5",
                                                "text": "„Über die folgende Zahl dürfte auf der Bundesfinanzminister zunächst staunen, um sich dann zu ärgern: Unternehmen in Deutschland tragen gerade mal 2,6 Prozent zum gesamten Steueraufkommen bei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9143cafc-c851-344f-a697-3911f636fc7c",
                                        "entry_id": "d70147cf-5052-3233-a357-96bb8b73e020",
                                        "glosses": [
                                            "Durchführung eines Gedankens oder Plans"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df03400a-3ef2-4a3e-9112-07010a110ac6",
                                                "sense_id": "9143cafc-c851-344f-a697-3911f636fc7c",
                                                "text": "Es handelt sich um ein gewagtes Unternehmen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08ab3570-a229-47b4-aaa6-ff0da46f11dd",
                        "source_entry_id": "d3c69330-27dc-37bc-8fa1-2143cecc9b01",
                        "source_sense_id": "bea86509-3475-30d0-bd56-605db7c06803",
                        "source_sense_description": "Wirtschaft: unternehmerisch, Unternehmen-, Unternehmer-",
                        "target_lang_word": "Unternehmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unternehmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9ac415ef-acbc-3a3a-9ed4-4e85adaf72fd",
                                        "entry_id": "46bb1fac-d681-37e6-9af7-ccebbddd0895",
                                        "glosses": [
                                            "Person, die Inhaber oder Eigentümer eines Unternehmens ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a653d79-7236-4a2e-b86c-59fe44f3d857",
                                                "sense_id": "9ac415ef-acbc-3a3a-9ed4-4e85adaf72fd",
                                                "text": "„Unternehmer ist eine natürliche oder juristische Person oder eine rechtsfähige Personengesellschaft, die bei Abschluss eines Rechtsgeschäfts in Ausübung ihrer gewerblichen oder selbständigen beruflichen Tätigkeit handelt.“"
                                            },
                                            {
                                                "example_id": "f8674fe3-53b4-473f-b3e9-f8b998b98af3",
                                                "sense_id": "9ac415ef-acbc-3a3a-9ed4-4e85adaf72fd",
                                                "text": "„Zum Begriff des Unternehmers gehört nicht notwendig die Kaufmannseigenschaft.“"
                                            },
                                            {
                                                "example_id": "e628ebd2-7b3f-4ba1-8041-edea249d7179",
                                                "sense_id": "9ac415ef-acbc-3a3a-9ed4-4e85adaf72fd",
                                                "text": "„Unternehmer im Sinne des Umsatzsteuerrechts ist, wer eine gewerbliche oder berufliche Tätigkeit selbständig ausübt.“"
                                            },
                                            {
                                                "example_id": "9f09d852-317d-4114-9ae3-852823b26838",
                                                "sense_id": "9ac415ef-acbc-3a3a-9ed4-4e85adaf72fd",
                                                "text": "„In der Geschichte habe sie das weggelassen, um den Unternehmer noch mieser darzustellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
