                    },
                    {
                        "translation_id": "1e0d3e22-f452-40fb-ae7e-e5b2ef0a5b62",
                        "source_entry_id": "6a0fdd84-a289-34ea-9ec3-17664492fcd0",
                        "source_sense_description": "system of an ecological community and its environment",
                        "target_lang_word": "ecosysteem",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ecosysteem",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2f47510c-ecbf-3397-846f-0815c9c30603",
                                        "entry_id": "d57e4141-cd88-3c59-b233-0a5426157964",
                                        "glosses": [
                                            "het geheel van alle organismen in een bepaald gebied, hun onderlinge wisselwerkingen en hun leefomgeving"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c177e52b-4cd5-46f8-b74c-eacf5ce1be66",
                                                "sense_id": "2f47510c-ecbf-3397-846f-0815c9c30603",
                                                "text": "Onderdeel van een ecosysteem zijn afzonderlijke planten, dieren en micro-organismen en de onderlinge complexen die zij vormen, bijvoorbeeld in de vorm van levensgemeenschappen en populaties."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "807f5594-1bb1-4000-bf93-aa964def1a0a",
                        "source_entry_id": "6a0fdd84-a289-34ea-9ec3-17664492fcd0",
                        "source_sense_description": "system of an ecological community and its environment",
                        "target_lang_word": "écosystème",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écosystème",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07a7806f-f4c9-3eb4-a382-39f1901ce44b",
                                        "entry_id": "7cf1f9d8-381f-32d4-823f-d6df765ee433",
                                        "glosses": [
                                            "Ensemble formé par une association ou communauté d’êtres vivants (ou biocénose) et son environnement biologique, géologique, édaphique, hydrologique, climatique, etc. (le biotope)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21406709-730b-49f8-b227-2f18ed53e214",
                                                "sense_id": "07a7806f-f4c9-3eb4-a382-39f1901ce44b",
                                                "text": "Avec le temps, je finirais peut-être par conclure avec cette bâtisse un pacte foncier et former l’un de ces écosystèmes discrets et sereins qui souvent relient de manière invisible les couples assagis."
                                            },
                                            {
                                                "example_id": "6127ffd1-6c0f-4f4f-b280-84cae363ab86",
                                                "sense_id": "07a7806f-f4c9-3eb4-a382-39f1901ce44b",
                                                "text": "Ce sont les machines qui, littéralement, enfantent notre monde. Et qui, de cet enfantement, permettent l’émergence d’un nouvel écosystème, d’une nouvelle espèce : depuis un peu moins d’un siècle, vous, moi, tous ceux qui lisent ce livre, doivent leur vie, leurs guérisons, leur agonie, leur bonheur et désespoir de moins en moins aux êtres qui peuplent leur désirs et de plus en plus aux machines qui les veillent calmement."
                                            },
                                            {
                                                "example_id": "9e8ad2a1-9a63-47ca-a8cc-b787b0b3ee66",
                                                "sense_id": "07a7806f-f4c9-3eb4-a382-39f1901ce44b",
                                                "text": "Nous aurons accompli un grand pas le jour où nous donnerons des droits, non plus seulement aux humains, mais à des écosystèmes, c'est-à-dire à des collectifs incluant humains et non-humains, donc à des rapports et plus seulement à des êtres."
                                            },
                                            {
                                                "example_id": "ebf73cb9-66e2-4290-873c-8b7f4028a0eb",
                                                "sense_id": "07a7806f-f4c9-3eb4-a382-39f1901ce44b",
                                                "text": "\"Il y a beaucoup de zones de conservation en cours de planification, mais ce que nous voulions vraiment souligner, c'est que celles-ci pourraient être étendues pour englober complètement certains des écosystèmes vulnérables qui se trouvent sur la côte nord de notre planète\", explique Derek Mueller dans une interview à CBC."
                                            },
                                            {
                                                "example_id": "9f9e598e-0003-4c3f-82c3-44a5e988af90",
                                                "sense_id": "07a7806f-f4c9-3eb4-a382-39f1901ce44b",
                                                "text": "Ainsi, c’est en s’interrogeant sur le cycle de la vie des communautés végétales que les botanistes Henry Chandler Cowles, Frederic Edward Clements, Henry Gleason et surtout Arthur George Tansley ont formulé le concept d’« écosystème », au cours d’un débat tumultueux autour de l’écologie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "777da14e-0f6f-3187-ac47-5fc6e8391629",
                                        "entry_id": "7cf1f9d8-381f-32d4-823f-d6df765ee433",
                                        "glosses": [
                                            "Environnement socio-économique."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8f492fd-896e-45a0-99e6-d734e01b5382",
                                                "sense_id": "777da14e-0f6f-3187-ac47-5fc6e8391629",
                                                "text": "[…] ces mêmes acheteurs peuvent aussi collaborer plus étroitement avec des écosystèmes de l’innovation ou des réseaux d’entrepreneurs, qui sont susceptibles de proposer des solutions."
                                            },
                                            {
                                                "example_id": "ebdae100-ad71-4206-8238-7a7d7e661fb1",
                                                "sense_id": "777da14e-0f6f-3187-ac47-5fc6e8391629",
                                                "text": "Il y a davantage de dialogue avec l’ensemble des acteurs de l’écosystème des achats."
                                            },
                                            {
                                                "example_id": "b8d655be-6e52-4044-8ac6-dc29a395c5c4",
                                                "sense_id": "777da14e-0f6f-3187-ac47-5fc6e8391629",
                                                "text": "Reste donc un pari sur la « plateformisation », le terme étant employé pour désigner la manière dont les usagers, les producteurs de contenus et les technologies interfacent dans des écosystèmes créateurs de valeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c5290c9-46da-3c93-a25e-9d31ba4cdc2b",
                                        "entry_id": "7cf1f9d8-381f-32d4-823f-d6df765ee433",
                                        "glosses": [
                                            "Système économique fondé sur des compatibilités (ouvertures) ou des incompatibilités (fermetures) technologiques"
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e9b3e71-308f-431d-8f15-bc07f63d0942",
                                                "sense_id": "7c5290c9-46da-3c93-a25e-9d31ba4cdc2b",
                                                "text": "Apple a construit son succès sur un écosystème fermé autour des iPhone et iPad dont il contrôle tous les paramètres, invoquant des impératifs de sécurité et le confort accru des utilisateurs — une philosophie en opposition frontale avec les règles européennes de concurrence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3805e040-6077-4ee9-a324-885168643e71",
                        "source_entry_id": "6a0fdd84-a289-34ea-9ec3-17664492fcd0",
                        "source_sense_description": "system of an ecological community and its environment",
                        "target_lang_word": "Ökosystem",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ökosystem",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9423ba11-8b08-37cb-97a9-36c2b2984a67",
                                        "entry_id": "cfe11353-d9c9-38b7-abff-559830a07b6a",
                                        "glosses": [
                                            "ein Bereich, ein Teil einer Landschaft, in dem Lebewesen, die aufeinander angewiesen sind, zusammen existieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ac1b4d3-cdc3-4920-90a8-8da9c1251e19",
                                                "sense_id": "9423ba11-8b08-37cb-97a9-36c2b2984a67",
                                                "text": "Ein See ist ein gutes Beispiel für ein Ökosystem."
                                            },
                                            {
                                                "example_id": "906310bd-7caf-4187-844e-25e91f337cce",
                                                "sense_id": "9423ba11-8b08-37cb-97a9-36c2b2984a67",
                                                "text": "„Für Wasserkraftwerke werden Stauseen errichtet, die riesige Ökosysteme zerstören, und für Energiesparlampen muss in China hochgiftiges Quecksilber abgebaut werden.“"
                                            },
                                            {
                                                "example_id": "3d0d9fab-3740-47f4-8c19-e64d4a3975c5",
                                                "sense_id": "9423ba11-8b08-37cb-97a9-36c2b2984a67",
                                                "text": "„Andererseits warnen Umweltschützer vor der Zerstörung kaum erforschter Ökosysteme, wenn man den Meeresgrund quadratkilometerweise durchpflügt.“"
                                            },
                                            {
                                                "example_id": "64f3f9c1-79cd-4f69-a0bf-374f977f8a7d",
                                                "sense_id": "9423ba11-8b08-37cb-97a9-36c2b2984a67",
                                                "text": "„Die Blütenpflanzen beeinflussen außerdem das Klima, gestalten unsere Ökosysteme und haben sogar zur Entstehung zahlreicher neuer Insekten, Pilze und Vögel beigetragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
