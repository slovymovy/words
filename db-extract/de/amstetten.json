                ],
                "senses": [
                    {
                        "sense_id": "5652d93a-5d47-375e-8987-d13ab4870f33",
                        "entry_id": "33825a2d-b113-381b-902f-cd2bc39cf542",
                        "glosses": [
                            "österreichische Stadt im Südwesten Niederösterreichs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afbd1b56-cc07-4ccb-b19b-d769d94dd862",
                                "sense_id": "5652d93a-5d47-375e-8987-d13ab4870f33",
                                "text": "Amstetten war schon in prähistorischer Zeit besiedelt, das belegen Funde aus der Jungsteinzeit."
                            },
                            {
                                "example_id": "250d3609-19e4-45ca-8d2e-096c7d866f92",
                                "sense_id": "5652d93a-5d47-375e-8987-d13ab4870f33",
                                "text": "1897 erhebt Kaiser Franz Joseph den Bahnknotenpunkt Amstetten zur Stadt."
                            },
                            {
                                "example_id": "df1c4806-eb24-4608-9790-93011cc7107a",
                                "sense_id": "5652d93a-5d47-375e-8987-d13ab4870f33",
                                "text": "Die Leitung eines städtischen Kindergartens in Amstetten nimmt Rücksicht auf die Esskultur muslimischer Kinder - und sorgt damit für Diskussionen."
                            },
                            {
                                "example_id": "5e4d020d-935f-47f2-b77a-a02dbce0f5b5",
                                "sense_id": "5652d93a-5d47-375e-8987-d13ab4870f33",
                                "text": "Das Fritzl-Haus in Amstetten in Niederösterreich soll bald wieder bewohnt werden."
                            },
                            {
                                "example_id": "0522c007-6ad4-47a6-8eb0-21f9067ff3b3",
                                "sense_id": "5652d93a-5d47-375e-8987-d13ab4870f33",
                                "text": "Der Musical Sommer Amstetten bietet mit „Hair“ eine Farbexplosion."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9937a4ad-7d36-3774-a75f-c9273fa6fc68",
                        "entry_id": "33825a2d-b113-381b-902f-cd2bc39cf542",
                        "glosses": [
                            "österreichischer Verwaltungsbezirk in Niederösterreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36e6040f-d4f9-4ee5-b24e-c31621994ad3",
                                "sense_id": "9937a4ad-7d36-3774-a75f-c9273fa6fc68",
                                "text": "Der Bezirk Amstetten ist der westlichste des Mostviertels."
                            },
                            {
                                "example_id": "2ea90b38-ac95-4a5c-bab7-1a2cb97f1554",
                                "sense_id": "9937a4ad-7d36-3774-a75f-c9273fa6fc68",
                                "text": "Geteilt wird der Bezirk Amstetten durch die Statutarstadt Waidhofen/Ybbs."
                            },
                            {
                                "example_id": "046726b8-c0ad-4172-b6db-585674ab6f36",
                                "sense_id": "9937a4ad-7d36-3774-a75f-c9273fa6fc68",
                                "text": "Der Einladung vom Seniorenbund Bezirk Amstetten folgten 8 Chöre."
                            },
                            {
                                "example_id": "8235ecac-910c-4b81-9590-47d1a3d1db9d",
                                "sense_id": "9937a4ad-7d36-3774-a75f-c9273fa6fc68",
                                "text": "Am 12.04.2018 fand im Zeughaus der Feuerwehr Wirts eine Übung des Katastrophenhilfsdienstes Bezirk Amstetten statt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ef391329-dbca-3789-9270-90dd98b9ca6f",
                        "entry_id": "33825a2d-b113-381b-902f-cd2bc39cf542",
                        "glosses": [
                            "deutsche Gemeinde in Baden-Württemberg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb7cab39-ec5b-4f4f-8429-a08a2d40d63d",
                                "sense_id": "ef391329-dbca-3789-9270-90dd98b9ca6f",
                                "text": "Laut Volkszählungsergebnis vom 31. Dezember 2015 hatte Amstetten 3978 Einwohner."
                            },
                            {
                                "example_id": "0f7ff3c5-3de6-4419-b678-9ba53892eab3",
                                "sense_id": "ef391329-dbca-3789-9270-90dd98b9ca6f",
                                "text": "Eine 50-jährige Zugbegleiterin ist bei einem Unfall im Bahnhof von Amstetten in Baden-Württemberg ums Leben gekommen."
                            },
                            {
                                "example_id": "d6d9f6ce-6fe2-4931-852b-0c4f6e773b13",
                                "sense_id": "ef391329-dbca-3789-9270-90dd98b9ca6f",
                                "text": "Durch den Brand eines Elektrorollers haben sieben Menschen in Amstetten (Alb-Donau-Kreis) eine leichte Rauchvergiftung erlitten."
                            },
                            {
                                "example_id": "5d2ad3ca-d686-4526-a549-02b3df62e1d0",
                                "sense_id": "ef391329-dbca-3789-9270-90dd98b9ca6f",
                                "text": "Laut Anklagebehörde wollte der Mann bei Amstetten (Alb-Donau-Kreis) mit seinem 500 PS starken Auto drei Freunden den Nervenkitzel des „gefühlten Abhebens“ von der Straße zeigen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
