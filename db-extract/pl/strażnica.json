                        "source_entry_id": "dceb6a45-29bd-354d-ac62-43ebdaa6841b",
                        "source_sense_id": "eff86c61-3009-3f56-8ced-6c3e5d4418a8",
                        "target_lang_word": "Wachturm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wachturm",
