                    }
                ],
                "senses": [
                    {
                        "sense_id": "b9738576-fdc2-33d6-97d1-51778eb5453a",
                        "entry_id": "b18c3702-f2b0-37ef-9ab2-ace27c75038c",
                        "glosses": [
                            "Kiev (capitale de l’Ukraine)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b7380ae-6b9f-467d-af7f-e2376b0993df",
                                "sense_id": "b9738576-fdc2-33d6-97d1-51778eb5453a",
                                "text": "Auf der Flucht vor dem Krieg kamen Hunderttausende Polen nach Kiew und machten Kiew für ein paar Jahre zu einer lebendigen polnischen Stadt.",
                                "translation": "Fuyant la guerre, des centaines de milliers de Polonais sont arrivés à Kiev et ont fait de Kiev une ville polonaise vivante pendant quelques années."
                            },
                            {
                                "example_id": "2ffb0cd7-0cf9-4981-9b43-b6c0cf763cdf",
                                "sense_id": "b9738576-fdc2-33d6-97d1-51778eb5453a",
                                "text": "Kiew liegt am Don.",
                                "translation": "Kiev est située sur le Don."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff09ec23-e522-3d02-8edc-c01f3f7bf372",
                        "entry_id": "b18c3702-f2b0-37ef-9ab2-ace27c75038c",
                        "glosses": [
                            "Gouvernement ukrainien."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "b69a1263-d5be-4116-8c3f-3ea2e3a7f3b4",
                                "sense_id": "ff09ec23-e522-3d02-8edc-c01f3f7bf372",
                                "text": "Wenn sich Söldner und reguläre Truppen beschossen hätten, wäre dies vor allem Kiew und seinen westlichen Verbündeten zugutegekommen, erklärte Putin. Deren Hoffnung, dass sich Russland selbst zerfleischen werde, habe sich aber nicht erfüllt.",
                                "translation": "Si les mercenaires et les troupes régulières se tiraient dessus, cela aurait surtout profité à Kiev et à ses alliés occidentaux, a expliqué Poutine. Mais l’espoir que la Russie s’étripe elle-même ne s’est pas réalisé."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
