                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "стебелёк",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a134e619-8d83-3463-baa6-ecfb7323c23d",
                                        "entry_id": "d2cae262-d5de-361c-9675-16926c90b0c7",
                                        "glosses": [
                                            "уменьш. к стебель; маленький стебель"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fe482c0-327a-48b3-b460-158b849eef6e",
                                                "sense_id": "a134e619-8d83-3463-baa6-ecfb7323c23d",
                                                "text": "Перед его носом на тоненьком стебельке росли красные ягоды, похожие на костянику."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73a1fff0-6006-3f07-8dac-52b0d1d70372",
                                        "entry_id": "d2cae262-d5de-361c-9675-16926c90b0c7",
                                        "glosses": [
                                            "анат. орган животного, имеющий форму стебля и служащий для соединения каких-либо тканей, органов и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4887444f-5c8a-4a18-b67c-c4815c01dd50",
                                                "sense_id": "73a1fff0-6006-3f07-8dac-52b0d1d70372",
                                                "text": "Оттуда выбегали деловитые крабы с тонкими узорами на спинах и черными глазами на стебельках."
                                            }
