                        "source_sense_id": "df55041e-eea2-3be5-a0e6-d71696e6c836",
                        "target_lang_word": "Insasse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Insasse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "648dedca-24ae-3d8f-a6f9-da91e0c2337e",
                                        "entry_id": "e0780fc1-d1d0-3788-bc8c-05d743870754",
                                        "glosses": [
                                            "Passagier in einem Fahrzeug"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "630df058-d11d-458a-9ee3-7a244f0dda6d",
                                                "sense_id": "648dedca-24ae-3d8f-a6f9-da91e0c2337e",
                                                "text": "Beide Insassen seien angegurtet und die Airbags intakt gewesen, so der Sachverständige."
                                            },
                                            {
                                                "example_id": "86e2ad90-14a0-4cf8-8fbe-970d30fadeb5",
                                                "sense_id": "648dedca-24ae-3d8f-a6f9-da91e0c2337e",
                                                "text": "Ein anderer Insasse berichtete, beim Landeanflug Flammen an einem Triebwerk gesehen zu haben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "45baf9cb-d37a-39e5-8e58-97de13a58986",
                                        "entry_id": "e0780fc1-d1d0-3788-bc8c-05d743870754",
                                        "glosses": [
                                            "Bewohner eines für mehrere Personen bestimmten Wohnsitzes"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "397ab450-21c3-3695-9fa7-1d751ee195bb",
                                        "entry_id": "e0780fc1-d1d0-3788-bc8c-05d743870754",
                                        "glosses": [
                                            "Bewohner eines für mehrere Personen bestimmten Wohnsitzes",
                                            "Bewohner eines Heimes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10ca1035-269e-451d-864b-99afe6cacfd9",
                                                "sense_id": "397ab450-21c3-3695-9fa7-1d751ee195bb",
                                                "text": "Wiederholt sollen Heimbewohner gefesselt worden sein. Exhumierte Leichen ehemaliger Insassen zeigten „ausgedehnte, ungepflegte Wundstellen\" und einen „weitgehend reduzierten Ernährungszustand\"."
                                            },
                                            {
                                                "example_id": "29610ee2-6add-4ff1-8998-f5db3b960f83",
                                                "sense_id": "397ab450-21c3-3695-9fa7-1d751ee195bb",
                                                "text": "Bei diesen Insassen handelte es sich um sieche und kranke und daher in höchstem Maße pflegebedürftige Menschen."
                                            }
                                        ],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "e99b6cea-eaba-3ada-a566-dff53e2c7b50",
                                        "entry_id": "e0780fc1-d1d0-3788-bc8c-05d743870754",
                                        "glosses": [
                                            "Bewohner eines für mehrere Personen bestimmten Wohnsitzes",
                                            "Bewohner einer Heilanstalt oder eines Krankenhauses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a63c17f2-3b58-4f61-b1b3-7fa39fd91fb4",
                                                "sense_id": "e99b6cea-eaba-3ada-a566-dff53e2c7b50",
                                                "text": "Gegen das polizeiliche Urteil, geisteskrank zu sein, besteht keine Einspruchsmöglichkeit, es ist zeitlich nicht begrenzt. Das macht die Hoffnung auf Entlassung für die Insassen so schwer, schwerer als im Gefängnis oder Arbeitslager, wo die Strafen zeitlich begrenzt sind«, sagt Wang."
                                            },
                                            {
                                                "example_id": "571e0f7c-7dda-4565-b06a-f362c6a62eab",
                                                "sense_id": "e99b6cea-eaba-3ada-a566-dff53e2c7b50",
                                                "text": "Alle nicht gemeingefährlichen Insassen von Heilanstalten sind im Wortsinn auf die Straße gesetzt worden."
                                            },
                                            {
                                                "example_id": "3cb5054f-0cf0-4a8a-9941-d9bb9de1c524",
                                                "sense_id": "e99b6cea-eaba-3ada-a566-dff53e2c7b50",
                                                "text": "„Sadistisches Glitzern läßt die schwarze Story vom verlegten Irrenhaus erkennen, dessen Insassen mit dem Flugzeug über den Ozean befördert werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2b\""
                                    },
                                    {
                                        "sense_id": "f8d153bf-76b5-3c80-aeac-1136ed0eb2da",
                                        "entry_id": "e0780fc1-d1d0-3788-bc8c-05d743870754",
                                        "glosses": [
                                            "Bewohner eines für mehrere Personen bestimmten Wohnsitzes",
                                            "jemand, der in einem Gefängnis oder einem Lager angehalten wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00191029-badb-4f20-a747-e335bafa6d96",
                                                "sense_id": "f8d153bf-76b5-3c80-aeac-1136ed0eb2da",
                                                "text": "Gut sieben Jahre nach der Einrichtung des umstrittenen Gefangenenlagers Guantanamo hat erstmals ein US-Zivilgericht die Freilassung von Insassen angeordnet."
                                            },
                                            {
                                                "example_id": "97fc99a6-62c7-48b8-9fc4-4432aa57d81e",
                                                "sense_id": "f8d153bf-76b5-3c80-aeac-1136ed0eb2da",
                                                "text": "Aus Protest gegen ihre Haftbedingungen sind rund 4.000 Insassen griechischer Gefängnisse nach Angaben einer Bürgerrechtsgruppe in den Hungerstreik getreten."
                                            },
                                            {
                                                "example_id": "13fc99ed-dec5-458b-a2f4-54acd396f533",
                                                "sense_id": "f8d153bf-76b5-3c80-aeac-1136ed0eb2da",
                                                "text": "„Nicht weit von seiner Wohnung entfernt lag das Stadtgefängnis, dessen Insassen zum Absingen geistlicher Lieder angehalten wurden, von denen man sich ihre Besserung erwartete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2c\""
                                    }
                                ]
                            }
                        ]
                    },
