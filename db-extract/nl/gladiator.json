                "senses": [
                    {
                        "sense_id": "618881a2-ae43-3476-9933-347ba1060d7a",
                        "entry_id": "fbf01cfb-67ff-3608-99b1-a792b929714d",
                        "glosses": [
                            "zwaardvechter bij de oude Romeinen (die een gevecht leverde als volksvermaak in een amfitheater)"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95ef49f0-d25d-4d7b-8c77-054441925b1a",
                        "source_entry_id": "fbf01cfb-67ff-3608-99b1-a792b929714d",
                        "source_sense_id": "618881a2-ae43-3476-9933-347ba1060d7a",
                        "target_lang_word": "Gladiator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gladiator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90272c0c-93d6-3b48-a50c-378eaedaa0b8",
                                        "entry_id": "cb572621-122d-39f5-9344-cfd12d9ecc97",
                                        "glosses": [
                                            "Schaukämpfer im antiken Rom"
                                        ],
                                        "tags": [
                                            "Antike"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d13d5e7-7ebd-4c7b-a955-34393d52e9b3",
                                                "sense_id": "90272c0c-93d6-3b48-a50c-378eaedaa0b8",
                                                "text": "Die Gladiatoren kämpften um Leben und Tod."
                                            },
                                            {
                                                "example_id": "d3c40035-b6e7-4be3-9746-40a4d6aebbc5",
                                                "sense_id": "90272c0c-93d6-3b48-a50c-378eaedaa0b8",
                                                "text": "„Der Kleine blickt kurz auf, bedankt sich und reißt einem Gladiator den Arm aus.“"
                                            },
                                            {
                                                "example_id": "942d082c-b665-41ef-bf38-07730dbdaa8d",
                                                "sense_id": "90272c0c-93d6-3b48-a50c-378eaedaa0b8",
                                                "text": "„Langsam fuhren wir an den muskelbepackten Gladiatoren vorbei.“"
                                            },
                                            {
                                                "example_id": "377ac760-0efb-488b-b86f-6461d5b2d9b5",
                                                "sense_id": "90272c0c-93d6-3b48-a50c-378eaedaa0b8",
                                                "text": "„Bei diesen Worten lasse ich sie mich beschimpfen, soviel sie will, halte sie im Rücken fest und trage den vollständigsten Sieg davon, den jemals ein gewandter Gladiator davongetragen hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82e9a48b-240a-4e78-ae09-97995b7a2714",
                        "source_entry_id": "fbf01cfb-67ff-3608-99b1-a792b929714d",
                        "source_sense_id": "618881a2-ae43-3476-9933-347ba1060d7a",
                        "target_lang_word": "gladiator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gladiator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5250ad03-2f0a-3486-8956-69ecfd261c2d",
                                        "entry_id": "9f77c822-f483-3b72-ace4-d7948f4b2302",
                                        "glosses": [
                                            "A person (professional or slave) who entertained the public by engaging in mortal combat with another, or with a wild animal."
                                        ],
                                        "tags": [
                                            "Ancient-Rome"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e0984f7-9cd5-4fb8-8a66-89710984579f",
                                                "sense_id": "5250ad03-2f0a-3486-8956-69ecfd261c2d",
                                                "text": "My mother prepared herself for the evening with the same somber deliberateness of the gladiators in Spartacus."
                                            },
                                            {
                                                "example_id": "3586aedb-5157-4c89-af2e-abd88f5a8ec4",
                                                "sense_id": "5250ad03-2f0a-3486-8956-69ecfd261c2d",
                                                "text": "And it's because something of the mundanely manual still adheres to darts that the players' heroic walk of honour from the green room to the oche is so incongruous. The fanfare begins, the strobes go wild, the crowds roar, hostesses wearing the sort of tinsel dresses that drove me crazy when I was eighteen escort the gladiator into the arena, only he's not a gladiator, he's a plumber."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e50fe11e-ba09-360d-bf3b-4f674f0b2899",
                                        "entry_id": "9f77c822-f483-3b72-ace4-d7948f4b2302",
                                        "glosses": [
                                            "A disputant in a public controversy or debate."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "29f585b7-9f64-315f-b2f7-91b8d7417d08",
                                        "entry_id": "9f77c822-f483-3b72-ace4-d7948f4b2302",
                                        "glosses": [
                                            "A professional boxer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11c16fe8-a942-315b-9fb7-3aa67f676eb1",
                                        "entry_id": "9f77c822-f483-3b72-ace4-d7948f4b2302",
                                        "glosses": [
                                            "Synonym of heelwalker (“Any of the order Mantophasmatodea of carnivorous, wingless insects that superficially resemble a cross between praying mantises and phasmids.”)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gladiator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcd9017b-58c5-3eb7-81a0-e851cad5f031",
                                        "entry_id": "a421bec5-135b-3f29-8f75-4869b4238a7b",
                                        "glosses": [
                                            "To fight as entertainment for others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7d252f6-02ae-4761-b361-36c64b14e19f",
                                                "sense_id": "bcd9017b-58c5-3eb7-81a0-e851cad5f031",
                                                "text": "When the dance was done there was the cock-fight, or rather a century of cock-fights, to be reckoned with. For two hundred of these luckless creatures 'gladiatored' bravely, while an appreciative audience held matting up to its chin to keep from being bespattered with blood."
                                            },
                                            {
                                                "example_id": "dcdee464-79b3-4334-9d87-44869f60b01a",
                                                "sense_id": "bcd9017b-58c5-3eb7-81a0-e851cad5f031",
                                                "text": "The guards made me fight other prisoners for their own amusement. It was called gladiatoring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7c74fe5-71e5-38b0-8e3b-a971aa74e3c3",
                                        "entry_id": "a421bec5-135b-3f29-8f75-4869b4238a7b",
                                        "glosses": [
                                            "To compete in a public contest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0c1f900-8694-4ea2-b58c-ea5806fc6155",
                                                "sense_id": "c7c74fe5-71e5-38b0-8e3b-a971aa74e3c3",
                                                "text": "I played very well as was evidenced in that I was the only participant in the entire six or seven days of wind gladiatoring who received a standing ovation from the orchestra, no less."
                                            },
                                            {
                                                "example_id": "013f035f-9d66-4a17-9652-8f7f34d9862e",
                                                "sense_id": "c7c74fe5-71e5-38b0-8e3b-a971aa74e3c3",
                                                "text": "It's himself gladiatoring on the harmonium."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "744ffcd4-6ba2-3196-9521-58987c01793a",
                                        "entry_id": "a421bec5-135b-3f29-8f75-4869b4238a7b",
                                        "glosses": [
                                            "To debate or argue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c07c7dee-5a63-4718-a234-d21e03968d14",
                                                "sense_id": "744ffcd4-6ba2-3196-9521-58987c01793a",
                                                "text": "He did his gladiatoring doubtless without malice, and from a purely sporting instinct — even as Mr. Punch gave the provocation."
                                            },
                                            {
                                                "example_id": "b9ed8916-839e-49d4-bc79-729993a56213",
                                                "sense_id": "744ffcd4-6ba2-3196-9521-58987c01793a",
                                                "text": "Quoting the accounts in both Time and Newsweek, they note that though the \"defense attorney may have outwitted, outsparred, and even \"out gladiatored\" (another popular image in the trial coverage) his opponent, but he still lost the case."
                                            },
                                            {
                                                "example_id": "90305a6d-1e17-4a4c-b044-8173d19931b3",
                                                "sense_id": "744ffcd4-6ba2-3196-9521-58987c01793a",
                                                "text": "It was all part of the gladiatoring: the true performer would argue each case to the utmost, like a debater or mooter in our own world."
                                            },
                                            {
                                                "example_id": "a5720a92-c212-4057-a886-14eb68b28fbc",
                                                "sense_id": "744ffcd4-6ba2-3196-9521-58987c01793a",
                                                "text": "Och! lave off your gladiatoring; sure it's took up I'd be if I did that!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "787f7a27-97b6-3421-94b4-444d7401bed8",
                                        "entry_id": "a421bec5-135b-3f29-8f75-4869b4238a7b",
                                        "glosses": [
                                            "To act aggressively toward others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c493df9d-ef6c-41ad-8b61-af277d40bc49",
                                                "sense_id": "787f7a27-97b6-3421-94b4-444d7401bed8",
                                                "text": "Why, thin, Mister Levi Slam, don't you think now that a volley poured into them haythen mosquitos beyant would put a stop to their gladiatoring a little?"
                                            },
                                            {
                                                "example_id": "924a12d6-0859-4eea-9d8a-214de3881c50",
                                                "sense_id": "787f7a27-97b6-3421-94b4-444d7401bed8",
                                                "text": "It's the Count von Eisenstein,\" says he, \"that's come over to Eire for protection against the murdering English who are marauding and gladiatoring about Germany and would kill him if they could, but thanks be to God,\" says my bold McQuirk, \"he'll be safe enough here and it'll be a good thing to have a friend of the Irish people living in Kilfenora Castle, though maybe you won't like it.\""
                                            },
                                            {
                                                "example_id": "d97a3c96-7922-45a3-a454-8cdcae2d33b5",
                                                "sense_id": "787f7a27-97b6-3421-94b4-444d7401bed8",
                                                "text": "Have I been gladiatoring about the place, boys? Did I squeeze the wizendy little fella a bit rough like?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "def27445-6034-4f52-a8ae-0f6be9090bcc",
                        "source_entry_id": "fbf01cfb-67ff-3608-99b1-a792b929714d",
                        "source_sense_id": "618881a2-ae43-3476-9933-347ba1060d7a",
                        "target_lang_word": "gladiateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gladiateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1110f11-fadc-3346-b07d-92c165fed3a9",
                                        "entry_id": "4ea5f966-5085-31c5-a33b-9cfdbb6e5eea",
                                        "glosses": [
                                            "Combattant qui, dans les jeux du cirque de la Rome antique, participait volontairement ou de force à des joutes pour l’amusement des spectateurs, avec des armes meurtrières, soit contre d’autres personnes, soit contre des bêtes féroces."
                                        ],
                                        "tags": [
                                            "Ancient-Roman"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80f75d03-943a-406d-b182-0f9d8dafda94",
                                                "sense_id": "a1110f11-fadc-3346-b07d-92c165fed3a9",
                                                "text": "Comment concilier la passion immodérée des Romains pour les combats du cirque, et l'infamie dont ils couvraient les instrumens de ces cruels spectacles, les arénaires, bestiaires, gladiateurs ?"
                                            },
                                            {
                                                "example_id": "8bce32a6-a109-4cb3-8cf8-bb5371f22212",
                                                "sense_id": "a1110f11-fadc-3346-b07d-92c165fed3a9",
                                                "text": "Le succès des combats de gladiateurs est en grande partie dû à l’idée que les Romains se faisaient de la vie morale plus forte que la mort. Ce qui passionnait la foule était alors d'observer le visage du gladiateur vaincu qui attend la sentence de la clameur publique et en particulier le visage du même homme quand on l’égorgeait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1896ab67-0b5a-3dee-952b-98fe0fc0979e",
                                        "entry_id": "4ea5f966-5085-31c5-a33b-9cfdbb6e5eea",
                                        "glosses": [
                                            "Spadassin, bretteur."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c53db36-2a28-4d99-8db5-91c2421b26e3",
                                                "sense_id": "1896ab67-0b5a-3dee-952b-98fe0fc0979e",
                                                "text": "— Cela me répugne, répondit le généreux Sigognac, de croire un gentilhomme capable de cette bassesse de faire assassiner son rival par des gladiateurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "231fd6f8-c0be-42df-9eb2-6bf86c7de5d4",
