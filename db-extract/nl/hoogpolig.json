                        "examples": [
                            {
                                "example_id": "120b57e6-b97f-4a88-b8ff-2204d3cc2478",
                                "sense_id": "cd233067-8b16-3177-9445-1668c76ff33c",
                                "text": "Uiterlijkheden als een mooi hoogpolig tapijt en een hardhouten bureau zijn zorgen voor later."
                            },
                            {
                                "example_id": "6e860140-79c7-47ad-aeba-5d4af650d421",
                                "sense_id": "cd233067-8b16-3177-9445-1668c76ff33c",
                                "text": "Anonieme voetstappen over het hoogpolige tapijt in de hotelgang, een slot dat voorzichtig wordt geopend met een sleutelkaart, gekuch of flarden van een vrijpartij (het verschil is moeilijk te horen), misschien een kamer of vijf verderop in de gang."
                            }
                        ]
                    }
