                    },
                    {
                        "sense_id": "9df9953b-9192-33ca-9dda-7ec5e29cbdb3",
                        "entry_id": "5e701a38-cdae-3a8e-807e-9f914a7afaa6",
                        "glosses": [
                            "misdienaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4b15a55-25a1-4dbb-bc2a-232ac22d6212",
                                "sense_id": "9df9953b-9192-33ca-9dda-7ec5e29cbdb3",
                                "text": "Priesters en leraren van het beroemde kathedraalkoor in de Duitse stad Regensburg hebben de afgelopen decennia minstens 231 koorknapen misbruikt, mishandeld of gemarteld"
                            },
                            {
                                "example_id": "2912a3b4-b8e7-4bb1-8a25-8a853ca6e6e7",
                                "sense_id": "9df9953b-9192-33ca-9dda-7ec5e29cbdb3",
                                "text": "Van lieverlede werd hij echter beschouwd als de 'vriend der kinderen'. In Nederland leest men over het St. Nicolaasfeest voor het eerst in het jaar 1360. De koorknaapjes in Dordrecht kregen er vrij voor. In optocht trokken zij door de stad en bedelden, met een smekend gebaar, hun bisschopsgeld bij elkaar. Maar in de zeventiende eeuw werd dit verboden!"
                            }
                        ]
                    }
