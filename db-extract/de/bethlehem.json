                "translations": [
                    {
                        "translation_id": "fb4ed16e-b104-4afd-ae77-42e8295339a6",
                        "source_entry_id": "4c7688d2-17cc-3864-ad25-da3a8fa86810",
                        "source_sense_id": "44e2b110-91e2-3e90-8584-8f43f7a8fd3d",
                        "source_sense_description": "Stadt im Westjordanland (Palästina), laut Bibel Geburtsort von Jesus",
                        "target_lang_word": "Bethléem",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bethléem",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "625bc89a-ea26-3b5a-a8ef-82a42726c6f1",
                                        "entry_id": "af53caa3-3a98-3bd9-9b32-55f3516b4f8b",
                                        "glosses": [
                                            "Ville de Palestine, surtout connue en tant que ville natale de Jésus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "439ae0ac-5afc-495c-8f9a-92541f869a64",
                                                "sense_id": "625bc89a-ea26-3b5a-a8ef-82a42726c6f1",
                                                "text": "Je me dis que bien avant notre naissance — pour parler le Langage humain — Notre-Seigneur nous a rencontrés quelque part , à Bethléem, à Nazareth, sur les routes de Galilée, que sais-je?"
                                            },
                                            {
                                                "example_id": "7dd52f4d-b741-45b9-8912-03371b9ce5da",
                                                "sense_id": "625bc89a-ea26-3b5a-a8ef-82a42726c6f1",
                                                "text": "— Es-tu né à Nazareth?\n— Non. En fait, je suis né à Bethléem, mais c'est une histoire un peu compliquée...\n— C'était écrit, Michée l'a annoncé : « L'Élu sortira de Bethléem. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b98f9b5-99ae-3ac1-8c1e-fd88097edd9e",
                                        "entry_id": "af53caa3-3a98-3bd9-9b32-55f3516b4f8b",
                                        "glosses": [
                                            "Nom d'un quartier de la ville de Clamecy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d217ad5-e107-4c3c-a400-f1581a52350c",
                                                "sense_id": "7b98f9b5-99ae-3ac1-8c1e-fd88097edd9e",
                                                "text": "La conversation, comme c’est l’habitude, entre fils de Beuvron et fils de Bethléem, consiste en quolibets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
