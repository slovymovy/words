                "senses": [
                    {
                        "sense_id": "9201f749-1b61-32ec-8504-4a4d03783ad4",
                        "entry_id": "c20d978f-ceac-3089-8d4c-36ada514d910",
                        "glosses": [
                            "Schleiertuch/Spitzentuch einer spanischen Festtracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3be22fe-3ee6-461f-a25a-41b69de2241a",
                                "sense_id": "9201f749-1b61-32ec-8504-4a4d03783ad4",
                                "text": "Sie kaufte sich als Erinnerung an den Madridaufenthalt eine klassische, schwarze Mantilla."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "71ed9d85-8749-3d0b-be89-976214ca34c3",
                        "entry_id": "c20d978f-ceac-3089-8d4c-36ada514d910",
                        "glosses": [
                            "dreieckiges Schultertuch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "373c76b0-8649-4d7a-8514-fa43090a552d",
                                "sense_id": "71ed9d85-8749-3d0b-be89-976214ca34c3",
                                "text": "„Beim Fernsehkucken strickte sie sich eine Mantilla mit Fransen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "5625d3c5-7830-3623-8c53-1fff5a8f5190",
                        "entry_id": "c20d978f-ceac-3089-8d4c-36ada514d910",
                        "glosses": [
                            "kleiner Mantel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dc2544e-3f7b-41a5-a8c5-5cfeee03ac5f",
                                "sense_id": "5625d3c5-7830-3623-8c53-1fff5a8f5190",
                                "text": "„Nun wusch Natascha sich in aller Eile, zog demütig ihr schlechtestes Kleid und ihre älteste Mantille an und ging mit Agrafena Iwanowna, in der Morgenfrische vor Kälte zitternd, durch die unbelebten, vom Frührot erhellten Strassen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f655f7d9-4719-4485-9910-9344021e9c2f",
                        "source_entry_id": "c20d978f-ceac-3089-8d4c-36ada514d910",
                        "source_sense_id": "9201f749-1b61-32ec-8504-4a4d03783ad4",
                        "source_sense_description": "Schleiertuch/Spitzentuch einer spanischen Festtracht",
                        "target_lang_word": "mantilla",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mantilla",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46a8423b-571e-3b91-aee7-203b146e625a",
                                        "entry_id": "f45c1c03-bda8-3cdc-abfc-6794b16a23de",
                                        "glosses": [
                                            "A lace veil of Spanish origin worn over a woman's hair and shoulders."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7196fd1c-7844-44c1-be7d-209a3dfd3a2c",
                                                "sense_id": "46a8423b-571e-3b91-aee7-203b146e625a",
                                                "text": "[M]y eyes were oft times [on the] charmante maitresse de la maison, who glided among her guests in her flowing Spanish mantilla, and train of the clearest blonde, doing her devoirs with winning kindness, and showing how much benevolence of manner adds to beauty."
                                            },
                                            {
                                                "example_id": "42da3f7f-19ee-4800-945e-ee1d18cc3d46",
                                                "sense_id": "46a8423b-571e-3b91-aee7-203b146e625a",
                                                "text": "Still the mantilla preserved its sway; it had taken a fast hold of the affections of all classes of the feminine gender; and there is now as much chance of driving roast-beef from our shores as there is of transporting black mantillas. […] no squire's lady, no duke's duchess, no countess, and no queen, can or need, in these days of mantillas, be without one of these coverlids for the shoulders, these hiders of all deformities, and these friends to all ages and proportions. For there are mantillas from seven shillings to seven pounds,—of all sizes and shapes, with or without fringe, lace, tassels, and other ornaments."
                                            },
                                            {
                                                "example_id": "f35360c7-fbcd-4372-aaf7-01246e608082",
                                                "sense_id": "46a8423b-571e-3b91-aee7-203b146e625a",
                                                "text": "Mantillas are larger than last year, and are generally all worn with a deep flouncing, either of the same material, or of black lace; the mantilla itself is also much trimmed with small ruchings of ribbon, guip and guipure lace, laid on quite flat. […] Black lace shawls and mantillas will always be in the best taste—the Spanish origin of the Empress Eugénie, having given her a penchant for these articles, the national mantilla of her country, of which we have borrowed the name."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb7d45f2-23c2-32d4-a5b0-edc3a343e7d5",
                                        "entry_id": "f45c1c03-bda8-3cdc-abfc-6794b16a23de",
                                        "glosses": [
                                            "A woman's light cloak or cape made of silk, velvet, lace, or other material."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f511674-5bf6-4569-9032-c9398fed474a",
                                                "sense_id": "fb7d45f2-23c2-32d4-a5b0-edc3a343e7d5",
                                                "text": "The Duchess of Alba wrapped herself in a mantilla coat, asked her guest to take a chair in the middle of the patio and placed herself three steps behind him in the shade of a magnolia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6726fce3-d387-46a9-8c9f-692eb541afba",
                        "source_entry_id": "c20d978f-ceac-3089-8d4c-36ada514d910",
                        "source_sense_id": "9201f749-1b61-32ec-8504-4a4d03783ad4",
                        "source_sense_description": "Schleiertuch/Spitzentuch einer spanischen Festtracht",
                        "target_lang_word": "mantille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mantille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "157c61b4-2e9c-3c5d-bafd-9c83cdbd2bbe",
                                        "entry_id": "40e7c7f9-fbbc-3c6f-b522-743612b2f9c9",
                                        "glosses": [
                                            "Fichu de soie ou de dentelle dont les Espagnoles se couvrent la tête et les épaules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12c32bd7-f97a-40d4-834c-8a6e39120365",
                                                "sense_id": "157c61b4-2e9c-3c5d-bafd-9c83cdbd2bbe",
                                                "text": "Je trouvai deux jeunes demoiselles de seize à dix-huit ans, commodément établies sur des chaises, et s’éventant de l’air du monde le plus dégagé. Toutes les deux étaient fort jolies, et à leurs robes de soie noire fort propres, à leurs souliers de satin et à leurs mantilles garnies de dentelles, je jugeai qu’elles devaient être les filles de quelque bourgeois aisé."
                                            },
                                            {
                                                "example_id": "abe79180-0619-4c0f-8385-88d07749661f",
                                                "sense_id": "157c61b4-2e9c-3c5d-bafd-9c83cdbd2bbe",
                                                "text": "La mantille espagnole est donc une vérité ; j’avais pensé qu’elle n’existait plus que dans les romances de M. Crevel de Charlemagne : elle est en dentelles noires ou blanches, plus habituellement noires, et se pose à l’arrière de la tête sur le haut du peigne ; quelques fleurs placées sur les tempes complètent cette coiffure qui est la plus charmante qui se puisse imaginer. Avec une mantille, il faut qu’une femme soit laide comme les trois vertus théologales pour ne pas paraître jolie ; malheureusement, c’est la seule partie du costume espagnol que l’on ait conservée : le reste est à la française."
                                            },
                                            {
                                                "example_id": "7ca87137-6a47-4cf7-bba6-a36207aa468a",
                                                "sense_id": "157c61b4-2e9c-3c5d-bafd-9c83cdbd2bbe",
                                                "text": "La femme du Maltais est toujours simple, modeste et jolie. On la reconnaît à sa tenue discrète, et surtout à une sorte de mantille particulière, noire et raide comme une capote de cabriolet."
                                            },
                                            {
                                                "example_id": "ce58bbb5-a416-431f-8ca9-4a501ad08b74",
                                                "sense_id": "157c61b4-2e9c-3c5d-bafd-9c83cdbd2bbe",
                                                "text": "Padre Pugnaccio, le crâne hors du capuce, montait les escaliers du dôme Saint-Pierre, entre deux dévotes enveloppées de mantilles."
                                            },
                                            {
                                                "example_id": "ee24fee2-38f6-4dea-9242-3e997daee47c",
                                                "sense_id": "157c61b4-2e9c-3c5d-bafd-9c83cdbd2bbe",
                                                "text": "Autrefois Anny emportait dans tous ses bagages une immense valise pleine de châles, de turbans, de mantilles, de masques japonais, d’images d’Épinal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62430c93-2fbc-3e4d-ba1c-a941728c1031",
                                        "entry_id": "40e7c7f9-fbbc-3c6f-b522-743612b2f9c9",
                                        "glosses": [
                                            "Diverses imitations de cette pièce de toilette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddc0d00c-3cc8-4c06-b25d-c90b037620e4",
                                                "sense_id": "62430c93-2fbc-3e4d-ba1c-a941728c1031",
                                                "text": "Une mantille garnie de velours, de dentelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
