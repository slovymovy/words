{
    "word_family": [
        "dislocation",
        "dislocator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3e07a4ed-687a-39ee-8297-b3f425ec99b6",
                    "sense_definition": "To force a bone out of its normal position in a joint.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>dislocate</w> his shoulder while playing rugby last weekend.",
                            "target_lang_translations": {
                                "zh": "上周末打橄榄球时，他不小心把肩膀<w>脱臼</w>了。"
                            }
                        },
                        {
                            "text": "The doctor had to <w>dislocate</w> the joint back into place after the accident.",
                            "target_lang_translations": {
                                "zh": "事故发生后，医生不得不将他<w>脱臼</w>的关节复位。"
                            }
                        }
                    ],
                    "synonyms": [
                        "luxate"
                    ],
                    "common_phrases": [
                        "dislocate a shoulder"
                    ],
                    "target_lang_definitions": {
                        "zh": "指骨头脱离关节的正常位置。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "脱臼",
                                "target_lang_sense_clarification": "指关节脱位，常用于描述骨骼损伤。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2103abb6-9e24-302d-9fcc-6d96fd5580f8",
                    "sense_definition": "To move something from its usual or proper place.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new highway project will <w>dislocate</w> hundreds of families from their homes.",
                            "target_lang_translations": {
                                "zh": "新的高速公路项目将导致数百户家庭<w>流离失所</w>。"
                            }
                        },
                        {
                            "text": "Economic changes often <w>dislocate</w> traditional patterns of trade in small villages.",
                            "target_lang_translations": {
                                "zh": "经济变革往往会<w>扰乱</small>小村庄传统的贸易模式。"
                            }
                        }
                    ],
                    "synonyms": [
                        "displace"
                    ],
                    "target_lang_definitions": {
                        "zh": "指将某物从其通常或适当的位置移走，常指被迫迁移或扰乱原有秩序。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使流离失所",
                                "target_lang_sense_clarification": "特指因工程或灾难导致人们被迫离开家园。"
                            },
                            {
                                "target_lang_word": "扰乱",
                                "target_lang_sense_clarification": "指破坏原有的模式或秩序。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e93f716-4d0d-3ddf-aff6-f98b612241e6",
                    "sense_definition": "To cause someone to feel confused, unsettled, or out of place.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden change in scenery served to <w>dislocate</w> his sense of time and reality.",
                            "target_lang_translations": {
                                "zh": "景色的突然变化让他对时间和现实感到了<w>迷失</w>。"
                            }
                        },
                        {
                            "text": "Moving to a foreign country can <w>dislocate</w> one's feeling of belonging for a long time.",
                            "target_lang_translations": {
                                "zh": "移居国外可能会让人长期感到<w>不安</w>，难以产生归属感。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指使人感到困惑、不安或与环境格格不入。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使迷失",
                                "target_lang_sense_clarification": "指心理上失去方向感或归属感。"
                            },
                            {
                                "target_lang_word": "使不安",
                                "target_lang_sense_clarification": "指因环境变化而产生的心理不适。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}