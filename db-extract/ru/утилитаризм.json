                                        "entry_id": "555f2bad-b0df-32e7-a2a8-3d5f244bfae8",
                                        "glosses": [
                                            "Action politique inspirée par l’utilitarisme."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
