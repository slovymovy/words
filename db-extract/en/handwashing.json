                        "sense_id": "1b0edaab-9c91-3830-a171-4d9ab4f9a558",
                        "entry_id": "64ef1862-dbf8-32f9-b318-3237b39d8931",
                        "glosses": [
                            "The washing of one's hands."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "48937e05-688d-4698-8de4-08eeb88dd8fd",
                                "sense_id": "1b0edaab-9c91-3830-a171-4d9ab4f9a558",
                                "text": "The mirror comes alive with images, guiding you through the steps of handwashing: turn on the taps, lather your hands with soap, rinse your hands, turn off the taps, dry your hands."
                            },
                            {
                                "example_id": "264f5320-2e12-4de4-b061-3b577ed62616",
                                "sense_id": "1b0edaab-9c91-3830-a171-4d9ab4f9a558",
                                "text": "The benefits of increased hygiene as a result of Covid-19 could stretch even further ahead. Most schools are insisting on regular hand washing, and are encouraging children to rub soap into their hands for 20 seconds or more, before rinsing it off."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61a27868-fd2c-4838-b425-c7c38621aa30",
                        "source_entry_id": "64ef1862-dbf8-32f9-b318-3237b39d8931",
                        "source_sense_id": "1b0edaab-9c91-3830-a171-4d9ab4f9a558",
                        "source_sense_description": "washing of one's hands",
                        "target_lang_word": "Händewaschen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Händewaschen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4fba659-c1ba-398f-92b1-d11c0f526734",
                                        "entry_id": "c204a361-6e74-3f3d-9376-efbe548b52d8",
                                        "glosses": [
                                            "Reinigung der Hände mit Wasser und Seife oder desinfizierenden Mitteln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98d7f4ac-d2ad-44c8-85b5-9aaa84feb19e",
                                                "sense_id": "b4fba659-c1ba-398f-92b1-d11c0f526734",
                                                "text": "Die günstigste, einfachste und wichtigste Methode die Ausbreitung des Coronavirus zu verhindern ist: Häufiges und gründliches Händewaschen mit Wasser und Seife!"
                                            },
                                            {
                                                "example_id": "5cad9730-1d5b-4aa8-9d1b-c2d57d3d3d91",
                                                "sense_id": "b4fba659-c1ba-398f-92b1-d11c0f526734",
                                                "text": "Zum Händewaschen geht es hier ins Badezimmer."
                                            },
                                            {
                                                "example_id": "bc5ad9aa-5767-4d2b-8ee8-cb68d1bb8d02",
                                                "sense_id": "b4fba659-c1ba-398f-92b1-d11c0f526734",
                                                "text": "Das Händewaschen schützt die Schleimhäute von Mund, Nase oder Augen vor Krankheitserregern."
                                            },
                                            {
                                                "example_id": "9571467f-ea4f-4fb4-8f3b-dcc46fa083cc",
                                                "sense_id": "b4fba659-c1ba-398f-92b1-d11c0f526734",
                                                "text": "Das richtige Händewaschen ist aber nicht nur im Kontext von Covid-19 wichtig, viele Fälle von schweren anderen Infektionen würden sich damit verhindern lassen."
                                            },
                                            {
                                                "example_id": "adcb08e4-e113-4c44-9777-a1ac3c8ed070",
                                                "sense_id": "b4fba659-c1ba-398f-92b1-d11c0f526734",
                                                "text": "Regelmäßiges Händewaschen reduziert das Auftreten von Durchfall-Erkrankungen bei Kindern um die Hälfte."
                                            },
                                            {
                                                "example_id": "bbe92ed4-8345-40af-9f51-6d8933fec22a",
                                                "sense_id": "b4fba659-c1ba-398f-92b1-d11c0f526734",
                                                "text": "„Vor dem Abendessen waren die Kinder wie immer zum Händewaschen gekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
