                                            {
                                                "example_id": "96634494-ba56-45de-b3ff-f00c5445c82f",
                                                "sense_id": "67a5bf56-18d3-3fd5-b6f9-ed62275a9220",
                                                "text": "Un bandit de la pire des espèces."
