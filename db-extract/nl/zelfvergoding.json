                "senses": [
                    {
                        "sense_id": "cf099f8e-2753-3387-bb3b-053fc4aff156",
                        "entry_id": "ce6f1803-6155-3724-8b17-8f694005527d",
                        "glosses": [
                            "het overmatig zichzelf of de eigen groep verheerlijken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67c00ded-c4ed-441e-9a80-478e9298c24f",
                                "sense_id": "cf099f8e-2753-3387-bb3b-053fc4aff156",
                                "text": "Het was haar stellige overtuiging dat levensbeschouwingen die de plaats innemen van het christelijke geloof – wat vaak neerkomt op een bepaalde vorm van nihilisme – leidt tot egocentrisme, zelfvergoding, liefdeloosheid, uitsluiting van medemensen of misbruik."
                            },
                            {
                                "example_id": "9ecfacf0-38cc-4af1-8879-23d9adeb6ab3",
                                "sense_id": "cf099f8e-2753-3387-bb3b-053fc4aff156",
                                "text": "Een van de meest diep borende beschouwingen kwam van prof. G. Wisse (toen nog gereformeerd). Hij schrijft (in de brochure ”Het gansche schepsel in baringsnood”) over de grote stuwing van de geschiedenis na de zondeval, over een „procesmatige ontplooiing” van de zonde, een „evolutie” van „zelfvergoding en geweld”: „Waarlijk, hij die dit alles ziet en kent, die is het toch eigenlijk weer geen wonder, geen verrassing, dat de dingen van thans geschieden.”"
                            }
                        ]
                    }
