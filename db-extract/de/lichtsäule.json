                        "glosses": [
                            "säulenförmiges Licht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76b42021-e0aa-455e-90f7-ad37e06de97a",
                                "sense_id": "cdbf8291-0fdf-3fa3-a08f-f36b9f31ef8a",
                                "text": "„Noch während er hinsah, meinte er zu erkennen, wie die Lichtsäule langsam an Umfang gewann, sich ihre unbekannte Farbe intensivierte und das Bildnis während seiner Metamorphosen neue, noch nicht gesehene Gestalten annahm.“"
                            },
                            {
                                "example_id": "41ceee8b-d186-477d-be83-a04ab50278df",
                                "sense_id": "cdbf8291-0fdf-3fa3-a08f-f36b9f31ef8a",
                                "text": "„Die kraftvollen Lichtsäulen schnitten wie Klingen durch das tiefe Blau.“"
                            },
                            {
                                "example_id": "7eb34ad2-ce22-46bf-bc4f-7f9a67690c6b",
                                "sense_id": "cdbf8291-0fdf-3fa3-a08f-f36b9f31ef8a",
                                "text": "„Er kletterte wieder zurück auf den Gewölbeboden, ging in die Hocke und klopfte sich mit den Fingern aufs Knie; die Lichtsäule mündete direkt in seinen Kopf, rief aber offenbar weder Schmerzen noch Inspirationen hervor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
