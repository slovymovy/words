                    {
                        "sense_id": "1ea7aca8-93ba-38cd-92e7-a07b0941d04b",
                        "entry_id": "b967e560-cd22-3e5c-aa5e-8363cc23a36c",
                        "glosses": [
                            "Habitant de Versailles, commune française située dans le département des Yvelines."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4b13ca8c-1143-3b58-a40d-76382357247b",
                        "entry_id": "b967e560-cd22-3e5c-aa5e-8363cc23a36c",
                        "glosses": [
                            "Membre de la coalition politique qui réprima la Commune de Paris en 1871."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5062bf3a-8813-4018-b244-d9ef322d390c",
                                "sense_id": "4b13ca8c-1143-3b58-a40d-76382357247b",
                                "text": "Comme faucheurs rasant un pré\nComme on abat des pommes\nLes Versaillais ont massacré\nPour le moins cent mille hommes\nEt les cent mille assassinats\nVoyez ce que ça rapporte."
                            },
                            {
                                "example_id": "8fe7fedb-6446-40b9-b8f4-bc419558e57d",
                                "sense_id": "4b13ca8c-1143-3b58-a40d-76382357247b",
                                "text": "Il prétendait ne pas connaître son âge mais il avait fait le coup de feu dans les rangs des Versaillais : pour lui, Paris, c’était toujours les communards."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
