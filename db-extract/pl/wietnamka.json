                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11aae758-dcdd-4ea5-8ec9-53d6595f9051",
                                                "sense_id": "d093b479-a551-3d76-ac53-01e5d519c979",
                                                "text": "„Die Vietnamesin hatte, nachdem sie auf dem Weihnachtsmarkt kontrolliert worden war und keine Arbeitsberechtigung vorweisen konnte, eine Nacht in Untersuchungshaft verbringen müssen.“"
                                            },
                                            {
                                                "example_id": "16e5b696-fc87-4a21-bd9e-6a9ace012bc3",
                                                "sense_id": "d093b479-a551-3d76-ac53-01e5d519c979",
                                                "text": "„Erst nachdem er eine Weile international geliebt hatte, kam Sung einer Vietnamesin nahe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
