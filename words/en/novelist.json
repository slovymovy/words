                        {
                            "text": "The scientist was a true <w>novelist</w> in her field, constantly proposing radical theories.",
                            "target_lang_translations": {
                                "ru": "Ученая была настоящим <w>новатором</w> в своей области, постоянно предлагая радикальные теории."
                            }
                        }
                    ],
