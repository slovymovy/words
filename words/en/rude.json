{
    "word_family": [
        "rudeness",
        "rudely"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "90964215-9a73-3170-9686-5c6f1be5bac7",
                    "sense_definition": "Lacking politeness or good manners; offensive or showing a lack of respect for others.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is considered very <w>rude</w> to point your finger at people.",
                            "target_lang_translations": {
                                "ru": "Считается очень <w>невежливым</w> показывать на людей пальцем.",
                                "zh": "用手指指人被认为是非常<w>无礼</w>的行为。"
                            }
                        },
                        {
                            "text": "She apologized for being <w>rude</w> to the waiter during dinner.",
                            "target_lang_translations": {
                                "ru": "Она извинилась за то, что была <w>груба</w> с официантом во время ужина.",
                                "zh": "她为晚餐时对服务员表现得<w>粗鲁</w>而道歉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "impolite",
                        "ill-mannered",
                        "uncouth",
                        "bad-mannered"
                    ],
                    "antonyms": [
                        "polite",
                        "courteous"
                    ],
                    "common_phrases": [
                        "rude to someone",
                        "how rude",
                        "rude remark"
                    ],
                    "target_lang_definitions": {
                        "ru": "Невежливый или невоспитанный; оскорбительный или проявляющий неуважение к другим.",
                        "zh": "缺乏礼貌或教养；冒犯他人或表现出对他人的不尊重。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грубый",
                                "target_lang_sense_clarification": "основное значение; резкий и обидный"
                            },
                            {
                                "target_lang_word": "невежливый",
                                "target_lang_sense_clarification": "нарушающий правила приличия"
                            },
                            {
                                "target_lang_word": "невоспитанный",
                                "target_lang_sense_clarification": "не умеющий вести себя в обществе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无礼",
                                "target_lang_sense_clarification": "指言行不符合礼节，冒犯他人"
                            },
                            {
                                "target_lang_word": "粗鲁",
                                "target_lang_sense_clarification": "指态度生硬、不客气"
                            },
                            {
                                "target_lang_word": "没教养",
                                "target_lang_sense_clarification": "指缺乏基本的社交礼仪"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ea0ee62-4775-31ff-b04a-8d9e7873f023",
                    "sense_definition": "Relating to sexual matters or bodily functions in a way that is considered offensive, humorous, or vulgar.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vulgarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedian told a <w>rude</w> joke that made some people blush.",
                            "target_lang_translations": {
                                "ru": "Комик рассказал <w>пошлую</w> шутку, от которой некоторые покраснели.",
                                "zh": "那个喜剧演员讲了一个<w>下流</w>的笑话，让一些人脸红了。"
                            }
                        },
                        {
                            "text": "Parents often tell their children not to use <w>rude</w> words in public.",
                            "target_lang_translations": {
                                "ru": "Родители часто говорят детям не использовать <w>неприличные</w> слова на людях.",
                                "zh": "父母经常告诉孩子不要在公共场合说<w>粗俗</w>的话。"
                            }
                        }
                    ],
                    "synonyms": [
                        "obscene",
                        "blue",
                        "adult",
                        "pornographic"
                    ],
                    "antonyms": [
                        "decent",
                        "clean"
                    ],
                    "common_phrases": [
                        "rude joke",
                        "rude word",
                        "rude gesture"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to describe mild obscenity or dirty humor"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неприличный или вульгарный; относящийся к сексуальным темам или функциям организма.",
                        "zh": "指涉及性或身体部位，被认为是不雅、下流或粗俗的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неприличный",
                                "target_lang_sense_clarification": "о словах, жестах или поведении"
                            },
                            {
                                "target_lang_word": "пошлый",
                                "target_lang_sense_clarification": "вульгарный, часто о юморе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "下流",
                                "target_lang_sense_clarification": "指言语或行为卑劣、不雅"
                            },
                            {
                                "target_lang_word": "粗俗",
                                "target_lang_sense_clarification": "指言语或行为不文明、粗野"
                            },
                            {
                                "target_lang_word": "不雅",
                                "target_lang_sense_clarification": "指不符合礼仪或体面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a69ee9c-c257-373f-abfa-8772c6a2c2a2",
                    "sense_definition": "Roughly made or built; simple, primitive, and lacking finish or skill.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The survivors built a <w>rude</w> shelter from branches to protect themselves from the rain.",
                            "target_lang_translations": {
                                "ru": "Выжившие построили <w>примитивное</w> укрытие из веток, чтобы защититься от дождя.",
                                "zh": "幸存者用树枝搭建了一个<w>简陋</w>的避雨棚。"
                            }
                        },
                        {
                            "text": "He sat on a <w>rude</w> wooden bench outside the old cottage.",
                            "target_lang_translations": {
                                "ru": "Он сидел на <w>грубой</w> деревянной скамье возле старого коттеджа.",
                                "zh": "他坐在老屋外面一张<w>粗糙</w>的木凳上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "primitive",
                        "crude"
                    ],
                    "antonyms": [
                        "sophisticated",
                        "refined"
                    ],
                    "common_phrases": [
                        "rude shelter",
                        "rude tools"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грубо сделанный, примитивный; простой и лишенный отделки.",
                        "zh": "制作粗糙；简单、原始，缺乏精细的加工或技巧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грубый",
                                "target_lang_sense_clarification": "о качестве обработки материала или конструкции"
                            },
                            {
                                "target_lang_word": "примитивный",
                                "target_lang_sense_clarification": "простой, несовершенный"
                            },
                            {
                                "target_lang_word": "неотёсанный",
                                "target_lang_sense_clarification": "необработанный (о материале)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "粗糙",
                                "target_lang_sense_clarification": "指制作不精细，表面不光滑"
                            },
                            {
                                "target_lang_word": "简陋",
                                "target_lang_sense_clarification": "指结构简单，条件差"
                            },
                            {
                                "target_lang_word": "原始",
                                "target_lang_sense_clarification": "指处于最初阶段，未经过多加工"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f323698-ff74-394d-8f96-9155197ce181",
                    "sense_definition": "Sudden, violent, or unpleasant, especially regarding a shock or realization.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "shock",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He received a <w>rude</w> awakening when he realized he had missed the deadline.",
                            "target_lang_translations": {
                                "ru": "Его ждало <w>неприятное</w> открытие, когда он понял, что пропустил крайний срок.",
                                "zh": "当他意识到自己错过了截止日期时，遭到了一个<w>突然</w>的打击。"
                            }
                        },
                        {
                            "text": "The icy water was a <w>rude</w> shock to his system after the warm sauna.",
                            "target_lang_translations": {
                                "ru": "Ледяная вода стала <w>резким</w> шоком для его организма после теплой сауны.",
                                "zh": "洗完热桑拿后，冰水对他来说是一个<w>猛烈</w>的刺激。"
                            }
                        }
                    ],
                    "antonyms": [
                        "gentle"
                    ],
                    "common_phrases": [
                        "rude awakening",
                        "rude shock"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапный, резкий или неприятный (обычно о потрясении или осознании).",
                        "zh": "突然的、剧烈的或令人不快的，尤指令人震惊的现实或打击。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "внезапный и сильный"
                            },
                            {
                                "target_lang_word": "неприятный",
                                "target_lang_sense_clarification": "вызывающий негативные эмоции"
                            },
                            {
                                "target_lang_word": "жестокий",
                                "target_lang_sense_clarification": "беспощадный (о разочаровании)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "突然",
                                "target_lang_sense_clarification": "指发生得很快，出乎意料"
                            },
                            {
                                "target_lang_word": "猛烈",
                                "target_lang_sense_clarification": "指程度剧烈，冲击力强"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76aa5041-fd3b-366f-a282-8aa175e4c7d7",
                    "sense_definition": "Vigorous and robust; used almost exclusively to describe excellent physical condition.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite his advanced age, the grandfather is in <w>rude</w> health.",
                            "target_lang_translations": {
                                "ru": "Несмотря на преклонный возраст, дедушка обладает <w>крепким</w> здоровьем.",
                                "zh": "尽管年事已高，这位祖父依然身体<w>健壮</w>。"
                            }
                        },
                        {
                            "text": "She returned from her holiday looking tanned and in <w>rude</w> health.",
                            "target_lang_translations": {
                                "ru": "Она вернулась из отпуска загорелой и с <w>отменным</w> здоровьем.",
                                "zh": "她度假回来时晒黑了，看起来身体非常<w>硬朗</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in rude health"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крепкий, цветущий; используется почти исключительно для описания отличного физического состояния.",
                        "zh": "精力充沛且强壮；几乎专门用于描述极佳的身体状况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крепкий",
                                "target_lang_sense_clarification": "сильный, здоровый"
                            },
                            {
                                "target_lang_word": "отменный",
                                "target_lang_sense_clarification": "превосходный (о здоровье)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "健壮",
                                "target_lang_sense_clarification": "指身体强壮，精力旺盛"
                            },
                            {
                                "target_lang_word": "硬朗",
                                "target_lang_sense_clarification": "常用于形容老年人身体健康"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}