                ],
                "senses": [
                    {
                        "sense_id": "465d936e-9cc2-3d2f-b82a-015ed9a022f9",
                        "entry_id": "c13fec39-8086-3d52-b5b4-c698d5431258",
                        "glosses": [
                            "(männliche) Person, die eine Katze zur Haustierhaltung besitzt, die sich eine Katze hält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89a921d4-e245-485e-a8b3-4e72585f54a5",
                                "sense_id": "465d936e-9cc2-3d2f-b82a-015ed9a022f9",
                                "text": "„Nicht selten entwickeln sich chronische Krankheiten, weil der Katzenhalter über Jahre falsch gefüttert hat.“"
                            },
                            {
                                "example_id": "93ebe774-634d-4f9d-9885-e0108fe85d46",
                                "sense_id": "465d936e-9cc2-3d2f-b82a-015ed9a022f9",
                                "text": "„Viele Katzenhalter klagen darüber, dass die Katze im Spiel fest zu beißt oder Hände beziehungsweise Füße angreift.“"
                            },
                            {
                                "example_id": "cae1988c-276a-4866-97a7-48312b7ff709",
                                "sense_id": "465d936e-9cc2-3d2f-b82a-015ed9a022f9",
                                "text": "„Jeder, der sich eine Katze anschaffen möchte und auch viele erfahrene Katzenhalter haben Fragen zum Thema Katzenhaltung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
