                "senses": [
                    {
                        "sense_id": "6968ec9c-b285-3cd8-8f55-f1a96549875a",
                        "entry_id": "38880d2a-25ba-3fe8-8f0f-21d28ed3d570",
                        "glosses": [
                            "Theorie und Philosophie der sinnlichen Wahrnehmung von Geruch"
                        ],
                        "tags": [
                            "ursprünglich"
                        ],
                        "examples": [
                            {
                                "example_id": "2175fd7f-f67b-4b51-adc9-3320b1a57543",
                                "sense_id": "6968ec9c-b285-3cd8-8f55-f1a96549875a",
                                "text": "Als eigenständige philosophische Disziplin wurde die Geruchsästhetik in Deutschland erstmals von Hans Henning, Privatdozent an der Universität Frankfurt a. M. anno 1913 publiziert."
                            },
                            {
                                "example_id": "627d322a-8be8-4205-8d34-12bde53851b0",
                                "sense_id": "6968ec9c-b285-3cd8-8f55-f1a96549875a",
                                "text": "„Es geht in dieser Studie von Christopher Dietz, um es kurz zu formulieren, um die Ideologie von Doderers Geruchsästhetik, doch nicht in dem Sinne, daß dadurch dem Autor die Leviten im Stile eines auf Political correctness bedachten Vorgehens gelesen werden.“"
                            },
                            {
                                "example_id": "cd51e7e7-2bff-4761-aa81-99cfbe9846ac",
                                "sense_id": "6968ec9c-b285-3cd8-8f55-f1a96549875a",
                                "text": "„Insbesondere sind es gewisse Inſekten, auf die auch bei der Blütensuche von diesen Blüten mit feinem Aroma und nicht mit Limburger spekuliert wurde, deren Geruchsästhetik also offenbar eine edle, der unseren verwandte sein mußte.“"
                            },
                            {
                                "example_id": "92fddd76-5ca2-43be-92b9-5df42dc31464",
                                "sense_id": "6968ec9c-b285-3cd8-8f55-f1a96549875a",
                                "text": "„Die Geruchsästhetik.“"
                            },
                            {
                                "example_id": "55af16fa-89c2-44d0-8200-d1c67187c575",
                                "sense_id": "6968ec9c-b285-3cd8-8f55-f1a96549875a",
                                "text": "„Ich habe mich mit der Geruchsästhetik des französischen Parfüms im 19. und 20. Jahrhunderts befasst, Bücher über die Geschichte des Parfüms geschrieben und arbeite nach wie vor in der einschlägigen Grundlagenforschung.“"
                            },
                            {
                                "example_id": "87068e94-51cd-4e88-91a4-ccae962ddddd",
                                "sense_id": "6968ec9c-b285-3cd8-8f55-f1a96549875a",
                                "text": "„Ich gehe von der Annahme aus, daß sich in den sozialen Milieus durchaus ganz bestimmte Geruchsästhetiken, 'Geruchsordnungen' oder 'Geruchsstile' entwickelt haben und jeweils auch ganz bestimmte Erwartungen und Vorstellungen zum praktischen Umgang mit den Gerüchen existieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1eee34b8-d9aa-3358-9aa5-62820e1d3e9d",
                        "entry_id": "38880d2a-25ba-3fe8-8f0f-21d28ed3d570",
                        "glosses": [
                            "Lehre des gut Riechen"
                        ],
                        "tags": [
                            "heute häufiger in dieser Bedeutung"
                        ],
                        "examples": [
                            {
                                "example_id": "705cac7e-9a7a-4e18-ab65-240adc71e528",
                                "sense_id": "1eee34b8-d9aa-3358-9aa5-62820e1d3e9d",
                                "text": "Die Geruchsästhetik darf bei Ihr niemals zu kurz kommen, da Sie einen ausgesprochen guten Sinn für Wohlgerüche hat."
                            },
                            {
                                "example_id": "bf913fe8-cf9f-4d34-97ae-1d70b0ec693d",
                                "sense_id": "1eee34b8-d9aa-3358-9aa5-62820e1d3e9d",
                                "text": "„Diese Studie stellt nicht die optische Ästhetik, sondern die Geruchsästhetik in den Mittelpunkt ihrer Betrachtung.“"
                            },
                            {
                                "example_id": "925c17c5-ac87-4b3f-a436-67c983d1f310",
                                "sense_id": "1eee34b8-d9aa-3358-9aa5-62820e1d3e9d",
                                "text": "Tausenderlei wohlriechender Düfte zeugen von ausgeprägter Geruchsästhetik."
                            },
                            {
                                "example_id": "f0e60052-415e-4c0f-9ec4-309f20869204",
                                "sense_id": "1eee34b8-d9aa-3358-9aa5-62820e1d3e9d",
                                "text": "„Die Geruchsästhetik.“"
                            },
                            {
                                "example_id": "7795afeb-07e2-47c8-8d9b-98c6fabd23e7",
                                "sense_id": "1eee34b8-d9aa-3358-9aa5-62820e1d3e9d",
                                "text": "„Ich habe mich mit der Geruchsästhetik des französischen Parfüms im 19. und 20. Jahrhunderts befasst, Bücher über die Geschichte des Parfüms geschrieben und arbeite nach wie vor in der einschlägigen Grundlagenforschung.“"
                            },
                            {
                                "example_id": "5065f139-1ee3-4617-b6cb-4df828179e84",
                                "sense_id": "1eee34b8-d9aa-3358-9aa5-62820e1d3e9d",
                                "text": "„Ich gehe von der Annahme aus, daß sich in den sozialen Milieus durchaus ganz bestimmte Geruchsästhetiken, 'Geruchsordnungen' oder 'Geruchsstile' entwickelt haben und jeweils auch ganz bestimmte Erwartungen und Vorstellungen zum praktischen Umgang mit den Gerüchen existieren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
