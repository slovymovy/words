                    {
                        "sense_id": "235f58f6-c45f-3773-af5a-20619be4f4fb",
                        "entry_id": "fbe6ea2c-cf75-3671-a665-233b7193f0f2",
                        "glosses": [
                            "Gelände, auf dem sich ein kaufmännischer Betrieb oder ein gewerbliches Unternehmen befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95e450df-50ac-4897-8595-5aeff3e5def0",
                                "sense_id": "235f58f6-c45f-3773-af5a-20619be4f4fb",
                                "text": "„Es ist eine Grundsatzfrage, die das Bundesarbeitsgericht in Erfurt am Dienstag entschieden hat: Dürfen Mitarbeiter auf dem Firmengelände streiken und damit sozusagen das Eigentum des Unternehmens gegen dieses wenden?“"
                            },
                            {
                                "example_id": "5b9df9c9-c200-471c-a963-bc167bda2936",
                                "sense_id": "235f58f6-c45f-3773-af5a-20619be4f4fb",
                                "text": "„Bei einem möglicherweise absichtlich gelegten Brand auf einem Firmengelände in Hünfeld im Kreis Fulda ist ein Schaden von mehr als 300.000 Euro entstanden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
