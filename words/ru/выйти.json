                                "target_lang_word": "用完",
                                "target_lang_sense_clarification": "物资消耗殆尽"
                            },
                            {
                                "target_lang_word": "到期",
                                "target_lang_sense_clarification": "时间限制结束"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8dce9e6-c07d-34a6-8a31-dffae7d56e91",
