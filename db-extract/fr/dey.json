                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92628852-d296-414f-89f5-931104e740d0",
                                "sense_id": "0d4034b0-9f89-3777-a03d-511fcab53b6d",
                                "text": "Originaire de Tavera, né en 1518 et enlevé tout jeune sur les côtes de Corse, Hassan Corso se convertit à l'Islam, devint caïd d'Alger en 1549, puis dey en 1556."
                            },
                            {
                                "example_id": "701a888f-c2b1-401d-8b5d-f1862464de50",
                                "sense_id": "0d4034b0-9f89-3777-a03d-511fcab53b6d",
                                "text": "Le dey de Tunis."
                            }
                        ]
                    }
