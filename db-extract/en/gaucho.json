                                    {
                                        "sense_id": "e2bfcf4c-1109-37b4-bd68-9aee5b82acc1",
                                        "entry_id": "b2ca823c-dce4-320d-8fbd-da617cb1337f",
                                        "glosses": [
                                            "Habitante rural de las llanuras del Cono Sur, desde el sur de Brasil a la Patagonia."
                                        ],
                                        "tags": [
                                            "adjective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "daf36b6f-cf6c-4c73-9114-acf421ff4ae4",
                                                "sense_id": "e2bfcf4c-1109-37b4-bd68-9aee5b82acc1",
                                                "text": "El gaucho es altanero, como que sabe domar un caballo salvaje y atravesar la pampa al galope en él. Es valiente como todo el que tiene que luchar con las fieras y abatir la res que le ha de servir de alimento."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
