                "forms": [],
                "senses": [
                    {
                        "sense_id": "83f183b0-7193-3170-a4b9-bce4b7ed1661",
                        "entry_id": "e82e84f9-c383-3db7-893a-b12ed590d239",
                        "glosses": [
                            "rijden naar de plaats vanwaar men eerder gekomen is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a47ff1a-d8b5-462b-b902-16aca14f2af6",
                                "sense_id": "83f183b0-7193-3170-a4b9-bce4b7ed1661",
                                "text": "Op datzelfde medium is een video te zien van auto’s die omgedraaid zijn en terugrijden, tegen de gebruikelijke richting in. „Spookrijden op de snelweg”, luidt het onderschrift. Volgens de politie doen de bestuurders niets fout: ze zijn waarschijnlijk teruggeleid naar Nieuwerkerk en mogen daar de snelweg verlaten."
                            },
                            {
                                "example_id": "d39b56a8-1974-4e85-8059-bfd53ee0cf1f",
                                "sense_id": "83f183b0-7193-3170-a4b9-bce4b7ed1661",
                                "text": "Vrijdag waarschuwden de verkeersdiensten al dat Nederlandse vakantiegangers die terugrijden uit Spanje rekening moeten houden met lange wachttijden. Tijdens verscherpte grenscontroles worden alle auto's één voor één gecontroleerd."
                            }
                        ]
                    }
