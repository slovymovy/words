                "senses": [
                    {
                        "sense_id": "7a6bd01c-b64d-3b02-848a-3aa1d52e0c92",
                        "entry_id": "1bc2b4b1-011f-3ac1-b42b-8b56b7a1bf20",
                        "glosses": [
                            "becherartiges Gefäß mit Deckel, in dem durch Schütteln Flüssigkeiten vermischt werden (besonders für – alkoholische – Getränke, Cocktails)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee724deb-f237-4a48-af36-316ac370fbe5",
                                "sense_id": "7a6bd01c-b64d-3b02-848a-3aa1d52e0c92",
                                "text": "„Die drei springen hinter die Bar, hantieren mit Flaschen – Anejo Rum, Curacao, Angostura – und schütteln ihre Mixbecher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cfca2d15-a528-4d4d-a3cb-834c5d192358",
                        "source_entry_id": "1bc2b4b1-011f-3ac1-b42b-8b56b7a1bf20",
                        "source_sense_id": "7a6bd01c-b64d-3b02-848a-3aa1d52e0c92",
                        "target_lang_word": "shaker",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shaker",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f603348b-0906-3388-a3ed-9dac000074d1",
                                        "entry_id": "3b455c03-e59f-3b3f-a867-f18c8bd3ea58",
                                        "glosses": [
                                            "Bouteille, généralement métallique, munie d’un large couvercle amovible pour mélanger intimement les ingrédients composant un cocktail."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93a3af7c-3dbd-4850-b010-5bdd520b15ad",
                                                "sense_id": "f603348b-0906-3388-a3ed-9dac000074d1",
                                                "text": "Il regardait ce bar, ses shakers, sa barre nickelée, comme de vieilles choses amicales."
                                            },
                                            {
                                                "example_id": "5b0f4011-4097-4154-92d4-99af080afd8f",
                                                "sense_id": "f603348b-0906-3388-a3ed-9dac000074d1",
                                                "text": "Albert, non Vidalie mais ce barman méthodique qui est le Descartes du shaker, manie cet ustensile dans la pénombre avec la rigueur d’un pendule."
                                            },
                                            {
                                                "example_id": "145873bc-d9d6-4d27-a3f5-46d402f9147e",
                                                "sense_id": "f603348b-0906-3388-a3ed-9dac000074d1",
                                                "text": "Il secouait la tête de son copain comme on secoue un shaker un soir de bamboula."
                                            },
                                            {
                                                "example_id": "9b982cbf-aa53-4fa4-ac20-0174bfbbb2ea",
                                                "sense_id": "f603348b-0906-3388-a3ed-9dac000074d1",
                                                "text": "Le shaker boston fut le premier modèle utilisé aux États-Unis par les pionniers du bar, au milieu du XIXᵉ siècle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shaker",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "443faa34-702d-3010-8f83-00014a2f6492",
                                        "entry_id": "6cc1a5ee-9616-3997-9b27-6e01ea5be03c",
                                        "glosses": [
                                            "Membre d’une branche sectaire du protestantisme, la Société unie des croyants dans la parousie (United Society of Believers in Christ’s Second Appearing), née au début du xviiiᵉ siècle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73431da1-0a9d-4aa6-a0c1-1e9b2bc647dc",
                                                "sense_id": "443faa34-702d-3010-8f83-00014a2f6492",
                                                "text": "Il est significatif que le principal héritage légué par les shakers au monde d’aujourd’hui repose, non pas dans leur forme de croyance unique, ni dans leur approche spirituelle mais dans le style dépouillé de leurs meubles et de leurs intérieurs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shaker",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bfbb43a5-d11c-3d64-89c6-5ba1bdf3e18a",
                                        "entry_id": "31076aae-24c0-3b57-8e86-8e669298e81c",
                                        "glosses": [
                                            "Serrer la main conventionnellement."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdc9ced6-0041-42d4-b265-62e908d449f7",
                                                "sense_id": "bfbb43a5-d11c-3d64-89c6-5ba1bdf3e18a",
                                                "text": "Une pratique qui s’étend pourtant du lycée de Marly-Gomont jusqu’au discours d’investiture de Barack Obama où le candidat démocrate américain « shake » sa femme sur scène devant ses militants pour fêter sa victoire."
                                            },
                                            {
                                                "example_id": "4ffb180c-3dbd-4e21-a1c6-cbb40afb3202",
                                                "sense_id": "bfbb43a5-d11c-3d64-89c6-5ba1bdf3e18a",
                                                "text": "Se laissant tomber sur un banc, Stéphane soupira :\n— Putain, c’était chaud cette fois.\n— Ben ouais, avec nous, c’est tout le temps à l’arrache, répondit Mastard en tendant sa main à ses amis pour shaker."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24d1882b-84f6-3b25-b673-d65cbfc5e0b9",
                                        "entry_id": "31076aae-24c0-3b57-8e86-8e669298e81c",
                                        "glosses": [
                                            "Secouer, brasser."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "301b8d13-82a7-4086-9a28-6f749e430f66",
                                                "sense_id": "24d1882b-84f6-3b25-b673-d65cbfc5e0b9",
                                                "text": "Parlez-moi d’un gouvernement qui veut «shaker» les colonnes du temple!"
                                            },
                                            {
                                                "example_id": "b15223a1-0f66-4e4f-9e7b-05fca826bed7",
                                                "sense_id": "24d1882b-84f6-3b25-b673-d65cbfc5e0b9",
                                                "text": "J-Lo peut shaker son booty sans soucis"
                                            },
                                            {
                                                "example_id": "37bf6847-3bd7-4bef-a6ec-e4becc8c0499",
                                                "sense_id": "24d1882b-84f6-3b25-b673-d65cbfc5e0b9",
                                                "text": "Mon talent secret… shaker mes fesses en les contractant…"
                                            },
                                            {
                                                "example_id": "fe244619-25e5-4faf-83ce-21a4da5a95fb",
                                                "sense_id": "24d1882b-84f6-3b25-b673-d65cbfc5e0b9",
                                                "text": "Les conseils du barman Nicolas Scellier pour bien shaker son cocktail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0788286a-6c86-33f3-9ee4-d04ea67c74fb",
                                        "entry_id": "31076aae-24c0-3b57-8e86-8e669298e81c",
                                        "glosses": [
                                            "Trembler."
                                        ],
