                "senses": [
                    {
                        "sense_id": "9ef6fd52-5433-314b-a6ad-44e1d68a1695",
                        "entry_id": "4a5650d0-89c5-3c5c-9d42-d8640c053650",
                        "glosses": [
                            "Traiter les eaux de cale en les filtrant avant de les rejeter à la mer."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0e7a7b56-d862-3c89-a4f2-b819b965f6fc",
                        "entry_id": "4a5650d0-89c5-3c5c-9d42-d8640c053650",
                        "glosses": [
                            "Avoir un comportement turbulent, faire du désordre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ae41a8b-29a0-4558-b7d8-92cab502f7fc",
                                "sense_id": "0e7a7b56-d862-3c89-a4f2-b819b965f6fc",
                                "text": "Ils turbulaient autour du billard, croisant leurs queues comme des armes, se sautaient sur les épaules pour se faire plier, se tapaient sur les cuisses, se frottaient des allumettes sur les fesses, et ils s’engueulaient ainsi que des gens qui vont s’égorger, braillant, la bouche en avant, les uns sur les autres, prêts à se manger le nez et à s’éborgner avec leurs gestes qui s’achevaient en des bourrades amicales et de gros rires."
                            }
                        ]
                    },
                    {
                        "sense_id": "0988b794-70db-3156-83d4-600cff951726",
                        "entry_id": "4a5650d0-89c5-3c5c-9d42-d8640c053650",
                        "glosses": [
                            "Bousculer."
                        ],
                        "tags": [
                            "analogy",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7f0ea3be-45b8-47af-b17c-4c7114eedb74",
                                "sense_id": "0988b794-70db-3156-83d4-600cff951726",
                                "text": "Le chef de l’Etat entend mobiliser « l’imaginaire » pour s’adresser aux Français et cherche à faire « turbuler le système » en 2024, selon son entourage."
                            }
                        ]
                    }
