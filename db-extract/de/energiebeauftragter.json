                "senses": [
                    {
                        "sense_id": "75cca89b-de6c-35b1-b4f0-1efff9c24d48",
                        "entry_id": "dc205619-d9e3-35ca-88c1-23cd7ab83842",
                        "glosses": [
                            "jemand, der mit einem Auftrag oder einer Aufgabe betraut ist, sie erledigen soll und den Auftraggeber eventuell dazu vertritt, wenn es um Energie geht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f81b9bc4-1328-47a1-848d-799d5b8c642f",
                                "sense_id": "75cca89b-de6c-35b1-b4f0-1efff9c24d48",
                                "text": "„Im Unterschied zum Energiebeauftragten verantwortet der Energiemanager die Einführung und die organisatorische Aufrechterhaltung des Energiemanagementsystems sowie dessen ständige Verbesserung.“"
                            },
                            {
                                "example_id": "2b625604-c4bb-44df-81d1-6677110a7459",
                                "sense_id": "75cca89b-de6c-35b1-b4f0-1efff9c24d48",
                                "text": "„Der Energiebeauftragte nimmt eine zentrale Schlüsselrolle im Zusammenhang mit allen Energiethemen in Unternehmen, Gemeinden und öffentlichen Einrichtungen ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
