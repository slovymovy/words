                ],
                "senses": [
                    {
                        "sense_id": "6a70c89d-583c-35e8-b0d2-62c750f835b2",
                        "entry_id": "c0e97ab0-47ed-3f61-91fe-9b9b88ce6354",
                        "glosses": [
                            "(meistens sportliche) Übung oder sonstige gezielte Maßnahme im Rahmen eines Trainings"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8274f7a7-1ebb-4c79-b4b7-56d850a3ba52",
                                "sense_id": "6a70c89d-583c-35e8-b0d2-62c750f835b2",
                                "text": "„Dieses Abzeichen stellt in jedem Jahr die gleichen Anforderungen: Gehen Sie nach draußen und absolvieren Sie eine Trainingsaktivität von mindestens 30 Minuten.“"
                            },
                            {
                                "example_id": "639ec81e-8561-48e4-8a16-5614b4d41362",
                                "sense_id": "6a70c89d-583c-35e8-b0d2-62c750f835b2",
                                "text": "„In zunehmendem Maße werden wir von Unternehmen angesprochen, die Problemlösungsmaßnahmen durchführen möchten, mit dem Ziel, nach den Ursachen für Widerstände gegen die DV zu forschen und sie durch gezielte Trainingsaktivitäten abzubauen.“"
                            },
                            {
                                "example_id": "2778bb51-ad2a-48ca-8166-d509664606d3",
                                "sense_id": "6a70c89d-583c-35e8-b0d2-62c750f835b2",
                                "text": "„Dreieinhalb Monate nach seinem Zusammenbruch hatte Hamlin wieder Grünes Licht für jegliche Trainingsaktivitäten erhalten.“"
                            },
                            {
                                "example_id": "c9b12fe0-9a25-4fd7-bd97-8507494c73b0",
                                "sense_id": "6a70c89d-583c-35e8-b0d2-62c750f835b2",
                                "text": "„Sind keinerlei Trainingsaktivitäten, Turniere oder sonstige Veranstaltungen der Abteilung vorgesehen, stehen die Felder zum freien Spiel zur Verfügung.“"
                            },
                            {
                                "example_id": "7b71bd8b-4713-4716-90d7-70a6d2826503",
                                "sense_id": "6a70c89d-583c-35e8-b0d2-62c750f835b2",
                                "text": "„Mit Hilfe dieser Apps können Benutzer beispielsweise ihre Trainingsaktivitäten verfolgen, ihre Schlafmuster analysieren, ihren Stresslevel überwachen oder ihre Ernährungsgewohnheiten aufzeichnen.“"
                            },
                            {
                                "example_id": "65c6ffd1-0a4c-43a0-a060-4c11b6709903",
                                "sense_id": "6a70c89d-583c-35e8-b0d2-62c750f835b2",
                                "text": "„Durch eine mögliche Zusammenlegung von Fußballvereinen und der Verlagerung ihrer Trainingsaktivitäten auf die Schillerwiese könnten die bisher angestammten Sportplätze in lukratives Bauland umgewandelt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
