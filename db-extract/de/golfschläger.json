                "senses": [
                    {
                        "sense_id": "069f8c49-666e-31b7-aaf9-1d1a6fcdd467",
                        "entry_id": "7f32a275-d299-36a5-b7f3-880a33b5efcb",
                        "glosses": [
                            "Spielgerät zum Spielen von Golf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16a6225e-d4d7-45c3-9b41-0fb2ae284c57",
                                "sense_id": "069f8c49-666e-31b7-aaf9-1d1a6fcdd467",
                                "text": "Bevor man einen Golfschläger kauft, sollte man sich professionell beraten lassen."
                            },
                            {
                                "example_id": "818c54e9-3547-48af-997f-5e1da84a29dc",
                                "sense_id": "069f8c49-666e-31b7-aaf9-1d1a6fcdd467",
                                "text": "Der Caddie trägt für den Spieler die Golfschläger über den Platz."
                            },
                            {
                                "example_id": "f16af174-c51e-4337-8334-5efe30b7738f",
                                "sense_id": "069f8c49-666e-31b7-aaf9-1d1a6fcdd467",
                                "text": "„Hinter den grauen Metalltüren der Lagerabteile lassen sich bei einem Lokalaugenschein Skier, Golfschläger, Gitarren, alte Polstermöbel und haufenweise Umzugskartons erahnen.“"
                            },
                            {
                                "example_id": "e6f0bf41-c466-40d1-9058-8a0db8601335",
                                "sense_id": "069f8c49-666e-31b7-aaf9-1d1a6fcdd467",
                                "text": "„Grosse Sorgen bereitet der Branche der Markt für Golfschläger, Bälle, Schuhe und jene modische Spezialbekleidung, die gutbetuchte Amateurspieler als stilistisches Muss betrachten.“"
                            },
                            {
                                "example_id": "d5a9d469-50fd-4687-be9b-36fc02b2546b",
                                "sense_id": "069f8c49-666e-31b7-aaf9-1d1a6fcdd467",
                                "text": "„Liéven nahm einen Golfschläger zur Hand und hieb ihn sausend durch die Luft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dfeb75b8-c631-4df0-8f96-202302d04831",
                        "source_entry_id": "7f32a275-d299-36a5-b7f3-880a33b5efcb",
                        "source_sense_id": "069f8c49-666e-31b7-aaf9-1d1a6fcdd467",
                        "source_sense_description": "Sport: Spielgerät zum Spielen von Golf",
                        "target_lang_word": "golf club",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "golf club",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4429e37e-3e09-3e65-812f-a3dcd0357a6b",
                                        "entry_id": "fb929b04-63e7-3cb3-a29a-d74277bdf8a5",
                                        "glosses": [
                                            "In golf, the implement used to hit the golf ball."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14324e87-2003-44dc-90d6-75d367d43798",
                                                "sense_id": "4429e37e-3e09-3e65-812f-a3dcd0357a6b",
                                                "text": "Once the tough job is done for Prosser, he says he can then get his golf clubs back out - they have been in the cupboard untouched for a decade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5485ed8-6761-387b-8187-a626ef46f73c",
                                        "entry_id": "fb929b04-63e7-3cb3-a29a-d74277bdf8a5",
                                        "glosses": [
                                            "A club or organization where golf is played."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36d56e94-fe2c-4efa-b1ae-e81b849334c8",
                        "source_entry_id": "7f32a275-d299-36a5-b7f3-880a33b5efcb",
                        "source_sense_id": "069f8c49-666e-31b7-aaf9-1d1a6fcdd467",
                        "source_sense_description": "Sport: Spielgerät zum Spielen von Golf",
                        "target_lang_word": "crosse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crosse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d1f36f72-3daf-3bb6-986e-e92ad468a571",
                                        "entry_id": "4e25e3f1-81dc-3044-a43b-bc10498cd226",
                                        "glosses": [
                                            "Bâton pastoral d’évêque ou d’abbé, dont l’extrémité supérieure se recourbe en volute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae82dbcf-d554-4635-bdfa-fcb62f073b31",
                                                "sense_id": "d1f36f72-3daf-3bb6-986e-e92ad468a571",
                                                "text": "La mitre et la crosse sont les symboles du pouvoir épiscopal."
                                            },
                                            {
                                                "example_id": "5fbcf165-8e46-4a68-9c8f-d83616182c90",
                                                "sense_id": "d1f36f72-3daf-3bb6-986e-e92ad468a571",
                                                "text": "Le nez en crosse d’évêque s’avançait entre deux joues qui dans le plus grand sérieux avaient toujours l’air de pouffer."
                                            },
                                            {
                                                "example_id": "7a26a8f7-4b65-43d3-9394-11a71850d79a",
                                                "sense_id": "d1f36f72-3daf-3bb6-986e-e92ad468a571",
                                                "text": "Je trouvai mon père sur la terrasse : il redressait l’équerre d’une porte gonflée par l’hiver, et des copeaux en crosse d’évêque montaient s’enrouler jusque sous son menton."
                                            },
                                            {
                                                "example_id": "fb1e86ef-9a1a-4fb6-8db0-f909bdbb80f3",
                                                "sense_id": "d1f36f72-3daf-3bb6-986e-e92ad468a571",
                                                "text": "Le Chevêche^([sic]) somnolait doucement, la main sur la crosse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da263069-659c-30f6-bebf-e6b5697b9b1b",
                                        "entry_id": "4e25e3f1-81dc-3044-a43b-bc10498cd226",
                                        "glosses": [
                                            "Partie postérieure d'une arme à feu portative, servant à tenir ou appuyer l’arme, lors du tir."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea3b99c1-31d4-4651-b2be-e71027740851",
                                                "sense_id": "da263069-659c-30f6-bebf-e6b5697b9b1b",
                                                "text": "Dafny, après avoir tiré son fusil, en avait brisé la crosse en se défendant contre les massues des sauvages."
                                            },
                                            {
                                                "example_id": "c991d6f3-0535-4224-8b99-8229161b8f43",
                                                "sense_id": "da263069-659c-30f6-bebf-e6b5697b9b1b",
                                                "text": "Ils avaient brisé les portes à coups de crosse et les Bavarois, surpris par la brusquerie de l'attaque, avaient mis bas les armes ou s'étaient sauvés."
                                            },
                                            {
                                                "example_id": "659eeaaf-6bab-481d-bf8f-b0054c9c9a3e",
                                                "sense_id": "da263069-659c-30f6-bebf-e6b5697b9b1b",
                                                "text": "Les deux malandrins alors ont essayé de l’achever avec leurs crosses d’armes et leurs poignards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85ddf4f6-7c82-39b8-ae02-0cacbd79df80",
                                        "entry_id": "4e25e3f1-81dc-3044-a43b-bc10498cd226",
                                        "glosses": [
                                            "Manche d’une arme de poing."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "096a055e-06ff-4233-888d-750b59711b35",
                                                "sense_id": "85ddf4f6-7c82-39b8-ae02-0cacbd79df80",
                                                "text": "Que l’on zyeute le canon d'une carabine ou la crosse du moindre bulldog, et vous êtes fait. Coupé cabèche !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f587e67a-6cce-3bf5-bf45-f4c3c26e42da",
                                        "entry_id": "4e25e3f1-81dc-3044-a43b-bc10498cd226",
                                        "glosses": [
                                            "Diacritique suscrit à une lettre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "16ea102c-0df1-3b01-b5db-9820918e3127",
                                        "entry_id": "4e25e3f1-81dc-3044-a43b-bc10498cd226",
                                        "glosses": [
                                            "Béquille, bâton recourbé sur lequel s’appuient pour marcher les infirmes, les blessés, etc."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94813325-89d4-474e-a98c-bf8818d9c06f",
                                                "sense_id": "16ea102c-0df1-3b01-b5db-9820918e3127",
                                                "text": "Mais ceux-ci, tiraillant ses grègues noires et mordant ses bas rouges, le culbutèrent comme un goutteux sur ses crosses."
                                            },
                                            {
                                                "example_id": "503ad1e5-4683-4bb7-85c6-b3da16586aa9",
                                                "sense_id": "16ea102c-0df1-3b01-b5db-9820918e3127",
                                                "text": "N’y tenant plus, il m’interpella, la voix enrouée, une main refermée sur la crosse de sa canne, l’autre pianotant nerveusement sur le marbre mouillé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6c8c93b-df12-3f80-a03c-039496e5ab8a",
                                        "entry_id": "4e25e3f1-81dc-3044-a43b-bc10498cd226",
                                        "glosses": [
                                            "Bâton courbé à son extrémité, utilisé dans certains sports comme le golf, le hockey sur glace, pour pousser la balle ou le palet."
                                        ],
                                        "tags": [
                                            "Hockey sur glace"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e1c8c59-a29d-379f-9685-6433a516334e",
                                        "entry_id": "4e25e3f1-81dc-3044-a43b-bc10498cd226",
                                        "glosses": [
                                            "Sport collectif opposant deux équipes de dix joueurs chacune, où les joueurs se servent d’une crosse, munie d’un filet, pour lancer une balle dans le but adverse."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a25babfb-21a1-4161-b4c4-3ade51e88673",
                                                "sense_id": "6e1c8c59-a29d-379f-9685-6433a516334e",
                                                "text": "La crosse est un sport enseigné aux enfants iroquois dès leur plus jeune âge et est considérée comme un des plus vieux sports en Amérique du Nord."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f94f701-10e2-357d-ba44-3407b5e9d28a",
                                        "entry_id": "4e25e3f1-81dc-3044-a43b-bc10498cd226",
                                        "glosses": [
                                            "Bout recourbé d’un objet."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "090052d8-c794-4436-972f-965127bd192b",
                                                "sense_id": "8f94f701-10e2-357d-ba44-3407b5e9d28a",
                                                "text": "D'autant qu'elle est au niveau de la crosse, un endroit difficile à opérer."
                                            },
                                            {
                                                "example_id": "c999c7e0-5d60-4da4-a6e6-f49b611d7a45",
                                                "sense_id": "8f94f701-10e2-357d-ba44-3407b5e9d28a",
                                                "text": "À droite du piano, le violoncelliste émergeait de la fosse, la tête appuyée contre la crosse de son instrument dont il pinçait les cordes en regardant fixement devant lui."
                                            },
                                            {
                                                "example_id": "9cf2109a-355a-4eb0-9941-30a0c844c639",
                                                "sense_id": "8f94f701-10e2-357d-ba44-3407b5e9d28a",
                                                "text": "Crosse de l’aorte."
                                            },
                                            {
                                                "example_id": "ee43fa3f-397f-440d-84cc-81f5ed15283a",
                                                "sense_id": "8f94f701-10e2-357d-ba44-3407b5e9d28a",
                                                "text": "Inflorescence en crosse."
                                            },
                                            {
                                                "example_id": "20873e7f-2fb4-429d-a2e0-44d9fda53ec8",
                                                "sense_id": "8f94f701-10e2-357d-ba44-3407b5e9d28a",
                                                "text": "Mais, après une demi-heure de marche, un morceau de ciel apparut, les pins s'espacèrent, le sol fut peuplé de petites crosses de fougères dont quelques-unes, déjà se déroulaient, déployant leur fine dentelle."
                                            },
                                            {
                                                "example_id": "97d92eee-a198-49c4-907e-328c2d831c00",
                                                "sense_id": "8f94f701-10e2-357d-ba44-3407b5e9d28a",
                                                "text": "En lisière du bois, les fougères se font rousses, et pleuvent en crosses recourbées au-dessus des perles mauves de bruyère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4144dc3c-7ae4-369a-9f97-9911b2190db7",
