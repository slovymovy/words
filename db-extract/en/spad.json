                ],
                "senses": [
                    {
                        "sense_id": "ddaa4ed8-c4bc-3f1a-a2ad-30890929cff6",
                        "entry_id": "55fa61cc-fea3-3916-ac3b-c7c06c355fe6",
                        "glosses": [
                            "Clipping of spadona/spadone."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "clipping"
                        ],
                        "examples": [
                            {
                                "example_id": "5b58af98-d46e-4009-a3c9-6920f987de20",
                                "sense_id": "ddaa4ed8-c4bc-3f1a-a2ad-30890929cff6",
                                "text": "No. 6.—Spadonas or spads, the first wing-quills of the chick, clipped at about six months."
                            },
                            {
                                "example_id": "ef93b433-a961-420f-aa7f-ca71758c4e4d",
                                "sense_id": "ddaa4ed8-c4bc-3f1a-a2ad-30890929cff6",
                                "text": "RAW OSTRICH FEATHERS / Primes, Wings, White Feminas, Spads, Etc."
                            },
                            {
                                "example_id": "a902d4af-8a9a-4dbd-825b-60abee07fb22",
                                "sense_id": "ddaa4ed8-c4bc-3f1a-a2ad-30890929cff6",
                                "text": "“What d’you mean—‘feathers’,” asked the tanned young public school man who volunteered to trot me round, “spads, second-after-chicks, fancies, natals, black butts, adults, juvenals, byocks, chicks, primes, feminas, or what?”[…]The first white ones we call spads.[…]Two or three months after that clipping we pull out the spad quills."
                            },
                            {
                                "example_id": "5ec78277-ed07-4b82-bb06-a91d537f20b4",
                                "sense_id": "ddaa4ed8-c4bc-3f1a-a2ad-30890929cff6",
                                "text": "An improvement was noted in the demand for femina wings, spads and long bodies;"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "6e00ae67-fa60-3452-b24c-cbbb5ad39f93",
                "word": "spad",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ec0ef163-da33-4060-890e-fe3c6313f893",
                        "entry_id": "6e00ae67-fa60-3452-b24c-cbbb5ad39f93",
                        "tags": [
