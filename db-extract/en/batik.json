                    },
                    {
                        "translation_id": "809b867e-eaeb-47db-b522-4fe2f12f8a59",
                        "source_entry_id": "4b833a84-6182-32db-85d0-523fb4f18196",
                        "source_sense_id": "a95dc240-f172-37fb-a9c2-58df0393dbce",
                        "source_sense_description": "to dye fabric using the wax-resist method",
                        "target_lang_word": "batiken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "batiken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67c91c35-3a1f-3e17-8f14-e97fe2a49b59",
                                        "entry_id": "ba662d82-c50d-3ec1-815a-f0bb87968471",
                                        "glosses": [
                                            "(insbesondere Textilien) mithilfe von Wachs mit einem Muster versehen und dann färben"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5a04246-e00f-406f-a781-184eb5c68a34",
                                                "sense_id": "67c91c35-3a1f-3e17-8f14-e97fe2a49b59",
                                                "text": "„In der Projektwerkstatt dürfen die Kinder töpfern, batiken, Kerzen gießen, Bilder malen, Instrumente bauen und bei Naturprojekten mitmachen.“"
                                            },
                                            {
                                                "example_id": "b394a6c3-e17a-40d3-b616-0070c714d950",
                                                "sense_id": "67c91c35-3a1f-3e17-8f14-e97fe2a49b59",
                                                "text": "„Zu diesen Veränderungen gehört auch, dass die Ostereier vermehrt ausgepustet werden, bevor man ihre Schale batikt, mit Sauerkrautsaft ätzt, mit Nadeln kratzt, sie bemalt oder auch mit Mustern aus winzigen Strohteilchen verziert.“"
                                            },
                                            {
                                                "example_id": "8e842ad9-4f3c-40a7-9fef-c2eb559922a0",
                                                "sense_id": "67c91c35-3a1f-3e17-8f14-e97fe2a49b59",
                                                "text": "„Der Architekt Adolf Loos ist nicht nur für seine Vorliebe für sehr junge Mädchen bekannt, sondern auch für verächtliche Bemerkungen über weibliche Künstler. Er spottete über ‚dilettantische Hofratstöchter‘ und meinte: ‚Neunzig Prozent der ‚Künstlerinnen‘ nennen sich so, weil sie batiken können […]‘“"
                                            },
                                            {
                                                "example_id": "19770eb4-a57a-4fef-bc96-513d76759ba6",
                                                "sense_id": "67c91c35-3a1f-3e17-8f14-e97fe2a49b59",
                                                "text": "„Elora Hardy, 35, feenhaft, dunkles Haar, zum lockeren Dutt gebunden, Sandalen an den Füßen und ein leichtes, gebatiktes Kleid um die grazile Gestalt, kommt mir am nächsten Morgen auf der Hängebrücke des Bambu Indah entgegen.“"
                                            },
                                            {
                                                "example_id": "922f3441-235f-4291-8450-a3cd90398c92",
                                                "sense_id": "67c91c35-3a1f-3e17-8f14-e97fe2a49b59",
                                                "text": "„Du zuckst und bist wieder das Mädchen in gebatikten Jeans, in Springerstiefeln, mit Nasenring und rot gefärbten Haaren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
