                        "entry_id": "0b7c8fb8-c7a2-336b-8c38-c3927ead8291",
                        "glosses": [
                            "Particule hypothétique se déplaçant à une vitesse supérieure à celle de la lumière dans le vide."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "3c4fe054-4ae3-4a6e-bbe5-5f1c0bf91387",
                                "sense_id": "95ea79f5-ac44-30b2-a323-6d42704e7471",
                                "text": "L’existence des tachyons n’a pu, jusqu’ici, être démontrée."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa454340-8d51-3aef-9f7c-4a5e8f4f31f7",
                        "entry_id": "0b7c8fb8-c7a2-336b-8c38-c3927ead8291",
                        "glosses": [
                            "Particule hypothétique se déplaçant à une vitesse supérieure à celle de la lumière dans le vide qui serait capable de procurer du bien-être à son exposition."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "eca9fe73-78d0-4eec-8d2a-6913690da1b7",
                                "sense_id": "fa454340-8d51-3aef-9f7c-4a5e8f4f31f7",
                                "text": "Des « chambres à tachyons » ou des « barres à tachyons » qui promettent « d’équilibrer votre énergie » ? Le Détecteur de rumeurs est allé à la chasse aux tachyons."
                            }
                        ]
                    }
