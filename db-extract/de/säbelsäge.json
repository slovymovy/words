                "senses": [
                    {
                        "sense_id": "22e1db2b-da6c-3892-aff8-c4b4e416a043",
                        "entry_id": "57fb1566-6945-3a7c-918a-5bce84327642",
                        "glosses": [
                            "„handgeführte Elektrosäge mit wie bei einer Stichsäge vorstehendem, hin und her laufendem, an nur einem Ende in der Maschine eingespanntem Sägeblatt“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "577bea32-6d4b-44b4-98a7-11e46baa2b96",
                                "sense_id": "22e1db2b-da6c-3892-aff8-c4b4e416a043",
                                "text": "„Die Säbelsäge ist eine elektrisch angetriebene Pendelhubsäge, entweder kabelgebunden für das externe Stromnetz oder als Akkubetriebene Säge.“"
                            },
                            {
                                "example_id": "caf7be84-6a8b-47ae-8226-6e3738b2d15c",
                                "sense_id": "22e1db2b-da6c-3892-aff8-c4b4e416a043",
                                "text": "„Eine sogenannte Säbelsäge käme vielleicht in Frage, aber das hängt von der Größe des Werkstücks ab.“"
                            },
                            {
                                "example_id": "6a0d7782-317b-4ebb-b3b0-231d075c4b31",
                                "sense_id": "22e1db2b-da6c-3892-aff8-c4b4e416a043",
                                "text": "„Beamte hielten einen vorbeifahrenden Baulaster an und liehen sich eine akkubetriebene Säbelsäge aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
