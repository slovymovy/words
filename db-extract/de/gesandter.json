                                "sense_id": "4bcf9fee-f78c-37eb-a82c-644c8203e832",
                                "text": "„Die drei Gesandten griffen gehorsam zu, aber eher diplomatischer Pflicht gehorchend als ihrem eigenen Appetit.“"
                            },
                            {
                                "example_id": "7f11fe6e-5967-4ec4-9529-62ade02da59d",
                                "sense_id": "4bcf9fee-f78c-37eb-a82c-644c8203e832",
                                "text": "„Anwesend waren der französische Gesandte, der Prinz, der seit kurzer Zeit ein häufiger Gast im Hause der Gräfin war, und viele glänzende Damen und Herren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
