                                                "example_id": "63272f22-d79e-467d-9bc5-c5797bf7164c",
                                                "sense_id": "38bc42e6-b023-39d7-913a-0c5c4eae5b4b",
                                                "text": "Having, moreover, put on her clean toy, rokelay, and scarlet plaid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5983ff3b-3701-3ca8-80ed-71e690947274",
