                "senses": [
                    {
                        "sense_id": "e2be5652-e982-3a54-8fd5-fe233902e09a",
                        "entry_id": "2b9c4977-8b8d-3f31-b68a-c2e2de9c2583",
                        "glosses": [
                            "der Abend eines Donnerstages"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9e79d4a-af17-4390-babb-01ac306fdf4c",
                                "sense_id": "e2be5652-e982-3a54-8fd5-fe233902e09a",
                                "text": "Für Donnerstagabend wurden umfangreiche Polizeikontrollen angekündigt."
                            },
                            {
                                "example_id": "d4d574af-433d-4938-ad7d-964cc1a6ab29",
                                "sense_id": "e2be5652-e982-3a54-8fd5-fe233902e09a",
                                "text": "An den kommenden Donnerstagabenden werdet ihr keine Zeit für eure Lieblingssendung haben, denn ihr müsst babysitten."
                            },
                            {
                                "example_id": "8f638a0c-f35f-4fb5-a515-8720836e0c67",
                                "sense_id": "e2be5652-e982-3a54-8fd5-fe233902e09a",
                                "text": "„Am Donnerstagabend verabschiedete der Bundestag eine Novelle, die es Behörden ermöglicht, Verbraucher schneller über Fälle von Etikettenschwindel zu informieren.“"
                            },
                            {
                                "example_id": "36bc8541-50f5-48eb-a914-9d44ac49da1d",
                                "sense_id": "e2be5652-e982-3a54-8fd5-fe233902e09a",
                                "text": "„Das war an einem Donnerstagabend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
