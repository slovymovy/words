    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "761056b7-e4e2-3801-a6b5-18d15bca18cf",
                    "sense_definition": "A complicated or confused situation that is difficult to escape from or make progress in.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "difficult_situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company became trapped in a legal <w>morass</w> that lasted for over three years.",
                            "target_lang_translations": {
                                "ru": "Компания оказалась в юридической <w>трясине</w>, которая затянулась более чем на три года."
                            }
                        },
                        {
                            "text": "Reformers struggled to navigate the bureaucratic <w>morass</w> of regional government.",
                            "target_lang_translations": {
                                "ru": "Реформаторы с трудом пробирались сквозь бюрократическое <w>болото</w> регионального правительства."
                            }
                        }
                    ],
                    "synonyms": [
                        "quagmire",
                        "muddle",
                        "tangle"
                    ],
                    "common_phrases": [
                        "bureaucratic morass",
                        "legal morass"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сложная или запутанная ситуация, из которой трудно выбраться или добиться в ней прогресса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трясина",
                                "target_lang_sense_clarification": "в переносном смысле, о безвыходной или затягивающей ситуации"
                            },
                            {
                                "target_lang_word": "болото",
                                "target_lang_sense_clarification": "о застое, рутине или бюрократии"
                            },
                            {
                                "target_lang_word": "пучина",
                                "target_lang_sense_clarification": "о затягивающих обстоятельствах или проблемах"
                            },
                            {
                                "target_lang_word": "дебри",
                                "target_lang_sense_clarification": "о сложных и запутанных перипетиях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a05411d7-7b6b-3d98-9273-c2fd76acc576",
                    "sense_definition": "An area of muddy or boggy ground.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "wetland",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heavy rains turned the valley into a muddy <w>morass</w> that halted the army's advance.",
                            "target_lang_translations": {
                                "ru": "Проливные дожди превратили долину в грязную <w>топь</w>, которая остановила продвижение армии."
                            }
                        },
                        {
                            "text": "The path disappeared entirely as they entered a dangerous <w>morass</w>.",
                            "target_lang_translations": {
                                "ru": "Тропа полностью исчезла, когда они вошли в опасную <w>трясину</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "marsh",
                        "bog",
                        "fen",
                        "swamp",
                        "quagmire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участок топкой, болотистой или грязной земли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болото",
                                "target_lang_sense_clarification": "топкая местность"
                            },
                            {
                                "target_lang_word": "трясина",
                                "target_lang_sense_clarification": "зыбкое, засасывающее болотистое место"
                            },
                            {
                                "target_lang_word": "топь",
                                "target_lang_sense_clarification": "непроходимое болотистое место"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}