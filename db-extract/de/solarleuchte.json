                                        "glosses": [
                                            "Lampe délivrant des UVA, lampe à bronzer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b53c1eba-ffaa-4195-beb0-0f35e7227583",
                                                "sense_id": "b7afef0a-5b95-3903-98aa-3eff1992816d",
                                                "text": "J'ai pris la précaution de me «pré-bronzer» sous une lampe solaire à Paris. Sans cela, on passe la première semaine de ses vacances à souffrir et la deuxième à peler"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6febbac-a349-374d-9277-0650ae21a3f7",
                                        "entry_id": "6bf08a89-3e10-38bb-a82b-2751c55383cd",
                                        "glosses": [
                                            "Système d'éclairage connecté à une batterie qui se recharge avec un panneau solaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fe4e9d1-7a50-4742-9b87-0f3047430fc8",
                                                "sense_id": "b6febbac-a349-374d-9277-0650ae21a3f7",
                                                "text": "… il conçoit alors une lampe solaire, « In-Diya », alimentée par un panneau solaire relié à une batterie, et utilisant la technologie LED."
                                            }
                                        ]
                                    }
