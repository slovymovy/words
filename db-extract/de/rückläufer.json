                    },
                    {
                        "form_id": "7c2b3ca9-a611-40a3-bc5e-219be43dd024",
                        "entry_id": "a747030d-4cd0-37b0-b7c5-bec7b37aff71",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Rückläufer"
                    },
                    {
                        "form_id": "9709ec9d-2f49-4b6e-a03b-834b740c0a50",
                        "entry_id": "a747030d-4cd0-37b0-b7c5-bec7b37aff71",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Rückläufer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "50994637-f005-351e-a130-6d842e9e75e4",
                        "entry_id": "a747030d-4cd0-37b0-b7c5-bec7b37aff71",
                        "glosses": [
                            "aufgrund von Unzustellbarkeit zurückgesandte Postsendung oder E-Mail"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c16c582-7b9d-4b4b-a94f-f7b099ab26cf",
                                "sense_id": "50994637-f005-351e-a130-6d842e9e75e4",
                                "text": "„Ein Großteil der so versendeten E-Mails kehrt an den vermeintlichen Absender, den Inhaber der Internet-Adresse zurück: Sei es als Rückläufer von ungültigen E-Mail-Empfängern oder als erboste Antwort von Empfängern der unerwünschten E-Mails.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f59bd85b-cadb-3a6b-9f8f-4c8cca6b282a",
                        "entry_id": "a747030d-4cd0-37b0-b7c5-bec7b37aff71",
                        "glosses": [
                            "Zuschriften als Reaktion auf eine Umfrage oder Einladung und Ähnlichem, die auf dem Postweg versandt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b5d28b6-76ca-4a36-9bc0-58d0636e91d8",
                                "sense_id": "f59bd85b-cadb-3a6b-9f8f-4c8cca6b282a",
                                "text": "„1000 Einladungen hatten sie zur Eröffnung der musealen Gedenkstätte für den Friedensnobelpreisträger […] gedruckt und verschickt und mit einem Drittel Rückläufer gerechnet.“"
                            },
                            {
                                "example_id": "97c0ba55-558a-4501-ae7b-0e34d2de921e",
                                "sense_id": "f59bd85b-cadb-3a6b-9f8f-4c8cca6b282a",
                                "text": "„Kalkulieren Sie eine ausreichende Vorlaufzeit für den Versand und auch die Rückläufer mit Zu- und Absagen ein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "33a3a5ab-a584-313c-9d14-36b343d1138e",
                        "entry_id": "a747030d-4cd0-37b0-b7c5-bec7b37aff71",
                        "glosses": [
                            "Industrie, Einzelhandel: von Kunden zurückgegebene, geleaste oder als fehlerhaft beanstandete Ware"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1553c1aa-db6c-42ba-a252-26189770a8e1",
                                "sense_id": "33a3a5ab-a584-313c-9d14-36b343d1138e",
                                "text": "„Apple bietet in den USA sogenannte ‚refurbished‘ iPhones an. Dabei handelt es sich um Rückläufer, also etwa Geräte, die wegen Fehlern zurückgegeben und instandgesetzt wurden.“"
                            },
                            {
                                "example_id": "29faf8fa-4dd8-4af3-b6ac-e2ae1aa63c07",
                                "sense_id": "33a3a5ab-a584-313c-9d14-36b343d1138e",
                                "text": "„Ihr Anteil am gehobenen Flottengeschäft ist gering, dafür ist die Not der Händler, die hochklassigen Rückläufer zu verkaufen, besonders groß.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "0890412c-7ea6-340f-bdfe-cbe806421cc7",
                        "entry_id": "a747030d-4cd0-37b0-b7c5-bec7b37aff71",
                        "glosses": [
                            "Rückabwicklung oder Nicht-Einlösung einer Zahlung, z.B. wegen falscher Bankverbindung oder wegen unzureichender Deckung eines Bankkontos"
                        ],
                        "tags": [
                            "Buchhaltung"
                        ],
                        "examples": [
                            {
                                "example_id": "27e1ea17-ae42-4325-8831-5e2dfd6d826c",
                                "sense_id": "0890412c-7ea6-340f-bdfe-cbe806421cc7",
                                "text": "„Dabei kennt das System zwei verschiedene Rückläufer-Varianten: Rückläufer mangels Kontodeckung oder solche mit fehlerhaften Kontodaten.“"
                            },
                            {
                                "example_id": "adcd01bb-e315-403a-87a1-09307a66f3fa",
                                "sense_id": "0890412c-7ea6-340f-bdfe-cbe806421cc7",
                                "text": "„Kommt es durch Verursachung des Mitglieds zu einem Rückläufer im Lastschriften-Einzugsverfahren, werden die dem Verein hierdurch entstehenden Kosten […] dem Mitglied in Rechnung gestellt.“"
                            },
                            {
                                "example_id": "0cf6059d-676b-44de-99e9-60d95432381d",
                                "sense_id": "0890412c-7ea6-340f-bdfe-cbe806421cc7",
                                "text": "„Folgeaktivitäten können Sie in Abhängigkeit vom Rückläufergrund, von der Bonität des Geschäftspartners, der Toleranzgruppe des Vertragskontos und der Anzahl der aufgetretenen Rückläufer definieren.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "f746ca3f-b767-3a94-8673-3bc2f8e1b548",
                        "entry_id": "a747030d-4cd0-37b0-b7c5-bec7b37aff71",
                        "glosses": [
                            "Stoß mit der Absicht, den Spielball nach der Karambolage mit dem Objektball wieder zurückrollen zu lassen"
                        ],
                        "tags": [
                            "im Billard"
                        ],
                        "examples": [
                            {
                                "example_id": "9964ac45-8034-4950-ba71-764575125ea9",
                                "sense_id": "f746ca3f-b767-3a94-8673-3bc2f8e1b548",
                                "text": "„Selbst um auf Landesebene vorne mithalten zu können, müssen Stop-Bälle, Rückläufer und Nachläufer sitzen – gefeilt wird letztlich am Positionsspiel.“"
                            },
                            {
                                "example_id": "9f921475-124b-448f-aec7-9b95d317f012",
                                "sense_id": "f746ca3f-b767-3a94-8673-3bc2f8e1b548",
                                "text": "„Ein zu leichter ‚Billardgriff‘ der alten Schule erschwert Rückläufer und Stoppbälle, ein zu fester Griff dagegen birgt die Gefahr, dass der Arm angespannt wird.“"
                            },
                            {
                                "example_id": "9c62a393-5919-453b-9dba-eec8985ed075",
                                "sense_id": "f746ca3f-b767-3a94-8673-3bc2f8e1b548",
                                "text": "„Beim Rückläufer geht es darum, den Spielball zunächst nach vorne zu treiben, aber derart, daß er nach Berührung des zweiten Balles umkehrt und den Weg, den er gekommen ist, zurückläuft, weil dort irgendwo der dritte Ball liegt, den er auch noch berühren muß.“"
                            },
                            {
                                "example_id": "31a48537-82f2-4651-a60f-648412c95d3a",
                                "sense_id": "f746ca3f-b767-3a94-8673-3bc2f8e1b548",
                                "text": "„Gibt man ihm bei einem Rückläufer rechts Effet, so zieht ihn dieser nach rechts, von dem getroffenen Ball aus gesehen, also nach links von der Anfangsstellung aus gesehen.“"
                            },
                            {
                                "example_id": "fca96576-a7d1-44a6-9031-e75df0ad3612",
                                "sense_id": "f746ca3f-b767-3a94-8673-3bc2f8e1b548",
                                "text": "„Die Weiße trifft auf eine ruhende Kugel, kommt aber anschließend wieder zu Ihnen zurück. In diesem Fall spricht man von einem Rückläufer.“"
                            }
                        ],
                        "sense_index_json": "\"5\""
                    },
                    {
                        "sense_id": "a273c8b4-e008-32cf-9ff6-382beabc7477",
                        "entry_id": "a747030d-4cd0-37b0-b7c5-bec7b37aff71",
                        "glosses": [
                            "Schüler, die querversetzt werden"
                        ],
                        "tags": [
                            "Schulwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "df0a4fe3-807e-4efe-ad1e-e0ea6eeac1c2",
                                "sense_id": "a273c8b4-e008-32cf-9ff6-382beabc7477",
                                "text": "„Zwei Drittel der Sitzenbleiber sind Jungen. Ebenso hoch ist ihr Anteil unter den Rückläufern, die vom Gymnasium zurück auf die Realschule oder von der Real- auf die Hauptschule wechseln.“"
                            },
                            {
                                "example_id": "21e3fbd3-33d8-4d11-b1ae-e6ce62f43521",
                                "sense_id": "a273c8b4-e008-32cf-9ff6-382beabc7477",
                                "text": "„Die Rückläufer stellen nun die Sekundarschulen vor eine Herausforderung.“"
                            },
                            {
                                "example_id": "0973df82-088e-42df-b595-9fee52e86101",
                                "sense_id": "a273c8b4-e008-32cf-9ff6-382beabc7477",
                                "text": "„In Einzelfällen müssten spezielle Klassen für die Rückläufer eingerichtet werden.“"
                            }
                        ],
                        "sense_index_json": "\"6\""
                    }
                ],
