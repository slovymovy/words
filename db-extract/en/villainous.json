                        "glosses": [
                            "Of, relating to, or appropriate to a villain."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c9448096-c8a5-3997-acf5-903a0161f6d1",
                        "entry_id": "b9646c3c-1982-3442-aaad-fdd63143a009",
                        "glosses": [
                            "Wicked, offensive, or reprehensible in nature or behaviour; nefarious."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7384014e-f699-4dee-a848-e9faf8540394",
                                "sense_id": "c9448096-c8a5-3997-acf5-903a0161f6d1",
                                "text": "Tuc[ca]. […] Can thy Author doe it impudently enough? / Hiſt[rio]. O, I warrant you, Captaine: and ſpitefully inough too; he ha's one of the moſt ouerflowing villanous wits, in Rome. He will ſlander any man that breathes; If he diſguſt him. / Tucca. I'le know the poor, egregious, nitty Raſcall; and he haue ſuch commendable Qualities, I'le cheriſh him: […]"
                            },
                            {
                                "example_id": "cb3d526f-5587-44bf-9bf6-fe4f2db9d10d",
                                "sense_id": "c9448096-c8a5-3997-acf5-903a0161f6d1",
                                "text": "Bah! to this toilet for the villainous boredom of church."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65591405-6c0c-4547-a64b-c2e5b77a755e",
                        "source_entry_id": "b9646c3c-1982-3442-aaad-fdd63143a009",
                        "source_sense_description": "of, relating to, or appropriate to a villain",
                        "target_lang_word": "crapuleux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crapuleux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "826d0bb1-6329-36c6-af6a-f476f7b08dd1",
                                        "entry_id": "cc30117d-1324-301b-8f62-49eb38a9d72d",
                                        "glosses": [
                                            "Porté sur la boisson, ivrogne."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbbc494e-a203-4eb6-ae2d-2905c0528414",
                                                "sense_id": "826d0bb1-6329-36c6-af6a-f476f7b08dd1",
                                                "text": "Je n’ai jamais été dissolu ni crapuleux, et ne me suis enivré de ma vie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e4d1bbf-7894-39ae-a3bf-33394dc30c7e",
                                        "entry_id": "cc30117d-1324-301b-8f62-49eb38a9d72d",
                                        "glosses": [
                                            "Qui se plaît dans la crapule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06ee72c5-2983-4b82-a786-eee3bb3a468e",
                                                "sense_id": "1e4d1bbf-7894-39ae-a3bf-33394dc30c7e",
                                                "text": "Individus crapuleux."
                                            },
                                            {
                                                "example_id": "042216e8-26c6-4524-be92-a3bf5c28f781",
                                                "sense_id": "1e4d1bbf-7894-39ae-a3bf-33394dc30c7e",
                                                "text": "Gens crapuleux."
                                            },
                                            {
                                                "example_id": "199bd1de-806a-4700-bd06-774ccff3b2ba",
                                                "sense_id": "1e4d1bbf-7894-39ae-a3bf-33394dc30c7e",
                                                "text": "Sieste crapuleuse, lorsqu'on se couche pour faire l'amour et dormir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e33f231-d28a-321f-8d3e-b285e8720d1a",
                                        "entry_id": "cc30117d-1324-301b-8f62-49eb38a9d72d",
                                        "glosses": [
                                            "Qui a rapport à la crapule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24a90d77-86d1-4216-b5b6-91b1c0ae1aa4",
                                                "sense_id": "3e33f231-d28a-321f-8d3e-b285e8720d1a",
                                                "text": "Or cette fameuse bagarre ne se produisit pas. Une sorte de crapuleux délire empêchait toute discorde."
                                            },
                                            {
                                                "example_id": "510b031a-d80a-4b72-a7f7-41077dd5a32e",
                                                "sense_id": "3e33f231-d28a-321f-8d3e-b285e8720d1a",
                                                "text": "Et elle me bombarde, d’une voix mauvaise, avec un accent crapuleux, d’une bordée d’injures grasses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8181094-faf3-3b9e-ad6d-88f0e99293fd",
                                        "entry_id": "cc30117d-1324-301b-8f62-49eb38a9d72d",
                                        "glosses": [
                                            "Qualifie ce qui a trait aux ébats sexuels."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91d8e762-d738-4874-9860-8a71c7d0bf38",
                                                "sense_id": "b8181094-faf3-3b9e-ad6d-88f0e99293fd",
                                                "text": "[…] celle en combinaison de dentelle et bas de soie noire avec laquelle, étant vierge, je me trouvai couché, une nuit de bombe crapuleuse, mais que je ne pus pas toucher parce que je me mis à dégurgiter sur les draps une nappe de vin rouge."
                                            },
                                            {
                                                "example_id": "b9d9928a-7a82-4819-805f-25cd739ee21f",
                                                "sense_id": "b8181094-faf3-3b9e-ad6d-88f0e99293fd",
                                                "text": "Il dînait avec elle puis ils montaient tous les deux au grenier pour ne pas se faire voir de la mère Billant. Ils y passaient un p’tit moment crapuleux et, après le café-du-pauvre, Petitcorps se rentrait en son petit logis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a73fb75a-d64b-4d01-ac61-77570417c90d",
                        "source_entry_id": "b9646c3c-1982-3442-aaad-fdd63143a009",
                        "source_sense_description": "of, relating to, or appropriate to a villain",
                        "target_lang_word": "scélérat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scélérat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a55179e-45ac-3f78-9582-a27a2bf49bda",
                                        "entry_id": "00949708-fe8a-383b-bb5c-456e6bddfe8d",
                                        "glosses": [
                                            "Qui a commis ou qui est capable de commettre de grands crimes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e6efc90-9ffe-40d0-8bac-823e3cfb4d4c",
                                                "sense_id": "6a55179e-45ac-3f78-9582-a27a2bf49bda",
                                                "text": "Mais s’il revient aujourd’hui sur les évènements qui ont ensanglanté ce dernier pays, c’est que cette guerre scélérate, pour reprendre l’expression de notre ancien ambassadeur au Salvador, Alain Rouquié, a été aussi un terrain d’expérimentation grandeur nature pour les États-Unis. Il s’agissait, sur fond de Guerre froide, de juguler la contagion marxiste et donc d’adresser un sérieux avertissement aux autres pays de la région qui seraient tentés de rompre avec le grand protecteur nord-américain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aeb41181-de27-37ee-b521-6c137de670de",
                                        "entry_id": "00949708-fe8a-383b-bb5c-456e6bddfe8d",
                                        "glosses": [
                                            "Qui manifeste des intentions ou des sentiments criminels et perfides."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b380a7b6-03a4-4c05-a860-5f606b6c766f",
                                                "sense_id": "aeb41181-de27-37ee-b521-6c137de670de",
                                                "text": "Les lois scélérates sont une série de trois lois liberticides votées dans l’urgence afin de lutter contre les actions anarchistes qui menaçaient de déstabiliser des pans entiers du système."
                                            },
                                            {
                                                "example_id": "f2694d9b-d5b8-4d78-bb2c-605420eadf6b",
                                                "sense_id": "aeb41181-de27-37ee-b521-6c137de670de",
                                                "text": "Une première faute les jeta l’un et l’autre dans la voie scélérate qu’ils ont suivie jusqu’à leur fin misérable."
                                            },
                                            {
                                                "example_id": "c570e8a5-d5c9-44a2-a86a-6989820bf837",
                                                "sense_id": "aeb41181-de27-37ee-b521-6c137de670de",
                                                "text": "Toujours les scélérats ont recours au parjure. Cesse, cesse, et m’épargne un importun discours, Si ta fausse vertu n’a point d’autre secours."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scélérat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "19ad2b21-4c44-32f5-8cef-d46bbd23c6d6",
                                        "entry_id": "446b18d2-acd3-3864-b459-0842bbdf7cd2",
                                        "glosses": [
                                            "Celui qui manifeste des intentions ou des sentiments criminels et perfides."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdf126dd-edd0-4092-afa8-2fad9818bb77",
                                                "sense_id": "19ad2b21-4c44-32f5-8cef-d46bbd23c6d6",
                                                "text": "Il est bien probable que ce scélérat de Lycaon que dans son propre palais Jupiter prit la peine de changer en loup, fut un des premiers et sera toujours le plus célèbre des loups-garous anciens et modernes."
                                            },
                                            {
                                                "example_id": "fa30edaf-93b7-4bd6-8b4f-ee18f7b9aac5",
                                                "sense_id": "19ad2b21-4c44-32f5-8cef-d46bbd23c6d6",
                                                "text": "Il vaut mieux que tu lui aies survécu pour m'aider à retrouver les scélérats qui l'ont assassinée, dit Hervé."
                                            },
                                            {
                                                "example_id": "d935a16a-354b-4156-8717-302743ae1d47",
                                                "sense_id": "19ad2b21-4c44-32f5-8cef-d46bbd23c6d6",
                                                "text": "J’espère que tu aimes\nC’est assez beau non\nC’est le requiem pour un con\nJe l’ai composé spécialement pour toi\nÀ ta mémoire de scélérat."
                                            },
                                            {
                                                "example_id": "e64a9ba6-5fc0-40ce-9312-48890dd87da5",
                                                "sense_id": "19ad2b21-4c44-32f5-8cef-d46bbd23c6d6",
                                                "text": "Nommez le fourbe, infâme et scélérat maudit,\nTout le monde en convient et nul n’y contredit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
