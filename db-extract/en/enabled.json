                "senses": [
                    {
                        "sense_id": "1606e19e-48f4-3dd2-b328-0615af3df456",
                        "entry_id": "62a0f622-7d28-3059-859d-16bb0394cc4f",
                        "glosses": [
                            "Being capable for use or action; not disabled."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d25417f8-aeb5-4c47-ad27-688dc4ca7df3",
                                "sense_id": "1606e19e-48f4-3dd2-b328-0615af3df456",
                                "text": "Because of social media and the unprecedented access to information, ordinary people are more enabled than ever before. We call them WE Generation—spanning all age demographics and professions, these are the people connected by the desire to make a difference—rather than birth order."
                            },
                            {
                                "example_id": "5b5518a2-3561-4e2b-80e1-ad3f2654c1c6",
                                "sense_id": "1606e19e-48f4-3dd2-b328-0615af3df456",
                                "text": "And as Anthony Rode has articulated [...] \"Molly Sweeny [...] is no longer the most disabled but the most enabled of the three characters, positioned to relate directly to the audience and bring them to participate in the world she inhabits.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "63b94347-6e1b-3b88-93d7-aee9456476ae",
                        "entry_id": "62a0f622-7d28-3059-859d-16bb0394cc4f",
                        "glosses": [
                            "Adapted for use with the specified mechanism or system."
                        ],
                        "tags": [],
                        "examples": [
                            {
