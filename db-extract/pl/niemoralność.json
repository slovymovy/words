                        ]
                    },
                    {
                        "translation_id": "db0335db-7a9b-4c1c-81a6-c2803d209aab",
                        "source_entry_id": "e3defefc-f3bb-3e10-9d94-aaeff78ae569",
                        "source_sense_id": "45cf02c3-0b1d-3317-b843-893d00322d13",
