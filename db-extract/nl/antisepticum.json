                ],
                "senses": [
                    {
                        "sense_id": "9a3e60a9-a278-30e2-a0fc-fad01b1230f9",
                        "entry_id": "05b998b1-03c0-30f3-b565-bba8cf778fca",
                        "glosses": [
                            "een bacteriedodend middel dat plaatselijk, uitwendig kan worden gebruikt, op het lichaam of om instrumenten of werkvlakken te ontsmetten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f18f505-d167-4364-b6b5-3afceba36e80",
                                "sense_id": "9a3e60a9-a278-30e2-a0fc-fad01b1230f9",
                                "text": "De meeste antiseptica zijn te giftig voor inwendig gebruik."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ddee77b4-9c24-47bb-9450-3e2f4415edaf",
                        "source_entry_id": "05b998b1-03c0-30f3-b565-bba8cf778fca",
                        "source_sense_id": "9a3e60a9-a278-30e2-a0fc-fad01b1230f9",
                        "target_lang_word": "Antiseptikum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antiseptikum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e26c8597-238e-3a6d-9ec5-c36f1148cbc7",
                                        "entry_id": "a2a1463f-6362-329d-8628-ce70af95d7bf",
                                        "glosses": [
                                            "keimtötendes oder Bakterienwachstum hemmendes, physikalisches oder chemisches Mittel"
                                        ],
                                        "tags": [
                                            "besonders bei Wundbehandlung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2f68422-d4ab-4b52-bc6b-88a7a28a041d",
                                                "sense_id": "e26c8597-238e-3a6d-9ec5-c36f1148cbc7",
                                                "text": "Das Antiseptikum ist ein Mittel zur Vermeidung einer Sepsis, also einer Wundinfektion."
                                            },
                                            {
                                                "example_id": "9a79ccda-20cb-41cb-8ad6-df4d962b52c8",
                                                "sense_id": "e26c8597-238e-3a6d-9ec5-c36f1148cbc7",
                                                "text": "Je ärger die Beschwerden, desto größer die Wahrscheinlichkeit, daß Frauen der Sache mit einem in unverdünntes Antiseptikum getauchten Wattebausch beikommen wollen."
                                            },
                                            {
                                                "example_id": "76fa9aa1-b0b0-463b-9d19-d86169b91269",
                                                "sense_id": "e26c8597-238e-3a6d-9ec5-c36f1148cbc7",
                                                "text": "Benutzen Sie nie ein Antiseptikum an Ihrem Unterleib - niemals!"
                                            },
                                            {
                                                "example_id": "687949f0-c267-4c55-963c-c4348b0dd182",
                                                "sense_id": "e26c8597-238e-3a6d-9ec5-c36f1148cbc7",
                                                "text": "Antiseptika ergänzen den rein mechanischen Effekt der Wundspülung."
                                            },
                                            {
                                                "example_id": "63d94301-e7a9-4fbd-bf34-e4f6cd2001cb",
                                                "sense_id": "e26c8597-238e-3a6d-9ec5-c36f1148cbc7",
                                                "text": "Insbesondere in Abwägung der Vorteile und der unerwünschten Nebenwirkungen nimmt kein aktuell verfügbares orales Antiseptikum eine herausragende Rolle ein. Folglich kann keines der Antiseptika uneingeschränkt empfohlen werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b38f5569-d25e-469c-ba1e-506fa81c9265",
                        "source_entry_id": "05b998b1-03c0-30f3-b565-bba8cf778fca",
                        "source_sense_id": "9a3e60a9-a278-30e2-a0fc-fad01b1230f9",
                        "target_lang_word": "antiseptic",
