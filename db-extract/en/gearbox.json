                    {
                        "translation_id": "6f7ff414-24dc-458d-b666-deda4a640580",
                        "source_entry_id": "4e1a11ea-3766-3ef4-be73-1dce2669439e",
                        "source_sense_description": "train of gears",
                        "target_lang_word": "коро́бка переда́ч",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "коро́бка переда́ч",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0b82117e-5fa9-325b-8430-965051cb1b79",
                                        "entry_id": "c88f6292-19ed-3dbb-a8e9-247ff2412113",
                                        "glosses": [
                                            "техн. многозвенный механизм, в котором ступенчатое изменение передаточного отношения осуществляется при переключении зубчатых передач, размещённых, например, в отдельном корпусе (коробке)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b8cb1a2-bd68-42e6-abe1-7d36bbc427c1",
                                                "sense_id": "0b82117e-5fa9-325b-8430-965051cb1b79",
                                                "text": "В коробке передач трещина внизу, масло течёт."
                                            },
                                            {
                                                "example_id": "3c614393-fc7b-4d4d-bbcd-f197d6c79216",
                                                "sense_id": "0b82117e-5fa9-325b-8430-965051cb1b79",
                                                "text": "На тягаче установлен 12-цилиндровый дизель воздушного охлаждения мощностью 250 л. с. и 10-ступенчатая коробка передач."
                                            },
                                            {
                                                "example_id": "d0b40767-bd2e-4c05-b6e6-c9712c18a1dc",
                                                "sense_id": "0b82117e-5fa9-325b-8430-965051cb1b79",
                                                "text": "Напротив, электромобиль, пожалуй, наиболее «тихий» вид транспорта: в нём нет коробки передач, а хорошо отрегулированный электромотор почти бесшумен."
                                            },
                                            {
                                                "example_id": "d657035f-a015-4589-9232-92dae5bec1d2",
                                                "sense_id": "0b82117e-5fa9-325b-8430-965051cb1b79",
                                                "text": "Думается, не нужно объяснять, что работа почти любой современной машины (будь то автомобиль или станок) требует регулирования скорости вращения её валов. Поэтому между ведущим валом двигателя и ведомым валом исполнительного органа (соответственно скаты или патрон) ставится специальный механизм, меняющий своё передаточное число. На автомобилях его именуют коробкой передач, а на станках — коробкой скоростей."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
