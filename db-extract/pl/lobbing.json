                "senses": [
                    {
                        "sense_id": "30c469ee-9692-3d08-86cd-17b994bdd76b",
                        "entry_id": "93cc8377-17d8-31f7-86ef-8c5b039d3cc6",
                        "glosses": [
                            "wywieranie wpływu przez zawodowych rzeczników interesów na władze publiczne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43d09148-4926-43ed-873e-adb4253fe1d4",
                                "sense_id": "30c469ee-9692-3d08-86cd-17b994bdd76b",
                                "text": "Wpływanie na decyzje polityczne we własnym interesie, często mylone z lobbingiem to w rzeczywistości wykonywanie obywatelskiego prawa petycji do władz."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "667ec6df-c6c7-45e0-b729-5ba297a42121",
                        "source_entry_id": "93cc8377-17d8-31f7-86ef-8c5b039d3cc6",
                        "source_sense_id": "30c469ee-9692-3d08-86cd-17b994bdd76b",
                        "target_lang_word": "lobbying",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lobbying",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2781400-10c0-3bc0-b4ad-f9fd3cb4132e",
                                        "entry_id": "a51d05ce-c6fb-3172-860f-8f9104b30d8f",
                                        "glosses": [
                                            "present participle and gerund of lobby"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62faef24-9f56-471f-8da5-c4d745bca9cc",
                                                "sense_id": "e2781400-10c0-3bc0-b4ad-f9fd3cb4132e",
                                                "text": "The referee seemed well placed to award the goal, but video evidence suggested the protests were well founded and the incident only strengthens the case of those lobbying for technology to assist officials."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lobbying",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9334710a-6434-3047-a790-af8ba40b3eb6",
                                        "entry_id": "e3af1ae4-28d2-345a-bc74-04265df0a666",
                                        "glosses": [
                                            "The act of one who lobbies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06eb0dfe-60a5-4d74-9398-c0fe85a298fe",
                                                "sense_id": "9334710a-6434-3047-a790-af8ba40b3eb6",
                                                "text": "They showed a new and encouraging Parliamentary appreciation that it is time our national transport problems were examined expertly and without doctrinaire prejudice of any sort—or too much attention to the lobbying of some powerful special interests."
                                            },
                                            {
                                                "example_id": "a05a034d-2c61-4d83-8539-dbf5087212ef",
                                                "sense_id": "9334710a-6434-3047-a790-af8ba40b3eb6",
                                                "text": "Although Sylvia had been present with her mother at the various lobbyings of parliament in 1905 she had not attempted, in the midst of her studies, to build up any support for WSPU policy in London."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aba32668-583f-44f5-9e8b-7be102d6e460",
                        "source_entry_id": "93cc8377-17d8-31f7-86ef-8c5b039d3cc6",
                        "source_sense_id": "30c469ee-9692-3d08-86cd-17b994bdd76b",
                        "target_lang_word": "lobbying",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lobbying",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09c35d83-8b56-3494-a33f-02b5a2fbc125",
                                        "entry_id": "752e6c7d-d22e-3963-bfa7-562b95eca784",
                                        "glosses": [
                                            "Activités ou pressions exercées par un lobby afin d’obtenir des décisions qui lui sont favorables ou une influence favorable sur des décisions."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8940fe0f-10f9-41f7-81e1-c643dbd3ae17",
                                                "sense_id": "09c35d83-8b56-3494-a33f-02b5a2fbc125",
                                                "text": "M. de Carolis a dénoncé \"le lobbying choquant et indécent\" de TF1 et M6 auprès des élus et s'est dit \"déterminé à fond la caisse\" pour renforcer le groupe France Télévisions."
                                            },
                                            {
                                                "example_id": "67e32dcc-d4cc-4f6f-af5b-605aecb1feea",
                                                "sense_id": "09c35d83-8b56-3494-a33f-02b5a2fbc125",
                                                "text": "Tiens, tiens… 53 amendements concernant les chambres de commerce et d’industrie (CCI), bien connues pour recourir au lobbying parlementaire sur les sujets leur tenant à cœur…"
                                            },
                                            {
                                                "example_id": "ab595eb4-3d1a-46ed-b58a-019a7c8faff5",
                                                "sense_id": "09c35d83-8b56-3494-a33f-02b5a2fbc125",
                                                "text": "Cette disposition était le fruit d’un lobbying de la part des éditeurs de dictionnaires et d’encyclopédies au moment du vote de la loi de 1957 sur la propriété littéraire et artistique."
                                            },
                                            {
                                                "example_id": "b2292172-0bf2-4457-8e39-29d7b76b091d",
                                                "sense_id": "09c35d83-8b56-3494-a33f-02b5a2fbc125",
                                                "text": "Cette situation pourrait même peser sur le lobbying de la France en faveur d’une directive « bas carbone », prenant en compte le nucléaire, en lieu et place de la future mise à jour de la directive sur les renouvelables pour 2040."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50ccc035-6d9f-4b67-826d-793857487d55",
                        "source_entry_id": "93cc8377-17d8-31f7-86ef-8c5b039d3cc6",
                        "source_sense_id": "30c469ee-9692-3d08-86cd-17b994bdd76b",
                        "target_lang_word": "Lobbyismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lobbyismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c02bfbeb-0034-37b5-a9ce-7da0a8dc176a",
                                        "entry_id": "815c1130-b64b-3bfe-a578-c0033ce04147",
                                        "glosses": [
                                            "systematische und andauernde Einflussnahme von Wirtschaftsunternehmen, sozialen oder gesellschaftlichen Gruppen auf politische Entscheidungsträger, meist durch persönlichen Kontakt oder über die Massenmedien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d36b990-6965-451b-8e47-eb7a0c4a7f5f",
                                                "sense_id": "c02bfbeb-0034-37b5-a9ce-7da0a8dc176a",
                                                "text": "Lobbyismus kann in manchen Fällen bis zur Korruption und damit unerlaubten Einflussnahme führen."
                                            },
                                            {
                                                "example_id": "934b76e4-33b4-4556-9383-cf9a83b51567",
                                                "sense_id": "c02bfbeb-0034-37b5-a9ce-7da0a8dc176a",
                                                "text": "Der Lobbyismus ist die weiche Stelle der Demokratie, das ist unvermeidlich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
