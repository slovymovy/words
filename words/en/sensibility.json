        "supersensibility"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4b0664b1-e5d6-3dd1-9b08-92398345c7c6",
                    "sense_definition": "A person's delicate feelings, moral standards, or capacity to be easily offended.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crude jokes in the movie offended the <w>sensibilities</w> of many viewers."
                        },
                        {
                            "text": "He tried to speak tactfully so he would not hurt anyone's <w>sensibilities</w>."
                        }
                    ],
                    "synonyms": [
                        "feelings",
                        "sensitiveness"
                    ],
                    "common_phrases": [
                        "offend sensibilities",
                        "hurt sensibilities"
                    ]
                },
                {
                    "sense_id": "2adcbc05-9403-339f-bd1a-4197ab43c33d",
                    "sense_definition": "Appreciation of and responsiveness to aesthetic, emotional, or artistic qualities.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "aesthetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director brought a modern artistic <w>sensibility</w> to the historical play."
                        },
                        {
                            "text": "Her poetry reflects a delicate <w>sensibility</w> toward natural beauty."
                        }
                    ],
                    "synonyms": [
                        "taste",
                        "discernment"
                    ],
                    "common_phrases": [
                        "artistic sensibility",
                        "poetic sensibility"
                    ]
                },
                {
                    "sense_id": "3092d380-16fb-3b70-84c3-ed81fcbb0b58",
                    "sense_definition": "The physical ability to perceive or respond to sensory stimuli.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nerve injury temporarily reduced tactile <w>sensibility</w> in his fingertips."
                        },
                        {
                            "text": "A severe drop in temperature can blunt physical <w>sensibility</w>."
                        }
                    ],
                    "synonyms": [
                        "sensitivity",
                        "sensation"
                    ],
                    "antonyms": [
                        "insensibility"
                    ],
                    "common_phrases": [
                        "tactile sensibility"
                    ]
                },
                {
                    "sense_id": "b331068d-f188-3e3d-9a17-0f4d50c3b8a2",
                    "sense_definition": "Excessive emotional awareness or tendency to be emotionally moved; sentimental oversensitivity.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "emotions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In eighteenth-century literature, refined <w>sensibility</w> was celebrated as a moral virtue."
                        },
                        {
                            "text": "His excessive <w>sensibility</w> made him weep at every minor misfortune."
                        }
                    ],
                    "synonyms": [
                        "sentimentality",
                        "oversensitivity"
                    ],
                    "common_phrases": [
                        "person of sensibility"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "frequently associated with 18th-century sentimentalism"
                        }
                    ]
                },
                {
                    "sense_id": "0f439144-4f10-38b9-9951-0b2822ee6721",
                    "sense_definition": "The state or capacity of being perceptible by the senses.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher debated whether the <w>sensibility</w> of matter proved its real existence."
                        },
                        {
                            "text": "These microscopic changes lie beyond the <w>sensibility</w> of ordinary human perception."
                        }
                    ],
                    "synonyms": [
                        "perceptibility"
                    ],
                    "antonyms": [
                        "imperceptibility"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare philosophical usage"
                        }
                    ]
                }
            ]
        }
    ]
