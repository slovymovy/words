                                "example_id": "d62947f8-4825-4dd6-84bb-dc2b89865ff7",
                                "sense_id": "48a72bb9-4b89-394f-a477-2d02f58c7c16",
                                "text": "Elle choisit bien sûr des activités réglementairement adaptées à l'âge des invités."
                            }
