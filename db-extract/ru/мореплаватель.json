                    {
                        "translation_id": "7943e422-8035-4cd1-bf8a-6c91999bd20d",
                        "source_entry_id": "885d58f4-4be5-3d12-b401-d49b27544a63",
                        "source_sense_id": "3f0c83b9-ffe7-3ac7-90b1-a637ad048718",
                        "target_lang_word": "Seefahrer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seefahrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8e238e87-511f-391c-9921-81f933f4ddbb",
                                        "entry_id": "39e9451d-1209-3b80-81ef-137e4c7c8343",
                                        "glosses": [
                                            "Person, die zu See fährt, die mit einem (kommerziellen) Segelschiff unterwegs ist; Menschen, Gruppen oder Völker, deren Leben hauptsächlich von der Seefahrt geprägt ist"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d4dafb5-089c-449d-a637-8205a0a2df52",
                                                "sense_id": "8e238e87-511f-391c-9921-81f933f4ddbb",
                                                "text": "In den früheren Jahrhunderten litten die Seefahrer auf ihren Schiffen oft an Skorbut und anderen Krankheiten."
                                            },
                                            {
                                                "example_id": "cc426f04-43c1-4833-8b9a-88f1e04fdf25",
                                                "sense_id": "8e238e87-511f-391c-9921-81f933f4ddbb",
                                                "text": "„Das Kommando führte der größte Seefahrer aller Zeiten, Kapitän James Cook.“"
                                            },
                                            {
                                                "example_id": "5e13fadc-98f3-49dc-8d03-3679b40b0fba",
                                                "sense_id": "8e238e87-511f-391c-9921-81f933f4ddbb",
                                                "text": "„Die Wikinger sind die besten Seefahrer ihrer Zeit, doch die Reise nach Island ist derart gefährlich, dass viele Schiffe ihr Ziel nicht erreichen.“"
                                            },
                                            {
                                                "example_id": "1a62f709-ab5e-486f-9a14-2903269b0cc8",
                                                "sense_id": "8e238e87-511f-391c-9921-81f933f4ddbb",
                                                "text": "„Kein Seefahrer würde jemals seinen Weg hierher finden.“"
                                            },
                                            {
                                                "example_id": "a5c6b0a0-39d4-416a-afdb-7157eb18afa8",
                                                "sense_id": "8e238e87-511f-391c-9921-81f933f4ddbb",
                                                "text": "„Am 22. April 1500 stießen portugiesische Seefahrer auf eine Küste, die nicht in ihren Karten verzeichnet war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
