                        "target_lang_word": "raccourci",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raccourci",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "653345b5-6d2c-301a-a368-295522f1509a",
                                        "entry_id": "37447cc3-2680-3831-9e14-495b0c4f2b0b",
                                        "glosses": [
                                            "Qui est plus court qu’auparavant, ou plus court que l’original."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68343284-30ca-49e4-a0fd-2f1481d29865",
                                                "sense_id": "653345b5-6d2c-301a-a368-295522f1509a",
                                                "text": "Regardez-moi ces pantalons tout raccourcis !"
                                            },
                                            {
                                                "example_id": "87168824-3166-4268-9479-86eb27093b77",
                                                "sense_id": "653345b5-6d2c-301a-a368-295522f1509a",
                                                "text": "C’est une version raccourcie de ton texte ?"
                                            },
                                            {
                                                "example_id": "781306b3-bc2b-4486-adf5-83ffafaeb00e",
                                                "sense_id": "653345b5-6d2c-301a-a368-295522f1509a",
                                                "text": "Les jours sont raccourcis d’une demi-heure depuis un mois."
                                            },
                                            {
                                                "example_id": "a69c7c6a-ec0f-4f78-8bea-2773f5a70768",
                                                "sense_id": "653345b5-6d2c-301a-a368-295522f1509a",
                                                "text": "Gilles et Ahmed vont faire la route Napoléon en quatre étapes raccourcies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c4e5a7d-b672-37ac-9511-c24335bfebd7",
                                        "entry_id": "37447cc3-2680-3831-9e14-495b0c4f2b0b",
                                        "glosses": [
                                            "Qui est abrégé."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a4852b9-3ec5-4948-be62-ba1156a79f59",
                                                "sense_id": "6c4e5a7d-b672-37ac-9511-c24335bfebd7",
                                                "text": "Cet historien n’a présenté qu’un tableau raccourci de tous ces grands événements."
                                            },
                                            {
                                                "example_id": "5997eb53-a614-487f-8f11-2253d3dd63d3",
                                                "sense_id": "6c4e5a7d-b672-37ac-9511-c24335bfebd7",
                                                "text": "Dès sa présentation fin 2024, cette nouvelle institution a pris le nom raccourci de Doge, référence directe à la cryptomonnaie chérie par Elon Musk."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "raccourci",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f416417a-1f6f-3391-9b2b-6af933290725",
                                        "entry_id": "12f5b56c-a7bb-326f-9da7-ae8256db474f",
                                        "glosses": [
                                            "Chemin plus court."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62b9619e-ce35-41d3-a7ee-44c8a96de7cb",
                                                "sense_id": "f416417a-1f6f-3391-9b2b-6af933290725",
                                                "text": "Je vais prendre un raccourci, ce sera plus rapide."
                                            },
                                            {
                                                "example_id": "aeae7d4b-a1e7-4e8b-8c1a-4dadb9e4d33e",
                                                "sense_id": "f416417a-1f6f-3391-9b2b-6af933290725",
                                                "text": "Je ne suis jamais passé par là, c’est un raccourci ?"
                                            },
                                            {
                                                "example_id": "85768dc1-af7c-4159-be68-2cc53b545c39",
                                                "sense_id": "f416417a-1f6f-3391-9b2b-6af933290725",
                                                "text": "— Jean, dit-elle enfin, quand tu étais petit, c’est moi qui te conduisais le long des routes... Je n’étais guère plus grande, mais je connaissais mieux les raccourcis... Aujourd’hui tu te perds, Jean, et il faudrait encore te remettre en bon chemin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee02509c-7da2-39c3-8b31-e5597d3f391d",
                                        "entry_id": "12f5b56c-a7bb-326f-9da7-ae8256db474f",
                                        "glosses": [
                                            "Aspect de certains objets, de certaines figures qui ne doivent pas se présenter à l’œil dans tout leur développement, dont certaines dimensions sont réduites par rapport aux autres par un effet de perspective."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3375a664-c9bf-4174-81dc-cf0685f9169c",
                                                "sense_id": "ee02509c-7da2-39c3-8b31-e5597d3f391d",
                                                "text": "Un effet de raccourci."
                                            },
                                            {
                                                "example_id": "f5d199a8-1c54-4671-9be4-110ed90843e3",
                                                "sense_id": "ee02509c-7da2-39c3-8b31-e5597d3f391d",
                                                "text": "De puissants raccourcis."
                                            },
                                            {
                                                "example_id": "103538b7-a989-442b-93b2-092b48b8b142",
                                                "sense_id": "ee02509c-7da2-39c3-8b31-e5597d3f391d",
                                                "text": "Lorsque l’on dessine des doigts, les raccourcis de perspective sont souvent recommandés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4ef4d7c-7e43-3236-a537-a2f053fde44f",
                                        "entry_id": "12f5b56c-a7bb-326f-9da7-ae8256db474f",
                                        "glosses": [
                                            "Groupe de touches permettant d’effectuer une action. → voir raccourci clavier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc601637-23bc-42be-8764-59110b6782ca",
                                                "sense_id": "f4ef4d7c-7e43-3236-a537-a2f053fde44f",
                                                "text": "si un raccourci existe dans la barre des tâches, un simple clic dessus lance l’application."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ce06338-3c2e-343e-a49b-796d3d54d268",
                                        "entry_id": "12f5b56c-a7bb-326f-9da7-ae8256db474f",
                                        "glosses": [
                                            "Abrégé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec14917c-6a84-4fc4-b1a1-32acb00d65b9",
                                                "sense_id": "6ce06338-3c2e-343e-a49b-796d3d54d268",
                                                "text": "Et dans la foulée, si le raccourci cubi ne vous convient pas, n’hésitez pas davantage à faire usage d’un cubiteneur en remplacement du cubitainer. Aucune raison pour que le vin s’aigrisse davantage dans l’un que dans l’autre."
                                            }
                                        ]
                                    }
                                ]
                            },
