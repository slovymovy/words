                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0929ded5-7c91-459b-94ed-8c6388c42fee",
                        "source_entry_id": "69634797-b4a9-37c9-8ab1-b6fec895c460",
                        "source_sense_id": "3a3e97b3-2d29-3579-bb86-f9f39f016bfd",
                        "target_lang_word": "outhouse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outhouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b402b2f3-9a28-32b0-8e38-013100f7b365",
                                        "entry_id": "4fc51b80-a12d-330e-8ee4-97f8328b0cae",
                                        "glosses": [
                                            "An outbuilding, typically permanent, containing a toilet or seat over a cesspit."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71a3b014-ecc3-3bb7-a8ff-8aa22b3a8978",
                                        "entry_id": "4fc51b80-a12d-330e-8ee4-97f8328b0cae",
                                        "glosses": [
                                            "Any outbuilding: any small structure located apart from a main building."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53e983fa-e2b5-4892-be13-7cc13fc43eea",
                                                "sense_id": "71a3b014-ecc3-3bb7-a8ff-8aa22b3a8978",
                                                "text": "The children had explored the gardens and the outhouses thoroughly before they were caught and cleaned for tea, and they saw quite well that they were certain to be happy at the White House."
                                            },
                                            {
                                                "example_id": "5768c377-79b8-4a1e-aa9f-a4c6b7439562",
                                                "sense_id": "71a3b014-ecc3-3bb7-a8ff-8aa22b3a8978",
                                                "text": "There was a considerable outhouse, which he unlocked and we entered."
                                            },
                                            {
                                                "example_id": "44d51580-0f4e-4c87-883c-aa1587016510",
                                                "sense_id": "71a3b014-ecc3-3bb7-a8ff-8aa22b3a8978",
                                                "text": "[…] plenty of sand and cement had been found in one of the outhouses"
                                            },
                                            {
                                                "example_id": "03cccb38-68ef-4285-8975-54f2ba3ae465",
                                                "sense_id": "71a3b014-ecc3-3bb7-a8ff-8aa22b3a8978",
                                                "text": "Dumbledore pointed toward a run-down stone outhouse where the Weasleys kept their broomsticks."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "outhouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d03a862-d283-3b9d-93c3-c595712be1ac",
                                        "entry_id": "11f3aa9f-c671-33cb-b9ac-f49d2be4711f",
                                        "glosses": [
                                            "To house in a separate building."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f4c976f-4a83-43f5-b2ef-5b4ac4a1e1ce",
                                                "sense_id": "1d03a862-d283-3b9d-93c3-c595712be1ac",
                                                "text": "In our discussion of outhousing we have tried to take into account the inconvenience to users as well as the potential savings in costs."
                                            },
                                            {
                                                "example_id": "425d8b54-6ca1-4794-9c5f-959eeb1802b7",
                                                "sense_id": "1d03a862-d283-3b9d-93c3-c595712be1ac",
                                                "text": "The Information Department is outhoused but there are operational reasons for this and it would, in any case, be physically impossible to house the staff of the Department in the main building."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c42808cf-3c37-4d5d-b5a7-9ff9d075ebf7",
                        "source_entry_id": "69634797-b4a9-37c9-8ab1-b6fec895c460",
                        "source_sense_id": "3a3e97b3-2d29-3579-bb86-f9f39f016bfd",
                        "target_lang_word": "kadibudka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kadibudka",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "568211fd-4716-33ac-a91c-7041eb7da469",
                                        "entry_id": "ef0bf676-2d47-3d7f-903e-aa1497524139",
                                        "glosses": [
                                            "malá bouda se suchým záchodem s odpadem ze sedáku do díry v zemi"
                                        ],
                                        "tags": [
                                            "lidově"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b6c0403-42d6-460d-bc38-f9d1c2be5c1a",
                                                "sense_id": "568211fd-4716-33ac-a91c-7041eb7da469",
                                                "text": "Za chatou je kadibudka, splachovací záchod nemáme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1faaeaa-a218-4eed-b688-53bb20a2391f",
                        "source_entry_id": "69634797-b4a9-37c9-8ab1-b6fec895c460",
                        "source_sense_id": "3a3e97b3-2d29-3579-bb86-f9f39f016bfd",
                        "target_lang_word": "сортир",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сортир",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a76a6c69-6ffb-33dd-bc9d-589e2befbbb1",
                                        "entry_id": "59b74efb-c7f0-34d4-b52c-1d8ec4716355",
                                        "glosses": [
                                            "прост. отхожее место; уборная"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b36cafbb-fde8-48e5-8540-010596317700",
                                                "sense_id": "a76a6c69-6ffb-33dd-bc9d-589e2befbbb1",
                                                "text": "Пошатываясь, дошагал до сортира, спустил штаны и уселся на стульчак, не закрыв за собой дверь."
                                            },
                                            {
                                                "example_id": "f10195ef-2d82-49b4-9388-0ca676128e02",
                                                "sense_id": "a76a6c69-6ffb-33dd-bc9d-589e2befbbb1",
                                                "text": "Они пользуются сортиром, они пользуются кухней, они пользуются телефоном"
                                            },
                                            {
                                                "example_id": "0677814b-d8e6-4d9f-ad54-24afc0b82cd3",
                                                "sense_id": "a76a6c69-6ffb-33dd-bc9d-589e2befbbb1",
                                                "text": "Бывало, человек сортир чистит, смотришь на него ― мнет ситник, сыт и весел, а теперь этот же самый человек, ведь они теперь все те же самые люди, стоит чистит нужник, ситника ему теперь нет, а нужник остался."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daa96f2f-a84b-3021-a1f8-9b639185db3c",
                                        "entry_id": "59b74efb-c7f0-34d4-b52c-1d8ec4716355",
                                        "glosses": [
                                            "прост. положение без возможности хода"
                                        ],
                                        "tags": [
                                            "в шашках"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
