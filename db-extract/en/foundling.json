                    {
                        "translation_id": "c461ed62-a9ba-4d7d-b375-5ce0232f4909",
                        "source_entry_id": "cfaa29fc-a168-3aa4-b6b1-9e93bfca5799",
                        "source_sense_id": "f4fbf2ef-89ab-3557-a5b8-b206c6a455fc",
