{
    "word_family": [
        "vraat",
        "vretend",
        "gevreten"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0cd9ae82-1ac0-3458-a3c0-0dc7f452e0b7",
                    "sense_definition": "Op een gulzige, onbeleefde of dierlijke manier voedsel tot zich nemen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "eten_werkwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zit toch niet zo asociaal te <w>vreten</w>!",
                            "target_lang_translations": {
                                "en": "Don't <w>stuff your face</w> in such an antisocial way!"
                            }
                        },
                        {
                            "text": "De hongerige honden <w>vraten</w> hun bakken in een paar seconden leeg.",
                            "target_lang_translations": {
                                "en": "The hungry dogs <w>devoured</w> their bowls in a matter of seconds."
                            }
                        }
                    ],
                    "synonyms": [
                        "schransen",
                        "bunkeren",
                        "schrokken",
                        "fretten"
                    ],
                    "common_phrases": [
                        "asociaal te vreten",
                        "alles op vreten"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used to describe eating in an impolite or animalistic manner."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To consume food in a greedy, impolite, or animalistic manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stuff oneself",
                                "target_lang_sense_clarification": "to eat greedily"
                            },
                            {
                                "target_lang_word": "gorge",
                                "target_lang_sense_clarification": "to eat greedily"
                            },
                            {
                                "target_lang_word": "stuff",
                                "target_lang_sense_clarification": "to eat in a hearty or greedy manner"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4dc63c40-4da2-3045-b6e8-5de84309726a",
                    "sense_definition": "Voedsel nuttigen (plat of informeel synoniem voor <w>eten</w>).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "eten_werkwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hebben vanavond lekker patat zitten <w>vreten</w> voor de televisie.",
                            "target_lang_translations": {
                                "en": "We sat <w>stuffing ourselves</w> with fries in front of the TV tonight."
                            }
                        },
                        {
                            "text": "Wat gaan we vanavond eigenlijk <w>vreten</w>?",
                            "target_lang_translations": {
                                "en": "What are we actually going to <w>grub</w> tonight?"
                            }
                        }
                    ],
                    "synonyms": [
                        "eten",
                        "kanen"
                    ],
                    "common_phrases": [
                        "lekker vreten"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal and slightly vulgar alternative to 'eten'."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To consume food (informal or colloquial synonym for eating)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stuff",
                                "target_lang_sense_clarification": "to eat, informal"
                            },
                            {
                                "target_lang_word": "pig out",
                                "target_lang_sense_clarification": "to eat a lot of food"
                            },
                            {
                                "target_lang_word": "grub",
                                "target_lang_sense_clarification": "to eat, slang"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54554ea3-d9f9-3e2d-bbe1-899dea0c2e1b",
                    "sense_definition": "In zeer grote hoeveelheden verbruiken of verslijten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verbruiken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze oude motorfiets <w>vreet</w> kettingen en benzine.",
                            "target_lang_translations": {
                                "en": "This old motorcycle <w>eats through</w> chains and gas."
                            }
                        },
                        {
                            "text": "Die zware applicaties op je telefoon <w>vreten</w> echt energie.",
                            "target_lang_translations": {
                                "en": "Those heavy apps on your phone really <w>guzzle</w> energy."
                            }
                        }
                    ],
                    "common_phrases": [
                        "energie vreten"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used metaphorically for high consumption."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To consume or wear out in very large quantities."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "guzzle",
                                "target_lang_sense_clarification": "to consume fuel or energy rapidly"
                            },
                            {
                                "target_lang_word": "eat up",
                                "target_lang_sense_clarification": "to consume resources quickly"
                            },
                            {
                                "target_lang_word": "devour",
                                "target_lang_sense_clarification": "to consume a lot of resources"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea57e98a-e2b9-38e1-9f12-c1c7d44e86f5",
                    "sense_definition": "Een aanhoudend, pijnlijk en knagend gevoel veroorzaken, vooral mentaal.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mentale_pijn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit geheim blijft al jaren aan mij <w>vreten</w>.",
                            "target_lang_translations": {
                                "en": "This secret has been <w>eating away</w> at me for years."
                            }
                        },
                        {
                            "text": "De schuldgevoelens <w>vraten</w> aan zijn geweten.",
                            "target_lang_translations": {
                                "en": "The feelings of guilt <w>gnawed</w> at his conscience."
                            }
                        }
                    ],
                    "common_phrases": [
                        "aan iemand vreten"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause a persistent, painful, and gnawing feeling, especially mentally."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "eat away at",
                                "target_lang_sense_clarification": "to cause persistent mental pain or worry"
                            },
                            {
                                "target_lang_word": "gnaw at",
                                "target_lang_sense_clarification": "to worry or torment someone constantly"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7e055864-ca82-3533-a211-272713c7741e",
                    "sense_definition": "Voedsel, vaak op een platte of informele manier aangeduid.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "voedsel_zelfstandig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eerst komt het <w>vreten</w>, dan de moraal.",
                            "target_lang_translations": {
                                "en": "First comes the <w>grub</w>, then the morals."
                            }
                        },
                        {
                            "text": "Is er nog wat <w>vreten</w> in huis voor vanavond?",
                            "target_lang_translations": {
                                "en": "Is there any <w>chow</w> left in the house for tonight?"
                            }
                        }
                    ],
                    "synonyms": [
                        "eten"
                    ],
                    "common_phrases": [
                        "eerst het vreten"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal and slightly rude term for food."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Food, often referred to in a colloquial, informal, or slightly rude way."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grub",
                                "target_lang_sense_clarification": "slang for food"
                            },
                            {
                                "target_lang_word": "chow",
                                "target_lang_sense_clarification": "informal word for food"
                            },
                            {
                                "target_lang_word": "nosh",
                                "target_lang_sense_clarification": "slang for food or a snack"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4472985a-39f4-37e2-be4b-f636490e8623",
                    "sense_definition": "Voedsel dat specifiek bestemd is voor dieren.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "voedsel_zelfstandig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moeten nog nieuw <w>vreten</w> voor de varkens kopen.",
                            "target_lang_translations": {
                                "en": "We still need to buy new <w>feed</w> for the pigs."
                            }
                        },
                        {
                            "text": "De boer strooide het <w>vreten</w> in de stal.",
                            "target_lang_translations": {
                                "en": "The farmer scattered the <w>feed</w> in the stable."
                            }
                        }
                    ],
                    "synonyms": [
                        "fret"
                    ],
                    "common_phrases": [
                        "vreten voor de dieren"
                    ],
                    "target_lang_definitions": {
                        "en": "Food specifically intended for animals."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "feed",
                                "target_lang_sense_clarification": "food for animals"
                            },
                            {
                                "target_lang_word": "fodder",
                                "target_lang_sense_clarification": "coarse food for livestock"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}