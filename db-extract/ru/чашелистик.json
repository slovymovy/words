                        "cross_references": [
                            {
                                "target_word": "sepal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b8bf014-4958-3fe2-878d-28d574c60bfd",
                                        "entry_id": "8ee06357-ce58-315c-82ee-0a7128584ffc",
                                        "glosses": [
                                            "One of the component parts of the calyx, particularly when such components are not fused into a single structure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81c849e3-b436-4cb5-ab4a-ad76d37ca889",
                                                "sense_id": "4b8bf014-4958-3fe2-878d-28d574c60bfd",
                                                "text": "1836, The Family Magazine, Or Monthly Abstract of General Knowledge, Volume III, Redfield & Lindsay, page 367,\nWhen the sepals are distinct, or separate from each other, the calyx is said to be polysepalous."
                                            },
                                            {
                                                "example_id": "5b6c2417-2fe1-4d28-87c8-bae1d23e9d0e",
                                                "sense_id": "4b8bf014-4958-3fe2-878d-28d574c60bfd",
                                                "text": "The sepal and the petal are essentially leaf-like in form and anatomy but generally simpler in detailed structure than a foliage leaf."
                                            },
                                            {
                                                "example_id": "28817359-0f7a-4220-b392-4b7249db07db",
                                                "sense_id": "4b8bf014-4958-3fe2-878d-28d574c60bfd",
                                                "text": "In tomato, for example, the first sepal primordium is formed as an outgrowth at the periphery of the apex and the subsequent sepal primordia are initiated in a helical fashion at an angle of approximately 137° from the previous one."
                                            }
                                        ]
                                    }
