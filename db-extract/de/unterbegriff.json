                ],
                "senses": [
                    {
                        "sense_id": "46a4f9c6-3b25-36d6-9a9e-283e2a4749db",
                        "entry_id": "3da470ad-c065-399a-97d8-92067a12b16c",
                        "glosses": [
                            "eine Spezialisierung oder Unterklasse eines Begriffes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56548f58-bd62-4da3-b3c6-196ac5d11bec",
                                "sense_id": "46a4f9c6-3b25-36d6-9a9e-283e2a4749db",
                                "text": "Der Unterbegriff hat alle Merkmale des Oberbegriffs und zusätzlich mindestens ein einschränkendes Merkmal."
                            },
                            {
                                "example_id": "2050f872-f377-4181-8812-f7d2bfaa250f",
                                "sense_id": "46a4f9c6-3b25-36d6-9a9e-283e2a4749db",
                                "text": "Fallobst ist ein Unterbegriff von Obst."
                            },
                            {
                                "example_id": "ea6a91af-4f11-45d7-847f-d355628ceb1d",
                                "sense_id": "46a4f9c6-3b25-36d6-9a9e-283e2a4749db",
                                "text": "Vogel ist ein Unterbegriff von Tier."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9efec39-2c72-42f3-9042-22becb7f889a",
                        "source_entry_id": "3da470ad-c065-399a-97d8-92067a12b16c",
                        "source_sense_id": "46a4f9c6-3b25-36d6-9a9e-283e2a4749db",
                        "source_sense_description": "Linguistik: eine Spezialisierung oder Unterklasse eines Begriffes",
                        "target_lang_word": "hyponym",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyponym",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59437c62-be36-365f-a16d-ae8a80e29dca",
                                        "entry_id": "a117ce00-583b-3c95-ba14-228eb75424ed",
                                        "glosses": [
                                            "A more specific term; a subordinate grouping word or phrase; a term designating a subclass of another more general class described by the given word."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37605d03-66ba-430d-8309-00b8a9117c4b",
                                                "sense_id": "59437c62-be36-365f-a16d-ae8a80e29dca",
                                                "text": "The words “dog”, “cat”, and “horse” are hyponyms of “animal” because dogs, cats, and horses are types of animal."
                                            },
                                            {
                                                "example_id": "ef4b7224-8a08-442b-b74d-8491411d47ef",
                                                "sense_id": "59437c62-be36-365f-a16d-ae8a80e29dca",
                                                "text": "Woman itself has as other hyponyms, sculptress and waitress, but is itself a hyponym of adult."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b66d6e7-bffe-4df2-b06c-922a10aca3c9",
                        "source_entry_id": "3da470ad-c065-399a-97d8-92067a12b16c",
                        "source_sense_id": "46a4f9c6-3b25-36d6-9a9e-283e2a4749db",
                        "source_sense_description": "Linguistik: eine Spezialisierung oder Unterklasse eines Begriffes",
                        "target_lang_word": "hyponyme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyponyme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "982057cc-4112-3025-b4a7-7aa210409edd",
                                        "entry_id": "31b88ab1-e3d6-308f-9e33-dc3474e07d9b",
                                        "glosses": [
                                            "Mot dont le sens (sa compréhension sémantique) est plus spécifique que celui d’un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1ffb1b2-8705-42f2-98d7-c6f79b9344d7",
                                                "sense_id": "982057cc-4112-3025-b4a7-7aa210409edd",
                                                "text": "On dira qu’une unité lexicale A est hyponyme d’une unité lexicale B quand l’extension de B inclut celle de A."
                                            },
                                            {
                                                "example_id": "2f6f8175-98d3-4944-9c3c-a9d6031d59a5",
                                                "sense_id": "982057cc-4112-3025-b4a7-7aa210409edd",
                                                "text": "La frontière entre hyponyme et dénomination analogique pourrait passer entre aigle de mer « pyrargue » et aigle de mer « frégate »."
                                            },
                                            {
                                                "example_id": "6a38f75f-8797-478f-bc2f-a82a3caedb9d",
                                                "sense_id": "982057cc-4112-3025-b4a7-7aa210409edd",
                                                "text": "La négation d’un hyperonyme entraîne la négation de tous ses hyponymes."
                                            },
                                            {
                                                "example_id": "47780ee1-5145-4297-803b-25b5ec378f5a",
                                                "sense_id": "982057cc-4112-3025-b4a7-7aa210409edd",
                                                "text": "Ainsi, oiseau est un hyperonyme de mouette ou de corbeau, et mouette et corbeau sont des hyponymes d’oiseau."
                                            },
                                            {
                                                "example_id": "cff5c416-cdf3-4421-b9ef-8544ebacb524",
                                                "sense_id": "982057cc-4112-3025-b4a7-7aa210409edd",
                                                "text": "D’autre part, et ce trait est essentiel, alors qu’un hyperonyme impose ses propriétés à ses hyponymes, les propriétés du tout (holonyme) ne sont pas obligatoirement transmises à ses parties (méronymes). Les co-hyponymes de fleur : tulipe, œillet, pivoine (cf. infra, 2.3) possèdent les propriétés de la classe fleur (pétales, parfum, etc.), mais les méronymes de bicyclette comme guidon, roues n’ont pas en commun les propriétés de la classe bicyclette, puisque les parties des noms comptables ne sont pas homogènes (cf. supra)."
                                            },
                                            {
                                                "example_id": "cd7e4570-f726-4240-bdb7-f7bf856dc4e2",
                                                "sense_id": "982057cc-4112-3025-b4a7-7aa210409edd",
                                                "text": "Destrier est un hyponyme de cheval."
                                            },
                                            {
                                                "example_id": "632d5143-4fef-4dff-815f-4b32e9a3513b",
                                                "sense_id": "982057cc-4112-3025-b4a7-7aa210409edd",
                                                "text": "Pouce est un hyponyme de doigt, qui est à son tour hyponyme de membre mais méronyme de main."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4378dc7b-c6b0-494e-a2db-000b029090ac",
                        "source_entry_id": "3da470ad-c065-399a-97d8-92067a12b16c",
