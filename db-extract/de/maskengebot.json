                        "entry_id": "ffb082ad-ea69-3d34-a164-08b88b7e9b43",
                        "glosses": [
                            "dringende Empfehlung, Teile des Gesichts zu verhüllen, um andere vor Ansteckung oder sich vor Erkanntwerden zu schützen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "546a156b-048f-4a29-9900-8fb4326659ff",
                                "sense_id": "20374f82-a1e7-3b74-bd2b-81b522bbaadd",
                                "text": "„Viele begnügten sich damit, eine Larve auf den Hut zu stecken, um dem Maskengebot zu genügen.“"
                            },
                            {
                                "example_id": "d7dd5204-4fa5-4e93-b06c-44c00cb9b467",
                                "sense_id": "20374f82-a1e7-3b74-bd2b-81b522bbaadd",
                                "text": "„Zudem spricht das Kabinett ein Maskengebot aus.“"
                            },
                            {
                                "example_id": "5b27068e-5848-4b46-a620-afdce0581c16",
                                "sense_id": "20374f82-a1e7-3b74-bd2b-81b522bbaadd",
                                "text": "„Im öffentlichen Personenverkehr will Söder die Maskenempfehlung eher als ‚Maskengebot‘ verstehen.“"
                            },
                            {
                                "example_id": "ba3419d9-df37-4a70-a8ee-8ff543996577",
                                "sense_id": "20374f82-a1e7-3b74-bd2b-81b522bbaadd",
                                "text": "„Die Ankündigung des ‚Maskengebots‘ der Bundesregierung hat allerdings bei Teilen der Bevölkerung zu Fragen geführt.“"
                            },
                            {
                                "example_id": "717292c7-90e1-4afa-90da-ae794ce2dd6f",
                                "sense_id": "20374f82-a1e7-3b74-bd2b-81b522bbaadd",
                                "text": "„Maskengebot in Bayern: Was bedeutet das? Wann muss ich eine Mund-Nasen-Maske tragen? Wie muss die Maske aussehen und wo bekomme ich sie her?“"
                            }
                        ],
