                ],
                "senses": [
                    {
                        "sense_id": "1b8fc9c8-9eac-3ba2-aca0-4a69b82b69c5",
                        "entry_id": "3c197fec-1fec-3dd4-9057-e0f0d677ec80",
                        "glosses": [
                            "Platz, der gewöhnlich immer von derselben Person besetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49665d77-fe69-463f-be70-8b79526a6592",
                                "sense_id": "1b8fc9c8-9eac-3ba2-aca0-4a69b82b69c5",
                                "text": "Er war sehr verärgert, dass sich jemand auf seinen Stammplatz gesetzt hatte."
                            },
                            {
                                "example_id": "6e75a58f-2ac0-4766-bddb-edf928891525",
                                "sense_id": "1b8fc9c8-9eac-3ba2-aca0-4a69b82b69c5",
                                "text": "„Es war eine einfache, sehr schlichte Kirche mit zwei Seitenschiffen und vielen Rundbögen, und Papa flüsterte mir zu, dass es früher an den Bänken kleine Schildchen mit den Namen der Kirchgänger gegeben habe, so dass man in jedem Gottesdienst an seinem Stammplatz gesessen habe.“"
                            },
                            {
                                "example_id": "23a6edef-a4e5-44d9-af2f-9161e925f39b",
                                "sense_id": "1b8fc9c8-9eac-3ba2-aca0-4a69b82b69c5",
                                "text": "„Thomas Mann hatte im Arbeitszimmer Feuchtwangers einen Stammplatz am Schreibtisch Hilde Waldos, wenn Lion vorlas.“"
                            },
                            {
                                "example_id": "aee9f04e-bbeb-4248-b785-6b54aa492b3b",
                                "sense_id": "1b8fc9c8-9eac-3ba2-aca0-4a69b82b69c5",
                                "text": "„Hier war der Stammplatz der Alkoholiker.“"
                            },
                            {
                                "example_id": "bb58ae1d-0fd2-409c-821c-c2f810121a47",
                                "sense_id": "1b8fc9c8-9eac-3ba2-aca0-4a69b82b69c5",
                                "text": "„Seither prangte das revolutionäre Trio wieder an seinem Stammplatz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
