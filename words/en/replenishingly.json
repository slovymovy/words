    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "488c531b-a9a4-39d2-bbf4-01827d2d290e",
                    "sense_definition": "In a manner that restores, refills, or renews something to its original or full state.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "restoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the long hike, we laughed deeply and <w>replenishingly</w> as we shared a meal by the fire.",
                            "target_lang_translations": {
                                "ru": "После долгого похода мы смеялись от души, и этот смех действовал <w>восстанавливающе</w>, пока мы ужинали у костра."
                            }
                        },
                        {
                            "text": "The mountain spring wells up <w>self-replenishingly</w>, providing a constant source of fresh water for the village.",
                            "target_lang_translations": {
                                "ru": "Горный источник бьет, <w>самовосполняясь</w>, обеспечивая деревню постоянным притоком свежей воды."
                            }
                        }
                    ],
                    "synonyms": [
                        "restoratively",
                        "renewingly"
                    ],
                    "antonyms": [
                        "depletingly"
                    ],
                    "common_phrases": [
                        "wells up self-replenishingly",
                        "deeply and replenishingly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Таким образом, что восстанавливает, восполняет или обновляет что-либо до его первоначального или полного состояния."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восстанавливающе",
                                "target_lang_sense_clarification": "возвращая силы или ресурсы"
                            },
                            {
                                "target_lang_word": "восполняюще",
                                "target_lang_sense_clarification": "наполняя заново"
                            },
                            {
                                "target_lang_word": "живительно",
                                "target_lang_sense_clarification": "в контексте отдыха или еды, возвращающих силы"
                            }
                        ]
                    }
                }
            ]
        }
