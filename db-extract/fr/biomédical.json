                "senses": [
                    {
                        "sense_id": "deb32be7-473e-3720-9fa9-a560e000285c",
                        "entry_id": "a23b6d1b-e180-3c09-a3c5-12b134a6b833",
                        "glosses": [
                            "Relatif à la biologie appliquée à la médecine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "883a4d38-a702-4a87-bb68-a3520b94eca4",
                                "sense_id": "deb32be7-473e-3720-9fa9-a560e000285c",
                                "text": "Le 27 juin 2000, au nom de l’Office, l’intimé Samson adresse à Mᵐᵉ Claire V. de la Durantaye, rectrice à l’U.Q.T.R., une lettre (pièce R-1) posant en ces termes la problématique liée aux expertises biomédicales prescrites par des chiropraticiens : […]."
                            },
                            {
                                "example_id": "6aa3f97a-97e8-4576-9846-e733c1589f5d",
                                "sense_id": "deb32be7-473e-3720-9fa9-a560e000285c",
                                "text": "Selon l’égyptologue biomédicale Sofia Aziz, le souverain égyptien aurait perdu la vie dans un accident de char dû à une conduite sous l’emprise de l’alcool."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9bf5b40c-2483-48fc-8fd0-2959c1f51ae4",
                        "source_entry_id": "a23b6d1b-e180-3c09-a3c5-12b134a6b833",
                        "source_sense_id": "deb32be7-473e-3720-9fa9-a560e000285c",
                        "target_lang_word": "biomedical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biomedical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b0d70b1-be86-3c5b-9438-9a024d943340",
                                        "entry_id": "4375c815-170d-3512-9ad2-03838d9dec8b",
                                        "glosses": [
                                            "Of or pertaining to biomedicine."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17d198dc-5bd2-4c8a-a113-7890f3f25f96",
                                                "sense_id": "1b0d70b1-be86-3c5b-9438-9a024d943340",
                                                "text": "The research problem was biomedical in nature but the research approach adopted was multidisciplinary, with biomedical, psychological and anthropological aspects. Despite joint efforts, our biomedical colleagues felt that [...]"
                                            },
                                            {
                                                "example_id": "f10d079c-c80a-494c-bd93-bca4f78f607f",
                                                "sense_id": "1b0d70b1-be86-3c5b-9438-9a024d943340",
                                                "text": "Alzheimer's disease and related dementias have come to be defined as biomedical in nature."
                                            },
                                            {
                                                "example_id": "bf2adddd-8e02-4a3f-8a48-978ff2cb20f8",
                                                "sense_id": "1b0d70b1-be86-3c5b-9438-9a024d943340",
                                                "text": "Clearly, some research undertaken by children's nurses is biomedical in nature although a significant amount of contemporary research is qualitative focusing on children's experiences and evaluating services."
                                            },
                                            {
                                                "example_id": "0d03a75d-3c57-48c6-9157-e1c60dc27d00",
                                                "sense_id": "1b0d70b1-be86-3c5b-9438-9a024d943340",
                                                "text": "Even outside openSNP, the largest use case for DTC genetic data was not biomedical research or research in big pharma."
                                            }
                                        ]
                                    }
                                ]
                            },
