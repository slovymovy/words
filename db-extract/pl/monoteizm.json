                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5d4f7ee-1042-4cd9-855e-acfd690da1c7",
                                "sense_id": "6dc31140-aa93-3963-9eea-e4d40edeee87",
                                "text": "Judaizm, chrześcijaństwo i islam charakteryzuje monoteizm."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "472ffca5-3446-4d89-bdd1-660d865a8b78",
                        "source_entry_id": "c59dea9f-51f1-33dc-bdeb-2db70663bede",
                        "source_sense_id": "6dc31140-aa93-3963-9eea-e4d40edeee87",
                        "target_lang_word": "monotheism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monotheism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f94ebfb-253d-3bca-a22e-71734049dacd",
                                        "entry_id": "3283d559-fbc0-3337-9a71-bd17eee75689",
                                        "glosses": [
                                            "Belief in the One True God, defined by More as personal, immaterial and trinitarian."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f48c77f-956c-34c8-b69c-e61b96839572",
                                        "entry_id": "3283d559-fbc0-3337-9a71-bd17eee75689",
                                        "glosses": [
                                            "The belief in a single deity (one god or goddess); especially within an organized religion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "187ba02e-a239-353e-9afd-221a503e7980",
                                        "entry_id": "3283d559-fbc0-3337-9a71-bd17eee75689",
                                        "glosses": [
                                            "The belief that God is one person (Judaism, Unitarian Christianity, Islam), not three persons (Trinitarian Christianity, Hinduism)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8e5fe5d-4b2e-428b-b943-4b8cf1a78d5d",
                        "source_entry_id": "c59dea9f-51f1-33dc-bdeb-2db70663bede",
                        "source_sense_id": "6dc31140-aa93-3963-9eea-e4d40edeee87",
                        "target_lang_word": "monothéisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monothéisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b5446973-7f1d-3136-9c66-3269efff05b3",
                                        "entry_id": "2132c3cf-61a8-3c97-bc17-43ab677d1e41",
                                        "glosses": [
                                            "Caractère d'une religion qui n’admet l’existence que d’un seul dieu, déité, esprit ou personnage divin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23fe8125-54e6-48b9-946e-7bd2746d8c50",
                                                "sense_id": "b5446973-7f1d-3136-9c66-3269efff05b3",
                                                "text": "L’idée de l’action d’un volonté et d’une intelligence dans la nature n’est en aucune façon le fruit exclusif du monothéisme chrétien."
                                            },
                                            {
                                                "example_id": "29869769-67f9-4951-b92a-b16150f2c4e5",
                                                "sense_id": "b5446973-7f1d-3136-9c66-3269efff05b3",
                                                "text": "Ainsi parlait Hérodote des Sassanides, soulignant la particularité du zoroastrisme, culte officiel de l’État perse de l'époque : son monothéisme. Bien avant l’avènement du christianisme et sans doute du judaïsme, les zoroastriens plaçaient leur foi en une divinité unique et abstraite, Ahura Mazda (…)."
                                            },
                                            {
                                                "example_id": "f2c348bd-50ac-42dd-8783-c2290eec385f",
                                                "sense_id": "b5446973-7f1d-3136-9c66-3269efff05b3",
                                                "text": "Mais le pharaon a tenté sans cesse d'imposer le monothéisme, au lieu d'en profiter au service de son trône."
                                            },
                                            {
                                                "example_id": "2a628d7e-7fca-4404-a42e-6584134b7c86",
                                                "sense_id": "b5446973-7f1d-3136-9c66-3269efff05b3",
                                                "text": "Il tire ainsi l'ultime conséquence du monothéisme juif : si Dieu est l'Unique, il doit être le Dieu de tous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c2c68a9-f8bb-4048-853a-d06f67cbe095",
                        "source_entry_id": "c59dea9f-51f1-33dc-bdeb-2db70663bede",
                        "source_sense_id": "6dc31140-aa93-3963-9eea-e4d40edeee87",
                        "target_lang_word": "monoteísmo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monoteísmo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "1256cdbe-6479-33f8-98ad-51303c759630",
                                        "entry_id": "3e5bd9e8-dd82-3a44-8ca2-21ab9b5fb7e6",
                                        "glosses": [
                                            "Creencia que admite la existencia de una y solo una deidad."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e8baaed-7f91-4deb-850e-c17c7f53d068",
                        "source_entry_id": "c59dea9f-51f1-33dc-bdeb-2db70663bede",
                        "source_sense_id": "6dc31140-aa93-3963-9eea-e4d40edeee87",
                        "target_lang_word": "Monotheismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monotheismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e7b053a2-7f65-31d8-b509-b184179081ed",
                                        "entry_id": "bc331bcc-0428-3b7b-a416-321abb2160d5",
                                        "glosses": [
                                            "Glaube an einen einzigen Gott"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70d18d7d-2482-4225-b20f-8813536f3da4",
                                                "sense_id": "e7b053a2-7f65-31d8-b509-b184179081ed",
                                                "text": "Während das Christentum dem Monotheismus zugewandt ist, glaubt man im Hinduismus an viele (Halb-)Götter sowie einen Gott."
                                            },
                                            {
                                                "example_id": "b1978ba3-f6a6-4c8f-93f2-ac5c80b7e75b",
                                                "sense_id": "e7b053a2-7f65-31d8-b509-b184179081ed",
                                                "text": "„Echnaton und Nofretete huldigten dem Gott Aton und einzig ihm. Damit schufen sie die früheste bekannte Form des Monotheismus, also eine Religion, die nur einen Gott kennt.“"
                                            },
                                            {
                                                "example_id": "532ef674-feaf-4997-abf3-95fcd48d46b6",
                                                "sense_id": "e7b053a2-7f65-31d8-b509-b184179081ed",
                                                "text": "„Denn er sah keinen Widerspruch zwischen diesen beiden Religionen, die sich so ähnlich seien in ihrem klaren Monotheismus, ohne Erweiterung um einen Gottessohn, auch ohne die Macht der Kirche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f72d9749-89f9-4c8b-bdbf-dcf5a8ba20f0",
                        "source_entry_id": "c59dea9f-51f1-33dc-bdeb-2db70663bede",
                        "source_sense_id": "6dc31140-aa93-3963-9eea-e4d40edeee87",
                        "target_lang_word": "монотеизм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "монотеизм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8f611f1d-d585-3170-9d45-62fe6cac519d",
                                        "entry_id": "d76cc907-258a-32e6-a338-ed4ca67b8ba5",
                                        "glosses": [
                                            "религ. вера в одного и единого бога, создавшего мир и управляющего им"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b20d666-6c7e-487f-b679-3f99c6b54351",
                                                "sense_id": "8f611f1d-d585-3170-9d45-62fe6cac519d",
                                                "text": "Переход от политеизма к монотеизму связан с переходом от язычества к христианству (для европейских народов), от коллективного сознания к индивидуальному, от созерцательного к прагматическому."
                                            },
                                            {
                                                "example_id": "8b747078-76e0-4bfd-9659-9388da75571e",
                                                "sense_id": "8f611f1d-d585-3170-9d45-62fe6cac519d",
                                                "text": "Аменхотеп четвертый, представитель восемнадцатой династии. Он взял себе другое имя и ввел в Египте монотеизм, поклонение только одному богу ― Солнцу"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
