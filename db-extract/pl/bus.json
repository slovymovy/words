                                "example_id": "2d9d4740-c34a-425c-abc9-afe0f426060a",
                                "sense_id": "448016f9-a093-363e-b4ea-fe322815b50e",
                                "text": "Przerażona skoczyła tak wysoko, że uderzyła w szybę busa, rozbiła ją i wpadła do kabiny samochodu"
                            }
                        ],
