                    {
                        "translation_id": "6ed698fd-2ffa-4fbe-947b-bb8d6d8e8c91",
                        "source_entry_id": "8f7229c0-f699-347d-86bc-0a08799f69e5",
                        "source_sense_id": "e0d3ee05-7697-3084-b981-39c3d47839a6",
