                    },
                    {
                        "translation_id": "b2c4dc18-94f2-48d7-9994-4f1bf07cc01c",
                        "source_entry_id": "7011fe13-a81e-3350-ae23-d7e19240dd20",
                        "source_sense_id": "b2977d61-356a-3054-a707-faa2eadec2ee",
                        "target_lang_word": "fer à cheval",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fer à cheval",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b4752081-3a0a-3886-a7d6-ef1717697ba1",
                                        "entry_id": "2814e073-7484-3d56-991f-068aa6c87fd2",
                                        "glosses": [
                                            "Semelle de fer, que l’on cloue sous les sabots des chevaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b673c07d-384a-4cef-b060-0cb8b230a60a",
                                                "sense_id": "b4752081-3a0a-3886-a7d6-ef1717697ba1",
                                                "text": "Puis il passa dans le bureau décoré de calendriers, où Deniseau lui-même se tenait devant une table couverte de registres crasseux et de vieux fers à cheval qui servaient de presse-papier."
                                            },
                                            {
                                                "example_id": "7b998b5f-6e9b-4f68-a76f-1e0e12da4a3a",
                                                "sense_id": "b4752081-3a0a-3886-a7d6-ef1717697ba1",
                                                "text": "Il poussa la porte si fort que le fer à cheval suspendu au linteau de chêne tinta faiblement."
                                            },
                                            {
                                                "example_id": "6e752721-b0b7-4f28-964b-cc178ddd9771",
                                                "sense_id": "b4752081-3a0a-3886-a7d6-ef1717697ba1",
                                                "text": "Un fer à cheval porte-bonheur, cloué sur la muraille, indiquait la demeure d’Honoré Demasure, le communiste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "763f4fc4-e394-351e-b27f-51469243dd68",
                                        "entry_id": "2814e073-7484-3d56-991f-068aa6c87fd2",
                                        "glosses": [
                                            "Objet plat de cette forme. (En forme de U.)"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ceeee10-04b4-476b-a635-6c7b035497b1",
                                                "sense_id": "763f4fc4-e394-351e-b27f-51469243dd68",
                                                "text": "Ainsi que tout ce qui était chez M. Ledru, cette table avait son caractère. C’était un grand fer à cheval appuyé aux fenêtres du jardin, laissant les trois quarts de l’immense salle libres pour le service."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1554425-380e-39db-861f-9b033ee5d2d3",
                                        "entry_id": "2814e073-7484-3d56-991f-068aa6c87fd2",
                                        "glosses": [
                                            "Synonyme de rhinolophe (chauve-souris)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43ce5030-a57a-3fea-9aee-6963d3b0de28",
                                        "entry_id": "2814e073-7484-3d56-991f-068aa6c87fd2",
                                        "glosses": [
                                            "Chez le mâle de la perdrix, tache en forme de fer à cheval qui apparaît au bas de la poitrine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "064872bb-8b42-49a2-a4a1-48d8921cbb6b",
                                                "sense_id": "43ce5030-a57a-3fea-9aee-6963d3b0de28",
                                                "text": "[…] des perdrix rouges, des perdreaux gris, qui avaient le fer à cheval comme mon camarade, et des jeunes de cette année qui avaient encore comme moi du duvet sous leurs plumes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "881bba42-41dc-35b1-bd9b-51ba95f01b77",
                                        "entry_id": "2814e073-7484-3d56-991f-068aa6c87fd2",
                                        "glosses": [
                                            "Type de piercing en forme de fer à cheval."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
