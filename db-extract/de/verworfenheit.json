                ],
                "senses": [
                    {
                        "sense_id": "cdeec68c-fffa-3965-a223-82346b0087ca",
                        "entry_id": "ff89154c-c268-332e-8cde-86a173bbbdf5",
                        "glosses": [
                            "Eigenschaft, verkommen/verworfen zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "481be68e-7f9c-4d67-8fe0-9fd6f51bbd00",
                                "sense_id": "cdeec68c-fffa-3965-a223-82346b0087ca",
                                "text": "„Sie bekreuzte sich, sie verneigte sich, und wenn sie den Worten der Liturgie nicht folgen konnte, so bat sie, ganz erschrocken über ihre Verworfenheit, Gott möge ihr alles, alles verzeihen und sich ihrer erbarmen.“"
                            },
                            {
                                "example_id": "36589eb6-d7f8-4e3f-84ec-022297b6a851",
                                "sense_id": "cdeec68c-fffa-3965-a223-82346b0087ca",
                                "text": "„Hilf- und willenlos war das Geschöpf seiner Bestimmung ausgeliefert, der Erwählung oder der Verworfenheit, dem Aufstieg ins ewige Leben am Tag des Jüngsten Gerichts oder dem Absturz in die Hölle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
