                        "source_entry_id": "41b5547a-50fb-3656-a145-17f4067c6bd7",
                        "source_sense_id": "3b05b83d-efdd-3e73-87a5-10c5367362f9",
                        "source_sense_description": "kleines Kissen, das mit Stempelfarbe getränkt ist",
                        "target_lang_word": "stempelkussen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stempelkussen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "bd3780cf-d820-31d1-9555-1bbd2e03cade",
                                        "entry_id": "4f07d48d-3c5c-30ac-a59a-802183b3eca2",
                                        "glosses": [
                                            "kussentje dat dient om iets te voorzien van inkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e35281de-21a7-4558-a79d-12adadf10fc1",
                                                "sense_id": "bd3780cf-d820-31d1-9555-1bbd2e03cade",
                                                "text": "Bij het stembureau krijgt Adwok voorrang; hij is minister. Een functionaris roept zijn naam af. Adwok drukt zijn wijsvinger op een stempelkussen en verdwijnt in het lage stemhokje."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7069697d-2d90-32f3-a39e-f9f1fadf244e",
                                        "entry_id": "4f07d48d-3c5c-30ac-a59a-802183b3eca2",
                                        "glosses": [
                                            "een parlement dat alleen maar beslissingen van de regering mag goedkeuren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cb33611-b40c-45e8-b417-ab22d8445638",
                                                "sense_id": "7069697d-2d90-32f3-a39e-f9f1fadf244e",
                                                "text": "De Senaat zei daarop: sorry, maar we zijn geen stempelkussen. Waarop de minister doodleuk namens Nederland instemde. Daarmee de goedkeuringswetten van de Verdragen van Maastricht, Amsterdam en Nice overtredend."
                                            },
                                            {
                                                "example_id": "741213ac-d5ab-421c-8248-88cbc7d983e2",
                                                "sense_id": "7069697d-2d90-32f3-a39e-f9f1fadf244e",
                                                "text": "Het rommelt al enige tijd in Koeweit. Oppositiegroeperingen van onder andere islamieten en liberalen zijn boos over de wijziging van de kieswet eerder dit jaar, die volgens hen het parlement tot een stempelkussen maakt. Sindsdien zijn er vrijwel elke nacht protesten, waarbij oproerpolitie geregeld traangas gebruikt om de demonstranten uiteen te drijven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
