                "senses": [
                    {
                        "sense_id": "39892c36-c88f-3323-92ff-3dcc8121029f",
                        "entry_id": "5afaeb6a-119f-308a-909a-b636bb905685",
                        "glosses": [
                            "mit getrockneten Blättern des Teestrauches gefüllter Beutel aus Filterpapier, der mit heißem Wasser übergossen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72cb0fb4-96aa-47f9-ad40-7e94de9bd4b6",
                                "sense_id": "39892c36-c88f-3323-92ff-3dcc8121029f",
                                "text": "Ich trinke keinen Tee, der mit Teebeuteln zubereitet worden ist."
                            },
                            {
                                "example_id": "4ebf4507-6e6f-40af-bff9-4fa8e6844d46",
                                "sense_id": "39892c36-c88f-3323-92ff-3dcc8121029f",
                                "text": "„Wem die beschriebene Zubereitung zu aufwendig ist, dem seien die in kleinen Leinensäckchen (!) angebotenen Teebeutel aus dem Hause KUSMI zu empfehlen, die wahrlich köstliche Tees bescheren und nicht ausschließlich zum ostfriesischen Teebeutelweitwurf geeignet sind.“"
                            },
                            {
                                "example_id": "c47217c5-ada7-4870-9fde-d6a072b1b1d4",
                                "sense_id": "39892c36-c88f-3323-92ff-3dcc8121029f",
                                "text": "„Er fischte den Teebeutel aus der Tasse und legte ihn auf den Untersetzer, bevor er fortfuhr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d3d73d4d-71e5-33a0-8d5e-5180864bce5a",
                        "entry_id": "5afaeb6a-119f-308a-909a-b636bb905685",
                        "glosses": [
                            "Säckchen zur Aufnahme von Tees"
                        ],
                        "tags": [
                            "Golf"
                        ],
                        "examples": [
                            {
                                "example_id": "c29eb7ba-fc73-43aa-83e6-a1ece722912e",
                                "sense_id": "d3d73d4d-71e5-33a0-8d5e-5180864bce5a",
                                "text": "Vor dem Turnier sollte man auch überprüfen, ob genug Tees im Teebeutel sind."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4d93669-71d4-4478-a1e2-8ba9ebf2bd0c",
