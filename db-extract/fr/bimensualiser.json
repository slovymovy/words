                "senses": [
                    {
                        "sense_id": "af8f367a-3875-3696-b80e-e09725cae650",
                        "entry_id": "ae5061d3-0ab2-314b-abe8-ab87e7bf6a08",
                        "glosses": [
                            "Donner un caractère bimensuel (au sens de deux fois par mois) à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ad00ab8-d71b-4ffd-bcfe-b36234367044",
                                "sense_id": "af8f367a-3875-3696-b80e-e09725cae650",
                                "text": "Il faut bimensualiser les manifestations de la manifpourtous jusqu'à ce que ce gouvernement autoritaire, totalitaire, dictatorial et autiste s'en aille définitivement."
                            }
                        ]
                    },
                    {
                        "sense_id": "57216881-9c24-3139-a179-1c7c70b7b307",
                        "entry_id": "ae5061d3-0ab2-314b-abe8-ab87e7bf6a08",
                        "glosses": [
                            "Donner un caractère bimensuel (au sens de tous les deux mois), bimestriel, à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f18b0e0d-eb3b-4e54-b5f2-1623d4888bb5",
                                "sense_id": "57216881-9c24-3139-a179-1c7c70b7b307",
                                "text": "Nous avons instruit le directeur général, Alassane Diallo, ici présent, je lui ai même adressé une note dans ce sens pour qu'il me présente d'ici le 1ᵉʳ novembre au plus tard, une proposition de réforme pour qu'on puisse instaurer un minimum-vieillesse et qu'on puisse bimensualiser les pensions, qu'on les paie tous les deux mois au lieu de trois."
                            },
                            {
                                "example_id": "2be322ed-8081-446f-a99c-1bc09e95c8f8",
                                "sense_id": "57216881-9c24-3139-a179-1c7c70b7b307",
                                "text": "SFR a enfin écouté ses client et ils ont décidés de nous mensualiser au lieu de nous bimensualiser!"
                            }
                        ]
                    }
                ],
