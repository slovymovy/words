                                "target_senses": [
                                    {
                                        "sense_id": "922dd04e-9fe3-3683-b78b-7f137e2bf99d",
                                        "entry_id": "251f89ef-3c87-3d28-8acf-449973302bc3",
                                        "glosses": [
                                            "Bösewicht in Märchen, menschenfressendes Ungeheuer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a07357c-0c9a-4a99-af10-1aa397a9d417",
                                                "sense_id": "922dd04e-9fe3-3683-b78b-7f137e2bf99d",
                                                "text": "Die Oger führen im Kampf meist Waffen und ernähren sich allzugern vom Fleisch der Menschen."
                                            },
                                            {
                                                "example_id": "a1fb67e8-2c12-4fb3-9639-f3dcc902858a",
                                                "sense_id": "922dd04e-9fe3-3683-b78b-7f137e2bf99d",
                                                "text": "In dem Märchen vom Kleinen Däumling kommt ein Oger vor."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d54d207e-d02e-3a65-b38a-632a49519856",
                                        "entry_id": "251f89ef-3c87-3d28-8acf-449973302bc3",
                                        "glosses": [
                                            "menschenähnliches, jedoch abscheulich aussehende Kreatur, die von immenser Kraft und Körpergröße zeugt und meist mit Keulen oder Ähnlichem kämpft"
                                        ],
