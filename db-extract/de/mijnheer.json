                        "source_sense_id": "108c0e48-6210-391d-b7cb-157effdd508f",
                        "source_sense_description": "ohne Artikel: in niederländischsprachigen Regionen gebräuchliche Anrede für einen Herren",
                        "target_lang_word": "mijnheer",
