                        "form_id": "c132bcf4-7913-4fce-82ae-e76e9df0004a",
                        "entry_id": "55f19efb-2682-3d77-abbd-df3cf50e0639",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more disorderly"
                    },
                    {
                        "form_id": "85649a78-eedb-4546-ba41-876a9300ebec",
                        "entry_id": "55f19efb-2682-3d77-abbd-df3cf50e0639",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most disorderly"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bbdbb6cc-b0aa-3dbe-94ea-40b5747bb52e",
                        "entry_id": "55f19efb-2682-3d77-abbd-df3cf50e0639",
                        "glosses": [
                            "Not in order; marked by disorder or disarray."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96760ebc-e047-4f01-a02d-96203709849b",
                                "sense_id": "bbdbb6cc-b0aa-3dbe-94ea-40b5747bb52e",
                                "text": "The books and papers are in a disorderly state."
                            },
                            {
                                "example_id": "a008a4ed-0144-4222-96fc-2e9ef6367374",
                                "sense_id": "bbdbb6cc-b0aa-3dbe-94ea-40b5747bb52e",
                                "text": "This one is surmounted by a clock-tower with a bent weather-vane - the latter being the only disorderly object in sight."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c3c06ea-e469-37c7-b3c1-a2432cac9d1a",
                        "entry_id": "55f19efb-2682-3d77-abbd-df3cf50e0639",
                        "glosses": [
                            "Not acting in an orderly way, as the functions of the body or mind."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "41ed1fda-2870-33cf-9915-bae2664fe269",
                        "entry_id": "55f19efb-2682-3d77-abbd-df3cf50e0639",
                        "glosses": [
                            "Not complying with the restraints of order and law; unruly; lawless."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d56320a0-ce71-43ea-a222-3e3810775f6c",
                                "sense_id": "41ed1fda-2870-33cf-9915-bae2664fe269",
                                "text": "disorderly people; disorderly assemblies"
                            },
                            {
                                "example_id": "a2e57888-6e37-4fa3-abda-209d5b70e348",
                                "sense_id": "41ed1fda-2870-33cf-9915-bae2664fe269",
                                "text": "The teacher sat at one end of the bench, with a meek little fellow by his side. When the others were disorderly, this young martyr received a rap; intended, probably, as a sample of what the rest might expect, if they didn't amend."
                            },
                            {
                                "example_id": "a4486a46-1319-4ee6-831a-ab804246f81e",
                                "sense_id": "41ed1fda-2870-33cf-9915-bae2664fe269",
                                "text": "The Uganda Police Force described the planned protests as “potentially anarchic” in a statement on Monday, warning it “shall not tolerate disorderly conduct.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "539c14b3-e2f8-363a-ba4b-1a7b1d82937c",
                        "entry_id": "55f19efb-2682-3d77-abbd-df3cf50e0639",
                        "glosses": [
                            "Offensive to good morals and public decency."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b25779a2-7e02-4f71-baf7-28d23268d54e",
                                "sense_id": "539c14b3-e2f8-363a-ba4b-1a7b1d82937c",
                                "text": "a disorderly house"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95baeb15-2643-441b-91ad-b1dbc3b489ea",
                        "source_entry_id": "55f19efb-2682-3d77-abbd-df3cf50e0639",
                        "source_sense_description": "not in order",
                        "target_lang_word": "désordonné",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désordonné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d65ecc9e-b86d-3222-97f2-09ed3520a895",
                                        "entry_id": "aaa5e549-5255-3afe-9ef4-2143fd21fdd8",
                                        "glosses": [
                                            "Où il n’y a pas d’ordre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d896e4de-f4c6-43d4-9607-9196a6595c00",
                                                "sense_id": "d65ecc9e-b86d-3222-97f2-09ed3520a895",
                                                "text": "Je vais essayer d'écrire, en me cramponnant à mon bureau, mais je crains que les mouvements désordonnés du bateau ne le permettent pas."
                                            },
                                            {
                                                "example_id": "d3629159-5a51-4145-8a85-4b8635979ef2",
                                                "sense_id": "d65ecc9e-b86d-3222-97f2-09ed3520a895",
                                                "text": "De sa grande cuisine désordonnée, tandis qu’elle préparait un cottage pie ou une salade de poires au Stilton, Arabella chantait divinement faux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00c25121-e99a-3936-adff-e325ba01ff13",
                                        "entry_id": "aaa5e549-5255-3afe-9ef4-2143fd21fdd8",
                                        "glosses": [
                                            "Qui manque d’ordre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4845a375-87b0-480f-b2ef-3d780e813c05",
                                                "sense_id": "00c25121-e99a-3936-adff-e325ba01ff13",
                                                "text": "[…], nous menions une vie désordonnée, parce que nous étions toujours sur le qui-vive, prêts à prendre notre essor le lendemain matin."
                                            },
                                            {
                                                "example_id": "5420cdbf-27f2-42e6-a92a-11bb609a222f",
                                                "sense_id": "00c25121-e99a-3936-adff-e325ba01ff13",
                                                "text": "Que cet enfant est désordonné!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05bdc501-a472-3025-b7df-196fb3d7d050",
                                        "entry_id": "aaa5e549-5255-3afe-9ef4-2143fd21fdd8",
                                        "glosses": [
                                            "Qui n’est pas conforme à la règle, à l’ordre moral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab3f1e38-38b5-4040-a6c2-949016f01723",
                                                "sense_id": "05bdc501-a472-3025-b7df-196fb3d7d050",
                                                "text": "Vie, conduite désordonnée."
                                            },
                                            {
                                                "example_id": "6d6fb584-e8af-4e25-b3b7-19e97186ca39",
                                                "sense_id": "05bdc501-a472-3025-b7df-196fb3d7d050",
                                                "text": "— Femme désordonnée."
                                            },
                                            {
                                                "example_id": "6c4fdd36-d8c0-42d9-923f-32b2fb0ba470",
                                                "sense_id": "05bdc501-a472-3025-b7df-196fb3d7d050",
                                                "text": "— Une faim désordonnée. - Une passion désordonnée pour la chasse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "désordonné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8aad4465-a04a-3c23-a8e9-2b09a76cc4b3",
                                        "entry_id": "9ac90f93-2a1d-3e83-87fe-5aad4d7ccb95",
                                        "glosses": [
                                            "Personne qui n’est pas ordonnée, pas organisée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14de8c55-46fc-41de-bf62-3d1a0e2fede3",
                                                "sense_id": "8aad4465-a04a-3c23-a8e9-2b09a76cc4b3",
                                                "text": "Surtout qu’un désordonné respecte rarement les affaires des autres, les empruntant sans façon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa7dc68e-e737-3089-a64d-38cd6ebfd611",
                                        "entry_id": "9ac90f93-2a1d-3e83-87fe-5aad4d7ccb95",
                                        "glosses": [
                                            "Personne qui manque d’ordre mental, spirituel."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6fe3046-de0b-489c-be58-0bb3e0983d2e",
                                                "sense_id": "aa7dc68e-e737-3089-a64d-38cd6ebfd611",
                                                "text": "Ce modéré, ce libéral, ce faiseur de chartes, ce méthodique, est un désordonné du sentiment, un chercheur d'émotions réelles ou fictives, un amateur de risques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "désordonné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f0c7612f-5268-3d0c-bf6a-93a46df6b7b9",
                                        "entry_id": "e79339c0-9c0a-3cd7-8a34-0fa4067e664a",
                                        "glosses": [
                                            "Participe passé masculin singulier de désordonner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
