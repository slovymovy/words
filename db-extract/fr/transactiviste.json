                                        "entry_id": "368eb9c6-8bef-3a98-9ab2-0a338dfdf9c2",
                                        "glosses": [
                                            "An activist for transgender issues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ba52d58-dee9-4111-9091-47a40a11b819",
                                                "sense_id": "5aa9cd38-45dd-3298-a812-7720ebf22e5c",
                                                "text": "The transactivists who are trying to eliminate Gender Identity Disorder from the DSM-IV have not come up with any credible replacement for the diagnosis, which is the prerequisite for sex reassignment."
                                            },
                                            {
                                                "example_id": "62ae5c77-950b-4d4e-afe4-365aa83cd89c",
                                                "sense_id": "5aa9cd38-45dd-3298-a812-7720ebf22e5c",
