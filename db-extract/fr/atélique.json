                        "sense_id": "e8494bd2-d04b-3234-93b2-f535c5db7b07",
                        "entry_id": "f1c4af61-9775-3a99-ab33-d814e3e8cb98",
                        "glosses": [
                            "Présente un évènement ou un procès sans mentionner sa fin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6cd4e51-ab58-48a8-b9a1-ebaed097c792",
                                "sense_id": "e8494bd2-d04b-3234-93b2-f535c5db7b07",
                                "text": "L’opération de réduplication consiste à fabriquer de l’atélique (procès étendu dans le temps) à partir du télique (évènement ponctuel)."
                            },
                            {
                                "example_id": "8f4eec86-056c-49b4-8826-7e325ef2c726",
                                "sense_id": "e8494bd2-d04b-3234-93b2-f535c5db7b07",
                                "text": "Un procès atélique (non délimité) peut être homogène (sans structure interne) ou itératif (avec structure interne) et un procès télique (délimité) peut également être individualisé (closed) ou itératif."
                            }
                        ]
                    }
                ],
