                        ],
                        "form": "den Trainingsbereich"
                    },
                    {
                        "form_id": "d439e5a9-4c57-4ff8-8cea-bdcbb31332fc",
                        "entry_id": "92988251-d410-33b3-8112-50f3c62ec6d6",
                        "tags": [
                            "accusative",
