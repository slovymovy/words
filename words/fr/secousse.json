                    "frequency": "VeryLow",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous marchions sous la pluie depuis une bonne <w>secousse</w> quand le refuge est apparu."
