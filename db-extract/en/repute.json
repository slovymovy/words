                        "translation_id": "5f9e8138-6f6a-4706-bae5-e95336839f6c",
                        "source_entry_id": "f252bddf-de4f-3523-9d45-281701874003",
                        "source_sense_id": "f8d60688-08a1-3cff-a5fe-903594f35437",
