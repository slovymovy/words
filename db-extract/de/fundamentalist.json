                "senses": [
                    {
                        "sense_id": "73134b5a-c4a1-333f-898a-06b4a3376861",
                        "entry_id": "7d40ab9c-47d2-3c56-ac3a-2972cec249b6",
                        "glosses": [
                            "Person, die vergleichsweise kompromisslos eine wenig pragmatische Haltung vertritt, die auf nicht hinterfragbaren Grundwahrheiten beruht"
                        ],
                        "tags": [
                            "in geistigen oder sozialen",
                            "insbesondere politischen oder religiösen Strömungen"
                        ],
                        "examples": [
                            {
                                "example_id": "dd9c918e-ec44-47a5-b339-4d709267280d",
                                "sense_id": "73134b5a-c4a1-333f-898a-06b4a3376861",
                                "text": "„In den Vereinigten Staaten, die schon immer für extremistische und apokalyptische Schwärmerei empfänglich waren, taten sich die christlichen Fundamentalisten in der NewRightBewegung zusammen.“"
                            },
                            {
                                "example_id": "6dcb80bb-17f2-4088-9f82-2a2cb9f3c7f9",
                                "sense_id": "73134b5a-c4a1-333f-898a-06b4a3376861",
                                "text": "„Islamische Fundamentalisten haben im Norden Malis ein zum Unesco-Weltkulturerbe zählendes Bauwerk zerstört.“"
                            },
                            {
                                "example_id": "f0479101-08d0-47b8-b918-7ef26db829d2",
                                "sense_id": "73134b5a-c4a1-333f-898a-06b4a3376861",
                                "text": "„Im Hinblick auf die wachsende Stimmung von Angst und Misstrauen, in der die Begriffe ‚Fundamentalist‘ und ‚Terrorist‘ so gut wie austauschbar wurden, erklärte Präsident George W. Bush einen ‚Krieg gegen den Terror‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
