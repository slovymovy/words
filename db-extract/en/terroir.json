                        "entry_id": "b0e0311f-2b82-340e-9c71-087c5d07955f",
                        "glosses": [
                            "The complete set of local conditions in which a particular wine or family of wines is produced, including soil type, weather conditions, topography, and wine-making savoir-faire."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "78cc7a4c-d95e-4aa2-8d91-d5e3316173b1",
                                "sense_id": "6d8f1edc-44ed-38f0-901e-3ee7f45353d2",
                                "text": "The concept of terroir summarises in a synthetic, effective way the genetic-environmental and human conditions that constitute the foundation for the production of a wine that can convey the above characteristics of naturalness and genuineness (Fig 1.1)."
                            },
                            {
                                "example_id": "aa846afe-91c4-4361-a5dd-e4c659bce4d0",
                                "sense_id": "6d8f1edc-44ed-38f0-901e-3ee7f45353d2",
                                "text": "“It's got an ass-load of terroir.” “The fuck do you know, terroir?” “What do you mean?”"
                            }
                        ]
                    }
