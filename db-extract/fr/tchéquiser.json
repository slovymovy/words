                "senses": [
                    {
                        "sense_id": "bf11d24e-58ed-3e85-9607-ecdf6be96f0d",
                        "entry_id": "b12532ca-2e90-336f-b346-d6b6657a8a3a",
                        "glosses": [
                            "Rendre (plus) tchèque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e15dfd6-2767-4120-8c45-85c03521ddfc",
                                "sense_id": "bf11d24e-58ed-3e85-9607-ecdf6be96f0d",
                                "text": "Il est à regretter que, souvent, bien des nouveaux restaurants présentant les cuisines exotiques n’en aient pas compris le sens, préférant les « tchéquiser »."
                            },
                            {
                                "example_id": "fb75269f-131b-4aab-939a-2a9d54e5ffc4",
                                "sense_id": "bf11d24e-58ed-3e85-9607-ecdf6be96f0d",
                                "text": "La lutte fait rage entre les nationalismes allemand et tchèque, les Juifs – majoritairement de culture allemande – cherchant aussi à se « tchéquiser »."
                            }
                        ]
                    }
