                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "aa055fca-8c96-461c-8881-258a7a97fbda",
                                "sense_id": "402e7ab3-1760-31a6-a0a5-28009d4cb61d",
                                "text": "Te veel blootstelling aan ozon kan schadelijk zijn voor de longen.",
                                "translation": "Too much exposure to ozone can be harmful to the lungs.",
                                "english": "Too much exposure to ozone can be harmful to the lungs."
                            },
                            {
                                "example_id": "64e56435-d64a-4c88-ad69-ec94fcd54b78",
                                "sense_id": "402e7ab3-1760-31a6-a0a5-28009d4cb61d",
                                "text": "Ozon wordt vaak gebruikt om water te zuiveren.",
                                "translation": "Ozone is often used to purify water.",
                                "english": "Ozone is often used to purify water."
                            },
                            {
                                "example_id": "7f485884-005f-4546-a0d5-0f79aa8c54d8",
                                "sense_id": "402e7ab3-1760-31a6-a0a5-28009d4cb61d",
                                "text": "De geur van ozon vulde de lucht na de bliksem.",
                                "translation": "The smell of ozone filled the air after the lightning.",
                                "english": "The smell of ozone filled the air after the lightning."
                            }
                        ]
                    }
                ],
