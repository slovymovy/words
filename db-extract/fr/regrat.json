                ],
                "senses": [
                    {
                        "sense_id": "232baaae-73b0-3e0c-bdcc-32ecc37541fe",
                        "entry_id": "8be63d73-faf9-3750-b0f6-295fd0c89d75",
                        "glosses": [
                            "Petit commerce consistant à vendre en détail et de seconde main certaines denrées, particulièrement du sel, des grains, du charbon, etc."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e1f9c1b4-e274-45a1-9246-b3d5e4a1613e",
                                "sense_id": "232baaae-73b0-3e0c-bdcc-32ecc37541fe",
                                "text": "Les bestiaux achetés pour l'approvisionnement de Paris ne devaient pas être revendus, et le « regrat » était formellement interdit et sanctionné."
                            },
                            {
                                "example_id": "a34f767f-f799-4fbd-825b-c7c760158112",
                                "sense_id": "232baaae-73b0-3e0c-bdcc-32ecc37541fe",
                                "text": "Comme les greniers à sel ne distribuaient pas moins d'un quart de minot, il existait des boutiques, appelées « regrats », où le sel se vendait au détail."
                            },
                            {
                                "example_id": "77bd16d8-2eb3-4c70-9730-020ccac24651",
                                "sense_id": "232baaae-73b0-3e0c-bdcc-32ecc37541fe",
                                "text": "Ainsi, le regrat, plat vendu dans la rue, est-il composé de restes de nourritures de gens aisés. Le regrattier, chargé de les vendre, y ajoute souvent des denrées avariées."
                            }
                        ]
                    }
                ],
