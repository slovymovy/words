                "senses": [
                    {
                        "sense_id": "b6522681-bb2f-3447-81f6-b082b9772b0b",
                        "entry_id": "709281b9-61d7-3ba4-a725-5084f4443d13",
                        "glosses": [
                            "Qui relève de l’agitation."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "9890105e-cac6-41f6-99be-f6a9217493ec",
                                "sense_id": "b6522681-bb2f-3447-81f6-b082b9772b0b",
                                "text": "Et pour commencer par quelque bout, je diz que la premiere espece est appelée par les Latins mouvement agitatif, ou bien debattement, qui se fait lors que la terre est esmeüe & esbranlée d’un costé & d’autre."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3f76df9-bc2b-3f47-b8c1-d17ff6a2e0e7",
                        "entry_id": "709281b9-61d7-3ba4-a725-5084f4443d13",
                        "glosses": [
                            "Qui crée de l’agitation."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "52d362a7-f70a-43ce-b215-6539167d871e",
                                "sense_id": "c3f76df9-bc2b-3f47-b8c1-d17ff6a2e0e7",
                                "text": "Ce sectarisme est très prononcé chez Ahmadou Bamba. Il a même, parfois, un caractère « agitatif », surtout lorsqu’il jette l’anathème sur tous ceux qui ne sont pas dans le giron de l’Islam."
                            },
                            {
                                "example_id": "97c58232-3c0c-443e-a56e-4cb49c38fe82",
                                "sense_id": "c3f76df9-bc2b-3f47-b8c1-d17ff6a2e0e7",
                                "text": "Le CIS, organe idéologique et agitatif, correspond à une époque où dominait la sensibilité militante."
                            },
                            {
                                "example_id": "0d4407e7-8220-41c9-b88c-75aef0ea6ade",
                                "sense_id": "c3f76df9-bc2b-3f47-b8c1-d17ff6a2e0e7",
                                "text": "Les composantes africaines sont prédominantes alors que l’occidentalisation est visible dans le style agitatif des années 1930, avec des poètes tels que Sterling Brown et Robert Hayden."
                            }
                        ]
                    }
