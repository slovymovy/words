                        "sense_id": "46e78eb4-ba44-3b97-9c76-3eeec9cece1e",
                        "entry_id": "b165418d-48fc-323a-ab89-908a4f6c3e1c",
                        "glosses": [
                            "Imprimeur ou technicien spécialisé dans l’impression offset."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "examples": [
                            {
                                "example_id": "c9ba4527-bbf5-40be-8634-b58b5fefc1b9",
                                "sense_id": "46e78eb4-ba44-3b97-9c76-3eeec9cece1e",
                                "text": "Cette machine intéresse tous les industriels qui ont besoin de répéter de petits clichés: Photograveurs, Héliograveurs, Offsettistes, Imprimeurs sur métaux, Fabricants de plaques gravées, Imprimeurs d’actions et papiers valeurs, etc."
                            },
                            {
                                "example_id": "a1d2ff7f-0c87-4be9-8544-740064205ae0",
                                "sense_id": "46e78eb4-ba44-3b97-9c76-3eeec9cece1e",
                                "text": "Diplômé des hautes études commerciales, il était le père d’Amenta ; offsettiste amateur, il avait déjà réalisé de petits fascicules qui présentaient agréablement l’Ordre."
                            },
                            {
                                "example_id": "df71b561-11cd-4e69-912d-fe7eacef842a",
                                "sense_id": "46e78eb4-ba44-3b97-9c76-3eeec9cece1e",
                                "text": "Un imprimeur numérique rachète un offsettiste"
                            },
                            {
                                "example_id": "dd41b114-0795-432d-bed1-7aa9dc9f7404",
                                "sense_id": "46e78eb4-ba44-3b97-9c76-3eeec9cece1e",
                                "text": "Offsettiste de métier, elle a rejoint la fonction publique par concours en 2004 et a atteint le statut d’attachée en 2006."
                            }
                        ]
                    }
