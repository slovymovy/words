                    {
                        "translation_id": "9776eff7-aa74-4e00-9818-cd35e04eab4d",
                        "source_entry_id": "db540d32-2d41-35b7-825d-9a14cbf62aa4",
                        "source_sense_description": "to restore somebody to his or her own country",
                        "target_lang_word": "rapatrier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rapatrier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0312d3d-73ac-3f69-a306-907622fc81a2",
                                        "entry_id": "ed7c58d7-44c5-39be-8e36-02d17c413685",
                                        "glosses": [
                                            "Retourner ou ramener dans son pays d’origine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "451fecfc-2078-4dff-9290-de11fc7b8585",
                                                "sense_id": "a0312d3d-73ac-3f69-a306-907622fc81a2",
                                                "text": "Atteint d'une tumeur arthritique à la jambe droite, il dut se rapatrier au plus vite en vue d'être soigné comme il fallait"
                                            },
                                            {
                                                "example_id": "4970eda7-700f-4666-bed4-0f9c75fa3fbc",
                                                "sense_id": "a0312d3d-73ac-3f69-a306-907622fc81a2",
                                                "text": "Mais si alors le lieutenant pouvait rapatrier la petite colonie en la guidant à travers le champ de glace jusqu'au continent, ce serait un heureux dénouement de la situation, […]."
                                            },
                                            {
                                                "example_id": "7b6a411f-6f4d-4ea4-8a30-dc721d3d0641",
                                                "sense_id": "a0312d3d-73ac-3f69-a306-907622fc81a2",
                                                "text": "Je leur offris de les rapatrier, mais ils refusèrent, préférant accomplir leur devoir jusqu'au bout et parachever leur œuvre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf070cee-2163-3de9-a222-c5cec9450e7d",
                                        "entry_id": "ed7c58d7-44c5-39be-8e36-02d17c413685",
                                        "glosses": [
                                            "Retourner ; ramener au bercail."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0c4e34f-a010-48cd-8ec3-e67a41b0393e",
                                                "sense_id": "bf070cee-2163-3de9-a222-c5cec9450e7d",
                                                "text": "Aux alentours et dans les lointains invisibles, les tintements joyeux des clochettes argentines et les bourdons graves des sonneaux indiquaient à Mimile que les autres petits bergers, ainsi que les bergères de son âge rapatriaient comme lui vers l’abreuvoir et vers l’étable leurs troupeaux repus."
                                            },
                                            {
                                                "example_id": "dfe29dde-b8c1-405a-aa6f-dda2f24afa57",
                                                "sense_id": "bf070cee-2163-3de9-a222-c5cec9450e7d",
                                                "text": "La veille de mon départ Momo me propose de prendre sa deudeuche pour le retour, moi je prendrai la bétaillère pour rapatrier quelques chevaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3edb7d1-1a2b-385d-a525-a364235326a2",
                                        "entry_id": "ed7c58d7-44c5-39be-8e36-02d17c413685",
                                        "glosses": [
                                            "Réconcilier ou raccommoder des personnes qui étaient brouillées."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42debb19-c3af-42e5-9371-ba72f68ef123",
                                                "sense_id": "d3edb7d1-1a2b-385d-a525-a364235326a2",
                                                "text": "Il y avait longtemps qu’ils étaient brouillés, on les a rapatriés."
                                            },
                                            {
                                                "example_id": "8134a36e-db36-48d1-b758-92c3a7569f04",
                                                "sense_id": "d3edb7d1-1a2b-385d-a525-a364235326a2",
                                                "text": "Ils se sont rapatriés de bonne foi. Ne voulez-vous pas vous rapatrier avec lui ?"
                                            },
                                            {
                                                "example_id": "b19ec696-f2f9-4f6e-8b46-ed32b98ed11e",
                                                "sense_id": "d3edb7d1-1a2b-385d-a525-a364235326a2",
                                                "text": "Geoges objecta qu'aucune religion n'avait de lien aussi particulier avec une autre que le christianisme avec le judaïsme. Il était donc naturel de vouloir les rapatrier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
