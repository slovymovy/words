                "senses": [
                    {
                        "sense_id": "8790fa12-a4b3-3eec-bbc0-25a14cdb7a38",
                        "entry_id": "d473bece-ba82-31fd-bf9a-09736d5428bc",
                        "glosses": [
                            "vor allem im Kindesalter auftretende Störung der Aussprache, die durch Stammeln/Stottern gekennzeichnet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b207c295-fe59-45b7-8dfe-c08382b12838",
                                "sense_id": "8790fa12-a4b3-3eec-bbc0-25a14cdb7a38",
                                "text": "„Bei der Dyslalie (Stammeln) liegt eine entwicklungsbedingte Lautbildungsstörung vor, die häufig auf motorische oder phonematische Schwächen zurückzuführen ist.“"
                            },
                            {
                                "example_id": "1140d85d-990c-474b-a861-57fda5afe5ac",
                                "sense_id": "8790fa12-a4b3-3eec-bbc0-25a14cdb7a38",
                                "text": "„Die vorliegende Arbeit stellt das Ergebnis eines etwa drei Jahre dauernden Projektes über funktionelle Dyslalien dar, das wir im Sprachheilzentrum der Arbeiterwohlfahrt in Wilhelmshaven durchgeführt haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
