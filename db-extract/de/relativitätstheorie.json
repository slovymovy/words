                            "plural"
                        ],
                        "form": "die Relativitätstheorien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3c25f59b-3b9b-31a9-b788-a5cfdd011a82",
                        "entry_id": "d20b2c27-34d5-3286-891d-07e12d9a2e0d",
                        "glosses": [
                            "von Albert Einstein aufgestellte physikalische Theorie"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "042ce4a4-cee1-4757-97a9-f1f8054ab59d",
                                "sense_id": "3c25f59b-3b9b-31a9-b788-a5cfdd011a82",
                                "text": "Die Relativitätstheorie entstand Anfang des 20. Jahrhunderts."
                            },
                            {
                                "example_id": "14767182-5465-4cee-87ac-b4113de5265a",
                                "sense_id": "3c25f59b-3b9b-31a9-b788-a5cfdd011a82",
                                "text": "„Topp nähert sich vorsichtig solch epochemachenden Arbeiten wie der Einsteinschen Relativitätstheorie oder Heisenbergs Unschärferelation, die beide dabei behilflich waren, die Gewißheit hierarchischer Ordnung, auf der das 19. Jahrhundert basierte, umzustürzen, und nach der das 20. Jahrhundert viel zu oft gehandelt hat.“"
                            },
                            {
                                "example_id": "66253ecf-d758-4626-bf19-2ac6460a4c84",
                                "sense_id": "3c25f59b-3b9b-31a9-b788-a5cfdd011a82",
                                "text": "„Um fünf Uhr nachmittags, als das Kolleg über die Relativitätstheorie eröffnet werden sollte, lasen alle die Absage.“"
                            },
                            {
                                "example_id": "3b1d06ca-3bd7-4989-927d-a9a953d7d72b",
                                "sense_id": "3c25f59b-3b9b-31a9-b788-a5cfdd011a82",
                                "text": "„Einstein war fast noch ein Twen, als er mit seiner Relativitätstheorie die Physik aus den Angeln hob.“"
                            },
                            {
                                "example_id": "07a1eeb1-1ded-4d82-b112-972f8637b202",
                                "sense_id": "3c25f59b-3b9b-31a9-b788-a5cfdd011a82",
                                "text": "„\"Früher hat man geglaubt, wenn alle Dinge aus der Welt verschwinden, so bleiben noch Raum und Zeit übrig. Nach der Relativitätstheorie verschwinden aber Raum und Zeit mit den Dingen.\"“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
