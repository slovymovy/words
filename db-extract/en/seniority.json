                        "entry_id": "986f6c1b-99eb-387b-bc80-84b1b7e21272",
                        "glosses": [
                            "A measure of the amount of time a person has been a member of an organization, as compared to other members, and with an eye towards awarding privileges to those who have been members longer."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4085ee1d-c2a4-4a99-a433-f110fdd5b773",
                                "sense_id": "3a037a10-d991-3ff1-a19b-e659bf8411d6",
                                "text": "It's an old-fashioned company, with parking spaces and other perks doled out on the basis of seniority."
                            }
                        ]
                    }
                ],
