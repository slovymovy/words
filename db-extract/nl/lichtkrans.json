                        "examples": [
                            {
                                "example_id": "8e489ae4-ca22-4c59-ae90-83f18dd5e950",
                                "sense_id": "b86f8f80-ce05-368b-9a61-fc195774e34b",
                                "text": "Terwijl hij luisterde naar het gefluister en voelde hoe het gebouw van naalden zich rekte en omhoogging, zag vorst Andrej bij vlagen de rode lichtkrans van de kaars en hoorde hij het geritsel van de kakkerlakken en het gezoem van de vliegen die tegen zijn hoofdkussen en zijn gezicht aan vlogen."
                            },
                            {
                                "example_id": "b398f3de-9b95-48e8-bf86-24c9a90f519c",
                                "sense_id": "b86f8f80-ce05-368b-9a61-fc195774e34b",
                                "text": "Vanaf de Faeröer eilanden is morgen de ´corona´ te zien; de lichtkrans die ontstaat doordat de zon en maan precies op één lijn staan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ee89533-799b-4433-8032-00b7e417486a",
                        "source_entry_id": "4d5bf018-9a9a-3a6a-8b99-46e9d7ffed00",
                        "source_sense_id": "b86f8f80-ce05-368b-9a61-fc195774e34b",
                        "source_sense_description": "een rand van licht",
                        "target_lang_word": "aureole",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aureole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ccb93227-22c5-3c1e-a8c1-0b03ab18b7ca",
                                        "entry_id": "6b048b74-a01f-357f-9b06-33ceb9f66f6f",
                                        "glosses": [
                                            "A circle of light or halo around the head of a deity or a saint."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53b66048-d893-4bae-8807-362c8b415506",
                                                "sense_id": "ccb93227-22c5-3c1e-a8c1-0b03ab18b7ca",
                                                "text": "The lady's hair no woman could possess without feeling it her pride. It was the daily theme of her lady's-maid,—a natural aureole to her head."
                                            },
                                            {
                                                "example_id": "50dafc6e-8e1e-4a8c-91f0-da8cbd7284b7",
                                                "sense_id": "ccb93227-22c5-3c1e-a8c1-0b03ab18b7ca",
                                                "text": "They sat quietly, side by side, without speaking. Philip enjoyed having her near him. He was warmed by her radiant health. A glow of life seemed like an aureole to shine about her."
                                            },
                                            {
                                                "example_id": "ad5d5d55-92e6-4a6c-b25f-d4b215076294",
                                                "sense_id": "ccb93227-22c5-3c1e-a8c1-0b03ab18b7ca",
                                                "text": "She feels, with all our furniture,\nRoom yet for something more secure\nThan our self-kindled aureoles\nTo guide our poor forgotten souls […]"
                                            },
                                            {
                                                "example_id": "6e891d17-0854-464c-a4a7-7f29c39e9117",
                                                "sense_id": "ccb93227-22c5-3c1e-a8c1-0b03ab18b7ca",
                                                "text": "Those white women whose superiority encircled them like an aureole, could quieten any raucous gathering by just placing a finger to a lip."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56fb7567-e05e-348e-bf8c-35f9fec4b897",
                                        "entry_id": "6b048b74-a01f-357f-9b06-33ceb9f66f6f",
                                        "glosses": [
                                            "Any luminous or colored ring that encircles something."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c547b9fc-a40d-4b64-865c-758361cd6aa5",
                                                "sense_id": "56fb7567-e05e-348e-bf8c-35f9fec4b897",
                                                "text": "It was a lean Jewish face, with a great fuzzy aureole of white hair and a small goatee beard […]"
                                            },
                                            {
                                                "example_id": "99b8173e-544a-450c-b918-dd1214c62ae8",
                                                "sense_id": "56fb7567-e05e-348e-bf8c-35f9fec4b897",
                                                "text": "The dust of the road and his long, wiry hair made aureoles of red about him in the westering light […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b68819e4-da98-3582-9c42-4976269accb2",
                                        "entry_id": "6b048b74-a01f-357f-9b06-33ceb9f66f6f",
                                        "glosses": [
                                            "A corona."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4fdce063-e5b1-3fba-8e18-63f6deb1cba5",
                                        "entry_id": "6b048b74-a01f-357f-9b06-33ceb9f66f6f",
                                        "glosses": [
                                            "A ring around an igneous intrusion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d86eb20-4ec0-414d-b6d6-261248b4b074",
                                                "sense_id": "4fdce063-e5b1-3fba-8e18-63f6deb1cba5",
                                                "text": "Cleavage and folds are imprinted are overprinted by the contact metamorphic aureole, indicating that they belong to a pre-intrustive episode of rock deformation and accompanying regional deformation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5076bfb-2664-3cfe-a55e-35cfc1921505",
                                        "entry_id": "6b048b74-a01f-357f-9b06-33ceb9f66f6f",
                                        "glosses": [
                                            "Alternative form of aureola (“increment to blessedness”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
