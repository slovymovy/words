                        "entry_id": "444625eb-9ea5-3b3c-802a-8b01b1788cfe",
                        "glosses": [
                            "Qui ne choisit pas un seul type de fleur à butiner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14d42dba-16a6-4d87-bfa5-c573a0d49a67",
                                "sense_id": "80191bac-ec75-383c-86b1-b965fe15e2f1",
                                "text": "L’osmie cornue est une abeille polylectique appréciant le pollen des Rosacées, Brassicacées, Salicacées et Fabacées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b7c5bfe-cc89-4383-9ab7-d5a4e8e02bb2",
                        "source_entry_id": "444625eb-9ea5-3b3c-802a-8b01b1788cfe",
                        "source_sense_id": "80191bac-ec75-383c-86b1-b965fe15e2f1",
                        "target_lang_word": "polylektisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polylektisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8059101-6ffe-37b2-ae3c-8955d2c15def",
                                        "entry_id": "9ad56828-b652-3686-9ab4-99493edceceb",
                                        "glosses": [
                                            "die Brut mit Pollen von Pflanzen vieler Familien ernährend"
                                        ],
                                        "tags": [
                                            "Entomologie",
                                            "von Bienen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22e36742-865a-4425-b00e-6e9505f16774",
                                                "sense_id": "f8059101-6ffe-37b2-ae3c-8955d2c15def",
                                                "text": "Die Bergwaldhummel ist polylektisch, das heißt, sie geht an die Blüten vieler verschiedener Pflanzenarten."
                                            },
                                            {
                                                "example_id": "09640ee1-4778-4d7e-baab-8884d3b5a773",
                                                "sense_id": "f8059101-6ffe-37b2-ae3c-8955d2c15def",
                                                "text": "Diese besonders spezialisierten Arten bezeichnet man als oligolektisch, wenig wählerische Bienen hingegen als polylektisch."
                                            },
                                            {
                                                "example_id": "a3586577-8948-4211-a6b2-9e53c1422f76",
                                                "sense_id": "f8059101-6ffe-37b2-ae3c-8955d2c15def",
                                                "text": "Sie ernähren sich polylektisch vom Nektar und Pollen einer Reihe verschiedener Pflanzen, vorwiegend von Doldengewächsen (Apiaceae), Korbblütlern (Asteraceae), Kreuzblütlern (Brassicaceae), Hahnenfußgewächsen (Ranunculaceae), Rosengewächsen (Rosaceae) und Weidengewächsen (Salicaceae)."
                                            },
                                            {
                                                "example_id": "9fc4b419-83f8-43ea-ac4c-436ba3fc42d2",
                                                "sense_id": "f8059101-6ffe-37b2-ae3c-8955d2c15def",
                                                "text": "Andere Arten hingegen können Pollen von verschiedenen Pflanzen nutzen, sind also eher Generalisten (polylektische Arten)."
                                            },
                                            {
                                                "example_id": "80287b9d-fbca-43b2-acb8-dca5357f0abd",
                                                "sense_id": "f8059101-6ffe-37b2-ae3c-8955d2c15def",
                                                "text": "Staatenbildende Bienen wie die Hummeln und manche Schmalbienen (Lasioglossum) sind ebenso wie die Honigbiene polylektisch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
