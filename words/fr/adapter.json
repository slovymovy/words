{
    "word_family": [
        "adaptation",
        "adaptable",
        "adaptateur",
        "inadapté",
        "adaptabilité",
        "réadapter",
        "réadaptation",
        "inadaptable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9cb6a65c-d60b-3757-9d9e-25879c73612c",
                    "sense_definition": "Modifier son comportement, ses habitudes ou son mode de vie pour convenir à un nouveau milieu ou à de nouvelles circonstances.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les nouveaux élèves s'<w>adaptent</w> généralement très vite au rythme des cours."
                        },
                        {
                            "text": "Il est important de savoir s'<w>adapter</w> aux imprévus dans le milieu professionnel."
                        }
                    ],
                    "synonyms": [
                        "s'acclimater"
                    ],
                    "common_phrases": [
                        "s'adapter au changement",
                        "s'adapter à la situation",
                        "s'adapter au rythme"
                    ]
                },
                {
                    "sense_id": "d3716be5-3c27-3eee-a8f6-f526791c5add",
                    "sense_definition": "Modifier ou ajuster quelque chose pour le rendre conforme ou approprié à une situation donnée ou à des besoins précis.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "modification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a dû <w>adapter</w> ses explications pour les plus jeunes enfants."
                        },
                        {
                            "text": "L'entreprise doit <w>adapter</w> son offre face à la demande croissante des clients."
                        }
                    ],
                    "common_phrases": [
                        "adapter son offre",
                        "adapter son discours",
                        "adapter ses horaires"
                    ]
                },
                {
                    "sense_id": "5be8cd2b-babb-3b39-954b-8740074a4e20",
                    "sense_definition": "Transposer une œuvre littéraire ou artistique dans un autre genre ou un autre média.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce réalisateur a choisi d'<w>adapter</w> un célèbre roman policier pour la télévision."
                        },
                        {
                            "text": "Il n'est jamais facile d'<w>adapter</w> une pièce classique pour le grand écran."
                        }
                    ],
                    "synonyms": [
                        "transposer"
                    ],
                    "common_phrases": [
                        "adapter un roman au cinéma",
                        "adapter pour la scène"
                    ]
                },
                {
                    "sense_id": "ba730f26-b039-360b-8eb1-5c165a55b6aa",
                    "sense_definition": "Ajuster matériellement un objet ou une pièce mécanique à un autre pour qu'ils fonctionnent ensemble.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "materiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le plombier a réussi à <w>adapter</w> ce tuyau au reste de l'installation."
                        },
                        {
                            "text": "Il faut <w>adapter</w> un embout spécial sur cet appareil avant de l'allumer."
                        }
                    ],
                    "common_phrases": [
                        "adapter une pièce"
                    ]
                },
                {
                    "sense_id": "fff4c8a8-ed1d-364c-9ab0-c43fddf279b7",
                    "sense_definition": "Être en accord parfait, correspondre exactement ou convenir harmonieusement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "correspondance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette citation s'<w>adapte</w> parfaitement au sujet traité dans votre exposé."
                        },
                        {
                            "text": "Ce couvercle ne s'<w>adapte</w> pas du tout à cette casserole trop large."
                        }
                    ],
                    "synonyms": [
                        "convenir",
                        "coïncider"
                    ]
                }
            ]
        }
    ]
}