                                    {
                                        "sense_id": "39695d98-64f3-3655-b632-50af93c00252",
                                        "entry_id": "c8a82e73-c016-3d3d-9174-60fd886b79be",
                                        "glosses": [
                                            "plastic poppetje gemaakt naar het voor beeld van een personage dat voorkomt in een actiefilm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ec2450c-e0f1-4b20-b650-db4baccc17f5",
                                                "sense_id": "39695d98-64f3-3655-b632-50af93c00252",
                                                "text": "Dora heeft ook grote handen, maar die van Gote passen beter bij een actiefiguur dan bij een mens."
                                            },
                                            {
                                                "example_id": "f64b8948-4d51-4f30-b559-6a77f0453908",
                                                "sense_id": "39695d98-64f3-3655-b632-50af93c00252",
                                                "text": "Het Chinese bedrijf In Icons kondigde deze week een actiefiguur van de overleden Apple-CEO Steve Jobs aan. De pop lijkt als twee druppels water op Jobs, vindt ook Apple zelf. Het bedrijf denkt er zelfs over na de de producent voor de rechtbank te slepen."
                                            },
                                            {
                                                "example_id": "1bdd7a50-2aa2-4b75-b8be-69e94c57fd8c",
                                                "sense_id": "39695d98-64f3-3655-b632-50af93c00252",
                                                "text": "Dat kan stevig in de papieren lopen. Sommige poppen koop je voor een tientje, maar de echt toegewijde fan kan voor 300 dollar de trotse eigenaar worden van een Godzilla-actiefiguur met wieltjes onder de voeten en een een wegschietende rechterhand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
