                                        "entry_id": "148829cf-4294-37cb-8c83-32a7b6f161ca",
                                        "glosses": [
                                            "The use of a romantic or a sexual relationship to entice a person into revealing secret information."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "171e5d76-2bff-4e68-9e26-3e317c7acd93",
                                                "sense_id": "7c25836b-1123-3f90-8712-880a82fd6ac7",
                                                "text": "“Some girl had made a fool of him,” said Connie with great contempt. “The Dutch set him a honey trap, my dear, and he barged in with his eyes wide shut.”"
                                            }
                                        ]
