                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "097b6f0f-1d2d-4fdf-9ef9-18f62511a59a",
                                                "sense_id": "3af549a9-160f-3633-8ce2-401d99d00882",
                                                "text": "This month's inventory took nearly three days."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43ff13e1-b460-345c-8272-d6132c4263bd",
                                        "entry_id": "5a87abc7-c79f-30fe-b693-554d14afbd2c",
                                        "glosses": [
                                            "A space containing the items available to a character, especially in a video game, for immediate use."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8b7c9b7-cedb-4af7-87a1-25101f9e7fc3",
                                                "sense_id": "43ff13e1-b460-345c-8272-d6132c4263bd",
                                                "text": "You can't get through the underground tunnel if there are more than three items in your inventory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a612e07c-0b54-38b4-909a-35f30012ee09",
                                        "entry_id": "5a87abc7-c79f-30fe-b693-554d14afbd2c",
                                        "glosses": [
                                            "The total set of a (specified) linguistic feature (within a language etc.)"
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f10e66d-1617-473e-8b5a-889528308c6d",
                                                "sense_id": "a612e07c-0b54-38b4-909a-35f30012ee09",
                                                "text": "Germanic languages have a marked tendency towards large vocalic inventories."
                                            },
                                            {
                                                "example_id": "92225dfe-9882-40b6-80ee-fc40ddb8335e",
                                                "sense_id": "a612e07c-0b54-38b4-909a-35f30012ee09",
                                                "text": "Most final consonants have been lost, resulting in a tonal language with a rich consonantal and vocalic inventory, but with a relatively simple syllabic structure.."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inventory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "afb86dde-40d6-3529-8f0a-ef8fc6b22742",
