        "assistanat"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "215c3741-49b5-3566-a3a1-23de5b13ac29",
                    "sense_definition": "Être présent à un événement, un spectacle ou une réunion en tant que témoin ou spectateur.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "presence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous <w>assistons</w> au match de football dans le grand stade de la ville."
                        },
                        {
                            "text": "Elle a pu <w>assister</w> au concert de son groupe préféré hier soir."
                        }
                    ],
                    "common_phrases": [
                        "assister à un concert",
                        "assister à une réunion",
                        "assister au match"
                    ]
                },
                {
                    "sense_id": "a504c5c1-25ba-3e24-9e74-58c314a4d92c",
                    "sense_definition": "Fournir une aide matérielle, morale ou médicale à une personne dans le besoin ou en difficulté.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "aide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les bénévoles viennent <w>assister</w> les personnes âgées isolées pendant l'hiver."
                        },
                        {
                            "text": "L'infirmière <w>assiste</w> les patients qui éprouvent des difficultés à marcher."
                        }
                    ],
                    "synonyms": [
                        "aider",
                        "secourir",
                        "soutenir"
                    ],
                    "antonyms": [
                        "abandonner"
                    ],
                    "common_phrases": [
                        "assister les malades",
                        "assister les plus démunis"
                    ]
                },
                {
                    "sense_id": "6ba932dd-3f09-3a4a-946d-2e08a2788570",
                    "sense_definition": "Seconder ou accompagner quelqu'un dans la réalisation d'une tâche ou l'exercice d'une fonction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "collaboration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'accusé a le droit légal de se faire <w>assister</w> par un avocat pendant son interrogatoire."
                        },
                        {
                            "text": "Cet interne expérimenté <w>assiste</w> le chef de service pendant chaque opération délicate."
                        }
                    ],
                    "synonyms": [
                        "seconder",
                        "épauler"
                    ],
                    "common_phrases": [
                        "se faire assister",
                        "assister le chirurgien"
                    ]
                }
            ]
        }
    ]
}