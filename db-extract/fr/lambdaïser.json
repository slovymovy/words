                "senses": [
                    {
                        "sense_id": "9be1f1e4-99bc-3a95-91bb-53eaf0e7af52",
                        "entry_id": "39756648-b450-360a-81cb-d681f7345e29",
                        "glosses": [
                            "Donner un caractère lambda à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18e70568-69ea-442f-a76f-2f83b939926f",
                                "sense_id": "9be1f1e4-99bc-3a95-91bb-53eaf0e7af52",
                                "text": "Tout cela conduira à « lambdaïser » les fonctionnaires et détruire les compétences spécifiques si importantes dans nos corps."
                            },
                            {
                                "example_id": "25bcb6bc-c13e-4e26-b758-e29c63e9b85e",
                                "sense_id": "9be1f1e4-99bc-3a95-91bb-53eaf0e7af52",
                                "text": "Mais simplement, des tas de gens vivent de cette activité et l'on ne peux pas diffuser les arguments de nos métiers sans le \"lambdaïser\"."
                            },
                            {
                                "example_id": "d178a740-9e6b-4265-b7db-8945d160a9ca",
                                "sense_id": "9be1f1e4-99bc-3a95-91bb-53eaf0e7af52",
                                "text": "Mais s'il faut se lambdaïser, allons-y, ne soyons pas chiche."
                            }
                        ]
                    }
