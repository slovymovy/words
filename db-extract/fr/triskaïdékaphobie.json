                            {
                                "target_word": "Triskaidekaphobie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "deab990e-60b3-3e56-83f8-3a6910f20690",
                                        "entry_id": "5daa81c0-4e56-3729-be68-69cde5229208",
                                        "glosses": [
                                            "Angst vor der Zahl 13"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb935d36-6947-4cb6-a990-291d5223bc64",
                                                "sense_id": "deab990e-60b3-3e56-83f8-3a6910f20690",
                                                "text": "„Wir vermuten einen Fall von Überkompensation der Triskaidekaphobie, der abergläubischen Angst vor der Zahl 13, die sich u. a. dadurch auszeichnet, dass sie die erste Mirpzahl ist.“"
                                            },
                                            {
                                                "example_id": "47d4b28d-8a26-404f-8558-46d84478fdd1",
                                                "sense_id": "deab990e-60b3-3e56-83f8-3a6910f20690",
                                                "text": "„Mag man dafür noch ein gewisses Verständnis aufbringen, so mutet das Ende des an der Furcht vor der Zahl 13 (Triskaidekaphobie) leidenden Arnold Schönberg geradezu skurril an:“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e86ec7cc-f30e-47ac-ad6f-74051e7233d4",
                        "source_entry_id": "3fcf00f9-9d6f-3563-8053-a5eb88e4f918",
                        "source_sense_id": "3ef22c07-4f63-3830-a960-00dc71c15ea6",
                        "target_lang_word": "triskaidekaphobia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "triskaidekaphobia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "342809c2-f34f-39d7-8f79-c16e6e3f646f",
                                        "entry_id": "4fdd52f4-1145-317c-9921-1012f70d5cf9",
                                        "glosses": [
                                            "Fear or dislike of the number thirteen (13)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea91e354-a964-4863-9281-68e3b4032653",
                                                "sense_id": "342809c2-f34f-39d7-8f79-c16e6e3f646f",
                                                "text": "Yet, despite beliefs that triskaidekaphobia began long ago and has been passed down through the centuries, the earliest known reference to Friday the 13th as a dreaded day did not appear until 1913. It is merely a 20th century invention."
                                            },
                                            {
                                                "example_id": "fbe1f896-c694-4ee4-a11f-1d4a0e73e726",
                                                "sense_id": "342809c2-f34f-39d7-8f79-c16e6e3f646f",
                                                "text": "The great Austrian-American composer Arnold Schoenberg had such a severe case of triskaidekaphobia (the fear of the number 13), he omitted numbering the 13th measure in some of his later works, substituting it with the notation “12a.”"
                                            },
                                            {
                                                "example_id": "e147d2f8-1a63-4082-8211-97c5834074f6",
                                                "sense_id": "342809c2-f34f-39d7-8f79-c16e6e3f646f",
                                                "text": "There’s even a name to describe the irrational dread of the date: paraskevidekatriaphobia — a specialized form of triskaidekaphobia, a fear of the number 13."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
