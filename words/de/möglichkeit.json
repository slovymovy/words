                    "frequency": "High",
                    "semantic_group_id": "chance_ability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er hat im Ausland die <w>Möglichkeit</w>, seine Sprachkenntnisse täglich zu verbessern."
                        },
                        {
                            "text": "Nur der Direktor hat die <w>Möglichkeit</w>, diesen wichtigen Vertrag direkt zu unterschreiben."
                        }
                    ],
                    "synonyms": [
                        "Gelegenheit",
                        "Fähigkeit",
                        "Vermögen"
                    ],
                    "common_phrases": [
