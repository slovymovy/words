{
    "word_family": [
        "план",
        "планировка",
        "планировщик",
        "плановый",
        "планомерный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "df2b5f7a-1fa5-3bfd-9cb7-8182900b95c9",
                    "sense_definition": "Составлять план действий или последовательность шагов для достижения цели.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "planning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы <w>планируем</w> поехать в отпуск в следующем месяце.",
                            "target_lang_translations": {
                                "en": "We <w>plan</w> to go on vacation next month."
                            }
                        },
                        {
                            "text": "Важно <w>планировать</w> свой рабочий день заранее.",
                            "target_lang_translations": {
                                "en": "It is important to <w>plan</w> your workday in advance."
                            }
                        }
                    ],
                    "synonyms": [
                        "запланировать"
                    ],
                    "common_phrases": [
                        "планировать день",
                        "планировать бюджет"
                    ],
                    "target_lang_definitions": {
                        "en": "To create a plan of action or a sequence of steps to achieve a goal."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plan",
                                "target_lang_sense_clarification": "To create a set of intended actions to achieve a goal."
                            },
                            {
                                "target_lang_word": "schedule",
                                "target_lang_sense_clarification": "To plan an activity or event for a specific time."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bec0749a-3452-395f-a6ba-835e65d99152",
                    "sense_definition": "Иметь намерение сделать что-либо в будущем.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "planning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>планирую</w> выучить русский язык до конца года.",
                            "target_lang_translations": {
                                "en": "I <w>plan</w> to learn Russian by the end of the year."
                            }
                        },
                        {
                            "text": "Они <w>планируют</w> купить новую квартиру в центре города.",
                            "target_lang_translations": {
                                "en": "They <w>plan</w> to buy a new apartment in the city center."
                            }
                        }
                    ],
                    "synonyms": [
                        "собираться",
                        "намереваться"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто используется в разговорной речи"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To have the intention to do something in the future."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plan",
                                "target_lang_sense_clarification": "To intend to do something."
                            },
                            {
                                "target_lang_word": "intend",
                                "target_lang_sense_clarification": "To have a plan or purpose in mind."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e236cdb-de8f-3cd2-a256-c9d675f4fc7a",
                    "sense_definition": "Разрабатывать проект или чертеж постройки или сооружения.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "design",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Архитектор <w>планирует</w> новый жилой комплекс на окраине города.",
                            "target_lang_translations": {
                                "en": "The architect is <w>planning</w> a new residential complex on the outskirts of the city."
                            }
                        },
                        {
                            "text": "Инженеры <w>планируют</w> строительство моста через реку.",
                            "target_lang_translations": {
                                "en": "Engineers are <w>planning</w> the construction of a bridge across the river."
                            }
                        }
                    ],
                    "synonyms": [
                        "проектировать"
                    ],
                    "target_lang_definitions": {
                        "en": "To develop a project or blueprint for a building or structure."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plan",
                                "target_lang_sense_clarification": "To design a building or structure."
                            },
                            {
                                "target_lang_word": "design",
                                "target_lang_sense_clarification": "To create a plan or drawing for a structure."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6303832-55c7-3130-8bce-d163858b6490",
                    "sense_definition": "Постепенно и плавно снижаться в воздухе (о летательном аппарате или птице).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "flight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Орел начал <w>планировать</w> над полем, высматривая добычу.",
                            "target_lang_translations": {
                                "en": "The eagle began to <w>glide</w> over the field, looking for prey."
                            }
                        },
                        {
                            "text": "Самолет с выключенным двигателем может <w>планировать</w> некоторое время.",
                            "target_lang_translations": {
                                "en": "A plane with its engine off can <w>glide</w> for some time."
                            }
                        }
                    ],
                    "synonyms": [
                        "пари́ть"
                    ],
                    "antonyms": [
                        "падать",
                        "рушиться"
                    ],
                    "target_lang_definitions": {
                        "en": "To descend gradually and smoothly through the air (of an aircraft or bird)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "glide",
                                "target_lang_sense_clarification": "To fly unpowered, as of an aircraft or bird."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}