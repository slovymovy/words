                "senses": [
                    {
                        "sense_id": "a87a949b-2bfb-3187-9b57-701f20fc7a06",
                        "entry_id": "f18ceb40-3257-3ef8-bcdc-d79d6d26426b",
                        "glosses": [
                            "betrekking hebbend op de relatie tussen verschillende besturen of bestuurslagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "013466d5-7dc5-40ec-a6fd-9a03ed673847",
                                "sense_id": "a87a949b-2bfb-3187-9b57-701f20fc7a06",
                                "text": "Dat heeft de provincie de gemeente laten weten naar aanleiding van het Interbestuurlijk Toezicht (IBT). Daarbij kijkt de provincie naar het totaalbeeld van de gemeente. Uit dat onderzoek is gebleken dat de gemeente het op alle sectoren verder goed doet. Alleen bij financien moet wat gebeuren. Inmiddels heeft de gemeente toegezegd aan beide kritiekpunten te werken."
                            },
                            {
                                "example_id": "50a06899-2fa3-4b7c-bccb-386960f594af",
                                "sense_id": "a87a949b-2bfb-3187-9b57-701f20fc7a06",
                                "text": "Met het interbestuurlijk toezicht oordeelt de provincie van groen (goed) tot rood (fout) op de domeinen financiën, omgevingsrecht, ruimtelijke ordening, archiefzorg en -beheer en huisvesting."
                            },
                            {
                                "example_id": "0db1a820-02f1-4c5c-9b5b-e44f21bf35bf",
                                "sense_id": "a87a949b-2bfb-3187-9b57-701f20fc7a06",
                                "text": "De gemeenten blijven dan over als enige decentrale bestuurslaag. Zij en het rijk doen dan de taken van provincies en waterschappen erbij. Dat scheelt een stuk beleidsoverlap en een hoop interbestuurlijk gedoe. Grotere gemeenten zouden op hun beurt weer taken van het rijk erbij kunnen pakken."
                            }
                        ]
                    }
