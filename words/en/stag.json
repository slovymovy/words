                            },
                            {
                                "target_lang_word": "пацанка",
                                "target_lang_sense_clarification": "сорвиголова"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "044fa6de-5fa4-3bc5-bb89-fd599be1a400",
                    "sense_definition": "The Eurasian wren.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tiny <w>stag</w> sang loudly from beneath the garden hedge.",
                            "target_lang_translations": {
                                "ru": "Крошечный <w>крапивник</w> громко пел из-под садовой изгороди."
                            }
