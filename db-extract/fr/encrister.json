                        "examples": [
                            {
                                "example_id": "cb7d71d3-579e-44ca-a0b3-c45f19f60a53",
                                "sense_id": "c5b2f54e-6de1-3026-a014-8dcfa5e7bebc",
                                "text": "Et lui, qu’aurait voulu devenir curé, il s’est fait encrister comme Juif."
                            },
                            {
                                "example_id": "63997e09-b4fe-42d4-9355-18b0e5a7aa87",
                                "sense_id": "c5b2f54e-6de1-3026-a014-8dcfa5e7bebc",
                                "text": "Ça ne me coûte pas beaucoup de leur dire ça, encore qu’ils soient capables de m’encrister pour recel de malfaiteur."
