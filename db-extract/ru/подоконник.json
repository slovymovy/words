                    {
                        "translation_id": "0629ad12-94aa-4017-b28d-a305e5511b30",
                        "source_entry_id": "b2cc9bdd-07ab-3b7f-882a-c689d8ce4fe5",
                        "source_sense_id": "4b88c41b-2ee8-3d5b-9a1b-d9bbb9d0bf55",
                        "target_lang_word": "windowsill",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "windowsill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df3c0b6e-7237-3f7f-8d39-0d2cff2ff28c",
                                        "entry_id": "7c01ac70-db62-33d8-9785-46596909edf3",
                                        "glosses": [
                                            "The horizontal member protruding from the base of a window frame."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a07ed838-6536-41c3-a530-ddc46ca2a0ae",
                                                "sense_id": "df3c0b6e-7237-3f7f-8d39-0d2cff2ff28c",
                                                "text": "An upscale version of this tried and true method of providing windowsill humidity is the use of plastic 'egg crating' instead of gravel."
                                            },
                                            {
                                                "example_id": "cf6c9fd0-2cc5-4cae-8c22-e13567a141fd",
                                                "sense_id": "df3c0b6e-7237-3f7f-8d39-0d2cff2ff28c",
                                                "text": "You could tell summer was coming because people were drinking on the street, searching for spaces on the windowsills of the pub to balance their beerglasses."
                                            },
                                            {
                                                "example_id": "4d9e02d6-ad80-4683-8942-d49fdf828631",
                                                "sense_id": "df3c0b6e-7237-3f7f-8d39-0d2cff2ff28c",
                                                "text": "north-facing rooms: These rooms receive the least light if you live up north, so choose plants that can endure low-light conditions and keep them directly on the windowsill. Some suggestions include pothos, philodendrons, arrowheads, Chinese evergreens, peace lilies and zamioculcas (or “ZZ”)."
                                            },
                                            {
                                                "example_id": "dc978559-880e-4b96-8a2d-b5e3e7112829",
                                                "sense_id": "df3c0b6e-7237-3f7f-8d39-0d2cff2ff28c",
                                                "text": "The most unreliable joints are in connections between the wall with ceilings and roofing, esconson of windows, places under the windowsills, exits to the balcony or veranda..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
