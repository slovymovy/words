                ],
                "senses": [
                    {
                        "sense_id": "5fbaf6eb-5f56-30ca-8e09-fadbd8e46e1e",
                        "entry_id": "da265ba4-09e5-304a-b185-a5d88f589afa",
                        "glosses": [
                            "Chtcherbatov."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e72f0a4-d497-4918-ad36-4fec637e2d07",
                                "sense_id": "5fbaf6eb-5f56-30ca-8e09-fadbd8e46e1e",
                                "text": "Всё лучшее, что осталось в Кипренском от житейских встреч с женщинами, он воплотил в образе Щербатовой — задумчивость, нежность, девическую чистоту.",
                                "translation": "Tout ce qui restait de meilleur à Kiprensky de ses rencontres quotidiennes avec les femmes, il l'incarnait à l'image de Chtcherbatova : la prévenance, la tendresse, la pureté enfantine."
                            },
                            {
                                "example_id": "ea3cf61b-3a9a-4410-9db9-388c47122249",
                                "sense_id": "5fbaf6eb-5f56-30ca-8e09-fadbd8e46e1e",
                                "text": "Mихаил Михайлович Щербатов.",
                                "translation": "Mikhaïl Chtcherbatov."
                            },
                            {
                                "example_id": "be4be091-13e4-4516-8359-393435242454",
                                "sense_id": "5fbaf6eb-5f56-30ca-8e09-fadbd8e46e1e",
                                "text": "Николай Борисович Щербатов.",
                                "translation": "Nicolas Chtcherbatov."
                            }
                        ]
                    }
                ],
