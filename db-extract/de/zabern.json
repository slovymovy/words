                        "examples": [
                            {
                                "example_id": "3eccf3de-d5e6-4b13-b142-c02fd3e1fb45",
                                "sense_id": "05d168c5-0204-36dd-a732-8a661d9759e4",
                                "text": "Zabern wurde als römische Militärstation „Tres Tabernae“ (lat. „Drei Tavernen“) zur Sicherung der Zaberner Steige, eines Vogesenübergangs, an der Römerstraße Straßburg – Metz errichtet."
                            }
                        ],
                        "sense_index_json": "\"1\""
