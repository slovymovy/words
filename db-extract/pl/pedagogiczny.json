                        ]
                    },
                    {
                        "translation_id": "60b35371-0733-4dff-829f-c90a51c95925",
                        "source_entry_id": "cf8cd6bd-09d0-3cde-8413-ed25d3a7b2e0",
                        "source_sense_id": "517cf120-8a63-36b0-a201-d2386b28ff48",
                        "target_lang_word": "pedagogical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pedagogical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8dcc3692-cfb1-3dc6-af72-7865e50c3e65",
                                        "entry_id": "309841ba-2ae2-307d-a136-e17c47723a18",
                                        "glosses": [
                                            "Of, or relating to pedagogy; teaching."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55b3c9b1-33ac-44ed-a6c5-cbee45b1f008",
                                                "sense_id": "8dcc3692-cfb1-3dc6-af72-7865e50c3e65",
                                                "text": "As we look back into the early collections of qin notations, known as qinpu, we find an interesting collection of pictures in the pedagogical sections of several important qinpu."
                                            },
                                            {
                                                "example_id": "b391fc05-86ad-470e-a905-d4297916d741",
                                                "sense_id": "8dcc3692-cfb1-3dc6-af72-7865e50c3e65",
                                                "text": "The value of pedagogical material informed by objective methodological procedures developed in corpus linguistics is widely recognized."
                                            },
                                            {
                                                "example_id": "71f1f6f8-5ee5-4b27-b4ab-e63313bacb9b",
                                                "sense_id": "8dcc3692-cfb1-3dc6-af72-7865e50c3e65",
                                                "text": "She also noted that the administration, in a letter in April, “specifically conditioned funding on agreeing to its ten terms, only one of which related to antisemitism, while six related to ideological and pedagogical concerns, including who may lead and teach at Harvard, who may be admitted, and what may be taught.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c145bba3-0ce3-3836-8827-d4bbae43cc42",
                                        "entry_id": "309841ba-2ae2-307d-a136-e17c47723a18",
                                        "glosses": [
                                            "Haughty and formal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4115d05-c7ef-4606-bb0d-d9523a0c5c13",
                        "source_entry_id": "cf8cd6bd-09d0-3cde-8413-ed25d3a7b2e0",
                        "source_sense_id": "517cf120-8a63-36b0-a201-d2386b28ff48",
                        "target_lang_word": "教师",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4ba460b0-002d-41e3-839b-9662780c366b",
                        "source_entry_id": "cf8cd6bd-09d0-3cde-8413-ed25d3a7b2e0",
                        "source_sense_id": "517cf120-8a63-36b0-a201-d2386b28ff48",
                        "target_lang_word": "pédagogique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pédagogique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2d01919-b93d-3a1d-bb36-0dd7296afbbe",
                                        "entry_id": "8e115f13-e794-3257-b134-88f87a303ffb",
                                        "glosses": [
                                            "Relatif à la pédagogie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e87cce09-db92-492c-8e78-839dc78e44f5",
                                                "sense_id": "f2d01919-b93d-3a1d-bb36-0dd7296afbbe",
                                                "text": "Ces matériaux pédagogiques sont ainsi loin de fournir un aperçu général de la structure de la langue japonaise."
                                            },
                                            {
                                                "example_id": "8317a41f-4bfa-4f7a-940a-eaa3213bed9c",
                                                "sense_id": "f2d01919-b93d-3a1d-bb36-0dd7296afbbe",
                                                "text": "Quelque citation latine banale de ci, de là, un aphorisme philosophique ou pédagogique, une ironie forcée mais acerbe, rehaussent son prestige."
                                            },
                                            {
                                                "example_id": "6142d19f-af7c-49f9-99c2-0b2ae4ec9b95",
                                                "sense_id": "f2d01919-b93d-3a1d-bb36-0dd7296afbbe",
                                                "text": "Afin de démonopoliser, de désexpertiser le droit, l’enseignement doit être donné par les éducateurs réguliers et non pas par des policiers ou des juristes comme l’on tend à le pratiquer car, en premier lieu ceux-ci ne possèdent aucune formation pédagogique et d’autre part l’entraînement du policier est basé avant tout sur la répression : les échecs répétés dans la mise en application de l’enseignement juridique par les policiers sont dus avant tout au besoin inné d’inquisition de la personnalité policière."
                                            },
                                            {
                                                "example_id": "4c5db52e-c330-4f1f-988c-99d59ba2672a",
                                                "sense_id": "f2d01919-b93d-3a1d-bb36-0dd7296afbbe",
                                                "text": "Après une baisse de plus de 20% l’an dernier, le nombre d’étudiants inscrits dans les filières pédagogiques en Wallonie et à Bruxelles devrait à nouveau connaître une diminution cette année."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
