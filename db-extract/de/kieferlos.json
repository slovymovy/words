                "senses": [
                    {
                        "sense_id": "f0a6d896-8551-3653-b548-931d80107174",
                        "entry_id": "bb63cc05-55e3-3d16-8e92-a090be3c5313",
                        "glosses": [
                            "ohne Kiefer, keinen Kiefer habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b83c6001-2a76-4735-8ab3-9e461311652a",
                                "sense_id": "f0a6d896-8551-3653-b548-931d80107174",
                                "text": "„Wieder stürzte sie herab, und in einem blinden Reflex des Ekels schlug ich mit der Hand gegen das kieferlose Insekt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "80da1092-04f0-3fca-a304-692d8946b2dc",
                        "entry_id": "bb63cc05-55e3-3d16-8e92-a090be3c5313",
                        "glosses": [
                            "(entwicklungsgeschichtlich noch) ohne Kiefer, früher eigenes Taxon"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "9967ce1b-b5e9-4be0-b664-368775a28989",
                                "sense_id": "80da1092-04f0-3fca-a304-692d8946b2dc",
                                "text": "„Das zu den Rundmäulern […] zählende Flussneunauge […] ist ein 30 cm langer kieferloser Fisch, der sich von Blut und Fleischfetzen der Knochenfische ernährt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
