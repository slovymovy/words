                ],
                "senses": [
                    {
                        "sense_id": "a93f2047-87a4-3dd1-9131-5e9f17d872fa",
                        "entry_id": "bd41bff3-ad4a-318c-a06a-13952ac928e6",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2efca69f-1aa0-4188-a3df-0eb408df6409",
                                "sense_id": "a93f2047-87a4-3dd1-9131-5e9f17d872fa",
                                "text": "Frau Pfannkuch ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "985f39d3-1053-44e9-9787-327e0b8238ec",
                                "sense_id": "a93f2047-87a4-3dd1-9131-5e9f17d872fa",
                                "text": "Herr Pfannkuch wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "325387bb-879a-4551-8ef7-4e6a96485617",
                                "sense_id": "a93f2047-87a4-3dd1-9131-5e9f17d872fa",
                                "text": "Die Pfannkuchs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "ce30514a-49e9-42eb-a0db-37cfb84987e4",
                                "sense_id": "a93f2047-87a4-3dd1-9131-5e9f17d872fa",
                                "text": "Der Pfannkuch trägt nie die Schals, die die Pfannkuch ihm strickt."
                            },
                            {
                                "example_id": "52a0a203-5c75-4473-a36d-436978b76d43",
                                "sense_id": "a93f2047-87a4-3dd1-9131-5e9f17d872fa",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Pfannkuch kommt, geht der Herr Pfannkuch.“"
                            },
                            {
                                "example_id": "28dfd839-df72-41ad-8437-1669be54f1ea",
                                "sense_id": "a93f2047-87a4-3dd1-9131-5e9f17d872fa",
                                "text": "Pfannkuch kommt und geht."
                            },
                            {
                                "example_id": "bb9848ed-d71f-4c19-876d-d61f92abb986",
                                "sense_id": "a93f2047-87a4-3dd1-9131-5e9f17d872fa",
                                "text": "Pfannkuchs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
