                        "glosses": [
                            "Surface cylindrique ayant une base différente du cercle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4e02215-85c6-4eae-a023-693211cc8e9f",
                                "sense_id": "087ee252-3475-3cac-81c1-12241850812f",
                                "text": "Une variante plus exacte de cette projection est de ne pas utiliser un cylindre parfait, mais un cylindroïde aplati aux pôles et tangent tout le long des deux méridiens opposés au géoïde (ellipsoïdal) de référence."
                            }
