                "senses": [
                    {
                        "sense_id": "955ab610-0055-38cf-a0ee-f5cb441766ce",
                        "entry_id": "5cfe60ea-8c4c-394d-9cb5-1d4331ba5f0b",
                        "glosses": [
                            "der Ort, in den nach den Vorstellungen vieler Kulturen die Gestorbenen einziehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c228d7d0-092a-4ca0-8300-3c7890122422",
                                "sense_id": "955ab610-0055-38cf-a0ee-f5cb441766ce",
                                "text": "„Es war einfach nicht zu begreifen, dass eine Freundschaft zwischen einem erwachsenen Mann und einem kleinen Jungen so endete und er sozusagen aus dem Totenreich ein ganzes Haus auf dem Silbertablett serviert bekam.“"
                            },
                            {
                                "example_id": "07b4fcdc-429a-4e78-9ce0-d7a6c60dfcc0",
                                "sense_id": "955ab610-0055-38cf-a0ee-f5cb441766ce",
                                "text": "„Die Beschäftigung mit dem Totenreich der Vergangenheit ist sinnlos, wenn sie nicht der Sinngebung der lebendigen Gegenwart dient.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
