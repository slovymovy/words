            "pos": "verb",
            "senses": [
                {
                    "sense_id": "32156f0b-a371-30af-8555-0dd66c036721",
                    "sense_definition": "Badigeonner une pâte avec du jaune d'œuf avant la cuisson, ou faire rissoler un aliment pour lui donner une couleur dorée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant d'enfourner la tarte, pensez à <w>dorer</w> la pâte avec un peu de jaune d'œuf."
                        },
                        {
                            "text": "Il faut faire <w>dorer</w> les oignons à feu doux pendant quelques minutes."
                        }
                    ],
                    "synonyms": [
                        "brunir",
                        "rissoler"
                    ],
                    "common_phrases": [
                        "dorer au four",
                        "dorer à la poêle"
                    ]
                },
                {
                    "sense_id": "e31ecfae-aa75-3a02-99a1-11b9a681bca6",
                    "sense_definition": "Recouvrir la surface d'un objet d'une mince couche d'or ou d'une matière semblable à l'or.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "artisanat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan va <w>dorer</w> le cadre ancien avec de fines feuilles d'or."
                        },
                        {
                            "text": "On a choisi de <w>dorer</w> les lettres du titre sur la reliure du livre."
                        }
                    ],
                    "common_phrases": [
                        "dorer à la feuille",
                        "dorer sur tranche"
                    ]
                },
                {
                    "sense_id": "cfd72ac9-574f-3933-aa4b-bedfed74c0ce",
                    "sense_definition": "Éclairer d'une lumière chaude et éclatante, conférer une teinte jaune ou dorée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lumiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les derniers rayons du soleil couchant venaient <w>dorer</w> le sommet des collines."
                        },
                        {
                            "text": "Chaque matin, la douce lumière matinale commence à <w>dorer</w> les façades des maisons."
                        }
                    ],
                    "synonyms": [
                        "illuminer"
                    ],
                    "antonyms": [
                        "assombrir"
                    ],
                    "common_phrases": [
                        "se dorer au soleil"
                    ]
                },
                {
                    "sense_id": "8f15e4f7-51c6-3441-a27c-ed02d39f3b5c",
                    "sense_definition": "Faire mûrir des céréales ou des fruits en leur donnant une couleur blonde dorée.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La chaleur de l'été contribue à <w>dorer</w> les épis de blé dans les champs."
                        },
                        {
                            "text": "Sous le soleil de juillet, les grandes plaines semblent se <w>dorer</w> à perte de vue."
                        }
                    ],
                    "synonyms": [
                        "mûrir"
                    ],
                    "common_phrases": [
