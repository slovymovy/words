                        "entry_id": "44339007-83f9-33e8-9cfa-e74fe198604e",
                        "glosses": [
                            "Mélange de malt concassé et d'eau de la cuve-matière (ou cuve à empâtage) lors du brassage de la bière."
                        ],
                        "tags": [
                            "Alsace"
                        ],
                        "examples": [
                            {
                                "example_id": "366dad09-90b7-42ed-b578-2638d6205fa8",
                                "sense_id": "faf61b96-5f87-351e-bf59-954c73a29fba",
                                "text": "Tout dépend de la bière que vous brassez mais, pour moi, une maïsche – le mélange d’eau et de malt – se fait entre soixante-cinq et soixante-neuf degrés."
                            }
                        ]
                    }
                ],
                "translations": [
