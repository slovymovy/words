                                "target_senses": [
                                    {
                                        "sense_id": "745981e0-2145-317c-a2fa-1d35ef375e3d",
                                        "entry_id": "8886822d-102a-3ae1-89d3-48638a618bde",
                                        "glosses": [
                                            "Apparat zur Bestimmung der Hörfähigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96dd26e5-4eb2-4cde-9e95-5b41c57f30e5",
                                                "sense_id": "745981e0-2145-317c-a2fa-1d35ef375e3d",
                                                "text": "„Das Audiometer wird vom Hersteller so eingestellt, dass für alle Frequenzen beim Pegel von 0dB HL gerade die mittlere Normalhörschwelle erreicht wird.“"
                                            },
                                            {
                                                "example_id": "5a66d461-4c20-4cd9-810c-7a3f355b79a3",
                                                "sense_id": "745981e0-2145-317c-a2fa-1d35ef375e3d",
                                                "text": "„Die Hörschwelle wird grundsätzlich in Luft- und in Knochenleitung mithilfe eines Audiometers bestimmt.“"
                                            },
                                            {
                                                "example_id": "ca49ec0f-596d-4fc0-8733-20f9f33ad780",
                                                "sense_id": "745981e0-2145-317c-a2fa-1d35ef375e3d",
                                                "text": "„Auch durch eine weitere Erhöhung des Schalldruckpegels auf die Leistungsgrenze des Audiometers (110 dB) wird keine 100 %ige Verständlichkeit erreicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
