                ],
                "senses": [
                    {
                        "sense_id": "7e516811-474d-3108-9e50-e09bbe56dfa2",
                        "entry_id": "51899b46-c117-345a-a296-6cc24eba2222",
                        "glosses": [
                            "Qui appartient à l’ornement ; qui sert l’ornement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab8eaae5-d0cc-4017-8cce-a124475cb904",
                                "sense_id": "7e516811-474d-3108-9e50-e09bbe56dfa2",
                                "text": "Le forsythia est un arbuste ornemental dont la couleur jaune des fleurs et la floribondité sont très appréciées au début du printemps."
                            },
                            {
                                "example_id": "51f88cec-3696-4d0b-ab85-d655ba1ab55b",
                                "sense_id": "7e516811-474d-3108-9e50-e09bbe56dfa2",
                                "text": "Cependant, le caractère vraiment ornemental et architectural des armoiries, qui ne tolérait pas une représentation des objets sous leur forme parfaitement naturelle, se conserva […] jusqu’au milieu du 16ᵉ [siècle]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57df0cd8-c4d0-4d97-9fef-82658c0aadc5",
                        "source_entry_id": "51899b46-c117-345a-a296-6cc24eba2222",
                        "source_sense_id": "7e516811-474d-3108-9e50-e09bbe56dfa2",
                        "target_lang_word": "ornamental",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ornamental",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f92ba4fc-c781-3208-835f-7a5ef7a2d7bd",
                                        "entry_id": "ba443071-8c58-375e-9a37-970e7ea078f3",
                                        "glosses": [
                                            "Serving as an ornament; having no purpose other than to make more beautiful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "680c1090-2c44-4894-8bfe-631b0bc11ff9",
                                                "sense_id": "f92ba4fc-c781-3208-835f-7a5ef7a2d7bd",
                                                "text": "Some think it most ornamental to wear their bracelets on their wrists; others, about their ankles."
                                            },
                                            {
                                                "example_id": "bdac60d7-da2e-4ba8-acd7-c53e46b8bfa0",
                                                "sense_id": "f92ba4fc-c781-3208-835f-7a5ef7a2d7bd",
                                                "text": "We shall leave to the reader to determine with what judgment we have chosen the several occasions for inserting those ornamental parts of our work."
                                            },
                                            {
                                                "example_id": "0406b388-73fc-42cd-bf00-3934ba29545d",
                                                "sense_id": "f92ba4fc-c781-3208-835f-7a5ef7a2d7bd",
                                                "text": "There were ornamental ponds and shrubs clipped into animal shapes, painted concrete gnomes sitting on mushrooms, pink flamingos standing on one leg[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75596418-e7aa-3852-b70c-55d8764f08ab",
                                        "entry_id": "ba443071-8c58-375e-9a37-970e7ea078f3",
                                        "glosses": [
                                            "Bred for aesthetic or decorative purposes."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "239ef5fd-2e9f-40e1-923c-37a78c973498",
                                                "sense_id": "75596418-e7aa-3852-b70c-55d8764f08ab",
                                                "text": "Those pine trees on the lawn are the fastest-growing ornamentals we could find."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ornamental",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa242b54-e024-32cc-b033-4ce6f53e6c1c",
                                        "entry_id": "ce78cb3d-f14b-3566-bb9b-2ec034b9e292",
                                        "glosses": [
                                            "An ornamental plant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87623b99-0fd0-48d0-bb4f-ae72fc08a66e",
                                                "sense_id": "aa242b54-e024-32cc-b033-4ce6f53e6c1c",
                                                "text": "The tumbleweed is a gracious gift from the Russians, having been imported as a favored ornamental from the steppes of central Asia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
