                "senses": [
                    {
                        "sense_id": "2769f691-5f56-32f6-bc88-31d855c2dd6c",
                        "entry_id": "51622870-45d0-3a83-a120-a816e8823962",
                        "glosses": [
                            "dotyczący kar, więźniów, więziennictwa"
