                        "glosses": [
                            "The act of benumbing, or state of being benumbed; torpor."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "ba0adb8f-acf0-4358-a6a9-2d35a2c94be1",
                                "sense_id": "c40df22b-6d97-344d-a9d9-f1c194e4ac25",
                                "text": "The first cold weather, after insects have entered their winter quarters, produces effects upon them similar to those which occur in the dormouse, hedgehog, and other of the larger animals subject to torpor. At first a partial benumbment takes place; but the insect if touched is still capable of moving its organs."
                            },
                            {
                                "example_id": "c8059e2e-59b3-456a-a4fc-188de295b63e",
                                "sense_id": "c40df22b-6d97-344d-a9d9-f1c194e4ac25",
                                "text": "The pain was electric and compact, reducing everything to its own sort of benumbment, making the world beyond my head seem small and dazed."
                            }
                        ]
                    }
                ],
