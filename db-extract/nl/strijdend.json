                                        "glosses": [
                                            "Engaged in war or other conflict."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a50c8ca4-f96d-351f-8a11-8f58053a604a",
                                        "entry_id": "987bf315-77c8-3a56-ae1e-499c5b42d3c7",
                                        "glosses": [
                                            "Apt to provoke a fight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8cf6592-cdeb-4c86-aa47-24f3f0ad129a",
                                                "sense_id": "a50c8ca4-f96d-351f-8a11-8f58053a604a",
                                                "text": "It seems like a fighting insult, but he explains."
                                            },
                                            {
                                                "example_id": "3df65cef-5c42-4321-b3a1-fe7862896ba5",
                                                "sense_id": "a50c8ca4-f96d-351f-8a11-8f58053a604a",
                                                "text": "Them's fighting words in my country!"
                                            },
                                            {
                                                "example_id": "fad944ab-b54a-49e2-a282-a3b1b5a6a942",
                                                "sense_id": "a50c8ca4-f96d-351f-8a11-8f58053a604a",
                                                "text": "Those are fighting words, of course, and the people who presently hold the high ground of economic power in society will not be amused."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fighting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34047fcd-7979-3ccf-bd5d-1c2f1c9ff70f",
                                        "entry_id": "3f01ece2-caed-34a0-8a12-64ecfd5fc727",
