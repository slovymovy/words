                "senses": [
                    {
                        "sense_id": "4d4b4c12-6c07-3cd8-8b54-a1e96061675d",
                        "entry_id": "30a2e342-2ac1-3927-a4ca-616ccc03f712",
                        "glosses": [
                            "The study of old or ancient forms of writing."
                        ],
                        "tags": [
                            "US",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "dd370e27-4e9e-41ee-aa6d-85ad9f8636aa",
                                "sense_id": "4d4b4c12-6c07-3cd8-8b54-a1e96061675d",
                                "text": "Paleography might teach men to read documents, diplomatics to date them and to test their authenticity; but the full significance of an ancient deed might easily escape the most exact paleographer and the most accomplished diplomatist, for the want of that finished sense for legal technicality which is the natural fruit of a conveyancing practice."
                            }
                        ]
                    },
                    {
                        "sense_id": "dbf43a31-8f5e-31d9-9280-dbd9326d3f7d",
                        "entry_id": "30a2e342-2ac1-3927-a4ca-616ccc03f712",
                        "glosses": [
                            "Ancient scripts or forms of writing themselves, as uncial, scriptio continua, or methods of using papyrus scrolls."
                        ],
                        "tags": [
                            "US",
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
