                        "examples": [
                            {
                                "example_id": "89a8d3da-9df9-40b2-9800-b7c34b0fb71a",
                                "sense_id": "f84409c5-09b4-3c61-8784-22b71f93ca4e",
                                "text": "Risicovolle banken gaan meer bijdragen aan een nieuw spaarfonds voor het depositogarantiestelsel dan minder risicovolle banken. Dit blijkt uit een voorstel dat het ministerie van Financiën vandaag openbaar heeft gemaakt."
                            },
                            {
                                "example_id": "ecacef0b-b022-4927-8759-e1ce07abbefb",
                                "sense_id": "f84409c5-09b4-3c61-8784-22b71f93ca4e",
                                "text": "Daarna ontstaat een financieel probleem. Om het complete binnenstadsplan af te kunnen ronden, is nog 25 miljoen euro nodig. In de herfst komt het college met een plan om aan dat geld te komen. Het gaat dan om een spaarfonds. Wethouder Jan van Marle (financiën) kan nog niet zeggen hoe dat fonds gevuld moet worden."
                            },
                            {
                                "example_id": "b7dc692c-f3f3-49ae-be5e-73fa99240fb4",
                                "sense_id": "f84409c5-09b4-3c61-8784-22b71f93ca4e",
                                "text": "Een bijna een kwart eeuw geleden opgezet Noors spaarfonds beschikt inmiddels over omgerekend 605 miljard euro. Dat uit olie- en gasinkomsten opgebouwde nationale spaarpotje bevat dus nu ruim 5,1 biljoen Noorse kronen. Dat is volgens meldingen van de centrale bank in Oslo vanaf vandaag een miljoen keer het aantal inwoners van het land."
                            }
                        ]
                    }
