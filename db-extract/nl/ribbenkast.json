                                "target_senses": [
                                    {
                                        "sense_id": "ba86efd2-27d3-3dec-ae6c-39c3d527b45c",
                                        "entry_id": "076f90d9-8fd4-3bac-84e9-8a069c659cfa",
                                        "glosses": [
                                            "vorderer Teil des Oberkörpers"
                                        ],
                                        "tags": [],
