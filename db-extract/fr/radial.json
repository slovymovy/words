                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b6a62579-9b3b-3926-a8e5-d3398920e492",
                                        "entry_id": "6ddfe0a9-dbc3-3399-8838-5a23ad53cb95",
                                        "glosses": [
                                            "Of, or relating to the radius (vein), and/or the wing areas next to it."
                                        ],
