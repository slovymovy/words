                ],
                "translations": [
                    {
                        "translation_id": "e13b0c6f-cda4-4fd7-a3ed-09d1d46090bd",
                        "source_entry_id": "c977c1bb-229a-3947-bba5-bf4b576a5f5e",
                        "target_lang_word": "Büttel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Büttel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "28cf21d5-135c-3f34-b2f1-968dd4a57a49",
                                        "entry_id": "551f456b-1b6b-3c29-bd95-84780843dad7",
                                        "glosses": [
                                            "Gerichtsdiener, Gerichtsbote"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcc47b09-d72b-4d49-8513-7207f50d2a85",
                                                "sense_id": "28cf21d5-135c-3f34-b2f1-968dd4a57a49",
                                                "text": "Wer seinen Kopf auf den Richtblock legte, fand relativ schnell den Tod; wen die Büttel auf das Rad flochten, starb erst, nachdem ihm jeder Knochen im Leib gebrochen war."
                                            },
                                            {
                                                "example_id": "83f79feb-6597-4868-ae7c-0df93d7b9ed9",
                                                "sense_id": "28cf21d5-135c-3f34-b2f1-968dd4a57a49",
                                                "text": "Über die im Mittelalter ebenfalls zu den Unehrlichen zählenden Scharfrichter, Henker und Büttel, so weist Wolf nach, kam das Rotwelsch in die städtischen Frauenhäuser, deren Beaufsichtigung im Mittelalter oft dem Henker oder Büttel anvertraut war."
                                            },
                                            {
                                                "example_id": "78b55196-280b-488d-8209-70c5d0e92e13",
                                                "sense_id": "28cf21d5-135c-3f34-b2f1-968dd4a57a49",
                                                "text": "„Als Mary und Pihan auch um 7.30 Uhr noch nicht eingetroffen waren, schickte das Gericht einen Büttel aus, der den Anwalt aufsuchen sollte.“"
                                            },
                                            {
                                                "example_id": "2b0ad291-c8f4-4c33-b35f-2df984ebbd48",
                                                "sense_id": "28cf21d5-135c-3f34-b2f1-968dd4a57a49",
                                                "text": "„Die Büttel mußten Tschö Dan und seine Genossen vorführen.“"
                                            },
                                            {
                                                "example_id": "6743aceb-ee92-41e3-90c6-6d4218e342d3",
                                                "sense_id": "28cf21d5-135c-3f34-b2f1-968dd4a57a49",
                                                "text": "„Dieser grimmigen Anschauung, der Folge des einzigen Fehlers, den die große Maria Theresia ›sub specie recti‹(unter dem Anschein des Rechtes) hatte, entsprangen alle Ungerechtigkeiten und alle Unterschlagungen, die von den Bütteln der Keuschheitskommissare begangen wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "37714a85-3d64-3257-8483-face7df9ecb3",
                                        "entry_id": "551f456b-1b6b-3c29-bd95-84780843dad7",
                                        "glosses": [
                                            "Polizist"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "717f5f12-13f3-4830-bf7e-8d7e3ea40925",
                                                "sense_id": "37714a85-3d64-3257-8483-face7df9ecb3",
                                                "text": "„Es genügten ein paar Dutzend Landsknechte und die Büttel der Stadt, um den Aufstand nicht eigentlich ›niederzuschlagen‹, wie es auf der Gedenktafel heißt, sondern zu ersticken, bevor die Tuchmacher die zusammengetragenen Waffen überhaupt in die Hand nahmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e522949b-0b74-369c-92bb-f78be0d1245c",
                                        "entry_id": "551f456b-1b6b-3c29-bd95-84780843dad7",
                                        "glosses": [
                                            "Person, die zu niedrigen Diensten missbraucht wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1502efe5-0181-429d-b9b2-48a3fbdb8e48",
                                                "sense_id": "e522949b-0b74-369c-92bb-f78be0d1245c",
                                                "text": "„Unzucht war ein Begriff, mit dem die Kirche sich den Staat zum Büttel gemacht hatte: Denn die christliche Lustfeindlichkeit, die Geschlechtsverkehr nur zur Zeugung und nur innerhalb der Ehe für propagierungswürdig erachtete (was sich ja bis heute in die Abtreibungsdebatte fortsetzt), duldete keine Darstellung von Geschlechtlichkeit als Selbstzweck.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
