{
    "word_family": [
        "слабоумие"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d9bce34a-4cff-3f08-a0e9-0bde28d50d51",
                    "sense_definition": "страдающий психическим расстройством или снижением интеллекта",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental_disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач отметил, что пациент выглядит <w>слабоумным</w> из-за прогрессирующей болезни.",
                            "target_lang_translations": {
                                "en": "The doctor noted that the patient appears <w>demented</w> due to a progressive illness."
                            }
                        },
                        {
                            "text": "Даже <w>слабоумный</w> человек нуждается в заботе и уважении со стороны общества.",
                            "target_lang_translations": {
                                "en": "Even a <w>mentally disabled</w> person needs care and respect from society."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Suffering from a mental disorder or a decline in intellectual capacity."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "demented",
                                "target_lang_sense_clarification": "suffering from dementia or mental decline"
                            },
                            {
                                "target_lang_word": "mentally disabled",
                                "target_lang_sense_clarification": "having a cognitive impairment"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b446062-8372-3c46-b340-516c6ae96c4f",
                    "sense_definition": "глупый, недалекий или ограниченный в умственном развитии",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stupidity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его поведение казалось окружающим совершенно <w>слабоумным</w> и нелогичным.",
                            "target_lang_translations": {
                                "en": "His behavior seemed completely <w>feeble-minded</w> and illogical to those around him."
                            }
                        },
                        {
                            "text": "Он был крайне <w>слабоумен</w> и не мог понять простых вещей.",
                            "target_lang_translations": {
                                "en": "He was extremely <w>dim-witted</w> and could not understand simple things."
                            }
                        }
                    ],
                    "synonyms": [
                        "дурак"
                    ],
                    "antonyms": [
                        "мудрый"
                    ],
                    "target_lang_definitions": {
                        "en": "Stupid, narrow-minded, or limited in intellectual development."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "feeble-minded",
                                "target_lang_sense_clarification": "lacking intelligence or common sense"
                            },
                            {
                                "target_lang_word": "dim-witted",
                                "target_lang_sense_clarification": "slow to understand or stupid"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f864d7cf-b534-33fb-9993-c0af542beca0",
                    "sense_definition": "человек, страдающий слабоумием",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental_disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом учреждении содержатся как пожилые люди, так и <w>слабоумные</w>.",
                            "target_lang_translations": {
                                "en": "This institution houses both elderly people and <w>those with dementia</w>."
                            }
                        },
                        {
                            "text": "Общество должно создавать условия для интеграции, в том числе для <w>слабоумных</w>.",
                            "target_lang_translations": {
                                "en": "Society must create conditions for integration, including for <w>the mentally disabled</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
