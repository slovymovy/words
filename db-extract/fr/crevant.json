                "senses": [
                    {
                        "sense_id": "1c459786-2c90-37b7-b357-f42dd502a539",
                        "entry_id": "120de703-8795-38ae-a66c-b948c7589e46",
                        "glosses": [
                            "Qui crève (quelqu’un) de fatigue, épuisant, fatigant."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "9889e1ab-cced-4b51-8afa-bf4efc9bf9e0",
                                "sense_id": "1c459786-2c90-37b7-b357-f42dd502a539",
                                "text": "Cette journée de travail était crevante."
                            },
                            {
                                "example_id": "8f056a75-4fbd-4780-a594-25a4c9a083c7",
                                "sense_id": "1c459786-2c90-37b7-b357-f42dd502a539",
                                "text": "— Mais je suis à la disposition de madame et de mademoiselle, répondit Sainte-Austreberthe, qui partageait complètement l’avis de M. de Mériolle et qui trouvait que c’était là une promenade crevante."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd83bbed-7547-3eb6-a0d0-e2831e03b384",
                        "entry_id": "120de703-8795-38ae-a66c-b948c7589e46",
                        "glosses": [
                            "Qui fait crever de rire, très drôle."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "dd5a51a5-ce32-4eb8-8dc7-cee896d68331",
                                "sense_id": "dd83bbed-7547-3eb6-a0d0-e2831e03b384",
                                "text": "J’ai menti : l’histoire du passe-boules, tout de même, sans charre, voyons ! c’est une bonne histoire, une histoire crevante."
                            }
                        ]
                    }
                ],
