                                "example_id": "bc8757cf-a820-401c-9732-c2a13f481f05",
                                "sense_id": "b593025c-ffc5-3a1e-afb0-cb71fb2c25bb",
                                "text": "„Ein Pilotversuch mit neuer Bodenmarkierung, die die Farbe je nach Temperatur wechselt, ist in der Steiermark angelaufen.“"
                            },
                            {
                                "example_id": "dccd75d3-964c-428e-8e93-c01428a2916f",
                                "sense_id": "b593025c-ffc5-3a1e-afb0-cb71fb2c25bb",
                                "text": "„Das Amt für Straßenbau und Erschließung brachte auf dem Pflaster dafür eigens eine Bodenmarkierung an – „in der Liebfrauenstraße zwischen der dritten und der vierten Baumscheibe von Süden\".“"
                            }
                        ],
