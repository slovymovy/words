                ],
                "senses": [
                    {
                        "sense_id": "46824b05-0b53-3e53-b328-c37f70e3892a",
                        "entry_id": "7e9e0098-7949-3eab-90fe-7be0405a2961",
                        "glosses": [
                            "die Entfernung eines oder mehrerer Elektronen aus einem Atom, Molekül oder Molekülketten durch Energiezufuhr in Luft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "decc88f1-4488-496c-8fc2-6c2211a90b20",
                                "sense_id": "46824b05-0b53-3e53-b328-c37f70e3892a",
                                "text": "„Staubemissionen werden durch die Luftionisation nicht beeinflusst.“"
                            },
                            {
                                "example_id": "43b116bd-cc4d-4673-accf-c8fece136a31",
                                "sense_id": "46824b05-0b53-3e53-b328-c37f70e3892a",
                                "text": "„Andererseits gibt es Hinweise darauf, dass Luftionisation zu verstärktem nächtlichen Husten führt, was gegen den Einsatz bei Lungenerkrankungen spricht.“"
                            },
                            {
                                "example_id": "a2f6d3b1-ccb7-47a4-9414-220f72ef2daa",
                                "sense_id": "46824b05-0b53-3e53-b328-c37f70e3892a",
                                "text": "„Die Luftionisation entsteht durch Strahlung natürlicher künstlicher radioaktiver Stoffe, durch kosmische Strahlung sowie UV-Strahlung.“"
                            },
                            {
                                "example_id": "d752950a-84bd-41bb-a8d1-a30fad898f1a",
                                "sense_id": "46824b05-0b53-3e53-b328-c37f70e3892a",
                                "text": "„In kritischen Umgebungen ist aktive Luftionisation die ideale Methode zur Kontrolle und Neutralisierung elektrostatischer Ladungen.“"
                            },
                            {
                                "example_id": "5e50d0cd-b4fb-43a9-987a-861acdc77883",
                                "sense_id": "46824b05-0b53-3e53-b328-c37f70e3892a",
                                "text": "„Zahlreiche Autoren haben in ihren Publikationen die komplexe Thematik der Luftionisation beschrieben und Hersteller von Ionisatoren bemühten sich, ihren Produkten durch werbewirksame Abhandlungen biologische Wirkungen nachzusagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
