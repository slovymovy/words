                "senses": [
                    {
                        "sense_id": "9b23bb79-ce08-3b6a-b8d3-bca9644fda43",
                        "entry_id": "46d9ed07-a76f-395d-ad4d-462bfbe54290",
                        "glosses": [
                            "Menge an Luft, die beim Atmen ein- oder ausgeatmet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94417e7b-d011-46d4-b030-95003ebdb038",
                                "sense_id": "9b23bb79-ce08-3b6a-b8d3-bca9644fda43",
                                "text": "„Kinder unter 5 Jahren haben ein geringeres Atemvolumen (3 bis 4 l/min) als Erwachsene (6 bis 8 l/min), so dass bei gleichem Kompressorfluss (6 bis 8 l/min) die tatsächlich inhalierte Dosis gegenüber den Erwachsenen in etwa halbiert ist.“"
                            },
                            {
                                "example_id": "94f57eb9-b150-47d1-a3b1-1695cdd31470",
                                "sense_id": "9b23bb79-ce08-3b6a-b8d3-bca9644fda43",
                                "text": "„Im Alltag nutzen die meisten Menschen nur einen Bruchteil ihres Atemvolumens, das bei Gesunden mehr als sechs Liter beträgt.“"
                            },
                            {
                                "example_id": "c150e0cc-a465-455d-86e8-d20314e51cd7",
                                "sense_id": "9b23bb79-ce08-3b6a-b8d3-bca9644fda43",
                                "text": "„Bei der Spiroergometrie wird das Atemvolumen sowie die Menge an aufgenommenem Sauerstoff (O2) und die abgeatmete Menge an Kohlendioxid (CO2) unter Belastung gemessen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
