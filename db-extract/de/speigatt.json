                "senses": [
                    {
                        "sense_id": "a80eb429-aa32-3730-b1f8-522078a456dd",
                        "entry_id": "ee32f03e-c557-35c8-ab18-c222f6ebc7fb",
                        "glosses": [
                            "Ablauf auf einem Schiffsdeck, durch den das Wasser nach Außenbord oder in die Bilge ablaufen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f443e7a-fd5f-4c11-8a45-5cafdf7644ab",
                                "sense_id": "a80eb429-aa32-3730-b1f8-522078a456dd",
                                "text": "„Man hatte nur zwei Mann als Wache an Bord zurückgelassen, und alle beide lagen total betrunken im Speigatt.“"
                            },
                            {
                                "example_id": "63423c01-286f-4eab-8318-2b1537efa6e3",
                                "sense_id": "a80eb429-aa32-3730-b1f8-522078a456dd",
                                "text": "„Als der Fremde nah genug herangekommen war, sahen wir, dass er pumpte, da unablässig Wasser aus dem Speigatt lief.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "495bf3a3-09bd-49e5-9b51-a5cd06db7d1f",
                        "source_entry_id": "ee32f03e-c557-35c8-ab18-c222f6ebc7fb",
                        "source_sense_id": "a80eb429-aa32-3730-b1f8-522078a456dd",
                        "target_lang_word": "scupper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scupper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84e93d99-7cd0-30e8-bd64-eebb2129f341",
                                        "entry_id": "eda0f888-9b0b-3b4a-b693-691be7b18728",
                                        "glosses": [
                                            "A drainage hole on the deck of a ship."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c054d02-7979-38c6-b2fd-0cc055a682f5",
                                        "entry_id": "eda0f888-9b0b-3b4a-b693-691be7b18728",
                                        "glosses": [
                                            "A similar opening in a wall or parapet that allows water to drain from a roof."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1e00517-0cfc-41bd-ad3b-3ec6fffb6c2e",
                                                "sense_id": "0c054d02-7979-38c6-b2fd-0cc055a682f5",
                                                "text": "I have said that our roof was decidedly Biblical in style; but to make it a dry one, something of a nautical character was added to its architecture, for on either side were scuppers, and it was slightly arched in the centre[.]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scupper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35491bdc-3dd4-394d-8f8f-b783503ad8d4",
                                        "entry_id": "374aa621-dca8-3262-bc47-516b295eb693",
                                        "glosses": [
                                            "To thwart or destroy, especially something belonging or pertaining to another."
                                        ],
                                        "tags": [
                                            "UK",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f060adbe-5777-4a46-9be2-883bf9f72146",
                                                "sense_id": "35491bdc-3dd4-394d-8f8f-b783503ad8d4",
                                                "text": "The bad media coverage scuppered his chances of being elected."
                                            },
                                            {
                                                "example_id": "77a89d9f-b9d7-42af-a83b-fce4c312889a",
                                                "sense_id": "35491bdc-3dd4-394d-8f8f-b783503ad8d4",
                                                "text": "[\"]The only chance was to get the guns and try a rescue. Of course they may scupper them at once in revenge.[\"]"
                                            },
                                            {
                                                "example_id": "03ac9fd6-ce22-499c-a631-34b40988f780",
                                                "sense_id": "35491bdc-3dd4-394d-8f8f-b783503ad8d4",
                                                "text": "This is the face of American exceptionalism[…] threatening to scupper both the court and, failing that, UN peace-keeping operations in Bosnia and anywhere else the US might have forces deployed on such work."
                                            },
                                            {
                                                "example_id": "2f028d9f-9dd8-4fd1-a9b0-03d436c9826b",
                                                "sense_id": "35491bdc-3dd4-394d-8f8f-b783503ad8d4",
                                                "text": "Anthony Watson’s late interception and Owen Farrell’s 100% kicking contribution also helped scupper the Wallabies, despite the promise of their exciting new centre Jordan Petaia and the roadrunner pace of winger Marika Koroibete."
                                            },
                                            {
                                                "example_id": "abc139a3-5a82-4790-a66f-0b65f23d3cfa",
                                                "sense_id": "35491bdc-3dd4-394d-8f8f-b783503ad8d4",
                                                "text": "Pacers should have all been withdrawn by now, but that has been scuppered by a failure to deliver new trains on time and delays to infrastructure projects. The most high-profile withdrawals were to be Northern's Class 142s and '144s' (the latter by the end of 2018, and the '142s' by the end of last year)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7327fed-3f8c-4894-86c8-b427c9dfd1fd",
                        "source_entry_id": "ee32f03e-c557-35c8-ab18-c222f6ebc7fb",
                        "source_sense_id": "a80eb429-aa32-3730-b1f8-522078a456dd",
                        "target_lang_word": "dalot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dalot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "475d8a43-e3fc-3de7-a0b0-639ada660ad9",
                                        "entry_id": "2dcb9791-a4ee-38d9-98ba-cef89d29c4ce",
                                        "glosses": [
                                            "Trou, canal pour faire écouler les eaux hors du navire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f377be53-8c9e-4274-be97-fb320ab5eef0",
                                                "sense_id": "475d8a43-e3fc-3de7-a0b0-639ada660ad9",
                                                "text": "Il y a plusieurs dalots à chaque bord."
                                            },
                                            {
                                                "example_id": "ae85aa2d-d047-4960-aa91-48d76e1c7e77",
                                                "sense_id": "475d8a43-e3fc-3de7-a0b0-639ada660ad9",
                                                "text": "Le pont se remplissait, à chaque plongeon, et la nappe liquide, ne trouvant pas par les dalots un assez rapide écoulement, pouvait submerger le navire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5706fcd9-d4a9-3add-ab18-dc454643cd38",
                                        "entry_id": "2dcb9791-a4ee-38d9-98ba-cef89d29c4ce",
                                        "glosses": [
                                            "Conduit maçonné permettant l'écoulement des eaux d'un remblai le long d'une route, d'une voie ferrée, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6150dfae-059c-4099-b200-bb5efbecbff1",
                                                "sense_id": "5706fcd9-d4a9-3add-ab18-dc454643cd38",
                                                "text": "Bélanger entreprit alors d'installer un dalot qui passerait au centre d'une talle d'érables à sucre."
                                            },
                                            {
                                                "example_id": "e23bf296-dde5-4a47-a1f5-8041d2a207fd",
                                                "sense_id": "5706fcd9-d4a9-3add-ab18-dc454643cd38",
                                                "text": "“C’est un problème au niveau d’un dalot bouché par des déchets verts et autres détritus, accentué par la pluie, alors l’eau pluviale est passée sur la route, déformant la chaussée à certains endroits.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c80926bc-8d20-32d8-a527-61785f40fb5b",
                                        "entry_id": "2dcb9791-a4ee-38d9-98ba-cef89d29c4ce",
                                        "glosses": [
                                            "Sorte de gouttière située de chaque côté d’une allée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
