                "senses": [
                    {
                        "sense_id": "61992b4b-6911-3fdc-ab17-ab36bfeaba8f",
                        "entry_id": "cf08a24d-6f45-3061-b3fc-5e55560fea64",
                        "glosses": [
                            "муз. музыкальный инструмент, обечайка, обтянутая сухой выделки кожей, с колокольцами, бубенчиками"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ffe3db8-c4bd-48b8-ac3b-2309b326f8d1",
                                "sense_id": "61992b4b-6911-3fdc-ab17-ab36bfeaba8f",
                                "text": ".. под звуки бубна и песни шаманов якуты встречают первое солнце Нового года."
                            }
                        ]
                    },
                    {
                        "sense_id": "56dff89e-658d-3be9-ac41-afa2dd44f592",
                        "entry_id": "cf08a24d-6f45-3061-b3fc-5e55560fea64",
                        "glosses": [
                            "перен., разг., пренебр. лицо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0561d59d-5c10-42b3-9c9c-c18e3fa89305",
                                "sense_id": "56dff89e-658d-3be9-ac41-afa2dd44f592",
                                "text": "Именно тогда я и пообещал, что дам в бубен тому, кто будет бузить."
                            }
                        ]
                    }
                ],
