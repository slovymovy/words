{
    "word_family": [
        "stashing",
        "stashed",
        "stasher"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "35107e4a-6a6a-3fa7-a66e-62a3cfbb4573",
                    "sense_definition": "To hide or store something away in a safe or secret place for later use.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>stash</w> his liquor in the cabinet under the bar where no one would find it.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>припрятать</w> выпивку в шкафчике под барной стойкой, где её никто не найдет."
                            }
                        },
                        {
                            "text": "The squirrel will <w>stash</w> away food during the autumn to prepare for the long winter.",
                            "target_lang_translations": {
                                "ru": "Белка будет <w>делать запасы</w> еды осенью, чтобы подготовиться к долгой зиме."
                            }
                        }
                    ],
                    "synonyms": [
                        "hive up"
                    ],
                    "common_phrases": [
                        "stash away food",
                        "stash some cash"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спрятать или сохранить что-либо в надежном или секретном месте для последующего использования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "припрятывать",
                                "target_lang_sense_clarification": "прятать тайком"
                            },
                            {
                                "target_lang_word": "ныкать",
                                "target_lang_sense_clarification": "разговорное, прятать"
                            },
                            {
                                "target_lang_word": "заначивать",
                                "target_lang_sense_clarification": "откладывать про запас"
                            }
                        ]
                    }
                }
            ]
        },
        {
