                    {
                        "translation_id": "60a077d0-6fb3-4626-8c71-87ca573d6929",
                        "source_entry_id": "40d2e494-0afc-3cab-a8b7-6288d2c3aaea",
                        "source_sense_id": "850e68c6-0d07-30b8-a85e-cb1be4ef3700",
                        "source_sense_description": "unit of surface area",
                        "target_lang_word": "Hektar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hektar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73af3b96-e45d-317f-9487-837b3c4394bc",
                                        "entry_id": "83cef08b-323c-3736-aaaa-249012798e96",
                                        "glosses": [
                                            "Flächenmaß, das 100 Ar oder 10 000 Quadratmetern entspricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93b8fa75-d218-4e30-a2de-696dc570f464",
                                                "sense_id": "73af3b96-e45d-317f-9487-837b3c4394bc",
                                                "text": "Sie wollte dasselbe und fünfhundert Hektar des umliegenden Landes bis zu ihrem Lebensende für sich behalten. (Max Eyth: Der Tartarenrebell hinter dem Dampfpflug)"
                                            },
                                            {
                                                "example_id": "6cee6fa9-b2fd-4700-8406-4db31dc04fc5",
                                                "sense_id": "73af3b96-e45d-317f-9487-837b3c4394bc",
                                                "text": "„Neben den handelsüblichen sächsischen Weinen bietet er eine selbstgekelterte Hausmarke an, die auf seinem etwa einen Hektar großen Weinberg gleich hinter seinem Gasthof reift.“"
                                            },
                                            {
                                                "example_id": "ca249e60-32af-44dc-8e4e-882fa72cd9e3",
                                                "sense_id": "73af3b96-e45d-317f-9487-837b3c4394bc",
                                                "text": "„Die Artenvielfalt soll hier auf einem Hektar höher sein als in ganz Europa.“"
                                            },
                                            {
                                                "example_id": "aed17d8d-c8d7-48f3-84b8-adb1fd1ca617",
                                                "sense_id": "73af3b96-e45d-317f-9487-837b3c4394bc",
                                                "text": "„Es bestehe aus einem Pachthof von achtunddreißig Hektar mit einer Art Schloß und einem sehr ertragreichen Garten.“"
                                            },
                                            {
                                                "example_id": "d3d32c1b-6460-44bd-8611-f1e253bc5b0b",
                                                "sense_id": "73af3b96-e45d-317f-9487-837b3c4394bc",
                                                "text": "„Der Stablack ist eine weitläufige, hügelige Landschaft, in die hinein zehn Jahre zuvor, 1934, ein riesiger Truppenübungsplatz mit einer Fläche von 10000 Hektar gebaut worden war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
