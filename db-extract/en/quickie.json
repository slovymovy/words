                        ],
                        "examples": [
                            {
                                "example_id": "0428c74a-6d04-49c0-97bd-9b8f2a796d1c",
                                "sense_id": "67f8ed66-84c1-38fb-844f-00ba9ec57be4",
                                "text": "We had a quickie; I didn’t come & was only telling of the future where there was better bed fucks & us living contentedly as we walked slowly across town again to her home."
                            },
                            {
                                "example_id": "3cd25128-2ed9-4731-aded-ae62f2d4f2bb",
                                "sense_id": "67f8ed66-84c1-38fb-844f-00ba9ec57be4",
                                "text": "Why talk about courtly love [l'amour courtois]^([sic]) today, in an age of permissiveness when the sexual encounter is often nothing more than a ‘quickie’ in some dark corner of an office?"
                            }
                        ]
