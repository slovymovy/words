                        "tags": [],
                        "examples": [
                            {
                                "example_id": "deb281bc-b8e3-49f6-a9ef-6dec3658aca5",
                                "sense_id": "d540f449-a138-3ec0-9fff-392e4dcb2dbd",
                                "text": "„Die Trauertage waren vorbei.“"
                            },
                            {
                                "example_id": "64c67ae9-d830-4641-a438-13697ef2ee51",
                                "sense_id": "d540f449-a138-3ec0-9fff-392e4dcb2dbd",
                                "text": "„Pir Pagaro VII. starb am 10. Januar 2012 in einem Londoner Krankenhaus. In ganz Sindh wurde der 12. Januar zum Trauertag erklärt, an dem öffentliche Einrichtungen geschlossen blieben.“"
                            }
                        ],
