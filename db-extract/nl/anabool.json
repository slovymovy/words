                                "example_id": "464e3cff-393b-4751-b816-55f3256498cd",
                                "sense_id": "0bda6905-a65c-3474-a81f-2ff5efcf94bf",
                                "text": "Het wijdverspreid gebruik van anabole steroïden in de sport heeft tot grote opschudding geleid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b247223-6689-4488-8183-ef0cd18b75ce",
