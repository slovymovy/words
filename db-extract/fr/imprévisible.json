                                            {
                                                "example_id": "530145fa-8772-4529-a4f1-c5f5e0472190",
                                                "sense_id": "d388fe26-a9cb-3867-9f26-7e697d6bad47",
                                                "text": "Sharks are not unpredictable; for the most part, they do exactly what an apex predator is expected to do."
                                            }
