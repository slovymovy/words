                    "target_lang_definitions": {
                        "en": "To give a spoken or written account of real or imagined events.",
                        "ru": "Передавать словами реальные или вымышленные события.",
                        "nl": "Een echte of verzonnen gebeurtenis in woorden aan iemand overbrengen.",
                        "de": "Tatsächliche oder erfundene Ereignisse mündlich oder schriftlich wiedergeben.",
                        "pl": "Przedstawiać słowami prawdziwe lub zmyślone wydarzenia, opowiadać o nich.",
                        "it": "Esporre a voce o per iscritto fatti reali o immaginari.",
                        "cs": "Vyprávět o skutečných nebo smyšlených událostech ústně nebo písemně.",
                        "tr": "Gerçek ya da hayali olayları sözlü veya yazılı olarak aktarmak.",
                        "es": "Explicar oralmente o por escrito hechos reales o imaginarios.",
                        "zh": "用语言叙述真实或虚构的事件。"
                    },
