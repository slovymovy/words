        "zh-extract.jsonl": [
            {
                "entry_id": "4822e592-8e84-3e59-b274-dbe283f8954b",
                "word": "quinoa",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7c7fad71-f397-4030-a873-aad850a3d71f",
                        "entry_id": "4822e592-8e84-3e59-b274-dbe283f8954b",
                        "tags": [
                            "plural"
                        ],
                        "form": "quinoas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3c77c505-ea01-3a40-a0e3-6361c0eb1212",
                        "entry_id": "4822e592-8e84-3e59-b274-dbe283f8954b",
                        "glosses": [
                            "藜麥（Chenopodium quinoa）"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb639c9e-1a7d-47d8-b92b-56f42e31b6a5",
                                "sense_id": "3c77c505-ea01-3a40-a0e3-6361c0eb1212",
                                "text": "Chenopodium quinoa Will, (quinoa) is native to the Andes, and the seeds are a staple grain in parts of South America. The newly formed Canadian Quinoa Association anticipated growing about 400 ha of quinoa annually (Anonymous 1992e).",
                                "translation": "藜麦 (Chenopodium quinoa Will) 原产于安第斯山脉，其种子是南美部分地区的主食。新成立的加拿大藜麦协会预计每年种植约400公顷藜麦 (匿名 1992e)。"
                            },
                            {
                                "example_id": "453fe160-d462-438e-ac99-a468b9b61f5d",
                                "sense_id": "3c77c505-ea01-3a40-a0e3-6361c0eb1212",
                                "text": "Quinoa was cultivated about 3,000 years ago in the Andes mountain region, and was the favored crop of the Incas, who used it as a sacred plant in rituals.",
                                "translation": "藜麦大约在3000年前于安第斯山脉地区开始种植，是印加人最喜欢的作物，他们将其用作祭祀仪式中的神圣植物。"
                            },
                            {
                                "example_id": "7f41924a-4486-4478-bddb-7f80757138ce",
                                "sense_id": "3c77c505-ea01-3a40-a0e3-6361c0eb1212",
                                "text": "The oldest archeological remains of domesticated quinoa date to 5000 BC (Tapia 1979).",
                                "translation": "已知最古老的藜麦驯化遗迹可追溯到公元前5000年 (Tapia 1979)。"
                            }
                        ]
                    },
                    {
                        "sense_id": "b9d84899-921d-3181-87d0-412740ad0793",
                        "entry_id": "4822e592-8e84-3e59-b274-dbe283f8954b",
                        "glosses": [
                            "藜麥種子"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdf6e590-c744-4192-9dd1-6e3b604cf485",
                                "sense_id": "b9d84899-921d-3181-87d0-412740ad0793",
                                "text": "Turn the heat up to medium-high, add the quinoa, and sprinkle with salt and pepper.",
                                "translation": "将火调至中高火，加入藜麦，撒上盐和胡椒粉。"
                            },
                            {
                                "example_id": "9faaa3e0-338d-482d-b895-6981b6de94a4",
                                "sense_id": "b9d84899-921d-3181-87d0-412740ad0793",
                                "text": "Quinoa is another of those foods that keeps getting miscategorized—everyone thinks it′s a grain, everyone uses it like a grain, but it′s actually a seed.",
                                "translation": "藜麦是另一种经常被错误归类的食物——所有人都认为它是谷物，所有人都像对待谷物一样使用它，但它实际上是一种种子。"
                            },
                            {
                                "example_id": "c7a045e8-eefc-4e3c-a116-aabffddc1b32",
                                "sense_id": "b9d84899-921d-3181-87d0-412740ad0793",
                                "text": "To use quinoa in a salad, spread it on a platter or baking sheet after cooking to allow it to cool and, more importantly, dry. Cooked quinoa can be stored in an airtight container in the refrigerator for up to 5 days.",
                                "translation": "藜麦煮熟后，若要用于沙拉，应将其平铺在盘子或烤盘上，待其冷却，更重要的是使其干燥。煮熟的藜麦可置于密封容器中，在冰箱冷藏保存最多5天。"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ]
    }
