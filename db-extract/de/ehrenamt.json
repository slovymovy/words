                        "form": "die Ehrenämter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d99c540f-4e23-341c-80db-27238e80f5b4",
                        "entry_id": "3752c042-a301-3b29-b55a-8e83674e6034",
                        "glosses": [
                            "freiwilliges unentgeltliches Engagement in gesellschaftlich relevanten Bereichen, im engeren Sinne eine in den Statuten einer Organisation vorgesehene unbezahlte Position"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbced750-6cca-493b-8280-f6a2f2a2dfe8",
                                "sense_id": "d99c540f-4e23-341c-80db-27238e80f5b4",
                                "text": "Man findet leichter jemanden, der sein elftes Ehrenamt übernimmt, als jemanden, der sein erstes Ehrenamt übernimmt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "39590c94-4524-3600-ac15-d0eeeef2af35",
                        "entry_id": "3752c042-a301-3b29-b55a-8e83674e6034",
                        "glosses": [
                            "verpflichtendes Amt der Bürger als Schöffe oder Wahlhelfer (gegen Auszahlung einer angemessenen Aufwandsentschädigung)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4b0cefa-2640-4126-8520-18d33bb336a3",
                                "sense_id": "39590c94-4524-3600-ac15-d0eeeef2af35",
                                "text": "Man findet leichter jemanden, der sein elftes Ehrenamt übernimmt, als jemanden, der sein erstes Ehrenamt übernimmt."
                            },
                            {
                                "example_id": "b94a49cb-9c7b-4e83-93ea-23c9f709ec6a",
                                "sense_id": "39590c94-4524-3600-ac15-d0eeeef2af35",
                                "text": "Miriam hatte ein Ehrenamt als Wahlhelferin und war somit an diesem Wochenende in den Räumen der Grundschule anzutreffen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "beed9413-cf42-3ad6-a963-2019c2ad5094",
                        "entry_id": "3752c042-a301-3b29-b55a-8e83674e6034",
                        "glosses": [
                            "öffentliches unvergütetes Amt einer angesehenen Person in einer Organisation oder Institution, um die Autorität und Attraktivität selbiger zu stärken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53e3a39a-24e8-4729-9b88-432fcd483c3c",
                                "sense_id": "beed9413-cf42-3ad6-a963-2019c2ad5094",
                                "text": "Nach dem Skandal, in den er im Frühjahr verwickelt war, musste Hubert N. zwar alle seine Ehrenämter aufgeben, aber dem Schützenverein fühlt er sich nach wie vor sehr verbunden."
                            },
                            {
                                "example_id": "42b6b59d-011d-4ccb-991a-191f0f84734f",
                                "sense_id": "beed9413-cf42-3ad6-a963-2019c2ad5094",
                                "text": "Nach Ihrem starken Engagement in der erfolgreichen UNICEF-Sommerkampagne 2003 übernimmt nun auch Frau Christiane Hörbiger das Ehrenamt als UNICEF-Botschafterin."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
