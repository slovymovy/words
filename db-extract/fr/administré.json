                "senses": [
                    {
                        "sense_id": "d737eec2-cd90-3517-a106-171a753d008f",
                        "entry_id": "80e918fe-fae8-3803-be7f-43fdfdbc2933",
                        "glosses": [
                            "Citoyen, relativement à ceux qui régissent la subdivision administrative."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d87d1e02-d917-4c24-a542-4764cae7eb93",
                                "sense_id": "d737eec2-cd90-3517-a106-171a753d008f",
                                "text": "[…], et le lendemain il faisait signer à son Conseil municipal d’abord, à ses administrés ensuite, une pétition contre cet imbécile de maître d’école qu’il fallait absolument et au plus vite faire f… le camp du pays."
                            },
                            {
                                "example_id": "5055f5bf-6c82-452f-bcd1-fa18ae35600a",
                                "sense_id": "d737eec2-cd90-3517-a106-171a753d008f",
                                "text": "Monsieur Josèphe, observe le maire, je ne suis pas plus tendeur que vous ; je fais même partie d’une société protectrice des animaux, mais je dois veiller aux intérêts de mes administrés et en discuter sans parti-pris."
                            },
                            {
                                "example_id": "866edb47-57b9-4513-9b71-d687aeb0d0d6",
                                "sense_id": "d737eec2-cd90-3517-a106-171a753d008f",
                                "text": "L’article R. 312-8 du CRPA impose à l’administration de mettre en ligne les circulaires sur le site internet du Premier ministre circulaires.gouv.fr. A défaut, l’administration ne peut se prévaloir à l’égard des administrés de la circulaire, qui n’est ainsi pas applicable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5497b599-18db-411b-b07b-1238861762e8",
                        "source_entry_id": "80e918fe-fae8-3803-be7f-43fdfdbc2933",
                        "source_sense_id": "d737eec2-cd90-3517-a106-171a753d008f",
                        "target_lang_word": "constituent",
