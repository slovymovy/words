                "senses": [
                    {
                        "sense_id": "ed9f60d3-3e51-3cea-9f7e-729ea98cf2ab",
                        "entry_id": "1a0026ef-533d-3d94-a306-28ab450b9e01",
                        "glosses": [
                            "In der christlichen Kultur aufgewachsene Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a409a3f-584a-4489-b497-7e4e8e1ca95f",
                                "sense_id": "ed9f60d3-3e51-3cea-9f7e-729ea98cf2ab",
                                "text": "Die meisten Europäer, egal ob religiös oder nicht, sind Kulturchristen."
                            },
                            {
                                "example_id": "2e8b0e51-b854-4a7f-b9cf-d18813944038",
                                "sense_id": "ed9f60d3-3e51-3cea-9f7e-729ea98cf2ab",
                                "text": "„Weil man Klassiker-Texte „genital“ sprechen müsse, weihevoll, von unten her. „Dem kann kein abendländischer Kulturchrist sich entziehen, der geht ins Theater, und dann hält er wieder zwei Wochen durch.“ Was macht ein Clown mit einem deutschen Drama?“"
                            },
                            {
                                "example_id": "41703f52-10ec-4bdd-b7c5-d29eb26212a9",
                                "sense_id": "ed9f60d3-3e51-3cea-9f7e-729ea98cf2ab",
                                "text": "„Als Kulturchrist, Verehrer Jesu und Suchender besuche ich aber nicht selten die Heilige Messe.“"
                            },
                            {
                                "example_id": "98ef9746-b4c6-4eaf-9145-0e31631ee7da",
                                "sense_id": "ed9f60d3-3e51-3cea-9f7e-729ea98cf2ab",
                                "text": "„Mir als bloßem Kulturchrist ist es nicht möglich, für die Auferstehung einzutreten, aber das christliche Familienbild unterstütze ich nachdrücklich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
