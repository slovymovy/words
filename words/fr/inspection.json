                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "administration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur de l'école s'est rendu à l'<w>inspection</w> pour déposer les dossiers administratifs."
