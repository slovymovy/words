{
    "word_family": [
        "rumor",
        "rumormonger",
        "rumoured"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2c5ee85a-1e0c-39cc-a3aa-5c63b2a26e6c",
                    "sense_definition": "A piece of information or a story that is passed from person to person but has not yet been proven to be true.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a persistent <w>rumour</w> going around that the company will close next month.",
                            "target_lang_translations": {
                                "ru": "Ходит упорный <w>слух</w>, что компания закроется в следующем месяце."
                            }
                        },
                        {
                            "text": "The <w>rumour</w> had it that she was planning to resign, but she denied everything.",
                            "target_lang_translations": {
                                "ru": "Ходили <w>слухи</w>, что она планирует уйти в отставку, но она всё отрицала."
                            }
                        }
                    ],
                    "synonyms": [
                        "hearsay",
                        "gossip",
                        "whisper"
                    ],
                    "antonyms": [
                        "fact",
                        "truth",
                        "certainty"
                    ],
                    "common_phrases": [
                        "rumour had it",
                        "spread a rumour",
                        "vicious rumour",
                        "false rumour"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British, Canadian, Australian, and New Zealand spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Информация или история, передаваемая от человека к человеку, истинность которой еще не доказана."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слух",
                                "target_lang_sense_clarification": "неподтвержденная информация"
                            },
                            {
                                "target_lang_word": "молва",
                                "target_lang_sense_clarification": "общественное мнение или слухи"
                            },
                            {
                                "target_lang_word": "сплетня",
                                "target_lang_sense_clarification": "слух о чьей-то личной жизни"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8782240b-5c59-395a-b5db-268cae78e344",
                    "sense_definition": "A low, continuous, and indistinct sound or noise, often like a distant murmur or bustle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I heard a bustling <w>rumour</w> like a fray coming from the city square.",
                            "target_lang_translations": {
                                "ru": "Я услышал оживленный <w>гул</w>, похожий на шум потасовки, доносившийся с городской площади."
                            }
                        },
                        {
                            "text": "The distant <w>rumour</w> of the crowd grew louder as we approached the stadium.",
                            "target_lang_translations": {
                                "ru": "Отдаленный <w>гул</w> толпы становился громче по мере того, как мы приближались к стадиону."
                            }
                        }
                    ],
                    "synonyms": [
                        "murmur",
                        "din",
                        "clamour"
                    ],
                    "common_phrases": [
                        "bustling rumour"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature to describe noise"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Низкий, непрерывный и невнятный звук или шум, часто напоминающий отдаленный гул или суету."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гул",
                                "target_lang_sense_clarification": "отдаленный шум толпы или города"
                            },
                            {
                                "target_lang_word": "ропот",
                                "target_lang_sense_clarification": "негромкий шум голосов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f38fcc0b-068b-3eea-9e35-4346dbdb4fb7",
                    "sense_definition": "To report or spread something as a <w>rumour</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reporting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was <w>rumoured</w> that the two actors were secretly married in Italy.",
                            "target_lang_translations": {
                                "ru": "<w>Поговаривали</w>, что эти два актера тайно поженились в Италии."
                            }
                        },
                        {
                            "text": "People are <w>rumouring</w> that the old house on the hill is haunted.",
                            "target_lang_translations": {
                                "ru": "Люди <w>распускают слухи</w>, что в старом доме на холме водятся привидения."
                            }
                        }
                    ],
                    "synonyms": [
                        "gossip",
                        "suggest",
                        "whisper"
                    ],
                    "common_phrases": [
                        "widely rumoured",
                        "rumoured to be"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British, Canadian, Australian, and New Zealand spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сообщать или распространять что-либо в качестве слуха."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ходить (о слухах)",
                                "target_lang_sense_clarification": "о распространении информации"
                            },
                            {
                                "target_lang_word": "поговаривать",
                                "target_lang_sense_clarification": "неофициально обсуждать что-то"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}