                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b71c21d-5132-437c-b6f7-b5ca22a90c62",
                                "sense_id": "a77fea54-a7da-3edb-b4a2-029a3a56b778",
                                "text": "Выгладил ветер море ― холодным стеклом лежит, а звёзды дрожат и в нём."
                            }
                        ]
                    }
