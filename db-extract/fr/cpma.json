                "forms": [],
                "senses": [
                    {
                        "sense_id": "554211fe-2e88-3c77-aeb0-97b8cb2008e9",
                        "entry_id": "264e2e2e-9425-36d7-9d32-14e5c66a2830",
                        "glosses": [
                            "En France, cotisation payée par les pêcheurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b439ea27-c086-4501-b6e5-464fd8e0e923",
                                "sense_id": "554211fe-2e88-3c77-aeb0-97b8cb2008e9",
                                "text": "En prenant une carte de pêche, chaque pêcheur adhère automatiquement à une Association Agréée pour la Pêche et la Protection du Milieu Aquatique (AAPPMA) et acquitte par la même occasion la Cotisation Pêche et Milieu Aquatique (CPMA)."
                            },
                            {
                                "example_id": "8f57e179-83d5-4263-afa0-9b51c622f2ff",
                                "sense_id": "554211fe-2e88-3c77-aeb0-97b8cb2008e9",
                                "text": "Aucun remboursement ne sera possible si la commande est effectuée depuis un compte adhérent différent de celui comportant la CPMA annuelle."
                            },
                            {
                                "example_id": "b3b57507-4c8d-4875-a2e9-f47ade5c165d",
                                "sense_id": "554211fe-2e88-3c77-aeb0-97b8cb2008e9",
                                "text": "La CPMA est payée par chaque adhérent une seule fois par an, même s’il prend plusieurs cartes."
                            }
                        ]
                    }
                ],
