                "senses": [
                    {
                        "sense_id": "8d294837-89b7-3d0d-86b3-91266c84b67d",
                        "entry_id": "e91e30ac-bc9a-36f3-bf9c-35fb1a1731ff",
                        "glosses": [
                            "Tough and courageous; having balls."
                        ],
                        "tags": [
                            "colloquial",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "0e3c6ddd-9238-4ded-9d0e-517d570ce75a",
                                "sense_id": "8d294837-89b7-3d0d-86b3-91266c84b67d",
                                "text": "On a movie like this, I don’t mind doing [the scene] as written, but I do do a lot of improv. I’m sort of a rapid-fire ballsy talker, and so I bring that to the character whenever it’s appropriate to the scene. That never makes it in."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f66b5b05-29e9-437d-8f7e-abcd40c83e4d",
                        "source_entry_id": "e91e30ac-bc9a-36f3-bf9c-35fb1a1731ff",
                        "source_sense_id": "8d294837-89b7-3d0d-86b3-91266c84b67d",
                        "source_sense_description": "having balls",
                        "target_lang_word": "couillu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "couillu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "669d159b-25c1-3ba7-ab96-a4ab93baaf93",
                                        "entry_id": "03e0cde6-9339-3353-9b4a-30d2a22358ef",
                                        "glosses": [
                                            "Qui a de grosses couilles, de gros testicules."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d033251b-ab66-4c20-97d2-0b27d8a9958d",
                                                "sense_id": "669d159b-25c1-3ba7-ab96-a4ab93baaf93",
                                                "text": "Regarde-moi ce taureau, comme il est couillu."
                                            },
                                            {
                                                "example_id": "61765fc4-36af-45d9-bf4d-8eec5c72b285",
                                                "sense_id": "669d159b-25c1-3ba7-ab96-a4ab93baaf93",
                                                "text": "Car Giacometti se foutait éperdument d’être le mâle qui réussit, tout, d’être le couillidé triomphant comme aurait dit ma Chloé (tout couillidé qui se respecte considérant qu’un homme qui erre ou qui échoue est un pauvre type, une chiffe, un minable, une lope, pour ne pas dire un moins que rien, et ne concevant d’autre modèle de – je cherchai une autre que réussite dont le sens avait été confisqué par les nouveaux langages, – d’autre accomplissement que le sien : fort couillu)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce96428b-b6ff-3d95-b19a-cc55dd15676a",
                                        "entry_id": "03e0cde6-9339-3353-9b4a-30d2a22358ef",
                                        "glosses": [
                                            "Audacieux, osé, courageux."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4b63048-fb82-4582-87d3-7bf02022bba4",
                                                "sense_id": "ce96428b-b6ff-3d95-b19a-cc55dd15676a",
                                                "text": "C’est aussi assez couillu de ne pas citer Flaubert !"
                                            },
                                            {
                                                "example_id": "1a6738d2-5aa9-4092-b313-c52aed29b9d8",
                                                "sense_id": "ce96428b-b6ff-3d95-b19a-cc55dd15676a",
                                                "text": "C’est une expression assez couillue !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "couillu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6db9af77-9d2f-37e8-8aa0-a758652a5fb5",
                                        "entry_id": "bc62678f-4448-3eea-9f2d-930b6404c754",
                                        "glosses": [
                                            "Personne qui a des couilles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ae29a47-fd9b-488b-87c1-67460d852634",
                                                "sense_id": "6db9af77-9d2f-37e8-8aa0-a758652a5fb5",
                                                "text": "’Ce n’est pas une garce, c’est un couillu, et tu connais le dicton : je lâche mon coq, gardez vos poules."
                                            },
                                            {
                                                "example_id": "beb9201a-cb86-4c57-b33f-e35e36737cd4",
                                                "sense_id": "6db9af77-9d2f-37e8-8aa0-a758652a5fb5",
                                                "text": "Ce couillu fait vivre sa mère et ses deux sœurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
