                "senses": [
                    {
                        "sense_id": "f2a42ced-690e-377c-b47e-c5134ac8639e",
                        "entry_id": "bdb6cd7c-97f8-3ee3-85de-6aa11a42ce9a",
                        "glosses": [
                            "jüdischer Händler, der mit Tabak handelte"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "2eead653-5001-43bd-857c-8cc06e1f3477",
                                "sense_id": "f2a42ced-690e-377c-b47e-c5134ac8639e",
                                "text": "„Der Tabakjude, der von Kowno her über die Memel gekommen war, schrie es in Ragnit auf der Straße aus: In Moskau brennt ein Scheiterhaufen!“"
                            },
                            {
                                "example_id": "9d928cd6-58c0-446b-959e-7c155c06c896",
                                "sense_id": "f2a42ced-690e-377c-b47e-c5134ac8639e",
                                "text": "„So wurden Käufer in jüdischen Geschäften „entlarvt“ oder die Autokennzeichen der Firma des „Tabakjuden Aron, dessen Bruder vor einigen Wochen aus dem Konzentrationslager zurückgekehrt ist“ (25.08.1935), veröffentlicht.“"
                            },
                            {
                                "example_id": "5422e25f-a9dc-43a4-af45-ce334daf0640",
                                "sense_id": "f2a42ced-690e-377c-b47e-c5134ac8639e",
                                "text": "„Da die Tabakjuden in den Dörfern vermög ausdrücklicher Verordnung nebst den Tabak mit keinen anderen Waaren zum Nachtheil der christlichen und jüdischen Handelsleuten handeln dürfen, so soll von den Magistraten und Wirtschaftsämtern genauest invigiliret werden, damit von denen jüdischen Tabaktrafikanten, welche in verschiedenen Orten über die Zahl der bestimmten Schutzjudenfamilien, oder in jenen Orten, wo ansonst gar keine Juden gewesen, angestellet sind, kein Handel mit anderen Waaren getrieben, und der allenfalls betriebene Handel unter Konfiskationsstrafe eingestellet werde.“"
                            },
                            {
                                "example_id": "2859e446-828c-419d-ac49-261bdef649a9",
                                "sense_id": "f2a42ced-690e-377c-b47e-c5134ac8639e",
                                "text": "„Die Alfassi waren die reichsten Tabakjuden von Saloniki.“"
                            },
                            {
                                "example_id": "90462070-459a-4c35-923b-b6b80d410011",
                                "sense_id": "f2a42ced-690e-377c-b47e-c5134ac8639e",
                                "text": "„Der Cohen, der Tabakjude, wird sich freuen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
