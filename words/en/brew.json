                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "назревать",
                                "target_lang_sense_clarification": "о конфликте, буре или беде"
                            },
                            {
                                "target_lang_word": "собираться",
                                "target_lang_sense_clarification": "о буре или грозе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e6fd2d5-8430-3842-a1b8-b83bd80262a5",
                    "sense_definition": "To devise, concoct, or plot a secret or mischievous plan.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "develop_threat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rebels met in secret to <w>brew</w> a plot against the corrupt government.",
                            "target_lang_translations": {
                                "ru": "Повстанцы тайно встретились, чтобы <w>сплести</w> заговор против коррумпированного правительства."
                            }
