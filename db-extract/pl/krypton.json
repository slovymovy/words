                    {
                        "translation_id": "c79e6fa7-5527-4bad-9b0a-dbc28a00af75",
                        "source_entry_id": "749ea455-ed44-3a79-a88e-2dc33b434d58",
                        "source_sense_id": "6aff5b1b-17bb-35b8-a848-fa7a4fa7bb04",
