                        "glosses": [
                            "A mischievous gossip or a troublemaker."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7208dd3b-50a9-4336-b362-a6d1582e10d4",
                                "sense_id": "b606d320-a533-365a-a087-24e3a29817ac",
                                "text": "There is no moe such titifyls in Englandes ground, / To hold with the hare and run with the hound."
                            },
                            {
                                "example_id": "49f76841-4e5b-4f2b-93da-ce3454da45e0",
                                "sense_id": "b606d320-a533-365a-a087-24e3a29817ac",
                                "text": "For the deuill hymself, to set farther diuision betwene the Englishe and Frenche nacion did apparell certain catchepoules, and Parasites, cōmonly called titiuils and tale tellers, to sowe discord and dissencion, betwene the dukes of Bedford and Burgoyne […]"
                            }
                        ]
                    }
