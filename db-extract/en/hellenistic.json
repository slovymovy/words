                    {
                        "translation_id": "6e308a05-47fd-4faa-897a-eed8088bf27d",
                        "source_entry_id": "6af7b418-9da7-3bec-86f8-fcc81bb171e4",
                        "source_sense_description": "of or relating to a period of Greek history",
                        "target_lang_word": "hellénistique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hellénistique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0583a4b3-1e86-32b4-be6b-a319b2105862",
                                        "entry_id": "61b6dde0-964f-3270-ad5e-6cca3fd10509",
                                        "glosses": [
                                            "Relatif à la civilisation grecque depuis Alexandre le Grand jusqu’à la conquête romaine, soit de 323 à 31 avant J.-C."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4610b931-af0d-4e8d-a593-8967c90271d7",
                                                "sense_id": "0583a4b3-1e86-32b4-be6b-a319b2105862",
                                                "text": "Sa marchandise sous le bras, il se faufilait entre deux malades, déballait un masque égyptien ou une tanagra hellénistique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d55c62e-abb5-3ca0-9eec-3fe67602d0a9",
                                        "entry_id": "61b6dde0-964f-3270-ad5e-6cca3fd10509",
                                        "glosses": [
                                            "Se rapporte aux Juifs hellénisants."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f37a29d0-c16d-4d38-9336-7d00e7841678",
                                                "sense_id": "1d55c62e-abb5-3ca0-9eec-3fe67602d0a9",
                                                "text": "On parle du christianisme hellénistique pour celui qui s’est développé dans la partie hellénisée du monde, par une mise en rapport de l’Évangile avec la philosophie grecque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5056785-8825-4216-9e0b-4bfab17266da",
                        "source_entry_id": "6af7b418-9da7-3bec-86f8-fcc81bb171e4",
                        "source_sense_description": "of or relating to a period of Greek history",
                        "target_lang_word": "hellenistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hellenistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9fa6d092-5e31-3d37-9a4f-90306f02a698",
                                        "entry_id": "3fc228c6-78c7-3deb-a827-8448517dd50c",
                                        "glosses": [
                                            "den Hellenismus betreffend, zu ihm gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c881097-e279-4554-b221-78218495f82d",
                                                "sense_id": "9fa6d092-5e31-3d37-9a4f-90306f02a698",
                                                "text": "„Hannibals politische Konzeption gipfelte in dem Bestreben, Karthago als ein außerhalb des römischen Machtmonopols stehendes, autonomes Staatswesen zu erhalten. Das Vorbild dafür bot das politische System der hellenistischen Staaten, das durch die Herstellung eines Gleichgewichts der Kräfte die Etablierung eines allmächtigen Hegemons verhindern konnte und die politische Existenz mehrerer in Konkurrenz zueinander stehender Gemeinwesen garantierte.“"
                                            },
                                            {
                                                "example_id": "b63114bb-91f4-4570-af49-95db90e4ec34",
                                                "sense_id": "9fa6d092-5e31-3d37-9a4f-90306f02a698",
                                                "text": "„Auf meinem Weg hindurch kam ich an weiteren, noch älteren Grabmalen vorüber, solchen aus hellenistischer Zeit.“"
                                            },
                                            {
                                                "example_id": "28899276-6f3f-4e35-8104-ed908b12ae6b",
                                                "sense_id": "9fa6d092-5e31-3d37-9a4f-90306f02a698",
                                                "text": "„So fanden etwa hellenistische Vorstellungen Eingang in die indische Darstellungskunst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
