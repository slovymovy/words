                ],
                "senses": [
                    {
                        "sense_id": "fb018892-3175-3ead-a8d0-a4cc36327c36",
                        "entry_id": "357da9ea-0431-33fb-a1c3-21674a75a949",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b23fd80-762c-4f1d-a8dc-fa569108cfd8",
                                "sense_id": "fb018892-3175-3ead-a8d0-a4cc36327c36",
                                "text": "Frau Voitle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "35159c76-8a7e-42f6-a1b1-54077797277c",
                                "sense_id": "fb018892-3175-3ead-a8d0-a4cc36327c36",
                                "text": "Herr Voitle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d6dec29c-7cc9-4df6-9317-be005b7a80b0",
                                "sense_id": "fb018892-3175-3ead-a8d0-a4cc36327c36",
                                "text": "Die Voitles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "098fa97a-e712-471f-a8ed-dcc11ca15893",
                                "sense_id": "fb018892-3175-3ead-a8d0-a4cc36327c36",
                                "text": "Der Voitle trägt nie die Schals, die die Voitle ihm strickt."
                            },
                            {
                                "example_id": "740b280b-3668-4531-a63b-bf4905c9b723",
                                "sense_id": "fb018892-3175-3ead-a8d0-a4cc36327c36",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Voitle kommt, geht der Herr Voitle.“"
                            },
                            {
                                "example_id": "90dd5264-757f-46d6-aaf5-25823f48438a",
                                "sense_id": "fb018892-3175-3ead-a8d0-a4cc36327c36",
                                "text": "Voitle kommt und geht."
                            },
                            {
                                "example_id": "130bdc36-16b8-4684-9df2-c5e4407c1663",
                                "sense_id": "fb018892-3175-3ead-a8d0-a4cc36327c36",
                                "text": "Voitles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
