                ],
                "senses": [
                    {
                        "sense_id": "bb1c0561-a66e-3fdf-898b-04348c9de940",
                        "entry_id": "0cd25821-9cec-34b5-a5e4-e69e11ba27e1",
                        "glosses": [
                            "Omelett, bei dem der Eiermasse Käse zugefügt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9e2854f-7d1a-436b-8c5f-d326114ab79c",
                                "sense_id": "bb1c0561-a66e-3fdf-898b-04348c9de940",
                                "text": "„Im ausführlichen Rezeptteil lernt man nicht nur, eine Käseplatte ansehnlich zu dekorieren, sondern auch, ein Käseomelett zu backen oder ein Raclette anzurichten - auch in eher seltsamen Variationen mit Mango und Schinken oder mit Ananas und Putenbrust.“"
                            },
                            {
                                "example_id": "fbfa7fb3-c42e-4323-84e8-b816621e39d1",
                                "sense_id": "bb1c0561-a66e-3fdf-898b-04348c9de940",
                                "text": "„Das Käseomelett vor dem Zusammenklappen mit etwa 1 EL feinen Schinkenstreifen (roh oder gekocht), zerpflücktem Räucherfisch oder auch mit blanchierten Spinatstreifen gleichmäßig belegen.“"
                            },
                            {
                                "example_id": "0f2793f1-01cf-465d-af1b-5df3f5f159fa",
                                "sense_id": "bb1c0561-a66e-3fdf-898b-04348c9de940",
                                "text": "„Vom Käseomelett ging eine wohlige Wärme aus. Der Salat war knackig und hatte etwas Schärfe.“"
                            },
                            {
                                "example_id": "3b834a67-8b46-46e3-8d6c-27b279d7a1f4",
                                "sense_id": "bb1c0561-a66e-3fdf-898b-04348c9de940",
                                "text": "„Für ein paar Euro kann sich jedermann gemütlich durch eine Prozession von scharfen Kartoffelkuchen, Chorizos, Käseomeletts, Pilzen, Schinken und allerlei Meeresgetier naschen.“"
                            },
                            {
                                "example_id": "8472263e-23c7-4e04-8067-ee1c4b3f6420",
                                "sense_id": "bb1c0561-a66e-3fdf-898b-04348c9de940",
                                "text": "„Gerollte und flache Omeletts werden bei lebhafter, aber nicht zu heftiger Hitze gegart, so daß die Garzeit nicht mehr als ein oder zwei Minuten beträgt. Das Omelett soll dann auf der Unterseite leicht gebräunt, oben jedoch noch etwas flüssig oder soeben gestockt sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
