                    {
                        "sense_id": "c6c3cc1f-95e1-3250-a21d-901c4370c1d6",
                        "entry_id": "e71b6318-c604-363a-9144-a1315c738bb8",
                        "glosses": [
                            "Effet qui résulte du mélange et de l’emploi des couleurs dans les tableaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "534a304c-69f2-4910-a41d-686c9318344e",
                                "sense_id": "c6c3cc1f-95e1-3250-a21d-901c4370c1d6",
                                "text": "Coloris frais, chaud, vigoureux, tendre, vif."
                            },
                            {
                                "example_id": "7995531e-9f38-48ce-bdc1-2e1a0d7acb07",
                                "sense_id": "c6c3cc1f-95e1-3250-a21d-901c4370c1d6",
                                "text": "Le coloris d’un tableau."
                            },
                            {
                                "example_id": "5a2ad879-db61-4902-a169-edd2decb74ca",
                                "sense_id": "c6c3cc1f-95e1-3250-a21d-901c4370c1d6",
                                "text": "La beauté, la perfection, la vigueur du coloris."
                            },
                            {
                                "example_id": "b51ee88f-cc1e-4412-8b30-7407119058f3",
                                "sense_id": "c6c3cc1f-95e1-3250-a21d-901c4370c1d6",
                                "text": "Ce tableau pèche par le coloris."
                            }
                        ]
                    },
                    {
                        "sense_id": "4698dc68-07a9-3815-b15c-b75c2bf47dee",
                        "entry_id": "e71b6318-c604-363a-9144-a1315c738bb8",
                        "glosses": [
                            "Coloration du visage, des fruits."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "8cbd798b-77de-4174-bbe2-44820b3d0302",
                                "sense_id": "4698dc68-07a9-3815-b15c-b75c2bf47dee",
                                "text": "Le coloris des joues, d’une pêche."
                            }
                        ]
                    },
                    {
                        "sense_id": "e8fde2dd-2411-325d-a461-c42037c305b4",
                        "entry_id": "e71b6318-c604-363a-9144-a1315c738bb8",
                        "glosses": [
                            "Ce qui est haut en couleur."
