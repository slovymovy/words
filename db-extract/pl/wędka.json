                                        "glosses": [
                                            "stok of buis om een microfoon op de gewenste plaats te houden"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e616708a-0194-3152-88fe-549f38370468",
                                        "entry_id": "2ea3da85-b3a0-3a78-8601-0a62efb3f46a",
                                        "glosses": [
                                            "Melampyrum pratense een plant uit de bremraapfamilie Orobanchaceae"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e6dd3e9-b2ce-4c38-9070-68022e7e3892",
                                                "sense_id": "e616708a-0194-3152-88fe-549f38370468",
                                                "text": "De eveneens zeer zeldzame bosparelmoervlinder houdt nu juist van open kapvlakten, waar zijn rupsen zich voeden met hengel, een plant vooral te vinden is op plaatsen waar kortgeleden eiken zijn gekapt."
                                            }
                                        ]
