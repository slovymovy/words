        "fr-extract.jsonl": [
            {
                "entry_id": "2a219343-2827-36b0-8b98-36484c614769",
                "word": "naturisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7068487b-e8c6-439a-a80a-8fed4252be43",
                        "entry_id": "2a219343-2827-36b0-8b98-36484c614769",
                        "tags": [
                            "plural"
                        ],
                        "form": "naturismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a8f1c7a7-fc95-3847-ba6b-72354974531d",
                        "entry_id": "2a219343-2827-36b0-8b98-36484c614769",
                        "glosses": [
                            "Une manière de vivre en harmonie avec la nature, caractérisée par la pratique de la nudité en commun, ayant pour conséquence de favoriser le respect de soi-même, le respect des autres et de l’environnement. (FFN - Agde 1974)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0212b8b1-391e-3d60-b873-5c7ed03a38f1",
                        "entry_id": "2a219343-2827-36b0-8b98-36484c614769",
                        "glosses": [
                            "Mouvement qui prône la proximité avec la nature, le retour à un état naturel et, incidemment, la nudité, pour assurer une bonne hygiène du corps et de l'esprit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81bea1a4-0397-4c5b-8352-4f9382b8ad84",
                                "sense_id": "0212b8b1-391e-3d60-b873-5c7ed03a38f1",
                                "text": "Le naturisme est né en France, sous la plume et dans l’entourage du géographe Élisée Reclus, (deuxième moitié du XIXe siècle)."
                            }
                        ]
                    },
                    {
                        "sense_id": "48431a4e-059a-344d-8dfb-1d8953a2e9ca",
                        "entry_id": "2a219343-2827-36b0-8b98-36484c614769",
                        "glosses": [
                            "Médecine naturelle."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1ee66917-dcfd-4e7d-a208-c90baad768f0",
                                "sense_id": "48431a4e-059a-344d-8dfb-1d8953a2e9ca",
                                "text": "j’ose publier cet ouvrage que j’ai cru pouvoir intituler le Naturisme."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b3003a0-8d0b-348a-aa81-e705821bed0c",
                        "entry_id": "2a219343-2827-36b0-8b98-36484c614769",
                        "glosses": [
                            "Désignait le naturalisme."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ec6b4a24-d402-4cfd-96f8-89da2bf7ceaa",
                                "sense_id": "8b3003a0-8d0b-348a-aa81-e705821bed0c",
                                "text": "Jean-Louis exultait, s'exaltait au point de convergence de ses tendresses essentielles : son naturisme et son christianisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd805458-61eb-42c4-b468-01055da43917",
                        "source_entry_id": "2a219343-2827-36b0-8b98-36484c614769",
                        "target_lang_word": "Freikörperkultur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Freikörperkultur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f40e8ff-0221-3a50-b739-f97f18a7e906",
                                        "entry_id": "dc97899c-477c-3660-a333-f27220008bf9",
                                        "glosses": [
                                            "gesellschaftliche Bewegung für gemeinschaftlichen Aufenthalt in der Natur ohne Kleidung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f1de1d1-c301-45b2-83b4-fde48e8475d1",
                                                "sense_id": "4f40e8ff-0221-3a50-b739-f97f18a7e906",
                                                "text": "„Ich möchte aber noch auf einen weiteren Sonderweg hinweisen, den das Turnen hierzulande genommen hat - und zwar eine Liaison mit der sogenannten Freikörperkultur.“"
                                            },
                                            {
                                                "example_id": "63507b0d-4635-4d67-8973-cb25bc6e51d1",
                                                "sense_id": "4f40e8ff-0221-3a50-b739-f97f18a7e906",
                                                "text": "„In der DDR war die Freikörperkultur eine der wenigen tolerierten Transgressionen.“"
                                            },
                                            {
                                                "example_id": "058f19d7-7edb-4a0f-ac95-16070903795b",
                                                "sense_id": "4f40e8ff-0221-3a50-b739-f97f18a7e906",
                                                "text": "„Hörstemeier ist mit seiner Schwärmerei für Natur und Freikörperkultur keineswegs besonders originell.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
