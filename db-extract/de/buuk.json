                "senses": [
                    {
                        "sense_id": "42b7dc3f-1c4e-3f01-b3e3-41662960b9b3",
                        "entry_id": "e088ce8d-27ce-36f8-ad6d-196b9134aaa0",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "821334eb-42f0-4d99-94a4-38dabcd5239f",
                                "sense_id": "42b7dc3f-1c4e-3f01-b3e3-41662960b9b3",
                                "text": "Frau Buuk ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "94e66791-db82-4dc4-a411-105636b2d122",
                                "sense_id": "42b7dc3f-1c4e-3f01-b3e3-41662960b9b3",
                                "text": "Herr Buuk wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5e4887ef-d86b-4abf-a6a0-6cefb20973fe",
                                "sense_id": "42b7dc3f-1c4e-3f01-b3e3-41662960b9b3",
                                "text": "Die Buuks fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "db2881b5-9adc-45b0-acf2-1918f0800e38",
                                "sense_id": "42b7dc3f-1c4e-3f01-b3e3-41662960b9b3",
                                "text": "Der Buuk trägt nie die Schals, die die Buuk ihm strickt."
                            },
                            {
                                "example_id": "baaaeaa2-375b-4970-b4ce-c0b880ca5640",
                                "sense_id": "42b7dc3f-1c4e-3f01-b3e3-41662960b9b3",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Buuk kommt, geht der Herr Buuk.“"
                            },
                            {
                                "example_id": "178976f3-37b8-4c9c-b340-b01e19fd22aa",
                                "sense_id": "42b7dc3f-1c4e-3f01-b3e3-41662960b9b3",
                                "text": "Buuk kommt und geht."
                            },
                            {
                                "example_id": "8459b82b-5cc8-4bad-8438-c9ad6d5379b9",
                                "sense_id": "42b7dc3f-1c4e-3f01-b3e3-41662960b9b3",
                                "text": "Buuks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
