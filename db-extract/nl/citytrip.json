                        "examples": [
                            {
                                "example_id": "32e3688d-8581-4a2f-8713-32d4bfc8d5a0",
                                "sense_id": "b9fddc63-502a-34d8-92e8-71eade9bada3",
                                "text": "„Het gaat om een vrouw uit de omgeving van Roeselare die op citytrip was met haar zus en moeder”, zegt Reynders over de overleden Belgische. „We stellen alles in het werk om hen bij te staan.” De drie Belgische gewonden zijn een vader, moeder en zoon van één gezin. De drie worden geopereerd."
                            },
                            {
                                "example_id": "b71a9e5c-bf0d-4903-9ced-d1214a6f852c",
                                "sense_id": "b9fddc63-502a-34d8-92e8-71eade9bada3",
                                "text": "Peter Pan vloog met kinderen naar Never Never Land, een plek waar geen ziekte bestaat. Dat is precies het idee achter de Peter Pan Vakantieclub. Zij verzorgen vakanties voor chronisch en ernstig zieke tieners. Een citytrip, Disneyland Parijs, vijf dagen Mallorca."
                            }
                        ]
                    }
