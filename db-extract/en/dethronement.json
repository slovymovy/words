                "senses": [
                    {
                        "sense_id": "943fdcdd-4c47-32b3-9d66-a643ab0e3a04",
                        "entry_id": "8229ef08-bca1-3e43-98be-e0cc395edb75",
                        "glosses": [
                            "Removal from a superior place in a hierarchy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6cb81ea-0713-473e-b452-6723d7ff95d4",
                                "sense_id": "943fdcdd-4c47-32b3-9d66-a643ab0e3a04",
                                "text": "I felt the first inkling of a thing that presently grew quite clear in my mind, that oppressed me for many days, a sense of dethronement, a persuasion that I was no longer a master, but an animal among the animals, under the Martian heel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48c35bcc-6eb9-4adb-9488-a10fcfffbd4d",
                        "source_entry_id": "8229ef08-bca1-3e43-98be-e0cc395edb75",
                        "source_sense_id": "943fdcdd-4c47-32b3-9d66-a643ab0e3a04",
                        "source_sense_description": "the act of being dethroned",
                        "target_lang_word": "détrônement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détrônement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7851cc4e-403b-3512-8591-100b8f8ec071",
                                        "entry_id": "190fe674-cd2e-31bc-9ddb-6f00edd452ee",
                                        "glosses": [
                                            "Action de détrôner ou le fait d’être détrôné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c938de31-0a0c-444b-a346-e8130689451d",
                                                "sense_id": "7851cc4e-403b-3512-8591-100b8f8ec071",
                                                "text": "La mort de ce prince suivit de près son détrônement."
                                            },
                                            {
                                                "example_id": "38c846b4-29ca-4017-b54b-326ad8c5e350",
                                                "sense_id": "7851cc4e-403b-3512-8591-100b8f8ec071",
                                                "text": "Rabelais dépeint le détrônement de deux rois : Picrochole dans Gargantua et Anarche dans Pantagruel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bd47f73-1076-328c-bf2f-9b5fc228c5cf",
                                        "entry_id": "190fe674-cd2e-31bc-9ddb-6f00edd452ee",
                                        "glosses": [
                                            "Perte de la première place, de la position de meneur, de son rang et donc le fait de passer en arrière-plan au profit d’un autre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92d67dff-cd3c-4aa4-a9ee-68a9b953acc1",
                                                "sense_id": "9bd47f73-1076-328c-bf2f-9b5fc228c5cf",
                                                "text": "Depuis son détrônement lors de son dernier championnat, il déprime."
                                            },
                                            {
                                                "example_id": "3aa10e96-4193-41bc-8291-1b4089cfdbc5",
                                                "sense_id": "9bd47f73-1076-328c-bf2f-9b5fc228c5cf",
                                                "text": "Suite à son détrônement dans le numérique, l’entreprise se réoriente vers l'argentique."
                                            },
                                            {
                                                "example_id": "5deb7047-7d21-4388-86f4-0bbc5ae31367",
                                                "sense_id": "9bd47f73-1076-328c-bf2f-9b5fc228c5cf",
                                                "text": "Le détrônement du dollar au profit de l'euro comme monnaie d'échange la plus utilisée en Europe, n'est pas un mal en soi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
