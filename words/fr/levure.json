                {
                    "sense_id": "050a44ac-e49f-3b1a-ad40-2649bad5b239",
                    "sense_definition": "Champignon unicellulaire microscopique provoquant la fermentation des matières organiques, utilisé notamment pour faire gonfler la pâte ou produire de l'alcool.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fermentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour préparer cette pâte à pain, vous devez délayer la <w>levure</w> dans un peu d'eau tiède."
                        },
                        {
                            "text": "La <w>levure</w> de boulanger permet d'obtenir une mie très légère et bien aérée."
                        }
                    ],
                    "synonyms": [
                        "levain"
                    ],
                    "common_phrases": [
                        "levure de boulanger",
