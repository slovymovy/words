                        "translation_id": "c24aa87f-91de-49aa-b073-a650fa9ace71",
                        "source_entry_id": "2d3ddabd-2453-3299-8c18-efd81dc20332",
                        "source_sense_id": "954e4d25-ffd7-36bb-b9aa-1057c07aed02",
                        "target_lang_word": "matchless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matchless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12e57e45-1bc3-3fe8-b10d-71dace8c1788",
                                        "entry_id": "3219718b-33ca-3227-8c17-199cbec817c3",
                                        "glosses": [
                                            "Having no match; without equal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "389fa414-8057-4cc0-b85a-99aa2ddc6970",
                                                "sense_id": "12e57e45-1bc3-3fe8-b10d-71dace8c1788",
                                                "text": "[T]he Prince was to declare the victor in the first day's tourney, who should receive as prize a warhorse of exquisite beauty and matchless strength."
                                            },
                                            {
                                                "example_id": "0ac65a0a-b116-4410-84d4-6606c6c2cc5d",
                                                "sense_id": "12e57e45-1bc3-3fe8-b10d-71dace8c1788",
                                                "text": "It was not his matchless talent that exalted Koufax beyond his greatest contemporaries so much as it was his knowledge that character was not connected to talent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "159011ce-8252-33c8-b0f6-95b78e3b17f4",
                                        "entry_id": "3219718b-33ca-3227-8c17-199cbec817c3",
                                        "glosses": [
                                            "Having no mate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4419da4b-12ed-40f6-8773-7a671d0a5cae",
                                                "sense_id": "159011ce-8252-33c8-b0f6-95b78e3b17f4",
                                                "text": "In this comedy, a matchmaker has a matchless daughter. Try as he might, he cannot seem to find anyone for her."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "matchless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11bb2f77-7c69-39ec-a629-ea9b4bf3f244",
                                        "entry_id": "7afbe612-24a6-3abd-9de4-dafa68f00970",
                                        "glosses": [
                                            "Without the use of matches for ignition."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72e540af-4653-4b58-81c0-ec3bc20d47dd",
                                                "sense_id": "11bb2f77-7c69-39ec-a629-ea9b4bf3f244",
                                                "text": "a matchless stove"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88c3bf1b-d38c-4945-a480-f701bd358829",
                        "source_entry_id": "2d3ddabd-2453-3299-8c18-efd81dc20332",
                        "source_sense_id": "954e4d25-ffd7-36bb-b9aa-1057c07aed02",
                        "target_lang_word": "unapproachable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unapproachable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6610c11-b365-3efc-adca-1281ca4a6811",
                                        "entry_id": "d5ec2efb-3c58-3e5e-bd6c-d1fb6fa40eca",
                                        "glosses": [
                                            "Not accessible or able to be reached."
                                        ],
                                        "tags": [],
