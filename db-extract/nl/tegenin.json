                        "cross_references": []
                    },
                    {
                        "translation_id": "affa50fa-4ac7-4ab3-92af-74b9bf554e28",
                        "source_entry_id": "4c6e77f3-ee11-38e9-9552-009237d1706d",
                        "source_sense_id": "e4436898-1226-3682-9984-0bab5297367f",
                        "source_sense_description": "zich tegen iets verzettend",
                        "target_lang_word": "against",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "against",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20091ca1-2f80-342e-84f9-07a095e0dab9",
                                        "entry_id": "51114f5f-a398-311a-9087-a1ea727f835d",
                                        "glosses": [
                                            "In a contrary direction to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faa23ec6-db6a-4f87-a925-6fffeb557b16",
                                                "sense_id": "20091ca1-2f80-342e-84f9-07a095e0dab9",
                                                "text": "It is hard work to swim against the current."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7f2ae50-3808-3a16-a8d4-20845d709437",
                                        "entry_id": "51114f5f-a398-311a-9087-a1ea727f835d",
                                        "glosses": [
                                            "In physical opposition to; in collision with."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "090ab62c-2ffe-4193-a4f3-cb99bd1eb1e1",
                                                "sense_id": "f7f2ae50-3808-3a16-a8d4-20845d709437",
                                                "text": "The rain pounds against the window."
                                            },
                                            {
                                                "example_id": "c9185a83-845c-40ec-8290-8421cb54c18a",
                                                "sense_id": "f7f2ae50-3808-3a16-a8d4-20845d709437",
                                                "text": "Ivor had acquired more than a mile of fishing rights with the house ; he was not at all a good fisherman, but one must do something ; one generally, however, banged a ball with a squash-racket against a wall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33f9e570-bcd7-3505-a488-6182d5c9e45e",
                                        "entry_id": "51114f5f-a398-311a-9087-a1ea727f835d",
                                        "glosses": [
                                            "In physical contact with, so as to abut or be supported by."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fef54e7-38cf-460e-87e2-d10060e796e1",
                                                "sense_id": "33f9e570-bcd7-3505-a488-6182d5c9e45e",
                                                "text": "The ladder was leaning against the wall."
                                            },
                                            {
                                                "example_id": "11c04d94-8b94-471e-857c-5798e5b1067b",
                                                "sense_id": "33f9e570-bcd7-3505-a488-6182d5c9e45e",
                                                "text": "The puppy rested its head against a paw."
                                            },
                                            {
                                                "example_id": "66155270-218c-4f55-8398-b46e0d3a7fb9",
                                                "sense_id": "33f9e570-bcd7-3505-a488-6182d5c9e45e",
                                                "text": "The kennel was put against the back wall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b1f6de1-e85e-3eec-9a78-64bb87e45415",
                                        "entry_id": "51114f5f-a398-311a-9087-a1ea727f835d",
                                        "glosses": [
                                            "Close to, alongside."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cf7ffcd-ebf7-4596-baa2-07bb65855707",
                                                "sense_id": "5b1f6de1-e85e-3eec-9a78-64bb87e45415",
                                                "text": "A row of trees stood against a fence."
                                            },
                                            {
                                                "example_id": "36bf27e6-a4d0-446e-9332-bc6e43fe1dca",
                                                "sense_id": "5b1f6de1-e85e-3eec-9a78-64bb87e45415",
                                                "text": "We expressed our readiness, and in ten minutes were in the station wagon, rolling rapidly down the long drive, for it was then after nine.[…]As we reached the lodge we heard the whistle, and we backed up against one side of the platform as the train pulled up at the other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b45c2bd-b822-3259-9b4c-bce716e25d8e",
                                        "entry_id": "51114f5f-a398-311a-9087-a1ea727f835d",
                                        "glosses": [
                                            "In front of; before (a background)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b83eb800-e007-4a54-9f15-857f9bf58d72",
                                                "sense_id": "1b45c2bd-b822-3259-9b4c-bce716e25d8e",
                                                "text": "The giant was silhouetted against the door."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ece6570-e1e2-3605-b7d2-4d4d2d5b181c",
                                        "entry_id": "51114f5f-a398-311a-9087-a1ea727f835d",
                                        "glosses": [
                                            "In contrast or comparison with."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7172e91f-9df9-46bd-b272-b17f034abfa8",
                                                "sense_id": "7ece6570-e1e2-3605-b7d2-4d4d2d5b181c",
                                                "text": "There is an awesome authenticity in Barrus's voice which, I imagine, is frightening to those who must evaluate art against a one-dimensional standard of political rectitude."
                                            },
                                            {
                                                "example_id": "deaeb9a4-ef05-4a31-8af9-98f0e7339b0f",
                                                "sense_id": "7ece6570-e1e2-3605-b7d2-4d4d2d5b181c",
                                                "text": "He stands out against his classmates."
                                            },
                                            {
                                                "example_id": "37a50dc6-a3f5-440c-8b0a-64329a975f17",
                                                "sense_id": "7ece6570-e1e2-3605-b7d2-4d4d2d5b181c",
                                                "text": "This report sets out the risks against the benefits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "844b8b88-6a3e-387b-8847-69c58a454c9d",
                                        "entry_id": "51114f5f-a398-311a-9087-a1ea727f835d",
                                        "glosses": [
                                            "In competition with, versus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "472c53b9-2f6e-4f05-b02d-ef21689e1a3f",
                                                "sense_id": "844b8b88-6a3e-387b-8847-69c58a454c9d",
                                                "text": "The Tigers will play against the Bears this weekend."
                                            },
                                            {
                                                "example_id": "5b614148-2b20-4594-b69b-a21326500afe",
                                                "sense_id": "844b8b88-6a3e-387b-8847-69c58a454c9d",
                                                "text": "“[…] it is not fair of you to bring against mankind double weapons ! Dangerous enough you are as woman alone, without bringing to your aid those gifts of mind suited to problems which men have been accustomed to arrogate to themselves.”"
                                            },
                                            {
                                                "example_id": "8e34aca5-13d0-4f4b-9d5a-5ec6c3a8c502",
                                                "sense_id": "844b8b88-6a3e-387b-8847-69c58a454c9d",
                                                "text": "The breakthrough came through Torres who, pilloried for his miss against Manchester United a week earlier, scored his second goal of the season."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "333d092c-71ec-3bbe-b526-b1700817ab3e",
                                        "entry_id": "51114f5f-a398-311a-9087-a1ea727f835d",
                                        "glosses": [
                                            "Contrary to; in conflict with."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df72300b-4b29-4dc4-9948-e056775521d2",
                                                "sense_id": "333d092c-71ec-3bbe-b526-b1700817ab3e",
                                                "text": "Doing this is against my principles."
                                            },
                                            {
                                                "example_id": "f6b1b755-3f91-4fd5-8544-ca749831a57c",
                                                "sense_id": "333d092c-71ec-3bbe-b526-b1700817ab3e",
                                                "text": "It is against the law to smoke on these premises."
                                            },
                                            {
                                                "example_id": "e1dcb63e-2cb1-49c5-b9d5-d29f756301cd",
                                                "sense_id": "333d092c-71ec-3bbe-b526-b1700817ab3e",
                                                "text": "There was no car in sight so we crossed against the red light."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e51bb5d8-a050-37f8-ab9a-280594597400",
                                        "entry_id": "51114f5f-a398-311a-9087-a1ea727f835d",
                                        "glosses": [
                                            "In opposition to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cfd567f-f119-4f68-8335-afe1f7d9c323",
                                                "sense_id": "e51bb5d8-a050-37f8-ab9a-280594597400",
                                                "text": "Are you against freedom of choice?"
                                            },
                                            {
                                                "example_id": "4b1d59f3-5453-4616-b801-14aeabb3c1bc",
                                                "sense_id": "e51bb5d8-a050-37f8-ab9a-280594597400",
                                                "text": "He waged a ten-year campaign against the company that was polluting the river."
                                            },
                                            {
                                                "example_id": "9a1216ba-bd39-4ed3-8e1c-0a19dc80b650",
                                                "sense_id": "e51bb5d8-a050-37f8-ab9a-280594597400",
                                                "text": "I'd bet against his succeeding."
                                            },
                                            {
                                                "example_id": "0287580c-c61f-4aa9-926f-b006d10aee53",
                                                "sense_id": "e51bb5d8-a050-37f8-ab9a-280594597400",
                                                "text": "(with implied object) Ten voted for, and three voted against."
                                            },
                                            {
                                                "example_id": "38aa8eb8-c1fa-4ce0-b594-45402cad8350",
                                                "sense_id": "e51bb5d8-a050-37f8-ab9a-280594597400",
                                                "text": "Mr. Cooke at once began a tirade against the residents of Asquith for permitting a sandy and generally disgraceful condition of the roads. So roundly did he vituperate the inn management in particular, and with such a loud flow of words, that I trembled lest he should be heard on the veranda."
                                            },
                                            {
                                                "example_id": "c5bf8d13-ef41-48fd-9974-cba80586f12e",
                                                "sense_id": "e51bb5d8-a050-37f8-ab9a-280594597400",
                                                "text": "Plant breeding is always a numbers game.[…]The wild species we use are rich in genetic variation,[…]. In addition, we are looking for rare alleles, so the more plants we try, the better. These rarities may be new mutations, or they can be existing ones that are neutral—or are even selected against—in a wild population. A good example is mutations that disrupt seed dispersal, leaving the seeds on the heads long after they are ripe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be9cb4a3-f3e2-3675-bd2a-364ea78ab2dd",
                                        "entry_id": "51114f5f-a398-311a-9087-a1ea727f835d",
                                        "glosses": [
                                            "Of betting odds, denoting a worse-than-even chance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b305a37-d78b-4112-ad2b-c8351d260205",
                                                "sense_id": "be9cb4a3-f3e2-3675-bd2a-364ea78ab2dd",
                                                "text": "That horse is fifty-to-one against, so it has virtually no chance of winning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05ccee8a-8dce-38be-9197-2dc528f4e304",
                                        "entry_id": "51114f5f-a398-311a-9087-a1ea727f835d",
                                        "glosses": [
                                            "In exchange for."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d116b90-86d2-4c9c-8758-7ce37b73c0d9",
                                                "sense_id": "05ccee8a-8dce-38be-9197-2dc528f4e304",
                                                "text": "The vouchers are redeemable against West End shows and theatre breaks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f6dc1e6-67d5-3ef2-bd0a-91d89e565000",
                                        "entry_id": "51114f5f-a398-311a-9087-a1ea727f835d",
                                        "glosses": [
                                            "As counterbalance to."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea283f02-ad7b-3433-9681-0574c790d481",
                                        "entry_id": "51114f5f-a398-311a-9087-a1ea727f835d",
                                        "glosses": [
                                            "As a charge on."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f148f4b-b18c-4b61-b918-7f940322a5bf",
                                                "sense_id": "ea283f02-ad7b-3433-9681-0574c790d481",
                                                "text": "Tax is levied against income from sales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "375159ea-b6cb-3a8c-97ae-db38061e8f64",
                                        "entry_id": "51114f5f-a398-311a-9087-a1ea727f835d",
                                        "glosses": [
                                            "As protection from."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb7fc101-0f69-440a-87bf-ba6fe41c3f1e",
                                                "sense_id": "375159ea-b6cb-3a8c-97ae-db38061e8f64",
                                                "text": "He turned the umbrella against the wind."
                                            },
                                            {
                                                "example_id": "02192ff6-b481-483e-b6e4-01f1412b028d",
                                                "sense_id": "375159ea-b6cb-3a8c-97ae-db38061e8f64",
                                                "text": "Beautie alone is a ſoveraigne remedy againſt feare,griefe,and all melancholy fits; a charm,as Peter de la Seine and many other writers affirme,a banquet it ſelfe;he gives inſtance in diſcontented Menelaus that was ſo often freed by Helenas faire face: and ʰTully, 3 Tusc. cites Epicurus as a chiefe patron of this Tenent."
                                            },
                                            {
                                                "example_id": "403ebebf-9034-49ec-a017-223dcd5e1713",
                                                "sense_id": "375159ea-b6cb-3a8c-97ae-db38061e8f64",
                                                "text": "Monoclonal antibodies were raised against these proteins: IN-1 and IN-2 bound both to the 35 kd and 250 kd inhibitors and to the surface of differentiated cultured oligodendrocytes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f6bd470-a29b-30c7-bb84-8d3964291446",
                                        "entry_id": "51114f5f-a398-311a-9087-a1ea727f835d",
                                        "glosses": [
                                            "In anticipation of; in preparation for (a particular time, event etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17e49808-f0a0-4a4e-863a-064f20ad1fb1",
                                                "sense_id": "2f6bd470-a29b-30c7-bb84-8d3964291446",
                                                "text": "The stores are kept well stocked against a time of need."
                                            },
                                            {
                                                "example_id": "ffaef293-dcdf-4c6e-bef0-e2f8cc886007",
                                                "sense_id": "2f6bd470-a29b-30c7-bb84-8d3964291446",
                                                "text": "He wrote to a friend of his, that he lived but with browne bread and water, and entreated him to send him a piece of cheese, against [translating pour] the time he was to make a solemne feast."
                                            },
                                            {
                                                "example_id": "b64ec7d6-fa60-4005-bd73-40cee1027523",
                                                "sense_id": "2f6bd470-a29b-30c7-bb84-8d3964291446",
                                                "text": "\"And now leave me, I pray thee, and thou too, my own Kallikrates, for I would get me ready against our journey, and so must ye both, and your servant also.\""
                                            },
                                            {
                                                "example_id": "5609d6c4-cf8f-4bf4-879f-d8b33d2b13cc",
                                                "sense_id": "2f6bd470-a29b-30c7-bb84-8d3964291446",
                                                "text": "A quarter of a mile inland we came upon the holluschickie -- sleek young bulls, living out the loneliness of their bachelorhood and gathering strength against the day when they would fight their way into the ranks of the benedicts"
                                            },
                                            {
                                                "example_id": "43429830-623d-4f60-a3a3-5a91e0964e9d",
                                                "sense_id": "2f6bd470-a29b-30c7-bb84-8d3964291446",
                                                "text": "Of the two fried chops served him for breakfast he ate one and gave Edmund the other, and put a buttered sandwich of bread in his pocket against the accidents of travel."
                                            },
                                            {
                                                "example_id": "ab7242fc-8fc8-4d2b-b989-711bd80bf347",
                                                "sense_id": "2f6bd470-a29b-30c7-bb84-8d3964291446",
                                                "text": "Rod, who always distrusted such methods, was forced to accept the new way but had begun to stash away large amounts of cash against the day that the system might be sabotaged or failed entirely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "395372c0-1614-35c4-9d8e-1ca6d0b3b8f1",
                                        "entry_id": "51114f5f-a398-311a-9087-a1ea727f835d",
                                        "glosses": [
                                            "To be paid now in contrast to the following amount to be paid later under specified circumstances, usually that a movie is made or has started filming."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "313b393a-95eb-48b5-98d1-dc8c8672de67",
                                                "sense_id": "395372c0-1614-35c4-9d8e-1ca6d0b3b8f1",
                                                "text": "The studio weren't sure the movie would ever get made, so they only paid $50,000 against $200,000. That way they wouldn't be out very much if filming never began."
                                            },
                                            {
                                                "example_id": "dadfddea-e6ea-4829-9866-1fbdcac766aa",
                                                "sense_id": "395372c0-1614-35c4-9d8e-1ca6d0b3b8f1",
                                                "text": "“Hollywood noises” yielded an early $35,000 option against $100,000 if the movie was made."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00d5ec45-59ef-3491-8524-6e834297abdb",
                                        "entry_id": "51114f5f-a398-311a-9087-a1ea727f835d",
                                        "glosses": [
                                            "Exposed to."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "against",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43cd22fb-34db-3a18-af24-a055fdab949e",
                                        "entry_id": "9db227c2-5522-3914-a34f-06f7e73cc449",
                                        "glosses": [
                                            "By the time that (something happened); before."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66f5e4db-b36a-4220-8e20-4bbdcf6e94cf",
                                                "sense_id": "43cd22fb-34db-3a18-af24-a055fdab949e",
                                                "text": "Thence she them brought into a stately Hall, / Wherein were many tables faire dispred, / And ready dight with drapets festiuall, / Against the viaundes should be ministred."
                                            },
                                            {
                                                "example_id": "0db8b76e-63f3-4395-b557-00a13035cb06",
                                                "sense_id": "43cd22fb-34db-3a18-af24-a055fdab949e",
                                                "text": "He now gave Mrs Deborah positive orders to take the child to her own bed, and to call up a maid-servant to provide it pap, and other things, against it waked."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95efb530-d231-49ac-ac7f-304b21179fcf",
                        "source_entry_id": "4c6e77f3-ee11-38e9-9552-009237d1706d",
