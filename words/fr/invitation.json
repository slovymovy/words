    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3f2844ab-6c20-32ae-bd5c-ca369a63c5b5",
                    "sense_definition": "Action ou fait de prier quelqu'un de venir ou de participer à un événement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Merci beaucoup pour votre aimable <w>invitation</w> à dîner ce samedi soir."
                        },
                        {
                            "text": "Il a décidé d'accepter l'<w>invitation</w> de ses amis pour passer le week-end à la campagne."
                        }
                    ],
                    "common_phrases": [
                        "accepter une invitation",
                        "décliner une invitation",
                        "lancer une invitation"
                    ]
                },
                {
                    "sense_id": "691eb239-f424-3be6-bcc7-3e95dd4b56e9",
                    "sense_definition": "Message, billet ou carte par lequel on convie formellement quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons déjà envoyé chaque <w>invitation</w> pour la cérémonie de mariage par la poste."
                        },
                        {
                            "text": "N'oublie pas de présenter ton <w>invitation</w> à l'entrée de la salle de concert."
                        }
                    ],
                    "common_phrases": [
                        "carte d'invitation",
                        "carton d'invitation"
                    ]
                },
                {
                    "sense_id": "5f91f9d6-5e5e-3a30-80c4-e6287b9f6d0c",
                    "sense_definition": "Incitation, encouragement ou sollicitation à faire quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "incitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette météo ensoleillée est une véritable <w>invitation</w> à la promenade en forêt."
                        },
                        {
                            "text": "Son discours passionné sonnait comme une <w>invitation</w> claire au changement."
                        }
                    ],
                    "synonyms": [
                        "incitation"
                    ],
                    "common_phrases": [
                        "invitation au voyage"
                    ]
                },
                {
                    "sense_id": "8a07249f-7709-3238-8e88-2c3af88635a4",
                    "sense_definition": "Demande officielle ou solennelle de se présenter quelque part, convocation.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "officiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le témoin s'est rendu au commissariat dès réception de son <w>invitation</w> officielle."
                        },
                        {
                            "text": "Sur l'<w>invitation</w> du juge, l'accusé a pris la parole devant l'assemblée."
                        }
                    ]
                }
            ]
        }
    ]
