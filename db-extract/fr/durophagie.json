                        "sense_id": "cc6f0729-6f50-36b6-a848-6b6f60477adf",
                        "entry_id": "e9293332-3ad5-317c-aa7a-0778b66336b4",
                        "glosses": [
                            "Fait de se nourrir de proies dures par rapport à ses dents et devant être broyées, comme des mollusques à coquille, des crabes, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9385905-9a50-4636-980c-a98dcf71b4c3",
                                "sense_id": "cc6f0729-6f50-36b6-a848-6b6f60477adf",
                                "text": "Il y a donc un aspect circulaire dans la définition de la durophagie : si une proie est dure elle doit être broyée, si une proie doit être broyée alors elle est dure."
                            }
                        ]
                    }
