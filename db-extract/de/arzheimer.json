                "senses": [
                    {
                        "sense_id": "4f2ff77e-94b5-39f9-8a41-ec25230d1f8a",
                        "entry_id": "2a24ade7-6d5d-3d99-a0bb-e0f024fdd30e",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27e939f7-de3d-4a77-ba80-4059f4f27235",
                                "sense_id": "4f2ff77e-94b5-39f9-8a41-ec25230d1f8a",
                                "text": "Frau Arzheimer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ad8828ff-d60f-4361-b90f-1f9a9646018e",
                                "sense_id": "4f2ff77e-94b5-39f9-8a41-ec25230d1f8a",
                                "text": "Herr Arzheimer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2d5cf186-253f-4913-b991-6107116d734e",
                                "sense_id": "4f2ff77e-94b5-39f9-8a41-ec25230d1f8a",
                                "text": "Die Arzheimers kommen heute von Pellworm."
                            },
                            {
                                "example_id": "86488d65-c30f-4d04-8997-edeae6b35604",
                                "sense_id": "4f2ff77e-94b5-39f9-8a41-ec25230d1f8a",
                                "text": "Der Arzheimer trägt nie die Schals, die die Arzheimer ihm strickt."
                            },
                            {
                                "example_id": "4149710c-bb73-4f54-8954-1310c30191ca",
                                "sense_id": "4f2ff77e-94b5-39f9-8a41-ec25230d1f8a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Arzheimer kommt, geht der Herr Arzheimer.“"
                            },
                            {
                                "example_id": "1b985f92-8265-40a1-97ab-9eb10065e6c4",
                                "sense_id": "4f2ff77e-94b5-39f9-8a41-ec25230d1f8a",
                                "text": "Arzheimer kommt und geht."
                            },
                            {
                                "example_id": "12c046ec-ee4f-46cb-bad6-02ad40d2662f",
                                "sense_id": "4f2ff77e-94b5-39f9-8a41-ec25230d1f8a",
                                "text": "Arzheimers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "b878e73c-0813-4422-aab0-69755bf2ffa1",
                                "sense_id": "4f2ff77e-94b5-39f9-8a41-ec25230d1f8a",
                                "text": "An verregneten Herbsttagen ist Familie Arzheimers liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "688c5877-4ca4-485a-94ca-33e13df34397",
                                "sense_id": "4f2ff77e-94b5-39f9-8a41-ec25230d1f8a",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Arzheimer das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
