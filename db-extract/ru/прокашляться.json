                    }
                ],
                "senses": [
                    {
                        "sense_id": "efe2493b-8154-3b03-95f2-dc8493efdf68",
                        "entry_id": "3fb4f9f4-c41e-3d0e-89c5-162cd6b39455",
                        "glosses": [
                            "очистить горло кашлем"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e29a90c-a671-4642-ba9f-27c1797e8420",
                                "sense_id": "efe2493b-8154-3b03-95f2-dc8493efdf68",
                                "text": "Он вынул из кармана свиток писаной бумаги, прокашлялся и начал читать следующее."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3dfc42f9-60c6-4b7f-9a35-d6a263c8eab7",
                        "source_entry_id": "3fb4f9f4-c41e-3d0e-89c5-162cd6b39455",
                        "source_sense_id": "efe2493b-8154-3b03-95f2-dc8493efdf68",
                        "target_lang_word": "cough up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cough up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "009d3607-51a1-3ac4-9e6e-14f6368b1e5f",
                                        "entry_id": "582af0b8-4971-36c2-b43c-3e081cdda1ea",
                                        "glosses": [
                                            "To expel from the lungs, throat, stomach, etc. by coughing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cd94ed1-afc6-42bd-980f-7eed2ea45fd3",
                                                "sense_id": "009d3607-51a1-3ac4-9e6e-14f6368b1e5f",
                                                "text": "He was coughing up blood."
                                            },
                                            {
                                                "example_id": "8ded8937-ba2d-42ce-ba05-f64341a82205",
                                                "sense_id": "009d3607-51a1-3ac4-9e6e-14f6368b1e5f",
                                                "text": "He was coughing up a lung. [idiomatic, figurative]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0566df8-43f2-30c5-8d7f-a57e961727b2",
                                        "entry_id": "582af0b8-4971-36c2-b43c-3e081cdda1ea",
                                        "glosses": [
                                            "To reluctantly or unwillingly give.",
                                            "To pay or disburse reluctantly (perhaps influenced by coffers of money)."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e09cb2e0-5274-4bf2-9859-2ba047812ca0",
                                                "sense_id": "f0566df8-43f2-30c5-8d7f-a57e961727b2",
                                                "text": "Do you think he'll be able to cough up the three grand by Tuesday?"
                                            },
                                            {
                                                "example_id": "602a2098-2035-430c-9ced-531d7d3fd848",
                                                "sense_id": "f0566df8-43f2-30c5-8d7f-a57e961727b2",
                                                "text": "\"[…] Usually businessmen. Married, middle-aged guys who'll cough up fifty bucks to smoke my pole.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63d64d87-cfbd-31ca-8c5d-238a42c57734",
                                        "entry_id": "582af0b8-4971-36c2-b43c-3e081cdda1ea",
                                        "glosses": [
                                            "To reluctantly or unwillingly give.",
                                            "To hand over, give."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c049bc19-a33d-4852-82de-cf65e11f76de",
                                                "sense_id": "63d64d87-cfbd-31ca-8c5d-238a42c57734",
                                                "text": "\"Anyhow, you go and cough it up and then we shall see.\""
                                            },
                                            {
                                                "example_id": "84c24c2d-eec3-4fb7-b6e8-105a3c362812",
                                                "sense_id": "63d64d87-cfbd-31ca-8c5d-238a42c57734",
                                                "text": "Cough it up, Cooper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6572787f-6da1-33b2-a8bb-d709af0ed0bb",
                                        "entry_id": "582af0b8-4971-36c2-b43c-3e081cdda1ea",
                                        "glosses": [
                                            "To reluctantly or unwillingly give.",
                                            "To confess; to give up information."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "informal",
                                            "intransitive",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28870841-a3a7-3052-97ac-c82eab9c6780",
                                        "entry_id": "582af0b8-4971-36c2-b43c-3e081cdda1ea",
                                        "glosses": [
                                            "To lose a competition by one's own mistakes, usually near the end of the contest."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4b16cfc-2e69-4dbe-8e59-5a9c06f70532",
                                                "sense_id": "28870841-a3a7-3052-97ac-c82eab9c6780",
                                                "text": "That team had the game won, but they coughed it up in the end."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c3d85be-fefd-37ce-b976-b65eca920da2",
                                        "entry_id": "582af0b8-4971-36c2-b43c-3e081cdda1ea",
                                        "glosses": [
                                            "To spill, to fumble."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "892229a7-195e-4faa-ab25-6a610aa46c8a",
                                                "sense_id": "1c3d85be-fefd-37ce-b976-b65eca920da2",
                                                "text": "England had never before come back to win from a margin of more than 12 points, and the errors continued to come thick and fast as Tom Croft became the latest to cough up the ball."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f8dfbdc-132b-41b7-bbed-01c5ff1923d3",
                        "source_entry_id": "3fb4f9f4-c41e-3d0e-89c5-162cd6b39455",
                        "source_sense_id": "efe2493b-8154-3b03-95f2-dc8493efdf68",
                        "target_lang_word": "aushusten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aushusten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d0ae79e0-c2a8-346f-9ae9-b8ff2a1f0c18",
                                        "entry_id": "c5a36041-05dc-33a9-9f4a-84bef238f9fc",
                                        "glosses": [
                                            "durch Husten etwas durch den Mund ausstoßen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95c81645-da98-4d96-bc82-b7a14b3d34a5",
                                                "sense_id": "d0ae79e0-c2a8-346f-9ae9-b8ff2a1f0c18",
                                                "text": "„Um das vierte Lebensjahr herum fängt das leise Rasseln der Lungen an, schließlich beginnt Wolfgang einen zähen graugrünen Schleim auszuhusten, der Elsa äußerst unangenehm ist.“"
                                            },
                                            {
                                                "example_id": "483edd48-ab8a-471d-a7fe-e7599c1b512b",
                                                "sense_id": "d0ae79e0-c2a8-346f-9ae9-b8ff2a1f0c18",
                                                "text": "„Doch dann fing Orval wieder an Blut auszuhusten, und Teasle sah den Schmerz in seinem Gesicht, und nichts erschien ihm mehr komisch.“"
                                            },
                                            {
                                                "example_id": "784b6932-196c-40ae-8706-5fa81cae8709",
                                                "sense_id": "d0ae79e0-c2a8-346f-9ae9-b8ff2a1f0c18",
                                                "text": "„Roman verschluckte sich fast an seinem Kaugummi und musste kräftig aushusten.“"
                                            },
                                            {
                                                "example_id": "418add12-133a-4a1e-958e-811938d99b46",
                                                "sense_id": "d0ae79e0-c2a8-346f-9ae9-b8ff2a1f0c18",
                                                "text": "„Enzio hatte zu hastig getrunken und mußte aushusten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
