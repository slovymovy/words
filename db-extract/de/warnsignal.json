                    {
                        "form_id": "1b3d4798-37f9-4f2a-a84e-f3e502517417",
                        "entry_id": "04fc1aaf-37ee-3229-98fc-085f274ae979",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Warnsignale"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d16d31f6-2255-33e3-975d-e21011ff25bc",
                        "entry_id": "04fc1aaf-37ee-3229-98fc-085f274ae979",
                        "glosses": [
                            "vereinbartes Zeichen, das vor einer Gefahr warnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96a65454-b86c-421c-9983-8120b832c27d",
                                "sense_id": "d16d31f6-2255-33e3-975d-e21011ff25bc",
                                "text": "Mit der Hupe kann ein Autofahrer an andere Fahrer Warnsignale aussenden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e427764b-f77b-36c2-b67c-f03db2d13c32",
                        "entry_id": "04fc1aaf-37ee-3229-98fc-085f274ae979",
                        "glosses": [
                            "Anzeichen, Symptom, das als Hinweis auf etwas Drohendes/Unerwünschtes gewertet werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caee7c56-c910-4131-bbd9-c1658bc166d7",
                                "sense_id": "e427764b-f77b-36c2-b67c-f03db2d13c32",
                                "text": "„Nicht nur war mein Interesse an weiteren Felszeichnungen gering, auch die Hitze machte mir zu schaffen, und zum ersten Mal auf dieser Reise begann ich die Warnsignale eines Hitzekollaps zu spüren, die ich von meiner Marokko-Reise in Erinnerung hatte.“"
                            },
                            {
                                "example_id": "7dfa2576-8cd2-4352-a15b-adca682c0302",
                                "sense_id": "e427764b-f77b-36c2-b67c-f03db2d13c32",
                                "text": "„Nicht nur psychosomatisch ist dieses Warnsignal zu deuten.“"
                            },
                            {
                                "example_id": "0f6e973b-fc4d-43c8-b656-333026fbbad3",
                                "sense_id": "e427764b-f77b-36c2-b67c-f03db2d13c32",
                                "text": "„In der Ferne war das Bimmeln von Schafsglocken zu hören, es klang wie ein Warnsignal.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
