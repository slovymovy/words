                                "target_senses": [
                                    {
                                        "sense_id": "c4d08677-c3aa-38b0-9123-3f3ec48f07cf",
                                        "entry_id": "775fa5f9-c207-3516-85c5-84e79d57c9a0",
                                        "glosses": [
                                            "wieszczka (m.in. przepowiedziała upadek Troi) i królewna trojańska, córka Priama i Hekuby"
                                        ],
                                        "tags": [
                                            "Ancient-Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4f63225-ae4a-4686-b28d-6ef52ddc795e",
                                                "sense_id": "c4d08677-c3aa-38b0-9123-3f3ec48f07cf",
                                                "text": "Pan hetman posła za posłem śle, o pomoc dla Kamieńca prosi, jako Kasandra upadek Ilium i narodu Priama przepowiada"
                                            },
                                            {
                                                "example_id": "a5ff8b3f-96b5-4dd8-9f51-20bb9b71466f",
                                                "sense_id": "c4d08677-c3aa-38b0-9123-3f3ec48f07cf",
                                                "text": "Wieszczka Kasandra daremnie przestrzegała Trojan przed koniem trojańskim, na próżno zapowiadała upadek Troi."
                                            },
                                            {
                                                "example_id": "4f00a464-ae93-47db-add7-19f9efb5e322",
                                                "sense_id": "c4d08677-c3aa-38b0-9123-3f3ec48f07cf",
                                                "text": "Nikt nie wierzył przepowiedniom Kasandry."
                                            },
                                            {
                                                "example_id": "7f94b3f5-1fd1-4258-a0a2-700baf5c9c98",
                                                "sense_id": "c4d08677-c3aa-38b0-9123-3f3ec48f07cf",
                                                "text": "Klitajmestra z zazdrości zamordowała Kasandrę."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "2e200e60-2a5d-3e1d-aeba-638a15aa9206",
                                        "entry_id": "775fa5f9-c207-3516-85c5-84e79d57c9a0",
                                        "glosses": [
                                            "imię żeńskie"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cd518e6-91fc-4467-875b-d3d0a9df2496",
                                                "sense_id": "2e200e60-2a5d-3e1d-aeba-638a15aa9206",
                                                "text": "Moja przyrodnia siostra, która jest Polką greckiego pochodzenia, ma na imię Kasandra."
                                            },
                                            {
                                                "example_id": "0e86f0bd-e29a-4cdd-ae1e-1efc586c192e",
                                                "sense_id": "2e200e60-2a5d-3e1d-aeba-638a15aa9206",
                                                "text": "Dziś udało nam się zamienić parę słów z zawodniczką kadry Marcina Kasprowicza, Kasandrą Parczewską"
                                            },
                                            {
                                                "example_id": "7e414f24-9c52-4902-8b16-d9d662026ff6",
                                                "sense_id": "2e200e60-2a5d-3e1d-aeba-638a15aa9206",
                                                "text": "Kasandry imieniny obchodzą 22 stycznia."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            },
