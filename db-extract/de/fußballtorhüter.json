                                "sense_id": "c7f11d6d-420f-340d-8ccb-07ce3e586f7c",
                                "text": "„Selbstmord – ein Thema, das seit dem tragischen Geschehen um den Fußballtorhüter Robert Enke immer mehr in der Öffentlichkeit diskutiert wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
