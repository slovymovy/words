                    {
                        "form_id": "2848a267-58d3-403f-a5b0-7ce76efdd01e",
                        "entry_id": "d30869ed-6584-3b5b-af85-e2aa4e25078c",
                        "tags": [
                            "feminine"
                        ],
                        "form": "massière"
