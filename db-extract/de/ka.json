                "senses": [
                    {
                        "sense_id": "d293af86-7485-310c-831f-e71d2ec43c59",
                        "entry_id": "d2126745-6dc4-3a22-9592-9fffa91a8502",
                        "glosses": [
                            "no idea (alternative spelling of k. A. – abbreviation of keine Ahnung)"
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "81482f0f-f5ab-4880-b6a7-dc63c4e6d1b8",
                                "sense_id": "d293af86-7485-310c-831f-e71d2ec43c59",
                                "text": "Kann mir da einer helfen? ich hab absolut ka woran es liegt. AUs der config von xine bin ich zum nicht schlauer geworden.",
                                "translation": "Can someone help me with this? I have absolutely no idea where the problem is. The config of xine left me none the wiser.",
                                "english": "Can someone help me with this? I have absolutely no idea where the problem is. The config of xine left me none the wiser."
                            },
                            {
                                "example_id": "5533964f-87e7-4dac-b66a-b1da3910d02e",
                                "sense_id": "d293af86-7485-310c-831f-e71d2ec43c59",
                                "text": "irgendwo hab ich aufgeschnappt das mitte Februar neue Dual Core CPU´s auf den Markt kommen.Bitte nicht fragen wo ich das her hab,ka vieleicht bilde ich mir das ja auch nur ein ;-)",
                                "translation": "I heard somewhere that new Dual Core CPU's will come onto the market in mid-February. Please don't ask where I go that, no idea I might just be imagining it. ;-)",
                                "english": "I heard somewhere that new Dual Core CPU's will come onto the market in mid-February. Please don't ask where I go that, no idea I might just be imagining it. ;-)"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "52d272c5-0232-380d-b032-62dac60bd37b",
                "word": "kA",
                "pos": "phrase",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "41f3907d-7056-3ba8-85da-e96db6906a84",
                        "entry_id": "52d272c5-0232-380d-b032-62dac60bd37b",
                        "glosses": [
                            "alternative spelling of k. A."
                        ],
                        "tags": [
                            "Internet",
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "50531fc4-f50a-42b2-991f-8edfc1a29c73",
                                "sense_id": "41f3907d-7056-3ba8-85da-e96db6906a84",
                                "text": "Nur was mach ich jetzt ?!? Hab kA wie ich\n1. das System \"reparieren\" soll\n2. den Fehler analysieren kann ...welche Tools bietet XP ?"
                            },
                            {
                                "example_id": "d2218e2c-8792-43c5-8a67-70cc3926083c",
                                "sense_id": "41f3907d-7056-3ba8-85da-e96db6906a84",
                                "text": "Also das heißt für mich wäre das kein Problem, aber ich muss es meinem Vater so einfach wie möglich machen, denn der hat wirklich kA von Linux und kommt nur mit einer einfachen grafischen Oberfläche klar."
                            },
                            {
                                "example_id": "6b7fef03-7fa6-46c3-83a1-443ff2d410a4",
                                "sense_id": "41f3907d-7056-3ba8-85da-e96db6906a84",
                                "text": "Und komischerweise hab ich's jetzt auch zum funktionieren gebracht undzwar indem ich Win2K installiert hab - kA warum, aber FF8 läuft jetzt absolut einwandfrei, sogar über TV-Out."
                            },
                            {
                                "example_id": "4c6ede8f-6319-4ee5-9795-00e7f3df6112",
                                "sense_id": "41f3907d-7056-3ba8-85da-e96db6906a84",
                                "text": "Leider scheinen viele Hängerkunden ja wirklich technisch absolut kA zu haben, dass sie sich mit goldnen Verkäuferworten abspeisen lassen."
                            },
                            {
                                "example_id": "4f6d0439-ffd1-456a-a424-d980da858bca",
                                "sense_id": "41f3907d-7056-3ba8-85da-e96db6906a84",
                                "text": "Sorry davon hab ich wirklich kA. Ich weiß nich was ich für eins hab ..."
                            },
                            {
                                "example_id": "5622eea6-ad5c-43c1-a600-e88ecc62f44e",
                                "sense_id": "41f3907d-7056-3ba8-85da-e96db6906a84",
                                "text": "> Wie kommen die auf die Idee, dass du 4 Jahre lang einen Fernseher hattest,\n> aber\n> keine Gebühren bezahlt hast?\nkA! Ich bin 1999 aus meinem Elternhaus ausgezogen und habe mich bei der GEZ mit einem der ohnehin regelmäßig zugesandten Schreiben angemeldet."
                            },
                            {
                                "example_id": "c1e58429-e103-48a5-babf-9c4f6cebdcb0",
                                "sense_id": "41f3907d-7056-3ba8-85da-e96db6906a84",
                                "text": "Das Problem ist aber, das anscheinend manche nie fertig werden. Hab kA warum. Hab auch schon thread.exit() an's Ende der run() Methoden geschrieben, hilft aber nix."
                            },
                            {
                                "example_id": "b6830c4f-1227-4a8f-861d-d28db83c82b5",
                                "sense_id": "41f3907d-7056-3ba8-85da-e96db6906a84",
                                "text": "Ps. Könnt ihr diese Nachricht verbreiten? Ich hab kA in welchen Newslettern, Foren, Mailingslisten oder Seiten ihr aktiv seid :)"
                            },
                            {
                                "example_id": "71286458-9056-4add-b5ef-853725502272",
                                "sense_id": "41f3907d-7056-3ba8-85da-e96db6906a84",
                                "text": "kA. *g*"
                            },
                            {
                                "example_id": "2d2ceab4-1116-4711-bfdc-8fae3aeb1b66",
                                "sense_id": "41f3907d-7056-3ba8-85da-e96db6906a84",
                                "text": "Ich hatte auch mal welche, kA wo die abgeblieben sind."
                            }
                        ]
                    }
                ],
