                        "target_lang_word": "kalandrieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kalandrieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8efca259-6ac9-352f-bace-1693c69c7d6e",
                                        "entry_id": "1aa266f2-42fc-3104-bd4c-ae9d7876c58d",
                                        "glosses": [
                                            "mit dem Kalander zu einer Folie auswalzen"
                                        ],
                                        "tags": [
                                            "jargon",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b514fe11-7b0a-48b1-95aa-da070828f110",
                                                "sense_id": "8efca259-6ac9-352f-bace-1693c69c7d6e",
                                                "text": "Als Kalander werden mehrere Stahlwalzen bezeichnet, die meist erhitzt sind und zwischen denen Materialen durchgeführt und so „kalandriert“ werden, also geglättet, gewalzt, ausgedünnt etc.."
                                            },
                                            {
                                                "example_id": "7e199e3a-3510-4367-8cf5-946159ee460c",
                                                "sense_id": "8efca259-6ac9-352f-bace-1693c69c7d6e",
                                                "text": "Für die PVC-Weich-Verarbeitung ist die F-Form üblich, während Gewebebahnen meist auf der Z-Form kalandriert werden."
                                            },
                                            {
                                                "example_id": "0f7b8f49-02a7-47bf-b792-26137c6a845d",
                                                "sense_id": "8efca259-6ac9-352f-bace-1693c69c7d6e",
                                                "text": "Nahezu alle Thermoplaste können kalandriert werden."
                                            },
                                            {
                                                "example_id": "34e799bd-d199-431b-b687-1bb010ef6c14",
                                                "sense_id": "8efca259-6ac9-352f-bace-1693c69c7d6e",
                                                "text": "So werden meist Pulver oder Granulate zur Verarbeitung erwärmt, gegossen, gespritzt, extrudiert, kalandriert, beblasen, aufgeschämt oder gepresst."
                                            },
                                            {
                                                "example_id": "89d9fc0c-da23-4409-a3c3-7c8434e27388",
                                                "sense_id": "8efca259-6ac9-352f-bace-1693c69c7d6e",
                                                "text": "Es ist auch aus dem Stand der Technik bekannt, Faserbahnen in einem Riemen-[]bzw. Bandkalander, typischenweise in einem Metallbandkalander, zu kalandrieren, in[]welchem die Faserbahn in einer zwischen der Oberfläche einer Kalandrierwalze und einem über die Walze geführten Band gebildeten Kalandrierzone kalandriert wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
