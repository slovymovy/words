                "senses": [
                    {
                        "sense_id": "97c357c4-5a46-3b0f-aa11-2ee542954d85",
                        "entry_id": "642ea459-e53d-3e0a-8a32-66af1bce3fa8",
                        "glosses": [
                            "das den Personen einer wirtschaftlichen Gemeinschaft zur Verfügung stehende Geld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7c0efa2-a794-434c-8358-60243fdd654a",
                                "sense_id": "97c357c4-5a46-3b0f-aa11-2ee542954d85",
                                "text": "Wenn Sie alle Einkommen Ihres Haushaltes, also inkl. Pensionen, Familienbeihilfen und sonstiger Einkünfte, zusammenzählen: In welche der folgenden Einkommensgruppen fällt Ihr monatliches Haushaltsnettoeinkommen?"
                            },
                            {
                                "example_id": "ee358d91-5a8b-4a53-8bfc-891304fc24b7",
                                "sense_id": "97c357c4-5a46-3b0f-aa11-2ee542954d85",
                                "text": "Das Haushaltsnettoeinkommen der Familie war wegen der geringen Steuerabgaben um nur zehn Prozent geringer als das Haushaltsbruttoeinkommen."
                            },
                            {
                                "example_id": "584872f7-91f3-466a-869e-e33296f6d3d1",
                                "sense_id": "97c357c4-5a46-3b0f-aa11-2ee542954d85",
                                "text": "„Das Programm soll weiter ausgebaut werden. Augenblicklich hat nur fast jeder fünfte Kursbesucher ein Haushaltsnettoeinkommen unter 1500 Euro«, sagt Thönnes. Diesen Anteil wollen wir erhöhen.“"
                            },
                            {
                                "example_id": "6e0c4080-488f-4760-be55-8844ac51ad9f",
                                "sense_id": "97c357c4-5a46-3b0f-aa11-2ee542954d85",
                                "text": "„Befragt wurden 1500 repräsentativ ausgewählte Personen ab 30 Jahren mit einem Haushaltsnettoeinkommen von mindestens 2000 Euro.“"
                            },
                            {
                                "example_id": "1676a92e-9b6f-4091-aff1-9898df303690",
                                "sense_id": "97c357c4-5a46-3b0f-aa11-2ee542954d85",
                                "text": "„Ein Drittel des Haushaltsnettoeinkommens, heißt es, darf fürs Wohnen aufgewendet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
