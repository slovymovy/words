                        "entry_id": "24f7035a-9083-32b8-8a76-0c17caf8a3e8",
                        "glosses": [
                            "Gesamtheit politischer Maßnahmen und Entscheidungen, die den Umgang mit Rauschmitteln betreffen"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "d9b5605e-5187-474a-8e66-96f39d98a82b",
                                "sense_id": "1b9e1338-f00b-34ab-8a8b-7f3f6a23060d",
                                "text": "„Befürworter einer liberaleren Drogenpolitik nach dem Vorbild Portugals sind beim digitalen FDP-Bundesparteitag nach einer Intervention der Parteispitze gescheitert.“"
                            },
                            {
                                "example_id": "9aceb2df-a8fc-4a48-b128-0518d9851d81",
                                "sense_id": "1b9e1338-f00b-34ab-8a8b-7f3f6a23060d",
                                "text": "„Die Verbreitung von Cannabis ist in den Niederlanden sogar geringer als in Ländern, die eine repressive Drogenpolitik verfolgen.“"
                            }
                        ],
