                        "examples": [
                            {
                                "example_id": "e6d88254-a801-403b-a2ba-227f122943f1",
                                "sense_id": "bed95fca-8143-3fee-aa77-bd4780e5f6c2",
                                "text": "Van de mensen die het in Suriname voor het zeggen hebben, heeft Boy geen hoge pet op. Dat geldt voor zowel het landelijk bestuur als het traditionele gezag van de boslandcreolen, dat bestaat uit de granman (grootopperhoofd), dorpskapiteins en basja's (assistenten) die langs de familielijn voor het leven worden benoemd."
                            }
                        ]
                    }
