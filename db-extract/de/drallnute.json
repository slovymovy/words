                "senses": [
                    {
                        "sense_id": "d7c0fb59-f102-30c5-bf45-cfc40081de90",
                        "entry_id": "83e4d371-3ab3-39b6-865a-53fe62a19d77",
                        "glosses": [
                            "in Form einer Helix auf einer Zylinderoberfläche verlaufende Rille"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "229599eb-bcd5-4c0b-a3d9-d9e72c831a5a",
                                "sense_id": "d7c0fb59-f102-30c5-bf45-cfc40081de90",
                                "text": "„Die Ganghöhe H der Drallnuten bleibt entlang der Hauptschneide konstant.“"
                            },
                            {
                                "example_id": "ed9aad14-e4b6-498c-8eea-0d38dd449674",
                                "sense_id": "d7c0fb59-f102-30c5-bf45-cfc40081de90",
                                "text": "„Die Spanabfuhr ist problemlos, lässt doch die sehr geräumige Drallnute die schmalen Späne nach hinten fliessen.“"
                            },
                            {
                                "example_id": "06cfa6b9-2f3b-481b-868d-6ec5acee2e9b",
                                "sense_id": "d7c0fb59-f102-30c5-bf45-cfc40081de90",
                                "text": "„Zur sicheren Führung des Bohrers im Bohrloch bleibt längs der Drallnute eine schmale Fase b stehen (Abb. B 7), die durch Hinterfräsen erzeugt wird, deren annähernde Breite nachstehend gegeben ist:“"
                            },
                            {
                                "example_id": "7bffb360-218f-431b-abbd-6cbfebf70dbe",
                                "sense_id": "d7c0fb59-f102-30c5-bf45-cfc40081de90",
                                "text": "„Schneckenwindungen oder Drallnuten besorgen die Abfuhr des abgetrennten Werkstoffes.“"
                            },
                            {
                                "example_id": "e73fb6fd-428b-4ba1-9b68-d2a9827ab155",
                                "sense_id": "d7c0fb59-f102-30c5-bf45-cfc40081de90",
                                "text": "„Der aufwärtsgehende Kolben muß, da die Drallstege des Sperrads in die Drallnuten des Kolbens eingreifen, eine Drehbewegung ausführen und nimmt über die geraden Nuten der Bohrhülse das Bohrgestänge mit.“"
                            },
                            {
                                "example_id": "1b5ac425-665b-48cb-8ebf-55d169fc1772",
                                "sense_id": "d7c0fb59-f102-30c5-bf45-cfc40081de90",
                                "text": "„Hierbei ist die Drallnute für den großen Hub mit etwa 30°, für das Aneinanderpressen der Kegelflächen aber eine solche von etwa 5° anzuwenden […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
