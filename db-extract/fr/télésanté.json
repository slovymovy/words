                "senses": [
                    {
                        "sense_id": "2cd3a766-199e-350d-b474-2382c3c8e09e",
                        "entry_id": "290d19ba-bc5a-3b7f-a66b-5715a7005f83",
                        "glosses": [
                            "Utilisation des technologies de l’information pour fournir des services de santé à distance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "569019c7-f477-4ed2-bfdc-cbddd5000768",
                                "sense_id": "2cd3a766-199e-350d-b474-2382c3c8e09e",
                                "text": "Grâce aux nouvelles technologies, la télésanté permet l’accès à distance d’un patient à un professionnel de santé ou à une équipe médicale."
                            },
                            {
                                "example_id": "5b1b2277-3fe9-4ecf-8af3-1df218618ab4",
                                "sense_id": "2cd3a766-199e-350d-b474-2382c3c8e09e",
                                "text": "Après une période d’expérimentations, la télésanté bascule dans le droit commun."
                            },
                            {
                                "example_id": "c8437a6f-16f4-40a3-84c8-9863d86aa255",
                                "sense_id": "2cd3a766-199e-350d-b474-2382c3c8e09e",
                                "text": "Le nombre de projets ou de programmes mettant de l’avant la « télésanté » a augmenté considérablement au cours des dernières années."
                            }
                        ]
                    }
                ],
