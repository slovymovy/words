                        "entry_id": "63cc0e03-f628-3ff4-9955-3612554afd1c",
                        "glosses": [
                            "Resembling, or characteristic of a gimmick."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e6a43509-7933-3974-9063-4d0cbba46d1f",
                        "entry_id": "63cc0e03-f628-3ff4-9955-3612554afd1c",
                        "glosses": [
                            "Containing gimmicks."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5f92027-1d85-43ae-b71d-f54b9fb4cdd0",
                                "sense_id": "e6a43509-7933-3974-9063-4d0cbba46d1f",
                                "text": "What isn't so gimmicky is the Aggro System, where you draw fire onto yourself by acting aggressive, while your partner sneaks off blindsiding distracted enemies. Aggro depends on how big your current weapon is and how often you act aggressive."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44a896de-9870-4984-b6eb-45cc34bbbca5",
                        "source_entry_id": "63cc0e03-f628-3ff4-9955-3612554afd1c",
                        "source_sense_description": "resembling, or characteristic of a gimmick",
                        "target_lang_word": "effekthascherisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effekthascherisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58b24b00-05a3-3357-a5d4-9bbe1fb7a59a",
                                        "entry_id": "9e037cbb-d4fb-3f67-b06f-7e7dd2122617",
                                        "glosses": [
                                            "vorwiegend auf die Erzielung von Effekten bedacht"
                                        ],
                                        "tags": [
                                            "pejorativ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f31852d9-67f4-40c5-9a04-da60f9ff58f9",
                                                "sense_id": "58b24b00-05a3-3357-a5d4-9bbe1fb7a59a",
                                                "text": "Reißerische Überschriften und effekthascherische Bilder – „Fake News“ lassen sich nicht immer auf den ersten Blick erkennen."
                                            },
                                            {
                                                "example_id": "ca675b59-89a6-47fa-8de8-2e75343d25e7",
                                                "sense_id": "58b24b00-05a3-3357-a5d4-9bbe1fb7a59a",
                                                "text": "Opulenz ist alles andere als effekthascherisch."
                                            },
                                            {
                                                "example_id": "0d459ec4-34bd-4236-af80-8fc2f20a3bb9",
                                                "sense_id": "58b24b00-05a3-3357-a5d4-9bbe1fb7a59a",
                                                "text": "Sie beeinflusste auch die Musikkritik, die Mahlers Musik als oberflächlich und effekthascherisch abqualifizierte."
                                            },
                                            {
                                                "example_id": "00e0e831-a4c4-488b-a7d6-1609bc9d212c",
                                                "sense_id": "58b24b00-05a3-3357-a5d4-9bbe1fb7a59a",
                                                "text": "„Effekthascherisch“ fand Museumsdirektor Jörg Morré zunächst den im Ukraine-Krieg zerstörten russischen Panzer, den Aktivisten vor der russischen Botschaft in Berlin aufgestellt hatten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1a2fee83-2d30-316e-97a5-b496b1d347b9",
                                        "entry_id": "9e037cbb-d4fb-3f67-b06f-7e7dd2122617",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0613f504-1b8a-46fb-aece-6487d80d99f5",
                                                "sense_id": "1a2fee83-2d30-316e-97a5-b496b1d347b9",
                                                "text": "Die erst am 3. April veröffentlichte Mini-Dokuserie mit drei gut halbstündigen Teilen befasst sich eindrucksvoll - manche würden effekthascherisch sagen - mit dem Fall des sogenannten Darkroom-Mörders oder Koma-Killers von Berlin."
                                            }
                                        ],
                                        "sense_index_json": "\"11\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "634031f9-71e3-4c87-8526-8787bc429bb0",
                        "source_entry_id": "63cc0e03-f628-3ff4-9955-3612554afd1c",
                        "source_sense_description": "resembling, or characteristic of a gimmick",
                        "target_lang_word": "künstlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "künstlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2c8b9d4-0c6d-3b43-b4a4-181a027c2cf0",
                                        "entry_id": "a3fde6ca-a5c9-30df-b2ab-59abe5154b9c",
                                        "glosses": [
                                            "nicht natürlich, sondern technisch nach Vorbildern aus der Natur nachgebildet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "198ed5a5-280a-42d8-9c96-ad92d3e61a8b",
                                                "sense_id": "d2c8b9d4-0c6d-3b43-b4a4-181a027c2cf0",
                                                "text": "Ihm wurde ein künstliches Kniegelenk eingebaut."
                                            },
                                            {
                                                "example_id": "0f4df655-a229-4d79-bd85-d1d04ec7c9af",
                                                "sense_id": "d2c8b9d4-0c6d-3b43-b4a4-181a027c2cf0",
                                                "text": "Das künstliche Licht machte die Nacht zum Tag und veränderte die Lebensverhältnisse des Menschen entscheidend."
                                            },
                                            {
                                                "example_id": "647dc749-ecb0-446c-832c-2b295f4b38a9",
                                                "sense_id": "d2c8b9d4-0c6d-3b43-b4a4-181a027c2cf0",
                                                "text": "„Freunde und Profis des Klettersports haben eine neue Möglichkeit, in Berlin an künstlichen Felswänden zu trainieren.“"
                                            },
                                            {
                                                "example_id": "89cb9962-a1d2-4d30-9c37-47d9cb657497",
                                                "sense_id": "d2c8b9d4-0c6d-3b43-b4a4-181a027c2cf0",
                                                "text": "Ein künstlicher Bach belebt den Garten."
                                            },
                                            {
                                                "example_id": "251e6b15-eb88-4f9c-b4bf-06b6031e4daa",
                                                "sense_id": "d2c8b9d4-0c6d-3b43-b4a4-181a027c2cf0",
                                                "text": "Manche Wissenschaftler träumen von der künstlichen Intelligenz und ihrer Realisierung in kleinen Hausrobotern, die uns voller Umsicht alle lästigen Arbeiten abnehmen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3731edb3-4b5b-32cd-8d16-74dbcacdb89c",
                                        "entry_id": "a3fde6ca-a5c9-30df-b2ab-59abe5154b9c",
                                        "glosses": [
                                            "nicht auf natürliche Art und Weise ablaufend, aber natürliche Prozesse imitierend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09f5396b-bb16-46f7-b9c0-f1863e859af8",
                                                "sense_id": "3731edb3-4b5b-32cd-8d16-74dbcacdb89c",
                                                "text": "In England begann man in Bourn Hall mit der künstlichen Befruchtung von Eizellen."
                                            },
                                            {
                                                "example_id": "865f1f75-caf2-4ae7-9d63-4f4b8df9d823",
                                                "sense_id": "3731edb3-4b5b-32cd-8d16-74dbcacdb89c",
                                                "text": "Im Gegensatz zur natürlichen sprechen wir hier von der künstlichen Synthese."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c8a74457-9f6d-3651-85e5-01d50a1e8bbf",
                                        "entry_id": "a3fde6ca-a5c9-30df-b2ab-59abe5154b9c",
                                        "glosses": [
                                            "gekünstelt, unnatürlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ab228d3-0af2-4592-b93b-179af960987d",
                                                "sense_id": "c8a74457-9f6d-3651-85e5-01d50a1e8bbf",
                                                "text": "Sie antwortete mit einem künstlichen Lachen."
                                            },
                                            {
                                                "example_id": "e5b3bee7-61f1-48cd-a37f-1c91e8ff1fbd",
                                                "sense_id": "c8a74457-9f6d-3651-85e5-01d50a1e8bbf",
                                                "text": "Wolfgang regt sich bei dem Thema immer gleich so künstlich auf, dabei hat er doch eigentlich gar keine Probleme damit, oder?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "76acbc73-a08c-3680-b218-6dad8e68d2e2",
                                        "entry_id": "a3fde6ca-a5c9-30df-b2ab-59abe5154b9c",
                                        "glosses": [
                                            "eine Kunst beziehungsweise ein Kunstwerk darstellend"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac357d9d-512a-4ebb-b2be-f79de1a9487a",
                                                "sense_id": "76acbc73-a08c-3680-b218-6dad8e68d2e2",
                                                "text": "„Er zerrt voll roher Lust und Tücke / Der Tante künstliches Gestricke“"
                                            },
                                            {
                                                "example_id": "0a053a7d-5285-43cd-b767-580b509a5f48",
                                                "sense_id": "76acbc73-a08c-3680-b218-6dad8e68d2e2",
                                                "text": "Würcken, ist eine künstliche Arbeit des Frauenzimmers, da auf einem Würckstuhle, mit Wolle oder Seide von allerhand Farben, Blumen, Früchte und andere Dinge, nach dem Leben abgebildet, und durch ein zartes Gewebe zierlich herausgebracht werden."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
