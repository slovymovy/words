                        ],
                        "examples": [
                            {
                                "example_id": "f27d0b06-074d-4e41-b5f6-df72f1ad8904",
                                "sense_id": "f686ce52-0701-3ff1-aaee-2606cf76ef4b",
                                "text": "Aby zwiedzić cały Manhattan, potrzeba co najmniej dwóch tygodni – zważywszy, że zajmuje on prawie 60 kilometrów kwadratowych powierzchni, czyli więcej, niż niektóre małe europejskie państewka."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ae4278fb-56ed-30a9-8a2c-dabbcd4ba62c",
                        "entry_id": "a8824976-0d20-360d-90cf-edee22a9610a",
                        "glosses": [
                            "niewielkie państwo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c007060-4206-4345-a13d-ca34eff49e7c",
                                "sense_id": "ae4278fb-56ed-30a9-8a2c-dabbcd4ba62c",
                                "text": "Przed rokiem 1480 psy przypominające osobniki tej rasy pojawiały się prawie wyłącznie na włoskich obrazach i można przypuszczać, że to z dworów książąt państewek włoskich moda na papillony rozszerzała się stopniowo na resztę Europy."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
