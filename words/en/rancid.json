{
    "word_family": [
        "rancidity",
        "rancidness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1e770467-aaee-32a0-ac82-fe9fb9dd6886",
                    "sense_definition": "Having a strong, unpleasant smell or taste, typically due to the decomposition of fats or oils.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "smell_taste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The butter had been left out in the sun and had turned <w>rancid</w>.",
                            "target_lang_translations": {
                                "tr": "Tereyağı güneşte kalmış ve <w>acılaşmıştı</w>."
                            }
                        },
                        {
                            "text": "We had to throw away the <w>rancid</w> meat because it smelled terrible.",
                            "target_lang_translations": {
                                "tr": "Çok kötü koktuğu için <w>bozuk</w> eti çöpe atmak zorunda kaldık."
                            }
                        }
                    ],
                    "synonyms": [
                        "putrid",
                        "spoiled",
                        "stale"
                    ],
                    "antonyms": [
                        "fresh"
                    ],
                    "common_phrases": [
                        "rancid butter",
                        "rancid oil"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yağların veya yağlı gıdaların bozulması sonucu oluşan, ağır ve kötü koku veya tat."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "acılaşmış",
                                "target_lang_sense_clarification": "Özellikle yağlı gıdaların bozulup tadının değişmesi durumu."
                            },
                            {
                                "target_lang_word": "bozuk",
                                "target_lang_sense_clarification": "Genel olarak tazeliğini yitirmiş ve kötü kokan gıdalar için kullanılır."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6480090-3bc6-306d-b595-f7a082a4c39c",
                    "sense_definition": "Highly offensive, unpleasant, or morally corrupt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "offensive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician made a <w>rancid</w> comment that shocked the entire audience.",
                            "target_lang_translations": {
                                "tr": "Siyasetçi, tüm dinleyicileri şoke eden <w>iğrenç</w> bir yorum yaptı."
                            }
                        },
                        {
                            "text": "His <w>rancid</w> attitude made it impossible for anyone to work with him.",
                            "target_lang_translations": {
                                "tr": "Onun <w>yozlaşmış</w> tavrı, kimsenin onunla çalışmasını imkansız hale getirdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "offensive",
                        "repulsive",
                        "vile"
                    ],
                    "antonyms": [
                        "pleasant"
                    ],
                    "target_lang_definitions": {
                        "tr": "Son derece rahatsız edici, iğrenç veya ahlaki açıdan yozlaşmış."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "iğrenç",
                                "target_lang_sense_clarification": "Ahlaki veya davranışsal olarak tiksindirici durumlar için."
                            },
                            {
                                "target_lang_word": "yozlaşmış",
                                "target_lang_sense_clarification": "Karakter veya tutumun ahlaki açıdan bozulmuş olması."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}