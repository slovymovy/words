                    "frequency": "Middle",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A political <w>rift</w> has divided the members of the committee.",
                            "target_lang_translations": {
                                "it": "Una <w>frattura</w> politica ha diviso i membri del comitato."
                            }
                        },
                        {
                            "text": "The long-standing <w>rift</w> between the two families finally began to heal.",
                            "target_lang_translations": {
                                "it": "La <w>discordia</w> di lunga data tra le due famiglie ha finalmente iniziato a sanarsi."
                            }
                        }
