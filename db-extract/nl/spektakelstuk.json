                        "examples": [
                            {
                                "example_id": "a6235456-d237-4d9b-b184-1a219ecba7bc",
                                "sense_id": "aa09d37e-af93-3827-a93c-df8c0f13d024",
                                "text": "PEC Zwolle en Heerenveen maken er geen spektakelstuk van, maar de Friezen zullen er maling aan hebben. Door een raak geschoten penalty van Anas Tahiri, staat sc Heerenveen keurig op een 0-1 voorsprong in Zwolle."
                            },
                            {
                                "example_id": "889215af-a093-49b3-8d3a-cd96a1b4e77c",
                                "sense_id": "aa09d37e-af93-3827-a93c-df8c0f13d024",
                                "text": "Newcastle United en Sven Botman hebben keihard uitgehaald bij Sheffield United. Op Bramall Lane werd het maar liefst 8-0 voor Newcastle. Ook de Londense derby tussen Tottenham Hotspur en Arsenal was een spektakelstuk. Dat duel eindigde in een 2-2 gelijkspel."
                            }
                        ]
                    }
