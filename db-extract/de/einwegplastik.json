                "senses": [
                    {
                        "sense_id": "a1f53b29-9514-3321-a856-8729fdb55924",
                        "entry_id": "785c0aac-d4c9-38ff-b65c-6785612fa4cc",
                        "glosses": [
                            "nur zur einmaligen Verwendung bestimmtes Plastik, das nachher als Müll entsorgt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41aec566-800c-462b-bb57-e5e7e93be462",
                                "sense_id": "a1f53b29-9514-3321-a856-8729fdb55924",
                                "text": "„Tonnen und sind damit nach Einwegplastik der zweitgrößte Mikroplastikverschmutzer in den Ozeanen.“"
                            },
                            {
                                "example_id": "0d4f299b-e0de-46b4-afe1-038c655b05a1",
                                "sense_id": "a1f53b29-9514-3321-a856-8729fdb55924",
                                "text": "„Interessant ist auch, dass der Film aufdeckt, dass die großen Verschmutzer der Meere weder Plastikstrohhalme noch Einwegplastik sind.“"
                            },
                            {
                                "example_id": "59d074b9-64cd-427e-8328-4b02723c6b42",
                                "sense_id": "a1f53b29-9514-3321-a856-8729fdb55924",
                                "text": "„Einwegplastik wird verboten und die Vernichtung von Retouren soll gestoppt werden.“"
                            },
                            {
                                "example_id": "4c63c357-5287-4d07-84c7-d6f3738abe26",
                                "sense_id": "a1f53b29-9514-3321-a856-8729fdb55924",
                                "text": "„Der Verzicht auf Einwegplastik in der kleinen Bar ist nur ein kleiner, sichtbarer Teil der gesamten, nachhaltigen Philosophie.“"
                            },
                            {
                                "example_id": "da7858f7-8706-4f1f-9c1a-e67828c7907b",
                                "sense_id": "a1f53b29-9514-3321-a856-8729fdb55924",
                                "text": "„Im Bucuti wurden schon in den 1980er-Jahren sämtliches Einwegplastik, Styropor und Aluminiumdosen aus Restaurants und Zimmern verbannt.“"
                            },
                            {
                                "example_id": "91dc8eef-cb76-4e62-a356-d3b0a79bad98",
                                "sense_id": "a1f53b29-9514-3321-a856-8729fdb55924",
                                "text": "„Unternehmen werden nicht verpflichtet, sich konkrete Ziele Reduzierung des Einwegplastiks zu setzen, das sie insgesamt produzieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
