                        "entry_id": "ad4770ef-61ed-3c12-98e9-e708333b0df8",
                        "glosses": [
                            "standardisiertes Verfahren zum Bewerten und Dokumentieren der Beweglichkeit von Gelenken"
                        ],
                        "tags": [
                            "Orthopädie"
                        ],
                        "examples": [
                            {
                                "example_id": "0aa9fc20-af77-4677-91f3-095b8ef9226f",
                                "sense_id": "eaefcb43-5a9b-3c7a-bf29-1ddfb9690d30",
                                "text": "„Die passive Gelenkbeweglichkeit wird nach der Neutral-Null-Methode gemessen.“"
                            },
                            {
                                "example_id": "6777c060-fd72-49be-b0da-f18467a9b425",
                                "sense_id": "eaefcb43-5a9b-3c7a-bf29-1ddfb9690d30",
                                "text": "„Bei der Neutral-Null-Methode gibt der abgelesene Winkelwert den Bewegungsausschlag von der Nullstellung aus an.“"
                            },
                            {
                                "example_id": "8acc77b8-bbd1-40af-80bd-cf02cdf00b59",
                                "sense_id": "eaefcb43-5a9b-3c7a-bf29-1ddfb9690d30",
                                "text": "„Bei den endoprothetischen Patienten wurde die Gelenkbeweglichkeit bei Reha-Aufnahme und -Entlassung nach der Neutral-Null-Methode (Nulldurchgangsmethode) erhoben.“"
                            }
                        ],
