{
    "word_family": [
        "fidgety"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8c8a6308-d0e8-3fb7-b911-178b42013ef1",
                    "sense_definition": "To move the body or parts of the body nervously or idly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child began to <w>fidget</w> in his seat because he was bored.",
                            "target_lang_translations": {
                                "ru": "Ребёнок начал <w>ёрзать</w> на сиденье, потому что ему было скучно."
                            }
                        },
                        {
                            "text": "Please stop <w>fidgeting</w> with your pen while I am talking.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, перестань <w>вертеть в руках</w> ручку, пока я говорю."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fidget in seat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Беспокойно, нервно двигаться или вертеть что-либо в руках от скуки или волнения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ёрзать",
                                "target_lang_sense_clarification": "беспокойно двигаться на месте"
                            },
                            {
                                "target_lang_word": "вертеться",
                                "target_lang_sense_clarification": "крутиться, не сидеть спокойно"
                            },
                            {
                                "target_lang_word": "крутить в руках",
                                "target_lang_sense_clarification": "теребить или перебирать предмет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd434a84-e494-3262-a1b0-b2b9063ac085",
                    "sense_definition": "To make someone feel uneasy or restless.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His constant tapping did <w>fidget</w> the other passengers on the train.",
                            "target_lang_translations": {
                                "ru": "Его постоянное постукивание действительно <w>нервировало</w> других пассажиров в поезде."
                            }
                        },
                        {
                            "text": "The loud noise seemed to <w>fidget</w> the nervous dog.",
                            "target_lang_translations": {
                                "ru": "Громкий шум, казалось, <w>беспокоил</w> и без того пугливую собаку."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять кого-либо нервничать, беспокоиться или раздражаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нервировать",
                                "target_lang_sense_clarification": "вызывать раздражение или беспокойство"
                            },
                            {
                                "target_lang_word": "беспокоить",
                                "target_lang_sense_clarification": "лишать покоя"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1c17f80e-6675-3e74-a342-49f87589c301",
                    "sense_definition": "A nervous or restless movement of the body.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden <w>fidget</w> betrayed her hidden anxiety during the interview.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>нервное движение</w> выдало её скрытую тревогу во время собеседования."
                            }
                        },
                        {
                            "text": "He tried to suppress every <w>fidget</w> to appear calm.",
                            "target_lang_translations": {
                                "ru": "Он пытался подавить любое <w>ёрзание</w>, чтобы казаться спокойным."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нервное или суетливое движение тела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нервное движение",
                                "target_lang_sense_clarification": "непроизвольное суетливое действие"
                            },
                            {
                                "target_lang_word": "ёрзание",
                                "target_lang_sense_clarification": "беспокойное движение на месте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57dedaf4-daf1-3b6b-a00a-74e749ded6eb",
                    "sense_definition": "A person who moves restlessly or nervously on a regular basis.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher told the little <w>fidget</w> to sit still.",
                            "target_lang_translations": {
                                "ru": "Учитель сказал маленькому <w>непоседе</w> посидеть смирно."
                            }
                        },
                        {
                            "text": "She is such a <w>fidget</w> that she cannot watch a movie without moving.",
                            "target_lang_translations": {
                                "ru": "Она такая <w>егоза</w>, что не может посмотреть фильм, не шевелясь."
                            }
                        }
                    ],
                    "synonyms": [
                        "fidgeter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Суетливый, подвижный человек, которому трудно усидеть на месте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непоседа",
                                "target_lang_sense_clarification": "человек или ребёнок, который не может сидеть смирно"
                            },
                            {
                                "target_lang_word": "егоза",
                                "target_lang_sense_clarification": "очень подвижный, вертлявый человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac2d23c1-b6f6-313f-ac4e-29f844a1b812",
                    "sense_definition": "A small object designed to be handled to relieve stress or boredom.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He keeps a small <w>fidget</w> on his desk to help him focus.",
                            "target_lang_translations": {
                                "ru": "Он держит на столе маленький <w>фиджет</w>, чтобы лучше сосредоточиться."
                            }
                        },
                        {
                            "text": "Using a <w>fidget</w> can help some people manage their anxiety.",
                            "target_lang_translations": {
                                "ru": "Использование <w>игрушки-антистресс</w> может помочь некоторым людям справиться с тревогой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fidget toy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой предмет или игрушка для верчения в руках, помогающая снять стресс или сосредоточиться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фиджет",
                                "target_lang_sense_clarification": "игрушка-антистресс"
                            },
                            {
                                "target_lang_word": "игрушка-антистресс",
                                "target_lang_sense_clarification": "предмет для снятия напряжения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}