                    {
                        "translation_id": "dff56db9-45ad-4473-a1f0-8d7300a70852",
                        "source_entry_id": "cba88883-40fe-3781-abca-8e0817645dd5",
                        "source_sense_id": "5957a941-4a4e-3e00-b248-40f0987a16b6",
                        "source_sense_description": "plat hoofddeksel zonder klep",
                        "target_lang_word": "Baskenmütze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baskenmütze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7dac4c8-95f7-357b-9230-426ae86daf3e",
                                        "entry_id": "f90a8995-b682-30ae-9411-30850edafcd8",
                                        "glosses": [
                                            "weiche, flache Mütze als Wolle oder Filz, die keinen Schirm oder Rand hat und mit dem Barett verwandt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a83f8f6-8c7f-4019-9cba-b6439e512d8e",
                                                "sense_id": "c7dac4c8-95f7-357b-9230-426ae86daf3e",
                                                "text": "Die Baskenmütze gehört ebenso zum Klischee des Franzosen wie die Flasche Rotwein und das Baguette unterm Arm."
                                            },
                                            {
                                                "example_id": "58769f73-5ba0-4d68-bd2a-008fb000a12f",
                                                "sense_id": "c7dac4c8-95f7-357b-9230-426ae86daf3e",
                                                "text": "Die Baskenmütze, die Kurt Tucholsky einen \"Eisbeutel aus Tuch mit einem Zippelchen obendrauf\" genannt hat, stammt eigentlich aus Béarn."
                                            },
                                            {
                                                "example_id": "f6964887-fc52-4cbf-b09f-22ef8778c395",
                                                "sense_id": "c7dac4c8-95f7-357b-9230-426ae86daf3e",
                                                "text": "Che Guevara trug eine, der baskische General Zumalacárregui sowieso, und während der Französischen Revolution war sie ein unvermeidliches Modeaccessoire: die Baskenmütze."
                                            },
                                            {
                                                "example_id": "522e693c-c599-4a8e-84d5-3191042991c2",
                                                "sense_id": "c7dac4c8-95f7-357b-9230-426ae86daf3e",
                                                "text": "„Man sieht den Medizinstudenten, der anfangs eine Baskenmütze, dann einen Hut trägt, verzweifelt rauchen und Tabletten schlucken.“"
                                            },
                                            {
                                                "example_id": "9daa591c-025f-4fb8-a0a8-08cc946b0354",
                                                "sense_id": "c7dac4c8-95f7-357b-9230-426ae86daf3e",
                                                "text": "„Maria Fiola stand auf einmal auf dem Podium, schmal und eng in einen schwarzen, mattschimmernden Mantel gewickelt, eine Art Baskenmütze aus demselben dünnen, glänzenden Fell schief auf dem Kopf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21b43380-eb54-4177-8bb6-9fa11e8030fe",
                        "source_entry_id": "cba88883-40fe-3781-abca-8e0817645dd5",
                        "source_sense_id": "5957a941-4a4e-3e00-b248-40f0987a16b6",
