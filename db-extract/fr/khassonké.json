                        "glosses": [
                            "Langue mandingue d’Afrique de l’Ouest parlée principalement au Mali ainsi qu’en Gambie et au Sénégal par les Khassonkés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db04a014-df37-478f-a690-8347837c596f",
                                "sense_id": "8a9b9668-b259-3076-a82d-b274e6f3e283",
                                "text": "Lorsque les missionnaires savent suffisamment la langue locale, le khassonké, ils commencent l’évangélisation des villages."
                            }
                        ]
                    }
