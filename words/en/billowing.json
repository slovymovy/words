{
    "word_family": [
        "billow",
        "billowy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "944e5606-350a-3b3c-bd55-3ab1fa85362f",
                    "sense_definition": "present participle and gerund of <w>billow</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thick smoke was <w>billowing</w> from the windows of the burning building.",
                            "target_lang_translations": {
                                "nl": "Dikke rook <w>walsde uit</w> de ramen van het brandende gebouw."
                            }
                        },
                        {
                            "text": "The curtains were <w>billowing</w> in the gentle summer breeze.",
                            "target_lang_translations": {
                                "nl": "De gordijnen <w>waaiden op</w> in het zachte zomerbriesje."
                            }
                        }
                    ],
                    "common_phrases": [
                        "smoke billowing",
                        "curtains billowing"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het zich in grote, golvende massa's verplaatsen of opzwellen, zoals rook, stof of stof in de wind."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "opwaaien",
                                "target_lang_sense_clarification": "gebruikt voor stoffen of gordijnen die door de wind bewegen"
                            },
                            {
                                "target_lang_word": "uitwalsen",
                                "target_lang_sense_clarification": "gebruikt voor rook of wolken die zich in grote massa's verspreiden"
                            },
                            {
                                "target_lang_word": "golven",
                                "target_lang_sense_clarification": "algemene term voor een beweging in golvende patronen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "776af521-a8b2-3b88-9e38-59fec83405ce",
                    "sense_definition": "The act of moving or swelling in large, rolling waves or clouds.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>billowing</w> of the sails signaled that the ship was ready to depart.",
                            "target_lang_translations": {
                                "nl": "Het <w>bolstaan</w> van de zeilen gaf aan dat het schip klaar was om te vertrekken."
                            }
                        },
                        {
                            "text": "She watched the <w>billowing</w> of the storm clouds across the dark horizon.",
                            "target_lang_translations": {
                                "nl": "Ze keek naar het <w>golven</w> van de stormwolken over de donkere horizon."
                            }
                        }
                    ],
                    "synonyms": [
                        "surging",
                        "swelling",
                        "undulation"
                    ],
                    "common_phrases": [
                        "constant billowing"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het proces of de beweging van het opzwellen of golven in grote massa's."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "het golven",
                                "target_lang_sense_clarification": "de actie van het bewegen in golven"
                            },
                            {
                                "target_lang_word": "het opzwellen",
                                "target_lang_sense_clarification": "de actie van het groter worden of uitdijen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}