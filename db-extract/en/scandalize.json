                                    {
                                        "sense_id": "adf2634c-240a-3f7a-921c-3b85657f5bb7",
                                        "entry_id": "3fdbda34-888c-394f-8db9-01a526dddee5",
                                        "glosses": [
                                            "Mettre en danger de chute, de péché."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9aff9c1e-df79-4c92-8263-b6acea4464ec",
                                                "sense_id": "adf2634c-240a-3f7a-921c-3b85657f5bb7",
                                                "text": "Scandaliser un enfant par ses propos, par son exemple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "627d7d2e-f83b-3897-9cd0-67db6926cc00",
                                        "entry_id": "3fdbda34-888c-394f-8db9-01a526dddee5",
                                        "glosses": [
                                            "Choquer par l’éclat du mauvais exemple ; causer, provoquer du scandale."
                                        ],
                                        "tags": [
                                            "Plus courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2283c0d-f64d-41f1-a580-80f097f8343e",
                                                "sense_id": "627d7d2e-f83b-3897-9cd0-67db6926cc00",
                                                "text": "Votre vie scandalise tout le monde."
                                            },
                                            {
                                                "example_id": "366ceb4f-7611-4154-b007-337f6f3a1a46",
                                                "sense_id": "627d7d2e-f83b-3897-9cd0-67db6926cc00",
                                                "text": "Ces discours licencieux le scandalisèrent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "563f86de-e6d5-39ba-b832-f211156eab1f",
                                        "entry_id": "3fdbda34-888c-394f-8db9-01a526dddee5",
                                        "glosses": [
                                            "S’indigner, se choquer, s’offenser."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2229292-e9ca-46e5-b258-12276f68039d",
                                                "sense_id": "563f86de-e6d5-39ba-b832-f211156eab1f",
                                                "text": "Il se scandalise de tout."
                                            },
                                            {
                                                "example_id": "61bf1cc9-f051-46be-b04b-407432829954",
                                                "sense_id": "563f86de-e6d5-39ba-b832-f211156eab1f",
                                                "text": "Ne vous scandalisez pas de ce qu’il dit."
                                            }
                                        ]
                                    }
                                ]
                            }
