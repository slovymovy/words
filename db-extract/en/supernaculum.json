                "senses": [
                    {
                        "sense_id": "38432114-6bd1-30ed-bb8f-4d5e6fbc3f66",
                        "entry_id": "9b5b6593-4c6a-318a-bbef-a8316f632543",
                        "glosses": [
                            "According to the rules of an old drinking game in which the drinker upturned the empty cup and had to drink more if the remaining droplets spilled beyond the edge of his fingernail."
                        ],
                        "tags": [
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "38209ec3-acff-338c-90fb-452063faebd7",
                        "entry_id": "9b5b6593-4c6a-318a-bbef-a8316f632543",
                        "glosses": [
                            "To the last drop, to the bottom."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c95ca6af-4faa-4636-bc5e-56934444fcdd",
                                "sense_id": "38209ec3-acff-338c-90fb-452063faebd7",
                                "text": "Nay, it shall be an overflowing bumper an you will; and I will drink it super naculum."
                            },
                            {
                                "example_id": "e47e8bfa-8e49-49ff-b829-422cebeef745",
                                "sense_id": "38209ec3-acff-338c-90fb-452063faebd7",
                                "text": "A dream put Aristotle out of breath, / A meteor he said, ’twixt life and death. “An quid fit frustra? An datur vacuum? Fill the pot, Edy! Supernaculum.” A blazing star’s a rare spectaculum!"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "5499df66-43f1-39e6-af1a-0a874f03839c",
                "word": "supernaculum",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c9586da8-4e65-37cb-823f-b86f8e47959e",
                        "entry_id": "5499df66-43f1-39e6-af1a-0a874f03839c",
                        "glosses": [
                            "Excellent wine that one would wish to drink to the last drop."
                        ],
                        "tags": [
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "99c6d284-6a93-4c28-8d48-736052f4fa9d",
                                "sense_id": "c9586da8-4e65-37cb-823f-b86f8e47959e",
                                "text": "I've placed another flaggon on the table. Your worship knows it— number thirty-five:— the supernaculum."
                            },
                            {
                                "example_id": "1a4842b4-c99e-469a-ba64-79f1ef6f2af3",
                                "sense_id": "c9586da8-4e65-37cb-823f-b86f8e47959e",
                                "text": "Between the mattings, or dangling from the arched awning, an experienced eye may detect little pet barrels of supernaculum; some racy wine sent as a present from the correrero of Malaga, to some old friend or patron in the metropolis."
                            }
                        ]
                    }
                ],
