                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "70efdebf-fa2a-4803-8a9b-e284673ba7a8",
                        "entry_id": "f7417fcb-2d24-36b3-b67f-d85e413c90f5",
                        "tags": [
                            "nominative",
                            "singular"
                        ],
                        "form": "der Brexit"
                    },
                    {
                        "form_id": "b147a1ad-a65a-4300-bdf9-b0fb3c4575ba",
                        "entry_id": "f7417fcb-2d24-36b3-b67f-d85e413c90f5",
                        "tags": [
                            "genitive",
