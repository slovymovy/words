                    {
                        "translation_id": "1720a93d-9206-47b7-92cd-d4552bb40485",
                        "source_entry_id": "3d9fa4a7-ba78-3bf2-8ff3-96d0e08878ee",
                        "source_sense_id": "c2ff545d-d783-345f-b8ea-7ef652be86e8",
