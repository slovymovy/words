    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b7e1630d-b5c0-3304-95df-40a0d86bb4db",
                    "sense_definition": "mały, ruchliwy chłopiec",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dziecko",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten mały <w>smyk</w> biegał cały dzień po podwórku.",
                            "target_lang_translations": {
                                "ru": "Этот маленький <w>карапуз</w> бегал весь день по двору."
                            }
                        },
                        {
                            "text": "Mój <w>smyk</w> uwielbia bawić się klockami w swoim pokoju.",
                            "target_lang_translations": {
                                "ru": "Мой <w>сорванец</w> обожает играть с кубиками в своей комнате."
                            }
                        }
                    ],
                    "synonyms": [
                        "szkrab",
                        "psotnik",
                        "łobuziak"
                    ],
                    "target_lang_definitions": {
                        "ru": "маленький, подвижный мальчик"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карапуз",
                                "target_lang_sense_clarification": "разговорное, шутливое обозначение маленького ребенка"
                            },
                            {
                                "target_lang_word": "сорванец",
                                "target_lang_sense_clarification": "озорной, непоседливый мальчик"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7da8efda-9c9a-3d42-b260-40a333c1c5ca",
                    "sense_definition": "pasek przy pasie służący do noszenia noża",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Myśliwy zawiesił swój nóż na skórzanym <w>smyku</w> przy pasie.",
                            "target_lang_translations": {
                                "ru": "Охотник повесил свой нож на кожаный <w>ремешок</w> на поясе."
                            }
                        },
                        {
                            "text": "Stary <w>smyk</w> był już mocno przetarty od częstego używania.",
                            "target_lang_translations": {
                                "ru": "Старый <w>ремешок</w> был уже сильно протерт от частого использования."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "termin rzadko używany w nowoczesnej polszczyźnie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "ремешок на поясе для ношения ножа"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ремешок",
                                "target_lang_sense_clarification": "узкая полоска кожи или другого материала для крепления"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2999ea90-556a-3278-942d-43487aeae638",
                    "sense_definition": "polskie nazwisko męskie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pan <w>Smyk</w> pracuje w naszym dziale księgowości.",
                            "target_lang_translations": {
                                "ru": "Господин <w>Смык</w> работает в нашем отделе бухгалтерии."
                            }
                        },
                        {
                            "text": "Dzisiaj spotkałem się z panem <w>Smykiem</w> w sprawie umowy.",
                            "target_lang_translations": {
                                "ru": "Сегодня я встретился с господином <w>Смыком</w> по поводу договора."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nazwisko"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "польская мужская фамилия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Смык",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb90827a-a694-3ad2-9154-d77d2f9ee41c",
                    "sense_definition": "polskie nazwisko żeńskie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pani <w>Smyk</w> prowadzi dzisiaj bardzo ważne szkolenie.",
                            "target_lang_translations": {
                                "ru": "Госпожа <w>Смык</w> проводит сегодня очень важный тренинг."
                            }
                        },
                        {
                            "text": "Rozmawiałem wczoraj z panią <w>Smyk</w> o wynikach egzaminu.",
                            "target_lang_translations": {
                                "ru": "Я разговаривал вчера с госпожой <w>Смык</w> о результатах экзамена."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nazwisko"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "польская женская фамилия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Смык",
                                "target_lang_sense_clarification": "фамилия (не склоняется)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
