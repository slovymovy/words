                ],
                "senses": [
                    {
                        "sense_id": "eb103ace-8c63-3d5a-ab75-a7bb1a974786",
                        "entry_id": "693d9bbc-b34d-39cd-b279-fac0eb723734",
                        "glosses": [
                            "Person, die sich für die sogenannten Menschenrechte einsetzt; diese verteidigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ead32ee-2af6-4a54-98a6-34e2b381c776",
                                "sense_id": "eb103ace-8c63-3d5a-ab75-a7bb1a974786",
                                "text": "„Die Pinneberger Gruppe der Menschenrechtsorganisation Amnesty International hat erfolgreich an der Freilassung des kurdischen Rechtsanwalts und Menschenrechtsverteidigers Sabri Mirza mitgewirkt.“"
                            },
                            {
                                "example_id": "de65b67e-12a6-453c-9e30-cfab666540e7",
                                "sense_id": "eb103ace-8c63-3d5a-ab75-a7bb1a974786",
                                "text": "„Zahlreiche Menschenrechtsverteidiger würden in als inoffizielle Gefängnisse genutzte Keller oder Hotels eingesperrt, erklärte die Organisation am Dienstag.“"
                            },
                            {
                                "example_id": "773db737-8cd9-4a0c-a030-13bd451e94ea",
                                "sense_id": "eb103ace-8c63-3d5a-ab75-a7bb1a974786",
                                "text": "„Russland gefällt sich gerade in der Rolle des globalen Menschenrechtsverteidigers und verurteilt gleichzeitig Kreml-Kritiker Alexej Nawalny zu einer hohen Haftstrafe.“"
                            },
                            {
                                "example_id": "0b272c8b-c4be-4ec5-ba38-7736f717d3a7",
                                "sense_id": "eb103ace-8c63-3d5a-ab75-a7bb1a974786",
                                "text": "„In Iran sind alle Menschenrechtsorganisationen und -gruppen verboten, selbst das Zentrum für Menschenrechtsverteidiger der Friedensnobelpreisträgerin Shirin Ebadi.“"
                            },
                            {
                                "example_id": "33331a81-8ff6-416e-9d20-0c71922b9cf1",
                                "sense_id": "eb103ace-8c63-3d5a-ab75-a7bb1a974786",
                                "text": "„Wie abstoßend sie den meisten Menschenrechtsverteidigern auch erscheinen mag: Die Todesstrafe ist eine rechtliche Sanktion, eine Strafe, die nach einem mutmaßlich fairen Verfahren ausgesprochen wird, dem oft verschiedene Berufungsmöglichkeiten folgen, sofern solche Fairness nicht gewährleistet war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
