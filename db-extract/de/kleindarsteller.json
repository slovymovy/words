                "senses": [
                    {
                        "sense_id": "7b370ce3-69cd-3303-967c-98ad6893e765",
                        "entry_id": "5fda70a4-eaf2-38ec-a3ab-443ce164f620",
                        "glosses": [
                            "Darsteller, vor allem in einem Film oder einem Theaterstück, welcher keine tragende Rolle spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f9c73af-cd61-4db7-bce8-a197229976f3",
                                "sense_id": "7b370ce3-69cd-3303-967c-98ad6893e765",
                                "text": "„Neben den Hauptdarstellern sollen dann 500 Komparsen und 40 Kleindarsteller vor der Kamera stehen.“"
                            },
                            {
                                "example_id": "f3e6321a-7aac-4a47-a7c8-d35e870047a4",
                                "sense_id": "7b370ce3-69cd-3303-967c-98ad6893e765",
                                "text": "„Übrigens, sobald Sätze wie ‚Hilfe, Hilfe, mein Bein ist gebrochen‘ gesprochen werden, darf der Komparse sich bereits Kleindarsteller nennen. Das ist doch was.“"
                            }
                        ],
