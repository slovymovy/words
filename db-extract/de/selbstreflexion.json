                "senses": [
                    {
                        "sense_id": "d08e5e51-3f9c-374b-b242-6312631bfc30",
                        "entry_id": "3354e22c-9e07-341d-a983-f631529285e8",
                        "glosses": [
                            "vertieftes Nachdenken über sich selbst oder über etwas, was von einem selbst geschaffen/produziert/getan wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "550c21d9-71af-40ec-849f-8ce5971bd4aa",
                                "sense_id": "d08e5e51-3f9c-374b-b242-6312631bfc30",
                                "text": "„Es soll auf essayistische Weise gezeigt werden, dass in der Märchenpsychologie eine kritische Selbstreflexion dringend geboten ist.“"
                            },
                            {
                                "example_id": "c2205a17-72ad-4ed5-805a-72c5520e22b4",
                                "sense_id": "d08e5e51-3f9c-374b-b242-6312631bfc30",
                                "text": "„Trotz aller Selbstreflexionen und Ablenkungen beginnt er, sich vorsichtig und zurückhaltend zu engagieren.“"
                            },
                            {
                                "example_id": "9ec2d8d6-1dd7-4f02-b263-5cc650464fd7",
                                "sense_id": "d08e5e51-3f9c-374b-b242-6312631bfc30",
                                "text": "„Mugabe, der Politiker, erwies sich während seiner gesamten Laufbahn als unzugänglich für Kritik und unfähig zur Selbstreflexion.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
