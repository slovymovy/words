                "senses": [
                    {
                        "sense_id": "7298a98c-55c8-32aa-a391-b41ee2adfa72",
                        "entry_id": "96048fb7-f1a6-331e-9e6a-9d8d65350d9f",
                        "glosses": [
                            "An ancient empire and geographic region of Mesopotamia, existing from 1850 BCE to 539 BCE, based around the city of Babylon; at its maximum extent, covering parts of modern-day Iraq, Kuwait, Syria and Iran."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "35a87071-2c70-37a5-b45a-90b7970e4da1",
                        "entry_id": "96048fb7-f1a6-331e-9e6a-9d8d65350d9f",
                        "glosses": [
                            "A geographic area equivalent to Mesopotamia, from the area of Babylon's empire at its maximum extent."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    }
                ],
