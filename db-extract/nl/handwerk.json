                                        "sense_id": "64651f73-97ed-3eba-80f5-89e1f1b508ee",
                                        "entry_id": "0e1acd14-a9d9-3137-aaa1-27c8830b2327",
                                        "glosses": [
                                            "A trade requiring skill of hand; manual occupation; handcraft."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0be86f32-48d0-4ae3-b3d6-830da36da641",
                                                "sense_id": "64651f73-97ed-3eba-80f5-89e1f1b508ee",
                                                "text": "I regard the Grand Seignior , who is obliged , by an express command in the Alcoran , to learn and practise some handicraft trade"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7edb682-f883-369d-9156-b558bb380845",
                                        "entry_id": "0e1acd14-a9d9-3137-aaa1-27c8830b2327",
                                        "glosses": [
                                            "An artifact produced by handicraft."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6ac211a-294f-3636-ad2c-2077976dcf0e",
                                        "entry_id": "0e1acd14-a9d9-3137-aaa1-27c8830b2327",
                                        "glosses": [
                                            "A man who earns his living by handicraft; a handicraftsman."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67cf9792-0338-407c-8387-2615fc97fae6",
                                                "sense_id": "a6ac211a-294f-3636-ad2c-2077976dcf0e",
                                                "text": "his men were all baſe handie craftes, as coblers, and curriers, and tinkers, whereof ſome had barres of yron[…]"
                                            },
                                            {
                                                "example_id": "429a24b0-e506-45bd-9a22-ade5648a0bb3",
                                                "sense_id": "a6ac211a-294f-3636-ad2c-2077976dcf0e",
                                                "text": "the Handicrafts-Shops begin to open"
                                            },
                                            {
                                                "example_id": "8cc8df27-137e-47a4-801f-9f099bc7755a",
                                                "sense_id": "a6ac211a-294f-3636-ad2c-2077976dcf0e",
                                                "text": "The M[e]chanicks, and handy-crafts were Induſtrious, Thrifty, and the main ſupporters of the Trade of France."
                                            },
                                            {
                                                "example_id": "a40d441d-20f5-4c03-ac8e-ca1ded69e51a",
                                                "sense_id": "a6ac211a-294f-3636-ad2c-2077976dcf0e",
                                                "text": "\"Why, thou knowest, father,\" he said, smiling, \"that we handicrafts best love the folks we live by;[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
