{
    "word_family": [
        "fantasy",
        "fantastical",
        "fantastically",
        "fantasize",
        "fantast"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "13935912-4cec-344c-ad69-fc0b6dbc363f",
                    "sense_definition": "Extremely good, wonderful, or impressive.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "excellent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had a <w>fantastic</w> time at the beach last weekend.",
                            "target_lang_translations": {
                                "ru": "Мы <w>чудесно</w> провели время на пляже в прошлые выходные.",
                                "zh": "上周末我们在海滩度过了一段<w>极好的</w>时光。"
                            }
                        },
                        {
                            "text": "The food at that new restaurant is <w>fantastic</w> and very affordable.",
                            "target_lang_translations": {
                                "ru": "Еда в том новом ресторане <w>превосходная</w> и очень доступная по цене.",
                                "zh": "那家新餐馆的食物<w>棒极了</w>，而且价格非常实惠。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wonderful",
                        "excellent",
                        "great",
                        "superb",
                        "terrific",
                        "marvelous"
                    ],
                    "common_phrases": [
                        "fantastic news",
                        "fantastic job",
                        "fantastic opportunity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно хороший, замечательный или впечатляющий.",
                        "zh": "极其好、精彩或令人印象深刻的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фантастический",
                                "target_lang_sense_clarification": "в значении превосходный"
                            },
                            {
                                "target_lang_word": "чудесный",
                                "target_lang_sense_clarification": "очень хороший"
                            },
                            {
                                "target_lang_word": "великолепный",
                                "target_lang_sense_clarification": "впечатляющий"
                            },
                            {
                                "target_lang_word": "превосходный",
                                "target_lang_sense_clarification": "высшего качества"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极好的",
                                "target_lang_sense_clarification": "非常出色"
                            },
                            {
                                "target_lang_word": "精彩的",
                                "target_lang_sense_clarification": "令人赞叹"
                            },
                            {
                                "target_lang_word": "棒极了",
                                "target_lang_sense_clarification": "口语中表示非常好"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9edaafd-089b-32bd-a938-e932a59de410",
                    "sense_definition": "Based on or existing only in fantasy; not real or practical.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "imaginary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author created a <w>fantastic</w> world filled with dragons and magic.",
                            "target_lang_translations": {
                                "ru": "Автор создал <w>фантастический</w> мир, наполненный драконами и магией.",
                                "zh": "作者创造了一个充满龙和魔法的<w>虚构</w>世界。"
                            }
                        },
                        {
                            "text": "His <w>fantastic</w> plans for a moon colony were never taken seriously by the government.",
                            "target_lang_translations": {
                                "ru": "Его <w>фантастические</w> планы по созданию колонии на Луне никогда не воспринимались правительством всерьез.",
                                "zh": "他关于月球殖民地的<w>不切实际的</w>计划从未被政府认真对待过。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fanciful",
                        "imaginary",
                        "unreal",
                        "wild"
                    ],
                    "antonyms": [
                        "realistic"
                    ],
                    "common_phrases": [
                        "fantastic creatures",
                        "fantastic stories"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основанный на фантазии или существующий только в воображении; нереальный или непрактичный.",
                        "zh": "基于幻想或仅存在于想象中；不现实或不切实际的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фантастический",
                                "target_lang_sense_clarification": "вымышленный"
                            },
                            {
                                "target_lang_word": "воображаемый",
                                "target_lang_sense_clarification": "не существующий в реальности"
                            },
                            {
                                "target_lang_word": "нереальный",
                                "target_lang_sense_clarification": "неосуществимый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "虚构的",
                                "target_lang_sense_clarification": "非真实存在"
                            },
                            {
                                "target_lang_word": "幻想的",
                                "target_lang_sense_clarification": "存在于想象中"
                            },
                            {
                                "target_lang_word": "不切实际的",
                                "target_lang_sense_clarification": "无法实现的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f63e263e-3eb2-310d-b5f8-22571536d7f1",
                    "sense_definition": "So unlikely or extreme as to be difficult to believe.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "unbelievable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company made <w>fantastic</w> claims about their product that turned out to be false.",
                            "target_lang_translations": {
                                "ru": "Компания делала <w>невероятные</w> заявления о своем продукте, которые оказались ложными.",
                                "zh": "该公司对其产品做出了<w>难以置信的</w>声明，结果证明是虚假的。"
                            }
                        },
                        {
                            "text": "It seems <w>fantastic</w> to suggest that the entire project could be finished in one day.",
                            "target_lang_translations": {
                                "ru": "Предположение о том, что весь проект можно завершить за один день, кажется <w>неправдоподобным</w>.",
                                "zh": "认为整个项目可以在一天内完成，这听起来太<w>荒诞</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "implausible",
                        "unbelievable",
                        "incredible",
                        "preposterous"
                    ],
                    "antonyms": [
                        "reasonable",
                        "realistic"
                    ],
                    "common_phrases": [
                        "fantastic claims",
                        "fantastic amount"
                    ],
                    "target_lang_definitions": {
                        "ru": "Настолько маловероятный или крайний, что в него трудно поверить.",
                        "zh": "极其不可能或极端，以至于难以置信。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невероятный",
                                "target_lang_sense_clarification": "трудноповеримый"
                            },
                            {
                                "target_lang_word": "фантастический",
                                "target_lang_sense_clarification": "крайне маловероятный"
                            },
                            {
                                "target_lang_word": "неправдоподобный",
                                "target_lang_sense_clarification": "вызывающий сомнения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "难以置信的",
                                "target_lang_sense_clarification": "令人怀疑"
                            },
                            {
                                "target_lang_word": "荒诞的",
                                "target_lang_sense_clarification": "极不合理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04a3a993-ce86-334a-b417-685358846bda",
                    "sense_definition": "Strange and unusual in shape or appearance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "strange_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old tree had <w>fantastic</w> roots that twisted in every direction.",
                            "target_lang_translations": {
                                "ru": "У старого дерева были <w>причудливые</w> корни, извивающиеся во всех направлениях.",
                                "zh": "那棵老树有着向四面八方扭曲的<w>奇形怪状的</w>根。"
                            }
                        },
                        {
                            "text": "The cave was filled with <w>fantastic</w> rock formations that looked like frozen waves.",
                            "target_lang_translations": {
                                "ru": "Пещера была заполнена <w>фантастическими</w> скальными образованиями, похожими на застывшие волны.",
                                "zh": "洞穴里布满了看起来像凝固波浪一样的<w>离奇</w>岩层。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grotesque",
                        "bizarre",
                        "eccentric",
                        "irregular"
                    ],
                    "common_phrases": [
                        "fantastic shapes",
                        "fantastic appearance"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Странный и необычный по форме или внешнему виду.",
                        "zh": "形状或外观奇特且不寻常的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "причудливый",
                                "target_lang_sense_clarification": "необычной формы"
                            },
                            {
                                "target_lang_word": "фантастический",
                                "target_lang_sense_clarification": "причудливый и странный"
                            },
                            {
                                "target_lang_word": "вычурный",
                                "target_lang_sense_clarification": "излишне сложный по форме"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "奇形怪状的",
                                "target_lang_sense_clarification": "形状古怪"
                            },
                            {
                                "target_lang_word": "离奇的",
                                "target_lang_sense_clarification": "外观不寻常"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "700d9d55-3817-3681-a2f8-cec6d146e4a1",
                    "sense_definition": "A person who is fanciful, whimsical, or eccentric.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was known as a <w>fantastic</w> who spent his days dreaming of impossible inventions.",
                            "target_lang_translations": {
                                "ru": "Он был известен как <w>фантазер</w>, который проводил свои дни, мечтая о невозможных изобретениях.",
                                "zh": "他被称为一个<w>空想家</w>，整天梦想着那些不可能的发明。"
                            }
                        },
                        {
                            "text": "The salon was a gathering place for poets, artists, and other <w>fantastics</w> of the era.",
                            "target_lang_translations": {
                                "ru": "Салон был местом сбора поэтов, художников и других <w>чудаков</w> той эпохи.",
                                "zh": "沙龙是那个时代诗人、艺术家和其他<w>怪人</w>的聚集地。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dreamer",
                        "eccentric"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a noun in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, склонный к фантазиям, причудам или эксцентричности.",
                        "zh": "爱幻想、古怪或行为怪异的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фантазер",
                                "target_lang_sense_clarification": "человек, который много мечтает"
                            },
                            {
                                "target_lang_word": "чудак",
                                "target_lang_sense_clarification": "эксцентричный человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "空想家",
                                "target_lang_sense_clarification": "爱做梦的人"
                            },
                            {
                                "target_lang_word": "怪人",
                                "target_lang_sense_clarification": "行为古怪的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}