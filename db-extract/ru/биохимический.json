                                        "glosses": [
                                            "auf der Biochemie basierend, sie betreffend oder zu ihr gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36175e4d-c3a4-40a9-b183-605ee0fa9c78",
                                                "sense_id": "e548330d-52f4-3fd1-87bd-2fba14a2352d",
                                                "text": "Bei der Hausdurchsuchung des Verdächtigen wurde eine biochemische Substanz gefunden, die als gefährlich eingestuft wird."
                                            },
                                            {
                                                "example_id": "46899f89-5c14-4cd9-9ba6-e6e68237194e",
                                                "sense_id": "e548330d-52f4-3fd1-87bd-2fba14a2352d",
                                                "text": "„Davis, ein Genetiker, der früher biochemische Forschungen betrieb, wirft die Bettdecke beiseite und eilt über eine gewundene Holztreppe hinunter ins Erdgeschoss.“"
                                            }
