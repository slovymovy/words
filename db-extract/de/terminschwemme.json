                    {
                        "sense_id": "76c8e294-c3ca-3d1a-8def-b1b727e956a1",
                        "entry_id": "f8e970aa-4bd9-3108-832e-277de6df361e",
                        "glosses": [
                            "hohe Anzahl an Terminen innerhalb kurzer Zeit"
