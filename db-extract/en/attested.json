                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa50e89e-d4af-4334-87c7-48157a897dac",
                                "sense_id": "f3dbf23b-e7a4-311f-9387-b5e8444e65bc",
                                "text": "The word \"slæpwerig\" (sleep-weary) is attested in the Exeter Book in the form \"slæpwerigne\"."
                            },
                            {
                                "example_id": "ad72fa60-a076-4992-8e96-bbb61827cb48",
                                "sense_id": "f3dbf23b-e7a4-311f-9387-b5e8444e65bc",
                                "text": "A term should be included if it's likely that someone would run across it and want to know what it means. This in turn leads to the somewhat more formal guideline of including a term if it is attested and idiomatic."
                            }
                        ]
                    }
