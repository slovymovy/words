{
    "word_family": [
        "overtly",
        "overtness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "02ee10a2-b60e-3ca2-b526-87324bc10226",
                    "sense_definition": "Done or shown openly; plainly apparent and not concealed or secret.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "open_apparent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician faced severe criticism after making several <w>overt</w> threats against the press.",
                            "target_lang_translations": {
                                "ru": "Политик столкнулся с жёсткой критикой после того, как высказал несколько <w>открытых</w> угроз в адрес прессы.",
                                "zh": "该政客在对媒体发出数次<w>公开的</w>威胁后遭到了严厉批评。"
                            }
                        },
                        {
                            "text": "There was an <w>overt</w> act of hostility when the troops crossed the recognized border.",
                            "target_lang_translations": {
                                "ru": "Пересечение войсками признанной границы стало <w>явным</w> актом враждебности.",
                                "zh": "当军队越过公认的边界时，这是一种<w>明显的</w>敌对行为。"
                            }
                        }
                    ],
                    "synonyms": [
                        "manifest",
                        "open",
                        "patent",
                        "plain",
                        "unconcealed"
                    ],
                    "antonyms": [
                        "covert",
                        "hidden",
                        "nonovert"
                    ],
                    "common_phrases": [
                        "overt act",
                        "overt hostility",
                        "overt discrimination"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершаемый или проявляемый открыто; очевидный, не скрываемый и не тайный.",
                        "zh": "公开的、明显的；毫不掩饰或非秘密的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "явный",
                                "target_lang_sense_clarification": "не скрываемый, очевидный"
                            },
                            {
                                "target_lang_word": "открытый",
                                "target_lang_sense_clarification": "прямой, не тайный"
                            },
                            {
                                "target_lang_word": "неприкрытый",
                                "target_lang_sense_clarification": "откровенный, демонстративный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公开的",
                                "target_lang_sense_clarification": "不隐瞒的"
                            },
                            {
                                "target_lang_word": "明显的",
                                "target_lang_sense_clarification": "显而易见的"
                            },
                            {
                                "target_lang_word": "公然的",
                                "target_lang_sense_clarification": "毫无顾忌的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56262be5-e099-368b-af5a-fa6ff5de558f",
                    "sense_definition": "Spread out or opened, especially said of a bird's wings.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coat of arms depicted a golden falcon with wings <w>overt</w> against a blue background.",
                            "target_lang_translations": {
                                "ru": "На гербе был изображён золотой сокол с <w>распростёртыми</w> крыльями на синем фоне.",
                                "zh": "这面盾徽在蓝色背景上描绘了一只双翼<w>张开的</w>金隼。"
                            }
                        },
                        {
                            "text": "In traditional heraldry, an eagle <w>overt</w> is portrayed with its wings spread widely apart.",
                            "target_lang_translations": {
                                "ru": "В традиционной геральдике орёл с <w>раскрытыми</w> крыльями изображается с широко расставленными крыльями.",
                                "zh": "在传统纹章学中，双翼<w>展开的</w>鹰被描绘成双翅大大张开的形象。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wings overt"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used chiefly in heraldry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Расправленный или раскрытый (преимущественно о крыльях птицы в геральдике).",
                        "zh": "（尤指纹章学中鸟类的翅膀）张开的，展开的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распростёртый",
                                "target_lang_sense_clarification": "о крыльях"
                            },
                            {
                                "target_lang_word": "раскрытый",
                                "target_lang_sense_clarification": "о крыльях птицы в геральдике"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "展开的",
                                "target_lang_sense_clarification": "纹章学中指鸟翼张开"
                            },
                            {
                                "target_lang_word": "张开的",
                                "target_lang_sense_clarification": "指翅膀舒展"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a2729b7b-536d-3e7a-8e5c-04a1bdbaf2dc",
                    "sense_definition": "An action or condition deemed detrimental to survival and considered unethical, particularly within Scientology doctrine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Members of the group were pressured to confess every past <w>overt</w> during the auditing session.",
                            "target_lang_translations": {
                                "ru": "На членов группы оказывали давление, заставляя исповедоваться в каждом прошлом <w>оверте</w> во время сеанса одитинга.",
                                "zh": "在听析过程中，该团体的成员被迫忏悔过去的每一次<w>越轨行为</w>。"
                            }
                        },
                        {
                            "text": "According to church teachings, an unconfessed <w>overt</w> can lead to a person's complete spiritual ruin.",
                            "target_lang_translations": {
                                "ru": "Согласно учению церкви, неисповеданный <w>оверт</w> может привести к полному духовному краху человека.",
                                "zh": "根据教会的教义，未忏悔的<w>越轨行为</w>可能导致一个人在精神上彻底毁灭。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В саентологии: вредоносное или неэтичное действие, нарушающее моральный кодекс группы.",
                        "zh": "（山达基教用语）越轨行为，指有害于生存或违反道德准则的过失行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оверт",
                                "target_lang_sense_clarification": "термин саентологии: проступок, вредоносное действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "越轨行为",
                                "target_lang_sense_clarification": "山达基教术语，有害行为或过失"
                            }
                        ]
                    }
                }
            ]
        }
    ]
