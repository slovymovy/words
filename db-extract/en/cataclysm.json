                ],
                "senses": [
                    {
                        "sense_id": "e28909ca-11e0-3540-8ac5-d00a97f9f288",
                        "entry_id": "b7eb7760-9267-3fad-aff6-590401f2e7b6",
                        "glosses": [
                            "A sudden, violent event."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8aba164-c5af-4a0b-a156-02e045890bc6",
                                "sense_id": "e28909ca-11e0-3540-8ac5-d00a97f9f288",
                                "text": "While the disaster capitalism complex does not deliberately scheme to create cataclysms on which it feeds (though Iraq may be a notable exception), there is plenty of evidence that its component industries work very hard indeed to make that current disastrous trends continue unchallenged."
                            },
                            {
                                "example_id": "6329643c-ef7d-46fa-ae98-4ed9b37a158e",
                                "sense_id": "e28909ca-11e0-3540-8ac5-d00a97f9f288",
                                "text": "Judging by the sedimentary composition of the crust, it appears that Altaaya once possessed an atmosphere thick enough to support some form of liquid. What cataclysm stripped the atmosphere and left the planet to freeze is not currently known."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f0f760c-a468-346a-9b97-83c411c0d441",
                        "entry_id": "b7eb7760-9267-3fad-aff6-590401f2e7b6",
                        "glosses": [
                            "A sudden and violent change in the earth's crust."
                        ],
                        "tags": [],
                        "examples": []
                    },
