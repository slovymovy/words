                                "sense_id": "a580927d-87f1-33ec-a609-45ffd2658c40",
                                "text": "преподнести́ неприя́тную но́вость",
                                "translation": "to communicate/bring bad news",
                                "english": "to communicate/bring bad news"
                            },
                            {
                                "example_id": "326c0513-f7b1-4bdd-91a0-07ee3ccbfb1b",
                                "sense_id": "a580927d-87f1-33ec-a609-45ffd2658c40",
                                "text": "Де́ло в том, как э́то преподнести́.",
                                "translation": "It's a matter of presentation.",
                                "english": "It's a matter of presentation."
                            }
                        ]
                    }
