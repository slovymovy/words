                "senses": [
                    {
                        "sense_id": "01a095e4-5a16-3fcb-9e12-ca4a9db5f528",
                        "entry_id": "747e9799-0122-3bb9-86d4-dbaab67ded73",
                        "glosses": [
                            "Überfahrt"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "62d1f023-ed96-424c-ae03-a4808e5509b8",
                                "sense_id": "01a095e4-5a16-3fcb-9e12-ca4a9db5f528",
                                "text": "„Beim Abfahren, beim Trajekt über einen Fluß und anderen ähnlichen Gelegenheiten lärmen und schreien seine Leute niemals; im Gegenteil, indem sie sich durch die Menge drängen, pflegen sie […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2baf348a-7f3d-3589-be48-abe67b2300a2",
                        "entry_id": "747e9799-0122-3bb9-86d4-dbaab67ded73",
                        "glosses": [
                            "Fähre/Fährschiff für Fahrzeuge, besonders für Eisenbahnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5192ec6a-91d0-4c1f-8392-0b28d11466fd",
                                "sense_id": "2baf348a-7f3d-3589-be48-abe67b2300a2",
                                "text": "„Die Züge wurden mit Hilfe einer Spezialfähre von Ufer zu Ufer befördert (Trajekt < lat. trajectum = Überfahrt). In Kessenich befand sich der Bahnhof Bonn-Trajekt. Das Trajekt war bis zum 2. August 1914 in Betrieb.“"
                            },
                            {
                                "example_id": "fb642a85-cdcf-4d21-89d7-69bc1159e440",
                                "sense_id": "2baf348a-7f3d-3589-be48-abe67b2300a2",
                                "text": "„Wichtiges auf einen Blick Fährverbindungen Trajekt 431 (Jadrolinija) Zadar (Gaženica) - Preko (25 Min. Fahrtzeit): zur HS (Juni-Sept.) bis zu 18-mal tägl., danach bis zu 15-mal tägl.; 18 KN/Pers., Auto 103 KN.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
