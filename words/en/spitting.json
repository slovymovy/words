{
    "word_family": [
        "spit",
        "spitter",
        "spittle"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "437768b4-ae4c-37e5-a16f-c65573879dce",
                    "sense_definition": "present participle and gerund of <w>spit</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spitting_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry camel kept <w>spitting</w> at the tourists whenever they came too close.",
                            "target_lang_translations": {
                                "de": "Das wütende Kamel <w>spuckte</w> immer wieder nach den Touristen, sobald sie ihm zu nahe kamen."
                            }
                        },
                        {
                            "text": "It was only <w>spitting</w> rain when we left the house, so we did not take an umbrella.",
                            "target_lang_translations": {
                                "de": "Es <w>nieselte</w> nur, als wir das Haus verließen, daher nahmen wir keinen Regenschirm mit."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spitting image",
                        "spitting blood",
                        "spitting feathers",
                        "spitting mad"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Präsens und Gerundium von „spit“: spuckend; nieselnd"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "spuckend",
                                "target_lang_sense_clarification": "Speichel ausstoßend"
                            },
                            {
                                "target_lang_word": "nieselnd",
                                "target_lang_sense_clarification": "vom Wetter, leise regnend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f50505ac-440f-3364-bb6d-8a2fe83df1ff",
                    "sense_definition": "The act of ejecting saliva or phlegm from the mouth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spitting_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient complained of constant coughing and <w>spitting</w> throughout the night.",
                            "target_lang_translations": {
                                "de": "Der Patient klagte über ständiges Husten und <w>Spucken</w> während der gesamten Nacht."
                            }
                        },
                        {
                            "text": "Public health campaigns in the nineteenth century sought to discourage public <w>spitting</w>.",
                            "target_lang_translations": {
                                "de": "Gesundheitskampagnen im 19. Jahrhundert versuchten, das öffentliche <w>Spucken</w> einzudämmen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "public spitting"
                    ],
                    "target_lang_definitions": {
                        "de": "Das Ausstoßen von Speichel oder Schleim aus dem Mund."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "das Spucken",
                                "target_lang_sense_clarification": "allgemeine Handlung des Spuckens"
                            },
                            {
                                "target_lang_word": "das Ausspeien",
                                "target_lang_sense_clarification": "gehobener, kräftiges Ausspucken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df695a56-6328-3652-b137-61df607827a8",
                    "sense_definition": "An appearance on the surface of cooling molten silver or platinum caused by the rapid release of dissolved oxygen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "metallurgy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Careful cooling of the crucible prevents <w>spitting</w> from dispersing drops of molten silver.",
                            "target_lang_translations": {
                                "de": "Ein vorsichtiges Abkühlen des Tiegels verhindert, dass durch <w>Spratzen</w> Tropfen von geschmolzenem Silber verspritzt werden."
                            }
                        },
                        {
                            "text": "The metallurgist observed irregular <w>spitting</w> on the ingot during the solidification process.",
                            "target_lang_translations": {
                                "de": "Der Metallurg beobachtete während des Erstarrungsprozesses unregelmäßiges <w>Spratzen</w> am Barren."
                            }
                        }
                    ],
                    "synonyms": [
                        "sprouting"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Spratzen: Erscheinung auf der Oberfläche von abkühlendem geschmolzenem Silber oder Platin durch plötzliches Freisetzen von gelöstem Sauerstoff."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "das Spratzen",
                                "target_lang_sense_clarification": "metallurgischer Fachbegriff für das Auswerfen von Metalltröpfchen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}