{
    "word_family": [
        "handbrake",
        "airbrake",
        "brakeman",
        "autobrake",
        "brakelight"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "574c6d9f-4adc-386e-b8c5-cd37e2abe4a7",
                    "sense_definition": "A device used to slow down or stop the motion of a vehicle or wheel, usually by friction.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "stopping_mechanism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She slammed on the <w>brakes</w> when she saw a child run in front of the car.",
                            "target_lang_translations": {
                                "ru": "Она ударила по <w>тормозам</w>, когда увидела ребенка, выбежавшего перед машиной.",
                                "zh": "当她看到一个孩子跑到车前时，她猛地踩下了<w>刹车</w>。"
                            }
                        },
                        {
                            "text": "You should check your parking <w>brake</w> before leaving the vehicle on a hill.",
                            "target_lang_translations": {
                                "ru": "Вам следует проверить стояночный <w>тормоз</w>, прежде чем оставлять автомобиль на склоне.",
                                "zh": "在坡道上停车前，你应该检查一下你的<w>手刹</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hit the brakes",
                        "slam on the brakes",
                        "parking brake",
                        "emergency brake",
                        "apply the brakes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство, используемое для замедления или остановки движения транспортного средства или колеса, обычно за счет трения.",
                        "zh": "用于减慢或停止车辆或车轮运动的装置，通常通过摩擦力起作用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тормоз",
                                "target_lang_sense_clarification": "механизм"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刹车",
                                "target_lang_sense_clarification": "机械装置"
                            },
                            {
                                "target_lang_word": "制动器",
                                "target_lang_sense_clarification": "技术术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8183300-6616-340f-82bd-c8cdfd19bcaf",
                    "sense_definition": "An area of dense undergrowth, bushes, or briers; a thicket.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nature_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rabbit disappeared quickly into the dense <w>brake</w> of thorns and vines.",
                            "target_lang_translations": {
                                "ru": "Кролик быстро исчез в густых <w>зарослях</w> колючек и лоз.",
                                "zh": "兔子迅速消失在茂密的荆棘和藤蔓<w>丛</w>中。"
                            }
                        },
                        {
                            "text": "Hunters struggled to move through the tangled <w>brake</w> deep in the forest.",
                            "target_lang_translations": {
                                "ru": "Охотники с трудом пробирались через сплетенную <w>чащу</w> в глубине леса.",
                                "zh": "猎人们艰难地穿过森林深处那片纠缠的<w>灌木丛</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cane brake",
                        "dense brake"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often found in literary or older contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Участок густого подлеска, кустарника или колючек; чаща.",
                        "zh": "茂密的灌木丛、荆棘丛或丛林。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заросли",
                                "target_lang_sense_clarification": "густой кустарник"
                            },
                            {
                                "target_lang_word": "чаща",
                                "target_lang_sense_clarification": "густой лес"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "灌木丛",
                                "target_lang_sense_clarification": "茂密的植被"
                            },
                            {
                                "target_lang_word": "丛林",
                                "target_lang_sense_clarification": "茂密的林地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "349dcdc6-5252-3528-a039-d0432e9e8b8b",
                    "sense_definition": "A coarse fern, specifically bracken, often found in wasteland or open forest.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nature_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hillside was covered in green <w>brake</w> and wild heather.",
                            "target_lang_translations": {
                                "ru": "Склон холма был покрыт зеленым <w>орляком</w> и диким вереском.",
                                "zh": "山坡上覆盖着绿色的<w>蕨类植物</w>和野生石楠。"
                            }
                        },
                        {
                            "text": "We walked through the tall <w>brake</w> growing along the woodland path.",
                            "target_lang_translations": {
                                "ru": "Мы шли через высокий <w>папоротник</w>, растущий вдоль лесной тропы.",
                                "zh": "我们走过林间小路旁长得高高的<w>蕨类</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Грубый папоротник, в частности орляк, часто встречающийся на пустошах или в редком лесу.",
                        "zh": "一种粗糙的蕨类植物，特别是欧洲蕨，常生长在荒地或开阔的森林中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "орляк",
                                "target_lang_sense_clarification": "вид папоротника"
                            },
                            {
                                "target_lang_word": "папоротник",
                                "target_lang_sense_clarification": "растение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蕨类",
                                "target_lang_sense_clarification": "植物类别"
                            },
                            {
                                "target_lang_word": "欧洲蕨",
                                "target_lang_sense_clarification": "特定品种"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0bed214e-8a56-3fbc-a645-db92ada54114",
                    "sense_definition": "A machine used for bending sheet metal into specific shapes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The worker used a hydraulic <w>brake</w> to fold the steel panel precisely.",
                            "target_lang_translations": {
                                "ru": "Рабочий использовал гидравлический <w>листогибочный пресс</w>, чтобы точно согнуть стальную панель.",
                                "zh": "工人使用液压<w>折弯机</w>精确地折叠了钢板。"
                            }
                        },
                        {
                            "text": "You need a proper <w>brake</w> to get a clean angle on this piece of metal.",
                            "target_lang_translations": {
                                "ru": "Вам нужен подходящий <w>листогиб</w>, чтобы получить чистый угол на этом куске металла.",
                                "zh": "你需要一台合适的<w>折弯机</w>才能在这块金属上折出整齐的角度。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "press brake",
                        "bending brake"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Станок, используемый для сгибания листового металла в определенные формы.",
                        "zh": "用于将金属板弯曲成特定形状的机器。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "листогибочный пресс",
                                "target_lang_sense_clarification": "станок"
                            },
                            {
                                "target_lang_word": "листогиб",
                                "target_lang_sense_clarification": "профессиональный жаргон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "折弯机",
                                "target_lang_sense_clarification": "工业设备"
                            },
                            {
                                "target_lang_word": "板料折弯机",
                                "target_lang_sense_clarification": "专业术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5143e79b-b27f-30e1-88bc-d549f5762f0c",
                    "sense_definition": "A historical open carriage or large estate car used for transporting equipment or shooting parties.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vehicle_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lord arrived at the hunt in an old-fashioned shooting <w>brake</w>.",
                            "target_lang_translations": {
                                "ru": "Лорд прибыл на охоту в старомодном охотничьем <w>брейке</w>.",
                                "zh": "领主乘坐一辆老式的<w>狩猎马车</w>抵达了狩猎场。"
                            }
                        },
                        {
                            "text": "They loaded the picnic baskets into the back of the <w>brake</w> for the journey.",
                            "target_lang_translations": {
                                "ru": "Они погрузили корзины для пикника в заднюю часть <w>брейка</w> для поездки.",
                                "zh": "他们把野餐篮装进<w>马车</w>后部，准备出发。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shooting brake"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical vehicle term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Исторический открытый экипаж или большой универсал, используемый для перевозки снаряжения или охотничьих групп.",
                        "zh": "一种历史上的敞篷马车或大型旅行车，用于运送装备或狩猎队伍。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брейк",
                                "target_lang_sense_clarification": "тип повозки"
                            },
                            {
                                "target_lang_word": "шарабан",
                                "target_lang_sense_clarification": "открытый экипаж"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "狩猎马车",
                                "target_lang_sense_clarification": "历史交通工具"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "efe6159e-a684-3101-9830-6ef5d6af8880",
                    "sense_definition": "To slow down or stop a vehicle or machine by using a braking device.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "stopping_mechanism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>brake</w> gently before you reach the sharp corner.",
                            "target_lang_translations": {
                                "ru": "Вам следует мягко <w>тормозить</w>, прежде чем вы достигнете крутого поворота.",
                                "zh": "在到达急转弯之前，你应该轻踩<w>刹车</w>。"
                            }
                        },
                        {
                            "text": "The driver had to <w>brake</w> suddenly when the traffic light turned red.",
                            "target_lang_translations": {
                                "ru": "Водителю пришлось резко <w>затормозить</w>, когда светофор переключился на красный.",
                                "zh": "当红绿灯变红时，司机不得不紧急<w>制动</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "accelerate"
                    ],
                    "common_phrases": [
                        "brake hard",
                        "brake gently",
                        "brake suddenly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Замедлять или останавливать транспортное средство или механизм с помощью тормозного устройства.",
                        "zh": "使用制动装置减慢或停止车辆或机器的运动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тормозить",
                                "target_lang_sense_clarification": "замедлять движение"
                            },
                            {
                                "target_lang_word": "затормозить",
                                "target_lang_sense_clarification": "остановить движение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刹车",
                                "target_lang_sense_clarification": "动词，减速"
                            },
                            {
                                "target_lang_word": "制动",
                                "target_lang_sense_clarification": "动词，技术性减速"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "785d17fa-de82-3e85-8729-555900ccb46e",
                    "sense_definition": "An archaic simple past tense form of <w>break</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took the bread and <w>brake</w> it before giving it to them.",
                            "target_lang_translations": {
                                "ru": "Он взял хлеб и <w>преломил</w> его, прежде чем дать им.",
                                "zh": "他拿起面包，将其<w>掰开</w>后分给了他们。"
                            }
                        },
                        {
                            "text": "The storm <w>brake</w> upon the ship with terrible fury.",
                            "target_lang_translations": {
                                "ru": "Шторм <w>обрушился</w> на корабль со страшной яростью.",
                                "zh": "风暴带着可怕的怒火<w>爆发</w>在船上。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        },
                        {
                            "trait_type": "form",
                            "comment": "past tense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшая форма прошедшего времени глагола 'break' (ломать).",
                        "zh": "动词“break”（打破、折断）的古旧过去式形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сломал",
                                "target_lang_sense_clarification": "устар. форма"
                            },
                            {
                                "target_lang_word": "преломил",
                                "target_lang_sense_clarification": "библейский/высокий стиль"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "折断",
                                "target_lang_sense_clarification": "古语用法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "3a448664-2cc3-34fd-9d2a-de53d4f28e24",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
