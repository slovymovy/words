                "senses": [
                    {
                        "sense_id": "1e2d184d-0caa-3389-bcb0-84c82eec7545",
                        "entry_id": "5b9ed7c3-757b-3316-850e-46a9768c2c0b",
                        "glosses": [
                            "Covered in lichen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c41cfe35-84e0-4182-aaa3-1b8bfdf052d6",
                                "sense_id": "1e2d184d-0caa-3389-bcb0-84c82eec7545",
                                "text": "We made a few gargantuan strides, leapt three or four times more, and sat down at last in a lichenous hollow."
                            },
                            {
                                "example_id": "0a38f1d5-e938-464e-ad93-b53dc492ae34",
                                "sense_id": "1e2d184d-0caa-3389-bcb0-84c82eec7545",
                                "text": "Green-graped upon their walls\nAn ancient hoary vine\nHath clustered their carven, lichenous stones\nWith tendril serpentine."
                            }
                        ]
                    },
                    {
                        "sense_id": "40b68578-fc40-3852-963e-62bac0950c0d",
                        "entry_id": "5b9ed7c3-757b-3316-850e-46a9768c2c0b",
                        "glosses": [
                            "Composed of lichen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5a2cace-24dc-4123-b6ed-e7257f46382d",
                                "sense_id": "40b68578-fc40-3852-963e-62bac0950c0d",
                                "text": "He went on foot across the wilder recesses of the park, where slimy streams of green moisture, exuding from decayed holes caused by old amputations, ran down the bark of the oaks and elms, the rind below being coated with a lichenous wash as green as emerald."
                            },
                            {
                                "example_id": "f3d32cf2-6eba-4061-9224-80c845973a8d",
                                "sense_id": "40b68578-fc40-3852-963e-62bac0950c0d",
                                "text": "The tree sloths of the South American forests are among the oddest of mammalian types. They are small nocturnal forms with a lichenous growth which often gives a greenish tinge to their gray hair."
                            }
                        ]
                    },
                    {
                        "sense_id": "b84b4b0e-3d51-3d5e-8608-da2f5058de1b",
                        "entry_id": "5b9ed7c3-757b-3316-850e-46a9768c2c0b",
                        "glosses": [
                            "Resembling lichen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92c83349-8d7f-41ec-99f8-ff06e6964336",
                                "sense_id": "b84b4b0e-3d51-3d5e-8608-da2f5058de1b",
                                "text": "1907, Louis Fischer, Diseases of Infancy and Childhood, Philadelphia: F.A. Davis, Chapter 6. Disorders Resulting from Improper Nutrition, p. 358,\nThe mouth becomes the seat of a parasitic stomatitis; the skin is harsh and dry; small boils or a lichenous rash make their appearance."
                            },
                            {
                                "example_id": "80400916-f455-4ec3-99a8-c287f23eb7fe",
                                "sense_id": "b84b4b0e-3d51-3d5e-8608-da2f5058de1b",
                                "text": "As the day advanced we saw the miracle of the desert flowers in vivid contrast to the lichenous grey of the persistent bushes and shrubs with which I had grown familiar throughout the journey."
                            }
                        ]
                    }
                ],
