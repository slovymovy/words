        "de-extract.jsonl": [
            {
                "entry_id": "3239ca07-f4de-34ae-bd65-35c6dc812259",
                "word": "VAE",
                "pos": "abbrev",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cf69fe24-b92a-321b-81e6-fe08a8f635d9",
                        "entry_id": "3239ca07-f4de-34ae-bd65-35c6dc812259",
                        "glosses": [
                            "Abkürzungen von Vereinigte Arabische Emirate"
                        ],
                        "tags": [
                            "Nahost"
                        ],
                        "examples": [
                            {
                                "example_id": "0a2a4fa0-c5e3-4c5b-82e3-f34ba764d838",
                                "sense_id": "cf69fe24-b92a-321b-81e6-fe08a8f635d9",
                                "text": "„Zwischen Deutschland und den VAE bahnen sich möglicherweise weitere Rüstungsgeschäfte an.“"
                            },
                            {
                                "example_id": "8745dd0a-a2ac-46f9-b379-0898c7acc3f6",
                                "sense_id": "cf69fe24-b92a-321b-81e6-fe08a8f635d9",
                                "text": "„Das Militär der VAE hat nicht nur im Juli 2015 die wichtige Stadt Aden, sondern anschließend alle Hafenstädte des Südens sowie die Insel Perim am Eingang des Roten Meeres eingenommen und Militärbasen gebaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
