                                        "entry_id": "6bf5d0d0-edc1-3d38-a824-3099ae290578",
                                        "glosses": [
                                            "Wild; uncontrolled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff7e52af-fcb2-48a3-9b22-053d879209e9",
                                                "sense_id": "26f5ee45-3e56-3020-acac-f343afdf8114",
                                                "text": "The police gathered to contain the unruly mob."
                                            },
                                            {
                                                "example_id": "350e0013-bd71-4599-9a4a-24ca9881fec6",
                                                "sense_id": "26f5ee45-3e56-3020-acac-f343afdf8114",
                                                "text": "Unruly boys who will not grow up / Must be taken in hand / Unruly girls who will not settle down / They must be taken in hand"
                                            },
                                            {
                                                "example_id": "0bb772af-828d-4ba8-92aa-f9873e7d4c37",
                                                "sense_id": "26f5ee45-3e56-3020-acac-f343afdf8114",
                                                "text": "Richard DeLongpre: Are you okay, my boy angel?\nAllen Gregory DeLongpre: I have a broken heart. And undergarments filled with my own unruly waste."
                                            },
                                            {
                                                "example_id": "cca92e6e-f94a-4020-b18b-1a218947bfba",
                                                "sense_id": "26f5ee45-3e56-3020-acac-f343afdf8114",
                                                "text": "The bar had two entrances, one on Barrow and another via Bedford, and “86” referred to the address of the door from which intoxicated or unruly guests would be ejected."
                                            }
                                        ]
                                    }
                                ]
                            }
