                                "target_senses": [
                                    {
                                        "sense_id": "f03de85c-c14d-3e9e-887c-932381dee7c7",
                                        "entry_id": "e77fba04-be5a-3511-acd4-60f130bc9f8e",
                                        "glosses": [
                                            "Stuffiness; stifling warmth in a room."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a7dcbc6-e66d-40a8-bdb3-ffdd1ebcceaa",
                                                "sense_id": "f03de85c-c14d-3e9e-887c-932381dee7c7",
                                                "text": "I was pretty bad myself, but managed to move about all the time, for the frowst in my cabin would have sickened a hippo."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "frowst",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8270149d-8c92-3e25-9e0f-28be7fe74b9f",
                                        "entry_id": "58939014-e479-3476-95f4-82c9659ddcb1",
                                        "glosses": [
                                            "To enjoy being in a warm, close, stuffy place."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6913458-3c77-4bbc-ab8d-1703680d2f3e",
                                                "sense_id": "8270149d-8c92-3e25-9e0f-28be7fe74b9f",
                                                "text": "The cure for this ill is not to sit still, / Or frowst with a book by the fire;"
                                            },
                                            {
                                                "example_id": "2e46ad58-f48b-4044-b20a-975a66af7974",
                                                "sense_id": "8270149d-8c92-3e25-9e0f-28be7fe74b9f",
                                                "text": "[…] punting a footer around the quad on a beautiful day like today, not frowsting in their studies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
