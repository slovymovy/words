                                        "entry_id": "c94d3b0b-806a-3fa2-8381-adc87bb4af81",
                                        "glosses": [
                                            "Gerät mit dem Zweck, physikalische Größen zu verändern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14191102-360d-4b99-8b9d-cee67fa629ff",
                                                "sense_id": "8806d96f-6afc-37f5-a576-2c36cd9d7251",
                                                "text": "Transformatoren sind Wandler, welche die elektrische Spannung und die Stromstärke verändern, aber die Frequenz unverändert lassen."
                                            }
                                        ],
