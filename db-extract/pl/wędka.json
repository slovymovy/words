                                            {
                                                "example_id": "0024763b-c108-4ec3-b9f8-a3b4976263f4",
                                                "sense_id": "192bf4fc-8699-3bf9-baa6-240cd35d20c9",
                                                "text": "Bij het eerstvolgende open veldje aan het water gooiden we onze spullen neer. Ik wilde dolgraag een keer verse vis vangen en op een kampvuurtje grillen. Vol goede moed ging ik aan de oever van het idyllische riviertje zitten met mijn zelfgemaakte hengel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44088417-231b-3bae-95bb-adb8d80bca3f",
