                "senses": [
                    {
                        "sense_id": "fc014e85-852f-3507-818b-ddd0880f10f7",
                        "entry_id": "fa1eeb78-f51a-3213-b3ee-80607c7dd370",
                        "glosses": [
                            "to start, to set out"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9bbdf37-f6f3-4adc-a60b-79892c0944f3",
                                "sense_id": "fc014e85-852f-3507-818b-ddd0880f10f7",
                                "text": "пусти́ться вдого́нку за ке́м-либо",
                                "translation": "to rush/dash after someone (in pursuit of someone)",
                                "english": "to rush/dash after someone (in pursuit of someone)"
                            },
                            {
                                "example_id": "a9818020-e4b9-40cc-975a-b4698df79960",
                                "sense_id": "fc014e85-852f-3507-818b-ddd0880f10f7",
                                "text": "пусти́ться в путь",
                                "translation": "to start on a journey",
                                "english": "to start on a journey"
                            },
                            {
                                "example_id": "bea6a29a-d3ae-426e-8f06-5d41cd89acd1",
                                "sense_id": "fc014e85-852f-3507-818b-ddd0880f10f7",
                                "text": "пусти́ться во все тя́жкие",
                                "translation": "1) to plunge into dissipation; 2) to go to all lengths, stop short at nothing",
                                "english": "1) to plunge into dissipation; 2) to go to all lengths, stop short at nothing"
                            }
                        ]
                    },
                    {
                        "sense_id": "f286f12c-9d10-3ede-b0ab-abdf7eafab4e",
                        "entry_id": "fa1eeb78-f51a-3213-b3ee-80607c7dd370",
                        "glosses": [
                            "to start"
                        ],
                        "tags": [],
                        "examples": [
                            {
