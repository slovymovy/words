{
    "word_family": [
        "reversal",
        "reversible",
        "irreversible",
        "reversion",
        "reversely"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "30289611-43e2-33f3-a707-a625e561ab85",
                    "sense_definition": "To turn something around so that it faces the opposite direction or runs in the opposite sequence.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "change_direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>reverse</w> the order of the books on the shelf.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>изменить</w> порядок книг на полке на обратный.",
                                "zh": "你需要把书架上书的顺序<w>颠倒</w>过来。"
                            }
                        },
                        {
                            "text": "The video shows the flower blooming, but then they <w>reverse</w> the footage.",
                            "target_lang_translations": {
                                "ru": "На видео показано, как цветок распускается, но затем они <w>прокручивают</w> запись в обратном направлении.",
                                "zh": "视频显示了花朵盛开的过程，但随后他们将录像<w>倒放</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "invert",
                        "flip"
                    ],
                    "antonyms": [
                        "unreverse"
                    ],
                    "common_phrases": [
                        "reverse the order",
                        "reverse the process",
                        "reverse direction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Повернуть что-либо так, чтобы оно было обращено в противоположную сторону, или изменить порядок на обратный.",
                        "zh": "将某物转动使其朝向相反方向，或将顺序颠倒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перевернуть",
                                "target_lang_sense_clarification": "изменить порядок или положение"
                            },
                            {
                                "target_lang_word": "поменять местами",
                                "target_lang_sense_clarification": "переставить в обратном порядке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "颠倒",
                                "target_lang_sense_clarification": "改变顺序或位置"
                            },
                            {
                                "target_lang_word": "倒置",
                                "target_lang_sense_clarification": "上下或前后位置颠倒"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee47a799-89ce-375f-8b24-9efb0316742b",
                    "sense_definition": "To drive a vehicle backwards or cause a mechanism to operate in the opposite direction.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "change_direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He carefully <w>reversed</w> the car into the narrow parking space.",
                            "target_lang_translations": {
                                "ru": "Он осторожно <w>сдал назад</w> на машине на узкое парковочное место.",
                                "zh": "他小心翼翼地把车<w>倒</w>进了狭窄的停车位。"
                            }
                        },
                        {
                            "text": "The driver stopped the train and <w>reversed</w> it back to the station.",
                            "target_lang_translations": {
                                "ru": "Машинист остановил поезд и <w>повел</w> его задним ходом обратно на станцию.",
                                "zh": "司机停下火车，然后<w>倒车</w>回到了车站。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "reverse the car",
                        "reverse into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ехать на транспортном средстве назад или заставлять механизм работать в обратном направлении.",
                        "zh": "驾驶车辆向后行驶，或使机械装置向相反方向运转。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдавать назад",
                                "target_lang_sense_clarification": "о движении автомобиля"
                            },
                            {
                                "target_lang_word": "ехать задним ходом",
                                "target_lang_sense_clarification": "о движении транспорта"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倒车",
                                "target_lang_sense_clarification": "指车辆向后行驶"
                            },
                            {
                                "target_lang_word": "倒转",
                                "target_lang_sense_clarification": "指机械或过程向相反方向运行"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75b95b30-cdea-3fe6-8ba2-1ec332485663",
                    "sense_definition": "To change a situation, decision, or trend totally to the opposite.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "change_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to <w>reverse</w> its policy on tax reform.",
                            "target_lang_translations": {
                                "ru": "Правительство решило кардинально <w>изменить</w> свою политику в отношении налоговой реформы.",
                                "zh": "政府决定<w>扭转</w>其税制改革政策。"
                            }
                        },
                        {
                            "text": "It will take a lot of effort to <w>reverse</w> the current economic trend.",
                            "target_lang_translations": {
                                "ru": "Потребуется много усилий, чтобы <w>переломить</w> текущую экономическую тенденцию.",
                                "zh": "需要付出巨大努力才能<w>扭转</w>当前的经济趋势。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "reverse a decision",
                        "reverse a trend",
                        "reverse a policy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью изменить ситуацию, решение или тенденцию на противоположные.",
                        "zh": "彻底改变某种情况、决定或趋势，使其变为相反的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изменить",
                                "target_lang_sense_clarification": "поменять решение или политику на противоположные"
                            },
                            {
                                "target_lang_word": "повернуть вспять",
                                "target_lang_sense_clarification": "о процессе или тенденции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扭转",
                                "target_lang_sense_clarification": "改变局面或趋势"
                            },
                            {
                                "target_lang_word": "推翻",
                                "target_lang_sense_clarification": "改变原有的决定或政策"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88c9ac95-f359-3ce3-bccb-3722fa118bd5",
                    "sense_definition": "To revoke a law or judgment officially.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "change_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The higher court may <w>reverse</w> the judgment if new evidence appears.",
                            "target_lang_translations": {
                                "ru": "Вышестоящий суд может <w>отменить</w> решение, если появятся новые доказательства.",
                                "zh": "如果出现新证据，上级法院可能会<w>撤销</w>原判。"
                            }
                        },
                        {
                            "text": "They campaigned to <w>reverse</w> the unfair decree passed last year.",
                            "target_lang_translations": {
                                "ru": "Они проводили кампанию, чтобы <w>отменить</w> несправедливый указ, принятый в прошлом году.",
                                "zh": "他们发起运动，要求<w>撤销</w>去年通过的不公正法令。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "reverse a judgment",
                        "reverse a verdict"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально отменить закон или судебное решение.",
                        "zh": "正式撤销法律或判决。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отменить",
                                "target_lang_sense_clarification": "аннулировать решение суда или указ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "撤销",
                                "target_lang_sense_clarification": "取消判决或决定"
                            },
                            {
                                "target_lang_word": "推翻",
                                "target_lang_sense_clarification": "否定原有的判决"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7969c1ad-a549-3629-ae9a-6b8566702196",
                    "sense_definition": "To turn something inside out or upside down.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "change_direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>reversed</w> the jacket to show the orange lining inside.",
                            "target_lang_translations": {
                                "ru": "Он <w>вывернул</w> куртку, чтобы показать оранжевую подкладку внутри.",
                                "zh": "他把夹克<w>翻</w>了过来，露出里面的橙色衬里。"
                            }
                        },
                        {
                            "text": "The image was <w>reversed</w> by the lens, appearing upside down.",
                            "target_lang_translations": {
                                "ru": "Изображение было <w>перевернуто</w> линзой и казалось перевернутым вверх ногами.",
                                "zh": "图像被镜头<w>倒置</w>了，看起来上下颠倒。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вывернуть что-либо наизнанку или перевернуть вверх дном.",
                        "zh": "将某物翻转过来或倒置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вывернуть",
                                "target_lang_sense_clarification": "наизнанку"
                            },
                            {
                                "target_lang_word": "перевернуть",
                                "target_lang_sense_clarification": "вверх ногами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "翻转",
                                "target_lang_sense_clarification": "改变物体的朝向"
                            },
                            {
                                "target_lang_word": "倒置",
                                "target_lang_sense_clarification": "使物体上下颠倒"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "37ed53e4-39aa-30ea-af11-e3d90663727d",
                    "sense_definition": "The gear setting of an automobile that makes it travel backwards.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I shifted into <w>reverse</w> and slowly backed out of the driveway.",
                            "target_lang_translations": {
                                "ru": "Я переключился на <w>задний ход</w> и медленно выехал задом с подъездной дорожки.",
                                "zh": "我挂上<w>倒档</w>，慢慢地从车道上退了出来。"
                            }
                        },
                        {
                            "text": "Check behind you before you put the car in <w>reverse</w>.",
                            "target_lang_translations": {
                                "ru": "Посмотрите назад, прежде чем включить <w>заднюю передачу</w>.",
                                "zh": "在挂<w>倒档</w>之前，先看看后面。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reverse gear"
                    ],
                    "common_phrases": [
                        "in reverse",
                        "shift into reverse",
                        "put in reverse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передача в автомобиле, обеспечивающая движение назад.",
                        "zh": "汽车中使车辆向后行驶的档位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задний ход",
                                "target_lang_sense_clarification": "режим движения"
                            },
                            {
                                "target_lang_word": "задняя передача",
                                "target_lang_sense_clarification": "механизм коробки передач"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倒档",
                                "target_lang_sense_clarification": "汽车的倒车档位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60327d1a-4231-3315-bed7-72bcb632d70b",
                    "sense_definition": "The opposite of something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "opposite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I thought he would be angry, but the <w>reverse</w> was true.",
                            "target_lang_translations": {
                                "ru": "Я думал, он рассердится, но оказалось совсем <w>наоборот</w>.",
                                "zh": "我以为他会生气，但事实恰恰<w>相反</w>。"
                            }
                        },
                        {
                            "text": "Division is the <w>reverse</w> of multiplication in mathematics.",
                            "target_lang_translations": {
                                "ru": "Деление — это <w>обратное</w> умножению действие в математике.",
                                "zh": "在数学中，除法是乘法的<w>逆运算</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "quite the reverse",
                        "the exact reverse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечто противоположное.",
                        "zh": "与某事物相反的情况或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "противоположность",
                                "target_lang_sense_clarification": "обратное явление"
                            },
                            {
                                "target_lang_word": "обратное",
                                "target_lang_sense_clarification": "существительное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "相反",
                                "target_lang_sense_clarification": "指对立的情况"
                            },
                            {
                                "target_lang_word": "反面",
                                "target_lang_sense_clarification": "事物的另一面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07982c45-4927-3228-808f-78f99ad0ea97",
                    "sense_definition": "The back side of a coin, medal, or badge.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "side",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>reverse</w> of the coin features an image of an eagle.",
                            "target_lang_translations": {
                                "ru": "На <w>реверсе</w> монеты изображен орел.",
                                "zh": "硬币的<w>背面</w>印有一只老鹰的图案。"
                            }
                        },
                        {
                            "text": "Inspect the <w>reverse</w> of the medal to see the inscription.",
                            "target_lang_translations": {
                                "ru": "Осмотрите <w>обратную сторону</w> медали, чтобы увидеть надпись.",
                                "zh": "检查奖章的<w>背面</w>以查看铭文。"
                            }
                        }
                    ],
                    "antonyms": [
                        "obverse"
                    ],
                    "common_phrases": [
                        "on the reverse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обратная сторона монеты, медали или значка.",
                        "zh": "硬币、奖章或徽章的背面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реверс",
                                "target_lang_sense_clarification": "термин нумизматики"
                            },
                            {
                                "target_lang_word": "обратная сторона",
                                "target_lang_sense_clarification": "задняя часть предмета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "背面",
                                "target_lang_sense_clarification": "物体的反面"
                            },
                            {
                                "target_lang_word": "反面",
                                "target_lang_sense_clarification": "硬币或奖章的背面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb47d11e-b6dd-353f-86a5-5d0b59b5f59d",
                    "sense_definition": "A piece of misfortune or a setback.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "misfortune",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of success, the company suffered a sudden financial <w>reverse</w>.",
                            "target_lang_translations": {
                                "ru": "После многих лет успеха компания потерпела внезапную финансовую <w>неудачу</w>.",
                                "zh": "在经历了多年的成功后，该公司突然遭遇了财务<w>挫折</w>。"
                            }
                        },
                        {
                            "text": "He met with a <w>reverse</w> in his career but soon recovered.",
                            "target_lang_translations": {
                                "ru": "Его постигла <w>неудача</w> в карьере, но он вскоре оправился.",
                                "zh": "他的职业生涯遭遇了<w>挫折</w>，但很快就恢复了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "meet with a reverse",
                        "suffer a reverse"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неудача или поражение.",
                        "zh": "挫折或不幸的遭遇。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неудача",
                                "target_lang_sense_clarification": "провал в делах"
                            },
                            {
                                "target_lang_word": "поражение",
                                "target_lang_sense_clarification": "проигрыш"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挫折",
                                "target_lang_sense_clarification": "事业或进程中的阻碍"
                            },
                            {
                                "target_lang_word": "失败",
                                "target_lang_sense_clarification": "遭遇不顺"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d93f0893-d38c-374f-9a04-2ed082f44c45",
                    "sense_definition": "Going in the opposite direction or order; opposite or contrary.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We listed the names in <w>reverse</w> order, from Z to A.",
                            "target_lang_translations": {
                                "ru": "Мы перечислили имена в <w>обратном</w> порядке, от Я до А.",
                                "zh": "我们按<w>相反</w>顺序排列了名字，从Z到A。"
                            }
                        },
                        {
                            "text": "The mirror showed a <w>reverse</w> image of the room.",
                            "target_lang_translations": {
                                "ru": "В зеркале отражалось <w>перевернутое</w> изображение комнаты.",
                                "zh": "镜子里显示出房间的<w>反向</w>影像。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "reverse order",
                        "reverse direction",
                        "reverse side"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идущий в противоположном направлении или порядке; противоположный.",
                        "zh": "向相反方向或顺序进行的；相反的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обратный",
                                "target_lang_sense_clarification": "о порядке или направлении"
                            },
                            {
                                "target_lang_word": "противоположный",
                                "target_lang_sense_clarification": "находящийся напротив"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "相反的",
                                "target_lang_sense_clarification": "性质或方向对立"
                            },
                            {
                                "target_lang_word": "反向的",
                                "target_lang_sense_clarification": "方向与常规相反"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "620f6ced-ca4e-3d16-94a5-ffde2409556a",
                    "sense_definition": "Relating to movement in a direction opposite to the usual one, especially for vehicles.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car made a strange noise when shifted into <w>reverse</w> gear.",
                            "target_lang_translations": {
                                "ru": "Машина издала странный звук при переключении на <w>заднюю</w> передачу.",
                                "zh": "当挂入<w>倒档</w>时，车子发出了奇怪的声音。"
                            }
                        },
                        {
