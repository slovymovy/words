                        "sense_id": "7be90972-f163-3b90-a316-8a63320f16fa",
                        "entry_id": "9d62fd9d-b3cc-3379-a65f-a061d646f90d",
                        "glosses": [
                            "Jardinier exerçant une fonction de chef."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "288f5c1e-63f7-4378-a2bb-8f8a6bb6ddb1",
                                "sense_id": "7be90972-f163-3b90-a316-8a63320f16fa",
                                "text": "À l’occasion du bicentenaire de la création de ce jardin paysager à l’anglaise, d’une superficie de six hectares, vous pourrez arpenter et découvrir ce lieu au cours d’une visite guidée en compagnie du chef-jardinier Odile Bureau ce 3 juin."
                            },
                            {
                                "example_id": "e1ab0e4e-459c-44cf-85d5-1d9e39391e5c",
                                "sense_id": "7be90972-f163-3b90-a316-8a63320f16fa",
                                "text": "Un chef de culture, de surcroît, veille sur toute l’activité horticole du Jardin botanique, dans les serres et dans les Écoles, avec une équipe de chefs-jardiniers et de jardiniers."
                            },
                            {
                                "example_id": "73a5dcbe-8fd5-4701-9dc9-d17eceb782ad",
                                "sense_id": "7be90972-f163-3b90-a316-8a63320f16fa",
                                "text": "Nos chefs-jardiniers établissent des rapports journaliers afin d’assurer une transparence des coûts et des travaux envers nos clients."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e888af1-2b72-3fc7-8220-804599af4bbd",
                        "entry_id": "9d62fd9d-b3cc-3379-a65f-a061d646f90d",
                        "glosses": [
                            "Chef cuisinier s'occupant aussi de jardinage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c50c25b8-d57b-4096-b5c7-f61a5d781da1",
                                "sense_id": "7e888af1-2b72-3fc7-8220-804599af4bbd",
                                "text": "Pour les étudiants, ce panorama de « chefs-jardiniers », totalement engagés sur leur terre et disséminés partout en France et en Belgique, donne clairement envie d’aller rejoindre ces équipes."
                            }
                        ]
                    }
