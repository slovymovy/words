                            {
                                "example_id": "dd08aecd-44e9-4224-9c1d-e75d4aceb5e0",
                                "sense_id": "f502931f-1ff5-3634-9429-93973a4f1687",
                                "text": "„Um hier gegenzusteuern, wurden die Raubvögel zu Greifvögeln, die Raubtiere zu Beutegreifern und die Unkräuter zu Beikräutern.“"
                            }
