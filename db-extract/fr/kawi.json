                                        "glosses": [
                                            "A literary and prose language based on Old Javanese with a large number of Sanskrit loanwords, and used on the islands of Java, Bali, and Lombok; or the script used in writing this language."
                                        ],
                                        "tags": [],
                                        "examples": [
