                        ]
                    },
                    {
                        "translation_id": "0dfd8741-fb1d-4f9f-a091-9f487696bd1f",
                        "source_entry_id": "94551bc3-7e9a-3971-92eb-97c7eb93dfe4",
                        "source_sense_id": "8181e5e3-d76a-3b13-906f-be7fdf24fbb4",
                        "target_lang_word": "черножопый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "черножопый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c67a4bbd-ae10-35f8-9e40-912ffc68d65f",
                                        "entry_id": "3f1df64e-167b-3b3c-9fc7-fdcb4eae99e2",
                                        "glosses": [
                                            "разг., сниж., пренебр. или бран. имеющий нерусскую, смуглокожую национальность (обычно о кавказцах или среднеазиатах)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68fee498-bd41-446b-b10f-f6ceead89086",
                                                "sense_id": "c67a4bbd-ae10-35f8-9e40-912ffc68d65f",
                                                "text": "Серёга про себя называл Арслана черножопой образи́ной и совершенно не замечал, насколько они похожи. Оба невысокие, жилистые, смуглые, с усиками. В метро у обоих непременно потребовали бы паспорта, как у подозрительных личностей кавказской национальности."
                                            },
                                            {
                                                "example_id": "9f2bd007-d343-492b-b7f2-545cd6da6586",
                                                "sense_id": "c67a4bbd-ae10-35f8-9e40-912ffc68d65f",
                                                "text": "Ляля обстоятельно рассказывала младшей сестре о житье-бытье семьи в дальних краях, о школьных успехах Алёши, особенно в рисовании. Присылала фотографии, на которых были изображены черножопые туземцы у пальмовых хижин, ритуальные пляски жрецов под барабан, всякие слоны и обезьяны."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "черножопый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e755e6b4-a9e2-345b-a50e-f9da3502c18c",
                                        "entry_id": "7fcc7701-71de-3de8-b4d3-fe0bf9428a66",
                                        "glosses": [
                                            "разг., сниж., пренебр. или бран. человек нерусской, смуглокожей национальности (обычно о кавказцах или среднеазиатах)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dbee921-a558-4e0a-bd92-4f3c3a9bfb7d",
                                                "sense_id": "e755e6b4-a9e2-345b-a50e-f9da3502c18c",
                                                "text": "— Ну, пойдём выйдем, раз уж тебе и твоим кунакам, вижу я, охота выйти. — Выйдем, выйдем! — засеменил джигит впереди Ярыгина, и вся чёрная братия, попустившись покупками, потянулась следом. — Чего ж вы стоите? — послышался раздражённый голос буфетчицы. — Пока этих черножопых нету, берите что нужно."
                                            },
                                            {
                                                "example_id": "10d2243b-934c-442a-b767-19ff13e321f4",
                                                "sense_id": "e755e6b4-a9e2-345b-a50e-f9da3502c18c",
                                                "text": "Очень интересен проект «Чужие в городе», который преобразовался в спектакль «Черножопые», посвящённый защите людей разных национальностей, живущих в столичном мегаполисе."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6964790f-ca9a-368b-9c25-18551617636d",
                                        "entry_id": "7fcc7701-71de-3de8-b4d3-fe0bf9428a66",
                                        "glosses": [
                                            "разг., сниж., пренебр. человек негроидной расы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a888b3d-0626-40aa-b9e0-6854ee02b180",
                                                "sense_id": "6964790f-ca9a-368b-9c25-18551617636d",
                                                "text": "[Суходрищев, Олег Табаков, муж, 60, 1935] Слышь / чего говорят / черножопые! [Жена посла, Любовь Полищук, жен, 46, 1949] Черножопый. Ий."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
