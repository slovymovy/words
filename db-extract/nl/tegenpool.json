                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ade162ae-f9c3-4b7e-9b87-b8b928bb9dcc",
                                                "sense_id": "005583ee-dde7-3eb7-957c-a954c9b504e8",
                                                "text": "She is the opposite of her ex-boyfriend who abused her both physically and verbally nearly every day for five years. She now works as an advocate and supportive listener for others who have endured abusive relationships."
