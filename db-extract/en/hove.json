                        "glosses": [
                            "To remain suspended in air, water etc.; to float, to hover."
                        ],
                        "tags": [
                            "intransitive",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ff7e5cff-6dc7-42ec-bdac-c4a8ca0bced7",
                                "sense_id": "16be94f5-674e-338e-b3b7-b718cf8c16f8",
                                "text": "As shee arrived on the roring shore, / In minde to leape into the mighty maine, / A little bote lay hoving her before[…]."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2b105d4-3127-3f15-9ce5-07c7424c2b94",
