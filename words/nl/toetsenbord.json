    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d61bae3c-429b-3e7b-b3f5-e2c313ff0616",
                    "sense_definition": "een apparaat met knoppen waarmee je gegevens in een computer kunt invoeren",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "invoerapparatuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik gebruik een draadloos <w>toetsenbord</w> om gemakkelijker op mijn laptop te werken.",
                            "target_lang_translations": {
                                "en": "I use a wireless <w>keyboard</w> to work more easily on my laptop."
                            }
                        },
                        {
                            "text": "Zou je niet een ander <w>toetsenbord</w> nemen want op deze kan ik echt niet typen.",
                            "target_lang_translations": {
                                "en": "Shouldn't you get another <w>keyboard</w> because I really can't type on this one."
                            }
                        }
                    ],
                    "synonyms": [
                        "keyboard"
                    ],
                    "common_phrases": [
                        "draadloos toetsenbord",
                        "op het toetsenbord typen"
                    ],
                    "target_lang_definitions": {
                        "en": "a device with buttons used to input data into a computer"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "keyboard",
                                "target_lang_sense_clarification": "for a computer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1194e6a8-5dce-3ae3-856f-0d8889cc6c1d",
                    "sense_definition": "een set van toetsen waarmee een muziekinstrument zoals een piano of orgel wordt bespeeld",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "muziekinstrumenten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>toetsenbord</w> van dit oude orgeltje omvat maar vijf octaven.",
                            "target_lang_translations": {
                                "en": "The <w>keyboard</w> of this old organ only spans five octaves."
                            }
                        },
                        {
                            "text": "De pianist maakte het <w>toetsenbord</w> schoon voordat het concert begon.",
                            "target_lang_translations": {
                                "en": "The pianist cleaned the <w>keyboard</w> before the concert started."
                            }
                        }
                    ],
                    "synonyms": [
                        "klavier",
                        "manuaal"
                    ],
                    "common_phrases": [
                        "het toetsenbord bespelen"
                    ],
                    "target_lang_definitions": {
                        "en": "a set of keys used to play a musical instrument such as a piano or organ"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "keyboard",
                                "target_lang_sense_clarification": "musical instrument component"
                            },
                            {
                                "target_lang_word": "musical keyboard",
                                "target_lang_sense_clarification": "electronic or acoustic instrument keys"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ef46490-d216-3d9d-9b71-3a13abe0a726",
                    "sense_definition": "een paneel met knoppen of schakelaars om een machine of apparaat te bedienen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bedieningspanelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>toetsenbord</w> van de geldautomaat is veel te klein voor zijn dikke vingers.",
                            "target_lang_translations": {
                                "en": "The ATM <w>keypad</w> is much too small for his thick fingers."
                            }
                        },
                        {
                            "text": "Toets uw persoonlijke code in op het <w>toetsenbord</w> van de beveiligde deur.",
                            "target_lang_translations": {
                                "en": "Enter your personal code on the <w>keypad</w> of the secure door."
                            }
                        }
                    ],
                    "common_phrases": [
                        "numeriek toetsenbord"
                    ],
                    "target_lang_definitions": {
                        "en": "a panel with buttons or switches to operate a machine or device"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "keypad",
                                "target_lang_sense_clarification": "small set of buttons for a machine or door"
                            },
                            {
                                "target_lang_word": "keyboard",
                                "target_lang_sense_clarification": "control panel interface"
                            }
                        ]
                    }
                }
            ]
        }
    ]
