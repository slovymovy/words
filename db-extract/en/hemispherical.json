        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "757adc5e-86fd-30e5-a1b4-2c374013d9f8",
                "word": "hemispherical",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "23c07238-5fd3-39a7-80c5-fa2990b0ad61",
                        "entry_id": "757adc5e-86fd-30e5-a1b4-2c374013d9f8",
                        "glosses": [
                            "Having the shape of half a sphere."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "760b7db8-4fb3-42e4-9ebd-afc35c3a1cb1",
                                "sense_id": "23c07238-5fd3-39a7-80c5-fa2990b0ad61",
                                "text": "Split peas are hemispherical."
                            },
                            {
                                "example_id": "94ca1383-a371-449e-9d10-08fc53570790",
                                "sense_id": "23c07238-5fd3-39a7-80c5-fa2990b0ad61",
                                "text": "Wind speed is measured by the conventional arrangement of three hemispherical cups, mounted at 120 deg. on a shaft which is geared to a cam."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e2255df-172e-3550-a464-3cf350e7896e",
                        "entry_id": "757adc5e-86fd-30e5-a1b4-2c374013d9f8",
                        "glosses": [
                            "Pertaining to or operating throughout a hemisphere of the Earth."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9570099-9b2f-441a-91eb-f41c1e74171a",
                        "source_entry_id": "757adc5e-86fd-30e5-a1b4-2c374013d9f8",
                        "source_sense_description": "having the shape of a hemisphere",
                        "target_lang_word": "hémisphérique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hémisphérique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "29f969f1-be41-3697-ae45-3ea226bcb547",
                                        "entry_id": "a62bb2b4-3422-30f5-8da1-931617be5d5f",
                                        "glosses": [
                                            "Qui a la forme d’un hémisphère."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4468f02b-b31e-4195-9429-5bbbc2bc559d",
                                                "sense_id": "29f969f1-be41-3697-ae45-3ea226bcb547",
                                                "text": "Les aliments détaillés en menus morceaux sont sautés très rapidement avec très peu de matière grasse dans un récipient hémisphérique placé sur un brûleur très puissant."
                                            },
                                            {
                                                "example_id": "cb401c23-9528-417f-9b51-9da1a0f0b655",
                                                "sense_id": "29f969f1-be41-3697-ae45-3ea226bcb547",
                                                "text": "L'œuvre est imprimée à Genève : à quelques lieues de là, sur les rives du même lac, les notables de Vevey siègent sous un miroir hémisphérique, une merveille qui nous est conservée et qui suscite la rêverie."
                                            },
                                            {
                                                "example_id": "20fcfabd-9955-4a5c-b735-e9a6ab19afe6",
                                                "sense_id": "29f969f1-be41-3697-ae45-3ea226bcb547",
                                                "text": "Une des rares attractions touristiques de la ville est un majestueux silo hémisphérique datant de la fin du XVIIIᵉ siècle et prouvant, par son gigantisme, que Patna fut autrefois une cité prospère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73a858ec-228d-3d59-8f0c-b0098e9f82fe",
                                        "entry_id": "a62bb2b4-3422-30f5-8da1-931617be5d5f",
                                        "glosses": [
                                            "Relatif aux hémisphères cérébraux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cad4632-ba37-495a-ad9a-504adb4748af",
                                                "sense_id": "73a858ec-228d-3d59-8f0c-b0098e9f82fe",
                                                "text": "Un article très récent montre que, très tôt, chez le nouveau-né, il y a une asymétrie hémisphérique : le cerveau gauche est syntaxique, rationnel, le siège du langage, tandis que le cerveau droit va plutôt gérer les émotions, l'intuition, l'espace et les métaphores visuelles."
                                            },
                                            {
                                                "example_id": "baf689fb-612e-4d59-8807-33ef1de2cd61",
                                                "sense_id": "73a858ec-228d-3d59-8f0c-b0098e9f82fe",
                                                "text": "Les différences de dominance hémisphérique (cerveau gauche, cerveau droit) peuvent aider à expliquer les différences individuelles entre apprenants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
