                        "entry_id": "cae83bbe-36ce-302d-9456-0d6415c17d2d",
                        "glosses": [
                            "grotere ruimte in een gebouw bestemd voor missen of vieringen"
                        ],
                        "tags": [
                            "christelijk"
                        ],
                        "examples": [
                            {
                                "example_id": "0ad51014-6e93-4c6a-a674-85a35d75d62b",
                                "sense_id": "d4805d4c-a10b-3bf6-8fbe-5b9eb042276d",
                                "text": "In de kerkzaal waren 350 zitplaatsen in de vorm van stoelen, die in carré waren opgesteld waren rond het eikehouten vieringaltaar."
                            },
                            {
                                "example_id": "eac3358b-aa5a-498b-8b35-ccaca1e83a17",
                                "sense_id": "d4805d4c-a10b-3bf6-8fbe-5b9eb042276d",
                                "text": "Dit pand werd in 1918 als woonhuis met kerkzaal gebouwd voor de Herst. Apost. gemeente en in 1931 naar plannen van J.S. Baars verbouwd tot synagoge (vergroot 1956, gerestaureerd 1983)."
                            }
                        ]
                    }
