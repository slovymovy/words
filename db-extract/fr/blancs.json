                                    },
                                    {
                                        "sense_id": "72daab89-ad97-3a32-a354-fda86890b6ef",
                                        "entry_id": "fe14ad07-504e-3dce-9d64-fc08fa702fd7",
                                        "glosses": [
                                            "The player moving the white pieces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
