                "senses": [
                    {
                        "sense_id": "60440ace-f6a6-3c3c-9242-d0aa11962167",
                        "entry_id": "0e6aaa90-fb79-31f8-a51b-b9af2f779f71",
                        "glosses": [
                            "Ladung, die in einem Wagen transportiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bec8a2b-e579-4c24-ab08-f4b9c3881321",
                                "sense_id": "60440ace-f6a6-3c3c-9242-d0aa11962167",
                                "text": "„Er sammelt eine Wagenladung alter Zähne, und nach der Highschool haut dieser durchgeknallte Junge einfach ab und schließt sich einer Sekte an, die nur nachts aktiv ist.“"
                            },
                            {
                                "example_id": "d07579a2-5bcc-467d-aed1-045b0afa207f",
                                "sense_id": "60440ace-f6a6-3c3c-9242-d0aa11962167",
                                "text": "„Wer kein kleiner Dieb ist, wer also keine Ziegel, Papier oder Zucker stiehlt, der ist mit Sicherheit ein umso größerer Dieb, der wahrscheinlich ganze Wagenladungen Zucker stiehlt und sämtliche Ziegel und Kupferkabel aufkauft, die die kleinen Diebe geklaut haben.“"
                            },
                            {
                                "example_id": "6a0785b0-2a0a-4ff6-947d-f3247d231be9",
                                "sense_id": "60440ace-f6a6-3c3c-9242-d0aa11962167",
                                "text": "„Und das sagte derselbe Mann, der vier Wagenladungen Ziegel hatte zurückgehen lassen, weil es nicht genau die waren, die er bestellt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
