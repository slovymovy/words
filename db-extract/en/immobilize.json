                ],
                "senses": [
                    {
                        "sense_id": "8a48ae25-5108-3738-b0ec-a69ae010a39c",
                        "entry_id": "e1da37c1-4d19-3d9d-a268-968406b961c2",
                        "glosses": [
                            "To render motionless; to stop moving or stop from moving."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "60c2a307-5767-4c07-bb9e-77f39c23207e",
                                "sense_id": "8a48ae25-5108-3738-b0ec-a69ae010a39c",
                                "text": "It is best to immobilize the injury until a doctor can examine it."
                            },
                            {
                                "example_id": "39e5cbdc-0233-4133-9be1-cea509da89e2",
                                "sense_id": "8a48ae25-5108-3738-b0ec-a69ae010a39c",
                                "text": "[…]two Russian armies would advance into East Prussia, one westward from the Niemen, the other northward from the Narew, with the object of encircling and immobilizing all enemy forces there."
                            },
                            {
                                "example_id": "8287593f-6fbd-46d0-8ce6-374ebd3fa318",
                                "sense_id": "8a48ae25-5108-3738-b0ec-a69ae010a39c",
                                "text": "Zinc oxide is biosafe and, therefore, there are no toxic effects for biomedical applications that immobilize and modify biomolecules (Kumar and Shen, 2008)."
                            },
                            {
                                "example_id": "0821863b-c0ae-4500-b644-1fb61b4e1b63",
                                "sense_id": "8a48ae25-5108-3738-b0ec-a69ae010a39c",
                                "text": "This is how Alzheimer's transforms encyclopedians into vegetables, how Parkinson's immobilizes triatheletes."
                            },
                            {
                                "example_id": "72e53450-4fde-4054-894f-ad0e0d062f58",
                                "sense_id": "8a48ae25-5108-3738-b0ec-a69ae010a39c",
                                "text": "Fully autonomous vehicles have raised safety concerns. California enacted a law this year that will, among other things, require manufacturers to continuously monitor every autonomous vehicle on the road and designate a remote human operator to immobilize a vehicle if necessary."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a16c416-2418-3888-99bf-dc1fe2654111",
                        "entry_id": "e1da37c1-4d19-3d9d-a268-968406b961c2",
                        "glosses": [
                            "To render incapable of action."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c192e139-d3ec-4acc-b89c-fa9ef638def5",
                                "sense_id": "8a16c416-2418-3888-99bf-dc1fe2654111",
                                "text": "It's clear from these [budget] cuts that the MCAD is virtually immobilized as an effective organization for at least the next year."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2af315c-eb8c-3265-af47-16102db1e4c2",
                        "entry_id": "e1da37c1-4d19-3d9d-a268-968406b961c2",
                        "glosses": [
                            "To modify a surface such that things will not stick to it"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4010b816-f1c4-3e6c-848c-1a79410c9677",
                        "entry_id": "e1da37c1-4d19-3d9d-a268-968406b961c2",
                        "glosses": [
                            "To tie up a capital: make a capital investment that makes that capital unavailable."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6c5f5b7d-f81d-4a77-b428-3f4e0c69b068",
                                "sense_id": "4010b816-f1c4-3e6c-848c-1a79410c9677",
                                "text": "Don't immobilize your capital in aging accounts."
                            }
                        ]
                    }
                ],
