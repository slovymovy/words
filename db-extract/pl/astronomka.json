                        "entry_id": "8d93f137-256e-367a-bf7b-3c6b7f3b8906",
                        "glosses": [
                            "specjalistka w zakresie astronomii"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b2d5cd82-1c4a-4008-97c5-1cf2b351764d",
                                "sense_id": "7c073f8a-2d27-3501-bd2f-32c1ce1793db",
                                "text": "Jak to jest być astronomką. Śmieją się, kiedy ktoś myli je z astrologami i prosi, żeby postawiły horoskop"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "b91ea668-6ec7-30fb-b350-82c7020ed299",
                        "entry_id": "8d93f137-256e-367a-bf7b-3c6b7f3b8906",
                        "glosses": [
                            "miłośniczka i znawczyni astronomii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7794d3fc-e108-418c-acb8-b084f1f5b833",
                                "sense_id": "b91ea668-6ec7-30fb-b350-82c7020ed299",
                                "text": "Astronomka amatorka odkryła nową planetoidę."
                            },
                            {
                                "example_id": "fa76429f-3780-4c89-9e84-1fdd6c7d52b6",
                                "sense_id": "b91ea668-6ec7-30fb-b350-82c7020ed299",
                                "text": "Ania jest ekonomistką z zawodu i astronomką z zamiłowania."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
