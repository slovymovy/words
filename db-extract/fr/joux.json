                "entry_id": "b7020025-a305-35a0-8a6d-5540396b1467",
                "word": "joux",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9e9d3a70-fff3-3751-a7b0-d9613b66c0fa",
                        "entry_id": "b7020025-a305-35a0-8a6d-5540396b1467",
                        "glosses": [
                            "Dans le Jura et dans les Alpes, une joux, sans préciser de couleur, signifie une vaste étendue de forêt de montagne de sapins et d'épicéas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6987123-80e5-4620-9e44-7cfea4fc0ff8",
                                "sense_id": "9e9d3a70-fff3-3751-a7b0-d9613b66c0fa",
                                "text": "Il y a un lien profond entre les paysages un peu sévères, les joux sombres, les clochers bulbes, les grandes fermes et cet esprit d'humour, de gaieté et de gravité mêlés qui rendent les Comtois attachants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a1302bc-57d1-403f-8334-e6caf6449695",
                        "source_entry_id": "b7020025-a305-35a0-8a6d-5540396b1467",
                        "source_sense_id": "9e9d3a70-fff3-3751-a7b0-d9613b66c0fa",
                        "target_lang_word": "Schwarzwald",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwarzwald",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1888781-0d5e-38c3-9005-b9553e995330",
                                        "entry_id": "4bf245f5-f99c-3324-b3e0-b32400023c50",
                                        "glosses": [
                                            "südwestdeutsches Mittelgebirge, das sich vom Dreiländereck (Frankreich, Schweiz, Deutschland) aus etwa 160 km nach Norden östlich der Oberrheinischen Tiefebene erstreckt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5786e967-8c5f-4528-ae2f-4a6322a2105f",
                                                "sense_id": "f1888781-0d5e-38c3-9005-b9553e995330",
                                                "text": "„Ein vermeintlich abgestürzter Gleitschirmflieger hat im Schwarzwald für einen Einsatz von Polizei und Bergwacht gesorgt.“"
                                            },
                                            {
                                                "example_id": "2d8b409b-3f94-4e27-a5be-aa89868bff05",
                                                "sense_id": "f1888781-0d5e-38c3-9005-b9553e995330",
                                                "text": "Der Schwarzwald ist bei Touristen für die Kuckucksuhren, den Schinken und die Trachten bekannt."
                                            },
                                            {
                                                "example_id": "bdfec631-6dc8-4100-ab45-9aef5ffeabb1",
                                                "sense_id": "f1888781-0d5e-38c3-9005-b9553e995330",
                                                "text": "„Der 28-jährige katholische Bauernsohn aus dem Schwarzwald hatte sich im Krieg ausgezeichnet und später als Leutnant mit den Freikorps an den Nachkriegskämpfen im Baltikum und in Oberschlesien teilgenommen.“"
                                            },
                                            {
                                                "example_id": "37818e5a-65b3-460d-9c12-2fe1c4d984ea",
                                                "sense_id": "f1888781-0d5e-38c3-9005-b9553e995330",
                                                "text": "„Und mit den Figuren dieser Geschichten malte er seine ersten Comics, die er seiner älteren Schwester in dicken Briefen nachschickte, als sie vier Wochen auf einer Kindererholung im dunklen Schwarzwald zubrachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
