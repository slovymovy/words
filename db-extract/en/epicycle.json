    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "36b2da7d-986c-3300-8401-bbd986e083bc",
                "word": "epicycle",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9d024220-f6ba-45c5-b149-3e2735091142",
                        "entry_id": "36b2da7d-986c-3300-8401-bbd986e083bc",
                        "tags": [
                            "plural"
                        ],
                        "form": "epicycles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8e09c184-109f-3744-9720-8be6ac93b3fc",
                        "entry_id": "36b2da7d-986c-3300-8401-bbd986e083bc",
                        "glosses": [
                            "A small circle whose centre is on the circumference of a larger circle; in Ptolemaic astronomy it was seen as the basis of revolution of the \\\"seven planets\\\", given a fixed central Earth."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3d92b39-b6c0-4321-add6-6fcbcb0a9fd7",
                                "sense_id": "8e09c184-109f-3744-9720-8be6ac93b3fc",
                                "text": "Is it not [Philosophie], that […] teacheth miserie, famine and sicknesse to laugh? Not by reason of some imaginarie Epicicles, but by naturall and palpable reasons."
                            }
                        ]
                    },
                    {
                        "sense_id": "93b46907-b4d0-339d-8ff4-30d8a2aad34a",
                        "entry_id": "36b2da7d-986c-3300-8401-bbd986e083bc",
                        "glosses": [
                            "Any circle whose circumference rolls around that of another circle, thus creating a hypocycloid or epicycloid."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cbeca66a-744c-3148-929c-8112582a1256",
                        "entry_id": "36b2da7d-986c-3300-8401-bbd986e083bc",
                        "glosses": [
                            "A ring of atoms joining parts of an already cyclic compound"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f127be48-194e-3eeb-858c-3b8fa6d725b3",
                        "entry_id": "36b2da7d-986c-3300-8401-bbd986e083bc",
                        "glosses": [
                            "An ad hoc complication added to a model to make it fit the known data"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "798944ca-a220-4a71-88cb-7b8ee7bf52b9",
                                "sense_id": "f127be48-194e-3eeb-858c-3b8fa6d725b3",
                                "text": "If two chronicles seemed contradictory, instead of trying to choose between them, a rationalization (epicycle) was devised to cover both."
                            },
                            {
                                "example_id": "37194663-4501-466f-8d02-176f01c0f002",
                                "sense_id": "f127be48-194e-3eeb-858c-3b8fa6d725b3",
                                "text": "Rather than solve the theoretical problem of how to produce a method of political ethics, the contractarian device introduces an unnecessary theoretical epicycle into what is otherwise a coherent account of social justice in particular and political morality in general."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c740b9f-dc83-41ae-ab4d-59c3cfd97541",
                        "source_entry_id": "36b2da7d-986c-3300-8401-bbd986e083bc",
                        "source_sense_description": "a small circle whose centre is on the circumference of a larger circle",
