                "senses": [
                    {
                        "sense_id": "e5d2887c-c61f-3699-81f2-20a1d10a0b74",
                        "entry_id": "90203e85-8106-34b1-aa8f-326be5ff8093",
                        "glosses": [
                            "Dont la surface présente ou semble présenter des ondulations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b79fe95-a382-4de3-8cc4-d9e51c6ed77d",
                                "sense_id": "e5d2887c-c61f-3699-81f2-20a1d10a0b74",
                                "text": "Le nouveau campement est établi à une douzaine de kilomètres de l'ancien, dans une plaine ondulée et verdoyante."
                            },
                            {
                                "example_id": "86d0b317-cf12-4411-b235-4fd3e545fb56",
                                "sense_id": "e5d2887c-c61f-3699-81f2-20a1d10a0b74",
                                "text": "Qu’y a-t-il vers les cabanes aux toits ondulés, dans le silence gris des brumes ?"
                            },
                            {
                                "example_id": "940b5b48-ae06-46d4-b112-ffffcd19ffa8",
                                "sense_id": "e5d2887c-c61f-3699-81f2-20a1d10a0b74",
                                "text": "Le cachemire n'est pas ondulé comme la laine ; il est souple, soyeux et brillant."
                            }
                        ]
                    },
                    {
                        "sense_id": "5932210d-a579-309e-9672-7da452bb4dd3",
                        "entry_id": "90203e85-8106-34b1-aa8f-326be5ff8093",
                        "glosses": [
                            "Branché sur un onduleur, s’emploie surtout pour une prise de courant dans l’expression : prise ondulée."
                        ],
                        "tags": [],
                        "examples": []
                    }
