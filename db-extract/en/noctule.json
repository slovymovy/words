                                                "sense_id": "683669ff-aef8-3a62-97f4-22c384d4a3cd",
                                                "text": "Вечерница предпочитает селиться в широколиственных и смешанных лесах."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ea6a07b-bf37-30a4-997a-568052bd4f76",
                                        "entry_id": "0ebc61e2-89d6-320f-bfad-8c60deb6da16",
                                        "glosses": [
