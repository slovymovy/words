                                    {
                                        "sense_id": "e7d87011-751b-3555-a984-e36fe8b7804e",
                                        "entry_id": "ac36e30f-e132-3e3e-a7f2-53c22a58d8d4",
                                        "glosses": [
                                            "Körperhaltung des Springers bei der Landung mit einem nach vorne gerichteten Bein, einem abgewinkelten Knie und seitlich ausgestreckten Armen"
                                        ],
                                        "tags": [
                                            "Skispringen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce161887-979a-42f1-ab4a-57930f75eefb",
                                                "sense_id": "e7d87011-751b-3555-a984-e36fe8b7804e",
                                                "text": "Mit 93,5 Metern im zweiten Versuch sicherte Freitag den zweiten Platz, obwohl ihm wie im ersten Durchgang nach unruhiger Luftfahrt keine Telemark-Landung gelang und deshalb einige Punkte abgezogen wurden."
                                            },
                                            {
                                                "example_id": "83fce6bc-8443-4c9e-95ce-7faa38507090",
                                                "sense_id": "e7d87011-751b-3555-a984-e36fe8b7804e",
                                                "text": "Und natürlich setzte er im Wettkampf zwei lupenreine Telemark."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "90b8574e-4132-39eb-bdfa-da82a8eedeb6",
                                        "entry_id": "ac36e30f-e132-3e3e-a7f2-53c22a58d8d4",
                                        "glosses": [
                                            "Querschwung zum Hang"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1dd0999-b39e-41df-8b51-51b11a0ea037",
                                                "sense_id": "90b8574e-4132-39eb-bdfa-da82a8eedeb6",
                                                "text": "Es gibt wahrscheinlich nur wenige Sportarten auf der Welt, durch die man die verschiedenen Grade des Beinmuskelkaters besser kennen lernen kann, als das Skifahren im Telemark-Stil."
                                            },
                                            {
                                                "example_id": "ec62b079-4c94-417d-9dad-29f037b7283e",
                                                "sense_id": "90b8574e-4132-39eb-bdfa-da82a8eedeb6",
                                                "text": "Telemark ist eine Kunst, eine Lebensart."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Telemark",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81891b65-6e4f-3966-b6f6-2c403db11203",
                                        "entry_id": "8ee65e2c-9f3e-307c-87a1-ebd208c057b3",
                                        "glosses": [
                                            "Verwaltungsbezirk im Süden Norwegens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55fd766c-7881-45cc-8de8-6c1a64e9171a",
                                                "sense_id": "81891b65-6e4f-3966-b6f6-2c403db11203",
                                                "text": "Skien ist das Verwaltungszentrum der Provinz Telemark."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9e0c2299-213c-37f7-a8e9-e7aa4ca20de8",
                                        "entry_id": "8ee65e2c-9f3e-307c-87a1-ebd208c057b3",
                                        "glosses": [
                                            "Region im Süden Norwegens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b1ba0c5-27ac-4657-97a2-91d3a4d9ec05",
                                                "sense_id": "9e0c2299-213c-37f7-a8e9-e7aa4ca20de8",
                                                "text": "Mit Telemark präsentiert sich eine Region Norwegens, die durch Zauber und Magie zum Leben erweckt wird."
                                            },
                                            {
                                                "example_id": "5359f84e-cc22-43ff-914f-43626689025b",
                                                "sense_id": "9e0c2299-213c-37f7-a8e9-e7aa4ca20de8",
                                                "text": "Ganz langsam können Sie die Telemark an Bord der alten Dampfschiffe Victoria und Henrik Ibsen erkunden, die morgens in Skien an der Südküste ablegen und am frühen Abend in Dalen mitten in der Telemark festmachen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
