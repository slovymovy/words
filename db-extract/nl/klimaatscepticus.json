                "senses": [
                    {
                        "sense_id": "93d996bc-9334-38f6-aa81-adc6619149d7",
                        "entry_id": "e153c327-4578-35f5-9c17-66294d3af68a",
                        "glosses": [
                            "iemand die (sterk) betwijfelt dat de mens verantwoordelijk is voor de klimaatverandering"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75af410e-b98c-4318-b0d3-67670883c9fc",
                                "sense_id": "93d996bc-9334-38f6-aa81-adc6619149d7",
                                "text": "Klimaatscepticus Scott Pruitt vocht, voordat hij de baas van het EPA werd, als openbaar aanklager van Oklahoma jarenlang tegen de milieumaatregelen die datzelfde bureau uitvaardigde. Onder zijn leiding trokken de VS zich terug uit het Klimaatakkoord van Parijs."
                            },
                            {
                                "example_id": "522cab3b-0170-47fe-9510-5f260c9fb5ae",
                                "sense_id": "93d996bc-9334-38f6-aa81-adc6619149d7",
                                "text": "Een Nederlandse klimaatscepticus is erin geslaagd een passage over de gevolgen van klimaatverandering te weren uit het VVD-verkiezingsprogramma."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3f0de52-0114-3d84-9321-ca671a912aab",
                        "entry_id": "e153c327-4578-35f5-9c17-66294d3af68a",
                        "glosses": [
                            "iemand die (sterk) betwijfelt dat er sprake is van een klimaatverandering"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79a85a76-c7f9-441a-99ca-52674d4858ec",
                                "sense_id": "f3f0de52-0114-3d84-9321-ca671a912aab",
                                "text": "In de jaren tachtig werd al voorspeld dat de Malediven op den duur zouden verdwijnen, als een 21e-eeuws Atlantis. Dit is nog niet gebeurd, wat dankbaar wordt aangegrepen door klimaatsceptici – een concrete ramp blijft als het ware uit."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b8b8142-3343-3c85-b861-dc5dc4d22342",
                        "entry_id": "e153c327-4578-35f5-9c17-66294d3af68a",
                        "glosses": [
                            "een persoon die de mening verbreidt dat het klimaat zich niet of nauwelijks door menselijke activiteit laat beïnvloeden (maar eerder door natuurlijke processen van de aarde of variaties van de zonnekracht)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cb7b85f-5ffb-45c6-8f5d-0d4d7aa343bc",
                                "sense_id": "0b8b8142-3343-3c85-b861-dc5dc4d22342",
                                "text": "De Nederlandse klimaatscepticus Frits Böttcher, ooit mede-oprichter van de Club van Rome, heeft tussen 1989 en 1998 meer dan een miljoen gulden ontvangen van Shell en andere multinationals (Shell, Texaco, Hoogovens, DSM, de Gasunie, de NAM, de KLM, Schiphol, ING, Bovag en de ANWB). Het doel was: twijfel zaaien over klimaatverandering en de rol van de mens daarin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87daa56e-000b-4dd1-a487-d945f21dc9b6",
                        "source_entry_id": "e153c327-4578-35f5-9c17-66294d3af68a",
                        "target_lang_word": "Klimaskeptiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klimaskeptiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4835176d-4c95-3b7c-94ae-5eb82a5dfd36",
                                        "entry_id": "8c16d4e4-94b7-3463-ae9c-dc1e1ee2bc73",
                                        "glosses": [
                                            "Person, die den menschengemachten Klimawandel anzweifelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3874b549-7b6c-48da-ab56-33edc198f799",
                                                "sense_id": "4835176d-4c95-3b7c-94ae-5eb82a5dfd36",
                                                "text": "„Im Team des gewählten Präsidenten bereiten Klimaskeptiker eine Neuordnung der US-Umweltbehörde vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1960c95d-0969-4662-aefd-b0545b2c0eca",
