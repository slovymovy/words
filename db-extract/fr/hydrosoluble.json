                            "feminine"
                        ],
                        "form": "hydrosolubles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "64bc5f0e-ecd8-3e8b-94e7-d9ef9bac7f4b",
                        "entry_id": "0f413b4d-5dc4-3e31-bc02-dc25edbb8e32",
                        "glosses": [
                            "Qualifie un corps chimique soluble dans l’eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c45f701-b774-4eb9-8b3f-7da51b252f8d",
                                "sense_id": "64bc5f0e-ecd8-3e8b-94e7-d9ef9bac7f4b",
                                "text": "Nous employons ici systématiquement comme liquide de contraste des solutions triiodées hydrosolubles de faible concentration (25 % à 35 % max.)."
                            },
                            {
                                "example_id": "dcc00bf3-0254-44f4-9ed8-386fcb01ee5c",
                                "sense_id": "64bc5f0e-ecd8-3e8b-94e7-d9ef9bac7f4b",
                                "text": "Ainsi, les médicaments liposolubles quittent plus rapidement le sang pour pénétrer dans les tissus que les substances hydrosolubles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d06b692b-2227-4cd9-89e9-0316507f4230",
                        "source_entry_id": "0f413b4d-5dc4-3e31-bc02-dc25edbb8e32",
                        "source_sense_id": "64bc5f0e-ecd8-3e8b-94e7-d9ef9bac7f4b",
                        "target_lang_word": "wasserlöslich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wasserlöslich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9aff65a2-09cf-3726-92a8-26b2f431fccb",
                                        "entry_id": "3a814576-cf13-3bfb-b138-fea943b0821c",
                                        "glosses": [
                                            "sich in Wasser auflösen lassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97a0c26c-d76a-4b37-baa9-66e452d45e67",
                                                "sense_id": "9aff65a2-09cf-3726-92a8-26b2f431fccb",
                                                "text": "„Die Proteine sind nicht wasserlöslich, sodass die Schutzschicht auch ein kurzes Wasserbad übersteht“"
                                            },
                                            {
                                                "example_id": "dc49e82b-2435-4eae-9cf0-dc56a0c064f0",
                                                "sense_id": "9aff65a2-09cf-3726-92a8-26b2f431fccb",
                                                "text": "„Infolgedessen ist Kohlendioxid bei Raumtemperatur mehr als fünfzigmal wasserlöslicher als Stickstoff und mehr als fünfundzwanzigmal wasserlöslicher als Sauerstoff.“"
                                            },
                                            {
                                                "example_id": "2140cf99-cf1d-48a0-bd43-7b313c7f123e",
                                                "sense_id": "9aff65a2-09cf-3726-92a8-26b2f431fccb",
                                                "text": "„Aromatische Verbindungen und solche mit einem niedrigen Molekulargewicht sind im allgemeinen toxischer, neigen aber dazu, sich vom Ölteppich durch Verdunstung und Lösung innerhalb weniger Stunden zu trennen, da sie am flüchtigsten und wasserlöslichsten sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
