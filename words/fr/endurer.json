                    "frequency": "Low",
                    "semantic_group_id": "permettre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne pouvait pas <w>endurer</w> qu'on traite ses proches avec un tel mépris.temps"
                        },
                        {
                            "text": "Notre famille n'<w>endurerait</w> point qu'une injustice semblable soit commise sans réaction."
                        }
                    ],
                    "synonyms": [
                        "permettre",
                        "tolérer"
                    ],
                    "antonyms": [
