                "senses": [
                    {
                        "sense_id": "872062ed-ac5b-3d8d-b2c7-a8fce81e58e7",
                        "entry_id": "5d403b3c-0900-3c75-ad51-dd6b16919885",
                        "glosses": [
                            "Par anticipation, à l’avance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e39ceab5-8e84-4f39-96f8-891bf4a5a059",
                                "sense_id": "872062ed-ac5b-3d8d-b2c7-a8fce81e58e7",
                                "text": "La rétribution accordée aux instituteurs est fixée à trois francs par semestre, à payer par les élèves anticipativement."
                            },
                            {
                                "example_id": "f3796758-c4ac-44f2-9573-2b131baafbc0",
                                "sense_id": "872062ed-ac5b-3d8d-b2c7-a8fce81e58e7",
                                "text": "La pension est payable par trimestre et anticipativement."
                            },
                            {
                                "example_id": "884858b6-5a75-4292-865c-1214c90574ce",
                                "sense_id": "872062ed-ac5b-3d8d-b2c7-a8fce81e58e7",
                                "text": "Que la vie, la vraie vie, doit être, avant tout, vécue ; non rétrospectivement par l’étude du passé, non anticipativement par le rêve du futur, mais bien actuellement dans le moment présent."
                            }
                        ]
                    }
