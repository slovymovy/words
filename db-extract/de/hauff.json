                ],
                "senses": [
                    {
                        "sense_id": "caa8cc37-e412-3107-b0cd-9bb3eb3bc0bb",
                        "entry_id": "8e517bcb-9524-3b51-a096-58bcb805f077",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb2c06b8-34c6-4a6e-a410-5083a3138ad5",
                                "sense_id": "caa8cc37-e412-3107-b0cd-9bb3eb3bc0bb",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hauff kommt, geht der Herr Hauff.“"
                            },
                            {
                                "example_id": "015764fb-a6e2-44fa-be10-0396fa9333e0",
                                "sense_id": "caa8cc37-e412-3107-b0cd-9bb3eb3bc0bb",
                                "text": "Hauff kommt und geht."
                            },
                            {
                                "example_id": "f5b63434-8e05-4689-bf6d-ea0168d444e3",
                                "sense_id": "caa8cc37-e412-3107-b0cd-9bb3eb3bc0bb",
                                "text": "Hauffs kamen, sahen und siegten."
                            },
                            {
                                "example_id": "4067055e-6f6c-46a1-a612-22636716be5a",
                                "sense_id": "caa8cc37-e412-3107-b0cd-9bb3eb3bc0bb",
                                "text": "Der Hauff trägt nie die Schals, die die Hauff ihm strickt."
                            },
                            {
                                "example_id": "6bed9b19-af43-45e6-866c-bccc2224192b",
                                "sense_id": "caa8cc37-e412-3107-b0cd-9bb3eb3bc0bb",
                                "text": "Frau Hauff ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e7619cb7-14d0-45a8-befe-93c56681c854",
                                "sense_id": "caa8cc37-e412-3107-b0cd-9bb3eb3bc0bb",
                                "text": "Herr Hauff wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8aaa72a6-82d1-438c-827e-b7c7da233c6f",
                                "sense_id": "caa8cc37-e412-3107-b0cd-9bb3eb3bc0bb",
                                "text": "Die Hauffs fliegen heute nach La Paz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
