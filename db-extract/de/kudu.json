                "senses": [
                    {
                        "sense_id": "e5e21971-3730-306e-8c25-1b05812f8ca7",
                        "entry_id": "a2473b9f-d802-3931-86e8-23057609572c",
                        "glosses": [
                            "in Afrika verbreitete Antilopenart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e31805d-7bf4-4b1a-acb4-ab0990c88fc1",
                                "sense_id": "e5e21971-3730-306e-8c25-1b05812f8ca7",
                                "text": "„›Als er den Dienstweg entlanggefahren ist, hat er einen starken Verwesungsgeruch wahrgenommen, aber da hat er sich noch nichts dabei gedacht, denn manchmal erwischt ein Zug einen Kudu oder ein anderes Tier, manchmal auch einen Betrunkenen.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb397886-9aeb-4c0c-93ca-fa8b000080af",
                        "source_entry_id": "a2473b9f-d802-3931-86e8-23057609572c",
