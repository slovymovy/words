                        "entry_id": "e9c284e9-00cb-3666-9853-d351e7e25c0c",
                        "glosses": [
                            "urządzenie elektryczne odbierające fale elektromagnetyczne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98908d83-1de6-44b7-b490-621d77420105",
                                "sense_id": "4e4297d0-1866-3222-86e6-2fcd7067859c",
                                "text": "Przed wojną na Wełnowcu produkowano odbiorniki radiowe."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "090d2cbb-6977-3d72-8801-e5aa14012329",
                        "entry_id": "e9c284e9-00cb-3666-9853-d351e7e25c0c",
                        "glosses": [
                            "zbiornik, do którego coś spływa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7b05112-3342-4b7f-a698-24ce48229926",
                                "sense_id": "090d2cbb-6977-3d72-8801-e5aa14012329",
                                "text": "Obieg cieczy między pompą a odbiornikiem nazywamy obiegiem hydraulicznym"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "d1fe5fa1-3350-3912-9ddc-ff7512e725ff",
                        "entry_id": "e9c284e9-00cb-3666-9853-d351e7e25c0c",
                        "glosses": [
                            "urządzenie pobierające energię elektryczną i przekazujące ją do obwodu elektrycznego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28fd4000-e780-4a2c-a2a0-2945cde6e1d0",
                                "sense_id": "d1fe5fa1-3350-3912-9ddc-ff7512e725ff",
                                "text": "Odbiornikiem z punktu widzenia gospodarki elektroenergetycznej nazywamy urządzenie, maszynę lub aparat przetwarzające energię elektryczną pobraną z sieci na taką energię, jaka jest potrzebna odbiorcy"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
