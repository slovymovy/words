                                                "example_id": "62120883-051e-4889-8bf9-17361887cdb4",
                                                "sense_id": "3f498eee-59dc-379f-9c45-756c8d17e10a",
                                                "text": "On sonne. Je vais ouvrir, le faciès rogue, la sèche au coin de la gueule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "023bd230-3730-36a1-8465-13a63f3b23fd",
