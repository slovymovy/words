                "senses": [
                    {
                        "sense_id": "352dfa9f-9171-304b-9bb7-1e81cb0b82f3",
                        "entry_id": "8d5eb994-7d63-3d72-b002-65fbc3b510a0",
                        "glosses": [
                            "als je ergens treurig, somber en verdrietig van wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24eb4ba1-d21a-4f27-a54b-ecf28dcb40a7",
                                "sense_id": "352dfa9f-9171-304b-9bb7-1e81cb0b82f3",
                                "text": "Het was naargeestig weer want het miezerde de hele dag."
                            },
                            {
                                "example_id": "9f09def5-9395-4bcb-8495-1b4a00e71b2b",
                                "sense_id": "352dfa9f-9171-304b-9bb7-1e81cb0b82f3",
                                "text": "De bodem veranderde in een zachtbruine zandvlakte, die Kleine Woord ineens herinnerde aan de Vlakte van de Namen. Maar deze was toch anders. Naargeestiger leek het wel."
                            }
                        ]
                    }
                ],
