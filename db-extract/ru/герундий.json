                                "target_senses": [
                                    {
                                        "sense_id": "6dbb2fb1-9e79-3ae6-80ea-a851d4da89ef",
                                        "entry_id": "a50f4b0d-604f-3a76-8be5-5ecdbd895338",
                                        "glosses": [
                                            "modo verbale della lingua italiana usato per esprimere un'azione secondaria. È composto da due tempi: il presente, che è di tipo semplice, e il passato, quest'ultimo composto. Si può usare per esprimere un valore causale, modale, strumentale, ipotetico e temporale"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9521c8f-0967-4359-85f5-3c7c0b92076d",
                                                "sense_id": "6dbb2fb1-9e79-3ae6-80ea-a851d4da89ef",
                                                "text": "Non posso ascoltarti mentre sto lavorando"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
