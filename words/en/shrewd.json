                    "synonyms": [
                        "evil",
                        "bad",
                        "mischievous",
                        "wicked"
                    ],
                    "antonyms": [
                        "good",
                        "beneficial"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Obsolete meaning of bad or evil"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Zły, niegodziwy lub zwiastujący nieszczęście (przestarzałe)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zły",
                                "target_lang_sense_clarification": "niegodziwy, niepomyślny"
