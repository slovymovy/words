                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "3bbba788-5058-46f1-8858-ae18bc28f9ef",
                                "sense_id": "9704596e-b7e3-32e8-b10f-116dde27e047",
                                "text": "Der Weg schlängelte sich einen steilen Hügel hinauf. Es ging äußerst langsam und mühselig voran, nicht schneller als fünf Stundenkilometer, ockerfarbene Staubwolken umwirbelten uns.",
                                "translation": "Le chemin gravissait en lacets une colline escarpée. La montée fut pénible, nous ne pouvions pas dépasser le cinq à l’heure, des nuages de poussière ocre tourbillonnaient autour de nous."
                            }
                        ]
                    }
