                        ]
                    },
                    {
                        "translation_id": "7444de1e-74df-4745-b24c-5ab3209f2a82",
                        "source_entry_id": "1db1ba59-83a2-3389-a664-53b7fcf002cb",
                        "target_lang_word": "Athlet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Athlet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a15e744c-3e54-3909-b8b7-b2851c08bb96",
                                        "entry_id": "98d269f3-d5c3-3fd9-a6f8-c477f34dc06b",
                                        "glosses": [
                                            "Sportler und/oder Wettkämpfer an öffentlichen Spielen bei den alten Griechen und Römern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d291f4e-2e15-4992-b4b8-4a8450346a7e",
                                                "sense_id": "a15e744c-3e54-3909-b8b7-b2851c08bb96",
                                                "text": "Die Athleten waren dieses Jahr alle sehr gut."
                                            },
                                            {
                                                "example_id": "ede97bf8-e71e-4c7f-a146-7d1d07001ce2",
                                                "sense_id": "a15e744c-3e54-3909-b8b7-b2851c08bb96",
                                                "text": "„Staatsanwalt Nel: Der Athlet ist in jedem Fall des Mordes schuldig.“"
                                            },
                                            {
                                                "example_id": "6e34efc7-d736-4671-b001-495738023d9e",
                                                "sense_id": "a15e744c-3e54-3909-b8b7-b2851c08bb96",
                                                "text": "„Pistorius habe nach dem Tod seiner Freundin keine Krokodilstränen vergossen. Der Athlet sei in tiefer Trauer gewesen.“"
                                            },
                                            {
                                                "example_id": "a330932d-fe5e-48fc-ad04-1b87526a3ab1",
                                                "sense_id": "a15e744c-3e54-3909-b8b7-b2851c08bb96",
                                                "text": "„Weitere erfolgreiche Athleten folgten ihnen nach, aber diese absolute finnische Dominanz war nicht weiter aufrechtzuerhalten.“"
                                            },
                                            {
                                                "example_id": "e82556bb-7290-4709-9c08-1fd1631ccfe1",
                                                "sense_id": "a15e744c-3e54-3909-b8b7-b2851c08bb96",
                                                "text": "„Depressionen im Spitzensport sind seit den Suiziden bekannter Athleten und Athletinnen ein Dauerthema im öffentlichen Diskurs.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d91ae72f-0ea2-34cb-bf20-10d78236b7c1",
                                        "entry_id": "98d269f3-d5c3-3fd9-a6f8-c477f34dc06b",
                                        "glosses": [
                                            "Mensch mit kräftigem Körperbau und ausgeprägter Muskulatur"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dc7ba07-a468-4658-9989-3349e900567a",
                                                "sense_id": "d91ae72f-0ea2-34cb-bf20-10d78236b7c1",
                                                "text": "Dieser Mann ist ein Athlet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e6da042-689d-4cca-bb92-0f8868aecba3",
                        "source_entry_id": "1db1ba59-83a2-3389-a664-53b7fcf002cb",
                        "target_lang_word": "athlète",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "athlète",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a99ec2b9-6bd1-3d20-8ae9-3efcdfba9f5a",
                                        "entry_id": "d3f704d3-e910-39b8-a66c-14626721c3ed",
                                        "glosses": [
                                            "Sportif qui combattait à la lutte ou au pugilat, dans les jeux solennels de l’ancienne Grèce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2161e431-2701-4411-b8a3-f7699037f6d9",
                                                "sense_id": "a99ec2b9-6bd1-3d20-8ae9-3efcdfba9f5a",
                                                "text": "Les combats d’athlètes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b117137-75d6-3a38-9b4e-d28e6da57374",
                                        "entry_id": "d3f704d3-e910-39b8-a66c-14626721c3ed",
                                        "glosses": [
                                            "Personne qui pratique l’athlétisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52e94094-6e8a-4521-ae9a-96e0babb6dad",
                                                "sense_id": "6b117137-75d6-3a38-9b4e-d28e6da57374",
                                                "text": "Les règles du sprint en athlétisme stipulent depuis 2002 que, si un athlète quitte les starting blocks en moins de 100 ms (0,1 s) après le coup de feu, il sera sanctionné d'un faux départ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edf96f2a-3740-3fbf-8cc7-fe8679e40a19",
                                        "entry_id": "d3f704d3-e910-39b8-a66c-14626721c3ed",
                                        "glosses": [
                                            "Sportif ou sportive de haut niveau, qui participe à une compétition."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d28f519-180b-4e4a-9219-faff3c9e8716",
                                                "sense_id": "edf96f2a-3740-3fbf-8cc7-fe8679e40a19",
                                                "text": "Un athlète ne peut arriver en compétition très motivé s’il n’a jamais été mis à l’épreuve."
                                            },
                                            {
                                                "example_id": "a6748ef8-3101-4b54-b305-f03f410c48eb",
                                                "sense_id": "edf96f2a-3740-3fbf-8cc7-fe8679e40a19",
                                                "text": "Une variante particulière du gène DCP, qui code pour l’enzyme de conversion de l’angiotensine, peut faire la différence entre quelqu’un qui peinerait à l’effort physique et un athlète de haut niveau dans des sports d’endurance."
                                            },
                                            {
                                                "example_id": "faa0351e-3518-40cd-8e1a-5d74f5fb4a5b",
                                                "sense_id": "edf96f2a-3740-3fbf-8cc7-fe8679e40a19",
                                                "text": "Les athlètes français ne seront pas autorisés à porter le badge « Pour un monde meilleur » destiné à montrer leur attachement aux droits de l'Homme lors des JO de Pékin"
                                            },
                                            {
                                                "example_id": "3ca147f9-db0d-4fbf-8675-754466efa9cb",
                                                "sense_id": "edf96f2a-3740-3fbf-8cc7-fe8679e40a19",
                                                "text": "Noooon. Je ne veux pas devenir une athlète olympique, me lever tous les matins à 5 h, m’entrainer quatre heures par jour et participer à des tournois à l’autre bout du monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2309bb53-8d4a-3c63-badf-b574b8b65a86",
                                        "entry_id": "d3f704d3-e910-39b8-a66c-14626721c3ed",
                                        "glosses": [
                                            "Personne très forte, robuste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7c39cc2-a89f-4a5c-b1d8-02ac7e983744",
                                                "sense_id": "2309bb53-8d4a-3c63-badf-b574b8b65a86",
                                                "text": "Êtes-vous un hercule, lecteur ?… Peut-être. Tous mes compliments. Mais votre femme n'est pas une athlète, votre fils, votre frère, vos amis n’ont pas votre force."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
