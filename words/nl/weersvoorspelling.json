                            }
                        },
                        {
                            "text": "Meteorologen gebruiken satellieten voor een nauwkeurige <w>weersvoorspelling</w>.",
                            "target_lang_translations": {
                                "ru": "Метеорологи используют спутники для точного <w>прогнозирования погоды</w>."
