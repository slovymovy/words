                        "examples": [
                            {
                                "example_id": "0b7ef2ca-9541-4931-a3c8-41726ca39802",
                                "sense_id": "d30a3a56-6f05-3466-9ac7-e12af4275ba2",
                                "text": "Drie rensters? En de andere vier dan? Die waren maandag in de openingsetappe al direct afgestapt. Na de finish van de vierde etappe in Luik was er nog maar eentje over, de Oezbeeks kampioen Yanina Kuskova (22)."
                            },
                            {
                                "example_id": "8dd5f164-a25d-4347-b520-e9fac42cf4c4",
                                "sense_id": "d30a3a56-6f05-3466-9ac7-e12af4275ba2",
                                "text": "Lild-Trek heeft de openingsetappe van de Vuelta Femenina gewonnen. In de ploegentijdrit was de ploeg van Ellen van Dijk nipt de snelste, ondanks een valpartij van de Nederlandse."
                            }
                        ]
                    }
