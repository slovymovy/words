                    "sense_id": "0af1f2e2-19f2-37e5-8dc6-669c82716e72",
                    "sense_definition": "Глубокое эмоциональное влечение, сильная сердечная привязанность к другому человеку или объекту.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "emotion_feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Материнская <w>любовь</w> считается самым сильным чувством на свете.",
                            "target_lang_translations": {
                                "en": "Maternal <w>love</w> is considered the strongest feeling in the world.",
                                "nl": "Moederlijke <w>liefde</w> wordt beschouwd als het sterkste gevoel ter wereld.",
                                "pl": "Matczyna <w>miłość</w> jest uważana za najsilniejsze uczucie na świecie.",
                                "fr": "L'<w>amour</w> maternel est considéré comme le sentiment le plus fort au monde.",
                                "de": "Mütterliche <w>Liebe</w> gilt als das stärkste Gefühl auf der Welt.",
                                "es": "El <w>amor</w> maternal se considera el sentimiento más fuerte del mundo.",
                                "it": "L'<w>amore</w> materno è considerato il sentimento più forte al mondo.",
                                "tr": "Anne <w>sevgisi</w> dünyadaki en güçlü duygu olarak kabul edilir.",
                                "cs": "Mateřská <w>láska</w> je považována za nejsilnější cit na světě.",
                                "zh": "母<w>爱</w>被认为是世界上最强烈的情感。"
                            }
                        },
                        {
                            "text": "Они поженились по большой и чистой <w>любви</w>.",
                            "target_lang_translations": {
                                "en": "They married for great and pure <w>love</w>.",
                                "nl": "Ze trouwden uit grote en pure <w>liefde</w>.",
                                "pl": "Pobrali się z wielkiej i czystej <w>miłości</w>.",
                                "fr": "Ils se sont mariés par un grand et pur <w>amour</w>.",
                                "de": "Sie heirateten aus großer und reiner <w>Liebe</w>.",
                                "es": "Se casaron por un <w>amor</w> grande y puro.",
                                "it": "Si sono sposati per un grande e puro <w>amore</w>.",
                                "tr": "Büyük ve temiz bir <w>aşkla</w> evlendiler.",
                                "cs": "Vzali se z velké a čisté <w>lásky</w>.",
                                "zh": "他们是因为纯洁而伟大的<w>爱情</w>而结婚的。"
                            }
                        },
                        {
                            "text": "Первая <w>любовь</w> часто запоминается на всю жизнь.",
                            "target_lang_translations": {
                                "en": "First <w>love</w> is often remembered for a lifetime.",
                                "nl": "Eerste <w>liefde</w> wordt vaak voor het leven herinnerd.",
                                "pl": "Pierwsza <w>miłość</w> często zapada w pamięć na całe życie.",
                                "fr": "Le premier <w>amour</w> reste souvent gravé en mémoire pour toute la vie.",
                                "de": "Die erste <w>Liebe</w> bleibt oft ein Leben lang in Erinnerung.",
                                "es": "El primer <w>amor</w> a menudo se recuerda para toda la vida.",
                                "it": "Il primo <w>amore</w> si ricorda spesso per tutta la vita.",
                                "tr": "İlk <w>aşk</w> genellikle ömür boyu unutulmaz.",
                                "cs": "Na první <w>lásku</w> se často vzpomíná po celý život.",
                                "zh": "初<w>恋</w>往往让人终生难忘。"
                            }
                        }
                    ],
                    "synonyms": [
                        "привязанность"
