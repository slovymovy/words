                "senses": [
                    {
                        "sense_id": "0be36f67-e5ae-32b5-bcaa-1cf14f8f403e",
                        "entry_id": "c3be9675-b131-34cd-a54a-278b615ab0ec",
                        "glosses": [
                            "langstreckiger Radweg, der für mehrtägige Fahrradtouren geeignet und ausgeschildert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae13d067-7ca5-441d-b4d7-918c40694bf7",
                                "sense_id": "0be36f67-e5ae-32b5-bcaa-1cf14f8f403e",
                                "text": "„Durch den Ort führt der Radfernweg Eifel-Höhen-Route, die als Rundkurs um und durch den Nationalpark Eifel verläuft.“"
                            },
                            {
                                "example_id": "1e0674bd-6cd6-49f2-879f-ddb0885c30cc",
                                "sense_id": "0be36f67-e5ae-32b5-bcaa-1cf14f8f403e",
                                "text": "„Der Park liegt direkt am Radfernweg Hamburg – Bremen, auf dem Streckenabschnitt zwischen Hamburg und Harburg.“"
                            },
                            {
                                "example_id": "130e1377-fc43-4e11-a655-9acb927abb17",
                                "sense_id": "0be36f67-e5ae-32b5-bcaa-1cf14f8f403e",
                                "text": "Alle Informationen zur Schlossparkradrunde im Allgäu, zu den einzelnen Etappen des Radfernweges und weitere nützliche Tipps enthält das Serviceheft.“"
                            },
                            {
                                "example_id": "579ae440-9410-4657-ac7f-faa37364ae30",
                                "sense_id": "0be36f67-e5ae-32b5-bcaa-1cf14f8f403e",
                                "text": "„Diese Radfernwege sind grenzüberschreitend und ideal für mehrtägige Touren.“"
                            },
                            {
                                "example_id": "e0d2504f-b620-4414-9956-eb8f639906ec",
                                "sense_id": "0be36f67-e5ae-32b5-bcaa-1cf14f8f403e",
                                "text": "„Das ca. 400 km lange und gut ausgeschilderte Radwegenetz um und durch die Stadt bietet Anschluss an verschiedene Radfernwege wie z. B. den Elbe-Weser-Radweg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
