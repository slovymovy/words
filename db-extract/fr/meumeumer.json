                ],
                "senses": [
                    {
                        "sense_id": "7319b481-7956-3626-82d7-307e2e7f73d8",
                        "entry_id": "64256663-7c79-3704-b6ad-1d9cdd468c40",
                        "glosses": [
                            "Chanter dans sa bouche."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "9e8122cd-1492-42c4-8fbf-d0083b480d99",
                                "sense_id": "7319b481-7956-3626-82d7-307e2e7f73d8",
                                "text": "— La mélodie fait ça. Laisse-moi te la meumeumer comme je l'entends !"
                            },
                            {
                                "example_id": "0e0051e8-7f30-41dc-a825-928f0f83a888",
                                "sense_id": "7319b481-7956-3626-82d7-307e2e7f73d8",
                                "text": "Sans cesser de meumeumer ses borborygmes au dieu purificateur, Blanca nous invite à nous asseoir autour du feu."
                            },
                            {
                                "example_id": "f5a5ddea-978e-4734-a0a1-ade74a7eff2c",
                                "sense_id": "7319b481-7956-3626-82d7-307e2e7f73d8",
                                "text": "C'est un peu comme avoir un air dans la tête dont on connaît vaguement les paroles sans jamais réussir ni à les chanter ni à trouver qui en est le compositeur et « meumeumer » pour trouver de l'aide extérieure mais en vain."
                            },
                            {
                                "example_id": "6e4a296a-b747-4789-810d-9ed735cafb4d",
                                "sense_id": "7319b481-7956-3626-82d7-307e2e7f73d8",
                                "text": "Tu peux t’enregistrer en train de meumeumer l’air ?"
                            },
                            {
                                "example_id": "e96e8107-e88c-4fd8-b6ef-deeed590d043",
                                "sense_id": "7319b481-7956-3626-82d7-307e2e7f73d8",
                                "text": "Il suffit de cliquer sur \"Click and Sing or Hum\", d'autoriser le logiciel à accéder au micro du PC/Mac, et en avant, on peut passer la musique de la pub/film/etc. ou la chanter ou la \"meumeumer\" et ça trouve le titre/auteur de la chanson. Je l’ai testé, ça marche nickel (et pourtant, je ne chante vraiment pas bien, et je \"meumeume\" la plupart du temps)."
                            }
                        ]
                    }
                ],
