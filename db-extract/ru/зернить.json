                                        "entry_id": "9a68d40b-4b34-35ac-a2ca-460aee24bd43",
                                        "glosses": [
                                            "an einem Werkstoff, meist Metall, ein Bohrloch mit einem Körner markieren"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6530ad5d-4cfd-4e98-a17b-e819820f3b74",
                                                "sense_id": "8889da4b-735a-3d8a-847d-91af2fcd6828",
                                                "text": "„Zunächst müssen wir das Bohrloch sorgfältig ankörnen.“"
                                            },
