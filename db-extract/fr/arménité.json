                        "glosses": [
                            "Identité arménienne, ou appartenance au groupe ethnique ou linguistique arménien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e2e49b0-4739-4c54-b14e-1767600370e4",
                                "sense_id": "fd228b19-57bf-3e02-9c4b-8f97e530f2dc",
                                "text": "Neuf personnages un peu paumés en quête d’une identité, d’une citoyenneté, d’une arménité."
                            },
                            {
                                "example_id": "f0fc9550-df48-4f09-9cda-ae2ace3ae084",
                                "sense_id": "fd228b19-57bf-3e02-9c4b-8f97e530f2dc",
                                "text": "Je suis allé un an en pension arménienne, quand même, à Sèvres — une pension qui s’appelait Meritarian, qui a fermé depuis. […] Donc ça, ça été ma vraie expérience de l’arménité, de mon arménité, sauf que, en fait, il n’y avait pas de prof d’arménien : le prof c’était le pion, et comme il était pas payé pour faire cours, bah il faisait pas cours."
                            }
                        ]
                    }
