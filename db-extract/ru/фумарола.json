                                    {
                                        "sense_id": "123e638f-3c73-34c2-a891-02170476e353",
                                        "entry_id": "8b690452-4dab-3668-b5f9-53315da4e1d3",
                                        "glosses": [
                                            "An opening in the ground that emits steam and gases due to volcanic activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4317bc42-2eed-4a8a-89d5-acae1a82c6d1",
                                                "sense_id": "123e638f-3c73-34c2-a891-02170476e353",
                                                "text": "Masaya did not offer an opportunity to sample high-temperature fumaroles, but its neighbors, Momotombo and Cerro Negro volcanoes, are noted for their fumarolic activity"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
