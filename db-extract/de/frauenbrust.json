                "senses": [
                    {
                        "sense_id": "637d90c6-3f75-3d91-aaf1-087bdf34edee",
                        "entry_id": "b36074e1-108f-3ebf-a93d-1974ed8fe9c6",
                        "glosses": [
                            "vorderer Teil des Oberkörpers der Frau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "766e9908-7e18-4c11-a69b-51fd1146bbb2",
                                "sense_id": "637d90c6-3f75-3d91-aaf1-087bdf34edee",
                                "text": "„Der Mann war meist angezogen, die Frau eher nicht. Hefte wie „Men’s Health“ haben diese Grenze eingerissen, sie entblößen lieber eine Männer- als eine Frauenbrust.“"
                            },
                            {
                                "example_id": "9a7d0f4f-1038-4d7c-a10b-2eb633e0439b",
                                "sense_id": "637d90c6-3f75-3d91-aaf1-087bdf34edee",
                                "text": "„Du trugst in zarter Frauenbrust ein heldenmäßiges Männerherze, selbst in dem allergrößten Schmerze blieb dir die Kleinmuth unbewust“"
                            },
                            {
                                "example_id": "eb164664-fbe0-41a0-a51d-ccbfcc44ee0b",
                                "sense_id": "637d90c6-3f75-3d91-aaf1-087bdf34edee",
                                "text": "„Jeder weiß doch, dass eine Frauenbrust keine Schrottpresse ist, das Bild sei gelungen und außerdem wünscht sich doch jede Frau einen solch schönen Busen“, argumentiert Witz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "968beec0-a6ab-385e-a4fe-fc049fa06d10",
                        "entry_id": "b36074e1-108f-3ebf-a93d-1974ed8fe9c6",
                        "glosses": [
                            "sekundäres Geschlechtsmerkmal der Frau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4344e4f-f1ae-4c7a-8be8-37fcfa083ddf",
                                "sense_id": "968beec0-a6ab-385e-a4fe-fc049fa06d10",
                                "text": "„Taucht auf einem Foto auf Facebook eine nackte Frauenbrust auf, sperrt das Netzwerk den Beitrag sehr schnell. Hasserfüllte Kommentare, etwa gegen Flüchtlinge, lässt Facebook stehen.“"
                            },
                            {
                                "example_id": "e1e9f435-b430-43ad-9fe6-c765300cf3c9",
                                "sense_id": "968beec0-a6ab-385e-a4fe-fc049fa06d10",
                                "text": "„Die virtuelle Hetze, ja die virtuelle Rechte, die sich in den letzten Jahren formiert hat, basiert unter anderem auf der Gewissheit, dass Plattformanbieter wie Facebook Frauenbrüste sperren, aber keine rechtsextreme Propaganda.“"
                            },
                            {
                                "example_id": "e5ba2ad1-44a2-412e-8821-b7da46b31c23",
                                "sense_id": "968beec0-a6ab-385e-a4fe-fc049fa06d10",
                                "text": "„Trickdiebstahl mit nackter Frauenbrust“"
                            },
                            {
                                "example_id": "a97283cb-0ae9-4423-8965-0d79267d1e7f",
                                "sense_id": "968beec0-a6ab-385e-a4fe-fc049fa06d10",
                                "text": "„Nicht das Material, sondern das Sujet leitet die Künstlerin bei ihrer Arbeit. Es sind ins Auge springende Motive – populär und kunstgeschichtlich verbürgt zugleich: Da stechen aus dem braunen Plüschfell eines Fabelwesens muskulöser Solarplexus und nackte Frauenbrüste obszön hervor.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
