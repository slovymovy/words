                    {
                        "sense_id": "82fa8a85-1c8b-3873-8ca4-1a0dd008f575",
                        "entry_id": "48924025-b2da-34e1-9cf0-d331e50eebd8",
                        "glosses": [
                            "Qualifie un explosif qui provoque une déflagration."
                        ],
                        "tags": [
                            "Armement"
                        ],
                        "examples": [
                            {
                                "example_id": "f2572a00-64f6-4502-af91-cb1f137a5b98",
                                "sense_id": "82fa8a85-1c8b-3873-8ca4-1a0dd008f575",
                                "text": "Les poudres flash sont des mélanges pyrotechniques non seulement déflagrants, mais aussi détonants. Sur plusieurs centaines de bombes annuellement en cause, il y a environ 15% de cas où il est fait usage de poudres flash."
                            }
                        ]
                    },
                    {
                        "sense_id": "135c1ff7-deb2-398b-b719-4d3d9cf5f4ff",
                        "entry_id": "48924025-b2da-34e1-9cf0-d331e50eebd8",
                        "glosses": [
                            "Qualifie la puissance et l’intensité d’une lumière, d’une couleur."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "dc103cfa-8721-42e6-b85e-70264598b410",
                                "sense_id": "135c1ff7-deb2-398b-b719-4d3d9cf5f4ff",
                                "text": "La couleur est entre l’ocre enfumé et le vert déflagrant et puissant. Mais, à mesure que la lumière baisse, la fumée augmente et le vert s’assombrit."
                            }
                        ]
                    }
