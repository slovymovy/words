                    },
                    {
                        "translation_id": "2c9a41e3-127c-483f-8359-d4d575d0defc",
                        "source_entry_id": "66256f2a-cc59-30c9-8192-5052ce5280e3",
                        "source_sense_id": "a987c68e-b6b9-341b-bb40-1024d9d2ccec",
                        "source_sense_description": "story that is part of the oral tradition of a people",
                        "target_lang_word": "Volksmärchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Volksmärchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "976a9ea0-eeda-3e01-bf50-60b08941e531",
                                        "entry_id": "ef665fc3-fe90-3268-bebc-868600907ff9",
                                        "glosses": [
                                            "lange Zeit mündlich tradiertes Märchen, für das kein Autor bekannt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acc31ebc-631e-40ef-96a1-051c0b73493a",
                                                "sense_id": "976a9ea0-eeda-3e01-bf50-60b08941e531",
                                                "text": "„Tatsächlich muss, wer die Volksmärchen nicht nur der Gebrüder Grimm studiert, einräumen, dass die Kleriker sehr erfolgreich darin waren, bestimmte Frauen als Hexen zu denunzieren.“"
                                            },
                                            {
                                                "example_id": "b5dc4d23-8190-408a-8fa7-b7c677f66413",
                                                "sense_id": "976a9ea0-eeda-3e01-bf50-60b08941e531",
                                                "text": "„Sie erforschten und publizierten Volksmärchen wie die Sammlung der Gebrüder Grimm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0a5d4c6-9271-4378-af8d-83910ae4fb76",
                        "source_entry_id": "66256f2a-cc59-30c9-8192-5052ce5280e3",
                        "source_sense_id": "a987c68e-b6b9-341b-bb40-1024d9d2ccec",
                        "source_sense_description": "story that is part of the oral tradition of a people",
                        "target_lang_word": "Märchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Märchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ee4e92a-6362-36f3-bd74-dd43ca61faa6",
                                        "entry_id": "7821e0fe-87d3-35fb-b804-4b86870e1244",
                                        "glosses": [
                                            "auf mündlicher Überlieferung beruhende, kurze Erzählung, oft mit fantastischen und wunderbaren Begebenheiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf4f5b44-a112-42b9-a15c-b5ed5237be3a",
                                                "sense_id": "1ee4e92a-6362-36f3-bd74-dd43ca61faa6",
                                                "text": "Dornröschen war auch ein schönes Märchen."
                                            },
                                            {
                                                "example_id": "3f885c3d-d550-44d7-ab9c-f8c4211d9160",
                                                "sense_id": "1ee4e92a-6362-36f3-bd74-dd43ca61faa6",
                                                "text": "„Spüren wir nun einigen Sagen und Märchen nach, die sich rund um das Wesen und Wirken guter und böser Hexen, vor allem aber auch rund um den Brocken und seine Region im Hochharz ranken.“"
                                            },
                                            {
                                                "example_id": "49dc3930-93f2-4955-8b1c-2d9fe9337336",
                                                "sense_id": "1ee4e92a-6362-36f3-bd74-dd43ca61faa6",
                                                "text": "„Der Tag wird interessanter, wenn man Märchen erzählt.“"
                                            },
                                            {
                                                "example_id": "3b8b7ab5-c4d3-412e-a8d9-4602b2e3c693",
                                                "sense_id": "1ee4e92a-6362-36f3-bd74-dd43ca61faa6",
                                                "text": "„Wie jedes Märchen führt es in Zustände, die uns etwas von der Tiefe und der Unbegreiflichkeit des Daseins erkennen lassen.“"
                                            },
                                            {
                                                "example_id": "105806b2-04e9-40c0-bd8b-b3a1791d2341",
                                                "sense_id": "1ee4e92a-6362-36f3-bd74-dd43ca61faa6",
                                                "text": "„Deutsche Märchen sind durch jahrhundertelanges Umschreiben verweichlicht worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "70802f96-01b0-3ff9-a044-cd051124a1a9",
                                        "entry_id": "7821e0fe-87d3-35fb-b804-4b86870e1244",
                                        "glosses": [
                                            "unwahre, erfundene Geschichte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa357e25-5a26-404a-8a4c-4348de947a20",
                                                "sense_id": "70802f96-01b0-3ff9-a044-cd051124a1a9",
                                                "text": "„Erzähl doch keine Märchen!“"
                                            },
                                            {
                                                "example_id": "c11927dc-f326-4b3f-9f0d-ea8952ef1c56",
                                                "sense_id": "70802f96-01b0-3ff9-a044-cd051124a1a9",
                                                "text": "„Die Klimaleugner der Erdölindustrie erzählten das verführerischste aller Märchen, nämlich dass alles so weitergehen könne wie bisher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
