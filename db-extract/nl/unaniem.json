                                "target_senses": [
                                    {
                                        "sense_id": "3ab5738d-aa33-36aa-891a-f1d09eb321ed",
                                        "entry_id": "c06008e4-de9b-3860-af7c-47a9d65189e8",
                                        "glosses": [
                                            "mit voller Zustimmung, ohne Gegenstimmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0e2794a-270e-4f20-b3a5-95cd0f337af6",
                                                "sense_id": "3ab5738d-aa33-36aa-891a-f1d09eb321ed",
                                                "text": "„Am vergangenen Donnerstag hat der NSA-Untersuchungsausschuss des Bundestags einstimmig die Befragung Snowdens beschlossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3b2574eb-2216-3f10-b9db-cea03ae3cb92",
                                        "entry_id": "c06008e4-de9b-3860-af7c-47a9d65189e8",
                                        "glosses": [
                                            "aus nur einer Stimme bestehend"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d0420f8-e4fd-497e-9b7e-20614f3ff3f6",
                                                "sense_id": "3b2574eb-2216-3f10-b9db-cea03ae3cb92",
                                                "text": "„Dieses Ausnahme-Ensemble beeindruckt durch die Interpretation sowohl von einstimmigen und vor allem mehrstimmigen liturgischen Gesängen der orthodoxen Kirche, als auch von russischer und weißrussischer Musikliteratur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c01edda5-daee-4f89-82e9-9750eba1b22a",
                        "source_entry_id": "88a8080a-7878-344c-9d66-b940442f39ac",
                        "source_sense_id": "67a1b3a3-2173-3f6b-91d1-1abecd9c7cc8",
                        "source_sense_description": "met eenheid van stemmen",
                        "target_lang_word": "einhellig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einhellig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "75919518-6d56-39f2-b25c-731c41f9b16a",
                                        "entry_id": "8b78122d-a55b-3577-8648-f79ebc5e2669",
                                        "glosses": [
                                            "ohne Gegenstimmen"
                                        ],
                                        "tags": [
                                            "gehoben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b71ef219-54b3-4157-9cd9-8de73300f047",
                                                "sense_id": "75919518-6d56-39f2-b25c-731c41f9b16a",
                                                "text": "Wir sind der einhelligen Meinung, dass eine Krankenversicherung absolut nötig ist."
                                            },
                                            {
                                                "example_id": "9669317e-da8b-4700-ab86-3a9f78106a1a",
                                                "sense_id": "75919518-6d56-39f2-b25c-731c41f9b16a",
                                                "text": "Die Politiker verurteilten einhellig den Raketentest."
                                            },
                                            {
                                                "example_id": "506bf951-3163-47c2-a5c7-675604687858",
                                                "sense_id": "75919518-6d56-39f2-b25c-731c41f9b16a",
                                                "text": "„Wie bekommen Sie eine einhelligere Betrachtungsweise im Sicherheitsrat hin, etwa bezogen auf das Nuklearprogramm Irans?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4265919-dded-4062-9e7a-d11370cf6c60",
                        "source_entry_id": "88a8080a-7878-344c-9d66-b940442f39ac",
                        "source_sense_id": "67a1b3a3-2173-3f6b-91d1-1abecd9c7cc8",
                        "source_sense_description": "met eenheid van stemmen",
                        "target_lang_word": "unanimous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unanimous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f9a6bfa-458b-3f63-8f27-5944fa215c1d",
                                        "entry_id": "2b6cb24f-97ba-37ff-a50a-97e17bbb6553",
                                        "glosses": [
                                            "Based on unanimity, assent or agreement."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9aae442-3a2e-478e-b33e-966cd581ebde",
                                                "sense_id": "4f9a6bfa-458b-3f63-8f27-5944fa215c1d",
                                                "text": "The debate went on for hours, but in the end the decision was unanimous."
                                            },
                                            {
                                                "example_id": "98adb036-7fbb-4415-b10f-f15a689dbe44",
                                                "sense_id": "4f9a6bfa-458b-3f63-8f27-5944fa215c1d",
                                                "text": "That of their small force, some of the soldiers were superannuated, others invalid; therefore, since the course to be pursued was left discretional, their unanimous advice was, to remain where they were, and fortify themselves as strongly as possible."
                                            },
                                            {
                                                "example_id": "3ba1d0cc-11d7-4d10-92fd-a2cde14edbd0",
                                                "sense_id": "4f9a6bfa-458b-3f63-8f27-5944fa215c1d",
                                                "text": "Under court tradition, a new justice is usually assigned a relatively uncontroversial opinion that is often, although not always, unanimous."
                                            },
                                            {
                                                "example_id": "ff3dfcea-ca7f-47a6-876b-502e4e8653ec",
                                                "sense_id": "4f9a6bfa-458b-3f63-8f27-5944fa215c1d",
                                                "text": "That was followed by a Florida Supreme Court ruling that found the jury must be unanimous to impose the death penalty, and Florida lawmakers adopted the unanimity requirement soon after."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adb18559-350f-3d45-a7c9-3dcc0cd4cf87",
                                        "entry_id": "2b6cb24f-97ba-37ff-a50a-97e17bbb6553",
                                        "glosses": [
                                            "Sharing the same views or opinions, and being in harmony or accord."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "150cecf0-dc17-4e9d-afd4-f9bada069083",
                                                "sense_id": "adb18559-350f-3d45-a7c9-3dcc0cd4cf87",
                                                "text": "We were unanimous: the President had to go."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c13e395-a837-4141-8c19-b80472ccf9af",
                        "source_entry_id": "88a8080a-7878-344c-9d66-b940442f39ac",
                        "source_sense_id": "67a1b3a3-2173-3f6b-91d1-1abecd9c7cc8",
                        "source_sense_description": "met eenheid van stemmen",
                        "target_lang_word": "unanime",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unanime",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "627a1565-711d-3742-82e0-15d171d5cb51",
                                        "entry_id": "03cc9543-240c-30b9-9b57-6bae6434443e",
                                        "glosses": [
                                            "Qui réunit tous les suffrages, qui exprime un commun accord."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6d8b82c-a2ec-49a3-8a44-80c33b741d49",
                                                "sense_id": "627a1565-711d-3742-82e0-15d171d5cb51",
                                                "text": "Devant la réprobation presque unanime qui accueillit mon exposé, je me décourageai et me ralliai à l'interprétation probabiliste de Born, Bohr et Heisenberg […]."
                                            },
                                            {
                                                "example_id": "144aaf61-d3d6-4720-8870-355d4640e0a9",
                                                "sense_id": "627a1565-711d-3742-82e0-15d171d5cb51",
                                                "text": "Consentement unanime. — Résolution unanime. — Les opinions furent unanimes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2837330d-aebc-306c-8438-49170700cf2e",
                                        "entry_id": "03cc9543-240c-30b9-9b57-6bae6434443e",
                                        "glosses": [
                                            "Qualifie les personnes qui sont en complet accord, qui ont le même sentiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "313bb1a2-4560-4379-98c4-55098335d9a2",
                                                "sense_id": "2837330d-aebc-306c-8438-49170700cf2e",
                                                "text": "Nous avons été unanimes sur cette question."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
