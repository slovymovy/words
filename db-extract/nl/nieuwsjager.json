                        "examples": [
                            {
                                "example_id": "8bf86126-a6da-4cc9-896f-1249d38db866",
                                "sense_id": "2fae443c-eba0-382c-881d-c8aaf3740d0c",
                                "text": "Mist Boulevard een nieuwsjager? Ongetwijfeld weten Beau en Luuk ook zonder kookwekker wanneer de pasta beetgaar is, maar hebben zij ook de ijzeren wil om bekende Nederlanders telefonisch het mes op de keel te zetten en de naam van een nieuwe geliefde, baby of ernstige ziekte te ontfutselen?"
                            },
                            {
                                "example_id": "d564af42-f96a-4c62-8298-e50d07993a9e",
                                "sense_id": "2fae443c-eba0-382c-881d-c8aaf3740d0c",
                                "text": "Recent hield 112-fotograaf en nieuwsjager Jack Huygens (49) uit Hengelo het hoofd koel bij een brand in Hengelo. Zo dicht op het nieuws zat hij ook bij de vuurwerkramp. \"We hadden destijds de keuze al gemaakt er een einde aan te maken.\""
                            }
                        ]
