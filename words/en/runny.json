{
    "word_family": [
        "run",
        "runner",
        "running"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f61560e4-fd06-3ceb-b3e4-f9730d7fb1c4",
                    "sense_definition": "Tending to drip or discharge liquid, especially from the nose due to a cold.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to buy some tissues because I have a <w>runny</w> nose and a slight cough.",
                            "target_lang_translations": {
                                "ru": "Мне нужно купить салфетки, потому что у меня <w>насморк</w> и небольшой кашель."
                            }
                        },
                        {
                            "text": "The child had a <w>runny</w> nose after playing outside in the cold winter air for too long.",
                            "target_lang_translations": {
                                "ru": "У ребенка <w>потекли сопли</w> после слишком долгой прогулки на холодном зимнем воздухе."
                            }
                        }
                    ],
                    "synonyms": [
                        "watery",
                        "running"
                    ],
                    "common_phrases": [
                        "runny nose"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный к выделению жидкости или капанию, особенно из носа при простуде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насморк",
                                "target_lang_sense_clarification": "в контексте заложенности и выделений из носа"
                            },
                            {
                                "target_lang_word": "сопливый",
                                "target_lang_sense_clarification": "разговорное описание носа при простуде"
                            },
                            {
                                "target_lang_word": "слезящийся",
                                "target_lang_sense_clarification": "о глазах, выделяющих жидкость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd0ba442-1c15-30c8-9f0a-d0171efe4dbd",
                    "sense_definition": "Having a more liquid consistency than usual or desired; flowing easily.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "consistency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef explained that <w>runny</w> honey is much easier to drizzle over yogurt than thick honey.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар объяснил, что <w>жидким</w> медом гораздо проще полить йогурт, чем густым."
                            }
                        },
                        {
                            "text": "If the cake batter is too <w>runny</w>, you should add a little more flour to thicken it.",
                            "target_lang_translations": {
                                "ru": "Если тесто для торта слишком <w>жидкое</w>, следует добавить немного муки, чтобы оно загустело."
                            }
                        }
                    ],
                    "synonyms": [
                        "liquid",
                        "fluid",
                        "thin",
                        "watery"
                    ],
                    "antonyms": [
                        "viscous"
                    ],
                    "common_phrases": [
                        "runny honey",
                        "runny egg yolk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий более жидкую консистенцию, чем обычно или требуется; легко текущий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жидкий",
                                "target_lang_sense_clarification": "о консистенции продуктов или веществ"
                            },
                            {
                                "target_lang_word": "текучий",
                                "target_lang_sense_clarification": "способный легко течь"
                            },
                            {
                                "target_lang_word": "негустой",
                                "target_lang_sense_clarification": "о недостаточно плотной массе"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}