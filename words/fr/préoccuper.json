                    ]
                },
                {
                    "sense_id": "f5a0be71-0782-344a-a42f-f6c31e24a66c",
                    "sense_definition": "Se soucier de quelqu'un ou de quelque chose, y prêter une attention bienveillante ou vigilante.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "souci",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chacun devrait se <w>préoccuper</w> des autres afin de maintenir une bonne ambiance dans l'équipe."
                        },
                        {
                            "text": "Mes parents se <w>préoccupent</w> toujours beaucoup de ma santé et de mes résultats scolaires."
                        }
                    ],
                    "synonyms": [
                        "se soucier",
                        "s'inquiéter"
                    ],
                    "antonyms": [
                        "se désintéresser",
                        "ignorer"
                    ],
                    "common_phrases": [
                        "se préoccuper des autres"
                    ]
                },
                {
                    "sense_id": "1de91ff8-5432-3789-bd25-4f2940d3d41d",
                    "sense_definition": "Occuper fortement l'esprit de quelqu'un, retenir toute son attention de façon continue.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "absorption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette énigme mathématique complexe a continué de <w>préoccuper</w> les esprits pendant plusieurs décennies."
                        },
                        {
                            "text": "Une seule question semble <w>préoccuper</w> son esprit depuis le début du projet."
                        }
                    ],
                    "synonyms": [
                        "accaparer",
                        "absorber",
                        "obséder"
                    ],
                    "antonyms": [
                        "distraire"
                    ],
                    "common_phrases": [
                        "préoccuper les esprits"
                    ]
                }
            ]
        }
    ]
