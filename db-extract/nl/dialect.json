                ],
                "senses": [
                    {
                        "sense_id": "d7036eba-4095-3e77-850e-8b119a2642d7",
                        "entry_id": "8d9660aa-799a-3aaa-8361-98bdc9a6f2fd",
                        "glosses": [
                            "een taalvariëteit met onderscheidende grammaticale, fonologische en andere kenmerken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "738e1df9-b4d5-4bb3-b866-f19d7db98e88",
                                "sense_id": "d7036eba-4095-3e77-850e-8b119a2642d7",
                                "text": "Ook het Surinaams-Nederlands is een dialect van het Nederlands."
                            }
                        ]
                    },
                    {
                        "sense_id": "27a91e9a-4bbf-329e-a955-f251550b24e1",
                        "entry_id": "8d9660aa-799a-3aaa-8361-98bdc9a6f2fd",
                        "glosses": [
                            "een niet-standaard taalvariëteit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24043c4c-647b-431a-875f-8b077c79711c",
                                "sense_id": "27a91e9a-4bbf-329e-a955-f251550b24e1",
                                "text": "Het Nederlands kent verschillende dialecten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "935e6f40-af50-4059-96d4-963d79885368",
                        "source_entry_id": "8d9660aa-799a-3aaa-8361-98bdc9a6f2fd",
                        "source_sense_id": "d7036eba-4095-3e77-850e-8b119a2642d7",
                        "source_sense_description": "een variant van een taal met kenmerkende grammaticale, fonologische en andere kenmerken",
                        "target_lang_word": "Mundart",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mundart",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "883d6de4-34e5-3a01-be7d-16ea00bf527d",
                                        "entry_id": "0b700220-1cc1-3409-80e6-1303b33e7e79",
                                        "glosses": [
                                            "deutsche Entsprechung für dialectus beziehungsweise Dialekt; regional begrenzte Varietät einer Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d9a2e3f-990e-426d-beb4-33ee2ad74e99",
                                                "sense_id": "883d6de4-34e5-3a01-be7d-16ea00bf527d",
                                                "text": "Rheinländer, Bayern und Sachsen sprachen alle in ihrer regionalen Mundart."
                                            },
                                            {
                                                "example_id": "0c6693af-294c-414b-adf5-1cba1e72e6e2",
                                                "sense_id": "883d6de4-34e5-3a01-be7d-16ea00bf527d",
                                                "text": "„Zum Glück wird in Deutschland sehr viel Mundart und mundartlich gefärbtes Hochdeutsch gesprochen.“"
                                            },
                                            {
                                                "example_id": "9ade9be7-2dd9-4bbc-a1a6-6955ca1a72da",
                                                "sense_id": "883d6de4-34e5-3a01-be7d-16ea00bf527d",
                                                "text": "„Die positive Betonung des Alters der Dialekte ist, schlagwortartig gesagt, eine ›romantische‹ Erkenntnis, die sich gegen eine frühere Auffassung wandte, welche in den Mundarten mehr oder weniger verderbte Hochsprache sah.“"
                                            },
                                            {
                                                "example_id": "82e1ba71-6ca7-4a87-bee3-8d390dcdad88",
                                                "sense_id": "883d6de4-34e5-3a01-be7d-16ea00bf527d",
                                                "text": "„Es ist schon erstaunlich, wie viele jiddische Einsprengsel sich in allen deutschen Mundarten finden lassen.“"
                                            },
                                            {
                                                "example_id": "2ec9c709-ff50-4859-a618-3693f3312dfc",
                                                "sense_id": "883d6de4-34e5-3a01-be7d-16ea00bf527d",
                                                "text": "„Die Namen der Mundarten sind hergeleitet von alten Landesnamen und von Volksstämmen, die in diesen Regionen leben oder lebten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eeed2fb7-a504-45cf-a31c-92e59eba0f4d",
                        "source_entry_id": "8d9660aa-799a-3aaa-8361-98bdc9a6f2fd",
                        "source_sense_id": "d7036eba-4095-3e77-850e-8b119a2642d7",
                        "source_sense_description": "een variant van een taal met kenmerkende grammaticale, fonologische en andere kenmerken",
                        "target_lang_word": "dialect",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dialect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3571cb0f-7c01-3d3b-98c1-bac7744fe1b9",
                                        "entry_id": "6e4b24eb-93a2-3521-990b-d2b8ff9056eb",
                                        "glosses": [
                                            "A lect (often a regional or minority language) as part of a group or family of languages, especially if they are viewed as a single language, or if contrasted with a standardized idiom that is considered the 'true' form of the language (for example, Bavarian as contrasted with Standard German)."
                                        ],
                                        "tags": [
                                            "strict-sense"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80aa882e-797a-4994-8fca-2f8b9da20e32",
                                                "sense_id": "3571cb0f-7c01-3d3b-98c1-bac7744fe1b9",
                                                "text": "The question could be put: 'Is there anything inherent in a dialect which gives it a negative stigma or is it that the status of the majority of the speakers is transferred to the dialect?' — something that occurs in many regions in different countries."
                                            },
                                            {
                                                "example_id": "ad9c04d3-8b93-45f3-8d29-aa0a754b2fe1",
                                                "sense_id": "3571cb0f-7c01-3d3b-98c1-bac7744fe1b9",
                                                "text": "Comparative wordlists of two dialects of Yoruba with Igala."
                                            },
                                            {
                                                "example_id": "a3a5a190-1cc2-40f8-9624-9f8665d06e42",
                                                "sense_id": "3571cb0f-7c01-3d3b-98c1-bac7744fe1b9",
                                                "text": "Bloomfield, for example, noted that “local dialects are spoken by the peasants and the poorest people of the towns” (1933: 50) though he also thought that the lower middle class spoke 'sub-standard' speech."
                                            },
                                            {
                                                "example_id": "1c740d05-57eb-48e6-9908-f5fc7b9205d7",
                                                "sense_id": "3571cb0f-7c01-3d3b-98c1-bac7744fe1b9",
                                                "text": "Among common errors still persisting in the minds of educated people, one error which dies very hard is the theory that a dialect is an arbitrary distortion of the mother tongue, a wilful mispronunciation of the sounds, and disregard of the syntax of a standard language."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a79c508-341c-318b-9c4a-bd5e1c5e6039",
                                        "entry_id": "6e4b24eb-93a2-3521-990b-d2b8ff9056eb",
                                        "glosses": [
                                            "A variety of a language that is characteristic of a particular area, community, or social group, differing from other varieties of the same language in relatively minor ways as regards grammar, phonology, and lexicon."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d70bd00-76c9-4588-9dc9-9df541e6f0ea",
                                                "sense_id": "6a79c508-341c-318b-9c4a-bd5e1c5e6039",
                                                "text": "And in addition, many dialects of English make no morphological distinction between Adjectives and Adverbs, and thus use Adjectives in contexts where the standard language requires -ly Adverbs"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07127b96-8d81-3f44-9087-1ee399069a0c",
                                        "entry_id": "6e4b24eb-93a2-3521-990b-d2b8ff9056eb",
                                        "glosses": [
                                            "Language that is perceived as substandard or wrong."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d445be1-da8d-459a-853b-2fb2cf6e4289",
                                                "sense_id": "07127b96-8d81-3f44-9087-1ee399069a0c",
                                                "text": "Well, those children don't speak dialect, not in this school. Maybe in the public schools, but not here."
                                            },
                                            {
                                                "example_id": "0c069210-0a6a-4c74-b4f2-32cb3958e223",
                                                "sense_id": "07127b96-8d81-3f44-9087-1ee399069a0c",
                                                "text": "[…] on the second day, Miss Anderson gave the school a lecture on why it was wrong to speak dialect. She had ended by saying \"Respectable people don't speak dialect.\""
                                            },
                                            {
                                                "example_id": "f1fa3ed7-2075-4c94-b6cf-a4abb58d3dd5",
                                                "sense_id": "07127b96-8d81-3f44-9087-1ee399069a0c",
                                                "text": "Many even deny it and say something like this: \"No, we don't speak a dialect around here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60dceac4-e455-3b45-9db8-67213e90b561",
                                        "entry_id": "6e4b24eb-93a2-3521-990b-d2b8ff9056eb",
                                        "glosses": [
                                            "A language existing only in an oral or non-standardized form, especially a language spoken in a developing country or an isolated region."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "offensive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "249caeea-7d41-3d90-8063-dae7d818566f",
                                        "entry_id": "6e4b24eb-93a2-3521-990b-d2b8ff9056eb",
                                        "glosses": [
                                            "A variant of a non-standardized programming language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e309a98-04a5-4688-bc7d-37e90364b6d1",
                                                "sense_id": "249caeea-7d41-3d90-8063-dae7d818566f",
                                                "text": "Home computers in the 1980s had many incompatible dialects of BASIC."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71fec259-6bc0-3e70-a0da-1dbd0202d65a",
                                        "entry_id": "6e4b24eb-93a2-3521-990b-d2b8ff9056eb",
                                        "glosses": [
                                            "A variant form of the vocalizations of a bird species restricted to a certain area or population."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcfd9971-5b7c-4729-aefe-f6aee8a55089",
                                                "sense_id": "71fec259-6bc0-3e70-a0da-1dbd0202d65a",
                                                "text": "A curious question, which has as yet attracted but little attention, is whether the notes of the same species of Bird are in all countries alike. From my own observation I am inclined to think that they are not, and that there exist \"dialects,\" so to speak, of the song."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd08ae6c-95f3-4506-8df9-3f3f44797bd5",
                        "source_entry_id": "8d9660aa-799a-3aaa-8361-98bdc9a6f2fd",
                        "source_sense_id": "d7036eba-4095-3e77-850e-8b119a2642d7",
                        "source_sense_description": "een variant van een taal met kenmerkende grammaticale, fonologische en andere kenmerken",
                        "target_lang_word": "dialecte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dialecte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c53c6680-9620-3a28-880e-c93164e9228b",
                                        "entry_id": "8ac711f1-cb99-35cf-b74e-9e91020d7849",
                                        "glosses": [
                                            "Proche parent d’une langue dominante ou officielle mais qui s’en distingue et qui, avec cette langue dominante, étaient autrefois variétés régionales l’une de l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d648afcb-9453-45b1-8817-0641c15c4af7",
                                                "sense_id": "c53c6680-9620-3a28-880e-c93164e9228b",
                                                "text": "La seconde question qui se présente est celle-ci : en quoi le dialecte morvandeau se distingue-t-il des autres dialectes ? À dire vrai, il ne se sépare guère du dialecte bourguignon dont il peut être considéré comme une sous-division."
                                            },
                                            {
                                                "example_id": "c7674b89-85dc-4e36-a16c-02bb66dacbb4",
                                                "sense_id": "c53c6680-9620-3a28-880e-c93164e9228b",
                                                "text": "Ce qui fait qu’une langue se dissout en dialectes mutuellement incompréhensibles, ce n’est ni la distance ni le passage du temps, c’est l’absence de communications. Le latin ne s’est transformé en langues-filles que lorsque l’administration romaine s’est effondrée et que les communautés qui parlaient latin se sont retrouvées isolées."
                                            },
                                            {
                                                "example_id": "f2c45db4-463c-4c46-9a4b-08be1db694f4",
                                                "sense_id": "c53c6680-9620-3a28-880e-c93164e9228b",
                                                "text": "Le normand, le bourguignon et le picard ont eu chacun leur littérature au Moyen Âge. Ils sont tantôt des dialectes du français, tantôt des langues d’oïl."
                                            },
                                            {
                                                "example_id": "db2d5423-28e3-4eb3-874c-5cb50cda31ff",
                                                "sense_id": "c53c6680-9620-3a28-880e-c93164e9228b",
                                                "text": "Mais la différence entre dialecte et langue est une différence que même les linguistes spécialistes du domaine peinent à définir. C'est qu'il s'agit avant tout d'une différence sociale et politique plutôt que d'une différence linguistique. La phrase attribuée à Max Weinreich en 1945, sociolinguiste spécialiste du yiddish, « une langue est un dialecte avec une armée et une marine », si elle se voulait humoristique, n'est quand même pas très loin de la réalité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87705a08-3fd7-324f-b44e-f9443b787c5d",
                                        "entry_id": "8ac711f1-cb99-35cf-b74e-9e91020d7849",
                                        "glosses": [
                                            "Variété particulière d’une langue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a1eef98-d55d-487e-8ddd-4b7409b5f2d7",
                                                "sense_id": "87705a08-3fd7-324f-b44e-f9443b787c5d",
                                                "text": "Une étude plus large et plus scientifique des dialectes locaux établira que, par son origine et par ses caractères essentiels, le slovaque appartient au groupe yougoslave."
                                            },
                                            {
                                                "example_id": "7042fe77-708f-498a-84ca-3d2d16f97488",
                                                "sense_id": "87705a08-3fd7-324f-b44e-f9443b787c5d",
                                                "text": "Tous les pays faisant partie de l’arabophonie utilisent l’alphabet arabe, mais les habitants de ces pays parlent tous un dialecte différent."
                                            },
                                            {
                                                "example_id": "c850e7f0-b0c5-4f8f-b034-8e555b4f8540",
                                                "sense_id": "87705a08-3fd7-324f-b44e-f9443b787c5d",
                                                "text": "« Au lieu de votre joli patois dont on comprend toujours quelque chose, c’est une langue que le diable a inventée que l’on parle là-bas et qui n’a pas moins de quatre dialectes très différents. »"
                                            },
                                            {
                                                "example_id": "74ace338-ff20-408f-980b-46801dfcaa51",
                                                "sense_id": "87705a08-3fd7-324f-b44e-f9443b787c5d",
                                                "text": "Le québécois, le belge et le romand sont des français régionaux, c’est-à-dire des dialectes du français."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05be029c-0ab6-46de-a7a2-017c645c8daf",
