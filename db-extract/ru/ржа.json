                        ],
                        "form": "*ржа́х"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b47f5ae-2ff1-3668-abc0-e6ff82f8c64b",
                        "entry_id": "9ea1b4d8-a90c-38fa-9eb8-c9f80fc16311",
                        "glosses": [
                            "устар., рег. то же, что ржавчина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "505990b5-4fcb-4606-adb4-c442129b07a4",
                                "sense_id": "6b47f5ae-2ff1-3668-abc0-e6ff82f8c64b",
                                "text": "То же было и с крышкою, у которой ржа переела железные петли."
                            },
                            {
                                "example_id": "9c268d87-da83-4b53-835a-06ea4cf33c2c",
                                "sense_id": "6b47f5ae-2ff1-3668-abc0-e6ff82f8c64b",
                                "text": "Насквозь проеденный ржой, чёрный, с оранжевыми крапинами остов небольшого судёнышка, ощерившегося на белый свет своим разорванным рылом: видимо, это всё, что осталось от бота «Колгуевец»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a331207a-d1ea-4561-8dd8-6f6b6edb9ed2",
                        "source_entry_id": "9ea1b4d8-a90c-38fa-9eb8-c9f80fc16311",
                        "source_sense_id": "6b47f5ae-2ff1-3668-abc0-e6ff82f8c64b",
                        "target_lang_word": "rust",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rust",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8993ed7e-dc86-30cb-88cf-80f43840f415",
                                        "entry_id": "be511c29-0e71-31b8-a015-6dd933c0fb8b",
                                        "glosses": [
                                            "The deteriorated state of iron or steel as a result of moisture and oxidation; it consists mostly of iron(III) oxide (ferric oxide) and iron(II) oxide (ferrous oxide)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "582ae96d-e288-4a78-b6d9-4fde3b4324b2",
                                                "sense_id": "8993ed7e-dc86-30cb-88cf-80f43840f415",
                                                "text": "The rust on my bicycle chain made cycling to work very dangerous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f401f0fe-aa62-3ef3-b90f-975de100a9b7",
                                        "entry_id": "be511c29-0e71-31b8-a015-6dd933c0fb8b",
                                        "glosses": [
                                            "A similar substance based on another metal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0af405c-eb79-44ae-983c-c7d61a29a92a",
                                                "sense_id": "f401f0fe-aa62-3ef3-b90f-975de100a9b7",
                                                "text": "copper rust"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "241ed7b0-c8c6-3124-bac9-570f540471b9",
                                        "entry_id": "be511c29-0e71-31b8-a015-6dd933c0fb8b",
                                        "glosses": [
                                            "A reddish-brown color."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89ed042c-0a09-3775-b07c-4271c94e7503",
                                        "entry_id": "be511c29-0e71-31b8-a015-6dd933c0fb8b",
                                        "glosses": [
                                            "A disease of plants caused by a reddish-brown fungus."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75adc952-0b4d-342d-9e9e-2efe1c9c2bff",
                                        "entry_id": "be511c29-0e71-31b8-a015-6dd933c0fb8b",
                                        "glosses": [
                                            "Damage caused to stamps and album pages by a fungal infection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rust",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7c15e3e-968e-3576-a346-084ca3e205fb",
                                        "entry_id": "f1507e10-e532-32ba-90a8-7b01923912bb",
                                        "glosses": [
                                            "To oxidize, especially of iron or steel."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a0fe9b8-5083-486f-a3c7-4feb82141812",
                                                "sense_id": "f7c15e3e-968e-3576-a346-084ca3e205fb",
                                                "text": "The patio furniture had rusted in the wind-driven spray."
                                            },
                                            {
                                                "example_id": "aed6494b-bb02-43ec-a1a2-ff293bd2d843",
                                                "sense_id": "f7c15e3e-968e-3576-a346-084ca3e205fb",
                                                "text": "Your gold and silver have rusted, and their rust will be evidence against you and will eat your flesh like fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e36d947-071b-36c6-9dc2-7c6629b86135",
                                        "entry_id": "f1507e10-e532-32ba-90a8-7b01923912bb",
                                        "glosses": [
                                            "To cause to oxidize."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "baaf4e1e-d25f-4c6c-b6e4-2115d73d0e70",
                                                "sense_id": "6e36d947-071b-36c6-9dc2-7c6629b86135",
                                                "text": "The wind-driven spray had thoroughly rusted the patio furniture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e3cb772-9a03-3e6c-8d43-c6d68824c682",
                                        "entry_id": "f1507e10-e532-32ba-90a8-7b01923912bb",
                                        "glosses": [
                                            "To be affected with the parasitic fungus called rust."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35145242-d740-4746-b1b9-b9b4d2993cd3",
                                                "sense_id": "9e3cb772-9a03-3e6c-8d43-c6d68824c682",
                                                "text": "I am sorry to say that, contrary to the majority, I have to report that the forage rusted rather badly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14d994f0-4fa3-38a1-9566-ab4b3df423cb",
                                        "entry_id": "f1507e10-e532-32ba-90a8-7b01923912bb",
                                        "glosses": [
                                            "To (cause to) degenerate in idleness; to make or become dull or impaired by inaction."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3efbd986-c4d1-45c6-836c-7f611d004538",
                                                "sense_id": "14d994f0-4fa3-38a1-9566-ab4b3df423cb",
                                                "text": "Must I rust in Egypt? never more / Appear in arms, and be the chief of Greece?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "054b1d23-094e-3570-8945-534206a34561",
                                        "entry_id": "f1507e10-e532-32ba-90a8-7b01923912bb",
                                        "glosses": [
                                            "Of a black cat or its fur, to turn rust-coloured following long periods of exposure to sunlight."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22e0f978-fc31-448b-9070-1b04dff35b1f",
                                                "sense_id": "054b1d23-094e-3570-8945-534206a34561",
                                                "text": "It's very common for black cats to rust during the summer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
