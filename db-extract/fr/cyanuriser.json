                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c61aa21-dc62-409b-8808-43e9502c8cd3",
                                "sense_id": "85641464-d32b-3676-bdda-200db0da37df",
                                "text": "Il écorche encore mon nom, je vais songer à cyanuriser son repas un jour, il fait exprès."
                            },
                            {
                                "example_id": "1959699a-a774-4859-a99b-db6297ed99db",
                                "sense_id": "85641464-d32b-3676-bdda-200db0da37df",
                                "text": "Rappel : interdit de survivre à cette attaque là et de se déhydrater, cyanuriser, faire pendre ou bouffer au J10, même à 0h46."
                            },
                            {
                                "example_id": "253dbab7-e713-4756-b06e-bc8a8911d8b5",
                                "sense_id": "85641464-d32b-3676-bdda-200db0da37df",
                                "text": "Au début, ses parents adoptifs n'en ont pas voulu, ils avaient beau essayer de le noyer, le cyanuriser, l'enclumer, le fouetter, rien ne le faisait partir et il revenait toujours à la charge plus chiant que jamais..."
                            }
                        ]
