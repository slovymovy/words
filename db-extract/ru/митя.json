                "senses": [
                    {
                        "sense_id": "1ec15f53-58e5-3691-af0e-fedc7c0d39ef",
                        "entry_id": "3a7610cc-cf91-308a-beb4-ebb0a321b0da",
                        "glosses": [
                            "мужское имя; гипокор. к Дмитрий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c66d425a-5a71-4a96-b4c4-702eb92a0bce",
                                "sense_id": "1ec15f53-58e5-3691-af0e-fedc7c0d39ef",
                                "text": "Митя читал, теребя на макушке редкие пряди."
                            },
                            {
                                "example_id": "194ed1c4-58e0-42ab-8879-0b8995c5f382",
                                "sense_id": "1ec15f53-58e5-3691-af0e-fedc7c0d39ef",
                                "text": "Те добродетельные мысли, которые мы в беседах перебирали с обожаемым другом моим Дмитрием, чудесным Митей, как я сам с собою шепотом иногда называл его, еще нравились только моему уму, а не чувству."
                            }
                        ]
                    }
                ],
