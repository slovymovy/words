                "senses": [
                    {
                        "sense_id": "a810caa5-5451-3cc0-b798-6b5ca6b04c1f",
                        "entry_id": "d7a8ff28-90c9-3ef6-9781-12966a2dc5c2",
                        "glosses": [
                            "Qui se rapporte à Ossian, aux poésies attribuées à Ossian."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5edb986-0a71-42b3-9d25-f72948ab8933",
                                "sense_id": "a810caa5-5451-3cc0-b798-6b5ca6b04c1f",
                                "text": "Ne soyons donc pas surpris quʼen 1835 lʼauteur de Servitude et Grandeur Militaires se soit rappelé le paysage ossianique."
                            },
                            {
                                "example_id": "2e0ac656-b872-4809-b163-bf0fbd70c5b8",
                                "sense_id": "a810caa5-5451-3cc0-b798-6b5ca6b04c1f",
                                "text": "Les chants ossianiques relatent sur un ton épique alterné de lyrisme élégiaque des histoires de guerre et d'amour, des scènes d'enlèvements, de chasse et de naufrages, le tout marinant dans une atmosphère boréale très embrumée. Ossian a entortillé un grand nombre d'écrivains, de peintres et de musiciens de la génération préromantique."
                            },
                            {
                                "example_id": "20ad2d4c-9062-4cb4-a3b4-72aac53fc1ae",
                                "sense_id": "a810caa5-5451-3cc0-b798-6b5ca6b04c1f",
                                "text": "Enfin, dans les poésies ossianiques, bien modifiées, il est vrai, par l’esprit moderne, les femmes partagent l’existence nuageuse des héros."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e32a914-8ff2-4935-9d2d-a61c6b474f0b",
                        "source_entry_id": "d7a8ff28-90c9-3ef6-9781-12966a2dc5c2",
                        "source_sense_id": "a810caa5-5451-3cc0-b798-6b5ca6b04c1f",
