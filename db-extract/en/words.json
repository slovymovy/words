            },
            {
                "entry_id": "c8906db3-08af-3916-9526-741c62c768d1",
                "word": "words",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "18e96561-9aff-3cbc-b233-17acc1fa2061",
                        "entry_id": "c8906db3-08af-3916-9526-741c62c768d1",
                        "glosses": [
                            "Angry debate or conversation; argument."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "05c94705-b19a-45bb-9a38-a586fa10baf3",
                                "sense_id": "18e96561-9aff-3cbc-b233-17acc1fa2061",
                                "text": "After she found out the truth, she had words with him, to tell him how she felt."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b231ae2-dcfc-3c9a-bc00-8e9c9434d696",
                        "entry_id": "c8906db3-08af-3916-9526-741c62c768d1",
                        "glosses": [
                            "The lines in a script for a performance."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "29dd9dd1-6e22-461a-80cf-98a351a879a3",
                                "sense_id": "4b231ae2-dcfc-3c9a-bc00-8e9c9434d696",
                                "text": "You better get your words memorised before rehearsal next Saturday."
                            }
                        ]
                    },
                    {
                        "sense_id": "683ea1ce-3354-375f-b6d9-1bb1826577fb",
                        "entry_id": "c8906db3-08af-3916-9526-741c62c768d1",
                        "glosses": [
                            "Lyrics."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "9b610e3f-9882-4a64-9eae-ecce91fd32cd",
                                "sense_id": "683ea1ce-3354-375f-b6d9-1bb1826577fb",
                                "text": "The composer set the words to music."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39e14b8d-a184-4277-ac7c-bfb9e47795df",
                        "source_entry_id": "c8906db3-08af-3916-9526-741c62c768d1",
                        "source_sense_description": "angry debate or conversation",
                        "target_lang_word": "Streit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Streit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "77ae75f9-9f55-389c-a6d6-988efc8ab0d1",
                                        "entry_id": "0c892b97-7b19-36f1-b1a7-78b2b8b23b4b",
                                        "glosses": [
                                            "heftig ausgetragene Kollision von Interessen oder Meinungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7498b0b-d1e3-4ae3-b6f7-f637bf2f357f",
                                                "sense_id": "77ae75f9-9f55-389c-a6d6-988efc8ab0d1",
                                                "text": "Der Streit um die politische Ausrichtung und das qualitative Niveau des Spiegels geht weiter. (Internetbeleg)"
                                            },
                                            {
                                                "example_id": "724f7c77-bf39-4c70-974e-b9ec7f300857",
                                                "sense_id": "77ae75f9-9f55-389c-a6d6-988efc8ab0d1",
                                                "text": "„Als wir gehen, gibt es Streit, der zweite an diesem Abend.“"
                                            },
                                            {
                                                "example_id": "74433d4d-a708-4b36-afb1-c5da44e98ec9",
                                                "sense_id": "77ae75f9-9f55-389c-a6d6-988efc8ab0d1",
                                                "text": "„Jacques stand in der Tür und hatte den Streit ebenso durch das Fenster gehört.“"
                                            },
                                            {
                                                "example_id": "a5836f49-0410-421f-9970-56059ac4037a",
                                                "sense_id": "77ae75f9-9f55-389c-a6d6-988efc8ab0d1",
                                                "text": "„Eine Frau hat bei einem Streit immer das letzte Wort.“"
                                            },
                                            {
                                                "example_id": "be0e455e-a17d-40af-a246-c7b42a8964c1",
                                                "sense_id": "77ae75f9-9f55-389c-a6d6-988efc8ab0d1",
                                                "text": "„Ein scharfer, schneller Streit entstand plötzlich vor dem Café .“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0912b2fb-ace0-4f50-bbe5-6d113e5fd4dc",
                        "source_entry_id": "c8906db3-08af-3916-9526-741c62c768d1",
                        "source_sense_description": "angry debate or conversation",
                        "target_lang_word": "ссора",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ссора",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "666b989c-2f55-3384-84f6-4bd96a6d00cc",
                                        "entry_id": "3cce2349-1194-336d-bf1d-3592de3d45f1",
                                        "glosses": [
                                            "резкое ухудшение взаимоотношений между людьми, состояние вражды"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffb96775-5927-4ba7-bc28-e5137be6713c",
                                                "sense_id": "666b989c-2f55-3384-84f6-4bd96a6d00cc",
                                                "text": "Ссора длилась шесть лет, и сердечные отношения никогда не были восстановлены."
                                            },
                                            {
                                                "example_id": "2d02ae3f-f47a-4706-9272-6586a6ae9a5a",
                                                "sense_id": "666b989c-2f55-3384-84f6-4bd96a6d00cc",
                                                "text": "Она особенно любила щипаться и раздавать колотушки детям сестры своей, фискалить на них за утащенный сахар и хлеб, отчего между ней и старшей сестрой её существовала бесконечная и неутолимая ссора."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aee7f5a9-266e-3c89-9a70-223f03e2b379",
                                        "entry_id": "3cce2349-1194-336d-bf1d-3592de3d45f1",
                                        "glosses": [
                                            "жёсткий, нелицеприятный разговор на повышенных тонах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e0a9d27-f42e-4c17-ba20-0592d7271227",
                                                "sense_id": "aee7f5a9-266e-3c89-9a70-223f03e2b379",
                                                "text": "Некоторое время спустя ко мне в комнату донеслось гулкое дверное бухание и другие звуки, исходившие из каких-то содрогавшихся недр, где у соперниц происходила яростная ссора."
                                            },
                                            {
                                                "example_id": "945cae3a-35bb-4e36-8e7a-1658b45416c7",
                                                "sense_id": "aee7f5a9-266e-3c89-9a70-223f03e2b379",
                                                "text": "Супруги скоро уехали; в дороге между ними ссора продолжалась до такой степени сильно и такими голосами, что вёзшие их ямщики и стоявший на запятках почтальон по временам ожидали, что господа начнут драться, и всё больше барыня, которая так и наскакивала на барина."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c322b2ba-3ae8-4f00-b02f-ace28602c28e",
                        "source_entry_id": "c8906db3-08af-3916-9526-741c62c768d1",
                        "source_sense_description": "lines in a script for a performance",
                        "target_lang_word": "слова",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "слова",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "54c5f877-7ca5-3f90-b49b-77990a26e930",
                                        "entry_id": "ffc7945f-bd56-3e09-a93e-cbe4029c8592",
                                        "glosses": [
                                            "то, что сказано, написано; чьи-либо высказывания"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc642c96-edef-41d7-a02a-2c5e1feb9d59",
                                                "sense_id": "54c5f877-7ca5-3f90-b49b-77990a26e930",
                                                "text": "В ту минуту, кажется, мои слова не произвели на неё никакого впечатления."
                                            },
                                            {
                                                "example_id": "39608eae-b485-4d0d-b5a4-679b1efb3a96",
                                                "sense_id": "54c5f877-7ca5-3f90-b49b-77990a26e930",
                                                "text": "Кроме того, он всегда отвечает за свои слова"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a9669be-9709-3650-ba31-4e80b9e628de",
                                        "entry_id": "ffc7945f-bd56-3e09-a93e-cbe4029c8592",
                                        "glosses": [
                                            "текст вокального произведения, молитвы и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba106221-a60f-48bf-8dc5-280151048735",
                                                "sense_id": "3a9669be-9709-3650-ba31-4e80b9e628de",
                                                "text": "У большинства слова песни получаются, как правило, гораздо слабее собственно стихов, и мы лишь мечтаем, чтобы наши просто стихотворения были положены на музыку."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d25de73c-48b8-3e5b-9cf3-0463879a842c",
                                        "entry_id": "ffc7945f-bd56-3e09-a93e-cbe4029c8592",
                                        "glosses": [
                                            "разг., неодобр. пустые разговоры, болтовня"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d3acb4b-6f17-4c81-8ca6-7bd23c3d7c79",
                                                "sense_id": "d25de73c-48b8-3e5b-9cf3-0463879a842c",
                                                "text": "В дальнейшем угрозы в отношении Лизы много раз повторялись, и мы не могли думать, что это только пустые слова."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "слова",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e931a2f5-f0d9-3868-8627-31587c2c73dc",
                                        "entry_id": "c8ed9669-1056-3fa1-a3f8-e2b2c5d4929d",
