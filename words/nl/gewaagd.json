                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "risky",
                                "target_lang_sense_clarification": "involving danger or uncertainty"
                            },
                            {
                                "target_lang_word": "daring",
                                "target_lang_sense_clarification": "showing courage and willingness to take risks"
                            },
                            {
                                "target_lang_word": "bold",
                                "target_lang_sense_clarification": "showing a fearless spirit"
                            },
                            {
                                "target_lang_word": "hazardous",
                                "target_lang_sense_clarification": "potentially dangerous"
                            }
                        ]
                    }
                }
            ]
        },
        {
