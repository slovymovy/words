                "senses": [
                    {
                        "sense_id": "19e4c9d8-6265-33d0-add8-466f355046a8",
                        "entry_id": "d0d58fbd-3538-3db4-8cd7-4d673ce5654a",
                        "glosses": [
                            "Fläche eines Landes oder Bundeslandes; geographische Ausdehnung des Territoriums des Landes/Bundeslandes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62c16903-b0f4-4de3-b7ff-28c39993b331",
                                "sense_id": "19e4c9d8-6265-33d0-add8-466f355046a8",
                                "text": "„Monentan stehen in der Bundesrepublik rund 30.000 Windräder, die etwa 0,5 Prozent der Landesfläche belegen. Gebraucht werden aber 2 Pozent der Flächen, also das Vierfache.“"
                            },
                            {
                                "example_id": "d2e07ee3-6248-4891-96c7-3b52a1e046f6",
                                "sense_id": "19e4c9d8-6265-33d0-add8-466f355046a8",
                                "text": "„Sachsen […] hat nur 0,2 Prozent der Landesfläche für Windparks freigegeben, und in Bayern sind sogar nur 0,1 Prozent.“"
                            },
                            {
                                "example_id": "fd4c120f-f1e8-4e0f-9006-682494b026c0",
                                "sense_id": "19e4c9d8-6265-33d0-add8-466f355046a8",
                                "text": "„Weiterhin sind 2,3 Prozent der Landesfläche durch Landminen belastet und in der Folge unzugänglich.“"
                            },
                            {
                                "example_id": "f7f13d06-7daa-4d71-96c5-bca5e056caa8",
                                "sense_id": "19e4c9d8-6265-33d0-add8-466f355046a8",
                                "text": "[Irland:] „2002 galten bereits zehn Prozent der Landesfläche als bewaldet und wurden forstwirtschaftlich genutzt. Die irische Regierung beabsichtigt, den Anteil bis 2030 auf 17 Prozent zu erhöhen.“"
                            },
                            {
                                "example_id": "b14e8a7c-8d71-4f70-8f03-a42c70239654",
                                "sense_id": "19e4c9d8-6265-33d0-add8-466f355046a8",
                                "text": "„Armenien ist ein sehr ausgeprägtes Gebirgsland – denn 90 % der Landesfläche liegen mehr als 1.000 Meter über dem Meeresspiegel, die mittlere Höhe beträgt sogar 1.800 Meter.“"
                            },
                            {
                                "example_id": "10f85bbf-9b6b-450e-89c0-69e01268cb1c",
                                "sense_id": "19e4c9d8-6265-33d0-add8-466f355046a8",
                                "text": "„Aus einem Drittel der Landesfläche Tschechiens verschwanden die Deutschen – und so bekam das Land ein homogen, tschechisches Gesicht, als hätte es nie Deutsche hier gegeben. Das geschah vor 70 Jahren.“"
                            },
                            {
                                "example_id": "55154940-d892-4485-8e32-4e4f9852d788",
                                "sense_id": "19e4c9d8-6265-33d0-add8-466f355046a8",
                                "text": "„Berge machen in Albanien gut die Hälfte der Landesfläche aus.“"
                            },
                            {
                                "example_id": "2b1e9c65-0b5b-4e66-b1fd-e695472e61c3",
                                "sense_id": "19e4c9d8-6265-33d0-add8-466f355046a8",
                                "text": "[Portugal 2005:] „Mindestens drei Viertel der Landesfläche sind von extremer Dürre betroffen.“"
                            },
                            {
                                "example_id": "183049ce-10ef-44e2-9a60-81ffd375c4c8",
                                "sense_id": "19e4c9d8-6265-33d0-add8-466f355046a8",
                                "text": "[Frankreich:] Mit dem Klimawandel hat die Gefahr von Bränden in der Natur zugenommen und betrifft inzwischen praktisch die gesamte Landesfläche, teilte das Innenministerium mit."
                            },
                            {
                                "example_id": "84277743-4808-442a-b8f9-98e69ac90f1e",
                                "sense_id": "19e4c9d8-6265-33d0-add8-466f355046a8",
                                "text": "„36% der Schweizer Landesfläche werden landwirtschaftlich genutzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
