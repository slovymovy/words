                    {
                        "translation_id": "dc1f5e3c-26cf-421d-8aa0-e90c2a9e1fed",
                        "source_entry_id": "5397d31a-68d6-369d-930e-f9e3b9caa4b2",
                        "source_sense_id": "488cde09-89c2-3912-97c1-be5a10ffb22f",
                        "target_lang_word": "bacchettone",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bacchettone",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "d04d4886-063e-3f8c-8079-a08bb250443a",
                                        "entry_id": "712e5af4-e2f9-398e-980f-4583a75b3b98",
                                        "glosses": [
                                            "chi osserva le pratiche religiose con fervore ed ostentazione, spesso per ipocrisia"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8b1313e-b710-44bb-ba9a-2bf5a503894f",
                                                "sense_id": "d04d4886-063e-3f8c-8079-a08bb250443a",
                                                "text": "\"Che smetta di fare il bacchettone! Ha più peccati lui di tutti loro messi assieme!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "596172e4-666e-3ceb-95d7-bfdc8d31180e",
                                        "entry_id": "712e5af4-e2f9-398e-980f-4583a75b3b98",
                                        "glosses": [
                                            "in tono scherzoso e tra coetanei, spesso tra giovani, è espressione detta con ironia comunque per sottolineare un atteggiamento di monito ma appunto simpaticamente maldestro quando suscita risa in complicità"
                                        ],
                                        "tags": [
                                            "familiare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80f87f68-f098-4cb8-ac78-8e433d45dcfb",
                                                "sense_id": "596172e4-666e-3ceb-95d7-bfdc8d31180e",
                                                "text": "è un bacchettone ma tollerante e comunque ha rispetto"
                                            },
                                            {
                                                "example_id": "700d6472-6fae-4f05-9d04-f8858c3a5048",
                                                "sense_id": "596172e4-666e-3ceb-95d7-bfdc8d31180e",
                                                "text": "\"Non ti piace la musica rock?! Sei un bacchettone...\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f22f1abc-daf8-3b6b-9441-bfad648f054d",
                                        "entry_id": "712e5af4-e2f9-398e-980f-4583a75b3b98",
                                        "glosses": [
                                            "pur senza problemi in merito, è chi forse esagera con moniti riguardo ad atteggiamenti sessuali invero un po' troppo \\\"liberi\\\"... però senza che lo riguardino direttamente, ovvero senza che le sue \\\"prediche\\\" possano trarre interesse ed attenzione quindi restando inascoltate dalla maggioranza"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
