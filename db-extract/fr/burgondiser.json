                "senses": [
                    {
                        "sense_id": "26f5a26e-4dab-3d04-9a76-2f08fe5eeba1",
                        "entry_id": "ae3a2de5-a9e4-315a-a5b3-a4621b64bd16",
                        "glosses": [
                            "Donner un caractère burgonde à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "186d504d-f59e-435d-b6ef-43260f6940b1",
                                "sense_id": "26f5a26e-4dab-3d04-9a76-2f08fe5eeba1",
                                "text": "Déjà une première fois, nous le savons, Césaire avait été accusé de « burgondiser » et avait été pour cela expédié en exil."
                            },
                            {
                                "example_id": "bb9ff40c-3797-405a-aedf-cf80f3fee526",
                                "sense_id": "26f5a26e-4dab-3d04-9a76-2f08fe5eeba1",
                                "text": "Ils en enrobent le foie gras, le magret de canard qui n'ont rien de local afin de les burgondiser, pensent-ils."
                            },
                            {
                                "example_id": "3feb0f64-03a9-4f43-89c1-6176d30b5b0f",
                                "sense_id": "26f5a26e-4dab-3d04-9a76-2f08fe5eeba1",
                                "text": "Vous avez en face de vous quelqu'un qui a beaucoup contribué à « burgondiser » le libournais et à y introduire certaines pratiques bourguignonnes !"
                            }
                        ]
                    }
