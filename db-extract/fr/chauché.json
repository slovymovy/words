                        "entry_id": "3b59c19c-fa53-348a-b274-74e82e4432d5",
                        "glosses": [
                            "Cépage ancien de vigne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "184cc50c-355a-4b33-b7c2-6a444af6ae01",
                                "sense_id": "a1e63bc0-09c3-3987-9dd7-60a2bf0dc202",
                                "text": "Dans la production des vins blancs, en plus du sauvignon, du colombard ou du chardonnay, nous utilisons du chauché, poursuit le viticulteur. C’est un vieux cépage qui était employé au Moyen Âge et qui a été remis au goût du jour."
                            }
                        ]
                    },
                    {
                        "sense_id": "de65a40a-e6f6-3aa5-85e9-061b68f29ff0",
                        "entry_id": "3b59c19c-fa53-348a-b274-74e82e4432d5",
                        "glosses": [
                            "Pineau blanc, pineau d'Aunis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6b44502-4069-4743-8770-3986f54d09f5",
                                "sense_id": "de65a40a-e6f6-3aa5-85e9-061b68f29ff0",
                                "text": "Il y a le chauché noir et le chauché gris."
                            },
                            {
                                "example_id": "56cceba6-de85-47cc-916e-42a1479b3ab5",
                                "sense_id": "de65a40a-e6f6-3aa5-85e9-061b68f29ff0",
                                "text": "Le vin d'Aunis, célèbre au moyen âge, se faisait avec le chauché."
                            },
                            {
                                "example_id": "13e2cb0f-ca18-4b01-b9e7-0b741463e618",
                                "sense_id": "de65a40a-e6f6-3aa5-85e9-061b68f29ff0",
                                "text": "Chauché gris, en Bourgogne, pineau blanc."
                            }
                        ]
