                ],
                "translations": [
                    {
                        "translation_id": "a3c63d24-ec1e-45ce-bf55-a4f251e10d73",
                        "source_entry_id": "29193786-00d3-3821-a3b0-638a7e02707d",
                        "source_sense_id": "7720c933-c759-3ba0-adaa-46d2ecabe9e7",
                        "target_lang_word": "theocracy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "theocracy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28bf9de6-d7a3-3d9b-8542-f2a38dee3d47",
                                        "entry_id": "021dd8ec-d4b4-3d17-bc71-00b3124ac386",
                                        "glosses": [
                                            "Government under the control of a state religion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67e2208a-6eae-4181-824d-71b896bea42d",
                                                "sense_id": "28bf9de6-d7a3-3d9b-8542-f2a38dee3d47",
                                                "text": "Near-synonym: clericocracy"
                                            },
                                            {
                                                "example_id": "6a3b9dd5-b918-4a2a-8656-2191eb786ef5",
                                                "sense_id": "28bf9de6-d7a3-3d9b-8542-f2a38dee3d47",
                                                "text": "Tibet was a Buddhist theocracy ruled by the Dalai Lama prior to Chinese annexation."
                                            },
                                            {
                                                "example_id": "eb5a13de-a642-451f-ac19-a51f194dc069",
                                                "sense_id": "28bf9de6-d7a3-3d9b-8542-f2a38dee3d47",
                                                "text": "The Vatican City State is a sovereign city-state and a Christian theocracy ruled by the Pope."
                                            },
                                            {
                                                "example_id": "11b60fea-101e-4d17-a8cf-d2803688646e",
                                                "sense_id": "28bf9de6-d7a3-3d9b-8542-f2a38dee3d47",
                                                "text": "Lynch certainly seems to think to. “We feel liberated from the prism of the past,” he says. “Ireland was a theocracy.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "018ac820-4ac5-3d7b-bc34-31848f5b4ad3",
                                        "entry_id": "021dd8ec-d4b4-3d17-bc71-00b3124ac386",
                                        "glosses": [
                                            "Rule by a god."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc34eab5-46bc-4136-91b3-0288206d1e8a",
                                                "sense_id": "018ac820-4ac5-3d7b-bc34-31848f5b4ad3",
                                                "text": "For quotations using this term, see Citations:theocracy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4b24bdd-aea3-412d-8a79-9b5919e71850",
                        "source_entry_id": "29193786-00d3-3821-a3b0-638a7e02707d",
                        "source_sense_id": "7720c933-c759-3ba0-adaa-46d2ecabe9e7",
                        "target_lang_word": "théocratie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "théocratie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fb6e9d9b-bee4-38b1-a2eb-bdb3cd7f308c",
                                        "entry_id": "688a81aa-6c84-3215-8728-1f06cbffa795",
                                        "glosses": [
                                            "Gouvernement fondé sur la religion, où soit un dieu soit le clergé exerce le pouvoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35ba013e-1c32-4977-81a0-272f64c85e6f",
                                                "sense_id": "fb6e9d9b-bee4-38b1-a2eb-bdb3cd7f308c",
                                                "text": "Tout ce qui se faisait, devait se faire pour honorer, pour glorifier Jéhovah. Ce mobile sacré des actions des hommes s'appelait religion; et la constitution qui en était la base, et qui faisait de la loi du Dieu du pays un code éternellement inviolable, était le principe gouvernemental que nous nommons théocratie."
                                            },
                                            {
                                                "example_id": "e380f0ab-def4-442e-b4d5-3fd1b8d5fb95",
                                                "sense_id": "fb6e9d9b-bee4-38b1-a2eb-bdb3cd7f308c",
                                                "text": "«Ce gouvernement d'une république fédérative par une théocratie sacrée et centrale, continue le philosophe allemand [Herder] , était le plus idéal des gouvernements». (…) Telle était la Constitution théocratique de Moïse. La loi régnait seule; fondée sur la volonté de Dieu, et soutenue par la voix unanime du peuple, elle avait son trône dans le temple national."
                                            },
                                            {
                                                "example_id": "b0290aef-0a30-422c-a8ae-a41830d7edf9",
                                                "sense_id": "fb6e9d9b-bee4-38b1-a2eb-bdb3cd7f308c",
                                                "text": "Il prône aujourd’hui la compassion, la non-violence et, la justice, valeurs partagées par tous, mais lourdement déficientes dans la société tibétaine sous la théocratie bouddhiste dont il est issu."
                                            },
                                            {
                                                "example_id": "bd0cf1bb-5624-47cd-999a-bdce2790861c",
                                                "sense_id": "fb6e9d9b-bee4-38b1-a2eb-bdb3cd7f308c",
                                                "text": "« Ce n’est pas un combat entre les athées et les croyants, ou entre les chrétiens et les musulmans, c’est un combat entre la laïcité et la théocratie, c’est ça le véritable débat !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5888f48-c09b-4970-9c68-6359644e6c09",
                        "source_entry_id": "29193786-00d3-3821-a3b0-638a7e02707d",
                        "source_sense_id": "7720c933-c759-3ba0-adaa-46d2ecabe9e7",
