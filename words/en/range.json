                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "область значений",
                                "target_lang_sense_clarification": "математика"
                            },
                            {
                                "target_lang_word": "множество значений",
                                "target_lang_sense_clarification": "математика"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "değer kümesi",
                                "target_lang_sense_clarification": "matematik"
                            },
                            {
                                "target_lang_word": "görüntü kümesi",
                                "target_lang_sense_clarification": "matematik"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "38ef30ff-13bf-3cb9-a981-1e19963e98ff",
                    "sense_definition": "To vary between two specified limits or values.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "vary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The temperature <w>ranges</w> from mild to very hot.",
                            "target_lang_translations": {
                                "ru": "Температура <w>варьируется</w> от умеренной до очень жаркой.",
                                "tr": "Sıcaklık ılımandan çok sıcağa kadar <w>değişmektedir</w>."
                            }
                        },
                        {
                            "text": "Prices for the tickets <w>range</w> between ten and twenty dollars.",
                            "target_lang_translations": {
                                "ru": "Цены на билеты <w>колеблются</w> от десяти до двадцати долларов.",
                                "tr": "Bilet fiyatları on ila yirmi dolar arasında <w>değişiyor</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "run"
                    ],
                    "common_phrases": [
                        "range from",
                        "range between"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменяться в пределах двух указанных границ или значений.",
                        "tr": "Belirtilen iki sınır veya değer arasında değişiklik göstermek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "варьироваться",
                                "target_lang_sense_clarification": "изменяться в пределах"
                            },
                            {
                                "target_lang_word": "колебаться",
                                "target_lang_sense_clarification": "меняться (о ценах, температуре)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "değişmek",
                                "target_lang_sense_clarification": "belirli sınırlar arasında farklılık göstermek"
                            },
                            {
                                "target_lang_word": "uzanmak",
                                "target_lang_sense_clarification": "bir değerden diğerine kadar sürmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "992c61d7-71fd-395b-b6e1-40a157c4daef",
                    "sense_definition": "To travel over a wide area; to roam or wander freely.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "move",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wolves <w>range</w> over a large territory in search of food.",
                            "target_lang_translations": {
                                "ru": "Волки <w>рыщут</w> по большой территории в поисках пищи.",
                                "tr": "Kurtlar yiyecek aramak için geniş bir bölgede <w>dolaşırlar</w>."
                            }
                        },
                        {
                            "text": "They <w>ranged</w> the woods for hours.",
                            "target_lang_translations": {
                                "ru": "Они <w>бродили</w> по лесу часами.",
                                "tr": "Saatlerce ormanda <w>gezindiler</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Путешествовать по обширной территории; бродить или скитаться свободно.",
                        "tr": "Geniş bir alanda seyahat etmek; serbestçe dolaşmak veya gezinmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бродить",
                                "target_lang_sense_clarification": "ходить без цели"
                            },
                            {
                                "target_lang_word": "рыскать",
                                "target_lang_sense_clarification": "искать добычу"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dolaşmak",
                                "target_lang_sense_clarification": "geniş bir alanda gezinmek"
                            },
                            {
                                "target_lang_word": "gezinmek",
                                "target_lang_sense_clarification": "serbestçe dolaşmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21c3fc8b-f612-3b63-95fa-a7f018045277",
