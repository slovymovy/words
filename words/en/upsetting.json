{
    "word_family": [
        "upset"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ce928175-4406-362e-a2af-35272cc844e6",
                    "sense_definition": "Causing emotional distress, worry, or unhappiness.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was very <w>upsetting</w> to hear the bad news about the accident.",
                            "target_lang_translations": {
                                "es": "Fue muy <w>perturbador</w> escuchar las malas noticias sobre el accidente."
                            }
                        },
                        {
                            "text": "She found the <w>upsetting</w> movie difficult to watch until the end.",
                            "target_lang_translations": {
                                "es": "Le resultó difícil ver la película <w>perturbadora</w> hasta el final."
                            }
                        }
                    ],
                    "synonyms": [
                        "distressing",
                        "sad",
                        "unhappy"
                    ],
                    "common_phrases": [
                        "very upsetting",
                        "deeply upsetting"
                    ],
                    "target_lang_definitions": {
                        "es": "Que causa angustia emocional, preocupación o infelicidad."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "perturbador",
                                "target_lang_sense_clarification": "Que causa inquietud o desasosiego emocional."
                            },
                            {
                                "target_lang_word": "desconcertante",
                                "target_lang_sense_clarification": "Que causa confusión o malestar emocional."
                            },
                            {
                                "target_lang_word": "triste",
                                "target_lang_sense_clarification": "Que provoca sentimientos de infelicidad."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0780075-97d1-3461-8f7a-ae7409338d3b",
                    "sense_definition": "Feeling or showing too much pride; arrogant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>upsetting</w> attitude made it hard for others to work with him.",
                            "target_lang_translations": {
                                "es": "Su actitud <w>arrogante</w> dificultaba que otros trabajaran con él."
                            }
                        },
                        {
                            "text": "The team disliked his <w>upsetting</w> behavior during the meeting.",
                            "target_lang_translations": {
                                "es": "Al equipo le desagradaba su comportamiento <w>arrogante</w> durante la reunión."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Que siente o muestra demasiado orgullo; arrogante."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "arrogante",
                                "target_lang_sense_clarification": "Que muestra una actitud de superioridad."
                            },
                            {
                                "target_lang_word": "presuntuoso",
                                "target_lang_sense_clarification": "Que tiene una opinión excesivamente alta de sí mismo."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3a5feaa1-2fea-3253-9e11-1b0d9c08863c",
                    "sense_definition": "The act of overturning or causing a state of disorder.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>upsetting</w> of the table caused all the drinks to spill.",
                            "target_lang_translations": {
                                "es": "El repentino <w>vuelco</w> de la mesa hizo que todas las bebidas se derramaran."
                            }
                        },
                        {
                            "text": "The <w>upsetting</w> of their plans led to a chaotic afternoon.",
                            "target_lang_translations": {
                                "es": "El <w>trastorno</w> de sus planes condujo a una tarde caótica."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "El acto de volcar algo o causar un estado de desorden."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "vuelco",
                                "target_lang_sense_clarification": "Acción de voltear o invertir la posición de algo."
                            },
                            {
                                "target_lang_word": "trastorno",
                                "target_lang_sense_clarification": "Acción de causar desorden o alteración en un plan o sistema."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "467b203a-ed06-31af-a58a-5ef3ab9c6e82",
                    "sense_definition": "The present participle and gerund of <w>upset</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>upsetting</w> the balance of the game by changing the rules.",
                            "target_lang_translations": {
                                "es": "Él está <w>alterando</w> el equilibrio del juego al cambiar las reglas."
                            }
                        },
                        {
                            "text": "The constant noise is <w>upsetting</w> the neighbors.",
                            "target_lang_translations": {
                                "es": "El ruido constante está <w>molestando</w> a los vecinos."
                            }
                        }
                    ],
                    "common_phrases": [
                        "upsetting the balance"
                    ],
                    "target_lang_definitions": {
                        "es": "El participio presente y gerundio de 'upset' (alterar, molestar, volcar)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "alterando",
                                "target_lang_sense_clarification": "Causando cambios negativos o molestia."
                            },
                            {
                                "target_lang_word": "molestando",
                                "target_lang_sense_clarification": "Causando incomodidad o irritación a alguien."
                            },
                            {
                                "target_lang_word": "volcando",
                                "target_lang_sense_clarification": "Cambiando la posición de algo, haciéndolo caer."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}