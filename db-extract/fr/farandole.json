        "fr-extract.jsonl": [
            {
                "entry_id": "866fbb8b-3881-3edb-8ca1-7276a1736984",
                "word": "farandole",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e47b425f-ed38-4b91-a2ca-10e047a0c6c2",
                        "entry_id": "866fbb8b-3881-3edb-8ca1-7276a1736984",
                        "tags": [
                            "plural"
                        ],
                        "form": "farandoles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ba51c4be-4f6e-3163-b69e-cf43d67a1c93",
                        "entry_id": "866fbb8b-3881-3edb-8ca1-7276a1736984",
                        "glosses": [
                            "Sorte de danse provençale, que plusieurs personnes exécutent en se tenant par la main et en formant une chaîne ^([3])."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a54e042c-f0b9-4a0b-bc10-a4afb026f054",
                                "sense_id": "ba51c4be-4f6e-3163-b69e-cf43d67a1c93",
                                "text": "Danser une farandole."
                            },
                            {
                                "example_id": "6f027a47-aae5-44f0-aaa5-d5db5432139d",
                                "sense_id": "ba51c4be-4f6e-3163-b69e-cf43d67a1c93",
                                "text": "Alors, je chantai la farandole, et je me mis à danser au soleil…"
                            },
                            {
                                "example_id": "27f37ea4-b595-4e75-aca6-5f2e3a05e29d",
                                "sense_id": "ba51c4be-4f6e-3163-b69e-cf43d67a1c93",
                                "text": "Puis, en pleine vague disco, « Va où le vent te mène », ou sa « Demoiselle marchant sur le ruisseau » qui donna la cadence à quantité de farandoles…"
                            }
                        ]
                    },
                    {
                        "sense_id": "d61f2891-488b-3eb9-874d-ff1eda69d2db",
                        "entry_id": "866fbb8b-3881-3edb-8ca1-7276a1736984",
                        "glosses": [
                            "Ensemble d’objets ou de sensations qui se succèdent en enfilade comme dans une farandole."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "56396718-347a-485d-a001-a3889d1921ef",
                                "sense_id": "d61f2891-488b-3eb9-874d-ff1eda69d2db",
                                "text": "Une farandole de mille pensées qui s’entrechoquaient lui faisait tourner la tête."
                            },
                            {
                                "example_id": "7125215f-f3e1-4df1-88e7-48366043035b",
                                "sense_id": "d61f2891-488b-3eb9-874d-ff1eda69d2db",
                                "text": "Au comptoir, perché sur un tabouret, on déguste un verre de blanc, un café, avec une farandole de tapas et chipoteries, «grignoteries» en tout genre."
                            },
                            {
                                "example_id": "b20a8113-c0b1-47e2-b2ae-33e6b071972d",
                                "sense_id": "d61f2891-488b-3eb9-874d-ff1eda69d2db",
                                "text": "Une flopée de buts, pas mal de galères et beaucoup, beaucoup de talent. De retour sur les terrains après une farandole de blessures, Grégory Pujol a fêté dignement sa troisième titularisation de la saison face à Sochaux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "864d31c8-d7ae-46e5-9695-d34b1bdbecb4",
                        "source_entry_id": "866fbb8b-3881-3edb-8ca1-7276a1736984",
                        "source_sense_description": "Danse provençale où on se tient les mains en formant une chaîne",
