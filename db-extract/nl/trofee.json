                ],
                "senses": [
                    {
                        "sense_id": "8fc95385-9f66-3d27-adcc-64a841bb3f24",
                        "entry_id": "b774bde3-eb80-38a5-a82a-7587268ef35a",
                        "glosses": [
                            "duurzaam voorwerp dat na een overwinning als symbool daarvan aan de winnaar wordt uitgereikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a51224f-612e-4be8-8c8f-1b1900846a4b",
                                "sense_id": "8fc95385-9f66-3d27-adcc-64a841bb3f24",
                                "text": "Het Nederlands elftal heeft voor de vijfde keer op rij de trofee gewonnen."
                            },
                            {
                                "example_id": "2eab23ed-cda4-4381-bbac-62a5fa397e29",
                                "sense_id": "8fc95385-9f66-3d27-adcc-64a841bb3f24",
                                "text": "De vreugde op de Nederlandse bank was uitzinnig. Waar iedereen sprong, bleef coach Ilse DeLange met de handen voor haar ogen zitten. Ongeloof won het nog van de vreugde. Laurence was al snel weer bij zijn positieven en nam de trofee in ontvangst met de woorden: ‘To Music first. Always.’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "727b6121-3129-4196-b106-15c56612a9d6",
                        "source_entry_id": "b774bde3-eb80-38a5-a82a-7587268ef35a",
                        "source_sense_id": "8fc95385-9f66-3d27-adcc-64a841bb3f24",
                        "source_sense_description": "duurzaam voorwerp dat na een overwinning als symbool daarvan aan de winnaar wordt uitgereikt",
                        "target_lang_word": "Trophäe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trophäe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55a7a482-ce5a-3ec4-b3a5-e0297468a39b",
                                        "entry_id": "de4db137-64fd-3b12-a5a9-d6c651ebe34e",
                                        "glosses": [
                                            "Zeichen des Sieges über einen Feind in Form einer Fahne, einer Waffe oder ähnlichen Ausrüstungsgegenständen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7cbe53e-c8d0-438e-9be7-4b64aac54466",
                                                "sense_id": "55a7a482-ce5a-3ec4-b3a5-e0297468a39b",
                                                "text": "Hier sehen Sie einige Trophäen aus dem Dreißigjährigen Krieg."
                                            },
                                            {
                                                "example_id": "d6b72622-9948-4bbd-9991-e0eacce650c2",
                                                "sense_id": "55a7a482-ce5a-3ec4-b3a5-e0297468a39b",
                                                "text": "„In einer Zeremonie zerstören sie die Trophäen, brechen die Schwerter entzwei und zerschlagen die Schilde.“"
                                            },
                                            {
                                                "example_id": "cafb6b5f-d339-46d0-82cd-b8031e8a9024",
                                                "sense_id": "55a7a482-ce5a-3ec4-b3a5-e0297468a39b",
                                                "text": "„Auf der Straße trägt Sam seinen Stock wie eine Trophäe im Maul und läuft dicht neben Jürgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "632232fd-76ac-3841-b86a-5ad0cd5c009f",
                                        "entry_id": "de4db137-64fd-3b12-a5a9-d6c651ebe34e",
                                        "glosses": [
                                            "Kurzform von Jagdtrophäe oder Siegestrophäe, Merkmal oder Objekt als Wahrzeichen eines Triumphes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2df5b99-9a45-4cea-871a-da4714688521",
                                                "sense_id": "632232fd-76ac-3841-b86a-5ad0cd5c009f",
                                                "text": "„Darum geht es ja auch, wenn eine Frau die Trophäe eines Mannes ist, sie muss nicht nur jung und attraktiv sein, sondern auch klug und gebildet.“"
                                            },
                                            {
                                                "example_id": "52f5cbd0-42f1-4c33-8128-978b443985a4",
                                                "sense_id": "632232fd-76ac-3841-b86a-5ad0cd5c009f",
                                                "text": "„Die körperlichen und seelischen Narben wurden von einigen als stolze Beweisstücke, als Trophäen, getragen der Zugehörigkeit zu einer Truppe, die an Leidensfähigkeit ihresgleichen sucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cb8cf974-71ab-3411-a556-909f695230e0",
                                        "entry_id": "de4db137-64fd-3b12-a5a9-d6c651ebe34e",
                                        "glosses": [
                                            "Gegenstand, der für den Sieger eines Wettbewerbs bestimmt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc558da2-4d20-485d-9d01-e5e2ae637284",
                                                "sense_id": "cb8cf974-71ab-3411-a556-909f695230e0",
                                                "text": "Konrad hat eine ganze Sammlung diverser Trophäen von Skatturnieren."
                                            },
                                            {
                                                "example_id": "b8479aac-5487-4a76-b747-f78cac6c6b88",
                                                "sense_id": "cb8cf974-71ab-3411-a556-909f695230e0",
                                                "text": "„Dann hebt er sie auf und trägt sie wie eine Trophäe davon.“"
                                            },
                                            {
                                                "example_id": "d3e35c61-26b3-4e5a-ab57-cb417762f887",
                                                "sense_id": "cb8cf974-71ab-3411-a556-909f695230e0",
                                                "text": "„Seit 2006 gibt es den Felix Burda Award auch als Trophäe für die Preisträger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d2b0973e-71bc-3728-a477-80380c0c27d3",
                                        "entry_id": "de4db137-64fd-3b12-a5a9-d6c651ebe34e",
                                        "glosses": [
                                            "historisches Siegesdenkmal, Ehrenmal"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "1eeb7783-d902-34f6-b8a8-cd2126aec67b",
                                        "entry_id": "de4db137-64fd-3b12-a5a9-d6c651ebe34e",
                                        "glosses": [
                                            "historisches Siegesdenkmal, Ehrenmal",
                                            "an einen Baum, der an der Stelle auf dem Schlachtfeld steht, wo der Feind in die Flucht geschlagen wurde, gehängte erbeutete Waffen"
                                        ],
                                        "tags": [
                                            "bei den Griechen"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4a\""
                                    },
                                    {
                                        "sense_id": "f64fab18-13b1-3224-9a31-32aaecf617e8",
                                        "entry_id": "de4db137-64fd-3b12-a5a9-d6c651ebe34e",
                                        "glosses": [
                                            "historisches Siegesdenkmal, Ehrenmal",
                                            "feststehender monumentaler Rundbau mit Reliefs"
                                        ],
                                        "tags": [
                                            "bei den Römern"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4b\""
                                    },
                                    {
                                        "sense_id": "a50a7853-1a30-3d5e-8bd4-3e0a7b499099",
                                        "entry_id": "de4db137-64fd-3b12-a5a9-d6c651ebe34e",
                                        "glosses": [
                                            "besondere Ehrenzeichen in Form von Waffen oder Armaturen, die an Stadttoren, Zeughäusern oder Gräbern höherstehender Personen angebracht waren"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33b8e33b-3948-4217-b349-650bd47cf38c",
                        "source_entry_id": "b774bde3-eb80-38a5-a82a-7587268ef35a",
                        "source_sense_id": "8fc95385-9f66-3d27-adcc-64a841bb3f24",
                        "source_sense_description": "duurzaam voorwerp dat na een overwinning als symbool daarvan aan de winnaar wordt uitgereikt",
                        "target_lang_word": "trophy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trophy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "985c3d4b-a7b8-3daf-aa00-0333bb3f8405",
                                        "entry_id": "095dc191-5fcf-3149-af2d-730d5586850a",
                                        "glosses": [
                                            "An object, usually in the form of a statuette, cup, or shield, awarded for success in a competition or to mark a special achievement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33069cfa-d761-446c-930d-8e9d3b2853bc",
                                                "sense_id": "985c3d4b-a7b8-3daf-aa00-0333bb3f8405",
                                                "text": "He won the trophy in a running competition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec43ca50-986f-3f03-8a5d-de93f78f3824",
                                        "entry_id": "095dc191-5fcf-3149-af2d-730d5586850a",
                                        "glosses": [
                                            "An object taken as a prize by a hunter, or a conqueror or belligerent, especially one that is displayed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04f03ecf-a6f7-4021-bd89-0960597becc6",
                                                "sense_id": "ec43ca50-986f-3f03-8a5d-de93f78f3824",
                                                "text": "The set of antlers which hung on the wall was his prized trophy."
                                            },
                                            {
                                                "example_id": "06dcf164-7743-4373-b1b1-38c8d0433871",
                                                "sense_id": "ec43ca50-986f-3f03-8a5d-de93f78f3824",
                                                "text": "Around the posts hung helmets, darts, and spears, / And captive chariots, axes, shields, and bars, / And broken beaks of ships, the trophies of their wars."
                                            },
                                            {
                                                "example_id": "92b66e7c-9ccf-4746-984d-ae30df8edd75",
                                                "sense_id": "ec43ca50-986f-3f03-8a5d-de93f78f3824",
                                                "text": "Similarly, the Soviet defence industry tested their guns by firing against German trophy tanks or fired against new Soviet vehicles with German guns or German ammunition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0581d75-a0f6-37a8-959c-9ab10f50f6fa",
                                        "entry_id": "095dc191-5fcf-3149-af2d-730d5586850a",
                                        "glosses": [
                                            "Any emblem of success; a status symbol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77fd1a13-d9bc-4ba9-869f-1359f4e97d84",
                                                "sense_id": "e0581d75-a0f6-37a8-959c-9ab10f50f6fa",
                                                "text": "His trophies included his second wife, his successful children, the third and fourth homes in Palm Beach and Malibu, and his three yachts."
                                            },
                                            {
                                                "example_id": "5d7ae2ff-bca3-43d8-be80-89bc582c1215",
                                                "sense_id": "e0581d75-a0f6-37a8-959c-9ab10f50f6fa",
                                                "text": "“The stakes are getting so high,” Mr. MacDonald-Korth said in a telephone interview, referring to the skyrocketing amounts being paid for trophy works of art."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c78bd4e-d394-3c7f-b4dc-84c342e8930b",
                                        "entry_id": "095dc191-5fcf-3149-af2d-730d5586850a",
                                        "glosses": [
                                            "An object taken by a serial killer or rapist as a memento of the crime."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08bf83f7-5293-387a-be8d-e555645cda9f",
                                        "entry_id": "095dc191-5fcf-3149-af2d-730d5586850a",
                                        "glosses": [
                                            "A tropæum."
                                        ],
                                        "tags": [
                                            "Ancient-Rome",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf16c449-eb4a-316f-abe0-c5ed89e5138a",
                                        "entry_id": "095dc191-5fcf-3149-af2d-730d5586850a",
                                        "glosses": [
                                            "A display of weaponry and other militaria, often captured from a defeated enemy, as an ornament designed for the purpose of triumphalist display by a victor or as a show of military prowess by a monarch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a276dea6-71ab-4a5c-bfcc-dad5b5e20fa0",
                                                "sense_id": "cf16c449-eb4a-316f-abe0-c5ed89e5138a",
                                                "text": "The souvenirs which many killers retain of their victims are often described as trophies, and Norman Bates's taxidermic interests derived from the real-life Ed Gein."
                                            },
                                            {
                                                "example_id": "3ef4d8ee-6f2b-4213-a7d3-a28ff8cf4b9f",
                                                "sense_id": "cf16c449-eb4a-316f-abe0-c5ed89e5138a",
                                                "text": "A trophy from this murder would have been of great importance."
                                            },
                                            {
                                                "example_id": "ec2cc592-96fb-4b3e-b5b1-c2e417048055",
                                                "sense_id": "cf16c449-eb4a-316f-abe0-c5ed89e5138a",
                                                "text": "The offender is also likely to mentally relive his killings, often with the help of souvenirs or trophies, such as a bracelet or a body part taken from the victim."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02925355-52ef-33ef-8bbb-3033daac6231",
                                        "entry_id": "095dc191-5fcf-3149-af2d-730d5586850a",
                                        "glosses": [
                                            "An artifact or artwork that has been stolen by a criminal and traded on the black market."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1ebe167-dd1d-3513-8771-6b9b731f1dbc",
                                        "entry_id": "095dc191-5fcf-3149-af2d-730d5586850a",
                                        "glosses": [
                                            "An animal killed by a trophy hunter that usually has its parts sold on the black market."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "trophy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "872e1cd6-17ca-34fe-8c3a-0fdc155960e5",
                                        "entry_id": "22f04110-ac18-3be2-8f82-d711a1940261",
                                        "glosses": [
                                            "To adorn (someone) with trophies."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5615cbbc-90f6-44aa-bc7e-a5356d77016c",
                                                "sense_id": "872e1cd6-17ca-34fe-8c3a-0fdc155960e5",
                                                "text": "How many a night serene, shall I behold / Those vvarm attractive orbits, close inshrined / In ether, over vvhich Love's column rose / Marmoreal, trophied round vvith golden hair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8402baa6-8cd9-3e03-991b-3c66d9d457c1",
                                        "entry_id": "22f04110-ac18-3be2-8f82-d711a1940261",
                                        "glosses": [
                                            "To win a trophy in a competition."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5513a9f-691f-4633-95cc-5df3ce2e664b",
                                                "sense_id": "8402baa6-8cd9-3e03-991b-3c66d9d457c1",
                                                "text": "He trophied at the 1993, 1994, 2012 and 2015 National Championships and was most proud of winning his class at the 2017 Spring Nationals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0b72196-8ee1-4bb2-85cb-cd94a2c00a0b",
                        "source_entry_id": "b774bde3-eb80-38a5-a82a-7587268ef35a",
                        "source_sense_id": "8fc95385-9f66-3d27-adcc-64a841bb3f24",
                        "source_sense_description": "duurzaam voorwerp dat na een overwinning als symbool daarvan aan de winnaar wordt uitgereikt",
                        "target_lang_word": "trophée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trophée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "711b9109-dbbf-3a49-af1e-ed0a22f4a024",
                                        "entry_id": "7b5321fa-189d-3ff1-965b-468dcaed0b44",
                                        "glosses": [
                                            "Dépouille d’un ennemi vaincu, que l’on mettait ordinairement sur un tronc d’arbre dont on avait coupé les branches."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4593b297-c948-3b6f-9b71-e46e2c99869d",
                                        "entry_id": "7b5321fa-189d-3ff1-965b-468dcaed0b44",
                                        "glosses": [
                                            "Dépouille d’un vaincu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "374724b5-a692-4f6d-98a1-450e879bdfd7",
                                                "sense_id": "4593b297-c948-3b6f-9b71-e46e2c99869d",
                                                "text": "Louis XVI cria son innocence sur l'échafaud, mais Santerre fit couvrir sa voix par le roulement des tambours. Sa mort fut atroce. Il se débattit et le couperet mutila sa mâchoire sans décoller sa tête. Affreux trophée que le fils du bourreau brandit à la place de son père, écœuré, devant une foule stupéfaite, puis en transe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2479af36-d94c-3d5d-a4d8-55ded9aa3e04",
                                        "entry_id": "7b5321fa-189d-3ff1-965b-468dcaed0b44",
                                        "glosses": [
                                            "Assemblage d’armes, de drapeaux, élevés et disposés avec art, pour conserver le souvenir d’une victoire, d’une conquête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a003616-73d3-4316-b896-2111beb83669",
                                                "sense_id": "2479af36-d94c-3d5d-a4d8-55ded9aa3e04",
                                                "text": "Dresser, élever, ériger un trophée."
                                            },
                                            {
                                                "example_id": "bbd33e54-2843-430c-89ae-419dc143d1ad",
                                                "sense_id": "2479af36-d94c-3d5d-a4d8-55ded9aa3e04",
                                                "text": "Sculpter des trophées sur un arc de triomphe."
                                            },
                                            {
