                "senses": [
                    {
                        "sense_id": "ef1781c1-9f24-35b9-9a28-10f50a796bf4",
                        "entry_id": "e8cc156b-a2af-3900-aaa6-25d38dc37b37",
                        "glosses": [
                            "im Vergleich zum Fußboden erhöhte Plattform für Redner, Dirigenten, darstellende Künstler, siegreiche Wettkämpfer oder Ähnliches"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fa1d229-b268-4065-b369-d1491c461858",
                                "sense_id": "ef1781c1-9f24-35b9-9a28-10f50a796bf4",
                                "text": "„Am nächsten Mittwoch werden die Cellistin Sol Gabetta und die Pianistin Hélène Grimaud nun zum ersten Mal gemeinsam auf dem Podium der Laeiszhalle bei einem Kammermusikrecital von Pro Arte zu erleben sein.“"
                            },
                            {
                                "example_id": "9bde74d9-97ea-4e6a-a94b-93bb9edd10be",
                                "sense_id": "ef1781c1-9f24-35b9-9a28-10f50a796bf4",
                                "text": "„Der Referent auf dem Podium müht sich mit dem Mikrofon ab.“"
                            },
                            {
                                "example_id": "6dd4ce4c-00d0-429b-94ed-b1e73e5078dd",
                                "sense_id": "ef1781c1-9f24-35b9-9a28-10f50a796bf4",
                                "text": "„Auf dem Podium sprach ein Mann mit Buckel von der Frankfurter Buchmesse.“"
                            },
                            {
                                "example_id": "525820f0-6e1a-47bb-8ee9-bcbfd0cb3a46",
                                "sense_id": "ef1781c1-9f24-35b9-9a28-10f50a796bf4",
                                "text": "„Thomas verbeugte sich, verließ das Podium, und nahm auf dem Außenplatz der ersten Sitzreihe Platz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
