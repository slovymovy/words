                "senses": [
                    {
                        "sense_id": "c361ee29-9212-3708-81f5-ddca06465a00",
                        "entry_id": "56a7cf8d-0459-3356-8cf9-7208605b45a3",
                        "glosses": [
                            "Faire revenir en arrière par rapport à un élargissement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27e77bfe-c80b-4a70-aa0a-c241e7e9bdae",
                                "sense_id": "c361ee29-9212-3708-81f5-ddca06465a00",
                                "text": "Eh bien on le désélargit."
                            },
                            {
                                "example_id": "0e81e39d-90d1-4161-b7ef-c205056f8eb9",
                                "sense_id": "c361ee29-9212-3708-81f5-ddca06465a00",
                                "text": "Le 23 juin, le vote d’une majorité de Britanniques en faveur d’une sortie de l’UE consacre la métamorphose de l’UE, en la révélant, conformément aux textes (article 50 du Traité sur l’Union), concrètement susceptible de se « désélargir »."
                            },
                            {
                                "example_id": "3fc88222-ceb0-4f6b-9054-bccd6fa289a7",
                                "sense_id": "c361ee29-9212-3708-81f5-ddca06465a00",
                                "text": "Si la pente se raidit, la route ne se désélargit pas."
                            }
                        ]
                    }
