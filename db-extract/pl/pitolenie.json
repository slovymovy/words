                "senses": [
                    {
                        "sense_id": "b24ded53-1fd5-3350-9f31-69666380396c",
                        "entry_id": "4739ecee-be08-39f8-8c28-2c4599428849",
                        "glosses": [
                            "bezwartościowa, czcza gadanina"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "a6395620-7444-4ba6-a083-e88251255426",
                                "sense_id": "b24ded53-1fd5-3350-9f31-69666380396c",
                                "text": "Mam już dość tego jego pitolenia o niczym."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "87ebc72b-94bb-36e2-88af-e77062f05f61",
                        "entry_id": "4739ecee-be08-39f8-8c28-2c4599428849",
                        "glosses": [
                            "nieumiejętna gra na instrumencie"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "522f4f21-b22c-46ea-8359-7c286b03d9f0",
                                "sense_id": "87ebc72b-94bb-36e2-88af-e77062f05f61",
                                "text": "Trzy piętra poniżej było słychać pitolenie Zbyszka na pianinie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23fd5bc1-0885-4006-883c-2ced18bbc817",
                        "source_entry_id": "4739ecee-be08-39f8-8c28-2c4599428849",
                        "source_sense_id": "b24ded53-1fd5-3350-9f31-69666380396c",
                        "target_lang_word": "babble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "babble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5a81e53-403e-3305-abfe-8ef0b443f8c7",
                                        "entry_id": "3180c382-7cf2-3711-a8c7-32070c869f42",
                                        "glosses": [
                                            "To utter words indistinctly or unintelligibly; to utter inarticulate sounds"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a193d31e-8efa-4fef-b088-a258199d6910",
                                                "sense_id": "c5a81e53-403e-3305-abfe-8ef0b443f8c7",
                                                "text": "The men were babbling, so we couldn't make sense of anything."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c47b9baa-2f0e-332e-92e4-4a4dc73976cd",
                                        "entry_id": "3180c382-7cf2-3711-a8c7-32070c869f42",
                                        "glosses": [
                                            "To talk incoherently; to utter meaningless words."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c79109fb-d661-3c00-9758-f4a8acf17678",
                                        "entry_id": "3180c382-7cf2-3711-a8c7-32070c869f42",
                                        "glosses": [
                                            "To talk too much; to chatter; to prattle."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25302be4-f21e-448d-a686-f6e33590dbcb",
                                                "sense_id": "c79109fb-d661-3c00-9758-f4a8acf17678",
                                                "text": "She babbled on for hours about the importance of some new gadget."
                                            },
                                            {
                                                "example_id": "c8e906d2-9612-4a7a-b541-b3608e07629f",
                                                "sense_id": "c79109fb-d661-3c00-9758-f4a8acf17678",
                                                "text": "Radical rather than rhetorical, babble like an oracle"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc4cf23d-6dbc-36b3-8685-1937c22652f0",
                                        "entry_id": "3180c382-7cf2-3711-a8c7-32070c869f42",
                                        "glosses": [
                                            "To make a continuous murmuring noise, like shallow water running over stones."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "329cdd9c-4482-4788-833f-570a45693ce7",
                                                "sense_id": "dc4cf23d-6dbc-36b3-8685-1937c22652f0",
                                                "text": "Hounds are said to babble, or to be babbling, when they are too noisy after having found a good scent."
                                            },
                                            {
                                                "example_id": "a9fdb455-748e-461e-88b2-0676886465f9",
                                                "sense_id": "dc4cf23d-6dbc-36b3-8685-1937c22652f0",
                                                "text": "In every babbling brook he finds a friend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36e3e448-085d-35bd-b189-d49c136d3bd5",
                                        "entry_id": "3180c382-7cf2-3711-a8c7-32070c869f42",
                                        "glosses": [
                                            "To utter in an indistinct or incoherent way; to repeat words or sounds in a childish way without understanding."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf1951c7-9d45-4f30-811c-032d04ed985c",
                                                "sense_id": "36e3e448-085d-35bd-b189-d49c136d3bd5",
                                                "text": "All this vvhile John had conn'd over ſuch a Catalogue of hard VVords, as vvere enough to conjure up the Devil; theſe he uſed to babble indifferently in all Companies, eſpecially at Coffee-houſes; ſo that his Neighbour Tradeſmen began to ſhun his Company as a Man that vvas crack'd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d682684-06b9-39d9-b933-f540bdd3f16a",
                                        "entry_id": "3180c382-7cf2-3711-a8c7-32070c869f42",
                                        "glosses": [
                                            "To reveal; to give away (a secret)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "babble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4e7c6fe-8c46-3897-88d0-854c232a0cdd",
                                        "entry_id": "055b559f-e87f-31e6-a26a-c4c94325685e",
                                        "glosses": [
                                            "Idle talk; senseless prattle"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2b5a6f7-cffb-4834-b40d-3f24b49b9454",
                                                "sense_id": "a4e7c6fe-8c46-3897-88d0-854c232a0cdd",
                                                "text": "This is mere moral babble.",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "685a07fb-8dd3-3d37-af34-bf10357e5881",
                                        "entry_id": "055b559f-e87f-31e6-a26a-c4c94325685e",
                                        "glosses": [
                                            "Inarticulate speech; constant or confused murmur."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83e3dd33-3e95-4d1a-b387-ddd5aa6b48e5",
                                                "sense_id": "685a07fb-8dd3-3d37-af34-bf10357e5881",
                                                "text": "[M]an has an instinctive tendency to speak, as we see in the babble of our young children; whilst no child has an instinctive tendency to brew, bake, or write."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e422815-780f-3380-9203-3775f65a99cc",
                                        "entry_id": "055b559f-e87f-31e6-a26a-c4c94325685e",
                                        "glosses": [
                                            "A sound like that of water gently flowing around obstructions."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c49b847d-9dc8-449f-b931-734ac7599a1a",
                                                "sense_id": "4e422815-780f-3380-9203-3775f65a99cc",
                                                "text": "[T]he babble of the stream / Fell, and without the steady glare / Shrank the sick olive sere and small."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee53cb95-a563-4f31-982d-b526df12dc1d",
                        "source_entry_id": "4739ecee-be08-39f8-8c28-2c4599428849",
                        "source_sense_id": "b24ded53-1fd5-3350-9f31-69666380396c",
                        "target_lang_word": "twaddle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "twaddle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                        "entry_id": "29704ed7-2ab5-36ea-b81a-037408cd321b",
                                        "glosses": [
                                            "Empty or silly idle talk or writing; nonsense, rubbish."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04c6d97c-9ef2-4685-aad9-136266240963",
                                                "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                                "text": "You're talking a load of twaddle. Get your facts straight, man!"
                                            },
                                            {
                                                "example_id": "ca87bb01-20fb-41b1-8a3e-77539214a92c",
                                                "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                                "text": "\"What ineffable twaddle!\" I cried, slapping the magazine down on the table; \"I never read such rubbish in my life.\""
                                            },
                                            {
                                                "example_id": "e6dd98eb-0953-479f-9298-ae517b816273",
                                                "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                                "text": "I would rather be rude than to listen to twaddle from a man I’ve known."
                                            },
                                            {
                                                "example_id": "f834bbe0-13d3-489d-bef1-0d2aba51677f",
                                                "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                                "text": "It was her other self who had written that letter. It not only bored, it rather disgusted her real self. \"Flippant and silly,\" said her real self. Yet she knew that she'd send it and she'd always write that kind of twaddle to Nan Pym."
                                            },
                                            {
                                                "example_id": "12949f06-1ab1-4bc4-87c1-99fcf75c6a8c",
                                                "sense_id": "3dc42ba8-dcb4-3d9b-9c3e-888b9c6b4950",
                                                "text": "I improvised for three or four minutes, speaking complete twaddle in character."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85ca7b9f-92b1-38c8-bfbc-df1bbe47b3aa",
                                        "entry_id": "29704ed7-2ab5-36ea-b81a-037408cd321b",
                                        "glosses": [
                                            "One who twaddles; a twaddler."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "twaddle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "342e586c-4a0f-3ca2-9c86-2f0601a1275f",
                                        "entry_id": "8b75e73d-354c-3d2b-b86b-71cae2344415",
                                        "glosses": [
                                            "To talk or write nonsense; to prattle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4ff4a32-5ae8-425a-bfef-b30f4fed617e",
                                                "sense_id": "342e586c-4a0f-3ca2-9c86-2f0601a1275f",
                                                "text": "To Edward […] he was terrible, nerve-inflaming, poisonously asphyxiating. He sat rocking himself in the late Mr. Churchill's swing chair, smoking and twaddling."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
