                    {
                        "form_id": "5c74eb3b-562b-4fdd-8a02-8e64f3391239",
                        "entry_id": "a2f37460-8dd5-3672-bd85-54b527493692",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "conchoïdes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b86cbbea-264f-3fdd-be33-0403f9687b26",
                        "entry_id": "a2f37460-8dd5-3672-bd85-54b527493692",
                        "glosses": [
                            "En forme de conque, de coquille Saint-Jacques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ee85f74-6a3b-431e-9e06-baf16e413fd9",
                                "sense_id": "b86cbbea-264f-3fdd-be33-0403f9687b26",
                                "text": "Courbe conchoïde."
                            },
                            {
                                "example_id": "1f497c73-1795-4983-a1a3-f78660c74a57",
                                "sense_id": "b86cbbea-264f-3fdd-be33-0403f9687b26",
                                "text": "Sporophore de champignon conchoïde."
                            },
                            {
                                "example_id": "fba79a89-2847-4271-a4fe-b5a13f5aeb41",
                                "sense_id": "b86cbbea-264f-3fdd-be33-0403f9687b26",
                                "text": "La seconde est formée de calcaires gris bleuâtre ou noir, à pâte très fine, plus ou moins compactes, sub-lithographiques, à cassure conchoïde, et bien stratifiés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2b85fd2-1dcc-4088-a427-dde471197826",
                        "source_entry_id": "a2f37460-8dd5-3672-bd85-54b527493692",
                        "source_sense_id": "b86cbbea-264f-3fdd-be33-0403f9687b26",
                        "target_lang_word": "conchoidal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conchoidal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db00180a-94ec-3221-ada7-ce28dcd8003b",
                                        "entry_id": "bf9e4949-a706-3757-9636-b6582d4761c7",
                                        "glosses": [
                                            "Of or pertaining to a conchoid; that may be defined as a conchoid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9da05cc-d0b0-41db-9b01-35e65b6333a1",
                                                "sense_id": "db00180a-94ec-3221-ada7-ce28dcd8003b",
                                                "text": "c. 1695, Isaac Newton, 1976, D. T. Whiteside (editor), The Mathematical Papers of Isaac Newton, Volume 7: 1691-1695, page 621,\n[…] a conchoidal hyperbola with an oval at its convexity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "520cfad8-50cb-38bd-9737-90f654d76e45",
                                        "entry_id": "bf9e4949-a706-3757-9636-b6582d4761c7",
                                        "glosses": [
                                            "Irregular, with planar, concentric curves, similar to those on a mussel shell."
                                        ],
                                        "tags": [
                                            "of a fracture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b197492d-5efd-44e3-b18f-7d5cd49efb3c",
                                                "sense_id": "520cfad8-50cb-38bd-9737-90f654d76e45",
                                                "text": "1821, Coal, entry in Andrew Ure, A Dictionary of Chemistry on the Basis of Mr Nicholson's, unnumbered page,\nIt is distinguished by its splendent lustre and conchoidal fracture."
                                            },
                                            {
                                                "example_id": "b57489a1-3efa-45a1-b633-b63e8a86e63a",
                                                "sense_id": "520cfad8-50cb-38bd-9737-90f654d76e45",
                                                "text": "Some flakes detached in a controlled manner have characteristics of conchoidal fracture."
                                            },
                                            {
                                                "example_id": "894963d7-0784-4e6e-8ba4-154da4068aad",
                                                "sense_id": "520cfad8-50cb-38bd-9737-90f654d76e45",
                                                "text": "On one side of the radial edge, the conchoidal fractures form right angles, that is, form a perpendicular with the edge."
                                            },
                                            {
                                                "example_id": "e184d56d-1089-426f-980f-978957cb3964",
                                                "sense_id": "520cfad8-50cb-38bd-9737-90f654d76e45",
                                                "text": "If grains derived from these rocks are unweathered after separation from the parent rock (a very rare occurrence), they may contain either conchoidal breakage patterns if grains are large, or upturned plates and flat upper and lower surfaces if small grains are considered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c18876dd-f227-35fa-bb96-d1206a93e98a",
                                        "entry_id": "bf9e4949-a706-3757-9636-b6582d4761c7",
                                        "glosses": [
                                            "That fractures with planar concentric curves (e.g., as flint, chert or obsidian)."
                                        ],
                                        "tags": [
                                            "of a mineral"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22179fcc-8e83-45c1-bca0-0437c05bf80f",
                                                "sense_id": "c18876dd-f227-35fa-bb96-d1206a93e98a",
                                                "text": "1821, Focus of Philosophy, Science and Art, Volume 1, Issues 1-4, page 74,\nThe customary transitions of pitchstone are, into Chalcedony, Chert, Semi-opal; also into a substance resembling conchoidal shining jasper, found in clay strata, entangled in trap, or volcanic rock; and lastly, into Trap."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "edf80396-13c2-3e4d-b73d-c563af76f78a",
                "word": "conchoïde",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "58f0cb41-95d5-4436-bbb7-535f31e7e3d3",
                        "entry_id": "edf80396-13c2-3e4d-b73d-c563af76f78a",
                        "tags": [
                            "plural"
                        ],
                        "form": "conchoïdes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "241e0a05-8366-3fa7-8851-4c7a634ab629",
                        "entry_id": "edf80396-13c2-3e4d-b73d-c563af76f78a",
                        "glosses": [
                            "Courbe en forme de coquillages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f87ab4d-de24-4a71-b222-34945bdce33e",
                                "sense_id": "241e0a05-8366-3fa7-8851-4c7a634ab629",
                                "text": "La quadratrice ressemble si peu à une conchoïde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ebd34675-ad34-4b8e-b2f2-ac7df07878b4",
                        "source_entry_id": "edf80396-13c2-3e4d-b73d-c563af76f78a",
                        "source_sense_id": "241e0a05-8366-3fa7-8851-4c7a634ab629",
                        "target_lang_word": "conchoid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conchoid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "438fe457-a325-3324-a534-f283cd65a212",
                                        "entry_id": "fefddd69-9725-3cf3-a6ec-e17e43c3d26f",
                                        "glosses": [
                                            "Any of a family of curves defined as the locus of points p, such that each p is on a line that passes through a given fixed point P and intersects a given curve, C, and the distance from p to the point of intersection with C is a specified constant (note that for nontrivial cases two such points p satisfy the criteria, and the resultant curve has two parts)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f635393-56a3-4976-8c82-062a3c08203d",
                                                "sense_id": "438fe457-a325-3324-a534-f283cd65a212",
                                                "text": "The conchoid of a circle with respect to a point on the circle is a cardioid if the fixed distance is equal to the diameter of the circle."
                                            },
                                            {
                                                "example_id": "8a19d349-2610-41af-be98-263b9d3c8b59",
                                                "sense_id": "438fe457-a325-3324-a534-f283cd65a212",
                                                "text": "The Conchoid of Nicomedes is the conchoid of a straight line with respect to a point not on the line."
                                            },
                                            {
                                                "example_id": "8bed8b2c-0877-42bf-a463-908eb90d04f8",
                                                "sense_id": "438fe457-a325-3324-a534-f283cd65a212",
                                                "text": "1815, Charles Hutton, Pappus, entry in A Philosophical and Mathematical Dictionary, Volume 2, page 147,\nHe next treats of the properties of the Conchoid, which Nicomedes invented for doubling the cube; applying it to the solution of certain problems concerning Inclinations, with the finding of two mean proportionals, and cubes in any proportion whatever."
                                            },
                                            {
                                                "example_id": "50b3ee3d-c159-4062-b258-64483b2fb7b8",
                                                "sense_id": "438fe457-a325-3324-a534-f283cd65a212",
                                                "text": "The classical conchoid construction is a non-orthogonal polar-curvilinear construction in which equal distances along a line are marked off from its point of intersection with a curve for various positions of the line as it rotates about a point."
                                            },
                                            {
                                                "example_id": "2df96848-ff00-47ee-98e2-64aae0748ea1",
                                                "sense_id": "438fe457-a325-3324-a534-f283cd65a212",
                                                "text": "These curves are called conchoids of Nicomedes after the ancient Greek scholar Nicomedes. He called them conchoids because the shape of their outer branches resembles that of a conch shell or mussel shell."
                                            },
                                            {
                                                "example_id": "bfbbb108-56ee-4f57-90a6-e70cf8a13105",
                                                "sense_id": "438fe457-a325-3324-a534-f283cd65a212",
                                                "text": "One of the best choices is the conchoid, according to Newton the simplest curve after the circle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3a0c33a-da34-3c88-aef2-f95faf797d8f",
                                        "entry_id": "fefddd69-9725-3cf3-a6ec-e17e43c3d26f",
                                        "glosses": [
                                            "A conchoidal fracture in rock."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ec06ef6-5d1d-473d-a934-fe9e44a43273",
                                                "sense_id": "f3a0c33a-da34-3c88-aef2-f95faf797d8f",
                                                "text": "Conchoids of sound rock, from a few feet to 20 or more feet in diameter, entirely surrounded by comparatively thin layers of weathered material, were frequently encountered, sometimes in adjacent series."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b77cc16-8f47-476a-a030-7833d355def1",
                        "source_entry_id": "edf80396-13c2-3e4d-b73d-c563af76f78a",
