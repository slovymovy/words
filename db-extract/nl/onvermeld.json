                        "examples": [
                            {
                                "example_id": "d124aa9a-5ec7-450a-a49c-146cd53f43f5",
                                "sense_id": "85934821-1206-35b7-a771-f76beecd1416",
                                "text": "Dat het ministerie van Buitenlandse Zaken wel degelijk waarschuwt voor politieke onrust en terrorisme in het land bleef wijselijk onvermeld: het was voor de deelnemers allemaal al spannend genoeg."
                            },
                            {
                                "example_id": "73283394-af45-421b-8353-e7aaaedb2f51",
                                "sense_id": "85934821-1206-35b7-a771-f76beecd1416",
                                "text": "Onder de veertig films die hij achterlaat, zitten veel hier nog onvermelde pareltjes, zoals het fraaie kostuumdrama La nuit de Varennes (1982), de weemoedige terugblik op de dorpsbioscoop Splendor (1989) en het liefdesdrama Passione d’amore (1981), waarin een lelijke vrouw valt voor een knappe legerkapitein."
                            },
                            {
                                "example_id": "39ceec5e-d275-4cbb-87a2-a52ed1962041",
                                "sense_id": "85934821-1206-35b7-a771-f76beecd1416",
                                "text": "Dieren zijn geen mensen, vindt de directeur van Artis. Een zebra krijgt geen ‘baby’ meer, maar een veulen, en de naam blijft onvermeld."
                            }
                        ]
                    }
