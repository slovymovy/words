                        "form": "die Düngemittel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "29a2b865-4540-3f8f-b6c5-d64cb70274a3",
                        "entry_id": "78400613-0131-33ef-b28a-7662359ad630",
                        "glosses": [
                            "flüssige oder feste Nährstoffe, die in die Erde gegeben werden, damit Pflanzen besser wachsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2257ed75-3dc9-42b9-b525-2c4eb3d2cdb1",
                                "sense_id": "29a2b865-4540-3f8f-b6c5-d64cb70274a3",
                                "text": "„Zur Herstellung von Munition, aber auch von Düngemitteln für die Landwirtschaft bilden Stickstoffverbindungen (Nitrate), darunter insbesondere Salpeter (NaNO₃) und Salpetersäure (HNO₃), einen unentbehrlichen Grundbestandteil.“"
                            },
                            {
                                "example_id": "bafc4991-0e0c-409d-8e06-b3ba16c53ff2",
                                "sense_id": "29a2b865-4540-3f8f-b6c5-d64cb70274a3",
                                "text": "„Eine Weile hockte ich auf dem niedrigen Hügel und betrachtete die künstliche Landschaft, atmete den Geruch von Kunststoff und Düngemitteln ein und versuchte das Meer an Plantagen zu begreifen.“"
                            },
                            {
                                "example_id": "f6b8b56f-a2fc-44db-a8a6-6e63c379eb0e",
                                "sense_id": "29a2b865-4540-3f8f-b6c5-d64cb70274a3",
                                "text": "„Seit über hundert Jahren werden im Werratal Kaliumsalze für die Herstellung von Düngemitteln gewonnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
