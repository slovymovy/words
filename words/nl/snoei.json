            "senses": [
                {
                    "sense_id": "4cf0d436-acee-3680-ab18-3f52944d14ee",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>snoeien</w>",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het voorjaar <w>snoei</w> ik altijd de rozenstruiken in de tuin.",
                            "target_lang_translations": {
                                "fr": "Au printemps, je <w>taille</w> toujours les rosiers dans le jardin."
                            }
                        },
                        {
                            "text": "Ik <w>snoei</w> de dode takken weg zodat de boom weer beter kan groeien.",
                            "target_lang_translations": {
                                "fr": "J'<w>élague</w> les branches mortes pour que l'arbre puisse mieux repousser."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "persoonsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "première personne du singulier au présent de l'indicatif du verbe « snoeien » (tailler, élaguer)"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "taille",
                                "target_lang_sense_clarification": "1re pers. sing. présent de tailler (végétaux)"
                            },
                            {
                                "target_lang_word": "élague",
                                "target_lang_sense_clarification": "1re pers. sing. présent d'élaguer (arbres)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69574abf-b44f-3c68-862e-2a03eb523958",
                    "sense_definition": "gebiedende wijs van <w>snoeien</w>",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Snoei</w> de heg voordat de zomer begint, dan blijft hij mooi vol.",
                            "target_lang_translations": {
                                "fr": "<w>Taille</w> la haie avant le début de l'été, elle restera ainsi bien dense."
                            }
                        },
                        {
                            "text": "<w>Snoei</w> die overhangende takken alsjeblieft even af.",
                            "target_lang_translations": {
                                "fr": "<w>Élague</w> un peu ces branches qui dépassent, s'il te plaît."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperatief"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "impératif singulier du verbe « snoeien » (taille, élague)"
                    },
                    "translations": {
