                            "plural"
                        ],
                        "form": "sackcloths"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3ac9bd98-415a-3d2f-b9b9-bd59604c6538",
                        "entry_id": "1e806646-feb1-384b-a5ce-e4ca0d1a6db8",
                        "glosses": [
                            "A coarse hessian style of cloth used to make sacks."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e7b39d2b-16af-3068-9caf-8d9ec7f40fb7",
                        "entry_id": "1e806646-feb1-384b-a5ce-e4ca0d1a6db8",
                        "glosses": [
                            "Garments worn as an act of penance."
                        ],
                        "tags": [
                            "also",
                            "countable",
                            "figuratively",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "34ced1bc-e0ac-49a6-9a39-51b1c7152828",
                                "sense_id": "e7b39d2b-16af-3068-9caf-8d9ec7f40fb7",
                                "text": "After he realised the gravity of his crime he spent some time wearing sackcloth and ashes."
                            },
                            {
                                "example_id": "37ad63f8-516a-45c8-9077-8e1b44b8422a",
                                "sense_id": "e7b39d2b-16af-3068-9caf-8d9ec7f40fb7",
                                "text": "Next you saw her alone, a kneeling penitent at the foot of the crucifix; her long fair hair is unbound, and the sackcloth robe is girded by a cord round her slender shape: her hands are clasped, and tears are flowing fast from the quenched radiance of those shadowy eyes;..."
                            },
                            {
                                "example_id": "b79016d0-9649-4ec2-a709-8a12e61d84f0",
                                "sense_id": "e7b39d2b-16af-3068-9caf-8d9ec7f40fb7",
                                "text": "No more ashes, no more sackcloth / And an armband made of black cloth / Will someday never more adorn a sleeve"
                            }
                        ]
                    }
                ],
