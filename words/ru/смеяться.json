                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Дети громко <смеялись> и играли во дворе.",
                            "target_lang_translations": {
                                "en": "The children were <laughing> loudly and playing in the yard.",
                                "nl": "De kinderen <lachten> luid en speelden op het schoolplein.",
