                                "target_senses": [
                                    {
                                        "sense_id": "2e20923c-6a01-3f44-b557-97ee706dff8b",
                                        "entry_id": "79aeeefa-a60c-387f-a7f7-e547085979c3",
                                        "glosses": [
                                            "An unconventionally modern style of fashionable dress originating in England in the 1960s, characterized by ankle-length black trenchcoats and sunglasses."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "afc61358-13f3-34ee-b78b-d70f618eaa7c",
                                        "entry_id": "79aeeefa-a60c-387f-a7f7-e547085979c3",
                                        "glosses": [
                                            "A 1960s British person who dressed in such a style and was interested in modernism and the modern music of the time; the opposite of a rocker."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdbe51ef-ba57-4f85-bc5c-b5edf32b2e35",
                                                "sense_id": "afc61358-13f3-34ee-b78b-d70f618eaa7c",
                                                "text": "It was “Mods” against “Rockers” and the police against both as this quiet seaside town of 28,000 exploded with teen‐age violence during the Easter weekend. […] The “Mods” or “Moderns” wear sharply cut Italian‐style suits and long, pointed “winklepicker” shoes. They ride motor scooters fitted with scores of gleaming accesories^([sic])."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0ada0f4-e0c1-36b5-a1f6-c9d16a67617e",
                                        "entry_id": "79aeeefa-a60c-387f-a7f7-e547085979c3",
                                        "glosses": [
                                            "Clipping of modification."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bf5e0e16-c521-3930-b90b-93bf452d6a74",
                                        "entry_id": "79aeeefa-a60c-387f-a7f7-e547085979c3",
                                        "glosses": [
                                            "An end user-created package containing modifications to the look or behaviour of a video game."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c58cc0f4-defb-408a-a77b-144c5bcb64ec",
                                                "sense_id": "bf5e0e16-c521-3930-b90b-93bf452d6a74",
                                                "text": "Since Doom II, thousands of gamers had begun modifying id's products and making them available for free online. Doom fans would communicate entirely over the Internet to create mods of the game—often never even meeting in person or, for that matter, talking on the phone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28cbc96c-1366-37bf-814f-3580cb011a54",
                                        "entry_id": "79aeeefa-a60c-387f-a7f7-e547085979c3",
                                        "glosses": [
                                            "A moderator, for example on a discussion forum."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "832fad85-5b1c-4ab3-93b5-0064fb09a256",
                                                "sense_id": "28cbc96c-1366-37bf-814f-3580cb011a54",
                                                "text": "The mods had a difficult time deciding whether to believe a story about a man who was attracted to his girlfriend only when she was grieving her dead sister, but it stayed up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "132534c4-f2ff-307e-bbc4-b8c7ec6e349c",
                                        "entry_id": "79aeeefa-a60c-387f-a7f7-e547085979c3",
                                        "glosses": [
                                            "A moderator, for example on a discussion forum.",
                                            "Used to express a wish of removal or, often hyperbolic, harm (as opposed to a literal request to moderators)."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "countable",
                                            "humorous",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cb95548-cbdd-4bb4-a3a6-22fadc9464cb",
                                                "sense_id": "132534c4-f2ff-307e-bbc4-b8c7ec6e349c",
                                                "text": "Mods, kill this guy with hammers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf8451b5-10c2-3aff-8e72-bb057951b035",
                                        "entry_id": "79aeeefa-a60c-387f-a7f7-e547085979c3",
                                        "glosses": [
                                            "A module (file containing a tracker music sequence)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c096e53-889a-4ced-878c-f8080c0308a6",
                                                "sense_id": "cf8451b5-10c2-3aff-8e72-bb057951b035",
                                                "text": "I'd like to convert some of the arch^([sic]) mods back into Amiga mods since I don't have the original Amiga versions."
                                            },
                                            {
                                                "example_id": "a33c7755-d6dc-43ab-83e0-1399abbba064",
                                                "sense_id": "cf8451b5-10c2-3aff-8e72-bb057951b035",
                                                "text": "These mods, while usually having the distinctive bleep and beep quality of transistor-generated tones, are often astonishingly creative and rich in expressive nuances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7584b2fa-9fcc-37a4-a1fa-f0ae816e966c",
                                        "entry_id": "79aeeefa-a60c-387f-a7f7-e547085979c3",
                                        "glosses": [
                                            "A moderately difficult route."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28427e3d-07c5-3204-bf6d-114ce1f04db1",
                                        "entry_id": "79aeeefa-a60c-387f-a7f7-e547085979c3",
                                        "glosses": [
                                            "Moderations: university examinations generally taken in the first year."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87867783-0dbe-4e7e-894b-b07dc71814ad",
                                                "sense_id": "28427e3d-07c5-3204-bf6d-114ce1f04db1",
                                                "text": "It will thus be seen that, however well a boy may have been trained at school, his time may be amply occupied in preparing for Mods. during his first year and a half of residence at Oxford."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "568f2e3f-0767-3ba7-bf5b-cb2c99f6e884",
                                        "entry_id": "79aeeefa-a60c-387f-a7f7-e547085979c3",
