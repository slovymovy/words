                        "examples": [
                            {
                                "example_id": "f253f97c-b115-4b3f-a44b-6a8659e53f5a",
                                "sense_id": "32d3f466-71be-3aeb-9282-d0837a03532f",
                                "text": "Occasionally a church gleams white, its spire thin on a leekish onion of dark grey; and then a small town spreads itself as the trees fall away — [...]"
                            },
                            {
                                "example_id": "5e301836-96d5-4268-9747-390dee559101",
                                "sense_id": "32d3f466-71be-3aeb-9282-d0837a03532f",
                                "text": "In describing garlic, Coghan contradicts other writers, for example Newton, who claims that it is a \"grosse pothearb\" that creates \"naughty and corrupte iuyce,\" which in turn engenders a putrefying \"leekish choler\" in the body."
                            }
                        ]
