                "senses": [
                    {
                        "sense_id": "1dd2ec1a-4363-3fdd-960d-43f9045b5cb7",
                        "entry_id": "3480b3f9-28fa-3ec7-b751-f56aafc605c1",
                        "glosses": [
                            "flexible Mappe mit Vorrichtung zum Einheften gelochter Blätter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d55d162-77f8-4392-ab58-983be971f894",
                                "sense_id": "1dd2ec1a-4363-3fdd-960d-43f9045b5cb7",
                                "text": "„Jeder Schnellhefter hat sein Schwänzchen, und Pinneberg liest auf dem Schwänzchen Namen, Fichte liest er, dann Filchner, dann Fischer.“"
                            },
                            {
                                "example_id": "bf85f044-b31e-4b52-9425-7910503ac612",
                                "sense_id": "1dd2ec1a-4363-3fdd-960d-43f9045b5cb7",
                                "text": "„Sie waren vollständig bepackt mit Aktenordnern und Schnellheftern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
