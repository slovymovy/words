                    {
                        "translation_id": "149a68bb-2659-433e-a3f9-6a66d105c4ff",
                        "source_entry_id": "d3845629-05ca-3d82-a116-82351deb1b65",
                        "source_sense_id": "2f264da9-6d3d-3fc4-9a50-233b93e0241d",
                        "target_lang_word": "vagevuur",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vagevuur",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "415d0a2c-d326-34ef-862e-a47bc2087be1",
                                        "entry_id": "720a089b-882a-39f3-a1e6-fe4d39f866ba",
                                        "glosses": [
                                            "een toestand waarin de zielen van personen die gestorven zijn in vriendschap met God, zonder dat ze volledig zuiver waren, gereinigd worden, zodat ze de hemel kunnen binnengaan"
                                        ],
                                        "tags": [
                                            "rooms-katholiek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e344aa6-e60e-4cd5-b679-ca5cbc108a6f",
                                                "sense_id": "415d0a2c-d326-34ef-862e-a47bc2087be1",
                                                "text": "Toen hij kwam te overlijden, ging zijn ziel naar het vagevuur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cca52ea-53d7-3612-bbe4-a638d22b96cd",
                                        "entry_id": "720a089b-882a-39f3-a1e6-fe4d39f866ba",
                                        "glosses": [
                                            "onzekere situatie"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c51eab6c-fc87-457b-b41a-6e6ce7b58aef",
                                                "sense_id": "2cca52ea-53d7-3612-bbe4-a638d22b96cd",
                                                "text": "Omdat het aftellen tot de verkiezingen in november begonnen is, vinden de gesprekken over de begrotingen plaats in een politiek vagevuur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "338ba3ad-ccb8-4f3d-812b-964598c29a80",
                        "source_entry_id": "d3845629-05ca-3d82-a116-82351deb1b65",
                        "source_sense_id": "2f264da9-6d3d-3fc4-9a50-233b93e0241d",
                        "target_lang_word": "Fegefeuer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fegefeuer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13152ccb-2fa1-396f-8109-66a787070c43",
                                        "entry_id": "3d5108a6-563b-3699-bd07-c5ea11e19204",
                                        "glosses": [
                                            "nach der römisch-katholischen Lehre ein Prozess der Läuterung, in dem die Seele eines Verstorbenen auf den Himmel vorbereitet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2508c75-a7ed-46bf-910d-50b8272d9ea3",
                                                "sense_id": "13152ccb-2fa1-396f-8109-66a787070c43",
                                                "text": "Nach katholischer Lehre ist das Fegefeuer nicht die Vor-Hölle, sondern der Vor-Himmel."
                                            },
                                            {
                                                "example_id": "f07c4140-e92f-4c31-a5b4-61311888abfc",
                                                "sense_id": "13152ccb-2fa1-396f-8109-66a787070c43",
                                                "text": "„Auf die weitere Wirkungsgeschichte des Fegefeuers als eines Schwellenraumes der Buße und Reinigung nimmt gerade Dantes Darstellung dieses Bereiches enormen Einfluss.“"
                                            },
                                            {
                                                "example_id": "9c04acb6-10e7-4f5c-b2c5-a091f57c492b",
                                                "sense_id": "13152ccb-2fa1-396f-8109-66a787070c43",
                                                "text": "„Da war der alte Lenkes endlich in den Ruhestand geschickt worden, und seine ständigen Predigten von Gottes Strafe, dem ewigen Fegefeuer und dem Jüngsten Gericht hatten ein Ende gehabt.“"
                                            },
                                            {
                                                "example_id": "0a293323-ccb9-45c0-83cc-64ffa0181b60",
                                                "sense_id": "13152ccb-2fa1-396f-8109-66a787070c43",
                                                "text": "„Beim Nachtmahl sagte er mir, nur über eines sei er glücklich, daß er den Klauen der Mönche entronnen sei, deren Quälereien fünfzehn Jahre hindurch für ihn ein Fegefeuer gewesen waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c562d89-1ae4-4681-a5c2-832fc8cbc757",
                        "source_entry_id": "d3845629-05ca-3d82-a116-82351deb1b65",
                        "source_sense_id": "2f264da9-6d3d-3fc4-9a50-233b93e0241d",
                        "target_lang_word": "чистилище",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "чистилище",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "29d1a076-eaf1-3250-bb78-60f92a90af02",
                                        "entry_id": "d88587e2-405e-3ef1-9dad-e4b4711cc33c",
                                        "glosses": [
                                            "религ. согласно католическому вероучению — место, где души умерших грешников очищаются от не искуплённых при жизни грехов"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45ecefb7-1512-39d1-9f38-4a2689cbc683",
                                        "entry_id": "d88587e2-405e-3ef1-9dad-e4b4711cc33c",
                                        "glosses": [
                                            "перен. временное место страданий"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35e70114-fc6f-4933-aaae-e0e20386d023",
                                                "sense_id": "45ecefb7-1512-39d1-9f38-4a2689cbc683",
                                                "text": "Наступал конец второго учебного года, а с ним и конец учения в духовном училище, о чем все мы, выпускные, мечтали, как об освобождении из чистилища"
                                            },
                                            {
                                                "example_id": "d97bdcfc-7e7e-4dfa-b00a-55672277c4e0",
                                                "sense_id": "45ecefb7-1512-39d1-9f38-4a2689cbc683",
                                                "text": "Я умерла заживо и уже терплю загробные муки. Это чистилище какое-то! ― терзалась Людмила Александровна в одиночестве своем, ломая холодный руки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf6a8979-bc9f-3465-ae2e-6d3177b8fc6c",
                                        "entry_id": "d88587e2-405e-3ef1-9dad-e4b4711cc33c",
                                        "glosses": [
                                            "перен. место, где что-либо чистят, вычищают"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "098375d7-a993-48cc-936e-acf05f0f06ee",
                                                "sense_id": "cf6a8979-bc9f-3465-ae2e-6d3177b8fc6c",
                                                "text": "Писания свои прилежно вычищай: Ведь из чистилища лишь идут в рай."
                                            },
                                            {
                                                "example_id": "72fb4b4c-778e-4986-bd76-eb379430f6dc",
                                                "sense_id": "cf6a8979-bc9f-3465-ae2e-6d3177b8fc6c",
                                                "text": "Освободившись из карантинного чистилища, я поскакал в Царство Польское по прямой дороге, считая ее, как следовало думать, ближайшим путем к месту моего назначения."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
