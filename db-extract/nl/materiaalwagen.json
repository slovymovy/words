                        "examples": [
                            {
                                "example_id": "73d2a6bb-56c3-4ed6-84d0-d59c0cafbe64",
                                "sense_id": "09ac58fd-0344-3b6c-9bf3-fafd59b4c757",
                                "text": "Vijf kilometer verder voltrekt zich een klein wonder, als hij de neutrale materiaalwagen ziet."
                            },
                            {
                                "example_id": "07f5463e-0985-48ef-a091-e5933b4c357e",
                                "sense_id": "09ac58fd-0344-3b6c-9bf3-fafd59b4c757",
                                "text": "De Nieuw-Zeelander reed in de voorjaarsklassieker in de kopgroep toen hij werd aangereden door een neutrale materiaalwagen. Hij brak zijn sleutelbeen op meerdere plaatsen en kon maandenlang niet in actie komen."
                            },
                            {
                                "example_id": "9682a070-d5e7-4905-842d-9a9260cde450",
                                "sense_id": "09ac58fd-0344-3b6c-9bf3-fafd59b4c757",
                                "text": "De chauffeur van de bewuste materiaalwagen zag niet dat een auto van FDJ was gestopt om Chavanel, die een lekke band had, bij te staan. De materiaalwagen knalde vol op de FDJ-auto, waarna die auto vooruit schoot en vervolgens Chavanal aanreed."
