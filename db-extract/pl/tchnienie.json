                "translations": [
                    {
                        "translation_id": "2d248c88-849e-4860-abb4-3470f26af3bb",
                        "source_entry_id": "89aebfa3-8e1a-3d02-aef8-42aaa3620b5a",
                        "source_sense_id": "edd13790-62a4-3363-9f2d-7fbfe9a5c9cd",
                        "target_lang_word": "Atemzug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Atemzug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52085dad-965c-3ce2-9238-0c21d1e9d615",
                                        "entry_id": "a1305289-3544-32c4-a640-0219056d6c2e",
                                        "glosses": [
                                            "einzelner Vorgang des Ein- oder Ausatmens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c009d46c-e2bf-4648-a132-1585b9c4be7c",
                                                "sense_id": "52085dad-965c-3ce2-9238-0c21d1e9d615",
                                                "text": "„Jene Frau aber, die es gewohnt war, aus der Schnelligkeit eines Augenaufschlags, aus der Länge eines Blicks, aus der Heftigkeit eines Atemzuges, aus der Haltung des Kopfes oder aus anderen verräterischen Kleinigkeiten ihre Schlüsse zu ziehen, jene Frau, die sich in dieser Umgebung wahrscheinlich einen siebten instinktiven Sinn erworben hatte, spürte etwas und trat auf Ambly zu.“"
                                            },
                                            {
                                                "example_id": "c6780dbd-47e4-4323-90f3-8acb0c316833",
                                                "sense_id": "52085dad-965c-3ce2-9238-0c21d1e9d615",
                                                "text": "„Ein Dutzend Atemzüge lang betrachtete der größte Jäger Deutschlands das größte Säugetier der Erde.“"
                                            },
                                            {
                                                "example_id": "12fa4540-46ed-4d13-87fd-ff1ba44c532c",
                                                "sense_id": "52085dad-965c-3ce2-9238-0c21d1e9d615",
                                                "text": "„Bis zum letzten Atemzug hatte sie Efe verprochen, sie nie im Stich zu lassen.“"
                                            },
                                            {
                                                "example_id": "27403b13-5220-4585-a645-0866aeca513f",
                                                "sense_id": "52085dad-965c-3ce2-9238-0c21d1e9d615",
                                                "text": "„Ihre Atemzüge werden kurz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
