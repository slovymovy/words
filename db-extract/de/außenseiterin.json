                ],
                "senses": [
                    {
                        "sense_id": "4d81794e-bd4d-31a6-b23b-4163f56d530e",
                        "entry_id": "087d3094-804a-3b70-888a-d1abfbf40e68",
                        "glosses": [
                            "weibliche Person, von der angenommen wird, dass sie keine Gewinnchancen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08f6bb67-f242-4c0c-b5c3-55b560c77d0d",
                                "sense_id": "4d81794e-bd4d-31a6-b23b-4163f56d530e",
                                "text": "„Mona Barthel geht bei den Australian Open in Melbourne am Freitag als krasse Außenseiterin in das Drittrunden-Match gegen die an Position drei gesetzte Wiktoria Asarenka (Weißrussland).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f3ae5411-f57c-381c-874c-1a9ea0a2d46b",
                        "entry_id": "087d3094-804a-3b70-888a-d1abfbf40e68",
                        "glosses": [
                            "weibliche Person, die nicht in einer Gruppe integriert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ff34837-60a3-48c3-be7b-0b4c352cb763",
                                "sense_id": "f3ae5411-f57c-381c-874c-1a9ea0a2d46b",
                                "text": "„Im Jahr 2011 wurde die Außenseiterin Haley Gouverneurin, die erste Frau, die erste Tochter von Immigranten, damals war sie kaum bekannt und erst 38 Jahre alt.“"
                            },
                            {
                                "example_id": "84713402-bd26-4d35-8e08-5d10c433693e",
                                "sense_id": "f3ae5411-f57c-381c-874c-1a9ea0a2d46b",
                                "text": "„Die vagierende Frühbottin, die sich für so manche Demütigung mit so mancher Drohung gerächt haben mag, gehörte zu jenen wehr- und schutzlosen Außenseiterinnen, die dem Teufel in den Armen lagen und von den Wehrhaften und Beschützten ohne Risiko zur Hölle geschickt werden konnten.“"
                            },
                            {
                                "example_id": "8586eb53-e25a-4b10-a985-adee64dacba0",
                                "sense_id": "f3ae5411-f57c-381c-874c-1a9ea0a2d46b",
                                "text": "„Inmitten all der Leute kam sie sich vor wie eine Außenseiterin.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
