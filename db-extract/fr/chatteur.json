                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f04198d-8483-424d-8820-ef46a61e7c5d",
                        "source_entry_id": "05a69ef0-e810-3ad8-b9d0-3bc04896100d",
                        "source_sense_id": "f9635976-c3a2-3b40-b63a-be8cb3cad425",
                        "target_lang_word": "chatter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chatter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f85ca0b6-dd3a-3506-b15f-0f8dc696c496",
                                        "entry_id": "73c75052-15a6-3ffd-b129-04fcd0a7b668",
                                        "glosses": [
                                            "Talk, especially meaningless or unimportant talk."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10e171e5-318a-43fb-978c-0d25da73b0ff",
                                                "sense_id": "f85ca0b6-dd3a-3506-b15f-0f8dc696c496",
                                                "text": "Although hardly coming under my theme, I cannot omit this: \"Against a woman's chatter: Taste at night fasting a root of radish, that day the chatter cannot harm thee.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75fc2605-3980-3119-8c62-fb5c7008afd7",
                                        "entry_id": "73c75052-15a6-3ffd-b129-04fcd0a7b668",
                                        "glosses": [
                                            "The sound of talking."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72b03cd0-281f-32f5-9152-581da9a557aa",
                                        "entry_id": "73c75052-15a6-3ffd-b129-04fcd0a7b668",
                                        "glosses": [
                                            "The vocalisations of a Eurasian magpie, Pica pica."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "db44ac2f-a088-3519-8464-ac264d1ec9fe",
                                        "entry_id": "73c75052-15a6-3ffd-b129-04fcd0a7b668",
                                        "glosses": [
                                            "The vocalisations of various birds or other animals."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "214c9d92-da3a-4904-83fe-c557ab7484f0",
                                                "sense_id": "db44ac2f-a088-3519-8464-ac264d1ec9fe",
                                                "text": "The hare cried and complained of the terrible February cold and the disgusting chatter of the owls[.]"
                                            },
                                            {
                                                "example_id": "e1d5138f-31ff-44ba-81bc-b421baa784a7",
                                                "sense_id": "db44ac2f-a088-3519-8464-ac264d1ec9fe",
                                                "text": "At dawn and at sunset the howler monkeys screamed together and the parakeets broke into shrill chatter, but during the hot hours of the day only the full drone of insects, like the beat of a distant surf, filled the ear, while nothing moved amid the solemn vistas of stupendous trunks, fading away into the darkness which held us in."
                                            },
                                            {
                                                "example_id": "345459e4-375a-48fe-92c6-99e98018933a",
                                                "sense_id": "db44ac2f-a088-3519-8464-ac264d1ec9fe",
                                                "text": "The wind rose as the earth darkened, so that fading chatters of woodland animals were countered by the strengthening sounds of waving trees […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66a27350-ef10-3911-98ce-437a3befd249",
                                        "entry_id": "73c75052-15a6-3ffd-b129-04fcd0a7b668",
                                        "glosses": [
                                            "An intermittent noise, as from vibration."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5e2d543-0fec-4429-89cf-ea0d32e2fe89",
                                                "sense_id": "66a27350-ef10-3911-98ce-437a3befd249",
                                                "text": "Proper brake adjustment will help to reduce the chatter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61010195-9eef-350b-8561-bc507a46ef2c",
                                        "entry_id": "73c75052-15a6-3ffd-b129-04fcd0a7b668",
                                        "glosses": [
                                            "In national security, the degree of communication between suspect groups and individuals, used to gauge the degree of expected terrorist activity."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a811908-7320-4dfa-a4a5-8e6e8d94d1c9",
                                                "sense_id": "61010195-9eef-350b-8561-bc507a46ef2c",
                                                "text": "The NSA is concerned about increased chatter between known terror groups."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "131a1b05-3719-3e98-864c-60d0b8c84c76",
                                        "entry_id": "73c75052-15a6-3ffd-b129-04fcd0a7b668",
                                        "glosses": [
                                            "The situation where a drill or similar tool vibrates and tears the material rather than cutting it cleanly."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "chatter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e0f1f2d-4edb-364f-98c0-eddbddc1f577",
                                        "entry_id": "b47829c6-7743-3509-a518-b32db18309a4",
                                        "glosses": [
                                            "To talk idly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b50502d4-151b-4013-a637-785d90577d79",
                                                "sense_id": "7e0f1f2d-4edb-364f-98c0-eddbddc1f577",
                                                "text": "They knitted and chattered the whole time."
                                            },
                                            {
                                                "example_id": "52901761-1456-4f98-a346-c27a6186dff8",
                                                "sense_id": "7e0f1f2d-4edb-364f-98c0-eddbddc1f577",
                                                "text": "That teacheth trickes eleuen and twentie long, / To tame a ſhrew, and charme her chattering tongue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b26fbf5-2412-3f5a-a621-c8a53ad3bd27",
                                        "entry_id": "b47829c6-7743-3509-a518-b32db18309a4",
                                        "glosses": [
                                            "To make a noise by rapid collisions."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "923acaea-15da-4199-a7dc-e73ed1fb39aa",
                                                "sense_id": "8b26fbf5-2412-3f5a-a621-c8a53ad3bd27",
                                                "text": "He was so cold that his teeth were chattering."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d687982-9e42-3e61-825e-7f023636a8cb",
                                        "entry_id": "b47829c6-7743-3509-a518-b32db18309a4",
                                        "glosses": [
                                            "To utter sounds which somewhat resemble language, but are inarticulate and indistinct."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddc7f89b-f55f-4808-8037-f252cc1237a3",
                                                "sense_id": "3d687982-9e42-3e61-825e-7f023636a8cb",
                                                "text": "The jay makes answer, as the magpie chatters with delight."
                                            },
                                            {
                                                "example_id": "24f2a94d-9047-4076-9bde-bd056c2cdfe7",
                                                "sense_id": "3d687982-9e42-3e61-825e-7f023636a8cb",
                                                "text": "Is your cat intently staring out the window at a bird on a branch and “chattering” in a kind of shaky, high-pitched, breathy way? If so, she is expressing excitement at what she's observing (or maybe the desire to attack what she sees as prey)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chatter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
