                    {
                        "sense_id": "850cf611-fdfe-3c99-850d-af580dfae6dd",
                        "entry_id": "f69c3191-f84f-3475-a845-0c8a8a0e0416",
                        "glosses": [
                            "regional norddeutsch, abwertend: zu sehr verdünntes oder geschmackloses Getränk oder gleichartige Suppe; unappetitliche Flüssigkeit"
                        ],
                        "tags": [
                            "auch verallgemeinert"
                        ],
                        "examples": [
                            {
                                "example_id": "8a51613b-40a8-4ae6-851e-6959fea9663c",
                                "sense_id": "850cf611-fdfe-3c99-850d-af580dfae6dd",
                                "text": "Eine solche Plörre ist mir noch nie serviert worden."
                            },
                            {
                                "example_id": "1566c37e-5f73-41fb-8a54-9c284d4452b3",
                                "sense_id": "850cf611-fdfe-3c99-850d-af580dfae6dd",
                                "text": "Im Eimer steht schon wieder eine stinkende Plörre."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49f97ffd-b49b-420c-8cab-6861f6402d04",
                        "source_entry_id": "f69c3191-f84f-3475-a845-0c8a8a0e0416",
                        "source_sense_id": "850cf611-fdfe-3c99-850d-af580dfae6dd",
                        "target_lang_word": "eau de vaisselle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eau de vaisselle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "659f7fec-288f-38dc-8346-e7e72042af3a",
                                        "entry_id": "66c8d0ec-691d-392b-bf07-acb2c30f68b3",
                                        "glosses": [
                                            "Eau sale parce qu’elle a été utilisée pour laver la vaisselle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7dbd18e-629d-4032-aa43-66b1bc15a905",
                                                "sense_id": "659f7fec-288f-38dc-8346-e7e72042af3a",
                                                "text": "Elle essuya, sur son tablier, ses mains visqueuses d’eau de vaisselle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "078f05e5-7c80-4b94-b720-4dd7ea8a284f",
                        "source_entry_id": "f69c3191-f84f-3475-a845-0c8a8a0e0416",
                        "source_sense_id": "850cf611-fdfe-3c99-850d-af580dfae6dd",
                        "target_lang_word": "jus de chaussette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jus de chaussette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ebf8fd1a-c2dd-3b94-b4a6-4e060dd4612a",
                                        "entry_id": "da3b45f7-f256-337b-ba47-7878ac638950",
                                        "glosses": [
                                            "Café fade et insipide."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "751be174-ac6d-4e8d-abff-dd1435972463",
                                                "sense_id": "ebf8fd1a-c2dd-3b94-b4a6-4e060dd4612a",
                                                "text": "Celui d’un breuvage à la fois fade et insipide, bu à la va-vite sur la route ou entre deux trains. C’est le fameux « jus de chaussette » que l’on boit chez grand-mère, hérité de cette époque – pas si lointaine – où, faute de filtres en papier, on passait le café au travers d’une poche en tissu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99c84245-769a-46ba-96db-bb3968367b84",
                        "source_entry_id": "f69c3191-f84f-3475-a845-0c8a8a0e0416",
                        "source_sense_id": "850cf611-fdfe-3c99-850d-af580dfae6dd",
                        "target_lang_word": "lavasse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lavasse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f0bc5292-bf3b-363e-b504-cff938a78cab",
                                        "entry_id": "b65f7aa0-ffbb-3b0d-a3ea-400be8ed5895",
                                        "glosses": [
                                            "sauf : Averse soudaine et abondante."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67ca6f17-0eaf-4a29-bf24-01cb21dbd654",
                                                "sense_id": "f0bc5292-bf3b-363e-b504-cff938a78cab",
                                                "text": "[Les filles d’honneur] se trouvèrent dans un agréable désordre, par une lavasse de pluie artificielle, inopinément survenue..."
                                            },
                                            {
                                                "example_id": "2893f1d2-2c73-40e8-98dd-dcc5ab6141c6",
                                                "sense_id": "f0bc5292-bf3b-363e-b504-cff938a78cab",
                                                "text": "Après une lavasse de trois ou quatre heures ils ressemblaient tous à des fossoyeurs de mines ou des tireurs d’ocre et ne savaient comme échapper parmi le terrain gros et visqueux, ni où affermir le pied dans ces étroites tranchées …."
                                            },
                                            {
                                                "example_id": "653bffd4-bf30-4bf2-affc-2c16fe80193a",
                                                "sense_id": "f0bc5292-bf3b-363e-b504-cff938a78cab",
                                                "text": "C'est qu’avec la noirceur est survenue la pluie, une de ces lavasses d’octobre, violente, drue, froide, que le vent d’est ramasse en paquets pour la jeter aux carreaux avec des claquements de linge mouillé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04dce632-bf44-3783-b074-28afb4f5a4c0",
                                        "entry_id": "b65f7aa0-ffbb-3b0d-a3ea-400be8ed5895",
                                        "glosses": [
                                            "Soupe, sauce ou boisson où l’eau est en excès, ou tout simplement insipide."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51e4ca83-860a-4249-a5ea-fdf6e2aef9ff",
                                                "sense_id": "04dce632-bf44-3783-b074-28afb4f5a4c0",
                                                "text": "- Bon, d’accord, grommela l’autre ; pouah ! c’est de la lavasse...\n- Il reste exactement deux verres, c’est de la vraie lavasse, mais buvons et trinquons !"
                                            },
                                            {
                                                "example_id": "320b259e-7b4d-40c8-af57-8cb480de3b16",
                                                "sense_id": "04dce632-bf44-3783-b074-28afb4f5a4c0",
                                                "text": "– Prends la bouilloire et fais-nous du café. Du bon, hein ? Pas de la lavasse. Tu iras en porter une tasse à l’officier allemand."
                                            },
                                            {
                                                "example_id": "14741d2b-11c7-45cc-a9f6-5742f52fae08",
                                                "sense_id": "04dce632-bf44-3783-b074-28afb4f5a4c0",
                                                "text": "Obliquant par notre portail grand ouvert (sinon, la crue l'enfoncerait) et traversant en trois coups de gaffe la pelouse enfouie sous un mètre de lavasse jaunâtre, la barque vient de buter sur la cinquième marche du perron, à peine recouverte."
                                            },
                                            {
                                                "example_id": "3702e1d7-854b-4e0c-bca0-7d72b7a4964e",
                                                "sense_id": "04dce632-bf44-3783-b074-28afb4f5a4c0",
                                                "text": "Ton Kim prétend que notre Bollinger, c’est de la lavasse !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ac50e63-7c94-3b60-86c1-8842c1ba9db0",
                                        "entry_id": "b65f7aa0-ffbb-3b0d-a3ea-400be8ed5895",
                                        "glosses": [
                                            "Quelque chose sans saveur, sans intérêt."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c855c57f-8aba-416b-ae3a-a673d432505c",
                                                "sense_id": "4ac50e63-7c94-3b60-86c1-8842c1ba9db0",
                                                "text": "C’est qu’il n’y a pas à dire, mon vieux, nous sommes imbibés et saturés de toute une lavasse de lieux communs et de formules !"
                                            },
                                            {
                                                "example_id": "118c97db-2482-4f16-b05a-5b307bd24c16",
                                                "sense_id": "4ac50e63-7c94-3b60-86c1-8842c1ba9db0",
                                                "text": "« Je viens de relire la début de Nuit noire. C’est de la lavasse…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14cdaeb0-8202-38e0-a521-6d8842ee1601",
                                        "entry_id": "b65f7aa0-ffbb-3b0d-a3ea-400be8ed5895",
                                        "glosses": [
                                            "Personne sans énergie, sans vigueur ; lavette."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8959f545-1c50-4069-9782-9fbe3637f5f6",
                                                "sense_id": "14cdaeb0-8202-38e0-a521-6d8842ee1601",
                                                "text": "Moyennant la forte somme, le cher maître lui a proposé d’arranger le coup. Seulement Coras n’était pas une lavasse, de plus il était, aux dires de sa domestique, très jaloux."
                                            }
                                        ]
                                    }
                                ]
                            },
