{
    "word_family": [
        "windiness",
        "windward",
        "windlessly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1d3e0e4a-23b4-3c5a-b139-23211b9761fd",
                    "sense_definition": "Characterized by, having, or exposed to strong currents of wind.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a cold and <w>windy</w> day, so we decided to stay indoors.",
                            "target_lang_translations": {
                                "ru": "День был холодный и <w>ветреный</w>, поэтому мы решили остаться дома."
                            }
                        },
                        {
                            "text": "Hold onto your hat because it is very <w>windy</w> outside.",
                            "target_lang_translations": {
                                "ru": "Держи шляпу, потому что на улице очень <w>ветрено</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "blowy",
                        "blustery",
                        "breezy"
                    ],
                    "antonyms": [
                        "calm",
                        "windless"
                    ],
                    "common_phrases": [
                        "windy day",
                        "windy weather",
                        "cold and windy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся сильным ветром или подверженный его воздействию (о погоде, дне)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ветреный",
                                "target_lang_sense_clarification": "о погоде, дне"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad1b5717-c58b-3fa0-a2e9-a2b9028b948e",
                    "sense_definition": "Unsheltered and open to gusts of wind.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We waited for the bus in a <w>windy</w> shelter near the corner.",
                            "target_lang_translations": {
                                "ru": "Мы ждали автобус на <w>продуваемой ветром</w> остановке неподалёку от угла."
                            }
                        },
                        {
                            "text": "They pitched their tent on a high, <w>windy</w> hill overlooking the sea.",
                            "target_lang_translations": {
                                "ru": "Они поставили палатку на высоком, <w>открытом всем ветрам</w> холме с видом на море."
                            }
                        }
                    ],
                    "synonyms": [
                        "breezy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Открытый ветрам, незащищённый от порывов ветра (о месте)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обдуваемый всеми ветрами",
                                "target_lang_sense_clarification": "о месте или холме"
                            },
                            {
                                "target_lang_word": "ветреный",
                                "target_lang_sense_clarification": "открытый ветру"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2881859c-9462-3e4a-8013-7d898211d095",
                    "sense_definition": "Having many bends, curves, or turns; winding.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car drove slowly along the narrow, <w>windy</w> mountain road.",
                            "target_lang_translations": {
                                "ru": "Машина медленно ехала по узкой, <w>извилистой</w> горной дороге."
                            }
                        },
                        {
                            "text": "We followed a <w>windy</w> path through the thick forest until we reached the river.",
                            "target_lang_translations": {
                                "ru": "Мы шли по <w>петляющей</w> тропинке сквозь густой лес, пока не дошли до реки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "windy road",
                        "windy path"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий множество изгибов и поворотов (о дороге, тропинке)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извилистый",
                                "target_lang_sense_clarification": "о дороге, тропе"
                            },
                            {
                                "target_lang_word": "петляющий",
                                "target_lang_sense_clarification": "о пути"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cbfc836-88a3-3fcf-867c-1d66f9e0bf57",
                    "sense_definition": "Using far too many words, especially in an empty or pompous manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician delivered a long, <w>windy</w> speech that answered none of our questions.",
                            "target_lang_translations": {
                                "ru": "Политик произнёс длинную, <w>многословную</w> речь, в которой не ответил ни на один из наших вопросов."
                            }
                        },
                        {
                            "text": "I grew tired of his <w>windy</w> explanations and asked him to get straight to the point.",
                            "target_lang_translations": {
                                "ru": "Я устал от его <w>пространных</w> объяснений и попросил говорить прямо по существу."
                            }
                        }
                    ],
                    "synonyms": [
                        "diffuse",
                        "prolix",
                        "verbose",
                        "wordy"
                    ],
                    "common_phrases": [
                        "windy speech"
                    ],
                    "target_lang_definitions": {
                        "ru": "Многословный, напыщенный и пустой (о речи или стиле)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "многословный",
                                "target_lang_sense_clarification": "о речи, тексте"
                            },
                            {
                                "target_lang_word": "пространный",
                                "target_lang_sense_clarification": "длинный и пустой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8bf1e20-3a83-355d-bb9f-bacd031526c2",
                    "sense_definition": "Empty, boastful, and lacking substance or truth.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nobody trusted the candidate because of his <w>windy</w> promises.",
                            "target_lang_translations": {
                                "ru": "Никто не доверял кандидату из-за его <w>пустых</w> обещаний."
                            }
                        },
                        {
                            "text": "Her threats turned out to be nothing more than <w>windy</w> rhetoric.",
                            "target_lang_translations": {
                                "ru": "Её угрозы оказались не более чем <w>пустопорожней</w> риторикой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "windy promises"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пустой, хвастливый и лишённый реального содержания или правды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустой",
                                "target_lang_sense_clarification": "лишённый содержания, хвастливый"
                            },
                            {
                                "target_lang_word": "пустословный",
                                "target_lang_sense_clarification": "о словах, обещаниях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b593d9f-b6ca-36b2-9611-8181cb967270",
                    "sense_definition": "Suffering from or causing an accumulation of gas in the digestive tract.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eating too many beans often makes him feel quite <w>windy</w> and uncomfortable.",
                            "target_lang_translations": {
                                "ru": "От избытка бобовых у него часто <w>пучит живот</w> и возникает дискомфорт."
                            }
                        },
                        {
                            "text": "Certain spicy foods can leave you feeling bloated and <w>windy</w>.",
                            "target_lang_translations": {
                                "ru": "Некоторая острая еда может вызывать вздутие и <w>газы</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "flatulent",
                        "gassy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to describe flatulence"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Страдающий от скопления газов в кишечнике или вызывающий его."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "страдающий метеоризмом",
                                "target_lang_sense_clarification": "при пучении живота"
                            },
                            {
                                "target_lang_word": "пучащий",
                                "target_lang_sense_clarification": "о еде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fef7271-2738-35c7-9f43-9dadd35e9211",
                    "sense_definition": "Feeling nervous, apprehensive, or frightened.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers grew <w>windy</w> as the enemy artillery drew nearer to their trench.",
                            "target_lang_translations": {
                                "ru": "Солдаты <w>струсили</w>, когда вражеская артиллерия подобралась ближе к их окопу."
                            }
                        },
                        {
                            "text": "He tried to appear brave, but everyone could see he was getting <w>windy</w>.",
                            "target_lang_translations": {
                                "ru": "Он пытался казаться храбрым, но всем было видно, что он <w>дрейфит</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Chiefly military slang meaning scared or nervous"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "Rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нервничающий, испытывающий страх или опасение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "струсивший",
                                "target_lang_sense_clarification": "испуганный (воен. сленг)"
                            },
                            {
                                "target_lang_word": "напуганный",
                                "target_lang_sense_clarification": "испытывающий тревогу или страх"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b5adcca2-f911-3b20-bca3-e129adfc45ef",
                    "sense_definition": "An expulsion of gas from the bowels.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The naughty child let out a loud <w>windy</w> and giggled uncontrollably.",
                            "target_lang_translations": {
                                "ru": "Непослушный ребёнок громко <w>пукнул</w> и безудержно захихикал."
                            }
                        },
                        {
                            "text": "He blamed the sudden foul smell on a silent <w>windy</w>.",
                            "target_lang_translations": {
                                "ru": "Он свалил вину за внезапный неприятный запах на чей-то тихий <w>пук</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal slang term for flatulence"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выделение кишечных газов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пук",
                                "target_lang_sense_clarification": "разг., звук или акт выпускания газов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}