                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ddfa3c0-861c-3b83-8984-e9f91fed291e",
                                        "entry_id": "874e3318-7576-343a-b99b-3c45863a9e6c",
