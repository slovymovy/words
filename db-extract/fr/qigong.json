                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87de361e-d076-4112-a22e-82180c006dd0",
                                                "sense_id": "07d67260-8cfe-32b7-9892-f4cbcc0c4e30",
                                                "text": "Studying Tai Ji Men, a menpai (something similar to a \"school\") of Qi Gong rooted in esoteric Taoism, whose leader was persecuted in the 1990s in Taiwan, although later found innocent of all charges, I came across an extraordinary tale that can serve as a lesson in this field."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
