            "senses": [
                {
                    "sense_id": "49ec67e3-7310-3ca3-836f-d93a92f5978d",
                    "sense_definition": "Qui émane d'une autorité reconnue ou d'un gouvernement, qui a une valeur légale ou certifiée.",
