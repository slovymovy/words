                "senses": [
                    {
                        "sense_id": "62464dba-fbe1-307a-ace6-589b49bd6704",
                        "entry_id": "6331cefb-e995-3f59-a0e6-e8caf06af205",
                        "glosses": [
                            "podawane doustnie wyselekcjonowane kultury bakteryjne lub drożdży, najczęściej pałeczki kwasu mlekowego, których zadaniem jest korzystne dla zdrowia działanie w przewodzie pokarmowym, poprzez immunomodulację oraz zachowywanie prawidłowej flory fizjologicznej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11b7bd8b-9c90-4d76-be02-87915a6967ac",
                                "sense_id": "62464dba-fbe1-307a-ace6-589b49bd6704",
                                "text": "Kapusta kiszona jest znacznie tańsza niż suplementy diety, które można kupić w sklepach ze zdrową żywnością, i jest o wiele bogatsza w probiotyki, tj. bakterie kwasu mlekowego."
                            },
                            {
                                "example_id": "fc1a974b-6036-43a5-9e78-2f5992d43860",
                                "sense_id": "62464dba-fbe1-307a-ace6-589b49bd6704",
                                "text": "Trzeba pamiętać o stosowaniu probiotyków […], które przywracają prawidłową florę jelitową."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "223428ce-3280-4837-ab07-f58d7e6ad9ab",
