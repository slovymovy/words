                "senses": [
                    {
                        "sense_id": "879dc45a-180f-3d0f-97c1-9d99a674f4a6",
                        "entry_id": "d03c829a-4496-3d0e-8170-09936f981281",
                        "glosses": [
                            "bestimmte Struktur, Eigenschaft Aufbau von etwas"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "917dbf8c-5793-4f1f-bb26-35380250b498",
                                "sense_id": "879dc45a-180f-3d0f-97c1-9d99a674f4a6",
                                "text": "„Das Gerüst unseres Grundgesetzes, was die Verfasstheit des Staates angeht, steht.“"
                            },
                            {
                                "example_id": "f07b7880-8a92-46b5-9b52-966001141d83",
                                "sense_id": "879dc45a-180f-3d0f-97c1-9d99a674f4a6",
                                "text": "„Die Strategien dieser Heiratspolitik waren charakteristisch für die Verfasstheit der früh- und hochmittelalterlichen Adelsgesellschaft.“"
                            },
                            {
                                "example_id": "3d57b68a-16dc-4d3d-9450-851fe535b051",
                                "sense_id": "879dc45a-180f-3d0f-97c1-9d99a674f4a6",
                                "text": "„Vaubel gehört der European Constitutional Group an, einer Gruppe von Wissenschaftlern, die seit Jahren für eine freiheitliche Verfasstheit der Europäischen Union wirbt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1cfe815c-3174-3b1b-8647-777d645becf3",
                        "entry_id": "d03c829a-4496-3d0e-8170-09936f981281",
                        "glosses": [
                            "qualitativer Zustand, Lage, in dem sich jemand oder etwas körperlich oder geistig befindet"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "2f4e47f4-71ab-41d3-a4c4-fd7507757c6c",
                                "sense_id": "1cfe815c-3174-3b1b-8647-777d645becf3",
                                "text": "„Gefühle können schließlich als eine emotionale Verfasstheit des Ichs, als ein individuelles Empfinden, als eine subjektive Befindlichkeit begriffen werden […].“"
                            },
                            {
                                "example_id": "dd0743e3-64c7-44be-b3f4-77d6bd0ff9d4",
                                "sense_id": "1cfe815c-3174-3b1b-8647-777d645becf3",
                                "text": "„Neben Geschlecht sind auch weitere Faktoren sozialer Ungleichheit zu betrachten, wie Alter, Einkommen oder die körperliche Verfasstheit.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
