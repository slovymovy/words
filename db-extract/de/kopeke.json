                    }
                ],
                "senses": [
                    {
                        "sense_id": "2295ee66-740d-3898-b760-a6208bc75d7e",
                        "entry_id": "585daf2a-687f-3485-b91f-3a4a753dd337",
                        "glosses": [
                            "kleinere Einheit der Währungseinheit Rubel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "684bcde3-7778-4a6b-aa1d-45656a3614c5",
                                "sense_id": "2295ee66-740d-3898-b760-a6208bc75d7e",
                                "text": "100 Kopeken ergeben 1 Rubel."
                            },
                            {
                                "example_id": "d5f4fda4-e336-49ef-81a5-8af71d356c2f",
                                "sense_id": "2295ee66-740d-3898-b760-a6208bc75d7e",
                                "text": "„Am 9. Mai kosteten Narzissen nur drei und Tulpen fünf Kopeken das Stück.“"
                            },
                            {
                                "example_id": "bc6de713-fe35-490e-b299-5fe99359306d",
                                "sense_id": "2295ee66-740d-3898-b760-a6208bc75d7e",
                                "text": "„Ab Januar 1858 folgten dann gezähnte Briefmarken zu 10, 20 und 30 Kopeken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6057c969-fe32-4ff1-8714-e91ca58ce8b0",
                        "source_entry_id": "585daf2a-687f-3485-b91f-3a4a753dd337",
                        "source_sense_id": "2295ee66-740d-3898-b760-a6208bc75d7e",
                        "source_sense_description": "kleinere Einheit der Währungseinheit Rubel",
                        "target_lang_word": "kopeck",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kopeck",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79855b92-74c0-30b9-9a04-28864ab3bebd",
                                        "entry_id": "68a42775-af6c-363e-bce9-b421eae07c08",
                                        "glosses": [
                                            "Alternative spelling of kopek."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df6bc2e7-4e9d-45fb-977e-305d3c439b3b",
                                                "sense_id": "79855b92-74c0-30b9-9a04-28864ab3bebd",
                                                "text": "\"They do not exceed it? Fie! Why, you are robbing your children of their last kopeck—you, their guardian!\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1b2d736-33ee-4c0d-9462-141836bc652a",
                        "source_entry_id": "585daf2a-687f-3485-b91f-3a4a753dd337",
                        "source_sense_id": "2295ee66-740d-3898-b760-a6208bc75d7e",
                        "source_sense_description": "kleinere Einheit der Währungseinheit Rubel",
                        "target_lang_word": "copeck",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "copeck",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5730f358-6760-326c-9eed-6693dfe40b85",
                                        "entry_id": "0230c7d5-65ee-3bb6-aedd-3badd577b987",
                                        "glosses": [
                                            "Alternative spelling of kopek."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2e1e2f4-ad0a-4ba2-8abb-8a51429a0955",
                                                "sense_id": "5730f358-6760-326c-9eed-6693dfe40b85",
                                                "text": "The coinage of Russia is decimal; thus—100 copecks make 1 ruble. […] The only silver money in circulation are pieces of 20, 15, 10, and 5 copecks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35c5042d-4b84-4911-bd3a-cc1f0c39f2e3",
                        "source_entry_id": "585daf2a-687f-3485-b91f-3a4a753dd337",
                        "source_sense_id": "2295ee66-740d-3898-b760-a6208bc75d7e",
                        "source_sense_description": "kleinere Einheit der Währungseinheit Rubel",
                        "target_lang_word": "копейка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "копейка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3f0b00b6-4897-3cd4-83e1-9ae11bbfd185",
                                        "entry_id": "c18ce1c4-1a03-30eb-a7c4-48a1788fcfc3",
                                        "glosses": [
                                            "денежная единица, равная одной сотой рубля (а также некоторых других денежных единиц)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bee733f-3b6a-479f-8258-6b98d2c98eee",
                                                "sense_id": "3f0b00b6-4897-3cd4-83e1-9ae11bbfd185",
                                                "text": "Копейка даже в годы благополучного застоя имела очень ограниченное применение. 〈…〉 Зато в год деноминации её встречали, как давно забытого, но любимого родственника. Сегодня российская копейка снова при смерти. Её покупательная способность стремится к нулю."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f98364d0-934f-3b45-8b48-e10a8d23ac9c",
                                        "entry_id": "c18ce1c4-1a03-30eb-a7c4-48a1788fcfc3",
                                        "glosses": [
                                            "нумизм. мелкая монета номиналом в одну сотую рубля и соответствующая денежная сумма"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff23e86c-7f6c-4c94-96d3-c4df229ac16e",
                                                "sense_id": "f98364d0-934f-3b45-8b48-e10a8d23ac9c",
                                                "text": "Копейка упала на мостовую."
                                            },
                                            {
                                                "example_id": "1e2cdf85-ff5c-4ba1-bff3-67fd38712ae7",
                                                "sense_id": "f98364d0-934f-3b45-8b48-e10a8d23ac9c",
                                                "text": "Бухгалтерский баланс не сошёлся на копейку."
                                            },
                                            {
                                                "example_id": "77579b41-af54-4e2a-8179-347f9eb698f2",
                                                "sense_id": "f98364d0-934f-3b45-8b48-e10a8d23ac9c",
                                                "text": "Дайте на десять копеек соды! — говорит доктор."
                                            },
                                            {
                                                "example_id": "09fac463-53fe-4920-9bde-fc8e62678be1",
                                                "sense_id": "f98364d0-934f-3b45-8b48-e10a8d23ac9c",
                                                "text": "Марки были в разную цену: в копейку, в три копейки, в пять копеек."
                                            },
                                            {
                                                "example_id": "cd3daf61-bb7f-455a-ac86-cc1cf9566d9c",
                                                "sense_id": "f98364d0-934f-3b45-8b48-e10a8d23ac9c",
                                                "text": "Обнаружилась даже копейка ― не припомню, откуда она взялась и для чего положил её в карман."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80829f5d-5a43-3ab9-a34b-b38b83bbf356",
                                        "entry_id": "c18ce1c4-1a03-30eb-a7c4-48a1788fcfc3",
                                        "glosses": [
                                            "собир., разг. деньги вообще, денежные средства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70bc286c-bc2b-4e83-8031-dcd749ea4f19",
                                                "sense_id": "80829f5d-5a43-3ab9-a34b-b38b83bbf356",
                                                "text": "[Отец Паклина] управлял имениями, домами и зашиб-таки копейку."
                                            },
                                            {
                                                "example_id": "e3d38943-b293-4598-b8bd-e626c88ba042",
                                                "sense_id": "80829f5d-5a43-3ab9-a34b-b38b83bbf356",
                                                "text": "Всякий старался зашибить копейку и поскорей «выплавать ценз», а где и на чём ― на пароходе ли, делающем рейсы между Петербургом и Кронштадтом, или на броненосцах, отстаивающихся на трандзундском рейде, ― не всё ли равно?"
                                            },
                                            {
                                                "example_id": "2ac82b73-37a8-4276-845a-6506adc93b36",
                                                "sense_id": "80829f5d-5a43-3ab9-a34b-b38b83bbf356",
                                                "text": "Не менее Бестужева падкий до денег, он набивал свои карманы трудовою копейкой народа"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0102e3a-459c-327d-81e5-67c860e2fd2c",
                                        "entry_id": "c18ce1c4-1a03-30eb-a7c4-48a1788fcfc3",
                                        "glosses": [
                                            "перен., мн. ч. небольшие деньги"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02cf4c07-4fd8-481c-9c4c-d4aa48c7d471",
                                                "sense_id": "b0102e3a-459c-327d-81e5-67c860e2fd2c",
                                                "text": "Миллиард долларов по сравнению с бюджетом США — это копейки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cd6854c-a89b-3cdd-86ca-46afc1f7826a",
                                        "entry_id": "c18ce1c4-1a03-30eb-a7c4-48a1788fcfc3",
                                        "glosses": [
                                            "перен., разг. мелкая монета с единичным номиналом (один цент, евроцент и т. п.) и соответствующая денежная сумма"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e5b068a-d5ed-4930-811c-46a5036bf070",
                                                "sense_id": "5cd6854c-a89b-3cdd-86ca-46afc1f7826a",
                                                "text": "Суёшь в автомат евро одной монетой, он наливает кофе и даёт сдачи пятнадцать копеек."
                                            }
                                        ]
                                    },
