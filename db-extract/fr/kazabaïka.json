                                "target_senses": [
                                    {
                                        "sense_id": "a6c74d4f-3f61-34da-bf6c-9c9ac539e52d",
                                        "entry_id": "ac41685c-eaf2-383f-ba1b-4eb72d3b4c65",
                                        "glosses": [
                                            "A short fur-lined cloak or jacket."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3be1010b-6903-4400-b80d-3743f4c45407",
                                                "sense_id": "a6c74d4f-3f61-34da-bf6c-9c9ac539e52d",
                                                "text": "Theofil was decidedly embarrassed, but he acted as best he could, and throwing himself at the feet of the pretty mistress kissed the edge of her kazabaika."
                                            },
                                            {
                                                "example_id": "198c09ad-f91a-4c5b-812a-b474c7bfc4bf",
                                                "sense_id": "a6c74d4f-3f61-34da-bf6c-9c9ac539e52d",
                                                "text": "Suddenly the door leading to the adjoining room opened, and a young girl entered, her slender figure was wrapped in a silk robe of many folds and a kazabaika trimmed with fur, on her neck and arms she wore corrals and pearls, her long black tresses were braided with golden threads and her small feet were encased in red slippers."
                                            },
                                            {
                                                "example_id": "d51dc17a-dcbf-49e5-9c0a-562097996dc4",
                                                "sense_id": "a6c74d4f-3f61-34da-bf6c-9c9ac539e52d",
                                                "text": "She den leaned back on de cushions, and slowly jimmey'd ha' kazabaika. WORD!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
