                        "target_lang_word": "savante",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "savante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "59c4dc98-52a7-3b3d-ad1d-10b356515868",
                                        "entry_id": "d52c13a3-d4c2-3c80-93b2-4cfc9064728a",
                                        "glosses": [
                                            "Femme savante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "333fc7c2-1508-4d47-9da9-f5ff1f32a718",
                                                "sense_id": "59c4dc98-52a7-3b3d-ad1d-10b356515868",
                                                "text": "Alors qu’elle règne sur la vie intellectuelle d’Alexandrie, la savante païenne est brûlée par des chrétiens en 415 et éclipsée de l’histoire par sainte Catherine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01daaa50-2992-315d-946e-f712e37ec466",
                                        "entry_id": "d52c13a3-d4c2-3c80-93b2-4cfc9064728a",
                                        "glosses": [
                                            "Femme qui par ses connaissances approfondies et ses recherches contribue à l’élaboration, au progrès d’une science, et plus spécialement d’une science expérimentale ou exacte ; grande personnalité du monde scientifique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27b9856d-849d-4d43-85ae-cf6980a0b062",
                                                "sense_id": "01daaa50-2992-315d-946e-f712e37ec466",
                                                "text": "A voir aussi : le jardin de Marie Curie, son bureau et son laboratoire de chimie personnel conservés comme au temps de la savante."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "savante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d091934-988a-342a-b1b4-d147d2e57dfd",
                                        "entry_id": "4a80d6b0-97cb-33f0-80ea-f79676958948",
                                        "glosses": [
                                            "Féminin singulier de savant."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9035d3d1-6da1-4e9a-9244-36c1ea29ba42",
                                                "sense_id": "0d091934-988a-342a-b1b4-d147d2e57dfd",
                                                "text": "Elle entendit enfin sur les dalles le bruit d’un pas d’homme comme il faut ; car, la messe était dite, Ernest faisait le tour de l’église où il ne se trouvait plus que les dilettanti de la dévotion qui devinrent l’objet d’une savante et perspicace analyse."
                                            },
                                            {
                                                "example_id": "177c063d-91f6-49dd-8af1-70ab352e2e06",
                                                "sense_id": "0d091934-988a-342a-b1b4-d147d2e57dfd",
                                                "text": "Le moindre cacographe est membre d’une société savante, et ceux qui ne savent rien ou ne peuvent pas écrire comptent les fontaines de Paris, examinent les couleurs des numéros que le préfet impose aux maisons, et se prétendent occupés de statistique ; car la statistique est devenue à la mode, et c’est une position que de statistiquer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
