                ],
                "senses": [
                    {
                        "sense_id": "36d2a66e-143c-33a2-86ed-f3091fab773d",
                        "entry_id": "0af9b7f0-e3f6-32fd-bdd4-82ad445ccd64",
                        "glosses": [
                            "Pousser des cris de joie, des youyous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dde40228-93e4-4991-91b2-9f426d1326ab",
                                "sense_id": "36d2a66e-143c-33a2-86ed-f3091fab773d",
                                "text": "C’est pourquoi Roumi, qui n’avait famille qui vaille, se mit à charrier de pleins couffins chez sa future épouse, qui en pleurait sans cause, tandis que youyoutaient les autres femmes."
                            },
                            {
                                "example_id": "e28efd27-2954-401e-a4ae-7ec13e73de8c",
                                "sense_id": "36d2a66e-143c-33a2-86ed-f3091fab773d",
                                "text": "Les femmes « youyoutèrent » à gorge déployée, et nous échangeâmes congratulations et compliments, l’un flattant l’encolure du mulet, notre héros, l’autre exagérant les mérites du conducteur bédouin, en lui attribuant tous les adjectifs propres à Hatim Tay et à Antara Banu Abbas."
                            }
                        ]
                    },
                    {
                        "sense_id": "eff34fcb-cb19-3f30-9f98-0131c92b58f0",
                        "entry_id": "0af9b7f0-e3f6-32fd-bdd4-82ad445ccd64",
                        "glosses": [
                            "Faire un bruit répétitif semblable aux youyous."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "af4a2487-9587-4131-9be2-108c6f01f17f",
                                "sense_id": "eff34fcb-cb19-3f30-9f98-0131c92b58f0",
                                "text": "Les alarmes de voiture youyoutaient, les alarmes anti-effraction hululaient, les alarmes d'incendie beuglaient, stridentes."
                            }
                        ]
                    }
                ],
