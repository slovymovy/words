                        "glosses": [
                            "beheerder, vertrouwenspersoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63d875de-d152-4d3e-a5bb-97969a70235c",
                                "sense_id": "50f86e28-fc0e-3635-8418-45d8919afa62",
                                "text": "De overheidscommissaris wordt langzaam vervangen door een 'trustee', die de belangen van de staat behartigt. Zo'n persoon kun je veel meer bevoegdheden geven, aldus Dijsselbloem."
                            },
                            {
                                "example_id": "46833b94-07f1-409f-b19d-007998e91222",
                                "sense_id": "50f86e28-fc0e-3635-8418-45d8919afa62",
                                "text": "We zijn, zegt hij, op aarde als ”trustee” (beheerder). Je moet beheren wat de doden hebben nagelaten voor het welzijn van de ongeborenen, en dat geldt niet alleen voor het menselijke, maar ook voor het natuurlijke kapitaal."
                            }
                        ]
                    }
                ],
