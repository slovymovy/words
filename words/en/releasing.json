{
    "word_family": [
        "release",
        "releasable",
        "releaser",
        "rerelease"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2014057b-d151-3f0f-9e6b-c24c6fd2fa6b",
                    "sense_definition": "Present participle and gerund of <w>release</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is <w>releasing</w> a new software update next week.",
                            "target_lang_translations": {
                                "ru": "Компания <w>выпускает</w> новое обновление программного обеспечения на следующей неделе.",
                                "tr": "Şirket önümüzdeki hafta yeni bir yazılım güncellemesi <w>yayımlıyor</w>."
                            }
                        },
                        {
                            "text": "After <w>releasing</w> the handle, the door slowly swung open.",
                            "target_lang_translations": {
                                "ru": "<w>Отпустив</w> ручку, дверь медленно открылась.",
                                "tr": "Kolu <w>bıraktıktan</w> sonra kapı yavaşça açıldı."
                            }
                        }
                    ],
                    "antonyms": [
                        "holding",
                        "keeping",
                        "retaining"
                    ],
                    "common_phrases": [
                        "releasing a statement",
                        "releasing tension",
                        "releasing the brake"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола release (выпускать, освобождать, отпускать).",
                        "tr": "\"Release\" fiilinin şimdiki zaman sıfat-fiil ve ulaç biçimi (serbest bırakma, yayımlama, piyasaya sürme, salıverme)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпускающий",
                                "target_lang_sense_clarification": "публикующий, издающий"
                            },
                            {
                                "target_lang_word": "освобождающий",
                                "target_lang_sense_clarification": "дающий свободу"
                            },
                            {
                                "target_lang_word": "отпускающий",
                                "target_lang_sense_clarification": "прекращающий удерживать"
                            },
                            {
                                "target_lang_word": "выпуская",
                                "target_lang_sense_clarification": "деепричастие: производя выпуск"
                            },
                            {
                                "target_lang_word": "отпуская",
                                "target_lang_sense_clarification": "деепричастие: разжимая хватку"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "serbest bırakma",
                                "target_lang_sense_clarification": "tutsaklığı veya tutuşu sonlandırma"
                            },
                            {
                                "target_lang_word": "piyasaya sürme",
                                "target_lang_sense_clarification": "ürün veya yazılım yayımlama"
                            },
                            {
                                "target_lang_word": "bırakma",
                                "target_lang_sense_clarification": "tutulan bir şeyi salıverme"
                            },
                            {
                                "target_lang_word": "yayımlama",
                                "target_lang_sense_clarification": "haber, bildiri vb."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "90ee1985-b96f-37d3-a6ec-7c7797d6cbbf",
                    "sense_definition": "The act by which something is released.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>releasing</w> of the prisoners was a controversial decision by the government.",
                            "target_lang_translations": {
                                "ru": "<w>Освобождение</w> заключенных было спорным решением правительства.",
                                "tr": "Mahkumların <w>serbest bırakılması</w>, hükümet adına tartışmalı bir karardı."
                            }
                        },
                        {
                            "text": "We watched the <w>releasing</w> of the doves during the opening ceremony.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали за <w>выпуском</w> голубей во время церемонии открытия.",
                                "tr": "Açılış töreninde güvercinlerin <w>salıverilmesini</w> izledik."
                            }
                        }
                    ],
                    "synonyms": [
                        "liberation",
                        "freeing",
                        "discharge"
                    ],
                    "antonyms": [
                        "capture",
                        "retention",
                        "confinement"
                    ],
                    "common_phrases": [
                        "releasing of",
                        "accidental releasing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, посредством которого что-либо высвобождается или выпускается.",
                        "tr": "Bir şeyin serbest bırakılması, salıverilmesi veya yayımlanması eylemi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освобождение",
                                "target_lang_sense_clarification": "заключенных, от обязательств"
                            },
                            {
                                "target_lang_word": "выпуск",
                                "target_lang_sense_clarification": "продукции, птиц, пара"
                            },
                            {
                                "target_lang_word": "отпускание",
                                "target_lang_sense_clarification": "физического захвата, тормоза"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "serbest bırakılma",
                                "target_lang_sense_clarification": "tutsakların salınması"
                            },
                            {
                                "target_lang_word": "salınma",
                                "target_lang_sense_clarification": "kuş, gaz veya kimyasalların havaya bırakılması"
                            },
                            {
                                "target_lang_word": "salıverme",
                                "target_lang_sense_clarification": "özgürlüğüne kavuşturma eylemi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}