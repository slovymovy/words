                            {
                                "example_id": "c4f19248-7bf3-4c03-8b5c-b612a111b24a",
                                "sense_id": "0692d2a0-ce01-3335-99a6-ca5052534846",
                                "text": "„Ein von den Briten neu zusammengestelltes Truppenkorps setzt sich in der Stadt Berbera an der Küste des Golfs von Aden zum Kampf gegen die somalische Unabhängigkeitsbewegung unter \"Mullah\" Muhammad Ibn Abd Allah Hasan in Bewegung.“"
                            },
                            {
                                "example_id": "06ea3a7b-f9a1-4bb4-aca7-c4cf0fa4d6f1",
                                "sense_id": "0692d2a0-ce01-3335-99a6-ca5052534846",
                                "text": "„In den folgenden Jahren besetzen die Ägypter eine Reihe weiterer Städte, darunter Dar Fur und Berbera.“"
                            }
                        ],
