                                "target_senses": [
                                    {
                                        "sense_id": "a739d62e-5aef-3b55-98ef-d7b4a39a7201",
                                        "entry_id": "198633e2-c7ed-3e15-b23a-b22345c9f57b",
                                        "glosses": [
                                            "A lightweight object that is conical in shape with a cork or rubber-covered nose, used in badminton the way a ball is used in other racquet games."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47b6196e-165c-48f0-ae49-8409d503b49c",
                                                "sense_id": "a739d62e-5aef-3b55-98ef-d7b4a39a7201",
                                                "text": "Seven or eight of them, standing in a circle, were engaged in a game of shittlecock. They had in their hands no battledores. They did not employ the hand or arm, any way, in striking it. But, after taking a short race, and springing from the floor, they met the descending shittlecock with the sole of the foot, and drove it up again, with force, high into the air. [...] The shittlecock was made of a piece of dried skin rolled round, and bound with strings. Into this skin were inserted three long feathers spreading out at top, but so near to each other, where they were stuck into the skin, as to pass through the holes, little more than a quarter of an inch square, which are always made in the centre of Cochin-chinese copper coins."
                                            },
                                            {
                                                "example_id": "e4baba24-c37a-4b79-aed1-2b0824fd9a04",
                                                "sense_id": "a739d62e-5aef-3b55-98ef-d7b4a39a7201",
                                                "text": "In a severe gale like this, while the ship is but a tossed shuttlecock to the blast, it is by no means uncommon to see the needles in the compasses, at intervals, go round and round."
                                            },
                                            {
                                                "example_id": "a93c3b34-b268-42cb-82a2-b901894d8e0a",
                                                "sense_id": "a739d62e-5aef-3b55-98ef-d7b4a39a7201",
                                                "text": "The practice of the game in this country is to keep the shuttlecock in the air by striking it from one person to another."
                                            },
                                            {
                                                "example_id": "735cd2e7-5620-435c-af1d-f98ea456805a",
                                                "sense_id": "a739d62e-5aef-3b55-98ef-d7b4a39a7201",
                                                "text": "Crudely as they had calculated they were at first justified by the event; she was the little feathered shuttlecock they fiercely kept flying between them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e97b863d-8005-38a2-8181-203aca3700e1",
                                        "entry_id": "198633e2-c7ed-3e15-b23a-b22345c9f57b",
                                        "glosses": [
                                            "The game of badminton."
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f97ad959-3adb-42dc-a0f5-30bf67e25855",
                                                "sense_id": "e97b863d-8005-38a2-8181-203aca3700e1",
                                                "text": "Fla[via]. Come, Sir Pergamus, till your horse come, you and I'll go play at shuttle-cock. / Per[gamus]. A match i'faith. I love that sport a' life. Yet my mother charged me not to use it for fear of putting my arm out of joint."
                                            },
                                            {
                                                "example_id": "6f7651a2-1fe5-40aa-8d55-b777aad1484f",
                                                "sense_id": "e97b863d-8005-38a2-8181-203aca3700e1",
                                                "text": "Two people stand at opposite ends of the room, as in playing shuttlecock […]"
                                            }
                                        ]
                                    }
