                "senses": [
                    {
                        "sense_id": "8a09b14f-bf66-36fe-879b-61f78a8fc221",
                        "entry_id": "439ac570-7f28-3167-ad36-118f356d0bb4",
                        "glosses": [
                            "Administrer, s’occuper de l’administration."
                        ],
                        "tags": [
                            "Par plaisanterie"
                        ],
                        "examples": [
                            {
                                "example_id": "d0742547-d98b-47b6-9d34-f4f8e8cb4cf8",
                                "sense_id": "8a09b14f-bf66-36fe-879b-61f78a8fc221",
                                "text": "C.I.F.E : Les entreprises bossent, l'administration administrationne."
                            },
                            {
                                "example_id": "d69472d3-c569-4229-baa1-f2345ae8de06",
                                "sense_id": "8a09b14f-bf66-36fe-879b-61f78a8fc221",
                                "text": "Jocelyne, dernier maillon de cette équipe, mais non le moindre (ben oui, c'est moi qui rédige !!) s'évertue à coordonner, à ordonner, à administrationner (oups !), bref à s'occuper de la partie administrative."
                            },
                            {
                                "example_id": "b38204f9-ac7e-4c0e-9dca-8757ba59d37b",
                                "sense_id": "8a09b14f-bf66-36fe-879b-61f78a8fc221",
                                "text": "ceux qui sachent n'achèteront pas le livre car nous sachons qu'un complot biochimique vise à nous administrationner des vaccins via le papier."
                            },
                            {
                                "example_id": "826f29ca-8f4f-4ff4-9202-e79d530c9f79",
                                "sense_id": "8a09b14f-bf66-36fe-879b-61f78a8fc221",
                                "text": "Des gros qui administrationnent les comptes un médecin chef qui codérise les plaies un rond clignoteur qui niouzone ! et un modo qui modérationne les posts !"
                            },
                            {
                                "example_id": "a3148fe9-916a-4ae6-92ea-dc76effc6603",
                                "sense_id": "8a09b14f-bf66-36fe-879b-61f78a8fc221",
                                "text": "merci à tous les modos d'avoir \"moderaté\" tout bien comme y faut merci aux admins d'avoir administrationné tout bien comme y faut"
                            }
                        ]
                    }
                ],
