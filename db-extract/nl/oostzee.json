                                "target_senses": [
                                    {
                                        "sense_id": "dc9b21e2-d5c8-35b6-a2d5-93d0aa57bf47",
                                        "entry_id": "87dfcc44-b5ea-3a04-aa23-fde1f91fdf82",
                                        "glosses": [
                                            "Mer intracontinentale située dans le nord de l’Europe, limitée au sud-ouest par le Cattégat, et bordée par la Suède, la Finlande, la Russie, l’Estonie, la Lettonie, la Lituanie, l'oblast de Kaliningrad, la Pologne, l’Allemagne et le Danemark."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9433333d-6ff4-4570-977f-52fcd5f09dd0",
                                                "sense_id": "dc9b21e2-d5c8-35b6-a2d5-93d0aa57bf47",
                                                "text": "Enfin l’habitant de Saturne vit quelque chose d’imperceptible qui remuait entre deux eaux dans la mer Baltique : c’était une baleine."
                                            },
                                            {
                                                "example_id": "c9cb33d3-d793-447f-8034-183669b1b61f",
                                                "sense_id": "dc9b21e2-d5c8-35b6-a2d5-93d0aa57bf47",
                                                "text": "Les Cimbres et les Teutons, chassés de la Chersonèse cimbrique par un débordement de la mer Baltique, se montrèrent aux Romains sous les Alpes tridentines, au nombre de plus de trois cent mille."
                                            },
                                            {
                                                "example_id": "ffba2ed1-ba9d-437a-9005-06d08fcdaad2",
                                                "sense_id": "dc9b21e2-d5c8-35b6-a2d5-93d0aa57bf47",
                                                "text": "On peut signaler une analogie entre la mer Noire et la mer Baltique, c’est la faible salure des eaux."
                                            },
                                            {
                                                "example_id": "992ce326-4c74-4be7-9756-c1ac78fd71af",
                                                "sense_id": "dc9b21e2-d5c8-35b6-a2d5-93d0aa57bf47",
                                                "text": "Le grand canal devait relier la Volga et le Don et déboucher sur les mers Blanche, Baltique, Caspienne, d’Azov et Noire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
