                        "form": "télématiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ef419734-89b7-3ff0-866c-43dc94deee61",
                        "entry_id": "45b30ce2-6930-3433-a34e-481e1bd448a4",
                        "glosses": [
                            "Ensemble de services de télécommunication, autres que les services télégraphique et téléphonique usuels, qui peuvent être obtenus par les usagers d’un réseau de télécommunication."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bbb92b79-a3f4-317e-b6ef-980e97ba6b91",
                        "entry_id": "45b30ce2-6930-3433-a34e-481e1bd448a4",
                        "glosses": [
                            "Ensemble de services de nature ou d’origine informatique pouvant être fournis par un réseau de télécommunication."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2334129-b41a-4d15-ad5f-92f30df94620",
                                "sense_id": "bbb92b79-a3f4-317e-b6ef-980e97ba6b91",
                                "text": "Il revient à Minc d’avoir été le premier à nommer cet eldorado, en fondant le néologisme « télématique ». La convergence du téléphone et de l’informatique serait le grand chantier de la fin du siècle."
                            },
                            {
                                "example_id": "7bb23693-8ca3-475e-b56e-783677b0aec4",
                                "sense_id": "bbb92b79-a3f4-317e-b6ef-980e97ba6b91",
                                "text": "La télématique embarquée ne sert plus seulement à la géolocalisation des véhicules."
                            },
                            {
                                "example_id": "c10a02d5-090f-4c3d-9a92-031907d0b8b4",
                                "sense_id": "bbb92b79-a3f4-317e-b6ef-980e97ba6b91",
                                "text": "Comment faire passer ma flotte à l’électrique ? Les spécialistes de la télématique embarquée dont les boîtiers de connexion équipent les véhicules de leurs clients n’ont pas mis longtemps à répondre à cette question. Il en va ainsi de Mobility Tech Green dont la plate-forme e-Fleet fournit aux gestionnaires de parcs de nombreuses remontées de données sur l’usage réel de leurs véhicules afin de diagnostiquer ceux pouvant être éligibles à l’électrique"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "700416aa-7fb6-44ee-9dcd-d791383a4040",
                        "source_entry_id": "45b30ce2-6930-3433-a34e-481e1bd448a4",
