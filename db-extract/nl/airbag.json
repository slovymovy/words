                    }
                ],
                "senses": [
                    {
                        "sense_id": "60b03f21-ac26-39b7-9e32-878f8fbc3a0a",
                        "entry_id": "e3468cb0-e2f9-38a1-ba7e-b10783507bfd",
                        "glosses": [
                            "systeem in voertuigen waar bij een botsing snel een zak wordt opgeblazen ter bescherming van de inzittenden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc6c7b45-1876-4901-abd0-fa2b2492ecbf",
                                "sense_id": "60b03f21-ac26-39b7-9e32-878f8fbc3a0a",
                                "text": "Na de botsing klapten de airbags open."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4df15a8-331c-4886-ad1d-d7256f1c0bdf",
                        "source_entry_id": "e3468cb0-e2f9-38a1-ba7e-b10783507bfd",
                        "source_sense_id": "60b03f21-ac26-39b7-9e32-878f8fbc3a0a",
                        "source_sense_description": "beschermingssysteem in voertuigen",
                        "target_lang_word": "Airbag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Airbag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e1338a0-278a-35bd-a310-7730dc8c3210",
                                        "entry_id": "42d849ea-5b20-3373-8605-ece097188633",
                                        "glosses": [
                                            "ein Sack in einem Fahrzeug, der sich bei einem Aufprall automatisch mit Gas füllt, um somit die Insassen vor Verletzungen zu schützen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b1e2ffe-9709-430e-969d-9de2572534f9",
                                                "sense_id": "3e1338a0-278a-35bd-a310-7730dc8c3210",
                                                "text": "„Airbags für Kopf, Front und die Seiten beruhigen zusätzlich, auch bei der zunächst zögerlichen Annäherung an die Höchstgeschwindigkeit. Die liegt bei 220 km/h.“"
                                            },
                                            {
                                                "example_id": "57821555-f526-473f-a944-ac7d3ff6976d",
                                                "sense_id": "3e1338a0-278a-35bd-a310-7730dc8c3210",
                                                "text": "Obwohl die deutsche Sprache das englische Wort „Airbags“ für das „Aufprallkissen“ übernahm, ist es eine bereits 1951 von dem Münchner Erfinder Walter Linderer patentierte, deutsche Erfindung."
                                            },
                                            {
                                                "example_id": "23661c24-0ddf-4d19-a8f6-353cac0816b3",
                                                "sense_id": "3e1338a0-278a-35bd-a310-7730dc8c3210",
                                                "text": "„Seine Nase war vom Airbag blutig geschlagen.“"
                                            },
                                            {
                                                "example_id": "03d0343d-9d3f-4ad2-a29a-05a9030f3d7a",
                                                "sense_id": "3e1338a0-278a-35bd-a310-7730dc8c3210",
                                                "text": "„Ali reparierte ihre Autos, kümmerte sich um die Elektrik, montierte neue Airbags in ihre Limousinen.“"
                                            },
                                            {
                                                "example_id": "74b14d04-c336-4a06-b53c-192cf395bd0c",
                                                "sense_id": "3e1338a0-278a-35bd-a310-7730dc8c3210",
                                                "text": "„Noch nicht mal der Airbag war aufgegangen, wir waren ja einfach ausgerollt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91c3b993-5ece-4db0-aaa5-89e82d500be6",
                        "source_entry_id": "e3468cb0-e2f9-38a1-ba7e-b10783507bfd",
                        "source_sense_id": "60b03f21-ac26-39b7-9e32-878f8fbc3a0a",
                        "source_sense_description": "beschermingssysteem in voertuigen",
                        "target_lang_word": "airbag",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "airbag",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53d7005c-adc5-3f0f-ad47-d3176819e743",
                                        "entry_id": "5fc2aaa5-dec0-37a8-829e-10bbe1fd652a",
                                        "glosses": [
                                            "A protective system in automobiles in which when a crash occurs, a bag containing nitrogen, formed by the explosive decomposition of sodium azide, quickly inflates in front of the driver or passenger, preventing injury to the head. Side air bags, including the back seat passengers, also prevent injury."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aa46795-3dda-4bcb-a681-771975b075dc",
                                                "sense_id": "53d7005c-adc5-3f0f-ad47-d3176819e743",
                                                "text": "In a fast German car / I'm amazed that I survived / An airbag saved my life"
                                            },
                                            {
                                                "example_id": "44ef6f64-1c9f-4be9-9d1f-e54b0cfaf43b",
                                                "sense_id": "53d7005c-adc5-3f0f-ad47-d3176819e743",
                                                "text": "However, the challenges for the railway world are much greater than for automotive as we generally have more occupants, higher speeds, greater masses, higher energies, and an absence of seatbelts or airbags to contend with."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e0eccd9-10d4-3025-8089-c3d1959cc722",
                                        "entry_id": "5fc2aaa5-dec0-37a8-829e-10bbe1fd652a",
                                        "glosses": [
                                            "A similar inflated bag used in performing stunts, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82258ead-5641-4e30-b304-2df7dcb17739",
                                                "sense_id": "8e0eccd9-10d4-3025-8089-c3d1959cc722",
                                                "text": "As part of a scene in a movie, a stuntman falls from the top of a 95-foot-tall building into a large airbag directly below him on the ground, as shown in Figure 15-3."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ce48b20-a10b-329e-87cf-816640721a9a",
                                        "entry_id": "5fc2aaa5-dec0-37a8-829e-10bbe1fd652a",
                                        "glosses": [
                                            "A person who talks too much; a windbag or gossip."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
