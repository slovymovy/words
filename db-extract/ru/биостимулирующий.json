                "senses": [
                    {
                        "sense_id": "440fabc8-e059-37b2-8560-45dde76a016c",
                        "entry_id": "c3d66623-64de-3992-b25f-0f60cf4fd98b",
                        "glosses": [
                            "оказывающий стимулирующее воздействие на жизнедеятельность организма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f02012ee-2dc8-413e-bc65-4daae900a738",
                                "sense_id": "440fabc8-e059-37b2-8560-45dde76a016c",
                                "text": "Польза молока очевидна, если вспомнить, что молоко и молочные продукты благодаря оптимальному балансу таких биостимулирующих веществ, как метионин и холин, регулируют холестериновый обмен в организме, предупреждая тем самым развитие атеросклероза."
                            },
                            {
                                "example_id": "b96a0baa-9892-430c-82db-9f9c87cc1a75",
                                "sense_id": "440fabc8-e059-37b2-8560-45dde76a016c",
                                "text": "Органические соединения в минеральных водах… определяют её бактерицидные и биостимулирующие свойства."
                            }
                        ]
                    }
