                        "examples": [
                            {
                                "example_id": "d1d61c30-09f1-4cf2-8b94-ed7fef6d2518",
                                "sense_id": "0cb7dc78-5bb8-3383-a6a5-1023fc6fae1d",
                                "text": "Het hing al een tijdje in de lucht, maar nu is het ook officieel. Op het slotgala van de Superprestige raakte zaterdag bekend dat er vanaf volgend seizoen ook een klassement komt voor de vrouwen."
                            },
                            {
                                "example_id": "e3ffb83b-b029-4f70-9467-bb37fce14c8e",
                                "sense_id": "0cb7dc78-5bb8-3383-a6a5-1023fc6fae1d",
                                "text": "Daarnaast werden maandagavond de nominaties in de categorieën beste korte en lange documentaire en beste korte film bekendgemaakt. De rest van de nominaties, waaronder beste film, acteur, actrice en regisseur van een speelfilm, worden dinsdagavond bekendgemaakt. De uitreiking van de Gouden Kalveren vindt vrijdag plaats, tijdens het slotgala van het Nederlands Film Festival."
                            },
                            {
                                "example_id": "184257ea-eb1d-4905-bba7-b80e3dc74a14",
                                "sense_id": "0cb7dc78-5bb8-3383-a6a5-1023fc6fae1d",
                                "text": "Tijdens de festivaldag worden in het Agora Theater Lelystad alle ingezonden films gepresenteerd en vinden tientallen workshops plaats voor de jonge deelnemers. Deze worden gegeven door juryleden en andere professionals uit de film- en tv-wereld. Tijdens het slotgala ‘s avonds wordt het festival feestelijk afgesloten met de bekendmaking van de winnaars."
                            }
                        ]
                    }
