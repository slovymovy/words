                    {
                        "translation_id": "052e9f2f-05ba-4f3d-b15c-dfde710b6722",
                        "source_entry_id": "1476d95a-a268-3a73-84f2-7d9b2c6ce98f",
                        "source_sense_id": "dfdb98a3-5eb8-3c44-85ad-809c0fbd66c1",
