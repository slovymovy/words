{
    "word_family": [
        "drop"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "841f025e-fd1f-3506-8c06-925d389b1fa2",
                    "sense_definition": "A person who leaves an educational institution before finishing their studies.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He became a high school <w>dropout</w> at the age of sixteen. ",
                            "target_lang_translations": {
                                "tr": "On altı yaşında bir <w>lise terki</w> oldu."
                            }
                        },
                        {
                            "text": "Many successful tech entrepreneurs were university <w>dropouts</w> who pursued their own ideas.",
                            "target_lang_translations": {
                                "tr": "Birçok başarılı teknoloji girişimcisi, kendi fikirlerinin peşinden giden <w>üniversite terk</w> kişilerdi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "high school dropout",
                        "college dropout"
                    ],
                    "target_lang_definitions": {
                        "tr": "Öğrenimini tamamlamadan okuldan ayrılan kişi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "okul terk",
                                "target_lang_sense_clarification": "eğitimi bırakan kişi"
                            },
                            {
                                "target_lang_word": "okulu bırakan kimse",
                                "target_lang_sense_clarification": "eğitimini yarım bırakan öğrenci"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acf50266-e85c-366c-b52c-5be90dba83fe",
                    "sense_definition": "A person who rejects or withdraws from conventional society or traditional lifestyles.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He left his corporate job to live off the grid as a social <w>dropout</w>.",
                            "target_lang_translations": {
                                "tr": "Toplumdan soyutlanmış bir <w>sosyal kaçkın</w> olarak yaşamak için kurumsal işini bıraktı."
                            }
                        },
                        {
                            "text": "In the late sixties, many young people became cultural <w>dropouts</w>.",
                            "target_lang_translations": {
                                "tr": "Altmışların sonlarında birçok genç insan kültürel olarak <w>toplumu reddeden kişiler</w> haline geldi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Geleneksel toplumu veya yerleşik yaşam tarzını reddedip hayatın dışına çekilen kişi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "toplum dışına itilmiş kimse",
                                "target_lang_sense_clarification": "yerleşik düzeni reddeden kişi"
                            },
                            {
                                "target_lang_word": "toplumu reddeden kişi",
                                "target_lang_sense_clarification": "geleneksel yaşamı terk eden kişi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d174118-ace1-397e-8aeb-87c73749677b",
                    "sense_definition": "A person who withdraws from an activity, course, or organized group before completion, or the act of doing so.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The marathon had a high <w>dropout</w> rate due to the extreme heat.",
                            "target_lang_translations": {
                                "tr": "Aşırı sıcak nedeniyle maratonda yüksek bir <w>yarışı bırakma</w> oranı vardı."
                            }
                        },
                        {
                            "text": "To avoid excessive <w>dropouts</w> from the study, researchers changed the schedule.",
                            "target_lang_translations": {
                                "tr": "Araştırmadan aşırı <w>ayrılmaların</w> önüne geçmek için araştırmacılar takvimi değiştirdi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dropout rate"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir etkinlikten, kurstan veya gruptan tamamlanmadan ayrılan kişi veya bu çekilme eylemi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "bırakan kişi",
                                "target_lang_sense_clarification": "kurs veya etkinliği yarıda bırakan"
                            },
                            {
                                "target_lang_word": "yarıda bırakma",
                                "target_lang_sense_clarification": "çekilme eylemi veya oranı"
                            },
                            {
                                "target_lang_word": "fire",
                                "target_lang_sense_clarification": "katılımcı kaybı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "718e52c5-ec81-3037-88b5-da6b651b367d",
                    "sense_definition": "A temporary loss or disruption of an electronic audio, video, or data signal.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "electronics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Weak cellular coverage can cause a sudden signal <w>dropout</w> during a call.",
                            "target_lang_translations": {
                                "tr": "Zayıf hücresel kapsama alanı, bir arama sırasında ani bir sinyal <w>kesintisine</w> neden olabilir."
                            }
                        },
                        {
                            "text": "The broadcast suffered a brief audio <w>dropout</w> during the storm.",
                            "target_lang_translations": {
                                "tr": "Fırtına sırasında yayında kısa süreli bir ses <w>kesintisi</w> yaşandı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "audio dropout",
                        "signal dropout"
                    ],
                    "target_lang_definitions": {
                        "tr": "Elektronik ses, görüntü veya veri sinyalinde meydana gelen geçici kesinti veya kayıp."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kesinti",
                                "target_lang_sense_clarification": "sinyal veya ses kaybı"
                            },
                            {
                                "target_lang_word": "sinyal düşmesi",
                                "target_lang_sense_clarification": "geçici sinyal kaybı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23449930-0a2d-38a1-8d3d-5dc410739f9e",
                    "sense_definition": "A slot in a bicycle frame or fork that allows the wheel axle to be inserted or removed quickly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He carefully aligned the rear wheel in the bicycle <w>dropout</w>.",
                            "target_lang_translations": {
                                "tr": "Arka tekerleği bisikletin <w>tekerlek yuvasına</w> dikkatlice hizaladı."
                            }
                        },
                        {
                            "text": "Corrosion in the frame <w>dropout</w> made it hard to change the wheel.",
                            "target_lang_translations": {
                                "tr": "Kadro <w>yuvasındaki</w> korozyon tekerleği değiştirmeyi zorlaştırdı."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bisiklet kadrosunda veya maşasında tekerlek milinin hızlıca takılıp çıkarılmasını sağlayan yuva."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tekerlek yuvası",
                                "target_lang_sense_clarification": "bisiklet kadrosundaki mil geçme yeri"
                            },
                            {
                                "target_lang_word": "dropout",
                                "target_lang_sense_clarification": "bisiklet terimi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a02dffba-98e3-3a16-a3d6-517d67d7cb3c",
                    "sense_definition": "A regularization technique in machine learning where randomly selected neurons are ignored during training.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We applied <w>dropout</w> to the neural network to prevent overfitting.",
                            "target_lang_translations": {
                                "tr": "Aşırı öğrenmeyi önlemek için yapay sinir ağına <w>dropout</w> uyguladık."
                            }
                        },
                        {
                            "text": "Using a higher <w>dropout</w> rate helped improve the model's performance on unseen data.",
                            "target_lang_translations": {
                                "tr": "Daha yüksek bir <w>dropout</w> oranı kullanmak, modelin görülmemiş veriler üzerindeki performansını artırmaya yardımcı oldu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Maksimum uyumu (overfitting) önlemek için eğitim sırasında rastgele seçilen nöronların göz ardı edildiği bir makine öğrenmesi tekniği."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dropout",
                                "target_lang_sense_clarification": "yapay zeka terimi"
                            },
                            {
                                "target_lang_word": "nöron seyreltme",
                                "target_lang_sense_clarification": "makine öğreniminde seyreltme tekniği"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}