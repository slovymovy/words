                "senses": [
                    {
                        "sense_id": "73e3bf0f-87ea-3b72-815d-1fcbd512838d",
                        "entry_id": "9a5c3abc-5498-335e-859b-c9ce9e522fb2",
                        "glosses": [
                            "proces podziału redukcyjnego jądra komórkowego, z którego powstają cztery jądra o połowie chromosomów komórki macierzystej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0ba9aee-fc7f-4c62-869b-abb4a5f6cc8f",
                                "sense_id": "73e3bf0f-87ea-3b72-815d-1fcbd512838d",
                                "text": "Jutro mam sprawdzian z biologii; uczę się, czym są mejoza i mitoza."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf83617a-3ada-4af2-b1af-b0c93d226500",
                        "source_entry_id": "9a5c3abc-5498-335e-859b-c9ce9e522fb2",
                        "source_sense_id": "73e3bf0f-87ea-3b72-815d-1fcbd512838d",
                        "target_lang_word": "meiosis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meiosis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "430b339d-c932-36bc-8b83-852ad4569f1b",
                                        "entry_id": "a3c2a8f4-859f-375a-913f-b72e5de17246",
                                        "glosses": [
                                            "A figure of speech whereby something is made to seem smaller or less important than it actually is."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fead9b3-4153-45d5-8afd-289b5d7f64a8",
                                                "sense_id": "430b339d-c932-36bc-8b83-852ad4569f1b",
                                                "text": "I knew, with one of those secret knowledges that can exist between two people, that her suicide was a direct result of my having told her of my own attempt – I had told it with a curt meiosis that was meant to conceal depths; and she had called my bluff one final time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b745168d-75ce-334b-8050-fbe1073d5bbe",
                                        "entry_id": "a3c2a8f4-859f-375a-913f-b72e5de17246",
                                        "glosses": [
                                            "Cell division of a diploid cell into four haploid cells, which develop to produce gametes."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
