                    },
                    {
                        "translation_id": "36efcbe4-44b2-45f1-8758-7e390a5f2a1a",
                        "source_entry_id": "27a4f2e9-24fe-397b-abc3-069ff4295b86",
                        "source_sense_id": "bd9cc2a7-9709-3543-a1ef-9e4874b50f20",
                        "source_sense_description": "so, dass es fließen kann",
                        "target_lang_word": "fluid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fluid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f16cafdd-151f-3d1b-a31e-fdbe1752205f",
                                        "entry_id": "87a688b5-66a6-3ff0-aa15-058d34d781b7",
                                        "glosses": [
                                            "Any substance which can flow with relative ease, tends to assume the shape of its container, and obeys Bernoulli's principle; a liquid, gas or plasma."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a8a5f9b-0c95-43d8-ac8c-27c630af1571",
                                                "sense_id": "f16cafdd-151f-3d1b-a31e-fdbe1752205f",
                                                "text": "An extreme version of vorticity is a vortex. The vortex is a spinning, cyclonic mass of fluid, which can be observed in the rotation of water going down a drain, as well as in smoke rings, tornados and hurricanes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1993f108-1277-30b1-a4b7-7d3eedc1d4db",
                                        "entry_id": "87a688b5-66a6-3ff0-aa15-058d34d781b7",
                                        "glosses": [
                                            "A liquid (as opposed to a solid or gas)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9306056-68f7-4870-8382-cb43551046e2",
                                                "sense_id": "1993f108-1277-30b1-a4b7-7d3eedc1d4db",
                                                "text": "fluid inclusion Petrology, a tiny fluid- or gas-filled cavity in an igneous rock. 1-100 micrometers in diameter, formed by the entrapment of a fluid, typically that from which the rock crystallized."
                                            },
                                            {
                                                "example_id": "88ccf238-4b06-47a7-aede-906085c2c140",
                                                "sense_id": "1993f108-1277-30b1-a4b7-7d3eedc1d4db",
                                                "text": "The Doctor: Get a good night's sleep and drink plenty of fluids. / Kes: Fluids? / The Doctor: Everybody should drink plenty of fluids."
                                            },
                                            {
                                                "example_id": "34e97dc8-e89e-4f7c-9659-a40d0e30c8b2",
                                                "sense_id": "1993f108-1277-30b1-a4b7-7d3eedc1d4db",
                                                "text": "For studying interfaces between solid and another solid, fluid, or gas, a sample can be oriented with its reflecting surface(s) vertical (and with the scattering plane, as defined by nominal incident and reflected wavevectors, horizontal)."
                                            },
                                            {
                                                "example_id": "f794092d-71ce-4f2f-a036-4f5c138f314d",
                                                "sense_id": "1993f108-1277-30b1-a4b7-7d3eedc1d4db",
                                                "text": "Tenderness: is the lump tender?\nComposition: is the mass solid, fluid or gas?"
                                            },
                                            {
                                                "example_id": "6962473e-5732-4cbb-bb2e-9815234eb878",
                                                "sense_id": "1993f108-1277-30b1-a4b7-7d3eedc1d4db",
                                                "text": "The choke manifold then expels the fluid or gas to the gas buster or a panic line. The panic line will then either send the fluid or gas to the reserve pit or a flare stack or flare tank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f05c25ae-cd2c-31ad-9f33-1715bade9aeb",
                                        "entry_id": "87a688b5-66a6-3ff0-aa15-058d34d781b7",
                                        "glosses": [
                                            "Intravenous fluids."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "specifically",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fluid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33f57396-008e-34f9-a97b-99e40055c848",
                                        "entry_id": "3ee01c93-3997-335d-8cf1-899b3e8512ff",
                                        "glosses": [
                                            "Of or relating to fluid."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25c41a81-1b07-3cbb-86db-a9642422cff7",
                                        "entry_id": "3ee01c93-3997-335d-8cf1-899b3e8512ff",
                                        "glosses": [
                                            "In a state of flux; subject to change."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d19de35-19fa-4c66-bb5c-4dec0da053d0",
                                                "sense_id": "25c41a81-1b07-3cbb-86db-a9642422cff7",
                                                "text": "Economics is a messy discipline: too fluid to be a science, too rigorous to be an art. Perhaps it is fitting that economists’ most-used metric, gross domestic product (GDP), is a tangle too. GDP measures the total value of output in an economic territory. Its apparent simplicity explains why it is scrutinised down to tenths of a percentage point every month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17dd6ac3-5ca2-3c99-bf5b-ffb52af3de0a",
                                        "entry_id": "3ee01c93-3997-335d-8cf1-899b3e8512ff",
                                        "glosses": [
                                            "Moving smoothly, or giving the impression of a liquid in motion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9a50589-7a34-49b4-b3de-6bc10115ade5",
                                                "sense_id": "17dd6ac3-5ca2-3c99-bf5b-ffb52af3de0a",
                                                "text": "Tom of the fluid pelvis, undulating about the living room in defiance of Michael's taboo on sensuality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c741abec-91b0-3e67-a85a-145c850a394e",
                                        "entry_id": "3ee01c93-3997-335d-8cf1-899b3e8512ff",
                                        "glosses": [
                                            "Convertible into cash."
                                        ],
                                        "tags": [
                                            "of an asset"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1fc71bd1-c125-3b48-bb8d-475abc3af740",
                                        "entry_id": "3ee01c93-3997-335d-8cf1-899b3e8512ff",
                                        "glosses": [
                                            "Genderfluid."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b69e2866-0e0d-4f40-bf76-dd876bb1720a",
                                                "sense_id": "1fc71bd1-c125-3b48-bb8d-475abc3af740",
                                                "text": "Oh, Loki made sure of that. My mortal parents blamed him for the way I was, for being fluid."
                                            },
                                            {
                                                "example_id": "635b6ddb-6d57-40ca-a060-8f9842c097ef",
                                                "sense_id": "1fc71bd1-c125-3b48-bb8d-475abc3af740",
                                                "text": "As do renewals in genres such as romcoms and teen movies, which have updated sexist, heteronormative tropes to reflect audiences’ fluid, inclusive, queer realities."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
