                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "18a366a0-31d7-3600-91cb-fd9f608d9db8",
                        "entry_id": "091d6267-c9c4-3241-a937-c962b256dc32",
                        "glosses": [
                            "Gesicht, das dem eines Babys ähnelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1df8cf9e-46e3-4e99-b22e-458a6489f756",
                                "sense_id": "18a366a0-31d7-3600-91cb-fd9f608d9db8",
                                "text": "„Seine Augen waren blau und huschten umher – Schweinsäuglein; aus ihren aufgedunsenen Fettpolstern in dem zu runden Babygesicht glotzten sie etwas hervor.“"
                            },
                            {
                                "example_id": "1c1bfb47-71ff-41a0-98f7-cc8baf12be88",
                                "sense_id": "18a366a0-31d7-3600-91cb-fd9f608d9db8",
                                "text": "„Eduard hat plötzlich ein ekelhaft süffisantes Lächeln auf seinem Babygesicht und schweigt.“"
                            },
                            {
                                "example_id": "954f78fe-a916-4d09-8ec4-39a841db5702",
                                "sense_id": "18a366a0-31d7-3600-91cb-fd9f608d9db8",
                                "text": "„Der Eigentümer und Direktor einer Kette von »Ai«-Clubs hatte kurze Locken, einen dünnen Schnurrbart und trug eine Sonnenbrille, einen teuren Anzug, der dezent schimmerte, und eine gemusterte Seidenkrawatte, die so eng geknotet war, dass man fürchten musste, sein rundes Babygesicht werde unzureichend mit Sauerstoff versorgt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
