                                            {
                                                "example_id": "75f48dd4-78fb-44f7-b3d9-f130f6d9fbf1",
                                                "sense_id": "6e93ec86-1882-3c9f-87e5-95ea880d6b46",
                                                "text": "In kleine gemeenschappen bestaat het risico van inteelt."
                                            },
                                            {
                                                "example_id": "895741cd-f67b-47b8-82be-a64d506ea633",
                                                "sense_id": "6e93ec86-1882-3c9f-87e5-95ea880d6b46",
                                                "text": "Karel II (1661-1700) is de laatste Habsburger die koning van Spanje was. Karel II was geestelijk en lichamelijk gehandicapt als gevolg van inteelt."
                                            }
                                        ]
