                                        "entry_id": "a9759e52-31a1-3a78-b673-5478912648e8",
                                        "glosses": [
                                            "eine Veranstaltung, auf der musikalische Werke vorgetragen werden"
                                        ],
                                        "tags": [
                                            "Musik",
                                            "Veranstaltung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68bab91b-124f-44e6-b095-156897c0c790",
                                                "sense_id": "e734a31e-77e0-3d23-96b5-eb4f428f5497",
                                                "text": "Paul geht regelmäßig zu Konzerten."
                                            },
                                            {
                                                "example_id": "c67d1e12-d56f-4de3-9a69-0735778c79ba",
                                                "sense_id": "e734a31e-77e0-3d23-96b5-eb4f428f5497",
                                                "text": "„Papa sagte, dass er sich vor dem abendlichen Konzert noch etwas hinlegen wolle, sonst bekomme er das Konzert nicht richtig mit.“"
                                            },
                                            {
                                                "example_id": "8cc15614-ed07-4c39-b6d6-fbee1c3dd506",
                                                "sense_id": "e734a31e-77e0-3d23-96b5-eb4f428f5497",
                                                "text": "„Mit über hundert Konzerten im Jahr gab Liszt ein Pensum, das bis dahin noch kein Interpret bestritten hatte.“"
                                            },
                                            {
                                                "example_id": "09db86c8-fb8d-4bb2-8294-599e7ff75ab2",
                                                "sense_id": "e734a31e-77e0-3d23-96b5-eb4f428f5497",
                                                "text": "„April 1988: Die Scorpions spielten zehn ausverkaufte Konzerte im damaligen Leningrad, als zweite westliche Metal-Band in der UdSSR, nach Uriah Heep.“"
                                            },
                                            {
                                                "example_id": "28340963-7d36-4dc7-be58-8a5b0095d009",
                                                "sense_id": "e734a31e-77e0-3d23-96b5-eb4f428f5497",
                                                "text": "„Ich imitierte Maman; wenn wir in Köln Konzerte iranischer Bands besuchten, stand ich am Rand der Tanzfläche und schaute ihr stundenlang dabei zu, wie sie tanzte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5cf65ccf-fb5d-3e2a-a25e-b146ec65a0fd",
                                        "entry_id": "a9759e52-31a1-3a78-b673-5478912648e8",
                                        "glosses": [
