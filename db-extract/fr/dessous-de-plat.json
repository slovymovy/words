                                        "examples": [
                                            {
                                                "example_id": "e9bb57f9-b349-402b-9ecf-5e8c7f87c95b",
                                                "sense_id": "dd3d4e00-9665-3636-8a00-e80c2e2efb2b",
                                                "text": "I watch as Abikok scoops two spoonsful of rice, a spoonful of broccoli, a spoonful of peas, and a large chunk of roast beef into a plate. She then lifts it with both hands and places it on my table mat."
                                            }
                                        ]
                                    },
                                    {
