                "senses": [
                    {
                        "sense_id": "286fe93d-eaf8-3284-a512-3e36abfe8236",
                        "entry_id": "f9da8c12-c4fe-31e0-81c5-3de141957d7e",
                        "glosses": [
                            "A scent that indicates something in advance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc315efa-b278-418f-bf44-fa8612b245ec",
                                "sense_id": "286fe93d-eaf8-3284-a512-3e36abfe8236",
                                "text": "an appalling forescent of his own near approaching discomfiture"
                            },
                            {
                                "example_id": "feb13191-e5af-440b-b186-3985ca447414",
                                "sense_id": "286fe93d-eaf8-3284-a512-3e36abfe8236",
                                "text": "The patriarchs and prophets inhaled the sweet odour of Christ, Who was preordained to be born and to die in the flesh; yet they did not then give forth the same odour, because they could not exhibit in the flesh Him of Whom they had a fore-scent in the spirit."
                            },
                            {
                                "example_id": "6e5689e4-da6d-4a53-9b4b-246d88181cdd",
                                "sense_id": "286fe93d-eaf8-3284-a512-3e36abfe8236",
                                "text": "An allusion to the garlic breath of the groundlings provides a forescent of the evil smells that pervade the Genoan court."
                            },
                            {
                                "example_id": "fed715ba-576f-41e8-ba07-a53220ba38d7",
                                "sense_id": "286fe93d-eaf8-3284-a512-3e36abfe8236",
                                "text": "She opened the door on the night and felt the sudden damp forescent of autumn brush past her."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
