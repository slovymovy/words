                                "example_id": "6388213f-d624-45f5-bc0d-aa8d23fcaccb",
                                "sense_id": "3e6e8d48-3f53-3138-be6e-bddf4013aae8",
                                "text": "Volgens zijn familie en vrienden was de zeer sober levende Edhi een diepgelovige man, maar op een meer mystieke wijze, die niet strookte met het rechtlijnige geloof van de extremisten."
                            },
                            {
                                "example_id": "68a0b8ad-1a60-4422-b03e-c5448f53f511",
                                "sense_id": "3e6e8d48-3f53-3138-be6e-bddf4013aae8",
                                "text": "Trump en zijn team beseffen als geen ander dat rechtlijnige, coherente politieke communicatie bij de kiezer steeds minder tot de verbeelding spreekt."
                            }
                        ]
                    }
