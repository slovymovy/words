                    {
                        "translation_id": "d61873c0-b26f-42dd-bb43-abb306a2275b",
                        "source_entry_id": "81429250-46a7-3f9d-bae8-98282dbda73c",
                        "source_sense_description": "To treat with great respect and deference",
                        "target_lang_word": "vénérer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vénérer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c00bbd94-2538-3b78-8a80-429b73a8a0ac",
                                        "entry_id": "8c1a3bdf-ea43-352d-a0a8-4d20a259d730",
                                        "glosses": [
                                            "Rendre un culte à un dieu, à un saint ou à des choses saintes ou sacrées ; adorer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b65738a5-dcf5-41a3-af18-ff6a3fc1225d",
                                                "sense_id": "c00bbd94-2538-3b78-8a80-429b73a8a0ac",
                                                "text": "[…]; — ceux-là le croiront qui estiment que Berthe, femme de Girard de Roussillon, a pu entrer dans la légende sans le concours des moines de Pothières, lesquels vénéraient Berthe comme leur sainte; […]."
                                            },
                                            {
                                                "example_id": "e1f5b6ca-f2f8-4043-9f3d-055d1f1323bf",
                                                "sense_id": "c00bbd94-2538-3b78-8a80-429b73a8a0ac",
                                                "text": "Ainsi Le Chesne-Populeux (Ardennes) et La Chapelle-Gauthier (Eure) qui vénèrent au premier chef saint Martin dans un cas et Notre-Dame dans l'autre, avouent saint Jacques pour patron."
                                            },
                                            {
                                                "example_id": "6483b41d-d714-4d4b-b9c9-7f7b4742c2ce",
                                                "sense_id": "c00bbd94-2538-3b78-8a80-429b73a8a0ac",
                                                "text": "Ces exemples ne sont pas des cas isolés : ils révèlent un système où l’on enseigne aux enfants à vénérer la guerre et à voir le service militaire comme une destinée noble, quasi inévitable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f67ffe3e-b43e-3f85-a2fa-54b7faca1117",
                                        "entry_id": "8c1a3bdf-ea43-352d-a0a8-4d20a259d730",
                                        "glosses": [
                                            "Avoir un attachement ou un respect profond pour une personne."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff58dcac-58fa-4335-9dfe-8e6d7e1d64ea",
                                                "sense_id": "f67ffe3e-b43e-3f85-a2fa-54b7faca1117",
                                                "text": "[…], je vénère Faulkner et je ne peux oublier qu’en vérité c’est un pochetron, un pochetron honteux qui se cachait sous des façons collet monté."
                                            },
                                            {
                                                "example_id": "69e540df-a218-4b8e-ac14-2c2fb8c63296",
                                                "sense_id": "f67ffe3e-b43e-3f85-a2fa-54b7faca1117",
                                                "text": "De tous les pianistes soviétiques, Sofronitzki fut sans doute le plus adulé du public : Gilels et Richter eux-mêmes le vénéraient et ne manquaient pas ses récitals."
                                            },
                                            {
                                                "example_id": "7d052107-8533-49e4-b9e7-f20597b07a8f",
                                                "sense_id": "f67ffe3e-b43e-3f85-a2fa-54b7faca1117",
                                                "text": "Les sadhu ne sont pas des marginaux ou des fanatiques religieux, ce sont des hommes saints, vénérés par les hindous comme des représentants des divinités, entrés dans la voie de la libération et de l'élévation spirituelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9d15048-7133-4f31-8910-ac8f6cc8380b",
                        "source_entry_id": "81429250-46a7-3f9d-bae8-98282dbda73c",
                        "source_sense_description": "To treat with great respect and deference",
                        "target_lang_word": "почита́ть",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "почита́ть",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e5e27880-a594-3f80-8046-8164ac254d80",
                                        "entry_id": "e875d518-4888-3ff7-a881-e3e10ff47ed2",
                                        "glosses": [
                                            "совершить действие, выраженное гл. читать; провести некоторое время, совершая такое действие"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "349a0bd4-bc21-4122-a458-6de234611649",
                                                "sense_id": "e5e27880-a594-3f80-8046-8164ac254d80",
                                                "text": "Начни ты, Марфенька, а ты, Вера, послушай! Потом, когда Марфенька устанет, ты почитай. Книга хорошая, занимательная!"
                                            },
                                            {
                                                "example_id": "49219d3c-70a4-4548-8823-29bde6d7ab2d",
                                                "sense_id": "e5e27880-a594-3f80-8046-8164ac254d80",
                                                "text": "― Ах, кстати, ― перебил Зельтерский размышления Перегарина, ― не хотите ли, я почитаю вам своё сочинение?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9522578f-ca57-364d-afe6-95725ccaeeca",
                                        "entry_id": "e875d518-4888-3ff7-a881-e3e10ff47ed2",
                                        "glosses": [
                                            "ознакомиться с содержанием чего-либо путём чтения, прочитать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4fe7c8b-cce1-433c-8c30-9fec33e29cf0",
                                                "sense_id": "9522578f-ca57-364d-afe6-95725ccaeeca",
                                                "text": "Ты почитай газеты, что в стране творится!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "почита́ть",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "215268c0-fb3c-3a06-9885-8d3a9db2e7ee",
                                        "entry_id": "4d8e047f-3685-38ba-833e-230fc7a980fe",
                                        "glosses": [
                                            "кого (что); относиться к кому-либо, чему-либо с почтением, уважением"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac3d08f5-30c9-4d34-b63e-f99ce065820a",
                                                "sense_id": "215268c0-fb3c-3a06-9885-8d3a9db2e7ee",
                                                "text": "Почитай отца твоего и мать, это первая заповедь с обетованием: да будет тебе благо, и будешь долголетен на земле."
                                            },
                                            {
                                                "example_id": "3dfa9b1f-e267-4eb1-9448-44b1b249b935",
                                                "sense_id": "215268c0-fb3c-3a06-9885-8d3a9db2e7ee",
                                                "text": "Разве ты не видишь, как она его почитает, как она его уважает?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "почита́ть",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "131d494e-c771-36d8-b11a-35194abe381b",
                                        "entry_id": "5ced6b6e-5a2e-3d55-9003-aeffed63fe1b",
                                        "glosses": [
                                            "кого (что), за кого (что), кем (чем); устар. и разг. признавать, считать }"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b32535e-8efe-4353-b9f8-970d85401d13",
                                                "sense_id": "131d494e-c771-36d8-b11a-35194abe381b",
                                                "text": "Больше всего почитаю я себя виноватым перед господином Милетичем, к которому прилагаю при сем письмо, и прошу вас ему оное доставить."
                                            },
                                            {
                                                "example_id": "e521c64d-c87d-4c00-a9f1-8a0d95d773f8",
                                                "sense_id": "131d494e-c771-36d8-b11a-35194abe381b",
                                                "text": "Если я всё это вынесу, то буду себя почитать за истукана, который не стоит имени человека!.."
                                            },
                                            {
                                                "example_id": "2afdb92d-92f7-4c6f-8972-de2d54fec026",
                                                "sense_id": "131d494e-c771-36d8-b11a-35194abe381b",
                                                "text": "Где ближе было им разведаться, как не в стране, которую оба они почитали своею отчиною?"
                                            },
                                            {
                                                "example_id": "4e708032-fef4-4e23-ac01-612152d604bc",
                                                "sense_id": "131d494e-c771-36d8-b11a-35194abe381b",
                                                "text": "Этот народ докажет вам, что дважды два ― пять, что часть равна целому, что параллельные линии сходятся, и, словом, всё, что мы почитаем невозможным."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef94498c-3f4d-4f24-b062-6a5893cfbd91",
