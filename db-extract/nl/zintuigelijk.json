                    {
                        "sense_id": "e15dc260-9a7b-3b07-9ea6-1779cbf0f709",
                        "entry_id": "a3710c7f-9430-36ec-b583-716ac79ae487",
                        "glosses": [
                            "betrekking hebbend op de waarneming door de zintuigen; de zinnen prikkelend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ade6962c-1354-4ec9-af77-80705ae13de8",
                                "sense_id": "e15dc260-9a7b-3b07-9ea6-1779cbf0f709",
                                "text": "Voor op de koffieautomaat\nDe geur kleurt\neen zintuigelijk feest.\nDe smaak ontwaakt\nen opent de geest."
                            },
                            {
                                "example_id": "6369183b-958b-4ace-95cc-0e15a6cf22ce",
                                "sense_id": "e15dc260-9a7b-3b07-9ea6-1779cbf0f709",
                                "text": "De verslagen die in een verhalende vorm waren geschreven en een zintuigelijke stijl hanteerde werden opmerkelijk vaker geciteerd dan de studies die hun resultaten vooral verklarend presenteerde."
                            }
                        ]
                    }
