                                "target_senses": [
                                    {
                                        "sense_id": "a360dbe5-07f6-3ab7-8096-03e972a7cab9",
                                        "entry_id": "e0c9b24b-9447-3abd-a38e-dad638d8bad0",
                                        "glosses": [
                                            "Being or considered the greatest of all time; the best."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ff0c955-1b49-4067-895f-1f950679e9e5",
                                                "sense_id": "a360dbe5-07f6-3ab7-8096-03e972a7cab9",
                                                "text": "This restaurant's fries are goated."
                                            },
                                            {
                                                "example_id": "b2fe37b7-9425-4d26-aa8c-7834ce1fe1aa",
                                                "sense_id": "a360dbe5-07f6-3ab7-8096-03e972a7cab9",
                                                "text": "\"Congrats to the TRIPLE DOUBLE KING,\" George shared in an Instagram story on Monday night. \"Goated Brodie @russwest44!\"."
                                            },
                                            {
                                                "example_id": "42950c4f-0757-4929-81bb-f729c54ca310",
                                                "sense_id": "a360dbe5-07f6-3ab7-8096-03e972a7cab9",
                                                "text": "Migos is back. And they're goated, too. The rap group from Atlanta announced their newest project in a way even Michael Jordan would approve of..."
                                            },
                                            {
                                                "example_id": "8c4b0a84-8671-454a-b85c-8ca0ed479b12",
                                                "sense_id": "a360dbe5-07f6-3ab7-8096-03e972a7cab9",
                                                "text": "\"He's GOATed, man,\" Ravens outside linebacker Odafe Oweh said. \"We're just watching history right there. It's an honor to see that.\""
                                            }
                                        ]
                                    }
                                ]
