                        "glosses": [
                            "Que l’on ne peut pas encaisser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b18c9e6d-37c0-48ff-a8d2-fd0981096b2d",
                                "sense_id": "1e97043b-0633-3faf-ad15-3b227d9aa6be",
                                "text": "Que l’on se rassure : le manuscrit lui sera bien renvoyé, à nos frais, parce que le chèque était inencaissable."
