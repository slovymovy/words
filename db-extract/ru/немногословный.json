                        "sense_id": "100050c0-1187-3c50-bd29-b7340615c84c",
                        "entry_id": "5fc22bfb-de85-3ee7-9563-c5f6c7b21758",
                        "glosses": [
                            "выраженный немногими словами"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "38ff3f07-be0c-3fed-af72-b9ec2316ff71",
                        "entry_id": "5fc22bfb-de85-3ee7-9563-c5f6c7b21758",
                        "glosses": [
                            "не любящий много говорить"
                        ],
                        "tags": [],
