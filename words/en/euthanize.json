    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "05315ef2-efdc-3351-b6a4-84952a171a24",
                    "sense_definition": "To perform a painless death on a person or animal to end suffering.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical_procedure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The veterinarian had to <w>euthanize</w> the suffering horse after the accident.",
                            "target_lang_translations": {
                                "zh": "事故发生后，兽医不得不对那匹痛苦的马<w>执行安乐死</w>。"
                            }
                        },
                        {
                            "text": "Laws regarding when a doctor may <w>euthanize</w> a patient vary significantly between different countries.",
                            "target_lang_translations": {
                                "zh": "关于医生何时可以为病人<w>执行安乐死</w>的法律在不同国家之间差异巨大。"
                            }
                        }
                    ],
                    "synonyms": [
                        "put to sleep",
                        "put down"
                    ],
                    "common_phrases": [
                        "put to sleep",
                        "put down"
                    ],
                    "target_lang_definitions": {
                        "zh": "对人或动物实施无痛死亡，以结束其痛苦。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "安乐死",
                                "target_lang_sense_clarification": "指通过医疗手段结束生命，常用于动物或法律允许的医疗情况。"
                            },
                            {
                                "target_lang_word": "执行安乐死",
                                "target_lang_sense_clarification": "作为动词短语，指实施安乐死这一医疗行为。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}