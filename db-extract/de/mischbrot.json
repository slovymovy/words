                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d10c6cc0-d9b1-471d-a6dd-10d5827b6584",
                                                "sense_id": "e93b98ad-8548-3607-8459-439bbc42f717",
                                                "text": "I thought I was ready for the cold cook then. I swear it. I really thought I was brown bread."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e844093a-d99f-48a8-81da-34c16b88a608",
                        "source_entry_id": "96599f79-fa98-3f33-83ca-791f4c7a0676",
                        "source_sense_id": "170d3501-6678-3c66-baaa-1209b0431e4b",
                        "source_sense_description": "Brot, das Roggen- und Weizenmehl enthält",
                        "target_lang_word": "pain bis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pain bis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b7976398-30b1-3011-bebd-4e7dc1840f6c",
                                        "entry_id": "1a55df83-1930-32eb-80d4-b71d429f3da5",
                                        "glosses": [
                                            "Pain fabriqué à partir de farines bises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37cea1b8-2dbd-49e4-8129-3aefeefab9c5",
                                                "sense_id": "b7976398-30b1-3011-bebd-4e7dc1840f6c",
                                                "text": "Avec du laitage, des œufs, des herbes, du fromage, du pain bis et du vin passable, on est toujours sûr de bien me régaler"
                                            },
                                            {
                                                "example_id": "cce14b72-52bb-4a82-8600-21ea018e2cda",
                                                "sense_id": "b7976398-30b1-3011-bebd-4e7dc1840f6c",
                                                "text": "— N’était-ce point satiété ? dit Blazius, car d’ambroisie même on se dégoûte, et les dieux viennent manger sur terre le pain bis des humains."
                                            },
                                            {
                                                "example_id": "7364f79c-860d-4f5c-b0e1-28ef8f3c630d",
                                                "sense_id": "b7976398-30b1-3011-bebd-4e7dc1840f6c",
                                                "text": "Pendant qu’elle disposait les bols et qu’elle tirait de la huche la bonne miche de pain bis, mon compagnon lui demanda […]"
                                            },
                                            {
                                                "example_id": "5d84ff56-5557-4e0a-aa2e-2994d6b1cc06",
                                                "sense_id": "b7976398-30b1-3011-bebd-4e7dc1840f6c",
                                                "text": "A onze heures il arrivait à Fresnay-les-Chaumes, déjeunait à l'unique bouchon de ce hameau de Pithiviers-le-Vieil, d'un chanteau de pain bis et d'un hareng saur, additionnés d'un petit vin du pays qui lui fit faire une de ces grimaces !"
                                            },
                                            {
                                                "example_id": "96146c86-141a-4d13-82d3-c6b67692d145",
                                                "sense_id": "b7976398-30b1-3011-bebd-4e7dc1840f6c",
                                                "text": "La misère s’était abattue sur la grand’mère et sur l’enfant. Elles vivaient de rien, d’un morceau de pain bis, d’un sou de lait."
                                            },
                                            {
                                                "example_id": "cdea4985-454d-4493-9d12-913de004ac77",
                                                "sense_id": "b7976398-30b1-3011-bebd-4e7dc1840f6c",
                                                "text": "Les jeunes mordaient à pleines dents dans leur pain, tandis que les vieux coupaient précieusement chaque bouchée. Tous mangeaient en silence, et le pain bis paraissait plus blanc dans leurs mains noires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0d4ce1e-d75f-394b-84f3-a895cfaac942",
                                        "entry_id": "1a55df83-1930-32eb-80d4-b71d429f3da5",
                                        "glosses": [
                                            "Nourriture spirituelle de qualité inférieure, désagréable à assimiler."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0716e6a6-defa-475e-a19e-d30407e1edbe",
                                                "sense_id": "c0d4ce1e-d75f-394b-84f3-a895cfaac942",
                                                "text": "Il ne put s’accoutumer au pain bis de la scolastique ; il partit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
