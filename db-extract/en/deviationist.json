                    {
                        "translation_id": "c378d33a-3b4c-460e-96ea-3275d9cdfcb3",
                        "source_entry_id": "de3e8b6e-de80-3a72-8d7c-a0a875e8a1d0",
                        "source_sense_id": "b678e41d-8891-3344-a5fe-b6781f2d3bb6",
                        "source_sense_description": "One who deviates from accepted beliefs or policies",
                        "target_lang_word": "Dissident",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dissident",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8121850a-ab5f-3854-abe1-6cf35cc3c4d5",
                                        "entry_id": "3b56668e-de79-3bce-9586-cb5ee659a64d",
                                        "glosses": [
                                            "Person, die öffentlich gegen die allgemeine Meinung oder politisch autoritäre Macht auftritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef5a6b6b-cc99-4ced-afae-a0da003b45c1",
                                                "sense_id": "8121850a-ab5f-3854-abe1-6cf35cc3c4d5",
                                                "text": "„Lis Unterstützer Zhou Zhirong berichtete zudem am Donnerstag, die Polizei habe allen Angehörigen und Freunden des Dissidenten gesagt, der 62-Jährige habe Selbstmord begangen und sie sollten die Angelegenheit ‚nicht an die große Glocke hängen‘.“"
                                            },
                                            {
                                                "example_id": "9bf01ae2-d12e-44c5-836f-5ccebd054a6a",
                                                "sense_id": "8121850a-ab5f-3854-abe1-6cf35cc3c4d5",
                                                "text": "„So weit ich zurückblicken kann, war ich als junger Dissident ständig auf der Suche nach westlich aussehenden Lebensmitteln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "baa9cf8a-aa49-3e2a-b8ef-01b98532bb33",
                                        "entry_id": "3b56668e-de79-3bce-9586-cb5ee659a64d",
                                        "glosses": [
                                            "Person, die entgegen den Bestimmungen des bestehenden Finanzsystems handelt"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "4067e42f-4b4e-3561-aa29-79eb90b6da71",
                                        "entry_id": "3b56668e-de79-3bce-9586-cb5ee659a64d",
                                        "glosses": [
                                            "Person, die nicht der katholischen Kirche angehört"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "0edfc179-efa0-30e2-b789-e770466fc2c7",
                                        "entry_id": "3b56668e-de79-3bce-9586-cb5ee659a64d",
                                        "glosses": [
                                            "Person, die sich zu keiner anerkannten Religionsgemeinschaft bekennt; Konfessionsloser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2274d19-a544-4112-9e17-5fcb7d7e9fd6",
                                                "sense_id": "0edfc179-efa0-30e2-b789-e770466fc2c7",
                                                "text": "„Der evangelische Christ Hindenburg, der ‚getreue Eckehart‘, wurde – im Gegensatz zu dem Dissidenten Ebert – als ein Mann gepriesen, der seine Staatsauffassung und Berufsverpflichtung ‚aus den tiefsten Quellen evangelisch-christlicher Glaubensverantwortung‘ schöpfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2b\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d924b23e-5048-482b-9458-71542cf1111d",
                        "source_entry_id": "de3e8b6e-de80-3a72-8d7c-a0a875e8a1d0",
                        "source_sense_id": "b678e41d-8891-3344-a5fe-b6781f2d3bb6",
