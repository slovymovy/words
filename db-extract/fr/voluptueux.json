                                            {
                                                "example_id": "bb4fce0d-2982-45e7-8b33-0de1469a6279",
                                                "sense_id": "139b8457-fa2f-34dc-9d17-9a5ea06f341f",
                                                "text": "The plentiful blankets and the voluptuous pillows of the bed called out to my tired body."
                                            },
                                            {
                                                "example_id": "53709392-ca2d-4bfa-814b-aacb3048f8ec",
                                                "sense_id": "139b8457-fa2f-34dc-9d17-9a5ea06f341f",
                                                "text": "Thus we lay, whilst a voluptuous languor possest, and still maintain'd us motionless and fast locked in one another's arms",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            },
                                            {
                                                "example_id": "b976bc00-d892-4fc2-88e3-ab72f2f5a04e",
                                                "sense_id": "139b8457-fa2f-34dc-9d17-9a5ea06f341f",
                                                "text": "It was upon riches he founded his claim to importance; riches could alone supply the enjoyments of luxury; those voluptuous pleasures upon which the sensualist refines, and without which life appears but a mere vegetative existence, unproductive of enjoyment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ef8ce4f-41af-3948-ae87-cdd7bf676082",
                                        "entry_id": "60665c01-1cb3-3f30-af2d-bb025efd250e",
                                        "glosses": [
                                            "Curvaceous and sexually attractive."
                                        ],
