                {
                    "sense_id": "f8569c60-9a2f-32c8-a366-e4746523ae61",
                    "sense_definition": "Obsolete form of <w>that's</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "contraction_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He said <w>thats</w> the only way to solve the problem.",
                            "target_lang_translations": {
                                "ru": "Он сказал, что <w>это</w> единственный способ решить проблему.",
                                "de": "Er sagte, <w>das ist</w> der einzige Weg, das Problem zu lösen.",
                                "fr": "Il a dit que <w>c'est</w> la seule façon de résoudre le problème.",
                                "it": "Ha detto che <w>quello è</w> l'unico modo per risolvere il problema."
                            }
                        },
                        {
                            "text": "I believe <w>thats</w> exactly what she meant.",
                            "target_lang_translations": {
                                "ru": "Я полагаю, <w>это</w> именно то, что она имела в виду.",
                                "de": "Ich glaube, <w>das ist</w> genau das, was sie meinte.",
                                "fr": "Je crois que <w>c'est</w> exactement ce qu'elle voulait dire.",
                                "it": "Credo che <w>ciò sia</w> esattamente quello che intendeva."
                            }
                        }
                    ],
                    "common_phrases": [
                        "thats flat"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "standard modern spelling is that's"
                        },
                        {
                            "trait_type": "form",
                            "comment": "contraction"
                        }
                    ],
                    "target_lang_definitions": {
