        "fr-extract.jsonl": [
            {
                "entry_id": "a2aa0542-62ca-35c5-8410-ae5bd8d3109f",
                "word": "dystopique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d2e8c8c1-e27d-4339-9a70-16de8c124fef",
                        "entry_id": "a2aa0542-62ca-35c5-8410-ae5bd8d3109f",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "dystopiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "693869f6-da84-384b-8fdb-9258363d3939",
                        "entry_id": "a2aa0542-62ca-35c5-8410-ae5bd8d3109f",
                        "glosses": [
                            "Relatif à la dystopie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e01c2c10-57aa-4e71-9dc0-018d6a0be4fb",
                                "sense_id": "693869f6-da84-384b-8fdb-9258363d3939",
                                "text": "Le genre dystopique a le vent en poupe - témoin, le regain de gloire de « La servante écarlate », de Margaret Atwood -, et les scénarios pour un avenir en noir sont légion."
                            },
                            {
                                "example_id": "7dd7fd5f-edea-4e68-b85a-291563036a10",
                                "sense_id": "693869f6-da84-384b-8fdb-9258363d3939",
                                "text": "Et puis, dans cette ambiance dystopique, l’humanité n’a-t-elle pas désespérément besoin d’un peu de joie et d’espoir ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4cda32ed-9c61-4f04-81ed-c12e0b614154",
                        "source_entry_id": "a2aa0542-62ca-35c5-8410-ae5bd8d3109f",
                        "source_sense_id": "693869f6-da84-384b-8fdb-9258363d3939",
                        "target_lang_word": "dystopian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dystopian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa8fb251-62bf-35b6-ad43-70160e9ee58f",
                                        "entry_id": "60ddb0da-097c-3d3e-bae8-270b1937b08c",
                                        "glosses": [
                                            "Of or pertaining to a dystopia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85c87f3d-bb24-423b-871a-de41a6577856",
                                                "sense_id": "fa8fb251-62bf-35b6-ad43-70160e9ee58f",
                                                "text": "If Suzanne Collins’ novel The Hunger Games turns up on middle-school curricula 50 years from now—and as accessible dystopian science fiction with allusions to early-21st-century strife, that isn’t out of the question—the lazy students of the future can be assured that they can watch the movie version and still get better than a passing grade."
                                            },
                                            {
                                                "example_id": "65475871-4ab4-48b2-b853-69b25cb45a42",
                                                "sense_id": "fa8fb251-62bf-35b6-ad43-70160e9ee58f",
                                                "text": "In my book Britain has actually worked out how it wants to leave and the EU is preparing a new constitution as a result. The real Brexit is actually much more dystopian."
                                            },
                                            {
                                                "example_id": "67d9266f-91f6-4f37-b42a-162bec2b825b",
                                                "sense_id": "fa8fb251-62bf-35b6-ad43-70160e9ee58f",
                                                "text": "He kept thinking about an episode of “Black Mirror,” the British dystopian anthology series, in which the characters rate everyone they interact with on a scale of 1 to 5 stars. (It doesn’t end well.)"
                                            },
                                            {
                                                "example_id": "2d254607-727f-4872-8671-76741947b6d2",
                                                "sense_id": "fa8fb251-62bf-35b6-ad43-70160e9ee58f",
                                                "text": "The whole city is immersed in a dystopian-looking smog: urban streets in sepia, emptier than usual, bathed in an eerie quiet."
                                            },
                                            {
                                                "example_id": "81ab9d65-b46c-4d08-ba53-abbb9847afbf",
                                                "sense_id": "fa8fb251-62bf-35b6-ad43-70160e9ee58f",
                                                "text": "A pioneer of modern AI and Meta’s chief AI scientist, LeCun is one of the technology’s most vocal defenders. He scoffs at his peers’ dystopian scenarios of supercharged misinformation and even, eventually, human extinction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b11fd75-f3af-3d71-9f3d-789aa97f9e8e",
                                        "entry_id": "60ddb0da-097c-3d3e-bae8-270b1937b08c",
                                        "glosses": [
                                            "Dire; characterized by human suffering or misery."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
