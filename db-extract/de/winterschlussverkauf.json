                "senses": [
                    {
                        "sense_id": "e3f65d6b-466b-33db-a13e-025a3cdc673f",
                        "entry_id": "1668f28e-cc0e-3ef6-a608-3d8c2e4f40a5",
                        "glosses": [
                            "Verkauf von Waren zu reduzierten Preisen am Ende der Verkaufssaison, die im Winter endet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae599460-33c3-4c6e-81e1-18685cd01046",
                                "sense_id": "e3f65d6b-466b-33db-a13e-025a3cdc673f",
                                "text": "Im Winterschlussverkauf kann man günstig Winterware erstehen."
                            },
                            {
                                "example_id": "e2d512f8-15fa-485c-903e-cc0779a82a7d",
                                "sense_id": "e3f65d6b-466b-33db-a13e-025a3cdc673f",
                                "text": "„Wenn man außerdem noch am Neujahrsmorgen die Weihnachtsgeschenke zum Umtausch bereitlegt und pflichtgemäß dem Winterschlussverkauf entgegenfiebert, kann die Gefahr weihnachtlicher Besinnung als überwunden angesehen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
