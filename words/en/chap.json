                },
                {
                    "sense_id": "0832b1c8-ab9e-3167-aba6-3a1823cf7833",
                    "sense_definition": "A customer or buyer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shopkeeper was happy to see a new <w>chap</w> enter the store.",
                            "target_lang_translations": {
                                "ru": "Лавочник был рад видеть нового <w>покупателя</w>, вошедшего в магазин."
                            }
