                        "tags": [],
                        "examples": [
                            {
                                "example_id": "792b9871-69c4-4504-a787-46099ba43636",
                                "sense_id": "88b07970-13d7-323c-9968-53aa3272e359",
                                "text": "Derrière elle se profilait la silhouette de Ducup, tiré à quatre épingles, calamistré, avec sa tête de rat malade, le sourire ironique qu’il avait adopté une fois pour toutes et qu’il jugeait catégorique."
                            },
                            {
                                "example_id": "4469c44f-336a-44e8-93a7-a28d7511038c",
                                "sense_id": "88b07970-13d7-323c-9968-53aa3272e359",
                                "text": "Il y avait à Paris des colonies familiales d’artistes; le dimanche, tous, brossés, calamistrés, en belles redingotes, emmenaient leurs familles à Versailles, dans le bain…"
                            },
                            {
                                "example_id": "0e68d63e-20b5-4955-9926-fb71f80fd0ce",
                                "sense_id": "88b07970-13d7-323c-9968-53aa3272e359",
                                "text": "Le type qui chantait était une gros Noir joufflu aux cheveux coupés courts mais très calamistrés."
                            }
                        ]
                    }
                ],
