                        "examples": [
                            {
                                "example_id": "f0f1672e-52d0-4f09-a505-72f9bfee526b",
                                "sense_id": "4daa8506-7bc3-32e2-8d78-e657931caa93",
                                "text": "Дней через 6 еду на Алтай, у меня седло и все обмундирование и поеду как интурист."
                            },
                            {
                                "example_id": "036a028b-3b1b-40d2-b481-71ec3ebe934d",
                                "sense_id": "4daa8506-7bc3-32e2-8d78-e657931caa93",
                                "text": "[Мартынов] Что ты меня агитируешь? Что я тебе, интурист?"
                            }
                        ]
                    }
