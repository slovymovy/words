                "senses": [
                    {
                        "sense_id": "96b665ed-1921-3ee9-98fb-e39efd059db5",
                        "entry_id": "8eb53467-95f9-3c7d-9a17-f7ea04b72618",
                        "glosses": [
                            "имеющий щели, множество щелей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdb9d1dd-1f4b-4cfc-b1f1-3130c5ab3a44",
                                "sense_id": "96b665ed-1921-3ee9-98fb-e39efd059db5",
                                "text": "Зал был большой, но какой-то неопрятный, подержанный, с низковатым потолком, запачканными печами и щелистым полом, и воздух был спертый, нагретый и пыльный."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db006e78-1006-4081-b2d5-5721bca743d8",
                        "source_entry_id": "8eb53467-95f9-3c7d-9a17-f7ea04b72618",
                        "source_sense_id": "96b665ed-1921-3ee9-98fb-e39efd059db5",
                        "target_lang_word": "chinky",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chinky",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89c120bd-bb6f-3213-acc4-3eca26108da7",
                                        "entry_id": "2591e4d1-8be9-362c-b3f0-690234c00402",
                                        "glosses": [
                                            "Full of chinks, laden with small cracks or openings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e37f662-c776-41f6-af92-eb676c1e66fc",
                                                "sense_id": "89c120bd-bb6f-3213-acc4-3eca26108da7",
                                                "text": "[…] the accustomed warmth pierced his marrow, and ran thrilling through his shaken bones; just as when at times, with forked thunder burst, a chinky stream of fire in flashy lightning shoots athwart the skies."
                                            },
                                            {
                                                "example_id": "02ba2a1f-808c-4da5-b863-a80e93d40a4d",
                                                "sense_id": "89c120bd-bb6f-3213-acc4-3eca26108da7",
                                                "text": "The door was knockerless and chinky, and creaked dismally as I inserted the key."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea789b2f-f840-30ee-878a-47273e1d94d4",
                                        "entry_id": "2591e4d1-8be9-362c-b3f0-690234c00402",
                                        "glosses": [
                                            "Resembling a chink sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cac0efda-ab3b-4e88-8d83-9ba0b787d669",
                                                "sense_id": "ea789b2f-f840-30ee-878a-47273e1d94d4",
                                                "text": "The money made a chinky sound as I shook the purse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chinky",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "023ee454-2d60-3031-a101-57353b0f9013",
                                        "entry_id": "105348e8-f0bb-3f2a-b835-a4cd6417b2bb",
                                        "glosses": [
                                            "Possessing attributes of, or similar to, a Chinese person or Chinese style or culture."
                                        ],
                                        "tags": [
