                                        "glosses": [
                                            "Alone; without assistance; by oneself."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e04f7b83-c240-408d-8adb-72712b7445f1",
                                                "sense_id": "9bf9b410-1ad3-3676-b75b-6196105c7b4d",
                                                "text": "She single-handedly organized the whole event, and even set up all the chairs herself."
                                            },
                                            {
                                                "example_id": "b4cf4423-2342-4e81-a650-002a727a661d",
                                                "sense_id": "9bf9b410-1ad3-3676-b75b-6196105c7b4d",
                                                "text": "Charlie Chaplin, the poignant little tramp with the cane and comic walk who almost single — handedly elevated the novelty entertainment medium of motion pictures into art, died peacefully yesterday at his home in Switzerland[…]"
                                            },
                                            {
                                                "example_id": "280a11f5-57fc-4561-8a9d-48d5769785cc",
                                                "sense_id": "9bf9b410-1ad3-3676-b75b-6196105c7b4d",
                                                "text": "“Despite the surge in prices weighing on their purchasing power, the U.S. consumer now appears to be single-handedly keeping the global economy afloat,” Paul Ashworth, an economist at Capital Economics, wrote in a note."
                                            }
                                        ]
                                    }
                                ]
