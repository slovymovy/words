                        "sense_id": "f6b02c9c-2768-3962-91a7-c057061b905e",
                        "entry_id": "6ff834a8-813c-3690-a25d-223fc730b72a",
                        "glosses": [
                            "ou Variante orthographique de avec."
                        ],
                        "tags": [
                            "obsolete",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "7672868f-2d34-4c72-87e2-ba58a229a980",
                                "sense_id": "f6b02c9c-2768-3962-91a7-c057061b905e",
                                "text": "Laisse-les espérer, laisse-les entreprendre.\nIl suffit que ta cause est la cause de Dieu,\nEt qu’avecque ton bras elle a pour la défendre\nLes soins de Richelieu"
                            },
                            {
                                "example_id": "cccba3de-17b9-41ea-b058-3b8835a56cc3",
                                "sense_id": "f6b02c9c-2768-3962-91a7-c057061b905e",
                                "text": "Arrive le garde-champêtre, avecque des gendarmes."
                            },
                            {
                                "example_id": "888c56a1-287b-413f-8c72-84148595b2b2",
                                "sense_id": "f6b02c9c-2768-3962-91a7-c057061b905e",
                                "text": "Dans le cristal d’une Fontaine\nUn Cerf se mirant autrefois,\nLouait la beauté de son bois,\nEt ne pouvait qu’avecque peine\nSouffrir ses jambes de fuseaux."
                            },
                            {
                                "example_id": "d98f12d9-c982-4892-9289-445ae8ac4179",
                                "sense_id": "f6b02c9c-2768-3962-91a7-c057061b905e",
                                "text": "Le surnom d'infâme\nMe va comme un gant :\nD'avecque ma femme\nJ'ai foutu le camp."
                            }
                        ]
                    }
                ],
