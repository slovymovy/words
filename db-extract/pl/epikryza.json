                    },
                    {
                        "translation_id": "3bffd472-0a27-4510-8593-c38ba3c044f0",
                        "source_entry_id": "e230e355-7925-300a-b66c-3076d00980ef",
                        "source_sense_id": "f3d9aaa8-6a05-30e0-baa2-fd9cdb3855e3",
                        "target_lang_word": "Epikrise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Epikrise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f0b3b17-921e-32bc-93de-1bf05530b8bd",
                                        "entry_id": "bc67a0c8-402d-3f0b-9cf4-4d10d9a076fc",
                                        "glosses": [
                                            "abschließende, kritische Zusammenfassung eines Krankheitsverlaufs durch den behandelnden Arzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3be3ac26-1925-4199-b757-0aa336df8ab9",
                                                "sense_id": "5f0b3b17-921e-32bc-93de-1bf05530b8bd",
                                                "text": "„Ist auch bei optimaler Therapie keine wesentliche Verbesserung des Leistungsvermögens mehr zu erwarten, dann ist dies ebenfalls in der Epikrise und im Schlussblatt entsprechend anzuführen.“"
                                            },
                                            {
                                                "example_id": "abf502d6-289d-45aa-bb71-fc28250539d4",
                                                "sense_id": "5f0b3b17-921e-32bc-93de-1bf05530b8bd",
                                                "text": "„Die Interaktion zwischen Pathologie und anderen Disziplinen führt schließlich zur Gesamtinterpretation des Krankheitsfalls, der Epikrise.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb653249-78c8-42e7-9091-7b54f6559fa0",
                        "source_entry_id": "e230e355-7925-300a-b66c-3076d00980ef",
                        "source_sense_id": "f3d9aaa8-6a05-30e0-baa2-fd9cdb3855e3",
                        "target_lang_word": "эпикриз",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "эпикриз",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "82d29929-1ec7-3e08-bb74-b9c9aedeff3d",
                                        "entry_id": "dfe1396f-b745-3330-b91f-74a1f971f170",
                                        "glosses": [
                                            "мед. суждение о состоянии больного, о диагнозе, причинах возникновения и развитии болезни, об обосновании и результатах лечения, формулируемое по завершении лечения или на определённом его этапе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "655cf69c-b92b-4fd4-a51a-a8a4d2d75b12",
                                                "sense_id": "82d29929-1ec7-3e08-bb74-b9c9aedeff3d",
                                                "text": "В своем эпикризе патолог заявил, что перитонит был несомненно вызван поранением кишечника .."
                                            },
                                            {
                                                "example_id": "e883d936-1e8a-446b-a194-1d42abba924b",
                                                "sense_id": "82d29929-1ec7-3e08-bb74-b9c9aedeff3d",
                                                "text": "Сегодня конференция короче обычного, предоперационные эпикризы не зачитывают, все плановые операции отменены, несмотря на то что стрельба в городе давно прекратилась."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
