                ],
                "translations": [
                    {
                        "translation_id": "18ede12d-35b6-4fc5-922f-432e11e46a75",
                        "source_entry_id": "47c2620c-cb67-31fc-b9d3-2f118e50bc46",
                        "target_lang_word": "körnig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "körnig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b9a97b7a-1261-317e-affb-97d9e69dee57",
                                        "entry_id": "e74b3308-8996-3757-8648-f06770faced1",
                                        "glosses": [
                                            "aus kleinen Körnern (beispielsweise Sand, Reis, Weizen) bestehend oder Körner enthaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63578929-c29b-4945-a47b-924173a2b1db",
                                                "sense_id": "b9a97b7a-1261-317e-affb-97d9e69dee57",
                                                "text": "„Scharf, süß oder körnig – Senf gibt es in den verschiedensten Variationen.“"
                                            },
                                            {
                                                "example_id": "cfcc36fa-3371-4894-b141-2316d0a12a89",
                                                "sense_id": "b9a97b7a-1261-317e-affb-97d9e69dee57",
                                                "text": "[Paella:] „Wenn das Wasser verdampft ist, der Reis aber noch körnig ist, Wasser nachgießen.“"
                                            },
                                            {
                                                "example_id": "c8f47f09-4b31-4b83-b0e9-8756ee9a4ce7",
                                                "sense_id": "b9a97b7a-1261-317e-affb-97d9e69dee57",
                                                "text": "„Die Schokolade von Modica ist dunkel, pur, ohne irgendwelche Zusätze von Milch oder Sahne oder Lecithin oder Fetten, körnig und krümelig in der Konsistenz, keine flache Tafel, sondern ein kleiner, massiver Barren mit hohem Kakao-Anteil.“"
                                            },
                                            {
                                                "example_id": "1dc63552-bf07-4e17-92eb-4d552d3f49c7",
                                                "sense_id": "b9a97b7a-1261-317e-affb-97d9e69dee57",
                                                "text": "„Fühlt sich das Eis im Mund körnig oder sandig an, oder ist es unangenehm kalt, ist es falsch berechnet worden.“"
                                            },
                                            {
                                                "example_id": "6c035021-13c3-4a3a-9b7d-c2f45a56d651",
                                                "sense_id": "b9a97b7a-1261-317e-affb-97d9e69dee57",
                                                "text": "„Trainieren Sie deshalb Ihre Kaumuskulatur, und essen Sie achtsam. Bei Lebensmitteln mit groben, körnigen und fasrigen Bestandteilen besteht sonst die Gefahr, dass sie sich in den Divertikeln verfangen und dadurch die Entstehung von Entzündungen begünstigen.“"
                                            },
                                            {
                                                "example_id": "4e0df787-5953-4e8a-8ff7-43cc8980b9e3",
                                                "sense_id": "b9a97b7a-1261-317e-affb-97d9e69dee57",
                                                "text": "„[Firn ist] mehrjähriger Schnee des Hochgebirges. Er wird durch Tauen, Wiedergefrieren und Druck des Neuschnees körnig, dicht und luftarm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3c0231cf-67af-37c9-b900-8dafb1255a6d",
                                        "entry_id": "e74b3308-8996-3757-8648-f06770faced1",
                                        "glosses": [
                                            "eine rauhe Oberfläche aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c551ed09-7c28-4bc5-846b-37eef76daab1",
                                                "sense_id": "3c0231cf-67af-37c9-b900-8dafb1255a6d",
                                                "text": "Man kann Mauerwerksputz auf viele Arten gestalten. Mit Vollabrieb ergibt sich eine gleichmäßig körnige Oberfläche."
                                            },
                                            {
                                                "example_id": "efc1a98a-7814-47d2-86ee-52e079f6c93c",
                                                "sense_id": "3c0231cf-67af-37c9-b900-8dafb1255a6d",
                                                "text": "Wer Kreidefarbe benutzt erhält eine leicht körnige Wandoberfläche."
                                            },
                                            {
                                                "example_id": "4c1df2e5-c044-4682-82eb-7d32784edadc",
                                                "sense_id": "3c0231cf-67af-37c9-b900-8dafb1255a6d",
                                                "text": "„Bei einer guten Granita spürt man diese Kristalle ein kleines bisschen rau und körnig auf der Zunge.“"
                                            },
                                            {
                                                "example_id": "7767cd56-fe13-4dc8-9bcb-812c742aa2fe",
                                                "sense_id": "3c0231cf-67af-37c9-b900-8dafb1255a6d",
                                                "text": "„Die körnige Struktur der Oberfläche (Photosphäre) der Sonne wird als Granulation bezeichnet. Sie entsteht durch turbulenten, konvektiven Wärmetransport (‚brodeln‘).“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e95febcc-7ed0-398b-8528-b42ff7a3ceaa",
                                        "entry_id": "e74b3308-8996-3757-8648-f06770faced1",
                                        "glosses": [
                                            "scheinbar aus vielen Punkten zusammengesetzt; die kleinsten Strukturen nicht mehr auflösend durch eine hohe Empfindlichkeit des Films (hohe ISO-Zahl), was früher große (und damit bei Vergrößerung sichtbare) Silberiodid-/Silberbromid-Kristalle auf dem Trägermaterial des Films voraussetzte"
                                        ],
                                        "tags": [
                                            "Photographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "970798c6-c8ee-4e24-b6ad-bccde1c7059e",
                                                "sense_id": "e95febcc-7ed0-398b-8528-b42ff7a3ceaa",
                                                "text": "[Bildrauschen äußert] „sich durch eine körnige Struktur und einen Auflösungsverlust. Feine Details sind dann nicht mehr erkennbar, und auch die Farbwiedergabe leidet.“"
                                            },
                                            {
                                                "example_id": "eea6a719-0387-4a32-9f07-f63b18536d5b",
                                                "sense_id": "e95febcc-7ed0-398b-8528-b42ff7a3ceaa",
                                                "text": "„Es ist eine körnige Aufnahme, wahrscheinlich mit dem Handy gefilmt.“"
                                            },
                                            {
                                                "example_id": "1e281e17-0a71-4b96-9d35-68d14dfbcc7b",
                                                "sense_id": "e95febcc-7ed0-398b-8528-b42ff7a3ceaa",
                                                "text": "„Von der Titelseite blickte ihm ein körniges Foto von Robert Battle entgegen, das vor Jahren aufgenommen worden war.“"
                                            },
                                            {
                                                "example_id": "d0fe02bc-05c4-4ae4-9cb9-3945b766f5b7",
                                                "sense_id": "e95febcc-7ed0-398b-8528-b42ff7a3ceaa",
                                                "text": "„Das monochrome, körnige Bildresultat [der Kallotypie] stand einer Lithographie oder einer Zeichnung viel näher als die kontrastreiche und hochpräzise Abbildungsqualität einer guten Daguerreotypie.“"
                                            },
                                            {
                                                "example_id": "26bc8166-8f1c-44ca-9f39-3e7ff3b2dffd",
                                                "sense_id": "e95febcc-7ed0-398b-8528-b42ff7a3ceaa",
                                                "text": "„Obwohl es sich um ein «High End»-Gerät handelt, was die übrigen Funktionen anbetrifft, sei es kein «Kamera-Handy». Die Bilder kommen zu dunkel daher, zu körnig, und der Kontrast ist zu gering.“"
                                            },
                                            {
                                                "example_id": "4e02b066-238e-4bae-a4de-54afd2023605",
                                                "sense_id": "e95febcc-7ed0-398b-8528-b42ff7a3ceaa",
                                                "text": "„Die neuen Bilder aus dem Kosmos erinnern an die ersten Fotografie. Beides sind körnige, grobe Bilder. Jenes von 1826 zeigt Dächer eines Dorfes im Burgund, die neuen Fotos dagegen ferne Welten im All.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
