                                "text": "извлека́ть уро́к",
                                "translation": "to learn a lesson (from); to moralize, to draw the moral",
                                "english": "to learn a lesson (from); to moralize, to draw the moral"
                            },
                            {
                                "example_id": "b37860fc-ecec-49ba-8d24-2b941e7b009d",
                                "sense_id": "fc6365ae-888d-36e4-9e6b-073e4f836a78",
                                "text": "извлека́ть по́льзу",
                                "translation": "to derive benefit (from)",
                                "english": "to derive benefit (from)"
                            },
                            {
                                "example_id": "193d8606-77d7-4c55-b5fa-dfbf45424abe",
                                "sense_id": "fc6365ae-888d-36e4-9e6b-073e4f836a78",
                                "text": "извлека́ть огро́мные при́были",
                                "translation": "to derive / make huge profits (from)",
                                "english": "to derive / make huge profits (from)"
                            },
                            {
                                "example_id": "46ee0b7f-e901-4d2c-a4ab-2493626f2ff1",
                                "sense_id": "fc6365ae-888d-36e4-9e6b-073e4f836a78",
                                "text": "извлека́ть удово́льствие",
                                "translation": "to derive pleasure (from)",
