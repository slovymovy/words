                ],
                "translations": [
                    {
                        "translation_id": "b07b7963-3523-49b6-9a8d-fde181992665",
                        "source_entry_id": "cbf95e47-005b-33d7-85ab-30a82c1c4228",
                        "source_sense_description": "A penis",
                        "target_lang_word": "Pimmel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pimmel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c06df431-24ad-3df4-881e-4ba547362f23",
                                        "entry_id": "585feb42-a667-3ecb-87c0-3119bd5d6250",
                                        "glosses": [
                                            "männliches Geschlechtsglied"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70e048da-457f-4d75-aaef-d91f9d89dde0",
                                                "sense_id": "c06df431-24ad-3df4-881e-4ba547362f23",
                                                "text": "Jemand hat sich letztens den Pimmel eingeklemmt."
                                            },
                                            {
                                                "example_id": "f1aeb4c7-e321-4dd9-b512-9b1249193178",
                                                "sense_id": "c06df431-24ad-3df4-881e-4ba547362f23",
                                                "text": "„Als das Licht aus war, fragte Volker mich, ob ich wisse, wie Babys entstehen. Die entstünden, wenn der Mann seinen steifen Pimmel bei der Frau in die Scheide stecke.“"
                                            },
                                            {
                                                "example_id": "a21d7632-9f0b-456f-8e5d-9c16fd75d325",
                                                "sense_id": "c06df431-24ad-3df4-881e-4ba547362f23",
                                                "text": "„Er war barfuß, trug abgeschnittene Hosen und ein weißes T-Shirt mit dem fliegenden Pimmel des RFSU, des schwedischen Reichsverbands für sexuelle Aufklärung, auf der Brust.“"
                                            },
                                            {
                                                "example_id": "508ef298-daf2-44c5-8880-7bb44c7e55d3",
                                                "sense_id": "c06df431-24ad-3df4-881e-4ba547362f23",
                                                "text": "„Dieser Großonkel steckte seine Hände in die schleimigen violetten Eingeweide und untersuchte je nach gusto ihre komischen, schlaffen Pimmel.“"
                                            },
                                            {
                                                "example_id": "a35babc5-18f5-48ae-b71d-ebd3faae5600",
                                                "sense_id": "c06df431-24ad-3df4-881e-4ba547362f23",
                                                "text": "„Er rannte also ins Haus, schloss sich im Bad ein, zog die Hose aus, und schon allein nackt und mit einem steinharten Pimmel vor dem Spiegel zu stehen fühlte sich seltsam erregend an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9834106c-17ce-4a8f-ac1a-81d06b0ccf07",
                        "source_entry_id": "cbf95e47-005b-33d7-85ab-30a82c1c4228",
                        "source_sense_description": "A penis",
                        "target_lang_word": "Schwanz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwanz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "481409b6-556e-3de8-8d80-2aae23b194b4",
                                        "entry_id": "fd8fced5-2728-34c6-9885-f4665fa73f84",
                                        "glosses": [
                                            "hinterer Körperfortsatz bei Tieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7957443-9db9-4aad-9117-0b1ccc4edf48",
                                                "sense_id": "481409b6-556e-3de8-8d80-2aae23b194b4",
                                                "text": "Auf der grünen Wiese sitzt ein Krokodil, / das wedelt mit dem Schwanze und weiß nicht was es will – (Volkslied)"
                                            },
                                            {
                                                "example_id": "f7b15914-52bd-4298-bf8c-b116a665565e",
                                                "sense_id": "481409b6-556e-3de8-8d80-2aae23b194b4",
                                                "text": "„Ein kleiner Hund fegte mit eingezogenem Schwanz um eine Ecke.“"
                                            },
                                            {
                                                "example_id": "b4acbe6c-acd5-45ed-909b-bbdb28775e72",
                                                "sense_id": "481409b6-556e-3de8-8d80-2aae23b194b4",
                                                "text": "„Anders als Hundsaffen besitzen die Menschenaffen oder Andropomorpha bzw. Hominoidea keinen Schwanz“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dc583074-ca70-3f03-ace8-48be8f4967ab",
                                        "entry_id": "fd8fced5-2728-34c6-9885-f4665fa73f84",
                                        "glosses": [
                                            "Penis"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "impolite"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3ebf88b-f98a-46c8-ac4f-92644baba0a9",
                                                "sense_id": "dc583074-ca70-3f03-ace8-48be8f4967ab",
                                                "text": "Ich habe noch nie einen echten Schwanz gesehen."
                                            },
                                            {
                                                "example_id": "e503272d-2564-463f-9154-53fc524558a6",
                                                "sense_id": "dc583074-ca70-3f03-ace8-48be8f4967ab",
                                                "text": "„Mein Schwanz hing heraus und begann sich in der warmen Brise wieder zu regen.“"
                                            },
                                            {
                                                "example_id": "c109bb20-fa88-4817-ae0f-6f0a25bff280",
                                                "sense_id": "dc583074-ca70-3f03-ace8-48be8f4967ab",
                                                "text": "„Sein eigener Schwanz versteifte sich, wenn er diese Fotografie sah.“"
                                            },
                                            {
                                                "example_id": "71da52d1-7c4c-41a3-962a-248cbf8fb352",
                                                "sense_id": "dc583074-ca70-3f03-ace8-48be8f4967ab",
                                                "text": "„Als sein Schwanz in sie hineingleitet, entdeckt er die Welt.“"
                                            },
                                            {
                                                "example_id": "76fe284d-e524-4b0c-a424-17638e64b7e4",
                                                "sense_id": "dc583074-ca70-3f03-ace8-48be8f4967ab",
                                                "text": "„Als ich gekommen war und meinen Schwanz zurückzog, sah Consuela mich nicht nur entsetzt, sondern regelrecht wütend an.“"
                                            },
                                            {
                                                "example_id": "37e52f43-a9c9-4528-a368-a9cd6af170a2",
                                                "sense_id": "dc583074-ca70-3f03-ace8-48be8f4967ab",
                                                "text": "„Oder die modernen Ökonomen haben sich zu solchen Sykophanten des Bourgeois gemacht, daß sie demselben weismachen wollen, es sei produktive Arbeit, wenn einer […] ihm den Schwanz reibe, weil etwa die letztre Bewegung ihm den dicken Kopf — blockhead — den nächsten Tag aufgferäumter für das Comptoir machen werde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c5182894-a24f-377b-8d2a-f10d8b3f3321",
                                        "entry_id": "fd8fced5-2728-34c6-9885-f4665fa73f84",
                                        "glosses": [
                                            "Zipfel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a2abdae-1ee8-4521-908d-5cdf17ffdba8",
                                                "sense_id": "c5182894-a24f-377b-8d2a-f10d8b3f3321",
                                                "text": "Wo die Schokolade aus der Düse kam, bleibt ein kleiner Schwanz auf der Praline."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "cac000d3-bbe5-3254-b775-8ede45e78fbb",
                                        "entry_id": "fd8fced5-2728-34c6-9885-f4665fa73f84",
                                        "glosses": [
                                            "Abgang des Weines"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
