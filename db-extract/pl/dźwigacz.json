                                                "sense_id": "655439d0-8e84-3500-82ff-0724c84fe904",
                                                "text": "Nach Platon war Atlas, Sohn des Poseidon, erster König von Atlantis."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Atlas",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c79355c-f726-3a98-b6fd-a3aa90abd18f",
                                        "entry_id": "286873fd-817d-3d3c-8b3b-eeb743ba60e6",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2517fe5b-a784-48dc-a2be-002236c88d55",
                                                "sense_id": "0c79355c-f726-3a98-b6fd-a3aa90abd18f",
                                                "text": "Herr Atlas wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "5d968cf3-1959-41aa-b6ee-6af132b9c187",
                                                "sense_id": "0c79355c-f726-3a98-b6fd-a3aa90abd18f",
                                                "text": "Die Atlas fliegen heute nach Südafrika."
                                            },
                                            {
                                                "example_id": "a36349ac-0526-49df-bb72-57273ec1fc49",
                                                "sense_id": "0c79355c-f726-3a98-b6fd-a3aa90abd18f",
                                                "text": "Der Atlas trägt nie die Pullover, die die Atlas ihm strickt."
                                            },
                                            {
                                                "example_id": "7b6354bc-4e44-42d3-8b1b-fe9ec9ef5cdb",
                                                "sense_id": "0c79355c-f726-3a98-b6fd-a3aa90abd18f",
                                                "text": "Ich habe schon ein Konzert von Natacha Atlas besucht."
                                            },
                                            {
                                                "example_id": "6aa10a73-8899-4282-b31e-8c120e64e544",
                                                "sense_id": "0c79355c-f726-3a98-b6fd-a3aa90abd18f",
                                                "text": "Die Atlas war wieder große Klasse!"
                                            },
                                            {
                                                "example_id": "1d256ad8-089c-4e66-ae25-4325613c1fef",
                                                "sense_id": "0c79355c-f726-3a98-b6fd-a3aa90abd18f",
                                                "text": "Wir sind heute Abend bei Atlas eingeladen."
                                            },
                                            {
                                                "example_id": "682686cd-c019-41d6-a064-4a5460935868",
                                                "sense_id": "0c79355c-f726-3a98-b6fd-a3aa90abd18f",
                                                "text": "Wir sind heute Abend bei den Atlasens eingeladen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
