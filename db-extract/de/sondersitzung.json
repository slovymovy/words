                        "entry_id": "1e807a26-8ee1-3cd5-91f2-3d852403e5fb",
                        "glosses": [
                            "Sitzung, die nicht planmäßig, sondern aus einem besonderen Grund abgehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "897dee9d-9db2-4fdc-9028-21d6e1643447",
                                "sense_id": "891a6dd7-fd88-35e1-a5d0-da7374ae4cb9",
                                "text": "Wieder einmal wurde eine Sondersitzung anberaumt."
                            },
                            {
                                "example_id": "a515dfcc-d932-4e5c-ba73-a00627a63264",
                                "sense_id": "891a6dd7-fd88-35e1-a5d0-da7374ae4cb9",
                                "text": "„Derzeit eilt er von einer Sondersitzung zur nächsten und erhält täglich Anrufe von verunsicherten Investoren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
