        "fr-extract.jsonl": [
            {
                "entry_id": "fa09b8a2-21bc-3b0f-bc9d-6c12fd8a96d4",
                "word": "зайти",
                "pos": "verb",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "057282aa-8fa2-301d-bef3-9aa5d159fcb3",
                        "entry_id": "fa09b8a2-21bc-3b0f-bc9d-6c12fd8a96d4",
                        "glosses": [
                            "Passer quelque part ou chez quelqu'un pour un court moment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f34319c-9a1b-4d19-9c88-1796d159aa6c",
                                "sense_id": "057282aa-8fa2-301d-bef3-9aa5d159fcb3",
                                "text": "Он зашёл на мину́тку : Il n’a fait qu’une apparition."
                            },
                            {
                                "example_id": "ebdc8784-cd42-463a-9df7-7c534613c0db",
                                "sense_id": "057282aa-8fa2-301d-bef3-9aa5d159fcb3",
                                "text": "Зайти́ к дру́гу : Passer chez son ami."
                            },
                            {
                                "example_id": "269f6d13-1976-4dab-b265-eae3388fc965",
                                "sense_id": "057282aa-8fa2-301d-bef3-9aa5d159fcb3",
                                "text": "Зайти́ в магази́н : Entrer dans un magasin."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ba45539-c54e-326c-8d48-d4cf615c3957",
                        "entry_id": "fa09b8a2-21bc-3b0f-bc9d-6c12fd8a96d4",
                        "glosses": [
                            "(за + instrumental) Aller ou venir chercher quelqu’un ou quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b36c320d-263d-468b-8523-12a14e1dea68",
                                "sense_id": "4ba45539-c54e-326c-8d48-d4cf615c3957",
                                "text": "Зайти́ за ребёнком : Aller chercher son enfant."
                            },
                            {
                                "example_id": "1b7485b8-fea2-4919-95bf-3cd4fc03a252",
                                "sense_id": "4ba45539-c54e-326c-8d48-d4cf615c3957",
                                "text": "Зайти́ за спра́вкой : Aller prendre un certificat."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1f0ff35-9f33-3219-af90-cd01e38180ef",
                        "entry_id": "fa09b8a2-21bc-3b0f-bc9d-6c12fd8a96d4",
                        "glosses": [
                            "Prendre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "420d9f8f-b8a1-4b5c-b4f9-6eb8b6187a92",
                                "sense_id": "e1f0ff35-9f33-3219-af90-cd01e38180ef",
                                "text": "Зайти́ в тыл : Prendre à revers."
                            },
                            {
                                "example_id": "054bc836-f79c-4125-a01a-a39e04d19214",
                                "sense_id": "e1f0ff35-9f33-3219-af90-cd01e38180ef",
                                "text": "Зайти́ во фланг ou сбо́ку : Prendre par le flanc."
                            }
                        ]
                    },
                    {
                        "sense_id": "85c83047-9862-3e3b-902c-bbda31f0fa35",
                        "entry_id": "fa09b8a2-21bc-3b0f-bc9d-6c12fd8a96d4",
                        "glosses": [
                            "Tomber (dans un endroit)."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "ef1454ed-ca59-4ddd-983e-a63941c00754",
                                "sense_id": "85c83047-9862-3e3b-902c-bbda31f0fa35",
                                "text": "Мы зашли́ в незнако́мое ме́сто : Nous tombèrent dans un endroit inconnu."
                            },
                            {
                                "example_id": "494f026c-e88d-4e14-802d-24eee418e5bc",
                                "sense_id": "85c83047-9862-3e3b-902c-bbda31f0fa35",
                                "text": "Куда́ мы зашли́? : Où sommes-nous tombés ?"
                            },
                            {
                                "example_id": "f5591a90-22a4-456c-92b7-7ca3c0012ba3",
                                "sense_id": "85c83047-9862-3e3b-902c-bbda31f0fa35",
                                "text": "Речь зашла́ о ко́м-либо, о чём-либо. : La conversation tomba sur quelqu’un, sur quelque chose."
                            }
                        ]
                    },
                    {
                        "sense_id": "79e4b58e-cd37-3a5e-9e7b-bf2265c2158d",
                        "entry_id": "fa09b8a2-21bc-3b0f-bc9d-6c12fd8a96d4",
                        "glosses": [
                            "(за + accusatif) Tourner, contourner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a737ac96-bb90-40ef-b6c3-08c2d798cef9",
                                "sense_id": "79e4b58e-cd37-3a5e-9e7b-bf2265c2158d",
                                "text": "Зайти́ за́ угол : Prendre l’angle."
                            },
                            {
                                "example_id": "ea29ed06-af35-4112-a2f1-5de08fac59bc",
                                "sense_id": "79e4b58e-cd37-3a5e-9e7b-bf2265c2158d",
                                "text": "Зайти́ за дом : Contourner la maison."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c68ddda-6aee-311f-bad5-1dadabcc69d5",
                        "entry_id": "fa09b8a2-21bc-3b0f-bc9d-6c12fd8a96d4",
                        "glosses": [
                            "Aller, s’avancer loin à l’intérieur de quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf7daa24-39b6-4ef0-a049-4a7b9d55262c",
                                "sense_id": "3c68ddda-6aee-311f-bad5-1dadabcc69d5",
                                "text": "Мы зашли далеко в чащу леса. : Nous nous sommes avancés profondément dans la forêt."
                            },
                            {
                                "example_id": "311c9d29-8f31-454a-86fa-5ffe11cc56a0",
                                "sense_id": "3c68ddda-6aee-311f-bad5-1dadabcc69d5",
                                "text": "Вы зашли́ сли́шком далеко́ : Vous vous permettez trop de choses."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
