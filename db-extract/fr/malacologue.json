                    {
                        "sense_id": "728ec113-1ecf-3bd6-8e5f-0c66948c56c1",
                        "entry_id": "d12e3c53-1578-303c-85f3-5e9b576062a8",
                        "glosses": [
                            "Spécialiste de la malacologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85e8d677-4389-4097-92ff-570668baffff",
                                "sense_id": "728ec113-1ecf-3bd6-8e5f-0c66948c56c1",
                                "text": "Une solide équipe pluridisciplinaire, composée d’archéologues et de spécialistes (malacologue, géoarchéologue, géomorphologue, palynologue, technologue et tracéologue), s’est alors appliquée à faire parler le sous-sol d’Angoulème, pour déchiffrer cette succession, mais aussi et surtout pour apprécier les relations entre les hommes préhistoriques et leur environnement."
                            },
                            {
                                "example_id": "d64c2c9a-7e1b-45c6-8a04-2c11f7ae4f71",
                                "sense_id": "728ec113-1ecf-3bd6-8e5f-0c66948c56c1",
                                "text": "Parmi eux, il y avait un malacologue, un spécialiste des coquillages."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5c716b2-297c-4c67-b028-4b172b637f47",
