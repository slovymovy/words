                "forms": [],
                "senses": [
                    {
                        "sense_id": "1e41ea1e-a3fb-31d2-b39c-afa451357079",
                        "entry_id": "0d232f57-43ed-3824-b904-061e8d4296d7",
                        "glosses": [
                            "Signal de détresse et demande d’assistance immédiate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de519f6b-15a6-4073-8b3e-ad162c00726e",
                                "sense_id": "1e41ea1e-a3fb-31d2-b39c-afa451357079",
                                "text": "Avant de couler, le Titanic a vainement lancé plusieurs SOS."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5293463-d594-4293-8ca5-d92fb79032b6",
