                                        "entry_id": "24a17946-347b-3433-87c5-5665ca91f7b2",
                                        "glosses": [
                                            "A layer of makeup that goes beneath the foundation; undermakeup."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
