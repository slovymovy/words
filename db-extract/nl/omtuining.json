                    {
                        "sense_id": "6e883170-f7c2-3c7d-a13c-e1a4fc9ea4ab",
                        "entry_id": "b88843d9-5c85-32df-8b7c-96c980235385",
                        "glosses": [
                            "dat wat een ruimte omheint"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f40d80b-6bc6-4a64-9f5c-72df1e25e9fb",
                                "sense_id": "6e883170-f7c2-3c7d-a13c-e1a4fc9ea4ab",
                                "text": "Gods geboden knellen het leven niet af, maar vormen een omtuining waarin je veilig bent. Wie God vreest en Zijn geboden houdt, is van God niet bang. Die is maar voor één ding bang: Hem verdriet doen."
                            },
                            {
                                "example_id": "0af454a8-bdee-47ee-9ff2-28a1d8a8ed23",
                                "sense_id": "6e883170-f7c2-3c7d-a13c-e1a4fc9ea4ab",
                                "text": "Binnen de omheining van Gods heilzame geboden is geen verschrikking, maar veiligheid en geborgenheid. Zo klonk het bijna veertig jaar geleden. Dit boek maakt duidelijk: buiten die omtuining wordt veel verschrikking ervaren. Daarom: tegen de wetteloosheid het Evangelie!"
                            }
                        ]
                    }
