                    },
                    {
                        "translation_id": "417dbc66-58a5-4f34-bb88-e691cea8a784",
                        "source_entry_id": "03db54bc-3594-3c65-9a00-7689aa6f7f78",
                        "source_sense_id": "1ab08149-2c5e-34b0-b236-22988eedfafa",
