                "translations": [
                    {
                        "translation_id": "ad25a089-1e55-4736-af29-c482206f602e",
                        "source_entry_id": "fc85c48e-8c00-342a-adbf-fdd44d2a6be9",
                        "source_sense_id": "befb4290-4367-364c-b14e-1ffa4a205987",
                        "target_lang_word": "gedehnt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gedehnt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b43e571e-d8d5-324d-ae86-a004ecb02dac",
                                        "entry_id": "32d52840-7d44-3da6-af5c-e2d7e5db0178",
                                        "glosses": [
                                            "zeitlich: etwas, was sich in die Länge zieht, was lange dauert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58a5766e-266e-4552-8dc7-9d459a203f7d",
                                                "sense_id": "b43e571e-d8d5-324d-ae86-a004ecb02dac",
                                                "text": "Die Gladiatoren hielten die Rechte empor, schauten zu Cäsar hinauf und schrien, oder besser gesagt, sangen mit gedehnter Stimme: »Ave Caesar Imperator!«"
                                            },
                                            {
                                                "example_id": "8fcff8e4-c99e-4cbd-8cee-7cbfd14c4652",
                                                "sense_id": "b43e571e-d8d5-324d-ae86-a004ecb02dac",
                                                "text": "Die Augen auf die Zimmerdecke gerichtet, sprach sie mit gedehnter Stimme, während ihr Mann sich ankleidete."
                                            },
                                            {
                                                "example_id": "7e69da1b-2b39-49f7-8249-3d41243bad25",
                                                "sense_id": "b43e571e-d8d5-324d-ae86-a004ecb02dac",
                                                "text": "Versäumt er [der Lokführer] das [Drücken der Sicherheitsfahrschaltung alle 50 Sekunden], so leuchtet nach 2,5 Sekunden eine Signallampe auf, und nach nochmals der gleichen Zeitspanne ertönt ein gedehnter Warnton."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "47f09d23-cc2d-397f-bfc2-3d44b58f9375",
                                        "entry_id": "32d52840-7d44-3da6-af5c-e2d7e5db0178",
                                        "glosses": [
                                            "Bänder, Sehnen, Seile, Muskeln betreffend: in die Länge gezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71f213fd-6b35-45be-a3e2-2ef994e9b0bf",
                                                "sense_id": "47f09d23-cc2d-397f-bfc2-3d44b58f9375",
                                                "text": "Dieses schon aufs äußerste gedehnte Drahtseil darf nicht weiter belastet werden."
                                            },
                                            {
                                                "example_id": "5a996b09-ffa2-4d32-8a59-9c9b7c2c96a4",
                                                "sense_id": "47f09d23-cc2d-397f-bfc2-3d44b58f9375",
                                                "text": "„Diese in jahrelangem Training gedehnten Bänder und Sehnen von Balletttänzerinnen, sie sind so beweglich: bewundernswert!“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
