                ],
                "senses": [
                    {
                        "sense_id": "1a839ddf-981a-36d6-9222-8847126f8aae",
                        "entry_id": "4faa0701-8133-3e4d-b1c2-01f4e0ec174a",
                        "glosses": [
                            "Mit Burenkrieg wird in der Regel ein militärischer Konflikt zwischen Großbritannien und den Burenrepubliken Oranje Freistaat und Transvaal (auch: Südafrikanische Republik) von 1899 bis 1902 bezeichnet, der mit der Eingliederung der letzteren in das Britische Empire endete."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c4b7402-c841-4401-bb64-9225540509f2",
                                "sense_id": "1a839ddf-981a-36d6-9222-8847126f8aae",
                                "text": "„1880 entluden sich die Spannungen in einem Ersten Burenkrieg, den die Siedler im Jahr darauf gewannen.“"
                            },
                            {
                                "example_id": "25c4c478-cd02-4e61-93b2-7b8e918d60a7",
                                "sense_id": "1a839ddf-981a-36d6-9222-8847126f8aae",
                                "text": "„Was immer der wahre Grund war, der Burenkrieg hatte begonnen, und die Briten trafen auf wesentlich stärkeren Widerstand als erwartet.“"
                            },
                            {
                                "example_id": "cdc80eb6-135d-4304-81c1-768bf6c5a542",
                                "sense_id": "1a839ddf-981a-36d6-9222-8847126f8aae",
                                "text": "Aber dass er im Burenkrieg für die Engländer eintrat, war erstaunlich."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7a6a34cf-0dbf-3b18-b934-9ea61e4d41c9",
                        "entry_id": "4faa0701-8133-3e4d-b1c2-01f4e0ec174a",
                        "glosses": [
                            "Manchmal wird dieser Krieg auch als Zweiter Burenkrieg bezeichnet, um ihn von einem ersten, kleineren Krieg zwischen Engländern und Buren 1880-1881 abzugrenzen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e8fa574-1d71-4159-bf2e-62b1bb16fddd",
                                "sense_id": "7a6a34cf-0dbf-3b18-b934-9ea61e4d41c9",
                                "text": "Aber dass er im Burenkrieg für die Engländer eintrat, war erstaunlich."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
