                ],
                "senses": [
                    {
                        "sense_id": "a823e2a1-8ee3-3618-8d0f-66f809478765",
                        "entry_id": "c1d59937-683f-302c-9b02-c46e6ecbadd2",
                        "glosses": [
                            "Raum, der zur Veranstaltung von Feiern/Partys benutzt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78cff5af-c6ab-46e2-bbd9-5f3670bba972",
                                "sense_id": "a823e2a1-8ee3-3618-8d0f-66f809478765",
                                "text": "„»Baust Du uns auch so einen Partyraum? Platz haben wir doch genug im Keller.«“"
                            },
                            {
                                "example_id": "a71b5516-a1e7-4201-b535-c52573eaaf35",
                                "sense_id": "a823e2a1-8ee3-3618-8d0f-66f809478765",
                                "text": "Wir tanzten im Partyraum die ganze Nacht."
                            },
                            {
                                "example_id": "2eeed51a-49b7-4cba-8934-e2c8ba4e1bda",
                                "sense_id": "a823e2a1-8ee3-3618-8d0f-66f809478765",
                                "text": "„»Ihr habt einen Partyraum?«“"
                            },
                            {
                                "example_id": "4496e82e-0d62-4da9-8480-4488d0945d81",
                                "sense_id": "a823e2a1-8ee3-3618-8d0f-66f809478765",
                                "text": "„Für kleine Privatfeste steht auẞerdem ein Partyraum zur Verfügung.“"
                            },
                            {
                                "example_id": "f780f377-ec25-471e-8be1-76bb85555204",
                                "sense_id": "a823e2a1-8ee3-3618-8d0f-66f809478765",
                                "text": "„»Kommt, ich zeige euch den Partyraum!«, sagt Geraldine kichernd, und wir folgen ihr.“"
                            },
                            {
                                "example_id": "a834aac3-d98f-4ce7-b06a-9e99df8d996d",
                                "sense_id": "a823e2a1-8ee3-3618-8d0f-66f809478765",
                                "text": "„Der Partyraum war super hergerichtet worden und Essen und Getränke standen schon bereit.“"
                            },
                            {
                                "example_id": "0866e32d-1ba9-4b3d-8231-d9abdc7a86c2",
                                "sense_id": "a823e2a1-8ee3-3618-8d0f-66f809478765",
                                "text": "„Mit Michael sind wir dabei, einen Partyraum für Jugendliche zu organisieren. Da müssen wir noch viel Arbeit reinstecken, bis das realisiert werden kann.“"
                            },
                            {
                                "example_id": "ecb71e09-6f59-4bb1-b17d-22f2d11bdb8a",
                                "sense_id": "a823e2a1-8ee3-3618-8d0f-66f809478765",
                                "text": "„Tommys Großvater schenkt ihm ein altes Gewächshaus, das von Tommy und seinen neuen Freunden begeistert in einen Bastel- und Partyraum umfunktioniert wird.“"
                            },
                            {
                                "example_id": "d88e564a-faec-4715-abf7-e26e8f5d4cb3",
                                "sense_id": "a823e2a1-8ee3-3618-8d0f-66f809478765",
                                "text": "„Die Beamten wurden nach eigenen Angaben in der Nacht zum Samstag von Anwohnern und besorgten Eltern alarmiert und kamen gegen 3 Uhr an dem Partyraum an.“"
                            },
                            {
                                "example_id": "7f2f3965-acde-4ea9-b8b7-41de192c6ecc",
                                "sense_id": "a823e2a1-8ee3-3618-8d0f-66f809478765",
                                "text": "„Anschließend sollen die Kriminellen mit Flaschen im Partyraum um sich geworfen und fast das komplette Mobiliar zerstört haben.“"
                            },
                            {
                                "example_id": "7a3d5e70-84b6-4fc4-ab06-cac339303022",
                                "sense_id": "a823e2a1-8ee3-3618-8d0f-66f809478765",
                                "text": "„Beim Brand eines Partyraumes in einem Dreiseitenhof in Friemar (Kreis Gotha) ist ein Sachschaden von rund 30 000 Euro entstanden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
