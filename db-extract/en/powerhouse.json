                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "750a1be2-f839-4bce-9703-d60ccfb5a21c",
                                                "sense_id": "68e27c90-69eb-37a4-aa4e-e3866350758b",
                                                "text": "Je to právě honba firem za ekonomickými zisky, která je motorem ekonomického růstu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a25248f-e201-477f-aa78-a62189281f22",
