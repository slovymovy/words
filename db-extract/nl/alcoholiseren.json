                "senses": [
                    {
                        "sense_id": "262f7734-a827-3578-bc5d-72a5dbbb1008",
                        "entry_id": "42820d81-d593-3e7c-8277-313b579c4a53",
                        "glosses": [
                            "met alcohol vermengen of behandelen"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "81bcaa1b-3e9a-4a86-99f8-b91ce815b673",
                                "sense_id": "262f7734-a827-3578-bc5d-72a5dbbb1008",
                                "text": "[Dit bedrijf] offreert een keuze uit zo ongeveer alles, wat gebrouwen, gedestilleerd, gegist en anderszins gealcoholiseerd kan worden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c91bebf7-4e89-48a0-a76c-6d0f7a03272f",
                        "source_entry_id": "42820d81-d593-3e7c-8277-313b579c4a53",
                        "source_sense_id": "262f7734-a827-3578-bc5d-72a5dbbb1008",
                        "source_sense_description": "met alcohol vermengen of behandelen",
                        "target_lang_word": "alkoholisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alkoholisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ecb80437-3180-300a-930a-81ee033e83ff",
                                        "entry_id": "6dc9cb49-6744-38cb-8b09-bedfdd5a86ab",
                                        "glosses": [
                                            "(etwas) mit Alkohol anreichern, vermischen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4410664-d17e-4185-a469-5d93954841d5",
                                                "sense_id": "ecb80437-3180-300a-930a-81ee033e83ff",
                                                "text": "„Bei uns kommt etwas Alkohol in die Himbeersauce. Das kann man aber auch umdrehen und die Panna Cotta selbst alkoholisieren, zum Beispiel mit Amaretto oder Walnussgeist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eacafbdf-6835-38c1-ab87-7d2a7e0c44ce",
                                        "entry_id": "6dc9cb49-6744-38cb-8b09-bedfdd5a86ab",
                                        "glosses": [
                                            "(jemandem) reichlich alkoholische Getränke geben, (jemanden) zum Alkoholkonsum animieren"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2d572fe-fdb5-4ce9-803d-34a63313004a",
                                                "sense_id": "eacafbdf-6835-38c1-ab87-7d2a7e0c44ce",
                                                "text": "„Auf Erlass Iwans des Schrecklichen wurden Mitte des 16. Jahrhunderts so genannte ‚Kabaki‘ eingerichtet, in denen vereidigte Statthalter des Zaren die ansässige Bevölkerung alkoholisieren sollten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa162834-265f-4aad-b090-570ae9714d7a",
                        "source_entry_id": "42820d81-d593-3e7c-8277-313b579c4a53",
                        "source_sense_id": "262f7734-a827-3578-bc5d-72a5dbbb1008",
                        "source_sense_description": "met alcohol vermengen of behandelen",
                        "target_lang_word": "alcooliser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alcooliser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b0caffb7-cb4f-3faf-a9c6-308fa8832a38",
                                        "entry_id": "17f17f39-b373-30eb-8f9b-7c235ab73042",
                                        "glosses": [
                                            "Mêler de l’alcool à un autre liquide, rendre alcoolique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2aade03-8a4a-4bf0-a1aa-c5c37a486c40",
                                                "sense_id": "b0caffb7-cb4f-3faf-a9c6-308fa8832a38",
                                                "text": "Bière alcoolisée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9eeeb10-bd0a-3cae-86d1-db00803af120",
                                        "entry_id": "17f17f39-b373-30eb-8f9b-7c235ab73042",
                                        "glosses": [
                                            "Devenir alcoolisé, boire de l’alcool jusqu’à en ressentir les effets."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e11b7914-2669-4f74-9809-204c7f9ac240",
                                                "sense_id": "a9eeeb10-bd0a-3cae-86d1-db00803af120",
                                                "text": "Il s’alcoolise tous les soirs à la bière."
                                            },
                                            {
                                                "example_id": "a1468156-ee4c-41c9-b24e-ea9e57470f50",
                                                "sense_id": "a9eeeb10-bd0a-3cae-86d1-db00803af120",
                                                "text": "Il existe de nombreuses méthodes de psychothérapie dont l’intérêt est non seulement d’apporter un éclairage éventuel sur les causes du besoin impérieux de s’alcooliser mais surtout de donner des moyens pour affronter les angoisses et les limites personnelles qui étaient à l’origine de ce besoin."
                                            },
                                            {
                                                "example_id": "6596a1db-0e8b-4c99-9cfa-1b38f5696b61",
                                                "sense_id": "a9eeeb10-bd0a-3cae-86d1-db00803af120",
                                                "text": "L’on nous objectera que le nombre des employés qui vont ainsi le matin et le soir chez le marchand de vin forment une minorité et que cette minorité n’est nullement obligée de s’alcooliser ainsi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
