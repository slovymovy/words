                "senses": [
                    {
                        "sense_id": "db28c532-8c36-3a05-8c42-04c0eb35bd7f",
                        "entry_id": "129b4c99-026c-3ad8-8db4-fe5103e653c0",
                        "glosses": [
                            "bijzonder en leuk, apart op een leuke manier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62e865f2-b7aa-45b4-aab8-8c87d775ee28",
                                "sense_id": "db28c532-8c36-3a05-8c42-04c0eb35bd7f",
                                "text": "Het was een ludieke manier om de lange kilometers van de dag te verzachten."
                            },
                            {
                                "example_id": "6508b06c-b9ad-46b2-b730-aa85abd684c6",
                                "sense_id": "db28c532-8c36-3a05-8c42-04c0eb35bd7f",
                                "text": "Ludiek verzet tegen de oorlog in Oekraïne is voor de Russische autoriteiten niet om te lachen. Rechtszaken tegen actievoerders zitten vol absurdisme, is te zien in een documentaire over de zaak tegen tekenaar Sasja Skotsjilenko."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb64ad9a-6f2f-475a-bca3-2dccc93525cc",
                        "source_entry_id": "129b4c99-026c-3ad8-8db4-fe5103e653c0",
                        "source_sense_id": "db28c532-8c36-3a05-8c42-04c0eb35bd7f",
                        "source_sense_description": "bijzonder en leuk, apart op een leuke manier",
                        "target_lang_word": "spielerisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spielerisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9d8d83e-a244-3bd0-9497-9956b324bf69",
                                        "entry_id": "e769c549-5efa-325e-b03c-9aad6abfd212",
                                        "glosses": [
                                            "wie im Spiel, locker"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "573c9d29-7bf2-4543-a6ad-17a2c0d5d533",
                                                "sense_id": "c9d8d83e-a244-3bd0-9497-9956b324bf69",
                                                "text": "Er löste die Mathematikaufgaben spielerisch."
                                            },
                                            {
                                                "example_id": "6ff3c937-52cf-4ba7-9fd6-5aa10555db1a",
                                                "sense_id": "c9d8d83e-a244-3bd0-9497-9956b324bf69",
                                                "text": "„In zweistündigen Einzelsitzungen stellen die Testleiter — Promovierende oder Hilfskräfte — jedem Kind Fragen nach Einstellungen, Gedanken oder Gefühlen, lassen es je nach Alter spielerisch aufbereite Aufgaben am Computer lösen und filmen einzelne Szenen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3c3a43f1-4dbe-35cb-8cb7-6b9ffeb008a4",
                                        "entry_id": "e769c549-5efa-325e-b03c-9aad6abfd212",
                                        "glosses": [
                                            "das technische Vermögen im Spiel betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82fd0bde-89bb-4538-b458-26681f279633",
                                                "sense_id": "3c3a43f1-4dbe-35cb-8cb7-6b9ffeb008a4",
                                                "text": "Die Gastmannschaft war der Heimmannschaft spielerisch überlegen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a8f98a12-9f68-3d4a-b8e9-9bbe0f36b3cf",
                                        "entry_id": "e769c549-5efa-325e-b03c-9aad6abfd212",
                                        "glosses": [
                                            "ohne Ernst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d785394-7f0b-452b-bb9e-b23271622646",
                                                "sense_id": "a8f98a12-9f68-3d4a-b8e9-9bbe0f36b3cf",
                                                "text": "„In Frankreich ist es vor allem der Staatsmann Thiers, Minister für Handel und öffentliche Arbeiten, der sich gegen die Verwirklichung längerer Eisenbahnstrecken ausspricht; er gesteht den dampfbetriebenen Zügen allenfalls eine spielerische Komponente zu.\""
                                            }
                                        ],
