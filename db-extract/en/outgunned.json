                    {
                        "sense_id": "20bec452-8778-3907-8944-847ff1ebae91",
                        "entry_id": "1881eaa1-b5f0-3f02-a924-6811d30944ab",
                        "glosses": [
                            "Having insufficient guns compared to the enemy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df70c6bc-3035-4c3a-a537-f63f887bed6e",
                                "sense_id": "20bec452-8778-3907-8944-847ff1ebae91",
                                "text": "The fighters were hugely outgunned by the regular army."
                            },
                            {
                                "example_id": "9c33a4a3-84f4-43c6-ab3f-9b91e660f7cd",
                                "sense_id": "20bec452-8778-3907-8944-847ff1ebae91",
                                "text": "The opposite is true, said Dulcie Flaherty, executive director of the Montgomery County Lands Trust: \"We are very outgunned. We need to have funding […]"
                            },
                            {
                                "example_id": "bd080217-3425-4d1a-9291-708be5fa48b2",
                                "sense_id": "20bec452-8778-3907-8944-847ff1ebae91",
                                "text": "They greatly extended the battlefield and made the 6-pounder even more outgunned in action."
                            },
                            {
                                "example_id": "c0a01284-58e3-4db3-af87-74ab21b16270",
                                "sense_id": "20bec452-8778-3907-8944-847ff1ebae91",
                                "text": "Cockrell's men, becoming more outgunned with every passing minute, finally retreated back over the ridge and re-formed, supported by a Mississippi regiment."
                            }
                        ]
                    },
                    {
                        "sense_id": "62112eeb-28f2-3852-b1a0-83e4e688f804",
                        "entry_id": "1881eaa1-b5f0-3f02-a924-6811d30944ab",
                        "glosses": [
                            "Up against formidable adverse circumstances or (especially) adversarial forces."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b9028087-ca1a-4588-ad0b-cc0434d536fc",
                                "sense_id": "62112eeb-28f2-3852-b1a0-83e4e688f804",
                                "text": "Near-synonyms: outmatched, in too deep, out of one's depth, over one's head"
                            }
                        ]
                    }
