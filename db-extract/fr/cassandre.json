                "translations": [
                    {
                        "translation_id": "ec8b0796-3795-459f-9e25-69c578669df1",
                        "source_entry_id": "5ba85780-58c2-3c3b-b0e0-441ed78c663e",
                        "source_sense_id": "7085f834-bb0d-39fc-a324-d81896318c37",
                        "target_lang_word": "Cassandra",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cassandra",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "912b3a25-3d99-3776-9f05-97b902b6f7ab",
                                        "entry_id": "7c6af7b6-9551-3f5f-b148-dbb7ca3b5d70",
                                        "glosses": [
                                            "A prophetess who was daughter of King Priam of Troy and his queen Hecuba. She captured the eye of Apollo and was granted the ability to see the future; however, she was destined never to be believed."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfdf33a5-8882-4686-af57-325202513f53",
                                                "sense_id": "912b3a25-3d99-3776-9f05-97b902b6f7ab",
                                                "text": "And so when Cassandra foretold the evils that were to come upon Troy, even her own people would not credit her words."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b22db2b0-97d6-33a6-8fd0-8e63cf4333e7",
                                        "entry_id": "7c6af7b6-9551-3f5f-b148-dbb7ca3b5d70",
                                        "glosses": [
                                            "A female given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edeaca88-8ab0-4c16-98fb-7529f69da4d2",
                                                "sense_id": "b22db2b0-97d6-33a6-8fd0-8e63cf4333e7",
                                                "text": "But succeeding ages (little regarding S. Chrysosthome's admonition to the contrary) have recalled prophane names, so as now Diana, Cassandra, Hyppolytus, Venus, Lais, names of unhappy disaster are as rife, as ever they were in paganism."
                                            },
                                            {
                                                "example_id": "497864ca-86c0-44bf-b3bf-18ae7eaf4bbd",
                                                "sense_id": "b22db2b0-97d6-33a6-8fd0-8e63cf4333e7",
                                                "text": "Warren J. Tyler, son of Joel, was born in Byron, July 28, 1828. He married Cassandra Tyler, of Stafford, and has four children living."
                                            },
                                            {
                                                "example_id": "dc928fd4-e228-43cd-9b6d-f9a0b0f03d15",
                                                "sense_id": "b22db2b0-97d6-33a6-8fd0-8e63cf4333e7",
                                                "text": "\"What's your name?\" I asked.\n\"Cassandra.\"\nAh, a mythical name. It fit with the fairy-tale looks."
                                            },
                                            {
                                                "example_id": "2a01fe82-069e-4711-bdee-11f2007ed8b9",
                                                "sense_id": "b22db2b0-97d6-33a6-8fd0-8e63cf4333e7",
                                                "text": "Cassandra sat down on a small sofa next to Mrs Budley."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29c5b62b-44a1-338e-9d9f-5f64eec3fdd4",
                                        "entry_id": "7c6af7b6-9551-3f5f-b148-dbb7ca3b5d70",
                                        "glosses": [
                                            "An unincorporated community in Walker County, Georgia, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61bf5fe9-8dae-38ec-b65e-aef766d13413",
                                        "entry_id": "7c6af7b6-9551-3f5f-b148-dbb7ca3b5d70",
                                        "glosses": [
                                            "A small borough in Cambria County, Pennsylvania, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Cassandra",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "502a8b8a-379b-3c56-939b-885a006fc8a4",
                                        "entry_id": "b4b40e57-adc7-34f4-83ff-8b0e2a389fbd",
                                        "glosses": [
                                            "A person who makes dire predictions, especially those which are not believed but which turn out to be true."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e981cd1-fe16-4262-9a0b-55c704145419",
                                                "sense_id": "502a8b8a-379b-3c56-939b-885a006fc8a4",
                                                "text": "\"Well, take my word for it, those girls will never marry; marriage is like money—seem to want it, and you never get it.\" The Cassandra was scarcely departed, when the objects of her oracle appeared—Mrs. Fergusson and her two daughters."
                                            },
                                            {
                                                "example_id": "9bd7cb13-4db8-45da-9f19-76656857b2a2",
                                                "sense_id": "502a8b8a-379b-3c56-939b-885a006fc8a4",
                                                "text": "1876–1877, \"The New Republic\", book III, chapter IV, page 46 in Belgravia: An Illustrated London Magazine, volume XXXI\n'By the way,' said Mr. Saunders […] , 'I suppose I may speak the truth freely, as I know well enough that all to whom my vaticinations would be unwelcome are sure to mistake me for a Cassandra.'"
                                            },
                                            {
                                                "example_id": "891fed1b-aca9-41ca-966f-d4cc3dbb6b6d",
                                                "sense_id": "502a8b8a-379b-3c56-939b-885a006fc8a4",
                                                "text": "When Cassandras like Pete Peterson, the former Commerce Secretary, present alarming numbers about the future burden of baby boomers on the budget, it turns out that only part of that prospective burden represents the sheer demographic effects of an aging population: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
