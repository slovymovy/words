                "senses": [
                    {
                        "sense_id": "331e0ec7-a03f-3bbb-842e-aaadb4830df0",
                        "entry_id": "60701979-80e3-3f3c-859a-a8ee78842c2e",
                        "glosses": [
                            "Se conserver par soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44e32a55-b28a-4d60-80f5-c21ffc8b949f",
                                "sense_id": "331e0ec7-a03f-3bbb-842e-aaadb4830df0",
                                "text": "La capacité à s' « autoconserver » constitue un enjeu central dans l'épreuve que doivent surmonter ceux dont le corps tombe malade."
                            },
                            {
                                "example_id": "27895a82-2847-41b4-80f4-3b3cfd77bc78",
                                "sense_id": "331e0ec7-a03f-3bbb-842e-aaadb4830df0",
                                "text": "Après incubation pendant 15 jours sous agitation toutes les 24 heures, le mélange peut s'autoconserver grâce à son acidité élevée et sa flore initiale (BL)."
                            },
                            {
                                "example_id": "f9987b79-c646-4ecd-8ec6-624549317445",
                                "sense_id": "331e0ec7-a03f-3bbb-842e-aaadb4830df0",
                                "text": "Les institutions ont une tendance établie à s'autoconserver, à s'automaintenir, et ceci en dépit du sujet."
                            }
                        ]
                    }
