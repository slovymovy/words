                "senses": [
                    {
                        "sense_id": "242ed585-7417-3d8c-b175-cadf61d6c222",
                        "entry_id": "a544cc8c-d09b-3cea-ba50-9667a815704d",
                        "glosses": [
                            "Fournir un asile à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16fa91f7-0d95-47d8-b200-15a8d4ec71cb",
                                "sense_id": "242ed585-7417-3d8c-b175-cadf61d6c222",
                                "text": "Si le Venezuela avait réagi de la même façon, jamais il n’aurait dû m’asiler, et encore moins me naturaliser."
                            },
                            {
                                "example_id": "731ac9e6-7756-4cff-a8c4-c8c5ce6450dd",
                                "sense_id": "242ed585-7417-3d8c-b175-cadf61d6c222",
                                "text": "Betancourt, véritable lion de la politique, s’asile à l’ambassade de Colombie."
                            }
                        ]
