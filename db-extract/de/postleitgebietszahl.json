                "senses": [
                    {
                        "sense_id": "cc7b45b8-a27a-3be7-990d-7bb36460520e",
                        "entry_id": "56683a85-de95-34f2-8561-c8ffaa790cb0",
                        "glosses": [
                            "Ziffernkombination, die auf Postsendungen den Zustellort angibt"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "28b67410-13bc-4944-8841-44d04bd9119f",
                                "sense_id": "cc7b45b8-a27a-3be7-990d-7bb36460520e",
                                "text": "„Da man jedoch in der Übergangsphase unter keinen Umständen mehr Stempel mit der bisherigen, 1941 eingeführten Postleitgebietszahl (PLGZ) […] verwenden wollte, erging alsbald der Erlass, die PLGZ aus den Stempeln zu entfernen und diese aptiert weiterzuverwenden.“"
                            },
                            {
                                "example_id": "4be034b9-8394-4a18-8694-bad8593e5db5",
                                "sense_id": "cc7b45b8-a27a-3be7-990d-7bb36460520e",
                                "text": "„Im Juni 1944 wurde ferner angeordnet, dass in neu anzufertigenden Ortstagesstempeln grundsätzlich die Postleitgebietszahl in Klammern vor dem Ortsnamen eingearbeitet werden sollte.“"
                            },
                            {
                                "example_id": "13a31415-ff60-4a03-83d6-42327a0939e4",
                                "sense_id": "cc7b45b8-a27a-3be7-990d-7bb36460520e",
                                "text": "„1941 wird durch die Deutsche Reichspost für Nordbayern die Postleitgebietszahl ‚13a‘ eingeführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
