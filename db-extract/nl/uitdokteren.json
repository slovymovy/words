        "nl-extract.jsonl": [
            {
                "entry_id": "15aceae6-181e-31eb-84dc-5093e7a72ce3",
                "word": "uitdokteren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c7af4d85-bf5f-36e0-b6a9-2faf9850e053",
                        "entry_id": "15aceae6-181e-31eb-84dc-5093e7a72ce3",
                        "glosses": [
                            "uitzoeken en uitproberen van iets om zo een probleem op te lossen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1561e62d-9a88-474e-b4a7-fdb4fe803f4a",
                                "sense_id": "c7af4d85-bf5f-36e0-b6a9-2faf9850e053",
                                "text": "Leren is hierbij in het begin belangrijker dan rendement. “Achter een bureau een masterplan voor de komende 5 jaar uitdokteren, is niet meer van deze tijd."
                            },
                            {
                                "example_id": "43ddbdfb-a3bd-4c05-9819-298fdd104d32",
                                "sense_id": "c7af4d85-bf5f-36e0-b6a9-2faf9850e053",
                                "text": "„Ik ben de oudste ceo van alle beursgenoteerde ondernemingen in Nederland. Ik heb nog leiding mogen geven aan het uitdokteren van een plan tot 2020. Het is goed dat dit in uitvoering wordt gebracht door degenen die daar straks ook verantwoording over af moeten afleggen. Ik denk dat het dan beter is om de leiding eerder over te dragen.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f77cb671-5291-40b9-9222-1fcc32337183",
                        "source_entry_id": "15aceae6-181e-31eb-84dc-5093e7a72ce3",
                        "source_sense_id": "c7af4d85-bf5f-36e0-b6a9-2faf9850e053",
                        "target_lang_word": "puzzle out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "puzzle out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a09d82f8-3b2e-34d5-bd6f-49fb36c2f51d",
                                        "entry_id": "49970db1-7fa9-39d7-a660-292bda5e4583",
                                        "glosses": [
                                            "To figure out; to discover or find a solution to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c2ba135-9f78-4f87-ac8e-5031ebe8d9ca",
                                                "sense_id": "a09d82f8-3b2e-34d5-bd6f-49fb36c2f51d",
                                                "text": "[…] but Clover, who thought she remembered a definite ruling against beds, went to the end of the barn and tried to puzzle out the Seven Commandments which were inscribed there."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74225775-4e9b-4ea5-8fd9-e7447d8044eb",
                        "source_entry_id": "15aceae6-181e-31eb-84dc-5093e7a72ce3",
                        "source_sense_id": "c7af4d85-bf5f-36e0-b6a9-2faf9850e053",
                        "target_lang_word": "figure out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "figure out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "642b2691-2f77-355e-92fb-848d1ee32d6d",
                                        "entry_id": "3d5276c4-031c-3276-a9b4-0f7232b9fe6e",
                                        "glosses": [
                                            "To come to understand; to discover or find a solution; to deduce."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c96ff9b-bf9a-4ec9-b361-8b3bce5d71f2",
                                                "sense_id": "642b2691-2f77-355e-92fb-848d1ee32d6d",
                                                "text": "As soon as I figure out what is wrong with my car, I will fix it."
                                            },
                                            {
                                                "example_id": "14d727b3-5310-4877-accc-b75dec0a5230",
                                                "sense_id": "642b2691-2f77-355e-92fb-848d1ee32d6d",
                                                "text": "In a bid to understand the eternal mystery that is woman, Bart goes to the least qualified possible source for advice and counsel: his father, who remarkably seems to have made it to his mid-30s without quite figuring out much of anything."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bd9a735-0391-39b4-b8c0-f57e572e4f6e",
                                        "entry_id": "3d5276c4-031c-3276-a9b4-0f7232b9fe6e",
                                        "glosses": [
                                            "To calculate."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "018c74b4-3bbe-483c-9a61-ca9c3e8521c1",
                                                "sense_id": "6bd9a735-0391-39b4-b8c0-f57e572e4f6e",
                                                "text": "We'd already figured out that the trip would cost $1,000."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
