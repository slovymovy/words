        "fr-extract.jsonl": [
            {
                "entry_id": "543c40f8-2576-3620-8e4b-bc2503492e37",
                "word": "uniment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ca9e0bf9-3a2a-30e1-8b2d-361387dca024",
                        "entry_id": "543c40f8-2576-3620-8e4b-bc2503492e37",
                        "glosses": [
                            "Également et toujours de même sorte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b63b7787-98c5-4cb8-8579-6d4b956304ac",
                                "sense_id": "ca9e0bf9-3a2a-30e1-8b2d-361387dca024",
                                "text": "Ce fil est filé uniment."
                            },
                            {
                                "example_id": "d13bd7df-e1f0-4b03-a3af-5e985ce325ee",
                                "sense_id": "ca9e0bf9-3a2a-30e1-8b2d-361387dca024",
                                "text": "Cette toile est travaillée uniment."
                            },
                            {
                                "example_id": "8b0821df-63a0-4fdb-b576-9729ca6a8b01",
                                "sense_id": "ca9e0bf9-3a2a-30e1-8b2d-361387dca024",
                                "text": "Et ce long flot soyeux tout uniment s’épanche\nDans les arbres charnus."
                            }
                        ]
                    },
                    {
                        "sense_id": "32ecd4a9-5cb8-3906-b9b9-09749f614edb",
                        "entry_id": "543c40f8-2576-3620-8e4b-bc2503492e37",
                        "glosses": [
                            "Simplement, sans plus."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "45bee679-67a2-4dc7-87cc-f7dd4d92b483",
                                "sense_id": "32ecd4a9-5cb8-3906-b9b9-09749f614edb",
                                "text": "C’est tout uniment une description exacte et scientifique d’une sorte de folie très-rare en France."
                            },
                            {
                                "example_id": "ba16bef9-26fb-4e02-9895-cd6ca4531d16",
                                "sense_id": "32ecd4a9-5cb8-3906-b9b9-09749f614edb",
                                "text": "Il vit que son notaire était bien décidément un imbécile qu’il fallait tout uniment congédier, et il l’arrêta résolument par un geste."
                            },
                            {
                                "example_id": "af94f136-7cad-47f7-89b8-4f2213ec1d11",
                                "sense_id": "32ecd4a9-5cb8-3906-b9b9-09749f614edb",
                                "text": "Une première fois, à Gueures, après avoir attiré mes amis dans un guet-apens, vous vous êtes emparé d’un objet qui nous appartenait, ce qui, en langage ordinaire, s’appelle tout uniment un vol qualifié."
                            },
                            {
                                "example_id": "9cab4ae3-c084-4a82-b4d3-567d6fa269ae",
                                "sense_id": "32ecd4a9-5cb8-3906-b9b9-09749f614edb",
                                "text": "M. Gélis est tout uniment le jeune homme qui, l’an passé, m’a traité d’imbécile, sous les marronniers."
                            },
                            {
                                "example_id": "32a0292d-dbc6-428a-a025-f270198a2dce",
                                "sense_id": "32ecd4a9-5cb8-3906-b9b9-09749f614edb",
                                "text": "Michel-Joseph avait toujours aimé jouer de la carte postale insolente : sur le revers d’une vue de la Grand Place, il m’avisa tout uniment que ce qui restait de mon héritage maternel s’était dissipé : je n’avais plus, à l’en croire, qu’à vendre des pommes aux carrefours. (Il y a, il est vrai, de plus sots métiers.)"
                            },
                            {
                                "example_id": "426f34b9-a22a-44e8-9ab4-f0dcf369472a",
                                "sense_id": "32ecd4a9-5cb8-3906-b9b9-09749f614edb",
                                "text": "Sans entrer dans le détail de situations souvent complexes, le soutien financier que l’Afrique reçoit de ses Argonautes à l’étranger est, indiscutablement, très important. Mais il n’est pas tout uniment bénéfique."
                            }
                        ]
                    }
                ],
