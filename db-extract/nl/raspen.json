                                "target_senses": [
                                    {
                                        "sense_id": "389bc92f-8a37-37d8-bb70-ed8bd8511a82",
                                        "entry_id": "c3cb9746-f681-3000-8b59-4f835029f703",
                                        "glosses": [
                                            "A horizontal metal grill through which liquid, ash, or small objects can fall, while larger objects cannot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "377372fa-9629-44cf-bde6-c9433c89aa5c",
                                                "sense_id": "389bc92f-8a37-37d8-bb70-ed8bd8511a82",
                                                "text": "The grate stopped the sheep from escaping from their field."
                                            },
                                            {
                                                "example_id": "fbb974c8-47a9-47b9-8a2b-c75fade8b85f",
                                                "sense_id": "389bc92f-8a37-37d8-bb70-ed8bd8511a82",
                                                "text": "a secret grate of iron bars"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24a4e0e4-aa6b-3f39-a00a-c9a979dd6d1f",
                                        "entry_id": "c3cb9746-f681-3000-8b59-4f835029f703",
                                        "glosses": [
                                            "A frame or bed, or kind of basket, of iron bars, for holding fuel while burning."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0b73377b-8cce-3d7e-8202-b3813c0b85aa",
                                        "entry_id": "c3cb9746-f681-3000-8b59-4f835029f703",
                                        "glosses": [
                                            "A grapper, a metal ring on a lance behind the grip."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c01f30b4-0a5a-4ce4-906a-55e6296e4955",
                                                "sense_id": "0b73377b-8cce-3d7e-8202-b3813c0b85aa",
                                                "text": "Lances (only shown at Stoke D'Abernon) were commonly made of ash, about 13 feet long. A ring of metal (grate or grapper) was fastened to the shaft and during a fight[…]"
                                            },
                                            {
                                                "example_id": "d3634036-ae71-434b-90d4-fde16f000491",
                                                "sense_id": "0b73377b-8cce-3d7e-8202-b3813c0b85aa",
                                                "text": "[…] and a heavy metal ring, called the grate or graper, fastened to the shaft below the grip. The grate rested against the knight's breastplate and relieved the hand and arm of the full shock of contact. The metallic head (or socket) of the war lance was usually leaf shaped, while that of the tilting lance, at least from[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08883611-f0b8-304a-b272-e9e9588952d6",
                                        "entry_id": "e557a5ce-f69b-383f-a006-53aa6cd75ddd",
                                        "glosses": [
                                            "To furnish with grates; to protect with a grating or crossbars."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8680b1d-13f8-4d48-a8ae-784ace1f3b6a",
                                                "sense_id": "08883611-f0b8-304a-b272-e9e9588952d6",
                                                "text": "to grate a window"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f0f33c7-0651-3c3e-88dd-6ed521351865",
                                        "entry_id": "c71b6281-af8b-3e81-ac5e-43c9f6b0846c",
                                        "glosses": [
                                            "To shred (things, usually foodstuffs), by rubbing across a grater."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c91db8a0-0c52-4c3d-a905-997d37b1b212",
                                                "sense_id": "7f0f33c7-0651-3c3e-88dd-6ed521351865",
                                                "text": "I need to grate the cheese before the potato is cooked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d92586a2-bb0a-3e33-aae5-52f08775f976",
                                        "entry_id": "c71b6281-af8b-3e81-ac5e-43c9f6b0846c",
                                        "glosses": [
                                            "To make an unpleasant rasping sound, often as the result of rubbing against something."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36a318e2-30b2-4e7c-9c8b-be1c1d8c0c75",
                                                "sense_id": "d92586a2-bb0a-3e33-aae5-52f08775f976",
                                                "text": "1856, Gustave Flaubert, Madame Bovary, Part 3 Chapter X, translated by Eleanor Marx-Aveling\nThe gate suddenly grated. It was Lestiboudois; he came to fetch his spade, that he had forgotten. He recognised Justin climbing over the wall, and at last knew who was the culprit who stole his potatoes."
                                            },
                                            {
                                                "example_id": "9e29aac2-aa39-48c5-a18c-03c5ce9f3065",
                                                "sense_id": "d92586a2-bb0a-3e33-aae5-52f08775f976",
                                                "text": "The turmoil went on—no rest, no peace. […] It was nearly eleven o'clock now, and he strolled out again. In the little fair created by the costers' barrows the evening only seemed beginning; and the naphtha flares made one's eyes ache, the men's voices grated harshly, and the girls' faces saddened one."
                                            },
                                            {
                                                "example_id": "e11b8a05-ee7a-4803-a389-6190920074f0",
                                                "sense_id": "d92586a2-bb0a-3e33-aae5-52f08775f976",
                                                "text": "Listening to his teeth grate all day long drives me mad."
                                            },
                                            {
                                                "example_id": "4efab8e4-f957-40bb-b99a-378ddabe3332",
                                                "sense_id": "d92586a2-bb0a-3e33-aae5-52f08775f976",
                                                "text": "The chalk grated against the board."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71900441-5d62-3c5b-9327-fd237b93dff8",
                                        "entry_id": "c71b6281-af8b-3e81-ac5e-43c9f6b0846c",
                                        "glosses": [
                                            "To get on one's nerves; to irritate, annoy."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c93efd9a-5834-4a6b-a37b-f61fe40fe811",
                                                "sense_id": "71900441-5d62-3c5b-9327-fd237b93dff8",
                                                "text": "She’s nice enough, but she can begin to grate if there is no-one else to talk to."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30ec3d85-af30-38ea-ad73-a0a94cfbd17c",
                                        "entry_id": "c71b6281-af8b-3e81-ac5e-43c9f6b0846c",
                                        "glosses": [
                                            "To annoy."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddd5dcb0-523f-422f-88d1-683db7ef44e6",
                                                "sense_id": "30ec3d85-af30-38ea-ad73-a0a94cfbd17c",
                                                "text": "2015, Art Levy in Florida Trend, Roland Martin is a Florida 'Icon'\none of the issues that's kind of grating me a little bit is weed control."
                                            },
                                            {
                                                "example_id": "34503981-7404-4fd1-9cb6-7527b6ce463c",
                                                "sense_id": "30ec3d85-af30-38ea-ad73-a0a94cfbd17c",
                                                "text": "News, my good lord Rome […] grates me."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d147fa8-d06d-3e6a-b943-b47cf87e3389",
