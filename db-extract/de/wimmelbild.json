                "senses": [
                    {
                        "sense_id": "9d59c439-19ac-32da-84a7-c54273bfb22a",
                        "entry_id": "f5bfaef1-9b35-3419-a150-4cc726287a43",
                        "glosses": [
                            "A picture for children richly detailed with numerous people, animals, and objects."
                        ],
                        "tags": [
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "16b78f6c-8b95-4d3a-a66f-4dee1dd93c8b",
                                "sense_id": "9d59c439-19ac-32da-84a7-c54273bfb22a",
                                "text": "So kreiert Schlingensief auf Wagners Folie natürlich vor allem ein Wimmelbild, ein monströses, nimmermüdes Tohuwabohu im Neben- und Über- und Durcheinander von Bildern und Tönen.",
                                "translation": "Of course Schlingensief creates in this way above all a superabundant horror vacui image from Wagner's backdrop, a monstrous, never-tiring vortical chasm in an ensemble of images and notes placed beside, above and through one another.",
                                "english": "Of course Schlingensief creates in this way above all a superabundant horror vacui image from Wagner's backdrop, a monstrous, never-tiring vortical chasm in an ensemble of images and notes placed beside, above and through one another."
                            }
                        ]
                    },
                    {
                        "sense_id": "fadb58d8-d3ab-3da9-b74b-093c5a1cee37",
                        "entry_id": "f5bfaef1-9b35-3419-a150-4cc726287a43",
                        "glosses": [
                            "A genre of painting with many details developed in the 15th and 16th centuries."
                        ],
