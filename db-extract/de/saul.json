                ],
                "senses": [
                    {
                        "sense_id": "231f0190-bc55-3c31-8e43-b65192230b34",
                        "entry_id": "f17ee072-b257-3d54-83ab-fb56b2ef5301",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3199c60-71b4-4fa1-a205-b1375d3605c7",
                                "sense_id": "231f0190-bc55-3c31-8e43-b65192230b34",
                                "text": "Frau Saul ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "def71d2b-1292-43a0-a76e-28d056df6e06",
                                "sense_id": "231f0190-bc55-3c31-8e43-b65192230b34",
                                "text": "Herr Saul wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "80d41efd-ecdc-441c-98cc-7ddc9610705c",
                                "sense_id": "231f0190-bc55-3c31-8e43-b65192230b34",
                                "text": "Die Sauls fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "77b628a0-52b2-4b1f-93ad-4efc66bc570a",
                                "sense_id": "231f0190-bc55-3c31-8e43-b65192230b34",
                                "text": "Der Saul trägt nie die Schals, die die Saul ihm strickt."
                            },
                            {
                                "example_id": "9516bb64-73a4-4905-a9ed-f699bc6bb233",
                                "sense_id": "231f0190-bc55-3c31-8e43-b65192230b34",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Saul kommt, geht der Herr Saul.“"
                            },
                            {
                                "example_id": "5cad36cb-9ac6-4ebd-abdd-5db3fd6a2fa3",
                                "sense_id": "231f0190-bc55-3c31-8e43-b65192230b34",
                                "text": "Saul kommt und geht."
                            },
                            {
                                "example_id": "5eb5dcb1-4e2b-4bce-a191-1075c2850f85",
                                "sense_id": "231f0190-bc55-3c31-8e43-b65192230b34",
                                "text": "Sauls kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
