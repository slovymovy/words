                "senses": [
                    {
                        "sense_id": "59b846fa-0716-3e3b-9de1-0a00d746190f",
                        "entry_id": "785509ba-977c-3724-863f-1264230fe9a3",
                        "glosses": [
                            "Gebäude, das auf einem Grundstück steht, welches nicht dem Gebäudeeigentümer gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdb9ef31-5074-43ff-81da-12e4030f281e",
                                "sense_id": "59b846fa-0716-3e3b-9de1-0a00d746190f",
                                "text": "Gartenhäuser in Kleingartenanlagen werden oft als Superädifikat errichtet."
                            },
                            {
                                "example_id": "85486f76-98a6-488b-af50-72d11060791d",
                                "sense_id": "59b846fa-0716-3e3b-9de1-0a00d746190f",
                                "text": "„Ein Superädifikat, geregelt in den Paragrafen 297 und 435 des ABGB, ist ein Bauwerk auf fremdem Grund, das dort ohne Belassungsabsicht errichtet wurde.“"
                            },
                            {
                                "example_id": "2c10c5fb-bc59-4ecf-8226-035eade518ca",
                                "sense_id": "59b846fa-0716-3e3b-9de1-0a00d746190f",
                                "text": "„Das Gebäude steht auf einem Grund der Stadt Wien, bei dem es sich nach Auskunft des Bauressorts um ein Superädifikat handelt, also ein Bauwerk, das auf einem fremden Grund errichtet wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
