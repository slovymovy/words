                        "cross_references": [
                            {
                                "target_word": "pelvic floor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f7d8b2e-a97f-37ea-b4e8-e36df0ffbc8f",
                                        "entry_id": "272641d2-cf4d-35bc-b2a6-224f6d07b5b6",
                                        "glosses": [
                                            "A muscular partition, formed by the muscle fibers of the levator ani, the coccygeus, and associated connective tissue, which spans the area underneath the pelvis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49354c31-5936-499c-bc68-b55e68dbe7cb",
                                                "sense_id": "4f7d8b2e-a97f-37ea-b4e8-e36df0ffbc8f",
                                                "text": "1994, T. Sayer, T. Smith, 2.9 Pelvic Floor Biopsy, Bernhard Schüssler, Jo Laycock, Peggy A. Norton, Stuart L. Stanton (editors), Pelvic Floor Re-Education, Springer, page 99,\nSingle-fibre electromyography (SFEMG) and pudendal nerve terminal motor latency (PNTML) recordings were done in control women and women with genitourinary prolapse or stress incontinence who also had a pelvic floor muscle biopsy."
                                            },
                                            {
                                                "example_id": "5189aa25-ca61-4021-8f75-849f1fe389fc",
                                                "sense_id": "4f7d8b2e-a97f-37ea-b4e8-e36df0ffbc8f",
                                                "text": "Pelvic floor ultrasound is often described as a niche investigation within obstetrics and gynecology and even within gynecological ultrasound."
                                            },
                                            {
                                                "example_id": "23b1ca2a-46e4-4ecc-8b38-7ab1a201ec30",
                                                "sense_id": "4f7d8b2e-a97f-37ea-b4e8-e36df0ffbc8f",
                                                "text": "High-resolution three-dimensional endovaginal ultrasonography (EVUS) provides a detailed evaluation of the pelvic floor muscles and the levator ani complex, the lower urinary tract, and the anorectal region in planes that cannot be determined by conventional two-dimensional EVUS."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
