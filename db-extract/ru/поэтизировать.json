                ],
                "translations": [
                    {
                        "translation_id": "2513e2b6-2a4f-4b6f-a752-87ffbc3ebedf",
                        "source_entry_id": "a01a00e8-611a-30b9-9ad4-cc8d8d2d4d6c",
                        "target_lang_word": "poeticize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poeticize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5b4f2a6-1709-321e-ba61-18a8dcab90ea",
                                        "entry_id": "0ff67705-4dea-35bf-b4c8-e18227b707e4",
                                        "glosses": [
                                            "To make poetic, or express in poetry."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0efaf5b3-d103-4602-8190-2cf738921d2b",
                                                "sense_id": "a5b4f2a6-1709-321e-ba61-18a8dcab90ea",
                                                "text": "The ambition of Russia is most elaborately exposed in an essay highly poeticized."
                                            },
                                            {
                                                "example_id": "965992af-0ad4-4e97-bf89-3fac44d6c5ae",
                                                "sense_id": "a5b4f2a6-1709-321e-ba61-18a8dcab90ea",
                                                "text": "To the ancients in Mesopotamia as well as in Mexico this movement was poeticized as a journey through the underworld."
                                            },
                                            {
                                                "example_id": "f8c0dcb8-8e5d-409d-b078-bdc8d874ce8f",
                                                "sense_id": "a5b4f2a6-1709-321e-ba61-18a8dcab90ea",
                                                "text": "For me, the process of poeticizing the DSM is a way to enhance my empathic understanding of clients."
                                            },
                                            {
                                                "example_id": "20fc0b19-9a1e-4e64-925a-b7518bb667f9",
                                                "sense_id": "a5b4f2a6-1709-321e-ba61-18a8dcab90ea",
                                                "text": "His poeticized version of a news flash about the advent of AIDS (the disease that killed his mother) electrifies, as it should, like unexpected lightning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75e7ad23-fa85-3060-8bf6-4f6164442f11",
                                        "entry_id": "0ff67705-4dea-35bf-b4c8-e18227b707e4",
                                        "glosses": [
                                            "To write or speak in the manner of a poet."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97ffdc7b-9214-4845-86c6-35c5d311cdc6",
                                                "sense_id": "75e7ad23-fa85-3060-8bf6-4f6164442f11",
                                                "text": "They may poeticize when they come down upon the glory of the unclouded sun, or the extensive wonders of the developed landscape; but, my word for it, all was lost upon them, so long as their chief care was not to break their necks by a sudden descent!"
                                            },
                                            {
                                                "example_id": "8a170d97-66d0-4496-866a-4f8626f78488",
                                                "sense_id": "75e7ad23-fa85-3060-8bf6-4f6164442f11",
                                                "text": "Then, if I wish to poeticize upon it at home, there is Belinda, with her sylphs, drinking it in such state as nothing but poetry can supply […]"
                                            },
                                            {
                                                "example_id": "f42b191e-1f77-4d68-a9c4-75524ceb4412",
                                                "sense_id": "75e7ad23-fa85-3060-8bf6-4f6164442f11",
                                                "text": "One play is about a weak man who, under pressure, gives up his friend first and his crown later, and interests us only in his very human weakness and by virtue of the faint halo that is cast around it by all the grace and poeticizing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7c7acc2-7c8c-4a82-9a19-af9eef86c951",
                        "source_entry_id": "a01a00e8-611a-30b9-9ad4-cc8d8d2d4d6c",
                        "target_lang_word": "poetize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poetize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c284783-3adf-317e-95e5-00d7c227f1f5",
                                        "entry_id": "5cef7102-2997-38ba-bd2e-0aaba8496ad9",
                                        "glosses": [
                                            "To make (something) poetic."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76298517-3868-46a8-a3de-9cfec43f07d3",
                                                "sense_id": "6c284783-3adf-317e-95e5-00d7c227f1f5",
                                                "text": "She acknowledged that Wordsworth had done more to make all men poetical, than perhaps any other; that he was the poet of reflection; that where he failed to poetize his subject, his simple faith intimated to the reader a poetry that he did not find in the book."
                                            },
                                            {
                                                "example_id": "c05a0b12-339a-43c0-ac9a-40eac2785ad8",
                                                "sense_id": "6c284783-3adf-317e-95e5-00d7c227f1f5",
                                                "text": "Its aim is not merely to reunite all the dispersed classes of poetry, and to place poetry in touch with philosophy and rhetoric; it aims and ought to aim to mingle and combine poetry and prose, genius and criticism, artistic and natural poetry; to make poetry lively and social, to make life and society poetic; to poetize wit, to saturate all the forms of art with worthy materials of culture and enliven them by the sallies of humor."
                                            },
                                            {
                                                "example_id": "ce561049-ffb3-4d28-ad12-83dfec221498",
                                                "sense_id": "6c284783-3adf-317e-95e5-00d7c227f1f5",
                                                "text": "While the sailor was again attacking his breakfast with the familiarity of a lover who has achieved his ends and no longer needs to hide and poetize his grosser necessities, she seated herself on an old chaise longue, lighting a cigarette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61e25588-1bd4-38fb-9b75-151f779d4d01",
                                        "entry_id": "5cef7102-2997-38ba-bd2e-0aaba8496ad9",
                                        "glosses": [
                                            "To compose poetry."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6b71751-a0ef-46b3-9e6d-4a1f541b9f1e",
                                                "sense_id": "61e25588-1bd4-38fb-9b75-151f779d4d01",
                                                "text": "[T]each thy Incubus to Poëtize, / And throvve abroad thy ſpurious Snotteries, / Vpon that puft-vp Lumpe of Barmy froth, […]"
                                            },
                                            {
                                                "example_id": "66ddaa45-076d-4afc-bfc1-d2f566398e40",
                                                "sense_id": "61e25588-1bd4-38fb-9b75-151f779d4d01",
                                                "text": "It was probably after this amour ended that Sordello sat out upon his travels, visiting most courts, and dwelling long in Provence, where he learned to poetize in the Provencal tongue, in which he thereafter chiefly wrote, and composed many songs."
                                            },
                                            {
                                                "example_id": "30753f58-2ebc-42e3-99b3-0733fb485f05",
                                                "sense_id": "61e25588-1bd4-38fb-9b75-151f779d4d01",
                                                "text": "Hot sake is next served, which is to them what beer is to a German or absinthe to a blouse; and there they sit, sip, and poetize, passing their couplets, as they do their cups, in honor to one another."
                                            },
                                            {
                                                "example_id": "c43836ec-33e6-4142-b081-3c0e0cd8e8f9",
                                                "sense_id": "61e25588-1bd4-38fb-9b75-151f779d4d01",
                                                "text": "This it is that, particularly in my earlier years, gave me a rather awkward appearance both in the field of speculation and in that of poetry; for the poetic mind generally got the better of me when I ought to have philosophized, and my philosophical mind when I wished to poetize."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
