                        "examples": [
                            {
                                "example_id": "1c160298-9f2f-4f10-8f82-0355051bb3e6",
                                "sense_id": "6f16d593-9de1-3d1d-8223-f37dea3d5c25",
                                "text": "Но Машка, словно бы довольная, что Аксинья бессовестно врёт, не хуже кошки, одобрительно мурлыкнула."
                            },
                            {
                                "example_id": "c2f0c71f-bced-484a-ae3a-a438b82dddef",
                                "sense_id": "6f16d593-9de1-3d1d-8223-f37dea3d5c25",
                                "text": "Телефон мягко мурлыкнул."
                            },
                            {
                                "example_id": "d14868d8-f8da-4211-b377-3c702c6684d9",
                                "sense_id": "6f16d593-9de1-3d1d-8223-f37dea3d5c25",
                                "text": "Получив положенное, животное ещё разок благодарно мурлыкнуло и приступило к трапезе."
                            }
                        ]
                    }
