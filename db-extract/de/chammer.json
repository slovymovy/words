                "senses": [
                    {
                        "sense_id": "ad2a79cf-9802-334f-940f-9b1cda550d05",
                        "entry_id": "363bc40a-c7a0-3ba0-a7ba-6d2f720be8b9",
                        "glosses": [
                            "zur Gattung der Pferde gehörendes (männliches) Huftier, das ein (je nach Art / Unterart) graues bis braunes, fahlgelbes bis ockerfarbenes oder rötliches bis rotbraunes Fell mit dunklem Aalstrich, eine kurze, aufrecht stehende Nackenmähne, lange Ohren und einen Quastenschwanz besitzt, und dessen domestizierte Vertreter als Nutz-, Last- und Reittier dienen (Asinus)"
                        ],
                        "tags": [
                            "sondersprachlich (Rotwelsch)"
                        ],
                        "examples": [
                            {
                                "example_id": "20c8309b-f9ef-45b6-afef-6aeb7bc863d2",
                                "sense_id": "ad2a79cf-9802-334f-940f-9b1cda550d05",
                                "text": "bildlich: „Ohne auch nur einen Blick vom Eiſe weg auf den Commiſſar zu wenden, entgegnete der Angeredete mit fertiger Zunge: ‚Wenn der Chammer[…] Hörner hätt’ un’ der Ochs wüßt’ von ſeiner Kraft, hätt’ die Welt kein Kijum[…] [= Bestand]. […]‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c39acb12-debf-3158-a905-604116eb7ef0",
                        "entry_id": "363bc40a-c7a0-3ba0-a7ba-6d2f720be8b9",
                        "glosses": [
                            "jemand, der dumm, einfältig, unbeholfen, ungeschickt sowie, mitunter, störrisch ist oder ähnliche für das unter [1] beschriebene Tier typisch geltende Eigenschaften besitzt"
                        ],
                        "tags": [
                            "familiär"
                        ],
                        "examples": [
                            {
                                "example_id": "42b62dc2-0966-49e0-8922-61ac292e2083",
                                "sense_id": "c39acb12-debf-3158-a905-604116eb7ef0",
                                "text": "„Gott ſteh mer bei, was bin ich für ä Chammer!“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "18650530-e181-3b33-8406-fad1742f4242",
                        "entry_id": "363bc40a-c7a0-3ba0-a7ba-6d2f720be8b9",
                        "glosses": [
                            "jemand, der grob, ungehobelt ist"
                        ],
                        "tags": [
                            "familiär"
                        ],
                        "examples": [
                            {
                                "example_id": "74f13e40-dde9-43e2-8afc-b3549b537bd0",
                                "sense_id": "18650530-e181-3b33-8406-fad1742f4242",
                                "text": "„Das ſind keine Menſchen, das ſind grobbe Chamaurem.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
