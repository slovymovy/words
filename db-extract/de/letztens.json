                "translations": [
                    {
                        "translation_id": "ac5c61b4-b676-44dc-93c8-2dfec9b0fd26",
                        "source_entry_id": "882cd80e-6572-32d4-b58f-9b0e79563b57",
                        "source_sense_id": "4c55d26b-aa57-3042-87a8-b8605aea4b75",
                        "source_sense_description": "neulich, vor Kurzem",
                        "target_lang_word": "dernièrement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
