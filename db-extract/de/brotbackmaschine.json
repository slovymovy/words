                                        "entry_id": "47d51442-ab76-34ca-881c-bb552557fbac",
                                        "glosses": [
                                            "A household appliance which makes dough from raw ingredients and in most cases can also bake it into bread."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44346358-3209-3f7c-b1c5-ce8dad1ad32a",
                                        "entry_id": "47d51442-ab76-34ca-881c-bb552557fbac",
                                        "glosses": [
                                            "One who makes bread; a baker of bread, either non-vocationally or vocationally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d8ea9c5-fa66-4c09-ad10-f775487639ef",
                                                "sense_id": "44346358-3209-3f7c-b1c5-ce8dad1ad32a",
                                                "text": "He was a bread maker and a fishmonger."
                                            },
                                            {
                                                "example_id": "2d6f4236-6313-4e10-b171-0297546a45a6",
                                                "sense_id": "44346358-3209-3f7c-b1c5-ce8dad1ad32a",
                                                "text": "He was being trained to make wedding cakes and sugar sculptures although, at heart, he was a bread maker."
                                            },
                                            {
                                                "example_id": "5d72276b-e06a-4a2a-935a-6d337e5065b8",
                                                "sense_id": "44346358-3209-3f7c-b1c5-ce8dad1ad32a",
                                                "text": "Not to be left out, bread maker extraordinaire Eric Kayser of Maison Kayser will provide extraordinary breads to complement each cheese."
                                            },
                                            {
                                                "example_id": "42e0c30f-b300-41e7-93c6-dbac91979cf4",
                                                "sense_id": "44346358-3209-3f7c-b1c5-ce8dad1ad32a",
                                                "text": "But now a furious row has risen, as bread makers stand accused of changing the recipe rulebook into a “cheats’ charter”."
                                            }
