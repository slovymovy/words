    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bed293bf-e730-32dc-a788-26566a67c629",
                    "sense_definition": "Mający wysoką cenę; kosztujący dużo pieniędzy.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "price",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten nowy samochód jest dla mnie zdecydowanie za <w>drogi</w>.",
                            "target_lang_translations": {
                                "ru": "Этот новый автомобиль для меня определённо слишком <w>дорогой</w>.",
                                "de": "Dieses neue Auto ist für mich definitiv zu <w>teuer</w>."
                            }
                        },
                        {
                            "text": "Mieszkanie w centrum Warszawy jest bardzo <w>drogie</w>.",
                            "target_lang_translations": {
                                "ru": "Квартира в центре Варшавы очень <w>дорогая</w>.",
                                "de": "Eine Wohnung im Zentrum von Warschau ist sehr <w>teuer</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "kosztowny",
                        "nietani"
                    ],
                    "antonyms": [
                        "tani"
                    ],
                    "common_phrases": [
                        "bardzo drogi",
                        "za drogi",
                        "drogi sprzęt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий высокую цену; стоящий много денег.",
                        "de": "Einen hohen Preis habend; viel Geld kostend."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дорогой",
                                "target_lang_sense_clarification": "о цене"
                            },
                            {
                                "target_lang_word": "дорогостоящий",
                                "target_lang_sense_clarification": "имеющий высокую стоимость"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "teuer",
                                "target_lang_sense_clarification": "einen hohen Preis aufweisend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20b17e83-d5fc-34a4-bb57-c8086a12be10",
                    "sense_definition": "Bliski sercu, darzony uczuciem; używane także jako zwrot grzecznościowy w listach i powitaniach.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój <w>drogi</w> przyjacielu, dawno się nie widzieliśmy.",
                            "target_lang_translations": {
                                "ru": "Мой <w>дорогой</w> друг, мы давно не виделись.",
                                "de": "Mein <w>lieber</w> Freund, wir haben uns lange nicht gesehen."
                            }
                        },
                        {
                            "text": "To jest pamiątka po mojej <w>drogiej</w> babci.",
                            "target_lang_translations": {
                                "ru": "Это память о моей <w>дорогой</w> бабушке.",
                                "de": "Das ist ein Andenken an meine <w>liebe</w> Großmutter."
                            }
                        }
                    ],
                    "synonyms": [
                        "kochany",
                        "bliski",
                        "miły (W zwrotach grzecznościowych",
                        "np. „mój miły”)",
                        "najdroższy."
                    ],
                    "common_phrases": [
                        "mój drogi",
                        "drogi panie",
                        "drogi przyjacielu"
                    ],
                    "target_lang_definitions": {
                        "ru": "Близкий сердцу, любимый; также используется как вежливое обращение в письмах и приветствиях.",
                        "de": "Dem Herzen nahestehend, geliebt; wird auch als höfliche Anrede in Briefen und Begrüßungen verwendet."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дорогой",
                                "target_lang_sense_clarification": "любимый, близкий"
                            },
                            {
                                "target_lang_word": "родной",
                                "target_lang_sense_clarification": "близкий, свой"
                            },
                            {
                                "target_lang_word": "милый",
                                "target_lang_sense_clarification": "приятный, любимый"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "lieb",
                                "target_lang_sense_clarification": "geschätzt, gemocht"
                            },
                            {
                                "target_lang_word": "teuer",
                                "target_lang_sense_clarification": "geliebt, von persönlichem Wert (literarisch)"
                            }
                        ]
                    }
                }
            ]
        },
