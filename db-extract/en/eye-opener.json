                                        "glosses": [
                                            "etwas, das jemanden aufmerken, genau hinsehen lässt; etwas, das jemandem etwas Bestimmtes klarmacht, vor Augen führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
