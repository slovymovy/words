                ],
                "senses": [
                    {
                        "sense_id": "8b38e562-6ead-3232-8dc0-0d345c729dad",
                        "entry_id": "0825b43c-c706-32a2-8950-1265a2bd0602",
                        "glosses": [
                            "een militair versterkte stad."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6fc467b-cb71-4520-baf3-5ea08a7a2d19",
                                "sense_id": "8b38e562-6ead-3232-8dc0-0d345c729dad",
                                "text": "Een vesting moest een stad beschermen tegen vijanden."
                            },
                            {
                                "example_id": "0fd758bb-0ba8-47fb-8a33-7a4c420edf71",
                                "sense_id": "8b38e562-6ead-3232-8dc0-0d345c729dad",
                                "text": "Ik ontmoette Maurits kort voor vertrek naar Amerika in een bruine kroeg in Naarden Vesting."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "354312a8-0620-46d7-abd4-6c53d5ac29d3",
                        "source_entry_id": "0825b43c-c706-32a2-8950-1265a2bd0602",
                        "source_sense_id": "8b38e562-6ead-3232-8dc0-0d345c729dad",
                        "target_lang_word": "fortress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fortress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04b67daa-b8b3-3d83-9529-f131eb6326b6",
                                        "entry_id": "acd6859e-7561-35f4-ab69-4f8ef3062b41",
                                        "glosses": [
                                            "A fortified place; a large and permanent fortification, sometimes including a town; for example a fort, a castle; a stronghold; a place of defense or security."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c3095e9-5a55-458a-a233-b54602f9ffd2",
                                                "sense_id": "04b67daa-b8b3-3d83-9529-f131eb6326b6",
                                                "text": "Like the Mesolithic age of 10,000-8000 B.C., the period 6000-4000 B.C. seems to be one of the fall of fortresses and the rise of pastoral nomadism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4418a9f-a482-34b8-b581-5756f6e62eca",
                                        "entry_id": "acd6859e-7561-35f4-ab69-4f8ef3062b41",
                                        "glosses": [
                                            "A position that, if obtained by the weaker side, will prevent penetration by the opposing side, generally achieving a draw."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fortress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dca5555d-da8f-35a8-bdfa-003cfe1a9177",
                                        "entry_id": "55f159d4-32c4-385e-b14c-056a531dd6e7",
                                        "glosses": [
                                            "To furnish with a fortress or with fortresses; to guard, to fortify."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef6a1f6e-1f4b-4ebb-9a15-69fec5e8136d",
                                                "sense_id": "dca5555d-da8f-35a8-bdfa-003cfe1a9177",
                                                "text": "Honour and Beautie in the owners armes, / Are weaklie fortreſt from a world of harmes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef7d0272-e0d6-4b30-8b91-e7efc54647b3",
                        "source_entry_id": "0825b43c-c706-32a2-8950-1265a2bd0602",
                        "source_sense_id": "8b38e562-6ead-3232-8dc0-0d345c729dad",
                        "target_lang_word": "крепость",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "крепость",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9b78995b-750b-3483-9695-8f32f449c42f",
                                        "entry_id": "3f5a0627-4a95-36b2-8d5b-a52b9ed08151",
                                        "glosses": [
                                            "свойство быть твёрдым, стойким, сильным"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62c4f748-cc3c-4690-b5f9-4cc2cbdfe3a9",
                                                "sense_id": "9b78995b-750b-3483-9695-8f32f449c42f",
                                                "text": "Убеждение, что действия наши клонятся к благу Отечества, единственно поддерживало в нас крепость духа, энергию и отвагу, столь необходимые при таких обстоятельствах."
                                            },
                                            {
                                                "example_id": "ec111a77-ddb1-4b1f-ac2a-31366a3c102a",
                                                "sense_id": "9b78995b-750b-3483-9695-8f32f449c42f",
                                                "text": "Уже угадывается крепость, независимость и благородство будущего кедра, похож кедрёныш почему-то на крепкий гриб-боровик, хотя пропорции, и цвет, и вся природа у него иные."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfa19770-a6be-3ed0-bd97-4d422e3307fd",
                                        "entry_id": "3f5a0627-4a95-36b2-8d5b-a52b9ed08151",
                                        "glosses": [
                                            "насыщенность, концентрированность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e8e7dcb-677b-479d-a460-3924a86e3893",
                                                "sense_id": "cfa19770-a6be-3ed0-bd97-4d422e3307fd",
                                                "text": "Крепость приготовленного кофе оставляла желать лучшего."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "крепость",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "af6df776-bf17-37d5-9867-51700a80baf2",
                                        "entry_id": "e09a72ee-0657-385a-b7f4-1a277efa4cda",
                                        "glosses": [
                                            "воен. укреплённое место с долговременными оборонительными сооружениями, приспособленное для круговой обороны"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6ac4250-dd03-4e9e-b5ce-c639b5e418c9",
                                                "sense_id": "af6df776-bf17-37d5-9867-51700a80baf2",
                                                "text": "Крепость оказалась, как крепость, — четырехугольник стен с восемью фланкирующими башнями; стены, сделанные из твёрдой глины, были толщиною в четыре сажени при такой же, четырёхсаженной, высоте по отвесу; кроме того, на гребне стен торчали зубцы вышиною в полсажени. Огромный ров был выкопан перед стенами, но артиллерия крепости была слаба, — всего три орудия; гарнизон тоже невелик: четыреста человек."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "крепость",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a593b606-39e1-3911-8933-a6e7ad1251fa",
                                        "entry_id": "352ad1f7-7ec7-3a78-8464-752ff0f23d77",
                                        "glosses": [
                                            "устар. крепостная зависимость"
                                        ],
                                        "tags": [],
