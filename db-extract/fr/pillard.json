                "forms": [],
                "senses": [
                    {
                        "sense_id": "d494fa8a-0291-3418-a0ba-a78bdeda82f5",
                        "entry_id": "85281312-1c98-336c-ba5a-10337533ca4e",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "922bf3f9-8db5-40e4-bb85-08a4fe02f123",
                                "sense_id": "d494fa8a-0291-3418-a0ba-a78bdeda82f5",
                                "text": "« Ça fait très plaisir à notre clientèle d’avoir une femme derrière le bar », note Marie Pillard, 33 ans, cheffe cocktail depuis sept ans au Café Juliette à Lyon."
                            }
                        ]
                    }
                ],
                "translations": [],
