                                "target_senses": [
                                    {
                                        "sense_id": "b3a9b879-a28e-37eb-9ce0-60a7c7b1354d",
                                        "entry_id": "4ce2b91f-8781-3a69-9d86-931a5f34fe8c",
                                        "glosses": [
                                            "een middeleeuws wapen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd7b077d-26b1-4381-b017-c98a3c843304",
                                                "sense_id": "b3a9b879-a28e-37eb-9ce0-60a7c7b1354d",
                                                "text": "De slingerarm was de opvolger van de lepelblijde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e70716ca-d445-38d1-8f02-e19d9d0a5a0c",
                                        "entry_id": "4ce2b91f-8781-3a69-9d86-931a5f34fe8c",
                                        "glosses": [
                                            "de lange, vrij draaiende hefboom, het onderdeel dat aan 1) zijn werking verleent"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07a3e654-2cf5-38b2-829b-9f2c4899cc1b",
                                        "entry_id": "4ce2b91f-8781-3a69-9d86-931a5f34fe8c",
                                        "glosses": [
                                            "een lange vrij draaiende hefboom gelijkend op 2)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bb53d21-014f-465a-bf45-b14936e45d3b",
                                                "sense_id": "07a3e654-2cf5-38b2-829b-9f2c4899cc1b",
                                                "text": "Het toestel bestaat uit een slingerarm die van een welbepaalde hoogte af vrij kan schommelen en aan het uiteinde van een meetrubber is voorzien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb9c8827-478c-4d75-ba6b-674a69ec55a4",
                        "source_entry_id": "8a912ec9-371d-3152-a965-c0b4196bdfc2",
