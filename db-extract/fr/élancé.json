                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4d74195-caf2-444c-af44-ebfe2c16d361",
                                                "sense_id": "6de4b3ee-aee4-3f9c-87f0-adb1ea340666",
                                                "text": "'Maar dan is het moeilijk te verklaren hoe de ringen zo smal blijven."
                                            },
                                            {
                                                "example_id": "f393eadf-ae5f-4467-834d-4b47cd3520c5",
                                                "sense_id": "6de4b3ee-aee4-3f9c-87f0-adb1ea340666",
                                                "text": "De meeuw is vaag terwijl haar moeder scherp, bewegingloos, smal en klein is."
                                            },
                                            {
                                                "example_id": "1560be38-3678-482e-b078-80746ed615df",
                                                "sense_id": "6de4b3ee-aee4-3f9c-87f0-adb1ea340666",
                                                "text": "Ik liep een smalle kloof in en volgde het dunne spoor water totdat ik uitkwam bij een rivier van wel vier meter breed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
