                    {
                        "sense_id": "f190f1cb-fd1a-3a15-8c22-9e0501027961",
                        "entry_id": "34a5e378-8eb3-3861-89df-b4682b0e3549",
                        "glosses": [
                            "Sous-traitant dans le secteur pharmaceutique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ff5f57b-1367-4417-bcc9-81fd1982f903",
                                "sense_id": "f190f1cb-fd1a-3a15-8c22-9e0501027961",
                                "text": "Le façonnier – comme on appelle les sous-traitants dans le secteur pharmaceutique – prévoit le maintien des 350 emplois sur le site et des investissements pour renforcer les capacités de production."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f050062-be4d-3f4e-a2a3-55b50ac58024",
                        "entry_id": "34a5e378-8eb3-3861-89df-b4682b0e3549",
                        "glosses": [
                            "Celui qui travaille à façon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "538008b1-b3b5-4898-b25b-dded543dd0ed",
                                "sense_id": "8f050062-be4d-3f4e-a2a3-55b50ac58024",
                                "text": "Puis, nous autres qui employons parfois des façonniers ayant dix ou quinze métiers, nous sommes davantage maîtres de la production."
                            }
                        ]
                    }
