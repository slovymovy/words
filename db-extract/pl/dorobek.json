                "senses": [
                    {
                        "sense_id": "091c7560-f9b6-3755-b3cb-78d555e1bfac",
                        "entry_id": "cc1197f3-73a9-3cf5-a5f0-630504eb0129",
                        "glosses": [
                            "to, czego ktoś się dorobił"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "728c5441-527f-4c1e-80c0-796249775466",
                                "sense_id": "091c7560-f9b6-3755-b3cb-78d555e1bfac",
                                "text": "Małżonkowie mogą w umowie majątkowej zmienić lub uchylić ustawowy ustrój wspólności dorobków."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "703fb9db-9d03-3ea1-926d-711fdcd785c9",
                        "entry_id": "cc1197f3-73a9-3cf5-a5f0-630504eb0129",
                        "glosses": [
                            "ogół twórczości określonego uczonego, pisarza, artysty itp."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e75ec684-8392-47d1-bace-2fb5e7dfdc68",
                                "sense_id": "703fb9db-9d03-3ea1-926d-711fdcd785c9",
                                "text": "Charakteryzując cechy sztuki awangardowej, nie możemy zapominać o świadomym odrzuceniu dorobku pokoleń artystów."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "9c8d2882-c14c-3864-adc4-55757bfee4fc",
                        "entry_id": "cc1197f3-73a9-3cf5-a5f0-630504eb0129",
                        "glosses": [
                            "ogół osiągnięć w jakiejś dziedzinie"
                        ],
