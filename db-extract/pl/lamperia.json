                    {
                        "translation_id": "9bd58434-abbb-4990-871b-42ddb8e1b934",
                        "source_entry_id": "fea36926-14e8-3d24-bc11-b406a0285ab6",
                        "source_sense_id": "8b2fa22c-0e1c-3580-9534-8555912be852",
                        "target_lang_word": "панель",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "панель",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e698643d-4acc-3b75-8e3d-56b304151976",
                                        "entry_id": "7de08c21-95c8-35ce-945b-75244f3a0050",
                                        "glosses": [
                                            "строит. крупная плоская строительная деталь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df08c690-efb0-497e-a9bb-759a241fb1f5",
                                                "sense_id": "e698643d-4acc-3b75-8e3d-56b304151976",
                                                "text": "Один фасад дома отделан виниловым сайдингом, другие ― вентилируемыми навесными панелями сибирского завода «Краспан»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d768b764-bfb7-3ac8-b53e-c4e83a5faebc",
                                        "entry_id": "7de08c21-95c8-35ce-945b-75244f3a0050",
                                        "glosses": [
                                            "устар. то же, что тротуар; часть дороги, предназначенная пешеходам"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68bc2ae1-98b3-467f-9783-69d2b2fdddd9",
                                                "sense_id": "d768b764-bfb7-3ac8-b53e-c4e83a5faebc",
                                                "text": "Много столпилось людей на панели. // Люди в тревоге под крышу смотрели: // Там из окошка сквозь огненный дым // Руки ребёнок протягивал к ним."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3033cce2-f4d1-3c6c-bb2b-721788cd177b",
                                        "entry_id": "7de08c21-95c8-35ce-945b-75244f3a0050",
                                        "glosses": [
                                            "техн. то же, что пульт; поверхность прибора, аппарата, на которой монтируются приборы контроля и управления || комп. компьютерная имитация этого пульта"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c67044f-9efa-4ddf-808c-a06ed6546e47",
                                                "sense_id": "3033cce2-f4d1-3c6c-bb2b-721788cd177b",
                                                "text": "Передняя панель выглядит вполне стильно; большие круглые дефлекторы напоминают о чем-то реактивном."
                                            },
                                            {
                                                "example_id": "6667e7f9-301d-48e1-8a27-253714bc1f93",
                                                "sense_id": "3033cce2-f4d1-3c6c-bb2b-721788cd177b",
                                                "text": "Панель задач."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7864c897-24aa-3f65-802f-682acbc25608",
                                        "entry_id": "7de08c21-95c8-35ce-945b-75244f3a0050",
                                        "glosses": [
                                            "комп. то же, что матрица; отображающая часть плоского (ЖК- или плазменного) монитора, телевизора"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1913f093-a82c-4670-bc89-bc755949d88b",
                                                "sense_id": "7864c897-24aa-3f65-802f-682acbc25608",
                                                "text": "Уровень «чёрного» несколько великоват ― фильмы «ночного» жанра не так темны, как на плазменной панели."
                                            }
                                        ]
                                    }
                                ]
                            },
