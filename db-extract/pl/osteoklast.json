                        "cross_references": []
                    },
                    {
                        "translation_id": "8a6d6bb6-0493-442f-bc34-c2a16ee1d064",
                        "source_entry_id": "daae12d7-d29b-3940-b54f-4c9afa14230c",
                        "source_sense_id": "0a96b757-9b9a-3660-9bf0-dadcf00fa197",
                        "target_lang_word": "Osteoklast",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Osteoklast",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "215c07fd-a74d-3d8e-96b3-5000622e2689",
                                        "entry_id": "1bfc5ec5-b618-3132-b9e3-a653ed235c20",
                                        "glosses": [
                                            "Biologie, Medizin: Zelle, die Knochensubstanz abbaut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f95e23b3-f621-48ff-afed-d03b9b04dbfd",
                                                "sense_id": "215c07fd-a74d-3d8e-96b3-5000622e2689",
                                                "text": "Osteoblasten sind die Zellen, die den Knochen aufbauen; Osteoklasten dagegen bauen Knochensubstanz ab."
                                            },
                                            {
                                                "example_id": "32c0439b-605e-451a-9d61-5f6395d8bf77",
                                                "sense_id": "215c07fd-a74d-3d8e-96b3-5000622e2689",
                                                "text": "„Bei der Entstehung der Knochenmetastasen spielt die unheilvolle Allianz zwischen Tumorzellen und Knochenzellen eine wesentliche Rolle: Tumorzellen stimulieren die Fresszellen des Knochens (Osteoklasten) und diese setzen aus dem zerstörten Knochen wichtige Überlebensfaktoren für die Tumorzellen frei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41554f74-97a4-481d-a489-5dda72b77a73",
                        "source_entry_id": "daae12d7-d29b-3940-b54f-4c9afa14230c",
                        "source_sense_id": "0a96b757-9b9a-3660-9bf0-dadcf00fa197",
                        "target_lang_word": "остеокла́ст",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "остеокла́ст",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2b2ddb63-7986-3fcd-b0f1-9a8f51756c3d",
                                        "entry_id": "59a0f000-3f73-3628-8385-d3d563d5f3fa",
                                        "glosses": [
                                            "мед., цитол. гигантская многоядерная клетка позвоночных животных, удаляющая костную ткань посредством растворения минеральной составляющей и разрушения коллагена"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b8f28ea-e6b8-47a1-a2f2-e48b6ed0a908",
                                                "sense_id": "2b2ddb63-7986-3fcd-b0f1-9a8f51756c3d",
                                                "text": "Остеокласты — крупные (150—180 мкм) многоядерные клетки, резорбирующие костную ткань. Остеокласт возможно рассматривать как симпласт — многоядерную структуру, являющуюся результатом слияния клеток-предшественников."
                                            },
                                            {
                                                "example_id": "10df11a4-4122-4657-9026-38c0b4980d4d",
                                                "sense_id": "2b2ddb63-7986-3fcd-b0f1-9a8f51756c3d",
                                                "text": "Костная ткань состоит из клеток (остеоцитов, остеобластов и остеокластов) и костного матрикса."
                                            },
                                            {
                                                "example_id": "db8154e0-520f-4f38-af55-6ff04802bb4d",
                                                "sense_id": "2b2ddb63-7986-3fcd-b0f1-9a8f51756c3d",
                                                "text": "Хотя внутренний механизм разрушительной роли остеокластов ещё недостаточно выяснен, но более чем вероятно, что клетки эти выделяют какое-то кислое вещество, растворяющее известковые соли, что и вызывает размягчение костного вещества."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
