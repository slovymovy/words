                                            {
                                                "example_id": "44b6b4b9-ba17-457c-a481-af1f1152db7f",
                                                "sense_id": "515bfad7-13fc-3842-a0f3-c21c1e74ba6d",
                                                "text": "Die Grabinschrift verriet, dass der Verstorbene 99 Jahre alt wurde."
                                            },
                                            {
                                                "example_id": "2280b2ce-72ce-4c99-aa9a-2159db7b7847",
                                                "sense_id": "515bfad7-13fc-3842-a0f3-c21c1e74ba6d",
                                                "text": "„Die Grabinschriften waren meist bis zur Unkenntlichkeit verwittert.“"
                                            },
                                            {
                                                "example_id": "bfc0635c-ce64-4528-9fa0-2c12322668e8",
                                                "sense_id": "515bfad7-13fc-3842-a0f3-c21c1e74ba6d",
                                                "text": "„Die unfreiwillige Komik bei Todesanzeigen und Grabinschriften beruht darauf, daß Tod und Sterben ohnehin Grenzsitutionen, Extremfälle sind, zu denen daher besonders leicht auch komische Kontraste hergestellt werden können.“"
                                            },
                                            {
                                                "example_id": "5d5bba85-cdf7-42a4-8a51-eecb162abcb1",
                                                "sense_id": "515bfad7-13fc-3842-a0f3-c21c1e74ba6d",
                                                "text": "„Er vertiefte sich so in die Arbeit, als sollte es seine Lebensaufgabe sein, die Grabinschrift für seinen Bruder zu verfassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0386f3c1-4d97-4c3d-833f-74411d4c8828",
                        "source_entry_id": "1c9307f3-cc12-3cc9-a889-7e49b4b78577",
                        "source_sense_id": "353809ef-531d-3c41-b7a8-0500b9010d37",
                        "target_lang_word": "эпитафия",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "эпитафия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b7109193-e219-342b-aae3-a84343ce047e",
                                        "entry_id": "757e89cd-eabf-3086-88dd-9d0823bc3e34",
                                        "glosses": [
                                            "надгробная надпись, изречение, выбиваемое на могиле"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5484114c-81da-410b-8004-fb287ea5cf77",
                                                "sense_id": "b7109193-e219-342b-aae3-a84343ce047e",
                                                "text": "Так я и плутала среди крестов и памятников, читала эпитафии, механически вычитала из года смерти год рождения."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66a5c6bd-f08b-3981-8dce-716d3a3ae200",
                                        "entry_id": "757e89cd-eabf-3086-88dd-9d0823bc3e34",
                                        "glosses": [
                                            "стихотворение, изречение или другое литературное произведение, написанное в связи с чьей-либо смертью, какой-либо утратой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bf22413-1861-4931-b99a-6c2f8312357b",
                                                "sense_id": "66a5c6bd-f08b-3981-8dce-716d3a3ae200",
                                                "text": "Поэты состязались в сочинении пышных эпитафий и по-русски и по-латыни."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
