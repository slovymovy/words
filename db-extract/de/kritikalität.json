                "senses": [
                    {
                        "sense_id": "8e899da1-e55f-30b3-8d93-e3c34cbd5222",
                        "entry_id": "58e6855a-5ce8-3c83-87b1-94ac9e9aa1b4",
                        "glosses": [
                            "Zustand eines Kernreaktors, bei dem eine sich selbst erhaltende Kettenreaktion abläuft"
                        ],
                        "tags": [
                            "Kernphysik"
                        ],
                        "examples": [
                            {
                                "example_id": "33779e9f-0069-4bec-91db-4d75cc5cd0c6",
                                "sense_id": "8e899da1-e55f-30b3-8d93-e3c34cbd5222",
                                "text": "Die erste sich selbst erhaltende Kettenreaktion, die sogenannte erste Kritikalität, fand am 9. Dezember 1981 um 21.11 Uhr im Reaktor des Kernkraftwerkes statt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "285c8d5d-adb2-4c20-a8cf-846ad30d7163",
                        "source_entry_id": "58e6855a-5ce8-3c83-87b1-94ac9e9aa1b4",
                        "source_sense_id": "8e899da1-e55f-30b3-8d93-e3c34cbd5222",
                        "target_lang_word": "prompt criticality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prompt criticality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36bcd325-4c64-38e4-b248-094305ab5855",
                                        "entry_id": "45ca7113-67ce-3287-89c9-386f75227a1f",
                                        "glosses": [
                                            "The point at which the prompt neutrons produced by a nuclear fission chain reaction are just sufficient to sustain the chain reaction on their own (the state of being prompt critical); past this point, changes in reaction power are controlled by changes in the prompt neutron flux, and occur on a timeframe of milliseconds, too rapidly to be controlled by mechanical means."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc61d615-c72a-4ee2-b8e5-b6e28b870880",
                                                "sense_id": "36bcd325-4c64-38e4-b248-094305ab5855",
                                                "text": "The system is thought to have approached prompt criticality, at which time the rate of power increase would have been determined by the neutron lifetime (on the order of milliseconds)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
