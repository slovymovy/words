                ],
                "senses": [
                    {
                        "sense_id": "4263c805-635b-3b3f-963c-ba65a8bb0356",
                        "entry_id": "272d2e88-15c9-3b93-9752-2afbf0098f51",
                        "glosses": [
                            "metaphorische Umschreibung für den Fluss von Gedanken, die – wie Wellen im Wasser – ständig in Bewegung sind, kommen und gehen, manchmal ruhig, manchmal stürmisch"
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "d9c59dbb-1ab5-4d3d-a88e-362d2a2a999f",
                                "sense_id": "4263c805-635b-3b3f-963c-ba65a8bb0356",
                                "text": "„Du kannst die Gedankenwellen nicht stoppen, aber du kannst lernen sie zu reiten.“"
                            },
                            {
                                "example_id": "45e0f727-3b2f-4e8a-8813-c7858ebb8b7a",
                                "sense_id": "4263c805-635b-3b3f-963c-ba65a8bb0356",
                                "text": "„Yoga ist das Stillen der Gedankenwellen im Geiste.“"
                            },
                            {
                                "example_id": "3964cc2d-4b0d-46d3-8745-740d4b6a650e",
                                "sense_id": "4263c805-635b-3b3f-963c-ba65a8bb0356",
                                "text": "„Yoga ist das Aufhören der Identifizierung mit den Gedankenwellen.“"
                            },
                            {
                                "example_id": "9c75c715-0dad-4b2c-a60a-8e400d106d97",
                                "sense_id": "4263c805-635b-3b3f-963c-ba65a8bb0356",
                                "text": "„Erlebe beim Duft-Flow Yoga die mannigfaltige Wirkung reiner ätherischer Öle und bringe deine Gedankenwellen im Geiste zur Ruhe.“"
                            },
                            {
                                "example_id": "849a2fc5-1a93-4951-bbca-5198f1825f01",
                                "sense_id": "4263c805-635b-3b3f-963c-ba65a8bb0356",
                                "text": "„Unser Atmen steht auch in direkter Verbindung mit den Gedankenwellen.“"
                            },
                            {
                                "example_id": "94dabb1b-cd69-4feb-8592-ca866b1d7e39",
                                "sense_id": "4263c805-635b-3b3f-963c-ba65a8bb0356",
                                "text": "„Der Plan ist, an Godzillas Hinterkopf einen Telepathieverstärker zu befestigen und ihn dann mit Gedankenwellen zu steuern.“"
                            },
                            {
                                "example_id": "da3c0f23-322f-4dbe-8c43-2615c339d1ff",
                                "sense_id": "4263c805-635b-3b3f-963c-ba65a8bb0356",
                                "text": "„Die niedrigsten Gedankenwellen ziehen ihn immer tiefer in das primitivste Dasein der Welt, das geprägt ist von fremden Gedanken, die aus dem ihn umgebenden Dasein in Gewalt, Leid, Krankheit, Lust, Misstrauen, Gier, Dummheit, Neid und ungeheurer Brutalität stammen.“"
                            },
                            {
                                "example_id": "34d550b7-6e6b-46d6-950e-e5b43f1ae25f",
                                "sense_id": "4263c805-635b-3b3f-963c-ba65a8bb0356",
                                "text": "„Trage Dein Haar bitte offen, damit du Gedankenwellen damit einfangen kannst.“"
                            },
                            {
                                "example_id": "1f11bb5e-9922-40a5-913e-28a75adfa3eb",
                                "sense_id": "4263c805-635b-3b3f-963c-ba65a8bb0356",
                                "text": "„Vielleicht käme der ein oder andere Betrachter mit auf seine ‚Gedankenwellen‘, stelle sich ähnliche Fragen beim Betrachten des Bildes wie der Künstler beim Malen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
