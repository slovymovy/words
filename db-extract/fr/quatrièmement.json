                        "cross_references": [
                            {
                                "target_word": "fourth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cbfdd5b1-2ae4-3701-bf95-3aab14599ad4",
                                        "entry_id": "e1de855d-80f3-3b7c-9f94-8cc9ddf49540",
                                        "glosses": [
                                            "To agree with a proposition or statement after it has already been thirded."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6870a32-083e-4225-86ef-a8e3198642f1",
                                                "sense_id": "cbfdd5b1-2ae4-3701-bf95-3aab14599ad4",
                                                "text": "If he remembered rightly what took place in the House on the first night of the session, the Attorney General would have to file an information, not only against the noble Lord who proposed the address, and the hon. Member for London who seconded it, but also against the hon. Member who thirded, and the noble Lord who fourthed it, and indeed against every Member in the House."
                                            },
                                            {
                                                "example_id": "e6025a9c-7a05-41b9-8166-3cdd2bd6c07c",
                                                "sense_id": "cbfdd5b1-2ae4-3701-bf95-3aab14599ad4",
                                                "text": "A lisping young “Soundings,” or master’s assistant, sung out “I thecond the mothon,” instantly transferring his beer to our hero’s face. In short the resolution was thirded, fourthed, fifthed, and sixthed, all following suit with the swipes:[…]"
                                            },
                                            {
                                                "example_id": "680cdd3c-5da1-4b18-acf5-ff3ef8f457d9",
                                                "sense_id": "cbfdd5b1-2ae4-3701-bf95-3aab14599ad4",
                                                "text": "It was then moved, seconded, thirded, fourthed, and fifthed, “that Jarman be, and is hereby hung, and ought to be kicked.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fourth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0a05d49-1343-3d9d-847f-70436ef357f0",
                                        "entry_id": "3d33f252-1638-3f90-b647-85a807a66afa",
                                        "glosses": [
                                            "The ordinal form of the number four."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b659c42-5216-422f-ad3a-14b9de99f8d8",
                                                "sense_id": "c0a05d49-1343-3d9d-847f-70436ef357f0",
                                                "text": "The fourth model is called the enlightment model: Actors are seen to be responsible for problems but unable or unwilling to provide solutions. They are believed to need discipline provided by authoritative guidance. The Alcoholic Anonymous^([sic]) groups are considered prototypical for this model."
                                            },
                                            {
                                                "example_id": "77a8da0d-9f96-4420-a3e8-8007591768fd",
                                                "sense_id": "c0a05d49-1343-3d9d-847f-70436ef357f0",
                                                "text": "Finnley is the fourth daughter of Jason and Kylie Kelce, having already welcomed Wyatt, Elliotte and Bennett to the family."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fourth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57b615f7-2078-34c2-a596-54a756411118",
                                        "entry_id": "94edd6e0-02a6-3d46-ae2c-bb0e1ee2b5c8",
                                        "glosses": [
                                            "The person or thing in the fourth position."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62b3c747-8712-4308-93e1-fc650aa3a9c0",
                                                "sense_id": "57b615f7-2078-34c2-a596-54a756411118",
                                                "text": "We are one F and two M's seeking the company of a fourth (M or F) for our spacious and friendly Somerville apt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b09bbd90-290c-3f13-8e06-4cc680e4aea9",
                                        "entry_id": "94edd6e0-02a6-3d46-ae2c-bb0e1ee2b5c8",
                                        "glosses": [
                                            "A quarter, one of four equal parts of a whole."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46546b0f-54ec-37ac-a258-3e1f634cf51c",
                                        "entry_id": "94edd6e0-02a6-3d46-ae2c-bb0e1ee2b5c8",
                                        "glosses": [
                                            "The fourth gear of an engine."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c45d207c-0ab8-3b11-973c-6c6901957812",
                                        "entry_id": "94edd6e0-02a6-3d46-ae2c-bb0e1ee2b5c8",
                                        "glosses": [
                                            "A musical interval which spans four degrees of the diatonic scale, for example C to F (C D E F)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63b7c0c4-95e2-4da1-a36e-94dbe3ed485b",
                                                "sense_id": "c45d207c-0ab8-3b11-973c-6c6901957812",
                                                "text": "Now I've heard there was a secret chord / That David played, and it pleased the Lord / But you don't really care for music, do ya? / It goes like this, the fourth, the fifth"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4d76f7f-fdf5-34de-900b-f25e41bcad9b",
                                        "entry_id": "94edd6e0-02a6-3d46-ae2c-bb0e1ee2b5c8",
                                        "glosses": [
                                            "One sixtieth of a third or tierce."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "932424d5-fd7f-4948-9d9f-b4ef3ad52064",
                                                "sense_id": "f4d76f7f-fdf5-34de-900b-f25e41bcad9b",
                                                "text": "[…] thirds (sixtieths of seconds), fourths (sixtieths of thirds) and so on, but then it becomes very cumbersome."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
