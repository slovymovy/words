                "senses": [
                    {
                        "sense_id": "638909a4-cb7d-3632-b9ea-7f1502095681",
                        "entry_id": "4b1b4835-ed34-3257-a814-5357e73eb114",
                        "glosses": [
                            "door bomen beschaduwde tuin"
