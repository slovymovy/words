                        "source_sense_id": "75724ac3-74ef-3353-91a2-34cf96cb2c41",
                        "source_sense_description": "Schwierigkeit, normal zu atmen, oft infolge körperlicher Anstrengung oder gesundheitlicher Probleme",
                        "target_lang_word": "shortness of breath",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
