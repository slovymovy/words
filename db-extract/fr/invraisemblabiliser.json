                ],
                "senses": [
                    {
                        "sense_id": "576f2bab-2a5c-3a39-ba94-dd88d8704ebe",
                        "entry_id": "353cd763-e74a-3c75-b092-81613726c718",
                        "glosses": [
                            "Rendre invraisemblable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e060c203-c7f0-44f8-baa0-9848dd28fc62",
                                "sense_id": "576f2bab-2a5c-3a39-ba94-dd88d8704ebe",
                                "text": "Encore une fois, mêler du savoir – donc du « vrai » – à de la fiction revient bien à vraisemblabiliser l’invraisemblable en invraisemblabilisant le vraisemblable."
                            },
                            {
                                "example_id": "9a7e95dd-08f9-47f6-9e5b-8cad7e7a0885",
                                "sense_id": "576f2bab-2a5c-3a39-ba94-dd88d8704ebe",
                                "text": "Il ne s’agit pas ici, à la lumière de Charles Grivel, d’« invraisemblabiliser » le récit : l’ « effet de réel » n’est en aucun cas annihilé, mais plutôt déplacé dans une sphère différente, hors de la réalité historique vécue."
                            }
                        ]
                    }
                ],
