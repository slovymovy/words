                ],
                "senses": [
                    {
                        "sense_id": "94598004-158d-31aa-bfdc-108990a63af2",
                        "entry_id": "0cb1dc85-d2df-325e-936c-8517df67124e",
                        "glosses": [
                            "Gebäude, das zum Abhalten von Ritualen vorgesehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca14e4ce-a303-4d69-ba0f-52c3451018c9",
                                "sense_id": "94598004-158d-31aa-bfdc-108990a63af2",
                                "text": "„Die Kirchengebäude sind — wie Hinweise zeigen — mit staatlichen Mitteln sorgfältig restauriert […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3300feb1-246a-3dd1-aa1f-3cd03f429395",
                        "entry_id": "0cb1dc85-d2df-325e-936c-8517df67124e",
                        "glosses": [
                            "Geschäftshäuser der jeweiligen Glaubensgemeinde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bf4692c-d787-41be-8f89-e704c91ad8a6",
                                "sense_id": "3300feb1-246a-3dd1-aa1f-3cd03f429395",
                                "text": "Als Kirchengebäude wird zumeist die errichtete Kirche bezeichnet, wobei jedoch der Vatikan in Rom, als zentraler Sitz der Kath. Kirche, auch noch andere Kirchengebäude besitzt und bewirtschaftet."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1402aab0-efe4-41f2-a25f-2575ff7b7c73",
                        "source_entry_id": "0cb1dc85-d2df-325e-936c-8517df67124e",
                        "source_sense_id": "94598004-158d-31aa-bfdc-108990a63af2",
                        "source_sense_description": "Gebäude, das zum Abhalten von Ritualen vorgesehen ist",
                        "target_lang_word": "church building",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0fc7f78e-ee4d-4bf8-9769-4a5c642df778",
                        "source_entry_id": "0cb1dc85-d2df-325e-936c-8517df67124e",
                        "source_sense_id": "94598004-158d-31aa-bfdc-108990a63af2",
                        "source_sense_description": "Gebäude, das zum Abhalten von Ritualen vorgesehen ist",
                        "target_lang_word": "church",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "church",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b68cc4db-43d0-3333-b141-ae1c722446f4",
                                        "entry_id": "edfe3d43-e1e3-3250-ae70-d63db994f43d",
                                        "glosses": [
                                            "A Christian house of worship; a building where Christian religious services take place."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc183001-b492-44c8-98e2-bc08b82b4e35",
                                                "sense_id": "b68cc4db-43d0-3333-b141-ae1c722446f4",
                                                "text": "There is a lovely little church in the valley."
                                            },
                                            {
                                                "example_id": "8e208162-046a-4c3a-8c08-f16015c26661",
                                                "sense_id": "b68cc4db-43d0-3333-b141-ae1c722446f4",
                                                "text": "This building used to be a church before being converted into a library."
                                            },
                                            {
                                                "example_id": "6b84b189-f963-44af-b83f-7f025b0dc639",
                                                "sense_id": "b68cc4db-43d0-3333-b141-ae1c722446f4",
                                                "text": "He got the message and was in church the next Sunday. We need to stay in church with the fellowship of others in order to keep the fire of faith burning brightly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2aa60006-b024-3cc8-bd0a-6a0436ec28bb",
                                        "entry_id": "edfe3d43-e1e3-3250-ae70-d63db994f43d",
                                        "glosses": [
                                            "Christians collectively seen as a single spiritual community; Christianity; Christendom."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5a015cd-6da8-42a5-9705-fe82aa27ee45",
                                                "sense_id": "2aa60006-b024-3cc8-bd0a-6a0436ec28bb",
                                                "text": "These worshippers make up the Church of Christ."
                                            },
                                            {
                                                "example_id": "e6fe302e-5bc6-4e96-89c0-dc52d1751c66",
                                                "sense_id": "2aa60006-b024-3cc8-bd0a-6a0436ec28bb",
                                                "text": "Be shepherds of the church of God, which he bought with his own blood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d64aac7-fa60-3e3c-aca1-11befb24e352",
                                        "entry_id": "edfe3d43-e1e3-3250-ae70-d63db994f43d",
                                        "glosses": [
                                            "A local group of people who follow the same Christian religious beliefs, local or general."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaefaa53-f518-4786-a1bc-6e632ee0c88c",
                                                "sense_id": "6d64aac7-fa60-3e3c-aca1-11befb24e352",
                                                "text": "Many young people find their only role models of family life in church."
                                            },
                                            {
                                                "example_id": "fcb50f8d-8096-4cd2-8226-db8d5320f60b",
                                                "sense_id": "6d64aac7-fa60-3e3c-aca1-11befb24e352",
                                                "text": "He got the message and was in church the next Sunday. We need to stay in church with the fellowship of others in order to keep the fire of faith burning brightly."
                                            },
                                            {
                                                "example_id": "cd9012f8-d78e-4169-ba75-6b353d731b3c",
                                                "sense_id": "6d64aac7-fa60-3e3c-aca1-11befb24e352",
                                                "text": "As they actively get involved in ministry, lay ministry becomes vigorous, and new believers will settle in church with more ease."
                                            },
                                            {
                                                "example_id": "583fe1ca-11f2-46c2-87bd-b2523b71c59a",
                                                "sense_id": "6d64aac7-fa60-3e3c-aca1-11befb24e352",
                                                "text": "she had very many adults in church with whom she could talk about issues in life."
                                            },
                                            {
                                                "example_id": "93472766-82a0-4ecb-99a3-323c458b1825",
                                                "sense_id": "6d64aac7-fa60-3e3c-aca1-11befb24e352",
                                                "text": "Ruthie had left the church disappointed , reluctant to give up the idea that she was chosen by God to become a saint . But within a month she had sinned by lying , masturbating , and coveting Sarah 130 • Beu Marshall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d95c790-4d8a-3d90-94b6-34f16166afb7",
                                        "entry_id": "edfe3d43-e1e3-3250-ae70-d63db994f43d",
                                        "glosses": [
                                            "A particular denomination of Christianity."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fe637ad-3614-4ae1-ae09-335e428cb775",
                                                "sense_id": "4d95c790-4d8a-3d90-94b6-34f16166afb7",
                                                "text": "The Church of England separated from the Roman Catholic Church in 1534."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f123d90-8d73-32c0-8275-08e97a0eb09f",
                                        "entry_id": "edfe3d43-e1e3-3250-ae70-d63db994f43d",
                                        "glosses": [
                                            "Christian worship held at a church; service."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fde0364-c092-483b-94e7-f7e773b93856",
                                                "sense_id": "0f123d90-8d73-32c0-8275-08e97a0eb09f",
                                                "text": "Pastors complained that they were not allowed enough authority in church, with women exercising too much informal control."
                                            },
                                            {
                                                "example_id": "0baed2ef-e15e-428b-87f6-185161ce47e9",
                                                "sense_id": "0f123d90-8d73-32c0-8275-08e97a0eb09f",
                                                "text": "Some people are always saying, \"Oh, you have too much church.\" You never get too much church. I go to church every day."
                                            },
                                            {
                                                "example_id": "19fbec8a-afb6-425a-9664-7aef58a7c816",
                                                "sense_id": "0f123d90-8d73-32c0-8275-08e97a0eb09f",
                                                "text": "the learned women will be qualified to lead in church with equal grace and equal insight and equal gifts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bff03e75-e044-351c-aff7-00811c7fdc08",
                                        "entry_id": "edfe3d43-e1e3-3250-ae70-d63db994f43d",
                                        "glosses": [
                                            "Organized religion in general or a specific religion considered as a political institution."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c6eadce-8b74-4df4-b46d-1cb699835f56",
                                                "sense_id": "bff03e75-e044-351c-aff7-00811c7fdc08",
                                                "text": "Many constitutions enshrine the separation of church and state."
                                            },
                                            {
                                                "example_id": "e1b9dfc6-f64f-42b3-9f1d-c625576e2b80",
                                                "sense_id": "bff03e75-e044-351c-aff7-00811c7fdc08",
                                                "text": "But in Muslim countries, Church and State are one indissolubly, and until the very essence of Islam passes away, that unity cannot be relaxed. The law of the land, too, is, in theory, the law of the Church."
                                            },
                                            {
                                                "example_id": "e3949e8e-2c7e-48fc-b6d7-b37949b4f07e",
                                                "sense_id": "bff03e75-e044-351c-aff7-00811c7fdc08",
                                                "text": "Because the pan-Buddhist movement was heavily supported by the Japanese in Inner Mongolia, the Buddhist church, already under attack by Soviet-backed antireligion campaigns in Outer Mongolia, was further damaged […]"
                                            },
                                            {
                                                "example_id": "1e09368d-636f-4c41-b534-c589f3fc28d3",
                                                "sense_id": "bff03e75-e044-351c-aff7-00811c7fdc08",
                                                "text": "The secular absolutist model is based on a strict separation between church and state."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0beaa49-0eb6-3e47-8308-71e35017de7d",
                                        "entry_id": "edfe3d43-e1e3-3250-ae70-d63db994f43d",
                                        "glosses": [
                                            "Any religious group or place of worship; a temple."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d372f8c-4e25-43a2-8d7f-08c9a815f4a5",
                                                "sense_id": "a0beaa49-0eb6-3e47-8308-71e35017de7d",
                                                "text": "She goes to a Wiccan church down the road."
                                            },
                                            {
                                                "example_id": "1d2f5e05-7fe7-42a7-bfbd-ea78a2474e77",
                                                "sense_id": "a0beaa49-0eb6-3e47-8308-71e35017de7d",
                                                "text": "Among these, the church must investigate fundemental questions, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc6b09de-e2ad-3ade-8992-48682de2d48f",
                                        "entry_id": "edfe3d43-e1e3-3250-ae70-d63db994f43d",
                                        "glosses": [
                                            "Assembly."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "church",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fed91632-a068-36c0-b985-cc59c1564563",
                                        "entry_id": "365610ba-d173-37eb-874d-23aaf68bebdd",
                                        "glosses": [
                                            "To conduct a religious service for (a woman after childbirth, or a newly married couple)."
                                        ],
                                        "tags": [
                                            "historical",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01c19761-7190-41c5-866b-2503d93d41f0",
                                                "sense_id": "fed91632-a068-36c0-b985-cc59c1564563",
                                                "text": "Thenne after this lady was delyuerd and chirched / there came a knyghte vnto her / his name was sire Bromel la pleche / the whiche was a grete lord and he hadde loued that lady longe / and he euermore desyred her to wedde her / and soo by no meane she coude putte hym of"
                                            },
                                            {
                                                "example_id": "e242b299-cb07-4df9-bda5-becabd1a5f51",
                                                "sense_id": "fed91632-a068-36c0-b985-cc59c1564563",
                                                "text": "Nor did it [the Church] accept that the woman should stay indoors until she had been churched."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "721ae0c2-2efe-3550-9301-88969ac9e5b6",
                                        "entry_id": "365610ba-d173-37eb-874d-23aaf68bebdd",
                                        "glosses": [
                                            "To educate someone religiously, as in a church."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "church",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9c841d7-3754-370f-8621-b28087a779c8",
                                        "entry_id": "5b1dee30-7d4f-3f14-b41e-46054a4eb606",
                                        "glosses": [
                                            "Used to express strong agreement."
                                        ],
