                                "sense_id": "5b215fc4-6a56-3a32-a910-3ef3364af778",
                                "text": "Vous m'avez trahi? Mazette!",
                                "translation": "You betrayed me? Damn!",
                                "english": "You betrayed me? Damn!"
                            },
                            {
                                "example_id": "bf8cf16d-101b-4dca-a8ac-040d712b88f1",
                                "sense_id": "5b215fc4-6a56-3a32-a910-3ef3364af778",
                                "text": "Mazette! Ma sœur est une mangeuse d'hommes!",
                                "translation": "Damn! My sister is a man-eater!",
                                "english": "Damn! My sister is a man-eater!"
                            }
                        ]
                    }
