    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "aa67c82d-c6b5-3be7-ba11-79c6bbda8e14",
                "word": "vicarage",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "23a5d477-0147-4d2a-8d00-fd7c3f90deee",
                        "entry_id": "aa67c82d-c6b5-3be7-ba11-79c6bbda8e14",
                        "tags": [
                            "plural"
                        ],
                        "form": "vicarages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "53726054-c6fe-3363-82b0-c6ac6494ae91",
                        "entry_id": "aa67c82d-c6b5-3be7-ba11-79c6bbda8e14",
                        "glosses": [
                            "The residence of a vicar."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "bbb541b3-590b-401b-a44d-e51a8ca4fb63",
                                "sense_id": "53726054-c6fe-3363-82b0-c6ac6494ae91",
                                "text": "Atlantic gales constantly buffet Morwenstow, whose seven hamlets together constitute Cornwall's most northerly parish. The village is dotted with trees moulded into weird shapes by the wind, and above the trees rise the vicarage chimneystacks resembling miniature church towers."
                            }
                        ]
                    },
                    {
                        "sense_id": "57287265-9d95-3cff-b558-e552ba5d8abb",
                        "entry_id": "aa67c82d-c6b5-3be7-ba11-79c6bbda8e14",
                        "glosses": [
                            "The benefice, duties, or office of a vicar."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e2940a9-34e0-4fbb-9b42-a49a4b27649c",
                        "source_entry_id": "aa67c82d-c6b5-3be7-ba11-79c6bbda8e14",
                        "source_sense_description": "residence of vicar",
                        "target_lang_word": "vicariat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vicariat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4baeb19c-379e-36bb-be6a-dc82eafda3db",
                                        "entry_id": "dbe77a74-fe6e-3ab9-90de-8a13808da873",
                                        "glosses": [
                                            "Fonction, emploi de vicaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ae27d97-6a9e-4f20-a6f1-1a455197febf",
                                                "sense_id": "4baeb19c-379e-36bb-be6a-dc82eafda3db",
                                                "text": "Le reste de ces étudians vivait dans la plus profonde misère, et lorsqu’ils avaient obtenu leurs licences, ils retournaient chez eux, attendre de leurs protecteurs une chapellenie, ou quelque vicariat de village."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b595fb8-d2fe-3802-82d7-dccb747db7ab",
                                        "entry_id": "dbe77a74-fe6e-3ab9-90de-8a13808da873",
                                        "glosses": [
                                            "Résidence d’un vicaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4915a52f-b72c-4dce-bd10-ad406b94bfb6",
                                                "sense_id": "6b595fb8-d2fe-3802-82d7-dccb747db7ab",
                                                "text": "Les habitants de Bessancourt demandent qu’ils ne soient plus chargés de payer la reconstruction et les grosses réparations de l’église, du presbytère, du vicariat et des maisons du maître et de la maîtresse d’école, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "406a75c7-bb5e-3559-85f3-c3b30c984b1a",
                                        "entry_id": "dbe77a74-fe6e-3ab9-90de-8a13808da873",
                                        "glosses": [
                                            "Territoire sur lequel s’étend le pouvoir du vicaire, soit séculier, soit ecclésiastique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "420b7881-e631-4ee3-a772-c9f4508f6e77",
                                                "sense_id": "406a75c7-bb5e-3559-85f3-c3b30c984b1a",
                                                "text": "Tel prince était vicaire de l’Empire en tel et tel pays, et dans tout son vicariat il avait tels et tels droits. - Le vicariat apostolique du Gabon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0296e5ff-0ed4-3627-ad22-bff7f5a46254",
                                        "entry_id": "dbe77a74-fe6e-3ab9-90de-8a13808da873",
                                        "glosses": [
                                            "Période durant laquelle officie un vicaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfe31783-c05c-4766-80d8-67fc747d51de",
                                                "sense_id": "0296e5ff-0ed4-3627-ad22-bff7f5a46254",
                                                "text": "M. le comte ressemble certainement plus à un paysan comme moi qu’à n’importe quel riche industriel comme il m’est arrivé d’en approcher jadis, au cours de mon vicariat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b58e5791-f652-3a10-b8ac-4a056b410858",
                                        "entry_id": "dbe77a74-fe6e-3ab9-90de-8a13808da873",
                                        "glosses": [
                                            "Vicariat apostolique : pays de mission, sans diocèse, administré par un vicaire apostolique,"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21883bbd-3181-4fe7-ab1c-b62011caa951",
                        "source_entry_id": "aa67c82d-c6b5-3be7-ba11-79c6bbda8e14",
                        "source_sense_description": "residence of vicar",
                        "target_lang_word": "Pfarrhaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pfarrhaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05289029-0a3c-3114-ba30-4da5c9b09121",
                                        "entry_id": "afb3c134-8f29-3df1-b900-343a1bedd5dc",
                                        "glosses": [
                                            "Gebäude, in dem der Pfarrer seine Wohnung und/oder seinen Amtssitz hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f68d67d3-b392-423a-8c99-019e79d48240",
                                                "sense_id": "05289029-0a3c-3114-ba30-4da5c9b09121",
                                                "text": "„Der Hausvater, Pfarrer Hartnik, freut sich von Herzen, daß er endlich ein eigenes Pfarrhaus in Passau leiten kann.“"
                                            },
                                            {
                                                "example_id": "4a36ef86-5794-4ff7-b1b9-fc0811653391",
                                                "sense_id": "05289029-0a3c-3114-ba30-4da5c9b09121",
                                                "text": "„An eben dieser Stelle findet sich denn auch die ganze Herrlichkeit von Dorf Stechlin zusammen; das Pfarrhaus, die Schule, das Schulzenamt, der Krug, dieser letztere zugleich ein Eck- und Kramladen mit einem kleinen Mohren und einer Guirlande von Schwefelfäden in seinem Schaufenster.“"
                                            },
                                            {
                                                "example_id": "93c6a6ff-415a-4916-a944-1865d61420f1",
                                                "sense_id": "05289029-0a3c-3114-ba30-4da5c9b09121",
                                                "text": "„In der Wirklichkeit eines protestantischen Pfarrhauses hörte es sich anders an.“"
                                            },
                                            {
                                                "example_id": "e0d032cf-c55f-4b4a-a3f4-4a58d07f3da0",
                                                "sense_id": "05289029-0a3c-3114-ba30-4da5c9b09121",
                                                "text": "„Der Schöning war schon in Rente, ging aber immer noch täglich zur Kirche und aß dann im Pfarrhaus zu Mittag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04ed6f37-91df-425d-84a7-6a7a4b889167",
                        "source_entry_id": "aa67c82d-c6b5-3be7-ba11-79c6bbda8e14",
