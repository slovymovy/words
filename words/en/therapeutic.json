{
    "word_family": [
        "therapy",
        "therapist",
        "therapeutically"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a80ef300-2b0a-3c7c-bc75-6b4ad902c9b1",
                    "sense_definition": "Of or relating to the treatment of disease or disorders.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor explained the <w>therapeutic</w> benefits of the new medication.",
                            "target_lang_translations": {
                                "ru": "Врач объяснил <w>лечебные</w> свойства нового препарата.",
                                "zh": "医生解释了这种新药的<w>治疗</w>益处。"
                            }
                        },
                        {
                            "text": "They are researching the <w>therapeutic</w> potential of stem cells for tissue repair.",
                            "target_lang_translations": {
                                "ru": "Они исследуют <w>терапевтический</w> потенциал стволовых клеток для восстановления тканей.",
                                "zh": "他们正在研究干细胞在组织修复方面的<w>治疗</w>潜力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "therapeutical"
                    ],
                    "common_phrases": [
                        "therapeutic use",
                        "therapeutic effect",
                        "therapeutic approach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к лечению заболеваний или расстройств.",
                        "zh": "与疾病或失调的治疗有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "терапевтический",
                                "target_lang_sense_clarification": "относящийся к терапии"
                            },
                            {
                                "target_lang_word": "лечебный",
                                "target_lang_sense_clarification": "способствующий излечению"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "治疗性的",
                                "target_lang_sense_clarification": "指与治疗过程或目的相关的"
                            },
                            {
                                "target_lang_word": "疗效",
                                "target_lang_sense_clarification": "指治疗的效果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "955fa67d-2f95-3c0c-8daa-a1f15d04ee2c",
                    "sense_definition": "Having a positive effect on the body or mind; helping to relax or heal.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gardening can be very <w>therapeutic</w> for people suffering from high stress.",
                            "target_lang_translations": {
                                "ru": "Садоводство может быть очень <w>успокаивающим</w> для людей, страдающих от сильного стресса.",
                                "zh": "对于承受巨大压力的人来说，园艺可以非常<w>治愈</w>。"
                            }
                        },
                        {
                            "text": "She finds painting to be a <w>therapeutic</w> activity after a long day at work.",
                            "target_lang_translations": {
                                "ru": "Она находит рисование <w>успокаивающим</w> занятием после долгого рабочего дня.",
                                "zh": "她觉得在漫长的工作一天后，画画是一种<w>舒缓</w>身心的活动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "curative",
                        "remedial"
                    ],
                    "common_phrases": [
                        "therapeutic massage",
                        "find it therapeutic",
                        "therapeutic power"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оказывающий положительное воздействие на тело или разум; помогающий расслабиться.",
                        "zh": "对身心有积极影响；有助于放松或康复的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "успокаивающий",
                                "target_lang_sense_clarification": "помогающий расслабиться"
                            },
                            {
                                "target_lang_word": "целебный",
                                "target_lang_sense_clarification": "благотворно влияющий на здоровье"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "治愈性的",
                                "target_lang_sense_clarification": "指具有缓解压力或促进心理康复作用的"
                            },
                            {
                                "target_lang_word": "舒缓的",
                                "target_lang_sense_clarification": "指能让人放松、减轻压力的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b7c36d92-c312-34d7-83b0-d45e049fd99b",
                    "sense_definition": "A medication or treatment used to cure or treat a disease.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists are testing a new <w>therapeutic</w> for the virus in clinical trials.",
                            "target_lang_translations": {
                                "ru": "Ученые испытывают новый <w>препарат</w> против вируса в клинических испытаниях.",
                                "zh": "科学家们正在临床试验中测试一种针对该病毒的新型<w>治疗药物</w>。"
                            }
                        },
                        {
                            "text": "The company is developing a <w>therapeutic</w> that targets specific cancer cells.",
                            "target_lang_translations": {
                                "ru": "Компания разрабатывает <w>лекарственное средство</w>, нацеленное на определенные раковые клетки.",
                                "zh": "该公司正在开发一种针对特定癌细胞的<w>治疗药物</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "novel therapeutic",
                        "effective therapeutic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лекарство или метод лечения, используемые для исцеления болезни.",
                        "zh": "用于治愈或治疗疾病的药物或疗法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "препарат",
                                "target_lang_sense_clarification": "лекарственное вещество"
                            },
                            {
                                "target_lang_word": "лекарственное средство",
                                "target_lang_sense_clarification": "средство для лечения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "治疗药物",
                                "target_lang_sense_clarification": "指用于治疗疾病的特定药物"
                            },
                            {
                                "target_lang_word": "疗法",
                                "target_lang_sense_clarification": "指治疗疾病的方法"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}