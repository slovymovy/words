{
    "word_family": [
        "store",
        "storable",
        "stowage"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4aaeb86f-91fe-3e40-a900-8d280ea71812",
                    "sense_definition": "The act of keeping items in a safe place for future use, or the state of being kept there.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "general_keeping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We put most of our furniture in <w>storage</w> while we renovated the house.",
                            "target_lang_translations": {
                                "ru": "Мы сдали большую часть мебели на <w>хранение</w> на время ремонта дома.",
                                "zh": "我们在装修房子时，把大部分家具都送去<w>储存</w>了。"
                            }
                        },
                        {
                            "text": "Proper <w>storage</w> of food is essential to prevent it from spoiling.",
                            "target_lang_translations": {
                                "ru": "Правильное <w>хранение</w> продуктов необходимо, чтобы они не испортились.",
                                "zh": "妥善<w>储存</w>食物对于防止其变质至关重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "keeping",
                        "stowage",
                        "warehousing",
                        "preservation"
                    ],
                    "antonyms": [
                        "retrieval",
                        "removal"
                    ],
                    "common_phrases": [
                        "in storage",
                        "cold storage",
                        "long-term storage",
                        "food storage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по хранению вещей в безопасном месте для будущего использования или состояние нахождения там.",
                        "zh": "将物品存放在安全的地方以备将来使用，或处于被存放的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хранение",
                                "target_lang_sense_clarification": "процесс сбережения вещей"
                            },
                            {
                                "target_lang_word": "сохранение",
                                "target_lang_sense_clarification": "сбережение в целости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "储存",
                                "target_lang_sense_clarification": "指物品的存放过程"
                            },
                            {
                                "target_lang_word": "保管",
                                "target_lang_sense_clarification": "指对物品的看管和存放"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4d751ed-6998-3e5f-b40b-09490f75d448",
                    "sense_definition": "A space, area, or container available for keeping things.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "general_keeping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new apartment has plenty of <w>storage</w> for all my clothes and books.",
                            "target_lang_translations": {
                                "ru": "В новой квартире много <w>места для хранения</w> всей моей одежды и книг.",
                                "zh": "这间新公寓有充足的<w>储物空间</w>来放我所有的衣服和书。"
                            }
                        },
                        {
                            "text": "They rented a small <w>storage</w> unit to hold their extra belongings.",
                            "target_lang_translations": {
                                "ru": "Они арендовали небольшой <w>склад</w> (ячейку), чтобы хранить лишние вещи.",
                                "zh": "他们租了一个小型<w>仓库</w>来存放多余的物品。"
                            }
                        }
                    ],
                    "synonyms": [
                        "repository",
                        "depot",
                        "storehouse",
                        "space",
                        "room"
                    ],
                    "common_phrases": [
                        "storage space",
                        "storage room",
                        "storage facility",
                        "storage unit",
                        "water storage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пространство, помещение или контейнер, доступные для хранения вещей.",
                        "zh": "可用于存放物品的空间、区域或容器。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "склад",
                                "target_lang_sense_clarification": "помещение"
                            },
                            {
                                "target_lang_word": "хранилище",
                                "target_lang_sense_clarification": "специальное место для хранения"
                            },
                            {
                                "target_lang_word": "кладовая",
                                "target_lang_sense_clarification": "комната или шкаф в доме"
                            },
                            {
                                "target_lang_word": "место для хранения",
                                "target_lang_sense_clarification": "пространство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "储物空间",
                                "target_lang_sense_clarification": "指存放物品的地方"
                            },
                            {
                                "target_lang_word": "仓库",
                                "target_lang_sense_clarification": "指存放货物的场所"
                            },
                            {
                                "target_lang_word": "储藏室",
                                "target_lang_sense_clarification": "指家中的存放房间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b7128a4-d535-391e-8d70-855c072871da",
                    "sense_definition": "Electronic space or a device on a computer where data is saved and kept.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My phone is running out of <w>storage</w> because I have too many photos.",
                            "target_lang_translations": {
                                "ru": "В моем телефоне заканчивается <w>память</w>, потому что у меня слишком много фотографий.",
                                "zh": "我的手机因为照片太多，<w>存储空间</w>快用完了。"
                            }
                        },
                        {
                            "text": "You should back up your important files to cloud <w>storage</w> regularly.",
                            "target_lang_translations": {
                                "ru": "Тебе следует регулярно сохранять важные файлы в облачное <w>хранилище</w>.",
                                "zh": "你应该定期将重要文件备份到云<w>存储</w>中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "memory",
                        "disk space"
                    ],
                    "common_phrases": [
                        "cloud storage",
                        "data storage",
                        "internal storage",
                        "mass storage",
                        "storage capacity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Электронное пространство или устройство на компьютере, где сохраняются и хранятся данные.",
                        "zh": "计算机上用于保存和存放数据的电子空间或设备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "память",
                                "target_lang_sense_clarification": "объем данных на устройстве"
                            },
                            {
                                "target_lang_word": "хранилище",
                                "target_lang_sense_clarification": "облачное или файловое"
                            },
                            {
                                "target_lang_word": "накопитель",
                                "target_lang_sense_clarification": "устройство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "存储空间",
                                "target_lang_sense_clarification": "指设备上的容量"
                            },
                            {
                                "target_lang_word": "存储器",
                                "target_lang_sense_clarification": "指硬件设备"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14396ffb-78a9-3444-b654-183870cbad34",
                    "sense_definition": "The cost or fee charged for keeping goods in a facility.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "financial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monthly <w>storage</w> for the boat is more expensive than we expected.",
                            "target_lang_translations": {
                                "ru": "Ежемесячная <w>плата за хранение</w> лодки оказалась дороже, чем мы ожидали.",
                                "zh": "这艘船每月的<w>仓储费</w>比我们预期的要贵。"
                            }
                        },
                        {
                            "text": "Please calculate the total <w>storage</w> and shipping costs for this order.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, рассчитайте общую стоимость <w>хранения</w> и доставки для этого заказа.",
                                "zh": "请计算这笔订单的总<w>仓储费</w>和运费。"
                            }
                        }
                    ],
                    "synonyms": [
                        "storage fee",
                        "storage charge"
                    ],
                    "common_phrases": [
                        "pay for storage",
                        "storage costs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стоимость или плата, взимаемая за содержание товаров на складе.",
                        "zh": "在设施中存放货物所收取的费用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плата за хранение",
                                "target_lang_sense_clarification": "денежный сбор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "仓储费",
                                "target_lang_sense_clarification": "指存放货物的费用"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d062d5cb-ae8d-38f0-a9dd-5beafd042fbe",
                    "sense_definition": "To place items into a facility or container for safekeeping.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company <w>storaged</w> the excess inventory in a warehouse near the port.",
                            "target_lang_translations": {
                                "ru": "Компания <w>заскладировала</w> излишки инвентаря на складе возле порта.",
                                "zh": "公司将多余的库存<w>储存</w>在港口附近的一个仓库里。"
                            }
                        },
                        {
                            "text": "We have <w>storaged</w> the equipment until the next season begins.",
                            "target_lang_translations": {
                                "ru": "Мы <w>поместили на хранение</w> оборудование до начала следующего сезона.",
                                "zh": "我们已经将设备<w>入库</w>，直到下一季开始。"
                            }
                        }
                    ],
                    "synonyms": [
                        "store",
                        "stow",
                        "warehouse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помещать предметы в помещение или контейнер для сохранности.",
                        "zh": "将物品放入设施或容器中以妥善保管。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "складировать",
                                "target_lang_sense_clarification": "помещать на склад"
                            },
                            {
                                "target_lang_word": "хранить",
                                "target_lang_sense_clarification": "держать на хранении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "储存",
                                "target_lang_sense_clarification": "指存放物品的动作"
                            },
                            {
                                "target_lang_word": "入库",
                                "target_lang_sense_clarification": "指放入仓库"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}