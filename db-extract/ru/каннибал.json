                        "target_lang_word": "Kannibale",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kannibale",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9207fd6-8d86-3528-a1ea-cc572a340abc",
                                        "entry_id": "94d776d8-7a6f-352c-a8f3-bf5323a3a036",
                                        "glosses": [
                                            "Mensch, der Menschenfleisch verzehrt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2dff422-f895-4e43-b148-a32191f33853",
                                                "sense_id": "e9207fd6-8d86-3528-a1ea-cc572a340abc",
                                                "text": "In Hessen gab es vor nicht langer Zeit einen Prozess gegen einen Kannibalen."
                                            },
                                            {
                                                "example_id": "a3a02b4e-1a13-4a82-9c0b-e9a51bc6505e",
                                                "sense_id": "e9207fd6-8d86-3528-a1ea-cc572a340abc",
                                                "text": "„Sie behaupteten, dass einige der Afrikaner auf dem Sklavendeck ihrer Schiffe wahrscheinlich selber Kannibalen seien.“"
                                            },
                                            {
                                                "example_id": "0cab42b1-e584-4dfe-a4a4-d57a9cad70e0",
                                                "sense_id": "e9207fd6-8d86-3528-a1ea-cc572a340abc",
                                                "text": "„Heute rätseln Historiker, ob damalige Küstenbewohner wirklich Kannibalen waren.“"
                                            },
                                            {
                                                "example_id": "a72807be-46f2-4a71-ab25-e91b985e8120",
                                                "sense_id": "e9207fd6-8d86-3528-a1ea-cc572a340abc",
                                                "text": "„In einer Firma wurden vier einheimische Mitarbeiter gegen vier billigere Arbeitskräfte aus dem Ausland eingetauscht, aber niemand wusste, dass es sich bei ihnen um Kannibalen handelte.“"
                                            },
                                            {
                                                "example_id": "ab287c6b-bbab-4058-b44d-c58d826b52eb",
                                                "sense_id": "e9207fd6-8d86-3528-a1ea-cc572a340abc",
                                                "text": "„Ein Kannibale fliegt mit der Lufthansamaschine erster Klasse von Afrika nach Deutschland.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
