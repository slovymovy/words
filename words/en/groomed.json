    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d1b98273-2309-3c3f-98d1-10cd39639bb1",
                    "sense_definition": "Simple past and past participle of <w>groom</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She carefully <w>groomed</w> her horse every morning before going for a ride.",
                            "target_lang_translations": {
                                "ru": "Она тщательно <w>чистила</w> свою лошадь каждое утро перед выездом на прогулку."
                            }
                        },
                        {
                            "text": "The senior executives <w>groomed</w> him for years to take over as chief executive.",
                            "target_lang_translations": {
                                "ru": "Высшее руководство годами <w>готовило</w> его к должности генерального директора."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола groom (чистить, ухаживать за животным; готовить преемника)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чистил",
                                "target_lang_sense_clarification": "животное, например лошадь"
                            },
                            {
                                "target_lang_word": "ухаживал",
                                "target_lang_sense_clarification": "за внешним видом или шерстью"
                            },
                            {
                                "target_lang_word": "готовил",
                                "target_lang_sense_clarification": "к должности, роли"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bed40fff-f938-3037-83ec-44742dedf9d1",
                    "sense_definition": "Having a neat, clean, and tidy appearance; well cared for.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He always arrived at the office looking perfectly <w>groomed</w> and professional.",
                            "target_lang_translations": {
                                "ru": "Он всегда приходил в офис безупречно <w>ухоженным</w> и выглядел профессионально."
                            }
                        },
                        {
                            "text": "The hotel grounds featured manicured flowerbeds and well <w>groomed</w> lawns.",
                            "target_lang_translations": {
                                "ru": "На территории отеля были безупречные клумбы и хорошо <w>ухоженные</w> газоны."
                            }
                        }
                    ],
                    "synonyms": [
                        "neat",
                        "spruce",
                        "tidy"
                    ],
                    "antonyms": [
                        "disheveled",
                        "messy",
                        "unkempt",
                        "untidy"
                    ],
                    "common_phrases": [
                        "well groomed",
                        "carefully groomed",
                        "immaculately groomed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий опрятный, чистый и аккуратный вид; ухоженный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ухоженный",
                                "target_lang_sense_clarification": "о человеке или территории"
                            },
                            {
                                "target_lang_word": "опрятный",
                                "target_lang_sense_clarification": "аккуратный внешний вид"
                            },
                            {
                                "target_lang_word": "причёсанный",
                                "target_lang_sense_clarification": "аккуратно уложенный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
