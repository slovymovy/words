                "senses": [
                    {
                        "sense_id": "2ffc8a04-1083-3ef1-ad5c-996b01c547c7",
                        "entry_id": "7033abde-f0ad-327e-b8f2-3de29265134b",
                        "glosses": [
                            "Haustyp, der ein Blockhaus und ein Fachwerkhaus kombiniert oder zwei Blockhäuser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db234a7a-0de4-46c6-ba3c-635177eb43ee",
                                "sense_id": "2ffc8a04-1083-3ef1-ad5c-996b01c547c7",
                                "text": "„Das Umgebindehaus besteht aus einem Ständergerüst (Außenständer), das den Oberstock und das Dach trägt.“"
                            },
                            {
                                "example_id": "ddf3061b-cb16-43dd-8e28-6fb6712dd0c9",
                                "sense_id": "2ffc8a04-1083-3ef1-ad5c-996b01c547c7",
                                "text": "Zusammenhängende Bestände an Umgebindehäusern findet man noch heute in vielen Orten der Oberlausitz (z. B. Obercunnersdorf) und Nordböhmens."
                            },
                            {
                                "example_id": "227afabb-150a-431d-9aa1-b0dc5f7a4c45",
                                "sense_id": "2ffc8a04-1083-3ef1-ad5c-996b01c547c7",
                                "text": "Der Typ des Umgebindehauses findet man vor allem in einem Gebiet von Schlesien über die Oberlausitz und Nordböhmen bis in die Sächsische Schweiz."
                            },
                            {
                                "example_id": "c52033e4-c5dd-4462-9d06-19e9cfc4b2e0",
                                "sense_id": "2ffc8a04-1083-3ef1-ad5c-996b01c547c7",
                                "text": "„Offenbar gehörte bei vielen Umgebindehäusern dieser Gegend das Umgebinde zu einer Bautradition, die sich mit der Zeit verselbständigt hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
