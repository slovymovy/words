                    "sense_id": "e687174a-bfa6-30e9-8226-47b9439a9a99",
                    "sense_definition": "bedekt met een dun laagje goud",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bedekking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De antieke spiegel heeft een prachtig <w>vergulde</w> lijst die glinstert in het zonlicht.",
                            "target_lang_translations": {
                                "en": "The antique mirror has a beautifully <w>gilded</w> frame that glitters in the sunlight."
                            }
                        },
                        {
                            "text": "Zij droeg een <w>vergulde</w> broche op haar jurk tijdens het chique diner.",
                            "target_lang_translations": {
                                "en": "She wore a <w>gold-plated</w> brooch on her dress during the fancy dinner."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vergulde lijst",
                        "vergulde broche"
                    ],
                    "target_lang_definitions": {
