                "senses": [
                    {
                        "sense_id": "1ff31d7d-430c-3366-953f-e5972d8e4100",
                        "entry_id": "8839da70-9df1-31ab-82ec-1f19404db223",
                        "glosses": [
                            "Teilgebiet der Physik, welches sich mit Experimenten befasst"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "8d7c4f8e-477d-4384-8c79-1930d0ad5d91",
                                "sense_id": "1ff31d7d-430c-3366-953f-e5972d8e4100",
                                "text": "„Ich verbrachte die Fastenzeit glücklich und zufrieden mit meinen beiden Engeln, im Freundeskreis von Signor Malipiero und über dem Studium der Experimentalphysik im Kloster S. Maria della Salute.“"
                            },
                            {
                                "example_id": "38b60ed4-9ebb-43bb-9360-ec9e2a69a073",
                                "sense_id": "1ff31d7d-430c-3366-953f-e5972d8e4100",
                                "text": "„In Anbetracht der Eindeutigkeit, mit der Einsteins Aussagen der Erfahrung eine zentrale Bedeutung zusprechen, muß die Frage interessieren, warum er seine Arbeiten nicht auf die Experimentalphysik, sondern auf die theoretische Physik ausrichtete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
