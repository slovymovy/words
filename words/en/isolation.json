{
    "word_family": [
        "isolate",
        "isolated",
        "isolating",
        "isolationism",
        "isolationist",
        "isolator"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5a311704-691d-31d2-9b69-94d152943c48",
                    "sense_definition": "The state of being detached or separated from others, often resulting in being alone.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "social_separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She lived her final year in complete <w>isolation</w>, not wanting to see anybody.",
                            "target_lang_translations": {
                                "ru": "Последний год своей жизни она прожила в полной <w>изоляции</w>, не желая никого видеть."
                            }
                        },
                        {
                            "text": "Many people experienced a deep sense of <w>social</w> <w>isolation</w> during the long winter months.",
                            "target_lang_translations": {
                                "ru": "Многие люди испытывали глубокое чувство социальной <w>изоляции</w> в долгие зимние месяцы."
                            }
                        }
                    ],
                    "synonyms": [
                        "aloneness",
                        "seclusion",
                        "solitude",
                        "solitariness"
                    ],
                    "antonyms": [
                        "companionship",
                        "inclusion",
                        "connection"
                    ],
                    "common_phrases": [
                        "social isolation",
                        "complete isolation",
                        "splendid isolation",
                        "feelings of isolation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние отчужденности или отделенности от других, часто приводящее к одиночеству."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изоляция",
                                "target_lang_sense_clarification": "состояние отделенности от общества"
                            },
                            {
                                "target_lang_word": "уединение",
                                "target_lang_sense_clarification": "добровольное одиночество"
                            },
                            {
                                "target_lang_word": "затворничество",
                                "target_lang_sense_clarification": "образ жизни в полной изоляции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87a1e08a-462e-3dbd-8fea-57d2ba5dc08d",
                    "sense_definition": "The separation of a person with a contagious disease from others to prevent the spread of infection.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical_separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Upon returning from the field, he went into <w>isolation</w> for a week so as not to infect anyone.",
                            "target_lang_translations": {
                                "ru": "Вернувшись из экспедиции, он ушел на <w>изоляцию</w> на неделю, чтобы никого не заразить."
                            }
                        },
                        {
                            "text": "The hospital placed the patient in an <w>isolation</w> <w>ward</w> to protect the other staff and visitors.",
                            "target_lang_translations": {
                                "ru": "Больница поместила пациента в <w>изолятор</w>, чтобы защитить остальной персонал и посетителей."
                            }
                        }
                    ],
                    "synonyms": [
                        "seclusion"
                    ],
                    "common_phrases": [
                        "isolation ward",
                        "self isolation",
                        "protective isolation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отделение человека с заразным заболеванием от других для предотвращения распространения инфекции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изоляция",
                                "target_lang_sense_clarification": "медицинская мера"
                            },
                            {
                                "target_lang_word": "карантин",
                                "target_lang_sense_clarification": "ограничительные меры для больных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e561377e-e28f-3986-bfcf-0c5ca0b6af5b",
                    "sense_definition": "The state of a country not having diplomatic or trade relations with other nations.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "political_separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government's controversial policies led to increasing <w>diplomatic</w> <w>isolation</w> from its neighbors.",
                            "target_lang_translations": {
                                "ru": "Противоречивая политика правительства привела к растущей дипломатической <w>изоляции</w> от соседей."
                            }
                        },
                        {
                            "text": "International sanctions were designed to ensure the <w>isolation</w> of the regime from global markets.",
                            "target_lang_translations": {
                                "ru": "Международные санкции были направлены на то, чтобы обеспечить <w>изоляцию</w> режима от мировых рынков."
                            }
                        }
                    ],
                    "common_phrases": [
                        "diplomatic isolation",
                        "international isolation",
                        "political isolation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in political or academic contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние страны, не имеющей дипломатических или торговых отношений с другими государствами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изоляция",
                                "target_lang_sense_clarification": "политическая или дипломатическая"
                            },
                            {
                                "target_lang_word": "обособление",
                                "target_lang_sense_clarification": "отделение от других стран"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0812b7e1-f4a4-38b7-bc6b-5a405858f016",
                    "sense_definition": "The process of obtaining a specific substance or element in a pure form from a mixture or compound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "scientific_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>isolation</w> of the specific protein required several complex laboratory steps.",
                            "target_lang_translations": {
                                "ru": "<w>Выделение</w> специфического белка потребовало нескольких сложных лабораторных этапов."
                            }
                        },
                        {
                            "text": "Scientists celebrated the successful <w>isolation</w> of the new chemical element.",
                            "target_lang_translations": {
                                "ru": "Ученые праздновали успешное <w>выделение</w> нового химического элемента."
                            }
                        }
                    ],
                    "common_phrases": [
                        "isolation of compounds",
                        "chemical isolation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical or scientific usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс получения определенного вещества или элемента в чистом виде из смеси или соединения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выделение",
                                "target_lang_sense_clarification": "получение чистого вещества"
                            },
                            {
                                "target_lang_word": "изолирование",
                                "target_lang_sense_clarification": "процесс отделения компонента"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69968765-fd49-32d1-9be2-8c0def42e066",
                    "sense_definition": "A database property ensuring that concurrent transactions do not interfere with each other.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>isolation</w> level of the database determines how data is locked during a transaction.",
                            "target_lang_translations": {
                                "ru": "Уровень <w>изоляции</w> базы данных определяет, как блокируются данные во время транзакции."
                            }
                        },
                        {
                            "text": "Without proper <w>isolation</w>, two users might try to update the same record simultaneously.",
                            "target_lang_translations": {
                                "ru": "Без надлежащей <w>изоляции</w> два пользователя могут попытаться обновить одну и ту же запись одновременно."
                            }
                        }
                    ],
                    "common_phrases": [
                        "isolation level",
                        "transaction isolation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical computing term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство базы данных, гарантирующее, что параллельные транзакции не мешают друг другу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изоляция",
                                "target_lang_sense_clarification": "уровень изолированности транзакций"
                            },
                            {
                                "target_lang_word": "изолированность",
                                "target_lang_sense_clarification": "свойство ACID в СУБД"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}