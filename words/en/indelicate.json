                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Asking about her personal finances in front of everyone was considered an <w>indelicate</w> question."
                        },
                        {
                            "text": "He apologized for his <w>indelicate</w> phrasing during the heated discussion."
                        }
                    ],
                    "synonyms": [
