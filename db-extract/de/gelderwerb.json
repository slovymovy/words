                        "examples": [
                            {
                                "example_id": "5ff27b63-0ab1-4b2a-bcb9-ff448451c0d8",
                                "sense_id": "ae1f3805-9a4e-392b-bd04-02393386ef76",
                                "text": "„Sie diente dem Arzt Hartmann Schedel ja nicht zum Gelderwerb, sondern war Ausdruck seiner historischen und literarischen Bildung.“"
                            },
                            {
                                "example_id": "b8a1a483-5c48-4edc-b923-c4c74ad4e16e",
                                "sense_id": "ae1f3805-9a4e-392b-bd04-02393386ef76",
                                "text": "„Doch Betteln war in jenen Tagen ein beliebter Gelderwerb, und die Konkurrenz war erbittert.“"
                            }
                        ],
