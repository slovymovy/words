                ],
                "senses": [
                    {
                        "sense_id": "b661e950-4fd9-369f-8c39-333331c18a48",
                        "entry_id": "174bb14a-621c-37ed-8391-dd3de5899f67",
                        "glosses": [
                            "kleiner Brocken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a262d7f5-6f85-49c8-aec1-3b1d38154858",
                                "sense_id": "b661e950-4fd9-369f-8c39-333331c18a48",
                                "text": "Hunderte an kleinen Bröckchen aus Stein lagen im Gras."
                            },
                            {
                                "example_id": "d0f977cb-6393-448f-b646-9369429bc04f",
                                "sense_id": "b661e950-4fd9-369f-8c39-333331c18a48",
                                "text": "„Ich führte das Bröckchen zum Mund und biss vorsichtig darauf.“"
                            },
                            {
                                "example_id": "108fb8fe-4e71-439e-96b6-367a3d0c9c4d",
                                "sense_id": "b661e950-4fd9-369f-8c39-333331c18a48",
                                "text": "„Weil Sie je Trainingseinheit eine ganze Reihe von Wiederholungen benötigen, sollten die Bröckchen nicht zu groß sein, andererseits zum Werfen jedoch genügend schwer und „im Flug“ für den Hund gut sichtbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
