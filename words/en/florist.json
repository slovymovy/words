            "senses": [
                {
                    "sense_id": "154e96b6-eb91-32d7-b9b4-58ef95a5f5e7",
                    "sense_definition": "A person who sells and often arranges flowers and ornamental plants.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "flower_professionals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I asked the <w>florist</w> to create a beautiful bouquet for my mother's birthday.",
                            "target_lang_translations": {
                                "ru": "Я попросил <w>флориста</w> составить красивый букет на день рождения моей мамы.",
                                "zh": "我请<w>花艺师</w>为我母亲的生日制作了一束漂亮的花。"
                            }
                        },
                        {
                            "text": "The local <w>florist</w> shop is always busy on Valentine's Day.",
                            "target_lang_translations": {
                                "ru": "Местный <w>цветочный магазин</w> всегда переполнен в День святого Валентина.",
                                "zh": "情人节那天，当地的<w>花艺师</w>总是非常忙碌。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flower seller"
                    ],
                    "common_phrases": [
                        "local florist",
                        "wedding florist",
                        "expert florist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который продает и часто составляет цветочные композиции и декоративные растения.",
                        "zh": "从事鲜花销售及花艺设计的人。"
                    },
                    "translations": {
                        "ru": [
                            {
