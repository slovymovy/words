                        "glosses": [
                            "Full of lamentation."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "42ab11db-9705-497e-abad-6d6414feccda",
                                "sense_id": "cc8ccf22-a9c5-366c-92f9-0b32d4649e20",
                                "text": "Mark, O, ye beauties l—gay, and young, Mark the plainful woes, and weeping, That, from forc'd concealment sprung, Punish the sin of secret keeping."
                            },
                            {
                                "example_id": "becbcb8f-6f68-43d2-aa10-4c0d3142cb0e",
                                "sense_id": "cc8ccf22-a9c5-366c-92f9-0b32d4649e20",
                                "text": "Beset with plainful gusts, within ye hear No sound so loud as when on curtain'd bier The death-watch tick is stilled."
                            }
                        ]
                    },
                    {
                        "sense_id": "197402ec-a805-343c-b142-7d77f5f53f07",
                        "entry_id": "e6aa880f-cc43-3330-a765-0ba41bb6583c",
                        "glosses": [
                            "Plain; obvious."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a69a570-559b-4f08-ab4d-4ebd4f9d3cc9",
                                "sense_id": "197402ec-a805-343c-b142-7d77f5f53f07",
                                "text": "So plainful clear to me, it followed as the night the day."
                            }
                        ]
                    }
