                "senses": [
                    {
                        "sense_id": "a4aa15e5-26a6-37e8-9582-b7936caf0e6f",
                        "entry_id": "45a7f3ce-24f3-3b60-8952-085343f2d615",
                        "glosses": [
                            "ein Unternehmen (Firma), die auf die Planung und Durchführung eines Abbruchs eines Gebäudes spezialisiert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0481fa7d-43f7-40a4-82a2-dfd383a851e0",
                                "sense_id": "a4aa15e5-26a6-37e8-9582-b7936caf0e6f",
                                "text": "„FOCUS-Recherchen ergaben, daß die Hafenrand GmbH, Eigentümerin der Häuserblöcke, insgesamt mehr als drei Millionen Mark an eine norddeutsche Abbruchfirma zahlte.“"
                            },
                            {
                                "example_id": "c6d73e8e-0834-46cf-ab66-be77f445a059",
                                "sense_id": "a4aa15e5-26a6-37e8-9582-b7936caf0e6f",
                                "text": "„Als Ein-Mann-Unternehmen betreibt er eine Bau- und Abbruchfirma, sie einen Service für Reinigung und Entrümpelung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
