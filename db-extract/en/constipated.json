                    {
                        "translation_id": "83551353-c2bb-4a43-afa5-ef114647aabd",
                        "source_entry_id": "ced3a56c-b4d3-31a6-b934-d1bf207a3e5c",
                        "source_sense_description": "unable to defecate",
                        "target_lang_word": "verstopft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verstopft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c9aec77-f076-3810-8572-340971c7dd12",
                                        "entry_id": "8855f1b1-355c-3078-b125-8668593348da",
                                        "glosses": [
                                            "den Durchfluss von etwas behindernd (beispielsweise Abwasser, Blut, Luft)"
                                        ],
                                        "tags": [
                                            "Flüssigkeit",
                                            "Gas"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80d1fa50-1511-400b-b937-6e6d8da38f6e",
                                                "sense_id": "3c9aec77-f076-3810-8572-340971c7dd12",
                                                "text": "Der Innenraumluftfilter war so verstopft, dass kaum noch Luft hindurchkam."
                                            },
                                            {
                                                "example_id": "503603e1-8214-484d-83ac-f6cbb71605c6",
                                                "sense_id": "3c9aec77-f076-3810-8572-340971c7dd12",
                                                "text": "Wir mussten wegen des verstopften Klos den Klempner kommen lassen."
                                            },
                                            {
                                                "example_id": "d4456e52-fe16-4f9f-a3d9-6f3adc98fa26",
                                                "sense_id": "3c9aec77-f076-3810-8572-340971c7dd12",
                                                "text": "Ein an Regenwürmern verarmter Boden reagiert hingegen auf Regen wie ein verstopftes Sieb: Es kommt nicht mehr viel durch."
                                            },
                                            {
                                                "example_id": "97f173e7-a65d-4048-a373-a02983bb7154",
                                                "sense_id": "3c9aec77-f076-3810-8572-340971c7dd12",
                                                "text": "„Teilweise wird dann verfrüht wieder ein Laxans genommen, in der irrigen Annahme, der Darm sei schon wieder verstopft.“"
                                            },
                                            {
                                                "example_id": "d95bfb14-16e9-44dd-b736-2de6c768a18e",
                                                "sense_id": "3c9aec77-f076-3810-8572-340971c7dd12",
                                                "text": "Raucher sind 10 Mal häufiger von Krankheiten durch verstopfte Arterien betroffen als Nichtraucher. […] Sind [die Gefäße des Herzens -die Herzkranzgefäße] verstopft, kommt es mit hoher Wahrscheinlichkeit zu einem Herzinfarkt."
                                            },
                                            {
                                                "example_id": "e71e8d6b-59e8-480d-a92c-9a0a76694092",
                                                "sense_id": "3c9aec77-f076-3810-8572-340971c7dd12",
                                                "text": "„Histamin verursacht die typischen Heuschnupfensymptome wie tränende Augen und verstopfte Nase, aber auch Jucken der Haut.“"
                                            },
                                            {
                                                "example_id": "2568a2af-a940-4704-9257-cd18eab2d3d7",
                                                "sense_id": "3c9aec77-f076-3810-8572-340971c7dd12",
                                                "text": "Mitesser sind verstopfte Hautporen, die schnell zum dicken Pickel werden können."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c4ca394c-d315-3980-b465-381685bfab2f",
                                        "entry_id": "8855f1b1-355c-3078-b125-8668593348da",
                                        "glosses": [
                                            "unfähig, sich zu bewegen; Zustand des Staus auf Straßen, wenn zu viele Fahrzeuge gleichzeitig fahren wollen"
                                        ],
                                        "tags": [
                                            "Verkehr"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15a06aac-1ffe-4eaf-814f-47d897bdaa28",
                                                "sense_id": "c4ca394c-d315-3980-b465-381685bfab2f",
                                                "text": "„Die Victoria Road gilt als eine der am meisten verstopften Straßen in Sydney.“"
                                            },
                                            {
                                                "example_id": "7aa8a8d5-ff18-4684-ac13-33cefa098b88",
                                                "sense_id": "c4ca394c-d315-3980-b465-381685bfab2f",
                                                "text": "Vor allem in den wärmeren Monaten bringen verstopfte Wege, überfüllte Boote und gigantische Müllmengen Venedig an seine Belastungsgrenze."
                                            },
                                            {
                                                "example_id": "b739c03e-43b8-4245-8cb1-19d869bf7752",
                                                "sense_id": "c4ca394c-d315-3980-b465-381685bfab2f",
                                                "text": "Hotelbus und Taxi hängen oft längere Zeit in den Staus der chronisch verstopften Innenstadt [von Amsterdam] fest."
                                            },
                                            {
                                                "example_id": "3a910889-2276-47c3-abf9-615cdda579ff",
                                                "sense_id": "c4ca394c-d315-3980-b465-381685bfab2f",
                                                "text": "Bangkok ist eine Stadt der Gegensätze: Man findet hier goldverzierte Paläste, Tempel und Buddhastatuen, aber auch moderne Wolkenkratzer, traditionelle Märkte und riesige Shoppingmalls, verstopfte Straßen, Skytrains und grüne Oasen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "verstopft",
                                "target_lang_code": "de",
                                "target_senses": [
