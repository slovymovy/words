                        "form": "unsoundest"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d757be64-383f-3632-8b43-e4e6094624c4",
                        "entry_id": "a3b97acd-c8f7-3ec3-8039-9e4cd92f3bb4",
                        "glosses": [
                            "Not sound",
                            "Not whole, not solid, defective."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53c5cf64-3791-44bf-81f8-13f639a3bd45",
                                "sense_id": "d757be64-383f-3632-8b43-e4e6094624c4",
                                "text": "unsound mind"
                            },
                            {
                                "example_id": "f863c824-6924-49b4-bb7a-f8934f6de2ac",
                                "sense_id": "d757be64-383f-3632-8b43-e4e6094624c4",
                                "text": "In the ensuing financial panic, many persons sustained heavy losses, and large numbers of unsound schemes succumbed."
                            },
                            {
                                "example_id": "bf545239-6922-445e-b263-4dc98699dd52",
                                "sense_id": "d757be64-383f-3632-8b43-e4e6094624c4",
                                "text": "A striking example comes to mind, in which a scheme to improve the existing buildings finished up as virtually a complete reconstruction, owing to the unsound condition of the original structure!"
                            },
                            {
                                "example_id": "55a53b5d-7b85-4808-bd1b-13d510f91af2",
                                "sense_id": "d757be64-383f-3632-8b43-e4e6094624c4",
                                "text": "While he is reasonably effusive about inter-city travel, he is heavily disparaging of all types of stopping service, including those on otherwise busy main lines. His analysis is not entirely unsound, and he tackles some of the questions head on."
                            }
                        ]
                    },
                    {
                        "sense_id": "88918e5f-3e52-3235-9d7c-db873a34a0c5",
                        "entry_id": "a3b97acd-c8f7-3ec3-8039-9e4cd92f3bb4",
                        "glosses": [
                            "Not sound",
                            "Infirm, diseased."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "9cf0272f-3a04-423c-bd9e-88ca431867cf",
                                "sense_id": "88918e5f-3e52-3235-9d7c-db873a34a0c5",
                                "text": "... A horse labouring under a temporary injury, capable of being speedily cured, is not unsound within the meaning of a warranty of soundness ..."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5484cb8-fa0f-3aac-867b-da9ac1e11713",
                        "entry_id": "a3b97acd-c8f7-3ec3-8039-9e4cd92f3bb4",
                        "glosses": [
                            "Not sound",
                            "Not good, unreliable."
                        ],
                        "tags": [
                            "UK",
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "2666c03f-854a-4c42-868e-7afbdd1e7043",
                                "sense_id": "a5484cb8-fa0f-3aac-867b-da9ac1e11713",
                                "text": "You would not like Nietzsche, sir. He is fundamentally unsound."
                            }
                        ]
                    }
                ],
