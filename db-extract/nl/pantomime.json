                        "source_entry_id": "f036e120-882a-3dba-8139-70cac8184b2d",
                        "source_sense_id": "effb0ec8-b7df-3ccc-b7b8-ba10b30cbebe",
                        "source_sense_description": "toneelspel alleen maar met gebaren en lichaamsuitdrukkingen dus zonder woorden",
                        "target_lang_word": "pantomime",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
