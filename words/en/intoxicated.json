{
    "word_family": [
        "intoxicate",
        "intoxication",
        "intoxicant"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b69ab8d2-c4c3-3444-ae8f-460b514ba281",
                    "sense_definition": "Stupefied or affected by alcohol; drunk.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intoxication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police stopped the driver because he appeared <w>intoxicated</w>.",
                            "target_lang_translations": {
                                "pl": "Policja zatrzymała kierowcę, ponieważ wyglądał na <w>nietrzeźwego</w>."
                            }
                        },
                        {
                            "text": "He was too <w>intoxicated</w> to remember what happened at the party last night.",
                            "target_lang_translations": {
                                "pl": "Był zbyt <w>pijany</w>, żeby pamiętać, co wydarzyło się wczoraj wieczorem na imprezie."
                            }
                        }
                    ],
                    "synonyms": [
                        "drunk",
                        "inebriated"
                    ],
                    "antonyms": [
                        "sober"
                    ],
                    "common_phrases": [
                        "publicly intoxicated"
                    ],
                    "target_lang_definitions": {
                        "pl": "Będący pod wpływem alkoholu; pijany."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pijany",
                                "target_lang_sense_clarification": "najbardziej powszechne określenie stanu upojenia alkoholowego"
                            },
                            {
                                "target_lang_word": "nietrzeźwy",
                                "target_lang_sense_clarification": "bardziej formalne określenie używane np. w kontekście prawnym lub policyjnym"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1962e38-a64c-3a9a-b362-95463beca738",
                    "sense_definition": "Stupefied or affected by a chemical substance or drug.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intoxication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient arrived at the hospital appearing <w>intoxicated</w> from an unknown substance.",
                            "target_lang_translations": {
                                "pl": "Pacjent przybył do szpitala, wyglądając na <w>odurzonego</w> nieznaną substancją."
                            }
                        },
                        {
                            "text": "Doctors monitored the <w>intoxicated</w> individual until the effects of the drug wore off.",
                            "target_lang_translations": {
                                "pl": "Lekarze monitorowali <w>odurzonego</w> pacjenta, dopóki działanie narkotyku nie ustąpiło."
                            }
                        }
                    ],
                    "synonyms": [
                        "drugged"
                    ],
                    "target_lang_definitions": {
                        "pl": "Będący pod wpływem substancji chemicznych lub narkotyków."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "odurzony",
                                "target_lang_sense_clarification": "stan bycia pod wpływem narkotyków lub innych substancji psychoaktywnych"
                            },
                            {
                                "target_lang_word": "pod wpływem środków odurzających",
                                "target_lang_sense_clarification": "formalne określenie medyczne lub prawne"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "52f4a603-86b9-3c4f-bf74-85362e6a05b7",
                    "sense_definition": "Simple past and past participle of <w>intoxicate</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "intoxication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fumes <w>intoxicated</w> the workers in the small room.",
                            "target_lang_translations": {
                                "pl": "Opary <w>odurzyły</w> pracowników w małym pomieszczeniu."
                            }
                        },
                        {
                            "text": "The strong wine had <w>intoxicated</w> the guests by the end of the dinner.",
                            "target_lang_translations": {
                                "pl": "Mocne wino <w>upoiło</w> gości pod koniec kolacji."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Czas przeszły i imiesłów bierny od czasownika 'odurzyć' lub 'upoić'."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "odurzył / odurzeni",
                                "target_lang_sense_clarification": "w odniesieniu do działania substancji chemicznych lub oparów"
                            },
                            {
                                "target_lang_word": "upoił / upojeni",
                                "target_lang_sense_clarification": "w odniesieniu do działania alkoholu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}