{
    "word_family": [
        "tigress",
        "tigerish",
        "tiger-like"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f4847508-a750-313e-82f6-2d42ba13cb93",
                    "sense_definition": "A large predatory mammal of the cat family, indigenous to Asia, typically having a coat of orange-brown fur with black stripes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "feline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>tiger</w> moved silently through the tall grass while hunting its prey.",
                            "target_lang_translations": {
                                "ru": "<w>Тигр</w> бесшумно пробирался сквозь высокую траву, выслеживая добычу."
                            }
                        },
                        {
                            "text": "We saw a magnificent Bengal <w>tiger</w> during our safari in the national park.",
                            "target_lang_translations": {
                                "ru": "Мы видели великолепного бенгальского <w>тигра</w> во время сафари в национальном парке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Bengal tiger",
                        "Siberian tiger",
                        "wild tiger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупное хищное млекопитающее семейства кошачьих, обитающее в Азии, обычно имеющее рыже-коричневую шерсть с черными полосами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тигр",
                                "target_lang_sense_clarification": "животное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9393d910-bea3-3559-8c05-af37f8a0077c",
                    "sense_definition": "A country or region with a very fast-growing economy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "economy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several nations in Southeast Asia became known as an economic <w>tiger</w> due to their rapid industrialization.",
                            "target_lang_translations": {
                                "ru": "Несколько стран Юго-Восточной Азии стали известны как «экономический <w>тигр</w>» благодаря своей быстрой индустриализации."
                            }
                        },
                        {
                            "text": "The government hopes that new trade policies will turn the country into a regional <w>tiger</w>.",
                            "target_lang_translations": {
                                "ru": "Правительство надеется, что новая торговая политика превратит страну в регионального <w>тигра</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "economic tiger",
                        "Celtic tiger",
                        "Asian tiger"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in economic journalism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Страна или регион с очень быстрорастущей экономикой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тигр",
                                "target_lang_sense_clarification": "об экономике"
                            },
                            {
                                "target_lang_word": "экономический тигр",
                                "target_lang_sense_clarification": "устойчивое выражение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5aad5c8f-1199-3ccd-a4d6-a8554d40c06a",
                    "sense_definition": "A person who is very fierce, determined, or aggressive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a <w>tiger</w> in the boardroom and never backs down from a difficult negotiation.",
                            "target_lang_translations": {
                                "ru": "В зале заседаний она ведет себя как <w>тигр</w> и никогда не отступает в сложных переговорах."
                            }
                        },
                        {
                            "text": "The coach praised him for being a <w>tiger</w> on the field during the championship game.",
                            "target_lang_translations": {
                                "ru": "Тренер похвалил его за то, что он был настоящим <w>тигром</w> на поле во время чемпионата."
                            }
                        }
                    ],
                    "common_phrases": [
                        "real tiger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который ведет себя очень яростно, решительно или агрессивно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тигр",
                                "target_lang_sense_clarification": "о человеке"
                            },
                            {
                                "target_lang_word": "зверь",
                                "target_lang_sense_clarification": "переносное значение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68189ae9-9c76-3907-8bad-b7fc96b942cb",
                    "sense_definition": "A person who is very energetic or athletic during sexual intercourse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a reputation for being a <w>tiger</w> in the sack.",
                            "target_lang_translations": {
                                "ru": "У него репутация настоящего <w>тигра</w> в постели."
                            }
                        },
                        {
                            "text": "She joked with her friends about her partner being a <w>tiger</w> in bed.",
                            "target_lang_translations": {
                                "ru": "Она шутила с подругами о том, что ее партнер — <w>тигр</w> в постели."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tiger in the sack",
                        "tiger in bed"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal and sexual context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, проявляющий большую энергию или атлетизм во время полового акта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тигр",
                                "target_lang_sense_clarification": "в постели"
                            },
                            {
                                "target_lang_word": "неутомимый любовник",
                                "target_lang_sense_clarification": "описание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68dd2ba4-1790-3710-8464-2f0050dce135",
                    "sense_definition": "Any of various animals that resemble the true tiger, such as the extinct sabre-toothed cat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "feline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sabre-toothed <w>tiger</w> is one of the most famous prehistoric predators.",
                            "target_lang_translations": {
                                "ru": "Саблезубый <w>тигр</w> — один из самых известных доисторических хищников."
                            }
                        },
                        {
                            "text": "Paleontologists study the fossils of the sabre-toothed <w>tiger</w> to understand ancient ecosystems.",
                            "target_lang_translations": {
                                "ru": "Палеонтологи изучают окаменелости саблезубого <w>тигра</w>, чтобы понять древние экосистемы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sabre-toothed tiger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое из различных животных, напоминающих настоящего тигра, например, вымершая саблезубая кошка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тигр",
                                "target_lang_sense_clarification": "в названиях видов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f39fadf7-e967-35b1-8f9f-893342ef2fde",
                    "sense_definition": "A Tasmanian tiger; a large carnivorous marsupial, now believed to be extinct.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "marsupial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The last known Tasmanian <w>tiger</w> died in a zoo in 1936.",
                            "target_lang_translations": {
                                "ru": "Последний известный тасманийский <w>тигр</w> умер в зоопарке в 1936 году."
                            }
                        },
                        {
                            "text": "Many people still hope to find a surviving Tasmanian <w>tiger</w> in the wilderness.",
                            "target_lang_translations": {
                                "ru": "Многие люди все еще надеются найти выжившего тасманийского <w>тигра</w> в дикой природе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Tasmanian tiger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тасманийский тигр; крупное сумчатое хищное животное, ныне считающееся вымершим."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тигр",
                                "target_lang_sense_clarification": "сумчатый"
                            },
                            {
                                "target_lang_word": "тилацин",
                                "target_lang_sense_clarification": "научное название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59c78d1b-5e7b-3209-9a0d-c32eaae567e9",
                    "sense_definition": "Any of various insects with striped patterns, such as certain moths or beetles.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>tiger</w> moth is easily identified by its striking orange and black wings.",
                            "target_lang_translations": {
                                "ru": "Бабочку-медведицу (тигровую <w>моль</w>) легко узнать по ярким оранжево-черным крыльям."
                            }
                        },
                        {
                            "text": "We found a <w>tiger</w> beetle scurrying across the sandy path in the garden.",
                            "target_lang_translations": {
                                "ru": "Мы нашли жука-<w>скакуна</w>, снующего по песчаной дорожке в саду."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tiger moth",
                        "tiger beetle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое из различных насекомых с полосатым рисунком, например, некоторые виды мотыльков или жуков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тигровая",
                                "target_lang_sense_clarification": "о бабочке"
                            },
                            {
                                "target_lang_word": "скакун",
                                "target_lang_sense_clarification": "о жуке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e34fee3d-3289-3eae-83e2-c1ece4d04a99",
                    "sense_definition": "A young male servant in livery who attends a person in a carriage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "servant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gentleman arrived in his carriage, accompanied by a small <w>tiger</w> in polished boots.",
                            "target_lang_translations": {
                                "ru": "Джентльмен прибыл в своем экипаже в сопровождении маленького <w>грума</w> в начищенных сапогах."
                            }
                        },
                        {
                            "text": "In Victorian novels, a <w>tiger</w> often sat at the back of the cabriolet.",
                            "target_lang_translations": {
                                "ru": "В викторианских романах <w>выездной лакей</w> часто сидел сзади кабриолета."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical term for a servant"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Молодой слуга мужского пола в ливрее, сопровождающий господина в экипаже."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грум",
                                "target_lang_sense_clarification": "выездной лакей"
                            },
                            {
                                "target_lang_word": "тигр",
                                "target_lang_sense_clarification": "устаревшее, слуга"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f880856a-f17b-3cf9-a40f-6d5348220b05",
                    "sense_definition": "A common given name for a pet, especially a cat or a dog.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "pet_name",
                    "name_type": "fictional_name",
                    "examples": [
                        {
                            "text": "We decided to name our new orange tabby cat <w>Tiger</w>.",
                            "target_lang_translations": {
                                "ru": "Мы решили назвать нашего нового рыжего полосатого кота <w>Тигр</w>."
                            }
                        },
                        {
                            "text": "Come here, <w>Tiger</w>, it is time for your dinner!",
                            "target_lang_translations": {
                                "ru": "Иди сюда, <w>Тигрик</w>, пора обедать!"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенная кличка для домашнего животного, особенно для кошки или собаки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Тигр",
                                "target_lang_sense_clarification": "кличка"
                            },
                            {
                                "target_lang_word": "Тигрик",
                                "target_lang_sense_clarification": "уменьшительная кличка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d744a99-c66f-3aa9-98f3-2de4e96034ca",
                    "sense_definition": "The third animal in the 12-year cycle of the Chinese zodiac.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zodiac",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "People born in the Year of the <w>Tiger</w> are said to be brave and confident.",
                            "target_lang_translations": {
                                "ru": "Говорят, что люди, рожденные в год <w>Тигра</w>, смелы и уверены в себе."
                            }
                        },
                        {
                            "text": "The next Year of the <w>Tiger</w> will be celebrated with great festivities.",
                            "target_lang_translations": {
                                "ru": "Следующий год <w>Тигра</w> будет отмечаться большими празднествами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Year of the Tiger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Третье животное в 12-летнем цикле китайского зодиака."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Тигр",
                                "target_lang_sense_clarification": "знак зодиака"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23cbe991-0a7d-3d5a-a134-95dea2e8badd",
                    "sense_definition": "A town located in the state of Georgia, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They stopped for gas in the small town of <w>Tiger</w> while driving through Georgia.",
                            "target_lang_translations": {
                                "ru": "Они остановились заправиться в маленьком городке <w>Тайгер</w>, когда проезжали через Джорджию."
                            }
                        },
                        {
                            "text": "The community of <w>Tiger</w> is nestled in the mountains of Rabun County.",
                            "target_lang_translations": {
                                "ru": "Поселение <w>Тайгер</w> расположено в горах округа Рейбан."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "specific to Georgia, USA"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город, расположенный в штате Джорджия, США."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Тайгер",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}