                "senses": [
                    {
                        "sense_id": "7e31f9a2-6f6d-3216-93af-46b164ffd3ac",
                        "entry_id": "55efd2c4-ce1c-35f8-a85b-c57c80b0c2f2",
                        "glosses": [
                            "von Rotoren ausgehendes Geräusch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "345e28ee-13c6-43e1-861c-6a5a4f5eedc9",
                                "sense_id": "7e31f9a2-6f6d-3216-93af-46b164ffd3ac",
                                "text": "„Beim ersten Rotorengeräusch geht in diesem Tal ein Silvesterfeuerwerk los und jeder, der über die Straße kommt, wird erledigt, bevor er sich Shataparai auch nur auf fünf Klicks nähern kann.“"
                            },
                            {
                                "example_id": "dfa4423e-f870-425c-be50-ccf14cdd4087",
                                "sense_id": "7e31f9a2-6f6d-3216-93af-46b164ffd3ac",
                                "text": "„Über ihm wurde das Rotorengeräusch lauter, während sich der Helikopter auf die Bohrinsel herabsenkte.“"
                            },
                            {
                                "example_id": "4575b6ee-48f9-4ca8-b05e-99b67c208b5e",
                                "sense_id": "7e31f9a2-6f6d-3216-93af-46b164ffd3ac",
                                "text": "„Der Motor der Maschine lief an, und als das anfangs hohe Rotorengeräusch tiefer wurde, hob der Helikopter ab und entschwand in Richtung Nordkalifornien.“"
                            },
                            {
                                "example_id": "de639586-3f7f-4730-a0bc-687d6ddc804a",
                                "sense_id": "7e31f9a2-6f6d-3216-93af-46b164ffd3ac",
                                "text": "„Obwohl ihm das Blut in den Ohren rauschte, vernahm er das Rotorengeräusch eines Helikopters.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
