                        {
                            "text": "Als je zo naar die chocola staart, <w>lekkerbek</w> je vast al over de smaak.",
                            "target_lang_translations": {
                                "en": "If you stare at that chocolate like that, you must already be <w>drooling</w> over the taste."
                            }
