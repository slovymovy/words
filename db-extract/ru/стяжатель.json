                    },
                    {
                        "translation_id": "4b222b78-847c-4287-9965-2ab07d06f55b",
                        "source_entry_id": "d0e8eb48-60cd-352d-8979-ea76ae299700",
                        "target_lang_word": "buitre",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buitre",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "a7f6cfe3-e0bf-32d5-8b94-c172bc1de69c",
                                        "entry_id": "14ca1a15-b192-3e94-b694-b2c72265d756",
                                        "glosses": [
                                            "Cualquiera de una veintena de especies de aves rapaces de hábitos carroñeros, de característico cuello pelado; forman un grupo polifilético, en el que se cuentan aves de la familia de los accipítridos en el Viejo Mundo, y de la familia de los catártidos en el Nuevo."
                                        ],
                                        "tags": [
                                            "Aves"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe754efb-6e3c-4547-8a10-98934aa3742e",
                                                "sense_id": "a7f6cfe3-e0bf-32d5-8b94-c172bc1de69c",
                                                "text": "por lo cual, para andar por ella y no perderse, se guían por los aires que corren y por las estrellas y también por las aves que vuelan, principalmente cuervos y buitres y otras de rapiña, que siguen las inmundicias que se echan de los lugares poblados."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4d70c204-46c3-3b21-abd4-c55ad27ef2fb",
                                        "entry_id": "14ca1a15-b192-3e94-b694-b2c72265d756",
                                        "glosses": [
                                            "Por extensión, persona rapaz y codiciosa."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be2b5f16-22cb-40f6-8a8f-5f4354da3d5a",
                                                "sense_id": "4d70c204-46c3-3b21-abd4-c55ad27ef2fb",
                                                "text": "pero, ni bien colocó\nel sartén sobre la mesa\ncuando ya lo levantó\nmás limpio que una patena;\nporque el buitre Masramón\na cucharadas los güevos\nse los tragaba de a dos…."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
