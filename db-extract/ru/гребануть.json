                "senses": [
                    {
                        "sense_id": "22c316dd-3a3f-374a-92c3-627b321b9561",
                        "entry_id": "96f6b507-675b-3aef-9adf-c82930d290ad",
                        "glosses": [
                            "однокр. к грести"
