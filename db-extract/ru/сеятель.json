                ],
                "translations": [
                    {
                        "translation_id": "f3a3453a-6fbc-4e1d-9395-81c82ec35dd2",
                        "source_entry_id": "1c825924-1e92-3a3d-8d7f-fddd0be3b849",
                        "source_sense_description": "тот, кто занимается посевом семян",
                        "target_lang_word": "sower",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sower",
