                                            {
                                                "example_id": "71771e4e-dceb-4da6-be63-f231735208b2",
                                                "sense_id": "e94b6788-7747-3302-b2d0-01601358332c",
                                                "text": "The invisibility of private interactions in the form of whispers resolved an ethical concern in the research but reduced our ability to gauge the volume of interaction […]"
                                            },
                                            {
                                                "example_id": "53e38022-3f72-4304-be5e-2023079a0a9a",
                                                "sense_id": "e94b6788-7747-3302-b2d0-01601358332c",
                                                "text": "Anyone logged in to the chat room can click on an individual name, highlighting it, and send a message — a whisper — that will be seen only by the selected person."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whisper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3320db69-169a-328b-8485-40a72c1027b2",
                                        "entry_id": "6352028d-856d-343b-beb0-7590c64e47d6",
                                        "glosses": [
                                            "To speak softly or under one's breath, so as to be heard only by one near at hand; to utter words without sonant breath; to talk without that vibration of the vocal cords which gives sonorous, or vocal, sound."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15c825df-8eef-4468-b1ea-1f0868674135",
                                                "sense_id": "3320db69-169a-328b-8485-40a72c1027b2",
                                                "text": "I can hear them whisper as we pass by\nIt's a bad sign, bad sign"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "222453e5-f9f5-339c-b796-dcef941a596a",
                                        "entry_id": "6352028d-856d-343b-beb0-7590c64e47d6",
                                        "glosses": [
                                            "To say (something) softly or under one's breath, so as to be heard only by one near at hand; to utter (something) without sonant breath, without that vibration of the vocal cords which gives sonorous, or vocal, sound."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15f004f7-e157-4248-88b7-4f56edc6549f",
                                                "sense_id": "222453e5-f9f5-339c-b796-dcef941a596a",
                                                "text": "Whether he whispered sweet nothings to her in Stengelese is not known, but he did call her \"the best catch I ever made in my career.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c737e62-0be6-380a-8fa8-7080234cbaed",
                                        "entry_id": "6352028d-856d-343b-beb0-7590c64e47d6",
                                        "glosses": [
                                            "To mention privately and confidentially, or in a whisper."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "332d4c1a-70db-4770-8dd4-9adf982e4d29",
                                                "sense_id": "6c737e62-0be6-380a-8fa8-7080234cbaed",
                                                "text": "They might buzz and whisper it one to another."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "281dcaf0-92f8-312c-90e1-67163da4eb8c",
                                        "entry_id": "6352028d-856d-343b-beb0-7590c64e47d6",
                                        "glosses": [
                                            "To make a low, sibilant sound."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2edc1863-05a4-4e6b-a3c5-ec6551def29c",
                                                "sense_id": "281dcaf0-92f8-312c-90e1-67163da4eb8c",
                                                "text": "the hollow, whispering breeze"
                                            },
                                            {
                                                "example_id": "ef1226be-6119-4841-82ec-aec951c222d0",
                                                "sense_id": "281dcaf0-92f8-312c-90e1-67163da4eb8c",
                                                "text": "[…] hear thy laurel whisper sweet\nAbout the ledges of the hill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bee5f4b-7f7f-3ce7-a21b-981a9a49cb50",
                                        "entry_id": "6352028d-856d-343b-beb0-7590c64e47d6",
                                        "glosses": [
                                            "To speak with suspicion or timorous caution; to converse in whispers, as in secret plotting."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
