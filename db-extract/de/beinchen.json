                ],
                "senses": [
                    {
                        "sense_id": "54cc378e-a976-3b7f-9bb8-73cb2e669a45",
                        "entry_id": "2e9c3bbd-2447-35ea-9f5e-1c61bb4db0db",
                        "glosses": [
                            "kleines Bein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40574a6d-61d5-47b2-9d1c-7f4b6ccfff31",
                                "sense_id": "54cc378e-a976-3b7f-9bb8-73cb2e669a45",
                                "text": "Hausspinnen haben acht dünne Beinchen."
                            },
                            {
                                "example_id": "cf7d1493-ba12-447e-add3-18d50838db2d",
                                "sense_id": "54cc378e-a976-3b7f-9bb8-73cb2e669a45",
                                "text": "„Hätten sich ihre winzigen Ärmchen nicht gerekelt und ihre Beinchen sich nicht mitunter bloßgestrampelt, so hätte man meinen können, daß es Wachspuppen gewesen wären.“"
                            },
                            {
                                "example_id": "8d95c1a7-71cd-4a2f-b626-9ec66edfab28",
                                "sense_id": "54cc378e-a976-3b7f-9bb8-73cb2e669a45",
                                "text": "„Kleine schwarze Geschöpfchen eilten von überall her auf sie zu, auf Beinchen, dünn wie Streichhölzer, verschreckte Augen blickten verstohlen nach rechts und links, und kleine schwache Pfötchen zerrten Ladungen durch die Öffnungen, die nicht selten größer waren als die ganze Gestalt des Schmugglers.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7a7014f-da3a-4f3b-8d7a-428d23060af7",
                        "source_entry_id": "2e9c3bbd-2447-35ea-9f5e-1c61bb4db0db",
                        "source_sense_id": "54cc378e-a976-3b7f-9bb8-73cb2e669a45",
                        "source_sense_description": "kleines Bein",
                        "target_lang_word": "ножка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ножка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f9d61126-d2da-3c99-af9e-8128bee4341e",
                                        "entry_id": "2d237c4e-ab53-38fa-9c08-43beb1e6940a",
                                        "glosses": [
                                            "уменьш.-ласк. к нога"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01b425fa-0c48-4cbf-b13f-1627b0c53b7b",
                                                "sense_id": "f9d61126-d2da-3c99-af9e-8128bee4341e",
                                                "text": "И по ковру скользит, плывет // Ее божественная ножка; // И улыбается она, // Веселья детского полна."
                                            },
                                            {
                                                "example_id": "4a182cbb-b858-40cc-a3ae-c49d4cd59f73",
                                                "sense_id": "f9d61126-d2da-3c99-af9e-8128bee4341e",
                                                "text": "Чьей лёгкой ножки при реке // Следы остались на песке?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "380c4b37-9999-39da-b67d-f042c22a5530",
                                        "entry_id": "2d237c4e-ab53-38fa-9c08-43beb1e6940a",
                                        "glosses": [
                                            "лапка насекомого"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19870c21-8075-3051-83b2-e5aa7ce2ecdd",
                                        "entry_id": "2d237c4e-ab53-38fa-9c08-43beb1e6940a",
                                        "glosses": [
                                            "опора, стойка (мебели, утвари); черенок бокала, рюмки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "189c0c48-a9bb-4533-96a7-24a3dd0cad85",
                                                "sense_id": "19870c21-8075-3051-83b2-e5aa7ce2ecdd",
                                                "text": "Ножка дивана, стола, стула, самовара."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8c96afe-3600-38d4-918b-3c02f74a55cd",
                                        "entry_id": "2d237c4e-ab53-38fa-9c08-43beb1e6940a",
                                        "glosses": [
                                            "спец., уменьш. вывод радиодетали"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09fdc4f0-94c3-48b3-a389-3f5fe89ae255",
                                                "sense_id": "c8c96afe-3600-38d4-918b-3c02f74a55cd",
                                                "text": "Для осуществления такой запитки припаивайте провод к 16-й ножке микросхемы и выводите его из корпуса разъёма."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc683ae2-d013-3967-b10b-e9c41c1b74e5",
                                        "entry_id": "2d237c4e-ab53-38fa-9c08-43beb1e6940a",
                                        "glosses": [
                                            "биол. у гриба — нижняя часть, на которой сидит шляпка; стебель цветка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b000bf7e-4c87-4617-bab6-ad8447f6702a",
                                                "sense_id": "bc683ae2-d013-3967-b10b-e9c41c1b74e5",
                                                "text": "Не на стебле при дорожках // Неподвижно — одинок — // Нет, на двух летучих ножках.// Вьётся резвый тот цветок."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ae4ca62-83a9-3be0-b76d-0e6791561055",
                                        "entry_id": "2d237c4e-ab53-38fa-9c08-43beb1e6940a",
                                        "glosses": [
                                            "спец. раздвижная половинка циркуля"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
