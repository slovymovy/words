                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kommen und Gehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce5b46a5-4864-3554-94ae-3be914187158",
                                        "entry_id": "6a8cf763-abdd-316c-ad8e-db3d88c26601",
                                        "glosses": [
                                            "Wechsel von An- und Abwesenheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d4c1111-6676-4114-8b2f-6421ced5fa78",
                                                "sense_id": "ce5b46a5-4864-3554-94ae-3be914187158",
                                                "text": "\"Es geht tatsächlich um Kommen und Gehen, Bleiben und Gehen, um Bewegung und vermeintliche Bewegung, ums Reisen, Verreisen, Auswandern im geografischen Sinne, benennt Andreas Nentwich den roten Faden aller Erzählungen von Peters in diesem Band.\""
                                            },
                                            {
                                                "example_id": "b2448084-fbfc-40de-b3da-88d985eb7ef0",
                                                "sense_id": "ce5b46a5-4864-3554-94ae-3be914187158",
                                                "text": "\"In den letzten Wochen war es ein stetiges Kommen und Gehen bei der U 23 des FSV Mainz 05.\""
                                            },
                                            {
                                                "example_id": "97ffd647-0ce6-4823-999c-565f77ccc7b8",
                                                "sense_id": "ce5b46a5-4864-3554-94ae-3be914187158",
                                                "text": "\"Das Kommen und Gehen am Ballhausplatz geht auch am Tag zwei nach Bekanntgabe des Bundespräsidenten-Wahlergebnisses weiter.\""
                                            },
                                            {
                                                "example_id": "f6941265-ccd0-4785-b2d7-156b4179ef1b",
                                                "sense_id": "ce5b46a5-4864-3554-94ae-3be914187158",
                                                "text": "\"Auch am dritten Tag des Herbstfests herrschte ein reges Kommen und Gehen.\""
                                            },
                                            {
                                                "example_id": "02579a3b-7497-4514-9793-7312fccd315b",
                                                "sense_id": "ce5b46a5-4864-3554-94ae-3be914187158",
                                                "text": "\"Kommen und Gehen sind in der «Bergruh» tägliche Realität.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2084516-95df-4d92-8fb6-83bc2bdc77fd",
                        "source_entry_id": "e04632a9-83ea-3747-9946-0d7651a7ca10",
                        "source_sense_id": "3f724957-47b6-30cc-91ee-becc998de2d5",
                        "source_sense_description": "Figuré : échange entre plusieurs personnes de leurs places",
                        "target_lang_word": "Hin und Her",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hin und Her",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a0ebd3a-ccc3-3353-8077-23f34c6135a9",
                                        "entry_id": "5e5cef9b-bdf7-372e-b2c8-227734b9b204",
                                        "glosses": [
                                            "abwechselnder Besitz/Meinungsaustausch/Vorteil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e286ea70-a00f-4589-895a-6d95085a3a0a",
                                                "sense_id": "2a0ebd3a-ccc3-3353-8077-23f34c6135a9",
                                                "text": "Das Hin und Her machte die Buben müde und den Streit um den Ball vergessen."
                                            },
                                            {
                                                "example_id": "da7f1587-e37c-48a3-8c4d-47d3285a01dd",
                                                "sense_id": "2a0ebd3a-ccc3-3353-8077-23f34c6135a9",
                                                "text": "Nach langem Hin und Her konnten sich die Schauspieler auf die richtige Ausführung einigen."
                                            },
                                            {
                                                "example_id": "50e986e6-61e5-4d3c-8559-10f8dc1a76b8",
                                                "sense_id": "2a0ebd3a-ccc3-3353-8077-23f34c6135a9",
                                                "text": "Ohne das Hin und Her der Stellungskriege hätte der erste Weltkrieg nicht so viel Tote gefordert."
                                            },
                                            {
                                                "example_id": "5e2a273b-4136-42fd-ab47-5e6f1122432d",
                                                "sense_id": "2a0ebd3a-ccc3-3353-8077-23f34c6135a9",
                                                "text": "„Sie hatte nach langem Hin und Her endlich ihre Vollzeitstelle im Aluminiumwerk in Grundartangi gekündigt und sich wieder an der Uni eingeschrieben, während sie nebenbei im Laden um die Ecke jobbte.“"
                                            },
                                            {
                                                "example_id": "58d81ada-6701-461e-b6c2-0f69cb538e74",
                                                "sense_id": "2a0ebd3a-ccc3-3353-8077-23f34c6135a9",
                                                "text": "„Dann folgten schlaflose Nächte, ein Hin und Her zwischen Wut und Hoffnung, Aufregung und Niedergeschlagenheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
