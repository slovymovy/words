                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3aa435b-e94e-4b5c-a07f-4de26f6736b2",
                                "sense_id": "52bae5e2-e612-3bf4-b349-0c6068f9fad0",
                                "text": "„Wenn Grubenottern zubeißen, vergessen sie in fünf von zehn Fällen schlicht ihr Gift abzusondern.“"
