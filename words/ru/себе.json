                                "en": "She often talks about <herself>.",
                                "cs": "Často vypráví o <w>sobě</w>.",
                                "nl": "Ze vertelt vaak over <w>zichzelf</w>.",
                                "pl": "Ona często opowiada o <w>sobie</w>.",
                                "de": "Sie erzählt oft von <w>sich</w>.",
                                "fr": "Elle parle souvent d'elle-<w>même</w>.",
                                "it": "Lei parla spesso di <w>sé</w>.",
                                "tr": "Sık sık <w>kendinden</w> bahseder.",
                                "es": "Ella a menudo habla de <w>sí</w> misma.",
                                "zh": "她经常谈论<w>自己</w>。"
                            }
                        },
                        {
                            "text": "Мне стало не по <себе>.",
                            "target_lang_translations": {
                                "en": "I felt <uneasy>.",
                                "cs": "Nebylo mi <w>dobře</w>.",
                                "nl": "Ik voelde me <w>onbehaaglijk</w>.",
                                "pl": "Poczułem <w>się</w> nieswojo.",
                                "de": "Ich fühlte <w>mich</w> unwohl.",
                                "fr": "Je ne me suis pas senti <w>bien</w>.",
                                "it": "Mi sono sentito <w>a</w> disagio.",
                                "tr": "Kendimi <w>rahatsız</w> hissettim.",
                                "es": "Me sentí <w>incómodo</w>.",
                                "zh": "我感到有些<w>不舒服</w>。"
                            }
                        }
