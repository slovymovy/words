                    "sense_definition": "iemand met geld overhalen af te zien van tegenstand, bezwaar of chantage",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
