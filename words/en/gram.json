{
    "word_family": [
        "grammage",
        "gramme"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f38c4346-51c5-38f6-857c-0a5da3dcc846",
                    "sense_definition": "A unit of mass equal to one-thousandth of a kilogram.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recipe requires exactly one <w>gram</w> of saffron to achieve the perfect flavor.",
                            "target_lang_translations": {
                                "ru": "Для достижения идеального вкуса по рецепту требуется ровно один <w>грамм</w> шафрана."
                            }
                        },
                        {
                            "text": "A single paperclip usually weighs about one <w>gram</w>.",
                            "target_lang_translations": {
                                "ru": "Одна канцелярская скрепка обычно весит около одного <w>грамма</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "gramme"
                    ],
                    "common_phrases": [
                        "one gram",
                        "per gram"
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица массы, равная одной тысячной килограмма."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грамм",
                                "target_lang_sense_clarification": "единица измерения массы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa9601b9-78a3-32ab-be38-eb2be4ed27c2",
                    "sense_definition": "An informal term for a grandmother.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>gram</w> makes the best apple pie every Thanksgiving.",
                            "target_lang_translations": {
                                "ru": "Моя <w>бабуля</w> печет лучший яблочный пирог на каждый День благодарения."
                            }
                        },
                        {
                            "text": "I am going to visit my <w>gram</w> at her house this weekend.",
                            "target_lang_translations": {
                                "ru": "В эти выходные я собираюсь навестить свою <w>ба</w> у неё дома."
                            }
                        }
                    ],
                    "synonyms": [
                        "grandma",
                        "granny",
                        "grandmother"
                    ],
                    "antonyms": [
                        "gramp",
                        "grandpa"
                    ],
                    "common_phrases": [
                        "my gram"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal family term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неформальное обращение к бабушке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бабуля",
                                "target_lang_sense_clarification": "ласковое обращение к бабушке"
                            },
                            {
                                "target_lang_word": "ба",
                                "target_lang_sense_clarification": "сокращенное разговорное обращение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e115d8f-2b3f-30af-9146-8d30e0da1502",
                    "sense_definition": "A clipping of the social media platform Instagram.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "social_media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She posted the photo on the <w>gram</w> to show off her new outfit.",
                            "target_lang_translations": {
                                "ru": "Она выложила фото в <w>инсту</w>, чтобы похвастаться своим новым нарядом."
                            }
                        },
                        {
                            "text": "You should do it for the <w>gram</w> so all your followers can see.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит сделать это ради <w>инстаграма</w>, чтобы все твои подписчики увидели."
                            }
                        }
                    ],
                    "synonyms": [
                        "Instagram"
                    ],
                    "common_phrases": [
                        "for the gram",
                        "on the gram"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet and social media slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенное название социальной сети Instagram."
                    },
