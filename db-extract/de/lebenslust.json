                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "151f350b-bada-4fdb-a2f6-8d90617caf97",
                        "source_entry_id": "bd2716eb-4eb1-3476-ab1b-2cb9f54a7408",
