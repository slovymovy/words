                                    {
                                        "sense_id": "86e200ec-3c9b-36d0-a917-4f626c3470eb",
                                        "entry_id": "83952abd-4164-3ea1-9272-9544223a2724",
                                        "glosses": [
                                            "Qui transmet des messages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ce92a90-d380-43ed-844c-0b95d70d82b9",
                                                "sense_id": "86e200ec-3c9b-36d0-a917-4f626c3470eb",
                                                "text": "Acide ribonucléique messager, acide ribonucléique qui exerce une transmission de l'information génétique des gènes aux ribosomes où s'effectue la synthèse des protéines."
                                            },
                                            {
                                                "example_id": "f5258331-9b85-4094-a06c-21c49c80c29b",
                                                "sense_id": "86e200ec-3c9b-36d0-a917-4f626c3470eb",
                                                "text": "Le pigeon messager, pigeon voyageur qui transmet des messages."
                                            },
                                            {
                                                "example_id": "85a5545f-e059-4ca3-8ca3-9bd4ca087d36",
                                                "sense_id": "86e200ec-3c9b-36d0-a917-4f626c3470eb",
                                                "text": "La colombe messagère."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "messager",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b34451ca-8ae6-3a21-96c4-84c50860ee51",
                                        "entry_id": "34aa0079-ab0d-3488-9670-181519b55e68",
                                        "glosses": [
                                            "Celui qui est chargé de porter un message."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1a7a182-ae00-4a03-9f9f-9d952b066334",
                                                "sense_id": "b34451ca-8ae6-3a21-96c4-84c50860ee51",
                                                "text": "Messager fidèle."
                                            },
                                            {
                                                "example_id": "b6b12aff-2689-444f-ad36-0eca732e1d97",
                                                "sense_id": "b34451ca-8ae6-3a21-96c4-84c50860ee51",
                                                "text": "Le messager des dieux, Mercure ou Hermès."
                                            },
                                            {
                                                "example_id": "973da0a3-2371-443c-bae5-21371df2aaec",
                                                "sense_id": "b34451ca-8ae6-3a21-96c4-84c50860ee51",
                                                "text": "Je lui ai envoyé messager sur messager."
                                            },
                                            {
                                                "example_id": "c578eccc-8f67-4581-90b4-a5dc95470e79",
                                                "sense_id": "b34451ca-8ae6-3a21-96c4-84c50860ee51",
                                                "text": "Donnez-moi cette lettre, je serai votre messagère."
                                            },
                                            {
                                                "example_id": "ca9292ae-cd7f-4100-90a7-e8adf97fe2da",
                                                "sense_id": "b34451ca-8ae6-3a21-96c4-84c50860ee51",
                                                "text": "Dans le passage de l’oral à l’écrit, la spécificité du messager s’efface derrière celle du message. Peut-être y perd-on en spontanéité, mais on y gagne en cohérence, celle précisément d’une forme littéraire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b6967e6-eae7-353d-8e46-6647dc789468",
                                        "entry_id": "34aa0079-ab0d-3488-9670-181519b55e68",
                                        "glosses": [
                                            "Porteur, transporteur de colis ou de messages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88deb65b-a56c-4a4f-a510-9263379edae2",
                                                "sense_id": "8b6967e6-eae7-353d-8e46-6647dc789468",
                                                "text": "Messager de malheur, porteur de mauvaises nouvelles."
                                            },
                                            {
                                                "example_id": "e3664a7c-078b-4500-8342-28507d300cba",
                                                "sense_id": "8b6967e6-eae7-353d-8e46-6647dc789468",
                                                "text": "Apparemment conçu pour que personne ne s’y attarde, sauf les chauffeurs-gardes du corps venus déposer et attendre leurs ministres qui assistent au Conseil ou à diverses autres réunions, ce hall ne comporte aucun véritable endroit pour s’asseoir, à l’exception de deux longues banquettes de bois peu invitantes et sur lesquelles traînent invariablement colis et enveloppes en attente d’un messager ou d'un taxi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e322d3f-41bf-39ef-8e21-d107bd52e219",
                                        "entry_id": "34aa0079-ab0d-3488-9670-181519b55e68",
                                        "glosses": [
                                            "Annonciateur, avant-coureur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb49eb6e-f855-42fc-a762-d915b30da14b",
