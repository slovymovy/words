                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "afba7f4c-7528-395f-8d57-964b8b964424",
                        "entry_id": "17daf7bf-e0c9-343b-afcd-fa0f48a97831",
                        "glosses": [
                            "very (“非常”)的縮寫"
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "fabd882a-47c0-42a2-8aa0-021aa9208a93",
                                "sense_id": "afba7f4c-7528-395f-8d57-964b8b964424",
                                "text": "You were acting v rude to his boyfriend on New Year's.",
                                "translation": "你在新年時對他的男朋友表現得非常無禮。"
                            },
                            {
                                "example_id": "043e4747-0394-4bcc-bef7-e97c57dc67e4",
                                "sense_id": "afba7f4c-7528-395f-8d57-964b8b964424",
                                "text": "I'm v tired. I slept v badly, awake from 3–6 a.m., so I've slept all afternoon.",
                                "translation": "我非常累。我睡得極差，凌晨 3 點到 6 點都醒著，所以我整個下午都在睡覺。"
                            },
                            {
                                "example_id": "5d3bc5ef-4f1f-4751-b799-9189e6720991",
                                "sense_id": "afba7f4c-7528-395f-8d57-964b8b964424",
                                "text": "I said it wasn't a crush, I just thought he was v attractive.",
                                "translation": "我說那不是暗戀，我只是覺得他很有吸引力。"
                            },
                            {
                                "example_id": "56ad1002-5726-4a56-94ca-8abd40f34a37",
                                "sense_id": "afba7f4c-7528-395f-8d57-964b8b964424",
                                "text": "Since becoming social media official, Cara Delevingne and Ashley Benson have been sashaying around town together and being v cute",
                                "translation": "自從在社交媒體上公開關係後，卡拉·迪瓦伊和艾希莉·班森就一起在城裡招搖過市，而且表現得非常可愛"
                            },
                            {
                                "example_id": "b71d4d27-a08c-40ca-aea9-7f4fff5ce2b8",
                                "sense_id": "afba7f4c-7528-395f-8d57-964b8b964424",
                                "text": "Sometimes a trip to the spa is not in the cards, even if your gel manicure has seen waaaay better days. These polish remover tools help cut costs and keep your natural nails looking v nice.",
                                "translation": "有時候去水療中心是不太可能的，即使你的凝膠美甲早就已經過了大好時光。這些卸甲工具能幫助節省成本，並讓你的自然指甲看起來非常漂亮。"
                            }
                        ]
                    }
                ],
