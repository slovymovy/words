                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sculptor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc4fe6c7-832c-351c-bb07-bc4270f392b0",
                                        "entry_id": "b7dcc270-1bd7-30ab-8089-30fdfadcf77e",
                                        "glosses": [
                                            "A person who sculpts; an artist who produces sculpture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d00f46a1-0fa2-4389-8e7d-7ed6183de142",
                                                "sense_id": "fc4fe6c7-832c-351c-bb07-bc4270f392b0",
                                                "text": "The feisty wife of a world-renowned Russian sculptor emasculated an armed thug outside her Soho home — saying he “didn’t have the cojones to shoot her,” police sources said yesterday."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa2be9d3-5b03-40db-aaa2-6e4099174159",
                        "source_entry_id": "e820fef6-548c-3082-bf7b-bdee9d52a2ce",
                        "source_sense_id": "b1c320c9-6508-3587-822c-e5b813292bd3",
                        "source_sense_description": "een beoefenaar van de beeldhouwkunst",
                        "target_lang_word": "sculpteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sculpteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e8a6162-be21-3859-a08d-8490bcb0bff8",
                                        "entry_id": "7f05d3f3-2f33-3889-a3b0-8a6ead252594",
                                        "glosses": [
                                            "Artiste qui sculpte la matière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77f29181-75b7-4298-8178-8fd8460a06b2",
                                                "sense_id": "1e8a6162-be21-3859-a08d-8490bcb0bff8",
                                                "text": "« — Un sculpteur ? Ils sont généralement un peu brutes, les sculpteurs.\n— Oh ! celui-là sculpte si peu ! Mais, si vous êtes contrarié que je le reçoive, je ne le recevrai pas."
                                            },
                                            {
                                                "example_id": "fda6dbfe-240d-4c08-8a40-db3518c54fae",
                                                "sense_id": "1e8a6162-be21-3859-a08d-8490bcb0bff8",
                                                "text": "Et jamais, en somme, l’on n’a découvert le nom de l’un des premiers architectes, de l’un des sculpteurs, de l’un des verriers de cette cathédrale ?"
                                            },
                                            {
                                                "example_id": "0dd449cc-217e-4a63-8b55-4cefb31f3572",
                                                "sense_id": "1e8a6162-be21-3859-a08d-8490bcb0bff8",
                                                "text": "Une grande partie des vieux indigènes était tatouée. Cela ne me surprenait pas, car Fata-Hiva avait toujours été célèbre pour ses tatoueurs et ses sculpteurs."
                                            },
                                            {
                                                "example_id": "017299f6-2525-42a9-8c48-f13552454f27",
                                                "sense_id": "1e8a6162-be21-3859-a08d-8490bcb0bff8",
                                                "text": "Le visiteur découvre les multiples talents de Mathurin Méheut, à la fois peintre, décorateur, illustrateur, céramiste et sculpteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f67002d1-4202-3c19-9b64-d3efacd2023e",
                                        "entry_id": "7f05d3f3-2f33-3889-a3b0-8a6ead252594",
                                        "glosses": [
                                            "Métier de celui qui sculpte."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
