                                        "entry_id": "a65a47ff-b7eb-3e08-8f83-b75ff3103d1d",
                                        "glosses": [
                                            "To increment or decrement; especially, to offer controlled motion that can increment while resisting decrement, or vice versa."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8964b9c0-427a-4a7f-8f54-ca46e4ac9ff8",
                                                "sense_id": "90f232c1-5bd4-355e-a591-b910666d2483",
                                                "text": "This holddown ratchets, which allows the person loading the trailer to cinch down the straps."
                                            },
                                            {
                                                "example_id": "89725ddb-4084-41ca-80bd-4ba354cdd03a",
                                                "sense_id": "90f232c1-5bd4-355e-a591-b910666d2483",
                                                "text": "Compared with the excellent scroll wheels on the Basilisk V3 and G502 X, the G203’s scroll wheel feels less defined and mushier in its ratcheting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4597c1c-363d-3b78-877d-0f00b4add781",
                                        "entry_id": "a65a47ff-b7eb-3e08-8f83-b75ff3103d1d",
                                        "glosses": [
                                            "To cause (something) to become incremented or decremented."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e684750a-6ded-474e-8e7d-d98e8e2311aa",
                                                "sense_id": "b4597c1c-363d-3b78-877d-0f00b4add781",
                                                "text": "Get this holddown into position, but don't start ratcheting it yet. When I say go, you start ratcheting it, OK?"
                                            },
                                            {
                                                "example_id": "51314c0a-14cf-4de6-ab10-ac1e453942d7",
                                                "sense_id": "b4597c1c-363d-3b78-877d-0f00b4add781",
                                                "text": "It's time to ratchet up the intensity level here."
                                            },
                                            {
                                                "example_id": "5b3b6898-81e3-4a53-9ae3-9d6bd96b38e4",
                                                "sense_id": "b4597c1c-363d-3b78-877d-0f00b4add781",
                                                "text": "Yugoslavia’s President, Slobodan Milosevic, has rejected all efforts at meaningful diplomacy and, in violation of his own previous commitments, has ratcheted up his military campaign against the innocent civilians of Kosovo."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ratchet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3741e3b5-11a0-3e02-a58f-95407897b995",
                                        "entry_id": "d8a20476-4915-325b-a55a-6e7ec246a0e4",
                                        "glosses": [
                                            "Ghetto; unseemly, indecorous."
