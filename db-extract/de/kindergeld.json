                "senses": [
                    {
                        "sense_id": "b9733d39-2be5-321e-b8e5-e365b6a2331c",
                        "entry_id": "ec09bf71-be7c-37d7-b7ea-25b4ab28c36a",
                        "glosses": [
                            "Geld, das der Staat an Eltern pro Kind regelmäßig als Unterstützung zahlt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "527acb06-58ac-47f5-9266-f988b3198d38",
                                "sense_id": "b9733d39-2be5-321e-b8e5-e365b6a2331c",
                                "text": "Das Kindergeld wurde erhöht."
                            },
                            {
                                "example_id": "d79c5830-3769-4a3e-9e43-cc3ebf4736af",
                                "sense_id": "b9733d39-2be5-321e-b8e5-e365b6a2331c",
                                "text": "„Wir haben das Betreuungsgeld, das Kindergeld, Rechtsansprüche, und sogar der Unterhalt ist in einer Tabelle festgelegt.“"
                            },
                            {
                                "example_id": "2cb9c0d6-aba2-43f6-a8fe-62862df3f8d7",
                                "sense_id": "b9733d39-2be5-321e-b8e5-e365b6a2331c",
                                "text": "„In Wahrheit ist das Kindergeld verfassungsrechtlich garantiert und darf niemandem gekürzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f21f05e1-27e0-4b85-ae0d-d2de6b171e82",
                        "source_entry_id": "ec09bf71-be7c-37d7-b7ea-25b4ab28c36a",
                        "source_sense_id": "b9733d39-2be5-321e-b8e5-e365b6a2331c",
                        "source_sense_description": "Geld, das der Staat an Eltern pro Kind regelmäßig als Unterstützung zahlt",
                        "target_lang_word": "child benefit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "child benefit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69b4416f-c3c4-3a85-aa27-9a4031710654",
                                        "entry_id": "aab08943-0332-3900-a9a6-2bad7cd0c7ad",
                                        "glosses": [
                                            "A regular government payment made to parents or guardians for each child up to a certain age."
                                        ],
                                        "tags": [
                                            "UK",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55774d70-dc5d-4dad-af32-128bff28905d",
                                                "sense_id": "69b4416f-c3c4-3a85-aa27-9a4031710654",
                                                "text": "Near-synonym: family allowance"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "937003c2-8ee3-43ab-8eaa-2aafb13dbac4",
                        "source_entry_id": "ec09bf71-be7c-37d7-b7ea-25b4ab28c36a",
                        "source_sense_id": "b9733d39-2be5-321e-b8e5-e365b6a2331c",
                        "source_sense_description": "Geld, das der Staat an Eltern pro Kind regelmäßig als Unterstützung zahlt",
                        "target_lang_word": "allocation familiale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "allocation familiale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c88d9eec-e70f-3799-b0ab-b8037a407c10",
                                        "entry_id": "814aac04-ed54-32f2-898d-d20c4a2fa8c7",
                                        "glosses": [
                                            "Somme d’argent allouée par la collectivité aux foyers qui ont au moins deux enfants à charge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47375190-00d2-44b8-b756-3d963acce782",
                                                "sense_id": "c88d9eec-e70f-3799-b0ab-b8037a407c10",
                                                "text": "À Blainville-sur-l’Eau et à Damelevières la natalité est splendide ; […] Parce que les ménages ici sont jeunes, bien logés, bien payés et, surtout, décidés à la procréation par des allocations familiales très appréciables."
                                            },
                                            {
                                                "example_id": "9c015d78-a6f5-412f-8368-7c6d68d7a24c",
                                                "sense_id": "c88d9eec-e70f-3799-b0ab-b8037a407c10",
                                                "text": "Le nombre d’enfants recevant une allocation familiale était de 1,608,000 en 1973 et de plus de 2 millions en 1979."
                                            },
                                            {
                                                "example_id": "d282a26a-3055-4063-85fb-5694e126243e",
                                                "sense_id": "c88d9eec-e70f-3799-b0ab-b8037a407c10",
                                                "text": "Vous avez droit à une allocation familiale si vous avez la charge d’un enfant de moins de 18 ans."
                                            },
                                            {
                                                "example_id": "40536cd9-26cc-4c0a-9ba7-85b10a78c04c",
                                                "sense_id": "c88d9eec-e70f-3799-b0ab-b8037a407c10",
                                                "text": "À la naissance du bébé, afin de répondre aux mauvaises langues qui prétendaient qu’ils faisaient des enfants à tire-larigot pour toucher les allocations familiales, Georges avait, en guise de faire-part, reproduit une carte de réduction SNCF sur laquelle il avait écrit :\n« Les Poirier ont la joie de vous annoncer qu’ils bénéficient, enfin, des 75 % ! »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
