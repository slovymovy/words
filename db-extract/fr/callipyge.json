        "fr-extract.jsonl": [
            {
                "entry_id": "089a0f18-be5f-309c-873d-2f03b7440e31",
                "word": "callipyge",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "46ca8863-04a4-47bb-91b0-f8ec3286cf2f",
                        "entry_id": "089a0f18-be5f-309c-873d-2f03b7440e31",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "callipyges"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9c10109e-daf0-3c83-ab21-591e385ac9f8",
                        "entry_id": "089a0f18-be5f-309c-873d-2f03b7440e31",
                        "glosses": [
                            "Qui a de belles fesses, aux formes harmonieuses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e74f8ff-e162-473f-8cd9-14c8cb40b791",
                                "sense_id": "9c10109e-daf0-3c83-ab21-591e385ac9f8",
                                "text": "Il y eut à Syracuse deux femmes aux belles fesses, ou callipyges. Ces deux femmes, devenues riches, firent élever un temple à Vénus, qu’elles appelèrent la déesse aux belles fesses, selon ce que dit Archélaüs dans ses Iambes."
                            },
                            {
                                "example_id": "47b92c3f-e832-4799-aec1-2192351cbc01",
                                "sense_id": "9c10109e-daf0-3c83-ab21-591e385ac9f8",
                                "text": "Ô gracieuse et callipyge\nTous les culs sont de la Saint-Jean\nLe tien leur fait vraiment la pige\nDéesse aux collines d’argent"
                            },
                            {
                                "example_id": "21a2173a-22e1-40c9-9b33-85cbd7d8a828",
                                "sense_id": "9c10109e-daf0-3c83-ab21-591e385ac9f8",
                                "text": "Passait un’ bell’ gretchen au carrefour du château,\nEntre la rue Didot et la rue de Vanves,\nCallipyge à prétendre\nJouer les Vénus chez les Hottentots,\nEntre la rue de Vanv’s et la rue Didot."
                            },
                            {
                                "example_id": "302edc28-4552-464f-80e4-f8187a7ea0b0",
                                "sense_id": "9c10109e-daf0-3c83-ab21-591e385ac9f8",
                                "text": "Sensible et callipyge, Victoire, votre pudeur vous embellit.",
                                "translation": "— (Comte d’Époisse)"
                            }
                        ]
                    },
                    {
                        "sense_id": "eea904db-8045-3625-8336-740614ae8936",
                        "entry_id": "089a0f18-be5f-309c-873d-2f03b7440e31",
                        "glosses": [
                            "Qui a des formes arrondies. Gros et gras."
                        ],
                        "tags": [
                            "broadly",
                            "ironic",
                            "rare"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca20d172-b280-4294-b97f-f752c21d5e73",
                        "source_entry_id": "089a0f18-be5f-309c-873d-2f03b7440e31",
                        "target_lang_word": "callipygian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "callipygian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a53543c-1780-37c2-aca8-443e87312ff9",
                                        "entry_id": "e5085510-df51-3caa-9858-e0f0ed215fa8",
                                        "glosses": [
                                            "Having beautifully shaped buttocks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bc015d3-a461-4eea-9784-ac0f5489eec1",
                                                "sense_id": "5a53543c-1780-37c2-aca8-443e87312ff9",
                                                "text": "[…]we soon once more were in a state to renew our delicious combat; and a second course was run in the delightful callipygian recesses of Venus’s second temple of lubricity."
                                            },
                                            {
                                                "example_id": "389338c6-02b9-475f-b762-26b09ea33652",
                                                "sense_id": "5a53543c-1780-37c2-aca8-443e87312ff9",
                                                "text": "Suddenly the music grew fainter, as if drawing away, and the dancers, their feet together and limbs half opened, descended in a slow spiral, with gentle undulations, until they touched the floor; the instant their callipygian charms grazed the mosaic, they recoiled like suddenly awakened serpents, […]"
                                            },
                                            {
                                                "example_id": "24dcffbe-d478-450a-ba73-c51a4f30287b",
                                                "sense_id": "5a53543c-1780-37c2-aca8-443e87312ff9",
                                                "text": "Her gown (perhaps as a result of the scorching winds coming off the ambas) clung damply to her body, clearly revealing her callipygian curves and the entire shapely length of her legs."
                                            },
                                            {
                                                "example_id": "b7828ed3-7893-4ca0-a4b5-e6848f5c6c69",
                                                "sense_id": "5a53543c-1780-37c2-aca8-443e87312ff9",
                                                "text": "[T-Rex:] My lovely visage, callipygian frame, startlingly awesome calves and charming smile will yet go down in history!"
                                            },
                                            {
                                                "example_id": "3e1fa17d-e0d6-4e18-b439-14bd91bbe01f",
                                                "sense_id": "5a53543c-1780-37c2-aca8-443e87312ff9",
                                                "text": "With trepidation, but not embarrassment, I offer the thought that Mrs. Obama, a formerly disadvantaged alumna of Princeton and Harvard, to judge from her well-strategized appearances on national television in exiguous dresses and trousers, is as callipygian as Jennifer Lopez."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21090433-865c-32d2-857a-235b28ebe3e0",
                                        "entry_id": "e5085510-df51-3caa-9858-e0f0ed215fa8",
                                        "glosses": [
                                            "Specifically, describing a statue (often of a goddess such as Aphrodite) in a pose that shows off the figure's shapely buttocks."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91d251cf-7f4c-458f-a7ce-2c23d4c7eeda",
                        "source_entry_id": "089a0f18-be5f-309c-873d-2f03b7440e31",
                        "target_lang_word": "callipygous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "callipygous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39dd2753-9a66-3040-8ecd-74199ac11d80",
                                        "entry_id": "dbc0fc4d-a366-33fc-a36b-cd0c8284be10",
                                        "glosses": [
                                            "Synonym of callipygian."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2c91f3b-c0ff-42e8-a54e-d16897ccf1ea",
                                                "sense_id": "39dd2753-9a66-3040-8ecd-74199ac11d80",
                                                "text": "One does not fall very desperately in love with a loud speaker, however pretty, however firmly plump (for Philip's tastes were rather old-fashioned), however attractively callipygous."
                                            },
                                            {
                                                "example_id": "5377fdaf-ef45-4b71-a841-9cf9bb089ffd",
                                                "sense_id": "39dd2753-9a66-3040-8ecd-74199ac11d80",
                                                "text": "He enjoyed Nurse Sue Ann Duckett’s long white legs and supple, callipygous ass; he often neglected to remember that she was quite slim and fragile from the waist up and hurt her unintentionally in moments of passion when he hugged her too roughly."
                                            },
                                            {
                                                "example_id": "6947d9c1-d481-459d-bb39-9e8960801bf7",
                                                "sense_id": "39dd2753-9a66-3040-8ecd-74199ac11d80",
                                                "text": "The other hand came up and together they described a near callipygous shape."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
