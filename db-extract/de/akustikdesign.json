                        "glosses": [
                            "Gestaltung von etwas (Fahrzeuge, Räume, Verpackungen…) mit dem Ziel, einen guten Klang zu erreichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32d0dd93-dda7-4817-a5cd-31f2b8c9caf7",
                                "sense_id": "85a662f8-243f-3864-b6d3-cb15c0b2d2f8",
                                "text": "„Akustikdesign bedeutet für ihn nicht nur, dass man Sorge trägt, dass Autotüren mit steigendem Preis immer eleganter zuknallen oder Kartoffelchips beim Zerkauen schön knusprig knacken. Akustikdesign ist zunächst vor allem das Vermeiden unnötiger Geräusche und das Erproben ganz neuer Umweltgeräusche.“"
                            }
                        ],
