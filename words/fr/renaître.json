                                "target_lang_sense_clarification": "о подземных реках"
                            },
                            {
                                "target_lang_word": "забрезжить",
                                "target_lang_sense_clarification": "о свете и дневном свете"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "zutage treten",
                                "target_lang_sense_clarification": "unterirdische Flüsse, Quellen"
                            },
                            {
                                "target_lang_word": "wiedererscheinen",
                                "target_lang_sense_clarification": "Licht, Tageslicht"
