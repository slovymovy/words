                    {
                        "translation_id": "1daf8c19-f48b-4e2b-9ed9-1e7e61a6fc07",
                        "source_entry_id": "f31895e2-73f7-32d4-9f91-ec3a0ed881f0",
                        "source_sense_description": "study of the discipline and practice of history",
