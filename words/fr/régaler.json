    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dc255053-c218-3d0a-a3d2-d380679a2623",
                    "sense_definition": "Prendre un vif plaisir gustatif en mangeant ou en buvant de bonnes choses.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "nourriture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants se <w>régalent</w> toujours lorsqu'ils mangent des crêpes au chocolat le dimanche."
                        },
                        {
                            "text": "Nous nous sommes <w>régalés</w> avec cette excellente tarte aux pommes préparée par notre grand-mère."
                        }
                    ],
                    "synonyms": [
                        "savourer",
                        "déguster"
                    ],
                    "common_phrases": [
                        "se régaler les papilles",
                        "se régaler d'avance"
                    ]
                },
                {
                    "sense_id": "0abd41c2-c968-369b-826c-73b3cea24498",
                    "sense_definition": "Offrir un repas savoureux, une friandise ou une boisson agréable à quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nourriture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour célébrer son anniversaire, mon collègue a décidé de <w>régaler</w> toute la table au restaurant."
                        },
                        {
                            "text": "Ce chef passionné aime <w>régaler</w> ses invités avec des produits frais de son potager."
                        }
                    ],
                    "synonyms": [
                        "inviter",
                        "traiter"
                    ],
                    "common_phrases": [
                        "régaler ses invités",
                        "régaler la compagnie"
                    ]
                },
                {
                    "sense_id": "b0ab4d74-1ad5-3aaa-a95f-457d04cff460",
                    "sense_definition": "Procurer une grande satisfaction ou un plaisir divertissant très marqué.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plaisir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette pièce de théâtre comique me <w>régale</w> par ses dialogues brillants et ses quiproquos."
                        },
                        {
                            "text": "L'attaquant a su <w>régaler</w> les spectateurs grâce à des gestes techniques impressionnants."
                        }
                    ],
                    "synonyms": [
                        "enchanter",
                        "ravir"
                    ],
                    "antonyms": [
                        "ennuyer"
                    ],
                    "common_phrases": [
                        "régaler la galerie",
                        "régaler le public"
                    ]
                },
                {
                    "sense_id": "12ba32f5-ce5c-3dfd-9f68-6b220e435ed3",
                    "sense_definition": "Maltraiter ou rouer de coups, employé par antiphrase ou dérision.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le voleur surpris dans la grange a été <w>régalé</w> de plusieurs coups de bâton."
                        },
                        {
                            "text": "Si le coupable revient par ici, nous le <w>régalerons</w> d'une sévère correction."
                        }
                    ],
                    "synonyms": [
                        "rouer",
                        "battre"
                    ],
                    "common_phrases": [
                        "régaler de coups"
                    ]
                },
                {
                    "sense_id": "79d3de34-c9b8-35b9-81fe-a80e6e15f337",
                    "sense_definition": "Étaler du sable, de la terre ou du gravier pour mettre un sol à niveau.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers doivent <w>régaler</w> le gravier avant d'entamer la pose des dalles extérieures."
                        },
                        {
                            "text": "Le conducteur de pelleteuse a passé toute la journée à <w>régaler</w> les terres meubles."
                        }
                    ],
                    "synonyms": [
                        "niveler",
                        "égaliser",
                        "aplanir"
                    ],
                    "common_phrases": [
                        "régaler la terre",
                        "régaler le terrain"
                    ]
                }
            ]
        }
    ]
