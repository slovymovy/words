                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed0592ed-505e-4a0e-b3c1-728a310e3637",
                                                "sense_id": "7c17d31e-8fa5-3413-802e-c665ff4d451e",
                                                "text": "„Mit Ayurveda kommen Sie wieder ins Gleichgewicht. Dies geschieht durch vielfältige Kräuteranwendungen, eine spezielle Ernährungsweise, wohl tuende Massagen mit speziell bereiteten Kräuterölen, Bäder, Aromatherapie oder auch durch Yoga und Meditation.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
