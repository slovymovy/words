                                "target_senses": [
                                    {
                                        "sense_id": "f1debbbe-9f89-36e8-bc43-1dca11c203a5",
                                        "entry_id": "bb2be68b-4799-3aa0-9916-677525732be6",
                                        "glosses": [
                                            "A bed covering consisting of two layers of fabric stitched together, with insulation between, often having a decorative design."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d894464a-47b4-405f-bc64-cd4900a3262b",
                                                "sense_id": "f1debbbe-9f89-36e8-bc43-1dca11c203a5",
                                                "text": "My grandmother is going to sew a quilt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "070cdb70-468a-3aea-acd3-d925a2256d3e",
                                        "entry_id": "bb2be68b-4799-3aa0-9916-677525732be6",
                                        "glosses": [
                                            "A roll of material with sound-absorbing properties, used in soundproofing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b8ba4a4-2644-3615-b380-e00902f0b0e7",
                                        "entry_id": "bb2be68b-4799-3aa0-9916-677525732be6",
                                        "glosses": [
                                            "A quilted skirt worn by women."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "158ab31b-1318-3d75-907b-faf3d4b87813",
                                        "entry_id": "bb2be68b-4799-3aa0-9916-677525732be6",
                                        "glosses": [
                                            "Something composed of a variety of stitched-together parts; a patchwork."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b06d8d7-e0f5-4b0c-8435-92f6a35d0ede",
                                                "sense_id": "158ab31b-1318-3d75-907b-faf3d4b87813",
                                                "text": "Her humor was as bawdy as ever, and evenly placed throughout. Early on […] she alternated alternated jokes and stanzas, providing a wonderful quilt of her musical and story-telling talents."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quilt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "281bbf5a-39ec-3a36-86ba-eb27c284063b",
                                        "entry_id": "3891231e-7325-3956-8fee-bb4c83854408",
                                        "glosses": [
                                            "To construct a quilt."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "986de458-22fe-36a5-be08-ba98cb6f5c9c",
                                        "entry_id": "3891231e-7325-3956-8fee-bb4c83854408",
                                        "glosses": [
                                            "To construct something, such as clothing, using the same technique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e22b7ec-f6e3-46c2-96de-1a7da681e1df",
                                                "sense_id": "986de458-22fe-36a5-be08-ba98cb6f5c9c",
                                                "text": "Get up, get up for shame, the blooming morne / Upon her wings presents the god unshorne. / See how Aurora throwes her faire / Fresh-quilted colours through the aire; / Get up, sweet slug-a-bed, and see / The dew bespangling herbe and tree."
                                            },
                                            {
                                                "example_id": "20476f22-4f2c-4d01-98a1-53bfe19c9fd4",
                                                "sense_id": "986de458-22fe-36a5-be08-ba98cb6f5c9c",
                                                "text": "Two hundred Sempſtreſſes were employed to make me Shirts, and Linen for Bed and Table, all of the ſtrongeft and coarſeſt kind they could get; which, however, they were forced to quilt together in ſeveral Folds, for the thickeſt was ſome degrees finer than Lawn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0d88437-a338-3f68-bf0f-e997515973d2",
                                        "entry_id": "3891231e-7325-3956-8fee-bb4c83854408",
                                        "glosses": [
                                            "To beat or thrash."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "625647ed-151b-4e05-8a62-e6fff8c322f8",
                                                "sense_id": "a0d88437-a338-3f68-bf0f-e997515973d2",
                                                "text": "I am glad, said Mr. Slick, that cussed critter, that schoolmaster, hasn't yet woke up. I'm most afeerd if he had aturned out afore we started, I should have quilted him, for that talk of his last night sticks in my crop considerable hard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c54eea29-06e9-4d70-a2a0-1f591c0ba00c",
                        "source_entry_id": "fa7b7082-c01b-367a-9c91-4cdf4cc1b8f4",
                        "target_lang_word": "deken",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deken",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0429f3ab-4cc6-366c-888c-772514b28d2e",
                                        "entry_id": "beecf87c-7f5f-3001-b936-a54d08818a13",
                                        "glosses": [
                                            "een (vaak dikke) doek, met de functie om iemand te bedekken en daarmee warm te houden (tijdens de slaap)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e5fad5a-5c7f-4145-9e81-c1efbf6237d1",
                                                "sense_id": "0429f3ab-4cc6-366c-888c-772514b28d2e",
                                                "text": "Ze zaten op de her en der verspreide strobalen, op het stro op de grond of op dekens, en sommigen hadden een deken om zich heen geslagen."
                                            },
                                            {
                                                "example_id": "4dacaffd-ebea-4fb5-b3f4-8f11a7d56651",
                                                "sense_id": "0429f3ab-4cc6-366c-888c-772514b28d2e",
                                                "text": "`Ach Pietje,' zei Sint, 'in die grauwe deken ben ik toch Sinterklaas.'"
                                            },
                                            {
                                                "example_id": "ba104f6b-081e-49ec-8189-4a7f290f01e1",
                                                "sense_id": "0429f3ab-4cc6-366c-888c-772514b28d2e",
                                                "text": "De ochtendjas waar ze met een driftige beweging in schoot voelde aan als een extra deken op een zwoele zomernacht."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "deken",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1408f92d-966f-3af7-8735-edae0b1b9c06",
                                        "entry_id": "87334046-1b30-34a8-be56-4a89916b5789",
                                        "glosses": [
                                            "voorzitter van de Nederlandse orde van advocaten"
                                        ],
                                        "tags": [
