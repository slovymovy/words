        "fr-extract.jsonl": [
            {
                "entry_id": "b24f13cb-6d59-38eb-80cd-1115ff739001",
                "word": "cubique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6f449556-185e-4bd1-b6f9-258158ac4aac",
                        "entry_id": "b24f13cb-6d59-38eb-80cd-1115ff739001",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "cubiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "83ba5490-9e77-3e51-a16f-5ebaf873d739",
                        "entry_id": "b24f13cb-6d59-38eb-80cd-1115ff739001",
                        "glosses": [
                            "Relatif au cube."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d7b60a0-f391-4d46-8c6a-65e8628f3214",
                                "sense_id": "83ba5490-9e77-3e51-a16f-5ebaf873d739",
                                "text": "Le lendemain, après le dîner, nous partîmes à midi et demi tous munis d’un cubique morceau de pain que l’on nous distribuait d’avance pour notre goûter."
                            },
                            {
                                "example_id": "fea25620-5cc3-4087-8d0a-c2497ad466ab",
                                "sense_id": "83ba5490-9e77-3e51-a16f-5ebaf873d739",
                                "text": "Le « castelet » est aussi très employé, […]. C'est une boîte cubique en fer-blanc à double fond ; […]."
                            },
                            {
                                "example_id": "c44746d8-4f17-4ad5-92c2-65d9217da4b1",
                                "sense_id": "83ba5490-9e77-3e51-a16f-5ebaf873d739",
                                "text": "Les carbones sont des diamants polycristallins formés d'une matrice poreuse de cristallites anhédrales de très petites dimensions, de 0,5 à 20 microns, orientées au hasard, et entourant parfois des cristaux octaédriques ou cubiques bien formés de diamant, qui seraient de première génération, et atteignent 500 μ."
                            }
                        ]
                    },
                    {
                        "sense_id": "250cb468-0c40-3b3f-9d62-2a9e0304b967",
                        "entry_id": "b24f13cb-6d59-38eb-80cd-1115ff739001",
                        "glosses": [
                            "Qui a rapport au cube d’un nombre, d’une équation, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29e72b06-c37d-4aa9-9bc1-4311e37d7799",
                                "sense_id": "250cb468-0c40-3b3f-9d62-2a9e0304b967",
                                "text": "La façon d’exprimer la valeur de toutes les racines des équations cubiques, et ensuite de toutes celles qui ne montent que jusqu’au carré de carré."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f85379d-24d3-43a9-99e3-6d7097c90cff",
                        "source_entry_id": "b24f13cb-6d59-38eb-80cd-1115ff739001",
                        "target_lang_word": "kubisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kubisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54633667-0fad-3e08-984e-bb0e9b90a929",
                                        "entry_id": "5e79f76e-912f-327c-9e44-888096a7034e",
                                        "glosses": [
                                            "geometrische Eigenschaft von Würfeln (= Kuben), bei denen alle Seiten gleich lang und alle Innenwinkel gleich groß sind"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cfab819-7bbe-41c0-8bfc-b629feb471fe",
                                                "sense_id": "54633667-0fad-3e08-984e-bb0e9b90a929",
                                                "text": "Von der Decke hängen kleine, kubische Lautsprecher. Sie zeigen in verschiedene Richtungen des Raums."
                                            },
                                            {
                                                "example_id": "584d4961-d759-4780-ba3d-c5871adffe89",
                                                "sense_id": "54633667-0fad-3e08-984e-bb0e9b90a929",
                                                "text": "Dieser Bau wird nun durch die neue Kirche ersetzt. Das kubische Gebäude mit seinem 50 Meter hohen Glockenturm steht gegenüber dem Neuen Rathaus."
                                            },
                                            {
                                                "example_id": "ed091fe0-bea1-4793-9806-5ca65470f2ad",
                                                "sense_id": "54633667-0fad-3e08-984e-bb0e9b90a929",
                                                "text": "„Der Bahnhof ist eine bemerkenswerte kubische Konstruktion aus einzelnen Elementen, die erstens erlauben, dass sich eine hohe Funktionalität ergibt, die dann aber auch eine sehr abgewogene Komposition ergeben.“ Genau das sei moderne Architektur, sagt Kurator Voigt."
                                            },
                                            {
                                                "example_id": "edc71b7a-60df-4f74-899c-c75bb4025f11",
                                                "sense_id": "54633667-0fad-3e08-984e-bb0e9b90a929",
                                                "text": "Schon acht Jahre vor der Bauhaus-Gründung, im Jahr 1911, war Gropius ein bahnbrechendes Beispiel des „Neuen Bauens“ gelungen: Gemeinsam mit dem Kollegen Adolf Meyer hatte er das „Faguswerk“ im niedersächsischen Alfeld entworfen, eine Schuhleistenfabrik mit klaren kubischen Formen und transparenten Konstruktionen aus Stahl und Glas, die dem Bau eine bis dahin unbekannte Leichtigkeit geben."
                                            },
                                            {
                                                "example_id": "3cc9f5be-80df-4dc4-b445-f9c1bd107902",
                                                "sense_id": "54633667-0fad-3e08-984e-bb0e9b90a929",
                                                "text": "Es ist möglich, dass die Achsen eines triklinen Kristalls gleich lang sind und jeweils 90° einschließen. Daraus folgt nicht, dass der Kristall kubisch ist."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3170b141-9e74-3568-a4bb-ba29ad517428",
                                        "entry_id": "5e79f76e-912f-327c-9e44-888096a7034e",
                                        "glosses": [
                                            "in der dritten Potenz"
                                        ],
                                        "tags": [
                                            "Algebra"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1607dcd-5289-427d-96dd-4493b6244ad2",
                                                "sense_id": "3170b141-9e74-3568-a4bb-ba29ad517428",
                                                "text": "Omar Chayyam beschäftigte sich viel mit Geometrie, Zahlentheorie und der Lösung kubischer Gleichungen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
