                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce7b488c-700c-4426-88b4-8d551ff2b4b8",
                                "sense_id": "c27e83c4-e6e0-3c26-89a4-98cf4c9ea9b7",
                                "text": "Eine Verkettung unglücklicher Ereignisse führte zu seinem Tod."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dcc58e14-50ec-3135-9d48-581c02b440a3",
                        "entry_id": "c63b8a0c-a5d4-3337-99fd-b4c625e1919d",
                        "glosses": [
                            "eine Verknüpfung, bei der mehrere Wörter aneinandergehängt werden"
                        ],
                        "tags": [
                            "theoretische Informatik"
                        ],
                        "examples": [
                            {
                                "example_id": "8d1ad81f-2c7f-4255-803b-d4f9559cfab1",
                                "sense_id": "dcc58e14-50ec-3135-9d48-581c02b440a3",
                                "text": "Die Verkettung des Wortes u=wik und v=tionary ergibt das Wort u∘v=wiktionary."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "75569e45-9ef6-3804-a09f-800c160ad200",
                        "entry_id": "c63b8a0c-a5d4-3337-99fd-b4c625e1919d",
                        "glosses": [
                            "Hintereinanderausführung von Funktionen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9681fc62-f8bd-49f8-8293-d7c8e6d1df61",
                                "sense_id": "75569e45-9ef6-3804-a09f-800c160ad200",
                                "text": "„Wir können also argumentieren: f ist als Verkettung stetiger Funktion stetig.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67328ca8-4537-4ece-bedb-e973305f8605",
                        "source_entry_id": "c63b8a0c-a5d4-3337-99fd-b4c625e1919d",
                        "source_sense_id": "c27e83c4-e6e0-3c26-89a4-98cf4c9ea9b7",
                        "source_sense_description": "das (kausale) Hintereinander-Geschehen von Ereignissen",
                        "target_lang_word": "enchaînement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enchaînement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "179252d7-5ca3-3075-a993-07ac5811d027",
                                        "entry_id": "8f0670c7-5a7a-31bf-98e0-0536bd0c17f7",
                                        "glosses": [
                                            "Variante orthographique de enchainement."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc8c426a-eb52-4d40-85cd-3aa7b6266f99",
                                                "sense_id": "179252d7-5ca3-3075-a993-07ac5811d027",
                                                "text": "L’enchaînement des répliques est donc fondamental car il imprime à la pièce son rythme et son tempo intérieur."
                                            },
                                            {
                                                "example_id": "178655fc-ab09-44cc-9ed5-2a4c95ceef16",
                                                "sense_id": "179252d7-5ca3-3075-a993-07ac5811d027",
                                                "text": "Le jazz c'est chiant en fait. Certes les musiciens touchaient leur bille mais les mélodies sont toujours pourraves. Ça ne raconte rien, seulement un enchaînement de notes sans histoire. Les musiques sans saveur ni paroles, c'est bon pour les ascenseurs."
                                            },
                                            {
                                                "example_id": "3c777866-5979-4e17-93c8-fab10966b637",
                                                "sense_id": "179252d7-5ca3-3075-a993-07ac5811d027",
                                                "text": "Pour des \"délits\" mineurs, le châtiment va de la privation de repas à l’enchaînement sur une barre de justice, ou dans un carcan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0081ae18-1d94-440c-8eb5-74615a4facc7",
                        "source_entry_id": "c63b8a0c-a5d4-3337-99fd-b4c625e1919d",
                        "source_sense_id": "c27e83c4-e6e0-3c26-89a4-98cf4c9ea9b7",
