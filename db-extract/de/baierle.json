                ],
                "senses": [
                    {
                        "sense_id": "531bf793-c52a-3f15-8aaf-b9d7418eb9da",
                        "entry_id": "79a73c3f-b03f-3ebb-8aeb-d6f9915d423e",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a341ff4-2648-4633-9270-e929b962cc88",
                                "sense_id": "531bf793-c52a-3f15-8aaf-b9d7418eb9da",
                                "text": "Frau Baierle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8e4a3fd9-9e75-4612-a98f-44d6333c4c6d",
                                "sense_id": "531bf793-c52a-3f15-8aaf-b9d7418eb9da",
                                "text": "Herr Baierle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9336d595-02f1-4cd5-93d0-4c9e32d7e442",
                                "sense_id": "531bf793-c52a-3f15-8aaf-b9d7418eb9da",
                                "text": "Die Baierles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "61e6e8c0-ef3e-4647-be5f-f72a24acb507",
                                "sense_id": "531bf793-c52a-3f15-8aaf-b9d7418eb9da",
                                "text": "Der Baierle trägt nie die Schals, die die Baierle ihm strickt."
                            },
                            {
                                "example_id": "770dfa76-d9de-43a0-b0aa-dd60dd58f6d7",
                                "sense_id": "531bf793-c52a-3f15-8aaf-b9d7418eb9da",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Baierle kommt, geht der Herr Baierle.“"
                            },
                            {
                                "example_id": "8a30e101-a16a-4002-99e2-abf5bec28075",
                                "sense_id": "531bf793-c52a-3f15-8aaf-b9d7418eb9da",
                                "text": "Baierle kommt und geht."
                            },
                            {
                                "example_id": "d75396d7-8eba-4946-b535-7d1a0855277d",
                                "sense_id": "531bf793-c52a-3f15-8aaf-b9d7418eb9da",
                                "text": "Baierles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
