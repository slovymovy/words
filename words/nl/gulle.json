                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "inflection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>gulle</w> aanbod werd direct door de directie geaccepteerd.",
                            "target_lang_translations": {
                                "zh": "董事会立即接受了那份<w>慷慨的</w>提议。"
                            }
