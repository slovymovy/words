                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e049a33-8762-473f-bd3c-6e5f63445160",
                                "sense_id": "69256864-e8ff-33fa-8949-4af85bd6b5f0",
                                "text": "Otto verschijnt met een mand turf in de deuropening."
                            },
                            {
                                "example_id": "77b1673c-863e-4f8e-a6fc-16932d7d2314",
                                "sense_id": "69256864-e8ff-33fa-8949-4af85bd6b5f0",
                                "text": "Hierna knikte hij begripvol tegen zijn vrouw, die hem vanuit de deuropening duidelijk maakte dat ze op het punt stond om naar bed te gaan."
                            },
                            {
                                "example_id": "06828c28-0891-4bde-abde-02a99aba2c0f",
                                "sense_id": "69256864-e8ff-33fa-8949-4af85bd6b5f0",
                                "text": "In de deuropening van het huis staat Nella te huiveren als hij aarzelend zijn hand opsteekt."
                            }
                        ]
                    }
