                    {
                        "translation_id": "be82ebcc-7e7a-42e7-a4ea-9ae3a0bf4dc1",
                        "source_entry_id": "0db78f6f-a83a-3a86-99d8-91e331029133",
                        "source_sense_id": "88c3a06f-d569-33d6-a2b9-3a93a81ffd7e",
