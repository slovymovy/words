                            {
                                "example_id": "fac2d1ca-642f-47a6-944f-7279e98b8563",
                                "sense_id": "966def35-ad81-3dbe-ae2b-c6d4d776759f",
                                "text": "Ils [les Russes] donnent à cette plante le nom de Katran blanc. Ils appellent au contraire le statice, dont je viens de faire mention, le vrai Katran ou Katran rouge."
                            }
