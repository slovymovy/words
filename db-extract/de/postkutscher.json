                ],
                "translations": [
                    {
                        "translation_id": "815f3e08-2960-41ac-9b06-dc799665eb97",
                        "source_entry_id": "47ae2e4f-abbd-377e-864a-17bdb891b2ea",
                        "source_sense_id": "15ebf821-98d9-3fa4-ab4e-7394cdbb78c2",
