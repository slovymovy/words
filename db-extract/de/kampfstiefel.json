                "senses": [
                    {
                        "sense_id": "ed9c1778-9138-3bfd-a642-228031cdbfbc",
                        "entry_id": "5430d31e-0d6d-30c8-8c35-1144805bd1b2",
                        "glosses": [
                            "Stiefel, der von Soldaten getragen wird, Teil einer Kampfmontur ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed8ea5a5-65f0-4edd-993b-656b7ddc0b7a",
                                "sense_id": "ed9c1778-9138-3bfd-a642-228031cdbfbc",
                                "text": "„Es handelte sich um ein Paar Kampfstiefel, die nie einen Kampf erlebt hatten.“"
                            },
                            {
                                "example_id": "154052c4-aa10-4aa2-a957-1cbadba83bb0",
                                "sense_id": "ed9c1778-9138-3bfd-a642-228031cdbfbc",
                                "text": "„Die Haustür öffnete sich, und Russell trat ein, immer noch mit der schwarzen Mütze, der dunklen schenkellangen Jacke und den Kampfstiefeln.“"
                            },
                            {
                                "example_id": "99474611-fa78-465a-8da6-b14e2469dec5",
                                "sense_id": "ed9c1778-9138-3bfd-a642-228031cdbfbc",
                                "text": "„Er trug einen Tarnanzug, komplett mit Fallschirmspringerhose, Militärgürtel und Kampfstiefeln, dazu hatte er sich Tarnfarbe ins Gesicht geschmiert und eine Militärkappe aufgesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
