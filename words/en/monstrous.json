{
    "word_family": [
        "monster",
        "monstrosity",
        "monstrously",
        "monstrousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7f51922f-09a3-3871-9d7e-df1f4bda3e6d",
                    "sense_definition": "Shockingly hideous, cruel, or evil.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cruel_hideous",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dictator was condemned across the globe for his <w>monstrous</w> cruelty.",
                            "target_lang_translations": {
                                "tr": "Diktatör, <w>canavarca</w> zalimliği nedeniyle tüm dünyada kınandı."
                            }
                        },
                        {
                            "text": "Committing such an act against innocent people is a <w>monstrous</w> crime.",
                            "target_lang_translations": {
                                "tr": "Masum insanlara karşı böyle bir eylemde bulunmak <w>korkunç</w> bir suçtur."
                            }
                        }
                    ],
                    "common_phrases": [
                        "monstrous crime",
                        "monstrous act",
                        "monstrous cruelty"
                    ],
                    "target_lang_definitions": {
                        "tr": "Şok edici derecede korkunç, zalimce veya kötü olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "canavarca",
                                "target_lang_sense_clarification": "zalimce veya insanlık dışı davranışlar için"
                            },
                            {
                                "target_lang_word": "korkunç",
                                "target_lang_sense_clarification": "dehşet verici kötülük veya zulüm için"
                            },
                            {
                                "target_lang_word": "akıl almaz",
                                "target_lang_sense_clarification": "şok edici kötülükler için"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3a08c21-5392-33f4-ac2d-6bfff155d249",
                    "sense_definition": "Enormously or abnormally large; gigantic.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>monstrous</w> wave crashed against the tiny fishing boat during the storm.",
                            "target_lang_translations": {
                                "tr": "Fırtına sırasında <w>devasa</w> bir dalga küçük balıkçı teknesine çarptı."
                            }
                        },
                        {
                            "text": "The company reported a <w>monstrous</w> profit after the holiday shopping season.",
                            "target_lang_translations": {
                                "tr": "Şirket, tatil alışverişi sezonunun ardından <w>muazzam</w> bir kâr bildirdi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "monstrous wave",
                        "monstrous size"
                    ],
                    "target_lang_definitions": {
                        "tr": "Son derece veya olağan dışı derecede büyük; devasa."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "devasa",
                                "target_lang_sense_clarification": "muazzam büyüklükte"
                            },
                            {
                                "target_lang_word": "muazzam",
                                "target_lang_sense_clarification": "çok büyük hacim, miktar veya boyut için"
                            },
                            {
                                "target_lang_word": "kocaman",
                                "target_lang_sense_clarification": "aşırı büyük"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7667d022-84a2-3ffa-a681-7a435c348877",
                    "sense_definition": "Grotesque, unnatural, or freakish in appearance or character.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "freakish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient stone statue had a <w>monstrous</w> appearance with multiple heads.",
                            "target_lang_translations": {
                                "tr": "Antik taş heykel, birden fazla başıyla <w>ucube gibi</w> bir görünüme sahipti."
                            }
                        },
                        {
                            "text": "He refused to accept such <w>monstrous</w> ideas into his philosophy of life.",
                            "target_lang_translations": {
                                "tr": "Böylesine <w>garip</w> fikirleri yaşam felsefesine dahil etmeyi reddetti."
                            }
                        }
                    ],
                    "common_phrases": [
                        "monstrous appearance"
                    ],
                    "target_lang_definitions": {
                        "tr": "Görünüş veya nitelik olarak ucube gibi, doğal olmayan veya acayip."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ucube gibi",
                                "target_lang_sense_clarification": "şekilsiz ve tuhaf görünüşler için"
                            },
                            {
                                "target_lang_word": "garip",
                                "target_lang_sense_clarification": "doğal olmayan ve tuhaf"
                            },
                            {
                                "target_lang_word": "hilkat garibesi",
                                "target_lang_sense_clarification": "biçimsiz veya korkutucu görünümler için"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e2ac623-9f64-39ff-9e35-58c871f5fa09",
                    "sense_definition": "Exceedingly strange, fantastical, or absurd.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unbelievable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rumor spreading through the village was a <w>monstrous</w> lie with no truth to it.",
                            "target_lang_translations": {
                                "tr": "Köyde yayılan dedikodu, aslı astarı olmayan <w>kuyruklu</w> bir yalandı."
                            }
                        },
                        {
                            "text": "She found the entire explanation completely <w>monstrous</w> and refused to believe it.",
                            "target_lang_translations": {
                                "tr": "Tüm açıklamayı büsbütün <w>akıl almaz</w> buldu ve inanmayı reddetti."
                            }
                        }
                    ],
                    "common_phrases": [
                        "monstrous lie"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used historically to describe fantastical or marvelous things"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Son derece tuhaf, akıl almaz veya saçma."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kuyruklu",
                                "target_lang_sense_clarification": "yalanlar için (kuyruklu yalan)"
                            },
                            {
                                "target_lang_word": "akıl almaz",
                                "target_lang_sense_clarification": "inanılması güç ve saçma şeyler için"
                            },
                            {
                                "target_lang_word": "saçma sapan",
                                "target_lang_sense_clarification": "aşırı mantıksız ve kabul edilemez durumlar için"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4358430-2825-334c-808e-5cf1210cb660",
                    "sense_definition": "Of, relating to, or populated by monsters.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mythology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hero ventured into the <w>monstrous</w> depths of the ocean to fight mythical beasts.",
                            "target_lang_translations": {
                                "tr": "Kahraman, efsanevi yaratıklarla savaşmak için okyanusun <w>canavarlarla dolu</w> derinliklerine cesaretle indi."
                            }
                        },
                        {
                            "text": "Ancient sailors believed the uncharted seas were filled with <w>monstrous</w> creatures.",
                            "target_lang_translations": {
                                "tr": "Eski denizciler, haritası çıkarılmamış denizlerin <w>canavarca</w> yaratıklarla dolu olduğuna inanırdı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "monstrous world"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Literary or archaic usage describing regions filled with monsters"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Canavarlarla ilgili veya canavarlarla dolu olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "canavarlarla dolu",
                                "target_lang_sense_clarification": "canavarların istila ettiği veya yaşadığı yerler için"
                            },
                            {
                                "target_lang_word": "canavarca",
                                "target_lang_sense_clarification": "canavarlara özgü"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "908e4e1b-4912-3dc0-8293-f3a4d9450c10",
                    "sense_definition": "Used as a severely offensive insult to demean a person with physical disabilities or deformities.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cruel critic made a <w>monstrous</w> remark targeting the actor's physical disability.",
                            "target_lang_translations": {
                                "tr": "Acımasız eleştirmen, oyuncunun fiziksel engelini hedef alan <w>korkunç</w> bir yorum yaptı."
                            }
                        },
                        {
                            "text": "Calling another human being <w>monstrous</w> solely due to their condition is deeply unacceptable.",
                            "target_lang_translations": {
                                "tr": "Sırf durumundan ötürü başka bir insana <w>ucube</w> demek son derece kabul edilemezdir."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Highly derogatory and offensive insult"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Fiziksel engeli veya deformasyonu olan birini aşağılamak için kullanılan ağır hakaret."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ucube",
                                "target_lang_sense_clarification": "aşağılayıcı ve kaba hakaret"
                            },
                            {
                                "target_lang_word": "canavar",
                                "target_lang_sense_clarification": "kaba ve kırıcı niteleme"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}