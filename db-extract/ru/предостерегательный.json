                "senses": [
                    {
                        "sense_id": "4c846265-45d6-319b-b257-1c48d4ec7208",
                        "entry_id": "41199f9a-b693-3e5a-8bc6-97208109782c",
                        "glosses": [
                            "устар., книжн. служащий для предостережения, предостерегающий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec769b77-0132-4b3e-a278-bb90f9d378ce",
                                "sense_id": "4c846265-45d6-319b-b257-1c48d4ec7208",
                                "text": "Предостерегательный тон моего приятеля сделал было во мне некоторое впечатление, но оно скоро миновало."
                            }
                        ]
                    },
                    {
                        "sense_id": "c394ffe9-e553-34f4-80d6-edb96be39b8e",
                        "entry_id": "41199f9a-b693-3e5a-8bc6-97208109782c",
                        "glosses": [
                            "морск. служащий для предостережения, для ограждения судов от опасностей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46249a6e-9344-4239-a737-42dd12089e9c",
                                "sense_id": "c394ffe9-e553-34f4-80d6-edb96be39b8e",
                                "text": "Береговые предостерегательные знаки."
                            },
                            {
                                "example_id": "9c83c46b-927a-462f-ade3-8a3dedcbf9b0",
                                "sense_id": "c394ffe9-e553-34f4-80d6-edb96be39b8e",
                                "text": "Плавучие предостерегательные знаки."
                            }
                        ]
