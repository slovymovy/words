                        "glosses": [
                            "Of a roll of film: incorrectly wound, resulting in humps that appear as radial lines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d883a7e-c406-4466-afe3-6dc36b62e59e",
                                "sense_id": "1346dc60-ca30-3a86-a30b-a4cfc1661a4d",
                                "text": "A spoky roll is shown beside a smooth roll in Figure 1. Spokiness occurs both with 35mm and with 16mm film but does not appear to cause projection difficulties with 35mm film."
                            },
                            {
                                "example_id": "14df682c-1bd4-4c1c-8755-41c4e75cf4cc",
                                "sense_id": "1346dc60-ca30-3a86-a30b-a4cfc1661a4d",
                                "text": "When a spoky roll is stored for a long time, the film flows permanently into the spoky condition, resulting in film distortion."
                            }
                        ]
                    }
