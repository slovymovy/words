                "senses": [
                    {
                        "sense_id": "95040517-8122-330d-af98-223b66b52212",
                        "entry_id": "2088ee43-804e-3bfc-a521-2049dc3ea878",
                        "glosses": [
                            "Aviron placé à l’arrière d’un canot, d’une embarcation légère et qui les fait avancer par un mouvement spécial."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da3f7686-06db-4922-8f75-63e8eccc7006",
                                "sense_id": "95040517-8122-330d-af98-223b66b52212",
                                "text": "Une godille fut installée, qui permettait de gouverner l’appareil."
                            },
                            {
                                "example_id": "26b27c44-4af2-4e46-8849-57f17ea7b0fc",
                                "sense_id": "95040517-8122-330d-af98-223b66b52212",
                                "text": "Un jour, en bateau, voulant manier la godille à grand renflement de biceps, il tombait dans la Loire ; une autre fois, qu’il caracolait à la portière du landau, sa bête le serrait si durement contre la roue, qu’on était obligé de le garder et cataplasmer à la chambre plusieurs jours."
                            },
                            {
                                "example_id": "ae1b1626-1c80-41ad-8a1b-288b9bf899ad",
                                "sense_id": "95040517-8122-330d-af98-223b66b52212",
                                "text": "Il était rouge d’avoir couru et il haletait tandis que le vieux François poussait lentement son bachot à la godille."
                            }
                        ]
                    },
                    {
