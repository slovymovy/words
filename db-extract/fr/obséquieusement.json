                        "glosses": [
                            "D’une manière obséquieuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58c996ad-a359-4f83-bbb9-e5ac4fe9956b",
                                "sense_id": "d63de787-df4d-38b8-8bfd-d72752e5a3b8",
                                "text": "Tu es d’autant plus sage, dit Jean avec un éclat de rire auquel s’associa obséquieusement sa suite ; …."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fcbc17d4-b3eb-41c8-b881-86cee4a46be7",
                        "source_entry_id": "5fe5d36f-5b7c-3796-b611-50f845c4e9b0",
                        "source_sense_id": "d63de787-df4d-38b8-8bfd-d72752e5a3b8",
                        "target_lang_word": "obsequiously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obsequiously",
