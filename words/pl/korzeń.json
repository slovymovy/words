                    }
                },
                {
                    "sense_id": "9f02f263-689f-375a-a56d-f1927677b158",
                    "sense_definition": "nazwisko noszone przez kobiety",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pani <w>Korzeń</w> pracuje w szkole jako nauczycielka biologii od wielu lat.",
                            "target_lang_translations": {
                                "ru": "Госпожа <w>Кожень</w> много лет работает в школе учителем биологии."
                            }
                        },
                        {
                            "text": "Anna <w>Korzeń</w> napisała interesujący artykuł o historii naszej miejscowości.",
                            "target_lang_translations": {
                                "ru": "Анна <w>Кожень</w> написала интересную статью об истории нашего населенного пункта."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
