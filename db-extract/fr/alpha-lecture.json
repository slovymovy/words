                        "examples": [
                            {
                                "example_id": "a2f46b04-e5b0-4db2-8fe1-aed7945421c1",
                                "sense_id": "235dc42e-0f98-34c6-8c62-d363d879e3ce",
                                "text": "L’alpha-lecture permet à l’auteur de tester des idées, de retoucher des personnages dès le début s’ils ne fonctionnent pas… Pour le lecteur, c’est beaucoup plus simple, car relire au chapitre est beaucoup plus souple et rapide."
                            },
                            {
                                "example_id": "78503b69-6f1a-42c3-aaf6-464b52a01b72",
                                "sense_id": "235dc42e-0f98-34c6-8c62-d363d879e3ce",
                                "text": "L’AL, c’est un peu différent. Il s’agit là d’alpha-lecture ; là où la BL se concentre sur une version finie d’un manu/tapuscrit, l’AL vous accompagne pendant l’écriture."
                            }
