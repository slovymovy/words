{
    "word_family": [
        "struggler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e4e67ed5-6b49-3191-8e9f-9b02a1dd3058",
                    "sense_definition": "To make a great effort to deal with a challenge, or to fight for or against something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small business had to <w>struggle</w> to survive during the economic crisis.",
                            "target_lang_translations": {
                                "ru": "Малому бизнесу пришлось <w>бороться</w> за выживание во время экономического кризиса.",
                                "zh": "在经济危机期间，这家小企业不得不<w>挣扎</w>求生。"
                            }
                        },
                        {
                            "text": "Many people <w>struggle</w> for freedom when their rights are taken away.",
                            "target_lang_translations": {
                                "ru": "Многие люди <w>борются</w> за свободу, когда их лишают прав.",
                                "zh": "当权利被剥夺时，许多人会为自由而<w>抗争</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strive",
                        "fight",
                        "labor"
                    ],
                    "antonyms": [
                        "surrender",
                        "yield"
                    ],
                    "common_phrases": [
                        "struggle to survive",
                        "struggle for freedom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прилагать большие усилия, чтобы справиться с трудностями, или бороться за что-либо или против чего-либо.",
                        "zh": "为了应对挑战而付出巨大努力，或为某事而奋斗、抗争。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бороться",
                                "target_lang_sense_clarification": "прилагать усилия для достижения цели или против чего-либо"
                            },
                            {
                                "target_lang_word": "сражаться",
                                "target_lang_sense_clarification": "вести упорную борьбу"
                            },
                            {
                                "target_lang_word": "биться",
                                "target_lang_sense_clarification": "напряженно работать, добиваясь чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "奋斗",
                                "target_lang_sense_clarification": "为达到目的而努力"
                            },
                            {
                                "target_lang_word": "挣扎",
                                "target_lang_sense_clarification": "在困难中努力维持或生存"
                            },
                            {
                                "target_lang_word": "抗争",
                                "target_lang_sense_clarification": "为反对某事而斗争"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b0223c1-0b7a-39e7-865a-0c30df39d965",
                    "sense_definition": "To have difficulty performing a task or dealing with a specific situation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He began to <w>struggle</w> with math as the lessons became more advanced.",
                            "target_lang_translations": {
                                "ru": "Математика стала <w>даваться</w> ему <w>с трудом</w>, когда уроки стали более сложными.",
                                "zh": "随着课程难度增加，他学起数学来开始感到<w>吃力</w>。"
                            }
                        },
                        {
                            "text": "I often <w>struggle</w> with directions when I visit a new city.",
                            "target_lang_translations": {
                                "ru": "Я часто <w>путаюсь</w> в ориентирах, когда посещаю новый город.",
                                "zh": "我去新城市时，经常在辨别方向上感到<w>费劲</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "falter"
                    ],
                    "antonyms": [
                        "excel"
                    ],
                    "common_phrases": [
                        "struggle with math",
                        "struggle with directions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать трудности при выполнении задачи или в определенной ситуации.",
                        "zh": "在执行任务或处理特定情况时感到困难。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "даваться с трудом",
                                "target_lang_sense_clarification": "о задаче или предмете"
                            },
                            {
                                "target_lang_word": "мучиться",
                                "target_lang_sense_clarification": "испытывать затруднения с чем-либо"
                            },
                            {
                                "target_lang_word": "бороться",
                                "target_lang_sense_clarification": "пытаться справиться с проблемой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吃力",
                                "target_lang_sense_clarification": "形容做某事感到费劲"
                            },
                            {
                                "target_lang_word": "费劲",
                                "target_lang_sense_clarification": "形容处理某事有困难"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69c6bc01-5b0d-311f-b47a-c5ea7d935fb5",
                    "sense_definition": "To move the body with great effort or twisting motions, especially to get free.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird started to <w>struggle</w> to escape from the net.",
                            "target_lang_translations": {
                                "ru": "Птица начала <w>биться</w>, чтобы выбраться из сети.",
                                "zh": "那只鸟开始<w>挣扎</w>着想要逃出网子。"
                            }
                        },
                        {
                            "text": "She had to <w>struggle</w> to get free from the heavy door.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>побороться</w>, чтобы высвободиться из-под тяжелой двери.",
                                "zh": "她不得不<w>挣扎</w>着从那扇沉重的门下脱身。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thrash",
                        "flounder",
                        "writhe"
                    ],
                    "common_phrases": [
                        "struggle to escape",
                        "struggle to get free"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершать резкие движения телом, пытаясь высвободиться или преодолеть физическое сопротивление.",
                        "zh": "身体用力扭动或挣扎，通常是为了摆脱束缚。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вырываться",
                                "target_lang_sense_clarification": "пытаться освободиться"
                            },
                            {
                                "target_lang_word": "биться",
                                "target_lang_sense_clarification": "совершать порывистые движения"
                            },
                            {
                                "target_lang_word": "барахтаться",
                                "target_lang_sense_clarification": "делать беспорядочные движения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挣扎",
                                "target_lang_sense_clarification": "用力摆脱束缚"
                            },
                            {
                                "target_lang_word": "扭动",
                                "target_lang_sense_clarification": "身体剧烈晃动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "563734fc-5df2-33af-96ca-27da91be2198",
                    "sense_definition": "A long and difficult effort to achieve something or to overcome a problem.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team faced a constant <w>struggle</w> to stay at the top of the league.",
                            "target_lang_translations": {
                                "ru": "Команда столкнулась с постоянной <w>борьбой</w> за сохранение лидерства в лиге.",
                                "zh": "该队为了保持联赛领先地位，面临着持续的<w>苦战</w>。"
                            }
                        },
                        {
                            "text": "It was a real <w>struggle</w> to finish the project on time.",
                            "target_lang_translations": {
                                "ru": "Завершить проект вовремя было настоящим <w>испытанием</w>.",
                                "zh": "按时完成这个项目真是一场<w>苦战</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "endeavor",
                        "battle",
                        "conflict"
                    ],
                    "antonyms": [
                        "ease"
                    ],
                    "common_phrases": [
                        "constant struggle",
                        "real struggle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Долгая и трудная работа или усилия для достижения чего-либо или преодоления проблемы.",
                        "zh": "为实现目标或克服问题而进行的长期且艰苦的努力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "борьба",
                                "target_lang_sense_clarification": "деятельность, направленная на достижение цели или преодоление трудностей"
                            },
                            {
                                "target_lang_word": "усилия",
                                "target_lang_sense_clarification": "напряжение сил для выполнения чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "奋斗",
                                "target_lang_sense_clarification": "长期的努力过程"
                            },
                            {
                                "target_lang_word": "苦战",
                                "target_lang_sense_clarification": "艰苦的斗争或努力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eaa9e2b3-cb1a-310f-b3bf-b3d85c2aa458",
                    "sense_definition": "A physical act of twisting or moving the body forcefully to escape or perform a task.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a brief <w>struggle</w>, the prisoner was finally handcuffed.",
                            "target_lang_translations": {
                                "ru": "После короткой <w>схватки</w> на заключенного наконец надели наручники.",
                                "zh": "经过一番短暂的<w>挣扎</w>，囚犯最终被戴上了手铐。"
                            }
                        },
                        {
                            "text": "The cat gave a sudden <w>struggle</w> and jumped out of my arms.",
                            "target_lang_translations": {
                                "ru": "Кошка внезапно <w>дернулась</w> и выпрыгнула у меня из рук.",
                                "zh": "猫突然<w>挣扎</w>了一下，从我怀里跳了出去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scuffle",
                        "tussle"
                    ],
                    "common_phrases": [
                        "brief struggle",
                        "sudden struggle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое усилие, сопровождающееся резкими движениями тела, чтобы вырваться или выполнить задачу.",
                        "zh": "为逃脱或完成任务而进行的剧烈身体扭动或反抗动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "схватка",
                                "target_lang_sense_clarification": "физическое противоборство"
                            },
                            {
                                "target_lang_word": "сопротивление",
                                "target_lang_sense_clarification": "физическое противодействие"
                            },
                            {
                                "target_lang_word": "борьба",
                                "target_lang_sense_clarification": "рукопашная стычка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挣扎",
                                "target_lang_sense_clarification": "试图摆脱时的动作"
                            },
                            {
                                "target_lang_word": "反抗",
                                "target_lang_sense_clarification": "身体上的抵触动作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}