                ],
                "senses": [
                    {
                        "sense_id": "33e98e15-ed3d-35b3-aa53-709ffaec786f",
                        "entry_id": "8c168cce-2f79-3e5f-8bee-e1dcaa2ab8ed",
                        "glosses": [
                            "A metropolitan area."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5ef4387-649d-44cd-a6a4-db8e8f9a5d9f",
                                "sense_id": "33e98e15-ed3d-35b3-aa53-709ffaec786f",
                                "text": "In an age of persistently high inequality, work in high-cost metros catering to the whims of the wealthy—grooming them, stretching them, feeding them, driving them—has become one of the fastest-growing industries. […] Relationships between the classes, once mediated through the household, are now managed through an app that serves a large metro area."
                            }
                        ]
                    }
                ],
