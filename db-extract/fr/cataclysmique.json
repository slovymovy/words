        "fr-extract.jsonl": [
            {
                "entry_id": "77120d6e-0234-33f0-a006-c08d690edaf6",
                "word": "cataclysmique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ff18806c-8d2e-44e6-86c8-1160d28618f4",
                        "entry_id": "77120d6e-0234-33f0-a006-c08d690edaf6",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "cataclysmiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1dd0685e-bf0c-3a1a-b68f-e2ff03cd1838",
                        "entry_id": "77120d6e-0234-33f0-a006-c08d690edaf6",
                        "glosses": [
                            "Relatif à un cataclysme géologique, météorologique, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9254cfdc-81d9-48e3-b6d9-dcaf1722ac42",
                                "sense_id": "1dd0685e-bf0c-3a1a-b68f-e2ff03cd1838",
                                "text": "Venise, menacée d’engloutissement, a réapparu au terme du récit, sauvée d’un ouragan cataclysmique qui voulait la rendre au chaos des origines."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb800a66-a1f6-354b-a83e-b6bf66cbddf2",
                        "entry_id": "77120d6e-0234-33f0-a006-c08d690edaf6",
                        "glosses": [
                            "De la nature d’un cataclysme."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f3b0a17c-7cc8-4d62-bd86-bd65d74f0f00",
                                "sense_id": "bb800a66-a1f6-354b-a83e-b6bf66cbddf2",
                                "text": "La même idéologie affligée avec les mêmes fixettes cataclysmiques."
                            },
                            {
                                "example_id": "08680cce-1f73-4153-b83f-bf59f253a1cb",
                                "sense_id": "bb800a66-a1f6-354b-a83e-b6bf66cbddf2",
                                "text": "Loin de l’image cataclysmique d’un journalisme détruit par le clic, ce sont ces nuances qu’il est nécessaire de comprendre et d’explorer afin de mieux assurer l’avenir de l’information sur Internet."
                            },
                            {
                                "example_id": "8942f904-b633-471e-9f64-b740a1966e19",
                                "sense_id": "bb800a66-a1f6-354b-a83e-b6bf66cbddf2",
                                "text": "Les rieurs faciles ignorent les secousses cataclysmiques du véritable rieur."
                            },
                            {
                                "example_id": "ac93fb07-9079-43dc-b0f0-47b9da966bf7",
                                "sense_id": "bb800a66-a1f6-354b-a83e-b6bf66cbddf2",
                                "text": "Nous entrerions alors soit dans l’ère posthumaniste, qui viendrait après l’ère humaniste et où l’humanité s’éteindrait, soit dans l’ère transhumaniste, au cours de laquelle une nouvelle forme d’humanité verrait le jour. Dans tous les cas, les transformations seraient cataclysmiques. Cependant, rien dans les machines existantes ne laisse présager un tel avenir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2aa4a44d-cbd6-49ff-b247-43eb91999e9e",
                        "source_entry_id": "77120d6e-0234-33f0-a006-c08d690edaf6",
                        "target_lang_word": "katastrophal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "katastrophal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a84c284-de4d-3f2b-b356-e17c388ee943",
                                        "entry_id": "7048382b-1419-3ec5-82c5-da736b146af3",
                                        "glosses": [
                                            "sehr schlimm, verhängnisvoll, entsetzlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef23ed6a-9df8-46cf-8498-3836d75009a6",
                                                "sense_id": "8a84c284-de4d-3f2b-b356-e17c388ee943",
                                                "text": "Die katastrophale Wirtschaftslage eines Landes wirkt sich auf andere Länder aus."
                                            },
                                            {
                                                "example_id": "f0279160-73f3-493a-8674-4321e622d3e4",
                                                "sense_id": "8a84c284-de4d-3f2b-b356-e17c388ee943",
                                                "text": "„Die enorme Auswanderungswelle, die Ende der 1960er, Anfang der 1970er Jahre auch Italien, vor allem den Süden des Landes, erfasst hatte, war eine Folge der katastrophalen Wirtschaftslage und der damit verbundenen Perspektivlosigkeit.“"
                                            },
                                            {
                                                "example_id": "f3ae5ed5-544a-4b7e-ad8a-c22a3e04f332",
                                                "sense_id": "8a84c284-de4d-3f2b-b356-e17c388ee943",
                                                "text": "„Keltische Kriegerscharen fielen, von Gallien kommend, in Italien ein, die Römer stellten sich ihnen in der Schlacht an der Allia und erlitten eine katastrophale Niederlage.“"
                                            },
                                            {
                                                "example_id": "7755cf5f-2bfd-481c-ac03-41a5b1444feb",
                                                "sense_id": "8a84c284-de4d-3f2b-b356-e17c388ee943",
                                                "text": "„Die Verkehrs- und Versorgungslage in Deutschland ist katastrophal in diesen Tagen [Anmerkung: im April 1945] […].“"
                                            },
                                            {
                                                "example_id": "df306c34-06e7-4220-a992-322c11a00c5e",
                                                "sense_id": "8a84c284-de4d-3f2b-b356-e17c388ee943",
                                                "text": "„Im Gegensatz zu vielen seiner Kollegen ist es Mugabe trotz seiner katastrophalen Politik bisher gelungen, die Armee ruhig und auf seiner Seite zu halten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a62a61d1-7f3f-473d-ba31-c47e4772119b",
                        "source_entry_id": "77120d6e-0234-33f0-a006-c08d690edaf6",
                        "target_lang_word": "sintflutartig",
                        "target_lang_code": "de",
