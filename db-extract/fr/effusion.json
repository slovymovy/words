                                            },
                                            {
                                                "example_id": "685d5448-3c4e-4a29-bf67-d1d8bdf2a0a7",
                                                "sense_id": "530f095b-2ce3-3cfb-b532-21cf78c751ae",
                                                "text": "William heeft ook verklaard dat wat hem betreft alles nu wel is gezegd over zijn moeder. Hij ziet in elk geval geen kans op herhaling van de openhartige ontboezemingen van hem en zijn broer. Met het verstrijken van de jaren wordt ook de groep Britten groter die nauwelijks weten wie de prinses was."
                                            },
                                            {
                                                "example_id": "eed6da3f-ceff-4a70-b3d9-61f71eba39ee",
                                                "sense_id": "530f095b-2ce3-3cfb-b532-21cf78c751ae",
                                                "text": "De rechtse kranten stonden vol met ontboezemingen over het thema dat schoonheid en geschiedenis onscheidbare grootheden waren en dat een gebouw dat mooi gevonden wilde worden symbool moest staan voor de eeuwige waarden, moest herinneren aan een trots en geestrijker verleden en dat platte daken bovendien on-Duits waren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12226372-788c-40c2-aac6-6ffd7345b337",
                        "source_entry_id": "69a7c1ea-7c84-3905-97b7-aa1e0d62ac4c",
                        "source_sense_description": "Vive et sincère manifestation d’un sentiment, épanchement.",
                        "target_lang_word": "hartelijkheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hartelijkheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5e7a1a2d-6fc4-3d04-8d86-7b0aff26556c",
                                        "entry_id": "cd79e27d-4b25-3a4b-bcc3-88f793cbf969",
                                        "glosses": [
                                            "het vriendelijk en gastvrij zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9710d866-8c3a-4f2b-aeb9-8d031dbf2074",
                                                "sense_id": "5e7a1a2d-6fc4-3d04-8d86-7b0aff26556c",
                                                "text": "De gastvrijheid en de hartelijkheid van de oude graaf, die in Petersburg op een aangename manier uit de toon vielen, maakten dat vorst Andrej niet kon weigeren mee te eten."
                                            },
                                            {
                                                "example_id": "52a761dc-07bb-486c-9372-0ed2335666d3",
                                                "sense_id": "5e7a1a2d-6fc4-3d04-8d86-7b0aff26556c",
                                                "text": "\"Plekken om te slapen, voedsel en schoon water is allemaal schaars\", vertelt Roos. \"De hartelijkheid van de mensen viel mijn vrienden op. Ze boden de gasten zelfs het weinige eten aan dat ze nog hadden.\""
                                            },
                                            {
                                                "example_id": "a1045d66-a65b-46e0-b2ac-a4acfdc3aee2",
                                                "sense_id": "5e7a1a2d-6fc4-3d04-8d86-7b0aff26556c",
                                                "text": "Ook toen al sprak zij de kijkers aan met \"Dag lieve mensen\", wat altijd haar handelsmerk zou blijven. Het stond voor de spontaniteit, onbevangenheid en hartelijkheid die haar geliefd maakten bij grote delen van het Nederlandse volk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da43c36d-953a-37ba-ba78-344369288f2d",
                                        "entry_id": "cd79e27d-4b25-3a4b-bcc3-88f793cbf969",
                                        "glosses": [
                                            "een teken van vriendelijkheid"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
