                "forms": [
                    {
                        "form_id": "2dbdf4f8-c4bf-4769-bafd-df128692abd1",
                        "entry_id": "d75477fc-274c-3729-9761-b329c28e7619",
                        "tags": [
                            "plural"
                        ],
                        "form": "costumes-cravates"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5b3549db-5b22-323a-9cf1-15f14435ee98",
                        "entry_id": "d75477fc-274c-3729-9761-b329c28e7619",
                        "glosses": [
                            "Uniforme-type du cadre ou de l’employé de bureau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a82f7de-637e-47c3-949d-a55b79a5b32f",
                                "sense_id": "5b3549db-5b22-323a-9cf1-15f14435ee98",
                                "text": "Marie-Line devait avoir l’âge de Lucile, ses cheveux étaient coupés au carré, elle portait des chemisiers à col rond, des gilets bleu marine en laine fine, était l’épouse d’un homme qui travaillait dans une banque et s’habillait en costume-cravate, ce qui m’apparaissait, à l’époque, comme un gage indéniable de sérieux."
                            },
                            {
                                "example_id": "4314fa78-2812-463e-b813-244432603b81",
                                "sense_id": "5b3549db-5b22-323a-9cf1-15f14435ee98",
                                "text": "Le costume-cravate est la règle vestimentaire à respecter dans de nombreuses entreprises, plus encore au Royaume-Uni qu'en France. La jupe est de rigueur pour les femmes dans les mêmes situations professionnelles. Un tailleur strict est la version féminine du costume-cravate."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a3e5323-b355-3b7d-8248-d6cd18ee84ef",
                        "entry_id": "d75477fc-274c-3729-9761-b329c28e7619",
                        "glosses": [
                            "Cadre ou employé de bureau."
                        ],
                        "tags": [
                            "metonymically",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "0038a71b-4f94-4f27-a799-34b28ac4e052",
                                "sense_id": "8a3e5323-b355-3b7d-8248-d6cd18ee84ef",
                                "text": "Elle sourit sans piper mot et fila en direction de la pétaudière, au moment où la partouzarde sortait du couloir avec à son train trois costumes-cravates déculottés trottinant comme des mômes qui ont mieux à faire qu'à rester assis sur le pot."
                            },
                            {
                                "example_id": "0dce5d35-38ea-4815-9f2c-c35f396f5fa1",
                                "sense_id": "8a3e5323-b355-3b7d-8248-d6cd18ee84ef",
                                "text": "Le costume-cravate glissa la main sous sa veste, un petit sourire aux lèvres. Adams sortit son revolver et hurla :\n— Je veux voir vos mains ! Vite !\nLe costume-cravate écarta les bras immédiatement et adressa aux inspecteurs un sourire accommodant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47de0d34-8e6b-485a-96b4-3cb3be54c057",
                        "source_entry_id": "d75477fc-274c-3729-9761-b329c28e7619",
                        "target_lang_word": "suit and tie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suit and tie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "654cfdff-2e55-3a5f-bac9-2997179aa853",
                                        "entry_id": "fde7f9fe-d670-312b-b64b-d9b67a17da3f",
                                        "glosses": [
                                            "Formal business apparel, consisting of a business suit worn with a dress shirt, tie, and formal shoes for men, conservative dress or pant suit with pumps for women."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eabfce3b-8d39-48cc-b8e1-fd1f269908ce",
                                                "sense_id": "654cfdff-2e55-3a5f-bac9-2997179aa853",
                                                "text": "Max, you don't work in an office, but you still have to make it on time to this construction site like a suit and tie kind of job."
                                            },
                                            {
                                                "example_id": "d83d259c-f34f-4d43-a67b-2f425427f88e",
                                                "sense_id": "654cfdff-2e55-3a5f-bac9-2997179aa853",
                                                "text": "The days of coaching Little League in a suit and tie are long gone, but Marvin is still always impeccably dressed, regardless of the activity — and the location."
                                            },
                                            {
                                                "example_id": "8f92466d-90a4-4229-874a-7f128603a303",
                                                "sense_id": "654cfdff-2e55-3a5f-bac9-2997179aa853",
                                                "text": "Everybody was addressed by Mr. and Miss and always suit and tie."
                                            },
                                            {
                                                "example_id": "25974c40-25b6-4a0c-9dbb-696d96a277a0",
                                                "sense_id": "654cfdff-2e55-3a5f-bac9-2997179aa853",
                                                "text": "Behind this are assumptions about the significance and meaning of two major archaeological fashion styles: suit-and-tie manager wear on the one hand and scruffy but practical field wear on the other."
                                            },
                                            {
                                                "example_id": "c2e918a2-4e96-4490-ad06-a1750e001170",
                                                "sense_id": "654cfdff-2e55-3a5f-bac9-2997179aa853",
                                                "text": "He too was a young man in a suit and tie with a derby upon his head ."
                                            },
                                            {
                                                "example_id": "8d5ff140-8480-4e71-91b3-68c50edeece9",
                                                "sense_id": "654cfdff-2e55-3a5f-bac9-2997179aa853",
                                                "text": "The clothing for us western businessmen is the classic suit and tie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
