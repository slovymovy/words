                "translations": [
                    {
                        "translation_id": "ebb8b68a-2be6-44da-97b2-0506f9726fc1",
                        "source_entry_id": "e7a6ea81-fb4f-39b4-ad9e-35b6231400c6",
                        "source_sense_id": "e4879378-2cb5-3977-b4e3-50108260efc0",
                        "source_sense_description": "jemand, der ein Kind ermordet hat",
                        "target_lang_word": "infanticide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infanticide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0027d457-826e-331b-979e-b75060ee8a75",
                                        "entry_id": "e19ded2d-34ca-3bb5-a9b9-f531e023525f",
                                        "glosses": [
                                            "Meurtrier d’un enfant ou de son propre enfant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ffc7108-765f-4283-a222-3033e013006e",
                                                "sense_id": "0027d457-826e-331b-979e-b75060ee8a75",
                                                "text": "Un père, une mère infanticide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64a0f136-1c96-3a49-a519-a9bdb6785952",
                                        "entry_id": "e19ded2d-34ca-3bb5-a9b9-f531e023525f",
                                        "glosses": [
                                            "Qui cause ou incite à l’infanticide ; infanticidaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb1b6bf5-2de9-4a25-bf21-b8c22c4a6070",
                                                "sense_id": "64a0f136-1c96-3a49-a519-a9bdb6785952",
                                                "text": "Les horribles pensées infanticides sont revenues."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "infanticide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "03ac7cfc-f269-34c4-9338-d599f2af1a4c",
                                        "entry_id": "47663f1d-c09c-3219-ae91-24ff059bb497",
                                        "glosses": [
                                            "Action de tuer un enfant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de580c1b-5916-4219-950c-8000c8bbec03",
                                                "sense_id": "03ac7cfc-f269-34c4-9338-d599f2af1a4c",
                                                "text": "Cela vaut mieux que d’être engarrié par un avocat en Cour d'Assises, comme le séducteur d'une fille accusée d’infanticide."
                                            },
                                            {
                                                "example_id": "97521732-f49a-4d3f-8cc2-65995db1d163",
                                                "sense_id": "03ac7cfc-f269-34c4-9338-d599f2af1a4c",
                                                "text": "En Inde du Sud, l’importance capitale du lien frère-sœur suppose un biais matriarcal dans le système familial. L’infanticide des bébés de sexe féminin, fréquent en Inde du Nord, disparaît dans les régions dravidiennes du Sud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b18e8cf8-9eed-369e-b88f-8b44a46a84a2",
                                        "entry_id": "47663f1d-c09c-3219-ae91-24ff059bb497",
                                        "glosses": [
                                            "Délit criminel de tuer un enfant nouveau-né, commis par la mère dont l'esprit est déséquilibré par l'accouchement ou l'allaitement, ce qui ne constitue pas un meurtre au sens légal."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbcadb5d-7b01-3b47-b73f-53fd81be6feb",
                                        "entry_id": "47663f1d-c09c-3219-ae91-24ff059bb497",
                                        "glosses": [
                                            "(Criminologie) Meurtre d’un enfant âgé de moins de 72 heures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ca0ff5d-221d-4071-a86f-0329acbaa2a7",
                                                "sense_id": "dbcadb5d-7b01-3b47-b73f-53fd81be6feb",
                                                "text": "L’infanticide est le meurtre prémédité ou non d’un nourrisson ayant moins de soixante-douze heures. Qu’il soit commis par un des parents ou par toute autre personne, c’est ce même terme qui est utilisé pour définir, sur le versant criminologique, l’homicide d’un nouveau-né."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "infanticide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e3c1e20-1c8a-35a4-9d84-69cc6bbed144",
                                        "entry_id": "41d6513f-7827-3c49-b828-985d2b921790",
                                        "glosses": [
                                            "Personne qui a tué un enfant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaeabc18-4c82-409d-a365-2702938addbe",
                                                "sense_id": "3e3c1e20-1c8a-35a4-9d84-69cc6bbed144",
                                                "text": "Moi, ces femmes-là, disait Yvonne, disait Nelly, disaient les mères en chœur à propos des ravisseuses et des infanticides, je trouve qu’il n’y a pas de châtiment trop lourd pour elles ! Même la peine de mort ce n’est pas assez."
                                            },
                                            {
                                                "example_id": "79df9881-68fc-408f-b1c6-46d01a1bdb76",
                                                "sense_id": "3e3c1e20-1c8a-35a4-9d84-69cc6bbed144",
                                                "text": "L'enfant est plongé dans une angoisse abyssale, et d'esclave, Bakhita devient bourreau, de nourrice, infanticide."
                                            },
                                            {
                                                "example_id": "b60ad52d-c565-4c2d-83eb-3c4abb8adeea",
                                                "sense_id": "3e3c1e20-1c8a-35a4-9d84-69cc6bbed144",
                                                "text": "On arrêta l’infanticide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
