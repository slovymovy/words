                            },
                            {
                                "target_word": "pentagone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84a13e34-b800-3e9f-a27d-75ba3b6b92c1",
                                        "entry_id": "856f2e79-e209-34f7-ab66-dbde047ed099",
                                        "glosses": [
                                            "Polygone de cinq côtés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67ad41b4-6f89-4eb9-a9b4-7c90be585ead",
                                                "sense_id": "84a13e34-b800-3e9f-a27d-75ba3b6b92c1",
                                                "text": "On notera que le nombre 60, attribué à chacun des côtés de l’univers, correspond au produit du dodécaèdre (le solide constitué de 12 pentagones) par le nombre 5 ; le Timée de Platon en offrira plus d’un écho."
                                            },
                                            {
                                                "example_id": "8ca5a6bd-a3e9-411c-a323-0dcd44ac2622",
                                                "sense_id": "84a13e34-b800-3e9f-a27d-75ba3b6b92c1",
                                                "text": "Comme on le sait, la construction du pentagone régulier, qui repose sur la division du cercle en cinq portions égales, n’est pas une opération géométrique triviale."
                                            }
                                        ]
                                    }
                                ]
                            }
