                    },
                    {
                        "translation_id": "156948bb-da20-4ac9-8dc6-b040411de6cc",
                        "source_entry_id": "fec90f6e-b002-3ff9-9014-780abd2af45c",
                        "source_sense_id": "e6e5102b-1440-3592-8b78-4a0e188374a2",
                        "source_sense_description": "Bratpfanne mit einem meist nach außen gezogenen, hohen Rand",
                        "target_lang_word": "sauteuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sauteuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34ef84d6-4bf8-39bf-9150-235a8ad0a26d",
                                        "entry_id": "c6ac49c4-92e1-3553-aafc-724a83f5b916",
                                        "glosses": [
                                            "Danseuse de corde, dont la profession est de faire des sauts et des tours de force. Artiste de cirque, saltimbanque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2e61b37-2675-45ee-9dc1-186d81a93f68",
                                                "sense_id": "34ef84d6-4bf8-39bf-9150-235a8ad0a26d",
                                                "text": "M. Graindorge (…) passait l’après-midi à regarder les ébats de cette sauteuse."
                                            },
                                            {
                                                "example_id": "9a35dce7-a81c-4718-a52f-65d9849c1685",
                                                "sense_id": "34ef84d6-4bf8-39bf-9150-235a8ad0a26d",
                                                "text": "Me laisser boutonner !… Moi !… Par cette sauteuse ! Le jeune homme répliqua avec un accent d’enfant gâté : Je le veux. Le grognard haussa les épaules : Le roi dit : Nous voulons, fiston ! A-t-on jamais vu, sarpédiable ! Comme ils vous parlent aux anciens, ces moutards auxquels on tordrait le bout du nez, qu’il en sortirait encore des gouttes du lait de leur nourrice !…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de41d866-688e-3f38-8a02-e46332addfaa",
                                        "entry_id": "c6ac49c4-92e1-3553-aafc-724a83f5b916",
                                        "glosses": [
                                            "Celle qui fait du saut à ski."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "953fe70c-fdbf-30d7-a173-dc423d2447f7",
                                        "entry_id": "c6ac49c4-92e1-3553-aafc-724a83f5b916",
                                        "glosses": [
                                            "Femme dont la conduite s’écarte des règles de la morale sexuelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fd4a00d-d393-4612-8ae3-0bd15818aab9",
                                                "sense_id": "953fe70c-fdbf-30d7-a173-dc423d2447f7",
                                                "text": "il a eu le bonheur inouï de prendre pour épouse une Adeline ! et il l’a trahie, il l’a abreuvée de chagrins, il l’a quittée pour des catins, pour des gourgandines, pour des sauteuses, des actrices, des Cadine, des Josépha, des Marneffe."
                                            },
                                            {
                                                "example_id": "3f6f9398-da89-4857-92a0-259e8844e2be",
                                                "sense_id": "953fe70c-fdbf-30d7-a173-dc423d2447f7",
                                                "text": "C’est une rien du tout !… Une sauteuse qu’on peut voir quasi nue tous les soirs pour quarante sous…"
                                            },
                                            {
                                                "example_id": "7f716913-436a-443d-a356-c9cf9215220f",
                                                "sense_id": "953fe70c-fdbf-30d7-a173-dc423d2447f7",
                                                "text": "Être monté pour tuer le temps, pendant une averse, chez une sauteuse qui m’a prié de lui dessiner un costume de Vénustre."
                                            },
                                            {
                                                "example_id": "ecc0c3d6-1690-4778-beff-d752227bbb27",
                                                "sense_id": "953fe70c-fdbf-30d7-a173-dc423d2447f7",
                                                "text": "Il a l’habitude de se moquer de ma conduite de sauteuse et déclare qu’à cette heure-ci, au moins, il est sûr d’être le premier de la journée à me pénétrer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "737c4aea-80b6-3c73-83d6-164cc537aac0",
                                        "entry_id": "c6ac49c4-92e1-3553-aafc-724a83f5b916",
                                        "glosses": [
                                            "Valse à deux temps, de rythme très enlevé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "976a5770-0a76-46c4-8198-95d7447e84c7",
                                                "sense_id": "737c4aea-80b6-3c73-83d6-164cc537aac0",
                                                "text": "Il y eut un soir à Congress-Hall un bal par souscription. On valse peu en Amérique, mais on y aime d’autant plus les quadrilles et une espèce de sauteuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cacbfae-d617-3d27-b33a-a9d1d35a8caa",
                                        "entry_id": "c6ac49c4-92e1-3553-aafc-724a83f5b916",
                                        "glosses": [
                                            "Poêle avec des rebords qui sert à faire sauter les viandes, les légumes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3826003-9369-451e-9307-a7840ed31c9b",
                                                "sense_id": "4cacbfae-d617-3d27-b33a-a9d1d35a8caa",
                                                "text": "Au-dessus du buffet d’acajou, la batterie de cuisine en cuivre rouge qu’entretenait mon père. Il n’y manquait aucune pièce : la série de casseroles, les plats ronds ou longs et sur une étagère la daubière, la sauteuse, le chaudron à confitures et son écumoire et la casserole à sirop avec son manche en bois. Ma mère disait qu’il n’y a de bonne cuisine que dans les casseroles, faitouts, plats en cuivre."
                                            },
                                            {
                                                "example_id": "7e1afeee-c04e-4121-a768-b960b2ba5e84",
                                                "sense_id": "4cacbfae-d617-3d27-b33a-a9d1d35a8caa",
                                                "text": "Concassez l’intérieur de l’araignée et faites revenir dans une sauteuse (ou une large poêle) avec l’huile d’olive, l’échalote, l’ail, la branche de thym et le fumet de poisson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76bfd719-f83d-3372-8ed4-6b11b6b6b9c5",
                                        "entry_id": "c6ac49c4-92e1-3553-aafc-724a83f5b916",
                                        "glosses": [
                                            "Scie sauteuse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "481d8c8e-e3d2-370b-8ce8-3ed3305860cc",
                                        "entry_id": "c6ac49c4-92e1-3553-aafc-724a83f5b916",
                                        "glosses": [
                                            "Mouche sauteuse."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17795415-0956-3d6e-a6d1-2b751c285662",
                                        "entry_id": "c6ac49c4-92e1-3553-aafc-724a83f5b916",
                                        "glosses": [
                                            "Montre dont l’aiguille des heures avance par sauts d’une heure."
                                        ],
