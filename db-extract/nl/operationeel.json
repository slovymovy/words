                                        "sense_id": "02e6ba79-8300-3af9-9b58-3aa24fb05dc4",
                                        "entry_id": "519a938b-db0b-3e6d-babb-6a524d136a5d",
                                        "glosses": [
                                            "Relatif aux opérations (militaires, industrielles, ou commerciales, ou mathématiques)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68c1b847-c05c-436d-8137-ab76132a21eb",
                                                "sense_id": "02e6ba79-8300-3af9-9b58-3aa24fb05dc4",
                                                "text": "Nos résultats opérationnels pour l’exercice 2005-2006 n’étaient pas de nature à rassurer les investisseurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cff13ee0-4f88-3633-bb74-6a63bb18ff64",
                                        "entry_id": "519a938b-db0b-3e6d-babb-6a524d136a5d",
                                        "glosses": [
                                            "En état d’opération, prêt à fonctionner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53345b58-4609-4e31-9c57-0356edf5986e",
                                                "sense_id": "cff13ee0-4f88-3633-bb74-6a63bb18ff64",
                                                "text": "Par mesure de sécurité, tous les réseaux de la collectivité sont coupés, mais les services publics (MDS, PAT, MDPH, PMI, etc.) restent ouverts au public et opérationnels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1b0c5b3-b940-32a5-a51d-71f6182bc59e",
                                        "entry_id": "519a938b-db0b-3e6d-babb-6a524d136a5d",
                                        "glosses": [
                                            "Prêt à effectuer un travail productif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cee12ba8-7a4b-40f4-a062-afe18990ded8",
                                                "sense_id": "d1b0c5b3-b940-32a5-a51d-71f6182bc59e",
                                                "text": "Avant d’être opérationnel, le candidat retenu devra suivre une formation de sept jours à l’issue de laquelle il intégrera son poste."
                                            },
                                            {
                                                "example_id": "9258d7c8-abc0-4564-995c-059c8eecebc1",
                                                "sense_id": "d1b0c5b3-b940-32a5-a51d-71f6182bc59e",
                                                "text": "Afin que les équipes soient immédiatement opérationnelles en arrivant sur les lieux du sinistre, une grande partie du travail est faite en amont."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "opérationnel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30dd5a4c-04d3-36b7-8ae1-035a8b6570f5",
                                        "entry_id": "cc121a9d-ec51-3744-b6b9-362af2b871fb",
                                        "glosses": [
                                            "Celui qui effectue un travail productif.."
                                        ],
                                        "tags": [
                                            "Travail"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59b07269-b861-4f06-96f9-8029d249d0e1",
                                                "sense_id": "30dd5a4c-04d3-36b7-8ae1-035a8b6570f5",
                                                "text": "Ces dispositifs mettent en rapport un prescripteur et un opérationnel, mais sans qu’ils entrent en interaction : les prescripteurs encadrent à distance l’activité humaine."
                                            }
