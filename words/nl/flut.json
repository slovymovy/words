                            },
                            {
                                "target_lang_word": "weak tea",
                                "target_lang_sense_clarification": "tea with very little flavor"
                            },
                            {
                                "target_lang_word": "slop",
                                "target_lang_sense_clarification": "unappetizing watery drink"
                            }
                        ]
                    }
                }
            ]
        }
