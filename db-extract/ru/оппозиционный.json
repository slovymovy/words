                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opposition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4f50bf0-2afd-3367-81d2-750b7b05df41",
                                        "entry_id": "c0c0c6e8-9b88-3284-8693-72971e628943",
                                        "glosses": [
                                            "The action of opposing or of being in conflict."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3db88c1a-42db-4390-a74b-c23b9f696a1a",
                                                "sense_id": "e4f50bf0-2afd-3367-81d2-750b7b05df41",
                                                "text": "The two politicians are in opposition to the bill."
                                            },
                                            {
                                                "example_id": "c704d1b4-8cb9-477f-b0bf-1bceaddd5e04",
                                                "sense_id": "e4f50bf0-2afd-3367-81d2-750b7b05df41",
                                                "text": "The proposal met with strong opposition from local residents."
                                            },
                                            {
                                                "example_id": "dc400755-5882-4d39-a4f2-9c2e979fe590",
                                                "sense_id": "e4f50bf0-2afd-3367-81d2-750b7b05df41",
                                                "text": "Terra Firma is an Alliance political party formed after the First Contact War. Its policy agenda is based on the principle that Earth must 'stand firm' against alien influences. This covers a variety of legislation. Recent activities by Terra Firma include opposition to a law requiring high school alien language study, a proposal to increase tariffs on alien imports, and leading a popular movement to mark the First Contact War with a public holiday."
                                            },
                                            {
                                                "example_id": "40dfedc1-23fc-42ed-aeda-bce2c10fe314",
                                                "sense_id": "e4f50bf0-2afd-3367-81d2-750b7b05df41",
                                                "text": "That worries the government, which fears that environmental activism could become the foundation for more general political opposition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d98d9d4-a4aa-355d-8278-069d4ca168cd",
                                        "entry_id": "c0c0c6e8-9b88-3284-8693-72971e628943",
                                        "glosses": [
                                            "An opposite or contrasting position."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ed95d53-2957-4957-b8fb-2f85591c6b26",
                                                "sense_id": "5d98d9d4-a4aa-355d-8278-069d4ca168cd",
                                                "text": "Near-synonym: oppositeness"
                                            },
                                            {
                                                "example_id": "00bbcbc5-6409-4f87-8af1-9bab45705994",
                                                "sense_id": "5d98d9d4-a4aa-355d-8278-069d4ca168cd",
                                                "text": "These ideas are in opposition to each other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7e55a8c-8e2e-369c-985b-80de8800b4f8",
                                        "entry_id": "c0c0c6e8-9b88-3284-8693-72971e628943",
                                        "glosses": [
                                            "The apparent relative position of two celestial bodies when one is at an angle of 180 degrees from the other as seen from the Earth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64576e65-d2c9-379c-9b8a-f1630969f8ae",
                                        "entry_id": "c0c0c6e8-9b88-3284-8693-72971e628943",
                                        "glosses": [
                                            "A political party or movement opposed to the party or government in power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6694fce5-f491-4979-bef8-bb3c7515a45a",
                                                "sense_id": "64576e65-d2c9-379c-9b8a-f1630969f8ae",
                                                "text": "leader of the opposition"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53745b56-c2bd-318d-8f9c-f5e9d8866970",
                                        "entry_id": "c0c0c6e8-9b88-3284-8693-72971e628943",
                                        "glosses": [
                                            "In United States intellectual property law, a proceeding in which an interested party seeks to prevent the registration of a trademark or patent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2586665e-66e1-3a53-a7e4-74891c11f040",
                                        "entry_id": "c0c0c6e8-9b88-3284-8693-72971e628943",
                                        "glosses": [
                                            "A position in which the player on the move must yield with his king allowing his opponent to advance with his own king."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "01ce58bc-07be-3886-86dd-7e1ae0837da0",
                                        "entry_id": "c0c0c6e8-9b88-3284-8693-72971e628943",
                                        "glosses": [
                                            "The difference of quantity or quality between two propositions having the same subject and predicate."
                                        ],
