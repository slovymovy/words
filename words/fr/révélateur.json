                    "frequency": "High",
                    "semantic_group_id": "manifestation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce lapsus involontaire est particulièrement <w>révélateur</w> de ses véritables intentions."
                        },
                        {
                            "text": "Le silence prolongé du directeur constitue un signe <w>révélateur</w> de la crise interne."
                        }
                    ],
                    "synonyms": [
                        "significatif",
                        "éloquent",
                        "évocateur"
                    ],
                    "common_phrases": [
                        "signe révélateur",
                        "détail révélateur",
                        "indice révélateur"
