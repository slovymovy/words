                "senses": [
                    {
                        "sense_id": "45c4661b-6181-38aa-82cc-b1ceea31ff76",
                        "entry_id": "94f63086-7800-336e-9efb-3b1ecaf99501",
                        "glosses": [
                            "Saillir une brebis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "846409a0-972b-4252-8770-8452b44c7b22",
                                "sense_id": "45c4661b-6181-38aa-82cc-b1ceea31ff76",
                                "text": "et, gardant son troupeau, elle a vu le « mouton de semence » qui est à dire le bélier, « hurtebiller » ses brebis."
                            },
                            {
                                "example_id": "33dc7e8e-52f3-4c9f-b6b4-d7a63faa52ab",
                                "sense_id": "45c4661b-6181-38aa-82cc-b1ceea31ff76",
                                "text": "Vous me déshonorez, chienne en feu, putasse, cataud ; et par votre lécherie je suis sous Saint-Arnoult, seignor des cocus, tel un adepte de sa confrérie ! Il en est ainsi : qui eût un millier d'yeux pour en surveiller une, n'empêchera qu'elle se fasse hurtebiller !"
                            }
                        ]
                    }
