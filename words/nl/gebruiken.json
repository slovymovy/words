                            }
                        },
                        {
                            "text": "Deze oude wasmachine <w>gebruikt</w> heel veel water per wasbeurt.",
                            "target_lang_translations": {
                                "en": "This old washing machine <w>uses</w> a lot of water per wash.",
                                "ru": "Эта старая стиральная машина <w>расходует</w> очень много воды за одну стирку.",
                                "pl": "Ta stara pralka <w>pobiera</w> bardzo dużo wody na jedno pranie.",
                                "de": "Diese alte Waschmaschine <w>verbraucht</w> sehr viel Wasser pro Waschgang.",
                                "fr": "Cette vieille machine à laver <w>consomme</w> énormément d'eau par lavage.",
                                "it": "Questa vecchia lavatrice <w>consuma</w> moltissima acqua per ogni lavaggio.",
                                "cs": "Tato stará pračka <w>spotřebuje</w> na jedno praní hodně vody.",
                                "tr": "Bu eski çamaşır makinesi yıkama başına çok fazla su <w>harcıyor</w>.",
                                "es": "Esta lavadora vieja <w>gasta</w> mucha agua por lavado."
                            }
