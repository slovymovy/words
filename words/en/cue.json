{
    "word_family": [
        "miscue"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a0d47ac1-03f6-3feb-9396-2cbe2b49ddeb",
                    "sense_definition": "An action, event, or word that serves as a signal for someone to do something, especially in a play or film.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "signal_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ringing of the telephone was my <w>cue</w> to leave the room.",
                            "target_lang_translations": {
                                "ru": "Телефонный звонок стал для меня <w>сигналом</w> выйти из комнаты.",
                                "cs": "Zazvonění telefonu bylo mým <w>signálem</w> k odchodu z místnosti."
                            }
                        },
                        {
                            "text": "The actor missed his <w>cue</w> and the stage remained silent for a moment.",
                            "target_lang_translations": {
                                "ru": "Актёр пропустил свою <w>реплику</w>, и на сцене на мгновение воцарилась тишина.",
                                "cs": "Herec propásl svou <w>narážku</w> a na jevišti zavládlo na okamžik ticho."
                            }
                        }
                    ],
                    "common_phrases": [
                        "right on cue",
                        "take a cue",
                        "miss a cue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, событие или слово, служащее сигналом для кого-либо сделать что-либо, особенно в пьесе или фильме",
                        "cs": "Akce, událost nebo slovo, které slouží jako signál pro někoho, aby něco udělal, zejména v divadelní hře nebo filmu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сигнал",
                                "target_lang_sense_clarification": "условный знак"
                            },
                            {
                                "target_lang_word": "знак",
                                "target_lang_sense_clarification": "жест или действие"
                            },
                            {
                                "target_lang_word": "реплика",
                                "target_lang_sense_clarification": "театральный термин: последние слова партнера"
                            },
                            {
                                "target_lang_word": "подсказка",
                                "target_lang_sense_clarification": "напоминание"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "signál",
                                "target_lang_sense_clarification": "podnět k zahájení akce"
                            },
                            {
                                "target_lang_word": "narážka",
                                "target_lang_sense_clarification": "v divadelním kontextu, napovězení repliky"
                            },
                            {
                                "target_lang_word": "podnět",
                                "target_lang_sense_clarification": "impuls k činnosti"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f53a23d-c4f4-39bf-99d2-a8b67ae35997",
                    "sense_definition": "A long, tapering wooden stick used to hit the ball in games such as pool, billiards, or snooker.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He chalked the tip of his <w>cue</w> before taking the shot.",
                            "target_lang_translations": {
                                "ru": "Он натёр мелом кончик своего <w>кия</w> перед ударом.",
                                "cs": "Před úderem si namazal špičku svého <w>tága</w> křídou."
                            }
                        },
                        {
                            "text": "She selected a lighter <w>cue</w> from the rack to play the next game.",
                            "target_lang_translations": {
                                "ru": "Она выбрала со стойки более лёгкий <w>кий</w>, чтобы сыграть следующую партию.",
                                "cs": "Pro další hru si ze stojanu vybrala lehčí <w>tágo</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pool cue",
                        "snooker cue",
                        "chalk a cue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная сужающаяся деревянная палка, используемая для удара по шару в таких играх, как пул, бильярд или снукер",
                        "cs": "Dlouhá zužující se dřevěná hůl používaná k úderu do koule v hrách, jako je kulečník, pool nebo snooker."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кий",
                                "target_lang_sense_clarification": "инструмент для бильярда"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "tágo",
                                "target_lang_sense_clarification": "hrací hůl v kulečníku"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "25144be0-94ed-33f0-92ca-227ebfce21fb",
                    "sense_definition": "To give a signal to a performer or technician to begin a specific action or speech.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "signal_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director will <w>cue</w> the orchestra to start playing immediately.",
                            "target_lang_translations": {
                                "ru": "Дирижёр <w>даст знак</w> оркестру начать играть немедленно.",
                                "cs": "Dirigent <w>dá znamení</w> orchestru, aby okamžitě začal hrát."
                            }
                        },
                        {
                            "text": "Please <w>cue</w> the lighting effects as soon as the actor walks on stage.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>дайте сигнал</w> к световым эффектам, как только актёр выйдет на сцену.",
                                "cs": "Prosím, <w>spusťte</w> světelné efekty, jakmile herec vstoupí na jeviště."
                            }
                        }
                    ],
                    "synonyms": [
                        "cue up"
                    ],
                    "common_phrases": [
                        "cue the music",
                        "cue someone in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подать сигнал исполнителю или технику начать определённое действие или речь",
                        "cs": "Dát signál účinkujícímu nebo technikovi, aby zahájil určitou akci nebo projev."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подавать сигнал",
                                "target_lang_sense_clarification": "дать команду к действию"
                            },
                            {
                                "target_lang_word": "давать знак",
                                "target_lang_sense_clarification": "сигнализировать"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "dát znamení",
                                "target_lang_sense_clarification": "signalizovat začátek akce"
                            },
                            {
                                "target_lang_word": "napovědět",
                                "target_lang_sense_clarification": "v divadelním smyslu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e8b7a0ce-0e7a-3817-9759-653d920e6ec0",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Cue</w> arrived at the meeting early.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Кью</w> прибыл на встречу заранее.",
                                "cs": "Pan <w>Cue</w> dorazil na schůzku včas."
                            }
                        },
                        {
                            "text": "We looked up the history of the <w>Cue</w> family in the archives.",
                            "target_lang_translations": {
                                "ru": "Мы искали историю семьи <w>Кью</w> в архивах.",
                                "cs": "V archivech jsme hledali historii rodiny <w>Cueových</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
