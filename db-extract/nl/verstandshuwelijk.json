                "senses": [
                    {
                        "sense_id": "578f9f35-0a56-37ad-9ccd-834a2c91db59",
                        "entry_id": "0c6188c2-8e34-3b22-8671-7eea10751487",
                        "glosses": [
                            "een echtverbintenis die niet – of althans niet in de eerste plaats – is gebaseerd op liefde en wederzijdse genegenheid, maar veeleer op gemeenschappelijke (vaak geldelijke) belangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffa360b1-e233-4f5a-a8a9-8f9132e866c4",
                                "sense_id": "578f9f35-0a56-37ad-9ccd-834a2c91db59",
                                "text": "Segers had D66 maandag al een opening geboden voor een verstandshuwelijk met zijn partij. Over de wet die euthanasie mogelijk maakt bij een ’voltooid leven’, in de verkiezingen nog een breekpunt voor de CU, viel volgens Segers best te praten. Na overleg met zijn fractie liet hij weten dat ’standpunten voor en na de verkiezingen dezelfde zijn’."
                            },
                            {
                                "example_id": "f1ff2098-34bc-4ae7-b480-e57144fdb935",
                                "sense_id": "578f9f35-0a56-37ad-9ccd-834a2c91db59",
                                "text": ",,Cole Porter in zijn laatste levensfase. Hij verblijft in zijn buitenhuis in Buxton Hill, waar hij elk weekend gasten uitnodigt om hem gezelschap te houden. Maar die avond loopt alles anders dan anders. Cole was van rijke komaf, een hartstochtelijk feestganger en een fervent wereldreiziger, die een verstandshuwelijk had met een van de mooiste fotomodellen uit de twintiger jaren. Terwijl zijn succes ongekende hoogte bereikte, groeide zijn eenzaamheid.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "8da48454-6256-39be-92d1-9f88382a48ea",
                        "entry_id": "0c6188c2-8e34-3b22-8671-7eea10751487",
                        "glosses": [
                            "een samenwerkingsverband (bijv. in de politiek) dat vooral op strategische gronden tot stand is gekomen, zonder dat de betrokken deelnemers echt goed met elkaar overweg kunnen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "af0a159f-d89a-4692-b02b-5e4da219af2d",
                                "sense_id": "8da48454-6256-39be-92d1-9f88382a48ea",
                                "text": "Nu Nederland in zwaarder weer terecht is gekomen, wordt het verstandshuwelijk tussen CDA, PvdA en ChristenUnie pas echt op de proef gesteld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eeab78c9-9188-4fe1-9f36-acf35c7f3abc",
                        "source_entry_id": "0c6188c2-8e34-3b22-8671-7eea10751487",
                        "source_sense_id": "578f9f35-0a56-37ad-9ccd-834a2c91db59",
                        "target_lang_word": "marriage of convenience",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marriage of convenience",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5529b1df-0e95-3f51-8d40-b1596624c072",
                                        "entry_id": "f8502727-0a9c-358f-9107-876209216267",
                                        "glosses": [
                                            "A marriage motivated by some reason other than love; for example, one conducted to obtain residence rights in a country, for financial gain, or for political purposes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1ef5504-b246-4bc1-8fd4-50f14eb87290",
                                                "sense_id": "5529b1df-0e95-3f51-8d40-b1596624c072",
                                                "text": "Widely published author and business consultant would like a marriage of convenience with a woman who is an Irish or Austrian citizen. You get legal resident status in U.S. (and eligibility for student aid), and I get eligibility for prison furloughs plus the citizenship of a neutral country in a few years so I can start a new life elsewhere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc87daa3-18b6-3ff0-a662-788c158f8ffc",
                                        "entry_id": "f8502727-0a9c-358f-9107-876209216267",
                                        "glosses": [
                                            "A big tent alliance of disparate factions (such as political factions)."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0254549f-c0bd-4df6-8cb8-8ae63a73d00a",
                                                "sense_id": "cc87daa3-18b6-3ff0-a662-788c158f8ffc",
                                                "text": "Libertarians and the Religious Right make odd bedfellows, but that marriage of convenience in the Republican Party has stuck around since the 1980s."
                                            },
                                            {
                                                "example_id": "fd51dc2a-a62f-4405-aaac-2d8156507edc",
                                                "sense_id": "cc87daa3-18b6-3ff0-a662-788c158f8ffc",
                                                "text": "Kofi Annan’s marriage of convenience is likely to last only as long as it takes the political players to build up war chests ahead of another electoral bout."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
