                    }
                ],
                "translations": [
                    {
                        "translation_id": "f00fc00f-1e1c-4fdc-9886-5ddb44246dc0",
                        "source_entry_id": "e616f570-7f83-3804-916a-e0c3f891d663",
                        "source_sense_id": "a4bc7190-68b3-38e0-a112-0ba3d36bc870",
                        "source_sense_description": "veraltet: Aquavit, Wodka, Schnaps, Lebenswasser",
                        "target_lang_word": "Aquavit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aquavit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72866c3b-f465-3a06-a829-3ecc5b8f3b96",
                                        "entry_id": "9aba23dd-0dd9-3d41-8c44-f85a243da9eb",
                                        "glosses": [
                                            "farbloser, schwach aromatisierter Branntwein, zum Teil auch mit Kümmel oder anderen Gewürzen versetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "339588e7-1a18-4d0d-b4a3-9e93a4badd48",
                                                "sense_id": "72866c3b-f465-3a06-a829-3ecc5b8f3b96",
                                                "text": "„Manche schwören nach dem Essen auf Kräuterschnaps oder Aquavit.“"
                                            },
                                            {
                                                "example_id": "9059e8ca-f3d0-4255-b2d2-0e744212e0e7",
                                                "sense_id": "72866c3b-f465-3a06-a829-3ecc5b8f3b96",
                                                "text": "„Alfred fragt, warum niemand Aquavit getrunken hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49f4b968-98ac-4b39-817e-4b9071cc8743",
                        "source_entry_id": "e616f570-7f83-3804-916a-e0c3f891d663",
                        "source_sense_id": "a4bc7190-68b3-38e0-a112-0ba3d36bc870",
                        "source_sense_description": "veraltet: Aquavit, Wodka, Schnaps, Lebenswasser",
                        "target_lang_word": "Wodka",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wodka",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bbbd4bf1-260f-3027-988d-d5cf5dcc00df",
                                        "entry_id": "a1e5ca14-cfff-3341-9bc8-9eb270c8937a",
                                        "glosses": [
                                            "ein Branntwein, hergestellt aus Getreide, Kartoffeln oder Melasse"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54ee0b59-feac-4609-b263-7c63cd9aef1f",
                                                "sense_id": "bbbd4bf1-260f-3027-988d-d5cf5dcc00df",
                                                "text": "Wodka ist das russische Nationalgetränk."
                                            },
                                            {
                                                "example_id": "41390617-d510-4e89-9f06-800cebd3ba13",
                                                "sense_id": "bbbd4bf1-260f-3027-988d-d5cf5dcc00df",
                                                "text": "„Vom Wodka wurde Humboldt so schlecht, daß er zwei Tage im Bett bleiben mußte.“"
                                            },
                                            {
                                                "example_id": "50de6df7-db73-42ab-ad4e-e62accc6674c",
                                                "sense_id": "bbbd4bf1-260f-3027-988d-d5cf5dcc00df",
                                                "text": "„Dabei schmeckt Wodka nach nichts.“"
                                            },
                                            {
                                                "example_id": "4b652a2b-4efb-4854-89e1-b5102f7d6dae",
                                                "sense_id": "bbbd4bf1-260f-3027-988d-d5cf5dcc00df",
                                                "text": "„Wenn der Großvater Godny kein Geld mehr für den Wodka hatte, trank er Spiritus, den er mit etwas Wasser und Himbeersaft streckte.“"
                                            },
                                            {
                                                "example_id": "f809fee3-a54e-42aa-833e-de137d147e65",
                                                "sense_id": "bbbd4bf1-260f-3027-988d-d5cf5dcc00df",
                                                "text": "„Er war mit seinem Wodka sehr freigebig, fand ich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b48610d7-2224-3869-930b-1857cd87b254",
                                        "entry_id": "a1e5ca14-cfff-3341-9bc8-9eb270c8937a",
                                        "glosses": [
                                            "in ein Glas abgefüllter Branntwein [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eb54739-d9cc-413e-99f3-e9a733e22465",
                                                "sense_id": "b48610d7-2224-3869-930b-1857cd87b254",
                                                "text": "Er bestellte beim Wirt einen Wodka."
                                            },
                                            {
                                                "example_id": "0c788361-01ae-4c9d-97bd-8ea0e8e7ca5b",
                                                "sense_id": "b48610d7-2224-3869-930b-1857cd87b254",
                                                "text": "„Ich trank meinen Wodka runter und fühlte mich seltsam unbeteiligt.“"
                                            },
                                            {
                                                "example_id": "f1b826c4-58ac-44f8-94c6-4d7dedd77b8f",
                                                "sense_id": "b48610d7-2224-3869-930b-1857cd87b254",
                                                "text": "„Wir opfern dieser Gelegenheit unseren beinahe letzten Bohnenkaffee, den der Gast mit Wodka anreichert; das Gespräch dauert bis weit in den Abend hinein.“"
                                            },
                                            {
                                                "example_id": "febee010-5308-4294-8cb3-dc18bf504939",
                                                "sense_id": "b48610d7-2224-3869-930b-1857cd87b254",
                                                "text": "„Nach dem vierten Wodka kichern wir wie zwei Teenager.“"
                                            },
                                            {
                                                "example_id": "e030b5c2-64e8-4229-a1e0-ed324b12feb5",
                                                "sense_id": "b48610d7-2224-3869-930b-1857cd87b254",
                                                "text": "„Nach einigen Wodkas saß ich wieder neben ihm auf dem Beifahrersitz und ließ auf dem Rückweg nach Kaliningrad die Eichenalleen an mir vorbeiziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a1b60d4-d541-4956-9625-0755ac18d4b5",
                        "source_entry_id": "e616f570-7f83-3804-916a-e0c3f891d663",
                        "source_sense_id": "a4bc7190-68b3-38e0-a112-0ba3d36bc870",
                        "source_sense_description": "veraltet: Aquavit, Wodka, Schnaps, Lebenswasser",
                        "target_lang_word": "Schnaps",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schnaps",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "861fea8f-67f2-3d08-bfc6-07028986776d",
                                        "entry_id": "7ac9647e-2fc5-3db3-bcb1-7d55c4b5a2d7",
                                        "glosses": [
                                            "eine Mundfüllung, ein Schluck, ein Bisschen"
                                        ],
                                        "tags": [
                                            "ursprünglich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2032fb7-c6e7-4023-b809-ee64fca4d1b4",
                                                "sense_id": "861fea8f-67f2-3d08-bfc6-07028986776d",
                                                "text": "Einen Schnaps mehr, und ich hätte es geschafft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d906ec14-4015-3138-9dab-532a2e63a761",
                                        "entry_id": "7ac9647e-2fc5-3db3-bcb1-7d55c4b5a2d7",
                                        "glosses": [
                                            "gebranntes, stark alkoholhaltiges Getränk"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa060de0-8fe0-49db-b3f7-80746d55dc5d",
                                                "sense_id": "d906ec14-4015-3138-9dab-532a2e63a761",
                                                "text": "Ich hätte gerne noch einen Schnaps."
                                            },
                                            {
                                                "example_id": "a58e2053-a13f-4b34-a4d7-42aa8e0a5997",
                                                "sense_id": "d906ec14-4015-3138-9dab-532a2e63a761",
                                                "text": "„„Schnaps“, das war sein letztes Wort, dann trugen ihn die Englein fort.“"
                                            },
                                            {
                                                "example_id": "f2e604d2-5ac2-4968-9cf7-7b3c6dbe6a82",
                                                "sense_id": "d906ec14-4015-3138-9dab-532a2e63a761",
                                                "text": "„Er dankt vor jeder Kneipe seinem Schöpfer, daß es Schnaps gibt.“"
                                            },
                                            {
                                                "example_id": "76776c4d-495a-4746-94be-d5728ffed358",
                                                "sense_id": "d906ec14-4015-3138-9dab-532a2e63a761",
                                                "text": "„Der Großvater Paweł konnte ohne Machorka und Schnaps nicht leben.“"
                                            },
                                            {
                                                "example_id": "ce0a6e45-45a6-4aae-b94d-e67fcf828729",
                                                "sense_id": "d906ec14-4015-3138-9dab-532a2e63a761",
                                                "text": "„Der Schnaps rann als feiner Feuerstrahl in den Magen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
