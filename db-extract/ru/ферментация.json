                                        "sense_id": "401d8529-7093-3ef1-9973-a99e5b7ff99b",
                                        "entry_id": "0620cbf2-1d47-3eec-8941-61b9ebbc333f",
                                        "glosses": [
                                            "Any of many anaerobic biochemical reactions in which an enzyme (or several enzymes produced by a microorganism) catalyses the conversion of one substance into another; especially the conversion (using yeast) of sugars to alcohol or acetic acid with the evolution of carbon dioxide"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d1233c3-4182-33d3-bbcf-d01b19a6245a",
                                        "entry_id": "0620cbf2-1d47-3eec-8941-61b9ebbc333f",
                                        "glosses": [
                                            "A state of agitation or excitement; a ferment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00bb4b6f-3841-4b65-97b1-9d3a069629be",
                                                "sense_id": "6d1233c3-4182-33d3-bbcf-d01b19a6245a",
                                                "text": "[T]he Grace that is then given to us is like a piece of Leven put into a lump of dough, and Faith and Repentance do in all the periods of our life put it into fermentation and activity."
                                            },
                                            {
                                                "example_id": "5fb161b4-cad4-4a89-b18a-feb0f1f2c53e",
                                                "sense_id": "6d1233c3-4182-33d3-bbcf-d01b19a6245a",
                                                "text": "The universal fusion of races, languages, and customs, which had gone on for four centuries under Roman rule, had produced a corresponding fusion of creeds, an universal fermentation of human thought and faith."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
