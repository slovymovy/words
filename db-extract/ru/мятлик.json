                "senses": [
                    {
                        "sense_id": "cf446d3f-1eb4-35d9-a7cd-0a43c5e71496",
                        "entry_id": "f1dea105-7fe5-3c6b-92c4-79203b10b722",
                        "glosses": [
                            "ботан. крупный род многолетних, реже однолетних травянистых растений (Poa L.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e75daa72-417d-4282-ac27-307d7a232788",
                                "sense_id": "cf446d3f-1eb4-35d9-a7cd-0a43c5e71496",
                                "text": "Но степь, обильно напоенная августовскими ливнями, не хотела сдаваться напору осени, и под бурыми метелками пырея и мятлика у самых корневищ густо резались перистые сочные листья."
                            },
                            {
                                "example_id": "8b81bf19-e256-4364-baad-8cc587ec0964",
                                "sense_id": "cf446d3f-1eb4-35d9-a7cd-0a43c5e71496",
                                "text": "По странной прихоти судьбы, мятлик в бешеных количествах произрастает на зеленых кентуккийских холмах, отчего американцы, не мудрствуя лукаво, и окрестили Кентукки «Bluegrass State»."
                            }
                        ]
                    }
