                ],
                "senses": [
                    {
                        "sense_id": "e6e357f6-43eb-3947-a581-42085d92a758",
                        "entry_id": "f4dd2afd-0f7e-3468-89d4-1093aef15a45",
                        "glosses": [
                            "The headlining band or performer at a concert or similar event; the best-known and first billed musician, comedian, etc., often performing as the final act of the evening."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffe4899d-8b57-4531-8916-8f90201a292f",
                                "sense_id": "e6e357f6-43eb-3947-a581-42085d92a758",
                                "text": "I was ahead of my deadline so I watched \"Flatliners,\" about some serious deadliners with a headliner complex."
                            },
                            {
                                "example_id": "a1df5a24-01ff-48a2-ad50-531609c23471",
                                "sense_id": "e6e357f6-43eb-3947-a581-42085d92a758",
                                "text": "There, amid the curses and catcalls of sweaty beer drinkers, the tour's headliners are set to engage in a hallowed feminist ritual:"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "49f8f1d1-4c5a-3991-b3c7-11bc1c3b1f0c",
                "word": "headliner",
