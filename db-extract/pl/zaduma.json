                "senses": [
                    {
                        "sense_id": "536c9f9f-7e6d-393c-a19d-e4c3a72bf80b",
                        "entry_id": "23f79ac6-f9c0-32fe-9c9b-c66e6d369cf0",
                        "glosses": [
                            "głębokie zamyślenie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55d2cb21-a517-4405-a309-327c690e3e03",
                                "sense_id": "536c9f9f-7e6d-393c-a19d-e4c3a72bf80b",
                                "text": "Twoja głęboka myśl pogrążyła mnie w głębokiej zadumie."
                            },
                            {
                                "example_id": "f8dd06f0-4d84-498f-9f8e-809d8f0b34f8",
                                "sense_id": "536c9f9f-7e6d-393c-a19d-e4c3a72bf80b",
                                "text": "Z zadumy tej wyrwało ją gwizdanie kosa, który rozbudzony światłem, bijącym z fabryki w okienko, zaczynał wycinać swoje kuranty."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3805a6ba-a31c-428b-9797-0bc1cf670c65",
                        "source_entry_id": "23f79ac6-f9c0-32fe-9c9b-c66e6d369cf0",
                        "source_sense_id": "536c9f9f-7e6d-393c-a19d-e4c3a72bf80b",
                        "target_lang_word": "muse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "muse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f87e4072-f9d1-3fda-85d4-359bc6fa3579",
                                        "entry_id": "4022597c-14d2-3c06-b6a2-0a110a3bef74",
                                        "glosses": [
                                            "A gap or hole in a hedge, fence, etc. through which a wild animal is accustomed to pass; a muset."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bea24ad2-ab8b-4dfd-9ef8-0e23dded3e29",
                                                "sense_id": "f87e4072-f9d1-3fda-85d4-359bc6fa3579",
                                                "text": "Find a hare without a muse. (old proverb)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "muse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36c11816-5f79-304a-a1ee-aa1391c47b9c",
                                        "entry_id": "f1e8eb52-4257-3e63-9fc0-5aaaa2f891f8",
                                        "glosses": [
                                            "Of a person: a source of inspiration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7619890c-2437-48ab-89c2-c951d6b21230",
                                                "sense_id": "36c11816-5f79-304a-a1ee-aa1391c47b9c",
                                                "text": "Yoko Ono was John Lennon's wife, lover, and muse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cf42f11-a86d-33bb-ab9a-9aaba9033fcd",
                                        "entry_id": "f1e8eb52-4257-3e63-9fc0-5aaaa2f891f8",
                                        "glosses": [
                                            "A poet; a bard."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9f36418-d7d7-4b5f-bc3d-eadbcf5a20cd",
                                                "sense_id": "6cf42f11-a86d-33bb-ab9a-9aaba9033fcd",
                                                "text": "My toung-tide Muſe in manners holds her ſtill,\nWhile comments of your praiſe richly compil'd,\nReſerue their Character with goulden quill,\nAnd precious phraſe by all the Muſes fil’d."
                                            },
                                            {
                                                "example_id": "84fa8ab2-e799-406a-b9e9-d51aca032312",
                                                "sense_id": "6cf42f11-a86d-33bb-ab9a-9aaba9033fcd",
                                                "text": "So may some gentle Muse With lucky words favour my destined urn"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "muse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad1fcc58-032a-38ed-9591-128f66d041f2",
                                        "entry_id": "5bafb13f-e46c-3948-a266-49ea1046ef6a",
                                        "glosses": [
                                            "To become lost in thought, to ponder."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "844e477c-4fd0-379a-8a90-167941cde552",
                                        "entry_id": "5bafb13f-e46c-3948-a266-49ea1046ef6a",
                                        "glosses": [
                                            "To say (something) with due consideration or thought."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3da9e06b-0b00-45b4-aeab-fec7d30b7165",
                                                "sense_id": "844e477c-4fd0-379a-8a90-167941cde552",
                                                "text": "For quotations using this term, see Citations:muse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "935bdeb7-710a-3269-8d13-7d231a970d7f",
                                        "entry_id": "5bafb13f-e46c-3948-a266-49ea1046ef6a",
                                        "glosses": [
                                            "To think on; to meditate on."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d78d100-c649-4d02-b0a0-58543e274cd9",
                                                "sense_id": "935bdeb7-710a-3269-8d13-7d231a970d7f",
                                                "text": "Come, then, expressive Silence, muse his praise."
                                            },
                                            {
                                                "example_id": "9e36294a-806a-4a0d-8d8f-9f4ff9a0c4a0",
                                                "sense_id": "935bdeb7-710a-3269-8d13-7d231a970d7f",
                                                "text": "It is tempting to speculate about the incentives or compulsions that might explain why anyone would take to the skies in [the] basket [of a balloon]: […]; […]; or perhaps to muse on the irrelevance of the borders that separate nation states and keep people from understanding their shared environment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "590eeb5a-99ac-3514-afa8-5de8da12dbf6",
                                        "entry_id": "5bafb13f-e46c-3948-a266-49ea1046ef6a",
                                        "glosses": [
                                            "To wonder at."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb26eef7-2531-45de-93f3-d9e0b6a3a261",
                                                "sense_id": "590eeb5a-99ac-3514-afa8-5de8da12dbf6",
                                                "text": "Muse not that I thus suddenly proceed; for what I will, I will, and there an end."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "muse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "837c5c30-329b-3954-851b-7e7c2bee434b",
                                        "entry_id": "0204390c-9319-353d-9b7a-211b9a433c4a",
                                        "glosses": [
                                            "An act of musing; a period of thoughtfulness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "995de327-8472-48fa-8392-90db97a53c14",
                                                "sense_id": "837c5c30-329b-3954-851b-7e7c2bee434b",
                                                "text": "still he sate long time astonished / As in great muse, ne word to creature spake."
                                            },
                                            {
                                                "example_id": "0612a469-0f39-4bd9-af66-ea58a3d350a2",
                                                "sense_id": "837c5c30-329b-3954-851b-7e7c2bee434b",
                                                "text": "And with this Alan fell into a muse, and for a long time sate^([sic]) very sad and silent."
                                            },
                                            {
                                                "example_id": "143c3dd0-9010-4076-b7be-35e4e37a6690",
                                                "sense_id": "837c5c30-329b-3954-851b-7e7c2bee434b",
                                                "text": "He fell into a muse and pulled his upper lip."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
