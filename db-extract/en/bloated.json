                                            },
                                            {
                                                "example_id": "1224a076-9bba-4fa5-93a6-12fdc9a5737e",
                                                "sense_id": "c42783b8-09e4-3516-88fd-95d50d455c75",
                                                "text": "Siècle fortuné."
                                            },
                                            {
                                                "example_id": "996c1676-4ce1-4294-913c-f8cd2284a3c2",
                                                "sense_id": "c42783b8-09e4-3516-88fd-95d50d455c75",
                                                "text": "Région, terre fortunée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdcd034a-a8b0-3af1-ba98-c327de4f22b0",
                                        "entry_id": "57372f66-d992-3f48-a13e-efc02e74475c",
                                        "glosses": [
                                            "Qui est pourvu de grandes richesses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a1dc1a3-9a13-44fd-bccc-d2880e9a3e56",
                                                "sense_id": "cdcd034a-a8b0-3af1-ba98-c327de4f22b0",
                                                "text": "Il y eut, chez les plus fortunés de ses amis, le festin, le balthazar, la ripaille, la ribote, la bombance, la grande bouffe avec, en point d'orgue, une langouste sauce thermidor à se lécher tous les doigts de la main."
                                            }
