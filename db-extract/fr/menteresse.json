                "senses": [
                    {
                        "sense_id": "ee26bce4-4cc3-3e01-b6a3-e518b898d1cd",
                        "entry_id": "2a75d2ac-ead5-3374-8358-129270548b1e",
                        "glosses": [
                            "Variante de menteuse."
                        ],
                        "tags": [
                            "alt-of",
                            "dated",
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "953130de-ff4a-4ae9-9a9b-d5c23675d4cc",
                                "sense_id": "ee26bce4-4cc3-3e01-b6a3-e518b898d1cd",
                                "text": "Toutefois, l’évêque de Maguelonne sut de science certaine qu’elle était menteresse et sorcière ; c’est pourquoi elle fut brûlée vive à Montpellier en 1417."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ca4dbcc-f1b7-4322-9c2c-6c42ec297c23",
                        "source_entry_id": "2a75d2ac-ead5-3374-8358-129270548b1e",
                        "source_sense_id": "ee26bce4-4cc3-3e01-b6a3-e518b898d1cd",
                        "target_lang_word": "Lügnerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lügnerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "09ebfdd7-2d1e-3de7-8139-60023df467a5",
                                        "entry_id": "13795923-76b8-390c-92c0-648672ae30db",
                                        "glosses": [
                                            "eine, die lügt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71ae953b-e4f5-4634-8d45-96dab0c5a124",
                                                "sense_id": "09ebfdd7-2d1e-3de7-8139-60023df467a5",
                                                "text": "Sie war schon immer eine große Lügnerin."
                                            },
                                            {
                                                "example_id": "ad979af3-1a70-4efc-9374-54e8bdf90645",
                                                "sense_id": "09ebfdd7-2d1e-3de7-8139-60023df467a5",
                                                "text": "„Als notorische Diebin stiehlt sie die Uhr des Erzählers, als ebenso notorische Lügnerin gibt sie sich Don José gegenüber als Baskin aus.“"
                                            },
                                            {
                                                "example_id": "7d65e869-1471-419d-805d-7d1343e1b5c1",
                                                "sense_id": "09ebfdd7-2d1e-3de7-8139-60023df467a5",
                                                "text": "„Aber da brachte mich Irene zum Lachen, indem sie in gefühlvollem Ton zu mir sagte, ich dürfe nicht meinen, daß ihre Eltern sie für eine Lügnerin gehalten hätten.“"
                                            },
                                            {
                                                "example_id": "5c4fb193-8049-49d9-8f68-23a8cf168051",
                                                "sense_id": "09ebfdd7-2d1e-3de7-8139-60023df467a5",
                                                "text": "„Sie war eine lausige Lügnerin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "30795bb5-3f39-3191-afb3-d91e5a524145",
                                        "entry_id": "13795923-76b8-390c-92c0-648672ae30db",
                                        "glosses": [
                                            "eine, die häufig lügt oder zur Lüge neigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be9969fb-1971-4819-bf9f-17b366a6e1e2",
                                                "sense_id": "30795bb5-3f39-3191-afb3-d91e5a524145",
                                                "text": "„Dabei ging von ihr das Gerücht, dass sie eine Lügnerin und Diebin sei, eine »salope«, also eine Schlampe, überhaupt eine ganz schreckliche Person, die man möglichst weit von sich fernhalten solle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4e00ce2-fcc7-4ddc-890a-1f1128bc040d",
                        "source_entry_id": "2a75d2ac-ead5-3374-8358-129270548b1e",
                        "source_sense_id": "ee26bce4-4cc3-3e01-b6a3-e518b898d1cd",
                        "target_lang_word": "liar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48ddd1cf-0bb5-3559-baeb-049aefa083b7",
                                        "entry_id": "0beb25d9-8f5a-3d24-8e96-c043c68a5b3f",
                                        "glosses": [
                                            "A person who frequently lies; someone who tells a lie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26315097-df91-4787-b96e-b10142725470",
                                                "sense_id": "48ddd1cf-0bb5-3559-baeb-049aefa083b7",
                                                "text": "She paused and took a defiant breath. ‘If you don't believe me, I can't help it. But I'm not a liar.’ ¶ ‘No,’ said Luke, grinning at her. ‘You're not dull enough![…]What about the kid's clothes? I don't suppose they were anything to write home about, but didn't you keep anything?[…]’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4877bce-a2bd-3c4d-b23f-2d125d063da4",
                                        "entry_id": "0beb25d9-8f5a-3d24-8e96-c043c68a5b3f",
                                        "glosses": [
                                            "A swabber responsible for cleaning the outside parts of the ship rather than the cabins, a role traditionally assigned to a person caught telling a lie the previous week."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74b14fb9-d5f1-4632-8d73-329ae21dfc9a",
                                                "sense_id": "a4877bce-a2bd-3c4d-b23f-2d125d063da4",
                                                "text": "The Swabber is to keep the Cabbins, and all the Rooms of the Ship clean within board, and the Liar to do the like without board. The Liar holds his Place but for a week; and he that is first taken with a Lie upon a Monday morning, […] for that week he is under the Swabber, and meddles not with making clean the Ship within board, but without."
                                            },
                                            {
                                                "example_id": "b14ac5f7-2b53-4beb-9e5e-b685328fa22c",
                                                "sense_id": "a4877bce-a2bd-3c4d-b23f-2d125d063da4",
                                                "text": "The swabber, perhaps the lowliest position on the ship, was responsible for cleaning the decks. By tradition, each Monday a new crewmember was appointed the liar—the first person caught telling a lie the previous week."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
