    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7770c1ec-9a6a-3eaa-b3a3-f6e895f41b46",
                    "sense_definition": "A formal title of respect used when speaking to or referring to a prince, princess, or other member of royalty.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "royal_title",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everyone bowed low when Her Royal <w>Highness</w> entered the grand ballroom."
                        },
                        {
                            "text": "The ambassador addressed the young prince as Your <w>Highness</w> during the meeting."
                        }
                    ],
                    "common_phrases": [
                        "Her Royal Highness",
                        "His Royal Highness",
                        "Your Royal Highness"
                    ]
                },
                {
                    "sense_id": "5a1c03c0-358c-3ac5-9f10-bcc485b0388e",
                    "sense_definition": "The quality or condition of being high, elevated, or lofty.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sheer <w>highness</w> of the mountain peaks filled the travelers with awe."
                        },
                        {
                            "text": "She was startled by the extreme <w>highness</w> of the soprano's upper notes."
                        }
                    ]
                },
                {
                    "sense_id": "3addede8-9cc3-3439-97f3-a95687382eca",
                    "sense_definition": "A historical title or form of address formerly used for a monarch such as an emperor or king.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "royal_title",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the ancient chronicle, the king was formally addressed as His <w>Highness</w>."
                        },
                        {
                            "text": "Medieval courtiers often used the term Your <w>Highness</w> before 'Majesty' became standard for monarchs."
                        }
                    ],
                    "synonyms": [
                        "Majesty"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Used historically of monarchs"
                        }
                    ]
                }
            ]
        }
    ]
