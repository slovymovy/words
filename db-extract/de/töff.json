                        ],
                        "examples": [
                            {
                                "example_id": "2f97ac7e-8e6e-4bd6-9263-d292646a23e1",
                                "sense_id": "483a7982-56cb-3632-b43b-f067bd6d1e90",
                                "text": "„Ein Motorradfahrer schwang sich auf sein Töff, donnerte los.“"
                            },
                            {
                                "example_id": "db41854a-3f82-4762-8154-538d41e857c6",
                                "sense_id": "483a7982-56cb-3632-b43b-f067bd6d1e90",
                                "text": "„Der junge Mann wird, weil er sich nach dem Sturz nicht wohl fühlt, […] im Polizeiauto nach Hause gebracht, während [N.] den Töff zur Hauptwache führte.“"
                            },
                            {
                                "example_id": "f8ce56c7-c77a-4fe0-8006-b45880af1d09",
                                "sense_id": "483a7982-56cb-3632-b43b-f067bd6d1e90",
                                "text": "„Vergeblich beteuert Truffer, lieber auf seinem Töff als im Verwaltungsrat zu sitzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
