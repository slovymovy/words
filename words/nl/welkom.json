                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de lange wandeling was de rust zeer <w>welkom</w>.",
                            "target_lang_translations": {
                                "en": "After the long walk, the rest was very <w>welcome</w>.",
                                "ru": "После долгой прогулки отдых был очень <w>желанным</w>.",
                                "pl": "Po długim spacerze odpoczynek był bardzo <w>mile widziany</w>.",
                                "de": "Nach der langen Wanderung war die Ruhe sehr <w>willkommen</w>.",
                                "fr": "Après la longue marche, le repos était très <w>bienvenu</w>.",
                                "it": "Dopo la lunga camminata, il riposo è stato davvero <w>gradito</w>.",
                                "cs": "Po dlouhé procházce byl odpočinek velmi <w>vítaný</w>.",
                                "tr": "Uzun yürüyüşün ardından dinlenmek çok <w>iyi geldi</w>.",
                                "es": "Después de la larga caminata, el descanso fue muy <w>bienvenido</w>."
                            }
                        },
                        {
                            "text": "Hij is altijd een <w>welkome</w> gast op onze feesten.",
                            "target_lang_translations": {
                                "en": "He is always a <w>welcome</w> guest at our parties.",
                                "ru": "Он всегда <w>желанный</w> гость на наших вечеринках.",
                                "pl": "On zawsze jest <w>mile widzianym</w> gościem na naszych przyjęciach.",
                                "de": "Er ist immer ein <w>gern gesehener</w> Gast auf unseren Festen.",
                                "fr": "Il est toujours un invité <w>bienvenu</w> à nos fêtes.",
                                "it": "È sempre un ospite <w>benvenuto</w> alle nostre feste.",
                                "cs": "Na našich večírcích je vždy <w>vítaným</w> hostem.",
                                "tr": "O, partilerimizde her zaman <w>hoş karşılanan</w> bir misafirdir.",
                                "es": "Él siempre es un invitado <w>bienvenido</w> en nuestras fiestas."
                            }
