                                                "example_id": "d2a4dbd7-146e-4f16-b04b-5b0ef24f98ee",
                                                "sense_id": "ef0e59bd-64af-3fa0-9745-0391bf7b4305",
                                                "text": "Il est très pétochard, au moindre bruit, il s’inquiète."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pétochard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0fe5f50-d13b-3b32-8d03-af0b0584fa26",
                                        "entry_id": "54c9035a-0d5b-35b3-90f0-3416d52bafa0",
                                        "glosses": [
                                            "Personne peureuse, craintive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8cddcc3-ea3c-4b09-9a6d-7b04ab5eeca1",
                                                "sense_id": "a0fe5f50-d13b-3b32-8d03-af0b0584fa26",
                                                "text": "Pétochards !"
                                            },
                                            {
                                                "example_id": "1b1625ca-1711-4bf0-9b7f-c1fc07dc2e45",
                                                "sense_id": "a0fe5f50-d13b-3b32-8d03-af0b0584fa26",
                                                "text": "La peur, « la pétouille », « les pétochards » sont d’ailleurs des mots qui reviennent souvent dans leurs propos."
                                            },
                                            {
                                                "example_id": "53506138-ce41-47df-992b-d6e8e7440ac3",
                                                "sense_id": "a0fe5f50-d13b-3b32-8d03-af0b0584fa26",
                                                "text": "Mais Robert Bourassa était un pétochard constitutionnel."
                                            },
                                            {
                                                "example_id": "bd2179a8-61a9-4d10-9b82-01a1f0799587",
                                                "sense_id": "a0fe5f50-d13b-3b32-8d03-af0b0584fa26",
                                                "text": "C’est une vraie pétocharde, elle a peur de son ombre !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
