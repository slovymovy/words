                        "glosses": [
                            "een voorlopige selectie waaruit gekozen kan worden in de finale; de eerste schifting"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e21301d5-da55-4743-8f57-a8da4ecd9ccc",
                                "sense_id": "4e87fbd9-c685-380b-926c-de8d42aa7309",
                                "text": "Na een strenge voorselectie op basis van de sollicitatiebrief, zijn 10 kandidaten uitgenodigd voor een sollicitaitegesprek."
                            },
                            {
                                "example_id": "8d7adec9-2e2b-47db-a54b-ed46f853fbe6",
                                "sense_id": "4e87fbd9-c685-380b-926c-de8d42aa7309",
                                "text": "De Nederlandse inzending voor de Oscars voor beste buitenlandse film, Layla M, is in de voorselectie afgevallen. De Nederlandse coproducent Motion Pictures is nog in de race met de film The Wound, de Zuid-Afrikaanse inzending voor de categorie beste buitenlandse productie."
                            },
                            {
                                "example_id": "03e263b2-6c91-4c27-9c8d-389ec41ac757",
                                "sense_id": "4e87fbd9-c685-380b-926c-de8d42aa7309",
                                "text": "Volgens bondscoach Geert Kuiper is Ter Mors in de afgelopen jaren te weinig in actie gekomen op de ploegachtervolging, en ook op de 3000 meter, om voor een voorselectie in aanmerking te komen."
                            }
                        ]
