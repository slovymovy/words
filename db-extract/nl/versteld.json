                    },
                    {
                        "translation_id": "1262dae2-bc97-47c3-b3ce-2b428bdbb47d",
                        "source_entry_id": "fdf706d3-b054-30aa-a025-b73ba9d703e2",
                        "source_sense_id": "c96f5823-46e0-356d-9607-e85976df5b59",
                        "source_sense_description": "als je iets vreemd vindt omdat je het niet verwacht had",
                        "target_lang_word": "verblüfft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verblüfft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1fd65e17-80cd-37e7-9591-5a0dce2e2db0",
                                        "entry_id": "a5ef2e37-a281-3bd6-9803-2693d4ee156f",
                                        "glosses": [
                                            "durch etwas Unerwartetes in Erstaunen versetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d59e39e-aa07-44f3-81aa-7f74d23f498b",
                                                "sense_id": "1fd65e17-80cd-37e7-9591-5a0dce2e2db0",
                                                "text": "„Ein verblüffter Golfspieler hat in einem Vorort von Melbourne mit seinem Handy zahlreiche Kängurus gefilmt, die plötzlich über den Golfplatz gehüpft sind.“"
                                            },
                                            {
                                                "example_id": "a031e8e6-3954-4925-a3d6-a3d9a40e939e",
                                                "sense_id": "1fd65e17-80cd-37e7-9591-5a0dce2e2db0",
                                                "text": "[Schneidemühl, Sommer 1914:] „So wird das Kriegsgeschehen selbst zum Bestandteil des Unterrichts, in den Klassenzimmern hängen bald Landkarten, auf denen den verblüfften Kindern der aktuelle Frontverlauf geschildert wird.“"
                                            },
                                            {
                                                "example_id": "bff2d4a4-4b7d-4f60-a7a2-a5adc561c9d1",
                                                "sense_id": "1fd65e17-80cd-37e7-9591-5a0dce2e2db0",
                                                "text": "„In dem Interview mit dem britischen Sender“ […] „sagte das geistliche Oberhaupt der tibetischen Buddhisten, er könne sich eine Frau als nächsten Dalai Lama gut vorstellen. Er habe schon vor 15 Jahren zu einer französischen Reporterin gesagt, dass Frauen „biologisch mehr Potenzial hätten, Zuneigung ... und Mitgefühl“ zu zeigen. Diese Frau müsse dann aber „ein sehr, sehr attraktives Gesicht“ haben, sagte der 14. Dalai Lama Tenzin Gyatso zu dem verblüfften Journalisten Clive Myrie.“"
                                            },
                                            {
                                                "example_id": "dd6e8871-afc5-4452-8411-2eb1f107f763",
                                                "sense_id": "1fd65e17-80cd-37e7-9591-5a0dce2e2db0",
                                                "text": "[NSU-Prozess 2013 – 2018:] „Scholl: Und Sie haben wirklich alles protokolliert, jedes Wort mitgeschrieben – eine Großtat von Ihnen und Ihren Kollegen. Denn was man durch Ihr Protokoll und durch das Material als verblüffter juristischer Laie auch erfährt: Die deutsche Strafgesetzordnung sieht ein Protokoll nicht zwingend vor. Es gibt keine offiziellen Mitschriften der Zeugenaussagen, des ganzen Prozesses, keine Tonbandaufnahmen.“ […]."
                                            },
                                            {
                                                "example_id": "419ea58b-c39e-426f-ab1a-eb5cd4bb1c36",
                                                "sense_id": "1fd65e17-80cd-37e7-9591-5a0dce2e2db0",
                                                "text": "„Als die verblüfften Bandenmitglieder nachgeschaut haben, meint er, noch bevor sie etwas gesagt haben, er wüsste schon was in dem Kellerraum versteckt sei: Radios und andere Elektrogeräte, Fahrräder und teure Lebensmittel.“"
                                            },
                                            {
                                                "example_id": "3b7e4a67-fe69-4dd3-b6fa-365290c47b04",
                                                "sense_id": "1fd65e17-80cd-37e7-9591-5a0dce2e2db0",
                                                "text": "„Als sie eines Morgens dem ebenfalls alleinstehenden Topmanager Matthias Winkelmann die Vorfahrt nimmt, fährt sie dem verblüfften Anzugträger frech über den Mund.“"
                                            },
                                            {
                                                "example_id": "302cef3c-c355-46b5-b033-685299fdfc3f",
                                                "sense_id": "1fd65e17-80cd-37e7-9591-5a0dce2e2db0",
                                                "text": "„Als das Ergebnis der geheimen Abstimmung verkündet wird, gibt es viele verblüffte Gesichter - Helmut Kasimier 75 Stimmen, Ernst Albrecht 77 Stimmen, drei Wahlzettel sind ungültig. Damit erreicht kein Kandidat die notwendige absolute Mehrheit von 78 Stimmen. Die Wahl muss am nächsten Tag wiederholt werden.“"
                                            },
                                            {
                                                "example_id": "90961166-a5db-4482-800e-908eb8ac5dcf",
                                                "sense_id": "1fd65e17-80cd-37e7-9591-5a0dce2e2db0",
                                                "text": "„Wenn das Licht angeknipst wird, blickt das Publikum auf einen Sträfling. Verblüfftes, irritiertes Gelächter ist im Theatersaal zu hören.“"
                                            },
                                            {
                                                "example_id": "e5e91d57-0ecb-4de4-a45f-0c3562018fd1",
                                                "sense_id": "1fd65e17-80cd-37e7-9591-5a0dce2e2db0",
                                                "text": "[Rücktritt von Papst Benedikt XVI.:] „Auch beim Konsistorium, dem Treffen der Kardinäle heute Morgen, wusste offenbar niemand vorher Bescheid. Es habe viele völlig überraschte Gesichter gegeben, sagte Vatikansprecher Pater Lombardi, der selbst einen leicht verblüfften Eindruck machte: »Der Papst hat uns ein wenig überrascht.“ […]«."
                                            },
                                            {
                                                "example_id": "a5085a5a-e421-4e0b-8887-124711149696",
                                                "sense_id": "1fd65e17-80cd-37e7-9591-5a0dce2e2db0",
                                                "text": "„In der Woche, die nun folgte, gab es wohl keinen erstaunteren und verblüffteren kleinen Jungen als Cedrik;“ […]."
                                            },
                                            {
                                                "example_id": "9da78a0f-6978-4bfd-afdf-303d8f1b4b2a",
                                                "sense_id": "1fd65e17-80cd-37e7-9591-5a0dce2e2db0",
                                                "text": "„Er kam an die Tür und..... dann machte er das verblüffteste Gesicht, dass ich je gesehen habe.“"
                                            },
                                            {
                                                "example_id": "39778867-190e-42d7-bb18-6a86cdac4781",
                                                "sense_id": "1fd65e17-80cd-37e7-9591-5a0dce2e2db0",
                                                "text": "„Der Gardian verzog das Gesicht und machte eine Bewegung, als sei er der verblüffteste Mensch auf der ganzen Erde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
