                    {
                        "translation_id": "de8f62c0-d7de-4d7e-9f29-87815171fa37",
                        "source_entry_id": "b3cda2b3-e41d-302b-bdac-61e3a20bd644",
                        "source_sense_id": "18988822-8b7a-3897-968d-bbf9c536f5a8",
