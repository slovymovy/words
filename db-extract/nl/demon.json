                        ],
                        "form": "demoontjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "51a3fba7-bb92-3955-b7d5-df8d3a193df7",
                        "entry_id": "7565fa67-1644-3757-a120-140346d1e420",
                        "glosses": [
                            "een boze geest of gevallen engel of ander bovennatuurlijk wezen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c170d9a-6dcc-4279-ad87-72888bb4180e",
                                "sense_id": "51a3fba7-bb92-3955-b7d5-df8d3a193df7",
                                "text": "Aan iedere doodszonde wordt een bepaalde demon toegeschreven."
                            },
                            {
                                "example_id": "81b08663-fd0a-4992-8eb1-78bbf4b09ada",
                                "sense_id": "51a3fba7-bb92-3955-b7d5-df8d3a193df7",
                                "text": "Met het goed gemikt openen en sluiten van een luik tussen twee ruimtes krijgt Maxwells demon alle warme moleculen aan de ene en alle koude aan de andere kant."
                            },
                            {
                                "example_id": "7d9bcc47-1530-4fd4-9109-ff04268089bb",
                                "sense_id": "51a3fba7-bb92-3955-b7d5-df8d3a193df7",
                                "text": "Er is niemand anders in jouw hoofd. Jij stelt de vragen zelf, demonen bestaan niet. Jij bent jouw eigen demon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08ee3cad-d47c-4ab8-8e1a-0499c906a5a1",
                        "source_entry_id": "7565fa67-1644-3757-a120-140346d1e420",
                        "source_sense_id": "51a3fba7-bb92-3955-b7d5-df8d3a193df7",
                        "target_lang_word": "démon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "démon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b7cf9d4-87e8-3ecc-9fe3-3756b835db93",
                                        "entry_id": "5f91aeca-1875-3809-ae93-c454ce219cac",
                                        "glosses": [
                                            "Génie, esprit ou divinité, bon ou mauvais."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27868bcc-a476-4b7b-bbdc-e0c8059a1f4a",
                                                "sense_id": "8b7cf9d4-87e8-3ecc-9fe3-3756b835db93",
                                                "text": "Que l’honneur de mon prince est cher aux destinées ! Que le démon est grand qui lui sert de support !"
                                            },
                                            {
                                                "example_id": "15d78a41-fe49-4508-81f9-21302e237616",
                                                "sense_id": "8b7cf9d4-87e8-3ecc-9fe3-3756b835db93",
                                                "text": "Que saurait enseigner aux princes\nLe grand démon qui les instruit."
                                            },
                                            {
                                                "example_id": "a0099302-4d88-4356-8164-f6499858d7d7",
                                                "sense_id": "8b7cf9d4-87e8-3ecc-9fe3-3756b835db93",
                                                "text": "Or qu’en un saint ouvrage un saint démon m’appelle."
                                            },
                                            {
                                                "example_id": "b24f39f6-9dcd-4fb4-b9ed-0a68ee0e00af",
                                                "sense_id": "8b7cf9d4-87e8-3ecc-9fe3-3756b835db93",
                                                "text": "Un plus puissant démon veille sur vos années."
                                            },
                                            {
                                                "example_id": "9ca1f779-6d4f-41dd-b43d-fd7183c28d96",
                                                "sense_id": "8b7cf9d4-87e8-3ecc-9fe3-3756b835db93",
                                                "text": "Leur chef nous a paru le démon des combats."
                                            },
                                            {
                                                "example_id": "6db14d7e-1811-4041-a153-fde820630e4b",
                                                "sense_id": "8b7cf9d4-87e8-3ecc-9fe3-3756b835db93",
                                                "text": "[Il] Respecterait en lui le démon de l’empire."
                                            },
                                            {
                                                "example_id": "f1967b54-9753-40b9-a5b9-86df7ebf662a",
                                                "sense_id": "8b7cf9d4-87e8-3ecc-9fe3-3756b835db93",
                                                "text": "Ô ciel ! quel bon démon devers moi vous envoie, Madame ?"
                                            },
                                            {
                                                "example_id": "d94b6479-3e15-44fb-a0e7-6e3239ad6051",
                                                "sense_id": "8b7cf9d4-87e8-3ecc-9fe3-3756b835db93",
                                                "text": "Que les hommes, les dieux, les démons et le sort\nPréparent contre nous un général effort."
                                            },
                                            {
                                                "example_id": "5f54ef02-8ec1-4b76-85f5-00729929f5db",
                                                "sense_id": "8b7cf9d4-87e8-3ecc-9fe3-3756b835db93",
                                                "text": "Quel démon envieux\nM’a refusé l’honneur de mourir à vos yeux ?"
                                            },
                                            {
                                                "example_id": "274b00a1-71db-41d7-99ee-7217ac812168",
                                                "sense_id": "8b7cf9d4-87e8-3ecc-9fe3-3756b835db93",
                                                "text": "Fatale furie\nQue le démon de Rome a formée et nourrie."
                                            },
                                            {
                                                "example_id": "fcc51bf5-32c6-40be-a1bf-0638da9ad922",
                                                "sense_id": "8b7cf9d4-87e8-3ecc-9fe3-3756b835db93",
                                                "text": "J’ose donc dire d’abord qu’il ne faut pas accuser Dieu d’injustice parce que les enfers des Égyptiens, d’Orphée et d’Homère, n’existent pas, et que les trois gueules de Cerbère, les trois Furies, les trois Parques, les mauvais démons, la roue d’Ixion, le vautour de Prométhée, sont des chimères absurdes. Les charlatans sacrés qui inventèrent ces horribles fadaises pour se faire craindre, et qui ne soutinrent leur religion que par des bourreaux, sont aujourd’hui regardés par les sages comme la lie du genre humain ; ils sont aussi méprisés que leurs fables."
                                            },
                                            {
                                                "example_id": "5814676a-eb82-433c-a7da-258d2ef8b3fc",
                                                "sense_id": "8b7cf9d4-87e8-3ecc-9fe3-3756b835db93",
                                                "text": "Platon avait imaginé les démons pour former une échelle par laquelle, de créature plus parfaite en créature plus parfaite, on montât enfin jusqu’à Dieu, de sorte que Dieu n’aurait que quelques degrés de perfection par-dessus la première des créatures."
                                            },
                                            {
                                                "example_id": "8cb7c485-5f46-4cbf-afc6-0d8ffb27e32e",
                                                "sense_id": "8b7cf9d4-87e8-3ecc-9fe3-3756b835db93",
                                                "text": "Croyant sur la parole des esprits doux, que Diable et Démon ne sont qu’une même chose, et, par exemple, ayant ouï dire que la peine et la récompense sont les deux démons qui gouvernent les choses humaines, qu’Aristote est le démon de la nature, que le favori est le démon de l’État, etc. ; ils rediront innocemment, et sans craindre de parler mal françois, que la peine et la récompense sont les deux diables qui gouvernent les choses humaines, qu’Aristote est le diable de la nature, que le favori est le diable de l’État, etc."
                                            },
                                            {
                                                "example_id": "578ea1e8-4551-4e8c-9eee-7fdca3824297",
                                                "sense_id": "8b7cf9d4-87e8-3ecc-9fe3-3756b835db93",
                                                "text": "Deux démons à leur gré partagent notre vie,\nEt de son patrimoine ont chassé la raison […]\nJ’appelle l’un amour et l’autre ambition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e870861-d909-3149-a96b-8ee6b357f57c",
                                        "entry_id": "5f91aeca-1875-3809-ae93-c454ce219cac",
                                        "glosses": [
                                            "Dans l'Ancien Testament, faux dieu, dieu païen, mauvais esprit."
                                        ],
                                        "tags": [
                                            "Ancient",
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec920038-2474-49fa-8214-a7ce76edc418",
                                                "sense_id": "0e870861-d909-3149-a96b-8ee6b357f57c",
                                                "text": "Enfin, il y a une assimilation entre les faux dieux des nations païennes qui entourent le peuple élu (les shédîm) et les mauvais esprits, terme que la Septante (Bible grecque) va traduire par daïmonia, ce qui va donner le mot « démon » en français. Ainsi, on lit que les infidèles « sacrifiaient à des démons qui ne sont pas Dieu, à des dieux qu'ils ne connaissaient pas » (Dt 32,17). Les démons et les faux-dieux étaient souvent assimilés les uns aux autres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a436902-b77f-376b-915c-020a67350096",
                                        "entry_id": "5f91aeca-1875-3809-ae93-c454ce219cac",
                                        "glosses": [
                                            "Un des diables, des esprits malins, par opposition aux anges, pour les chrétiens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "675cc244-9c27-4f8d-934f-82f5c1dbb9dc",
                                                "sense_id": "1a436902-b77f-376b-915c-020a67350096",
                                                "text": "Il avait tout perdu dans ces pérégrinations, foi, honneur, fierté, et n’avait conservé que les desseins de faire le mal inspiré par les démons de l’enfer."
                                            },
                                            {
                                                "example_id": "b4dbb13e-f2c5-464c-8878-dab582615453",
                                                "sense_id": "1a436902-b77f-376b-915c-020a67350096",
                                                "text": "Le démon recourt à des calomniateurs pour nuire à François. Maintes fois l’évêque de Genève a fait l’objet de calomnies et de ragots de la part de certains ministres du culte réformé : […]."
                                            },
                                            {
                                                "example_id": "5300a067-fe61-41d8-bd37-ad086bb4d052",
                                                "sense_id": "1a436902-b77f-376b-915c-020a67350096",
                                                "text": "Que les démons et ceux qui les adorent\nSoient à jamais détruits et confondus !"
                                            },
                                            {
                                                "example_id": "b8c9efff-daef-4893-b080-ba9a168fb931",
                                                "sense_id": "1a436902-b77f-376b-915c-020a67350096",
                                                "text": "C’est une étrange vision,\nEt cependant, ange ou démon\nJ’ai vu partout cette ombre amie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0428976-c957-385f-be81-5df26df0d66b",
                                        "entry_id": "5f91aeca-1875-3809-ae93-c454ce219cac",
                                        "glosses": [
                                            "Le Diable, Satan, prince des démons, et principe du mal."
                                        ],
                                        "tags": [],
                                        "note": "Il porte alors une majuscule",
                                        "examples": [
                                            {
                                                "example_id": "f76813c0-e4c4-4544-abef-1da2b3b42fc4",
                                                "sense_id": "e0428976-c957-385f-be81-5df26df0d66b",
                                                "text": "[…] et le Démon profite de cette accalmie pour entrer en scène.\nIl lui apparaît sous des formes belliqueuses de monstres, casse tout, fuit, en s’effumant dans des buées puantes ; […]."
                                            },
                                            {
                                                "example_id": "3ab0a0c4-70c3-4ce9-aff4-03ca6ac91b9e",
                                                "sense_id": "e0428976-c957-385f-be81-5df26df0d66b",
                                                "text": "Et bravant du Démon l’impuissant artifice,\nDe la religion soutient tout l’édifice."
                                            },
                                            {
                                                "example_id": "ebbdfdad-aac0-4cee-8bef-b1e4f6273b84",
                                                "sense_id": "e0428976-c957-385f-be81-5df26df0d66b",
                                                "text": "Vous irez crier partout qu’il faut être organe du Démon pour vous imputer des choses dont il n’a ni marque ni vestige dans vos livres."
                                            },
                                            {
                                                "example_id": "9db42086-d860-4211-beb9-d128bb52b003",
                                                "sense_id": "e0428976-c957-385f-be81-5df26df0d66b",
                                                "text": "Le Démon se manifeste nuitamment, profitant du sommeil de notre raison pour nous souffler des comportements contre nature. L’insomnie est donc un remède souverain contre lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7823d24d-073f-318f-85da-51792d791e39",
                                        "entry_id": "5f91aeca-1875-3809-ae93-c454ce219cac",
                                        "glosses": [
                                            "Personne méchante qui se plaît à tourmenter les autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "009fe729-1674-4771-a2dd-54c1a5127e6f",
                                                "sense_id": "7823d24d-073f-318f-85da-51792d791e39",
                                                "text": "Cet homme est un vrai démon, un démon incarné."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1132bb17-42ec-39b2-b883-f79446c7d8b9",
                                        "entry_id": "5f91aeca-1875-3809-ae93-c454ce219cac",
                                        "glosses": [
                                            "Enfant vif et malin."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47aa3622-468d-4ba1-8d2f-09e8265c94f2",
                                                "sense_id": "1132bb17-42ec-39b2-b883-f79446c7d8b9",
                                                "text": "C’est un petit démon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a28c6967-d722-31fa-af35-f13794700a15",
                                        "entry_id": "5f91aeca-1875-3809-ae93-c454ce219cac",
                                        "glosses": [
                                            "Cause de l’inspiration, des impulsions bonnes ou mauvaises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40958777-f6b9-447a-8719-079f0703e7a1",
                                                "sense_id": "a28c6967-d722-31fa-af35-f13794700a15",
                                                "text": "Quel démon me poussait à toujours reprendre la mer ?"
                                            },
                                            {
                                                "example_id": "9fb30bd1-03c2-4bdd-9067-b7f098933a65",
                                                "sense_id": "a28c6967-d722-31fa-af35-f13794700a15",
                                                "text": "Que faisons-nous, Romains ? Dit-il, et quel démon nous fait venir aux mains ?"
                                            },
                                            {
                                                "example_id": "9bd860eb-0397-40d3-8643-2552da846f5d",
                                                "sense_id": "a28c6967-d722-31fa-af35-f13794700a15",
                                                "text": "Quel démon vous irrite et vous porte à médire ?"
                                            },
                                            {
                                                "example_id": "c9c56ef0-6548-4de1-a6e7-ffe01d0fc30d",
                                                "sense_id": "a28c6967-d722-31fa-af35-f13794700a15",
                                                "text": "Dès lors que son démon commence à l’agiter,\nTout, jusqu’à sa servante, est prêt à déserter."
                                            },
                                            {
                                                "example_id": "021e0a74-0930-43d2-ae8b-eb789844511e",
                                                "sense_id": "a28c6967-d722-31fa-af35-f13794700a15",
                                                "text": "Eh ! que serait-ce donc si le démon du jeu\nVersait dans son esprit sa ruineuse rage ?"
                                            },
                                            {
                                                "example_id": "28b9fb48-f9f0-415d-90cc-b76b2ce77d20",
                                                "sense_id": "a28c6967-d722-31fa-af35-f13794700a15",
                                                "text": "Térence n’est pas possédé de ce démon-là."
                                            },
                                            {
                                                "example_id": "cbc51b2b-0120-4c3c-9801-df6bb249b368",
                                                "sense_id": "a28c6967-d722-31fa-af35-f13794700a15",
                                                "text": "Celui qu’un vrai démon [l’inspiration] presse, enflamme, domine,\nIgnore un tel supplice, il pense, il imagine."
                                            },
                                            {
                                                "example_id": "59125f85-1f53-4a39-a929-0222c545fd0e",
                                                "sense_id": "a28c6967-d722-31fa-af35-f13794700a15",
                                                "text": "Si le démon de l’aventure n’avait soudainement empoigné Roy, il serait, sans doute, le mari de Pearl et aurait de grands enfants…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d40c984d-6512-3108-8471-cdef97599da0",
                                        "entry_id": "5f91aeca-1875-3809-ae93-c454ce219cac",
                                        "glosses": [
                                            "Personnification des idées noires, angoissantes, qui troublent une personne et peuvent l’inciter à des actions néfastes."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1583f0dd-211e-4729-8cef-468149c89510",
                                                "sense_id": "d40c984d-6512-3108-8471-cdef97599da0",
                                                "text": "Les démons sont ces esprits mauvais qui nous agitent et nous troublent. Ils se retrouvent dans nos angoisses et nos peurs incontrôlables."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "démon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f923e13-1c39-3011-9f3a-8a66d6e6946d",
                                        "entry_id": "209d65ca-0e4b-3020-9c46-8016ea0c6f73",
                                        "glosses": [
                                            "Programme actif en permanence dans un système multitâche, qui effectue certaines fonctions sans l’intervention de l’utilisateur."
                                        ],
