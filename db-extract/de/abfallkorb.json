                        "form": "den Abfallkorb"
                    },
                    {
                        "form_id": "864554dd-cb92-4df4-94aa-ff65fa69b28d",
                        "entry_id": "e84478b5-a43c-3269-8cd0-4b9b399ef9ad",
                        "tags": [
                            "accusative",
