                                                "example_id": "a7100348-b444-4dcc-a921-bc5c09ff6d48",
                                                "sense_id": "685aab36-c4f3-3cd6-8fcd-e7f3d582913f",
                                                "text": "„Die Deutschen schlucken denn auch doppelt so viele Antidepressiva wie noch vor zehn Jahren.“"
                                            },
                                            {
                                                "example_id": "348869a8-bff2-437e-a5fa-ce3f3684c8d3",
                                                "sense_id": "685aab36-c4f3-3cd6-8fcd-e7f3d582913f",
                                                "text": "„Frauen bauen viele Antidepressiva langsamer ab, weil das aber bei der Dosierung nicht genug beachtet wird, leiden sie häufiger an Nebenwirkungen.“"
                                            }
