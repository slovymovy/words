                ],
                "senses": [
                    {
                        "sense_id": "97938fb1-eb8a-30a1-b53a-c38a5f5668fa",
                        "entry_id": "1c405d73-5d77-3f02-93c4-87b8309d4291",
                        "glosses": [
                            "Gebirge in Nordwestafrika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a877827f-4732-486a-a66d-1478319d20ff",
                                "sense_id": "97938fb1-eb8a-30a1-b53a-c38a5f5668fa",
                                "text": "„Zum Thema evangelische Gruppen ist mir ein Besuch im Atlasgebirge Tunesiens in Erinnerung geblieben.“"
                            },
                            {
                                "example_id": "119ae659-c56e-43d4-aa96-90457580e21b",
                                "sense_id": "97938fb1-eb8a-30a1-b53a-c38a5f5668fa",
                                "text": "„Das Atlasgebirge ist der höchste Gebirgszug Nordafrikas und stellt somit eine bedeutende orographische Barriere für viele Arten dar.“"
                            },
                            {
                                "example_id": "02366607-2675-49e9-8d4d-16859e877320",
                                "sense_id": "97938fb1-eb8a-30a1-b53a-c38a5f5668fa",
                                "text": "„Anfang März flogen wir nach Marrakesch, mieteten dort zwei geländegängige Autos und brachen in Richtung Atlasgebirge auf.“"
                            },
                            {
                                "example_id": "63f1d6a2-efc4-497d-aaf9-0a0f480c633b",
                                "sense_id": "97938fb1-eb8a-30a1-b53a-c38a5f5668fa",
                                "text": "„Rodungen haben auch die mediterranen Wälder in den Atlasgebirgen Nordwestafrikas dezimiert oder vernichtet […].“"
                            },
                            {
                                "example_id": "71831542-2143-49a4-88c8-55fdc6ec202d",
                                "sense_id": "97938fb1-eb8a-30a1-b53a-c38a5f5668fa",
                                "text": "„Zahlreich sind die Off-Routen und Pässe über die Atlasgebirge, die kein Verkehr beeinträchtigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
