                                "example_id": "a498f642-b089-4aa3-a24a-79b07d5c0541",
                                "sense_id": "695fc4d0-c447-3da0-a60a-3273d8e1426d",
                                "text": "„Mit einem Mal nahm Davidson den Wind auf der Wüstenstraße wahr, der an den Scheiben seines Mustang jammerte.“"
                            },
                            {
                                "example_id": "0652b5f0-fdf0-4318-bdb1-06f4e91f8e9f",
                                "sense_id": "695fc4d0-c447-3da0-a60a-3273d8e1426d",
                                "text": "„Sie hatten sich von der einzigen Wüstenstraße zwischen Al-Faschir und Dirra ferngehalten und waren stundenlang nur über weites, leeres und trostloses Land geritten.“"
                            }
                        ],
