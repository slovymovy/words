        "fr-extract.jsonl": [
            {
                "entry_id": "8efa2124-7127-31ed-927a-7307b4786ae2",
                "word": "frontispice",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "75f59d36-1ec0-4e13-bb35-9f2e706b6ca1",
                        "entry_id": "8efa2124-7127-31ed-927a-7307b4786ae2",
                        "tags": [
                            "plural"
                        ],
                        "form": "frontispices"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "44052f48-c1d9-36ad-bbbf-d5b96b107800",
                        "entry_id": "8efa2124-7127-31ed-927a-7307b4786ae2",
                        "glosses": [
                            "Façade principale d’un grand bâtiment."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "b6c6cca3-3cb0-46e0-874f-db0e18d90b3f",
                                "sense_id": "44052f48-c1d9-36ad-bbbf-d5b96b107800",
                                "text": "Les vicissitudes de Notre-Dame, à partir de 1789, se présentent ainsi :[…]. Elle fut fermée en 1793; et dans la même année Robespierre fit inscrire sur son frontispice : Temple de la Raison."
                            },
                            {
                                "example_id": "9b2acc3a-34f6-4bcd-a851-e951eda1cdf3",
                                "sense_id": "44052f48-c1d9-36ad-bbbf-d5b96b107800",
                                "text": "La salle de réunion du conseil municipal avait autrefois servi de salle de classe pour les enfants du village. Le frontispice de l’édifice public comportait d’ailleurs toujours l’inscription « Ecole-Mairie »."
                            },
                            {
                                "example_id": "26107d63-a036-4fd1-9c28-3a6950e1acf4",
                                "sense_id": "44052f48-c1d9-36ad-bbbf-d5b96b107800",
                                "text": "[…], les petits édifices historiques meringués et sculptés de colonnades et de frontispices comme des gâteaux de mariage, […].,"
                            }
                        ]
                    },
                    {
                        "sense_id": "276febe7-ab87-3e37-b360-d87ffc69c74e",
                        "entry_id": "8efa2124-7127-31ed-927a-7307b4786ae2",
                        "glosses": [
                            "Titre imprimé d’un livre placé à la première page et entouré ou accompagné d’ornements ou de vignettes."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "examples": [
                            {
                                "example_id": "dc46a486-3d7d-4e24-8211-cd4e3dcd45f4",
                                "sense_id": "276febe7-ab87-3e37-b360-d87ffc69c74e",
                                "text": "Au verso du frontispice de la 1ʳᵉ édition on voit le portrait de l’auteur dans un médaillon, gravé par un anonyme."
                            },
                            {
                                "example_id": "32508b97-e0e8-4082-8b40-aac99d57101d",
                                "sense_id": "276febe7-ab87-3e37-b360-d87ffc69c74e",
                                "text": "Vient ensuite la tomaison, qui se lie moins étroitement encore au frontispice que le nom de l’auteur, puis le nom et l’adresse du libraire."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f2b18f5-0463-31e9-8f51-9c4d0d6bd87f",
                        "entry_id": "8efa2124-7127-31ed-927a-7307b4786ae2",
                        "glosses": [
                            "Illustration placée en regard du titre d’un livre."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "a81a53ee-7dc7-45a8-aef1-a7875d5aa792",
                                "sense_id": "0f2b18f5-0463-31e9-8f51-9c4d0d6bd87f",
                                "text": "Tandis qu’en 1651, Andromède est illustrée d’un frontispice suivi de six belles gravures du spectacle signées du décorateur Torelli et de François Chauveau."
                            },
                            {
                                "example_id": "aa73b1a7-7ac2-4b01-8dc7-fe39ac4e0239",
                                "sense_id": "0f2b18f5-0463-31e9-8f51-9c4d0d6bd87f",
                                "text": "Livre d’un format grand in-octavo, et contenant indépendamment de la planche frontispice représentant une promenade au bord de la mer, et de la dernière planche représentant le jeu de Kai-awassé, six planches doubles de coquillages."
                            }
                        ]
                    },
                    {
                        "sense_id": "cfa86b51-3145-356d-804f-c5e0c8def281",
                        "entry_id": "8efa2124-7127-31ed-927a-7307b4786ae2",
                        "glosses": [
                            "Début, introduction d’un écrit."
                        ],
                        "tags": [
                            "analogy",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2c267e71-9ac0-476e-9ea2-d83efe19e18a",
                                "sense_id": "cfa86b51-3145-356d-804f-c5e0c8def281",
                                "text": "— En cette préface, servant de frontispice à la description complète de notre régime d’impôts au début du vingtième siècle, je tentai, […], la philosophie de notre fiscalité […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5521ecae-a9c0-469a-ac27-146b98395672",
                        "source_entry_id": "8efa2124-7127-31ed-927a-7307b4786ae2",
                        "target_lang_word": "Frontispiz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frontispiz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66af33ef-81fb-3b26-95e8-1acce7cf6fd3",
                                        "entry_id": "c65a442e-f231-3b58-bcbd-2e133c5e0f89",
                                        "glosses": [
                                            "Giebeldreieck über einem vorstehenden Gebäudeteil (oft auch der Giebel über einem Fenster oder einer Tür, der auch „Fronton“ genannt wurde)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11a0e615-bb5a-4a08-8024-40caaae8729a",
                                                "sense_id": "66af33ef-81fb-3b26-95e8-1acce7cf6fd3",
                                                "text": "„Aus der Untersuchung und Beschreibung der einzelnen Bauformen und Ornamente am Frontispiz des Rathauses hat sich herausgestellt, daß dasselbe in seinen wesentlichen Theilen unverändert sich erhalten hat.“"
                                            },
                                            {
                                                "example_id": "9775c493-59ec-45ce-859a-da78510f40cc",
                                                "sense_id": "66af33ef-81fb-3b26-95e8-1acce7cf6fd3",
                                                "text": "„An der Vorderseite gab es eine dreiachsige Oberstube mit Frontispiz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fd4d1a5f-b1fe-32fa-9599-8f2dcb3b8848",
                                        "entry_id": "c65a442e-f231-3b58-bcbd-2e133c5e0f89",
                                        "glosses": [
                                            "Illustration auf der zweiten, der Titelseite gegenüberliegenden Seite eines Buches"
                                        ],
                                        "tags": [
                                            "Buchdruck"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adf84fdc-49bd-4155-98cc-e2706da80efa",
                                                "sense_id": "fd4d1a5f-b1fe-32fa-9599-8f2dcb3b8848",
                                                "text": "„Das Frontispiz zeigt eine dramatische Szene mit drei Figuren, und es ist Rousseau, der diese Trias 1752, also zwei Jahre nach der Erstveröffentlichung und als Reaktion auf zahlreiche kritische Einwendungen umfassend erläutert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbf93765-e6ed-4c70-a60d-3500425a07eb",
