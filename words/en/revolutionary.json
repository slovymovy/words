{
    "word_family": [
        "revolution",
        "revolutionize",
        "revolutionist",
        "revolute",
        "revolve"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4388abfa-ca7f-33d1-871f-a3577a988060",
                    "sense_definition": "Involving or causing a complete or dramatic change in ideas or methods",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "innovation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The invention of the smartphone was a <w>revolutionary</w> step in the history of communication.",
                            "target_lang_translations": {
                                "ru": "Изобретение смартфона стало <w>революционным</w> шагом в истории связи."
                            }
                        },
                        {
                            "text": "This <w>revolutionary</w> new tool will completely change how we design buildings.",
                            "target_lang_translations": {
                                "ru": "Этот <w>революционный</w> новый инструмент полностью изменит то, как мы проектируем здания."
                            }
                        }
                    ],
                    "synonyms": [
                        "Jacobinic",
                        "Jacobinical"
                    ],
                    "antonyms": [
                        "conservative",
                        "traditional"
                    ],
                    "common_phrases": [
                        "revolutionary new tool",
                        "revolutionary change",
                        "revolutionary idea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный с полным или резким изменением идей или методов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "революционный",
                                "target_lang_sense_clarification": "кардинально меняющий что-либо"
                            },
                            {
                                "target_lang_word": "прорывной",
                                "target_lang_sense_clarification": "инновационный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "942e5863-c3ad-3fb1-adca-21c7aa8a8b16",
                    "sense_definition": "Relating to or engaged in a political revolution to overthrow a government",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>revolutionary</w> war lasted for several years before the new government was established.",
                            "target_lang_translations": {
                                "ru": "<w>Революционная</w> война длилась несколько лет, прежде чем было сформировано новое правительство."
                            }
                        },
                        {
                            "text": "He was arrested for distributing <w>revolutionary</w> pamphlets in the city square.",
                            "target_lang_translations": {
                                "ru": "Его арестовали за распространение <w>революционных</w> листовок на городской площади."
                            }
                        }
                    ],
                    "synonyms": [
                        "Jacobinic",
                        "Jacobinical"
                    ],
                    "antonyms": [
                        "counterrevolutionary",
                        "loyalist"
                    ],
                    "common_phrases": [
                        "revolutionary war",
                        "revolutionary movement",
                        "revolutionary party"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к политической революции или участвующий в ней с целью свержения правительства"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "революционный",
                                "target_lang_sense_clarification": "относящийся к государственному перевороту"
                            },
                            {
                                "target_lang_word": "повстанческий",
                                "target_lang_sense_clarification": "связанный с восстанием"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdb5971e-bc71-35c7-9f5e-01da03ee2729",
                    "sense_definition": "Relating to a circular motion or rotation around an axis",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>revolutionary</w> motion of the planets around the sun follows an elliptical path.",
                            "target_lang_translations": {
                                "ru": "<w>Вращательное</w> движение планет вокруг Солнца происходит по эллиптической траектории."
                            }
                        },
                        {
                            "text": "Engineers studied the <w>revolutionary</w> speed of the turbine to ensure safety.",
                            "target_lang_translations": {
                                "ru": "Инженеры изучили <w>скорость вращения</w> турбины для обеспечения безопасности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "revolutionary motion",
                        "revolutionary speed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к круговому движению или вращению вокруг оси"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вращательный",
                                "target_lang_sense_clarification": "о движении вокруг оси"
                            },
                            {
                                "target_lang_word": "орбитальный",
                                "target_lang_sense_clarification": "о движении по орбите"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6c8eb6cd-a4db-3d16-b8ab-fd3f19f3d2c5",
                    "sense_definition": "A person who advocates or takes part in a political revolution",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young <w>revolutionary</w> spent his life fighting for the rights of the people.",
                            "target_lang_translations": {
                                "ru": "Молодой <w>революционер</w> посвятил свою жизнь борьбе за права народа."
                            }
                        },
                        {
                            "text": "Many a <w>revolutionary</w> was forced into exile after the failed uprising.",
                            "target_lang_translations": {
                                "ru": "Многие <w>революционеры</w> были вынуждены отправиться в изгнание после неудачного восстания."
                            }
                        }
                    ],
                    "synonyms": [
                        "Jacobinic",
                        "Jacobinical"
                    ],
                    "antonyms": [
                        "reactionary"
                    ],
                    "common_phrases": [
                        "young revolutionary",
                        "political revolutionary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который выступает за политическую революцию или участвует в ней"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "революционер",
                                "target_lang_sense_clarification": "мужчина или общее название"
                            },
                            {
                                "target_lang_word": "революционерка",
                                "target_lang_sense_clarification": "женщина"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a3b9c14b-f1a7-3c4a-8687-100e8fd846f2",
                    "sense_definition": "The popular name for Chopin's Étude Op. 10, No. 12 in C minor",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "work_of_art_name",
                    "examples": [
                        {
                            "text": "The pianist performed the <w>Revolutionary</w> with incredible speed and emotion.",
                            "target_lang_translations": {
                                "ru": "Пианист исполнил «<w>Революционный</w>» с невероятной скоростью и чувством."
                            }
                        },
                        {
                            "text": "Chopin wrote the <w>Revolutionary</w> Étude after hearing about the fall of Warsaw.",
                            "target_lang_translations": {
                                "ru": "Шопен написал «<w>Революционный</w>» этюд, узнав о падении Варшавы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Revolutionary Etude"
                    ],
                    "target_lang_definitions": {
                        "ru": "Популярное название Этюда Шопена Op. 10, No. 12 до минор"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Революционный",
                                "target_lang_sense_clarification": "название этюда"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}