    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "508469fe-e611-339a-b76f-b8789e9a6421",
                    "sense_definition": "Tirer ou retirer une chose ou une personne d'un lieu où elle se trouve enfermée, fixée ou enfoncée.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "retirer_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le dentiste a réussi à lui <w>extraire</w> une dent sans douleur."
                        },
                        {
                            "text": "Les pompiers ont dû découper la portière pour <w>extraire</w> le conducteur blessé."
                        }
                    ],
                    "synonyms": [
                        "retirer",
                        "tirer",
                        "ôter"
                    ],
                    "antonyms": [
                        "insérer",
                        "introduire"
                    ],
                    "common_phrases": [
                        "extraire une dent"
                    ]
                },
                {
                    "sense_id": "6304084b-b5f4-331d-b997-6dc91aca94c4",
                    "sense_definition": "Tirer du sol ou d'une mine des substances minérales ou des matières premières.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "exploitation_miniere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette entreprise minière continue d'<w>extraire</w> du charbon dans cette région isolée."
                        },
                        {
                            "text": "Les ouvriers <w>extraient</w> chaque jour plusieurs tonnes de minerai de fer."
                        }
                    ],
                    "synonyms": [
                        "exploiter"
                    ],
                    "common_phrases": [
                        "extraire du charbon",
                        "extraire du minerai",
                        "extraire du pétrole"
                    ]
                },
                {
                    "sense_id": "719b3b14-4b25-3d01-b2b5-946152d004d1",
                    "sense_definition": "Décompresser ou récupérer des données ou des fichiers à partir d'un dossier compressé ou d'une archive.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous devez d'abord <w>extraire</w> les fichiers du dossier compressé avant de les ouvrir."
                        },
                        {
                            "text": "Il a fait un simple clic droit pour <w>extraire</w> le contenu de l'archive téléchargée."
