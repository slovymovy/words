                    },
                    {
                        "form_id": "b6f0e9a3-0cdc-4bbe-94e0-c3096c7ea78e",
                        "entry_id": "647227d5-660e-3c7a-b02c-d4b1fdaba867",
                        "tags": [
                            "variant"
                        ],
                        "form": "darum"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d7a9cd97-4de2-35bf-8a6e-f8ff13a7beae",
                        "entry_id": "647227d5-660e-3c7a-b02c-d4b1fdaba867",
                        "glosses": [
                            "darum"
                        ],
                        "tags": [
                            "colloquial",
                            "short-form"
                        ],
                        "examples": [
                            {
                                "example_id": "5291f706-05b2-4d86-800c-7a23a16ba9a6",
                                "sense_id": "d7a9cd97-4de2-35bf-8a6e-f8ff13a7beae",
                                "text": "Draußen ist's kalt und nass, drum bleib ich zuhaus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84fb59bb-6a37-4130-b2d0-827b8c9065ce",
                        "source_entry_id": "647227d5-660e-3c7a-b02c-d4b1fdaba867",
                        "source_sense_id": "d7a9cd97-4de2-35bf-8a6e-f8ff13a7beae",
                        "source_sense_description": "umgangssprachlich, kurz für: darum",
                        "target_lang_word": "therefore",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "therefore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                        "entry_id": "dfe4845c-c283-3473-b130-6369e1ea8935",
                                        "glosses": [
                                            "Consequently, by or in consequence of that or this cause; referring to something previously stated."
                                        ],
                                        "tags": [
                                            "conjunctive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40fbf13c-cc31-47d7-806b-6082eb0202d9",
                                                "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                                "text": "Traditional values will always have a place—therefore, they will never lose relevance."
                                            },
                                            {
                                                "example_id": "22f9500b-699f-476c-b3b5-d34d86fc9150",
                                                "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                                "text": "I've been explicitly forbidden to leave and therefore must stay longer."
                                            },
                                            {
                                                "example_id": "04756caf-c792-423c-8861-8f44559bd973",
                                                "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                                "text": "I left the office at 5 o'clock. I was therefore not there when the fire started a quarter of an hour later."
                                            },
                                            {
                                                "example_id": "34821ae0-beb5-4463-8426-8a75d84efa86",
                                                "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                                "text": "I have married a wife, and therefore I can not come."
                                            },
                                            {
                                                "example_id": "db9c1fc7-05e9-44c6-ba04-91b1bc88e91b",
                                                "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                                "text": "Je pense, donc je suis (I think, therefore I am)"
                                            },
                                            {
                                                "example_id": "a9c74313-de9b-4036-9e6b-e7e870b9eb8b",
                                                "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                                "text": "In the old days, to my commonplace and unobserving mind, he gave no evidences of genius whatsoever. He never read me any of his manuscripts, […], and therefore my lack of detection of his promise may in some degree be pardoned."
                                            },
                                            {
                                                "example_id": "026260e6-ab62-4f9b-9d70-58e6897be38b",
                                                "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                                "text": "Creating a complete map of the human connectome would therefore be a monumental milestone but not the end of the journey to understanding how our brains work."
                                            },
                                            {
                                                "example_id": "9d6442df-21d4-4bea-b78b-ffe4a6a9468b",
                                                "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                                "text": "He blushes; therefore he is innocent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "643be500-cd4b-3d4e-81a0-8fafa6358794",
                                        "entry_id": "dfe4845c-c283-3473-b130-6369e1ea8935",
                                        "glosses": [
                                            "for that; for it (in reference to a previous statement)"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "conjunctive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1190b7a3-60b3-48fc-83ab-dbd453e9c927",
                                                "sense_id": "643be500-cd4b-3d4e-81a0-8fafa6358794",
                                                "text": "Behold, we have forsaken all, and followed thee; what shall we have therefore?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50017faa-fac9-4eaa-a8bf-95430ad82ffb",
                        "source_entry_id": "647227d5-660e-3c7a-b02c-d4b1fdaba867",
                        "source_sense_id": "d7a9cd97-4de2-35bf-8a6e-f8ff13a7beae",
                        "source_sense_description": "umgangssprachlich, kurz für: darum",
                        "target_lang_word": "aussi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aussi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "83ca4be0-146f-32d5-99d1-02e3b6eb40d6",
                                        "entry_id": "22472235-f7f4-3725-a36e-6ed7f2502a3d",
                                        "glosses": [
                                            "Autant."
                                        ],
                                        "tags": [],
                                        "note": "Établit une égalité qui peut révéler une intensité plus grande qu'à l’habitude",
                                        "examples": [
                                            {
                                                "example_id": "2d26a691-3d84-4413-ac92-87bb359bad7d",
                                                "sense_id": "83ca4be0-146f-32d5-99d1-02e3b6eb40d6",
                                                "text": "Supputer ce qui eût été accompli, avec une volonté différente, est une spéculation aussi vaine que magnifique."
                                            },
                                            {
                                                "example_id": "9bc0a430-0ef4-47ca-b556-2ec0182a0027",
                                                "sense_id": "83ca4be0-146f-32d5-99d1-02e3b6eb40d6",
                                                "text": "Le répandage se fait sur une surface sèche et le gravillonnage suit d’aussi près que possible le répandage, de manière que la surface du gravillon soit bien mouillée par le liant fluide."
                                            },
                                            {
                                                "example_id": "168f5b78-73c4-498e-b8ae-8233c32c5acc",
                                                "sense_id": "83ca4be0-146f-32d5-99d1-02e3b6eb40d6",
                                                "text": "Elle est aussi belle que sa mère."
                                            },
                                            {
                                                "example_id": "453b89f3-f258-4c1b-8518-99e7a5d65391",
                                                "sense_id": "83ca4be0-146f-32d5-99d1-02e3b6eb40d6",
                                                "text": "Il n’est plus aussi beau qu'autrefois."
                                            },
                                            {
                                                "example_id": "416301d8-fa9e-4930-8360-b831b0bc62b1",
                                                "sense_id": "83ca4be0-146f-32d5-99d1-02e3b6eb40d6",
                                                "text": "Vous savez cela aussi bien que moi."
                                            },
                                            {
                                                "example_id": "98ff9ec1-c011-4850-9ce2-520a02a11bdb",
                                                "sense_id": "83ca4be0-146f-32d5-99d1-02e3b6eb40d6",
                                                "text": "Elle danse aussi bien qu'elle chante."
                                            },
                                            {
                                                "example_id": "f6ebba26-b73d-4387-9180-f03e6380f778",
                                                "sense_id": "83ca4be0-146f-32d5-99d1-02e3b6eb40d6",
                                                "text": "Ce livre est estimable, mais il y en a d’aussi bons."
                                            },
                                            {
                                                "example_id": "b6bea828-fb18-4589-9ad2-65b96ea50d89",
                                                "sense_id": "83ca4be0-146f-32d5-99d1-02e3b6eb40d6",
                                                "text": "Il est aussi affable que son frère est bourru."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c0fbaab-78c4-3b37-b420-0ee49fab7fe8",
                                        "entry_id": "22472235-f7f4-3725-a36e-6ed7f2502a3d",
                                        "glosses": [
                                            "Également ; de même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d9a726d-593f-4180-ba5b-7cb992a3de84",
                                                "sense_id": "3c0fbaab-78c4-3b37-b420-0ee49fab7fe8",
                                                "text": "Flic et journaliste, c'est comme chien et chat, c'est comme flic et avocat aussi. Ça s'attire, ça se respecte, ça se cajole ; jusqu'au coup de griffe qui laisse des cicatrices."
                                            },
                                            {
                                                "example_id": "91c68cba-a693-4b2e-b236-29e7704212fc",
                                                "sense_id": "3c0fbaab-78c4-3b37-b420-0ee49fab7fe8",
                                                "text": "Sur le chemin du retour Djinn leva deux lapins et une outarde, que nous fléchâmes aussi, enrichissant notre tableau de chasse en le diversifiant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1288413b-3d31-31ce-9ef8-b385963734a9",
                                        "entry_id": "22472235-f7f4-3725-a36e-6ed7f2502a3d",
                                        "glosses": [
                                            "De plus ; encore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c91066ec-d98b-4599-a2c8-b66ed3e5edb2",
                                                "sense_id": "1288413b-3d31-31ce-9ef8-b385963734a9",
                                                "text": "Dites- lui aussi bonjour de ma part."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4db11e6-25b4-3954-9fcb-4484e25d9afe",
                                        "entry_id": "22472235-f7f4-3725-a36e-6ed7f2502a3d",
                                        "glosses": [
                                            "C’est pourquoi ; à cause de cela."
                                        ],
                                        "tags": [],
                                        "note": "Avec l'inversion de sujet",
                                        "examples": [
                                            {
                                                "example_id": "a8a17d89-37e3-4896-bf67-d9d65ad52925",
                                                "sense_id": "c4db11e6-25b4-3954-9fcb-4484e25d9afe",
                                                "text": "Quinze sous par jour, pour cinq personnes, il n’y a pas de quoi faire gras, je vous assure… Aussi nous ne mangions pas tous les jours parce qu’il fallait d’abord que le père malade ne manquât de rien."
                                            },
                                            {
                                                "example_id": "6424a511-053b-4dfe-a66a-611dd6825906",
                                                "sense_id": "c4db11e6-25b4-3954-9fcb-4484e25d9afe",
                                                "text": "Le général était podagre depuis longtemps et ne pouvait se déplacer qu'avec d'extrêmes difficultés ; aussi se faisait-il porter par ses soldats."
                                            },
                                            {
                                                "example_id": "1af52692-d17d-4da5-9377-e2812150fb6a",
                                                "sense_id": "c4db11e6-25b4-3954-9fcb-4484e25d9afe",
                                                "text": "Aussi, dès les âges les plus reculés, le pays a-t-il été habité."
                                            },
                                            {
                                                "example_id": "88876c70-6121-4f28-94db-60f7bd4fe841",
                                                "sense_id": "c4db11e6-25b4-3954-9fcb-4484e25d9afe",
                                                "text": "Aussi n’aimaient-ils pas à ce que les rarissimes piroguiers de passage photographiassent leur antiques et vénérables maisons croulantes."
                                            },
                                            {
                                                "example_id": "7f449232-b3c0-4570-913d-f516f7f26516",
                                                "sense_id": "c4db11e6-25b4-3954-9fcb-4484e25d9afe",
                                                "text": "Aussi par ce temps où la pièce de cent sous est tapie dans toutes les consciences, où elle roule dans toutes les phrases, le docteur, âgé de trente ans, doué d’une mère sans relations, restait-il garçon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aussi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fcd73633-cbfe-31d9-bdc4-58022bfd5d53",
                                        "entry_id": "3174850c-388d-364c-9176-eac2bb31d110",
                                        "glosses": [
                                            "Marque la conformité, le rapport logique d’une proposition avec celle qui précède."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dca6de4-fe90-4668-b0d3-1ccc953321a4",
                                                "sense_id": "fcd73633-cbfe-31d9-bdc4-58022bfd5d53",
                                                "text": "Il aime les sucreries. Aussi aime-t-il les caramels."
                                            },
                                            {
                                                "example_id": "88415dcf-1ec5-4fed-85be-9476ccffc7f2",
                                                "sense_id": "fcd73633-cbfe-31d9-bdc4-58022bfd5d53",
                                                "text": "Il a été volé la nuit ; mais aussi pourquoi n’y avait-t-il personne pour garder cet entrepôt ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
