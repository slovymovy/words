                "senses": [
                    {
                        "sense_id": "7f40eb24-0727-3e1f-81ac-f6adaff6a27c",
                        "entry_id": "c62c67e7-28ee-3b06-8c47-ba88f486f88f",
                        "glosses": [
                            "Loge initiale d’une colonie de graptolites."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b47618be-676b-4911-bfe3-611276f9ac29",
                                "sense_id": "7f40eb24-0727-3e1f-81ac-f6adaff6a27c",
                                "text": "La sicule est visible, elle est libre sur toute son étude, sur un seul côté, mais elle est plus ou moins enveloppée par la thèque 1¹ de l’autre côté, suivant que la première thèque prend naissance près de l’ouverture de la sicule ou près de son sommet."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "31502e32-8a08-3205-8c26-e0fd7c286947",
                "word": "Sicule",
