                    {
                        "translation_id": "d43831eb-340d-49e7-bd46-f8284839ec6c",
                        "source_entry_id": "e9bfd828-eef0-3f19-a6bb-6197aa4d207c",
                        "source_sense_description": "course of procedure",
                        "target_lang_word": "Verfahren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verfahren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5bcdf36b-c87a-370b-bea9-ed01bd9f44ad",
                                        "entry_id": "5b9f516f-ddf7-318f-b5ed-6095b74813c1",
                                        "glosses": [
                                            "die Art und Weise der Durchführung von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8313dbd-ce86-48f1-bbcd-d155440b9709",
                                                "sense_id": "5bcdf36b-c87a-370b-bea9-ed01bd9f44ad",
                                                "text": "Über das Verfahren müssen wir uns noch verständigen."
                                            },
                                            {
                                                "example_id": "9de79c37-a4ef-4606-bb40-9b583ea64e0d",
                                                "sense_id": "5bcdf36b-c87a-370b-bea9-ed01bd9f44ad",
                                                "text": "[Schwangerschaftsabbrüche:] „An anderthalb Tagen in der Woche macht sie […] Abbrüche – sowohl medikamentös als auch mit der sogenannten Absaugmethode. Dies sind die zwei gängigsten Verfahren.“"
                                            },
                                            {
                                                "example_id": "63fa63cc-b35f-45cf-8109-67e192831d10",
                                                "sense_id": "5bcdf36b-c87a-370b-bea9-ed01bd9f44ad",
                                                "text": "„An der Art des schriftstellerischen Verfahrens lag Bouvard wenig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "310b50ec-0db1-3c84-92f8-61d44484e548",
                                        "entry_id": "5b9f516f-ddf7-318f-b5ed-6095b74813c1",
                                        "glosses": [
                                            "Rechtshandlung oder Gerichtsprozess"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f867c0c5-adce-4616-9e21-53fc602420a0",
                                                "sense_id": "310b50ec-0db1-3c84-92f8-61d44484e548",
                                                "text": "Das Verfahren dauerte wegen Überlastung des Gerichts ungewöhnlich lange."
                                            },
                                            {
                                                "example_id": "95d3ccc1-1755-4fac-af92-02bd6c7ac82c",
                                                "sense_id": "310b50ec-0db1-3c84-92f8-61d44484e548",
                                                "text": "Das Verfahren wurde am 25. Oktober eröffnet […]"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "46cfa6d4-ba81-3b2d-a20f-ed925a493ad9",
                                        "entry_id": "5b9f516f-ddf7-318f-b5ed-6095b74813c1",
                                        "glosses": [
                                            "ein Vorgang bei einer Behörde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0826b360-600d-475f-85c0-a779354c21ab",
                                                "sense_id": "46cfa6d4-ba81-3b2d-a20f-ed925a493ad9",
                                                "text": "Das Verfahren liegt bei der Behörde und kommt nur langsam voran."
                                            },
                                            {
                                                "example_id": "aeb8465f-d022-4319-a92e-cd512fd80786",
                                                "sense_id": "46cfa6d4-ba81-3b2d-a20f-ed925a493ad9",
                                                "text": "„Die zuständige Fakultät der Universität Düsseldorf hat das Verfahren zur Aberkennung des Doktortitels einer früheren Doktorandin eingeleitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "79bdb973-1628-3f97-8114-a30c6afd63ed",
                                        "entry_id": "5b9f516f-ddf7-318f-b5ed-6095b74813c1",
                                        "glosses": [
                                            "(Produktions-)Methode in der Industrie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9dd068f-27ed-45de-b48a-1602877aee30",
                                                "sense_id": "79bdb973-1628-3f97-8114-a30c6afd63ed",
                                                "text": "Für dieses Produkt müssen geeignete Verfahren noch entwickelt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "7aab17d4-9b71-3a65-a9ac-f6a2d7a61acc",
                                        "entry_id": "5b9f516f-ddf7-318f-b5ed-6095b74813c1",
                                        "glosses": [
                                            "Rechenmethode zur Bestimmung eines konkreten Ergebnisses oder zur Lösung eines Problems"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c04cecf5-6878-4d46-bf1c-86630dfb7ca6",
                                                "sense_id": "7aab17d4-9b71-3a65-a9ac-f6a2d7a61acc",
                                                "text": "Man kann die Berechnung mit mehreren Verfahren durchführen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
