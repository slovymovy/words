                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f0e8dd7-928b-4e85-a431-e607f90ad286",
                        "source_entry_id": "e333bd6c-0755-3259-a6dc-5c66f9bffac6",
                        "source_sense_description": "sheets, blankets, quilts or other coverings used on a bed",
                        "target_lang_word": "linge de lit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "linge de lit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7de3e8c8-83a2-3053-a26d-a548e84d131d",
                                        "entry_id": "912c70a2-2557-3125-bda6-2ad938a6579e",
                                        "glosses": [
                                            "Ensemble des pièces de linge utilisées pour la literie, comme les draps, les taies..."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75d6c45a-a27a-4cc3-9d8e-3343625d4bb3",
                                                "sense_id": "7de3e8c8-83a2-3053-a26d-a548e84d131d",
                                                "text": "La taie d'oreiller doit être retirée et lavée régulièrement comme le reste du linge de lit."
                                            },
                                            {
                                                "example_id": "da1d37e5-73b6-4cc1-8f98-d8fe84f7f343",
                                                "sense_id": "7de3e8c8-83a2-3053-a26d-a548e84d131d",
                                                "text": "Torchons, linge de lit, rideaux, serviettes de bain, plaids, les textiles sont une façon de personnaliser son intérieur et de réchauffer un espace aseptisé."
                                            },
                                            {
                                                "example_id": "a14dc3b2-a94f-4aeb-b65f-75207b4d53b6",
                                                "sense_id": "7de3e8c8-83a2-3053-a26d-a548e84d131d",
                                                "text": "Au niveau national, le site Bed and Crous répertorie les logements vacants dans près de 40 villes. Et propose des « escales à prix étudiant » avec des prestations dignes de l’hôtel : linge de lit et serviettes de toilette fournis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd1188b3-e5f9-4b3f-b350-fefccec4653c",
                        "source_entry_id": "e333bd6c-0755-3259-a6dc-5c66f9bffac6",
                        "source_sense_description": "sheets, blankets, quilts or other coverings used on a bed",
                        "target_lang_word": "Bettwäsche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bettwäsche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f4c3712-2bee-3c94-8d51-290cd248844c",
                                        "entry_id": "49fd0222-93cc-364b-909f-79a7b2f4025e",
                                        "glosses": [
                                            "Textilien, die für das Bett verwendet werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9034edd6-259a-44ba-b6a3-c9794647a816",
                                                "sense_id": "9f4c3712-2bee-3c94-8d51-290cd248844c",
                                                "text": "Meine Bettwäsche wird wöchentlich gewechselt."
                                            },
                                            {
                                                "example_id": "90919857-1bca-48db-bdc5-fa2603e33350",
                                                "sense_id": "9f4c3712-2bee-3c94-8d51-290cd248844c",
                                                "text": "„Ein Witz von einem Zimmer, in dem ein Einzelbett stand, bezogen mit Bettwäsche, die von einem so irrealen Weiß war, dass sie staunte.“"
                                            },
                                            {
                                                "example_id": "04f598fd-da7a-4174-a384-2cbbbd99036a",
                                                "sense_id": "9f4c3712-2bee-3c94-8d51-290cd248844c",
                                                "text": "„Wenig später stand Marie auf, küßte mich im Dunkeln und zog die Bettwäsche ab.“"
                                            },
                                            {
                                                "example_id": "7fea68bf-85eb-4ed0-b762-4ed6339550f5",
                                                "sense_id": "9f4c3712-2bee-3c94-8d51-290cd248844c",
                                                "text": "„Als sie weg war, öffnete sie sofort den Kleiderschrank und versteckte das Jäckchen hinter einm Stapel Bettwäsche, wo es keiner sehen konnte.“"
                                            },
                                            {
                                                "example_id": "926ab1ec-7ab1-4220-8316-e9406e591cd6",
                                                "sense_id": "9f4c3712-2bee-3c94-8d51-290cd248844c",
                                                "text": "„Zierkissen, Bettwäsche und Vorhänge waren mit Wasser vollgesogen, in zwei von Mamas Zeitschriften war die Druckerschwärze ausgelaufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e75cd738-3051-4509-a38b-0d23c6b1be38",
                        "source_entry_id": "e333bd6c-0755-3259-a6dc-5c66f9bffac6",
                        "source_sense_description": "sheets, blankets, quilts or other coverings used on a bed",
                        "target_lang_word": "Bettzeug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bettzeug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9674543b-0acf-3f20-8b49-d85af19d53f1",
                                        "entry_id": "8e658945-98f0-3b36-94d1-21fdda43f716",
                                        "glosses": [
                                            "Stoff, mit dem Decke, Matratze und Kopfpolster im Bett überzogen werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf24fd0c-f17e-4d2d-b765-030248e75587",
                                                "sense_id": "9674543b-0acf-3f20-8b49-d85af19d53f1",
                                                "text": "Aber gut - ich ließ ihn weiter schlafen, eilte zu meinem Termin und nahm mir fest vor das Bettzeug zu wechseln - und zwar noch heute."
                                            },
                                            {
                                                "example_id": "4d49cdee-1914-4c88-b85e-57d707b716fd",
                                                "sense_id": "9674543b-0acf-3f20-8b49-d85af19d53f1",
                                                "text": "Dann kommen noch die Kleinigkeiten: \"Das Bettzeug braucht man gar nicht einpacken, weil es ohnehin nicht auf die Kingsize-Betten passt.\""
                                            },
                                            {
                                                "example_id": "cb2ed3f2-0613-4730-b631-3c7e9238058a",
                                                "sense_id": "9674543b-0acf-3f20-8b49-d85af19d53f1",
                                                "text": "„Ganze Wagenzüge bewegten sich landeinwärts – gefüllt mit Bettzeug, Hausgerät und Vorräten.“"
                                            },
                                            {
                                                "example_id": "57fbd742-b607-416d-99ea-8543dc9c3504",
                                                "sense_id": "9674543b-0acf-3f20-8b49-d85af19d53f1",
                                                "text": "„Ich legte mein eigenes Bettzeug auf die Schlafstelle, klopfte die Schubladen der Kommode aus und legte die wenigen Habseligkeiten, die ich mitnehmen wollte, hinein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
