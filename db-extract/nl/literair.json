                    },
                    {
                        "translation_id": "783a7c82-176e-418b-8db5-e7b2c91dd3fa",
                        "source_entry_id": "b1f99b2f-ba37-35ae-8926-dacfcceb392e",
                        "source_sense_id": "5dbb16d1-9859-3a1b-89b9-0076dba87e3f",
                        "target_lang_word": "littéraire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "littéraire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ad3f7ba-e908-3b64-88ae-13798de93c1c",
                                        "entry_id": "c25572c2-1e95-3abb-9f72-5b4d3e2572ab",
                                        "glosses": [
                                            "Qui appartient aux lettres, à la littérature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be635fb0-2031-4c47-8a9f-5706ccfcc025",
                                                "sense_id": "9ad3f7ba-e908-3b64-88ae-13798de93c1c",
                                                "text": "Ces malfaiteurs littéraires voudraient persuader de tels hommes qu’ils n’ont pas besoin d’excuse et que leur conduite se conforme au dictamen de la nature."
                                            },
                                            {
                                                "example_id": "09ab3cf2-c73e-4e78-b252-2a45c5c05691",
                                                "sense_id": "9ad3f7ba-e908-3b64-88ae-13798de93c1c",
                                                "text": "Je sais fort bien qui est Mr Kipling, bien que vous ayez cru bon dans votre \"Étude en rouge\" de me faire passer pour un béotien en décrivant ma culture littéraire comme nulle !"
                                            },
                                            {
                                                "example_id": "8b96663e-8a76-4ad7-bc61-e335184bd84e",
                                                "sense_id": "9ad3f7ba-e908-3b64-88ae-13798de93c1c",
                                                "text": "Ensuite, il est question de réinscrire la production littéraire gibranienne dans la vaste histoire littéraire de sa communauté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "511184b5-1e81-337e-9f7e-321b95a2cc17",
                                        "entry_id": "c25572c2-1e95-3abb-9f72-5b4d3e2572ab",
                                        "glosses": [
                                            "Qualifie un esprit caractérisé par le goût et l’intelligence de la littérature."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad1e0285-115e-42b2-95d4-5af1959b618c",
                                                "sense_id": "511184b5-1e81-337e-9f7e-321b95a2cc17",
                                                "text": "Notre homme était un officier supérieur à la retraite qui cachait, j’allais l’apprendre assez vite, une fine culture littéraire derrière son côté scrogneugneu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa1bb68a-acb0-3deb-8563-943734200d14",
                                        "entry_id": "c25572c2-1e95-3abb-9f72-5b4d3e2572ab",
                                        "glosses": [
                                            "Se dit des qualités de composition et de style par lesquelles se caractérisent les œuvres qui appartiennent à la littérature."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "littéraire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ad7181dc-d691-35f8-a93a-2b1e8adb5d88",
                                        "entry_id": "cd974a3e-f8de-30e3-8bbb-10261f0e4721",
                                        "glosses": [
                                            "Personne étudiant ou enseignant les lettres."
                                        ],
                                        "tags": [],
                                        "examples": [
