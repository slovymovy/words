                "senses": [
                    {
                        "sense_id": "9f7784b1-ac17-3e19-9b61-412c41287b7f",
                        "entry_id": "8b99a647-4cd0-376b-9424-65a010f9a8ac",
                        "glosses": [
                            "Herrschaftsgebiet der Moguln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdbf069b-d378-4902-a5de-5f8559f1784d",
                                "sense_id": "9f7784b1-ac17-3e19-9b61-412c41287b7f",
                                "text": "„Unter der Herrschaft Akbars des Großen kam das Mogulreich zu voller Blüte.“"
                            },
                            {
                                "example_id": "564f3851-7ec7-46b8-bc7c-8175c5b50be9",
                                "sense_id": "9f7784b1-ac17-3e19-9b61-412c41287b7f",
                                "text": "„Schon bald nach der Thronbesteigung zeigte sich, dass im Mogulreich nun ein neuer Wind wehte.“"
                            },
                            {
                                "example_id": "888c309f-2266-438b-a9e0-6b64f3849156",
                                "sense_id": "9f7784b1-ac17-3e19-9b61-412c41287b7f",
                                "text": "„Er starb 1680, doch sein Sohn Sambhaji führte den Widerstand gegen das Mogulreich fort.“"
                            },
                            {
                                "example_id": "0fa4a377-c2c8-448f-ba8c-c1c6b9932b05",
                                "sense_id": "9f7784b1-ac17-3e19-9b61-412c41287b7f",
                                "text": "„Diese Phase endete erst mit dem allmählichen Zerfall des Mogulreiches im 18. Jahrhundert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
