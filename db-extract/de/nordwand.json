                            {
                                "example_id": "f07e546d-9d95-410e-98ac-d9aa6af8b1fb",
                                "sense_id": "1a36e08c-7332-3900-bf98-990549b16522",
                                "text": "Die Nordwand verbirgt sich hinter Nebelwänden."
                            },
                            {
                                "example_id": "844a93b8-883c-4c10-aa7b-78f73762ae72",
                                "sense_id": "1a36e08c-7332-3900-bf98-990549b16522",
                                "text": "„Am Fuß der steilen Nordwand des Bischofs sind Lawinenkegel zu sehen.“"
                            }
                        ],
