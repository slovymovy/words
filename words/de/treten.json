                    "sense_id": "937cd476-e415-3e85-8c75-aea52922b499",
                    "sense_definition": "wenige Schritte machen oder sich zu Fuß an einen bestimmten Ort stellen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er stand auf und <w>trat</w> an das offene Fenster, um frische Luft zu atmen."
                        },
                        {
                            "text": "Bitte <w>treten</w> Sie einen Schritt zur Seite, damit die Leute durchgehen können."
                        }
                    ],
                    "synonyms": [
