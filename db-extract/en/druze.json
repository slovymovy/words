                        "entry_id": "86179eef-00dd-3ab0-a496-78d820eb2d6d",
                        "glosses": [
                            "Of or relating to this religious community."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "071b920b-e246-4fa3-b228-aaef8f30ba56",
                                "sense_id": "40744ae3-0118-38e6-a501-822b6d09406c",
                                "text": "\"The judges were very surprised when they found out I was Druze,\" she told Sonia Verma in The Times."
                            },
                            {
                                "example_id": "afb742a8-674a-40dd-b7c7-21e2922762b2",
                                "sense_id": "40744ae3-0118-38e6-a501-822b6d09406c",
                                "text": "Druze men shouted insults when she walked down the street."
                            }
                        ]
                    }
