                "senses": [
                    {
                        "sense_id": "f6d6c62b-2312-34d2-98e4-cbcdd7933402",
                        "entry_id": "bf9ca28d-36d8-3386-ae07-45b371b7be35",
                        "glosses": [
                            "Puzzle, bei dem Figurenteile oder geometrische Formen stimmig und/oder ästhetisch zu einem Ganzen zusammengefügt werden sollen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2d0473b-5b31-4017-96c7-1b560e685c4e",
                                "sense_id": "f6d6c62b-2312-34d2-98e4-cbcdd7933402",
                                "text": "„Gleichgültig, ob es ältere Legespiele als Tangram gibt oder nicht, Tangram ist für eine große Gruppe geometrischer Legespiele der Prototyp par excellence, und es ist unbestritten, dass eine Reihe von Legespielen das Tangram zum Vorbild hatte.“"
                            },
                            {
                                "example_id": "2d3bedff-8eba-4193-81e1-20c5e756f410",
                                "sense_id": "f6d6c62b-2312-34d2-98e4-cbcdd7933402",
                                "text": "„Die planimetrischen Legespiele -artenreich und vielgestaltig- haben merkwürdigerweise in der Unterhaltungsmathematik lediglich einen Randplatz eingenommen.“"
                            },
                            {
                                "example_id": "f747de24-98d3-4230-8114-04eec44baa95",
                                "sense_id": "f6d6c62b-2312-34d2-98e4-cbcdd7933402",
                                "text": "„Die Duette, Quartette, Puzzles, Legespiele, Quizkarten, Kartenspiele dienen der Aneignung und Festigung von Verkehrswissen.“"
                            },
                            {
                                "example_id": "11984bba-5db9-4da1-b79d-1aa6e525503b",
                                "sense_id": "f6d6c62b-2312-34d2-98e4-cbcdd7933402",
                                "text": "„Bei einem Legespiel werden meistens bestimmte Teile passend aneinander angelegt, daher der Name. Legespiele sind zum Beispiel solche Klassiker wie Domino, aber auch Tangram.“"
                            },
                            {
                                "example_id": "31d2df90-8cb4-433d-8b7c-c846a842f4b3",
                                "sense_id": "f6d6c62b-2312-34d2-98e4-cbcdd7933402",
                                "text": "„Mit Hilfe der zwei Legespiele soll durch geschicktes Vergleichen von Flächen der Satz des Pythagoras haptisch bewiesen werden.“"
                            },
                            {
                                "example_id": "9f3f217a-813d-4a27-9868-1817d2093cf0",
                                "sense_id": "f6d6c62b-2312-34d2-98e4-cbcdd7933402",
                                "text": "„Puzzleartige Legespiele sollen die verschiedenen mathematischen Strukturen verdeutlichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
