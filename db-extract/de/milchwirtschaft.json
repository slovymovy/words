                    {
                        "sense_id": "4e5bd15b-0d64-35f9-880d-244c4a159802",
                        "entry_id": "8bfeae83-212c-37a6-9068-e5637c034c45",
                        "glosses": [
                            "Wirtschaftszweig, der sich mit der Herstellung und der Verarbeitung und dem Vertrieb von Milch beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "799fce26-4215-477e-9380-e2e8f7391f36",
                                "sense_id": "4e5bd15b-0d64-35f9-880d-244c4a159802",
                                "text": "„Foldenauer stammt aus dem Allgäu, wo die Milchwirtschaft nach wie vor eine große Rolle spielt.“"
                            },
                            {
                                "example_id": "742585e8-86eb-432e-879a-e591d643a27d",
                                "sense_id": "4e5bd15b-0d64-35f9-880d-244c4a159802",
                                "text": "„Ursprünglich stammen Viehzucht und Milchwirtschaft, ebenso wie der Ackerbau, aus dem Nahen Osten.“"
                            },
                            {
                                "example_id": "d3bb5aa1-aa07-4899-b56e-32fcb00f73aa",
                                "sense_id": "4e5bd15b-0d64-35f9-880d-244c4a159802",
                                "text": "„Mit dem Beitritt Irlands zur Europäischen Wirtschaftsgemeinschaft (EWG) 1973 expandierte die irische Milchwirtschaft auf den Kontinent.“"
                            }
                        ],
