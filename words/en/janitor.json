{
    "word_family": [
        "janitorial"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ba068a7d-e8df-3106-9430-f54d351fcbef",
                    "sense_definition": "A person employed to look after, clean, and maintain a public building, such as a school or office.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "building_maintenance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school <w>janitor</w> made sure all the classrooms were clean and locked before leaving for the night.",
                            "target_lang_translations": {
                                "ru": "Школьный <w>уборщик</w> убедился, что все классы чисты и заперты, прежде чем уйти домой на ночь."
                            }
                        },
                        {
                            "text": "If you spill your drink in the hallway, please ask the <w>janitor</w> for help.",
                            "target_lang_translations": {
                                "ru": "Если вы прольете напиток в коридоре, пожалуйста, попросите <w>уборщика</w> о помощи."
                            }
                        }
                    ],
                    "synonyms": [
                        "caretaker",
                        "custodian",
                        "cleaner",
                        "maintenance person"
                    ],
                    "common_phrases": [
                        "school janitor",
                        "building janitor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, нанятый для присмотра, уборки и обслуживания общественного здания, такого как школа или офис."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уборщик",
                                "target_lang_sense_clarification": "человек, занимающийся уборкой помещений"
                            },
                            {
                                "target_lang_word": "дворник",
                                "target_lang_sense_clarification": "работник, поддерживающий чистоту во дворе и на прилегающей территории"
                            },
                            {
                                "target_lang_word": "завхоз",
                                "target_lang_sense_clarification": "заведующий хозяйством, занимающийся обслуживанием здания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8714c93-ba41-3c16-87a5-a49830396d36",
                    "sense_definition": "A doorkeeper or doorman.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "doorkeeper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient Roman houses, the <w>janitor</w> guarded the entrance and greeted guests at the door.",
                            "target_lang_translations": {
                                "ru": "В древнеримских домах <w>привратник</w> охранял вход и встречал гостей у дверей."
                            }
                        },
                        {
                            "text": "The old building still employed a traditional <w>janitor</w> to monitor who entered the lobby.",
                            "target_lang_translations": {
                                "ru": "В старом здании по-прежнему работал традиционный <w>вахтёр</w>, который следил за тем, кто входит в вестибюль."
                            }
                        }
                    ],
                    "synonyms": [
                        "porter"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in the historical sense of a doorkeeper"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Привратник, швейцар или дежурный у входа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привратник",
                                "target_lang_sense_clarification": "сторож у ворот или у входа"
                            },
                            {
                                "target_lang_word": "швейцар",
                                "target_lang_sense_clarification": "служащий при входе в ресторан, гостиницу или жилой дом"
                            },
                            {
                                "target_lang_word": "вахтёр",
                                "target_lang_sense_clarification": "дежурный сторож в проходной учреждения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d8e5b6a-1967-3e29-8f1d-fd0cafc8717c",
                    "sense_definition": "A moderator for an online discussion forum.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "online_moderator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The forum <w>janitor</w> quickly deleted the spam posts and banned the offending user.",
                            "target_lang_translations": {
                                "ru": "Форумный <w>модератор</w> быстро удалил спам-сообщения и заблокировал нарушителя."
                            }
                        },
                        {
                            "text": "Some users complained that the online <w>janitor</w> was being too strict with the community rules.",
                            "target_lang_translations": {
                                "ru": "Некоторые пользователи жаловались, что сетевой <w>модератор</w> слишком строго следит за соблюдением правил сообщества."
                            }
                        }
                    ],
                    "synonyms": [
                        "jannie",
                        "janny",
                        "moderator",
                        "mod"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Internet slang for a forum moderator"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Модератор на интернет-форуме или в онлайн-сообществе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "модератор",
                                "target_lang_sense_clarification": "пользователь, следящий за порядком на интернет-ресурсе"
                            },
                            {
                                "target_lang_word": "админ",
                                "target_lang_sense_clarification": "администратор или модератор онлайн-сообщества"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}