                ],
                "senses": [
                    {
                        "sense_id": "84ae6e9d-30fb-36af-be44-d96e78a48318",
                        "entry_id": "ca2477b2-9257-3654-bc31-7b149bd1fe4c",
                        "glosses": [
                            "то же, что слепой; неспособный видеть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71262f46-cf8e-4644-8e09-76abdde67886",
                                "sense_id": "84ae6e9d-30fb-36af-be44-d96e78a48318",
                                "text": "Институт выбросил нас в жизнь глупыми незрячими щенками."
                            },
                            {
                                "example_id": "3a7255d2-5b7d-44e2-b36b-8a5be0d7cacb",
                                "sense_id": "84ae6e9d-30fb-36af-be44-d96e78a48318",
                                "text": "Луна хорошо помогала Маргарите, светила лучше, чем самый лучший электрический фонарь, и Маргарита видела, что сидящий, глаза которого казались слепыми, коротко потирает свои руки и эти самые незрячие глаза вперяет в диск луны."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e1f1fcb-63d3-3d7f-b50a-e3357e13f810",
