                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69b41061-d5a7-46a6-a236-3ed7f4c05833",
                                                "sense_id": "3bccfb99-dd79-35fd-8681-b1c85564d725",
