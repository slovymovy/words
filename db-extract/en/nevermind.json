            {
                "entry_id": "a51d649c-45a0-3788-a824-e61aaa46cff0",
                "word": "nevermind",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "cc2228c4-9ddd-4779-a480-5fb0483ee5f6",
                        "entry_id": "a51d649c-45a0-3788-a824-e61aaa46cff0",
                        "tags": [
                            "plural"
