                                        "sense_id": "1850f04e-53a1-3f0b-9f5f-fd72e178f364",
                                        "entry_id": "6af915ed-3fff-3187-8b17-7815990070ac",
                                        "glosses": [
                                            "Any of very many photosynthetic prokaryotic microorganisms, of phylum Cyanobacteria."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ee56748-e097-47c7-81f0-a0021a1ef1a9",
                                                "sense_id": "1850f04e-53a1-3f0b-9f5f-fd72e178f364",
                                                "text": "At some point in the first billion years of life, cyanobacteria, or blue-green algae, learned to tap into a freely available resource – the hydrogen that exists in spectacular abundance in water."
                                            },
                                            {
                                                "example_id": "2d39d1d6-8485-403b-9fc5-acbe6b5a6fbf",
                                                "sense_id": "1850f04e-53a1-3f0b-9f5f-fd72e178f364",
                                                "text": "Photosynthesis was established some billion years ago by ancient bacterial precursors of modern cyanobacteria."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
