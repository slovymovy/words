                        "sense_id": "57e452aa-9558-3023-8811-fbbc82e966e7",
                        "entry_id": "27d1f9e2-455a-3099-8441-e62ebfd03242",
                        "glosses": [
                            "Étude des connexions entre les neurones, en particulier entre des régions cérébrales différentes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bf94c4f-3b51-460b-ab93-ee22520ec4fb",
                                "sense_id": "57e452aa-9558-3023-8811-fbbc82e966e7",
                                "text": "On tient là un des chapitres importants des neurosciences contemporaines : la connectomique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae8e3976-f51c-4348-9247-162bcc10d8e6",
                        "source_entry_id": "27d1f9e2-455a-3099-8441-e62ebfd03242",
                        "source_sense_id": "57e452aa-9558-3023-8811-fbbc82e966e7",
                        "target_lang_word": "connectomics",
                        "target_lang_code": "en",
