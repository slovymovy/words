                        "examples": [
                            {
                                "example_id": "3d8e2153-7c0b-4b85-b6d6-588f6a963f2f",
                                "sense_id": "05602c46-01fc-34cf-9b0c-47eba3e8ecae",
                                "text": "„Innerhalb der Ärzteschaft gibt es ebenfalls Coronaskeptiker.“"
                            },
                            {
                                "example_id": "3c126610-0e08-4ad5-a4a8-b650b087c05c",
                                "sense_id": "05602c46-01fc-34cf-9b0c-47eba3e8ecae",
                                "text": "„Coronaskeptiker bekommen überproportional Raum in Politik und Medien.“"
                            },
                            {
                                "example_id": "d8033e92-639e-498c-8deb-a2a673f30859",
                                "sense_id": "05602c46-01fc-34cf-9b0c-47eba3e8ecae",
                                "text": "„Kurz vor dem für diesem Samstag in Leipzig geplanten Protest radikaler Coronaskeptiker bekommt die Aggressivität der Szene eine neue Dimension.“"
                            },
                            {
                                "example_id": "124191ee-7f38-442f-89f5-04b52e536cfe",
                                "sense_id": "05602c46-01fc-34cf-9b0c-47eba3e8ecae",
                                "text": "„Erst kürzlich war Thüringens Regierungschef Ramelow Ziel von Aktionen aus dem Lager der Coronaskeptiker.“"
                            }
