                                    },
                                    {
                                        "sense_id": "802ea091-192d-301e-9ecc-8e3693b56a72",
                                        "entry_id": "7e2dfa20-f6ab-39d5-bc64-4e09feee0376",
                                        "glosses": [
                                            "Paliza."
