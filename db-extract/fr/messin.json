                        "entry_id": "a099fc69-5084-377c-88b4-374f83ed19ef",
                        "glosses": [
                            "Relatif à Metz, commune de la Moselle, ou à ses habitants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9cff97f-c0ee-4f2f-8f15-ff8227b04987",
                                "sense_id": "909ed3c4-9d41-3d0a-a140-2f1b100edd6b",
                                "text": "Le pays messin."
                            },
                            {
                                "example_id": "cde9f189-662f-41ab-a3af-218f975a0606",
                                "sense_id": "909ed3c4-9d41-3d0a-a140-2f1b100edd6b",
                                "text": "Vous êtes nancéien et moi je suis messin :\nVive donc à jamais cette vieille Lorraine\nQui nous vit naître et nous réchauffa dans son sein\nEt dont, fils pieux, nous baisons le front de reine."
                            }
                        ]
                    }
