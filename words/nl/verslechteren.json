{
    "word_family": [
        "slecht",
        "slechter",
        "verslechtering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4ee1e8db-c2e7-350a-b911-5ae6b2bdb181",
                    "sense_definition": "slechter worden, in kwaliteit of toestand achteruitgaan",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "kwaliteitsverandering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De humanitaire situatie <w>verslechtert</w> per maand.",
                            "target_lang_translations": {
                                "en": "The humanitarian situation <w>worsens</w> by the month."
                            }
                        },
                        {
                            "text": "Zijn gezondheid begon snel te <w>verslechteren</w> na de winter.",
                            "target_lang_translations": {
                                "en": "His health began to <w>deteriorate</w> rapidly after the winter."
                            }
                        }
                    ],
                    "synonyms": [
                        "achteruitgaan",
                        "verergeren"
                    ],
                    "antonyms": [
                        "verbeteren",
                        "vooruitgaan"
                    ],
                    "common_phrases": [
                        "snel verslechteren",
                        "situatie verslechtert"
                    ],
                    "target_lang_definitions": {
                        "en": "To become worse, to decline in quality or condition"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deteriorate",
                                "target_lang_sense_clarification": "to become progressively worse in quality or state"
                            },
                            {
                                "target_lang_word": "worsen",
                                "target_lang_sense_clarification": "to become worse or more difficult"
                            },
                            {
                                "target_lang_word": "decline",
                                "target_lang_sense_clarification": "to gradually become less, worse, or weaker"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b17a40ec-b59e-38a9-bbb6-778930a5f2e0",
                    "sense_definition": "slechter maken, de kwaliteit of toestand van iets verminderen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kwaliteitsverandering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De sombere stemming werd <w>verslechterd</w> door tegenvallende cijfers over de economische groei in 's werelds grootste economie.",
                            "target_lang_translations": {
                                "en": "The gloomy mood was <w>worsened</w> by disappointing figures on economic growth in the world's largest economy."
                            }
                        },
                        {
                            "text": "Nieuwe maatregelen kunnen de relatie tussen beide landen alleen maar <w>verslechteren</w>.",
                            "target_lang_translations": {
                                "en": "New measures can only <w>worsen</w> the relationship between both countries."
                            }
                        }
                    ],
                    "synonyms": [
                        "verergeren"
                    ],
                    "antonyms": [
                        "verbeteren"
                    ],
                    "common_phrases": [
                        "de sfeer verslechteren",
                        "de relatie verslechteren"
                    ],
                    "target_lang_definitions": {
                        "en": "To make worse, to reduce the quality or condition of something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "worsen",
                                "target_lang_sense_clarification": "to make something worse"
                            },
                            {
                                "target_lang_word": "deteriorate",
                                "target_lang_sense_clarification": "to make something inferior in quality or value"
                            },
                            {
                                "target_lang_word": "exacerbate",
                                "target_lang_sense_clarification": "to make a problem, bad situation, or negative feeling worse"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}