                ],
                "senses": [
                    {
                        "sense_id": "b0a1eb3e-5bac-3232-8581-07d3b1573d8d",
                        "entry_id": "1d2b0eef-345f-3157-b3ae-c50db651619c",
                        "glosses": [
                            "de postdienst, het postwezen, meestal wordt alleen de meervoudsvorm posterijen gebruikt"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d497155d-0e6d-4930-a2b6-46137ce55028",
                                "sense_id": "b0a1eb3e-5bac-3232-8581-07d3b1573d8d",
                                "text": "De Zwitserse posterijen zijn niet de enigen die met vliegende bezorging experimenteren. Ook pakketbezorger UPS, Amazon en Google zijn volop met dronebezorging aan het proefdraaien."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1e3de19-5c02-34bb-8aab-314d8a16f223",
                        "entry_id": "1d2b0eef-345f-3157-b3ae-c50db651619c",
                        "glosses": [
                            "het postkantoor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b41c3b32-4a63-4135-a96b-8bf63a85ba0f",
                                "sense_id": "b1e3de19-5c02-34bb-8aab-314d8a16f223",
                                "text": "‘Dagelijks willen bezoekers een brief versturen of geld afhalen. Zowel onwetende Bruggelingen als toeristen die via Google of een toeristische gids hier terechtkomen’, zegt Lieselot Stevens van Sissy Boy. Met de grote rode brievenbus in de gevel en het opschrift posterijen oogt het gebouw nog als een postkantoor. ‘Na een jaar begon het toch vervelend te worden.’ Daarom prijkt aan de ingang nu het opschrift ‘dit is geen postkantoor’."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c63ccf30-1854-4f34-a321-1083f085705c",
                        "source_entry_id": "1d2b0eef-345f-3157-b3ae-c50db651619c",
                        "source_sense_id": "b1e3de19-5c02-34bb-8aab-314d8a16f223",
                        "source_sense_description": "het postkantoor",
                        "target_lang_word": "post office",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "post office",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c47242d-8db8-3591-9be7-092e37e84c55",
                                        "entry_id": "64821770-5126-3093-87dd-5c2815bd2290",
                                        "glosses": [
                                            "A place (building, office, shop, or counter) concerned with the business of delivering letters, post or mail and selling stamps, etc."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f767428-f233-471f-85fd-a85acd1dcbaf",
                                                "sense_id": "2c47242d-8db8-3591-9be7-092e37e84c55",
                                                "text": "We were over the border here, into Northern Ireland, and the post office had a very English atmosphere. It was pleasant, too, much as we enjoyed the hospitality of the Republic, to be buying stamps with the Queen's head on them, and to be posting our cards in a red pillar-box, instead of a green one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c1b74e3-1d60-30a5-bbc5-7a4d3285ce57",
                                        "entry_id": "64821770-5126-3093-87dd-5c2815bd2290",
                                        "glosses": [
                                            "An organization that delivers letters."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaf4f261-2331-49cc-b507-9dc6a9278476",
                                                "sense_id": "5c1b74e3-1d60-30a5-bbc5-7a4d3285ce57",
                                                "text": "“The post-office is a wonderful establishment!” said she.—“The regularity and despatch of it! If one thinks of all that it has to do, and all that it does so well, it is really astonishing!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3adb3291-e860-3c19-8083-b2d9ee4e0375",
                                        "entry_id": "64821770-5126-3093-87dd-5c2815bd2290",
