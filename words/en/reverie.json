                            },
                            {
                                "target_lang_word": "иллюзия",
                                "target_lang_sense_clarification": "обманчивое видение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4ff80e1-ccfb-37e9-91c1-e7dfddad2f80",
                    "sense_definition": "An act of lighthearted play, frolic, or noisy merriment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "merriment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The festival was a time for music, dance, and general <w>reverie</w>.",
                            "target_lang_translations": {
                                "ru": "Фестиваль был временем музыки, танцев и всеобщего <w>веселья</w>."
                            }
                        },
                        {
                            "text": "They spent the evening in a joyful <w>reverie</w> after the successful performance.",
                            "target_lang_translations": {
                                "ru": "Они провели вечер в радостном <w>праздновании</w> после успешного выступления."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in this sense today"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт беззаботной игры, резвления или шумного веселья."
                    },
                    "translations": {
                        "ru": [
                            {
