                        ]
                    },
                    {
                        "translation_id": "08c30602-205b-4198-bc28-bec38fe5d987",
                        "source_entry_id": "1666a2e1-bde2-3207-a354-e37af10469c2",
                        "source_sense_id": "34cd384e-01e0-3b56-ae4a-d4ab931038eb",
                        "source_sense_description": "star divination",
                        "target_lang_word": "astrologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astrologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dd83d7dc-4fea-320b-b8a8-f112bdfa0774",
                                        "entry_id": "78998725-b189-336e-8ab4-fbe0312f1ff2",
                                        "glosses": [
                                            "Description de l’influence, ou de la correspondance, supposée des astres sur le caractère ou sur la destinée des hommes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bcc8734-9b5d-4a39-9a5c-f738aaa9856b",
                                                "sense_id": "dd83d7dc-4fea-320b-b8a8-f112bdfa0774",
                                                "text": "L’astrologie judiciaire était alors en vogue. La haute raison du président de L'Alouette condamnait cette science frivole et chimérique. Il écrivit pour la discréditer et en démontrer le vide et la nullité."
                                            },
                                            {
                                                "example_id": "a92fd883-651e-4def-b9df-dde2e69c7cbb",
                                                "sense_id": "dd83d7dc-4fea-320b-b8a8-f112bdfa0774",
                                                "text": "Dans leurs mouvemens immuables, la fatalité semble se révéler à chaque pas, et de là cette croyance à l’astrologie, si répandue chez tant de nations éclairées. Les découvertes de la science moderne, en détruisant ce qu'il y avait de superstitieux dans ces applications de l’astronomie, n’ont peut-être que confirmé ce caractère général."
                                            },
                                            {
                                                "example_id": "8812db5a-01f6-478d-8de6-77bef5a8e5b1",
                                                "sense_id": "dd83d7dc-4fea-320b-b8a8-f112bdfa0774",
                                                "text": "La mise au point qui suit nous permettra toutefois de dénoncer la facilité avec laquelle les hérauts de l’astrologie s’adonnent à la désinformation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0b302a2-8c35-4173-b309-b1c8c4df479c",
                        "source_entry_id": "1666a2e1-bde2-3207-a354-e37af10469c2",
                        "source_sense_id": "34cd384e-01e0-3b56-ae4a-d4ab931038eb",
                        "source_sense_description": "star divination",
                        "target_lang_word": "Astrologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Astrologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f38aae5c-43c9-329b-92f6-1c56c1decd99",
                                        "entry_id": "2436054a-f9e2-37f4-9da6-84e40a29544b",
                                        "glosses": [
                                            "systematisch betriebene anthropologisch-mythologische Deutung der Stellung bestimmter Himmelskörper"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d0a9cfa-a51d-4f23-8cc7-6c3f02f84f4c",
                                                "sense_id": "f38aae5c-43c9-329b-92f6-1c56c1decd99",
                                                "text": "Astrologie ist im Gegensatz zu Astronomie keine Wissenschaft."
                                            },
                                            {
                                                "example_id": "7509fb8e-1b52-4288-bee3-2e4b8fe75496",
                                                "sense_id": "f38aae5c-43c9-329b-92f6-1c56c1decd99",
                                                "text": "„Perchta Mergenin wohnte in einer großen Sechs-Zimmer-Wohnung in Berlin und beschäftigte sich neben Hellseherei auch mit Astrologie.“"
                                            },
                                            {
                                                "example_id": "4c1dac3e-1b01-483d-aa62-1542eaa9712a",
                                                "sense_id": "f38aae5c-43c9-329b-92f6-1c56c1decd99",
                                                "text": "„Die Anfänge der Astrologie dürften im 3. Jahrtausend [v. Chr.] liegen, obwohl aus dieser Zeit keine einschlägigen Texte erhalten sind.“"
                                            },
                                            {
                                                "example_id": "35eb8bfb-5ae9-4965-9ff3-22e8b746718b",
                                                "sense_id": "f38aae5c-43c9-329b-92f6-1c56c1decd99",
                                                "text": "„Mystische Anschauung der Astrologie und exakte Wissenschaft der Astronomie lassen sich zwar formell trennen, sie bilden jedoch in der Geistesgeschichte der Menschheit seit jeher eine eigentümliche Verquickung, die auch heutzutage noch zu den seltsamsten Ergebnissen führt.“"
                                            },
                                            {
                                                "example_id": "952bc67e-0a9e-44e2-8c28-21dfd4d5a6e8",
                                                "sense_id": "f38aae5c-43c9-329b-92f6-1c56c1decd99",
                                                "text": "„Alchimie oder Astrologie sind heute keine Wissenschaften mehr.“"
                                            },
                                            {
                                                "example_id": "8b19840f-1943-4034-bc69-7c5e297c5384",
                                                "sense_id": "f38aae5c-43c9-329b-92f6-1c56c1decd99",
                                                "text": "„… die zur Astrologie, zur Beachtung des Planetenstandes, der Konstellation und ihrer glücklichen oder verderblichen Ansagen führt, — ganz natürlich und mit Recht; denn die intime Abhängigkeit der Körper einer so eng zusammengehörigen kosmischen Winkelgruppe wie unseres Sonnensystems voneinander, ihr innignachbarlicher gegenseitiger Bezug liegt ja auf der Hand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
