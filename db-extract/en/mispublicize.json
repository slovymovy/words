                        "sense_id": "f4024898-749f-3abb-8a60-767e7e1300d7",
                        "entry_id": "4ed350ec-32ff-3a4a-bd94-c0032d50011e",
                        "glosses": [
                            "To publicize in a misleading, biased, or inaccurate manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48959f37-46b9-48a7-981c-81d4018eb42f",
                                "sense_id": "f4024898-749f-3abb-8a60-767e7e1300d7",
                                "text": "The whole problem of cosmetic surgery has in the past had a rather unfavorable light cast upon it because it has been misused and mispublicized."
                            },
                            {
                                "example_id": "717e0e08-85e4-437e-b8f9-2677858a3745",
                                "sense_id": "f4024898-749f-3abb-8a60-767e7e1300d7",
                                "text": "Without careful assessment of impact and modification of communications, it is quite possible through mass media to mispublicize or overpublicize."
                            },
                            {
                                "example_id": "2164d040-6e19-4073-b329-5693acacb8c6",
                                "sense_id": "f4024898-749f-3abb-8a60-767e7e1300d7",
                                "text": "It's quite true that Korea has been mispublicized in the United States especially."
                            },
                            {
                                "example_id": "9e683bd0-5162-49a1-b6a2-34517e2fe3c6",
                                "sense_id": "f4024898-749f-3abb-8a60-767e7e1300d7",
                                "text": "At the school board's September 19 meeting, James Detwiler claimed that the board's 1954 decision to no longer contribute to the Jeanes Library has been “mispublicized” all these years. It had nothing to do with Knowles's refusual to sign a Loyalty Oath, he said, not at all."
                            }
                        ]
