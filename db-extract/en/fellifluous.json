                "senses": [
                    {
                        "sense_id": "51dda6b0-ae31-3ce6-9674-50d9d524fb96",
                        "entry_id": "016dbe62-11ef-3ae6-b36f-640ded5866d8",
                        "glosses": [
                            "Flowing with bile or gall."
                        ],
                        "tags": [
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "f85f9b1d-d86f-41d0-9872-ac594d5695da",
                                "sense_id": "51dda6b0-ae31-3ce6-9674-50d9d524fb96",
                                "text": "Truth never reveals itself either to the enthusiast smitten with his own reveries; to the fellifluous fanatic enslaved by his prejudices; to the vain glorious mortal puffed up with his own presumptuous ignorance […]"
                            },
                            {
                                "example_id": "3f015bb4-6b9f-46fc-9f97-4febc4f79139",
                                "sense_id": "51dda6b0-ae31-3ce6-9674-50d9d524fb96",
                                "text": "Its claws scratch at the back of his eyeballs and cause him to see visions, to shriek with fevers, to choke in the embrace of fetid and fellifluous chimeras […]"
                            },
                            {
                                "example_id": "b7d406a0-4991-48ed-bc43-3e6ab46eb241",
                                "sense_id": "51dda6b0-ae31-3ce6-9674-50d9d524fb96",
                                "text": "The disease of cholera, according to some, derives its name from the flow of bile that takes place from mouth and bowels, cholera being, so to speak, ‘the fellifluous disease.’"
                            },
                            {
                                "example_id": "49517b50-3828-4161-9ff3-d239870fb919",
                                "sense_id": "51dda6b0-ae31-3ce6-9674-50d9d524fb96",
                                "text": "Behind a counter two young women, both evidently Asian, served a queue including a tipsy fellifluous Irishman."
                            },
                            {
                                "example_id": "b62c0b5d-9b49-498e-b7e1-7447b4909cb2",
                                "sense_id": "51dda6b0-ae31-3ce6-9674-50d9d524fb96",
                                "text": "What could ever be termed defeatist or pessimistic – what could ever be called fellifluous – about such ideas?"
                            }
                        ]
                    }
                ],
