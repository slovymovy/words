    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1c62d158-c45f-3857-8145-e6f29466e724",
                    "sense_definition": "Rendre obligatoire ou contraindre quelqu'un à accepter une règle, une décision ou une volonté.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur souhaite <w>imposer</w> de nouvelles directives à toute son équipe dès lundi prochain."
                        },
                        {
                            "text": "Face à cette situation imprévue, le gouvernement a décidé d'<w>imposer</w> le port du masque obligatoire."
                        }
                    ],
                    "synonyms": [
                        "prescrire",
                        "exiger",
                        "édicter"
                    ],
                    "antonyms": [
                        "permettre",
                        "autoriser",
                        "dispenser"
                    ],
                    "common_phrases": [
                        "imposer des conditions",
                        "imposer sa volonté",
                        "imposer des règles"
                    ]
                },
                {
                    "sense_id": "423962c0-92e2-3624-b03c-b8cee0f37099",
                    "sense_definition": "Être requis, devenir indispensable ou inévitable face à une situation donnée.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une telle erreur de gestion, une réorganisation complète du service s'<w>impose</w> sans attendre."
                        },
                        {
                            "text": "La plus grande prudence s'<w>impose</w> dès que les premières neiges commencent à recouvrir les routes."
                        }
                    ]
                },
                {
                    "sense_id": "3c951131-df6b-381a-8374-1fbff6abc38b",
                    "sense_definition": "Inspirer le respect, l'admiration ou la crainte par sa présence ou son attitude.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "autorité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Par son calme remarquable et son expérience, ce professeur sait <w>imposer</w> le respect à ses élèves."
                        },
                        {
                            "text": "Son charisme naturel et sa voix grave finissent toujours par <w>imposer</w> le silence dans la salle."
                        }
                    ],
                    "synonyms": [
                        "impressionner",
                        "intimider"
                    ],
                    "common_phrases": [
                        "imposer le respect",
                        "imposer le silence"
                    ]
                },
                {
                    "sense_id": "89e525d3-7805-36ae-9664-8549566eb34a",
                    "sense_definition": "Soumettre une personne, un bien ou une transaction au paiement d'une taxe ou d'un impôt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fiscalité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'État a choisi d'<w>imposer</w> plus lourdement les grandes fortunes pour financer les services publics."
                        },
                        {
                            "text": "La nouvelle loi vise à <w>imposer</w> les bénéfices réalisés par les multinationales du numérique."
                        }
                    ],
                    "synonyms": [
                        "taxer",
                        "fiscaliser",
                        "assujettir"
                    ],
                    "antonyms": [
                        "exonérer",
                        "défiscaliser"
                    ],
                    "common_phrases": [
                        "imposer les revenus",
                        "imposer les bénéfices"
                    ]
                },
                {
                    "sense_id": "a03813b9-f625-365a-8dda-57beebe79df6",
                    "sense_definition": "Faire reconnaître son autorité ou ses compétences, réussir à se faire une place ou remporter une victoire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "autorité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La jeune athlète a réussi à s'<w>imposer</w> lors de cette finale disputée contre les meilleures coureuses."
                        },
                        {
                            "text": "Cette entreprise innovante a su s'<w>imposer</w> face à des concurrents beaucoup plus anciens sur le marché."
                        }
                    ],
                    "synonyms": [
                        "triompher",
                        "percer",
                        "s'affirmer"
                    ],
                    "antonyms": [
                        "échouer"
                    ]
                },
                {
                    "sense_id": "d698a97b-970f-365d-bcf3-650dccc60cc6",
                    "sense_definition": "Poser les mains sur quelqu'un lors d'un rituel religieux de bénédiction ou de consécration.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'évêque s'est approché du fidèle pour lui <w>imposer</w> les mains lors de la cérémonie de confirmation."
                        },
                        {
                            "text": "Selon la tradition ancienne, le prêtre venait <w>imposer</w> les mains aux personnes souffrantes pour les bénir."
                        }
                    ],
                    "common_phrases": [
                        "imposer les mains"
                    ]
                },
                {
                    "sense_id": "c01278fa-4f27-3b07-ba0b-0dccf7121661",
                    "sense_definition": "Disposer et caler des pages composées pour former une feuille prête à être imprimée.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "imprimerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan typographe doit <w>imposer</w> la feuille avant de lancer l'impression définitive de l'ouvrage."
                        },
                        {
                            "text": "Il a fallu vérifier les marges avant d'<w>imposer</w> les seize pages du premier cahier du livre."
                        }
                    ],
                    "common_phrases": [
                        "imposer une feuille"
                    ]
                }
            ]
        }
    ]
