                    "sense_definition": "Spoilt, cosseted, or overly indulged.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spoiled",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>marred</w> child threw a tantrum when he did not get his way.",
