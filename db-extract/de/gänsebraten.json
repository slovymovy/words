                        ],
                        "form": "die Gänsebraten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9d97beab-65be-3ca9-ba77-33ac56d99927",
                        "entry_id": "d3d49f25-8750-33b0-8629-1ec41182ea02",
                        "glosses": [
                            "in einem Ofen gebackene Gans, die in Deutschland gerne als Weihnachtsbraten gegessen wird"
                        ],
                        "tags": [
                            "Lebensmittel"
                        ],
                        "examples": [
                            {
                                "example_id": "464b0a52-1312-4437-b1d4-05a6e983f6ac",
                                "sense_id": "9d97beab-65be-3ca9-ba77-33ac56d99927",
                                "text": "Der Gänsebraten kam herrlich duftend aus dem Ofen."
                            },
                            {
                                "example_id": "2ffb75bb-9952-442a-9504-026fc62d19e6",
                                "sense_id": "9d97beab-65be-3ca9-ba77-33ac56d99927",
                                "text": "Man sollte den Gänsebraten alle halbe Stunde übergießen, dann bleibt er schön saftig."
                            },
                            {
                                "example_id": "85ff692d-83ea-41b2-bea8-cbb5207d097a",
                                "sense_id": "9d97beab-65be-3ca9-ba77-33ac56d99927",
                                "text": "»Wir empfehlen heute den Gänsebraten.« (auf einer Tafel im Eingangsbereich eines Restaurants)"
                            },
                            {
                                "example_id": "5c640c1c-9964-4e6c-80f8-2d1143444ff3",
                                "sense_id": "9d97beab-65be-3ca9-ba77-33ac56d99927",
                                "text": "„Etwas aufwändiger zuzubereiten ist der Gänsebraten nach Mecklenburger Art.“"
                            },
                            {
                                "example_id": "008201a4-d30f-4ba2-9081-3f9ba32d16e8",
                                "sense_id": "9d97beab-65be-3ca9-ba77-33ac56d99927",
                                "text": "„Die Tradition des Gänsebratens zu Weihnachten reicht weit zurück.“"
                            },
                            {
                                "example_id": "0690b50d-7143-465e-a723-4703dcb1d0b7",
                                "sense_id": "9d97beab-65be-3ca9-ba77-33ac56d99927",
                                "text": "„Für viele gehört Johann Sebastian Bachs „Weihnachts-Oratorium“ so zum Christfest wie Tannenbaum, Stollen oder Gänsebraten.“"
                            },
                            {
                                "example_id": "86a37297-3573-4d48-9fdf-bb3635e39979",
                                "sense_id": "9d97beab-65be-3ca9-ba77-33ac56d99927",
                                "text": "„Der Gänsebraten ist fertig, wenn beim Einstechen der Keulen klarer Saft austritt und sich das Fleisch leicht vom Beinknochen ablöst. Die Zubereitungszeit beträgt circa drei bis vier Stunden.“"
                            },
                            {
                                "example_id": "73d79d38-5973-42b5-9c49-b2cecd6c9215",
                                "sense_id": "9d97beab-65be-3ca9-ba77-33ac56d99927",
                                "text": "Rainer Maria Rilke: „'In unseren Stuben riecht es am Donnerstag nach Tomaten, am Sonntag nach Gänsebraten, und jeden Montag ist Wäsche. So sind die Tage: der rote, der fette, der seifige.'“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
