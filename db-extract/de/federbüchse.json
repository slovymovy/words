                "senses": [
                    {
                        "sense_id": "a9d50a90-c414-3ff5-b5c6-cb9622fd04e6",
                        "entry_id": "79e06902-0d43-3581-941f-5cc0d0729581",
                        "glosses": [
                            "Behältnis für das Aufbewahren von Schreibfedern"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "3266e0a4-329c-438d-9cc9-fd15f05fc337",
                                "sense_id": "a9d50a90-c414-3ff5-b5c6-cb9622fd04e6",
                                "text": "„Der Ranzen mit Seehundsfell, die hellgraue Federbüchse und vor allem die Butterbrotdose, gelb lackiert, mit der Aufschrift ›Guten Appetit‹ verlockten zu herrlichen Aussichten.“"
                            },
                            {
                                "example_id": "cb2236c2-ca08-4fd6-baa9-d2d29f4e8e3b",
                                "sense_id": "a9d50a90-c414-3ff5-b5c6-cb9622fd04e6",
                                "text": "„Mutti hatte ihre Lotte überrascht und eine Lotterie veranstaltet. Was konnte man da für entzückende Sachen gewinnen! Federbüchsen und Notizbüchlein, Beutel mit bunten Perlen, Abziehbilder, Geduldspiele, ein winzig kleines Domino, Würfel und noch viele andere schöne Dinge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
