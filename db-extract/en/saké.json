                    },
                    {
                        "translation_id": "b755dd9c-2466-42d4-9a58-450370afca24",
                        "source_entry_id": "bc3ccbb9-9d4c-35c3-80e9-12b58441cf00",
                        "source_sense_id": "92f29b74-8431-3e33-b973-d0c91a42c0e1",
                        "source_sense_description": "Japanese rice wine",
                        "target_lang_word": "saké",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saké",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eccb4f63-5288-364b-ba03-454dcd372d1b",
                                        "entry_id": "ac4b0a4b-308f-3af4-bfcf-18cfbb1c75a0",
                                        "glosses": [
                                            "Vin de riz japonais, produit par fermentation comme la bière, titrant de 14° à 17°."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6636aec4-0865-43fc-aae2-55cb2a3c376d",
                                                "sense_id": "eccb4f63-5288-364b-ba03-454dcd372d1b",
                                                "text": "— Bon anniversaire alors! dis-je en levant mon verre de saké."
                                            },
                                            {
                                                "example_id": "683ac18c-fbad-427f-a6df-497700d0ff50",
                                                "sense_id": "eccb4f63-5288-364b-ba03-454dcd372d1b",
                                                "text": "Devenu une icône internationale , David Bowie a appris à s’exporter. En 1980, il compose un morceau instrumental, Crystal Japan , pour faire la retape d’une marque de saké nippone, qu’il semble, à l’image, sérieusement apprécier."
                                            },
                                            {
                                                "example_id": "44519551-4cfc-4fc6-bbd1-c7930012c98a",
                                                "sense_id": "eccb4f63-5288-364b-ba03-454dcd372d1b",
                                                "text": "En novembre 2022, ce sommelier, qui a travaillé avec Mory Sacko et Thierry Marx, a ouvert, avec le chef Julian Avila, une cave à manger où les plats à la carte riment avec tous les vins, mais aussi avec le saké."
                                            },
                                            {
                                                "example_id": "78e51268-9fad-4e4e-b4eb-826316065573",
                                                "sense_id": "eccb4f63-5288-364b-ba03-454dcd372d1b",
                                                "text": "Leurs bouches avides engloutissaient des quantités démesurées de bière, de shochu, de whisky ou de saké."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2dbc187-5f36-4ef4-8d0e-67a06d0b705e",
                        "source_entry_id": "bc3ccbb9-9d4c-35c3-80e9-12b58441cf00",
                        "source_sense_id": "92f29b74-8431-3e33-b973-d0c91a42c0e1",
                        "source_sense_description": "Japanese rice wine",
                        "target_lang_word": "Sake",
