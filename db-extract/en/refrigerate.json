                                        "glosses": [
                                            "Refroidir un corps ou un liquide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9ffd876-3f77-4caa-8de1-ebc61d3376fd",
                                                "sense_id": "c3b15d3a-6e2f-3f2f-89d8-1a7bbb6db42b",
                                                "text": "réfrigérer de l'eau"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cd9100a-a1d9-319c-903f-6b1f7a9ec076",
                                        "entry_id": "cd8cc719-ad13-30ad-9204-447beb87668c",
                                        "glosses": [
                                            "Diminuer l’ardeur, l’activité, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "960e2de2-2613-431c-988f-ac8cede36861",
                                                "sense_id": "9cd9100a-a1d9-319c-903f-6b1f7a9ec076",
                                                "text": "Ce peu jeté négligemment, tombant de ses lèvres au milieu des discussions véhémentes, des propos brûlants, sous une forme sentencieuse et solennelle, avait pour effet, de terminer tout débat, de réfrigérer toute ardeur combative et de couvrir Rémondin de gloire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce4f0001-b7e5-425f-9504-e2a5af5c56b3",
                        "source_entry_id": "9d1c35c8-d9ef-30f5-9e0f-18617023da93",
