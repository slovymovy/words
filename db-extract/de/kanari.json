                "senses": [
                    {
                        "sense_id": "57f63ba8-718e-3e95-94b0-036dd2297c96",
                        "entry_id": "1b20adc1-a4ae-382c-bbb1-996cb30c7ee1",
                        "glosses": [
                            "Kurzform von Kanarienvogel"
                        ],
                        "tags": [
                            "Austrian German",
                            "South-German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "67320aec-cbdb-48a0-8b7f-397faec67842",
                                "sense_id": "57f63ba8-718e-3e95-94b0-036dd2297c96",
                                "text": "„Karl Valentin, der Münchner Humorist und Poet ohne Reime, hat einmal, wie er dem Publikum erzählte, ‚probeweise den Kanarienvogel ins Aquarium und den Goldfisch ins Vogelhäusel getan. Da ist der Kanari bald dersoffen und der Goldfisch immer vom Stangl abigrutscht‘.“"
                            },
                            {
                                "example_id": "2a9b67e0-9fd9-4a57-8a84-3b8813995c08",
                                "sense_id": "57f63ba8-718e-3e95-94b0-036dd2297c96",
                                "text": "„Die bar centrale ist die gemeinsame Philosophie der Einheimischen und der Edeltouristen, die sich hier vermischen. Hier zentralisiert sich allabendlich das soziale Leben des Ortes inklusive integrationslüsterner Fremder. Ein paar Schirme, ein paar Bäume, ein Käfig mit drei zitronengelben Kanaris, leider auch ein Fernseher, aber nur, wenn EM ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9379a68-8119-46e1-857d-4fdc86a548ec",
                        "source_entry_id": "1b20adc1-a4ae-382c-bbb1-996cb30c7ee1",
                        "source_sense_id": "57f63ba8-718e-3e95-94b0-036dd2297c96",
                        "source_sense_description": "umgangssprachlich, süddeutsch, österreichisch: Kurzform von Kanarienvogel",
                        "target_lang_word": "canari",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "canari",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cfa6c03d-31a2-32cc-a6f9-e5bba3c3be03",
                                        "entry_id": "d487685e-0427-3063-94e7-0df22e5349bd",
                                        "glosses": [
                                            "Espèce de petit oiseau passereau d'Eurasie, serin voisin des pinsons, originaire des îles Canaries possédant un plumage marbré de vert et de brun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49e2a53a-172e-4a4d-9649-c1174ed937cc",
                                                "sense_id": "cfa6c03d-31a2-32cc-a6f9-e5bba3c3be03",
                                                "text": "Lorsque le canari sauvage fut ramené des îles Canaries à la cour d'Espagne au xve siècle, nul n’imaginait que ce petit passereau au plumage insignifiant allait devenir le plus populaire des oiseaux de cage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db1f7755-f7b7-3a92-9724-adcc037129ea",
                                        "entry_id": "d487685e-0427-3063-94e7-0df22e5349bd",
                                        "glosses": [
                                            "Oiseau chanteur de petite taille élevé en cage, forme domestiquée du précédent. Sa couleur jaune caractéristique est aujourd’hui modifiée par des éleveurs spécialisés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99d056d0-29c1-4367-b2d5-1f8693305224",
                                                "sense_id": "db1f7755-f7b7-3a92-9724-adcc037129ea",
                                                "text": "Il s’est attaché à créer un canari qui soit à la fois, un oiseau de couleur et de chant."
                                            },
                                            {
                                                "example_id": "7f8046ce-c915-4a42-92cf-2846c52f57de",
                                                "sense_id": "db1f7755-f7b7-3a92-9724-adcc037129ea",
                                                "text": "3000 canaris de couleurs s’exposent jusque dimanche au hall omnisport de Waremme. Depuis sa domestication, et suite à de multiples croisements, le canari se décline aujourd’hui en plus de 250 couleurs différentes."
                                            },
                                            {
                                                "example_id": "a81f7010-caf7-4655-9e50-c78277108c36",
                                                "sense_id": "db1f7755-f7b7-3a92-9724-adcc037129ea",
                                                "text": "Ce type d'épidémie est comme «un canari dans la mine de charbon de la crise climatique», a-t-il dit en évoquant la métaphore du petit oiseau qui alerte d'un grand danger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "765b79ad-29e2-3b90-8071-47be1cde7a23",
                                        "entry_id": "d487685e-0427-3063-94e7-0df22e5349bd",
                                        "glosses": [
                                            "Champignon à lames assez serrées et inégales, au chapeau à marge ondulée jaune brunâtre, et au pied sans anneau, trapu, jaune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "011a69d8-a019-407b-8a75-b747d170c47a",
                                                "sense_id": "765b79ad-29e2-3b90-8071-47be1cde7a23",
                                                "text": "Il s’appelle le tricholoma equestre, mais en gascon, on l’appelle le bidaou (on le trouve aussi sous la dénomination de chevalier, canari ou jaunet)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65c67800-3b3c-3a7c-8622-06eb30db3c83",
                                        "entry_id": "d487685e-0427-3063-94e7-0df22e5349bd",
                                        "glosses": [
                                            "Policier portant un dossard jaune."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb74e182-19dd-4490-82db-c7d29eac1087",
                                                "sense_id": "65c67800-3b3c-3a7c-8622-06eb30db3c83",
                                                "text": "Mais la photographe fut arrêtée par une première ligne de policiers vêtus de dossards jaunes – les « canaris », en jargon de manifestants – qui interdisaient l’accès à la scène."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41e3ab48-32a4-362c-92d2-575be6b9d584",
                                        "entry_id": "d487685e-0427-3063-94e7-0df22e5349bd",
                                        "glosses": [
                                            "Cocktail composé de pastis et de sirop de citron."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "canari",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e78299d-24de-3741-9b78-a636512f209b",
                                        "entry_id": "d225baed-21a9-30b0-bb5d-600b5924db8d",
                                        "glosses": [
                                            "Récipient en terre cuite destiné à contenir de l’eau ou des aliments."
                                        ],
                                        "tags": [
                                            "Afrique",
                                            "Antilles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6025e65-2541-4acb-9691-80ac49fe828b",
                                                "sense_id": "5e78299d-24de-3741-9b78-a636512f209b",
                                                "text": "J'avais prévu pour de Gaulle une bombe de petits pois, un canari de bananes jaunes, et une salade de christophines à l'eau, parsemée d'un persil levé à Texaco."
                                            },
                                            {
                                                "example_id": "b6cd6074-a251-467e-b9bd-9b297233aec8",
                                                "sense_id": "5e78299d-24de-3741-9b78-a636512f209b",
                                                "text": "J’ai mis dans le canari d’abord de l’eau de torrent, puis les trois sortes d’huiles, puis la veilleuse."
                                            },
                                            {
                                                "example_id": "0b5efbf6-b463-41b2-a7ad-37058db415a5",
                                                "sense_id": "5e78299d-24de-3741-9b78-a636512f209b",
                                                "text": "Sourire aux lèvres, la dame oriente son regard vers un grand canari rempli d’eau, de sel et de poissons, utilisé pour saler les produits halieutiques."
                                            },
                                            {
                                                "example_id": "4e8bb297-0789-440a-9497-4fe686a54f34",
                                                "sense_id": "5e78299d-24de-3741-9b78-a636512f209b",
                                                "text": "« Environ, la moitié de la population est exposé au risque», a expliqué Dr Elhadji Mamadou Ndiaye. « Elle est transmise à l’homme par la piqure d’un moustique appelé Aedes aegypti. Cet insecte ne se développe que dans l’eau propre et claire des canaris, des pots de fleurs, des réservoirs mal couverts etc.», a t-il ajouté."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "canari",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac9a24eb-914e-3a36-80e4-3e39a096b4a8",
                                        "entry_id": "cc2c478a-1b06-3f3d-a565-045e5a7c2fe4",
                                        "glosses": [
                                            "D'une couleur jaune vif très légèrement verdâtre. #E7F00D"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80babde0-7bff-465f-94ff-8bca98e81912",
                                                "sense_id": "ac9a24eb-914e-3a36-80e4-3e39a096b4a8",
                                                "text": "La vitre constellée de chiures de mouches renvoyait à Tsi-Tsi le reflet chatoyant de son corsage jaune canari […]."
                                            },
                                            {
                                                "example_id": "7782833e-fea7-4d72-bbfd-889550f80d12",
                                                "sense_id": "ac9a24eb-914e-3a36-80e4-3e39a096b4a8",
                                                "text": "Ils ont troqué leurs chemisettes avec palmiers ou flamands roses, pour un complet avec cravate, couleur jaune canari."
                                            },
                                            {
                                                "example_id": "d0f3c7c7-a97f-4967-ae59-8a64ed445b17",
                                                "sense_id": "ac9a24eb-914e-3a36-80e4-3e39a096b4a8",
                                                "text": "Perché sur un éperon rocheux, le bourg où se tient le festival consiste en un dédale de ruelles aux façades canari, céladon, pain d’épices, et frontons lourdement chantournés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
