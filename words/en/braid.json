{
    "word_family": [
        "braided",
        "braiding",
        "unbraid",
        "upbraid"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6e66fec1-6855-315b-9298-3fb8ee4aa4a5",
                    "sense_definition": "A length of hair or other material woven together from three or more intertwined strands.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "intertwined_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tied a colorful ribbon around the end of her long <w>braid</w>.",
                            "target_lang_translations": {
                                "es": "Ató una cinta de colores al final de su larga <w>trenza</w>."
                            }
                        },
                        {
                            "text": "The uniform was decorated with gold <w>braid</w> along the collar and cuffs.",
                            "target_lang_translations": {
                                "es": "El uniforme estaba decorado con un <w>galón</w> dorado a lo largo del cuello y los puños."
                            }
                        }
                    ],
                    "synonyms": [
                        "plait"
                    ],
                    "common_phrases": [
                        "gold braid"
                    ],
                    "target_lang_definitions": {
                        "es": "Porción de cabello u otro material entrelazado a partir de tres o más hebras cruzadas entre sí."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "trenza",
                                "target_lang_sense_clarification": "peinado o cordón entrelazado"
                            },
                            {
                                "target_lang_word": "galón",
                                "target_lang_sense_clarification": "cinta o adorno trenzado para uniformes"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72773b76-9086-3777-8060-0289ff8fb56b",
                    "sense_definition": "A flexible wire or cable composed of several smaller strands interwoven together.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intertwined_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The electrician replaced the damaged ground <w>braid</w> inside the control panel.",
                            "target_lang_translations": {
                                "es": "El electricista reemplazó la <w>malla</w> de conexión a tierra dañada dentro del panel de control."
                            }
                        },
                        {
                            "text": "A protective copper <w>braid</w> covered the delicate wiring to prevent damage.",
                            "target_lang_translations": {
                                "es": "Una <w>malla</w> protectora de cobre cubría el delicado cableado para evitar daños."
                            }
                        }
                    ],
                    "common_phrases": [
                        "copper braid"
                    ],
                    "target_lang_definitions": {
                        "es": "Cable o alambre flexible formado por varios hilos o filamentos entrelazados."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "malla",
                                "target_lang_sense_clarification": "alambre o hilo metálico trenzado"
                            },
                            {
                                "target_lang_word": "trenzada",
                                "target_lang_sense_clarification": "tira o cable trenzado"
                            },
                            {
                                "target_lang_word": "trenza",
                                "target_lang_sense_clarification": "cordón trenzado metálico"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27f2e4ea-8b08-31c6-ab82-bd5edc25a21d",
                    "sense_definition": "A tubular sleeve of woven metal strands surrounding a cable to provide shielding against electrical interference.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intertwined_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coaxial cable relies on an outer <w>braid</w> to block electromagnetic noise.",
                            "target_lang_translations": {
                                "es": "El cable coaxial depende de una <w>malla</w> exterior para bloquear el ruido electromagnético."
                            }
                        },
                        {
                            "text": "You must carefully strip the outer jacket without cutting the metallic <w>braid</w> underneath.",
                            "target_lang_translations": {
                                "es": "Debes pelar con cuidado la cubierta exterior sin cortar la <w>malla metálica</w> de abajo."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Funda tubular de hilos metálicos entretejidos alrededor de un cable para protegerlo de interferencias electromagnéticas."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "malla de blindaje",
                                "target_lang_sense_clarification": "funda protectora de cable"
                            },
                            {
                                "target_lang_word": "blindaje trenzado",
                                "target_lang_sense_clarification": "cubierta metálica contra interferencias"
                            },
                            {
                                "target_lang_word": "malla",
                                "target_lang_sense_clarification": "cobertura tubular trenzada"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae45f556-fe34-3acf-a87a-f6024fdc85b7",
                    "sense_definition": "A mathematical structure formed by intertwining strands connecting two parallel rows of points.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intertwined_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor lectured on how each <w>braid</w> corresponds to an element in an algebraic group.",
                            "target_lang_translations": {
                                "es": "El profesor dio una conferencia sobre cómo cada <w>trenza</w> se corresponde con un elemento de un grupo algebraico."
                            }
                        },
                        {
                            "text": "They studied topological properties by analyzing the crossings within the <w>braid</w>.",
                            "target_lang_translations": {
                                "es": "Estudiaron las propiedades topológicas analizando los cruces dentro de la <w>trenza</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Estructura matemática formada por hebras entrelazadas que unen dos filas paralelas de puntos."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "trenza",
                                "target_lang_sense_clarification": "en teoría geométrica o topología"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bd5a8ff-de52-3d20-a9d3-c60fa6d912bc",
                    "sense_definition": "A quick, sudden movement, jerk, or start.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sudden_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoner woke with a sudden <w>braid</w> when the loud bell sounded through the cell.",
                            "target_lang_translations": {
                                "es": "El prisionero se despertó de un repentino <w>sobresalto</w> cuando la ruidosa campana resonó en la celda."
                            }
                        },
                        {
                            "text": "He broke his bonds with a mighty <w>braid</w> and leapt toward the open window.",
                            "target_lang_translations": {
                                "es": "Rompió sus ataduras con una poderosa <w>sacudida</w> y saltó hacia la ventana abierta."
                            }
                        }
                    ],
                    "synonyms": [
                        "jerk",
                        "wrench"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical and Middle English contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Movimiento rápido y repentino, sacudida o sobresalto."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "sacudida",
                                "target_lang_sense_clarification": "movimiento violento y repentino"
                            },
                            {
                                "target_lang_word": "sobresalto",
                                "target_lang_sense_clarification": "movimiento de susto o sorpresa"
                            },
                            {
                                "target_lang_word": "tirón",
                                "target_lang_sense_clarification": "movimiento súbito"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a627e860-3a66-3ba0-98e8-c5f772b747b4",
                    "sense_definition": "A sudden burst of emotion or capricious fit of anger.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sudden_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was prone to an occasional <w>braid</w> whenever her plans were thwarted.",
                            "target_lang_translations": {
                                "es": "Era propensa a tener un <w>arrebato</w> ocasional cada vez que sus planes se veían frustrados."
                            }
                        },
                        {
                            "text": "In a wild <w>braid</w> of temper, the young nobleman threw his chalice across the room.",
                            "target_lang_translations": {
                                "es": "En un furioso <w>ataque</w> de ira, el joven noble arrojó su cáliz al otro lado de la habitación."
                            }
                        }
                    ],
                    "synonyms": [
                        "fit",
                        "outburst"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely found outside early modern literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Estallido repentino de emoción o arrebato caprichoso de ira."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "arrebato",
                                "target_lang_sense_clarification": "ataque o furia repentina"
                            },
                            {
                                "target_lang_word": "ataque",
                                "target_lang_sense_clarification": "estallido de ira o temperamento"
                            },
                            {
                                "target_lang_word": "rabieta",
                                "target_lang_sense_clarification": "berrinche o disgusto pasajero"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17b0a842-bd0e-3cb4-816e-2c2a96477e8f",
                    "sense_definition": "A protective wicker screen or guard placed around newly grafted fruit trees.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener placed a wicker <w>braid</w> around the delicate young apple graft.",
                            "target_lang_translations": {
                                "es": "El jardinero colocó un <w>resguardo de mimbre</w> alrededor del delicado y joven injerto de manzano."
                            }
                        },
                        {
                            "text": "Without a protective <w>braid</w>, the wind might snap the fresh graft away from the rootstock.",
                            "target_lang_translations": {
                                "es": "Sin una <w>protección</w> que lo resguarde, el viento podría desprender el injerto recién hecho del portainjerto."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Historical horticultural term."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Protector o resguardo de mimbre colocado alrededor de árboles frutales recién injertados."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "resguardo de mimbre",
                                "target_lang_sense_clarification": "protector de injertos"
                            },
                            {
                                "target_lang_word": "funda de mimbre",
                                "target_lang_sense_clarification": "cubierta para árboles jóvenes"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fca503c-b383-3038-8033-39d9bc8b179e",
                    "sense_definition": "A brief space of time; a moment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They stood silent for a short <w>braid</w> before resuming their perilous march across the hill.",
                            "target_lang_translations": {
                                "es": "Permanecieron en silencio por un breve <w>instante</w> antes de reanudar su peligrosa marcha colina a través."
                            }
                        },
                        {
                            "text": "Wait here but a single <w>braid</w> while I fetch the horses from the stable.",
                            "target_lang_translations": {
                                "es": "Espera aquí tan solo un <w>momento</w> mientras voy a buscar los caballos al establo."
                            }
                        }
                    ],
                    "synonyms": [
                        "moment"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Breve lapso de tiempo; instante o momento."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "instante",
                                "target_lang_sense_clarification": "breve periodo de tiempo"
                            },
                            {
                                "target_lang_word": "momento",
                                "target_lang_sense_clarification": "espacio muy corto de tiempo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a45cb84-ab45-3189-b0b8-e160107fc48e",
                    "sense_definition": "A shift or spell of work.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The laborers finished their daily <w>braid</w> in the field just as darkness fell.",
                            "target_lang_translations": {
                                "es": "Los labradores terminaron su <w>jornada</w> diaria en el campo justo al caer la noche."
                            }
                        },
                        {
                            "text": "He completed a heavy <w>braid</w> at the mill before returning home to rest.",
                            "target_lang_translations": {
                                "es": "Completó un pesado <w>turno</w> en el molino antes de volver a casa a descansar."
                            }
                        }
                    ],
                    "synonyms": [
                        "spell",
                        "turn"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Regional British dialect."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Turno, jornada o periodo continuo de trabajo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "turno",
                                "target_lang_sense_clarification": "jornada de trabajo"
                            },
                            {
                                "target_lang_word": "jornada",
                                "target_lang_sense_clarification": "sesión de labor"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb02b3ea-94d4-3efb-83f6-b1a7ed12f61f",
                    "sense_definition": "A deceptive trick or snare.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traveler fell victim to a cunning <w>braid</w> set by local thieves.",
                            "target_lang_translations": {
                                "es": "El viajero cayó víctima de una astuta <w>trampa</w> tendida por los ladrones locales."
                            }
                        },
                        {
                            "text": "He warned his companion against the deceitful <w>braid</w> of the corrupt merchant.",
                            "target_lang_translations": {
                                "es": "Advirtió a su compañero de las engañosas <w>artimañas</w> del comerciante corrupto."
                            }
                        }
                    ],
                    "synonyms": [
                        "deception",
                        "trick"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "No longer in contemporary use."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Engaño, trampa o artimaña maliciosa."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "artimaña",
                                "target_lang_sense_clarification": "truco engañoso"
                            },
                            {
                                "target_lang_word": "trampa",
                                "target_lang_sense_clarification": "ardid o estratagema"
                            },
                            {
                                "target_lang_word": "engaño",
                                "target_lang_sense_clarification": "embuste o celada"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03ce2a3b-8f15-3a27-b499-ce138fb1b17a",
                    "sense_definition": "A shelf, rack, or flat board used to store objects.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "board_implement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She set the newly polished copper vessels upon the kitchen <w>braid</w>.",
                            "target_lang_translations": {
                                "es": "Colocó las vasijas de cobre recién pulidas sobre el <w>estante</w> de la cocina."
                            }
                        },
                        {
                            "text": "The carpenter built a sturdy wooden <w>braid</w> along the pantry wall.",
                            "target_lang_translations": {
                                "es": "El carpintero construyó una robusta <w>repisa</w> de madera a lo largo de la pared de la despensa."
                            }
                        }
                    ],
                    "synonyms": [
                        "shelf"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Dialectal variant meaning shelf."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Estante, repisa o balda usada para colocar y almacenar objetos."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "estante",
                                "target_lang_sense_clarification": "mueble o balda para apoyar objetos"
                            },
                            {
                                "target_lang_word": "repisa",
                                "target_lang_sense_clarification": "tabla sujeta a la pared"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcaef1ea-4644-37c2-9bc5-3cc0805f4c8f",
                    "sense_definition": "A flat wooden board used in cheesemaking to press curd.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "board_implement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cheesemaker positioned a heavy <w>braid</w> over the cloth to drain the whey.",
                            "target_lang_translations": {
                                "es": "El quesero colocó una pesada <w>tabla de prensar</w> sobre el lienzo para escurrir el suero."
                            }
                        },
                        {
                            "text": "Weights were set upon the cheese <w>braid</w> to compress the fresh curds firmly.",
                            "target_lang_translations": {
                                "es": "Se pusieron pesas sobre la <w>prensa</w> para queso con el fin de compactar con firmeza la cuajada fresca."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Traditional dialectal cheesemaking term."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Tabla plana de madera empleada en la elaboración de quesos para prensar la cuajada."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "tabla de prensar",
                                "target_lang_sense_clarification": "en quesería, para escurrir el suero"
                            },
                            {
                                "target_lang_word": "prensa",
                                "target_lang_sense_clarification": "tabla de compresión para cuajada"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe350887-2486-3337-8327-13047648fbf5",
                    "sense_definition": "A flat board attached to a beam for weighing items.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "board_implement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miller placed the grain sacks directly onto the scale's wooden <w>braid</w>.",
                            "target_lang_translations": {
                                "es": "El molinero colocó los sacos de grano directamente sobre el <w>platillo</w> de madera de la balanza."
                            }
                        },
                        {
                            "text": "He adjusted the balance by shifting the counterweights against the suspended <w>braid</w>.",
                            "target_lang_translations": {
                                "es": "Ajustó el equilibrio desplazando los contrapesos frente a la <w>plataforma</w> suspendida."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Historical weighing apparatus term."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Plataforma o tabla plana suspendida de un brazo para pesar objetos en una balanza."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "platillo",
                                "target_lang_sense_clarification": "base o tabla de balanza"
                            },
                            {
                                "target_lang_word": "plato de balanza",
                                "target_lang_sense_clarification": "superficie para colocar pesos"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d8be7101-f435-327b-aff4-f9fbdcdeddec",
                    "sense_definition": "To intertwine three or more strands of hair, fiber, or other flexible material together.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "intertwine_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every morning before school, she helped her daughter <w>braid</w> her hair neatly.",
                            "target_lang_translations": {
                                "es": "Cada mañana antes de ir a la escuela, ayudaba a su hija a <w>trenzar</w> prolijamente su cabello."
                            }
                        },
                        {
                            "text": "The artisan began to <w>braid</w> leather strips into a sturdy belt.",
                            "target_lang_translations": {
                                "es": "El artesano empezó a <w>trenzar</w> tiras de cuero para hacer un cinturón resistente."
                            }
                        }
                    ],
                    "synonyms": [
                        "entwine",
                        "plait"
                    ],
                    "antonyms": [
                        "unbraid"
                    ],
                    "common_phrases": [
                        "braid hair"
                    ],
                    "target_lang_definitions": {
                        "es": "Entretejer tres o más mechones de pelo, fibras u otros materiales flexibles formando una trenza."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "trenzar",
                                "target_lang_sense_clarification": "entrelazar hebras o pelo"
                            },
                            {
                                "target_lang_word": "hacer una trenza",
                                "target_lang_sense_clarification": "peinar en forma de trenza"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9ab8608-41f7-3b7f-a1b5-aa41efeb10e9",
                    "sense_definition": "To pull, jerk, or wrench suddenly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "jerk_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He attempted to <w>braid</w> the weapon from the guard's tight grip.",
                            "target_lang_translations": {
                                "es": "Intentó <w>arrancar</w> el arma del firme agarre del guardia."
                            }
                        },
                        {
                            "text": "With a fierce twist, the knight did <w>braid</w> his sword out of the scabbard.",
