                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "224d51e2-4dab-4990-8e00-6429d0e6e50e",
                                                "sense_id": "7ead3061-88d0-3faa-b8f2-c9c0b0f9e4c7",
                                                "text": "He bought a January '08 put for Procter and Gamble at 80 to hedge his bet."
                                            },
                                            {
                                                "example_id": "ea5604cf-1faf-4a61-9735-d89c89debba8",
                                                "sense_id": "7ead3061-88d0-3faa-b8f2-c9c0b0f9e4c7",
                                                "text": "c. 1900, Universal Cyclopaedia Entry for Stock-Exchange\nA put and a call may be combined in one instrument, the holder of which may either buy or sell as he chooses at the fixed price."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff27d9e1-6b72-3242-bf65-ca3066163132",
                                        "entry_id": "b515358d-ff08-3d11-b0de-5a6cdb0ebf7a",
                                        "glosses": [
                                            "The act of putting; an action; a movement; a thrust; a push."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d23bae79-97ee-4aee-878a-8cfd741325f9",
                                                "sense_id": "ff27d9e1-6b72-3242-bf65-ca3066163132",
                                                "text": "the put of a ball"
                                            },
                                            {
                                                "example_id": "03f4f1f2-1ede-4165-abc2-a3db18dbde02",
                                                "sense_id": "ff27d9e1-6b72-3242-bf65-ca3066163132",
                                                "text": "The Stag's was a Forc'd put, and a Chance rather than a Choice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4f9df30-543d-379a-aa72-65b2557adb16",
                                        "entry_id": "b515358d-ff08-3d11-b0de-5a6cdb0ebf7a",
                                        "glosses": [
                                            "An old card game."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9adbf83b-d54d-40b9-b370-c4509e12e668",
                                                "sense_id": "c4f9df30-543d-379a-aa72-65b2557adb16",
                                                "text": "Among the in-door amusements of the costermonger is card-playing, at which many of them are adepts. The usual games are all-fours, all-fives, cribbage, and put."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "put",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5fd6098-9ece-359a-a830-96d526472a0f",
                                        "entry_id": "562f65b5-eab3-37d9-96d5-e259913bab33",
                                        "glosses": [
                                            "A fellow, especially an eccentric or elderly one; a duffer."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2be0947-2889-4542-8214-d214369b6ea0",
                                                "sense_id": "d5fd6098-9ece-359a-a830-96d526472a0f",
                                                "text": "Queer Country-puts extol Queen Bess's reign,\nAnd of lost hospitality complain."
                                            },
                                            {
                                                "example_id": "187217f7-4cd9-4402-a5a7-d7e167b709dd",
                                                "sense_id": "d5fd6098-9ece-359a-a830-96d526472a0f",
                                                "text": "The old put wanted to make a parson of me, but d—n me, thinks I to myself, I'll nick you there, old cull; the devil a smack of your nonsense shall you ever get into me."
                                            },
                                            {
                                                "example_id": "09b698d5-0047-461c-84a1-059ffb9b63c2",
                                                "sense_id": "d5fd6098-9ece-359a-a830-96d526472a0f",
                                                "text": "The Captain has a hearty contempt for his father, I can see, and calls him an old put, an old snob, an old chaw-bacon, and numberless other pretty names."
                                            },
                                            {
                                                "example_id": "d549234a-aa81-4227-ad86-0b2f44fec945",
                                                "sense_id": "d5fd6098-9ece-359a-a830-96d526472a0f",
                                                "text": "Any number of varlet to be had for a few ducats and what droll puts the citizens seem in it all!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "put",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b90e5556-fe21-372a-b4ad-e7730d0d2479",
                                        "entry_id": "b4f06135-420c-34e4-8693-3d02d1a1fbaf",
                                        "glosses": [
                                            "A prostitute."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "092c9d44-4533-491b-b77b-dfec5e6b977e",
                                                "sense_id": "b90e5556-fe21-372a-b4ad-e7730d0d2479",
                                                "text": "And Mrs. Penny-a-hoist Pim, said Mr. Gorman. That old put, said Mr. Nolan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0884782-b80c-4d49-9086-16e49166501e",
