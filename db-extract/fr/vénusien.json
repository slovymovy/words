        "fr-extract.jsonl": [
            {
                "entry_id": "83decfaf-945a-33c9-8133-2048ce0efeb4",
                "word": "vénusien",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "97728e06-2462-4131-957f-2cec5df561f2",
                        "entry_id": "83decfaf-945a-33c9-8133-2048ce0efeb4",
                        "tags": [
                            "plural",
                            "masculine"
                        ],
                        "form": "vénusiens"
                    },
                    {
                        "form_id": "6717f442-1264-4553-8dfc-d43fd7391070",
                        "entry_id": "83decfaf-945a-33c9-8133-2048ce0efeb4",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "vénusienne"
                    },
                    {
                        "form_id": "a414e889-d527-4328-a889-e339672c86a0",
                        "entry_id": "83decfaf-945a-33c9-8133-2048ce0efeb4",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "vénusiennes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c478498b-3cac-3a18-8d5f-74aa4280e082",
                        "entry_id": "83decfaf-945a-33c9-8133-2048ce0efeb4",
                        "glosses": [
                            "Qui se rapporte à la planète Vénus."
                        ],
                        "tags": [],
                        "note": "Cet adjectif a remplacé vénérien qui a une connotation moderne péjorative, d’origine médicale",
                        "examples": [
                            {
                                "example_id": "e183855b-490f-4765-9dcc-aa28f3b0ad26",
                                "sense_id": "c478498b-3cac-3a18-8d5f-74aa4280e082",
                                "text": "L’atmosphère vénusienne est principalement composée de dioxyde de carbone."
                            },
                            {
                                "example_id": "8807c70b-306d-4609-8b68-31e43f27433f",
                                "sense_id": "c478498b-3cac-3a18-8d5f-74aa4280e082",
                                "text": "À peine avais-je abordé le territoire vénusien, que je vis accourir, des champs voisins, une douzaine de paysans qui avaient été spectateurs de ma descente aérienne."
                            },
                            {
                                "example_id": "d59f8c5e-4aaa-409c-93d2-938ed1ae0928",
                                "sense_id": "c478498b-3cac-3a18-8d5f-74aa4280e082",
                                "text": "Les observations de ces missions vénusiennes \"seront indispensables pour confirmer – ou infirmer – nos travaux\", conclut David Ehrenreich, coauteur de l’étude et professeur à l’UNIGE."
                            }
                        ]
                    },
                    {
                        "sense_id": "36211125-e624-3047-a1fd-69b62a6df22b",
                        "entry_id": "83decfaf-945a-33c9-8133-2048ce0efeb4",
                        "glosses": [
                            "Sensible aux attraits de Vénus, déesse de l’amour. (au féminin essentiellement)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d340aaa-3c92-454e-86a6-0fb79b11870a",
                                "sense_id": "36211125-e624-3047-a1fd-69b62a6df22b",
                                "text": "Il a murmuré quelques mots en russe, qui résonnèrent très doucement à mes oreilles, m’a serrée très fort contre lui et m’a donné un de ces baisers qui comptent dans la vie d’une vénusienne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c32c179c-8ae4-4133-aae2-757d16290ef9",
                        "source_entry_id": "83decfaf-945a-33c9-8133-2048ce0efeb4",
                        "target_lang_word": "venusisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "venusisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "32fe1bc3-87ea-3baf-b53d-4e1e1c1d5e8a",
                                        "entry_id": "d281db4a-0060-3802-8614-8d26811cdcbd",
                                        "glosses": [
                                            "die Venus betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "368a4510-b67e-4b44-8ef2-7ef7d3e3e025",
                                                "sense_id": "32fe1bc3-87ea-3baf-b53d-4e1e1c1d5e8a",
                                                "text": "„Navarro ist es nun gelungen, die Zirkulation der venusischen Atmosphäre im Computermodell nachzubilden.“"
                                            },
                                            {
                                                "example_id": "386e952c-68c1-4724-9f5f-8ff6fe76c7ba",
                                                "sense_id": "32fe1bc3-87ea-3baf-b53d-4e1e1c1d5e8a",
                                                "text": "„Durch die geöffnete Zeltklappe konnte man den Strom venusischer Arbeiter sehen, die nach Beendigung ihrer Arbeitszeit aus dem Schachtkopf strömten und sich zwischen den geordneten Reihen der anderen einreihten, deren Arbeit gleich beginnen würde.“"
                                            },
                                            {
                                                "example_id": "5518281d-bdfe-4d59-9a6a-539bb8fbe540",
                                                "sense_id": "32fe1bc3-87ea-3baf-b53d-4e1e1c1d5e8a",
                                                "text": "„Praktisch stimmte der venusische Rat damit dafür, die Barbaren aus der marsianischen Mondstein-Welt ungehindert zur Erde fliegen zu lassen.“"
                                            },
                                            {
                                                "example_id": "ed1daf75-dd96-45d0-bc66-3cec1005cc1c",
                                                "sense_id": "32fe1bc3-87ea-3baf-b53d-4e1e1c1d5e8a",
                                                "text": "„Der medizinische Leiter des venusischen Stammhauses der Arahonta-Privatklinik, der Klonierer Maupabitt, hatte sich auf die Segmentklonung einzelner Organe und Organpartien spezialisiert, […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "079a8977-d451-4df9-8147-c7668e25c0af",
                        "source_entry_id": "83decfaf-945a-33c9-8133-2048ce0efeb4",
                        "target_lang_word": "Venusian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Venusian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5193c5fb-09f0-371b-9eee-4ac263c8fc6d",
                                        "entry_id": "69e25a7a-b625-39f5-9d2a-9800123fadb9",
                                        "glosses": [
                                            "An inhabitant of the planet Venus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3829cb53-e09a-4df9-b37d-c252342c3f87",
                                                "sense_id": "5193c5fb-09f0-371b-9eee-4ac263c8fc6d",
                                                "text": "The Venusians, unlike other planetary races, were almost like Earthpeople. There was only one notable difference—they had feathers on their heads instead of hair."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Venusian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "327c9ec9-1f39-34b0-9935-c255363d7779",
                                        "entry_id": "fe94c8fe-28db-34f7-9b76-413003a03adb",
                                        "glosses": [
                                            "Of or relating to the planet Venus."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "898f4c22-4781-4970-9ca8-8e29036da7a3",
                                                "sense_id": "327c9ec9-1f39-34b0-9935-c255363d7779",
                                                "text": "the Venusian landscape"
                                            },
                                            {
                                                "example_id": "c988e999-8558-4293-a06e-6240892cf0c1",
                                                "sense_id": "327c9ec9-1f39-34b0-9935-c255363d7779",
                                                "text": "The robot craft, the fifth from the Soviet Union to land on Venus, is a module detached from Venera 13. It plunged through the dense, baking-hot carbon dioxide atmosphere and touched down in the foothills of a mountainous region known as Phoebe, just south of the Venusian equator and also below the active volcanic region of Beta. An identical lander, from Venera 14, is expected to reach Venus Friday and probably put down on the plains east of the Phoebe landing site."
                                            },
                                            {
                                                "example_id": "7cfbd421-2a56-42c1-849f-364ad4c38e99",
                                                "sense_id": "327c9ec9-1f39-34b0-9935-c255363d7779",
                                                "text": "Kruban is a tidally-locked Venusian hothouse, its surface perpetually obscured by clouds of sulfur and carbon dioxides."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4223baf9-30a8-340b-9d94-e3266e5d6b30",
                                        "entry_id": "fe94c8fe-28db-34f7-9b76-413003a03adb",
                                        "glosses": [
                                            "Of or relating to inhabitants of Venus."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b17d643f-93cc-4d77-bf0e-2cd0742d2e72",
                                                "sense_id": "4223baf9-30a8-340b-9d94-e3266e5d6b30",
                                                "text": "a Venusian invasion"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7411942-5cc0-3e5e-a2a8-c4d8553c828e",
                                        "entry_id": "fe94c8fe-28db-34f7-9b76-413003a03adb",
                                        "glosses": [
                                            "Pertaining to the Roman goddess Venus."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "752ea871-d5d7-4e48-b7b5-51d77c501d1c",
                                                "sense_id": "f7411942-5cc0-3e5e-a2a8-c4d8553c828e",
                                                "text": "Near-synonym: Aphrodisian"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
