                ],
                "senses": [
                    {
                        "sense_id": "f9fcdc91-7091-373e-8abc-702e41b344c6",
                        "entry_id": "a8dbec56-737f-3386-b58e-fd197b026174",
                        "glosses": [
                            "de massa die een bepaalde structuur kan dragen zonder in te storten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa3d8f7e-285c-43a2-97b3-5584eafbe06e",
                                "sense_id": "f9fcdc91-7091-373e-8abc-702e41b344c6",
                                "text": "Het grondwaterpeil is lager dan in andere zomers. Als de funderingen droog komen te staan, neemt het draagvermogen af. \"Daar zitten we nu tegenaan en op enkele plekken in Zaanstad is het al het geval\", zegt een gemeentewoordvoerder tegen de krant."
                            },
                            {
                                "example_id": "4049b8b5-80e9-4c78-89d1-da0dbcb0c8d1",
                                "sense_id": "f9fcdc91-7091-373e-8abc-702e41b344c6",
                                "text": "De kinderen gebruikten de dug-out als tribune en zaten op de rand van het dak. Uit onderzoek is gebleken dat de betonplaat is gaan kantelen door overbelasting. Doordat ondersteuning in de zijwanden ontbrak, was het draagvermogen verminderd. Er ontbraken stenen in de muren. Een meisje van 10 kwam om het leven, vijf kinderen raakten gewond."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e4d5819-f701-3662-9510-5226be51e6b0",
                        "entry_id": "a8dbec56-737f-3386-b58e-fd197b026174",
                        "glosses": [
                            "het maximale gewicht dat een voertuig kan en mag vervoeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0d5d1b3-262a-4355-a425-e1fbf1a08736",
                                "sense_id": "5e4d5819-f701-3662-9510-5226be51e6b0",
                                "text": "Volgens de ANWB lijkt het erop dat bij het maken van de banden vooral gelet wordt op een zo groot mogelijk draagvermogen en zo min mogelijk brandstofverbruik. Dat lijkt ten koste te gaan van de veiligheid op de weg."
                            },
                            {
                                "example_id": "dd6798c6-7655-4c5e-a90f-5457431fd280",
                                "sense_id": "5e4d5819-f701-3662-9510-5226be51e6b0",
                                "text": "De conclusies lijken in tegenspraak met die in de Amerikaanse krant The Wall Street Journal gisteren. Ook meldde het minister van Transport eerder dat de bemanning het toestel net voor de ramp snel heeft laten klimmen om een onweersbui te ontwijken. Daarbij zou het te veel snelheid hebben verloren en zijn stilgevallen, waardoor het draagvermogen wegviel."
                            }
                        ]
                    }
