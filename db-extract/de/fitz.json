                ],
                "senses": [
                    {
                        "sense_id": "1c6a59c8-3636-3f7f-9566-b31510e82e68",
                        "entry_id": "50e24d7b-3dd9-30a5-8f90-d225861e92d8",
                        "glosses": [
                            "Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c1ea10d-e662-4d79-a1bf-185eeb04c186",
                                "sense_id": "1c6a59c8-3636-3f7f-9566-b31510e82e68",
                                "text": "Frau Fitz ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c924724e-20ca-4437-891c-f918c3d1fef4",
                                "sense_id": "1c6a59c8-3636-3f7f-9566-b31510e82e68",
                                "text": "Herr Fitz wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c4c229de-a6c3-4333-8536-dc40907e8785",
                                "sense_id": "1c6a59c8-3636-3f7f-9566-b31510e82e68",
                                "text": "Die Fitzens kommen heute von Sylt."
                            },
                            {
                                "example_id": "6449f710-1c48-404e-a5d1-caa4c3c1cc32",
                                "sense_id": "1c6a59c8-3636-3f7f-9566-b31510e82e68",
                                "text": "Der Fitz trägt nie die Schals, die die Fitz ihm strickt."
                            },
                            {
                                "example_id": "8a59be6f-7483-4858-9333-e3b0f7dde429",
                                "sense_id": "1c6a59c8-3636-3f7f-9566-b31510e82e68",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Fitz kommt, geht der Herr Fitz.“"
                            },
                            {
                                "example_id": "0e92d5df-3725-4625-9245-fe6b78ff4fbe",
                                "sense_id": "1c6a59c8-3636-3f7f-9566-b31510e82e68",
                                "text": "Fitz kommt und geht."
                            },
                            {
                                "example_id": "28227011-e608-4f74-951e-8b92169fe8cd",
                                "sense_id": "1c6a59c8-3636-3f7f-9566-b31510e82e68",
                                "text": "Fitzens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
