                    "examples": [
                        {
                            "text": "The hikers passed through the quiet hamlet of <w>Login</w> during their trek across Wales.",
                            "target_lang_translations": {
                                "ru": "Во время похода по Уэльсу туристы прошли через тихую деревушку <w>Логин</w>."
