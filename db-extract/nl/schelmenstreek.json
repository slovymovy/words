                "senses": [
                    {
                        "sense_id": "e441272c-19c9-300b-9102-2357a0f7b841",
                        "entry_id": "97761834-adce-3243-8320-d97f2517f6c0",
                        "glosses": [
                            "een handeling die past bij kwajongens, een vaak grappige, maar ondeugende handeling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1185dc9b-9f20-43cf-b01b-2cab2e0e5f1f",
                                "sense_id": "e441272c-19c9-300b-9102-2357a0f7b841",
                                "text": "Zijn vrienden herinneren hem als een impulsieve jongen die graag schelmenstreken uithaalt. Dat is meteen de reden waarom zijn academische carrière aan de Universiteit van Ohio van heel korte duur is: hij wordt ervan beschuldigd een pul bier stuk te hebben geslagen op de auto van de decaan en hij wordt prompt aan de deur gezet."
                            },
                            {
                                "example_id": "63f43790-9cf0-49ce-a666-2955d7f121f5",
                                "sense_id": "e441272c-19c9-300b-9102-2357a0f7b841",
                                "text": "De Twentse schelmenstreek duikt sinds donderdag in bijna alle kranten op en is onderwerp in tal van praatprogramma’s. De IJmuider vishandel ATL Seafood haakt er handig op in met hun reclame: “Deze week is de makreelfitel in de aanbieding. Wellicht een idee om er een Urker vistaart mee te maken”."
                            },
                            {
                                "example_id": "30cadd7f-e2c3-4095-a102-c9dace1e3b9b",
                                "sense_id": "e441272c-19c9-300b-9102-2357a0f7b841",
                                "text": "Van den Berg en Post voelen zich de Urker Pietje Bells. Een stiekeme schelmenstreek: Dunkirk naar Urk halen zonder dat iemand het doorheeft. Terwijl op Urk geheimen zelden verborgen blijven."
                            }
                        ]
                    }
                ],
