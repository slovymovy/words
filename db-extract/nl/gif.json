                "translations": [
                    {
                        "translation_id": "a4c32689-f5ac-4625-af3c-4a4e434a013b",
                        "source_entry_id": "3c9c609a-33ff-3943-a70b-971ff50d102e",
                        "source_sense_id": "866bbfcc-0864-3828-b736-6c5ecca9ec32",
                        "source_sense_description": "substantie die in kleine hoeveelheden schadelijk of dodelijk is",
                        "target_lang_word": "Gift",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gift",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c66545d5-19b3-3472-a21e-274e6f5b81e7",
                                        "entry_id": "37c45d2a-fa3d-3835-bd79-10dad5d38a57",
                                        "glosses": [
                                            "gesundheitsschädliche oder potenziell tödliche Substanz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4f9828d-a469-4b3a-8f5e-3ce9eb738f5b",
                                                "sense_id": "c66545d5-19b3-3472-a21e-274e6f5b81e7",
                                                "text": "Hamlets Vater wurde vom eigenen Bruder mit Gift ermordet."
                                            },
                                            {
                                                "example_id": "1a886f35-f45f-4266-9725-8ede704ce313",
                                                "sense_id": "c66545d5-19b3-3472-a21e-274e6f5b81e7",
                                                "text": "„Jedes Ding ist Gift und kein Ding ist ohne Gift, allein die Dosis macht, dass ein Ding kein Gift ist.“ – (Paracelsus)"
                                            },
                                            {
                                                "example_id": "a6f8b5b2-b36c-4fae-9a68-b8152ae7a553",
                                                "sense_id": "c66545d5-19b3-3472-a21e-274e6f5b81e7",
                                                "text": "Das Gift des Inlandtaipans ist das stärkste bekannte Schlangengift."
                                            },
                                            {
                                                "example_id": "87953633-6cbc-4a52-8f79-43cc9e58e99a",
                                                "sense_id": "c66545d5-19b3-3472-a21e-274e6f5b81e7",
                                                "text": "„Zudem muss Basileios seinen Höflingen misstrauen - etliche seiner Vorgänger sind durch Gift gestorben oder von Verschwörern gestürzt worden.“"
                                            },
                                            {
                                                "example_id": "a9feb9ec-d034-4e22-ab9f-4dfd7b330a54",
                                                "sense_id": "c66545d5-19b3-3472-a21e-274e6f5b81e7",
                                                "text": "„Gifte des Alltags gefährden nicht nur Leber und Lunge, sie machen Zellen überall im Körper alt.“"
                                            },
                                            {
                                                "example_id": "1cddfbec-29f8-4c35-8c9e-5b922df23338",
                                                "sense_id": "c66545d5-19b3-3472-a21e-274e6f5b81e7",
                                                "text": "„Einige haben Gift genommen wie der Chirurg aus Stolp und andere Ärzte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Gift",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f0db2f4-b292-3199-99be-a22473cd5568",
                                        "entry_id": "87a880b7-723f-3447-914a-9f9c84d3aab2",
                                        "glosses": [
                                            "Geschenk"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b56fe8e-654b-46bc-bb3c-76822205dc7b",
                                                "sense_id": "9f0db2f4-b292-3199-99be-a22473cd5568",
                                                "text": "„Bei Gott und Menschen ist beliebt, Wer Gift und Gaben richtig gibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Gift",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "28299c1f-dad0-3830-846b-666b13c97898",
                                        "entry_id": "6bcfd214-160a-3cc7-8b20-8b77b2ac2dd5",
                                        "glosses": [
                                            "ein meist durch Ärger mit einer anderen Person verursachtes negatives Gefühl"
                                        ],
                                        "tags": [
                                            "South-German",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5f07560-10a2-4d25-aab3-4e423c57e23d",
                                                "sense_id": "28299c1f-dad0-3830-846b-666b13c97898",
                                                "text": "„Im Bairischen kommt in solchen Fällen das Wort Gift zum Einsatz, im Sinne von Ärger, Zorn, Groll: Hoeneß hat einen Gift auf Ude, und Ude hat einen Gift auf Hoeneß.“"
                                            },
                                            {
                                                "example_id": "75fe7be8-58b5-4986-9697-698f5a0c413a",
                                                "sense_id": "28299c1f-dad0-3830-846b-666b13c97898",
                                                "text": "„Voller Gift, daß es die Häftlinge gewagt hatten, Trotz zu bieten, fauchte Kluttig auf Schwahl ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
