                ],
                "senses": [
                    {
                        "sense_id": "42e85d05-1311-3dbd-9e5d-2ef4e71d9f54",
                        "entry_id": "41a74212-f5e3-33d6-b8df-aa5ec298da49",
                        "glosses": [
                            "Se parler à soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3e2d23c-dc6b-4752-b9eb-a55a48a88740",
                                "sense_id": "42e85d05-1311-3dbd-9e5d-2ef4e71d9f54",
                                "text": "Qu’est-ce que tu m’as dit ? — Rien, je soliloquais."
                            },
                            {
                                "example_id": "39a2bd61-a1c7-421d-8cdb-a8bcc557cd18",
                                "sense_id": "42e85d05-1311-3dbd-9e5d-2ef4e71d9f54",
                                "text": "Lorsqu’elle n’était pas encore complètement saoule, elle soliloquait, se prédisant à elle-même d’effroyables catastrophes dont les responsables ne pouvaient être que de nature électronique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d73b7af-e0dd-4611-b1be-c22f6b7b46de",
                        "source_entry_id": "41a74212-f5e3-33d6-b8df-aa5ec298da49",
                        "source_sense_id": "42e85d05-1311-3dbd-9e5d-2ef4e71d9f54",
                        "target_lang_word": "soliloquize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soliloquize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b48c709-7e7e-3151-9573-9eafb081b6a6",
                                        "entry_id": "5cd4ad81-a096-3bb9-b0f0-876a35c01bbf",
                                        "glosses": [
                                            "Of a character: to perform a soliloquy, to talk to oneself."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e096bac3-cc7c-430c-90df-6df37700bc83",
                                                "sense_id": "0b48c709-7e7e-3151-9573-9eafb081b6a6",
                                                "text": "\"Now, I am quite sure that our beautiful hostess has been making an assignation,\" soliloquised Charles, who, for want of something better to do, had been watching the various actions of the group in the principal chamber in the castle, […]"
                                            },
                                            {
                                                "example_id": "df90e9ee-7e4d-44bb-9626-be16cc3ea05a",
                                                "sense_id": "0b48c709-7e7e-3151-9573-9eafb081b6a6",
                                                "text": "I rubbed my hands with delight over my happy notion, and soliloquised aloud, \"What a joy there is in going about doing good actions.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89165c27-3653-3d9d-bd8a-b523f7741438",
                                        "entry_id": "5cd4ad81-a096-3bb9-b0f0-876a35c01bbf",
                                        "glosses": [
                                            "To think to oneself."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "157f5678-907b-451b-b5c9-5189991ad8cb",
                                                "sense_id": "89165c27-3653-3d9d-bd8a-b523f7741438",
                                                "text": "Far up in the mountains he heard a lion roar. How much safer one was, he soliloquized, in the haunts of wild beasts than in the haunts of men."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "966dcd62-51e9-419d-881a-cb3e375814f5",
                        "source_entry_id": "41a74212-f5e3-33d6-b8df-aa5ec298da49",
                        "source_sense_id": "42e85d05-1311-3dbd-9e5d-2ef4e71d9f54",
                        "target_lang_word": "soliloquiar",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soliloquiar",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "2290dd62-1b7e-3164-ae56-9a93b30249b1",
                                        "entry_id": "bdba5939-72a8-34d4-8970-23f3df97c60d",
                                        "glosses": [
                                            "Hablar a solas."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e8d21b8-8cef-4247-8aec-af16195d92f3",
                                                "sense_id": "2290dd62-1b7e-3164-ae56-9a93b30249b1",
                                                "text": "«Pues sola pude quedar,\nun soliloquio he de hacer,\nque a una afligida mujer,\n¿quién quita el soliloquiar?»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
