                "senses": [
                    {
                        "sense_id": "6580ef31-c68c-3718-a6f3-564d61b19cb6",
                        "entry_id": "6b164dce-241a-3a9b-8e8c-ef5857df1c62",
                        "glosses": [
                            "Luft im Juni"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fc7cd12-09f4-4c6c-a1a6-1902e6980222",
                                "sense_id": "6580ef31-c68c-3718-a6f3-564d61b19cb6",
                                "text": "„Eigenartig, denn die einst zugemauerten Fenster in jenem Zimmer hätten zwar aufgestanden und die warme Juniluft hereingelassen, doch den ganzen Tag habe sich kaum ein Lüftchen geregt.“"
                            },
                            {
                                "example_id": "98aefb4e-93a3-4127-b0d5-f4ae358d7a08",
                                "sense_id": "6580ef31-c68c-3718-a6f3-564d61b19cb6",
                                "text": "„Es war auch wonnig droben; warme Junilüfte wehten um die Burg und trugen den Duft des blühenden Holunders und Jasmins in das Gärtchen, wo heute der Kreis der Freunde versammelt war.“"
                            },
                            {
                                "example_id": "7bf65e2b-dd75-4126-9b11-6c987bb98a5c",
                                "sense_id": "6580ef31-c68c-3718-a6f3-564d61b19cb6",
                                "text": "„Die Fenster stehen offen, warme Junilüfte und blitzender Sonnenschein grüßen die Bewohnerin, als wollten sie uns sagen: […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
