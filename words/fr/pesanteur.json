                    "frequency": "Low",
                    "semantic_group_id": "figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur déplorait les nombreuses <w>pesanteurs</w> administratives qui freinaient les projets."
                        },
                        {
                            "text": "Le style de cet auteur manque d'élégance à cause d'une certaine <w>pesanteur</w> d'esprit."
