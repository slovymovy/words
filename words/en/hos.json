                            {
                                "target_lang_word": "шлюхи",
                                "target_lang_sense_clarification": "грубое, оскорбительное"
                            },
                            {
                                "target_lang_word": "проститутки",
                                "target_lang_sense_clarification": "более формальное"
                            },
