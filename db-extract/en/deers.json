                "senses": [
                    {
                        "sense_id": "747c368b-ddcc-358e-8999-192d89eaffe5",
                        "entry_id": "2998af9f-6962-37ec-b488-1b5d84d40c9e",
                        "glosses": [
                            "Defense Enrollment and Eligibility Reporting System."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "afe646e8-fbde-4d70-830b-32fe5476f39c",
                                "sense_id": "747c368b-ddcc-358e-8999-192d89eaffe5",
                                "text": "In order to receive such care, however, all Armed Forces personnel must enroll their family members in the DEERS (Defense Enrollment Reporting System) program. Check your Personnel Office or, on larger posts, the DEERS Office for appropriate forms and actions."
                            },
                            {
                                "example_id": "c4396c42-156b-4486-833e-14446c952357",
                                "sense_id": "747c368b-ddcc-358e-8999-192d89eaffe5",
                                "text": "The ACTUR program is a component of the Defense Eligibility and Enrollment Reporting System (DEERS) program, which is used to establish eligibility for DoD services.[…]The database is linked through ACTUR and DEERS."
                            }
                        ]
                    }
                ],
