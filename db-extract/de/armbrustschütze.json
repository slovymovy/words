                    }
                ],
                "senses": [
                    {
                        "sense_id": "c8f3ee0b-1f84-37a7-a273-8dee9adcf417",
                        "entry_id": "959ad3bd-a0be-3cc2-9a3d-bf7949780338",
                        "glosses": [
                            "Sportler, der mit einer Armbrust schießt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf5b116d-e5ab-448f-a788-c2187fd3ba0a",
                                "sense_id": "c8f3ee0b-1f84-37a7-a273-8dee9adcf417",
                                "text": "„Eidgenössischer Armbrustschützenverband (kurz: EASV) (französisch: Association Fédérale de tir à l'arbalète) ist der Dachverband der Armbrustschützen für Breitensport und Leistungssport in der Schweiz, er wurde am 17. Juli 1898 gegründet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b0be5986-e86d-3aaf-b213-4db97b2c0f1b",
                        "entry_id": "959ad3bd-a0be-3cc2-9a3d-bf7949780338",
                        "glosses": [
                            "Soldat, der mit einer Armbrust bewaffnet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0520f9c-6124-4b7e-8625-be6a36a2cded",
                                "sense_id": "b0be5986-e86d-3aaf-b213-4db97b2c0f1b",
                                "text": "„Eine neue Waffe schwamm jetzt im trüben Wasser des Sees: 13 kleine Kriegsschiffe, Brigantinen, bemannt mit Armbrustschützen und Musketieren.“"
                            },
                            {
                                "example_id": "1393e83d-394c-442a-b132-cf675139b1cf",
                                "sense_id": "b0be5986-e86d-3aaf-b213-4db97b2c0f1b",
                                "text": "„Das Laden erfolgt von vorn und dauert einige Minuten, in denen Armbrustschützen weiter ihre Pfeile verschießen können.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70858402-7037-44ba-ad64-dc31c4ebe48f",
                        "source_entry_id": "959ad3bd-a0be-3cc2-9a3d-bf7949780338",
                        "source_sense_id": "b0be5986-e86d-3aaf-b213-4db97b2c0f1b",
                        "source_sense_description": "Soldat, der mit einer Armbrust bewaffnet ist",
                        "target_lang_word": "crossbowman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crossbowman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0f35636-f600-38f3-a53c-3c0be55a838d",
                                        "entry_id": "d84e7631-72b1-37de-bc6b-4375c4146a3e",
                                        "glosses": [
                                            "Someone (usually a soldier) equipped with a crossbow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9342274-84aa-4f70-96ec-a8fc63f44538",
                                                "sense_id": "a0f35636-f600-38f3-a53c-3c0be55a838d",
                                                "text": "Why did Richard I die at the hands of a crossbowman, clutching a frying pan, on the outskirts of Limoges?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "682bbb10-6f4a-4143-97dd-1290c9569600",
                        "source_entry_id": "959ad3bd-a0be-3cc2-9a3d-bf7949780338",
                        "source_sense_id": "b0be5986-e86d-3aaf-b213-4db97b2c0f1b",
                        "source_sense_description": "Soldat, der mit einer Armbrust bewaffnet ist",
                        "target_lang_word": "arbalétrier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arbalétrier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a99f00cc-b6da-3c4a-b877-8993d215caee",
                                        "entry_id": "c8c00eb5-7e81-3511-a3a9-fafdc7cdfe4b",
                                        "glosses": [
                                            "Personne qui se servait de l’arbalète."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75963085-ed7b-49a9-8bb2-ad227afe8a58",
                                                "sense_id": "a99f00cc-b6da-3c4a-b877-8993d215caee",
                                                "text": "De Bracy sonna du cor à trois reprises, et les archers et arbalétriers, qui avaient paru sur le mur à l’approche de la petite troupe, se hâtèrent de baisser le pont-levis et de l’introduire."
                                            },
                                            {
                                                "example_id": "f18ae695-5925-4972-bce0-248b2e0476b4",
                                                "sense_id": "a99f00cc-b6da-3c4a-b877-8993d215caee",
                                                "text": "[…], les meurtrières pratiquées dans les merlons de pierre restaient démasquées dans leur partie inférieure et permettaient aux arbalétriers postés au dedans du parapet sur ce chemin de ronde de lancer des traits sur les assaillants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38ed7462-5f21-3779-ae84-53effcc1926a",
                                        "entry_id": "c8c00eb5-7e81-3511-a3a9-fafdc7cdfe4b",
                                        "glosses": [
                                            "Synonyme de martinet noir (oiseau)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2bf0aae-e889-3bdf-a89f-405d10e44d11",
                                        "entry_id": "c8c00eb5-7e81-3511-a3a9-fafdc7cdfe4b",
                                        "glosses": [
                                            "Nom commun des balistes (poissons)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "480285be-39ae-31c1-b0c5-b5c4533b5505",
                                        "entry_id": "c8c00eb5-7e81-3511-a3a9-fafdc7cdfe4b",
                                        "glosses": [
                                            "Chacune de deux pièces de bois qui servent à former le comble d’un bâtiment de manière à s’assembler par leur extrémité supérieure dans la pièce de bois verticale qu’on appelle aiguille ou poinçon, et par l’autre extrémité dans la poutre horizontale qu’on nomme entrait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce558684-8970-40bf-86a0-d81c17adbce6",
                                                "sense_id": "480285be-39ae-31c1-b0c5-b5c4533b5505",
                                                "text": "Dans ces demeures grossières, en effet, murailles, planchers, plafonds, murs de refend, cloisons, chevrons, faîtage, arbalétriers, bardeaux, tout est planches, poutres et poutrelles."
                                            },
                                            {
                                                "example_id": "e156b7b3-8c6d-456c-bd8c-ffcf74ecdc9e",
                                                "sense_id": "480285be-39ae-31c1-b0c5-b5c4533b5505",
                                                "text": "Un second rang de moises, posé en L à 1m,80 du premier rang, formait l’enrayure des arbalétriers M du comble."
                                            },
                                            {
                                                "example_id": "2f6d2194-8a65-4005-b4ea-2262a13871a5",
                                                "sense_id": "480285be-39ae-31c1-b0c5-b5c4533b5505",
                                                "text": "Ces moments fléchissants de l’arbalétrier se rapportent aux points d’appui. Si des pannes sont placées entre les points d’appui, il faudra les considérer comme des forces fléchissantes et en tenir compte en calculant l’arbalétrier à la flexion et à la compression comme dans l’exemple du nᵒ 1252."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
