        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6255044b-16b3-3c22-b472-4838f84ebe91",
                "word": "escheat",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8a3a5a37-7069-4302-aba1-94a8672bb593",
                        "entry_id": "6255044b-16b3-3c22-b472-4838f84ebe91",
                        "tags": [
                            "plural"
                        ],
                        "form": "escheats"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3bdaa7e8-85d0-3ed0-b3b9-d29dcd28a775",
                        "entry_id": "6255044b-16b3-3c22-b472-4838f84ebe91",
                        "glosses": [
                            "The return of property of a deceased person to the state (originally to a feudal lord) where there are no legal heirs or claimants."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3d1b610c-7a9f-3cf0-9d06-2d31876bfc5a",
                        "entry_id": "6255044b-16b3-3c22-b472-4838f84ebe91",
                        "glosses": [
                            "The property so reverted."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cfe58000-cda4-334c-97a1-16dfd47f1c45",
                        "entry_id": "6255044b-16b3-3c22-b472-4838f84ebe91",
                        "glosses": [
                            "Plunder, booty."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "51386286-fcc5-420e-b68c-9c9d030d7245",
                                "sense_id": "cfe58000-cda4-334c-97a1-16dfd47f1c45",
                                "text": "Approching, with bold words and bitter threat, / Bad that same boaster, as he mote, on high / To leaue to him that Lady for excheat, / Or bide him battell without further treat."
                            }
                        ]
                    },
                    {
                        "sense_id": "b40db068-08ce-3121-8e8b-726db93d3ee8",
                        "entry_id": "6255044b-16b3-3c22-b472-4838f84ebe91",
                        "glosses": [
                            "That which falls to one; a reversion or return."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9da4fe11-147a-408c-a5f9-c09ea465a3cc",
                                "sense_id": "b40db068-08ce-3121-8e8b-726db93d3ee8",
                                "text": "And by my ruines thinkes to make them great: / To make one great by others losse, is bad excheat"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "565a74f0-ec11-486c-a0c0-01f835cb8469",
                        "source_entry_id": "6255044b-16b3-3c22-b472-4838f84ebe91",
                        "source_sense_description": "Translations",
                        "target_lang_word": "déshérence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déshérence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ff6e175-997c-39b3-9335-d8720808c13e",
                                        "entry_id": "58569078-8139-3b3a-ae59-d63c3a906e9d",
                                        "glosses": [
                                            "Défaut d’héritiers naturels par suite duquel une succession revient à l’État."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85fdb5f2-003f-49d4-9451-7b0bfd3990ce",
                                                "sense_id": "2ff6e175-997c-39b3-9335-d8720808c13e",
                                                "text": "Les biens civils acquis par le condamné depuis la mort civile encourue et dont il se trouvera en possession au jour de sa mort naturelle, appartiendront à la nation par droit de déshérence."
                                            },
                                            {
                                                "example_id": "c280d16d-51d4-49a2-8f4f-3e925d50bab6",
                                                "sense_id": "2ff6e175-997c-39b3-9335-d8720808c13e",
                                                "text": "Une étrange contagion, en ces contrées, s’était emparée des esprits. Pas d’enfants ! Aujourd’hui, tous les biens, ici, tombent en déshérence !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76d69d36-8d67-3244-b23e-05baa6c675bd",
                                        "entry_id": "58569078-8139-3b3a-ae59-d63c3a906e9d",
                                        "glosses": [
                                            "Disparition de la continuité d’une organisation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cefc2de-471e-4b9f-a20e-fe577c1bf260",
                                                "sense_id": "76d69d36-8d67-3244-b23e-05baa6c675bd",
                                                "text": "Paul Faure disait que ces révolutions avaient été faites par des armées en déroute. C'est une vue incomplète. Il y a eu, à ce moment là une sorte de déshérence du pouvoir bourgeois. L'état capitaliste s’est effondré sous le poids de ces fautes, de ses crimes."
                                            },
                                            {
                                                "example_id": "6495bed4-7c21-4d36-b795-a180a7ff3392",
                                                "sense_id": "76d69d36-8d67-3244-b23e-05baa6c675bd",
                                                "text": "Cela est particulièrement vrai en milieu rural, mais aussi dans les banlieues totalement laissées en déshérence par un gouvernement qui a eu l’audace de proposer, à grand renfort de publicité médiatique, un plan Marshall pour les quartiers sans accorder aucun moyen financier : tant pis pour la rigueur de la référence historique."
                                            },
                                            {
                                                "example_id": "ff125381-7575-41ce-a926-ddd02e00073e",
                                                "sense_id": "76d69d36-8d67-3244-b23e-05baa6c675bd",
                                                "text": "Pline, en prenant son poste, découvre que la religion civique est en déshérence, les temples vides, que personne ne veut plus acheter au marché de viandes immolées aux dieux, et à ce qu'on lui dit la principale raison de cette situation désolante est le succès d’une secte dont il n’a jamais entendu parler : les disciples de Christus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad2afaaa-a8e5-4ce2-94d4-a71a75be865f",
                        "source_entry_id": "6255044b-16b3-3c22-b472-4838f84ebe91",
