                                "target_senses": [
                                    {
                                        "sense_id": "a4b1ca0e-2370-34e6-a5b4-2e45b94b1e43",
                                        "entry_id": "01837145-18ff-34a3-9209-f1f8f2108e53",
                                        "glosses": [
                                            "gegenüber von jemandem, etwas liegen; sich gegenüber befinden"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea71e88f-b2e2-4ea2-9e38-a3e2443e5cea",
                                                "sense_id": "a4b1ca0e-2370-34e6-a5b4-2e45b94b1e43",
                                                "text": "Als Antipoden bezeichnet man in der Mathematik zwei Punkte einer Sphäre, die sich diametral gegenüberliegen."
                                            },
                                            {
                                                "example_id": "5e1a3e74-ecfd-4591-a8c7-23b291ee8dd7",
                                                "sense_id": "a4b1ca0e-2370-34e6-a5b4-2e45b94b1e43",
                                                "text": "Auf der Erdkugel liegt Spanien genau gegenüber von Neuseeland."
                                            },
                                            {
                                                "example_id": "7ec59d7c-9f3d-4c15-9910-61d141d62473",
                                                "sense_id": "a4b1ca0e-2370-34e6-a5b4-2e45b94b1e43",
                                                "text": "Man nennt die Seite, die dem rechten Winkel gegenüberliegt, die Hypotenuse des Dreiecks und die anderen beiden Seiten die Katheten."
                                            },
                                            {
                                                "example_id": "ced1ef6c-40ce-4064-9aa1-6208e15010bd",
                                                "sense_id": "a4b1ca0e-2370-34e6-a5b4-2e45b94b1e43",
                                                "text": "Im Gipfelbereich, wo sich die verfeindeten Truppen gegenüberlagen, häufen sich Infotafeln, Gedenktafeln, Denkmäler und bauliche Überreste."
                                            },
                                            {
                                                "example_id": "89944f89-7243-4d10-ba2b-2f33c7a62a56",
                                                "sense_id": "a4b1ca0e-2370-34e6-a5b4-2e45b94b1e43",
                                                "text": "Für das Handschriftkraftwerk legten die Forscher nun zwei solcher Papierflächen so aufeinander, dass sich die etwa ein fünftel Mikrometer dünnen Zinkoxidsäulen gegenüberlagen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bcd479f0-56fa-4e0a-89f0-d34eb1d65017",
