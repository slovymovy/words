                        "sense_id": "04982f5b-8a0d-320a-bce8-861df9fec4d9",
                        "entry_id": "39bbec5f-ae0d-36e7-b45c-afe1d3e837cd",
                        "glosses": [
                            "Staat, der ein internationales Abkommen/einen internationalen Vertrag unterzeichnet hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34018531-302c-42c4-83e5-a3bf5d2f81a1",
                                "sense_id": "04982f5b-8a0d-320a-bce8-861df9fec4d9",
                                "text": "„Sie sollte vollständig entmilitarisiert und gemeinsam von Diplomaten der Signatarmächte und einer kleinen Gruppe lokaler Repräsentanten verwaltet werden.“"
                            },
                            {
                                "example_id": "ad2e8f04-57b4-4532-8eab-a9da573ea65c",
                                "sense_id": "04982f5b-8a0d-320a-bce8-861df9fec4d9",
                                "text": "„Was für ein Staat wurde im Herbst 1938 von den Signatarmächten des Münchner Abkommens – Deutschland, Italien, Frankreich und Großbritannien – amputiert und im Frühjahr 1939 von Hitler zerschlagen?“"
                            }
                        ],
