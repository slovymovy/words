                "senses": [
                    {
                        "sense_id": "22d083c1-07c9-3f0a-bb89-b150d24bcee8",
                        "entry_id": "f7281fc5-7539-36b4-b979-274e5be3dc34",
                        "glosses": [
                            "Wald, der vom Menschen zur Erzeugung von Holz, Gerbrinde, Harz, Heilkräutern, Wildbret oder auch als Erholungslandschaft genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "231d6e7b-91cd-42ae-9512-01d7982349f7",
                                "sense_id": "22d083c1-07c9-3f0a-bb89-b150d24bcee8",
                                "text": "„Etwas, was fernab von uns einfach so ist, wie es ist. Eine Welt, die sich gleich bleibt, im Winterfrost wie im Frühling, selbst wenn es sich nur um einen von Menschen verwalteten Kulturwald handelt. Aber der Ehrenpreis, der blüht, und sei es in einem Stadtwald, ist da immerhin nicht hingepflanzt, und die Rotkehlchen werden auch nicht vom Forstmeister in den Wald gesetzt.“"
                            },
                            {
                                "example_id": "9faeef79-8fda-48ef-a189-629bfacea81f",
                                "sense_id": "22d083c1-07c9-3f0a-bb89-b150d24bcee8",
                                "text": "„Die Gründung und Nutzung der Kulturwälder […] heißt Waldbau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
