                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>connected</w> the printer to her laptop using a USB cable.",
                            "target_lang_translations": {
                                "ru": "Она <w>подключила</w> принтер к своему ноутбуку с помощью USB-кабеля.",
                                "pl": "Ona <w>podłączyła</w> drukarkę do laptopa za pomocą kabla USB."
