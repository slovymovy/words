                "translations": [
                    {
                        "translation_id": "e83d1b97-991d-4d49-a804-211d5f0c4f8e",
                        "source_entry_id": "29c46d9b-b0fb-3bf0-990e-313d1ec49a54",
                        "source_sense_id": "1eeefa79-3803-3d38-ae09-91ce7e5283dd",
                        "target_lang_word": "innocence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "innocence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce339f66-0a7e-344a-b69e-79ddccf6132d",
                                        "entry_id": "b2b3e116-8b1d-361a-b375-b815139ac8a3",
                                        "glosses": [
                                            "Absence of responsibility for a crime, tort, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87e0093e-f85c-43fb-8b35-56d691bb83ec",
                                                "sense_id": "ce339f66-0a7e-344a-b69e-79ddccf6132d",
                                                "text": "Her attorney managed to convince the jury of her innocence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19e39740-79ea-3d1b-bea2-d4e859262ad2",
                                        "entry_id": "b2b3e116-8b1d-361a-b375-b815139ac8a3",
                                        "glosses": [
                                            "Lack of understanding about sensitive subjects such as sexuality and crime."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc0d447e-36b2-4d1f-90cb-1e0ee996ba6c",
                                                "sense_id": "19e39740-79ea-3d1b-bea2-d4e859262ad2",
                                                "text": "In his innocence, he offered the stranger to bring the package to Paris, never suspecting it contained drugs."
                                            },
                                            {
                                                "example_id": "3e3a47cc-c5ff-4676-a9c6-53f4eee8776e",
                                                "sense_id": "19e39740-79ea-3d1b-bea2-d4e859262ad2",
                                                "text": "Eustace gaped at him in amazement. When his urbanity dropped away from him, as now, he had an innocence of expression which was almost infantile. It was as if the world had never touched him at all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5eb619ab-07e8-3902-8141-d5ed94526d41",
                                        "entry_id": "b2b3e116-8b1d-361a-b375-b815139ac8a3",
                                        "glosses": [
                                            "Lack of ability or intention to harm or damage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7198d92-ca1e-4d15-a2a7-2fa8af70548e",
                                                "sense_id": "5eb619ab-07e8-3902-8141-d5ed94526d41",
                                                "text": "Tests have demonstrated the innocence of this substance."
                                            },
                                            {
                                                "example_id": "39632a40-9a10-4259-b4bd-f142069c7d42",
                                                "sense_id": "5eb619ab-07e8-3902-8141-d5ed94526d41",
                                                "text": "His unruly hair was slicked down with water, and as Jessamy introduced him to Miss Brindle his face assumed a cherubic innocence which would immediately have aroused the suspicions of anyone who knew him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad36105f-98fe-3a48-8b29-0b092d4dce74",
                                        "entry_id": "b2b3e116-8b1d-361a-b375-b815139ac8a3",
                                        "glosses": [
                                            "Imbecility; mental deficiency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94223ba7-1fbf-4a4a-8fed-ee7c7036c15d",
                        "source_entry_id": "29c46d9b-b0fb-3bf0-990e-313d1ec49a54",
                        "source_sense_id": "1eeefa79-3803-3d38-ae09-91ce7e5283dd",
                        "target_lang_word": "innocence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "innocence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aef9cada-e22f-39ba-9da8-313057afb5e9",
                                        "entry_id": "91cf315e-8988-3b3c-81dd-db83db6dd2aa",
                                        "glosses": [
                                            "État de celui qui n’est pas coupable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04972ec5-73bd-466a-8c4d-a50e237b87b1",
                                                "sense_id": "aef9cada-e22f-39ba-9da8-313057afb5e9",
                                                "text": "Elle appelle le délinquant à son tribunal ; elle commence par lui administrer la bâtonnade pour lui rafraîchir la mémoire, et ensuite elle lui dit : Prouve ton innocence."
                                            },
                                            {
                                                "example_id": "6f5a65ab-d900-4fad-9138-79db93e7261f",
                                                "sense_id": "aef9cada-e22f-39ba-9da8-313057afb5e9",
                                                "text": "On a reconnu son innocence."
                                            },
                                            {
                                                "example_id": "8ddf56a6-6ea9-4ba5-9b7a-90faaa172c3a",
                                                "sense_id": "aef9cada-e22f-39ba-9da8-313057afb5e9",
                                                "text": "Défendre la cause de l’innocence."
                                            },
                                            {
                                                "example_id": "302440b5-6283-4555-8557-b55edfebc220",
                                                "sense_id": "aef9cada-e22f-39ba-9da8-313057afb5e9",
                                                "text": "Plaider l’innocence."
                                            },
                                            {
                                                "example_id": "2d7ec764-a1be-46cb-9ba2-57948f0bca8c",
                                                "sense_id": "aef9cada-e22f-39ba-9da8-313057afb5e9",
                                                "text": "Persécuter, poursuivre l’innocence."
                                            },
                                            {
                                                "example_id": "9ddbb501-6505-4e4c-9d02-ec40beb96cf2",
                                                "sense_id": "aef9cada-e22f-39ba-9da8-313057afb5e9",
                                                "text": "Protéger, sauver, faire triompher l’innocence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5e7a259-6573-3359-9f30-650c7fb8430f",
                                        "entry_id": "91cf315e-8988-3b3c-81dd-db83db6dd2aa",
                                        "glosses": [
                                            "État, qualité de celui qui ne commet pas le mal sciemment, qui est pur et candide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35913028-6ea8-41ba-bf8b-03863cac5e2c",
                                                "sense_id": "b5e7a259-6573-3359-9f30-650c7fb8430f",
                                                "text": "Pour offenser Dieu, mes enfants, pour perdre l’innocence et mériter l'enfer, il n'est pas nécessaire de faire aucune action déshonnête ; le désir seul est un crime."
                                            },
                                            {
                                                "example_id": "8fccc808-a1f7-4d83-ab2a-fdbe278e3375",
                                                "sense_id": "b5e7a259-6573-3359-9f30-650c7fb8430f",
                                                "text": "Invisible et sans rien troubler de ma présence,\ncomme un Zeus vêtu d'air aux âges d’innocence,\nque ne puis-je « inspecter » le grand travail des champs !"
                                            },
                                            {
                                                "example_id": "9efa4b54-fcc6-4e9b-b5b6-86154d04ebc8",
                                                "sense_id": "b5e7a259-6573-3359-9f30-650c7fb8430f",
                                                "text": "Vous étiez innocents ? De quoi préserve-t-elle, l’innocence ?\nMême le Créateur nous dit d’égorger les agneaux pour nos réjouissances.\nJamais les loups…"
                                            },
                                            {
                                                "example_id": "598dd8eb-85de-44d2-8a66-73a6f87c0562",
                                                "sense_id": "b5e7a259-6573-3359-9f30-650c7fb8430f",
                                                "text": "L’innocence de nos premiers parents."
                                            },
                                            {
                                                "example_id": "ce6c4eb0-06a6-42b7-a7fa-5da841f92999",
                                                "sense_id": "b5e7a259-6573-3359-9f30-650c7fb8430f",
                                                "text": "Adam fut créé dans un état d’innocence."
                                            },
                                            {
                                                "example_id": "213273cf-df08-430f-9829-f7f01c3a0a2a",
                                                "sense_id": "b5e7a259-6573-3359-9f30-650c7fb8430f",
                                                "text": "Vivre dans l’innocence."
                                            },
                                            {
                                                "example_id": "a426afc0-e642-420a-b8bd-def1e0e5e547",
                                                "sense_id": "b5e7a259-6573-3359-9f30-650c7fb8430f",
                                                "text": "Elle a conservé son innocence dans les occasions où elle courait le plus grand danger."
                                            },
                                            {
                                                "example_id": "7d37e8dd-f693-4065-8fd2-231859cef5af",
                                                "sense_id": "b5e7a259-6573-3359-9f30-650c7fb8430f",
                                                "text": "Perdre son innocence."
                                            },
                                            {
                                                "example_id": "9f692759-e3ee-43b2-b8fb-66a0bd6127b2",
                                                "sense_id": "b5e7a259-6573-3359-9f30-650c7fb8430f",
                                                "text": "Abuser de l’innocence d’une jeune fille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5362e316-be04-3a21-8c85-c1c376b30544",
                                        "entry_id": "91cf315e-8988-3b3c-81dd-db83db6dd2aa",
                                        "glosses": [
                                            "Qui n'est pas malfaisant, qui ne nuit pas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77ca7315-1bd0-4caa-8ef8-701205db9aa8",
                                                "sense_id": "5362e316-be04-3a21-8c85-c1c376b30544",
                                                "text": "L’innocence d’un agneau, d’une colombe, d'une oie blanche."
                                            },
                                            {
                                                "example_id": "a01a16c3-6090-43e2-8bc9-65d13a170b44",
                                                "sense_id": "5362e316-be04-3a21-8c85-c1c376b30544",
                                                "text": "L’âge d’innocence, L’enfance."
                                            },
                                            {
                                                "example_id": "dcf55118-2cf0-47ca-801f-3e6beb2680f1",
                                                "sense_id": "5362e316-be04-3a21-8c85-c1c376b30544",
                                                "text": "'(Sens figuré), en termes de Dévotion,"
                                            },
                                            {
                                                "example_id": "1506035d-cc22-42dd-8b1f-0c1f111544c7",
                                                "sense_id": "5362e316-be04-3a21-8c85-c1c376b30544",
                                                "text": "La robe d’innocence, L’état d’innocence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff2fbdad-8f67-344d-a1bf-8850f45aea9f",
                                        "entry_id": "91cf315e-8988-3b3c-81dd-db83db6dd2aa",
                                        "glosses": [
                                            "État de celui qui a l’esprit faible, borné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0040922-aafb-4b03-9f5d-77462dfe90ad",
                                                "sense_id": "ff2fbdad-8f67-344d-a1bf-8850f45aea9f",
                                                "text": "Son innocence est vraiment ridicule."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
