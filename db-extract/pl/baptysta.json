                                        "entry_id": "0ddc626e-8a75-315b-afd0-03d58704e2e9",
                                        "glosses": [
                                            "Anhänger des Baptismus; Mitglied einer Baptistengemeinde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4314df18-b6a4-4e08-b6f3-2f80f1672303",
                                                "sense_id": "203afc3e-69fd-3c22-9097-39608102d249",
                                                "text": "Sind Baptisten unter euch?"
                                            },
                                            {
                                                "example_id": "ca93fe27-e825-4304-97db-f6632ac5f862",
                                                "sense_id": "203afc3e-69fd-3c22-9097-39608102d249",
                                                "text": "„In null Komma nichts hatte sie aus Everett einen Baptisten gemacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
