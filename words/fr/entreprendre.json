{
    "word_family": [
        "entreprenant",
        "entrepreneur",
        "entreprise"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1ea4a08d-64c2-3665-b047-14658d0c1933",
                    "sense_definition": "Prendre la décision de faire quelque chose et commencer à le mettre à exécution.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a décidé d'<w>entreprendre</w> un voyage autour du monde après ses études."
                        },
                        {
                            "text": "Nous devons <w>entreprendre</w> des démarches rapidement pour obtenir notre permis de construire."
                        }
                    ],
                    "synonyms": [
                        "commencer",
                        "engager",
                        "entamer",
                        "lancer"
                    ],
                    "antonyms": [
                        "abandonner",
                        "renoncer"
                    ],
                    "common_phrases": [
                        "entreprendre des démarches",
                        "entreprendre des études",
                        "entreprendre un voyage"
                    ]
                },
                {
                    "sense_id": "998293c9-30eb-3700-a95b-241433ec9169",
                    "sense_definition": "S'engager par contrat à fournir des prestations ou à exécuter un projet selon des conditions précises.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette société a <w>entrepris</w> des travaux de rénovation pour le compte de la mairie."
                        },
                        {
                            "text": "L'artisan s'est engagé et <w>entreprend</w> la fourniture de tous les matériaux nécessaires."
                        }
                    ],
                    "common_phrases": [
                        "entreprendre des travaux",
                        "entreprendre la fourniture"
                    ]
                },
                {
                    "sense_id": "927f321d-cc85-3d64-9af5-6fd09fa50340",
                    "sense_definition": "Interpeller ou questionner vivement quelqu'un afin d'agir sur son opinion ou d'obtenir satisfaction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le journaliste l'a <w>entrepris</w> sur la question du budget dès la fin du discours."
                        },
                        {
                            "text": "J'<w>entreprends</w> ce responsable dès demain pour débloquer la situation."
                        }
                    ],
                    "synonyms": [
                        "harceler",
                        "interpeller",
                        "presser"
                    ],
                    "common_phrases": [
                        "entreprendre quelqu'un"
                    ]
                },
                {
                    "sense_id": "e8b40362-399d-3ff2-9e3e-e1e42d1ce4cd",
                    "sense_definition": "Empiéter de manière illégitime sur le terrain ou les prérogatives d'autrui.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La nouvelle clôture <w>entreprend</w> visiblement sur la propriété du voisin."
                        },
                        {
                            "text": "Cette décision contestée risque d'<w>entreprendre</w> sur les droits des usagers."
                        }
                    ],
                    "synonyms": [
                        "empiéter",
                        "usurper"
                    ],
                    "common_phrases": [
                        "entreprendre sur les droits"
                    ]
                },
                {
                    "sense_id": "a6bb07ca-a95e-3461-a73c-f992c0d6db0e",
                    "sense_definition": "Déclencher une action hostile ou diriger des attaques contre une personne ou une institution.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux généraux se sont juré de ne rien <w>entreprendre</w> contre la population civile."
                        },
                        {
                            "text": "L'armée ennemie <w>entreprit</w> une manœuvre soudaine contre la capitale."
                        }
                    ],
                    "synonyms": [
                        "attaquer"
                    ],
                    "common_phrases": [
                        "entreprendre contre quelqu'un"
                    ]
                },
                {
                    "sense_id": "0c732b7d-0157-3a0c-8c06-261d9fa68186",
                    "sense_definition": "Chercher à séduire ou courtiser quelqu'un avec insistance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant tout le banquet, le jeune homme <w>entreprit</w> sa voisine avec galanterie."
                        },
                        {
                            "text": "Il n'hésite jamais à <w>entreprendre</w> les invitées lors des réceptions mondaines."
                        }
                    ],
                    "synonyms": [
                        "courtiser",
                        "draguer",
                        "séduire"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "s'emploie surtout dans un contexte littéraire ou vieilli"
                        }
                    ]
                },
                {
                    "sense_id": "8ebcb7a9-4d4f-3967-95dd-e5bea23d18c4",
                    "sense_definition": "Tourmenter, persécuter ou accabler une personne de railleries et de reproches.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants l'ont cruellement <w>entrepris</w> à cause de son accoutrement inhabituel."
                        },
                        {
                            "text": "Ses collègues l'<w>entreprennent</w> sans pitié dès qu'il commet la moindre erreur."
                        }
                    ],
                    "synonyms": [
                        "harceler",
                        "persécuter",
                        "railler",
                        "tourmenter"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "usage rare et littéraire"
                        }
                    ]
                }
            ]
        }
    ]
}