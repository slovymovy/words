                "senses": [
                    {
                        "sense_id": "7add8ce2-5d67-3641-b26b-e6d527c252c8",
                        "entry_id": "ee82a958-3c4a-385c-99c8-348758613351",
                        "glosses": [
                            "To strike hard and suddenly."
                        ],
                        "tags": [
                            "US",
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6b2262bd-2af4-351d-ad3c-474d6b80a115",
                        "entry_id": "ee82a958-3c4a-385c-99c8-348758613351",
                        "glosses": [
                            "To throw oneself quickly, or by an abrupt motion; to turn suddenly."
                        ],
                        "tags": [
                            "US",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4baf1230-b51b-4c9d-846a-849fb270ef7f",
                                "sense_id": "6b2262bd-2af4-351d-ad3c-474d6b80a115",
                                "text": "1844, Thomas Chandler Haliburton, Judge Haliburton’s Yankee Stories, Part Two, Chapter 22, Philadelphia: Lindsay & Blakiston, pp. 179-180,\nHe wears his hat a little a one side, rakish-like, whaps his cane down ag’in the pavement hard, as if he intended to keep things in their place, swaggers a few, as if he though he had a right to look big […]"
                            },
                            {
                                "example_id": "723e3caf-b60f-46dd-a989-941630a2047e",
                                "sense_id": "6b2262bd-2af4-351d-ad3c-474d6b80a115",
                                "text": "TO WHAP OVER. To turn over. (New England.)"
                            },
                            {
                                "example_id": "8ba49990-b682-4a33-8b6f-57f416f1b674",
                                "sense_id": "6b2262bd-2af4-351d-ad3c-474d6b80a115",
                                "text": "And at last, as they wrestled and whapped together, they fell headlong in the stream."
                            },
                            {
                                "example_id": "1838c20c-be05-4df8-9acf-e13ae1f1e38c",
                                "sense_id": "6b2262bd-2af4-351d-ad3c-474d6b80a115",
                                "text": "Screen doors whapped throughout the night […]"
                            },
                            {
                                "example_id": "e5b434e6-d5a7-431a-ada3-0b070567962c",
                                "sense_id": "6b2262bd-2af4-351d-ad3c-474d6b80a115",
                                "text": "She whapped down on the floor."
                            },
                            {
                                "example_id": "c108f8bb-ad88-45ec-a25b-5b8cc344b9ca",
                                "sense_id": "6b2262bd-2af4-351d-ad3c-474d6b80a115",
                                "text": "The fish whapped over."
                            }
                        ]
                    }
                ],
