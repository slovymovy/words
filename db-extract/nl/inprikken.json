                                                "sense_id": "623e3a93-84f5-3efc-a739-278838e8a4ea",
                                                "text": "I'm going to the bank to put in for a transfer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f370b50e-0c74-325c-9965-0b80da6571a1",
                                        "entry_id": "68773aaf-c390-3fb3-b4ec-76d8d5e27805",
                                        "glosses": [
                                            "To contribute."
