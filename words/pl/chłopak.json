                                "target_lang_word": "Junge",
                                "target_lang_sense_clarification": "junger Mann (umgangssprachlich)"
                            },
                            {
                                "target_lang_word": "Bursche",
                                "target_lang_sense_clarification": "junger Mann"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f32540c9-1492-3433-a1a0-26cb8d73b4a3",
                    "sense_definition": "Syn, używane potocznie przez rodziców w odniesieniu do męskiego potomka.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moi <w>chłopacy</w> wrócili już ze szkoły i odrabiają lekcje.",
                            "target_lang_translations": {
                                "ru": "Мои <w>мальчики</w> уже вернулись из школы и делают уроки.",
                                "de": "Meine <w>Jungs</w> sind schon aus der Schule zurück und machen ihre Hausaufgaben."
                            }
                        },
                        {
                            "text": "Sąsiedzi mają dwóch <w>chłopaków</w> i jedną córkę.",
                            "target_lang_translations": {
                                "ru": "У соседей двое <w>мальчишек</w> и одна дочь.",
                                "de": "Die Nachbarn haben zwei <w>Söhne</w> und eine Tochter."
                            }
                        }
                    ],
                    "synonyms": [
                        "syn"
                    ],
                    "common_phrases": [
                        "moi chłopacy",
                        "starsi chłopacy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сын; используется родителями в разговорной речи.",
                        "de": "Sohn; wird umgangssprachlich von Eltern für männliche Nachkommen verwendet."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мальчик",
                                "target_lang_sense_clarification": "сын"
                            },
                            {
                                "target_lang_word": "пацан",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "de": [
