{
    "word_family": [
        "strand",
        "stranded"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc4711d1-8a3e-392b-89c4-355a5cf05792",
                    "sense_definition": "present participle and gerund of <w>strand</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action_of_stranding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden storm is <w>stranding</w> many travelers at the airport tonight.",
                            "target_lang_translations": {
                                "ru": "Внезапный шторм <w>оставляет</w> многих путешественников в аэропорту сегодня вечером без возможности уехать."
                            }
                        },
                        {
                            "text": "By <w>stranding</w> the whale on the beach, the tide left it vulnerable to the sun.",
                            "target_lang_translations": {
                                "ru": "<w>Выбросив</w> кита на пляж, отлив оставил его беззащитным перед солнцем."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "причастие настоящего времени и герундий от глагола strand (оставлять в затруднительном положении, выбрасывать на берег)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оставляющий",
                                "target_lang_sense_clarification": "в безвыходном положении"
                            },
                            {
                                "target_lang_word": "выбрасывающий",
                                "target_lang_sense_clarification": "на берег (о море)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0dfdd573-f7be-3e70-84cf-e376945fcc1e",
                    "sense_definition": "The act or occasion of being left helpless or in a difficult position, especially without transport.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action_of_stranding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mass <w>stranding</w> of whales on the coast remains a mystery to scientists.",
                            "target_lang_translations": {
                                "ru": "Массовый <w>выброс</w> китов на побережье остается загадкой для ученых."
                            }
                        },
                        {
                            "text": "The airline apologized for the <w>stranding</w> of passengers after the technical failure.",
                            "target_lang_translations": {
                                "ru": "Авиакомпания извинилась за <w>вынужденную задержку</w> пассажиров после технического сбоя."
                            }
                        }
                    ],
                    "synonyms": [
                        "abandonment",
                        "isolation"
                    ],
                    "antonyms": [
                        "rescue"
                    ],
                    "common_phrases": [
                        "mass stranding",
                        "whale stranding"
                    ],
                    "target_lang_definitions": {
                        "ru": "акт или случай, когда кто-то остается беспомощным или в трудном положении, особенно без транспорта"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выброс на берег",
                                "target_lang_sense_clarification": "о морских животных"
                            },
                            {
                                "target_lang_word": "вынужденная задержка",
                                "target_lang_sense_clarification": "пассажиров из-за отсутствия транспорта"
                            },
                            {
                                "target_lang_word": "оставление",
                                "target_lang_sense_clarification": "в безвыходном положении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6a5b11e-944a-350e-acd4-8f12b3be73fe",
                    "sense_definition": "The linguistic phenomenon of leaving a word, such as a preposition, without its usual following complement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In English, preposition <w>stranding</w> is common in sentences like 'Who are you talking to?'",
                            "target_lang_translations": {
                                "ru": "В английском языке <w>отрыв</w> предлога часто встречается в таких предложениях, как «Who are you talking to?»"
                            }
                        },
                        {
                            "text": "The professor explained that <w>stranding</w> occurs when the object of a preposition is moved.",
                            "target_lang_translations": {
                                "ru": "Профессор объяснил, что <w>стрендинг</w> происходит, когда дополнение предлога перемещается."
                            }
                        }
                    ],
                    "common_phrases": [
                        "preposition stranding"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in linguistics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "лингвистическое явление, при котором слово (например, предлог) остается без последующего дополнения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отрыв",
                                "target_lang_sense_clarification": "предлога от дополнения"
                            },
                            {
                                "target_lang_word": "стрендинг",
                                "target_lang_sense_clarification": "лингвистический термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}