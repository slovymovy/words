                        "source_entry_id": "d4dc9b4f-9e10-3c37-b5f2-f9e007227a0d",
                        "source_sense_description": "раздел педагогики, излагающий теорию и общие законы образования и обучения",
                        "target_lang_word": "Didaktik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Didaktik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ad78e3c-1a05-316b-acf3-fb416fc8e48a",
                                        "entry_id": "4b17b19b-a5ae-3560-8614-b7befd0f807e",
                                        "glosses": [
                                            "Wissenschaft vom Lehren. Sie ergänzt sich mit der Didaktik zur Berufswissenschaft der Lehrer."
                                        ],
                                        "tags": [
                                            "im engeren Sinn"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6d14221-6a25-44d8-b4cd-c5645866d810",
                                                "sense_id": "4ad78e3c-1a05-316b-acf3-fb416fc8e48a",
                                                "text": "Heute ist Didaktik eng mit der Mathetik verbunden, weil man nach modernem Verständnis nichts erfolgreich lehren kann, ohne sich gleichzeitig zu fragen: Wie lernen Schüler?"
                                            },
                                            {
                                                "example_id": "cf1b31a3-c644-4934-9704-23cb34ff7dd8",
                                                "sense_id": "4ad78e3c-1a05-316b-acf3-fb416fc8e48a",
                                                "text": "„Zur Didaktik der Spielerziehung gehört nicht nur die lernende Vermittlung der Spieltechnik und Spieltaktik und die Sicherung eines Spielrahmens, der dem Wesen des Spiels gerecht wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b42df1a8-df68-363e-8930-d7a06a974eac",
                                        "entry_id": "4b17b19b-a5ae-3560-8614-b7befd0f807e",
                                        "glosses": [
                                            "im weiteren (historischen) Sinn: Wissenschaften vom durch Lehre geleiteten Lernen. Unter der Vorgabe von Unterrichtszielen ist sie an der Auswahl der Fachinhalte beteiligt."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a513132b-1ffc-422a-976a-4e665b85afbc",
                        "source_entry_id": "d4dc9b4f-9e10-3c37-b5f2-f9e007227a0d",
                        "source_sense_description": "раздел педагогики, излагающий теорию и общие законы образования и обучения",
