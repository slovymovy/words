                                        "glosses": [
                                            "bouwstof van de eiwitten, een organische verbinding die zowel een carboxylgroep (-COOH) als een aminegroep (-NH₂) bezit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fda8b7a6-06fe-4cf4-8550-66b275ab1872",
                                                "sense_id": "06e1f606-c792-315b-90eb-89ca2bd40b77",
                                                "text": "- Voor het feit dat komeetinslagen nog een toevallig geschenk uit de kosmos meebrachten: de basisbestanddelen voor het leven en voor DNA, zoals ribose, kooldioxide, ethanol, aminozuren en fosfor."
                                            },
                                            {
                                                "example_id": "0266c168-75ff-4f37-bb5b-c8a746b978c6",
                                                "sense_id": "06e1f606-c792-315b-90eb-89ca2bd40b77",
                                                "text": "De preparaten bleken in tegenstelling tot de vermelding op het etiket onzuiver en bestonden uit veel meer aminozuren dan alleen d- of l- glutaminezuur."
                                            }
