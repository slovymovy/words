                "senses": [
                    {
                        "sense_id": "0003540c-e6bd-34e0-93f6-195f674db615",
                        "entry_id": "d5d73eaf-0776-350d-8bd5-94134b307735",
                        "glosses": [
                            "Magistrat romain qui avait inspection sur les édifices publics, sur les jeux, etc."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "17441312-e4cb-4fc5-959d-bc8a19f3ace2",
                                "sense_id": "0003540c-e6bd-34e0-93f6-195f674db615",
                                "text": "Édile curule."
                            },
                            {
                                "example_id": "7956af3e-6a87-4e41-8c79-2868365d4c4b",
                                "sense_id": "0003540c-e6bd-34e0-93f6-195f674db615",
                                "text": "Édile plébéien."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a1e98ac-c23f-3606-b384-3afe8b143d76",
                        "entry_id": "d5d73eaf-0776-350d-8bd5-94134b307735",
                        "glosses": [
                            "Élu municipal des grandes villes contemporaines."
                        ],
                        "tags": [
                            "Administration"
                        ],
                        "examples": [
                            {
                                "example_id": "e7b75f31-fc5e-432b-8111-276b60d3a827",
                                "sense_id": "5a1e98ac-c23f-3606-b384-3afe8b143d76",
                                "text": "L’édile a travaillé avec le maire du 9ᵉ arrondissement, dès 2011, pour essayer de labelliser les « vrais » salons."
                            },
                            {
                                "example_id": "5ce4d32f-7293-4fc7-b742-81ae241b3329",
                                "sense_id": "5a1e98ac-c23f-3606-b384-3afe8b143d76",
                                "text": "Sur la place Abbal, en plus du concepteur Olivier Vichard, on pouvait remarquer la présence de Jean-Luc Moudenc, le premier édile de Toulouse, et Gaëtan Cognard, maire du quartier de la Reynerie."
                            },
                            {
                                "example_id": "91a1f968-31fa-42fc-8076-9a70e4c2b888",
                                "sense_id": "5a1e98ac-c23f-3606-b384-3afe8b143d76",
                                "text": "Nos édiles se doutent-ils seulement que certains quartiers de Paris, notamment les boulevards extérieurs, sont aussi dangereux pour le promeneur qui s’y aventure, que la Prairie l’est pour le voyageur blanc ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c138985-41bd-4c13-924d-149cceb57f28",
                        "source_entry_id": "d5d73eaf-0776-350d-8bd5-94134b307735",
                        "source_sense_id": "0003540c-e6bd-34e0-93f6-195f674db615",
