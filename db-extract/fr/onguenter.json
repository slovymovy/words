                "senses": [
                    {
                        "sense_id": "04410eb0-780c-3c06-9e1a-0fedb9a00db7",
                        "entry_id": "264bc45a-c6f4-3a95-9bb0-15b487c2faab",
                        "glosses": [
                            "Enduire avec un onguent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7e3d5ff-290a-4fed-8d8a-9abb4b5a7dee",
                                "sense_id": "04410eb0-780c-3c06-9e1a-0fedb9a00db7",
                                "text": "Mandé, il est venu en hâte, mais mis au courant et introduit dans le cachot, il s’est borné à onguenter avec zèle les plaies du captif."
                            },
                            {
                                "example_id": "b2b6133a-7985-4526-ba35-2193ace2852f",
                                "sense_id": "04410eb0-780c-3c06-9e1a-0fedb9a00db7",
                                "text": "À l’église, poursuit-il, c’est la marraine qui tient le bébé pendant que le curé le sale et l’onguente."
                            }
                        ]
                    }
