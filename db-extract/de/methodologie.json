                    }
                ],
                "senses": [
                    {
                        "sense_id": "de8d2660-d165-35a2-a311-e5dadd7c7b94",
                        "entry_id": "cc44d547-7304-3663-8198-f6a1025fdb11",
                        "glosses": [
                            "Lehre von den wissenschaftlichen Methoden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09fe61dc-d5e7-499d-8dd7-de70c24c6c2c",
                                "sense_id": "de8d2660-d165-35a2-a311-e5dadd7c7b94",
                                "text": "Methodologie ist demnach eine Metawissenschaft und somit eine Teildisziplin der Wissenschaftstheorie."
                            },
                            {
                                "example_id": "a11df358-ce89-460f-99f4-99ecbaf7eb0e",
                                "sense_id": "de8d2660-d165-35a2-a311-e5dadd7c7b94",
                                "text": "„Dieser enthält nämlich darüber hinaus ein ausführliches Vorwort zur Methodologie der Kantforschung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d411525d-b509-4180-b33f-fa7daca82346",
                        "source_entry_id": "cc44d547-7304-3663-8198-f6a1025fdb11",
                        "source_sense_id": "de8d2660-d165-35a2-a311-e5dadd7c7b94",
                        "source_sense_description": "Lehre von den wissenschaftlichen Methoden",
                        "target_lang_word": "methodology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "methodology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0bfcc1b7-5ff5-36e4-a20d-c3d58d1ae523",
                                        "entry_id": "bc0fe972-86e6-348d-84eb-5cca3c20116c",
                                        "glosses": [
                                            "The study of methods used in a field."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63baaf76-6a7c-4e43-9d49-fe48e73a72e7",
                                                "sense_id": "0bfcc1b7-5ff5-36e4-a20d-c3d58d1ae523",
                                                "text": "research methodology"
                                            },
                                            {
                                                "example_id": "e30f4acb-05af-4f15-8523-6d4480607117",
                                                "sense_id": "0bfcc1b7-5ff5-36e4-a20d-c3d58d1ae523",
                                                "text": "In doing so it will describe two metatheories of scientific thought regarding the nature of methodology and epistemology in social science."
                                            },
                                            {
                                                "example_id": "0c803f03-3bf7-4538-b7f4-e2488cee9de0",
                                                "sense_id": "0bfcc1b7-5ff5-36e4-a20d-c3d58d1ae523",
                                                "text": "This volume is an addition to the rapidly growing area of interest in research methodology: the study of mixed method and mixed model studies."
                                            },
                                            {
                                                "example_id": "1d3ab605-cfd7-4868-b24a-290dc3de5d74",
                                                "sense_id": "0bfcc1b7-5ff5-36e4-a20d-c3d58d1ae523",
                                                "text": "To explore effective pedagogies to motivate these bilingual doctoral researchers to theorise translingually, this paper draws upon methodologies about translingualism and intercultural doctoral education to dispel the recurrent doubts raised by these bilingual doctoral researchers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eaa7472d-fd1b-3cf9-ae54-982d63fc8c5e",
                                        "entry_id": "bc0fe972-86e6-348d-84eb-5cca3c20116c",
                                        "glosses": [
                                            "A collection of methods, practices, procedures and rules used by those who work in some field."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd92c8aa-5ebe-4048-9ee3-928d708650d5",
                                                "sense_id": "eaa7472d-fd1b-3cf9-ae54-982d63fc8c5e",
                                                "text": "agile methodology"
                                            },
                                            {
                                                "example_id": "d89e4a19-c249-4fd8-80fb-89f8a75d336f",
                                                "sense_id": "eaa7472d-fd1b-3cf9-ae54-982d63fc8c5e",
                                                "text": "For example, an agile methodology should promote the frequent delivery of working systems rather than a single big bang delivery."
                                            },
                                            {
                                                "example_id": "d5660027-868e-431e-8ebe-9382d9b822f6",
                                                "sense_id": "eaa7472d-fd1b-3cf9-ae54-982d63fc8c5e",
                                                "text": "Design Methodology is understood as a concrete course of action for the design of technical systems that derives its knowledge from design science and cognitive psychology, and from practical experience in different domains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b66c9d25-f1ac-3465-8893-ee7a05456b84",
                                        "entry_id": "bc0fe972-86e6-348d-84eb-5cca3c20116c",
                                        "glosses": [
                                            "The implementation of such methods etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "893e8c7c-0c4b-4072-8b99-cea9a3658fb5",
                        "source_entry_id": "cc44d547-7304-3663-8198-f6a1025fdb11",
                        "source_sense_id": "de8d2660-d165-35a2-a311-e5dadd7c7b94",
                        "source_sense_description": "Lehre von den wissenschaftlichen Methoden",
                        "target_lang_word": "méthodologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "méthodologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "903d8976-bf10-3e9c-8999-3eb7dc4e4bea",
                                        "entry_id": "284dff76-f676-3ee3-aa01-9284fd05b43e",
                                        "glosses": [
                                            "Science de la méthode en général ou des méthodes particulières de diverses sciences."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36972e4b-5c97-4ecd-aea3-a971dd8e6548",
                                                "sense_id": "903d8976-bf10-3e9c-8999-3eb7dc4e4bea",
                                                "text": "La méthodologie est une partie de la logique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89872c2e-c1cf-38b6-8c84-c7e48744921e",
                                        "entry_id": "284dff76-f676-3ee3-aa01-9284fd05b43e",
                                        "glosses": [
                                            "Ensemble de règles concernant les méthodes à utiliser."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57f69093-c58e-40c3-bc3c-2b6c645c660d",
                                                "sense_id": "89872c2e-c1cf-38b6-8c84-c7e48744921e",
                                                "text": "Cet opuscule n'a la prétention ni d'être original, […]. C'est avant tout aux paysans qu'il s'adresse, mais aussi au grand public qui désire connaître la méthodologie mitchourinienne à propos de cas précis."
                                            },
                                            {
                                                "example_id": "2c96bff4-c50b-4ad1-bcb7-acba093befa3",
                                                "sense_id": "89872c2e-c1cf-38b6-8c84-c7e48744921e",
                                                "text": "Ce projet, mes camarades, je vous propose de parler de sa méthodologie et de son calendrier dans les mois qui viennent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27fa08a7-ba18-3f03-bb5b-ed81ea29dfb8",
                                        "entry_id": "284dff76-f676-3ee3-aa01-9284fd05b43e",
                                        "glosses": [
                                            "Démarche, méthode suivie ; manière de faire, de procéder."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
