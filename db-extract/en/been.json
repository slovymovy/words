                            "past"
                        ],
                        "examples": [
                            {
                                "example_id": "968140bc-02ae-4ad2-83a2-737dc996c2d0",
                                "sense_id": "96e8aad6-2bbf-35d6-94f3-cd0e7e5df557",
                                "text": "All the fries have been eaten."
                            },
                            {
                                "example_id": "65d92117-360a-4c3f-a3ca-46d8137ab22d",
                                "sense_id": "96e8aad6-2bbf-35d6-94f3-cd0e7e5df557",
                                "text": "Postman been?"
                            },
                            {
                                "example_id": "2e1138d5-8fce-4768-822f-f987b6ae8462",
                                "sense_id": "96e8aad6-2bbf-35d6-94f3-cd0e7e5df557",
                                "text": "They been here since yesterday. (dialectal, e.g. AAVE, omitting have)"
                            }
                        ]
                    },
                    {
                        "sense_id": "16aae7aa-5a2d-3f9c-8844-a7e0b47d9ef0",
                        "entry_id": "def27045-7476-348d-a23e-5c937c0d5f1b",
                        "glosses": [
                            "remote past form of be."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "780cd09c-57d7-4d24-96d0-597b508ad03d",
                                "sense_id": "16aae7aa-5a2d-3f9c-8844-a7e0b47d9ef0",
                                "text": "He been had that job."
                            },
                            {
                                "example_id": "e33644f3-cdaa-42e1-aedd-09327253f647",
                                "sense_id": "16aae7aa-5a2d-3f9c-8844-a7e0b47d9ef0",
                                "text": "We been knew they was doing this."
                            },
                            {
                                "example_id": "3e4a9b85-9ee6-41e2-ae7c-b50480b7acca",
                                "sense_id": "16aae7aa-5a2d-3f9c-8844-a7e0b47d9ef0",
                                "text": "She was disloyal, Casper was disloyal, so them muthafuckas gotta go. Like you said[,] we been knew we was going to have to kill Frost, so let's do it and Light too.” Star said. “Say no more. I'ma handle Kisha myself.” Max said walking to the door."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "3233f113-33d1-3482-b0f4-84dc4a5b13a6",
                "word": "been",
                "pos": "verb",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "473f925a-83e1-3827-904f-70a3386755b9",
                        "entry_id": "3233f113-33d1-3482-b0f4-84dc4a5b13a6",
                        "glosses": [
                            "Synonym of be (infinitival sense)."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "83caf2af-4b2e-4535-ac8e-132fd52af3b5",
                                "sense_id": "473f925a-83e1-3827-904f-70a3386755b9",
                                "text": "It useta been five foot long."
                            },
                            {
                                "example_id": "b5cf9deb-bd9e-4a55-a3de-7067fd4fd212",
                                "sense_id": "473f925a-83e1-3827-904f-70a3386755b9",
                                "text": "\"Bones\", says he, \"I tink dey's a-goin' to been a war ober de Alabamy question[…]"
                            },
                            {
                                "example_id": "b19dba6f-872b-4a3b-a1e9-c05316043106",
                                "sense_id": "473f925a-83e1-3827-904f-70a3386755b9",
                                "text": "Yur a boald 'un to tell the missus theer to hur feeace as how ya wur 'tossicatit whan ya owt to been duing yur larful business."
                            },
                            {
                                "example_id": "32ca5869-b803-42d1-9739-249de740a172",
                                "sense_id": "473f925a-83e1-3827-904f-70a3386755b9",
                                "text": "[…]But one time it use' to been so cold right first of the winter."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "1e9b301d-4bc8-460c-a07d-e246838dc8fa",
                        "source_entry_id": "3233f113-33d1-3482-b0f4-84dc4a5b13a6",
