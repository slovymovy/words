    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5b4ac664-efba-389f-bade-8e04974cbbd0",
                "word": "boutonniere",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "20bfe7af-45c4-494b-9239-1b2410675b9e",
                        "entry_id": "5b4ac664-efba-389f-bade-8e04974cbbd0",
                        "tags": [
                            "plural"
                        ],
                        "form": "boutonnieres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dd1521d7-6dde-3fbc-8552-c981de3341a0",
                        "entry_id": "5b4ac664-efba-389f-bade-8e04974cbbd0",
                        "glosses": [
                            "A small flower or bunch of flowers worn in a buttonhole or pinned to the lapel of a jacket."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7500f06d-0575-431e-aa56-22402cd890be",
                                "sense_id": "dd1521d7-6dde-3fbc-8552-c981de3341a0",
                                "text": "The rare white \"Heliotrope\" whose flower can can be worn as a boutanniere ^([sic]) and whose scent can be discreetly sprinkled on hankerchieves."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2570c70-0404-4306-900a-e41bc0aaab76",
                        "source_entry_id": "5b4ac664-efba-389f-bade-8e04974cbbd0",
                        "source_sense_id": "dd1521d7-6dde-3fbc-8552-c981de3341a0",
                        "source_sense_description": "flower worn in buttonhole",
                        "target_lang_word": "boutonnière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boutonnière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "568a4f6e-3b12-36e4-aff8-e981d1d177e8",
                                        "entry_id": "3331f0eb-1f94-3eee-8cab-1dcfec848a6b",
                                        "glosses": [
                                            "Petite fente faite à un vêtement pour y passer un bouton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c740e9d7-9582-4793-b52c-c31e3fe55bb8",
                                                "sense_id": "568a4f6e-3b12-36e4-aff8-e981d1d177e8",
                                                "text": "Tartous Hama, en smoking d’ottoman blanc, une rose desséchée à sa boutonnière, pieds et poings liés, le visage convulsé et bleu, les yeux exorbités."
                                            },
                                            {
                                                "example_id": "a43b62db-cd14-44be-9bc9-020c201e2899",
                                                "sense_id": "568a4f6e-3b12-36e4-aff8-e981d1d177e8",
                                                "text": "Orlando se tenait devant son miroir, cherchant à tâtons les boutonnières de sa chemise. Encore une fois, les perles venaient de lui glisser des doigts et étaient tombées par terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d16fc28-2a35-3a5d-a1f4-ecaa900ba469",
                                        "entry_id": "3331f0eb-1f94-3eee-8cab-1dcfec848a6b",
                                        "glosses": [
                                            "Petite fente sur le col gauche d'un costume par laquelle on attache les décorations civiles ou militaires, une fleur ou un bijou."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc512c03-53ea-471e-85f4-5d990859eeda",
                                                "sense_id": "8d16fc28-2a35-3a5d-a1f4-ecaa900ba469",
                                                "text": "Les mâles éclairs de ses yeux bleus, la bravoure inscrite dans les rides de ses joues flétries, annonçaient qu'il avait acheté par de rudes travaux le ruban rouge qui fleurissait la boutonnière de son habit."
                                            },
                                            {
                                                "example_id": "4c042cbc-e297-4e99-88f9-d95084af4aa2",
                                                "sense_id": "8d16fc28-2a35-3a5d-a1f4-ecaa900ba469",
                                                "text": "Les Palmes académiques, dont le Quatorze Juillet va fleurir tant de boutonnières, m'ont laissé toute une suite d'impressions désastreuses."
                                            },
                                            {
                                                "example_id": "70ce5761-5857-4e2e-a98c-a947aab6f4eb",
                                                "sense_id": "8d16fc28-2a35-3a5d-a1f4-ecaa900ba469",
                                                "text": "Les vieux ramollots du temps jadis, ces vétérans des guerres d'Italie et de Crimée qui promenaient leurs redingotes sanglées à la taille et épinglées de rouge à la boutonnière sous les ombrages du Champ-de-Juillet en regardant manœuvrer les jeunes recrues, […]."
                                            },
                                            {
                                                "example_id": "c5439653-43af-44ac-b0b5-4da2c7d54da5",
                                                "sense_id": "8d16fc28-2a35-3a5d-a1f4-ecaa900ba469",
                                                "text": "[…]; une véritable épidémie de petits drapeaux et d’insignes pour boutonnières s’abattit sur les torrents de jeunesse laborieuse et pressée […]. Il était dangereux de ne pas avoir d’insignes patriotiques au revers de l’habit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c3b2bbe-9a5e-3fcf-8723-2cfcea2a4fba",
                                        "entry_id": "3331f0eb-1f94-3eee-8cab-1dcfec848a6b",
                                        "glosses": [
                                            "Incision."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "969605f1-5d78-39d0-8fe7-6f3a3f018b67",
                                        "entry_id": "3331f0eb-1f94-3eee-8cab-1dcfec848a6b",
                                        "glosses": [
                                            "Dépression creusée par érosion dans l'axe d'un anticlinal. Ce sont deux cuestas qui se font face."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b99c6e0e-c373-45e7-a027-3b3920912633",
                                                "sense_id": "969605f1-5d78-39d0-8fe7-6f3a3f018b67",
                                                "text": "Les goûts de ma mère étaient plus futiles. Elle mourait d’envie d’aller voir un puits artésien dans la région du Nord et cette fameuse boutonnière du pays de Bray qui lui suggérait cette idée amusante : peut-être que dame Nature avait besoin, comme tout le monde, de coutures et de boutons pour ajuster sa verte parure de prairies et de guérets ?"
                                            },
                                            {
                                                "example_id": "d991e460-b397-4c69-9ff5-5e702da92991",
                                                "sense_id": "969605f1-5d78-39d0-8fe7-6f3a3f018b67",
                                                "text": "Auneuil est un village situé sur le rebord sud de la boutonnière du pays de Bray, où la structure géologique a permis l’affleurement de couches d’argile de grande qualité."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boutonnière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25ca6131-4261-3762-a219-43fca3a5a5a4",
                                        "entry_id": "abc30132-6426-3f1c-ac6b-32ec492d3e17",
                                        "glosses": [
                                            "Artisane ou ouvrière qui fait des boutons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a872b2f6-e165-4f1f-8c05-0eacadfd0295",
                                                "sense_id": "25ca6131-4261-3762-a219-43fca3a5a5a4",
                                                "text": "Les femmes sont également cirières et employées aux diverses manipulations qui aboutissent à la fabrication de cire à cacheter, boutonnières, employées à la vente des bouchons, émailleuses et ouvrières pour perles fausses ; l’industrie des fleurs artificielles en occupe un très grand nombre."
                                            },
                                            {
                                                "example_id": "5d081da5-449e-4234-a7fc-40cfa8789b02",
                                                "sense_id": "25ca6131-4261-3762-a219-43fca3a5a5a4",
                                                "text": "À en juger par l’état de ses finances à la fin de sa vie, la veuve Mangin n’avait pas connu un grand succès en tant que maîtresse passementière et boutonnière, même si elle vivait encore dans son propre logement à sa mort."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
