                                "target_senses": [
                                    {
                                        "sense_id": "2783a292-1878-3364-8970-4d9e5f2d89dc",
                                        "entry_id": "911f312a-df9c-37b1-99a2-fe440b232145",
                                        "glosses": [
                                            "Espèce de petit oiseau passereau de l’Ancien Monde, le plus grand des bruants d’Europe, le dessus est brun grisâtre ou roussâtre rayé de brun noir, le dessous blanc tacheté et rayé de brun noir et de noir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48e44b79-c07f-4764-87f1-0d4c30704ad7",
                                                "sense_id": "2783a292-1878-3364-8970-4d9e5f2d89dc",
                                                "text": "Le bruant proyer (Emberiza calandra) est un gros bruant qui est souvent observé dans les zones de cultures et les friches où il est un nicheur localement abondant."
                                            },
                                            {
                                                "example_id": "305aef08-9cf4-4a18-b86c-bc739f4c93f2",
                                                "sense_id": "2783a292-1878-3364-8970-4d9e5f2d89dc",
                                                "text": "À cette saison nichent quantité de fauvettes, bruants proyers et linottes mélodieuses attirés par la végétation arbustive, notamment de tamaris des bords de fossés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
