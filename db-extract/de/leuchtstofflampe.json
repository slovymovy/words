                                    {
                                        "sense_id": "6f366844-a83d-3723-b58d-8e2232d49ba1",
                                        "entry_id": "b181a1f7-c9c3-371b-b06a-866926e301b0",
                                        "glosses": [
                                            "Système d'éclairage, lampe, de forme tubulaire contenant du mercure sous faible pression qui est ionisé par une décharge électrique. Les vapeurs de mercure émettent alors un rayonnement ultra-violet transformé en lumière visible par le revêtement interne du tube."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "145b1673-efcc-47cb-bd7e-ff12f4f0f389",
                                                "sense_id": "6f366844-a83d-3723-b58d-8e2232d49ba1",
                                                "text": "Ce fut le cas, par exemple, de la première observation de bérylliose en 1949, chez une ouvrière employée à la préparation d'un produit destiné à la confection de tubes fluorescents."
                                            },
                                            {
                                                "example_id": "c1528754-3763-44b4-b08a-cecb815e8041",
                                                "sense_id": "6f366844-a83d-3723-b58d-8e2232d49ba1",
                                                "text": "Il est possible de créer de superbes portraits beauté avec pour seul éclairage un simple tube fluorescent."
                                            }
                                        ]
