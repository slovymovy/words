                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To improve your running efficiency, you should try to increase your <w>cadence</w>.",
                            "target_lang_translations": {
                                "ru": "Чтобы повысить эффективность бега, вам следует постараться увеличить свой <w>каденс</w>."
                            }
