                            },
                            {
                                "target_lang_word": "кадрить",
                                "target_lang_sense_clarification": "разг., флиртовать"
                            },
                            {
                                "target_lang_word": "цеплять",
                                "target_lang_sense_clarification": "жарг., знакомиться"
                            },
                            {
                                "target_lang_word": "подцеплять",
                                "target_lang_sense_clarification": "разг., знакомиться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c13e808-a39a-367d-a3e7-92d352e0a853",
                    "sense_definition": "okazywać wielką chęć lub zapał do wykonania jakiejś czynności",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "eagerness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wszyscy nowi pracownicy od samego rana bardzo <w>rwą</w> się do pracy.",
                            "target_lang_translations": {
                                "ru": "Все новые сотрудники с самого утра очень <w>рвутся</w> работать."
                            }
                        },
                        {
                            "text": "Młody żołnierz z niecierpliwością <w>rwał</w> się do walki w pierwszym szeregu.",
                            "target_lang_translations": {
                                "ru": "Молодой солдат с нетерпением <w>рвался</w> в бой на передовой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rwać się do pracy",
                        "rwać się do walki",
                        "rwać się do pomocy"
                    ],
                    "target_lang_definitions": {
                        "ru": "проявлять сильное желание или рвение к какому-либо действию"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рваться",
                                "target_lang_sense_clarification": "к делу, в бой"
                            },
                            {
                                "target_lang_word": "гореть желанием",
                                "target_lang_sense_clarification": "стремиться что-то сделать"
                            },
                            {
                                "target_lang_word": "стремиться",
                                "target_lang_sense_clarification": "с энтузиазмом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fd03d87-5475-36f4-a2a9-40ce3cc379e5",
                    "sense_definition": "ulegać przerwaniu lub podziałowi pod wpływem naprężenia lub szarpania",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stara i przetarta lina nagle <w>rwie</w> się pod ciężarem ładunku.",
                            "target_lang_translations": {
                                "ru": "Старая и перетёртая верёвка внезапно <w>рвётся</w> под тяжестью груза."
                            }
                        },
                        {
                            "text": "Podczas szycia słaba nić bez przerwy <w>rwała</w> się w maszynie krawieckiej.",
                            "target_lang_translations": {
                                "ru": "Во время шитья тонкая нить то и дело <w>рвалась</w> в швейной машинке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rwać się w rękach",
                        "lina rwie się"
                    ],
                    "target_lang_definitions": {
                        "ru": "разрываться, разделяться на части под воздействием натяжения"
                    },
                    "translations": {
                        "ru": [
