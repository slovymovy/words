                ],
                "senses": [
                    {
                        "sense_id": "1b12d58c-442c-3c7d-a722-634b7f1cfe0a",
                        "entry_id": "0c7e02d2-602e-3afa-b99f-064035529bd5",
                        "glosses": [
                            "Compagnie formée à l’origine de cent cosaques, puis de cent cavaliers, avant 1922."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "125d4a21-6a9d-4c50-8402-69c3dd165d45",
                                "sense_id": "1b12d58c-442c-3c7d-a722-634b7f1cfe0a",
                                "text": "Tout en fumant sa petite pipe chinoise qui ne contient guère que trois bouffées de fumée âcre, Boro nous raconte comment il commandait une sotnia de Cosaques sous Annenkof."
                            },
                            {
                                "example_id": "7cc70b45-1ccd-427d-9180-aaf0a23546a4",
                                "sense_id": "1b12d58c-442c-3c7d-a722-634b7f1cfe0a",
                                "text": "Les régiments de cavalerie de la milice, qui se composaient autrefois de cosaques des gouvernements de Tchernigof et de Poltava, seront remplacés par des sotnias de cavalerie formées dans tous les gouvernements de l’empire, à raison d’un cavalier sur cinquante fantassins."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "441b0142-38ba-488b-a31b-f343b411c147",
                        "source_entry_id": "0c7e02d2-602e-3afa-b99f-064035529bd5",
                        "source_sense_id": "1b12d58c-442c-3c7d-a722-634b7f1cfe0a",
                        "target_lang_word": "sotnia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sotnia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3606fcc3-a7c6-38c4-871c-e610620a5bbf",
                                        "entry_id": "d2430743-2a61-3138-a770-9a062549f277",
                                        "glosses": [
                                            "A Russian or Ukrainian army unit of about a hundred soldiers, chiefly with reference to Cossacks."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e58be4a1-625b-4a7f-9643-5acfee59b210",
                                                "sense_id": "3606fcc3-a7c6-38c4-871c-e610620a5bbf",
                                                "text": "On March 27 Mischtschenko marched from Koksan to Chonju, with 2 sotnias out of the 6 as advance guard."
                                            },
                                            {
                                                "example_id": "4c960bff-3952-4fa0-a860-9f5867d64038",
                                                "sense_id": "3606fcc3-a7c6-38c4-871c-e610620a5bbf",
                                                "text": "In the wide plains that lay between the border forests of Russia and Austria, sotnias of Cossacks galloped about, uniformed winds in military order, mounted on the short, nippy horses of their native steppes […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2122344-14e6-4638-ba45-a5c36d2dcfca",
                        "source_entry_id": "0c7e02d2-602e-3afa-b99f-064035529bd5",
                        "source_sense_id": "1b12d58c-442c-3c7d-a722-634b7f1cfe0a",
