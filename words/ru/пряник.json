{
    "word_family": [
        "пряничный",
        "пряность",
        "пряный",
        "пряничник"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e95d8aba-9e37-3258-947b-501c1d9dada8",
                    "sense_definition": "Сладкое мучное кондитерское изделие, выпекаемое обычно с добавлением мёда и пряностей.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "выпечка",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "К вечернему чаю бабушка всегда покупала свежий тульский <w>пряник</w> с начинкой.",
                            "target_lang_translations": {
                                "de": "Zum Abendtee kaufte die Großmutter immer einen frischen Tulaer <w>Lebkuchen</w> mit Füllung."
                            }
                        },
                        {
                            "text": "Дети с удовольствием раскрашивали имбирные <w>пряники</w> разноцветной глазурью перед праздником.",
                            "target_lang_translations": {
                                "de": "Vor dem Fest bemalten die Kinder mit Freude die <w>Ingwerlebkuchen</w> mit bunter Glasur."
                            }
                        }
                    ],
                    "common_phrases": [
                        "тульский пряник",
                        "имбирный пряник",
                        "медовый пряник"
                    ],
                    "target_lang_definitions": {
                        "de": "Süßes Gebäck, das traditionell mit Honig und Gewürzen zubereitet wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Lebkuchen",
                                "target_lang_sense_clarification": "traditionelles Gewürzgebäck"
                            },
                            {
                                "target_lang_word": "Pfefferkuchen",
                                "target_lang_sense_clarification": "regionale Bezeichnung für Lebkuchen"
                            },
                            {
                                "target_lang_word": "Honigkuchen",
                                "target_lang_sense_clarification": "Lebkuchen auf Honigbasis"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "daf7b759-ea97-3dd4-bdd2-96e6e68d5689",
                    "sense_definition": "Поощрение, награда или привлекательное обещание как способ воздействия на кого-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "поощрение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Руководитель умело сочетал метод кнута и <w>пряника</w> в управлении своими подчинёнными.",
                            "target_lang_translations": {
                                "de": "Der Vorgesetzte wandte bei der Führung seiner Untergebenen geschickt die Methode von Peitsche und <w>Zuckerbrot</w> an."
                            }
                        },
                        {
                            "text": "Никакие заманчивые <w>пряники</w> не могли убедить специалиста остаться в этой компании.",
                            "target_lang_translations": {
                                "de": "Keine verlockenden <w>Zuckerbrote</w> konnten den Spezialisten überzeugen, in diesem Unternehmen zu bleiben."
                            }
                        }
                    ],
                    "synonyms": [
                        "награда",
                        "поощрение"
                    ],
                    "antonyms": [
                        "кнут"
                    ],
                    "common_phrases": [
                        "кнут и пряник",
                        "политика кнута и пряника",
                        "метод кнута и пряника"
                    ],
                    "target_lang_definitions": {
                        "de": "Belohnung, Anreiz oder Versprechen als Mittel zur Einflussnahme oder Motivation."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Zuckerbrot",
                                "target_lang_sense_clarification": "im übertragenen Sinne, besonders in der Redewendung „Zuckerbrot und Peitsche“"
                            },
                            {
                                "target_lang_word": "Belohnung",
                                "target_lang_sense_clarification": "Anreiz, Vergünstigung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57a54a96-fd6d-37d8-b582-8192ca391551",
                    "sense_definition": "Участок дороги со срезанным перед ремонтом верхним слоем асфальта.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "дорога",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Водители снижали скорость и осторожно объезжали глубокие колодцы на свежем <w>прянике</w>.",
                            "target_lang_translations": {
                                "de": "Die Autofahrer drosselten das Tempo und umfuhren vorsichtig tiefe Schächte auf der frisch <w>abgefrästen Fahrbahn</w>."
                            }
                        },
                        {
                            "text": "На соседней улице новый асфальт ещё не положили, машины медленно едут по <w>прянику</w>.",
                            "target_lang_translations": {
                                "de": "In der Nachbarstraße wurde der neue Asphalt noch nicht aufgetragen, die Autos fahren langsam über die <w>Fräsfläche</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "жаргон автомобилистов и дорожников"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Straßenabschnitt, von dem vor einer Reparatur die oberste Asphaltschicht abgefräst wurde."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "abgefräster Asphalt",
                                "target_lang_sense_clarification": "Jargon für abgefräste Fahrbahndecke"
                            },
                            {
                                "target_lang_word": "Fräsfläche",
                                "target_lang_sense_clarification": "Straßenabschnitt nach dem Kaltfräsen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}