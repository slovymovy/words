                                    },
                                    {
                                        "sense_id": "4b93c51c-aa40-358e-9ec0-9399a1abdd9e",
                                        "entry_id": "c01d4411-54c2-34c3-9907-9cee4ece39fc",
                                        "glosses": [
                                            "A stand used to hold notes when speaking publicly."
                                        ],
