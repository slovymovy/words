                    "sense_definition": "Rendre une voix ou un son plus feutré, plus mélodieux ou moins agressif pour l'oreille.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "son",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a baissé d'un cran la musique pour <w>adoucir</w> le fond sonore.",
                            "target_lang_translations": {
                                "en": "She turned the music down a notch to <w>soften</w> the background noise.",
                                "ru": "Она немного убавила музыку, чтобы <w>приглушить</w> фоновый шум.",
                                "de": "Sie hat die Musik ein Stück leiser gestellt, um das Hintergrundgeräusch zu <w>dämpfen</w>.",
                                "es": "Bajó un poco la música para <w>amortiguar</w> el ruido de fondo.",
                                "zh": "她把音乐调低了一格，以<w>减弱</w>背景噪音。"
                            }
                        },
                        {
                            "text": "Le professeur <w>adoucit</w> sa voix pour rassurer l'enfant effrayé.",
                            "target_lang_translations": {
                                "en": "The teacher <w>softens</w> their voice to reassure the frightened child.",
                                "ru": "Учитель <w>смягчает</w> голос, чтобы успокоить испуганного ребёнка.",
                                "de": "Der Lehrer <w>dämpft</w> seine Stimme, um das verängstigte Kind zu beruhigen.",
                                "es": "El profesor <w>suaviza</w> su voz para tranquilizar al niño asustado.",
                                "zh": "老师<w>放轻</w>了声音，以安抚受惊的孩子。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "adoucir la voix"
                    ],
                    "target_lang_definitions": {
