                        "sense_id": "cdb4ed0b-241d-3833-89a5-a36b0fc96558",
                        "entry_id": "56dc769b-9b4d-3031-8fbd-0ba75a1df3b6",
                        "glosses": [
                            "Korb, in dem Obst aufbewahrt oder transportiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "106114a2-42e8-4cd7-94ed-1b383b61692e",
                                "sense_id": "cdb4ed0b-241d-3833-89a5-a36b0fc96558",
                                "text": "„Ich beobachte ihn von meinem Platz hinter den Obstkörben aus, in denen sich nur Wassermelonen von der Größe kleiner Bomben befinden.“"
                            },
                            {
                                "example_id": "ed631544-51e0-4869-825c-3d63812c4362",
                                "sense_id": "cdb4ed0b-241d-3833-89a5-a36b0fc96558",
                                "text": "„Dann tranken sie Whisky, den der Besucher in einem Obstkorb eingeschmuggelt hatte, und stritten sich höflich über die Kriegsaussichten der beiden Parteien, wobei sie sogar Karten von den Kriegsgebieten zu Hilfe nahmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
