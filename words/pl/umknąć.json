{
    "word_family": [
        "umykać",
        "umknięcie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c8feb705-7bab-37c6-b6bf-b04374de9857",
                    "sense_definition": "szybko oddalić się z jakiegoś miejsca, uciec przed kimś lub czymś",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ucieczka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Złodziej <w>umknął</w> policji, przeskakując przez wysoki płot w ciemnej uliczce.",
                            "target_lang_translations": {
                                "ru": "Вор <w>ускользнул</w> от полиции, перепрыгнув через высокий забор в темном переулке."
                            }
                        },
                        {
                            "text": "Większość ludzi <w>umknęła</w> z płonącego budynku, zanim przyjechała straż pożarna.",
                            "target_lang_translations": {
                                "ru": "Большинство людей <w>сбежало</w> из горящего здания до приезда пожарных."
                            }
                        }
                    ],
                    "synonyms": [
                        "uciec",
                        "czmychnąć",
                        "zwiać"
                    ],
                    "common_phrases": [
                        "umknąć przed kimś",
                        "umknąć z miejsca"
                    ],
                    "target_lang_definitions": {
                        "ru": "быстро удалиться с какого-либо места, убежать от кого-то или чего-то"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ускользнуть",
                                "target_lang_sense_clarification": "быстро и незаметно скрыться"
                            },
                            {
                                "target_lang_word": "сбежать",
                                "target_lang_sense_clarification": "поспешно покинуть место"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd8e2959-9907-30e2-9e0f-56bf21ad70f8",
                    "sense_definition": "uniknąć zauważenia, wymknąć się czyjejś uwadze lub kontroli",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unikanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten szczegół <w>umknął</w> mojej uwadze podczas czytania długiego raportu.",
                            "target_lang_translations": {
                                "ru": "Эта деталь <w>ускользнула</w> от моего внимания во время чтения длинного отчета."
                            }
                        },
                        {
                            "text": "Wszystkie ważne informacje <w>umknęły</w> uwadze komisji podczas przesłuchania świadków.",
                            "target_lang_translations": {
                                "ru": "Вся важная информация <w>ускользнула</w> от внимания комиссии во время допроса свидетелей."
                            }
                        }
                    ],
                    "synonyms": [
                        "wymknąć się",
                        "przeoczyć"
                    ],
                    "common_phrases": [
                        "umknąć uwadze"
                    ],
                    "target_lang_definitions": {
                        "ru": "избежать внимания, остаться незамеченным, выскользнуть из-под контроля"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ускользнуть",
                                "target_lang_sense_clarification": "остаться незамеченным"
                            },
                            {
                                "target_lang_word": "упустить из виду",
                                "target_lang_sense_clarification": "не заметить чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6508005c-7667-33dd-8104-c6077d821ac4",
                    "sense_definition": "szybko minąć, przeminąć w czasie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "czas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wakacje <w>umknęły</w> tak szybko, że nawet nie zdążyłem odpocząć.",
                            "target_lang_translations": {
                                "ru": "Каникулы <w>пролетели</w> так быстро, что я даже не успел отдохнуть."
                            }
                        },
                        {
                            "text": "Lata młodości <w>umknęły</w> mu niepostrzeżenie podczas ciężkiej pracy w biurze.",
                            "target_lang_translations": {
                                "ru": "Годы молодости <w>промелькнули</w> для него незаметно во время тяжелой работы в офисе."
                            }
                        }
                    ],
                    "synonyms": [
                        "upłynąć",
                        "przeminąć"
                    ],
                    "common_phrases": [
                        "czas umknął"
                    ],
                    "target_lang_definitions": {
                        "ru": "быстро пройти, пролететь во времени"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пролететь",
                                "target_lang_sense_clarification": "очень быстро пройти (о времени)"
                            },
                            {
                                "target_lang_word": "промелькнуть",
                                "target_lang_sense_clarification": "быстро пройти, оставив лишь мимолетное впечатление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6979e5f6-d4f4-3c82-aab5-1b43bd1945b9",
                    "sense_definition": "aspekt dokonany od czasownika <w>umykać</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ucieczka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Większość <w>umknęła</w> sekretnymi korytarzami podziemnymi, których trasę poznaliśmy po kilku dniach.",
                            "target_lang_translations": {
                                "ru": "Большинство <w>ускользнуло</w> по секретным подземным коридорам, маршрут которых мы узнали спустя несколько дней."
                            }
                        },
                        {
                            "text": "Zanim zdążyłem zareagować, przestępca <w>umknął</w> w stronę lasu.",
                            "target_lang_translations": {
                                "ru": "Прежде чем я успел среагировать, преступник <w>ускользнул</w> в сторону леса."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "aspekt dokonany"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "совершенный вид глагола umykać"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ускользнуть",
                                "target_lang_sense_clarification": "совершенный вид, действие завершено"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}