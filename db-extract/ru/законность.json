                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccdbd77e-e85f-43be-8e90-d37f81db283d",
                        "source_entry_id": "5439590d-1bce-3f8c-b2b3-70161b391f81",
                        "target_lang_word": "legality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "legality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd10db51-c53c-342b-a0ac-293d1169d279",
                                        "entry_id": "d84ffaaf-9674-3899-b4cb-7ab86d5b6b16",
                                        "glosses": [
                                            "Lawfulness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2782a73e-f692-4b50-9690-b154a53710aa",
                                                "sense_id": "dd10db51-c53c-342b-a0ac-293d1169d279",
                                                "text": "Brought from all the recesses of the coast in all the legality of time contracts, lost in uncongenial surroundings, fed on unfamiliar food, they sickened, became inefficient, and were then allowed to crawl away and rest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf6a75b6-c955-3299-bc09-347e45526196",
                                        "entry_id": "d84ffaaf-9674-3899-b4cb-7ab86d5b6b16",
                                        "glosses": [
                                            "A dice game; the same as chuck-a-luck."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14fad29f-9c72-4214-8e3f-f23e46c692f7",
                                                "sense_id": "bf6a75b6-c955-3299-bc09-347e45526196",
                                                "text": "There was one game in particular called “legality,” in which the managers of the establishment played against all comers. It was a game in which six numbers were marked upon a board, the players staked upon a number, the keeper of the bank threw against the players, and according to whether they were successful or not in the number they backed, they won or lost."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9987dcbc-aa53-4545-afec-ac8372b11f5e",
                        "source_entry_id": "5439590d-1bce-3f8c-b2b3-70161b391f81",
                        "target_lang_word": "legitimacy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "legitimacy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58e71e95-641f-334c-99ab-e8f9ea927107",
                                        "entry_id": "679fee89-baa9-359c-91ad-c1c1eb73b057",
                                        "glosses": [
                                            "The quality or state of being legitimate or valid; validity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ef5f11f-3f2b-4791-9bd3-713eb1963034",
                                                "sense_id": "58e71e95-641f-334c-99ab-e8f9ea927107",
                                                "text": "The legitimacy based on a revolutionary essence was replaced by legitimacy with an ultranational, ultra-Yugoslav character."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b512e07e-95c1-3946-9698-4ab42f4fd9ed",
                                        "entry_id": "679fee89-baa9-359c-91ad-c1c1eb73b057",
                                        "glosses": [
                                            "The quality or state of being legitimate or valid; validity.",
                                            "Public acceptance of an institution, such as a polity or societal system."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0177e105-988a-4f17-b3a8-95a38c9b40db",
                                                "sense_id": "b512e07e-95c1-3946-9698-4ab42f4fd9ed",
                                                "text": "After decades of inequality and oppression, the regime had lost legitimacy with its own population."
                                            },
                                            {
                                                "example_id": "38c2d484-7fbd-4b13-955e-077c2feb3093",
                                                "sense_id": "b512e07e-95c1-3946-9698-4ab42f4fd9ed",
                                                "text": "The fall of the Soviet Union in 1991 was seen by many as proof of capitalism’s legitimacy over communism."
                                            },
                                            {
                                                "example_id": "6911b180-09f5-482f-b06d-d45d9cea0823",
                                                "sense_id": "b512e07e-95c1-3946-9698-4ab42f4fd9ed",
                                                "text": "Democracy’s legitimacy stems from the consent of the governed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc2377d0-86f7-3f20-ab8e-a17dc72aceeb",
                                        "entry_id": "679fee89-baa9-359c-91ad-c1c1eb73b057",
                                        "glosses": [
                                            "Lawfulness of birth or origin; directness of descent as affecting the royal succession."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
