                        ],
                        "examples": [
                            {
                                "example_id": "63f075a2-d340-47c9-8638-f53fc9f7b8e4",
                                "sense_id": "cb5d3783-10d3-36f4-a479-c4e23e94b4d2",
                                "text": "De werkzaamheid van dit medicijn is wetenschappelijk en dubbelblind getest."
                            }
                        ]
                    },
                    {
                        "sense_id": "83363f55-0853-342f-8ed4-7758729b9cfc",
                        "entry_id": "b460eb66-df35-3c5d-a2a9-f8db94c0067c",
