                        "entry_id": "718cab22-6f79-3e66-9897-681c518a1822",
                        "glosses": [
                            "Relatif à Andrew Jackson, le septième président des États-Unis d’Amérique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6faf09e-42b6-4d00-b038-edf276a89183",
                                "sense_id": "2fe5322f-e84a-3683-b2f7-db7d96e9f5a6",
                                "text": "Les États-Unis sont entrés dans une phase jacksonnienne de leur politique étrangère, leurs interventions extérieures n’étant destinées qu’à assurer leur sécurité intérieure, et sans engagements à long terme."
                            }
                        ]
                    },
                    {
                        "sense_id": "06d1b1cf-e52a-38e7-af99-b237f58e0289",
                        "entry_id": "718cab22-6f79-3e66-9897-681c518a1822",
                        "glosses": [
                            "Relatif au musicien Michael Jackson."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2945da97-23ea-3e0e-a298-8aef0b798b24",
                        "entry_id": "718cab22-6f79-3e66-9897-681c518a1822",
                        "glosses": [
                            "Relatif au neurologue Hughlings Jackson."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18b7a917-99eb-41ce-9fc9-f34c041f20fc",
                                "sense_id": "2945da97-23ea-3e0e-a298-8aef0b798b24",
                                "text": "Dans un premier temps nous synthétiserons le modèle scientifique d’inspiration jacksonienne de l’inconscient dont nous avons hérité. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 56)"
                            }
                        ]
                    }
