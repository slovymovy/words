                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "dd02295d-0dd0-4151-8b06-f0740d243447",
                                "sense_id": "043fa308-faf2-31b8-968a-6f1b5a4e9c94",
                                "text": "Je suis le Solstice d’Hiver et faut que je pleuve : c’est mon métier."
                            },
                            {
                                "example_id": "82897bc5-54fa-4577-8e8c-ca30c175847b",
                                "sense_id": "043fa308-faf2-31b8-968a-6f1b5a4e9c94",
                                "text": "« Pour que je pleuve, répondit le ciel, il te faudra arracher l’œil du taureau et le brandir vers moi. Mystère ! »"
                            }
                        ]
                    },
                    {
                        "sense_id": "c30dcbd2-eb6e-3e5e-a195-9468b70dade1",
                        "entry_id": "21168cbf-1e41-338f-83eb-11d177f71736",
                        "glosses": [
                            "Troisième personne du singulier du présent du subjonctif de pleuvoir."
