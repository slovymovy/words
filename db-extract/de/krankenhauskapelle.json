                "senses": [
                    {
                        "sense_id": "f7b6a77b-1d3e-38cd-b189-4916450f5ed0",
                        "entry_id": "e4b09c7f-1dd4-39d8-aca3-4feed04643a9",
                        "glosses": [
                            "einfach gestaltetes Gotteshaus oder abgeteilter Bereich in einem Krankenhaus, der für persönliche Andachten oder auch Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "485a880c-b17e-4b72-87e1-24844fc171d5",
                                "sense_id": "f7b6a77b-1d3e-38cd-b189-4916450f5ed0",
                                "text": "„Die Krankenhauskapelle ist tagsüber für jeden offen, der Ruhe und Besinnung sucht – auch außerhalb der Gottesdienstzeiten.“"
                            },
                            {
                                "example_id": "af19ff4a-f8bc-41f1-8ec9-ce454123c77b",
                                "sense_id": "f7b6a77b-1d3e-38cd-b189-4916450f5ed0",
                                "text": "„Unsere Krankenhauskapelle ist ein Ort der Ruhe im manchmal doch sehr hektischen Krankenhausbetrieb.“"
                            },
                            {
                                "example_id": "7a7a958e-24c2-4441-8150-36d8bb4f7b19",
                                "sense_id": "f7b6a77b-1d3e-38cd-b189-4916450f5ed0",
                                "text": "„Die 1898 im neugotischen Stil errichtete Mutterhauskirche der Vinzentinerinnen wurde 2008 renoviert und steht seit dieser Zeit als Krankenhauskapelle dem Krankenhaus zur Verfügung.“"
                            },
                            {
                                "example_id": "2ab3c335-549d-4126-b6d1-726539a49fb8",
                                "sense_id": "f7b6a77b-1d3e-38cd-b189-4916450f5ed0",
                                "text": "„Als man ihr endlich Bescheid gesagt hatte und sie am Nachmittag im Krankenhaus ankam, lag er schon aufgebahrt in der Krankenhauskapelle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
