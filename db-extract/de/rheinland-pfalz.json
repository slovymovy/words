                    {
                        "sense_id": "eb287199-086c-3e83-adf7-a9d6afe1c60d",
                        "entry_id": "573a4f62-3afe-3931-8795-44bbf398a6fb",
                        "glosses": [
                            "Rhénanie-Palatinat."
                        ],
