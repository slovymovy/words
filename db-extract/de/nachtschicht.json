                        ],
                        "form": "die Nachtschichten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1abfecc9-693c-35a6-9bfb-7c72c9485daa",
                        "entry_id": "9ddbeb4f-def0-38d9-9023-1edb6b91adfc",
                        "glosses": [
                            "Arbeitszeit, Dienst in der Nacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11e5f709-0fb1-4ae7-a2ca-f9d8058c67ff",
                                "sense_id": "1abfecc9-693c-35a6-9bfb-7c72c9485daa",
                                "text": "„Im Hause der Ermordeten wohnten zwei Arbeiter aus der Zuckerfabrik, die Nachtschicht hatten und um zwei Uhr gehen mußten. Die beiden Männer machten sich ihre Laternen zurecht und gingen die Treppe hinunter.“"
                            },
                            {
                                "example_id": "6a5dae9d-b7f4-416d-921d-673a61cf1977",
                                "sense_id": "1abfecc9-693c-35a6-9bfb-7c72c9485daa",
                                "text": "Wie immer musste er einige Nachtschichten einlegen, damit er seine Seminararbeit rechtzeitig abgeben konnte."
                            },
                            {
                                "example_id": "d9c713fa-f0ec-45f9-b8e2-ecbee28b4863",
                                "sense_id": "1abfecc9-693c-35a6-9bfb-7c72c9485daa",
                                "text": "„Am frühen Morgen einer Nachtschicht wurden wir zur Unterstützung von Kollegen zu einem Streit zwischen etwa 30 Südländern angefordert.“"
                            },
                            {
                                "example_id": "3b43d6a5-5b0d-4c0f-babe-b0e608d62fcd",
                                "sense_id": "1abfecc9-693c-35a6-9bfb-7c72c9485daa",
                                "text": "„Dieser wünschte ihm mit mitleidsvollem Blick einen guten Schlaf, denn die Müdigkeit, die eine Nachtschicht mit sich brachte, war deutlich im Gesicht des Kollegen erkennbar.“"
                            },
                            {
                                "example_id": "622e205a-4a32-4adb-b70f-193de9cbdcae",
                                "sense_id": "1abfecc9-693c-35a6-9bfb-7c72c9485daa",
                                "text": "„Im Schmelzwerk verdiente ich viel mehr, als ich in einem Café oder einem Laden bekommen hätte, ich machte so viele Nachtschichten wie nur möglich, das gab richtig viel Geld.“"
                            },
                            {
                                "example_id": "96fb699d-9572-4168-baa0-f800a491491b",
                                "sense_id": "1abfecc9-693c-35a6-9bfb-7c72c9485daa",
                                "text": "„Und Sævar war auf dem Heimweg von der Nachtschicht gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f638e0ee-8f0a-3bf1-bf38-8477bc979fb7",
                        "entry_id": "9ddbeb4f-def0-38d9-9023-1edb6b91adfc",
                        "glosses": [
                            "die Gruppe der Arbeiter in einer Nachtschicht^([1])"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82a44fa6-cfb2-4618-b628-ea661292a5ad",
                                "sense_id": "f638e0ee-8f0a-3bf1-bf38-8477bc979fb7",
                                "text": "Die Nachtschicht hat sich einstimmig für die Teilnahme am Warnstreik ausgesprochen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
