                    "frequency": "Middle",
                    "semantic_group_id": "abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De advocaat gebruikte een <w>kromme</w> redenering om de schuld van zijn cliënt te ontkennen.",
