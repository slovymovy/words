                "senses": [
                    {
                        "sense_id": "5be0595a-09b0-3ee9-a02a-341e0454b52c",
                        "entry_id": "66874c7c-7e81-3909-8aea-f0911ee82011",
                        "glosses": [
                            "Verbaliser (envoyer un procès-verbal aux contrevenants) en utilisant des images vidéo pour détecter les infractions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cd4cf10-072f-4d6e-a8c6-9f4cf2616c56",
                                "sense_id": "5be0595a-09b0-3ee9-a02a-341e0454b52c",
                                "text": "Va-t-on demain les vidéo-verbaliser si, piétons, ils traversent la rue en dehors des clous ?"
                            },
                            {
                                "example_id": "7780e9e8-e8b7-48bc-bc9b-e361986a2735",
                                "sense_id": "5be0595a-09b0-3ee9-a02a-341e0454b52c",
                                "text": "Il faut aussi installer des caméras dans tous les chiots et vidéo-verbaliser tous ceux qui pissent à côté de la lunette !!"
                            },
                            {
                                "example_id": "92c38b9f-4e28-4c9b-8efa-1f1145b9fff6",
                                "sense_id": "5be0595a-09b0-3ee9-a02a-341e0454b52c",
                                "text": "A compter du 2 avril seront installées à Paris des caméras capables de « vidéo-verbaliser » les automobilistes commettant des infractions au code de la route."
                            }
                        ]
                    }
