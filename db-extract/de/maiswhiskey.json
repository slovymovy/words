                "senses": [
                    {
                        "sense_id": "4f0ad4cd-9a12-32bd-a686-4a091259dda5",
                        "entry_id": "78260e08-9213-3765-bedd-e7c12b903138",
                        "glosses": [
                            "aus Mais hergestellter Whiskey"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbb02875-7744-4a99-bad4-0962eb999195",
                                "sense_id": "4f0ad4cd-9a12-32bd-a686-4a091259dda5",
                                "text": "„Und außerdem - der Kesselflicker senkte die Stimme und spähte schlau in die Runde - und außerdem den besten Maiswhiskey, den Sie sich je in die Gurgel gekippt ha'm.“"
                            },
                            {
                                "example_id": "f49698ad-ce28-49a9-90bf-b6be1821c96d",
                                "sense_id": "4f0ad4cd-9a12-32bd-a686-4a091259dda5",
                                "text": "„Sie gaben auf, als sie sahen, wie eine Explosion von Benzin und 93-prozentigem Maiswhiskey den Himmel in einer Entfernung von mehr als einem Kilometer erleuchtete, genau dort, wo Simmie Lee oder der Wagen, den sie fuhr, es nicht geschafft hatte, eine S-Kurve mit 135 Stundenkilometern zu nehmen.“"
                            },
                            {
                                "example_id": "09cfbcdc-9019-4de4-bdc1-1c5a79e13121",
                                "sense_id": "4f0ad4cd-9a12-32bd-a686-4a091259dda5",
                                "text": "„Anschließend wurden die Schlangen gebraten und ein bisschen Maiswhiskey getrunken und das war's dann bis zum nächsten Jahr.“"
                            },
                            {
                                "example_id": "a6b1be1c-a583-4d7c-a530-46670cab3127",
                                "sense_id": "4f0ad4cd-9a12-32bd-a686-4a091259dda5",
                                "text": "„›Büffelbraten und Maiswhiskey sind keine Sünden‹, erklärte Charley Hoge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
