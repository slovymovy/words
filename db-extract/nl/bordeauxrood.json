                            {
                                "example_id": "a4c4110f-4fc4-4d68-a3db-30941a8bb468",
                                "sense_id": "8bb64e08-8e61-3d61-8bbd-a64fd485c83b",
                                "text": "In het midden van de kamer een ovale tafel met zwaar, bordeauxrood trijpen tafelkleed en mahoniehouten stoelen er om heen."
                            },
                            {
                                "example_id": "4d998844-17cc-4a8c-a073-59e43a70d466",
                                "sense_id": "8bb64e08-8e61-3d61-8bbd-a64fd485c83b",
                                "text": "Voor de ramen hing gesloten luxaflex, tegen de rechterwand stond een grijze archiefkast en op de vloer lag een bordeauxrood tapijt."
                            }
                        ]
                    }
