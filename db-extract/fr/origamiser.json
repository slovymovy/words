                "senses": [
                    {
                        "sense_id": "4cd4d0bf-841a-34d3-be4c-c9e3d6449b9d",
                        "entry_id": "93348936-b203-36b2-97d1-81aa71b20a3c",
                        "glosses": [
                            "Plier comme un origami."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "9ba632ad-c49f-4265-b7ce-10de5e84a223",
                                "sense_id": "4cd4d0bf-841a-34d3-be4c-c9e3d6449b9d",
                                "text": "« Débarrasser notre table ! je précise. Et nous apporter la carte des desserts. »\nIl retourne à son bar, origamise nerveusement les cartes et nous envoie deux avions en papier par vol express. Sur les ailes, une boule de glace à la vanille, un parasol en papier, fermé, et des bitoniots sucrés de toutes les couleurs saupoudrés dessus."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf43fc2f-d1e0-3562-beb9-8d8f7dcee694",
                        "entry_id": "93348936-b203-36b2-97d1-81aa71b20a3c",
                        "glosses": [
                            "Représenter comme un origami."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "83a4a405-260f-4620-a0be-020a780485d9",
                                "sense_id": "bf43fc2f-d1e0-3562-beb9-8d8f7dcee694",
                                "text": "Un chat se vectorise et s’origamise.\nC’est dans l’air du temps, tout s’origamise. On ne compte plus le nombre de logo où le cerf façon origami est utilisé."
                            }
                        ]
                    }
