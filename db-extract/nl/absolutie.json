                "translations": [
                    {
                        "translation_id": "82ef63e0-7d52-45bc-9399-acd6ca4d76e4",
                        "source_entry_id": "ebb66bbf-b203-3120-acfa-9e03b58a950a",
                        "source_sense_id": "61835feb-659e-3ae0-8b85-d0844f564047",
