{
    "word_family": [
        "zaczątek",
        "początek",
        "początkowy",
        "początkowo"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d16dbf30-3857-384e-8310-d339a2323b69",
                    "sense_definition": "rozpoczynać wykonywanie jakiejś czynności",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "rozpoczęcie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dzieci <w>zaczynają</w> czytać pierwsze książki w szkole.",
                            "target_lang_translations": {
                                "ru": "Дети <w>начинают</w> читать первые книги в школе."
                            }
                        },
                        {
                            "text": "Muszę <w>zaczynać</w> pracę bardzo wcześnie rano.",
                            "target_lang_translations": {
                                "ru": "Я должен <w>начинать</w> работу очень рано утром."
                            }
                        }
                    ],
                    "synonyms": [
                        "rozpoczynać"
                    ],
                    "antonyms": [
                        "kończyć"
                    ],
                    "common_phrases": [
                        "zaczynać pracę",
                        "zaczynać naukę"
                    ],
                    "target_lang_definitions": {
                        "ru": "приступать к выполнению какого-либо действия или занятия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "начинать",
                                "target_lang_sense_clarification": "приступать к какому-либо действию, занятию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3fe347c3-0456-3cea-a12d-2c8de3069d92",
                    "sense_definition": "mieć swój początek, być inicjowanym",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rozpoczęcie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Koncert <w>zaczyna</w> się dokładnie o godzinie dwudziestej.",
                            "target_lang_translations": {
                                "ru": "Концерт <w>начинается</w> ровно в двадцать часов."
                            }
                        },
                        {
                            "text": "Wiosna <w>zaczyna</w> się w marcu.",
                            "target_lang_translations": {
                                "ru": "Весна <w>начинается</w> в марте."
                            }
                        }
                    ],
                    "synonyms": [
                        "rozpoczynać się",
                        "nastawać"
                    ],
                    "antonyms": [
                        "kończyć"
                    ],
                    "common_phrases": [
                        "zaczyna się"
                    ],
                    "target_lang_definitions": {
                        "ru": "иметь свой старт, быть инициированным или возникать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "начинаться",
                                "target_lang_sense_clarification": "начинать существовать, возникать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7768aee4-ff17-382e-b4a3-2c9eabc218c1",
                    "sense_definition": "otwierać i używać czegoś po raz pierwszy",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rozpoczęcie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musiałem <w>zacząć</w> nową rolkę papieru.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось <w>начать</w> новый рулон бумаги."
                            }
                        },
                        {
                            "text": "Warto <w>zacząć</w> nowy zeszyt do notatek.",
                            "target_lang_translations": {
                                "ru": "Стоит <w>начать</w> новую тетрадь для заметок."
                            }
                        }
                    ],
                    "synonyms": [
                        "napoczynać"
                    ],
                    "target_lang_definitions": {
                        "ru": "открывать и использовать что-либо в первый раз"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "начинать",
                                "target_lang_sense_clarification": "приступать к потреблению, использованию чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c31100d5-f910-3949-bb72-605f1bbddf53",
                    "sense_definition": "zaczepiać lub drażnić kogoś, prowokować konflikt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "konflikt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przestań mnie <w>zaczynać</w>, bo nie mam dzisiaj humoru.",
                            "target_lang_translations": {
                                "ru": "Перестань ко мне <w>приставать</w>, у меня сегодня нет настроения."
                            }
                        },
                        {
                            "text": "On zawsze <w>zaczyna</w> kłótnie w towarzystwie.",
                            "target_lang_translations": {
                                "ru": "Он всегда <w>затевает</w> ссоры в компании."
                            }
                        }
                    ],
                    "synonyms": [
                        "wszczynać"
                    ],
                    "common_phrases": [
                        "znowu zaczynasz"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "często używane w sytuacjach nieformalnych"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "задирать, провоцировать кого-либо на конфликт"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задираться",
                                "target_lang_sense_clarification": "разг. провоцировать ссору, приставать"
                            },
                            {
                                "target_lang_word": "приставать",
                                "target_lang_sense_clarification": "разг. надоедать, провоцировать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}