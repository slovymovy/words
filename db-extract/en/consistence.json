    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "46132ca3-8122-385f-9ad9-4abefe87c6ef",
                "word": "consistence",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9f6a0e9e-0bd8-41d4-a746-aa4df9a88b91",
                        "entry_id": "46132ca3-8122-385f-9ad9-4abefe87c6ef",
                        "tags": [
                            "plural"
                        ],
                        "form": "consistences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4c6edf00-b4da-3898-a9e3-4a793ed718d5",
                        "entry_id": "46132ca3-8122-385f-9ad9-4abefe87c6ef",
                        "glosses": [
                            "Logical consistency; lack of self-contradiction."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "32324d3a-4c48-3419-b5fc-e4576fab079d",
                        "entry_id": "46132ca3-8122-385f-9ad9-4abefe87c6ef",
                        "glosses": [
                            "The staying together, or remaining in close relation, of non-physical things."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cc4d0a01-0869-41c2-b1b8-c7c6af11d4df",
                                "sense_id": "32324d3a-4c48-3419-b5fc-e4576fab079d",
                                "text": "Her performance has lacked consistence over the last year."
                            },
                            {
                                "example_id": "a7e92db8-4a1d-47a9-be96-f1b97192d3b1",
                                "sense_id": "32324d3a-4c48-3419-b5fc-e4576fab079d",
                                "text": "This composer’s musical work is of extraordinary consistence."
                            }
                        ]
                    },
                    {
                        "sense_id": "8189f37c-77bf-31d7-a349-67e7aceb0ea2",
                        "entry_id": "46132ca3-8122-385f-9ad9-4abefe87c6ef",
                        "glosses": [
                            "The physical quality which is given by the degree of density, firmness, solidity, and viscosity; consistency."
                        ],
                        "tags": [
                            "archaic",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ad10bccb-3180-4af4-b879-40c2b92cbd7b",
                                "sense_id": "8189f37c-77bf-31d7-a349-67e7aceb0ea2",
                                "text": "If they [expressed juices] be boiled into the Consistence of a Syrup."
                            },
                            {
                                "example_id": "99f85519-4036-4008-a5d9-abe29decac42",
                                "sense_id": "8189f37c-77bf-31d7-a349-67e7aceb0ea2",
                                "text": "All these things, and many others too numerous to mention, were well mixed together in the famous pot and boiled for four hours, until the consistence of a mess, or poss, was obtained, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "e9baacb6-a755-3818-a69f-3998694df226",
                        "entry_id": "46132ca3-8122-385f-9ad9-4abefe87c6ef",
                        "glosses": [
                            "The condition of adhering or standing together, or being fixed in union, as the parts of a body; coherence, existence, firmness, solidity."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "17494507-77ba-4540-9075-a33e1bb578a4",
                                "sense_id": "e9baacb6-a755-3818-a69f-3998694df226",
                                "text": "Water, being divided, maketh many circles, till it restore itself to the natural consistence."
                            },
                            {
                                "example_id": "3745609c-24cf-4950-b9d2-62037ba45b2f",
                                "sense_id": "e9baacb6-a755-3818-a69f-3998694df226",
                                "text": "VVe are as vvater, vveak, and of no conſiſtence, alvvayes deſcending, abiding in no certain place, unleſeſ vvhere vvee are detained vvith violence: […]"
                            },
                            {
                                "example_id": "bac26d9a-b97e-4f35-b44c-d56ccfcd5e63",
                                "sense_id": "e9baacb6-a755-3818-a69f-3998694df226",
                                "text": "When it was brought to the school it discharged from its right nostril, a whitish, viscid, clotty matter, which, although of little consistence, strongly adhered to the sides of the nostril."
                            }
                        ]
                    },
                    {
                        "sense_id": "05c7efaf-f5ee-37ce-85d5-617b768d7d85",
                        "entry_id": "46132ca3-8122-385f-9ad9-4abefe87c6ef",
                        "glosses": [
                            "That which stands together as a united whole; a combination."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "432b31ab-49be-4463-9928-7fdf616fa61a",
                                "sense_id": "05c7efaf-f5ee-37ce-85d5-617b768d7d85",
                                "text": "The church of God, as meaning whole consistence of orders and members."
                            }
                        ]
                    },
                    {
                        "sense_id": "3bf5488d-3ca1-376f-baec-61da63f5ca41",
                        "entry_id": "46132ca3-8122-385f-9ad9-4abefe87c6ef",
                        "glosses": [
                            "Standing still; quiescence, state of rest."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "97a5ffbb-4913-31d1-acd7-35679460dd74",
                        "entry_id": "46132ca3-8122-385f-9ad9-4abefe87c6ef",
                        "glosses": [
                            "A substance which adheres together."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1958f55e-2c4e-410f-bdb3-7ec24c3955e9",
                                "sense_id": "97a5ffbb-4913-31d1-acd7-35679460dd74",
                                "text": "Ægyptian ingenuity vvas more unſatisfied, contriving their bodies in ſvveet conſiſtences, to attend the return of their ſouls. But all vvas vanity, feeding the vvinde, and folly."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f86d8e0-3cc1-465c-b501-0190494d86ad",
                        "source_entry_id": "46132ca3-8122-385f-9ad9-4abefe87c6ef",
                        "source_sense_description": "physical quality",
                        "target_lang_word": "consistance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consistance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d7bd45b-f357-39ad-8db0-d7bf1dfccbf5",
                                        "entry_id": "f091b374-3323-3869-9b6f-115b5c621f45",
                                        "glosses": [
                                            "État d’un corps qui prend un certain degré de solidité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68e1c39c-5b4b-444f-b949-03ef00b7916d",
                                                "sense_id": "8d7bd45b-f357-39ad-8db0-d7bf1dfccbf5",
                                                "text": "Faire évaporer un liquide jusqu’à la consistance de sirop."
                                            },
                                            {
                                                "example_id": "5b47069c-22a6-4d4e-ba4f-8675e494f931",
                                                "sense_id": "8d7bd45b-f357-39ad-8db0-d7bf1dfccbf5",
                                                "text": "Pour le faumage façon « ricotta », mixez les ingrédients jusqu'à obtenir une consistance relativement lisse. Goûtez afin d'ajuster l'assaisonnement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa9eb032-6b18-3465-8bc0-51689d9d49c0",
                                        "entry_id": "f091b374-3323-3869-9b6f-115b5c621f45",
                                        "glosses": [
                                            "État d’un corps dont les parties sont liées entre elles de manière à offrir une certaine résistance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ab6d21d-640a-45c6-8837-9328f99d072b",
                                                "sense_id": "aa9eb032-6b18-3465-8bc0-51689d9d49c0",
                                                "text": "Bientôt, il n’y eut plus de ronces et Mokkhi reconnut sous ses pieds la consistance de l’herbe."
                                            },
                                            {
                                                "example_id": "8455df1b-8d83-485b-aee0-2e387ed32e32",
                                                "sense_id": "aa9eb032-6b18-3465-8bc0-51689d9d49c0",
                                                "text": "La consistance du sol doit être estimée sur la parcelle juste avant le travail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ff9b573-f432-38ae-936b-c3a913116336",
                                        "entry_id": "f091b374-3323-3869-9b6f-115b5c621f45",
                                        "glosses": [
                                            "Stabilité ; fixité ; permanence."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a0f8218-cc38-4c8e-a305-cd076e531212",
                                                "sense_id": "7ff9b573-f432-38ae-936b-c3a913116336",
                                                "text": "[…] mais, dans les grandes circonstances, ma femme n’a jamais hésité d’approuver ce qu’elle pensait propre à mettre de la consistance dans ma vie et à rehausser mon nom dans l’estime publique : en cela elle a plus de mérite qu’une autre."
                                            },
                                            {
                                                "example_id": "23768c77-e44a-4bf0-a4f3-48b82debde32",
                                                "sense_id": "7ff9b573-f432-38ae-936b-c3a913116336",
                                                "text": "Donc, l'art de la peinture esquisse et restitue en image les Grâces et donne de la consistance à leur corps par les couleurs ; désormais, il les peint toutes trois en pied et les présente nues, sans vêtements ni voiles."
                                            },
                                            {
                                                "example_id": "64cbb888-1688-46f3-8d40-8392373c30d6",
                                                "sense_id": "7ff9b573-f432-38ae-936b-c3a913116336",
                                                "text": "Ce bruit, cette nouvelle, etc., prend, acquiert de la consistance, Ce bruit, cette nouvelle, etc., devient moins vague, commence à se confirmer."
                                            },
                                            {
                                                "example_id": "c1f6d1fd-c689-4deb-9a9d-d33ebce2a735",
                                                "sense_id": "7ff9b573-f432-38ae-936b-c3a913116336",
                                                "text": "C’est un esprit qui n’a point de consistance, c’est un caractère sans consistance, se dit d’une Personne qui n’est pas ferme dans ses résolutions, dans ses opinions, etc., et qui en change aisément."
                                            },
                                            {
                                                "example_id": "82bee576-1ba8-4eb9-bc1f-92ed319c09c1",
                                                "sense_id": "7ff9b573-f432-38ae-936b-c3a913116336",
                                                "text": "C’est un homme sans consistance dans le monde, ou simplement"
                                            },
                                            {
                                                "example_id": "e458ae37-452a-4158-9223-bf3a1ddd131c",
                                                "sense_id": "7ff9b573-f432-38ae-936b-c3a913116336",
                                                "text": "Sans consistance, Sans crédit, sans considération."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d09e191a-3ec9-3193-8103-32d63906d200",
                                        "entry_id": "f091b374-3323-3869-9b6f-115b5c621f45",
                                        "glosses": [
                                            "Il désigne ce en quoi consiste une succession ou un domaine et ses dépendances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33ad6ad9-6fb3-4a2a-990d-c390d382402f",
                                                "sense_id": "d09e191a-3ec9-3193-8103-32d63906d200",
                                                "text": "La consistance d’une succession."
                                            },
                                            {
                                                "example_id": "cde852ac-a825-47b8-834e-79d50493bcd2",
                                                "sense_id": "d09e191a-3ec9-3193-8103-32d63906d200",
                                                "text": "Donner un état de la consistance d’une terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33cae2a7-8570-3266-9df4-376d91c391b2",
                                        "entry_id": "f091b374-3323-3869-9b6f-115b5c621f45",
                                        "glosses": [
                                            "Absence d'énoncé contradictoire d'une théorie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf1324f6-711f-4539-8ea6-3e1e9de42ca2",
                        "source_entry_id": "46132ca3-8122-385f-9ad9-4abefe87c6ef",
