                            "kerst"
                        ],
                        "examples": [
                            {
                                "example_id": "6002a183-f2ba-48b7-85f8-fc9aa6ed8325",
                                "sense_id": "5335c655-8acb-384b-8f3d-4e6c11136697",
                                "text": "Nu de economie groeit, worden er meer en luxere kerstpakketten uitgedeeld. Al zijn ze in het westen van Nederland wat duurder dan in het oosten. Advocaten worden het rijkst bedeeld."
                            }
                        ]
