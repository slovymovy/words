                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0014ac07-818d-4a8a-9cb2-bba7b0eb378b",
                        "source_entry_id": "4e98ae1a-6beb-30fc-9a90-f02d61ab45d2",
                        "source_sense_id": "6f0b6660-3a01-3e88-b12a-4d76483c7101",
                        "source_sense_description": "exploding device",
                        "target_lang_word": "Feuerwerkskörper",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feuerwerkskörper",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a134d94-dea1-3d36-8a00-a3e8707fff67",
                                        "entry_id": "381e7e97-f109-3074-9706-988998aa9f88",
                                        "glosses": [
                                            "ein Sprengkörper, der zur Belustigung und Unterhaltung zu bestimmten Anlässen in die Luft gejagt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c90da0a8-94f5-491b-8c17-2d23fa87a116",
                                                "sense_id": "3a134d94-dea1-3d36-8a00-a3e8707fff67",
                                                "text": "Da, wo sich zuvor die Hand befand, hat der Feuerwerkskörper gute Arbeit geleistet."
                                            },
                                            {
                                                "example_id": "b7de340e-f2f9-4bbf-b48a-d3354f2466b0",
                                                "sense_id": "3a134d94-dea1-3d36-8a00-a3e8707fff67",
                                                "text": "Als der Feuerwerkskörper in der Hand explodierte, kam Freude auf."
                                            },
                                            {
                                                "example_id": "3f64d28a-3ea0-4ad8-a353-b80885df5c76",
                                                "sense_id": "3a134d94-dea1-3d36-8a00-a3e8707fff67",
                                                "text": "„Über den Dächern platzen Feuerwerkskörper wie Blumen auf, lautlos.“"
                                            },
                                            {
                                                "example_id": "ca558a91-7c18-4e2d-b242-d1877652af91",
                                                "sense_id": "3a134d94-dea1-3d36-8a00-a3e8707fff67",
                                                "text": "„Anfänglich wurde Schwarzpulver nur für Feuerwerkskörper benutzt, später war es als Schießpulver unentbehrlich.“"
                                            },
                                            {
                                                "example_id": "54dc5109-35f4-4f84-9aa6-d19c62cd50ed",
                                                "sense_id": "3a134d94-dea1-3d36-8a00-a3e8707fff67",
                                                "text": "„In der Nähe geht ein Feuerwerkskörper in die Luft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
