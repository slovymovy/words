        "ru-extract.jsonl": [
            {
                "entry_id": "fc0e87c7-edbf-3b73-ab0a-d1eeb365c30c",
                "word": "набок",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8d8062e6-15d9-38c4-bc27-29c46f3e3467",
                        "entry_id": "fc0e87c7-edbf-3b73-ab0a-d1eeb365c30c",
                        "glosses": [
                            "на одну сторону"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faf56830-ba12-4b65-808a-4289afbab0ee",
                                "sense_id": "8d8062e6-15d9-38c4-bc27-29c46f3e3467",
                                "text": "По левую сторону городничего: Земляника, наклонивший голову несколько набок, как будто к чему-то прислушивающийся; за ним судья с растопыренными руками, присевший почти до земли и сделавший движенье губами, как бы хотел посвистать или произнесть: «Вот тебе, бабушка, и Юрьев день!»"
                            }
                        ]
                    },
                    {
                        "sense_id": "2da74c71-5b15-3232-9929-3431487ae5e3",
                        "entry_id": "fc0e87c7-edbf-3b73-ab0a-d1eeb365c30c",
                        "glosses": [
                            "перен. вкось, вкривь"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "554dc76a-44ee-4ca1-b621-d1d6bf09a2d6",
                        "source_entry_id": "fc0e87c7-edbf-3b73-ab0a-d1eeb365c30c",
                        "target_lang_word": "schief",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schief",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e55225d-a4eb-3a2c-929a-c4f39b17932b",
                                        "entry_id": "dd4a0948-989d-3411-91e3-35b7efc59d21",
                                        "glosses": [
                                            "weder parallel zur Lotlinie, noch zur Waagerechten; nicht parallel zu einer relevanten Linie oder Ebene"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18343510-0447-4784-bca3-2a46ec70b8fe",
                                                "sense_id": "3e55225d-a4eb-3a2c-929a-c4f39b17932b",
                                                "text": "Dieses Bild hängt ja ganz schief!"
                                            },
                                            {
                                                "example_id": "8cf10cb9-7d9b-4106-a6df-343f697dbd98",
                                                "sense_id": "3e55225d-a4eb-3a2c-929a-c4f39b17932b",
                                                "text": "Anhand der schiefen Ebene behandelt man in der Elementarphysik das Kräfteparallelogramm."
                                            },
                                            {
                                                "example_id": "feffb27c-35b9-4d57-9d99-4583a5ea84e1",
                                                "sense_id": "3e55225d-a4eb-3a2c-929a-c4f39b17932b",
                                                "text": "„Eine Besonderheit sind dabei die nebeneinander stehenden schiefen Türme Garisenda und Asinelli.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ab46d249-2acf-3ac0-85fb-5da55798e349",
                                        "entry_id": "dd4a0948-989d-3411-91e3-35b7efc59d21",
                                        "glosses": [
                                            "nicht gerade, leicht verwachsen"
                                        ],
                                        "tags": [
                                            "bezogen auf den menschliche Körper"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7c9a793-fb7b-45fe-ac43-7259e2f1d989",
                                                "sense_id": "ab46d249-2acf-3ac0-85fb-5da55798e349",
                                                "text": "„Lucas verpflichtet den sympathischen Schauspieler mit dem schiefen Grinsen auch für die \"Indiana Jones\"-Reihe,“ […]."
                                            },
                                            {
                                                "example_id": "485170e3-ea0b-442f-826e-c80dc20a8081",
                                                "sense_id": "ab46d249-2acf-3ac0-85fb-5da55798e349",
                                                "text": "Sie hielt den Kopf schief und sah in fragend an."
                                            },
                                            {
                                                "example_id": "1c66de05-7124-4607-abe4-07b8d51d5f51",
                                                "sense_id": "ab46d249-2acf-3ac0-85fb-5da55798e349",
                                                "text": "[Boxernase:] „Da sie in der Regel zunächst unbehandelt bleiben, wächst das Nasenbein – wenn überhaupt – schief zusammen.“"
                                            },
                                            {
                                                "example_id": "1c298cec-29a9-46aa-9fd9-d6212b7ce0d5",
                                                "sense_id": "ab46d249-2acf-3ac0-85fb-5da55798e349",
                                                "text": "„Die Platzierung dieses Piercings ist nicht immer leicht, da die Lage sehr auf das Gesicht abgestimmt werden muss, um nicht schief oder krumm zu wirken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c136a4b4-a745-3df6-848a-fcfd0eb524ab",
                                        "entry_id": "dd4a0948-989d-3411-91e3-35b7efc59d21",
                                        "glosses": [
                                            "Argumente/Fakten nur zum Teil berücksichtigend"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bc3027c-09fa-42fd-aca7-4343eb28362b",
                                                "sense_id": "c136a4b4-a745-3df6-848a-fcfd0eb524ab",
                                                "text": "Das siehst Du komplett schief."
                                            },
                                            {
                                                "example_id": "54dfc4da-3259-4172-951c-6c8f7cc2b85e",
                                                "sense_id": "c136a4b4-a745-3df6-848a-fcfd0eb524ab",
                                                "text": "Das ist ein schiefer Vergleich."
                                            },
                                            {
                                                "example_id": "fdac9008-76b6-45c7-923e-59e685e9e442",
                                                "sense_id": "c136a4b4-a745-3df6-848a-fcfd0eb524ab",
                                                "text": "[Obdachlosigkeit:] »Klar ist es hier besser, aber dieser Vergleich wäre schief. Man muss sie mit der Realität in der Stadt vergleichen - die Mieten, die Grundstückspreise. Wir haben Städte, wo die Menschen 50 Prozent ihres Gehalts für die Unterkunft zahlen müssen.«"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "16d474f8-72c9-3046-a23c-1984887db265",
                                        "entry_id": "dd4a0948-989d-3411-91e3-35b7efc59d21",
                                        "glosses": [
                                            "falsch, einen Ton nicht treffend"
                                        ],
                                        "tags": [
                                            "Musik",
                                            "Gesang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "737e43b2-90a5-435c-adbb-59e7b1fe6326",
                                                "sense_id": "16d474f8-72c9-3046-a23c-1984887db265",
                                                "text": "„Gut gelaunt und ziemlich schief trällere ich meine Lieblingshits aus dem Radio mit und drücke aufs Gas.“"
                                            },
                                            {
                                                "example_id": "7d36a3f8-29b9-4b23-ab4e-8bcfde897921",
                                                "sense_id": "16d474f8-72c9-3046-a23c-1984887db265",
                                                "text": "„Wer es nicht gewohnt ist, darauf zu achten, hat entsprechend wenig Übung darin, schiefe Töne zu erkennen.“"
                                            },
                                            {
                                                "example_id": "925f8775-346d-4ae5-b033-f3780e13dd4d",
                                                "sense_id": "16d474f8-72c9-3046-a23c-1984887db265",
                                                "text": "[…] „»Florence Foster Jenkins war eine tolle Frau. Es wäre falsch, sie als lächerliche Figur zu sehen. Gut, sie stand mit den hohen Tönen auf Kriegsfuß, aber sie hat nicht alles schief gesungen.«“"
                                            },
                                            {
                                                "example_id": "476c7403-ff41-4572-ae02-9181f8438aef",
                                                "sense_id": "16d474f8-72c9-3046-a23c-1984887db265",
                                                "text": "„Und sie fragt sich, wieso die Jenkins es einfach nicht hörte, wenn sie schief sang.“"
                                            },
                                            {
                                                "example_id": "e55b5f51-f1af-42d8-ba42-ac209f2f8341",
                                                "sense_id": "16d474f8-72c9-3046-a23c-1984887db265",
                                                "text": "„Sie lächelt. »Ich hätte nie gedacht, dass schiefer Gesang so gut ankommt. Als wir ,Glorious‘ in Hamburg spielten, klatschten die Leute in die Arien hinein.«“"
                                            },
                                            {
                                                "example_id": "281c35ce-8391-4ae8-a683-3c77db3b71ac",
                                                "sense_id": "16d474f8-72c9-3046-a23c-1984887db265",
                                                "text": "[Schlagzeile:] „Weil er schief gesungen hat: Karaoke-Fan muss 3000 Euro Strafe zahlen!“"
                                            },
                                            {
                                                "example_id": "85b0d0ff-5a7f-4e6c-ae51-ca866c6967c6",
                                                "sense_id": "16d474f8-72c9-3046-a23c-1984887db265",
                                                "text": "„Und was, wenn man oft schief singt oder Angst vor großen Tonsprüngen hat?“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "e0a13a47-a433-38d7-b861-fbbff437a110",
                                        "entry_id": "dd4a0948-989d-3411-91e3-35b7efc59d21",
                                        "glosses": [
                                            "unstabil, unhaltbar, gefährdet, suspekt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6900d153-d89d-4d04-a9c9-ee2f2799a6aa",
                                                "sense_id": "e0a13a47-a433-38d7-b861-fbbff437a110",
                                                "text": "Er hatte das Dokument gefälscht und damit das ganze Projekt in ein schiefes Licht gerückt."
                                            },
                                            {
                                                "example_id": "de427909-21ba-4364-a47b-847e59691600",
                                                "sense_id": "e0a13a47-a433-38d7-b861-fbbff437a110",
                                                "text": "Als dann auch noch mein bekannter Gegner mir in der Sitzung beipflichtete, wurde meine Position ganz schief."
                                            },
                                            {
                                                "example_id": "1b4fee65-2f8a-452c-bfaa-72a1c780a4a5",
                                                "sense_id": "e0a13a47-a433-38d7-b861-fbbff437a110",
                                                "text": "Manche lehnen mit dem Argument der schiefen Ebene jede genetische Keimbahntherapie am Menschen ab."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
