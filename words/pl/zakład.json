                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fold",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Krawcowa zrobiła szeroki <w>zakład</w>, aby w razie potrzeby wydłużyć spódnicę.",
                            "target_lang_translations": {
                                "ru": "Портниха сделала широкий <w>запас</w>, чтобы при необходимости можно было удлинить юбку."
                            }
                        },
                        {
                            "text": "Arkusze blachy należy układać starannie na <w>zakład</w>, by woda nie przeciekała.",
                            "target_lang_translations": {
                                "ru": "Листы жести нужно аккуратно укладывать в <w>нахлёст</w>, чтобы вода не протекала."
                            }
