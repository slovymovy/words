            {
                "entry_id": "ff0e8a41-8b50-3619-a001-1418bbbf28cd",
                "word": "Sung",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9f86c3d6-d95d-3025-b501-d318fe2945cd",
                        "entry_id": "ff0e8a41-8b50-3619-a001-1418bbbf28cd",
                        "glosses": [
                            "Alternative form of Song (Chinese dynasty)"
                        ],
                        "tags": [
                            "alt-of",
                            "alternative",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5282b47e-09c8-4a59-aa81-ebec44ced45b",
                                "sense_id": "9f86c3d6-d95d-3025-b501-d318fe2945cd",
                                "text": "At present the metropolitan area of Kuang-chou City alone comprises some 1,500,000 people or twice that of the Sung period for all of the two provinces."
                            },
                            {
                                "example_id": "1c8e03a8-9d4a-4729-9b9c-6afa6d11a55f",
                                "sense_id": "9f86c3d6-d95d-3025-b501-d318fe2945cd",
                                "text": "Fish were produced in Hu-chou for sale at the Southern Sung capital."
                            },
                            {
                                "example_id": "7e5922c6-3cdd-4cff-8e89-a175fa210eb0",
                                "sense_id": "9f86c3d6-d95d-3025-b501-d318fe2945cd",
                                "text": "The Sung dynasty was the great Classical Age and it is on this era that the emphasis in this book falls."
                            },
                            {
                                "example_id": "630f7c0d-3fe3-40a1-8f9c-6b918c670483",
                                "sense_id": "9f86c3d6-d95d-3025-b501-d318fe2945cd",
                                "text": "Today in Peking we repeat a phrase to our allies from the Sung dynasty, seven hundred years old. 'We are as close to you as the lips to the teeth. If the lips are gone, our teeth must chatter with cold.'"
                            },
                            {
                                "example_id": "a815d7c9-e058-4e97-8512-cd3bf89f196b",
                                "sense_id": "9f86c3d6-d95d-3025-b501-d318fe2945cd",
                                "text": "PICARD: Lutan, we are aware of many of your planet's achievements, and its unique similarity to an ancient Earth culture we all admire. On behalf of the Federation, therefore, I would like to present this token of our gratitude and friendship. From China's Sung Dynasty, Fourteenth Century.\nDATA: Thirteenth Century, sir.\nPICARD: Ah yes, indeed."
                            },
                            {
                                "example_id": "43079650-28df-4a5b-aa52-d3c6a99a71ad",
                                "sense_id": "9f86c3d6-d95d-3025-b501-d318fe2945cd",
                                "text": "The animated scroll was based on the work of 12th century Sung Dynasty artist Zhang Zeduan (張擇端), whose lively portrayal of the daily life of ordinary people in the capital city of the Northern Sung Dynasty — Bianjing (Kaifeng) — has captured the fascination of people for generations."
                            },
                            {
                                "example_id": "acbca193-9c07-44e7-8f1c-8661da5ffe84",
                                "sense_id": "9f86c3d6-d95d-3025-b501-d318fe2945cd",
                                "text": "Previous scholarship places the rocket’s origins in China during the Sung dynasty (A.D. 960-1279)."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "97be7ae9-3069-3205-9743-70f535bc6ab5",
                "word": "sung",
