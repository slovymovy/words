                "senses": [
                    {
                        "sense_id": "ce79661b-c73b-310e-9804-bd076b3ecf59",
                        "entry_id": "41007881-0af1-3d46-9f9b-f043b0d3d952",
                        "glosses": [
                            "Lippe eines Pferdes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08e63b4d-2f3e-460a-ad9c-d87837017353",
                                "sense_id": "ce79661b-c73b-310e-9804-bd076b3ecf59",
                                "text": "„Er schöpfte mit der hohlen Hand Wasser aus der Kolotscha, benetzte damit die Pferdelippen.“"
                            },
                            {
                                "example_id": "30a2130a-a7f4-4e11-8302-c8c25518c14a",
                                "sense_id": "ce79661b-c73b-310e-9804-bd076b3ecf59",
                                "text": "„Herschele wich dem forschenden Blick aus, schlug die Augen nieder, strich über die weichen Pferdelippen.“"
                            },
                            {
                                "example_id": "23063550-4e44-478e-9779-8fc4ac11db17",
                                "sense_id": "ce79661b-c73b-310e-9804-bd076b3ecf59",
                                "text": "„\"Java\" zupft es mit sanften Pferdelippen von ihrer Handfläche. “"
                            },
                            {
                                "example_id": "8ba6232c-eb72-42bb-84a3-73063b3f6266",
                                "sense_id": "ce79661b-c73b-310e-9804-bd076b3ecf59",
                                "text": "„Mit weichen Pferdelippen pflegen die Tiere sich gegenseitig die Fußgelenke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
