                    {
                        "sense_id": "6edd0997-f455-32c1-90d0-c084edf8791e",
                        "entry_id": "28deacfd-19ec-3cf6-8b5f-cfa2af7423bd",
                        "glosses": [
                            "Gleichgewichtsübung beim Turnen, bei der man kopfüber gestreckt auf seinen Händen steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89412e30-4328-4924-a374-a13fa5870f17",
                                "sense_id": "6edd0997-f455-32c1-90d0-c084edf8791e",
                                "text": "Sie braucht beim Handstand noch etwas Hilfestellung, sonst kippt sie um."
                            },
                            {
                                "example_id": "25ea1291-39a8-4666-b2c1-675ff7e5a586",
                                "sense_id": "6edd0997-f455-32c1-90d0-c084edf8791e",
                                "text": "„Sie tanzt einen akrobatischen Tanz, mit Saltos, Handständen und hohen Sprüngen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9bb97954-27a6-40fe-8f8a-e58fca18c32c",
