                                                "sense_id": "8f2bbfb5-e88c-372a-8e7f-f956359f4b10",
                                                "text": "Ils sont en train d’asphalter le pont."
                                            },
                                            {
                                                "example_id": "ae5d841d-aa36-4991-8187-b14d29e64555",
                                                "sense_id": "8f2bbfb5-e88c-372a-8e7f-f956359f4b10",
                                                "text": "La terrasse est asphaltée pour la rendre imperméable."
                                            },
                                            {
                                                "example_id": "97f732b4-9a28-4eb5-afbc-0cb83e3d5cf9",
                                                "sense_id": "8f2bbfb5-e88c-372a-8e7f-f956359f4b10",
                                                "text": "Je monte sur le toit avec un enfant et un chien, je tire sur les bardeaux chauffés par le ciel en déchirant mes paumes sur l’odeur asphaltée."
                                            }
                                        ]
