                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22489aad-50de-4ff0-b58e-1212b94423c1",
                        "source_entry_id": "9fc0dadb-a552-3d1f-b858-dad379435993",
                        "source_sense_id": "bf1d03cb-18cf-3a5a-b50a-5b362b76dec3",
                        "target_lang_word": "autocratic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autocratic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fee04b45-382d-37ed-a06c-c68e37a7f767",
                                        "entry_id": "10b537e5-5fa3-32be-9ca4-89d3ae517912",
                                        "glosses": [
                                            "Of or pertaining to autocracy or to an autocrat; absolute; holding independent and arbitrary powers of government."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4cdc29b-e205-4b62-88bb-628a96efd9bf",
                                                "sense_id": "fee04b45-382d-37ed-a06c-c68e37a7f767",
                                                "text": "In recent years, the prime minister has become increasingly autocratic."
                                            },
                                            {
                                                "example_id": "c732ec8c-2ce7-4a3d-8955-14705a458295",
                                                "sense_id": "fee04b45-382d-37ed-a06c-c68e37a7f767",
                                                "text": "Within democracies, nationalist leaders with autocratic impulses – from outgoing President Jair Bolsonaro in Brazil to presidential hopeful Marine Le Pen in France – have seen defeats in recent months."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bf97407-55f0-39a0-b4ab-40b4bb74a0ce",
                                        "entry_id": "10b537e5-5fa3-32be-9ca4-89d3ae517912",
                                        "glosses": [
                                            "Of or pertaining to the manner of an autocrat."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25077508-20e0-46bf-9f28-e7c185032ae0",
                                                "sense_id": "9bf97407-55f0-39a0-b4ab-40b4bb74a0ce",
                                                "text": "Despite his lack of actual authority, his autocratic demeanour annoyed many of his colleagues."
                                            },
                                            {
                                                "example_id": "95837aab-9e3d-4679-9873-e400f1d4ba31",
                                                "sense_id": "9bf97407-55f0-39a0-b4ab-40b4bb74a0ce",
                                                "text": "Donna became autocratic the day Daniel born, and she realized she had absolute power over another human being."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "282a3403-82c6-4fcf-83b2-3bc8776e51e0",
                        "source_entry_id": "9fc0dadb-a552-3d1f-b858-dad379435993",
                        "source_sense_id": "bf1d03cb-18cf-3a5a-b50a-5b362b76dec3",
                        "target_lang_word": "autocratique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autocratique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ed48cba-a6c0-3764-b5e8-3280e4fb5062",
                                        "entry_id": "26c4cdd0-dbee-33f8-89b1-2d1a19d1ef20",
                                        "glosses": [
                                            "Qui appartient à l’autocratie, à l’autocrate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fa73033-a2cc-4d7e-a215-0595dad86b39",
                                                "sense_id": "7ed48cba-a6c0-3764-b5e8-3280e4fb5062",
                                                "text": "Les difficultés que cet Edit éprouva à l’enregistrement, & la manière autocratique dont elles furent levées, contribuèrent encore à fixer les regards sur une Compagnie, en faveur de laquelle se faisaient les coups d’autorité les plus éclatants."
                                            },
                                            {
                                                "example_id": "3d52a15f-4c85-4fb6-ab11-96b2a76729d1",
                                                "sense_id": "7ed48cba-a6c0-3764-b5e8-3280e4fb5062",
                                                "text": "Au reste, ces barbaries deviennent rares et inspirent autant d’horreur aux Russes honnêtes qu’à mes lecteurs : mais elles se commettent encore, et attestent combien l’espèce humaine est dégradée sous un gouvernement autocratique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d01db39-dc03-3c26-ae45-67c764e933aa",
                                        "entry_id": "26c4cdd0-dbee-33f8-89b1-2d1a19d1ef20",
                                        "glosses": [
                                            "Qui est autoritaire, tyrannique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7abb995-4e03-41f8-a8af-0b7df4aea1bc",
                                                "sense_id": "6d01db39-dc03-3c26-ae45-67c764e933aa",
                                                "text": "Bref, ils ont laissé l’homme le plus puissant du monde contaminer des millions d’esprits par sa haine agissante et digne des régimes les plus autocratiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
