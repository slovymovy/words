                                "target_senses": [
                                    {
                                        "sense_id": "67edaa4a-aa93-3bcd-9cab-e8c15f7031c4",
                                        "entry_id": "cb0b99d1-be38-31ea-a132-330a52c64179",
                                        "glosses": [
                                            "Staat in Südamerika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9e034ff-7ff3-4c37-bead-4fe38bd8daec",
                                                "sense_id": "67edaa4a-aa93-3bcd-9cab-e8c15f7031c4",
                                                "text": "Ich möchte einen Urlaub durch die 43 Nationalparks Venezuelas machen."
                                            },
                                            {
                                                "example_id": "218f4d58-2383-4cca-8441-75b3cfd6afc8",
                                                "sense_id": "67edaa4a-aa93-3bcd-9cab-e8c15f7031c4",
                                                "text": "Caracas ist die Hauptstadt von Venezuela."
                                            },
                                            {
                                                "example_id": "311cb117-df2c-4f78-ac58-3dee1bb93a97",
                                                "sense_id": "67edaa4a-aa93-3bcd-9cab-e8c15f7031c4",
                                                "text": "Die hohe Kriminalität in Venezuela stellt ein großes Problem dar."
                                            },
                                            {
                                                "example_id": "cc5d14d6-ab33-4649-be4f-2a3b7fb23de4",
                                                "sense_id": "67edaa4a-aa93-3bcd-9cab-e8c15f7031c4",
                                                "text": "„Das war eine der Vorgaben des Madrid-Vertrags: Die Welser sollten in Venezuela zwei Städte mit jeweils 300 Menschen besiedeln und drei Festungen bauen.“"
                                            },
                                            {
                                                "example_id": "28b2267c-3dcf-4369-83c9-e28921fed46a",
                                                "sense_id": "67edaa4a-aa93-3bcd-9cab-e8c15f7031c4",
                                                "text": "„Venezuela gilt damit als erster Staat in der jüngeren Vergangenheit, der gletscherfrei wurde.“"
                                            },
                                            {
                                                "example_id": "1bc5ab57-c966-44b3-ace0-200219b4d65c",
                                                "sense_id": "67edaa4a-aa93-3bcd-9cab-e8c15f7031c4",
                                                "text": "„Neu-Nürnberg hat zwei Millionen Einwohner, liegt traumhaft an einem karibischen Meerbusen, heißt heute Maracaibo und ist die zweitgrößte Stadt Venezuelas.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
