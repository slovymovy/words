    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3253c6d2-5834-3504-8020-b319c2d9a08c",
                "word": "fieldwork",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b20cab53-26c4-4266-8d9f-0df5885ae761",
                        "entry_id": "3253c6d2-5834-3504-8020-b319c2d9a08c",
                        "tags": [
                            "plural"
                        ],
                        "form": "fieldworks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f9f3787e-1422-330f-b4ed-3fb21edf35bf",
                        "entry_id": "3253c6d2-5834-3504-8020-b319c2d9a08c",
                        "glosses": [
                            "Work done out in the fields as opposed to that done elsewhere on the farm (e.g., barn, house, outbuildings, office)."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9d34324b-0643-46d8-ab0d-45012a24afd5",
                                "sense_id": "f9f3787e-1422-330f-b4ed-3fb21edf35bf",
                                "text": "The days now were occupied in field work and more field work; he cleared new bits of ground, getting out roots and stones; plowing, manuring, harrowing, working with pick and spade, breaking lumps of soil and crumbling them with hand and heel; a tiller of the ground always, laying out fields like velvet carpets. He waited a couple of days longer―there was a look of rain about―and then he sowed his grain."
                            },
                            {
                                "example_id": "0874f91d-8b58-435b-befe-ce679dd89505",
                                "sense_id": "f9f3787e-1422-330f-b4ed-3fb21edf35bf",
                                "text": "Besides the bookkeeping and marketing, there's a ton of fieldwork to get done this week."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d1ba984-36a8-39ff-9990-af8c03bd0116",
                        "entry_id": "3253c6d2-5834-3504-8020-b319c2d9a08c",
                        "glosses": [
                            "Work done out in the real world rather than in controlled conditions."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f09dd865-42f1-4d1a-a45b-caedcd805418",
                                "sense_id": "0d1ba984-36a8-39ff-9990-af8c03bd0116",
                                "text": "That well Bob set up last weekend was some good fieldwork."
                            }
                        ]
                    },
                    {
                        "sense_id": "49bd284b-72e7-389c-b8b2-f1d5f1c2f15a",
                        "entry_id": "3253c6d2-5834-3504-8020-b319c2d9a08c",
                        "glosses": [
                            "The collection of raw data in the field, field research, field study, field studies."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5793866a-c289-4618-9533-2dba7c4f554f",
                                "sense_id": "49bd284b-72e7-389c-b8b2-f1d5f1c2f15a",
                                "text": "I thought the fieldwork in the course I was taking was going to be hard, but it was just interviewing people."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5c43dfa-02ae-3609-bc32-e4f7db5b40c8",
                        "entry_id": "3253c6d2-5834-3504-8020-b319c2d9a08c",
                        "glosses": [
                            "A temporary fortification built by troops in the field; a defensive earthwork in the field."
                        ],
                        "tags": [
                            "countable",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5f093c21-4f31-4b32-a2c6-ea4494643478",
                                "sense_id": "a5c43dfa-02ae-3609-bc32-e4f7db5b40c8",
                                "text": "Billy's out building some fieldwork so that our enemies don't walk right over us."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e9a35ec-2141-4ee2-9a46-2b91045b465e",
                        "source_entry_id": "3253c6d2-5834-3504-8020-b319c2d9a08c",
                        "source_sense_description": "(agriculture) work done out in the fields",
                        "target_lang_word": "veldwerk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veldwerk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b60f0763-c5eb-3eff-bdd0-91fedd84548d",
                                        "entry_id": "dfd20a0e-7591-3d35-bf69-b80fcd12fade",
                                        "glosses": [
                                            "het verzamelen van onderzoeksgegevens dat doorgaans buiten plaatsvindt en waarvan de resultaten vaak op kantoor worden geanalyseerd en verwerkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "928a01d6-9fd5-4543-9285-0fcb0fff8b39",
                                                "sense_id": "b60f0763-c5eb-3eff-bdd0-91fedd84548d",
                                                "text": "Toch staan de twee dikke delen die de Duitse erfelijkheidsonderzoeker Ernst Rodenwaldt begin vorige eeuw op basis van eigen veldwerk schreef over Die Mestizen auf Kisar (1928), bij de meeste families op een ereplaats. Wie belangstelling toont laten ze trots de sepia foto’s zien die de professor maakte van hun voorouders. Nu bestudeert de Leidse linguïst Aone van Engelenhoven deze kleine gemeenschap en hij schreef erover in het boek ‘Vêrlander’. Verschillende ‘mestiezen’ lieten zich voor het project portretteren."
                                            },
                                            {
                                                "example_id": "79f2b783-e104-4b5a-9954-de140d0ba372",
                                                "sense_id": "b60f0763-c5eb-3eff-bdd0-91fedd84548d",
                                                "text": "Hoog niveau: Voorzitter Bob Hoogendoorn van het Koninklijk Nederlands Geologisch-Mijnbouwkundig Genootschap (KNGMG) valt hem bij. \"Er is echt geen werkloze afgestudeerde op dit moment. Er is enorm veel vraag naar.\" Bovendien is de kwaliteit van het onderwijs en onderzoek aan de VU van wereldniveau, benadrukt hij. Niet goedkoop weliswaar, mede door het veldwerk, maar wel erg goed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
