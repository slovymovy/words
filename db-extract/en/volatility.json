                                            "Schwankungsbreite"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1de99545-3a64-4a5f-a283-18f164cc8386",
                                                "sense_id": "ae650f69-4e76-3602-8a66-23c9e649f28f",
                                                "text": "Je größer die Schwankungen, desto höher die Volatilität und umgekehrt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "50e334d0-8884-3241-976b-000fcc146579",
                                        "entry_id": "0f4f373a-e7c0-3522-aec0-8ddb45bfd23a",
                                        "glosses": [
                                            "Schwankungsmaß von Devisen- und Wertpapierkursen sowie von Zinssätzen, auch die Kurs- und Zinsschwankungen ganzer Märkte"
                                        ],
                                        "tags": [
                                            "Geldwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e6e9245-8489-4eac-8c74-03fa6cba4469",
                                                "sense_id": "50e334d0-8884-3241-976b-000fcc146579",
                                                "text": "Die Volatilität mancher Aktien ist besonders hoch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8c693630-78a7-3586-b97b-5981a008e1a2",
                                        "entry_id": "0f4f373a-e7c0-3522-aec0-8ddb45bfd23a",
                                        "glosses": [
                                            "Maß für das Gesamtrisiko einer Investitions- oder Finanzierungsmöglichkeit"
                                        ],
                                        "tags": [
                                            "Finanzmathematik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a41f96c-5928-4e30-9e38-2b1cdbc1af08",
                                                "sense_id": "8c693630-78a7-3586-b97b-5981a008e1a2",
                                                "text": "Vernachlässigt man die übliche Zweiteilung zwischen systematischen und unsystematischen Risiken, gilt die Volatilität gemeinhin als Maß des Gesamtrisikos einer Anlage."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "eb466330-1765-3025-a61e-57c4bc1d555e",
                                        "entry_id": "0f4f373a-e7c0-3522-aec0-8ddb45bfd23a",
                                        "glosses": [
                                            "Wechselhaftigkeit im Wahlverhalten"
                                        ],
                                        "tags": [
                                            "Politikwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92c89405-8e8b-42da-a4d8-210885b4a3ce",
                                                "sense_id": "eb466330-1765-3025-a61e-57c4bc1d555e",
                                                "text": "Die Volatilität von Schweizer Wahlen. Das Stichwort der Parteien- und Wahlforschung zur Messung von Instabilität heisst “volatility”. Geprägt wurde es 1979 vom dänischen Politikwissenschafter Morgen Pedersen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "a5201a6a-dd4b-31ee-8661-d9c38bec7c86",
                                        "entry_id": "0f4f373a-e7c0-3522-aec0-8ddb45bfd23a",
                                        "glosses": [
                                            "Maß der Flüchtigkeit beziehungsweise die Neigung zur Verflüchtigung von Stoffen, zum Beispiel Chemikalien, in die Luft"
                                        ],
                                        "tags": [
                                            "Naturwissenschaften"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02b05162-f768-4a14-a454-7756c3577b91",
                                                "sense_id": "a5201a6a-dd4b-31ee-8661-d9c38bec7c86",
                                                "text": "Flüchtigkeit oder auch Volatilität ist ein Einteilungskriterium für Lösungsmittel."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e799619c-dd0b-4eec-9aaa-9d3cff1fc15b",
