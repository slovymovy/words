                                        "glosses": [
                                            "Schlag, ausgeführt mit einem Hammer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "823071df-2dab-4c5a-a8f5-1bcd2741df4e",
                                                "sense_id": "8669db94-225b-3362-81a3-d047bdd50433",
                                                "text": "Die Hammerschläge dröhnten durch die Montagehalle."
                                            },
                                            {
                                                "example_id": "0dc00cfa-db58-4e9e-826e-8506016f8fc0",
                                                "sense_id": "8669db94-225b-3362-81a3-d047bdd50433",
                                                "text": "„Alle anderen hatten ihre Arbeit zurückerhalten, nur er nicht, und bereits am nächsten Tag würden wieder Hammerschläge von der Amtmannsburg zu hören sein.“"
                                            },
                                            {
                                                "example_id": "adc08505-bb6b-489e-bea6-d67f740e2d8c",
                                                "sense_id": "8669db94-225b-3362-81a3-d047bdd50433",
                                                "text": "„Der Hammerschlag ist mit seinem Echo verhallt, die Stille des Gebirgstals hat ihn in sich aufgenommen; aber das Gezwitscher des Regenpfeifers tönt weiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4c02ac13-5c31-3895-962a-3b1bc0da33f3",
                                        "entry_id": "c042f3b7-03fb-3b29-851f-427da46180fe",
                                        "glosses": [
                                            "Überzug mit einem Lack, der eine spezielle Optik erzeugt, die an Schläge mit einem Hammer erinnert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
