                    {
                        "sense_id": "456a2414-2710-3f42-8f30-f6cf8aab8158",
                        "entry_id": "5a4ac104-7f14-32f2-9a2e-a492f1c3489e",
                        "glosses": [
                            "Pilzgattung aus der Familie Physalacriaceae; häufig in Grüppchen oder Büscheln an Baumstümpfen lebender Blätterpilz, Schädling der Bäume"
                        ],
                        "tags": [
                            "Pilzkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "2692d9a3-01bd-4616-8f38-af17ce45db41",
                                "sense_id": "456a2414-2710-3f42-8f30-f6cf8aab8158",
                                "text": "Hast du Hallimasch gesammelt?"
                            },
                            {
                                "example_id": "dbaaeae0-57f6-455c-85b9-d1bd249b93d9",
                                "sense_id": "456a2414-2710-3f42-8f30-f6cf8aab8158",
                                "text": "„Und dieses Netz wird alt: Ein bestimmter Hallimasch in der Schweiz wurde auf ein Alter von etwa 1000 Jahren geschätzt, ein anderer in den USA, dessen Myzel sich auf rund neun Quadratkilometern verbreitet hat, auf circa 2400 Jahre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "496fc1f9-141a-4889-a62a-439dd853455e",
                        "source_entry_id": "5a4ac104-7f14-32f2-9a2e-a492f1c3489e",
                        "source_sense_id": "456a2414-2710-3f42-8f30-f6cf8aab8158",
                        "target_lang_word": "honey fungus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "honey fungus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75da6498-c111-3d11-87a8-a9059a939f47",
                                        "entry_id": "c1463c8c-7319-3424-8c8c-7af62df009f3",
                                        "glosses": [
                                            "A parasitic mushroom of the genus Armillaria that lives on trees and shrubs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00d02605-6a05-4d8b-b76b-4909bdd20e70",
                                                "sense_id": "75da6498-c111-3d11-87a8-a9059a939f47",
                                                "text": "The common edible Mushroom or Honey-fungus (Agaricus melleus) is also a very common, and in many places a very dangerous, parasite in young crops of conifers, which, however, also occurs extensively as a saprophyte on dead stools and roots of old trees, especially of Beeches."
                                            },
                                            {
                                                "example_id": "4216e353-e85b-473c-831b-dfda6bdec7a9",
                                                "sense_id": "75da6498-c111-3d11-87a8-a9059a939f47",
                                                "text": "Zhu ling grows on honey fungi (Armelliaria mellea) rhizomorph for nutrients, leading to a unique cultivation process (Huang 1993, Yao & Huang 1993)."
                                            },
                                            {
                                                "example_id": "e04d6c62-bd78-486e-b070-8d08e1e55ea4",
                                                "sense_id": "75da6498-c111-3d11-87a8-a9059a939f47",
                                                "text": "Honey fungus (Armillaria mellea) is most obvious when, in autumn, clumps of honey-coloured, pale-stemmed toadstools appear at the base of a tree."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4193c7cb-c04e-4779-b566-7dec7ec381c0",
                        "source_entry_id": "5a4ac104-7f14-32f2-9a2e-a492f1c3489e",
                        "source_sense_id": "456a2414-2710-3f42-8f30-f6cf8aab8158",
                        "target_lang_word": "pourridié",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pourridié",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "739cd8e9-9cfb-3f8b-8f75-7e76b3a2dd8f",
                                        "entry_id": "49a476e3-366e-37cb-b9eb-594a686902a1",
                                        "glosses": [
                                            "Maladie des végétaux ligneux (vigne et arbres fruitiers) causée par un champignon qui entraîne la décomposition du bois des racines des arbres, arbustes et arbrisseaux. Ce champignon parasite, l'armillaire Armillaria mellea, attaque les racines et entraine la mort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69672298-4baf-4230-9ec9-ab216e6406b0",
                                                "sense_id": "739cd8e9-9cfb-3f8b-8f75-7e76b3a2dd8f",
                                                "text": "Le pourridié est une maladie parasitaire due à des champignons qui se développent sur les racines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f271bf3-0ab3-4296-8d33-3133294d2db6",
                        "source_entry_id": "5a4ac104-7f14-32f2-9a2e-a492f1c3489e",
                        "source_sense_id": "456a2414-2710-3f42-8f30-f6cf8aab8158",
                        "target_lang_word": "armillaire couleur de miel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "armillaire couleur de miel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3d7d1e3-bf64-3d76-b3ec-3743b3dbda0c",
                                        "entry_id": "bc736778-7f3a-3096-aa85-56a169fea4bb",
                                        "glosses": [
                                            "Espèce de champignons à lames et à anneau ou armille, typiquement fasciculé, extrêmement polymorphe, de la couleur du miel quand il est jeune et qui pousse au pied des arbres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22ddb0da-54cd-497f-8db6-fc1d4a5e9d93",
                                                "sense_id": "c3d7d1e3-bf64-3d76-b3ec-3743b3dbda0c",
                                                "text": "D’autres ne se consomment que jeunes, comme le bolet orangé… ou ne seront comestibles que bien cuits : bolet granulé, armillaire couleur de miel, russule olivacée, shiitakes, morilles, etc."
                                            },
                                            {
                                                "example_id": "2e365d14-f164-4390-a1b9-96c27e0dc6ec",
                                                "sense_id": "c3d7d1e3-bf64-3d76-b3ec-3743b3dbda0c",
                                                "text": "Quelques kilos de souchettes, armillaires couleur de miel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
