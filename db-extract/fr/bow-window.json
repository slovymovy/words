                                                "sense_id": "ad84424c-3d41-31f4-a8cb-b7fbc532101e",
                                                "text": "Marriages that are based only on sex appeal generally fizzle out as soon as he gets a bay window and her figure becomes a bit lumpish."
                                            },
                                            {
                                                "example_id": "de02448d-1c14-477d-a3e7-a03fe0eaac60",
                                                "sense_id": "ad84424c-3d41-31f4-a8cb-b7fbc532101e",
                                                "text": "Bert came hustling up, bumping his way through the kids with his bay window."
                                            }
                                        ]
                                    },
