                                "example_id": "1e6a5d1a-1f94-43d1-8a32-f85a97a13684",
                                "sense_id": "8e7b81d5-1de6-3657-b278-1b5f2bce8d1c",
                                "text": "Een i wordt geschreven als een streepje met een punt erboven."
                            },
                            {
                                "example_id": "340fa58a-3387-43a8-9212-be86593f8fbc",
                                "sense_id": "8e7b81d5-1de6-3657-b278-1b5f2bce8d1c",
                                "text": "De vegetatie hierboven is droog, met hoge donkergroene sparren en dor helmgras."
                            },
                            {
                                "example_id": "7dbf1d64-1b2d-42a8-8034-87c3d0b76505",
                                "sense_id": "8e7b81d5-1de6-3657-b278-1b5f2bce8d1c",
                                "text": "De lucht erboven was donkerder en minder lieflijk; de donkerblauwe vlekken hadden iets nachtmerrieachtigs."
                            }
                        ]
                    }
