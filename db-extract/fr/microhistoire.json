                ],
                "senses": [
                    {
                        "sense_id": "4d16427d-73f0-319d-b06e-2d95982f8cf6",
                        "entry_id": "d50a8218-0cea-30cd-a990-60376093f53e",
                        "glosses": [
                            "Courant historiographique né en Italie au milieu des années 1970 portant sur l’histoire sociale et l’histoire culturelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "714b69aa-be2b-424e-b026-08383ce7e113",
                                "sense_id": "4d16427d-73f0-319d-b06e-2d95982f8cf6",
                                "text": "Le principe de la microhistoire globale est d’articuler deux échelles, locale et mondiale, afin d’en approfondir notre connaissance."
                            },
                            {
                                "example_id": "12327891-9fe7-42e8-b519-805029e38180",
                                "sense_id": "4d16427d-73f0-319d-b06e-2d95982f8cf6",
                                "text": "L’image des acteurs impliqués dans les sources se rapproche d’une vision par clichés photographiques, et cet aspect conduit à recourir à des méthodes proches de la microhistoire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb1dab02-f60c-4159-99d8-2230b15a7a7c",
                        "source_entry_id": "d50a8218-0cea-30cd-a990-60376093f53e",
                        "source_sense_id": "4d16427d-73f0-319d-b06e-2d95982f8cf6",
