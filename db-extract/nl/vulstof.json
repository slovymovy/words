                                        "sense_id": "efca106d-9de1-3475-9174-13c81085fed7",
                                        "entry_id": "f44c6d93-bb4a-3af9-98e6-82f01eb7b0ac",
                                        "glosses": [
                                            "One who extends."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4bc7d5b-981a-432c-b311-21b110a415b2",
                                                "sense_id": "efca106d-9de1-3475-9174-13c81085fed7",
                                                "text": "The public has learned to accept the services of physician extenders as a substitute for a qualified medical doctor, but the medical profession itself will, I daresay, continue to erect substantial barriers to any policy or effort that directly affects income."
                                            },
                                            {
                                                "example_id": "f43c2eef-4a26-498a-b628-b78fd61dd588",
                                                "sense_id": "efca106d-9de1-3475-9174-13c81085fed7",
                                                "text": "[Marc Jacobs] is a colonialist, an extender of brands, and in very good shape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecb19115-dea9-3049-ab16-99b6cead4ee7",
                                        "entry_id": "f44c6d93-bb4a-3af9-98e6-82f01eb7b0ac",
                                        "glosses": [
                                            "Any of various substances designed to extend any of several properties of a material."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d382c721-5e98-41a7-adab-e301d241c8fc",
                                                "sense_id": "ecb19115-dea9-3049-ab16-99b6cead4ee7",
                                                "text": "“Flour” routinely contained crushed stone or gypsum as a cheap extender."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c1712c3-3560-3bba-a171-4719cd886884",
                                        "entry_id": "f44c6d93-bb4a-3af9-98e6-82f01eb7b0ac",
                                        "glosses": [
                                            "Any of various components designed to extend the length of a device."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "200934b1-940f-370a-9940-cfa45e5a857d",
                                        "entry_id": "f44c6d93-bb4a-3af9-98e6-82f01eb7b0ac",
                                        "glosses": [
                                            "Any substance added to food to bulk it out, with a higher protein content than a filler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1d5330c-4ac6-4bb3-b53d-6eec8497be8d",
                                                "sense_id": "200934b1-940f-370a-9940-cfa45e5a857d",
                                                "text": "Soy protein is used as a meat extender."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14a6c400-c0bc-3a73-b43f-e3b6d1ec3d37",
