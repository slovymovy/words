                    },
                    {
                        "sense_id": "42fcf601-c1da-33c2-b280-a53abec74e73",
                        "entry_id": "9bdcfad8-7107-3bfa-8847-da2813dfcb8a",
                        "glosses": [
                            "\\\"60\\\", het getal tussen negenenvijftig en eenenzestig, zes maal tien",
                            "om een hoeveelheid aan te geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1439c13b-786b-4ceb-9daf-0225190f0105",
                                "sense_id": "42fcf601-c1da-33c2-b280-a53abec74e73",
                                "text": "De totale kosten bedragen zestig euro en zevenendertig cent."
                            },
                            {
                                "example_id": "6cb59714-b343-4b7f-aad6-ec0668b54535",
                                "sense_id": "42fcf601-c1da-33c2-b280-a53abec74e73",
                                "text": "Ik ben vandaag zestig jaar oud geworden."
                            }
                        ]
                    },
                    {
                        "sense_id": "83ef4b93-3332-3bfc-b823-3da28a395b23",
                        "entry_id": "9bdcfad8-7107-3bfa-8847-da2813dfcb8a",
                        "glosses": [
                            "\\\"60\\\", het getal tussen negenenvijftig en eenenzestig, zes maal tien",
                            "om een leeftijd aan te geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45795f45-dad9-443c-ad96-c6ee23509d92",
                                "sense_id": "83ef4b93-3332-3bfc-b823-3da28a395b23",
                                "text": "Pamela vertelde me dat hij in de zestig was en een kort lontje had."
                            },
                            {
                                "example_id": "88ec0530-63c4-4c4a-af64-142c76a31fe6",
                                "sense_id": "83ef4b93-3332-3bfc-b823-3da28a395b23",
                                "text": "Jack was een kale man van in de zestig die 35 jaar geleden zelf de PCT had gelopen."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe0ee9d8-d29a-34fe-9bdd-985677732a1e",
                        "entry_id": "9bdcfad8-7107-3bfa-8847-da2813dfcb8a",
                        "glosses": [
                            "\\\"60\\\", het getal tussen negenenvijftig en eenenzestig, zes maal tien",
                            "om een plaats in een volgorde aan te geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a6233c4-d265-45e9-b1ae-1badc007b4ec",
                                "sense_id": "fe0ee9d8-d29a-34fe-9bdd-985677732a1e",
                                "text": "Het juiste antwoord op opgave zestig is \"42\"."
                            },
                            {
                                "example_id": "a4fe5f9d-53a0-4845-a48c-3dc871ae08c2",
                                "sense_id": "fe0ee9d8-d29a-34fe-9bdd-985677732a1e",
                                "text": "Natuurlijk zijn ze in Assen onverminderd trots op 'hun' Harry. Gastconservator Albert Haar noemt hem graag een icoon voor Drenthe, een voorbeeld voor de provinciale jeugd. Maar Muskee was natuurlijk meer dan dat. Met zijn muziek en zijn dwarsheid was hij een exponent van de anarchie van de jaren zestig. Die levenshouding bracht hem fans in heel Nederland."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e644a53-bbf7-40b5-b1a5-6d48fdeacf6c",
                        "source_entry_id": "9bdcfad8-7107-3bfa-8847-da2813dfcb8a",
                        "source_sense_id": "3bf4e020-056c-39a4-a95d-8fa08f7270b4",
