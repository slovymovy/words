                        "examples": [
                            {
                                "example_id": "5ab6d91b-371a-41c3-8ce9-7235dc86fec9",
                                "sense_id": "384b4f68-6132-3797-9644-c2a8aa9d8d00",
                                "text": "Eerste man van het CDA in Naaldwijk, Zwinkels, gelooft dat er de afgelopen periode voldoende aan de leefomstandigheid van de buitenlandse Westlanders is gedaan.",
                                "translation": "The first man of the CDA in Naaldwijk, Zwinkels, believes that enough has been done about the living condition[s] of the foreign inhabitants of Westland in the past time.",
                                "english": "The first man of the CDA in Naaldwijk, Zwinkels, believes that enough has been done about the living condition[s] of the foreign inhabitants of Westland in the past time."
                            },
                            {
                                "example_id": "ee2949b8-bc7d-4d3f-b7ad-0ed16c9179d7",
                                "sense_id": "384b4f68-6132-3797-9644-c2a8aa9d8d00",
                                "text": "zij houden van de dieren, maar zij beseffen tegelijk dat opsluiting in een park niet de ideale leefomstandigheid voor ze is.",
                                "translation": "they love the animals, but they also understand that locking them up in a park isn't the ideal living condition for them.",
                                "english": "they love the animals, but they also understand that locking them up in a park isn't the ideal living condition for them."
                            },
                            {
                                "example_id": "a5fb0aa8-b36a-47ff-8d93-114f4a4ba634",
                                "sense_id": "384b4f68-6132-3797-9644-c2a8aa9d8d00",
                                "text": "Als je in iedere situatie, in ieder groepsverband of iedere leefomstandigheid iemand anders bent, als je morgen iemand anders bent dan vandaag, hoe weet jij zelf en hoe weten anderen dan wie je bent, en wat te midden van alle veranderingen je blijvende identiteit is?",
                                "translation": "If in every situation, every group of people or every living condition you are someone else, if tomorrow you're someone else than today, then how do you know and how do others who you are, and what with all the changes is your stable identity?",
                                "english": "If in every situation, every group of people or every living condition you are someone else, if tomorrow you're someone else than today, then how do you know and how do others who you are, and what with all the changes is your stable identity?"
                            }
                        ]
                    }
