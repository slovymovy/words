                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5de09da7-d7ba-4a7a-bd9e-386b5056efb1",
                                "sense_id": "6e9e48ba-47df-3e21-ab2b-68c584a2bed7",
                                "text": "Il pousse le vantail automatique du tambour et, se retrouvant dans la ruelle qu'illumine faiblement la flamme d'un réverbère parcimonieux, il se dirige vers son logis, sans oublier de ressertir le verre de son monocle dans la griffe osseuse de son arcade sourcilière."
                            },
                            {
                                "example_id": "baf096b3-5c25-4233-848d-f3ed719b22d1",
                                "sense_id": "6e9e48ba-47df-3e21-ab2b-68c584a2bed7",
                                "text": "Ou bien il fera ressertir les pierreries."
                            }
                        ]
                    }
