                        "entry_id": "e1f4a0ff-4d62-37c9-976d-deadafce5fc3",
                        "glosses": [
                            "Action d’ajouter une valeur fixée, en particulier 1, à une variable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d064a87e-7342-4ec2-8934-b0a001371cf8",
                                "sense_id": "87904940-1883-3972-8e3b-515bd8e4d610",
                                "text": "Elle comporte donc, avant son exécution, une préparation qui consiste en un chargement de la valeur initiale et de la limite, un traitement, une « incrémentation » et une condition de limite qui, lorsque celle-ci n’est pas réalisée, renvoie à l’execution du traitement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6420982-7e01-4a67-ba23-15531d782742",
