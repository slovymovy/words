                    {
                        "sense_id": "0fa699c2-337b-3fe6-a516-973122cc66a5",
                        "entry_id": "1627fc08-fe65-3060-9a6f-487a74149640",
                        "glosses": [
                            "Not loaded or stabilised with ballast."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5c249816-39fa-4fd4-96f7-0d4df2008819",
                                "sense_id": "0fa699c2-337b-3fe6-a516-973122cc66a5",
                                "text": "Then, as if the clouds had discharged their aqueous cargo and rode light as unballasted ships, they lifted in aerial fleets and sailed away, white in a blue sky."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f13a818-b12a-3a44-b3f9-d32177513c4b",
                        "entry_id": "1627fc08-fe65-3060-9a6f-487a74149640",
                        "glosses": [
                            "Unstable, liable to flounder."
                        ],
                        "tags": [
                            "figuratively",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "70b91e3a-48ae-4b3b-a465-65c163ce6318",
                                "sense_id": "5f13a818-b12a-3a44-b3f9-d32177513c4b",
                                "text": "It was a rickety concern, was unballasted, and looked as if, loosely thrown together, it had never filled its original mission and had been practically abandoned."
                            }
                        ]
                    }
                ],
