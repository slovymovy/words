                                        "examples": [
                                            {
                                                "example_id": "33b0da6a-059c-497b-8723-1696fdb5ccc7",
                                                "sense_id": "07a2c62d-c564-3580-950c-831fb1b324ff",
                                                "text": "La prima risorsa a mancare dopo più bombardamenti è proprio l'acqua per i sopravvissuti la cui sete è aggravata delle polveri..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef9b3349-e6c6-32d8-bc95-6d55b3a25acd",
                                        "entry_id": "5d1db259-8b7b-3602-92f5-6826a434a653",
                                        "glosses": [
                                            "indirizzamento di particelle verso una sostanza"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d4fbd3f-7842-453f-ae78-09641c5aea72",
                        "source_entry_id": "d7f9bc5d-521c-3f83-9c6a-b32abbd4b543",
                        "source_sense_id": "50146be1-fcc6-3df8-b9c4-6083048a47e0",
                        "source_sense_description": "andauernder Angriff mit schwerem Geschütz oder aus der Luft mit Bomben",
                        "target_lang_word": "bombardement",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bombardement",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "fafc22db-4de9-3496-89af-a814d8840733",
                                        "entry_id": "d5c240b9-2ef3-37d7-b11e-7d8bc53625b9",
                                        "glosses": [
                                            "beschieting met bommen, het werpen van bommen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "268a0cc8-1e02-40d6-a2f4-6d3a629925da",
                                                "sense_id": "fafc22db-4de9-3496-89af-a814d8840733",
                                                "text": "De coalitie is begonnen met het uitvoeren van massale bombardementen op militaire doelen."
                                            },
                                            {
                                                "example_id": "2153bcc0-2563-46ff-baa5-15ae59544725",
                                                "sense_id": "fafc22db-4de9-3496-89af-a814d8840733",
                                                "text": "Alles wat hem berucht heeft gemaakt zat erin: zijn onbedaarlijke snoeverij, zijn haat tegen een deel van de pers (CNN en The New York Times), zijn wraakzucht (hier tegen Spanje), zijn onbetrouwbaarheid bij de evaluatie van gebeurtenissen (de effecten van de bombardementen in Iran)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dca075d4-6af4-3787-b1cb-5506f2f71bfd",
                                        "entry_id": "d5c240b9-2ef3-37d7-b11e-7d8bc53625b9",
                                        "glosses": [
                                            "het getroffen worden door vele zaken"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1e0f770-f3f2-40e0-84de-78b39c694e7b",
                                                "sense_id": "dca075d4-6af4-3787-b1cb-5506f2f71bfd",
                                                "text": "De maan heeft geen atmosfeer, dus je ervaart een voortdurend bombardement van micro-meteorieten en de temperatuurverschillen zijn extreem."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
