                "senses": [
                    {
                        "sense_id": "c79ff037-1417-36f0-98da-4fe98de23d4a",
                        "entry_id": "086e8696-6eaa-3c54-b701-7abda0887596",
                        "glosses": [
                            "historische Person: König der Stadt Uruk in Mesopotamien in frühdynastischer Zeit, von circa 2652 bis 2602 vor Christus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d45e1f2-af1a-4161-b3c7-bda0ac0975d6",
                                "sense_id": "c79ff037-1417-36f0-98da-4fe98de23d4a",
                                "text": "Nach den sumerischen Königslisten war Gilgamesch von 2642 v.Chr. bis 2602 v.Chr. König der Stadt Uruk im Zweistromland."
                            },
                            {
                                "example_id": "cc7796e8-0b8a-4e6d-ab30-58b0fb518e9d",
                                "sense_id": "c79ff037-1417-36f0-98da-4fe98de23d4a",
                                "text": "Über den historischen Gilgamesch ist nicht sehr viel bekannt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9c54a212-2bf9-3e86-b71a-a50a75c07e1b",
                        "entry_id": "086e8696-6eaa-3c54-b701-7abda0887596",
                        "glosses": [
                            "mythische Gestalt, die sich in Anlehnung an [1] im Gilgamesch-Epos, eine der ältesten überlieferten Dichtungen der Menschheit, herausgebildet hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "239a4725-f11a-471b-b697-ba4ca75154b6",
                                "sense_id": "9c54a212-2bf9-3e86-b71a-a50a75c07e1b",
                                "text": "Gilgamesch war zu 1/3 Mensch und zu 2/3 Gott."
                            },
                            {
                                "example_id": "ef0773f1-0426-432e-893c-7ce98466cbc3",
                                "sense_id": "9c54a212-2bf9-3e86-b71a-a50a75c07e1b",
                                "text": "Im Gilgamesch-Epos wird über die Heldentaten des Gilgamesch und eine große Sintflut berichtet, die biblische Autoren wohl als Vorlage für die biblischen Sintflutberichte nahmen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
