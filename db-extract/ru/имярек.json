                "senses": [
                    {
                        "sense_id": "303ec58f-3c84-30d5-84ff-e22ec7de128a",
                        "entry_id": "8a2802b6-996d-3a67-ad5d-5da3ee564c2a",
                        "glosses": [
                            "устар. слово, заменяющее чьё-либо имя или какое-либо название; некто, такой-то"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96a2787d-ebc6-41af-97e1-c75f3d7a941e",
                                "sense_id": "303ec58f-3c84-30d5-84ff-e22ec7de128a",
                                "text": "Вручающий кому-либо эту повесть должен был вставить, вместо имярек, своё имя и имя своего клиента."
                            },
                            {
                                "example_id": "e9d8090f-dc41-4c52-b1f5-237a69b34bb5",
                                "sense_id": "303ec58f-3c84-30d5-84ff-e22ec7de128a",
                                "text": "Им, генетикам, кажется странным, что такой опытный и знающий работник, как имярек, придерживается столь консервативных взглядов…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf18412b-f142-4be2-9108-e0cfae09560b",
                        "source_entry_id": "8a2802b6-996d-3a67-ad5d-5da3ee564c2a",
                        "source_sense_id": "303ec58f-3c84-30d5-84ff-e22ec7de128a",
                        "target_lang_word": "so-and-so",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "so-and-so",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be42d4e0-e9cf-3399-ad0a-fe15e5a324d5",
                                        "entry_id": "290b5642-c72c-39cd-9f2c-320978c559cf",
                                        "glosses": [
                                            "A placeholder name for a person or thing, used when a name is not known; a generic person or thing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67dfab6f-3fdf-4746-8483-b6b8bc8e3624",
                                                "sense_id": "be42d4e0-e9cf-3399-ad0a-fe15e5a324d5",
                                                "text": "She told me to ask so-and-so, but he didn't know, either."
                                            },
                                            {
                                                "example_id": "2ba3b2d2-9e69-4458-ac1d-a55dc7a7b20f",
                                                "sense_id": "be42d4e0-e9cf-3399-ad0a-fe15e5a324d5",
                                                "text": "Business letters normally begin \"Dear Mr So-and-So\"."
                                            },
                                            {
                                                "example_id": "9ce456eb-f102-4a0f-981a-20ee4bcc8b52",
                                                "sense_id": "be42d4e0-e9cf-3399-ad0a-fe15e5a324d5",
                                                "text": "He will tell you to do so-and-so, but read the instructions first, anyway."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14dabfa6-4e3d-3eb9-8b00-79d29fa2ecea",
                                        "entry_id": "290b5642-c72c-39cd-9f2c-320978c559cf",
                                        "glosses": [
                                            "Used in place of epithets such as SOB, bastard, etc."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a520abee-de0b-47f0-8748-ea2c63f416b2",
                                                "sense_id": "14dabfa6-4e3d-3eb9-8b00-79d29fa2ecea",
                                                "text": "That miserable so-and-so messed up my work!"
                                            },
                                            {
                                                "example_id": "ca763a2a-dc7c-4bf0-8a28-b938ede7166c",
                                                "sense_id": "14dabfa6-4e3d-3eb9-8b00-79d29fa2ecea",
                                                "text": "“How can five hundred pounds become a hundred thousand pounds?!”\n“I’m not a bank,” snapped Mr Big.\n“No, you just rob them!” said Frank.\n“Cocky little so-and-so, aren’t you?”"
                                            },
                                            {
                                                "example_id": "fbe8f25f-1c82-4747-939f-c0db98db34cc",
                                                "sense_id": "14dabfa6-4e3d-3eb9-8b00-79d29fa2ecea",
                                                "text": "Greg [Wise]’s excellent to work with. Funny and incredibly playful. He gets to be married to me by day and Emma Thompson by night. What a lucky so-and-so. We all want to be married to Emma Thompson, don’t we? I certainly do."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0576de65-cc16-4b2b-b9f5-6c85995b54f3",
                        "source_entry_id": "8a2802b6-996d-3a67-ad5d-5da3ee564c2a",
