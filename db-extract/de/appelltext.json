                "senses": [
                    {
                        "sense_id": "02eeef1a-d95e-36a1-8904-d1b0fd3a48fa",
                        "entry_id": "1af361db-2b4e-38ca-adce-567b20780433",
                        "glosses": [
                            "Text, dessen hauptsächliche Textfunktion der Appell an den Hörer / Leser ist, etwas zu tun oder zu unterlassen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4715279-2cc5-4c9f-808e-4647b9059335",
                                "sense_id": "02eeef1a-d95e-36a1-8904-d1b0fd3a48fa",
                                "text": "Werbetexte sind Appelltexte, da ihre Hauptfunktion darin besteht, den Leser/ Hörer zum Kauf einer Ware zu bewegen."
                            },
                            {
                                "example_id": "4048ac69-0e8f-4f5a-92cd-90e325dcef6c",
                                "sense_id": "02eeef1a-d95e-36a1-8904-d1b0fd3a48fa",
                                "text": "„Wie schon bei der Diskussion zur Informationsfunktion muss aber auch hier beachtet werden, dass es grundsätzlich möglich ist, das Horoskop als Appelltext zu lesen…“"
                            },
                            {
                                "example_id": "ab93b8c2-168d-4ade-baca-490404c1bb20",
                                "sense_id": "02eeef1a-d95e-36a1-8904-d1b0fd3a48fa",
                                "text": "„Seine Anwendung führt zur Unterscheidung der folgenden fünf Textklassen: …- Appelltexte (Werbeanzeige, Kommentar, Gesetz, Antrag…)...“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
