                                            {
                                                "example_id": "4322a54f-2308-4602-b62c-f96beae6e5be",
                                                "sense_id": "6e8fb966-56c8-3c27-a0b0-5d09405df1f8",
                                                "text": "En découvrant la forme allongée tapie au milieu de la chaussée, les filles poussèrent un cri. Sauf Nadine, qui freina, amorça un tête-à-queue, contrebraqua, redonna un peu de gomme, puis freina à nouveau en rétrogradant."
                                            },
                                            {
                                                "example_id": "a59fd1d3-756d-4386-b431-915b43840e3f",
                                                "sense_id": "6e8fb966-56c8-3c27-a0b0-5d09405df1f8",
                                                "text": "Nadine Lemercier sortit la première, suivie de l’adjudant-chef Greudin armé du pistolet-mitrailleur."
                                            },
                                            {
                                                "example_id": "1e4ab8d2-f203-4dc1-99c0-6c474d1d1bd3",
                                                "sense_id": "6e8fb966-56c8-3c27-a0b0-5d09405df1f8",
                                                "text": "On est très malheureux, regrette Nadine Bonnefoy, une des responsables du parc."
                                            }
                                        ]
