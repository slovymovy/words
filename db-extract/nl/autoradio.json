                                        "entry_id": "ab02e522-3bfd-330d-9fb8-7f7af253e1a7",
                                        "glosses": [
                                            "A radio receiver fitted in a car, typically on or just below the dashboard, sometimes with specific features for use while driving, such as traffic alert interrupts and alternative frequency functions (switching frequencies as one moves in and out of range of transmitters)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "86fa384d-c3e0-3f23-a78f-82d355cce02e",
                                        "entry_id": "ab02e522-3bfd-330d-9fb8-7f7af253e1a7",
                                        "glosses": [
                                            "An on-board entertainment system in a car, usually including a radio receiver as well as the capability to play audio from recorded media."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e42f6e71-1f64-4034-b517-1b7839f4ed3a",
                                                "sense_id": "86fa384d-c3e0-3f23-a78f-82d355cce02e",
                                                "text": "If you’ve ever turned the key in your ignition and noticed that your car radio isn’t tuning in to your favourite station or playing your carefully curated playlist, the problem could be a security code. A car radio code is a password to access your vehicle's audio system - a combination of button presses designed to deter thieves from stealing your radio and using it in another vehicle."
                                            }
                                        ]
                                    }
