                    },
                    {
                        "sense_id": "8d07c567-cee8-3e9a-b74c-aaec010c8545",
                        "entry_id": "55ef6829-0afd-31e3-9a3a-82c815257512",
                        "glosses": [
                            "Contaminé par un virus."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "24122e68-db6e-4489-850d-a0e7668d0414",
                                "sense_id": "8d07c567-cee8-3e9a-b74c-aaec010c8545",
                                "text": "Contrairement à ce que dira le pirate pour nous convaincre d’exécuter son logiciel vérolé, l’alerte de l’antivirus n’est pas un faux positif."
                            }
                        ]
                    },
                    {
                        "sense_id": "b20ed768-7268-398d-bcd3-3780b4d7c16c",
                        "entry_id": "55ef6829-0afd-31e3-9a3a-82c815257512",
                        "glosses": [
                            "Corrompu."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "bab769a9-58ae-43b8-afc5-766b1bc6738d",
                                "sense_id": "b20ed768-7268-398d-bcd3-3780b4d7c16c",
                                "text": "Des policiers pour regardants — ou pire ? — ont conclu au suicide. Et le père de la jeune fille hurle à l’enquête vérolée."
                            }
                        ]
                    },
                    {
                        "sense_id": "484a4876-ae27-316a-af85-8d8541e3e579",
                        "entry_id": "55ef6829-0afd-31e3-9a3a-82c815257512",
                        "glosses": [
                            "Abimé, esquinté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22880cea-73b1-42b3-88fc-8520e13fe872",
                                "sense_id": "484a4876-ae27-316a-af85-8d8541e3e579",
                                "text": "Le dos appuyé contre le montant vérolé de la fenêtre, Henry tendit l’oreille."
                            }
                        ]
                    }
