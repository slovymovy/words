            "senses": [
                {
                    "sense_id": "1069590f-e8ab-319d-baa7-51c0dd3b02f8",
                    "sense_definition": "Not showing or feeling pain, distress, or emotion; enduring suffering without complaint.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He remained <w>stoic</w> despite the sudden bad news.          "
                        },
                        {
                            "text": "She maintained a <w>stoic</w> attitude during the difficult trial.          "
                        }
                    ],
                    "synonyms": [
                        "stoical",
                        "impassive"
                    ],
                    "common_phrases": [
