                    {
                        "sense_id": "8bd047d5-881d-3cf0-a500-a4968540b274",
                        "entry_id": "bb1c9161-e012-3e35-8040-2fc046887a3a",
                        "glosses": [
                            "To make an autocorrection; to correct something automatically."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2b5d6611-14f4-4158-9c94-09d7102bf82a",
                                "sense_id": "8bd047d5-881d-3cf0-a500-a4968540b274",
                                "text": "In [16], motion-free MR brain (Figure 2a) image was corrupted with motion artifacts and the resulting image (Figure 2b) was autocorrected to fix the motion artifacts."
                            },
                            {
                                "example_id": "7c739cc5-c8b5-4ec7-9f5c-eabde5692b32",
                                "sense_id": "8bd047d5-881d-3cf0-a500-a4968540b274",
                                "text": "But the good news is that it autocorrects all of your subcommunications."
                            },
                            {
                                "example_id": "1f879c2b-58ed-40db-9474-733d4a4187bf",
                                "sense_id": "8bd047d5-881d-3cf0-a500-a4968540b274",
                                "text": "The computer usually defaults to autocorrecting certain spellings and capitalising first words of sentences."
                            },
                            {
                                "example_id": "63ea051e-f2bc-4f4e-8fbb-27f9ae1338e5",
                                "sense_id": "8bd047d5-881d-3cf0-a500-a4968540b274",
                                "text": "That is the angriest Lindsey Graham has been about a cellphone since his name got autocorrected to “Linty Grandma”. “Stupid phone! Luhn mah name, Ah am your bawss! Stupid! So duhmb!”."
                            }
                        ]
                    }
                ],
