                        "glosses": [
                            "industriell hergestellter, beliebiger Gegenstand, der (ohne dass Veränderungen daran vorgenommen werden) als Kunstwerk betrachtet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
