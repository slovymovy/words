                    }
                ],
                "senses": [
                    {
                        "sense_id": "a11caf4b-8363-3cfc-844d-fabc746138bc",
                        "entry_id": "7e0d43f0-71b2-31f7-a2a7-70066c6b47e1",
                        "glosses": [
                            "van weinig of geen comfort voorzien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce5795bf-a503-4743-a9ce-2a28d2ae4138",
                                "sense_id": "a11caf4b-8363-3cfc-844d-fabc746138bc",
                                "text": "Mlle Staabs ijdeltuiterij stond haaks op de liefdevolle soberheid in huize Stork. Vader ohan Charles Stork was opgegroeid in het spartaanse huis van natuurliefhebber Boer Stork; moeder Uta (Guretta Elisabeth) Stam kwam uit Nijverdal."
                            },
                            {
                                "example_id": "440038f3-3759-49af-b8c6-2f2203c18108",
                                "sense_id": "a11caf4b-8363-3cfc-844d-fabc746138bc",
                                "text": "Spartaans, zo omschreef hij het interieur. Er hoefde niet veel boedel te worden verkocht. Als wij het goed vonden, wilde hij wel een opkoper regelen om de etage van Nico leeg te ruimen."
                            },
                            {
                                "example_id": "5cca78d3-ea22-4970-943c-3d868d5d687a",
                                "sense_id": "a11caf4b-8363-3cfc-844d-fabc746138bc",
                                "text": "Het voorzitterschap moet de geloofwaardigheid van de Grieken, na jaren van berichten over deplorabel bestuur, enigszins herstellen. Het is voor de Grieken een pr-exercitie in spaarzaamheid. Ze willen laten zien dat ze het nog zuiniger aan kunnen doen dan Ierland, een ander crisisland dat in juni 2013 een succesvol voorzitterschap afsloot waaraan het 51 miljoen euro spendeerde. Maximaal 50 miljoen euro wil Griekenland uitgeven. Onderminister van Buitenlandse Zaken Dimitris Kourkalas noemt het voorzitterschap half-grappend „Spartaans”."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad4fa42a-2477-4bc1-8962-3c4b12c025e9",
                        "source_entry_id": "7e0d43f0-71b2-31f7-a2a7-70066c6b47e1",
                        "source_sense_id": "a11caf4b-8363-3cfc-844d-fabc746138bc",
                        "source_sense_description": "zonder luxe",
                        "target_lang_word": "spartan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spartan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a216c036-d47c-3ba3-b496-3923bda0a6e8",
                                        "entry_id": "e7d0d5c8-0ab4-3ddc-b1ec-c9f1e2b3d4be",
                                        "glosses": [
                                            "Austere, frugal, characterized by self-denial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "216b6969-d1b2-42f6-8f86-55fa061abaf3",
                                                "sense_id": "a216c036-d47c-3ba3-b496-3923bda0a6e8",
                                                "text": "I went on the retreat to the monastery, thinking I would be sleeping in a spartan cell, only to discover a simple but comfortable bedroom."
                                            },
                                            {
                                                "example_id": "bddbcebf-59a5-4f2c-8cc1-8a0cda957e26",
                                                "sense_id": "a216c036-d47c-3ba3-b496-3923bda0a6e8",
                                                "text": "The engine was Class \"3\" 2-6-2 tank No. 82013, with Driver Sampson (Exmouth), and its roomy draught-free cab was a striking contrast to the spartan comfort offered on the Drummond tank."
                                            },
                                            {
                                                "example_id": "13db045e-2770-4c79-825c-3a41c21c3205",
                                                "sense_id": "a216c036-d47c-3ba3-b496-3923bda0a6e8",
                                                "text": "Among its findings, the report says: \"In recent years we have seen more stations transformed from run-down Victorian hulks, or spartan bus-sheltered platforms, into places that people can take pride in, feel comfortable in using, and which are fulfilling more of their wider potential."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a0e2ff4-89b4-31e5-983a-fa2130fa5ca1",
                                        "entry_id": "e7d0d5c8-0ab4-3ddc-b1ec-c9f1e2b3d4be",
                                        "glosses": [
                                            "Resolute in the face of danger or adversity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b4d34cc-9389-41bc-937c-0b238755ab84",
                                                "sense_id": "6a0e2ff4-89b4-31e5-983a-fa2130fa5ca1",
                                                "text": "The spartan legionaries vowed to fight to the death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3fb6135-baed-31be-9d95-998ea37113b3",
                                        "entry_id": "e7d0d5c8-0ab4-3ddc-b1ec-c9f1e2b3d4be",
                                        "glosses": [
                                            "Lacking in decoration and luxury."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5180808-9cc4-4b34-8c0b-63f69c191a38",
                                                "sense_id": "b3fb6135-baed-31be-9d95-998ea37113b3",
                                                "text": "After ten years as a fashion designer in the rough-and-tumble Garment District, Eloise left New York for the spartan but serene life of a farmer's wife."
                                            },
                                            {
                                                "example_id": "010841d0-c7b0-427e-9971-dd9dde9c3abf",
                                                "sense_id": "b3fb6135-baed-31be-9d95-998ea37113b3",
                                                "text": "[I]t was furnished with the spartan simplicity which characterizes womanless quarters."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52f84d04-5cbc-4f3a-ae2c-c7f2fd9c9bde",
                        "source_entry_id": "7e0d43f0-71b2-31f7-a2a7-70066c6b47e1",
                        "source_sense_id": "a11caf4b-8363-3cfc-844d-fabc746138bc",
                        "source_sense_description": "zonder luxe",
                        "target_lang_word": "austere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "austere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "346a6a76-bb62-37dc-ac51-98d10674c74f",
                                        "entry_id": "5cd07e3a-cbd5-302b-b9c3-dfc8f4a88a78",
                                        "glosses": [
                                            "Grim or severe in manner or appearance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b72d191e-3c33-4b3c-893e-bee517d6a450",
                                                "sense_id": "346a6a76-bb62-37dc-ac51-98d10674c74f",
                                                "text": "The headmistress was an austere old woman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41fcaef3-f0d6-3ac3-b061-b282777f261d",
                                        "entry_id": "5cd07e3a-cbd5-302b-b9c3-dfc8f4a88a78",
                                        "glosses": [
                                            "Lacking decoration; trivial; not extravagant or gaudy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3754cdf8-6292-4f3a-882f-fdd92be83bd4",
                                                "sense_id": "41fcaef3-f0d6-3ac3-b061-b282777f261d",
                                                "text": "The interior of the church was as austere as the parishioners were dour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e07dba6-11cb-3d78-86d9-8cded56d7691",
                                        "entry_id": "5cd07e3a-cbd5-302b-b9c3-dfc8f4a88a78",
                                        "glosses": [
                                            "Adhering to the economic policy of austerity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dd54336-cb51-4cc7-bf13-507bad4f8dd8",
                                                "sense_id": "2e07dba6-11cb-3d78-86d9-8cded56d7691",
                                                "text": "Counterintuitively, in an effort to be austere and save money, cities which only remove a crossing every couple of years manage to be way less efficient at it than Melbourne has been."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "599456ac-cb82-3b13-aaa1-64213d307dc0",
                                        "entry_id": "5cd07e3a-cbd5-302b-b9c3-dfc8f4a88a78",
                                        "glosses": [
                                            "Harsh; astringent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b409ce3-b9ba-4bbc-b00e-d81a7e1ff7d1",
                                                "sense_id": "599456ac-cb82-3b13-aaa1-64213d307dc0",
                                                "text": "It is like a small plum, nearly globular in shape, black covered with a bluish bloom, and with a very austere taste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
