                "senses": [
                    {
                        "sense_id": "094ffaa0-6c60-3b6e-8ec5-9f3ed35c7bc6",
                        "entry_id": "528577ef-0345-32a6-a339-63f3a432d681",
                        "glosses": [
                            "Doux et léger comme le zéphyr."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2fb5105-ffa9-488b-b6b8-c92e08bfd679",
                                "sense_id": "094ffaa0-6c60-3b6e-8ec5-9f3ed35c7bc6",
                                "text": "Plus on supprimera d’accents circonflexes, plus on retirera de grâce zéphyrienne à notre langue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e66a0986-0fec-4711-8443-26c69cc7ae3a",
                        "source_entry_id": "528577ef-0345-32a6-a339-63f3a432d681",
                        "source_sense_id": "094ffaa0-6c60-3b6e-8ec5-9f3ed35c7bc6",
                        "target_lang_word": "zephyrous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zephyrous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15ce63f8-7b27-31db-8baf-8218293e8281",
                                        "entry_id": "352cff21-8fd3-3f4a-894e-03cb3700afb9",
                                        "glosses": [
                                            "Like a zephyr; (of a wind) soft, gentle, refreshing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72d03d5a-db71-4841-95aa-0209929830db",
                                                "sense_id": "15ce63f8-7b27-31db-8baf-8218293e8281",
                                                "text": "Hither no winds, but zephyrous breaths repair,\nSoft, as the sighs of love sick virgins are!"
                                            },
                                            {
                                                "example_id": "3cb64343-7b3e-42ab-9e9a-d4b6d086ed48",
                                                "sense_id": "15ce63f8-7b27-31db-8baf-8218293e8281",
                                                "text": "1800, Frederick Howard, Earl of Carlisle, The Stepmother, London: R.H. Evans, Act V, Scene 1, p. 75,\nThe last night’s tempest was a zephyrous gale,\nTo the rough storm that tears his frame to atoms:"
                                            },
                                            {
                                                "example_id": "241e0e63-dac4-400e-8de7-774258c049db",
                                                "sense_id": "15ce63f8-7b27-31db-8baf-8218293e8281",
                                                "text": "And the blossom as scarlet as blood, the single, the starry, the strong,\nIs the Alpine love that is nurtured in clefts of the toiler’s life,—\nThe love that is sought not in languor nor chanted in zephyrous song,\nBut held in the heart of the storm when the soul has been wed to a wife."
                                            },
                                            {
                                                "example_id": "54e467db-52ec-492e-8197-3cb8ab0c7e65",
                                                "sense_id": "15ce63f8-7b27-31db-8baf-8218293e8281",
                                                "text": "He used to be impatient of poems about budding flowers and zephyrous breezes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a2cf0f6-7671-393a-831f-442dc9055a80",
                                        "entry_id": "352cff21-8fd3-3f4a-894e-03cb3700afb9",
                                        "glosses": [
                                            "Breezy; blown by a breeze."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0eaa259-22ae-48de-b936-b4288b07988d",
                                                "sense_id": "4a2cf0f6-7671-393a-831f-442dc9055a80",
                                                "text": "It was March now, the mild March of an early spring. There came new days, zephyrous and sweet."
                                            },
                                            {
                                                "example_id": "633476e0-0e9a-4d87-ac6b-384e44c2c3a5",
                                                "sense_id": "4a2cf0f6-7671-393a-831f-442dc9055a80",
                                                "text": "Green-hatted doormen awaken the eve\nin statuary-niched yellow lobbies—\nzephyrous canyons brightlit, gray stone Empire State\ntoo small to be God\nlords it over sweet Macy’s & Seafood City\nby junkie Grant Hotel—"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f74ffe1f-50c9-364e-9b96-17ca15b98eeb",
                                        "entry_id": "352cff21-8fd3-3f4a-894e-03cb3700afb9",
                                        "glosses": [
                                            "Light, fine, soft. (of a fabric, garment, etc.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "520b3464-24b2-42d0-8464-0dd944541bbe",
                                                "sense_id": "f74ffe1f-50c9-364e-9b96-17ca15b98eeb",
                                                "text": "1895, “Feminine Affairs” in To-Day (magazine edited by Jerome K. Jerome), Volume 9, Number 111, 21 December, 1895, p. 200,\nThat there will be flying machines before very long seems more than likely, and what deliciously zephyrous and diaphanous costumes will not the milliners devise for airy recreations in the near future!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
