                                "example_id": "694cc99b-ff42-4a66-97aa-f3561ed80282",
                                "sense_id": "f9b9e5dd-6899-3d81-a7d2-38642561bde1",
                                "text": "Danella kam in der zweiten Märzwoche und blieb bis zum Sommer."
                            },
                            {
                                "example_id": "10f004fb-cb0b-4cff-89b3-825a958cc0a5",
                                "sense_id": "f9b9e5dd-6899-3d81-a7d2-38642561bde1",
                                "text": "„In der ersten Märzwoche wurden sie von einem Glasfäden-Regen überrascht, der aus der flüssigen Lava entstanden war.“"
                            }
                        ],
