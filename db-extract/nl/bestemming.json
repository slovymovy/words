                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "201d2a67-cac9-413b-8027-9a804989a3e4",
                                                "sense_id": "cbf371ae-9c4c-355e-a53e-ef51f643f611",
                                                "text": "Das Schiff wurde seiner Bestimmung zugeführt und zu Wasser gelassen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f92c6d8b-e539-32c5-a105-d5cd4d7bd6f4",
                                        "entry_id": "fe356a54-8abc-3e51-81b6-207ddd6f3c45",
                                        "glosses": [
                                            "Zielort eines Reisenden oder einer Warensendung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71f5a9f0-8ae9-4a7b-9c5c-4155daa88104",
                                                "sense_id": "f92c6d8b-e539-32c5-a105-d5cd4d7bd6f4",
                                                "text": "Nach langer Reise erreichte er seine Bestimmung."
                                            },
                                            {
                                                "example_id": "4bccb288-fe55-4b24-8314-600f35106994",
                                                "sense_id": "f92c6d8b-e539-32c5-a105-d5cd4d7bd6f4",
                                                "text": "„Die Sehnsucht nach Tiefenerkenntnis der göttlichen Bestimmung des Menschen ist zeitlos.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "faa2d784-85e9-36bc-baeb-4de11e8885f7",
                                        "entry_id": "fe356a54-8abc-3e51-81b6-207ddd6f3c45",
                                        "glosses": [
                                            "das, was schon vorbestimmt ist; Berufung, Schicksal"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a75ceea5-69c5-4c02-a074-1616fffccb34",
                                                "sense_id": "faa2d784-85e9-36bc-baeb-4de11e8885f7",
                                                "text": "Seine Bestimmung ist es, Polizist zu werden."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "553a330c-fccd-3cf1-93f8-a8e0095162c0",
                                        "entry_id": "fe356a54-8abc-3e51-81b6-207ddd6f3c45",
                                        "glosses": [
                                            "wissenschaftliche Ermittlung, zum Beispiel von Pflanzen, von chemischen Zusammensetzungen etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9bd1e5f-501c-4fe3-94e9-6af8c640adce",
                                                "sense_id": "553a330c-fccd-3cf1-93f8-a8e0095162c0",
                                                "text": "Die Bestimmung des Alters der Fossilien gestaltete sich schwierig."
                                            },
                                            {
                                                "example_id": "d9968409-6cdf-4c2b-88af-bdbeaf3f51f9",
                                                "sense_id": "553a330c-fccd-3cf1-93f8-a8e0095162c0",
                                                "text": "„Das war der Tag, an dem ich die ersten Proben mitnahm. Sie vertrockneten später im Labor, weil Laura und Henrik sich nicht dafür interessierten, weil Angela im Vorprüfungsstress war und ich an der Bestimmung scheiterte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "c7c0c404-e9cc-30b5-a49b-1f47df5f2d0e",
                                        "entry_id": "fe356a54-8abc-3e51-81b6-207ddd6f3c45",
                                        "glosses": [
                                            "Satzteil, der einen Umstand angibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15a392fb-d863-492e-96b4-685a071c8606",
                                                "sense_id": "c7c0c404-e9cc-30b5-a49b-1f47df5f2d0e",
                                                "text": "In dem Satz „Sie läuft auf dem Balkon“ ist „auf dem Balkon“ eine adverbiale Bestimmung."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
