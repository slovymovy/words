                        "form": "ха́мствами"
                    },
                    {
                        "form_id": "fe38a20e-fd65-419e-aabf-64ce225e651d",
                        "entry_id": "0dad7f67-75b9-3ae4-ae91-dca4775db8c4",
                        "tags": [
