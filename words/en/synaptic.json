{
    "word_family": [
        "synapse",
        "synapsis",
        "synaptically"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4fcd4901-b141-3bdf-9a32-49a563554297",
                    "sense_definition": "Relating to a synapse, the junction between nerve cells where impulses are transmitted.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "neuroscience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The drug is designed to improve <w>synaptic</w> transmission between neurons in the brain.",
                            "target_lang_translations": {
                                "zh": "该药物旨在改善大脑神经元之间的<w>突触</w>传递。"
                            }
                        },
                        {
                            "text": "Learning and memory formation depend heavily on changes in <w>synaptic</w> plasticity.",
                            "target_lang_translations": {
                                "zh": "学习和记忆的形成在很大程度上依赖于<w>突触</w>可塑性的变化。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "synaptic cleft",
                        "synaptic transmission",
                        "synaptic plasticity"
                    ],
                    "target_lang_definitions": {
                        "zh": "神经元的突触（神经元之间传递神经冲动的连接处）的，与突触相关的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "突触的",
                                "target_lang_sense_clarification": "神经生物学中指神经元突触结构或功能"
                            },
                            {
                                "target_lang_word": "突触",
                                "target_lang_sense_clarification": "作定语直接修饰名词，如突触间隙、突触可塑性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d37ca056-ae2f-3989-a0fd-5cfe440aed22",
                    "sense_definition": "Relating to synapsis, the pairing of homologous chromosomes during meiosis.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "genetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researchers observed the <w>synaptic</w> pairing of chromosomes under a high-powered microscope.",
                            "target_lang_translations": {
                                "zh": "研究人员在高倍显微镜下观察到了染色体的<w>联会</w>配对。"
                            }
                        },
                        {
                            "text": "Any disruption during this <w>synaptic</w> stage can lead to severe genetic abnormalities.",
                            "target_lang_translations": {
                                "zh": "在这一<w>联会</w>阶段发生的任何紊乱都可能导致严重的遗传异常。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（减数分裂中同源染色体）配对的，联会的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "联会的",
                                "target_lang_sense_clarification": "遗传学中指染色体减数分裂时的配对"
                            },
                            {
                                "target_lang_word": "联会",
                                "target_lang_sense_clarification": "作定语修饰阶段、配对等"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}