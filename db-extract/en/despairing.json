                                        "examples": [
                                            {
                                                "example_id": "1a04599b-a933-4f7f-9f8b-0718e66c300a",
                                                "sense_id": "13396873-161f-3ce5-ab44-163c4926d44e",
                                                "text": "Mein Leben ist am Ende, ich fühle mich so verzweifelt."
                                            },
                                            {
                                                "example_id": "7f43259f-c8f4-4940-bb07-bd4564190638",
                                                "sense_id": "13396873-161f-3ce5-ab44-163c4926d44e",
                                                "text": "Hurrikan \"Katrina\": Viele Menschen warten auf ihren Hausdächern verzweifelt auf Rettung, während rings um sie herum die Wassermassen steigen."
                                            },
                                            {
                                                "example_id": "98bf9529-6542-46bb-a1df-70e6a464a9a6",
                                                "sense_id": "13396873-161f-3ce5-ab44-163c4926d44e",
                                                "text": "Schottlands Regierungschef, Alex Salmond, der das Unabhängigkeitsreferendum lanciert hatte, verspottete die Versprechungen [des britischen Premierministers D. Cameron] als ein \"verzweifeltes, leeres Angebot in letzter Minute\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a5864493-aec4-3d80-a673-fe8cd069f443",
                                        "entry_id": "57e9631f-2020-3d2b-8be2-f6fc390d544a",
                                        "glosses": [
