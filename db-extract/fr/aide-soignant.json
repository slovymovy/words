                                                "sense_id": "fddf8bb7-48f2-3fb1-b428-4cf93023ab06",
                                                "text": "He has always kept an orderly kitchen, with nothing out of place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d97816e-bd58-393e-aec9-d80636d83d74",
                                        "entry_id": "51933249-9f9b-367a-9119-1a261c5582ba",
                                        "glosses": [
                                            "Methodical or systematic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5100a8a-3dd7-49c8-a6b9-83efc7778157",
                                                "sense_id": "6d97816e-bd58-393e-aec9-d80636d83d74",
                                                "text": "We live in an orderly universe, where rules govern both the movements of planets and the binding of molecules."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b48933e-0222-3538-b341-f45a26d8803c",
                                        "entry_id": "51933249-9f9b-367a-9119-1a261c5582ba",
                                        "glosses": [
                                            "Peaceful; well-behaved."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7e2233f-a438-4033-9a19-f9e995b86a8b",
                                                "sense_id": "7b48933e-0222-3538-b341-f45a26d8803c",
                                                "text": "An orderly gathering of citizens stood on the corner awaiting the bus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c297f3d0-e7dc-36c7-ae29-8617fa9ff332",
                                        "entry_id": "51933249-9f9b-367a-9119-1a261c5582ba",
                                        "glosses": [
                                            "Being on duty; keeping order; conveying orders."
                                        ],
                                        "tags": [],
                                        "examples": [
