                "senses": [
                    {
                        "sense_id": "44f059da-cd12-3516-bec0-04d949269da9",
                        "entry_id": "3aa589ba-abdc-38a7-8930-b6a6e993fc98",
                        "glosses": [
                            "booth, show-booth"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8df49071-3408-4b4d-928d-9ef634590c93",
                                "sense_id": "44f059da-cd12-3516-bec0-04d949269da9",
                                "text": "Вре́менная коню́шня, балага́н из до́сок, была́ постро́ена по́дле са́мого гипподро́ма, и туда́ вчера́ должна́ была́ быть приведена́ его́ ло́шадь.",
                                "translation": "The temporary stable, a wooden shed, had been put up close to the race course, and there his mare was to have been taken the previous day.",
                                "english": "The temporary stable, a wooden shed, had been put up close to the race course, and there his mare was to have been taken the previous day."
                            }
                        ]
                    },
                    {
                        "sense_id": "13c5026c-63c7-3101-8cb7-5249c0f150ec",
                        "entry_id": "3aa589ba-abdc-38a7-8930-b6a6e993fc98",
                        "glosses": [
                            "show; farce; low farce; buffoonery"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bdf7e9db-8766-34d3-b43f-d92fcd67098d",
                        "entry_id": "3aa589ba-abdc-38a7-8930-b6a6e993fc98",
                        "glosses": [
                            "fuss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7512cfb2-85f7-4731-80d5-44da8c5c51fa",
                                "sense_id": "bdf7e9db-8766-34d3-b43f-d92fcd67098d",
                                "text": "Чего вы тут балаган устроили?",
                                "translation": "Why are you making such a fuss here?",
                                "english": "Why are you making such a fuss here?"
                            }
                        ]
                    },
