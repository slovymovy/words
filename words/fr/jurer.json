            "senses": [
                {
                    "sense_id": "f9fb8c5d-9253-3d25-a942-d9966844fb8a",
                    "sense_definition": "Affirmer solennellement ou s'engager par serment.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "serment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le témoin lève la main droite et <w>jure</w> de dire toute la vérité."
                        },
                        {
                            "text": "Avant de commencer son mandat, le nouveau président doit <w>jurer</w> fidélité à la constitution."
                        }
                    ],
                    "common_phrases": [
                        "jurer de dire la vérité"
                    ]
                },
                {
                    "sense_id": "c72f30df-ba11-3d81-bd3c-85ed9a79c576",
                    "sense_definition": "Assurer ou certifier fermement la vérité d'un fait.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "affirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je te <w>jure</w> que je n'ai rien à voir avec cette histoire absurde."
                        },
                        {
                            "text": "Il m'a <w>juré</w> sur l'honneur qu'il n'avait jamais vu ce document auparavant."
                        }
                    ],
                    "common_phrases": [
                        "jurer sur l'honneur"
                    ]
                },
                {
                    "sense_id": "11c93290-26b4-3223-b8d8-1f49fb60bf1e",
                    "sense_definition": "Faire une promesse ferme et sincère à quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "promesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux amis se sont <w>juré</w> de toujours s'entraider dans les moments difficiles."
                        },
                        {
                            "text": "Il a <w>juré</w> à ses parents de terminer ses études universitaires cette année."
                        }
                    ],
                    "synonyms": [
                        "promettre"
                    ],
                    "common_phrases": [
                        "se jurer amitié",
                        "jurer fidélité"
                    ]
                },
                {
                    "sense_id": "1136928f-b35f-3ad0-8bbc-d76fcb0e7b04",
                    "sense_definition": "Prononcer des jurons ou des grossièretés sous l'effet de l'énervement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grossierete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après s'être cogné le pied contre la table, il a commencé à <w>jurer</w> de douleur."
                        },
                        {
                            "text": "Le conducteur énervé par les embouteillages ne cesse de <w>jurer</w> au volant."
