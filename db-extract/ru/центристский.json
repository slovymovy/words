                ],
                "translations": [
                    {
                        "translation_id": "6135585d-e9ee-438b-b795-0353b2c1ebe7",
                        "source_entry_id": "31dbdd75-6e46-3d8a-bcde-b583f76dcdff",
                        "source_sense_id": "10c402f9-169c-3c48-a7fc-b1250e3dd2ba",
                        "target_lang_word": "centrist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "centrist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "929e01c9-4679-3e83-8549-60a190135d46",
                                        "entry_id": "943da9a9-8cef-3fcc-9bf4-304e66e7cd20",
                                        "glosses": [
                                            "Of, pertaining to, or advocating centrism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a5e778e-52ad-47d5-8f10-af407366b120",
                                                "sense_id": "929e01c9-4679-3e83-8549-60a190135d46",
                                                "text": "Emmanuel Macron’s ruling centrist party was divided and soul-searching on Wednesday after a strict new immigration law was approved by parliament but contained so many hardline measures that the far-right Marine Le Pen claimed it as an “ideological victory” for her own anti-immigration platform."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "centrist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16f87d92-73b4-3182-8583-23488636970a",
                                        "entry_id": "8e296a67-b46a-3cc5-8902-dee1cf194747",
                                        "glosses": [
                                            "A person who advocates centrism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "485d641f-a118-49cd-8f10-4f5bbbe9d2bd",
                                                "sense_id": "16f87d92-73b4-3182-8583-23488636970a",
                                                "text": "But to critics like the New York Times's Paul Krugman, Ryan was an obvious con man weaponizing the deficit to hamstring Obama's presidency, weaken the recovery, and snooker Beltway centrists eager to champion a reasonable-seeming Republican."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
