    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "977cd129-4528-3408-8127-49b016ad3298",
                    "sense_definition": "To cause someone to feel confused or bewildered",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The complex riddle seemed to <w>stam</w> even the most intelligent students in the class.",
                            "target_lang_translations": {
                                "ru": "Сложная загадка, казалось, <w>озадачила</w> даже самых умных учеников в классе."
                            }
                        },
                        {
                            "text": "He was <w>stammed</w> by the sudden change in the project requirements.",
                            "target_lang_translations": {
                                "ru": "Он был <w>сбит с толку</w> внезапным изменением требований к проекту."
                            }
                        }
                    ],
                    "synonyms": [
                        "confound",
                        "bewilder",
                        "perplex",
                        "mystify"
                    ],
                    "antonyms": [
                        "clarify",
                        "enlighten"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "primarily found in specific regional dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить кого-либо в замешательство или недоумение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "озадачивать",
                                "target_lang_sense_clarification": "ставить в тупик"
                            },
                            {
                                "target_lang_word": "сбивать с толку",
                                "target_lang_sense_clarification": "вызывать замешательство"
                            },
                            {
                                "target_lang_word": "ошеломлять",
                                "target_lang_sense_clarification": "сильно удивлять или путать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5b0ea306-ef1c-3b6a-b575-692d6604c4e8",
                    "sense_definition": "A collective term for Jewish ritual scrolls, specifically the Torah, tefillin, and mezuzot",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religious_objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scribe spent many years perfecting the art of writing <w>stam</w> with holy intent.",
                            "target_lang_translations": {
                                "ru": "Писец потратил много лет на совершенствование искусства написания <w>СТАМ</w> со священным намерением."
                            }
                        },
                        {
                            "text": "Proper maintenance of <w>stam</w> is essential for their continued use in religious services.",
                            "target_lang_translations": {
                                "ru": "Надлежащий уход за <w>священными свитками</w> необходим для их дальнейшего использования в богослужениях."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирательный термин для еврейских ритуальных свитков (Свиток Торы, тфилин и мезузот)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "СТАМ",
                                "target_lang_sense_clarification": "аббревиатура: Сефер Тора, Тфилин, Мезузот"
                            },
                            {
                                "target_lang_word": "священные тексты",
                                "target_lang_sense_clarification": "в контексте иудаизма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b782e6da-f617-3829-a1b3-2b31bb94288c",
                    "sense_definition": "A state of confusion or bewilderment",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unexpected news left the entire office in a complete <w>stam</w> for the afternoon.",
                            "target_lang_translations": {
                                "ru": "Неожиданные новости повергли весь офис в полное <w>замешательство</w> на весь остаток дня."
                            }
                        },
                        {
                            "text": "After the accident, he wandered around in a <w>stam</w>, unable to recall his name.",
                            "target_lang_translations": {
                                "ru": "После аварии он бродил вокруг в <w>оцепенении</w>, не в силах вспомнить свое имя."
                            }
                        }
                    ],
                    "synonyms": [
                        "confusion",
                        "daze",
                        "muddle"
                    ],
                    "antonyms": [
                        "clarity"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "primarily found in specific regional dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние замешательства или недоумения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замешательство",
                                "target_lang_sense_clarification": "состояние растерянности"
                            },
                            {
                                "target_lang_word": "оцепенение",
                                "target_lang_sense_clarification": "состояние ступора или шока"
                            },
                            {
                                "target_lang_word": "недоумение",
                                "target_lang_sense_clarification": "состояние непонимания"
                            }
                        ]
                    }
                }
            ]
        }
    ]
