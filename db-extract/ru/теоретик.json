                "senses": [
                    {
                        "sense_id": "ec47da39-c088-306c-81f5-dec374104783",
                        "entry_id": "746305e5-4f75-3f9b-9d70-65d6856d79ed",
                        "glosses": [
                            "тот, кто занимается разработкой теории в какой-либо области знаний"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f03b7b51-f363-3c6d-95d2-5d71bf93ac3a",
                        "entry_id": "746305e5-4f75-3f9b-9d70-65d6856d79ed",
                        "glosses": [
                            "разг. тот, кто склонен к теоретизированию"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1193a541-1d92-48a7-93a9-7ec939df1fe1",
                        "source_entry_id": "746305e5-4f75-3f9b-9d70-65d6856d79ed",
                        "target_lang_word": "theorist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "theorist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f597e99b-1015-377a-8e61-1e414cdfd3d2",
                                        "entry_id": "969940fc-10fd-3308-8056-2e9a67cc915e",
                                        "glosses": [
                                            "Someone who constructs theories, especially in the arts or sciences."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0915abb-9872-4bb1-b3e6-ce04b10466c4",
                                                "sense_id": "f597e99b-1015-377a-8e61-1e414cdfd3d2",
                                                "text": "Some of the most beautiful and thus appealing physical theories, including quantum electrodynamics and quantum gravity, have been dogged for decades by infinities that erupt when theorists try to prod their calculations into new domains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4dff325f-4f77-483d-8b2d-4f97db68e6f0",
                        "source_entry_id": "746305e5-4f75-3f9b-9d70-65d6856d79ed",
                        "target_lang_word": "theoretician",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "theoretician",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2304b5e-9b93-3b55-826d-8a4fc5a2d5c4",
                                        "entry_id": "e10644e6-7280-36f6-ba59-668fcd53260b",
                                        "glosses": [
                                            "Someone who is expert in the theory of a particular science or art."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "401f7eab-6a94-3890-893c-bcb517fadd47",
                                        "entry_id": "e10644e6-7280-36f6-ba59-668fcd53260b",
                                        "glosses": [
                                            "A theorist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d574f34f-0c00-4b7e-80a0-fb74588af44e",
                                                "sense_id": "401f7eab-6a94-3890-893c-bcb517fadd47",
                                                "text": "“They have numerically confirmed, perhaps for the first time, something we were fairly sure had to be true, but was still a conjecture — namely that the thermodynamics of certain black holes can be reproduced from a lower-dimensional universe,” says Leonard Susskind, a theoretical physicist at Stanford University in California who was among the first theoreticians to explore the idea of holographic universes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9ee5161-b8fc-4685-a39d-791466b84f38",
                        "source_entry_id": "746305e5-4f75-3f9b-9d70-65d6856d79ed",
                        "target_lang_word": "teórico",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teórico",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "4dcab20e-eb9a-3964-b065-f4b96b3b1d9e",
                                        "entry_id": "0044d1c9-f9e5-30e3-99cb-9ce8338d74c3",
                                        "glosses": [
                                            "De la teoría o relacionado con ella."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a8967ef1-a817-37ea-aa8a-31da9f8f4197",
                                        "entry_id": "0044d1c9-f9e5-30e3-99cb-9ce8338d74c3",
                                        "glosses": [
                                            "Que es verdadero por lógica matemática, pero no ha sido contrastado."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "045f7ad8-d869-46b6-96db-b2598051df02",
                                                "sense_id": "a8967ef1-a817-37ea-aa8a-31da9f8f4197",
                                                "text": "Me sorprende que no pueda utilizar mi tarjeta, el saldo teórico que hay en mi cuenta sobrepasa la cantidad que me pide."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "teórico",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "49f770e5-bcb1-38fc-87f5-b622853040a3",
                                        "entry_id": "5cce553c-3697-3ceb-8f32-ea24edecd965",
                                        "glosses": [
                                            "Persona que se dedica fundamentalmente al estudio de la teoría de alguna ciencia, doctrina o actividad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c995ca21-d181-461a-bb05-d2d9135a6cce",
                                                "sense_id": "49f770e5-bcb1-38fc-87f5-b622853040a3",
                                                "text": "Locke y Smith son teóricos convencionales del liberalismo clásico."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e75f5cb1-26a9-490d-b89a-774c10d21448",
                        "source_entry_id": "746305e5-4f75-3f9b-9d70-65d6856d79ed",
                        "target_lang_word": "Theoretiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Theoretiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2fe57db5-a116-3c13-bcdd-06b382b4284b",
                                        "entry_id": "81a5ce36-c445-34b0-8c1b-39219b0da191",
                                        "glosses": [
                                            "Person mit wenig oder keiner praktischen Erfahrung, jedoch mit einer hohen theoretischen Kenntnis über eine bestimmte Tätigkeit oder in einem bestimmten Fachgebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e12a567-2fac-4499-b905-2e9c475fd9c4",
                                                "sense_id": "2fe57db5-a116-3c13-bcdd-06b382b4284b",
                                                "text": "Ich kann Dir bei Deinen Problemen mit dem Computer nicht helfen. Ich bin eher ein Theoretiker."
                                            },
                                            {
                                                "example_id": "115e6905-f51f-416d-a0bb-9b95cb76c210",
                                                "sense_id": "2fe57db5-a116-3c13-bcdd-06b382b4284b",
                                                "text": "In der Firma können wir keine Theoretiker brauchen."
                                            },
                                            {
                                                "example_id": "e04b9447-8506-4aa1-83f3-c9b403d0f332",
                                                "sense_id": "2fe57db5-a116-3c13-bcdd-06b382b4284b",
                                                "text": "„Sozialdarwinistische Theoretiker können zwar Schlagworte und einzelne Zitate Darwins anführen, aber sie ignorieren grundlegende Einsichten der Evolutionstheorie.“"
                                            },
                                            {
                                                "example_id": "da50bdb0-ab4b-4884-b1bb-947595049e88",
                                                "sense_id": "2fe57db5-a116-3c13-bcdd-06b382b4284b",
                                                "text": "[Dietrich Bonhoeffer:] „Der Theoretiker, den so mancher Kommilitone als überheblich erlebte, wurde zum Praktiker, der für Frieden und Gerechtigkeit kämpfen wollte.“"
                                            },
                                            {
                                                "example_id": "0a12f296-59bd-43cc-aa51-c22941b125bc",
                                                "sense_id": "2fe57db5-a116-3c13-bcdd-06b382b4284b",
                                                "text": "„Die Erfahrung, das heißt: allein die Bestätigung des durch Denken Gewonnenen bringt dem Theoretiker Ruhe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d5cca39-e077-4c1f-8e98-d683d2a4789d",
                        "source_entry_id": "746305e5-4f75-3f9b-9d70-65d6856d79ed",
                        "target_lang_word": "théoricien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "théoricien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fcfeddcd-2cd4-3853-884a-8311dde09bac",
                                        "entry_id": "2a8ed972-95d8-3520-97f1-c8a53fe95b46",
                                        "glosses": [
                                            "Celui qui est versé dans l’étude d’une science, qui connaît les principes d’un art."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca07dde4-1a7f-40ff-a84a-54a62448bfdd",
                                                "sense_id": "fcfeddcd-2cd4-3853-884a-8311dde09bac",
                                                "text": "L’utopie est, au contraire, le produit d'un travail intellec­tuel; elle est l’œuvre de théoriciens qui, après avoir observé et discuté les faits, cherchent à établir un modèle auquel on puisse comparer les sociétés existantes pour mesurer le bien et le mal qu'elles renferment."
                                            },
                                            {
                                                "example_id": "9b4de26e-4b04-4a09-99ca-cee9dcfeb604",
                                                "sense_id": "fcfeddcd-2cd4-3853-884a-8311dde09bac",
                                                "text": "De 1567 à sa mort, en 1590, il a tenu la fonction de mathématicien du duc de Savoie, c’est-à-dire qu’il a eu à s’occuper de nombreux problèmes techniques, qu’il a été socialement un théoricien chargée de la science appliquée."
                                            },
                                            {
                                                "example_id": "bfc0fa6e-2b35-4d8e-af5d-f3c59b571661",
                                                "sense_id": "fcfeddcd-2cd4-3853-884a-8311dde09bac",
                                                "text": "Viollet-le-Duc apparaît à cette occasion dans la lignée d’Alberti, comme l’un des premiers théoriciens de l’architecture à avoir préconisé l’étude des nécessités et des pratiques sociales, civiles ou religieuses, dans le processus de conception en tant que démarche essentielle contribuant à l’élaboration d’un programme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c218d692-0805-3a23-a339-dab39e639910",
                                        "entry_id": "2a8ed972-95d8-3520-97f1-c8a53fe95b46",
                                        "glosses": [
                                            "Celui qui avance une ou des théories plus ou moins établies."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78ce7aa8-b472-4732-a1bd-a56aaf4892ca",
                                                "sense_id": "c218d692-0805-3a23-a339-dab39e639910",
                                                "text": "Certaines thèses avancées par les théoriciens du complot font appel à de nombreux faits troublants que seules de laborieuses analyses poussées pourraient clairement réfuter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
