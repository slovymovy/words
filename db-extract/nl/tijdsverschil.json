                                                "example_id": "707a7569-3f8f-4fd1-949b-9046f04f5e08",
                                                "sense_id": "bec451e3-ddd5-31e5-bea5-15659277ad4f",
                                                "text": "Some tardy cripple bore the countermand, / That came too lag to see him buried."
