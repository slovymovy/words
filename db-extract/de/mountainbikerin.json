                                "target_word": "vététiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e925ea6d-7731-364c-a91d-7c4696d4098a",
                                        "entry_id": "b10a7e53-f2a1-3d22-a9a9-fb5fb0c54993",
                                        "glosses": [
                                            "Cycliste qui pratique le vélo tout terrain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b9a8fb3-528e-42ef-a3e5-a4974b75ae4f",
                                                "sense_id": "e925ea6d-7731-364c-a91d-7c4696d4098a",
                                                "text": "L'été, les troupeaux de vaches d’Abondance regardent tranquillement passer les randonneurs et les vététistes dans les alpages et les sentiers."
                                            },
                                            {
                                                "example_id": "e9266e74-83c2-4542-9634-61097ac609b4",
                                                "sense_id": "e925ea6d-7731-364c-a91d-7c4696d4098a",
                                                "text": "Dimanche, ce vététiste amateur, qui fait partie du Vélo club de Simandres, s’est blessé en pleine balade sur un chemin forestier."
                                            },
                                            {
                                                "example_id": "5e0e4167-807b-4976-b18b-fb4177e2df8a",
                                                "sense_id": "e925ea6d-7731-364c-a91d-7c4696d4098a",
                                                "text": "« Ce qui m’intéresse, ce sont les titres », clame la vététiste française de 30 ans à l’orée de la semaine décisive de sa saison entre les Championnats d’Europe samedi puis les Mondiaux aux Gets le 28 août."
                                            }
                                        ]
                                    }
