{
    "word_family": [
        "majesteit",
        "majesteitelijk"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "851fb001-8eb6-3bdb-ab8d-29f8e25ab401",
                    "sense_definition": "Met de pracht, praal en waardigheid die past bij een vorst of koning.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het koninklijke paar maakte een <w>majestueuze</w> entree tijdens het gala.",
                            "target_lang_translations": {
                                "fr": "Le couple royal a fait une entrée <w>majestueuse</w> lors du gala."
                            }
                        },
                        {
                            "text": "De koning verscheen in een <w>majestueuze</w> verschijning op het koninklijk bal.",
                            "target_lang_translations": {
                                "fr": "Le roi est apparu dans une allure <w>majestueuse</w> au bal royal."
                            }
                        }
                    ],
                    "synonyms": [
                        "majesteitelijk",
                        "luisterrijk",
                        "glorieus"
                    ],
                    "common_phrases": [
                        "koninklijk en majestueus",
                        "majestueuze verschijning"
                    ],
                    "target_lang_definitions": {
                        "fr": "Avec la magnificence, la grandeur et la dignité propres à un souverain ou un roi."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "majestueux",
                                "target_lang_sense_clarification": "relatif à la majesté royale ou souveraine"
                            },
                            {
                                "target_lang_word": "royal",
                                "target_lang_sense_clarification": "propre à un roi ou une reine"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d9f9281-15c1-3f9b-8028-3a5899d186e3",
                    "sense_definition": "Zeer groot, indrukwekkend en groots van uitstraling.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vanaf het uitkijkpunt hadden we een <w>majestueus</w> uitzicht over de bergen.",
                            "target_lang_translations": {
                                "fr": "Depuis le point de vue, nous avions une vue <w>majestueuse</w> sur les montagnes."
                            }
                        },
                        {
                            "text": "Een <w>majestueus</w> uitzicht over de vallei maakte onze wandeling onvergetelijk.",
                            "target_lang_translations": {
                                "fr": "Une vue <w>grandieuse</w> sur la vallée a rendu notre randonnée inoubliable."
                            }
                        }
                    ],
                    "synonyms": [
                        "indrukwekkend",
                        "statig",
                        "monumentaal"
                    ],
                    "common_phrases": [
                        "een majestueus uitzicht",
                        "een majestueuze boom"
                    ],
                    "target_lang_definitions": {
                        "fr": "Très grand, impressionnant et d'une allure grandiose."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "majestueux",
                                "target_lang_sense_clarification": "qui impose par sa grandeur et sa beauté"
                            },
                            {
                                "target_lang_word": "grandioce",
                                "target_lang_sense_clarification": "qui produit une impression de grandeur spectaculaire"
                            },
                            {
                                "target_lang_word": "imposant",
                                "target_lang_sense_clarification": "qui suscite le respect ou l'admiration par sa taille"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}