                "senses": [
                    {
                        "sense_id": "9fbc2e7a-6bf6-347e-9514-9dcb9cc81208",
                        "entry_id": "eab7115d-054d-3c3e-b43f-23675ffda9ee",
                        "glosses": [
                            "Femme qui recherche la fréquentation de la haute société."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c545da80-ffa7-486f-87bd-ec872558bf0f",
                                "sense_id": "9fbc2e7a-6bf6-347e-9514-9dcb9cc81208",
                                "text": "Quelques loups de dentelle abritaient peut-être de vraies mondaines en rupture de salons du high-life, mais la plupart cachaient mal des visages de demoiselles trop connues, […]."
                            },
                            {
                                "example_id": "b541fbdf-f8ee-4973-a4de-1a56d74dd76a",
                                "sense_id": "9fbc2e7a-6bf6-347e-9514-9dcb9cc81208",
                                "text": "Il se détourne à demi, son journal sur les genoux ; sa main gauche écartée tient une cigarette, le petit doigt en l’air, comme une mondaine tiendrait un sandwich…"
                            }
                        ]
                    },
                    {
                        "sense_id": "73b05662-1b95-32a0-ab14-87ce21e29346",
                        "entry_id": "eab7115d-054d-3c3e-b43f-23675ffda9ee",
                        "glosses": [
                            "Brigade mondaine, ancien nom de la brigade des mœurs en France."
                        ],
                        "tags": [
                            "ellipsis",
                            "singular"
                        ],
                        "examples": [
                            {
                                "example_id": "11435d6a-2f65-468d-9b6e-7995508715a9",
                                "sense_id": "73b05662-1b95-32a0-ab14-87ce21e29346",
                                "text": "Des mythes et fantasmes qui entourent le travail policier, ceux qui concernent la brigade de répression du proxénétisme, parfois appelée « la mondaine », sont parmi les plus endurants."
                            },
                            {
                                "example_id": "5f2c801d-4a1b-4245-804f-2a234b24c646",
                                "sense_id": "73b05662-1b95-32a0-ab14-87ce21e29346",
                                "text": "Tu vas filer à la Mondaine, Salvagnac, et me sortir les dossiers Cucuru, Juan, Innocenti, et tout ce que tu pourras trouver ce qui s’y rapporte."
                            }
                        ]
                    }
                ],
