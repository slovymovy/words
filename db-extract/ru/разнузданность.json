                "senses": [
                    {
                        "sense_id": "23dc6bcd-2287-311b-a3b5-ef06ebb4743a",
                        "entry_id": "2881e138-529b-3ca8-97f5-1330c89651d5",
                        "glosses": [
                            "разг. свойство по значению прилагательного разнузданный; крайняя степень распущенности, своеволия, ничем не сдерживаемого произвола"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56fa3536-f88d-4f59-a3ca-398507e37ed2",
                        "source_entry_id": "2881e138-529b-3ca8-97f5-1330c89651d5",
                        "source_sense_id": "23dc6bcd-2287-311b-a3b5-ef06ebb4743a",
                        "target_lang_word": "insolence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insolence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04070f9a-df2c-3f77-9e3f-fd08acdfec37",
                                        "entry_id": "fed70754-cedd-30b9-bc11-107482b53050",
                                        "glosses": [
                                            "Contemptible, ill-mannered conduct; insulting: arrogant, bold behaviour or attitude."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cc6327c-3840-4727-82e1-47a5b9e489e1",
                                                "sense_id": "04070f9a-df2c-3f77-9e3f-fd08acdfec37",
                                                "text": "all the insolence of imaginary superiority"
                                            },
                                            {
                                                "example_id": "d8e8084d-7fbb-4d69-9ba4-77189263ce25",
                                                "sense_id": "04070f9a-df2c-3f77-9e3f-fd08acdfec37",
                                                "text": "There she was, doing rude things, and saying ruder, which every body bore with the best grace in the world: then, as now, it was perfectly astonishing what people in general will submit to in the way of insolence, provided the said insolence be attended by rank and riches."
                                            },
                                            {
                                                "example_id": "73a6ecd3-a043-4261-98fb-998bd6fe85ab",
                                                "sense_id": "04070f9a-df2c-3f77-9e3f-fd08acdfec37",
                                                "text": "The coarseness and truth of her attack alike overwhelmed him. But her supreme insolence found him words, and he too burst forth. \"Yes! and I forbid you to do it! You despise me, perhaps, and think I'm feeble. But you're mistaken. You are ungrateful, impertinent, and contemptible, but I will save you in order to save Irma and our name."
                                            },
                                            {
                                                "example_id": "918d97d5-2661-44ba-8d84-ea092156f07d",
                                                "sense_id": "04070f9a-df2c-3f77-9e3f-fd08acdfec37",
                                                "text": "They are fond of fun and therefore witty, wit being well-bred insolence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aadb726f-4972-3a4c-a5ac-1103977028db",
                                        "entry_id": "fed70754-cedd-30b9-bc11-107482b53050",
                                        "glosses": [
                                            "Insolent conduct or treatment; insult."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72aabeaf-b6dd-4b42-b2ae-e56dc641ce0e",
                                                "sense_id": "aadb726f-4972-3a4c-a5ac-1103977028db",
                                                "text": "Two heavy iron chains were put about his neck, (in metal and weight different from them he bore before!) and, loaded with fetters and insolences from the soldiers, (who in such ware seldom give scant measure,) he was brought into the presence of Isaacius."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c26f04d1-1961-383e-9449-01a2ad20f00f",
                                        "entry_id": "fed70754-cedd-30b9-bc11-107482b53050",
                                        "glosses": [
                                            "The quality of being unusual or novel."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84e5ea53-12f7-4857-b9c4-7ffca3ad4cf6",
                                                "sense_id": "c26f04d1-1961-383e-9449-01a2ad20f00f",
                                                "text": "Her great excellence / Lifts me above the measure of my might / That being fild with furious insolence / I feele my selfe like one yrapt in spright."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "insolence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "314f7f72-89b2-3809-97d4-a2b9766dc479",
                                        "entry_id": "63dfe919-e470-3578-bf43-c95db6f8c051",
                                        "glosses": [
                                            "To insult."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05e16b65-afb2-4577-abf6-fb0aec8b4a3f",
                                                "sense_id": "314f7f72-89b2-3809-97d4-a2b9766dc479",
                                                "text": "...we are bound to assert that we never heard either in his public discourses or private conversation, anything that might tend towards encouraging sedition, or anyways insolencing the government"
                                            },
                                            {
                                                "example_id": "0ca0f0a5-2956-4c11-adbf-2af93208ef8c",
                                                "sense_id": "314f7f72-89b2-3809-97d4-a2b9766dc479",
                                                "text": "bishops, who were first foully insolenced and assaulted."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
