                        "target_lang_word": "Schaulustiger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schaulustiger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59ae58d2-e052-3ec8-ac41-38fd88ed8fb2",
                                        "entry_id": "e219cc7a-4a3d-31b0-9d4f-2da2236c0471",
                                        "glosses": [
                                            "jemand, der ein spektakuläres Ereignis beobachtet, das nicht für Zuschauer vorgesehen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08817b0f-134e-4177-9279-ed7d28ea4acf",
                                                "sense_id": "59ae58d2-e052-3ec8-ac41-38fd88ed8fb2",
                                                "text": "Viele Schaulustige versammelten sich um die Unfallstelle, doch niemand half den Verletzten."
                                            },
                                            {
                                                "example_id": "849b9f3b-9fad-4e67-b4e6-17bead7cf7d3",
                                                "sense_id": "59ae58d2-e052-3ec8-ac41-38fd88ed8fb2",
                                                "text": "„Tausende Schaulustige strömten an die Kaimauern.“"
                                            },
                                            {
                                                "example_id": "e5ea84a7-9c0b-4513-adad-37606209bad4",
                                                "sense_id": "59ae58d2-e052-3ec8-ac41-38fd88ed8fb2",
                                                "text": "„Leider vereiteln das mühevolle Anziehen von Helm und Handschuhen eine schnelle Flucht auf dem Motorrad, und als der Wagen schon außer Sichtweite war, hatte ich bereits eine Menge Schaulustiger angezogen.“"
                                            },
                                            {
                                                "example_id": "5932ac1e-7d78-4c56-9056-eaa4b10a1265",
                                                "sense_id": "59ae58d2-e052-3ec8-ac41-38fd88ed8fb2",
                                                "text": "„Durch ein Spalier von Schaulustigen begab ich mich in ein Café, um den bitteren Geschmack mit einer ungezuckerten Limonade hinunterzuspülen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
