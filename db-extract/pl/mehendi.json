                                        "examples": [
                                            {
                                                "example_id": "c12231cf-ceb8-423b-925a-12dfc04a6635",
                                                "sense_id": "9fff1d7a-e698-3560-a6cf-e7b3d05b2595",
                                                "text": "The first lot to be put up was a tin of sugar biscuits and a jar of ‘mendy’, a pomade of native origin for dyeing the hair black."
                                            },
                                            {
                                                "example_id": "628b9b27-9607-45ad-aa62-764d3a36d7d9",
                                                "sense_id": "9fff1d7a-e698-3560-a6cf-e7b3d05b2595",
                                                "text": "She was thirteen, a young bride whose small palms had been stained burgundy with mehndi for a man she knew nothing about, not even his name."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee983138-8930-3a5c-a3d3-1c1e0e8895b2",
                                        "entry_id": "8fe6f539-e67f-39d9-bc73-822ba18acacd",
                                        "glosses": [
                                            "A temporary skin decoration made with henna."
                                        ],
                                        "tags": [
                                            "South-Asia",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d56cc788-599e-3e75-aefc-68e3ee19862f",
                                        "entry_id": "8fe6f539-e67f-39d9-bc73-822ba18acacd",
                                        "glosses": [
                                            "The practice of applying such decoration, typically as part of a bride or groom's preparations for a wedding."
                                        ],
                                        "tags": [
                                            "South-Asia",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d00313a-a5dc-4ee2-b6c1-2cc494c78f56",
                                                "sense_id": "d56cc788-599e-3e75-aefc-68e3ee19862f",
                                                "text": "Then came the Mehndi ceremony – where henna is painted on the bride's hands and feet, and the bride and groom's family try to outdo each other in singing and dancing."
                                            }
                                        ]
                                    }
