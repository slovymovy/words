                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "škopek",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "da9eb492-c4bf-399e-8d79-c5b4e6a3cfbe",
                                        "entry_id": "3d52a316-8ad5-3f81-a75d-3ece67221d5f",
                                        "glosses": [
                                            "nižší okrouhlá dřevěná nebo kovová nádoba se dvěma uchy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4dc17d1-25d6-4e27-96ea-9af184aecb4f",
                                                "sense_id": "da9eb492-c4bf-399e-8d79-c5b4e6a3cfbe",
                                                "text": "Jinde tahali se o škopek, kdo se má v něm první umýt, až ho na sebe zvrhli."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9028b018-f166-3577-8b22-139054d48e8e",
                                        "entry_id": "3d52a316-8ad5-3f81-a75d-3ece67221d5f",
                                        "glosses": [
                                            "hlava"
                                        ],
                                        "tags": [
                                            "brněnský hantec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e338f18-abce-4d3a-af66-4f6f2b87389d",
                                                "sense_id": "9028b018-f166-3577-8b22-139054d48e8e",
                                                "text": "Tak mu mázli železa na perutě a šópli ho do kameňa, tam ho klendra štengrovala, kelcny se mu furt lágrovaly, chálka levá, škopek z toho paf, akorát samé tvrdé giňál, samé vasr, vo válcách žádné hantec."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47b7291e-a172-3c3a-9c73-797488ffc613",
                                        "entry_id": "3d52a316-8ad5-3f81-a75d-3ece67221d5f",
                                        "glosses": [
                                            "pivo"
                                        ],
                                        "tags": [
                                            "brněnský hantec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d5abb95-3ef1-493e-a371-628f4931bb1d",
                                                "sense_id": "47b7291e-a172-3c3a-9c73-797488ffc613",
                                                "text": "Dali si scuka v jezovitským klabu, kde si každé jen tak cvičně vysmahl pár škopků, a začali hned šmírovat, komu by dali do řepy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de1c7657-fbcb-3676-8867-db99befb59fd",
                                        "entry_id": "3d52a316-8ad5-3f81-a75d-3ece67221d5f",
                                        "glosses": [
                                            "bicí nástroje, bubny"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1eb9f79-4e7c-474f-929d-820ab1d74f31",
                                                "sense_id": "de1c7657-fbcb-3676-8867-db99befb59fd",
                                                "text": "Ksicht měl sice jak padesátku šmirgl, ovary jak rákosníček, kelca jak noty na škopky a ještě mu trochu švidraly baterky."
                                            }
                                        ]
                                    }
                                ]
