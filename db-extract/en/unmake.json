                "senses": [
                    {
                        "sense_id": "81cf02d1-9ca3-3400-bcc7-c19a1c19eb05",
                        "entry_id": "e2ae9c50-42a5-3bbd-bf0a-428b85c78f0c",
                        "glosses": [
                            "To destroy or take apart; to cause (a made article) to lose its nature."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e51a7bdf-5716-4526-98d6-7169e22dcf3d",
                                "sense_id": "81cf02d1-9ca3-3400-bcc7-c19a1c19eb05",
                                "text": "Let go the lure\nThe striving to unmake"
                            },
                            {
                                "example_id": "23611436-4f5b-4fd0-ab0f-137b3e9a9b53",
                                "sense_id": "81cf02d1-9ca3-3400-bcc7-c19a1c19eb05",
                                "text": "She was confused. Now that he had worked himself into a snit he'd be angry if she unmade the bed and did what he wanted. If she didn't make it properly, he'd be resentful. She stripped the bed. She'd change the linens."
                            }
                        ]
                    }
