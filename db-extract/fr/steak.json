                "senses": [
                    {
                        "sense_id": "b0d2636f-f151-3ada-a4cc-873191dfd5c8",
                        "entry_id": "a0051338-8770-30ae-acb1-4448c9271271",
                        "glosses": [
                            "Tranche de viande de bœuf, de thon, de chair de poisson ou à base de légumes prêt à une cuisson à la poêle."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "b32c8561-dbc2-4419-80b1-0bd2e20119b3",
                                "sense_id": "b0d2636f-f151-3ada-a4cc-873191dfd5c8",
                                "text": "— Et vous comptez tenir le barbeuc dehors tout à l’heure, aussi ? Retourner les steaks hachés à ma place ?"
                            },
                            {
                                "example_id": "6bfe7ed0-7cfa-4a6c-824f-16a25c6b5594",
                                "sense_id": "b0d2636f-f151-3ada-a4cc-873191dfd5c8",
                                "text": "Steak de saumon sur lit d’asperges et salade de pommes de terre."
                            },
                            {
                                "example_id": "65407e14-8435-4abc-b372-31e3541ac55c",
                                "sense_id": "b0d2636f-f151-3ada-a4cc-873191dfd5c8",
                                "text": "Le végétal est-il l’avenir du steak?"
                            },
                            {
                                "example_id": "b6af89c3-c9fb-4f11-846f-5d1baa476d05",
                                "sense_id": "b0d2636f-f151-3ada-a4cc-873191dfd5c8",
                                "text": "Dans sa conclusion, la CJUE n’exclut pas la possibilité que les États membres prennent des mesures pour établir des dénominations légales et préciser ce qu’est un « steak » ou un « filet », ce qui pourrait permettre aux gouvernements de restreindre les termes « carnés » à des produits ayant une composition particulière."
                            }
                        ]
                    },
                    {
                        "sense_id": "df81ac33-4e97-38bf-accb-2963409fdc4a",
                        "entry_id": "a0051338-8770-30ae-acb1-4448c9271271",
                        "glosses": [
                            "Ampoule ou arrachement de la peau de la paume, à la base des doigts, provoqués par la pratique de certaines activités sportives, notamment les agrès de barres en gymnastique artistique."
                        ],
                        "tags": [
                            "Anglicism",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "5ec036f1-94eb-4cd1-bcfe-9fde915616b6",
                                "sense_id": "df81ac33-4e97-38bf-accb-2963409fdc4a",
                                "text": "À force de m’entraîner aux barres asymétriques, j’ai des steaks plein les mains."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "913c9ac2-50ac-49ab-a600-70f3b3693878",
                        "source_entry_id": "a0051338-8770-30ae-acb1-4448c9271271",
                        "target_lang_word": "Steak",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steak",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "69f65c5d-502c-307f-adef-102956380e80",
                                        "entry_id": "03022063-77d9-3aaf-b451-c1582480927b",
                                        "glosses": [
                                            "zum Kurzbraten oder Grillen geeignete Fleischscheibe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e28ca12f-b8c8-4eaf-a5a9-9d15b53a7730",
                                                "sense_id": "69f65c5d-502c-307f-adef-102956380e80",
                                                "text": "Ich habe jetzt Appetit auf ein schönes Steak."
                                            },
                                            {
                                                "example_id": "4a96ddb9-f53c-41f7-9acd-5a05e4aadc5f",
                                                "sense_id": "69f65c5d-502c-307f-adef-102956380e80",
                                                "text": "„Alle Steaks werden durch Braten oder Grillen gegart, selten auch durch Pochieren.“"
                                            },
                                            {
                                                "example_id": "f2a22541-745a-4dc4-a669-0133ae577d8a",
                                                "sense_id": "69f65c5d-502c-307f-adef-102956380e80",
                                                "text": "„Als nächstes gingen sie zum Clubhaus und sahen ein luxuriöses Büffet mit allen nur erdenklichen Spezialitäten, von Meeresfrüchten über Steaks bis zu exotischen Desserts, allen möglichen Getränken und einem Champagnerbrunnen.“"
                                            },
                                            {
                                                "example_id": "88b3cdbf-e313-417d-8ca1-176b11a0ac98",
                                                "sense_id": "69f65c5d-502c-307f-adef-102956380e80",
                                                "text": "„Jan saß am Esstisch und stocherte in den grünen Bohnen, die er uns zum Steak mit Rosmarinkartoffeln serviert hatte.“"
                                            },
                                            {
                                                "example_id": "dca25fa9-22fd-46e2-a02f-e07f204ab048",
                                                "sense_id": "69f65c5d-502c-307f-adef-102956380e80",
                                                "text": "„Er wollte ein gutes Steak, blutig, und ich bestellte zwei Tournedos mit Sauce béarnaise.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
