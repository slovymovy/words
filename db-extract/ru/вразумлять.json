                                                "example_id": "e1a9e880-815f-46a6-b346-eff047e1d353",
                                                "sense_id": "b05556e1-3de3-3443-b6af-7dd829160d84",
                                                "text": "Ich habe mir eingeredet, ich könnte das nicht."
