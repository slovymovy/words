                "forms": [
                    {
                        "form_id": "463c8444-50ed-4cf5-90cb-e4f5767a7ff8",
                        "entry_id": "01bd8a44-63e7-3744-b9c2-5f06ac1e6a19",
                        "tags": [
                            "plural"
                        ],
                        "form": "aigrettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "64cb9e02-a383-372b-a22f-3056ed3e234c",
                        "entry_id": "01bd8a44-63e7-3744-b9c2-5f06ac1e6a19",
                        "glosses": [
                            "A feather or plume, or feather-shaped item, used as an adornment or ornament."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07584ab8-1c4e-4488-934e-96e8e6fc2432",
                                "sense_id": "64cb9e02-a383-372b-a22f-3056ed3e234c",
                                "text": "This bauble, said he, shewing me an elegant sprig of diamonds, is an aigret, sent in last week by a lady of quality, who has ever since kept home with her head muffled up in a double clout for a pretended fit of the tooth-ache."
                            },
                            {
                                "example_id": "43461b4a-44e4-4315-8aa0-d64215ceac50",
                                "sense_id": "64cb9e02-a383-372b-a22f-3056ed3e234c",
                                "text": "His turban, furled in many a graceful fold, / An emerald aigrette, with Haidée's hair in't, / Surmounted as its clasp […]"
                            },
                            {
                                "example_id": "3e24a892-26ed-4abe-b7b8-1b274a85966c",
                                "sense_id": "64cb9e02-a383-372b-a22f-3056ed3e234c",
                                "text": "On a stool, in front [of the throne], was placed a human skull, crowned with an immense emerald, of a pyramidal form, and surmounted by an aigrette of brilliant plumes and precious stones."
                            },
                            {
                                "example_id": "562858b7-1fec-43af-931e-fe32ad384507",
                                "sense_id": "64cb9e02-a383-372b-a22f-3056ed3e234c",
                                "text": "At intervals you behold the passage of sounds of all forms which come from the triple peal of Saint-Germain des Prés. Then, again, from time to time, this mass of sublime noises opens and gives passage to the beats of the Ave Maria, which bursts forth and sparkles like an aigrette of stars."
                            },
                            {
                                "example_id": "c52ea7f6-a3b1-4daf-a359-3348a2a20efa",
                                "sense_id": "64cb9e02-a383-372b-a22f-3056ed3e234c",
                                "text": "She was formal in manner, and made calls in rustling, steel-gray brocades and a tall bonnet with bristling aigrettes."
                            },
                            {
                                "example_id": "20b46fa9-e158-440b-a7b2-6d3888787e44",
                                "sense_id": "64cb9e02-a383-372b-a22f-3056ed3e234c",
                                "text": "Young women attired often in nothing more than ostrich-feather aigrettes dyed in colors of doubtful taste ran nubilely up and down the marble staircases, chased by young men in razor-toed ball shoes of patent-leather."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e45d953-3f64-3dee-9910-a7cb122df257",
                        "entry_id": "01bd8a44-63e7-3744-b9c2-5f06ac1e6a19",
                        "glosses": [
                            "The lesser white heron."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11d1423d-7e83-438b-9d46-7648def86b63",
                                "sense_id": "1e45d953-3f64-3dee-9910-a7cb122df257",
                                "text": "Birds of many kinds skimmed the weedy flats. George pointed out a flock of aigrets, the beautiful wild fowl with the priceless plumes."
                            }
                        ]
                    },
                    {
                        "sense_id": "46f5bba5-6148-33d5-bb92-40d0655e5950",
                        "entry_id": "01bd8a44-63e7-3744-b9c2-5f06ac1e6a19",
                        "glosses": [
                            "The feathery crown of some seeds (such as the dandelion)."
                        ],
