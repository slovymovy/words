                "senses": [
                    {
                        "sense_id": "069a64fe-8fa8-3737-9fde-a29fb9fa9c0f",
                        "entry_id": "e0a3fc25-e12a-3620-8cdb-9bcecddcd9e7",
                        "glosses": [
                            "Donner un caractère narbonnais à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25a0835d-f29f-4cb9-9fba-8cf2ed902ed6",
                                "sense_id": "069a64fe-8fa8-3737-9fde-a29fb9fa9c0f",
                                "text": "Il est vrai que le temps presse : M. Turrel a décidé de narbonniser notre municipalité radicale-socialiste avant les élections législatives, afin d'assurer la réélection de ses amis."
                            },
                            {
                                "example_id": "25e0e9a4-c985-4f92-8eea-f87b62b90355",
                                "sense_id": "069a64fe-8fa8-3737-9fde-a29fb9fa9c0f",
                                "text": "Dis Pascool, venir me narbonniser pour ouvrir les feux d'octobre lors de votre rasso, pourquoi pas?"
                            },
                            {
                                "example_id": "85592705-5ec0-40e9-bd5b-2d4f280b3b45",
                                "sense_id": "069a64fe-8fa8-3737-9fde-a29fb9fa9c0f",
                                "text": "On s'est narbonnisé."
                            }
                        ]
                    }
