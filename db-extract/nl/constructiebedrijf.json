                "senses": [
                    {
                        "sense_id": "52d8fbe5-a205-3c0a-a32e-7795e06c6b68",
                        "entry_id": "25f19a13-93c3-3ab1-9618-ed47e863502d",
                        "glosses": [
                            "onderneming die grote voorwerpen of delen van gebouwen uit metaal in elkaar zet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15c331fc-6a1b-4853-a8f4-c16cc83874e6",
                                "sense_id": "52d8fbe5-a205-3c0a-a32e-7795e06c6b68",
                                "text": "De Roemeense en Italiaanse werknemers werken voor SIM SpA, een Italiaans constructiebedrijf voor de industrie. Ze bouwen een nieuwe fabriek op het terrein van de Noorse kunstmestfabrikant."
                            },
                            {
                                "example_id": "cf7cb577-4e71-45d3-8a46-c13fccff0b8c",
                                "sense_id": "52d8fbe5-a205-3c0a-a32e-7795e06c6b68",
                                "text": "Op dit moment trekt vooral zijn robotgestuurde 3D-metaalprinter de aandacht. Constructiebedrijven hopen met een nog grotere ‘XL’-versie boten en gebouwen te kunnen printen."
                            },
                            {
                                "example_id": "c98ec9e6-b762-48bf-bde1-67c2809f63a0",
                                "sense_id": "52d8fbe5-a205-3c0a-a32e-7795e06c6b68",
                                "text": "Een kijkje in de keuken van QinetiQ, een constructiebedrijf dat apparaten en machines voor onder meer het Britse leger bouwt."
                            },
                            {
                                "example_id": "0ae35793-9207-4323-b5ba-0e045fe819c0",
                                "sense_id": "52d8fbe5-a205-3c0a-a32e-7795e06c6b68",
                                "text": "Ik liep al enige jaren rond met het idee het chassis te verbeteren, maar ik vond bij de motorfabrikanten geen gehoor. Te tijdrovend en te kostbaar, waren altijd de argumenten bij afwijzing. Dan doe ik het zelf wel, heb ik uiteindelijk gezegd. Past ook mooi in het constructiebedrijf dat ik drie jaar geleden ben begonnen."
                            },
                            {
                                "example_id": "1695600c-ff50-4931-afb0-51d19f3fafe0",
                                "sense_id": "52d8fbe5-a205-3c0a-a32e-7795e06c6b68",
                                "text": "Het begon allemaal in 1928, toen uitvinder Hub van Doorne met zijn broer Wim een constructiebedrijfje opzette dat zich toelegde op militaire producten die nog stamden uit de Duits-Franse oorlog van 1870."
                            }
                        ]
                    }
