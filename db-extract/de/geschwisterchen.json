                            {
                                "example_id": "c1104e30-83a8-4e40-b411-5f2c3ee56384",
                                "sense_id": "33352c3d-eb66-302e-b4fa-28a788e674dd",
                                "text": "Der kleine Noah bekommt bald ein Geschwisterchen, seine Mutter ist wieder schwanger."
                            },
                            {
                                "example_id": "1eaf2422-d57a-48bc-88d5-8d92a7bf5943",
                                "sense_id": "33352c3d-eb66-302e-b4fa-28a788e674dd",
                                "text": "„Aber wenn man neun Jahre älter ist, ändert sich durch ein neues Geschwisterchen nicht viel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
