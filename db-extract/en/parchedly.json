                        "glosses": [
                            "In a parched manner; with great thirst or dryness."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3adfa342-d9a2-4439-9a72-06e0bc357272",
                                "sense_id": "7da0d72e-fd90-3e17-861b-420aa87a6373",
                                "text": "I shall find them at tea, thought I. I had hardly eaten anything since landing, but I felt no hunger; I was only anxious, feverishly, parchedly anxious to arrive."
                            },
                            {
                                "example_id": "21488d28-b8f0-4b00-b07c-d1a858a97df4",
                                "sense_id": "7da0d72e-fd90-3e17-861b-420aa87a6373",
                                "text": "[…] the distant sand dunes of Nubia glittering parchedly below."
                            },
                            {
                                "example_id": "2bffbdf6-2483-4c52-88a3-530c21e74606",
                                "sense_id": "7da0d72e-fd90-3e17-861b-420aa87a6373",
                                "text": "In a single instant his mouth went parchedly dry. He found himself swaying urgently backwards on the narrow plank beneath his feet. And stopped himself. He must not show fright. He must act as if fear was an impossibility."
                            }
                        ]
                    }
