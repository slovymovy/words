                "senses": [
                    {
                        "sense_id": "1b0a5bbe-e6fd-3470-b91d-10bd6a186fa5",
                        "entry_id": "0ff782b0-8fd4-3b13-8bd5-7740b139d1d8",
                        "glosses": [
                            "zwei oder mehr Atome in einem energiearmen, geschlossenen Verband, die durch eine kovalente Bindung miteinander verknüpft sind und als Geruch wahrgenommen werden"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "ab0206e6-a0d5-4e93-97cd-ccf68edab7f1",
                                "sense_id": "1b0a5bbe-e6fd-3470-b91d-10bd6a186fa5",
                                "text": "„Ob Maiglöckchen oder Flieder, die Bratwurst auf dem Grill oder das vergessene Stück Käse, das nach Wochen aus der hintersten Ecke des Kühlschrankes wieder auftaucht – alles was duftet, riecht oder stinkt, gelangt in Form von Geruchsmolekülen in unsere Nasen.“"
                            },
                            {
                                "example_id": "2ed4e2e4-82b2-47ce-a830-46cb24f7138e",
                                "sense_id": "1b0a5bbe-e6fd-3470-b91d-10bd6a186fa5",
                                "text": "„Die Geruchsmoleküle gelangen aus der Luft in die Nase und verbinden sich dort mit den passenden Empfängern.“"
                            },
                            {
                                "example_id": "96b235b3-f16c-4b98-9497-0b6b6b7a39c5",
                                "sense_id": "1b0a5bbe-e6fd-3470-b91d-10bd6a186fa5",
                                "text": "„Großaufnahmen mit einer Videokamera aus dem Aquarium zeigten, dass der Hummer seine Fühler mit einer Abwärtsbewegung gerade so rasch durch das Wasser pflügt, dass Wasser mitsamt den Geruchsmolekülen in das Büschel der feinen sensorischen Haare an der Spitze der Antennen eindringt.“"
                            },
                            {
                                "example_id": "5d505d90-a350-424b-9164-c01ae3221a08",
                                "sense_id": "1b0a5bbe-e6fd-3470-b91d-10bd6a186fa5",
                                "text": "„Für den kaukasischen Körpergeruch ist u.a. das schwefelhaltige Geruchsmolekül 3-Methyl-3-sulfanylhexanol charakteristisch.“"
                            },
                            {
                                "example_id": "6192db24-42d7-4296-bd2d-bd425ec97c25",
                                "sense_id": "1b0a5bbe-e6fd-3470-b91d-10bd6a186fa5",
                                "text": "„Es bringt mehr Luft und damit mehr Geruchsmoleküle zu den Sinneszellen der Nase.“"
                            },
                            {
                                "example_id": "94370f35-7265-4f0d-a751-22f328bff8ca",
                                "sense_id": "1b0a5bbe-e6fd-3470-b91d-10bd6a186fa5",
                                "text": "„Bei Geruchsmolekülen handelt es sich fast immer um wenig polare Substanzen, sonst könnten die ja nicht so einfach verdampfen („verduften“).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
