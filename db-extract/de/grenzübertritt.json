                ],
                "senses": [
                    {
                        "sense_id": "a60c7677-dcc2-32d6-9ef8-f66a293dc7a5",
                        "entry_id": "61066ffe-ebba-3105-ae4b-3a26b13f9bc3",
                        "glosses": [
                            "Wechsel über die Grenze von einem Land zu einem anderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d04fa43a-21e7-480c-8df7-b7a3f04c69f9",
                                "sense_id": "a60c7677-dcc2-32d6-9ef8-f66a293dc7a5",
                                "text": "„Zwanzig Jahre nach der Wiedervereinigung hat ein Grenzübertritt von Thüringen nach Niedersachsen natürlich längst seinen einstigen Schrecken verloren.“"
                            },
                            {
                                "example_id": "e4d845fc-5e79-4895-b0db-66abb93f7903",
                                "sense_id": "a60c7677-dcc2-32d6-9ef8-f66a293dc7a5",
                                "text": "„Diese Eigenschaften scheinen sich mit meinem Grenzübertritt in die Türkei in Luft aufzulösen.“"
                            },
                            {
                                "example_id": "b37e5fbe-8976-4762-9dfd-79b3c25436eb",
                                "sense_id": "a60c7677-dcc2-32d6-9ef8-f66a293dc7a5",
                                "text": "„Doch bereits kurz vor dem Grenzübertritt, im malerischen Fischerort Tutrakan, wurde mir bewusst, dass die rumänischen Hunde von anderem Kaliber waren.“"
                            },
                            {
                                "example_id": "4daf9e00-a5a8-4d42-97d3-12dc3a62d8c1",
                                "sense_id": "a60c7677-dcc2-32d6-9ef8-f66a293dc7a5",
                                "text": "„Die Zahl der Grenzübertritte nach Mosambik betrug bald mehr als 1000 pro Monat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
