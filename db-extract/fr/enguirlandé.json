                        "examples": [
                            {
                                "example_id": "93364f88-dab4-4680-8826-10146585c458",
                                "sense_id": "7409d5fe-fcec-3ece-89ad-7d281cc26e92",
                                "text": "Au fond, à demi cachée par l’enchevêtrement des branches, on aperçoit une clairière déserte où se dresse une petite statue d’Aphrodite sur une stèle enguirlandée de roses."
                            },
                            {
                                "example_id": "16a05f0e-dbc5-4990-811b-db75871ffac2",
                                "sense_id": "7409d5fe-fcec-3ece-89ad-7d281cc26e92",
                                "text": "Trois grandes roues du moulin rappellent la destination primitive du logis, mais elles sont à présent immobiles et tout enguirlandées de lierre."
                            }
                        ]
                    }
