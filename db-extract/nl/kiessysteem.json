                    {
                        "sense_id": "c6045de7-61e1-30db-b7a6-6740d56da01e",
                        "entry_id": "59eba18a-4cb5-3846-b968-6c8652478bbc",
                        "glosses": [
                            "de wijze waarop de volksvertegenwoordiging bij verkiezingen wordt gekozen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6e16b23-59a7-445b-9c17-ecde20f57310",
                                "sense_id": "c6045de7-61e1-30db-b7a6-6740d56da01e",
                                "text": "Het kiessysteem is van grote invloed op de wijze waarop een land bestuurd wordt."
                            },
                            {
                                "example_id": "a4b12600-c9ec-4d84-9820-f4f7b5a09c5f",
                                "sense_id": "c6045de7-61e1-30db-b7a6-6740d56da01e",
                                "text": "Een kiessysteem kan ingedeeld worden naargelang het aantal zetels dat tegelijk verkozen wordt of, omgekeerd, naargelang het aantal kieskringen waarin de zetels worden verkozen."
                            }
                        ]
                    }
                ],
