                "senses": [
                    {
                        "sense_id": "c520bd2d-1a82-37fa-8261-746b28330457",
                        "entry_id": "05b46f86-885b-3984-9f4e-0b41baef5bcf",
                        "glosses": [
                            "een laag sneeuw op de bodem, die wordt gevormd als gevolg van sneeuwval en sneeuwstormen en gedurende een bepaalde periode blijft liggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db9d1d92-280b-4c0d-beef-a4b3e3ef5fc2",
                                "sense_id": "c520bd2d-1a82-37fa-8261-746b28330457",
                                "text": "Het sneeuwdek reikte hier en daar tot de vensters van de begane grond."
                            },
                            {
                                "example_id": "c7c462c6-aa45-44f6-ba92-10319eec94ea",
                                "sense_id": "c520bd2d-1a82-37fa-8261-746b28330457",
                                "text": "Aan het begin van de nacht heeft de sneeuwzone de lijn Alkmaar-Utrecht-Eindhoven bereikt en sneeuwt het overal in het zuiden van het land. Pas aan het einde van de nacht sneeuwt het ook in Groningen. In een groot deel van het land kan een sneeuwdek van zo'n 1 tot 3 centimeter ontstaan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2da00ba6-23d4-4cca-bec3-83d06befff83",
                        "source_entry_id": "05b46f86-885b-3984-9f4e-0b41baef5bcf",
                        "source_sense_id": "c520bd2d-1a82-37fa-8261-746b28330457",
                        "source_sense_description": "een laag sneeuw op de bodem, die wordt gevormd als gevolg van sneeuwval en sneeuwstormen en gedurende een bepaalde periode blijft liggen",
                        "target_lang_word": "Schneedecke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schneedecke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "deab02bd-4c49-3c17-b287-045bee5f6bae",
                                        "entry_id": "2351ec12-6edd-37bf-94d3-32108cd9aae6",
                                        "glosses": [
                                            "Lage von Schnee auf dem Boden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1efabb9-1b5c-4c59-aea9-65f9df4a4611",
                                                "sense_id": "deab02bd-4c49-3c17-b287-045bee5f6bae",
                                                "text": "„Wenn jetzt durch frühes, durch zu schnelles Tauen die Schneedecke nicht mehr dick genug ist und die Schneehöhlen einbrechen, dann liegen die jungen Robben zu früh und schutzlos auf dem Eis des Sees.“"
                                            },
                                            {
                                                "example_id": "561dc8c3-f018-4092-bbf4-24cf8535436c",
                                                "sense_id": "deab02bd-4c49-3c17-b287-045bee5f6bae",
                                                "text": "„Im Jahre 1999 war Aschermittwoch kein gewöhnlicher Tag in Osthessen. Ein nächtlicher Schneesturm hatte mit einem donnernden Wintergewitter die graue Mittelgebirgslandschaft, in der nur noch die Nordseiten der Berge schmutzige Schneereste aufwiesen, mit einer dicken Schneedecke überzogen und in ein zauberhaftes Wintermärchen verwandelt.“"
                                            },
                                            {
                                                "example_id": "a722fbc6-df4b-4254-9ad3-6acc6164b0c8",
                                                "sense_id": "deab02bd-4c49-3c17-b287-045bee5f6bae",
                                                "text": "„Der Kontinent lag unter einer dichten Schneedecke, scharfer Frost ließ den Menschen im Freien den Atem vor den Mündern gefrieren.“"
                                            },
                                            {
                                                "example_id": "e6695709-e64a-4fd4-8ac5-8584194c77ac",
                                                "sense_id": "deab02bd-4c49-3c17-b287-045bee5f6bae",
                                                "text": "„Ich hatte die Küchentür zum Garten am Morgen geöffnet und beobachtet, wie die Schneedecke das Verschwinden der Welt vorantrieb und alles so leise, so still machte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
