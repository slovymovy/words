    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4c81497b-c729-3196-ab2f-ca8c34902c37",
                    "sense_definition": "A herring or salmon that has been split along the back, salted, and smoked.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fish_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He usually eats a grilled <w>kipper</w> with buttered toast for breakfast.",
                            "target_lang_translations": {
                                "ru": "На завтрак он обычно ест поджаренную <w>копчёную селёдку</w> с тостом с маслом."
                            }
                        },
                        {
                            "text": "The kitchen was filled with the distinct aroma of smoked <w>kippers</w>.",
                            "target_lang_translations": {
                                "ru": "Кухня наполнилась характерным ароматом <w>копчёной сельди</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "smoked kipper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сельдь или лосось, разрезанные вдоль спины, засоленные и копчёные."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "копчёная селёдка",
                                "target_lang_sense_clarification": "рыба горячего или холодного копчения"
                            },
                            {
                                "target_lang_word": "киппер",
                                "target_lang_sense_clarification": "пластованная копчёная сельдь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "443f5f30-c2e3-3825-8797-1cbe79210a49",
                    "sense_definition": "A male salmon during or after the spawning season.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fish_biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angler caught a spent <w>kipper</w> near the shallow gravel beds.",
                            "target_lang_translations": {
                                "ru": "Рыболов поймал обессилевшего <w>отнерестившегося лосося</w> возле галечного мелководья."
                            }
                        },
                        {
                            "text": "After spawning, the exhausted <w>kipper</w> struggled against the river current.",
                            "target_lang_translations": {
                                "ru": "После нереста измождённый <w>самец лосося</w> с трудом боролся с речным течением."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Самец лосося во время или после нереста."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отнерестившийся лосось",
                                "target_lang_sense_clarification": "самец лосося в период нереста"
                            },
                            {
                                "target_lang_word": "лошак",
                                "target_lang_sense_clarification": "самец лосося после нереста"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66e74704-b6e6-3bf8-8ed8-faa523d3f2ae",
                    "sense_definition": "A member or supporter of the UK Independence Party (UKIP).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several local <w>kippers</w> gathered outside the town hall to distribute party leaflets.",
                            "target_lang_translations": {
                                "ru": "Несколько местных <w>сторонников UKIP</w> собрались у здания ратуши, чтобы раздавать партийные листовки."
                            }
                        },
                        {
                            "text": "He described himself as a committed <w>kipper</w> during the election campaign.",
                            "target_lang_translations": {
                                "ru": "Во время предвыборной кампании он называл себя убеждённым <w>сторонником партии независимости</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in British politics"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "Chiefly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Член или сторонник Партии независимости Соединённого Королевства (UKIP)."
