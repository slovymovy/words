                                            {
                                                "example_id": "743e55ec-da0d-4aa2-9e56-d5aa429749f7",
                                                "sense_id": "92febaac-3af5-37f4-9710-c676ea9cc503",
                                                "text": "‘I wish it would rain,’ continued she; ‘only we are going to have a six-week’s wash to-morrow, and that’s a heavy job for the poor creatures. La! don’t you pity washerwomen in hot weather; it’s the hardest work that’s done.’"
                                            }
                                        ]
