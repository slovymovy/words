                                                "example_id": "5aae0e07-15a3-4ae4-bffe-a0fe979e4e17",
                                                "sense_id": "1db7aed4-b79a-3672-98b1-406196a77b96",
                                                "text": "Ach, meine Kleine, du hast dich ja jetzt ganz mit dem Eis eingeschmiert, lass mich das mal wegmachen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
