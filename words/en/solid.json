                        {
                            "text": "The editor asked me to change the hyphenated term to a <w>solid</w> compound.",
                            "target_lang_translations": {
                                "ru": "Редактор попросил меня заменить термин, пишущийся через дефис, на <w>слитное</w> сложное слово."
                            }
                        }
                    ],
                    "synonyms": [
                        "closed",
                        "closed up"
                    ],
                    "antonyms": [
                        "hyphenated",
                        "spaced"
                    ],
                    "common_phrases": [
