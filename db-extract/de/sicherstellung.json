                ],
                "senses": [
                    {
                        "sense_id": "ca099acc-b6d4-3654-8051-e879c05dda9d",
                        "entry_id": "d76dacb0-0649-395a-9ae0-72ddc80069de",
                        "glosses": [
                            "Assurance, garantie, assurance, confirmation rendant quelque chose certain, indubitable dans le faits."
                        ],
                        "tags": [],
                        "note": "Cf. vocabulaire apparenté pour les noms exprimant des notions proches",
                        "examples": [
                            {
                                "example_id": "57694b77-ee98-4a3b-ba28-30441d52413a",
                                "sense_id": "ca099acc-b6d4-3654-8051-e879c05dda9d",
                                "text": "An erster Stelle steht die Sicherstellung einer ausreichenden Sauerstoffversorgung.",
                                "translation": "La première priorité est l’assurance d’une oxygénation suffisante."
                            },
                            {
                                "example_id": "e45afd5c-9419-48d8-a319-fd678222c9d4",
                                "sense_id": "ca099acc-b6d4-3654-8051-e879c05dda9d",
                                "text": "Seine Anwesenheit auf der Burg oder dem befestigten Hof nutzte der Ritter während Friedenszeiten zur Vorbereitung auf künftige kriegerische Handlungen und zur Sicherstellung der täglichen Ernährung.",
                                "translation": "En temps de paix, le chevalier profitait de sa présence au château ou à la ferme fortifiée pour se préparer à de futures actions militaires et assurer son alimentation quotidienne."
                            }
                        ]
                    },
                    {
                        "sense_id": "aab312cb-585e-32cf-af98-5bb1bcf96e92",
                        "entry_id": "d76dacb0-0649-395a-9ae0-72ddc80069de",
                        "glosses": [
                            "Sûreté ; mise en sûreté de preuves, sécurisation, bouclage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5815746-a8ce-45c3-a3ef-d1333db163b5",
                                "sense_id": "aab312cb-585e-32cf-af98-5bb1bcf96e92",
                                "text": "Polizeitaktisch wird ein Tatort unmittelbar nach Eintreffen der Einsatzkräfte durch innere und äußere Absperrung sowie Sicherstellung bzw. Beschlagnahme gesichert.",
                                "translation": "Du point de vue de la tactique policière, une scène de crime est immédiatement sécurisée par un bouclage vers l’intérieur et l’extérieur, ainsi qu’une mise en sûreté / une saisie [de preuves, d’armes, etc.]."
                            },
                            {
                                "example_id": "18c3b1be-0d5f-445d-ade9-6e165a7b6f26",
                                "sense_id": "aab312cb-585e-32cf-af98-5bb1bcf96e92",
                                "text": "Art. 253 Aussergewöhnliche Todesfälle … ³ Andernfalls ordnet die Staatsanwaltschaft die Sicherstellung der Leiche und weitere Untersuchungen durch eine rechtsmedizinische Institution, nötigenfalls die Obduktion an. Sie kann die Leiche oder Teile davon zurückbehalten, solange der Zweck der Untersuchung es erfordert.",
                                "translation": "Art. 253 Mort suspecte … ³ Dans le cas contraire, le ministère public ordonne la mise en sûreté du cadavre et de nouveaux examens par un institut de médecine légale ou, au besoin, une autopsie. Il peut ordonner la rétention du cadavre ou de certaines de ses parties pour les besoins de l’examen."
                            }
                        ]
                    }
                ],
