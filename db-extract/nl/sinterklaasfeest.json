                        "entry_id": "4fa99da5-5b81-31d6-8084-c5d1bcfff557",
                        "glosses": [
                            "feest met cadeaus dat in Nederland, België en andere landen jaarlijks rond 5 december wordt gevierd"
                        ],
                        "tags": [
                            "feest",
                            "cultuur"
                        ],
                        "examples": [
                            {
                                "example_id": "2c6aae79-7d85-4b39-a973-4ab72723bc5c",
                                "sense_id": "2619f8ff-2071-348e-afcd-c91506381452",
                                "text": "We kregen wat nodig was: voedsel, geld, liefde. Geen cadeaus. Op school en tijdens het sinterklaasfeest op het bedrijf waar mijn vader werkte, kregen andere kinderen wel grote cadeaus. Naderhand hoorde ik dat die ouders die spullen voor ze hadden gekocht en daar hadden mijn vader en moeder geen geld voor."
                            }
                        ]
                    }
