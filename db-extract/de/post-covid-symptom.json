                ],
                "senses": [
                    {
                        "sense_id": "b5e217b1-41d0-3817-8df5-a8bd7744d446",
                        "entry_id": "bacddb95-d42a-31f2-9162-dd5b741cfcee",
                        "glosses": [
                            "Anzeichen für Nachwirkungen/Langzeitfolgen von Covid-19; Weiterbestehen von Krankheitssymptomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c9d1147-dd03-46b2-b364-f10747f382ce",
                                "sense_id": "b5e217b1-41d0-3817-8df5-a8bd7744d446",
                                "text": "„Die häufigsten Post-COVID-Symptome sind Atemnot, Muskelschmerzen, Angstzustände und Schlafstörungen.“"
                            },
                            {
                                "example_id": "a7c38f42-e4a3-43aa-b058-2b43db956092",
                                "sense_id": "b5e217b1-41d0-3817-8df5-a8bd7744d446",
                                "text": "„Vorläufige Berichte und Daten über Post-COVID-Symptome weisen Gemeinsamkeiten mit anderen postviralen chronischen Erkrankungen auf.“"
                            },
                            {
                                "example_id": "b6f2eaa6-b592-4e37-9c74-89e477453a42",
                                "sense_id": "b5e217b1-41d0-3817-8df5-a8bd7744d446",
                                "text": "„Auch diese psychosozialen Aspekte könnten zu vermehrt auftretenden Post-COVID-Symptomen beigetragen haben.“"
                            },
                            {
                                "example_id": "f7dd9180-0e8c-4408-b3dd-115ccd3b405f",
                                "sense_id": "b5e217b1-41d0-3817-8df5-a8bd7744d446",
                                "text": "„Diese waren teilweise von der Schwere her und Symptomcharakteristik vergleichbar mit mäßigen bis starken Post-COVID-Symptomen.“"
                            },
                            {
                                "example_id": "4713809c-dc5f-45cb-82f2-6083fe9242bb",
                                "sense_id": "b5e217b1-41d0-3817-8df5-a8bd7744d446",
                                "text": "„COVID-19-Erkrankungen sind sehr komplex und können sich auf verschiedene Organe auswirken. Deshalb gibt es nicht die eine Reha für das eine Post-COVID-Symptom.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
