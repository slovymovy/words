                        "glosses": [
                            "Enrouler de manière ordonnée un objet (voir tracaner)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ac702d6-8b78-4099-b4eb-b3431f19737b",
                                "sense_id": "c7e85e2d-d98e-364d-9fe2-4238409b9844",
                                "text": "Trancaner un fil sur une bobine. Trancaner un câble sur un tambour."
                            }
                        ]
                    },
                    {
                        "sense_id": "593bc60c-9738-3874-9ad8-1d35790a7b4f",
                        "entry_id": "759da087-84ff-3978-9380-63e340d96fb0",
                        "glosses": [
                            "Transvaser inutilement un liquide, et par là le perdre ou le gâter."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "9fb26626-ba91-4663-b046-677385b2586d",
                                "sense_id": "593bc60c-9738-3874-9ad8-1d35790a7b4f",
                                "text": "Laisse-moi ce vin dans cette bouteille et ne le trancane pas tant."
                            }
                        ]
                    },
