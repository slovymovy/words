                "senses": [
                    {
                        "sense_id": "529c0e1e-ffc3-33b5-97f7-20599a594acc",
                        "entry_id": "73ae2004-b967-3ff9-ae16-9d069debd913",
                        "glosses": [
                            "Einwohner des bayerischen Regierungsbezirks Oberbayern, Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76ad9bdc-9ae0-4501-ae75-a5a0c478ef4b",
                                "sense_id": "529c0e1e-ffc3-33b5-97f7-20599a594acc",
                                "text": "„Hätten Komtesse doch statt meiner den Schorschl mitgenommen! Der war schon bei den Franzosen, als Komtesse noch gar nicht geboren waren; der hätte ihnen gesagt, was ein Oberbayer ist und wie die Bayern dazumal die Franzosen gejagt haben …“"
                            },
                            {
                                "example_id": "b8bedb36-3e69-4611-b91e-fed36d118c7f",
                                "sense_id": "529c0e1e-ffc3-33b5-97f7-20599a594acc",
                                "text": "„[…] auch zeigte sich in der Tat bald, daß der kleine Franz ein anderes Kerlchen war als seine Brüder, schlank, stark, zwar etwas stiller als sie, aber mit großen blauen, aufgeweckten Augen, kurz, ein echter Oberbayer; darauf bestand die Mutter.“"
                            },
                            {
                                "example_id": "a9f528a0-9018-4b45-805b-51e2b7f46975",
                                "sense_id": "529c0e1e-ffc3-33b5-97f7-20599a594acc",
                                "text": "„Ich sage es mal so: Die Oberbayern haben die höheren Berge und wir Niederbayern haben den größeren Horizont.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
