                "senses": [
                    {
                        "sense_id": "8c520487-a02f-3f0b-8b5a-d9f978b502a4",
                        "entry_id": "57e9f3a6-a7c6-3ce2-85fd-b7e9b58eb701",
                        "glosses": [
                            "Qui a la faculté de comprendre, de saisir par l’esprit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f4d130f-8610-470a-8fe7-082024ef2f2b",
                                "sense_id": "8c520487-a02f-3f0b-8b5a-d9f978b502a4",
                                "text": "Une intelligence compréhensive."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2102db1-2b0b-3232-8b23-e35ca0b1f7ce",
                        "entry_id": "57e9f3a6-a7c6-3ce2-85fd-b7e9b58eb701",
                        "glosses": [
                            "Capable de comprendre les sentiments d’autrui."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66bf6084-58ae-4d1f-b887-ab82aa179be1",
                                "sense_id": "d2102db1-2b0b-3232-8b23-e35ca0b1f7ce",
                                "text": "C’est quelqu’un de très compréhensif, tu verras."
                            },
                            {
                                "example_id": "7227e4b4-8310-4d88-8db8-d5219a617e71",
                                "sense_id": "d2102db1-2b0b-3232-8b23-e35ca0b1f7ce",
                                "text": "La personne étayante se montre bienveillante et ouverte à accueillir l’autre tel qu’il est devant elle, ici et maintenant dans un échange empathique, compréhensif et plein d’affection."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d5f3b77-3af4-3f78-b9b6-1b9571508b2e",
                        "entry_id": "57e9f3a6-a7c6-3ce2-85fd-b7e9b58eb701",
                        "glosses": [
                            "Qui, à l’inverse d’une énumération exhaustive qui explicite chacun d’entre eux, réfère implicitement à tous les éléments d’un ensemble par les propriétés communes qui les relient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "962b2b59-58b8-4f62-b5f2-a19784144075",
                                "sense_id": "5d5f3b77-3af4-3f78-b9b6-1b9571508b2e",
                                "text": "Terme compréhensif : Qui embrasse dans sa signification un nombre plus ou moins grand d’êtres, de choses, d’idées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8528fee5-c6a0-4875-8215-f790ded39749",
                        "source_entry_id": "57e9f3a6-a7c6-3ce2-85fd-b7e9b58eb701",
                        "source_sense_id": "8c520487-a02f-3f0b-8b5a-d9f978b502a4",
                        "source_sense_description": "Qui a la faculté de comprendre, de saisir par l’esprit.",
                        "target_lang_word": "verständnisvoll",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verständnisvoll",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95b585a6-7cb4-3c00-a676-3bf37d906102",
                                        "entry_id": "61001d53-bb76-3e3a-9293-76fb317d3568",
                                        "glosses": [
                                            "Verständnis und Einsicht zeigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1080cb8c-ccfd-48d1-88d3-fa2d0663706d",
                                                "sense_id": "95b585a6-7cb4-3c00-a676-3bf37d906102",
                                                "text": "„Die Kaiserin Mentewab glaubte daher, dass er sich ihrer Lage gegenüber verständnisvoll zeigen würde.“"
                                            },
                                            {
                                                "example_id": "c1018e1a-1b70-4151-bf21-4e2c0fcfff02",
                                                "sense_id": "95b585a6-7cb4-3c00-a676-3bf37d906102",
                                                "text": "„Sich in den anderen hineinversetzen, verständnisvoll und höflich sein – nur wenn alle auf Kuschelkurs sind, klappt auch die Zusammenarbeit, lautet das Credo.“"
                                            },
                                            {
                                                "example_id": "3319e894-32f8-419a-b8fc-1f291ee5b3da",
                                                "sense_id": "95b585a6-7cb4-3c00-a676-3bf37d906102",
                                                "text": "„[…] Sie war so verständnisvoll, dass sie sich als Erste entschuldigte, selbst wenn ich falsch gelegen hatte. Ihre Liebe war wie der Himmel auf Erden für mich.“"
                                            },
                                            {
                                                "example_id": "0a50d394-7da8-4d23-a682-62418e786cbc",
                                                "sense_id": "95b585a6-7cb4-3c00-a676-3bf37d906102",
                                                "text": "Wenn eine Politikerin Gefühle zeigt, kompromissbereit und verständnisvoll handelt, gilt sie als zu weich und daher unfähig für den Job. Handelt sie dagegen wie ein Mann, gilt sie als kompetent, aber berechnend, zickig und kalt."
                                            },
                                            {
                                                "example_id": "c9355244-6850-4f59-97f8-77c1cd294ad5",
                                                "sense_id": "95b585a6-7cb4-3c00-a676-3bf37d906102",
                                                "text": "„Er ist ein gleichermaßen wortkarger wie liebenswerter Mensch, immer verständnisvoll und immer für andere da.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea6e300a-06bf-4498-a060-17a811dfb50c",
                        "source_entry_id": "57e9f3a6-a7c6-3ce2-85fd-b7e9b58eb701",
                        "source_sense_id": "d2102db1-2b0b-3232-8b23-e35ca0b1f7ce",
