                    },
                    {
                        "translation_id": "fcb5f15d-95e7-4bdb-b120-3572c0942e44",
                        "source_entry_id": "36b2da7d-986c-3300-8401-bbd986e083bc",
                        "source_sense_description": "a small circle whose centre is on the circumference of a larger circle",
                        "target_lang_word": "épicycle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épicycle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88919ac7-f2fe-349e-823c-7bc51c357786",
                                        "entry_id": "f6124041-444b-32a4-bab6-d1b26e8d74b2",
                                        "glosses": [
                                            "Petit cercle imaginé par les anciens astronomes et dont le centre est un point de la circonférence d’un plus grand cercle, nommé déférent. L’épicycle était censé être parcouru en un an par la planète en question, tandis que le centre de l’épicycle devait mettre pour parcourir le déférent, un temps égal à la révolution sidérale de la dite planète."
                                        ],
                                        "tags": [
                                            "Histoire des sciences"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a66376fa-99bf-400b-807c-815b5cbe6e14",
                                                "sense_id": "88919ac7-f2fe-349e-823c-7bc51c357786",
                                                "text": "Mars retrograde plus que Jupiter, & Jupiter retrograde plus que Saturne, parce que l’épicycle de Mars eſt plus grand que celui de Jupiter."
                                            },
                                            {
                                                "example_id": "1cb7dfca-20c7-4466-94b6-230812b01324",
                                                "sense_id": "88919ac7-f2fe-349e-823c-7bc51c357786",
                                                "text": "La planète décrit un cercle dit épicycle, dont le centre se déplace sur un cercle appelé déférent dont le centre est la Terre."
                                            },
                                            {
                                                "example_id": "838504b9-2887-4fa5-8bf4-123cecf08bed",
                                                "sense_id": "88919ac7-f2fe-349e-823c-7bc51c357786",
                                                "text": "La planète apparaît alors en mouvement rétrograde autour du périgée de l’épicycle."
                                            },
                                            {
                                                "example_id": "35fbe1f3-8b3c-4baa-8c86-ae85e977dc91",
                                                "sense_id": "88919ac7-f2fe-349e-823c-7bc51c357786",
                                                "text": "Ces gens qui se logent à chevauchons sur l'épicycle de Mercure , il me semble qu'ils m'arrachent les dens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
