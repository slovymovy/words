                                        "entry_id": "2096d98b-0d5a-3edb-a8f6-90daa3520399",
                                        "glosses": [
                                            "Matching each member of one set with exactly one member of another set."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e2c88f0-902a-4a78-9808-a20af9affdff",
                                                "sense_id": "86799d69-2a9e-3a54-9755-0ac3e34f5871",
                                                "text": "There is a one-to-one relationship between days with large cash shortages and his workdays."
                                            }
