                "senses": [
                    {
                        "sense_id": "2f4268c3-8941-3abb-98d1-32265e331ddb",
                        "entry_id": "84f54cb6-50b7-3ab5-abca-dbf7b5efe342",
                        "glosses": [
                            "Donner un caractère grand-guignol à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81302e10-70a0-4c3d-b637-a4c4fdbba73d",
                                "sense_id": "2f4268c3-8941-3abb-98d1-32265e331ddb",
                                "text": "Tout cela dramatise singulièrement, on a parfois envie de dire « grand-guignolise », la schizophrénie."
                            },
                            {
                                "example_id": "2653f411-69ef-4e3c-adf5-7ea7b9b76433",
                                "sense_id": "2f4268c3-8941-3abb-98d1-32265e331ddb",
                                "text": "A Monsieur Jourdain, que tant d'interprétations ont noirci, caricaturé, grand-guignolisé, François Morel restitue enfin sa naïveté, sa gaucherie et ses caprices puérils."
                            },
                            {
                                "example_id": "a946ad1a-6d8e-4bb9-9479-1de161d216bc",
                                "sense_id": "2f4268c3-8941-3abb-98d1-32265e331ddb",
                                "text": "Tristram Shandy raconte son propre engendrement - il y mettra plus de quatre volumes - sans doute la première fois que quelqu'un grand-guignolise de cette façon les saints mystères de la procréation."
                            }
                        ]
                    }
