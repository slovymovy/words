{
    "word_family": [
        "skitting"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dd866f0b-90bc-37a6-aed2-e5d3cedc5a24",
                    "sense_definition": "A short, humorous performance, often performed by amateurs.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students performed a funny <w>skit</w> about life at school during the talent show.",
                            "target_lang_translations": {
                                "ru": "На шоу талантов ученики показали смешной <w>скетч</w> о школьной жизни."
                            }
                        },
                        {
                            "text": "We wrote a short <w>skit</w> to help explain the new safety rules to the employees.",
                            "target_lang_translations": {
                                "ru": "Мы написали короткий <w>скетч</w>, чтобы помочь объяснить сотрудникам новые правила безопасности."
                            }
                        }
                    ],
                    "synonyms": [
                        "sketch"
                    ],
                    "common_phrases": [
                        "funny skit",
                        "short skit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткое юмористическое представление, часто исполняемое любителями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скетч",
                                "target_lang_sense_clarification": "короткая шуточная пьеса или эстрадный номер"
                            },
                            {
                                "target_lang_word": "реприза",
                                "target_lang_sense_clarification": "короткий шуточный номер в цирке или на эстраде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98ea5877-5605-306e-ad7d-e4163b41ffa7",
                    "sense_definition": "A brief, sudden shower of rain.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We took shelter under a tree when a sudden <w>skit</w> of rain began to fall.",
                            "target_lang_translations": {
                                "ru": "Мы укрылись под деревом, когда начался внезапный <w>кратковременный дождь</w>."
                            }
                        },
                        {
                            "text": "The afternoon was interrupted by a quick <w>skit</w> of rain that passed as fast as it arrived.",
                            "target_lang_translations": {
                                "ru": "День был прерван быстрым <w>ливневым дождем</w>, который закончился так же быстро, как и начался."
                            }
                        }
                    ],
                    "synonyms": [
                        "shower",
                        "downpour"
                    ],
                    "common_phrases": [
                        "skit of rain"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Regional or dated usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кратковременный, внезапный дождь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кратковременный дождь",
                                "target_lang_sense_clarification": "небольшой, быстро проходящий дождь"
                            },
                            {
                                "target_lang_word": "ливневый дождь",
                                "target_lang_sense_clarification": "внезапный и интенсивный, но короткий дождь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b0d42f5-888d-3465-a8b2-f87db4e522a2",
                    "sense_definition": "Diarrhea in livestock, particularly in sheep or lambs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer noticed the lamb was suffering from the <w>skit</w> and moved it to a different pasture.",
                            "target_lang_translations": {
                                "ru": "Фермер заметил, что ягненок страдает от <w>поноса</w>, и перевел его на другое пастбище."
                            }
                        },
                        {
                            "text": "Proper nutrition is essential to prevent the <w>skit</w> in young lambs during the spring.",
                            "target_lang_translations": {
                                "ru": "Правильное питание необходимо для предотвращения <w>поноса</w> у молодых ягнят весной."
                            }
                        }
                    ],
                    "synonyms": [
                        "scour"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Agricultural or regional term."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Диарея у домашнего скота, особенно у овец или ягнят."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понос",
                                "target_lang_sense_clarification": "общее медицинское и ветеринарное название диареи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d710435e-d8e7-34af-b9ad-564269c489f9",
                    "sense_definition": "A brief satirical remark or jeer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "satire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His speech was filled with a sharp <w>skit</w> against the local political leaders.",
                            "target_lang_translations": {
                                "ru": "Его речь была наполнена резкими <w>насмешками</w> в адрес местных политических лидеров."
                            }
                        },
                        {
                            "text": "The article was little more than a mean <w>skit</w> intended to mock the author's latest work.",
                            "target_lang_translations": {
                                "ru": "Статья была не более чем злой <w>насмешкой</w>, призванной высмеять последнюю работу автора."
                            }
                        }
                    ],
                    "synonyms": [
                        "satire",
                        "jeer"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткое сатирическое замечание или насмешка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насмешка",
                                "target_lang_sense_clarification": "ироничное или сатирическое замечание"
                            },
                            {
                                "target_lang_word": "шпилька",
                                "target_lang_sense_clarification": "колючее, язвительное замечание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27051c65-e81a-37f0-aa88-d7050b1646af",
                    "sense_definition": "A derogatory term for a woman considered to be of loose morals.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old novel, the character was cruelly dismissed by the townspeople as a <w>skit</w>.",
                            "target_lang_translations": {
                                "ru": "В старом романе горожане жестоко называли этого персонажа «распутницей»."
                            }
                        },
                        {
                            "text": "The term <w>skit</w> was used in historical texts to insult women, though it is now obsolete.",
                            "target_lang_translations": {
                                "ru": "Термин «<w>распутница</w>» использовался в исторических текстах для оскорбления женщин, хотя сейчас он устарел."
                            }
                        }
                    ],
                    "synonyms": [
                        "hussy",
                        "trollop"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Highly offensive and no longer in common use."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее оскорбительное обозначение женщины легкого поведения."
                    },
                    "translations": {
                        "ru": []
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a0f6896e-0a5d-3561-87b6-3d2df6e983bc",
                    "sense_definition": "To move or run lightly, quickly, or in a skipping manner.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young deer <w>skitted</w> across the open field when it heard a noise.",
                            "target_lang_translations": {
                                "ru": "Молодой олень <w>проскакал</w> по открытому полю, когда услышал шум."
                            }
                        },
                        {
                            "text": "I watched the sunlight <w>skitting</w> over the surface of the calm lake.",
                            "target_lang_translations": {
                                "ru": "Я наблюдал, как солнечный свет <w>порхает</w> по поверхности спокойного озера."
                            }
                        }
                    ],
                    "synonyms": [
                        "skip",
                        "dart"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться или бежать легко, быстро или вприпрыжку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скакать",
                                "target_lang_sense_clarification": "двигаться прыжками или легким бегом"
                            },
                            {
                                "target_lang_word": "порхать",
                                "target_lang_sense_clarification": "двигаться легко и быстро"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53db364f-633d-32b8-aca8-e552d220c483",
                    "sense_definition": "To mock or make fun of someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "satire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedian began to <w>skit</w> the politician's strange way of speaking.",
                            "target_lang_translations": {
                                "ru": "Комик начал <w>высмеивать</w> странную манеру речи политика."
                            }
                        },
                        {
                            "text": "It is not polite to <w>skit</w> others for their personal mistakes.",
                            "target_lang_translations": {
                                "ru": "Невежливо <w>высмеивать</w> других за их личные ошибки."
                            }
                        }
                    ],
                    "synonyms": [
                        "mock",
                        "ridicule"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in this sense today."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Высмеивать или подшучивать над кем-либо или чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высмеивать",
                                "target_lang_sense_clarification": "подвергать насмешкам"
                            },
                            {
                                "target_lang_word": "пародировать",
                                "target_lang_sense_clarification": "высмеивать путем имитации"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}