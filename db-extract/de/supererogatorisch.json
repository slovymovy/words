                        "entry_id": "69431778-e203-39be-ab13-b868c9d73531",
                        "glosses": [
                            "mehr als ethisch gefordert; über die Pflichterfüllung hinausgehend gut"
                        ],
                        "tags": [
                            "Moraltheologie"
                        ],
                        "examples": [
                            {
                                "example_id": "6a7c8a95-1ed5-44bb-aa65-cb75cd32de5d",
                                "sense_id": "a15412bf-9013-3ec2-bcb0-7831de65f216",
                                "text": "Weder nach dem klassischen Utilitarismus noch nach der Pflichtenethik Kants kann es supererogatorische Handlungen geben."
