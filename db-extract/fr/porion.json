                    {
                        "sense_id": "bfdcec7f-52ed-3902-babc-7ff13514ed70",
                        "entry_id": "421fae1e-9e14-393b-a64d-bffc1d99fd71",
                        "glosses": [
                            "Points de repérage craniométrique, se situant au niveau du canal auditif externe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b10a3b6b-c38c-451a-b8f5-0ec56adc4bfb",
                                "sense_id": "bfdcec7f-52ed-3902-babc-7ff13514ed70",
                                "text": "Le conservateur se transformait en être charmant. Il continuait son cours. Hauteur du crâne, inclinaison de la face, porion, sutures, point sous-orbitaire, Nina noircissait sa feuille."
                            },
                            {
                                "example_id": "8f682b25-e4d0-45dd-a68b-3cb53cc13aa7",
                                "sense_id": "bfdcec7f-52ed-3902-babc-7ff13514ed70",
                                "text": "Le porion osseux (Po) est le bord supérieur du conduit auditif externe osseux (CAE), à l’intersection de ce bord avec une verticale passant par le milieu du conduit."
                            }
                        ]
                    }
                ],
