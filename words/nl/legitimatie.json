{
    "word_family": [
        "legitiem",
        "legitimeren",
        "legitimiteit"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "30ff68a0-fbda-3c62-8cd3-04eff82e9831",
                    "sense_definition": "officieel document waarmee men de eigen identiteit kan aantonen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "identificatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De beveiliger vroeg om mijn <w>legitimatie</w> bij de ingang van het gebouw.",
                            "target_lang_translations": {
                                "zh": "保安在楼门口要求我出示<w>身份证件</w>。"
                            }
                        },
                        {
                            "text": "Vergeet niet om altijd een geldig <w>legitimatie</w> bij je te dragen.",
                            "target_lang_translations": {
                                "zh": "别忘了随身携带有效的<w>身份证件</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "identificatie"
                    ],
                    "common_phrases": [
                        "geldige legitimatie",
                        "legitimatie tonen"
                    ],
                    "target_lang_definitions": {
                        "zh": "用于证明个人身份的官方证件"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "身份证件",
                                "target_lang_sense_clarification": "指证明身份的各类官方文件"
                            },
                            {
                                "target_lang_word": "证件",
                                "target_lang_sense_clarification": "指证明身份或资格的凭证"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34aad854-0360-310d-b6bd-b8c2a8c1669c",
                    "sense_definition": "het proces van het bewijzen van iemands identiteit",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "identificatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij de grenscontrole is een strikte <w>legitimatie</w> van alle reizigers verplicht.",
                            "target_lang_translations": {
                                "zh": "在边境检查时，必须对所有旅客进行严格的<w>身份核实</w>。"
                            }
                        },
                        {
                            "text": "De procedure voor <w>legitimatie</w> duurt meestal maar enkele minuten.",
                            "target_lang_translations": {
                                "zh": "<w>身份验证</w>流程通常只需要几分钟。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "证明某人身份的过程"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "身份核实",
                                "target_lang_sense_clarification": "指确认个人身份的程序"
                            },
                            {
                                "target_lang_word": "身份验证",
                                "target_lang_sense_clarification": "指通过技术或程序手段确认身份"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f07ef14-0f30-3402-82be-e5f6ee50b11c",
                    "sense_definition": "het rechtvaardigen of wettig maken van een handeling of positie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rechtvaardiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De regering zocht naar een juridische <w>legitimatie</w> voor de nieuwe maatregelen.",
                            "target_lang_translations": {
                                "zh": "政府正在为新措施寻求法律上的<w>合法化</w>依据。"
                            }
                        },
                        {
                            "text": "Er is geen enkele <w>legitimatie</w> voor dit soort geweld tegen onschuldige burgers.",
                            "target_lang_translations": {
                                "zh": "这种针对无辜平民的暴力行为没有任何<w>正当化</w>理由。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使行为或立场合法化或正当化的过程"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "合法化",
                                "target_lang_sense_clarification": "指使某事符合法律规定"
                            },
                            {
                                "target_lang_word": "正当化",
                                "target_lang_sense_clarification": "指为某行为提供合理依据"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acf81661-14c4-3382-9f5a-05afdd1f89d9",
                    "sense_definition": "de wettelijke of morele basis voor iemands macht of gezag",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "rechtvaardiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koning zocht naar de historische <w>legitimatie</w> van zijn troonopvolging.",
                            "target_lang_translations": {
                                "zh": "国王在寻求其王位继承的各种历史<w>合法性</w>。"
                            }
                        },
                        {
                            "text": "Zonder democratische <w>legitimatie</w> kan een leider zijn beleid moeilijk doorvoeren.",
                            "target_lang_translations": {
                                "zh": "没有民主<w>合法性</w>，领导人很难推行其政策。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "某人权力或权威的法律或道德基础"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "合法性",
                                "target_lang_sense_clarification": "指权力或地位的合理性与合法基础"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}