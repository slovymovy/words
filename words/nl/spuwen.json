                    "frequency": "Middle",
                    "semantic_group_id": "uitstoten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De geiser laat dagelijks veel water naar buiten <w>spuwen</w>.",
                            "target_lang_translations": {
                                "en": "The geyser <w>spews</w> out a lot of water daily."
                            }
                        },
                        {
                            "text": "De vulkaan begon plotseling as en gloeiende lava te <w>spuwen</w>.",
                            "target_lang_translations": {
                                "en": "The volcano suddenly began to <w>spew</w> ash and glowing lava."
                            }
                        }
                    ],
                    "synonyms": [
