                ],
                "senses": [
                    {
                        "sense_id": "95301aa6-e763-38d4-90fc-bd190eb1cb48",
                        "entry_id": "a6c546ca-386b-320a-a59a-4142f015744b",
                        "glosses": [
                            "iets vervelends wat een mens overkomt, waar geen oorzaak voor is en waar niets aan te doen is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "107c11e8-550e-49be-890c-bd8c59ce88eb",
                                "sense_id": "95301aa6-e763-38d4-90fc-bd190eb1cb48",
                                "text": "Het was blijkbaar zijn noodlot om in die maalstroom terecht te komen."
                            },
                            {
                                "example_id": "0b91a902-9a9d-4f7a-bb47-f80cb53a2d0a",
                                "sense_id": "95301aa6-e763-38d4-90fc-bd190eb1cb48",
                                "text": "Hij wist heus wel dat hij vooral uit een soort bijgeloof de komende wapenstilstand niet serieus wilde nemen: hoe meer je hoopt op vrede, hoe minder geloof je eraan hecht als die wordt aangekondigd, om zo het noodlot te bezweren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "424e816d-72bf-4183-b279-2ba14fd62cae",
                        "source_entry_id": "a6c546ca-386b-320a-a59a-4142f015744b",
                        "source_sense_id": "95301aa6-e763-38d4-90fc-bd190eb1cb48",
                        "source_sense_description": "datgene wat het toeval iemand doet overkomen",
                        "target_lang_word": "Schicksal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schicksal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4f53d54-2715-38c3-8feb-ff0cf8c66e4e",
                                        "entry_id": "282b22c1-1720-387d-aa09-d709b2562fb6",
                                        "glosses": [
                                            "höhere Macht, welche die Zukunft der/eines Menschen beliebig beeinflusst und lenkt"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0f7f7bf-fb5f-4771-8ae6-8a3a7938cc61",
                                                "sense_id": "b4f53d54-2715-38c3-8feb-ff0cf8c66e4e",
                                                "text": "„Das Schicksal ist launisch und grausam.“"
                                            },
                                            {
                                                "example_id": "f0d0c69d-a704-411b-b68c-491fcbcfe768",
                                                "sense_id": "b4f53d54-2715-38c3-8feb-ff0cf8c66e4e",
                                                "text": "„Das Schicksal mischt die Karten und wir spielen.“"
                                            },
                                            {
                                                "example_id": "cf03affd-6ab4-45e0-b1c1-1a367f69ada0",
                                                "sense_id": "b4f53d54-2715-38c3-8feb-ff0cf8c66e4e",
                                                "text": "„Doch das Schicksal machte schon bald meiner bitteren Probezeit ein Ende.“"
                                            },
                                            {
                                                "example_id": "7741d312-2c75-4baa-8f13-91ad243796a4",
                                                "sense_id": "b4f53d54-2715-38c3-8feb-ff0cf8c66e4e",
                                                "text": "„Das Schicksal ist so alt wie die Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "925783cb-3ff4-3b2e-bdad-c7e3baac27df",
                                        "entry_id": "282b22c1-1720-387d-aa09-d709b2562fb6",
                                        "glosses": [
                                            "vermeintliche, sich auf eine oder mehrere Personen beziehende Folge des Schicksals ^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "967d7cc5-abb3-4a96-8000-cf18af8a5ca1",
                                                "sense_id": "925783cb-3ff4-3b2e-bdad-c7e3baac27df",
                                                "text": "Die traurigen Schicksale dieser armen Menschen berührten sie sehr."
                                            },
                                            {
                                                "example_id": "11661312-e94d-4dc0-b049-ab159153cf58",
                                                "sense_id": "925783cb-3ff4-3b2e-bdad-c7e3baac27df",
                                                "text": "„In Rückblenden erfahren wir vom Schicksal des Helden, der es zu Hause, beim spießbürgerlichen Vater vor allem, nicht mehr aushielt und hinauszog in die Welt.“"
                                            },
                                            {
                                                "example_id": "962a8363-f909-4cbf-9d9b-f04ebb5143af",
                                                "sense_id": "925783cb-3ff4-3b2e-bdad-c7e3baac27df",
                                                "text": "„Hat er genug zu leben und hat das Schicksal ihn nicht mit Krankheit geschlagen, ist er zufrieden und dankbar, und leidet er Not und Entbehrung, trägt er auch diese Schickung mit Würde.“"
                                            },
                                            {
                                                "example_id": "22ca2872-0389-41ad-9c6a-6d72993eee61",
                                                "sense_id": "925783cb-3ff4-3b2e-bdad-c7e3baac27df",
                                                "text": "„Das Schicksal Deutschlands war dem Grunde nach seit der Teheran-Konferenz von 1943 entschieden.“"
                                            },
                                            {
                                                "example_id": "f2dbe0a9-1d2c-480e-9111-18fd338463e3",
                                                "sense_id": "925783cb-3ff4-3b2e-bdad-c7e3baac27df",
                                                "text": "„Ihr Schicksal hatte sich entschieden, und es hatte sich glücklich entschieden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6dd092c-61c9-41b7-b850-75f2d04d140c",
                        "source_entry_id": "a6c546ca-386b-320a-a59a-4142f015744b",
                        "source_sense_id": "95301aa6-e763-38d4-90fc-bd190eb1cb48",
                        "source_sense_description": "datgene wat het toeval iemand doet overkomen",
                        "target_lang_word": "fate",
