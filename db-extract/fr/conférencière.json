                    {
                        "sense_id": "48b74a68-5801-312b-a72b-a5e2919900ac",
                        "entry_id": "413ec7e9-2b1b-3a60-9b26-ed874b23e49d",
                        "glosses": [
                            "Personne qui parle à un auditoire lors d'une conférence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9286a67d-5e36-43a8-a85d-dea5965d9ac5",
                                "sense_id": "48b74a68-5801-312b-a72b-a5e2919900ac",
                                "text": "Attention, alerte quand même Anna Bressan, conférencière et secrétaire de Women in Games, ces quelques têtes d’affiche sont aussi « des actions de communication, qui ne correspondent pas à ce qu’on retrouve dans la totalité des jeux »."
                            }
                        ]
