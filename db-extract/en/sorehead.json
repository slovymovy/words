                                        "glosses": [
                                            "jemand, der schmollt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6185f50-88e0-44bf-b13a-c15a0ff80e57",
                                                "sense_id": "14b96d4d-4275-36dd-b250-db3af2a8c8d2",
                                                "text": "Thomas spielt wieder die beleidigte Leberwurst."
                                            },
                                            {
                                                "example_id": "5886c048-84f1-404c-a6bb-d612157b4956",
                                                "sense_id": "14b96d4d-4275-36dd-b250-db3af2a8c8d2",
                                                "text": "Er ist sehr empfindlich und wird häufig als beleidigte Leberwurst bezeichnet."
                                            },
                                            {
                                                "example_id": "9fe912ac-6d22-4b96-8a38-b3c57a4b8809",
                                                "sense_id": "14b96d4d-4275-36dd-b250-db3af2a8c8d2",
                                                "text": "\"Nun spiel' doch nicht die beleidigte Leberwurst! Das mit der Mimose habe ich doch nicht so gemeint.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
