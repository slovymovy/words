                {
                    "sense_id": "1c7fd022-a5b8-3ae4-92fb-0cc98f388cbd",
                    "sense_definition": "Showing a tendency to happen quickly, frequently, or with little provocation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Small children get bored very <w>easily</w>.",
                            "target_lang_translations": {
                                "ru": "Маленькие дети очень <w>легко</w> начинают скучать.",
                                "zh": "小孩子非常<w>容易</w>感到无聊。",
                                "nl": "Kleine kinderen vervelen zich heel <w>snel</w>.",
                                "pl": "Małe dzieci bardzo <w>łatwo</w> się nudzą.",
                                "de": "Kleine Kinder langweilen sich sehr <w>leicht</w>.",
                                "fr": "Les jeunes enfants s'ennuient très <w>facilement</w>.",
                                "it": "I bambini piccoli si annoiano molto <w>facilmente</w>.",
                                "cs": "Malé děti se velmi <w>snadno</w> začnou nudit.",
                                "tr": "Küçük çocuklar çok <w>kolayca</w> sıkılırlar.",
                                "es": "Los niños pequeños se aburren muy <w>fácilmente</w>."
                            }
                        },
                        {
                            "text": "Glass is fragile and breaks <w>easily</w> if dropped.",
                            "target_lang_translations": {
                                "ru": "Стекло хрупкое и <w>легко</w> бьется, если его уронить.",
                                "zh": "玻璃很脆，掉在地上很<w>容易</w>碎。",
                                "nl": "Glas is breekbaar en gaat <w>snel</w> kapot als je het laat vallen.",
                                "pl": "Szkło jest kruche i <w>łatwo</w> się tłucze, jeśli upadnie.",
                                "de": "Glas ist zerbrechlich und geht <w>leicht</w> kaputt, wenn man es fallen lässt.",
                                "fr": "Le verre est fragile et se casse <w>facilement</w> si on le fait tomber.",
                                "it": "Il vetro è fragile e si rompe <w>facilmente</w> se cade.",
                                "cs": "Sklo je křehké a pokud spadne, <w>snadno</w> se rozbije.",
                                "tr": "Cam kırılgandır ve düşürülürse <w>kolayca</w> kırılır.",
                                "es": "El vidrio es frágil y se rompe <w>fácilmente</w> si se cae."
                            }
                        }
