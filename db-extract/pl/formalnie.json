                                        "entry_id": "4e93b674-8bec-33b8-acb7-1fd4aff6ee33",
                                        "glosses": [
                                            "With constant frequency or pattern."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8563e81-7547-4010-9790-869bec59e810",
                                                "sense_id": "909ae75d-e1f6-3251-a9f0-988aaecdd541",
                                                "text": "We regularly buy lottery tickets from the corner store."
                                            },
                                            {
                                                "example_id": "197bf772-224f-4377-9120-f1f4fe0cb924",
                                                "sense_id": "909ae75d-e1f6-3251-a9f0-988aaecdd541",
                                                "text": "Wax models of the pudenda of both sexes were regularly placed before the altar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57c46cbf-5208-3dd7-83ac-1148fc05048b",
                                        "entry_id": "4e93b674-8bec-33b8-acb7-1fd4aff6ee33",
                                        "glosses": [
                                            "normally; ordinarily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70f5e888-4046-407c-a241-964eb307f5c4",
                                                "sense_id": "57c46cbf-5208-3dd7-83ac-1148fc05048b",
                                                "text": "Noemi decided to dress regularly for the party, instead of going for an outrageous outfit."
                                            },
                                            {
                                                "example_id": "a4684854-3230-42ad-beaf-d4c18aed7730",
                                                "sense_id": "57c46cbf-5208-3dd7-83ac-1148fc05048b",
                                                "text": "The period of life at which initiation takes place is regularly puberty."
                                            }
                                        ]
