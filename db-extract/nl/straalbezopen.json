                        "examples": [
                            {
                                "example_id": "504e4773-0fc3-40c0-b595-0f04bc8449be",
                                "sense_id": "50fb3921-80fb-3b8b-b36a-40ea3633b794",
                                "text": "Russen en wodka: het is een heilige twee-eenheid. De Russische literatuur is ervan doordrenkt. De Russische president Boris Jeltsin (1991-1999) ging eraan ten onder. De beelden van een straalbezopen Jeltsin in Berlijn die onder het oog van bondskanselier Kohl een politiekapel begint te dirigeren, doen het nog altijd goed op YouTube. Wodka hoort bij Rusland zoals wijn bij Frankrijk en wiet bij Nederland."
                            }
                        ]
                    }
