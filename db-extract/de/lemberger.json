            {
                "entry_id": "b143cac7-739b-3969-8002-7bf0c721b50d",
                "word": "Lemberger",
                "pos": "adj",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "603a2d66-29e8-4815-90ad-7429a1688b68",
                        "entry_id": "b143cac7-739b-3969-8002-7bf0c721b50d",
                        "tags": [
                            "positive"
                        ],
                        "form": "Lemberger"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b53b793-ca68-36a3-a9a8-8e859915fced",
                        "entry_id": "b143cac7-739b-3969-8002-7bf0c721b50d",
                        "glosses": [
                            "aus Lemberg stammend, kommend, zu Lemberg gehörig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31a380db-500f-49b5-ab43-6cd863a94023",
                                "sense_id": "6b53b793-ca68-36a3-a9a8-8e859915fced",
                                "text": "„Die Lemberger Jesuiten haben im Literaturbetrieb der Stadt deutliche Spuren hinterlassen.“"
                            },
                            {
                                "example_id": "7efb0a8f-6552-425d-98db-cb47e61df660",
                                "sense_id": "6b53b793-ca68-36a3-a9a8-8e859915fced",
                                "text": "„Die Lemberger Mundart entstand vor allem in den Vorstädten wie Lützenhof, Klöpperhof und anderen, die vorwiegend von Polen, Ukrainern und Juden bewohnt waren.“"
                            },
                            {
                                "example_id": "cde46a7f-3ef1-4ac5-ab22-27d5d2fe811c",
                                "sense_id": "6b53b793-ca68-36a3-a9a8-8e859915fced",
                                "text": "„Der zweite Essay befasst sich mit der gegenwärtigen Darstellung der Stadtgeschichte durch die Lemberger Eliten und die Politik […].“"
                            },
                            {
                                "example_id": "838d8dba-703c-455f-9d96-6a57e54186eb",
                                "sense_id": "6b53b793-ca68-36a3-a9a8-8e859915fced",
                                "text": "„Vorrangiges Opfer der nationalsozialistischen Besatzung waren die Lemberger Juden.“"
                            },
                            {
                                "example_id": "9d4bae5d-fdea-4ca1-b1bc-f0a7f68610c9",
                                "sense_id": "6b53b793-ca68-36a3-a9a8-8e859915fced",
                                "text": "„Die Lemberger Museen, die sich kulturellen Figuren widmen, ehren fast ausschließlich Ukrainer, etwa den Maler Iwan Trusch und die Opernsängerin Salomea Kruschelnitzka, nach der auch die Lemberger Oper benannt ist.“"
                            },
                            {
                                "example_id": "fadfa33a-8f17-4f7a-9d8b-a34f93ccef48",
                                "sense_id": "6b53b793-ca68-36a3-a9a8-8e859915fced",
                                "text": "„In dieser Verfassung existierte die Lemberger Universität bis zum Beginn des 19. Jahrhunderts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
