    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e7a76fae-bb37-346c-b8ed-efee81764b71",
                    "sense_definition": "Femme qui s'engage à soutenir un enfant lors de son baptême religieux ou républicain et à veiller sur son développement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "parrainage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ma <w>marraine</w> m'a offert un livre magnifique pour mon dixième anniversaire."
                        },
                        {
                            "text": "Ils ont demandé à sa sœur d'être la <w>marraine</w> du nouveau-né."
                        }
                    ],
                    "common_phrases": [
                        "choisir une marraine",
                        "le parrain et la marraine"
                    ]
                },
                {
                    "sense_id": "5881c40c-75e5-334d-9550-fee5f050877e",
                    "sense_definition": "Femme qui donne son nom ou apporte son patronage symbolique à un navire, une cloche ou une promotion.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "parrainage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La célèbre navigatrice a accepté de devenir la <w>marraine</w> du nouveau voilier."
                        },
                        {
                            "text": "Lors de l'inauguration de la cloche, sa <w>marraine</w> a prononcé un discours très émouvant."
                        }
                    ],
                    "synonyms": [
                        "patronne"
                    ],
                    "common_phrases": [
                        "marraine de promotion",
                        "marraine d'un navire"
                    ]
                },
                {
                    "sense_id": "55b8e1f5-4c66-3d2b-a968-80a6f3db457c",
                    "sense_definition": "Ville ou collectivité qui apporte un soutien financier et moral à une localité détruite ou sinistrée par une guerre.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la guerre, cette grande métropole est devenue la <w>marraine</w> d'un village dévasté."
                        },
                        {
                            "text": "La ville <w>marraine</w> a financé la reconstruction de l'école et de l'hôpital local."
                        }
                    ],
                    "common_phrases": [
                        "ville marraine"
                    ]
                },
                {
                    "sense_id": "71fcff51-bc3f-38ca-8a29-60958070143d",
                    "sense_definition": "Mère du parrain dans certains usages traditionnels ou coutumiers.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce petit village isolé, la coutume donnait le titre de <w>marraine</w> à la mère du parrain."
                        },
                        {
                            "text": "Elle était respectée comme <w>marraine</w> de par son lien familial avec le parrain de l'enfant."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "usage traditionnel ou régional"
                        }
                    ]
                }
            ]
        }
