                        "entry_id": "2286ed77-4a36-3c99-aa2c-957935654ee7",
                        "glosses": [
                            "geen enkele keer; nooit meer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c1a1b8b-3826-427c-996a-78193291b1fa",
                                "sense_id": "45fcdf50-1bf3-3c90-95e1-c0b7301b10d0",
                                "text": "Mijn schild ende betrouwen\nzijt Gij, o God mijn Heer,\nop U zo wil ik bouwen,\nVerlaat mij nimmermeer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1366b06-8d96-4aef-bc26-5ae906301288",
                        "source_entry_id": "2286ed77-4a36-3c99-aa2c-957935654ee7",
                        "source_sense_id": "45fcdf50-1bf3-3c90-95e1-c0b7301b10d0",
                        "source_sense_description": "geen enkele keer; nooit meer",
                        "target_lang_word": "nevermore",
