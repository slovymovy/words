{
    "word_family": [
        "waddler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0fee17f5-0ebd-3e67-bfa1-2d336bb95387",
                    "sense_definition": "To walk with short steps, tilting the body from side to side.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The duck <w>waddled</w> across the grass toward the pond.",
                            "target_lang_translations": {
                                "ru": "Утка <w>переваливаясь</w> прошла по траве к пруду."
                            }
                        },
                        {
                            "text": "The toddler <w>waddled</w> toward his mother with a funny <w>waddle</w>.",
                            "target_lang_translations": {
                                "ru": "Малыш <w>зашлепал</w> к маме смешной походкой вразвалку."
                            }
                        }
                    ],
                    "synonyms": [
                        "totter",
                        "sway"
                    ],
                    "common_phrases": [
                        "funny waddle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передвигаться короткими шагами, переваливаясь с боку на бок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ходить вразвалку",
                                "target_lang_sense_clarification": "о способе передвижения, характерном для уток или полных людей"
                            },
                            {
                                "target_lang_word": "переваливаться",
                                "target_lang_sense_clarification": "о движении с покачиванием из стороны в сторону"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f21119b-95b2-3a98-9875-93c381c418de",
                    "sense_definition": "To move slowly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old ship <w>waddled</w> through the heavy waves.",
                            "target_lang_translations": {
                                "ru": "Старый корабль тяжело <w>переваливался</w> через высокие волны."
                            }
                        },
                        {
                            "text": "The heavy machine <w>waddled</w> along the factory floor.",
                            "target_lang_translations": {
                                "ru": "Тяжелая машина медленно <w>переваливалась</w> по цеху."
                            }
                        }
                    ],
                    "synonyms": [
                        "lumber",
                        "trudge"
                    ],
                    "antonyms": [
                        "dash",
                        "sprint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медленно и тяжело передвигаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плестись",
                                "target_lang_sense_clarification": "о медленном, тяжелом движении"
                            },
                            {
                                "target_lang_word": "тащиться",
                                "target_lang_sense_clarification": "о медленном, затрудненном перемещении"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3b8da546-3939-3195-a136-81fb236698e1",
                    "sense_definition": "A squat, swaying gait.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The duck had a distinct <w>waddle</w> as it walked.",
                            "target_lang_translations": {
                                "ru": "У утки была характерная <w>походка вразвалку</w>."
                            }
                        },
                        {
                            "text": "He walked with a funny <w>waddle</w> after hurting his leg.",
                            "target_lang_translations": {
                                "ru": "После травмы ноги он ходил смешной <w>походкой вразвалку</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sway"
                    ],
                    "common_phrases": [
                        "funny waddle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Походка вразвалку, при которой тело покачивается из стороны в сторону."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "походка вразвалку",
                                "target_lang_sense_clarification": "существительное, описывающее манеру ходьбы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "bf139349-ed8c-3ea9-bdbb-dc660a052257",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Waddles</w> is our new neighbor.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Уоддлс</w> — наш новый сосед."
                            }
                        },
                        {
                            "text": "The family name is <w>Waddles</w>.",
                            "target_lang_translations": {
                                "ru": "Фамилия этой семьи — <w>Уоддлс</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Уоддлс",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}