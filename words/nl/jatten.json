{
    "word_family": [
        "jat",
        "gejat"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c1e9ef94-63c5-3b05-8367-46b4fae664e0",
                    "sense_definition": "iets wegnemen van iemand en het zich wederrechtelijk toe-eigenen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "stelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Iemand heeft gisteravond mijn fiets <w>gejat</w> bij het station.",
                            "target_lang_translations": {
                                "en": "Someone <w>nicked</w> my bike at the station last night."
                            }
                        },
                        {
                            "text": "Je moet niet zomaar spullen <w>jatten</w> van je klasgenoten.",
                            "target_lang_translations": {
                                "en": "You shouldn't just <w>swipe</w> things from your classmates."
                            }
                        }
                    ],
                    "synonyms": [
                        "pikken",
                        "stelen",
                        "gappen",
                        "klauwen"
                    ],
                    "common_phrases": [
                        "fiets jatten",
                        "spullen jatten"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik voor stelen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to take something from someone and unlawfully appropriate it"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nick",
                                "target_lang_sense_clarification": "informal British English for stealing"
                            },
                            {
                                "target_lang_word": "pinch",
                                "target_lang_sense_clarification": "informal for stealing something small"
                            },
                            {
                                "target_lang_word": "swipe",
                                "target_lang_sense_clarification": "to steal something quickly"
                            },
                            {
                                "target_lang_word": "steal",
                                "target_lang_sense_clarification": "general term for taking without permission"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d15364fb-fa46-3beb-b472-ae4041f2d3be",
                    "sense_definition": "meervoud verleden tijd van <w>jatten</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vroeger <w>jatten</w> de kinderen soms appels uit de boomgaard van de buurman.",
                            "target_lang_translations": {
                                "en": "In the past, the children used to <w>pinch</w> apples from the neighbor's orchard."
                            }
                        },
                        {
                            "text": "Zij <w>jatten</w> de muziekbladen en bestudeerden de hitparade urenlang.",
                            "target_lang_translations": {
                                "en": "They <w>stole</w> the music magazines and studied the charts for hours."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verleden tijd meervoud"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural past tense of 'jatten' (to steal)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stole",
                                "target_lang_sense_clarification": "past tense of steal"
                            },
                            {
                                "target_lang_word": "nicked",
                                "target_lang_sense_clarification": "past tense of nick"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "50dfd1b9-5b20-3607-966d-847acc2704ae",
                    "sense_definition": "meervoud van <w>jat</w>: handen of poten",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lichaamsdelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Blijf met je <w>jatten</w> van mijn eten af!",
                            "target_lang_translations": {
                                "en": "Keep your <w>paws</w> off my food!"
                            }
                        },
                        {
                            "text": "Hij hield het kostbare voorwerp stevig vast met zijn grote <w>jatten</w>.",
                            "target_lang_translations": {
                                "en": "He held the precious object tightly with his big <w>mitts</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "met je jatten"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak op een onvriendelijke manier gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of 'jat': hands or paws"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "paws",
                                "target_lang_sense_clarification": "informal/rude way to refer to hands"
                            },
                            {
                                "target_lang_word": "mitts",
                                "target_lang_sense_clarification": "slang for hands"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}