                            {
                                "example_id": "5641216e-4631-4f71-a418-58557069ca4a",
                                "sense_id": "bbafe1f9-ad9a-316d-844b-12a23a4ff4b0",
                                "text": "Wie is nou eigenlijk precies de schepper van de aarde?"
                            }
                        ]
                    },
                    {
                        "sense_id": "9eec3833-d2b7-3b32-9dea-aee3f9d1b6e8",
                        "entry_id": "87297801-aa06-32bf-88e4-1d443dbf230b",
