                                        "glosses": [
                                            "hochschnellen und sich ein kurzes Stück durch die Luft bewegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bae72bff-65fc-41f3-b5a4-643ebb470476",
                                                "sense_id": "2e2ec08e-4603-3331-8fdc-374b06dedaa2",
                                                "text": "Sie springt zwei Meter hoch."
                                            },
                                            {
                                                "example_id": "663e95f5-e292-4b15-bb33-e8d34af08f0f",
                                                "sense_id": "2e2ec08e-4603-3331-8fdc-374b06dedaa2",
                                                "text": "„Ich […] sprang in das Motorboot und fuhr es auf die andere Seite des Stegs, um es dort festzumachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9a082c85-1797-3409-894a-cc051680c479",
                                        "entry_id": "b83ef347-f7b6-309e-84cd-6615ea7f750a",
                                        "glosses": [
                                            "sich plötzlich ins Blickfeld bewegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0aea15e4-008f-455c-b41c-9273b64f1966",
                                                "sense_id": "9a082c85-1797-3409-894a-cc051680c479",
                                                "text": "Plötzlich sprangen zwei Männer aus dem Gebüsch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "36bf7437-cb33-35b8-8b6f-8e9523f8c411",
