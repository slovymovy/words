                        "sense_id": "86da783f-348a-3351-bae8-00f5cf613246",
                        "entry_id": "8f14ee32-15cd-3207-a87e-a467c313c722",
                        "glosses": [
                            "D’une façon stylistique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f90612d8-5902-48ba-9965-c0c8a294bf3a",
                                "sense_id": "86da783f-348a-3351-bae8-00f5cf613246",
                                "text": "« Je sais depuis le début que, stylistiquement, je voulais créer une conversation avec le piano », explique Di Salvio, qui a récemment collaboré avec le groupe Misteur Valaire."
                            },
                            {
                                "example_id": "8963eed9-6119-4b73-86ed-a512b101fbd2",
                                "sense_id": "86da783f-348a-3351-bae8-00f5cf613246",
                                "text": "Cette interprétation, en plus d’être stylistiquement pauvre, est aussi conceptuellement vide."
                            },
                            {
                                "example_id": "dd8ecc80-d52d-4375-b90a-ffc24998c0e4",
                                "sense_id": "86da783f-348a-3351-bae8-00f5cf613246",
                                "text": "Le monnayage attribué aux Aulerques Diablintes appartient stylistiquement à un ensemble armoricain, notamment par la présence au revers d’un cheval androcéphale."
                            }
                        ]
                    }
                ],
