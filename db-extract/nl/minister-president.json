                        "entry_id": "7a10b0c0-9c49-34c3-9a9d-227c8a881341",
                        "glosses": [
                            "de minister die het kabinet aanvoert"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "f5077962-5e40-4197-bc5d-bedf6ead0cb4",
                                "sense_id": "c05f69b4-99d4-3efc-9bb3-bbc0fd6a6ab4",
                                "text": "Het is nog onduidelijk wie de volgende minister-president wordt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "949a24ff-c867-4a1c-95bc-1bf3c40a52e8",
                        "source_entry_id": "7a10b0c0-9c49-34c3-9a9d-227c8a881341",
                        "source_sense_id": "c05f69b4-99d4-3efc-9bb3-bbc0fd6a6ab4",
                        "source_sense_description": "de minister die het kabinet aanvoert",
                        "target_lang_word": "Premierminister",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Premierminister",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d78f751f-610b-3dbc-b2fe-e8513bc0307c",
                                        "entry_id": "fc17c6be-d4f1-3e13-9fbe-c9204d43f901",
                                        "glosses": [
                                            "Regierungschef in parlamentarischen Staaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e2efaa1-cb63-4828-a9f1-002a48858eb4",
                                                "sense_id": "d78f751f-610b-3dbc-b2fe-e8513bc0307c",
                                                "text": "„Auch der britische Premierminister Gordon Brown hatte an Chinas Regierung appelliert, den Mann von einer Todesstrafe zu verschonen.“"
                                            },
                                            {
                                                "example_id": "3ffc4aec-de0a-476a-83d3-c3e745823638",
                                                "sense_id": "d78f751f-610b-3dbc-b2fe-e8513bc0307c",
                                                "text": "„Gut anderthalb Jahre ist es her, dass Modi das Amt des Premierministers übernahm, um überall im Land Großes wie in Jayapur zu vollbringen.“"
                                            },
                                            {
                                                "example_id": "74917105-f0be-42de-a73d-a4789bbbe1e3",
                                                "sense_id": "d78f751f-610b-3dbc-b2fe-e8513bc0307c",
                                                "text": "„Erster Premierminister des neuen Staates wird Patrice Lumumba.“"
                                            },
                                            {
                                                "example_id": "a557c126-84d8-4fff-abdf-ae189c5e89b8",
                                                "sense_id": "d78f751f-610b-3dbc-b2fe-e8513bc0307c",
                                                "text": "„Nicht genug damit, dass er sich an der Ermordung des ehemaligen Premierministers Churchill mitschuldig machte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd72201e-e01c-4e95-abd7-fb7a3f1fc0f5",
                        "source_entry_id": "7a10b0c0-9c49-34c3-9a9d-227c8a881341",
                        "source_sense_id": "c05f69b4-99d4-3efc-9bb3-bbc0fd6a6ab4",
                        "source_sense_description": "de minister die het kabinet aanvoert",
                        "target_lang_word": "prime minister",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prime minister",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68e2562e-127e-3176-8d3b-ef6810521476",
                                        "entry_id": "d56896d4-7df2-30e6-b03b-d5de1e7141f6",
                                        "glosses": [
                                            "The chief member of the cabinet and head of the government, especially in a parliamentary democracy; often the leader of the majority party."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "009ec92f-011d-4a29-8fe9-2f58a604d326",
                                                "sense_id": "68e2562e-127e-3176-8d3b-ef6810521476",
                                                "text": "This is a list of all prime ministers since Churchill."
                                            },
                                            {
                                                "example_id": "ddff9047-cae9-4b8e-b09c-197599c948a0",
                                                "sense_id": "68e2562e-127e-3176-8d3b-ef6810521476",
                                                "text": "Yesterday we had a visit from the Prime Minister / prime minister. (See usage notes below.)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0dff6b4c-a972-41d2-b6fd-6df0660fc71b",
                        "source_entry_id": "7a10b0c0-9c49-34c3-9a9d-227c8a881341",
                        "source_sense_id": "c05f69b4-99d4-3efc-9bb3-bbc0fd6a6ab4",
                        "source_sense_description": "de minister die het kabinet aanvoert",
                        "target_lang_word": "premier ministre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "premier ministre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2fb0727a-f804-3623-b995-03f46abe7537",
                                        "entry_id": "29aee26e-c89d-3298-9680-c4dcfc02b56b",
                                        "glosses": [
                                            "Titre du chef de gouvernement dans divers pays ou provinces, parmi lesquels le Royaume-Uni, la France (depuis 1959), la Belgique, l’Inde, le Canada et ses provinces, l’Italie, le Japon, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1db747f1-22e9-421f-a214-fcc33f001c99",
                                                "sense_id": "2fb0727a-f804-3623-b995-03f46abe7537",
                                                "text": "Tel est en Angleterre le premier ministre ; et lorsqu’à cette influence prodigieuse de sa place, il peut joindre, comme le fit M. Pitt, la charge de chancelier de l’échiquier, et inspirer une grande confiance au monarque, en faisant adopter de vastes et utiles projets, on peut dire qu’il a dans ses opérations une latitude aussi grande que peut le permettre un gouvernement constitutionnel."
                                            },
                                            {
                                                "example_id": "3be22113-4939-4645-8d37-18f4f751b649",
                                                "sense_id": "2fb0727a-f804-3623-b995-03f46abe7537",
                                                "text": "Le Commissariat général du Plan a été chargé par le Premier ministre d’élaborer un « rapport sur les perspectives de la France », visant à éclairer les stratégies économiques et sociales du pays et les choix à moyen terme des autorités publiques. Conformément à la demande du Premier ministre, le rapport a été élaboré en toute indépendance."
                                            },
                                            {
                                                "example_id": "ea866e89-e28d-416c-931f-cf6af79b4074",
                                                "sense_id": "2fb0727a-f804-3623-b995-03f46abe7537",
                                                "text": "Le 4 octobre 1911, le Premier ministre Giolitti donne le coup d’envoi au départ d’un corps expéditionnaire. Il va vite atteindre les 100 000 hommes, marins et bersagliers, transportés par des centaines de navires."
                                            },
                                            {
                                                "example_id": "d9d0c1ca-3c00-44ff-b3af-dc23c7d02fd4",
                                                "sense_id": "2fb0727a-f804-3623-b995-03f46abe7537",
                                                "text": "La première ministre écossaise, Nicola Sturgeon, veut un second référendum en faveur de l’indépendance de l’Écosse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
