                                                "example_id": "34b88b59-ed5c-4cc9-beb3-cc6a7466afde",
                                                "sense_id": "2f26f7b2-47a8-3ff9-acde-a1cf9828aa33",
                                                "text": "Dotąd nalegał, póki się nie zgodzili."
                                            },
                                            {
                                                "example_id": "f40cd72e-2927-4fac-805c-c5fccac8327c",
