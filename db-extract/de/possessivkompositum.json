                "senses": [
                    {
                        "sense_id": "a2450686-4a1c-3f3f-9881-b1224bd33f9c",
                        "entry_id": "1e7e36b4-7d81-3e63-b9d9-98a73171bd43",
                        "glosses": [
                            "exozentrische (Wort-)Zusammensetzung, die den gemeinten Gegenstand, das gemeinte Lebewesen, durch eine ihrer Eigenschaften kennzeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06e05b52-080e-4213-8e29-db98b77d0100",
                                "sense_id": "a2450686-4a1c-3f3f-9881-b1224bd33f9c",
                                "text": "„Blaukehlchen“ ist ein Possessivkompositum, bei dem der Singvogel durch Angabe seiner Eigenschaft, eine blaue Kehle zu haben, benannt wird. Mit dem Possessivkompositum „Vierzylinder“ ist ein Auto gemeint, dessen Motor vier Zylinder hat. Ein „Blaukehlchen“ ist aber kein *„Kehlchen“, ein „Vierzylinder“ kein *„Zylinder“; daher handelt es sich bei diesen Wörtern nicht um Determinativkomposita."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
