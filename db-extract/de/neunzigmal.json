                "senses": [
                    {
                        "sense_id": "5cdb4d1b-862c-33c0-9dcd-a3d7d47b4dba",
                        "entry_id": "92727d4f-d350-3c51-94be-f68476b5693a",
                        "glosses": [
                            "mit neunzig vervielfacht; zehnmal und achtzig weitere Male; neunzigfach vorgekommen, durchgeführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb5ebbbf-190c-4354-99a0-011701b37110",
                                "sense_id": "5cdb4d1b-862c-33c0-9dcd-a3d7d47b4dba",
                                "text": "„Platin ist ein edles und derzeit nach Rhodium bzw. noch vor Gold das zweitwertvollste Edelmetall – es ist ca. neunzigmal teurer als Silber.“"
                            },
                            {
                                "example_id": "e86ea9f2-dad9-45cb-aad2-4022a656a37e",
                                "sense_id": "5cdb4d1b-862c-33c0-9dcd-a3d7d47b4dba",
                                "text": "„Mann und Frau legten sich neunzigmal abends nebeneinander ins Bett, lasen, gaben sich einen Gutenachtkuß, löschten das Licht und rollten sich jeweils auf ihre Seite“"
                            },
                            {
                                "example_id": "d23001ba-ccc7-40a3-9e17-8ee455643842",
                                "sense_id": "5cdb4d1b-862c-33c0-9dcd-a3d7d47b4dba",
                                "text": "„Hassan heiratete neunzigmal, Omar hatte neun Ehefrauen (vier Ehen schloß er vor, fünf nach seiner Konversion zum Islam), abd ar-Rahman sechzehn, und sie alle hatten neben ihren legitimen Ehefrauen Konkubinen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
