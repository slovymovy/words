                                        "sense_id": "19cc47b0-8ada-3df9-b5fd-14927bff3a25",
                                        "entry_id": "2face951-b79b-39d8-8dce-2bf98cbe1ce1",
                                        "glosses": [
                                            "A codeword that marks the use of a specific cryptic device."
                                        ],
