                                            "with-infinitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17c1636f-c2f1-4f32-a598-62c2a00f4a5a",
                                                "sense_id": "bf7ed9f2-78fb-3e44-b5d1-aa0ba25f626b",
                                                "text": "I'm fitting to go home and sleep."
                                            },
                                            {
                                                "example_id": "c8ed2a5f-54da-4feb-865a-0f97ac03ef29",
                                                "sense_id": "bf7ed9f2-78fb-3e44-b5d1-aa0ba25f626b",
                                                "text": "'I am fitting to go to South Hadley Seminary [as Mount Holyoke was known], and expect if my health is good to enter that institution a year from next fall', she confided to Abiah."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
