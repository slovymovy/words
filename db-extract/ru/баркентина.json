                "senses": [
                    {
                        "sense_id": "e2e8f881-4b76-3264-8631-912a29aca203",
                        "entry_id": "bfc7c1df-693c-3532-923e-0e13bd8f1e8f",
                        "glosses": [
                            "морск. морское парусное грузовое или учебное судно с прямыми парусами на фок-мачте и косыми на остальных"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25598e40-e376-46d3-a704-371078962be0",
                                "sense_id": "e2e8f881-4b76-3264-8631-912a29aca203",
                                "text": "Четырехмачтовая баркентина Star Clipper пришвартована в порту Бриджтаун."
                            },
                            {
                                "example_id": "d63da3a4-465f-4639-9305-dc94ea9fecbe",
                                "sense_id": "e2e8f881-4b76-3264-8631-912a29aca203",
                                "text": "Если ветер отсюда, а баркентина стоит носом к выходу из бухты, тогда стаксель закреплен на левый галс."
                            }
                        ]
                    }
                ],
