                                "target_senses": [
                                    {
                                        "sense_id": "ab08cd0f-7b4b-38b3-97c7-bb0585b4dfc4",
                                        "entry_id": "4636d123-2e50-3024-8644-40af5e7fde77",
                                        "glosses": [
                                            "Having been subjected to torture, mental or physical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbce37b6-b324-4cac-b3bb-70333f6ab24f",
                                                "sense_id": "ab08cd0f-7b4b-38b3-97c7-bb0585b4dfc4",
                                                "text": "Those who have escaped the dark and terrible aspects of life will find my brutality, my flash of rage in our final tragedy, easy enough to blame; for they know what is wrong as well as any, but not what is possible to tortured men. But those who have been under the shadow, who have gone down at last to elemental things, will have a wider charity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e3e9567-863f-3964-965b-1640bfd4fe4c",
                                        "entry_id": "4636d123-2e50-3024-8644-40af5e7fde77",
                                        "glosses": [
                                            "Involving suffering and difficulty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18469be8-f5dd-41da-81a6-5b805d1585fc",
                                                "sense_id": "1e3e9567-863f-3964-965b-1640bfd4fe4c",
                                                "text": "a tortured history"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1a9f09f-fd4d-38d0-a5eb-38c12ce31a68",
                                        "entry_id": "4636d123-2e50-3024-8644-40af5e7fde77",
                                        "glosses": [
                                            "Of literature, burdened by unnecessary complexity, obfuscation, abstruseness, etc."
                                        ],
