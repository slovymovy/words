{
    "word_family": [
        "occasion",
        "occasional"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d086e2d3-62f1-318d-8c53-f606710c8b13",
                    "sense_definition": "At relatively infrequent intervals; happening sometimes but not often.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "frequency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>occasionally</w> go out for dinner on Fridays, but usually we cook at home.",
                            "target_lang_translations": {
                                "ru": "Мы <w>иногда</w> ходим ужинать в ресторан по пятницам, но обычно готовим дома.",
                                "zh": "我们周五<w>偶尔</w>会出去吃晚饭，但通常都在家做。"
                            }
                        },
                        {
                            "text": "He visits his grandparents <w>occasionally</w>, mostly during the summer holidays.",
                            "target_lang_translations": {
                                "ru": "Он навещает бабушку и дедушку <w>время от времени</w>, в основном во время летних каникул.",
                                "zh": "他<w>偶尔</w>会去探望祖父母，大多是在暑假期间。"
                            }
                        },
                        {
                            "text": "Very <w>occasionally</w>, the machine might stop working and need a restart.",
                            "target_lang_translations": {
                                "ru": "Лишь <w>изредка</w> машина может перестать работать, и потребуется перезагрузка.",
                                "zh": "机器<w>偶尔</w>会停止工作，需要重新启动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sometimes",
                        "from time to time",
                        "now and then",
                        "on occasion",
                        "every so often",
                        "intermittently",
                        "sporadically",
                        "once in a while",
                        "at times"
                    ],
                    "antonyms": [
                        "usually"
                    ],
                    "common_phrases": [
                        "only occasionally",
                        "very occasionally"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий через сравнительно редкие промежутки времени; случающийся иногда, но не часто.",
                        "zh": "指发生频率较低，偶尔出现但并不频繁。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иногда",
                                "target_lang_sense_clarification": "самый общий и употребительный вариант"
                            },
                            {
                                "target_lang_word": "изредка",
                                "target_lang_sense_clarification": "подчеркивает редкость события"
                            },
                            {
                                "target_lang_word": "время от времени",
                                "target_lang_sense_clarification": "указывает на периодичность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "偶尔",
                                "target_lang_sense_clarification": "最常用的表达，指频率不高"
                            },
                            {
                                "target_lang_word": "有时",
                                "target_lang_sense_clarification": "指在某些时候发生"
                            },
                            {
                                "target_lang_word": "间或",
                                "target_lang_sense_clarification": "书面语，强调间隔发生"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e817f47f-d546-3bd2-b96d-9911dc42f4c2",
                    "sense_definition": "By chance or accident; on a specific occasion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I met him <w>occasionally</w> in the town square, having not planned the encounter.",
                            "target_lang_translations": {
                                "ru": "Я встретил его <w>случайно</w> на городской площади, не планируя этой встречи.",
                                "zh": "我在广场上<w>偶然</w>遇见了他，那次见面并非计划好的。"
                            }
                        },
                        {
                            "text": "They arrived <w>occasionally</w> at the same inn during their separate journeys.",
                            "target_lang_translations": {
                                "ru": "Они <w>случайно</w> прибыли на один и тот же постоялый двор во время своих раздельных путешествий.",
                                "zh": "在各自的旅途中，他们<w>偶然</w>住进了同一家旅店。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Случайно или непреднамеренно; в силу сложившихся обстоятельств.",
                        "zh": "指偶然或碰巧发生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случайно",
                                "target_lang_sense_clarification": "непреднамеренно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "偶然",
                                "target_lang_sense_clarification": "指非预期的、碰巧发生的"
                            },
                            {
                                "target_lang_word": "碰巧",
                                "target_lang_sense_clarification": "强调巧合"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3076add-7819-38a4-a430-badf5deafa1c",
                    "sense_definition": "Incidentally or by the way; arising from a specific event.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He mentioned <w>occasionally</w> that he had known the author personally.",
                            "target_lang_translations": {
                                "ru": "Он упомянул <w>между прочим</w>, что знал автора лично.",
                                "zh": "他<w>顺便</w>提到过他认识那位作者。"
                            }
                        },
                        {
                            "text": "The topic was raised <w>occasionally</w> during the long debate.",
                            "target_lang_translations": {
                                "ru": "Эта тема поднималась <w>попутно</w> в ходе долгих дебатов.",
                                "zh": "在漫长的辩论中，这个话题被<w>附带</w>提及了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Между прочим, к слову; в связи с конкретным событием.",
                        "zh": "指顺便提及或在特定事件中随带发生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "между прочим",
                                "target_lang_sense_clarification": "попутно, к слову"
                            },
                            {
                                "target_lang_word": "попутно",
                                "target_lang_sense_clarification": "заодно с чем-то другим"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "顺便",
                                "target_lang_sense_clarification": "指做某事时顺便做另一件事"
                            },
                            {
                                "target_lang_word": "附带",
                                "target_lang_sense_clarification": "指随主要事项一起发生"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}