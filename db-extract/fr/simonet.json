                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29baa50a-5939-4de0-935b-158a2d8d47fa",
                                "sense_id": "a47693cf-9024-3a53-9515-2415a30f38f9",
                                "text": "Après les démissions de Jacques Baudhuin (adjoint), Serge Brisset (adjoint), Christophe Couraud et dernièrement Sophie Simonet, la commune se dirige tout droit vers des élections municipales partielles."
                            },
                            {
                                "example_id": "ca32acd3-bad4-4301-8aef-2f4935780382",
                                "sense_id": "a47693cf-9024-3a53-9515-2415a30f38f9",
                                "text": "Munies d’un téléphone fourni par la direction, les aides-soignantes Chloé Simonet et Élodie Mandler passent la chanson par petits bouts."
                            },
                            {
                                "example_id": "b58c15de-deca-45c1-a16d-2408363ab3c9",
                                "sense_id": "a47693cf-9024-3a53-9515-2415a30f38f9",
                                "text": "Le présentateur rencontre Maxime Chattam, qui publie Lux, Christophe Galfard, qui évoque Voyage vers l’infini, mais aussi Hélène Dorion, Marion Montaigne, Mathieu Simonet et Thomas Pesquet."
                            }
                        ]
                    }
