            {
                "entry_id": "5800086d-330f-3cf5-a2da-06f414d3caa4",
                "word": "gloxinia",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dfca15f8-591c-490b-a774-60320c16ec70",
