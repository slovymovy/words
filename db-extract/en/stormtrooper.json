    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f783475a-9591-33b1-93a5-1a88c638e67f",
                "word": "stormtrooper",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4b6ad4e6-a0e3-45c1-886f-b1d61b83cef7",
                        "entry_id": "f783475a-9591-33b1-93a5-1a88c638e67f",
