                "senses": [
                    {
                        "sense_id": "ea845bfe-13ca-3f1e-8127-30b6765d335b",
                        "entry_id": "6f6f77ea-4b77-33a1-92e3-4a53b5d5d89b",
                        "glosses": [
                            "устар. тот, кто умеет играть на каком-либо музыкальном инструменте"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3d9975e-396b-4ff5-b9f2-6e25dd06e8ff",
                                "sense_id": "ea845bfe-13ca-3f1e-8127-30b6765d335b",
                                "text": "― Сидел я, дитятки, у купца в лавке, купец и кричит: «Сыграй, игрец!»"
                            },
                            {
                                "example_id": "1a1ed9a4-0c79-4302-8280-94f52c69e483",
                                "sense_id": "ea845bfe-13ca-3f1e-8127-30b6765d335b",
                                "text": "А игрец был лихой: захочет откачать вприсядку, откачает!"
                            }
                        ]
                    }
                ],
