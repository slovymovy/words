{
    "word_family": [
        "frémissement",
        "frémissant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "152b13d5-8b06-3c2c-a107-cb183205d506",
                    "sense_definition": "Être agité d'un léger tremblement sous l'effet du froid, de la peur ou d'une vive émotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tremblement_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant s'est mis à <w>frémir</w> de peur en entendant ce bruit étrange."
                        },
                        {
                            "text": "Elle sentit tout son corps <w>frémir</w> sous la morsure du vent glacial."
                        }
                    ],
                    "synonyms": [
                        "frissonner",
                        "trembler"
                    ],
                    "common_phrases": [
                        "frémir de peur",
                        "frémir d'effroi"
                    ]
                },
                {
                    "sense_id": "d50ca007-3d98-3df9-a9a7-4bdb6d7f25e3",
                    "sense_definition": "En parlant d'un liquide, commencer à bouillir doucement en formant de petites bulles à la surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cuisine_liquide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut laisser <w>frémir</w> la sauce à feu doux pendant dix minutes."
                        },
                        {
                            "text": "Dès que vous voyez l'eau <w>frémir</w>, plongez délicatement les légumes dans la casserole."
                        }
                    ],
                    "common_phrases": [
                        "laisser frémir"
                    ]
                },
                {
                    "sense_id": "49ed8d63-4a2e-37c4-af28-f983bafcd9b5",
                    "sense_definition": "Produire un léger bruissement ou une faible vibration sous l'action du vent ou d'un mouvement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vibration_bruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les feuilles des peupliers commencent à <w>frémir</w> sous la brise du soir."
                        },
                        {
                            "text": "Dans le silence de la nuit, la surface du lac semblait <w>frémir</w> doucement."
                        }
                    ],
                    "synonyms": [
                        "bruire",
                        "vibrer"
                    ],
                    "common_phrases": [
                        "frémir au vent"
                    ]
                },
                {
                    "sense_id": "0643af00-3c99-3649-b3ba-b3508e7e4441",
                    "sense_definition": "Éprouver une vive réaction intérieure d'indignation, d'horreur ou de révolte.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le public tout entier a <w>frémi</w> d'indignation en apprenant cette terrible nouvelle."
                        },
                        {
                            "text": "Ce récit tragique est capable de faire <w>frémir</w> les lecteurs les plus insensibles."
                        }
                    ],
                    "synonyms": [
                        "s'indigner"
                    ],
                    "common_phrases": [
                        "frémir d'indignation",
                        "faire frémir"
                    ]
                }
            ]
        }
    ]
}