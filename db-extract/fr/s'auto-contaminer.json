                        "glosses": [
                            "Se contaminer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19c6e738-4afb-4863-bed9-6111ec30b3b3",
                                "sense_id": "4bddf0c4-47e4-34d5-9812-abe304b55c2a",
                                "text": "Enfin, il y a également un risque de s’auto-contaminer quand on touche une autre partie de son corps avec les mains."
                            },
                            {
                                "example_id": "9b091f9f-c136-40d8-9098-ba1bba883d3f",
                                "sense_id": "4bddf0c4-47e4-34d5-9812-abe304b55c2a",
                                "text": "Les abrasifs recyclables peuvent s’auto-contaminer si les surfaces à nettoyer contiennent des chlorures; ces derniers contaminent les abrasifs qui à leur tour contaminent les surfaces."
                            }
                        ]
                    }
