                ],
                "senses": [
                    {
                        "sense_id": "baf3506b-e390-3238-9b57-c28cf43e6316",
                        "entry_id": "21c008d8-ffe1-37de-b9e2-83439b0ff651",
                        "glosses": [
                            "een ruimte in een school voor het geven van les aan scholieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f49e6bb6-b5c9-4dd1-93aa-693b3d1a3395",
                                "sense_id": "baf3506b-e390-3238-9b57-c28cf43e6316",
                                "text": "Na schooltijd werd het klaslokaal gebruikt voor het geven van bijlessen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59122618-ebd9-48e2-87ec-27db38f98e54",
                        "source_entry_id": "21c008d8-ffe1-37de-b9e2-83439b0ff651",
                        "source_sense_id": "baf3506b-e390-3238-9b57-c28cf43e6316",
                        "source_sense_description": "een ruimte in een school voor het geven van les aan scholieren",
                        "target_lang_word": "Klassenraum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klassenraum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3397ddca-c2f6-3284-9c68-4b08361aded2",
                                        "entry_id": "8a97824c-0ae4-3e8a-b32c-240a3b000572",
                                        "glosses": [
                                            "Raum, in dem eine Schulklasse unterrichtet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fa76b7b-e0c5-470a-beee-558ec79055da",
                                                "sense_id": "3397ddca-c2f6-3284-9c68-4b08361aded2",
                                                "text": "Der Klassenraum müsste mal renoviert werden."
                                            },
                                            {
                                                "example_id": "06a298c6-507e-455d-b7dc-fb44ba7ccf29",
                                                "sense_id": "3397ddca-c2f6-3284-9c68-4b08361aded2",
                                                "text": "„Viele Klassenräume in Kamerun sind mit Schulbänken ausgestattet, die am Boden fixiert sind.“"
                                            },
                                            {
                                                "example_id": "bd72b528-87a4-4bb8-bb59-9ae9bf3466a9",
                                                "sense_id": "3397ddca-c2f6-3284-9c68-4b08361aded2",
                                                "text": "„Als die Söhne, an die Mutter geschmiedet, den Klassenraum betraten, verstummten die anderen ABC-Schützen wie auf Kommando.“"
                                            },
                                            {
                                                "example_id": "d4a3f946-37a2-464e-b775-7dbb49c45d11",
                                                "sense_id": "3397ddca-c2f6-3284-9c68-4b08361aded2",
                                                "text": "„An Sommerabenden hängt die Sonne rot in den blanken Scheiben der Klassenräume.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fe2ac1d-6f22-496e-b42f-ebc458f26361",
                        "source_entry_id": "21c008d8-ffe1-37de-b9e2-83439b0ff651",
                        "source_sense_id": "baf3506b-e390-3238-9b57-c28cf43e6316",
                        "source_sense_description": "een ruimte in een school voor het geven van les aan scholieren",
                        "target_lang_word": "Klassenzimmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klassenzimmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4805e3a3-8664-3b11-b007-dfdbbb10d255",
                                        "entry_id": "1f1365f1-e879-377a-aa4a-d73d90151705",
                                        "glosses": [
                                            "Raum, in dem eine Schulklasse unterrichtet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea63232a-2b08-458c-ace5-3112a450b5c3",
                                                "sense_id": "4805e3a3-8664-3b11-b007-dfdbbb10d255",
                                                "text": "Die Klassenzimmer müssten mal renoviert werden."
                                            },
                                            {
                                                "example_id": "363b4fa9-8211-486a-9faa-088133673a38",
                                                "sense_id": "4805e3a3-8664-3b11-b007-dfdbbb10d255",
                                                "text": "»Wir mögen dich so, wie du bist« lautet das Motto der Schule, das jedes Klassenzimmer ziert."
                                            },
                                            {
                                                "example_id": "63e2f088-61bd-407d-a183-6b9b24040131",
                                                "sense_id": "4805e3a3-8664-3b11-b007-dfdbbb10d255",
                                                "text": "„Er trat während der ersten Strophe neben das Bild des amtierenden Staatspräsidenten, das in jedem Klassenzimmer neben dem Kruzifix hängen musste, und salutierte bei der letzten Strophe.“"
                                            },
                                            {
                                                "example_id": "5eb2d7c8-12e3-4ea6-a61a-2462933018b4",
                                                "sense_id": "4805e3a3-8664-3b11-b007-dfdbbb10d255",
                                                "text": "„Auf den Fluren und in den Klassenzimmern standen Grüppchen von Mädchen und besprachen das Geschehene.“"
                                            },
                                            {
                                                "example_id": "4f973757-22ad-4aac-ae3f-0c7381873dde",
                                                "sense_id": "4805e3a3-8664-3b11-b007-dfdbbb10d255",
                                                "text": "„Als wir das Klassenzimmer betreten, in dem sonst Deutschkurse für Erwachsene abgehalten werden, springen die beiden geradezu erfreut auf.“"
                                            },
                                            {
                                                "example_id": "46fc7e05-8559-475a-9976-b60a0c6f47c2",
                                                "sense_id": "4805e3a3-8664-3b11-b007-dfdbbb10d255",
                                                "text": "„Aufstehen, hieß es, wenn Lehrer Mohren das Klassenzimmrer betrat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22a80f9e-32f2-44a8-95cb-842c3db32142",
                        "source_entry_id": "21c008d8-ffe1-37de-b9e2-83439b0ff651",
                        "source_sense_id": "baf3506b-e390-3238-9b57-c28cf43e6316",
