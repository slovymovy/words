                ],
                "senses": [
                    {
                        "sense_id": "6e635219-a1c0-35d5-bd1f-8360dfd3ed95",
                        "entry_id": "16fb1a54-7a26-3052-a40d-d355fae9ab96",
                        "glosses": [
                            "een spel dat een publiek van toeschouwers beoogt te boeien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bf4a768-8178-47a8-a6da-b13335537c76",
                                "sense_id": "6e635219-a1c0-35d5-bd1f-8360dfd3ed95",
                                "text": "Het schouwspel werd door een veelkoppig publiek ademloos gadegeslagen."
                            },
                            {
                                "example_id": "01ac8947-f916-437d-819e-3a8d07442241",
                                "sense_id": "6e635219-a1c0-35d5-bd1f-8360dfd3ed95",
                                "text": "Ze lijkt geen passies te hebben, behalve een voorliefde voor snuisterijen en een hele kennel vol honden, maar ook geen slechte eigenschappen, en wanneer ze koninklijke plechtigheden bijwoont, dwaalt haar blik af naar onzichtbare schouwspelen die alleen zij kan zien. Haar ongrijpbare karakter is als een blanco vel papier waarop je elk verhaal zou kunnen schrijven, en ieder meisje dat ervan droomt om prinses te worden, kan zich zonder problemen voorstellen dat ze in de beroemde kleine muiltjes van prinses Elfilda staat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6850db4-3b00-4115-adc2-4396d7dd6809",
                        "source_entry_id": "16fb1a54-7a26-3052-a40d-d355fae9ab96",
                        "source_sense_id": "6e635219-a1c0-35d5-bd1f-8360dfd3ed95",
                        "source_sense_description": "een spel dat een publiek van toeschouwers beoogt te boeien",
                        "target_lang_word": "Schauspiel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schauspiel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "794fe998-8f52-336b-b386-a9ddbbbd6606",
                                        "entry_id": "7b02666c-3f4a-306b-a9aa-86f5a3dde764",
                                        "glosses": [
                                            "Drama, ernstes Bühnenstück, Bühnenwerk, Theaterstück"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eadec3f3-da83-4a52-a4a9-6ffeb4dc6519",
                                                "sense_id": "794fe998-8f52-336b-b386-a9ddbbbd6606",
                                                "text": "Viele Schauspiele von Schiller werden auch heute noch aufgeführt."
                                            },
                                            {
                                                "example_id": "86a8a597-a366-43a2-85eb-12e23a24eaad",
                                                "sense_id": "794fe998-8f52-336b-b386-a9ddbbbd6606",
                                                "text": "„Die Poesie als Dienerin der Beredsamkeit: dies war auch der didaktische Grundsatz von Christian Weise, der als Rektor des Gymnasiums zu Zittau und als Verfasser von Schauspielen, Romanen und zahlreichen Lehrbüchern gleichzeitig mit Thomasius und vielleicht wirkungsvoller noch als dieser der deutschen Stilbildung im 18. Jahrhundert den Weg gewiesen hat.“"
                                            },
                                            {
                                                "example_id": "bb1ea550-2e2a-44a9-a31e-a0c3f10ed69b",
                                                "sense_id": "794fe998-8f52-336b-b386-a9ddbbbd6606",
                                                "text": "„Am 20. Januar 1772 wurde de Sades erstes Schauspiel hier aufgeführt, und wenn es auch noch geraume Zeit dauern sollte, bevor die Comédie-Française ein Stück von ihm herausbrachte, hielt er sich seit 1772 für einen großen Bühnenautor und hat sich auch die erdenklichste Mühe gegeben, als solcher Anerkennung bei seinen Zeitgenossen zu finden.“"
                                            },
                                            {
                                                "example_id": "2c273faa-412e-4baf-bd68-8add3d03d6d5",
                                                "sense_id": "794fe998-8f52-336b-b386-a9ddbbbd6606",
                                                "text": "„Das Schauspiel zeichnet das Leben des Sir Thomas Morus nach, des allseits beliebten Kanzlers König Heinrichs VIII., der ihn schließlich hinrichten ließ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6691b290-0581-3caa-911f-7543ace8b4e6",
                                        "entry_id": "7b02666c-3f4a-306b-a9aa-86f5a3dde764",
                                        "glosses": [
                                            "beeindruckendes Ereignis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3a73134-e284-4da2-a8d1-376e5a14087b",
                                                "sense_id": "6691b290-0581-3caa-911f-7543ace8b4e6",
                                                "text": "Die Sonnenfinsternis war für alle ein unvergessliches Schauspiel."
                                            },
                                            {
                                                "example_id": "0e395e8d-8991-40d2-bc53-a887877d6051",
                                                "sense_id": "6691b290-0581-3caa-911f-7543ace8b4e6",
                                                "text": "„Das Schauspiel, an dem außer den drei Wehrmachtsteilen auch die Waffen-SS teilnahm, sollte die Gegner beeindrucken.“"
                                            },
                                            {
                                                "example_id": "bd1adab1-d484-42c2-a05f-226caf845476",
                                                "sense_id": "6691b290-0581-3caa-911f-7543ace8b4e6",
                                                "text": "„Dies bot ein fröhliches Schauspiel, und wir bekamen reichlich Musik und jede Menge Salutschüsse.“"
                                            },
                                            {
                                                "example_id": "27f22fcf-36be-4623-835c-04ab5a547f5f",
                                                "sense_id": "6691b290-0581-3caa-911f-7543ace8b4e6",
                                                "text": "„Doch als die SS-Offiziere schließlich ihre Pistolen zogen, beeilte sich Göring zu unterschreiben. Das Dröhnen anfliegender Bomber unterbrach das Schauspiel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "40d4ffcf-6806-3f89-81a3-8737fd03224b",
                                        "entry_id": "7b02666c-3f4a-306b-a9aa-86f5a3dde764",
                                        "glosses": [
                                            "Aufführung von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bc40205-9a43-4a2e-bc9a-334947c81f91",
                                                "sense_id": "40d4ffcf-6806-3f89-81a3-8737fd03224b",
                                                "text": "Am Samstag waren wir im Theater. Das Schauspiel war langweilig, aber der Pausensekt köstlich."
                                            },
                                            {
                                                "example_id": "5f0819a6-6e8f-4b89-8b3e-acf57130c753",
                                                "sense_id": "40d4ffcf-6806-3f89-81a3-8737fd03224b",
                                                "text": "Das Felspanorama der Naturbühne bietet für Schauspiele eine faszinierende Kulisse."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "fc4c849f-11b9-3376-a98f-71be18ca6102",
                                        "entry_id": "7b02666c-3f4a-306b-a9aa-86f5a3dde764",
                                        "glosses": [
                                            "in manchen Städten Bezeichnung für das Gebäude, in dem [1] aufgeführt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c09cc172-ca40-4dbc-af31-a179491df65b",
                                                "sense_id": "fc4c849f-11b9-3376-a98f-71be18ca6102",
                                                "text": "Das Schauspiel Köln ist eine der Schauspielstätten der Stadt Köln."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b0f4128-7c42-4e12-9d2f-16ee48162144",
                        "source_entry_id": "16fb1a54-7a26-3052-a40d-d355fae9ab96",
