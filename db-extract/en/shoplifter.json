                                "example_id": "e2ab8316-aeee-4a41-9ae9-be42704e6115",
                                "sense_id": "d7b44d3c-416f-32f3-978a-6066a0176bfe",
                                "text": "Shoplifters will be handed to police.",
                                "translation": "Ladendiebe werden der Polizei übergeben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55f59430-88fd-445c-a89a-befcbafeda5a",
                        "source_entry_id": "1b940193-e4f8-3ade-b4a5-0849b122adfe",
                        "source_sense_id": "d7b44d3c-416f-32f3-978a-6066a0176bfe",
                        "source_sense_description": "Person, die in einem Geschäft stiehlt",
                        "target_lang_word": "Ladendieb",
