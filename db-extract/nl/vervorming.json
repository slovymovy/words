                                                "text": "permanent deformation"
                                            },
                                            {
                                                "example_id": "0fc57c3c-bc0b-42cc-a71e-03fae97c9284",
                                                "sense_id": "6f291fcf-2af5-31db-a61c-80c0cf4d51ef",
                                                "text": "structural deformation"
                                            },
                                            {
                                                "example_id": "1eeb9d49-3c70-433b-be6e-5e3f6369dae7",
                                                "sense_id": "6f291fcf-2af5-31db-a61c-80c0cf4d51ef",
                                                "text": "The metal showed signs of deformation under stress."
                                            },
                                            {
                                                "example_id": "2c949fa8-2ffb-41aa-a0e7-04c7dcc4ea3b",
                                                "sense_id": "6f291fcf-2af5-31db-a61c-80c0cf4d51ef",
