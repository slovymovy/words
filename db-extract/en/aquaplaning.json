                                        "entry_id": "06f4dfcc-da8f-3198-9672-4e988c2be88c",
                                        "glosses": [
                                            "het verschijnsel waarbij een dunne waterfilm ontstaat tussen de band van een rijdend voertuig en het wegdek, waardoor dit voertuig (tijdelijk) onbestuurbaar wordt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "271f2f8d-cfc3-4ef9-a07a-82cb0ae80280",
                                                "sense_id": "0e154bd9-0884-3aae-b4ed-3ce5def6b783",
                                                "text": "Als je met versleten banden rijdt, dan loop je meer risico op watergladheid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
