                ],
                "senses": [
                    {
                        "sense_id": "acd2ed6e-7670-3bdb-a12f-87cebb99842f",
                        "entry_id": "7ee23d5a-21b9-3847-82a0-5e227951a8c9",
                        "glosses": [
                            "an einer altersgemäß zu besuchenden Lehranstalt Unterrichtender"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0ecc7d2-5d19-4418-a546-704ef8b7a653",
                                "sense_id": "acd2ed6e-7670-3bdb-a12f-87cebb99842f",
                                "text": "„Wir erinnern daran, daß es gerade die Pflichtschullehrer sind, die in unserer Gesellschaft eine zentrale, sozial integrierende Funktion innehaben.“"
                            },
                            {
                                "example_id": "409156cd-68dc-4026-9249-e1156ce9ff5a",
                                "sense_id": "acd2ed6e-7670-3bdb-a12f-87cebb99842f",
                                "text": "„In Niederösterreich haben sich laut Landesschulratspräsident Hermann Helm ‚de facto alle‘ Pflichtschullehrer für das neue Dienstrecht entschieden - die Quote liege bei etwa 99 Prozent.“"
                            },
                            {
                                "example_id": "7cdb0272-b455-451a-bd31-00f366765eee",
                                "sense_id": "acd2ed6e-7670-3bdb-a12f-87cebb99842f",
                                "text": "„1944/1956 stellten die Frauen erstmals mehr als die Hälfte der Pflichtschullehrer.“"
                            },
                            {
                                "example_id": "7c41f107-dd62-43c5-b4f6-abfe7c69c1a2",
                                "sense_id": "acd2ed6e-7670-3bdb-a12f-87cebb99842f",
                                "text": "„Zur Vorbereitung der Entwicklung von Hochschulstudien für die Ausbildung der Pflichtschullehrer im Sinne des § 1 des Bundesgesetzes über die Studien an Akademien und über die Schaffung von Hochschulen für pädagogische Berufe können Versuche an Akademien durchgeführt werden.“"
                            },
                            {
                                "example_id": "9c4938c4-a188-4139-bfd4-48cf4819df65",
                                "sense_id": "acd2ed6e-7670-3bdb-a12f-87cebb99842f",
                                "text": "„Wien hat zum Start des neuen Schuljahrs erneut mit einem Mangel an Pflichtschullehrern zu kämpfen, derzeit fehlen 120 Pädagogen an den Volks-, Haupt- und Sonderschulen.“"
                            },
                            {
                                "example_id": "33b4084e-888c-46db-9640-e8780c6adea4",
                                "sense_id": "acd2ed6e-7670-3bdb-a12f-87cebb99842f",
                                "text": "„Alle Lehrer müssen in Zukunft ein vierjähriges Bachelorstudium absolvieren, das heißt für Pflichtschullehrer verlängert sich das Studium um zwei Semester.“"
                            },
                            {
                                "example_id": "9ad853a2-de4a-4f83-a4c5-bd2db4d4e676",
                                "sense_id": "acd2ed6e-7670-3bdb-a12f-87cebb99842f",
                                "text": "„Nur: Wie soll Föderalismus funktionieren, wenn Länder im konkreten Fall die Befugnis haben, Pflichtschullehrer einzustellen, die der Bund bezahlen muss?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
