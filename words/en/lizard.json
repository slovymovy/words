{
    "word_family": [
        "lizardlike",
        "lizardy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bda4e827-d065-31d1-8f0a-30431b8a5aef",
                    "sense_definition": "A cold-blooded reptile with a long body, four legs, and a tail.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A small <w>lizard</w> ran across the hot rocks in the sun.",
                            "target_lang_translations": {
                                "ru": "Маленькая <w>ящерица</w> пробежала по горячим камням на солнце.",
                                "zh": "一只小<w>蜥蜴</w>在阳光下跑过滚烫的岩石。"
                            }
                        },
                        {
                            "text": "The green <w>lizard</w> hid quickly under a large leaf.",
                            "target_lang_translations": {
                                "ru": "Зеленая <w>ящерица</w> быстро спряталась под большим листом.",
                                "zh": "那只绿色的<w>蜥蜴</w>迅速躲到了一片大叶子下面。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reptile"
                    ],
                    "common_phrases": [
                        "green lizard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Хладнокровное пресмыкающееся с длинным телом, четырьмя ногами и хвостом.",
                        "zh": "一种冷血爬行动物，身体细长，有四条腿和一条尾巴。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "я́щерица",
                                "target_lang_sense_clarification": "общее название пресмыкающегося"
                            },
                            {
                                "target_lang_word": "я́щерка",
                                "target_lang_sense_clarification": "уменьшительно-ласкательная форма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蜥蜴",
                                "target_lang_sense_clarification": "爬行动物的统称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "837ec50e-a598-3bd8-9edb-33f984d6d0b8",
                    "sense_definition": "A person who spends time idly in a specific place.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a typical lounge <w>lizard</w> who spends all night at the bar.",
                            "target_lang_translations": {
                                "ru": "Он типичный <w>тусовщик</w>, который проводит всю ночь в баре.",
                                "zh": "他是个典型的<w>混迹者</w>，整晚都泡在酒吧里。"
                            }
                        },
                        {
                            "text": "The beach <w>lizard</w> lay on the sand all day without moving.",
                            "target_lang_translations": {
                                "ru": "Этот <w>бездельник</w> весь день лежал на песке, не двигаясь.",
                                "zh": "那个<w>游手好闲者</w>在沙滩上躺了一整天，一动不动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "loafer",
                        "idler"
                    ],
                    "common_phrases": [
                        "lounge lizard",
                        "beach lizard"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in compound nouns."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который праздно проводит время в определенном месте.",
                        "zh": "指在特定场所无所事事、消磨时间的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бездельник",
                                "target_lang_sense_clarification": "человек, проводящий время в праздности"
                            },
                            {
                                "target_lang_word": "тусовщик",
                                "target_lang_sense_clarification": "о человеке, постоянно проводящем время в барах или клубах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "游手好闲者",
                                "target_lang_sense_clarification": "指无所事事的人"
                            },
                            {
                                "target_lang_word": "混迹者",
                                "target_lang_sense_clarification": "指常在特定场所消磨时间的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "323b76fc-7c98-3eef-9957-2aaa1923b026",
                    "sense_definition": "The skin of a lizard, often used as a material for clothing or accessories.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore expensive <w>lizard</w> boots to the party.",
                            "target_lang_translations": {
                                "ru": "На вечеринку она надела дорогие сапоги из <w>кожи ящерицы</w>.",
                                "zh": "她穿着昂贵的<w>蜥蜴皮</w>靴子去参加聚会。"
                            }
                        },
                        {
                            "text": "The designer bag was made from genuine <w>lizard</w> skin.",
                            "target_lang_translations": {
                                "ru": "Дизайнерская сумка была сделана из натуральной <w>кожи ящерицы</w>.",
                                "zh": "这款设计师手袋是用真正的<w>蜥蜴皮</w>制成的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lizard skin",
                        "lizard boots"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кожа ящерицы, используемая как материал для одежды или аксессуаров.",
                        "zh": "蜥蜴的皮，常用于制作服装或配饰的材料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кожа ящерицы",
                                "target_lang_sense_clarification": "материал из кожи рептилии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蜥蜴皮",
                                "target_lang_sense_clarification": "用作材料的动物皮"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71065e84-6bcd-3f7a-92bc-9b0c158e1c1e",
                    "sense_definition": "A person who is considered cowardly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be such a <w>lizard</w> and just tell the truth.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>трусом</w>, просто скажи правду.",
                                "zh": "别当<w>胆小鬼</w>了，说实话吧。"
                            }
                        },
                        {
                            "text": "He acted like a <w>lizard</w> when he refused to face his problems.",
                            "target_lang_translations": {
                                "ru": "Он повел себя как <w>трус</w>, когда отказался встретиться лицом к лицу со своими проблемами.",
                                "zh": "当他拒绝面对自己的问题时，表现得像个<w>胆小鬼</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "coward"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Derogatory term."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Трусливый человек.",
                        "zh": "指胆小怕事的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трус",
                                "target_lang_sense_clarification": "человек, склонный к трусости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胆小鬼",
                                "target_lang_sense_clarification": "形容人懦弱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6851e542-1c04-3c64-be66-5710da049266",
                    "sense_definition": "An insincere or overly smooth person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The salesman was a total <w>lizard</w> who only cared about his commission.",
                            "target_lang_translations": {
                                "ru": "Этот продавец был настоящим <w>скользким типом</w>, которого волновали только его комиссионные.",
                                "zh": "那个推销员是个彻头彻尾的<w>滑头</w>，只关心他的佣金。"
                            }
                        },
                        {
                            "text": "I do not trust that <w>lizard</w> with my business affairs.",
                            "target_lang_translations": {
                                "ru": "Я не доверяю этому <w>пройдохе</w> свои деловые вопросы.",
                                "zh": "我不信任那个<w>滑头</w>来处理我的商业事务。"
                            }
                        }
                    ],
                    "synonyms": [
                        "creep",
                        "slicker"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Derogatory term."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неискренний или скользкий человек.",
                        "zh": "指不真诚或油嘴滑舌的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скользкий тип",
                                "target_lang_sense_clarification": "о неискреннем, неприятном человеке"
                            },
                            {
                                "target_lang_word": "пройдоха",
                                "target_lang_sense_clarification": "о хитром и нечестном человеке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滑头",
                                "target_lang_sense_clarification": "指狡猾、不诚实的人"
                            },
                            {
                                "target_lang_word": "虚伪的人",
                                "target_lang_sense_clarification": "指不真诚的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6ff0652-0c71-3e4d-b62e-8df4f2b63f74",
                    "sense_definition": "A specific hand gesture used in the game rock-paper-scissors-lizard-Spock.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this version of the game, the <w>lizard</w> beats Spock.",
                            "target_lang_translations": {
                                "ru": "В этой версии игры <w>ящерица</w> побеждает Спока.",
                                "zh": "在这个版本的游戏中，<w>蜥蜴</w>能赢斯波克。"
                            }
                        },
                        {
                            "text": "Make the <w>lizard</w> shape with your hand to win the round.",
                            "target_lang_translations": {
                                "ru": "Сложи руку в форме <w>ящерицы</w>, чтобы выиграть раунд.",
                                "zh": "用手做出<w>蜥蜴</w>的形状来赢得这一局。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жест рукой в игре «Камень, ножницы, бумага, ящерица, Спок».",
                        "zh": "在“石头、剪子、布、蜥蜴、斯波克”游戏中代表蜥蜴的手势。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ящерица",
                                "target_lang_sense_clarification": "название жеста в игре"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蜥蜴",
                                "target_lang_sense_clarification": "游戏中的手势名称"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f71de202-bdf3-31c9-823b-b0e7004baf1a",
                    "sense_definition": "A peninsula located in southern Cornwall, England.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "They spent their summer vacation exploring the <w>Lizard</w> in Cornwall.",
                            "target_lang_translations": {
                                "ru": "Они провели летний отпуск, исследуя полуостров <w>Лизард</w> в Корнуолле.",
                                "zh": "他们暑假在康沃尔郡探索了<w>利泽德半岛</w>。"
                            }
                        },
                        {
                            "text": "The coastal path around the <w>Lizard</w> offers beautiful views.",
                            "target_lang_translations": {
                                "ru": "С прибрежной тропы вокруг <w>Лизарда</w> открываются прекрасные виды.",
                                "zh": "环绕<w>利泽德半岛</w>的海岸小径风景优美。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "the Lizard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полуостров в южном Корнуолле, Англия.",
                        "zh": "位于英国康沃尔郡南部的一个半岛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Лизард",
                                "target_lang_sense_clarification": "географическое название полуострова"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "利泽德半岛",
                                "target_lang_sense_clarification": "地理名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0aca372c-1be8-3a56-b499-133c9da3fa58",
                    "sense_definition": "A village in Cornwall, England, known as the most southerly village in the country.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We stopped for lunch in the village of <w>Lizard</w>.",
                            "target_lang_translations": {
                                "ru": "Мы остановились на обед в деревне <w>Лизард</w>.",
                                "zh": "我们在<w>利泽德村</w>停下来吃了午饭。"
                            }
                        },
                        {
                            "text": "The village of <w>Lizard</w> is a popular destination for tourists.",
                            "target_lang_translations": {
                                "ru": "Деревня <w>Лизард</w> — популярное место среди туристов.",
                                "zh": "<w>利泽德村</w>是一个很受欢迎的旅游目的地。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревня в Корнуолле, Англия, самая южная точка страны.",
                        "zh": "英国康沃尔郡的一个村庄，是该国最南端的村庄。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Лизард",
                                "target_lang_sense_clarification": "название деревни"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "利泽德村",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}