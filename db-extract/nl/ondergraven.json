                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a7b4c5f-27f3-43bb-b355-de66c8188e25",
                        "source_entry_id": "654cef88-63c1-3bc8-ad49-0b80009db0eb",
                        "source_sense_description": "de basis waarop iets rust eronder vandaan halen",
                        "target_lang_word": "subvert",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subvert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5222fde8-a8d4-34eb-bbfa-12d715c013f2",
                                        "entry_id": "1451ed06-75ad-36c9-8517-bd4fe92d60d5",
                                        "glosses": [
                                            "To overturn from the foundation; to overthrow; to ruin utterly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c920b55-b2f4-462b-b7c2-14a97fd8329b",
                                                "sense_id": "5222fde8-a8d4-34eb-bbfa-12d715c013f2",
                                                "text": "He […] razeth your cities, and subverts your towns."
                                            },
                                            {
                                                "example_id": "55d0bbc7-714e-4320-980b-3a3ebf02f5d4",
                                                "sense_id": "5222fde8-a8d4-34eb-bbfa-12d715c013f2",
                                                "text": ", Book IV, Chapter XVIII\nThis would be to subvert the principles and foundations of all knowledge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55cbe4f0-b3fc-31c7-b467-365b6e506e6e",
                                        "entry_id": "1451ed06-75ad-36c9-8517-bd4fe92d60d5",
                                        "glosses": [
                                            "To pervert, as the mind, and turn it from the truth; to corrupt; to confound."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "032fe824-63e5-4a33-9a3b-5b4ce364589c",
                                                "sense_id": "55cbe4f0-b3fc-31c7-b467-365b6e506e6e",
                                                "text": "The oppressive regime stays in power only as long as they manage to subvert the will of the people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28b0be20-3370-3c9e-9569-84647971380f",
                                        "entry_id": "1451ed06-75ad-36c9-8517-bd4fe92d60d5",
                                        "glosses": [
                                            "To upturn convention from the foundation by undermining it (literally, to turn from beneath)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "subvert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1267bb53-99f1-33e1-91d1-eba344ddf4da",
                                        "entry_id": "e98981ec-f207-3632-afb2-d6d627dc1962",
                                        "glosses": [
                                            "An advertisement created by subvertising."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7381176-d205-473b-85e8-d50db5ab6086",
                        "source_entry_id": "654cef88-63c1-3bc8-ad49-0b80009db0eb",
                        "source_sense_description": "de basis waarop iets rust eronder vandaan halen",
                        "target_lang_word": "undermine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "undermine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2dba05e8-57aa-3f34-8beb-64edc502f7f8",
                                        "entry_id": "154dc19f-0f59-326e-9feb-3a98045e6b9e",
                                        "glosses": [
                                            "To dig underneath (something), to make a passage for destructive or military purposes; to sap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "739d656c-1cfa-4b07-90e3-1a294f85d405",
                                                "sense_id": "2dba05e8-57aa-3f34-8beb-64edc502f7f8",
                                                "text": "Martin, for instance, had on one occasion undermined a tree sacred to old gods, then stood in the path of its fall, but forced it to fall elsewhere by making the sign of the Cross."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8249f3a-3f1e-3d80-9d66-086193b17074",
                                        "entry_id": "154dc19f-0f59-326e-9feb-3a98045e6b9e",
                                        "glosses": [
                                            "To weaken or work against; to hinder, sabotage."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "352f4bd5-f18d-4fc1-af60-b0377a4e6850",
                                                "sense_id": "a8249f3a-3f1e-3d80-9d66-086193b17074",
                                                "text": "The war efforts were undermined by the constant bickering between the allies."
                                            },
                                            {
                                                "example_id": "731408d9-4c03-4fca-a9a8-f704d2109228",
                                                "sense_id": "a8249f3a-3f1e-3d80-9d66-086193b17074",
                                                "text": "The penile mishaps (one involving a bristled toothbrush), severings (one involves hungry ducks) and surgeries cited by Ms. Roach are nothing if not memorable, but her book consistently undermines its own discoveries."
                                            },
                                            {
                                                "example_id": "c9dda375-39b9-443f-bf34-310ceba87aba",
                                                "sense_id": "a8249f3a-3f1e-3d80-9d66-086193b17074",
                                                "text": "The growing use of social media to spread anger and dissent in the Arab world has been hailed by western governments as one of the chief justifications for a completely unfettered internet. The US is reportedly funding the secret rollout of technology in Iran in an effort to undermine internet censors in the country."
                                            },
                                            {
                                                "example_id": "5d3c6f27-cdc4-4d18-b9ee-b6138e7d200a",
                                                "sense_id": "a8249f3a-3f1e-3d80-9d66-086193b17074",
                                                "text": "The 'partygate' controversy has played a major part in undermining the credibility of Boris Johnson and his Government and has led to calls from senior MPs for him to resign."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd429e30-0869-36e9-bfb4-08839593dc68",
                                        "entry_id": "154dc19f-0f59-326e-9feb-3a98045e6b9e",
                                        "glosses": [
                                            "To erode the base or foundation of something, e.g. by the action of water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be374c2e-97c7-43dd-a86e-8e530edca76a",
                                                "sense_id": "cd429e30-0869-36e9-bfb4-08839593dc68",
                                                "text": "Services between Glasgow Queen Street and Edinburgh Waverley via Falkirk High are currently suspended, following a 30-metre breach of the Union Canal that occurred on August 12 after torrential rain and thunderstorms. The thousands of gallons of water that cascaded onto the railway line below washed away track, ballast and overhead line equipment, and undermined embankments along a 300-metre section of Scotland's busiest rail link."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77422c49-ff76-3254-86a0-628b3c4c0b54",
                                        "entry_id": "154dc19f-0f59-326e-9feb-3a98045e6b9e",
                                        "glosses": [
                                            "To regard an object as the sum of the parts that compose it, in object-oriented ontology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7995e17d-b751-4a1f-8ebb-49fad26074f2",
                                                "sense_id": "77422c49-ff76-3254-86a0-628b3c4c0b54",
                                                "text": "We can even go further: when we consider an object in everyday life we do not usually just undermine or overmine it as if it demanded an either/or approach, but rather we run the two processes in tandem: duomining, as Harman labels it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
