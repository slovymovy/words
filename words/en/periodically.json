{
    "word_family": [
        "period",
        "periodic",
        "periodical"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "2ea16c3f-5a1a-3b04-8aaa-af5d543dc40d",
                    "sense_definition": "At regular intervals of time.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "regularity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should check the oil level in your car <w>periodically</w> to ensure the engine runs smoothly.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>периодически</w> проверять уровень масла в автомобиле, чтобы двигатель работал исправно."
                            }
                        },
                        {
                            "text": "The software is updated <w>periodically</w> to fix bugs and improve security.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение обновляется <w>регулярно</w>, чтобы исправлять ошибки и повышать безопасность."
                            }
                        }
                    ],
                    "antonyms": [
                        "constantly",
                        "continuously"
                    ],
                    "common_phrases": [
                        "updated periodically",
                        "checked periodically",
                        "reviewed periodically"
                    ],
                    "target_lang_definitions": {
                        "ru": "Через регулярные промежутки времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "периодически",
                                "target_lang_sense_clarification": "через равные интервалы"
                            },
                            {
                                "target_lang_word": "регулярно",
                                "target_lang_sense_clarification": "с определенной частотой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90d70c7f-a071-3458-9376-df2969b3c397",
                    "sense_definition": "From time to time; occasionally or intermittently.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "regularity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Small protests have erupted <w>periodically</w> across the city throughout the last year.",
                            "target_lang_translations": {
                                "ru": "В течение последнего года по всему городу <w>время от времени</w> вспыхивали небольшие протесты."
                            }
                        },
                        {
                            "text": "He visits his hometown <w>periodically</w> to see his old friends and family.",
                            "target_lang_translations": {
                                "ru": "Он <w>периодически</w> навещает свой родной город, чтобы увидеться со старыми друзьями и семьей."
                            }
                        }
                    ],
                    "synonyms": [
                        "sometimes",
                        "occasionally"
                    ],
                    "antonyms": [
                        "never",
                        "always"
                    ],
                    "common_phrases": [
                        "erupted periodically",
                        "occurs periodically",
                        "visits periodically"
                    ],
                    "target_lang_definitions": {
                        "ru": "Время от времени; изредка или с перерывами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "время от времени",
                                "target_lang_sense_clarification": "непостоянно"
                            },
                            {
                                "target_lang_word": "периодически",
                                "target_lang_sense_clarification": "случаясь иногда"
                            },
                            {
                                "target_lang_word": "эпизодически",
                                "target_lang_sense_clarification": "от случая к случаю"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}