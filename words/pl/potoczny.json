                },
                {
                    "sense_id": "b66d5605-0d6f-3bb2-9e06-9300b0b4f713",
                    "sense_definition": "zwykły, codzienny, pospolity, powszechny, popularny",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ogólny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To nie jest tylko <w>potoczny</w> pogląd, ale opinia poparta wieloma badaniami naukowymi.",
                            "target_lang_translations": {
                                "ru": "Это не просто <w>обывательский</w> взгляд, а мнение, подкрепленное многочисленными научными исследованиями."
                            }
                        },
                        {
                            "text": "W <w>potocznym</w> rozumieniu sukces oznacza posiadanie dużej ilości pieniędzy i sławy.",
                            "target_lang_translations": {
                                "ru": "В <w>общепринятом</w> понимании успех означает наличие большого количества денег и славы."
                            }
                        }
                    ],
                    "synonyms": [
