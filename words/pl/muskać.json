            "senses": [
                {
                    "sense_id": "03760d8b-e509-385b-b680-4991868ebca7",
                    "sense_definition": "dotykać czegoś lub kogoś w sposób bardzo delikatny, lekki i przelotny",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dotyk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ciepły letni wiatr delikatnie <w>muskał</w> jej twarz podczas wieczornego spaceru po plaży.",
                            "target_lang_translations": {
                                "ru": "Тёплый летний ветерок нежно <w>ласкал</w> её лицо во время вечерней прогулки по пляжу."
                            }
                        },
                        {
                            "text": "Dziewczyna zamyśliła się i zaledwie końcami palców <w>muskała</w> chłodną powierzchnię szyby.",
                            "target_lang_translations": {
                                "ru": "Девушка задумалась и лишь кончиками пальцев <w>едва касалась</w> холодной поверхности стекла."
                            }
                        }
                    ],
                    "synonyms": [
                        "głaskać"
                    ],
                    "common_phrases": [
                        "muskać wargami",
                        "muskać palcami"
                    ],
                    "target_lang_definitions": {
                        "ru": "прикасаться к кому-либо или чему-либо очень легко, нежно и мимолётно"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "касаться",
                                "target_lang_sense_clarification": "едва задевать, слегка дотрагиваться"
                            },
                            {
                                "target_lang_word": "ласкать",
                                "target_lang_sense_clarification": "о ветре, лучах, нежном прикосновении"
                            },
                            {
                                "target_lang_word": "овевать",
                                "target_lang_sense_clarification": "о легком ветерке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cd454da-5403-3503-a254-6394fe32d5fb",
                    "sense_definition": "pokrywać wapnem ściany budynku; <w>bielić</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bielenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gospodarz co roku starannie <w>muskał</w> wapnem drewniane ściany starej stodoły.",
                            "target_lang_translations": {
                                "ru": "Хозяин каждый год тщательно <w>белил</w> известью деревянные стены старого амбара."
                            }
                        },
                        {
                            "text": "Przed nadejściem świąt kobiety we wsi tradycyjnie <w>muskały</w> piece i ściany chat.",
                            "target_lang_translations": {
                                "ru": "Перед наступлением праздников женщины в деревне по традиции <w>белили</w> печи и стены изб."
                            }
                        }
                    ],
                    "synonyms": [
