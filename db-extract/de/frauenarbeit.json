                "senses": [
                    {
                        "sense_id": "97694cae-236c-309b-9581-c0d62350d6ce",
                        "entry_id": "21ef7894-9bc9-304d-bf2c-c76a4072c8f6",
                        "glosses": [
                            "Erwerbstätigkeit von Frauen"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "04069635-7729-4eba-89c8-2aa8f5508513",
                                "sense_id": "97694cae-236c-309b-9581-c0d62350d6ce",
                                "text": "Die Wirtschaft wird in Zukunft immer weniger auf Frauenarbeit verzichten können."
                            },
                            {
                                "example_id": "a6489202-8fdb-43c4-b141-d34a135340df",
                                "sense_id": "97694cae-236c-309b-9581-c0d62350d6ce",
                                "text": "Die Studie befasst sich mit der Frauenarbeit in Entwicklungsländern."
                            },
                            {
                                "example_id": "8ef4b105-6c65-4923-b52a-217e26824426",
                                "sense_id": "97694cae-236c-309b-9581-c0d62350d6ce",
                                "text": "„Doch auch wenn die Frauenarbeit im öffentlichen Raum sichtbar zunahm, so war doch der absolute Zuwachs eher gering.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8bbdabc8-c1a2-3c0b-8ac1-bad3c38d5ef0",
                        "entry_id": "21ef7894-9bc9-304d-bf2c-c76a4072c8f6",
                        "glosses": [
                            "Tätigkeit, Verrichtung, für die Frauen prädestiniert sein sollen, weil diese Tätigkeit/Verrichtung als besonders geeignet für Frauen angesehen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d71e02d-c9d0-4fa7-8f9c-59ab7305cbde",
                                "sense_id": "8bbdabc8-c1a2-3c0b-8ac1-bad3c38d5ef0",
                                "text": "Kurt hält sämtliche Tätigkeiten im Haushalt für Frauenarbeiten und beteiligt sich daran nicht."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "b72324e7-82ba-3b29-a9d1-29420b7a80d6",
                        "entry_id": "21ef7894-9bc9-304d-bf2c-c76a4072c8f6",
                        "glosses": [
                            "Gesamtheit der Tätigkeiten, die von verschiedenen Organisationen wahrgenommen werden, um sich für die Belange der Frauen einzusetzen"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "54c05e37-f9ec-43d8-b9dd-b95a38f12c60",
                                "sense_id": "b72324e7-82ba-3b29-a9d1-29420b7a80d6",
                                "text": "Unser Verein widmet sich der Frauenarbeit und betreibt ein Frauenhaus."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
