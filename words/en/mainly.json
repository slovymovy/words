                    "sense_definition": "Chiefly; for the most part.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The group consists <w>mainly</w> of university students.",
