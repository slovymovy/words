{
    "word_family": [
        "extricate",
        "extrication"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f0f9c257-6ee2-3441-afce-03097474290a",
                    "sense_definition": "Impossible to untie or disentangle.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "entanglement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>inextricable</w> knot was impossible to loosen.",
                            "target_lang_translations": {
                                "pl": "Ten <w>nierozsupływalny</w> węzeł był niemożliwy do poluzowania."
                            }
                        },
                        {
                            "text": "The wires behind the desk had formed an <w>inextricable</w> tangle.",
                            "target_lang_translations": {
                                "pl": "Kable za biurkiem utworzyły <w>nierozplątywalną</w> plątaninę."
                            }
                        }
                    ],
                    "synonyms": [
                        "inseparable",
                        "entangled"
                    ],
                    "antonyms": [
                        "extricable"
                    ],
                    "common_phrases": [
                        "inextricable link",
                        "inextricable bond"
                    ],
                    "target_lang_definitions": {
                        "pl": "Niemożliwy do rozplątania, rozsupłania lub rozdzielenia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "nierozplątywalny",
                                "target_lang_sense_clarification": "taki, którego nie da się rozplątać fizycznie"
                            },
                            {
                                "target_lang_word": "nierozsupływalny",
                                "target_lang_sense_clarification": "niemożliwy do rozwiązania, np. o węźle"
                            },
                            {
                                "target_lang_word": "nierozerwalny",
                                "target_lang_sense_clarification": "niemożliwy do rozdzielenia, ściśle ze sobą powiązany"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f15be68-e671-3eee-abe4-767c04d7d725",
                    "sense_definition": "Impossible from which to escape.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "entanglement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They found themselves in an <w>inextricable</w> situation during the storm.",
                            "target_lang_translations": {
                                "pl": "Podczas burzy znaleźli się w sytuacji <w>bez wyjścia</w>."
                            }
                        },
                        {
                            "text": "The hero faced an <w>inextricable</w> trap set by the villain.",
                            "target_lang_translations": {
                                "pl": "Bohater stanął w obliczu pułapki <w>bez wyjścia</w>, zastawionej przez złoczyńcę."
                            }
                        }
                    ],
                    "synonyms": [
                        "inescapable",
                        "unavoidable"
                    ],
                    "common_phrases": [
                        "inextricable situation",
                        "inextricable trap"
                    ],
                    "target_lang_definitions": {
                        "pl": "Taki, z którego nie ma ucieczki lub wyjścia; bez wyjścia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "bez wyjścia",
                                "target_lang_sense_clarification": "o sytuacji lub pułapce, z której nie można się wydostać"
                            },
                            {
                                "target_lang_word": "nieunikniony",
                                "target_lang_sense_clarification": "taki, przed którym nie można uciec"
                            },
                            {
                                "target_lang_word": "rozpaczliwy",
                                "target_lang_sense_clarification": "trudny do przezwyciężenia, beznadziejny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0162e47a-d4a8-3356-b896-6eaf16e129a5",
                    "sense_definition": "Impossible to solve.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "complexity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective faced an <w>inextricable</w> mystery that baffled everyone.",
                            "target_lang_translations": {
                                "pl": "Detektyw stanął w obliczu <w>nierozwikłanej</w> tajemnicy, która wprawiała wszystkich w osłupienie."
                            }
                        },
                        {
                            "text": "The math problem seemed <w>inextricable</w> to the students.",
                            "target_lang_translations": {
                                "pl": "To zadanie matematyczne wydawało się uczniom <w>nierozwiązywalne</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "insoluble",
                        "unsolvable"
                    ],
                    "common_phrases": [
                        "inextricable mystery",
                        "inextricable problem"
                    ],
                    "target_lang_definitions": {
                        "pl": "Niemożliwy do rozwiązania lub rozwikłania; niezwykle zawiły."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "nierozwiązywalny",
                                "target_lang_sense_clarification": "taki, którego nie da się rozwiązać"
                            },
                            {
                                "target_lang_word": "nierozwikłany",
                                "target_lang_sense_clarification": "o zagadce lub tajemnicy niemożliwej do wyjaśnienia"
                            },
                            {
                                "target_lang_word": "zawiły",
                                "target_lang_sense_clarification": "bardzo skomplikowany i trudny do pojęcia"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}