                    "frequency": "High",
                    "semantic_group_id": "enseignement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Notre <w>professeur</w> d'anglais explique très clairement les nouvelles notions de grammaire."
                        },
                        {
                            "text": "Elle pose une question à son <w>professeur</w> à la fin du cours de mathématiques."
                        }
                    ],
                    "synonyms": [
                        "enseignant"
                    ],
                    "common_phrases": [
