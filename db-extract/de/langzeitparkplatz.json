                "senses": [
                    {
                        "sense_id": "979bbfc8-34f8-32eb-8371-987b40795e68",
                        "entry_id": "d9294ac1-7dee-3834-90ce-63f95a6be561",
                        "glosses": [
                            "Parkplatz, der für einen längeren Zeitraum genutzt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "074926ca-a2bc-46cc-b5bc-91ede8967a03",
                                "sense_id": "979bbfc8-34f8-32eb-8371-987b40795e68",
                                "text": "„Dieser Mechaniker, der aus dem Wagen steigt, sagt, ich soll mir keine Sorgen machen, er hat die Nummernschilder mit einem anderen Wagen auf dem Langzeitparkplatz am Flughafen vertauscht.“"
                            },
                            {
                                "example_id": "cd370f09-8da4-4f2d-8864-263716623f59",
                                "sense_id": "979bbfc8-34f8-32eb-8371-987b40795e68",
                                "text": "„Im Augenblick sucht niemand nach dem Auto, weil Hamal die Kennzeichen gegen die eines Lincoln Continental getauscht hat, der auf einem Langzeitparkplatz steht, während der Besitzer im Urlaub ist.“"
                            },
                            {
                                "example_id": "a5b655c3-f47c-4978-b93c-c3bb01668e1a",
                                "sense_id": "979bbfc8-34f8-32eb-8371-987b40795e68",
                                "text": "„Sobald er in der weißen Sanitäteruniform steckte, ging es nur noch darum, einen einzelnen Reisenden in einem verlassenen Gang des Langzeitparkplatzes in der großen Garage zu finden.“"
                            },
                            {
                                "example_id": "8b66e116-c82a-4496-8145-4e201689e543",
                                "sense_id": "979bbfc8-34f8-32eb-8371-987b40795e68",
                                "text": "„Er fuhr den kleinen Viertürer zurück bis zum Reagan Washington National Airport, wo er ihn auf einem Langzeitparkplatz abstellte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
