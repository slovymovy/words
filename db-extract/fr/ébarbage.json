                                "example_id": "69d313c9-b91b-4c11-927a-bc5d2a7712a0",
                                "sense_id": "00491094-e021-3368-abca-56a61fa738b2",
                                "text": "L’ébarbage consiste à enlever des bavures ou des surépaisseurs de matière sur les pièces moulées ou estampées."
                            }
                        ]
