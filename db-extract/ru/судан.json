                            },
                            {
                                "target_word": "Soudan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "12f3877f-12c1-36bd-8ce4-d280e95292f1",
                                        "entry_id": "27d9f254-f2e6-33a0-a5af-036c27be9fc7",
                                        "glosses": [
                                            "Nom donné à une série de colorants solubles dans les graisses : Soudan 1 (jaune) ; Soudan 2 (orange) ; Soudan 3, 4 et 5 (rouge), noir Soudan, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e053e3a3-0008-4543-8e8a-69c04efea9fe",
                                                "sense_id": "12f3877f-12c1-36bd-8ce4-d280e95292f1",
                                                "text": "En présence de tétroxyde d'osmium, les goutelettes lipidiques de la cellule peuvent se colorer en noir, la coloration au Soudan III ou au Soudan IV ( rouge écarlate ) possède une valeur histochimique plus grande."
                                            },
                                            {
                                                "example_id": "18511031-778b-4503-b6bb-355bf4a0d047",
                                                "sense_id": "12f3877f-12c1-36bd-8ce4-d280e95292f1",
                                                "text": "Le noir Soudan, comme le rouge Soudan ou encore le Red O oil, colore spécifiquement les lipides."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
