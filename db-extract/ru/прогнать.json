                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "прогна́в"
                    },
                    {
                        "form_id": "04fd5d9a-1ef4-420e-bf35-36c511a93c44",
                        "entry_id": "4a0ed34e-2e4f-34ae-935f-a5465e5f0aa2",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "прогна́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e50de987-bbac-3526-89a2-5890358f45a1",
                        "entry_id": "4a0ed34e-2e4f-34ae-935f-a5465e5f0aa2",
                        "glosses": [
                            "вынудить уйти, удалиться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e9a7d67-47d7-4e1e-bd8d-a8d526c1e0e9",
                                "sense_id": "e50de987-bbac-3526-89a2-5890358f45a1",
                                "text": "Не предвидя добра от этого спора, я выпрыгнул из кареты с целью прогнать пьяного Ивана, с которым один Попов не мог совладать."
                            }
                        ]
                    },
                    {
                        "sense_id": "a89b0ae1-e84c-3ac4-99ec-fdf18f9669a1",
                        "entry_id": "4a0ed34e-2e4f-34ae-935f-a5465e5f0aa2",
                        "glosses": [
                            "заставить покинуть некий пост, должность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08522b9c-8e42-4ea7-9d45-2a06278ca84f",
                                "sense_id": "a89b0ae1-e84c-3ac4-99ec-fdf18f9669a1",
                                "text": "Поезд следовало остановить, сменить поездную бригаду, отдать под суд начальника поезда и прогнать с работы проводников."
                            }
                        ]
                    },
                    {
                        "sense_id": "574580fd-6426-3a1e-a050-34c4aed15e98",
                        "entry_id": "4a0ed34e-2e4f-34ae-935f-a5465e5f0aa2",
                        "glosses": [
                            "перен., разг. заставить что-либо перестать действовать, прекратиться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "863dd843-70fd-46e2-96c9-4dd2c3d911aa",
                                "sense_id": "574580fd-6426-3a1e-a050-34c4aed15e98",
                                "text": "Стал было засыпать, но в беспокойстве встал и прошелся по комнате, чтобы прогнать сон."
                            },
                            {
                                "example_id": "db740ee7-fc0c-4046-8605-cccab9641fd2",
                                "sense_id": "574580fd-6426-3a1e-a050-34c4aed15e98",
                                "text": "Она не вспоминала об острове, если же в мозгу начинали покачиваться верхушки сосен, она старалась как можно скорее прогнать виде́ние."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed46e696-096c-3939-81c3-c2084714211e",
                        "entry_id": "4a0ed34e-2e4f-34ae-935f-a5465e5f0aa2",
                        "glosses": [
                            "перен. провести через все этапы некоего процесса"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "854b3646-2ee6-47cd-9fe7-b4803e76737b",
                                "sense_id": "ed46e696-096c-3939-81c3-c2084714211e",
                                "text": "Считайте эти мои слова за увертюру к репетиции и давайте все-таки начнем с первого акта и попытаемся прогнать его вместе со вторым!"
                            },
                            {
                                "example_id": "7898809e-5a20-4426-9382-67d772db92e5",
                                "sense_id": "ed46e696-096c-3939-81c3-c2084714211e",
                                "text": "Незадолго до окончания смены, когда оставалось прогнать последнюю партию деталей, к Савелию подошел мастер…"
                            }
                        ]
                    },
                    {
                        "sense_id": "581bc74c-0fb0-3fe5-83a5-801149606094",
                        "entry_id": "4a0ed34e-2e4f-34ae-935f-a5465e5f0aa2",
                        "glosses": [
                            "редк. гоня, вынудить кого-либо переместиться мимо какого-либо места или через, сквозь что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf9099ae-f232-4060-b6ab-0b5f00a9f9b5",
                                "sense_id": "581bc74c-0fb0-3fe5-83a5-801149606094",
                                "text": "― И прекрасно. Как вы полагаете, что думает теперь о нас этот человек? ― продолжал Павел Петрович, указывая на того самого мужика, который за несколько минут до дуэли прогнал мимо Базарова спутанных лошадей и, возвращаясь назад по дороге, «забочил» и снял шапку при виде «господ»."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0798949-82af-34d5-a1c5-6fea6a2bfa22",
                        "entry_id": "4a0ed34e-2e4f-34ae-935f-a5465e5f0aa2",
                        "glosses": [
                            "жарг. рассказать очевидную неправду, чушь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb832091-6397-4c28-9432-a1258381a88b",
                                "sense_id": "b0798949-82af-34d5-a1c5-6fea6a2bfa22",
                                "text": "Ну он мне прогнал про то, какого крутого подрядчика они наняли для кровельных работ, сколько материалов им пришлось докупать, и прочую пургу."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
