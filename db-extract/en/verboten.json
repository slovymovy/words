                "senses": [
                    {
                        "sense_id": "c748ec32-4c9f-3810-aed1-be938ebec743",
                        "entry_id": "cf4b0357-49d6-36a2-b41f-fc85526ce9ae",
                        "glosses": [
                            "(autokratisch) verboten, untersagt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1b07adb-f519-4ae8-b0e2-7f70872cb072",
                                "sense_id": "c748ec32-4c9f-3810-aed1-be938ebec743",
                                "text": "[…] and the untrammeled autocratic power in Belgium made new crimes daily, simply by posting an affiche beginning \"Il est défendu,\" announcing thus the latest thing verboten. There was a new one on the walls of Brussels every morning; the long and tragic and sometimes ridiculous series of them was unending. It was verboten to display the Belgian flag; verboten to take photographs; […]"
                            },
                            {
                                "example_id": "b9bf2366-7959-48a1-beb8-b3530d82de2e",
                                "sense_id": "c748ec32-4c9f-3810-aed1-be938ebec743",
                                "text": "Pythagoras was verboten in the academy of Aristotle, he is verboten today."
                            },
                            {
                                "example_id": "332ac9fb-6577-4289-9fc6-d0238ed2f232",
                                "sense_id": "c748ec32-4c9f-3810-aed1-be938ebec743",
                                "text": "Taking a walk before lunch was verboten. Doing homework on the roof of the house was permissible. Eating at cheap Indian joints was verboten. Eating at cheap Tibetan joints was permissible."
                            },
                            {
                                "example_id": "e5705407-5efe-4047-9dab-cd37d740aabb",
                                "sense_id": "c748ec32-4c9f-3810-aed1-be938ebec743",
                                "text": "Pursuing any real offensive operational capability was strictly verboten."
                            },
                            {
                                "example_id": "b05ac3cf-7e22-4ef6-a0b8-2ba00e12c31f",
                                "sense_id": "c748ec32-4c9f-3810-aed1-be938ebec743",
                                "text": "[…] even with the new gay visibility and lesbian chic, love between women is still more verboten on the screens of America (except for porn for straight men) than is love between men."
                            },
                            {
                                "example_id": "7b498821-bcb4-4e77-a27f-4b8e6d4fb295",
                                "sense_id": "c748ec32-4c9f-3810-aed1-be938ebec743",
                                "text": "And in that Freudian paternal framework I came by my interest in chainsaws. They were the most verboten item on the list of things I was not to mess with."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
