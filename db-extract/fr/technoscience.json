                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef1bd104-d1a4-3da0-9b89-94abb34bf639",
                                        "entry_id": "c3721c06-c753-390f-be6c-6a8bc477f1d0",
                                        "glosses": [
                                            "The long-standing global human activity of technology combined with the scientific method that occurred primarily in Europe during the 17th and 18th centuries."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0f48222-e8af-3494-8658-0490b1d0b1f3",
                                        "entry_id": "c3721c06-c753-390f-be6c-6a8bc477f1d0",
                                        "glosses": [
                                            "The study of the technological and social context of science."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3e16b50-f526-4a6b-bdc6-2d1a974a25a3",
                                                "sense_id": "a0f48222-e8af-3494-8658-0490b1d0b1f3",
                                                "text": "Briefly put, strategies of globalization undertaken by the state, capital and technoscience all attempt to negotiate the production of locality in a non place- based way that induces increasingly delocalizing effects."
                                            },
                                            {
                                                "example_id": "4afda751-ac31-45d2-b406-bcc937b94212",
                                                "sense_id": "a0f48222-e8af-3494-8658-0490b1d0b1f3",
                                                "text": "Technoscience, when well directed, can produce important means of improving the quality of human life, from useful domestic appliances to great transportation systems, bridges, buildings and public spaces."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
