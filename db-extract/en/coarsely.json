                                    },
                                    {
                                        "sense_id": "df662abd-1fb8-38f5-9fc3-8e3987e0af9e",
                                        "entry_id": "1ab9f3e9-2dd8-3b2d-bd9e-c45b131a9ceb",
                                        "glosses": [
                                            "hrubým, násilným způsobem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a54eff8-27e9-4407-8eb5-7bfee3ced8e6",
                                                "sense_id": "df662abd-1fb8-38f5-9fc3-8e3987e0af9e",
                                                "text": "Hrubě veselými i krutými písněmi vytvořil Bruant žánr drsné „předměstské písně“ (chanson faubourienne)."
                                            }
                                        ]
                                    },
                                    {
