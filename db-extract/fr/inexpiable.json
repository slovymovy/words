                "senses": [
                    {
                        "sense_id": "79ba71b6-309a-38c9-be62-839f6ccde825",
                        "entry_id": "d5082a3b-fff3-31df-8427-08db0690c740",
                        "glosses": [
                            "Qui ne peut être expié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "903d77d3-847b-4789-b062-4b900504a73e",
                                "sense_id": "79ba71b6-309a-38c9-be62-839f6ccde825",
                                "text": "Ces gens là, quelque pitoyables que nous nous montrions pour eux, nous garderont jusqu'au bout la même haine inexpiable."
                            },
                            {
                                "example_id": "9a22976d-6eae-41b1-9da9-4e55e362600c",
                                "sense_id": "79ba71b6-309a-38c9-be62-839f6ccde825",
                                "text": "Elle sera seule éternellement. Que lui fait ? Sa vengeance inexpiable et un souvenir d’amour lui tiennent compagnie."
                            },
                            {
                                "example_id": "e54e8dbe-2d89-4cb6-a4f3-1a8393a41198",
                                "sense_id": "79ba71b6-309a-38c9-be62-839f6ccde825",
                                "text": "Le racisme est le crime inexpiable, comme nous l'a appris l'histoire tragique du XXᵉ siècle …."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
