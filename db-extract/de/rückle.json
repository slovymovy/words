                "senses": [
                    {
                        "sense_id": "c5a9b71b-285b-3917-8dee-d7dff9911861",
                        "entry_id": "507ac9f5-7a2f-3ec1-8862-aba7c443f898",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59c504d0-3a40-4a8e-b2be-053154140b5b",
                                "sense_id": "c5a9b71b-285b-3917-8dee-d7dff9911861",
                                "text": "Frau Rückle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ce6e7c64-feaf-49f7-a361-c6aa1af6db1c",
                                "sense_id": "c5a9b71b-285b-3917-8dee-d7dff9911861",
                                "text": "Herr Rückle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b785b7f9-a10f-4ce8-b0fc-0796aaf51eb4",
                                "sense_id": "c5a9b71b-285b-3917-8dee-d7dff9911861",
                                "text": "Die Rückles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "5984ab8d-1fa2-4319-a0ff-475878bb7910",
                                "sense_id": "c5a9b71b-285b-3917-8dee-d7dff9911861",
                                "text": "Der Rückle trägt nie die Pullover, die die Rückle ihm strickt."
                            },
                            {
                                "example_id": "dc594d21-2970-4b26-9312-267570e5d4cf",
                                "sense_id": "c5a9b71b-285b-3917-8dee-d7dff9911861",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Rückle kommt, geht der Herr Rückle.“"
                            },
                            {
                                "example_id": "92d1a95c-24d5-4437-8085-2521211e11fb",
                                "sense_id": "c5a9b71b-285b-3917-8dee-d7dff9911861",
                                "text": "Rückle kommt und geht."
                            },
                            {
                                "example_id": "63b3d1d9-d340-49ad-a905-d22026ec1216",
                                "sense_id": "c5a9b71b-285b-3917-8dee-d7dff9911861",
                                "text": "Rückles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
