                "senses": [
                    {
                        "sense_id": "6378c0c0-0774-372a-a90b-0554cfd6d252",
                        "entry_id": "e6858d2e-3e0b-3a70-99c0-4848fca07198",
                        "glosses": [
                            "een enkele keer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "704e161d-d53d-43b1-ace1-cd9df16f9e72",
                                "sense_id": "6378c0c0-0774-372a-a90b-0554cfd6d252",
                                "text": "Hij heeft die vergissing slechts eenmaal gemaakt."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3b54547-f2cd-3977-a2b1-0e30902b88f2",
                        "entry_id": "e6858d2e-3e0b-3a70-99c0-4848fca07198",
                        "glosses": [
                            "nu ~ een feit dat niet veranderd kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8d9bf2f-84f0-4edf-ae8f-7ba653fe3092",
                                "sense_id": "f3b54547-f2cd-3977-a2b1-0e30902b88f2",
                                "text": "Hij heeft die vergissing nu eenmaal gemaakt."
                            },
                            {
                                "example_id": "3107b76c-de5e-4201-88f6-7d614ce95783",
                                "sense_id": "f3b54547-f2cd-3977-a2b1-0e30902b88f2",
                                "text": "Sommige vrouwen zijn nu eenmaal enorme kletskousen daar moet je maar mee zien te leven."
                            },
                            {
                                "example_id": "f31373e7-a1d1-4465-b898-d9a010e4b8d5",
                                "sense_id": "f3b54547-f2cd-3977-a2b1-0e30902b88f2",
                                "text": "Het zal u zijn opgevallen dat het hotel hier en daar sporen vertoont van achterstallig onderhoud. We hebben nu eenmaal niet zoveel gasten meer als vroeger. Ook daaraan wil meneer Wang iets doen. Hij streeft naar een volle bezetting."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d297418-f7c1-3eaf-b0ea-d9c10724d39a",
                        "entry_id": "e6858d2e-3e0b-3a70-99c0-4848fca07198",
                        "glosses": [
                            "als ... ~ geeft een verandering in omstandigheden aan bij een bepaalde gebeurtenis, eens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5447de3a-c5c0-4ef1-89ee-60c6eef70ed9",
                                "sense_id": "3d297418-f7c1-3eaf-b0ea-d9c10724d39a",
                                "text": "Als ik eenmaal een nieuwe baan heb zal ik je zeker trakteren."
                            },
                            {
                                "example_id": "cdd40dec-965a-4c9e-aaba-930b5b7119b6",
                                "sense_id": "3d297418-f7c1-3eaf-b0ea-d9c10724d39a",
                                "text": "Als er eenmaal water door de dijk begint te komen, is een doorbraak onvermijdelijk geworden."
                            },
                            {
                                "example_id": "f303618b-4f19-4679-8e95-f3723886f18c",
                                "sense_id": "3d297418-f7c1-3eaf-b0ea-d9c10724d39a",
                                "text": "Eenmaal buiten wist ik me gelukkig nog net mijn roze fiets te herinneren en daarop reed ik voorzichtig richting de Best Western."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7aa1d507-8b4f-43f3-a5ee-a33772478a04",
                        "source_entry_id": "e6858d2e-3e0b-3a70-99c0-4848fca07198",
                        "source_sense_id": "6378c0c0-0774-372a-a90b-0554cfd6d252",
