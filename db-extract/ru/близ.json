                                        ]
                                    },
                                    {
                                        "sense_id": "e28c387b-bac9-3c24-b63b-8e786ddaea95",
                                        "entry_id": "aba27808-1399-3898-9bcc-d631832d5373",
                                        "glosses": [
                                            "Close to one's interests, affection, etc.; intimate; dear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7108d181-39fe-4071-b2d1-c0617b130dff",
                                                "sense_id": "e28c387b-bac9-3c24-b63b-8e786ddaea95",
                                                "text": "A matter of near consequence to me."
                                            },
                                            {
                                                "example_id": "7954209b-9e30-4231-be7c-99968b492315",
                                                "sense_id": "e28c387b-bac9-3c24-b63b-8e786ddaea95",
                                                "text": "a near friend"
                                            },
                                            {
                                                "example_id": "503a21a6-f6fe-4e2e-b364-9d5eca595a83",
                                                "sense_id": "e28c387b-bac9-3c24-b63b-8e786ddaea95",
                                                "text": "The Besht preached that the simple man, imbued with native faith and able to pray fervently and wholeheartedly with a sense of joy in his heart, was nearer and dearer to God than the learned but joyless formalist spending his whole life in the study of Talmud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70d17f06-49c2-302f-a8a3-f7a0af321f98",
                                        "entry_id": "aba27808-1399-3898-9bcc-d631832d5373",
                                        "glosses": [
                                            "Close to anything followed or imitated; not free, loose, or rambling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54659697-d669-43c1-90e8-d155b17ae8e7",
                                                "sense_id": "70d17f06-49c2-302f-a8a3-f7a0af321f98",
                                                "text": "a version near to the original"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c56447da-4442-373a-b583-18f28e71700d",
                                        "entry_id": "aba27808-1399-3898-9bcc-d631832d5373",
                                        "glosses": [
                                            "So as barely to avoid or pass injury or loss; close; narrow."
                                        ],
                                        "tags": [],
                                        "examples": [
