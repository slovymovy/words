                "senses": [
                    {
                        "sense_id": "8a4f1e4c-7817-325a-871b-eedb6e878f8f",
                        "entry_id": "29a165fa-69eb-3600-bac6-875d41edfc78",
                        "glosses": [
                            "Donner un caractère rappelant les hipsters à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d44cfb7f-870e-4a05-843a-0318d8078c6e",
                                "sense_id": "8a4f1e4c-7817-325a-871b-eedb6e878f8f",
                                "text": "Je crois que c'est vraiment LA news \"ballec\" de cette année 2017, so far (un peu d'anglais pour hipstériser mon propos)."
                            },
                            {
                                "example_id": "d28da529-461d-4961-930c-44146bb35a98",
                                "sense_id": "8a4f1e4c-7817-325a-871b-eedb6e878f8f",
                                "text": "Puis en voyant la boite de savon, je pensais que c'était pour hipstériser la photo"
                            },
                            {
                                "example_id": "059096df-54ef-4f4a-9f5f-e9f41fb01649",
                                "sense_id": "8a4f1e4c-7817-325a-871b-eedb6e878f8f",
                                "text": "J'ai à peine eu le temps de me hipstériser à grand frais que la mode en est déjà passée, obsolète, out, ringardisée à donf !"
                            },
                            {
                                "example_id": "5ab3dd20-8018-4f40-9f51-93ce6cc7b14e",
                                "sense_id": "8a4f1e4c-7817-325a-871b-eedb6e878f8f",
                                "text": "À celles et ceux qui ont toujours trouvé le look de Clark Kent un peu trop lisse, sachez que le super-héros DC Comics vient de s'hipstériser avec l'apparition d'une belle moustache."
                            }
                        ]
                    }
