                "senses": [
                    {
                        "sense_id": "7ef2a45f-953f-36bf-9e64-80c2297c6e23",
                        "entry_id": "de680fa3-9b88-3462-9cfc-991aca792bdd",
                        "glosses": [
                            "signalisieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d0cc077-c89e-47ec-a14f-a1e646fd7660",
                                "sense_id": "7ef2a45f-953f-36bf-9e64-80c2297c6e23",
                                "text": "People seek to change their name to signalize a change in status that has taken place.",
                                "translation": "Menschen versuchen ihren Namen zu ändern, um eine Änderung in ihrem Status hervorzuheben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2aa245f3-8d75-457d-976d-6ac7a166d476",
                        "source_entry_id": "de680fa3-9b88-3462-9cfc-991aca792bdd",
                        "source_sense_id": "7ef2a45f-953f-36bf-9e64-80c2297c6e23",
                        "source_sense_description": "signalisieren",
                        "target_lang_word": "hervorheben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hervorheben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b6a77de-749a-3115-98d9-9344ded7675f",
                                        "entry_id": "46fac5c4-0c86-3b94-a1be-085e2c5434ef",
                                        "glosses": [
                                            "etwas im hohen Maße betonen"
                                        ],
                                        "tags": [
                                            "jemand hebt etwas hervor"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "544848a9-0de5-4009-abfb-9bbea20cdfc5",
                                                "sense_id": "5b6a77de-749a-3115-98d9-9344ded7675f",
                                                "text": "Er hebt gerne seine gute Bildung hervor."
                                            },
                                            {
                                                "example_id": "f40c882c-72c9-4aae-aef6-3cd765c61fc7",
                                                "sense_id": "5b6a77de-749a-3115-98d9-9344ded7675f",
                                                "text": "Bei diesem Bild möchte ich vor allem die ungewohnte Pinselführung hervorheben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e50ae8d6-497b-301f-80a0-655489340822",
                                        "entry_id": "46fac5c4-0c86-3b94-a1be-085e2c5434ef",
                                        "glosses": [
                                            "etwas deutlich herausstreichen"
                                        ],
                                        "tags": [
                                            "etwas hebt etwas hervor"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a9a1f9c-591d-42ba-9393-92630e16b296",
                                                "sense_id": "e50ae8d6-497b-301f-80a0-655489340822",
                                                "text": "Der Kurzhaarschnitt hob ihren schlanken Hals hervor."
                                            },
                                            {
                                                "example_id": "c4e69fde-01d1-4703-a42a-509ea0835c8f",
                                                "sense_id": "e50ae8d6-497b-301f-80a0-655489340822",
                                                "text": "In der Anzeige sollte der Produktname noch besser hervorgehoben sein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d63b3ef2-c751-3f51-8bfc-5c30e04b1ed7",
                                        "entry_id": "46fac5c4-0c86-3b94-a1be-085e2c5434ef",
                                        "glosses": [
                                            "sich in einer Menge durch ein qualitativ höherwertiges Merkmal unterscheiden, deutlich werden"
                                        ],
                                        "tags": [
                                            "sich hervorheben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edc17ac7-b80a-4b51-98a4-05050bb7532a",
                                                "sense_id": "d63b3ef2-c751-3f51-8bfc-5c30e04b1ed7",
                                                "text": "„Ein hoher weißer Marmorblock hob sich hervor aus der Umgebung, eingeschlossen von einem niederen Eisengitter, am Fuße überdeckt von Blumen und Kränzen.“"
                                            },
                                            {
                                                "example_id": "442971a2-40e4-4aaa-a975-95ee14456ba1",
                                                "sense_id": "d63b3ef2-c751-3f51-8bfc-5c30e04b1ed7",
                                                "text": "Sie hebt sich hervor durch ihre Kleidung, trägt KaschmirPullover."
                                            },
                                            {
                                                "example_id": "0536e004-94fb-4ecc-b1da-70664de70766",
                                                "sense_id": "d63b3ef2-c751-3f51-8bfc-5c30e04b1ed7",
                                                "text": "Er ist kreditwürdig und er hebt sich aus der Masse hervor."
                                            },
                                            {
                                                "example_id": "be540230-686c-47b0-ab4d-ca07f387cc7b",
                                                "sense_id": "d63b3ef2-c751-3f51-8bfc-5c30e04b1ed7",
                                                "text": "Soweit auch das Auge reicht, nichts hebt sich hervor in dieser lichtreichen Wüste."
                                            },
                                            {
                                                "example_id": "04ce8479-cb7c-4257-a2f0-c14f38e5033e",
                                                "sense_id": "d63b3ef2-c751-3f51-8bfc-5c30e04b1ed7",
                                                "text": "„Auf praktischem Gebiet wurde ihnen weniger Schutz gewährleistet, und ihre Unterlegenheit hob sich hervor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de14208f-4c13-4f78-84b4-15ea9b98a349",
                        "source_entry_id": "de680fa3-9b88-3462-9cfc-991aca792bdd",
                        "source_sense_id": "7ef2a45f-953f-36bf-9e64-80c2297c6e23",
                        "source_sense_description": "signalisieren",
                        "target_lang_word": "signalisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "signalisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9645cc41-332e-3f0b-99d4-e3420920881b",
                                        "entry_id": "d6e03a1a-cdcb-3664-a374-ce4e9fdf1ce3",
                                        "glosses": [
                                            "ein Signal senden, andeuten, auf etwas hinweisen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7047f035-469e-410c-be3b-9aaaac9431e4",
                                                "sense_id": "9645cc41-332e-3f0b-99d4-e3420920881b",
                                                "text": "Er signalisierte ihm durch Nicken seine Zustimmung."
                                            },
                                            {
                                                "example_id": "a11537d2-ff9f-4744-b217-0a5598ed4c8b",
                                                "sense_id": "9645cc41-332e-3f0b-99d4-e3420920881b",
                                                "text": "„Denn die geschlossene Badezimmertür signalisiert auch dem Partner, dass er während der Zeremonie nichts im Bad zu suchen hat.“"
                                            },
                                            {
                                                "example_id": "93bd6ea4-fb81-41ba-92de-e7d82823d026",
                                                "sense_id": "9645cc41-332e-3f0b-99d4-e3420920881b",
                                                "text": "„Seine scharf geschnittenen Gesichtszüge signalisieren aber auch bei dieser entspannten Talkrunde Konzentration und Selbstkontrolle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1ad8d203-c2a0-3a64-8ab1-f923cd545031",
                                        "entry_id": "d6e03a1a-cdcb-3664-a374-ce4e9fdf1ce3",
                                        "glosses": [
                                            "ausschildern"
                                        ],
                                        "tags": [
                                            "Swiss Standard German",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6669235e-406b-4058-ada3-4888016800bf",
                                                "sense_id": "1ad8d203-c2a0-3a64-8ab1-f923cd545031",
                                                "text": "Wegen des Unfalls musste ein Teilbereich der Kreuzung kurzzeitig gesperrt werden; eine Umleitung wurde signalisiert."
                                            }
                                        ],
