                                        "sense_id": "df5a6ba9-b836-3a00-804c-82b06dc6161b",
                                        "entry_id": "9fe17b45-249c-3e1f-942e-833f6c5019f7",
                                        "glosses": [
                                            "Se dit des corps qui ont les mêmes propriétés physiques dans toutes les directions."
                                        ],
