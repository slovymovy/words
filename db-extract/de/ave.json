                "translations": [
                    {
                        "translation_id": "09828eb8-9796-4fa9-80eb-816b0413c1fc",
                        "source_entry_id": "712455e9-8ffa-39ce-b3db-fbe24aa46c4c",
                        "source_sense_id": "72443dce-915e-3a86-8ea5-9cdb1192fcfe",
                        "source_sense_description": "Religion, speziell katholische Kirche: Gebet, das an Maria gerichtet ist",
                        "target_lang_word": "Ave",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ave",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "882e72c2-f157-36ce-a6f8-511eae48dae8",
                                        "entry_id": "c0611087-8650-39b5-9c3e-e7759d3eda4b",
                                        "glosses": [
                                            "Sous-région du Portugal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ccac2937-cfcd-35b6-84fd-93151aa6c664",
                                        "entry_id": "c0611087-8650-39b5-9c3e-e7759d3eda4b",
                                        "glosses": [
                                            "Variante orthographique de avé, prière catholique à la Vierge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9eec7d8-6a63-4fc7-84eb-0ed3c29d519f",
                                                "sense_id": "ccac2937-cfcd-35b6-84fd-93151aa6c664",
                                                "text": "— C’est-il vrai, sa mère, demanda-t-elle vers le soir, qu’on obtient toujours la faveur qu’on demande quand on dit mille Ave le jour avant Noël ?\n— C’est vrai, répondit la mère Chapdelaine d’un air grave. Une personne qui a quelque chose à demander et qui dit ses mille Ave comme il faut avant le minuit de Noël, c’est bien rare si elle ne reçoit pas ce qu’elle demande."
                                            },
                                            {
                                                "example_id": "7e3faca4-50aa-424b-ae20-0fe90a91075c",
                                                "sense_id": "ccac2937-cfcd-35b6-84fd-93151aa6c664",
                                                "text": "Le seul Ave que je me souvienne d’avoir récité le soir pendant quelques années le fut sur ma descente de lit, ou, les soirs froids, sous l’édredon."
                                            },
                                            {
                                                "example_id": "5418bcd5-0e77-4f09-87e2-6ad7083ecb94",
                                                "sense_id": "ccac2937-cfcd-35b6-84fd-93151aa6c664",
                                                "text": "Une photo représente le malade sur son lit d'hôpital, un chapelet à la main; debout, à ses côtés, Soeur Marie-de-la-Providence, son ancienne secrétaire, enchaîne les Ave."
                                            }
                                        ]
                                    }
                                ]
                            },
