                    {
                        "sense_id": "ffbe1a99-fec7-3912-a1ec-f9114a9ea27d",
                        "entry_id": "d63fd921-3bc9-3ddb-b391-7314558ecc8f",
                        "glosses": [
                            "An irregular-shaped splash, smear, or patch."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "4f3e8dd6-6dd2-4e58-aac7-5ce7909a03ca",
                                "sense_id": "ffbe1a99-fec7-3912-a1ec-f9114a9ea27d",
                                "text": "It was a strip of absolute desert, where the only vegetation was the occasional splodge of moss, which lay over the sand edging of the salt flats like livid green cowpats."
                            },
                            {
                                "example_id": "4a446113-6a92-4e17-9215-ee8fc0ec2979",
                                "sense_id": "ffbe1a99-fec7-3912-a1ec-f9114a9ea27d",
                                "text": "The consequence was that the stupid girl now had ended up with a bright blue ink splodge on her white “see through” blouse […]"
                            },
                            {
                                "example_id": "4979db68-c2a2-4a1e-9b63-3b3b3c1e6450",
                                "sense_id": "ffbe1a99-fec7-3912-a1ec-f9114a9ea27d",
                                "text": "The 'rainbows' we had seen in the cockpit were two bright round splodges of light called sun dogs, one either side of the sun, joined together by a golden ring of light."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d558102e-cfe3-4edf-a5a2-e09ac1427ae0",
                        "source_entry_id": "d63fd921-3bc9-3ddb-b391-7314558ecc8f",
                        "source_sense_id": "ffbe1a99-fec7-3912-a1ec-f9114a9ea27d",
