                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac62835c-ee69-4f59-88f5-c13a6d0e78ed",
                                "sense_id": "0d959002-1bb6-38c2-a81c-02e25f246f26",
                                "text": "Amis Charentais, le groupe sera, à l'invitation de la Présipauté Grolandaise, amphorisé ce vendredi au festival de l'imprévu."
                            },
                            {
                                "example_id": "fb22fe99-d0bc-47e4-ad42-90659cbaa70b",
                                "sense_id": "0d959002-1bb6-38c2-a81c-02e25f246f26",
                                "text": "Quel groupe a été 'amphorisé' à Groland, vendredi dernier lors du festival de l'Imprévu ?"
                            }
                        ]
                    }
