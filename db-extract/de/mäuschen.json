                                    {
                                        "sense_id": "5af7d52e-2f1b-39c7-9eba-af5e351356e3",
                                        "entry_id": "432d1365-a634-3ab2-9ef2-7904a8c7a30d",
                                        "glosses": [
                                            "A little mouse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ae6043f-d419-4fa1-b840-fdbb8905fab0",
                                                "sense_id": "5af7d52e-2f1b-39c7-9eba-af5e351356e3",
                                                "text": "“Frisk about, pretty little mousekin,” says grey Grimalkin, purring in the corner, and keeping watch with her green eyes."
                                            },
                                            {
                                                "example_id": "76ea1ad9-fec2-4f3e-8132-3901c2d09ba5",
                                                "sense_id": "5af7d52e-2f1b-39c7-9eba-af5e351356e3",
                                                "text": "Dufleur blinked at the stuffed oblong bit of gray cloth that had originally been a mousekin for Fairyfoot. The ears and tail were all gone. The fabric was nubby and snagged, with a couple of bits gone, showing the padding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dc0016a-787b-3f17-9462-42f372feb83b",
                                        "entry_id": "432d1365-a634-3ab2-9ef2-7904a8c7a30d",
                                        "glosses": [
                                            "A baby mouse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6763999b-1eb7-4df2-832e-35c10a3d5c70",
                        "source_entry_id": "a9047a07-deed-3c8f-a8ce-9ec1d9922b27",
                        "source_sense_id": "58b568d7-a167-3456-a0dd-66f9ea2d33a4",
