            "senses": [
                {
                    "sense_id": "a3ad6375-0cc0-30a1-9247-270e4c75c18a",
                    "sense_definition": "een zeer korte tijd of een snelle waarneming",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tijd en waarneming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De EHBO-er overzag de situatie in een <w>oogopslag</w> en begon direct met reanimeren.",
                            "target_lang_translations": {
                                "en": "The first aider assessed the situation at a <w>glance</w> and immediately began CPR.",
                                "fr": "Le secouriste a évalué la situation en un <w>clin d'œil</w> et a immédiatement commencé la réanimation."
                            }
                        },
                        {
                            "text": "Je kunt in een <w>oogopslag</w> zien dat dit product van hoge kwaliteit is.",
                            "target_lang_translations": {
                                "en": "You can see at a <w>glance</w> that this product is of high quality.",
                                "fr": "Vous pouvez voir en un <w>coup d'œil</w> que ce produit est de haute qualité."
                            }
                        }
                    ],
                    "synonyms": [
                        "handomdraai",
                        "wenk"
                    ],
                    "common_phrases": [
                        "in een oogopslag"
                    ],
                    "target_lang_definitions": {
                        "en": "a very short period of time or a quick observation",
                        "fr": "une très courte durée de temps ou une observation rapide"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "glance",
                                "target_lang_sense_clarification": "a quick look"
                            },
                            {
                                "target_lang_word": "blink of an eye",
                                "target_lang_sense_clarification": "a very short time"
                            },
                            {
                                "target_lang_word": "at a glance",
                                "target_lang_sense_clarification": "immediately upon looking"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "clin d'œil",
                                "target_lang_sense_clarification": "un temps très court"
                            },
                            {
                                "target_lang_word": "coup d'œil",
                                "target_lang_sense_clarification": "un regard rapide"
                            },
                            {
                                "target_lang_word": "en un clin d'œil",
                                "target_lang_sense_clarification": "très rapidement ou immédiatement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f67d7a1-7e06-35b9-890c-a3266da22bcc",
                    "sense_definition": "de manier waarop iemand kijkt of een snelle blik",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tijd en waarneming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn eerste <w>oogopslag</w> verraadde dat hij niet blij was met het nieuws.",
                            "target_lang_translations": {
                                "en": "His first <w>look</w> revealed that he was not happy with the news.",
                                "fr": "Son premier <w>regard</w> a trahi qu'il n'était pas content de la nouvelle."
                            }
                        },
                        {
                            "text": "Met een korte <w>oogopslag</w> naar zijn horloge liet hij weten dat we moesten gaan.",
                            "target_lang_translations": {
                                "en": "With a quick <w>glance</w> at his watch, he let us know we had to go.",
                                "fr": "D'un bref <w>coup d'œil</w> à sa montre, il nous a fait savoir que nous devions partir."
                            }
                        }
                    ],
                    "synonyms": [
                        "blik"
                    ],
                    "common_phrases": [
                        "eerste oogopslag"
                    ],
                    "target_lang_definitions": {
                        "en": "the way someone looks or a quick glance",
                        "fr": "la façon dont quelqu'un regarde ou un bref regard"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "look",
                                "target_lang_sense_clarification": "the expression in someone's eyes"
                            },
                            {
                                "target_lang_word": "glance",
                                "target_lang_sense_clarification": "a brief look"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "regard",
                                "target_lang_sense_clarification": "l'expression des yeux"
                            },
                            {
                                "target_lang_word": "coup d'œil",
                                "target_lang_sense_clarification": "un bref regard"
                            }
                        ]
                    }
                }
            ]
        }
    ]
