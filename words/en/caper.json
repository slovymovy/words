                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young lamb performed a joyful <w>caper</w> in the green meadow.",
                            "target_lang_translations": {
                                "pl": "Młode jagnię wykonało radosny <w>podskok</w> na zielonej łące."
                            }
                        },
                        {
                            "text": "With a sudden <w>caper</w>, the puppy jumped over the garden fence.",
                            "target_lang_translations": {
