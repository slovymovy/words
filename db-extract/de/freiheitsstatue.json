                    {
                        "translation_id": "8823955f-d620-4ea2-9983-935d5c53763a",
                        "source_entry_id": "2a737b14-5939-3fa6-9dc1-837cfd82ea9e",
                        "source_sense_id": "e17479b7-7442-32fa-8cd1-3b0ba5bdb02f",
                        "source_sense_description": "eine Statue im New Yorker Hafen auf Liberty Island",
                        "target_lang_word": "vrijheidsbeeld",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vrijheidsbeeld",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "bc390559-059d-3611-968d-24cafe43c78c",
                                        "entry_id": "27527c63-824a-38d6-961a-8bcd5d42fec8",
                                        "glosses": [
                                            "beeld opgericht ter ere van de vrijheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd33e40b-aaa7-47a3-9cfa-9df475eee4a5",
                                                "sense_id": "bc390559-059d-3611-968d-24cafe43c78c",
                                                "text": "In het door de historicus Hermann Kesting geschreven boek dat bij dit Teutoonse vrijheidsbeeld te koop wordt aangeboden, geldt Arminius (zoals hij door de Romeinen werd genoemd) als de bevrijder van Germania en dus van het gehele Duitse volk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0af68df-d052-317e-9f92-049449549220",
                                        "entry_id": "27527c63-824a-38d6-961a-8bcd5d42fec8",
                                        "glosses": [
                                            "replica of afbeelding van het Vrijheidsbeeld in New York"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "967b4f48-d7fd-43d5-8c3e-b25b0f6e69ea",
                                                "sense_id": "e0af68df-d052-317e-9f92-049449549220",
                                                "text": "Remmelt Otten gaat met zijn kinderen naar Legoland in Denemarken. (…) De draak in de griezelgrot is van Lego, de leeuwen in de dierentuin zijn van Lego, de Hollandse molens en het vrijheidsbeeld zijn van Lego."
                                            },
                                            {
                                                "example_id": "79d471ab-163a-4b14-bbca-8a6271b318a2",
                                                "sense_id": "e0af68df-d052-317e-9f92-049449549220",
                                                "text": "In het Utrechtse Beatrix-theater opende gisteren de Nederlandse musicalversie van Saturday night fever. (…) Het doek gaat open, het hoofd van het vrijheidsbeeld splitst in tweeën – en daar staat Tony Manero, net zoals hij op de filmaffiches voor Saturday night fever en het bijbehorende dubbelalbum stond: de rechterhand gestrekt omhoog, de linkerhand op de heup en de borstkas tot het uiterste gespannen, klaar om een frenetieke discodans te beginnen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23d3512b-8cee-3f5c-9324-55175897edb5",
                                        "entry_id": "27527c63-824a-38d6-961a-8bcd5d42fec8",
                                        "glosses": [
                                            "indruk die men zich vormt van een leven zonder dwang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "927ed73a-ed72-434b-b812-422b37fa3f61",
                                                "sense_id": "23d3512b-8cee-3f5c-9324-55175897edb5",
                                                "text": "De keuze voor dit onderdeel van de lijkrede voor de reclamecampagne bevestigt de stelling van Wallas, namelijk dat het positieve vrijheidsbeeld van de Britten zijn wortels vindt in de lijkrede van Pericles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
