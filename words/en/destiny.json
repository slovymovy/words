                {
                    "sense_id": "de0ee556-228c-3ea7-976e-2d3069415191",
                    "sense_definition": "An unincorporated community in Osceola County, Florida, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We drove through the small community of <w>Destiny</w> during our road trip in Florida.",
                            "target_lang_translations": {
                                "ru": "Мы проехали через небольшое поселение <w>Дестини</w> во время нашего автопутешествия по Флориде.",
                                "pl": "Przejeżdżaliśmy przez małą osadę <w>Destiny</w> podczas naszej wycieczki samochodowej po Florydzie."
                            }
                        },
                        {
                            "text": "The map showed that <w>Destiny</w> was only a few miles away from the main highway.",
                            "target_lang_translations": {
                                "ru": "Карта показывала, что <w>Дестини</w> находится всего в нескольких милях от главного шоссе.",
                                "pl": "Mapa pokazywała, że <w>Destiny</w> znajduje się zaledwie kilka mil od głównej autostrady."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неинкорпорированное сообщество в округе Оцеола, штат Флорида, США.",
                        "pl": "Niezorganizowana wspólnota w hrabstwie Osceola, na Florydzie, w Stanach Zjednoczonych."
                    },
