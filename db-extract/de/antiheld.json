                ],
                "senses": [
                    {
                        "sense_id": "4e05f2d3-6ba2-3f19-9bc6-40ca36055fcd",
                        "entry_id": "d3263d13-9b71-31d2-b7e4-2a8f0cfa7319",
                        "glosses": [
                            "Protagonist, der durch Fehler und negative Eigenschaften auffällt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "316f9c35-794d-4bea-ba7a-d43c9395619c",
                                "sense_id": "4e05f2d3-6ba2-3f19-9bc6-40ca36055fcd",
                                "text": "„Die Protagonisten sind in diesen Werken letztlich Antihelden und sterben einen geistigen und (bzw. oder) physischen Tod, weil sie sich von unbewußten, archaischen Inhalten fremdbestimmen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d25b84ec-cd91-4c7d-8b0d-8323e6f36a3e",
                        "source_entry_id": "d3263d13-9b71-31d2-b7e4-2a8f0cfa7319",
                        "source_sense_id": "4e05f2d3-6ba2-3f19-9bc6-40ca36055fcd",
                        "source_sense_description": "Literatur: Protagonist, der durch Fehler und negative Eigenschaften auffällt",
                        "target_lang_word": "antihero",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antihero",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f620ab99-b40a-348a-93fb-146aa9e83e0e",
                                        "entry_id": "51168d1d-b4c5-3adc-b121-8dac8e232ad8",
                                        "glosses": [
                                            "A protagonist who proceeds in an unheroic manner, such as by criminal means, via cowardly actions, or for mercenary goals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd3bfac4-cdbc-473c-9b63-25b5bc979fc1",
                                                "sense_id": "f620ab99-b40a-348a-93fb-146aa9e83e0e",
                                                "text": "Alienation: A stage on the downside of the passage wherein the holdfast and the antihero take actions which bring about a disintegration of personality."
                                            },
                                            {
                                                "example_id": "7585e597-83f7-4231-87a7-d68617780924",
                                                "sense_id": "f620ab99-b40a-348a-93fb-146aa9e83e0e",
                                                "text": "JK Rowling says that “girls are very apt to romanticise” the antihero, and reveals that she had been forced to pour “cold common sense” on the startling number of readers who fall for the arrogant, unscrupulous bully Draco Malfoy in her Harry Potter books."
                                            },
                                            {
                                                "example_id": "2913d906-505e-4970-9a09-c925ee305dfe",
                                                "sense_id": "f620ab99-b40a-348a-93fb-146aa9e83e0e",
                                                "text": "The Deadpool fly is a species of Robber fly, which are “assassins of the insect world” – fitting for the mercenary antihero."
                                            },
                                            {
                                                "example_id": "9778de2c-9baf-43c4-86b7-7e321f9b1a9f",
                                                "sense_id": "f620ab99-b40a-348a-93fb-146aa9e83e0e",
                                                "text": "Fictional male antiheroes like television’s crime patriarchs Tony Soprano and Walter White have reigned for some time, but the antiheroine has only more recently had the opportunity to rise up – and become the cause of her own downfall. […] Grayson serves as an archetype for a female antihero not driven by much except for her own ambition, and she’s quite fine with that."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8b38b21-749c-4d15-9a9c-8f4fcb212ac4",
                        "source_entry_id": "d3263d13-9b71-31d2-b7e4-2a8f0cfa7319",
                        "source_sense_id": "4e05f2d3-6ba2-3f19-9bc6-40ca36055fcd",
                        "source_sense_description": "Literatur: Protagonist, der durch Fehler und negative Eigenschaften auffällt",
                        "target_lang_word": "antihéros",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antihéros",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d7d1eca-f696-330f-a67d-870df56503e1",
                                        "entry_id": "d4f41812-cf69-3971-8315-b335d1adbb97",
                                        "glosses": [
                                            "Personnage principal d’une œuvre de fiction dénué des caractéristiques positives du héros traditionnel."
                                        ],
                                        "tags": [
                                            "Moins courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b167a941-f1d7-44da-bc7a-af70a46fcc1a",
                                                "sense_id": "0d7d1eca-f696-330f-a67d-870df56503e1",
                                                "text": "Le héros déceptif est un antihéros plus ancien et figure dans nombre de contes populaires ; c’est un héros qui, par sa propre faute ou du fait des circonstances, ne parvient pas à accomplir sa quête."
                                            },
                                            {
                                                "example_id": "cc972b74-b74b-45fd-afcf-c7b8dedd4057",
                                                "sense_id": "0d7d1eca-f696-330f-a67d-870df56503e1",
                                                "text": "Ce n’est pas parce que le roman est moderne qu’il se définit nécessairement comme un antihéros mais, rappelle G. Durand, c’est bien parce qu’il est au fond un antihéros que l’on parlera de roman moderne."
                                            },
                                            {
                                                "example_id": "bf975ab5-b71f-47e9-9a3b-229b0c346947",
                                                "sense_id": "0d7d1eca-f696-330f-a67d-870df56503e1",
                                                "text": "Antihéros par excellence, il ne choisit pas la liberté : c’est elle, la garce, qui fait de lui son jouet, jusqu’à une improbable rédemption."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20a1b328-b5df-44a2-866c-39400e74a0ef",
                        "source_entry_id": "d3263d13-9b71-31d2-b7e4-2a8f0cfa7319",
                        "source_sense_id": "4e05f2d3-6ba2-3f19-9bc6-40ca36055fcd",
                        "source_sense_description": "Literatur: Protagonist, der durch Fehler und negative Eigenschaften auffällt",
                        "target_lang_word": "anti-héros",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anti-héros",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f3719885-12fc-31d3-9594-c65617a87951",
                                        "entry_id": "98baa20a-fcc1-3d51-bd44-c7141ad7fd5d",
                                        "glosses": [
                                            "Variante orthographique de antihéros."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f8e7797-ff8c-4c5f-a968-445d794263de",
                                                "sense_id": "f3719885-12fc-31d3-9594-c65617a87951",
                                                "text": "Il n’est pas civilisateur, comme les véritables héros mythiques, mais se construit et pour ce faire, détruit : c’est un anti-héros mythique."
                                            },
                                            {
                                                "example_id": "3944ba99-834d-4afc-8592-28c121b6bb8a",
                                                "sense_id": "f3719885-12fc-31d3-9594-c65617a87951",
                                                "text": "Et nous, les anti-héros, les benoîts couchés occupés à dormir, il faut se branle-basser, sauter à pieds joints dans les pantalons, se laver les yeux, se frotter les chaussures, s’hisser dans les camions, casqués aussi, il faut voir comment, l’arme qui pendouille, sonnaille."
                                            },
                                            {
                                                "example_id": "db6f29dd-e52a-42f7-b75c-136f75423047",
                                                "sense_id": "f3719885-12fc-31d3-9594-c65617a87951",
                                                "text": "Le jeune écrivain Tréplev, anti-héros de La mouette, est jaloux de l'écrivain Trigorine, l'amant de sa mère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2fd25e3-bad1-4ad7-8952-203f36c6ee4e",
                        "source_entry_id": "d3263d13-9b71-31d2-b7e4-2a8f0cfa7319",
