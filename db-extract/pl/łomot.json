                ],
                "senses": [
                    {
                        "sense_id": "95bdbff1-926d-3b6b-ad24-fbf664c685ca",
                        "entry_id": "b99d866e-5dfa-3712-b29b-dd97d033858d",
                        "glosses": [
                            "thud, thudding (dull sound of impact or a series of such sounds)"
                        ],
                        "tags": [
                            "inanimate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "a689d594-6be6-4030-a395-9c3d498b6727",
                                "sense_id": "95bdbff1-926d-3b6b-ad24-fbf664c685ca",
                                "text": "Rozległ się łomot ciężkich kroków.",
                                "translation": "The thud of heavy steps resounded.",
                                "english": "The thud of heavy steps resounded."
                            }
                        ]
                    },
                    {
                        "sense_id": "e8a14bdd-6be8-30d6-abd0-a957b8e21cfc",
                        "entry_id": "b99d866e-5dfa-3712-b29b-dd97d033858d",
                        "glosses": [
                            "wipeout (heavy beating)"
                        ],
                        "tags": [
                            "colloquial",
                            "inanimate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "e4964dc9-026d-4258-8c91-b61876d40a8d",
                                "sense_id": "e8a14bdd-6be8-30d6-abd0-a957b8e21cfc",
                                "text": "Po wszystkim w akcję wkroczy ZOMO i rebeliantom spuści łomot.",
                                "translation": "Afterwards, ZOMO will come in and beat the rebels.",
                                "english": "Afterwards, ZOMO will come in and beat the rebels."
                            },
                            {
                                "example_id": "4955426d-f218-44b8-9a71-f770f7394616",
                                "sense_id": "e8a14bdd-6be8-30d6-abd0-a957b8e21cfc",
                                "text": "PiS 46%... to nie porażka PO, a ostateczny łomot.",
                                "translation": "46% for Law and Justice... it is not a defeat for the Civic Platform, but it is an ultimate wipeout.",
                                "english": "46% for Law and Justice... it is not a defeat for the Civic Platform, but it is an ultimate wipeout."
                            }
                        ]
                    }
                ],
