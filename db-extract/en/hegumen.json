                        "entry_id": "f0b514d8-9006-3da8-b8dc-f5a419a39f2d",
                        "glosses": [
                            "The head of a monastery of the Eastern Orthodox Church or Eastern Catholic Churches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40a91ba0-de30-4981-aa74-953b9f8905ce",
                                "sense_id": "5fc86645-f877-3f97-b371-e4c6cc76fcc9",
                                "text": "From 1517 to 1637 a total of 19 Kirillov hegumens were transferred to other influential positions, and nine of them were raised to episcopal seats."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
