                "senses": [
                    {
                        "sense_id": "3e46b15d-d1fa-3cb9-9e06-b5827208ab18",
                        "entry_id": "1d0bacf9-70bb-3b90-9986-508bf0a3df47",
                        "glosses": [
                            "A contrasting rhythm or meter that deliberately interrupts or clashes with the naturally expected metrical pattern."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "857a4212-013e-4ab4-848b-9b6b790b0b88",
                                "sense_id": "3e46b15d-d1fa-3cb9-9e06-b5827208ab18",
                                "text": "The conflict between meter and antimeter is a critical aspect of the textural rhythm, and takes on significance as a rhetorical code that lends affective immediacy to the psychological drama of the recording."
                            },
                            {
                                "example_id": "92aa5028-a8ba-48f6-b6d4-153a309a0faf",
                                "sense_id": "3e46b15d-d1fa-3cb9-9e06-b5827208ab18",
                                "text": "Blake and Dickinson looked in the same place for an anti-meter (Hollander's term) ; Blake's rough fourteeners employ a one-line adaptation of the meter Dickinson favored, the ballad or hymn stanza."
                            },
                            {
                                "example_id": "dc379e4c-67aa-4937-8d86-bfffcb57a661",
                                "sense_id": "3e46b15d-d1fa-3cb9-9e06-b5827208ab18",
                                "text": "Later, Shemtov speaks of \"antimeter”. Here she could speak of “antistanza”, with one difference. Emily Dickinson does not indicate what metre she avoids, whereas Apollinaire clearly indicates what stanza form he does not choose. But, unlike the “antimeter\", this has no relevance to a feminist agenda."
                            }
                        ]
                    }
