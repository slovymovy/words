                "senses": [
                    {
                        "sense_id": "cfd197a6-8cda-375c-9827-8bf41b719f11",
                        "entry_id": "4d6e73c1-121e-3e97-8f80-53eaf932b72d",
                        "glosses": [
                            "Lâcher (ce qu'on avait empoigné)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ed0cad0-97b2-4c89-b8c8-b2cf8b7893bf",
                                "sense_id": "cfd197a6-8cda-375c-9827-8bf41b719f11",
                                "text": "Ce hurlement ne me fit point désempoigner mes cupidons voués à la noyade, tout juste s’il me fit réagir."
                            },
                            {
                                "example_id": "3d92d75a-4e89-4dc1-8f3f-c29c7d065bce",
                                "sense_id": "cfd197a6-8cda-375c-9827-8bf41b719f11",
                                "text": "Comme j’avais oublié de désempoigner mon attaché-case, je le plaçai immédiatement sur l’objet de son éventuelle convoitise."
                            }
                        ]
                    }
