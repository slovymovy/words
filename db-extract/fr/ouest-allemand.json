                ],
                "senses": [
                    {
                        "sense_id": "b0704210-57f1-35b1-9f83-24ed8bfcae4f",
                        "entry_id": "2edf7fce-2f33-3783-949e-97c73597299f",
                        "glosses": [
                            "Relatif à la République fédérale d’Allemagne entre 1949 et 1990 (aussi appelée l’Allemagne de l’Ouest), à sa culture ou à ses institutions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91dbf764-d5b3-488b-aa21-52953e047d98",
                                "sense_id": "b0704210-57f1-35b1-9f83-24ed8bfcae4f",
                                "text": "Lors de sa prise de fonctions à l’issue de l'élection de Konrad Adenauer par le Bundestag, le gouvernement ouest-allemand ne disposait ni des droits, ni des instruments nécessaires à l’exercice d’une politique étrangère."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58d6a510-66f5-4313-abcb-beb8aa5c49be",
                        "source_entry_id": "2edf7fce-2f33-3783-949e-97c73597299f",
                        "source_sense_id": "b0704210-57f1-35b1-9f83-24ed8bfcae4f",
                        "target_lang_word": "westdeutsch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "westdeutsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2552db14-a162-36f3-9317-fa3598c6ea51",
                                        "entry_id": "ba87f9bc-9273-31bb-bdb4-4dfdd468cd95",
                                        "glosses": [
                                            "auf den westlichen Teil Deutschlands, zumeist die alten Bundesländer bezogen (Vergleiche Westdeutschland)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eca2e571-ba3a-4642-83da-6f3344ffc364",
                                                "sense_id": "2552db14-a162-36f3-9317-fa3598c6ea51",
                                                "text": "„Die neuen Bundesländer überholten die alten 2006 beim Wachstum, inzwischen wandern westdeutsche Unternehmen gen Osten.“"
                                            },
                                            {
                                                "example_id": "a1bedc9e-6199-4e54-a543-700a91fe9d35",
                                                "sense_id": "2552db14-a162-36f3-9317-fa3598c6ea51",
                                                "text": "„Sie hob zwar immer wieder hervor, dass sie anders sozialisiert worden war als ihre westdeutschen Parteifreunde, zugleich aber trat sie in inhaltlichen Fragen gewissermaßen am westdeutschesten von allen ostdeutschen Politikern auf.“"
                                            },
                                            {
                                                "example_id": "f56d2f6c-9f28-4d65-bdd4-3f7b5204b891",
                                                "sense_id": "2552db14-a162-36f3-9317-fa3598c6ea51",
                                                "text": "„Es gibt ganz konkrete historische Gründe dafür, dass Ostdeutschland bis heute erst gute zwei Drittel der westdeutschen Wirtschaftskraft erreicht.“"
                                            },
                                            {
                                                "example_id": "70170ea9-f3f4-49db-98f2-4714aa5ff3d2",
                                                "sense_id": "2552db14-a162-36f3-9317-fa3598c6ea51",
                                                "text": "„Über fünf Jahre liegt die Barschel-Affäre zurück – das schlimmste politische Bubenstück der westdeutschen Nachkriegsgeschichte.“"
                                            },
                                            {
                                                "example_id": "dc068695-b9ec-4b4a-a1b7-1cbe992ec3b6",
                                                "sense_id": "2552db14-a162-36f3-9317-fa3598c6ea51",
                                                "text": "„Wir schreiben hier über den Motorflug, weil sich hier die Nöte des westdeutschen Luftsportes besonders kraß abzeichnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1cc9a22-cf63-4f32-9235-12e9cddf47ed",
                        "source_entry_id": "2edf7fce-2f33-3783-949e-97c73597299f",
                        "source_sense_id": "b0704210-57f1-35b1-9f83-24ed8bfcae4f",
