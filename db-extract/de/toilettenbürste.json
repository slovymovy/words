                "senses": [
                    {
                        "sense_id": "b7a9b438-6882-335a-aa3b-186e548490b5",
                        "entry_id": "0dae8e96-ade9-3efa-b2c1-f90a6a1554b6",
                        "glosses": [
                            "eine Bürste, mit der die Toilette gereinigt wird, vor allem die Innenseite"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99683719-1952-4499-9296-46fb4872f48f",
                                "sense_id": "b7a9b438-6882-335a-aa3b-186e548490b5",
                                "text": "Der Rauhaardackel meiner Nachbarin freut sich immer, wenn Besuch kommt, und bringt den Gästen dann mit Vorliebe sämtliche Toilettenbürsten, die er finden kann."
                            },
                            {
                                "example_id": "098621fb-552f-4e09-be50-64cea4f667b8",
                                "sense_id": "b7a9b438-6882-335a-aa3b-186e548490b5",
                                "text": "Mit einer Toilettenbürste kann man nur den groben Schmutz entfernen; für eine Desinfektion bedarf es eines speziellen Reinigungsmittels."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
