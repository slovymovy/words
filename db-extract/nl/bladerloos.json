                ],
                "translations": [
                    {
                        "translation_id": "c0720c6f-c38a-473c-98df-ca52c6ecc6b3",
                        "source_entry_id": "4430c7a1-7bac-351c-b307-9e84d85490f8",
                        "source_sense_id": "e1545623-6418-38b0-bc95-5ddd86e3dd7d",
                        "source_sense_description": "zonder bladeren",
                        "target_lang_word": "blätterlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blätterlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ebf0217b-7fe9-3970-8ff3-160cc9c0650c",
                                        "entry_id": "f0aac01a-4374-303b-9feb-4cf471db0441",
                                        "glosses": [
                                            "ohne Blätter, keine Blätter tragend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc709899-c40d-4584-adfa-7f805afa4b5f",
                                                "sense_id": "ebf0217b-7fe9-3970-8ff3-160cc9c0650c",
                                                "text": "„Oliven und Mandeln sind geerntet, die Trauben gären längst in Fässern, knorrige Feigenbäume zeigen sich blätterlos nackt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cc902ce-d54b-4644-89f3-d6b1b8e72565",
                        "source_entry_id": "4430c7a1-7bac-351c-b307-9e84d85490f8",
                        "source_sense_id": "e1545623-6418-38b0-bc95-5ddd86e3dd7d",
                        "source_sense_description": "zonder bladeren",
                        "target_lang_word": "leafless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leafless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b07f71e2-3709-3e25-a77d-2eb90db16360",
                                        "entry_id": "ca685784-8d58-3c77-a4d9-cd7e32ebc2ab",
                                        "glosses": [
                                            "Of plants or trees, without leaves."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce025513-080c-48b6-9708-ef71177e9f60",
                                                "sense_id": "b07f71e2-3709-3e25-a77d-2eb90db16360",
                                                "text": "In winter the leafless trees look cold."
                                            },
                                            {
                                                "example_id": "d7891e9a-5308-4dec-b900-7b1eacc7ee82",
                                                "sense_id": "b07f71e2-3709-3e25-a77d-2eb90db16360",
                                                "text": "One afternoon, when all the party from the house were riding, Adeline sauntered under the leafless, hazel hedges, which separated the pleasure domain from the park."
                                            },
                                            {
                                                "example_id": "4e187dbf-580b-4c58-8a04-f4bf1ccc608b",
                                                "sense_id": "b07f71e2-3709-3e25-a77d-2eb90db16360",
                                                "text": "Not a latent echo in the house, not a squeak and scuffle from the mice behind the panneling, not a drip from the half-thawed water-spout in the dull yard behind, not a sigh among the leafless boughs of one despondent poplar, not the idle swinging of an empty store-house door, no, not a clicking in the fire, but fell upon the heart of Scrooge with softening influence, and gave a freer passage to his tears."
                                            },
                                            {
                                                "example_id": "3481c0b6-0c21-4afe-b93a-04f89f03042e",
                                                "sense_id": "b07f71e2-3709-3e25-a77d-2eb90db16360",
                                                "text": "For many times with the laughing girls and boys / Played I along the road and over the hills / When the sun was low and the air was cool, / Stopping to club the walnut tree / Standing leafless against a flaming west."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
