                                "target_senses": [
                                    {
                                        "sense_id": "9bab3274-ef28-3b6e-ac6a-65567bedc9a7",
                                        "entry_id": "5ddccd1a-6084-30fc-8540-c6fb7e895c57",
                                        "glosses": [
                                            "Of or pertaining to a historical period before colonization."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "precolonial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de046f79-582b-3ed9-82a7-1221c4f22a21",
                                        "entry_id": "888f3299-1c79-337a-b0ea-2a6956b37a76",
                                        "glosses": [
                                            "An inhabitant of an area before colonists first arrived."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32acfaa3-8286-46dc-806a-8b0419a777a1",
                                                "sense_id": "de046f79-582b-3ed9-82a7-1221c4f22a21",
                                                "text": "After 1970 one no longer expected to find Tio whose parents had experienced the precolonial period, except for a few very old persons. Most people now were grandchildren of the precolonials."
                                            },
                                            {
                                                "example_id": "20982ccd-4af8-4cd5-a049-f99853429d04",
                                                "sense_id": "de046f79-582b-3ed9-82a7-1221c4f22a21",
                                                "text": "However, archaeological evidence also points to the likelihood of “direct jumps” by Saladoid migrants from South America to the northern Caribbean. It is easy to understand why these early precolonials were engaged in island-hopping."
                                            },
                                            {
                                                "example_id": "167d983c-730a-4de4-99be-24480e790e6d",
                                                "sense_id": "de046f79-582b-3ed9-82a7-1221c4f22a21",
                                                "text": "The precolonials did not do it, and the moderns ought not to do it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
