        "fr-extract.jsonl": [
            {
                "entry_id": "11d80967-409a-3650-a6dc-2b200a32af24",
                "word": "essayiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f5acb53b-426c-4a58-bcc1-f7758b9181a0",
                        "entry_id": "11d80967-409a-3650-a6dc-2b200a32af24",
                        "tags": [
                            "plural",
