                                "target_senses": [
                                    {
                                        "sense_id": "6ee1f2a9-6330-3df6-97a0-3e68017a8cb9",
                                        "entry_id": "398fe90e-59e7-36f8-80f6-5714b01a68c8",
                                        "glosses": [
                                            "zu einem Fossil werden"
                                        ],
