                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "fb082657-5ed4-4b0c-9946-626a2ba97fef",
                        "entry_id": "43977f7a-3af1-3f36-a580-ed5afb0690a2",
