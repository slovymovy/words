                "senses": [
                    {
                        "sense_id": "19225bdb-9db9-3f3b-8879-729e0f9b81f3",
                        "entry_id": "de95ee23-9a2a-3991-9671-955ec9ac3bcf",
                        "glosses": [
                            "ruimtevaartuig dat meerdere malen gebruikt kan worden"
                        ],
                        "tags": [
                            "ruimtevaart"
                        ],
                        "examples": [
                            {
                                "example_id": "7d79aef5-c37b-4e47-9cbc-3d011686a28d",
                                "sense_id": "19225bdb-9db9-3f3b-8879-729e0f9b81f3",
                                "text": "Daar lanceerde ze het project KidSat, waar kinderen in het hele land foto's van de aarde konden laten nemen met een camera op de spaceshuttle."
                            },
                            {
                                "example_id": "f84b8ab2-7d2f-4b05-9be5-2bdcd342506b",
                                "sense_id": "19225bdb-9db9-3f3b-8879-729e0f9b81f3",
                                "text": "Een halfjaar later, vlak voor het sluiten van de wereldwijde aanmeldprocedure, organiseerde hij een tweede fanclubmeeting, in de Utrechtse Jaarbeurs. Daar vond A Human Adventure plaats, een zeer matig bezocht evenement over de geschiedenis van de ruimtevaart, waarbij onder meer een deel van een spaceshuttle was te zien."
                            },
                            {
                                "example_id": "8b11d3f3-f6e6-4afe-aa7b-2d83ff7ec786",
                                "sense_id": "19225bdb-9db9-3f3b-8879-729e0f9b81f3",
                                "text": "Na een missie van twee jaar is de Amerikaanse spaceshuttle X-37B terug op aarde. Het toestel maakt deel uit van een ultrageheime missie van de Amerikaanse luchtmacht, en niemand weet wat het toestel de voorbije twee jaar in de ruimte deed."
                            }
                        ]
                    }
                ],
