{
    "word_family": [
        "lumberjack",
        "lumberyard",
        "lumbering",
        "lumberman"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a6c776bd-9f87-3b96-83fb-d211e1b402d8",
                    "sense_definition": "Wood sawn into planks or otherwise prepared for sale or use, especially as a building material.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wood_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The construction company ordered a large shipment of <w>lumber</w> to build the wooden frames of the new houses.",
                            "target_lang_translations": {
                                "ru": "Строительная компания заказала большую партию <w>пиломатериалов</w> для возведения деревянных каркасов новых домов."
                            }
                        },
                        {
                            "text": "They stacked the freshly cut <w>lumber</w> in the yard to dry before using it for the project.",
                            "target_lang_translations": {
                                "ru": "Они сложили свежеспиленную <w>древесину</w> во дворе, чтобы она высохла перед использованием в проекте."
                            }
                        }
                    ],
                    "synonyms": [
                        "timber",
                        "wood"
                    ],
                    "common_phrases": [
                        "lumber yard",
                        "stack of lumber"
                    ],
                    "target_lang_definitions": {
                        "ru": "Древесина, распиленная на доски или иным образом подготовленная для продажи или использования, особенно в качестве строительного материала."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пиломатериалы",
                                "target_lang_sense_clarification": "обработанная древесина, доски"
                            },
                            {
                                "target_lang_word": "лесоматериалы",
                                "target_lang_sense_clarification": "древесные строительные материалы"
                            },
                            {
                                "target_lang_word": "древесина",
                                "target_lang_sense_clarification": "дерево как материал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8cbaf8f0-5193-3c61-acbc-c69b6d085ebc",
                    "sense_definition": "Old furniture or other items that take up room, or are stored away.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clutter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The attic was filled with decades of old <w>lumber</w> that nobody wanted to throw away.",
                            "target_lang_translations": {
                                "ru": "Чердак был забит старым <w>хламом</w>, накопившимся за десятилетия, который никто не хотел выбрасывать."
                            }
                        },
                        {
                            "text": "We spent the entire weekend clearing out the dusty <w>lumber</w> from the basement.",
                            "target_lang_translations": {
                                "ru": "Мы провели все выходные, выгребая пыльную <w>рухлядь</w> из подвала."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Mainly used in historical or literary contexts to refer to stored clutter."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Старая мебель или другие предметы, которые занимают место или хранятся на складе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлам",
                                "target_lang_sense_clarification": "старые ненужные вещи"
                            },
                            {
                                "target_lang_word": "рухлядь",
                                "target_lang_sense_clarification": "старая изношенная мебель или вещи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf24242c-388e-3a54-b4d2-2874928425fb",
                    "sense_definition": "Useless or cumbrous material.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clutter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His mind was cluttered with a load of useless facts and intellectual <w>lumber</w>.",
                            "target_lang_translations": {
                                "ru": "Его голова была забита кучей бесполезных фактов и интеллектуального <w>балласта</w>."
                            }
                        },
                        {
                            "text": "She cleared the literary <w>lumber</w> from her draft to make the story flow better.",
                            "target_lang_translations": {
                                "ru": "Она убрала литературный <w>хлам</w> из своего черновика, чтобы повествование стало более плавным."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used figuratively for useless mental or physical clutter."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бесполезный или громоздкий материал (часто в переносном смысле)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "балласт",
                                "target_lang_sense_clarification": "бесполезный груз, в том числе интеллектуальный"
                            },
                            {
                                "target_lang_word": "хлам",
                                "target_lang_sense_clarification": "ненужные мысли или сведения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "436edbb3-a3d8-3b1d-a563-e2e51557b315",
                    "sense_definition": "To move clumsily and heavily; to move slowly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We watched the large bear <w>lumber</w> through the thick forest in search of food.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как крупный медведь тяжело <w>бредет</w> сквозь густой лес в поисках пищи."
                            }
                        },
                        {
                            "text": "The heavy truck began to <w>lumber</w> up the steep hill, making a loud noise.",
                            "target_lang_translations": {
                                "ru": "Тяжелый грузовик с громким шумом начал медленно <w>тащиться</w> вверх по крутому склону."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lumber along",
                        "lumber up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться неуклюже и тяжело; медленно тащиться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тяжело ступать",
                                "target_lang_sense_clarification": "идти неуклюже"
                            },
                            {
                                "target_lang_word": "тащиться",
                                "target_lang_sense_clarification": "медленно и тяжело двигаться"
                            },
                            {
                                "target_lang_word": "ковылять",
                                "target_lang_sense_clarification": "неуклюже передвигаться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbe4d9f4-dbce-3bb9-bc55-dd5cfe1547d0",
                    "sense_definition": "To load down with things, to fill, to encumber, to impose an unwanted burden on.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "burden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My colleagues went home early and <w>lumbered</w> me with all the extra paperwork.",
                            "target_lang_translations": {
                                "ru": "Мои коллеги ушли домой пораньше и <w>нагрузили</w> меня всей лишней бумажной работой."
                            }
                        },
                        {
                            "text": "I hate to <w>lumber</w> you with my problems, but I really need someone to talk to.",
                            "target_lang_translations": {
                                "ru": "Мне не хочется <w>обременять</w> вас своими проблемами, но мне действительно нужно с кем-то поговорить."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lumbered with"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in British and Commonwealth English meaning to burden someone."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нагружать вещами, заваливать, обременять нежелательной обязанностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нагружать",
                                "target_lang_sense_clarification": "обременять работой или делами"
                            },
                            {
                                "target_lang_word": "навязывать",
                                "target_lang_sense_clarification": "обременять кого-то нежелательной задачей"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}