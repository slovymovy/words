{
    "word_family": [
        "blasement",
        "blasitude",
        "déblaser"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "672d0674-23a3-3da8-835b-176ec6479880",
                    "sense_definition": "Rendre insensible ou indifférent en faisant éprouver des sensations ou des émotions avec excès.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "desensibilisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La multiplication constante des scènes de violence au cinéma finit par <w>blaser</w> le jeune public."
                        },
                        {
                            "text": "Ce flux ininterrompu de mauvaises nouvelles risque de <w>blaser</w> les esprits des citoyens."
                        }
                    ],
                    "synonyms": [
                        "désensibiliser",
                        "écœurer",
                        "lasser"
                    ],
                    "antonyms": [
                        "émouvoir",
                        "passionner",
                        "stimuler"
                    ],
                    "common_phrases": [
                        "blaser les esprits"
                    ]
                },
                {
                    "sense_id": "681b343a-bd30-3f48-a315-25fded484f6a",
                    "sense_definition": "Devenir indifférent ou perdre sa capacité d'émerveillement par excès d'habitudes ou de plaisirs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "desensibilisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À force d'avoir accès à tous les loisirs imaginables, les enfants peuvent se <w>blaser</w> de tout."
                        },
                        {
                            "text": "Après des années de voyages luxueux et faciles, il commence à se <w>blaser</w> de cette vie."
                        }
                    ],
                    "synonyms": [
                        "se lasser",
                        "se désintéresser"
                    ],
                    "antonyms": [
                        "s'émerveiller",
                        "s'enthousiasmer"
                    ],
                    "common_phrases": [
                        "se blaser de tout"
                    ]
                },
                {
                    "sense_id": "efdd82af-7b6e-343f-935c-d4b0943dcea7",
                    "sense_definition": "Émousser ou affaiblir un sens physique, particulièrement le goût ou le palais, par des excès répétés.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "desensibilisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La consommation régulière de plats excessivement épicés finit par <w>blaser</w> le palais des gourmets."
                        },
                        {
                            "text": "L'alcool fort bu en grande quantité peut <w>blaser</w> le goût de manière irréversible."
                        }
                    ],
                    "synonyms": [
                        "émousser",
                        "insensibiliser"
                    ],
                    "antonyms": [
                        "affiner",
                        "aiguiser"
                    ],
                    "common_phrases": [
                        "blaser le goût",
                        "blaser le palais"
                    ]
                }
            ]
        }
    ]
}