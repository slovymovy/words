                        "cross_references": []
                    },
                    {
                        "translation_id": "6b6f2d68-8987-48e5-8a4c-288a786c7fee",
                        "source_entry_id": "b85b62cc-fc58-39c8-8802-d7caed4ca080",
                        "source_sense_id": "eca12815-1bb9-3272-9217-cc47fb45bc06",
                        "target_lang_word": "totemism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "totemism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7943cf55-48fb-39a8-8aff-82da932552c8",
                                        "entry_id": "7b9887c6-5627-3d12-a36c-a961691e80fd",
                                        "glosses": [
                                            "The belief that a person or group has a special mystical relationship to a totem"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48298267-71c1-4bf9-adbe-32b9ddd70f8d",
                                                "sense_id": "7943cf55-48fb-39a8-8aff-82da932552c8",
                                                "text": "This is the common story of superstition, from the totemism of savage tribes and the image-worship of semi-civilized peoples on to the heathenism of the Mass."
                                            },
                                            {
                                                "example_id": "599ff680-b1bc-4ed9-908a-31bf7369bd3c",
                                                "sense_id": "7943cf55-48fb-39a8-8aff-82da932552c8",
                                                "text": "Although you see some representations of animals or gods in the form of animals, there's really no totemism or animism in Egyptian religion."
                                            },
                                            {
                                                "example_id": "271d1764-d2ff-4454-aac2-016f17c5306d",
                                                "sense_id": "7943cf55-48fb-39a8-8aff-82da932552c8",
                                                "text": "“The Happiness of Objects” doesn’t make it easy on the viewer. Mr. Mitchell’s book is, after all, an academic tome (though quite readable) that delves into complex discussions of everything from pictures, objects and materials to their relationship with totemism, fetishism and idolatry."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "103a09b0-f28b-4650-905a-e8c287f3a987",
                        "source_entry_id": "b85b62cc-fc58-39c8-8802-d7caed4ca080",
