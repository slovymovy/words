                        "glosses": [
                            "Autre orthographe, rarement rencontrée, de réassortir (assortir à nouveau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f202456b-6248-40bb-a294-cf4ccbaf752e",
                                "sense_id": "ef33de04-9659-3fae-baf3-30117bfd4d1f",
                                "text": "N’allons point, sous prétexte d’écrire un beau chapitre, ré-assortir les faits et leur imposer un rôle qui ne cadre point avec la juste notion historique."
                            },
                            {
                                "example_id": "8abb1492-944c-4262-a235-d96510f66c3d",
                                "sense_id": "ef33de04-9659-3fae-baf3-30117bfd4d1f",
                                "text": "Le divorce doit être facile, il permet de ré-assortir des couples."
