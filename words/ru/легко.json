                {
                    "sense_id": "ba964856-7f32-3cb2-8038-db7cf19e1a6e",
                    "sense_definition": "С небольшим весом, не тепло (об одежде) или слабо, нежно (о прикосновении).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weight_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Летом я люблю одеваться <легко> и удобно.",
                            "target_lang_translations": {
                                "en": "In summer I like to dress <lightly> and comfortably.",
                                "zh": "夏天我喜欢穿得<w>轻便</w>舒适。",
                                "nl": "In de zomer kleed ik me graag <w>licht</w> en comfortabel.",
                                "pl": "Latem lubię ubierać się <w>lekko</w> i wygodnie.",
                                "de": "Im Sommer kleide ich mich gerne <w>leicht</w> und bequem.",
                                "fr": "En été, j'aime m'habiller <w>légèrement</w> et confortablement.",
                                "it": "In estate mi piace vestirmi <w>leggero</w> e comodo.",
                                "cs": "V létě se rád oblékám <w>nalehko</w> a pohodlně.",
                                "tr": "Yazın <w>hafif</w> ve rahat giyinmeyi severim.",
                                "es": "En verano me gusta vestir <w>ligero</w> y cómodo."
                            }
                        },
                        {
                            "text": "Ветер <легко> коснулся верхушек деревьев в саду.",
                            "target_lang_translations": {
                                "en": "The wind <gently> touched the treetops in the garden.",
                                "zh": "微风<w>轻轻</w>地拂过花园里的树梢。",
                                "nl": "De wind raakte <w>zachtjes</w> de toppen van de bomen in de tuin aan.",
                                "pl": "Wiatr <w>lekko</w> dotknął wierzchołków drzew w ogrodzie.",
                                "de": "Der Wind berührte <w>sanft</w> die Baumwipfel im Garten.",
                                "fr": "Le vent a <w>doucement</w> effleuré la cime des arbres dans le jardin.",
                                "it": "Il vento ha toccato <w>delicatamente</w> le cime degli alberi in giardino.",
                                "cs": "Vítr se <w>lehce</w> dotkl vrcholků stromů v zahradě.",
                                "tr": "Rüzgar bahçedeki ağaçların tepelerine <w>hafifçe</w> dokundu.",
                                "es": "El viento tocó <w>suavemente</w> las copas de los árboles en el jardín."
                            }
                        }
                    ],
