{
    "word_family": [
        "poke",
        "poker",
        "poky"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "73b7ef46-551e-38e2-93f9-47a84fd7441e",
                    "sense_definition": "Present participle and gerund of <w>poke</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>poking</w> the fire with a long metal rod.",
                            "target_lang_translations": {
                                "ru": "Он <w>ворошил</w> огонь длинным металлическим прутом.",
                                "pl": "On <w>grzebał</w> w ogniu długim metalowym prętem."
                            }
                        },
                        {
                            "text": "Stop <w>poking</w> me in the ribs while I am trying to read.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>тыкать</w> меня в бока, пока я пытаюсь читать.",
                                "pl": "Przestań mnie <w>szturchać</w> w żebra, kiedy próbuję czytać."
                            }
                        }
                    ],
                    "common_phrases": [
                        "poking around",
                        "poking fun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, заключающееся в тыкании, протыкании или подталкивании кого-либо или чего-либо пальцем или предметом.",
                        "pl": "Czynność polegająca na szturchaniu, dźganiu lub popychaniu kogoś lub czegoś palcem lub przedmiotem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тыканье",
                                "target_lang_sense_clarification": "процесс совершения тыкающих движений"
                            },
                            {
                                "target_lang_word": "ворошение",
                                "target_lang_sense_clarification": "применительно к огню или углям"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "szturchanie",
                                "target_lang_sense_clarification": "proces wykonywania ruchów szturchających"
                            },
                            {
                                "target_lang_word": "grzebanie",
                                "target_lang_sense_clarification": "w odniesieniu do ognia lub węgla"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c627dc40-f4a6-3ecd-80b2-7a521429ed5f",
                    "sense_definition": "The act of pushing or prodding something with a finger or an object.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child gave the toy a few <w>pokings</w> to see if it would move.",
                            "target_lang_translations": {
                                "ru": "Ребенок сделал несколько <w>тычков</w> игрушке, чтобы проверить, сдвинется ли она.",
                                "pl": "Dziecko wykonało kilka <w>szturchnięć</w> zabawki, żeby sprawdzić, czy się poruszy."
                            }
                        },
                        {
                            "text": "After several <w>pokings</w> at the screen, the device finally turned on.",
                            "target_lang_translations": {
                                "ru": "После нескольких <w>нажатий</w> на экран устройство наконец включилось.",
                                "pl": "Po kilku <w>naciśnięciach</w> ekranu urządzenie w końcu się włączyło."
                            }
                        }
                    ],
                    "synonyms": [
                        "prodding",
                        "jab"
                    ],
                    "common_phrases": [
                        "gentle pokings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт нажатия, тычка или подталкивания чего-либо пальцем или инструментом.",
                        "pl": "Akt naciśnięcia, szturchnięcia lub popchnięcia czegoś palcem lub narzędziem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тычок",
                                "target_lang_sense_clarification": "короткое резкое движение"
                            },
                            {
                                "target_lang_word": "потыкивание",
                                "target_lang_sense_clarification": "несколько повторяющихся тычков"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "szturchnięcie",
                                "target_lang_sense_clarification": "krótki, gwałtowny ruch"
                            },
                            {
                                "target_lang_word": "naciśnięcie",
                                "target_lang_sense_clarification": "w odniesieniu do ekranów lub przycisków"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "550cf503-5a79-3f0b-a57e-95c4c4987b89",
                    "sense_definition": "Relating to drudging or servile work.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt trapped in a <w>poking</w> existence of endless, menial tasks.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя в ловушке <w>изнурительного</w> существования, состоящего из бесконечных черных дел.",
                                "pl": "Czuł się uwięziony w <w>żmudnej</w> egzystencji pełnej niekończących się, niewdzięcznych zadań."
                            }
                        },
                        {
                            "text": "The <w>poking</w> nature of his daily chores left him with no time for himself.",
                            "target_lang_translations": {
                                "ru": "Из-за <w>черной</w> природы его ежедневных обязанностей у него не оставалось времени на себя.",
                                "pl": "<w>Niewdzięczny</w> charakter jego codziennych obowiązków sprawiał, że nie miał czasu dla siebie."
                            }
                        }
                    ],
                    "synonyms": [
                        "menial",
                        "servile"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is archaic and rarely encountered in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к изнурительной, черной или низкооплачиваемой работе.",
                        "pl": "Dotyczący żmudnej, niewdzięcznej lub nisko płatnej pracy."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "черный",
                                "target_lang_sense_clarification": "о тяжелой, неквалифицированной работе"
                            },
                            {
                                "target_lang_word": "изнурительный",
                                "target_lang_sense_clarification": "о монотонном и тяжелом труде"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "niewdzięczny",
                                "target_lang_sense_clarification": "o ciężkiej, nieprzyjemnej pracy"
                            },
                            {
                                "target_lang_word": "żmudny",
                                "target_lang_sense_clarification": "o monotonnej i męczącej pracy"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}