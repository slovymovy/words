                "senses": [
                    {
                        "sense_id": "67338fd7-0199-3359-a462-2eb0330fca30",
                        "entry_id": "6709bc5f-bf55-32fb-afa0-4ce269a775e2",
                        "glosses": [
                            "Gagner à nouveau (pour la troisième fois au moins)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "227b6ffa-b4b0-4e90-9b7f-26a99f79a282",
                                "sense_id": "67338fd7-0199-3359-a462-2eb0330fca30",
                                "text": "Même pas 18 ans, déjà une médaille d’or en poche et la culture de la victoire en bandoulière. Pas celle de la France qui gagne, non, celle qui regagne, qui reregagne et qui gagne encore."
                            },
                            {
                                "example_id": "7f8244fd-ec6e-48c4-92df-900fb225b5a5",
                                "sense_id": "67338fd7-0199-3359-a462-2eb0330fca30",
                                "text": "Elle mise. Gagne. Empoche. Remise. Regagne. Reremise. Reregagne."
                            },
                            {
                                "example_id": "acb8b483-b4f4-4e01-82eb-f3ea4a2d9692",
                                "sense_id": "67338fd7-0199-3359-a462-2eb0330fca30",
                                "text": "Il reponte. Il regagne. ll rereponte. Il reregagne."
                            }
                        ]
                    }
                ],
