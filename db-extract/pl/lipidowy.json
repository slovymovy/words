                "senses": [
                    {
                        "sense_id": "1f53e45f-e59e-3d8e-8198-425059636744",
                        "entry_id": "4b7f0df3-f238-3375-a3f4-5df56087c907",
                        "glosses": [
                            "odnoszący się do lipidu, związany z lipidem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdb91eed-e786-4280-87fd-dc516d1d3d9a",
                                "sense_id": "1f53e45f-e59e-3d8e-8198-425059636744",
                                "text": "Ponieważ kaweole mają specyficzny skład lipidowy, odmienny od statystycznie średniego składu błony, uważa się je za jeden z rodzajów raftów lipidowych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
