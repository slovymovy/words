                "senses": [
                    {
                        "sense_id": "d4bc079b-c321-31eb-862a-b38a2b63e23a",
                        "entry_id": "376b671d-eabd-34f3-8c6a-448d7d52efd8",
                        "glosses": [
                            "Gesellschaft, deren Mitglieder einen hohen Lebensstandard haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7115b6e0-f242-4dce-9840-bb12c608b6b4",
                                "sense_id": "d4bc079b-c321-31eb-862a-b38a2b63e23a",
                                "text": "„Sie formulierten nur aggressiv, manchmal doppeldeutig, mit derber Sprache und einfachen Hardrock-Rhythmen den Frust vieler Kids am Rande der Wohlstandsgesellschaft.“"
                            },
                            {
                                "example_id": "4b2ca29f-67df-4d21-b52a-afceb2efaad8",
                                "sense_id": "d4bc079b-c321-31eb-862a-b38a2b63e23a",
                                "text": "„Es zielt auf die nostalgischen Gefühle einer alternden Wohlstandsgesellschaft, die mehr in der Vergangenheit als in der Zukunft lebt, aber es enthält einen wahren Kern.“"
                            },
                            {
                                "example_id": "9a967d20-b754-4e07-bb25-94e5e1cfbda5",
                                "sense_id": "d4bc079b-c321-31eb-862a-b38a2b63e23a",
                                "text": "„Betteln, die Schauseite der Armut, ist ins städtische Straßenbild der Wohlstandsgesellschaften hineingewachsen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
