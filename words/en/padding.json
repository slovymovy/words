{
    "word_family": [
        "pad",
        "padded",
        "paddable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8993811f-6173-314d-b39d-7fb42268de39",
                    "sense_definition": "Soft material used to fill cushions or protect objects.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "filling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chair was comfortable because of the thick <w>padding</w> inside the seat.",
                            "target_lang_translations": {
                                "cs": "Židle byla pohodlná díky silnému <w>polstrování</w> uvnitř sedáku."
                            }
                        },
                        {
                            "text": "The box was filled with <w>padding</w> to keep the glass from breaking.",
                            "target_lang_translations": {
                                "cs": "Krabice byla vyplněna <w>výplní</w>, aby se sklo nerozbilo."
                            }
                        }
                    ],
                    "common_phrases": [
                        "extra padding"
                    ],
                    "target_lang_definitions": {
                        "cs": "Měkký materiál používaný k vyplnění polštářů nebo k ochraně předmětů."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vycpávka",
                                "target_lang_sense_clarification": "měkký materiál uvnitř čalounění nebo oděvů"
                            },
                            {
                                "target_lang_word": "polstrování",
                                "target_lang_sense_clarification": "měkká vrstva pro pohodlí nebo ochranu"
                            },
                            {
                                "target_lang_word": "výplň",
                                "target_lang_sense_clarification": "materiál sloužící k vyplnění prostoru"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2775acdf-a178-34a8-afce-dbdbc7b3cdfe",
                    "sense_definition": "Unimportant content added to fill space.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "filling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The essay was too short, so he added some <w>padding</w> to reach the word count.",
                            "target_lang_translations": {
                                "cs": "Esej byla příliš krátká, tak přidal trochu <w>vaty</w>, aby dosáhl požadovaného počtu slov."
                            }
                        },
                        {
                            "text": "The report contained a lot of <w>padding</w> but very little useful information.",
                            "target_lang_translations": {
                                "cs": "Zpráva obsahovala spoustu <w>vaty</w>, ale jen velmi málo užitečných informací."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Nedůležitý obsah přidaný pouze pro vyplnění místa."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vata",
                                "target_lang_sense_clarification": "přeneseně nepodstatný obsah textu"
                            },
                            {
                                "target_lang_word": "výplňový text",
                                "target_lang_sense_clarification": "text přidaný jen pro dosažení délky"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12d13d8d-150b-3a0f-aad0-a40f1ebabed5",
                    "sense_definition": "Extra characters added to data to reach a specific length.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "filling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system uses <w>padding</w> to ensure every data record is the same size.",
                            "target_lang_translations": {
                                "cs": "Systém používá <w>doplnění</w>, aby zajistil, že každý datový záznam má stejnou velikost."
                            }
                        },
                        {
                            "text": "The programmer removed the <w>padding</w> from the end of the text file.",
                            "target_lang_translations": {
                                "cs": "Programátor odstranil <w>výplň</w> z konce textového souboru."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Dodatečné znaky přidané k datům pro dosažení určité délky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "doplnění",
                                "target_lang_sense_clarification": "technický termín pro zarovnání dat"
                            },
                            {
                                "target_lang_word": "výplň",
                                "target_lang_sense_clarification": "datové bajty pro zarovnání"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "baa27256-2c71-33e1-ac13-623a93f148f9",
                    "sense_definition": "Extra text added to a message to hide its true length or content.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "filling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The secret message included random <w>padding</w> to confuse anyone trying to read it.",
                            "target_lang_translations": {
                                "cs": "Tajná zpráva obsahovala náhodnou <w>výplň</w>, aby zmátla každého, kdo by se ji pokusil přečíst."
                            }
                        },
                        {
                            "text": "The spy used <w>padding</w> to disguise the actual length of the transmission.",
                            "target_lang_translations": {
                                "cs": "Špion použil <w>maskovací text</w>, aby zakryl skutečnou délku přenosu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Text přidaný ke zprávě za účelem skrytí její skutečné délky nebo obsahu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "maskovací text",
                                "target_lang_sense_clarification": "text sloužící k utajení skutečné zprávy"
                            },
                            {
                                "target_lang_word": "výplň",
                                "target_lang_sense_clarification": "náhodná data pro zmatení obsahu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27f1f53b-b7eb-3057-a3d3-2db3eba771a5",
                    "sense_definition": "A diaper.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby needed a fresh <w>padding</w> after the long nap.",
                            "target_lang_translations": {
                                "cs": "Dítě potřebovalo po dlouhém šlofíku čerstvou <w>plenu</w>."
                            }
                        },
                        {
                            "text": "She carefully changed the <w>padding</w> on the infant.",
                            "target_lang_translations": {
                                "cs": "Opatrně miminku vyměnila <w>plenu</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "nappy",
                        "napkin"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Regional or dated usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Dětská plena."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "plena",
                                "target_lang_sense_clarification": "dětská plenka"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9e18cbc4-e318-3749-b34b-6023e67b4889",
                    "sense_definition": "Present participle and gerund of <w>pad</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>padding</w> his resume with skills he does not actually have.",
                            "target_lang_translations": {
                                "cs": "Své životopisy si <w>vylepšuje</w> dovednostmi, které ve skutečnosti nemá."
                            }
                        },
                        {
                            "text": "The company is <w>padding</w> the bill with unnecessary extra charges.",
                            "target_lang_translations": {
                                "cs": "Společnost <w>navyšuje</w> účet o zbytečné dodatečné poplatky."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb pad."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přítomný příčestí a gerundium slovesa pad (vycpávat, nadhodnocovat)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vylepšování",
                                "target_lang_sense_clarification": "nadhodnocování životopisu"
                            },
                            {
                                "target_lang_word": "navyšování",
                                "target_lang_sense_clarification": "umělé zvyšování účtovaných částek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}