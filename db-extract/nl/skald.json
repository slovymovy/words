                                    {
                                        "sense_id": "f560e0b4-9300-38d1-be0d-5e1fc28583b1",
                                        "entry_id": "214f4cb3-5f5b-312e-abbb-ffc0078d1ff7",
                                        "glosses": [
                                            "A Nordic poet of the Viking Age."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d17bf3a3-bb0d-4b63-8569-e3e32c3205d6",
                                                "sense_id": "f560e0b4-9300-38d1-be0d-5e1fc28583b1",
                                                "text": "The fire was spreading rapidly through all parts of the castle, when Ulrica, who had first kindled it, appeared on a turret, in the guise of one of the ancient furies, yelling forth a war-song, such as was of yore chaunted on the field of battle by the scalds of the yet heathen Saxons."
                                            },
                                            {
                                                "example_id": "29c44a9a-4be9-48b0-845b-4ce10933448c",
                                                "sense_id": "f560e0b4-9300-38d1-be0d-5e1fc28583b1",
                                                "text": "Command Egil the Skald to stand forth and stir our viking blood with his songs of thee."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
