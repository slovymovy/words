                "senses": [
                    {
                        "sense_id": "7499039d-495b-37f7-9aea-3be28cc0db07",
                        "entry_id": "7792152a-d231-3299-9872-6d9a7edc4435",
                        "glosses": [
                            "rów tektoniczny o znacznej długości i głębokości"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17c8ed14-27cc-42df-a9ea-03f066d4fd55",
                                "sense_id": "7499039d-495b-37f7-9aea-3be28cc0db07",
                                "text": "Aktualnie obserwuje się tworzenie nowego ryftu na terytorium Etiopii, na północy regionu Afar, w miejscu zbiegu płyt tektonicznych: afrykańskiej, arabskiej i somalijskiej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b78a67a0-6050-4e5b-a88a-cc06633d410b",
                        "source_entry_id": "7792152a-d231-3299-9872-6d9a7edc4435",
                        "source_sense_id": "7499039d-495b-37f7-9aea-3be28cc0db07",
                        "target_lang_word": "rift",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rift",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85760595-bd17-3bc3-a3b5-fd16d9e03a61",
                                        "entry_id": "12fa97f1-fd17-386f-8c3a-b786b6c21ff5",
                                        "glosses": [
                                            "A chasm or fissure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8edc8ba-737b-4257-8f32-eb71efcc061d",
                                                "sense_id": "85760595-bd17-3bc3-a3b5-fd16d9e03a61",
                                                "text": "The Grand Canyon is a rift in the Earth's surface, but is smaller than some of the undersea ones."
                                            },
                                            {
                                                "example_id": "ae6de87b-9acc-44df-8b9a-8c279ceb3b65",
                                                "sense_id": "85760595-bd17-3bc3-a3b5-fd16d9e03a61",
                                                "text": "Where ashes are heaped in drifts / Over vineyard and field and town, / Whenever he starts and lifts / His head through the blackened rifts / Of the crags that keep him down"
                                            },
                                            {
                                                "example_id": "8052be95-846e-4659-92f7-6809e1319447",
                                                "sense_id": "85760595-bd17-3bc3-a3b5-fd16d9e03a61",
                                                "text": "As far as the eye can reach is a sea of green tree tops, with occasionally a deep rift where there is a chasm. Here and there are silver threads where the rivers wind in deep gorges through the forests."
                                            },
                                            {
                                                "example_id": "ff997cd1-508e-4878-82fe-6183d004f51d",
                                                "sense_id": "85760595-bd17-3bc3-a3b5-fd16d9e03a61",
                                                "text": "Far back in the dim geologic ages, when the sediments of the old seas were being gathered and outspread in smooth sheets like leaves of a book, and when these sediments became dry land, and were baked and crumbled into the sky as mountain ranges; when the lava-floods of the Fire Period were being lavishly poured forth from innumerable rifts and craters;[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0322d811-f3c8-3628-8fbe-6f4a1eae1442",
                                        "entry_id": "12fa97f1-fd17-386f-8c3a-b786b6c21ff5",
                                        "glosses": [
                                            "A lack of cohesion; a state of conflict, incompatibility, or emotional distance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f8293a1-aec0-4c38-bf8c-7c198ee6d70b",
                                                "sense_id": "0322d811-f3c8-3628-8fbe-6f4a1eae1442",
                                                "text": "My marriage is in trouble: the fight created a rift between us and we can't reconnect."
                                            },
                                            {
                                                "example_id": "4e21ffb5-21dd-4137-91d1-c093730278a0",
                                                "sense_id": "0322d811-f3c8-3628-8fbe-6f4a1eae1442",
                                                "text": "Elon Musk, the billionaire tech entrepreneur, has opened a new rift with Donald Trump by denouncing the US president’s tax and spending bill as a “disgusting abomination”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34e0bd05-c2c8-3c44-baca-6c3fea347065",
                                        "entry_id": "12fa97f1-fd17-386f-8c3a-b786b6c21ff5",
                                        "glosses": [
                                            "A break in the clouds, fog, mist etc., which allows light through."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f195dbb-be1e-4d0b-93ea-2c7523b208d6",
                                                "sense_id": "34e0bd05-c2c8-3c44-baca-6c3fea347065",
                                                "text": "I have but one rift in the darkness, that is that I have injured no one save myself by my folly, and that the extent of that folly you will never learn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1025082-0b20-34e8-b3f7-4e2fd76fdb96",
                                        "entry_id": "12fa97f1-fd17-386f-8c3a-b786b6c21ff5",
                                        "glosses": [
                                            "A shallow place in a stream; a ford."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rift",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b135dc6d-16b0-3fa5-9df5-36620c7c31fb",
                                        "entry_id": "e2382d69-0f2e-3d9a-b101-a74607773c00",
                                        "glosses": [
                                            "To form a rift; to split open."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1521ec2-9ea4-387c-b133-225b0a2af6f0",
                                        "entry_id": "e2382d69-0f2e-3d9a-b101-a74607773c00",
                                        "glosses": [
                                            "To cleave; to rive; to split."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64bcb42e-0f7d-4163-abe1-457ec840dece",
                                                "sense_id": "e1521ec2-9ea4-387c-b133-225b0a2af6f0",
                                                "text": "to rift an oak"
                                            },
                                            {
                                                "example_id": "15024f6f-1ba3-44be-b188-6c7a9f244403",
                                                "sense_id": "e1521ec2-9ea4-387c-b133-225b0a2af6f0",
                                                "text": "to the dread rattling thunder / Have I given fire and rifted Jove's stout oak / With his own bolt"
                                            },
                                            {
                                                "example_id": "95cbddbe-1cf1-4b9f-8803-7435e9241cc5",
                                                "sense_id": "e1521ec2-9ea4-387c-b133-225b0a2af6f0",
                                                "text": "The Mother—her thou must have seen, / In spirit, ere she came / To dwell these rifted rocks between."
                                            },
                                            {
                                                "example_id": "819d617e-be67-44a1-9e4b-23e531f0176a",
                                                "sense_id": "e1521ec2-9ea4-387c-b133-225b0a2af6f0",
                                                "text": "1894, Ivan Dexter, Talmud: A Strange Narrative of Central Australia, published in serial form in Port Adelaide News and Lefevre's Peninsula Advertiser (SA), Chapter III, http://gutenberg.net.au/ebooks16/1600641.txt\nhe stopped rigid as one petrified and gazed through the rifted logs of the raft into the water."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rift",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf463104-eb6b-3954-a760-dcf45e3d7db0",
                                        "entry_id": "3d3f0470-d1fc-30ce-bc13-88614d3687f9",
                                        "glosses": [
                                            "To belch."
                                        ],
