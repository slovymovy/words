                ],
                "senses": [
                    {
                        "sense_id": "6da0840a-bf57-3865-b713-ad98bea5bb7d",
                        "entry_id": "9f4c3a54-6211-3786-96fc-b9883fa101a4",
                        "glosses": [
                            "Donner un caractère inconfortable à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96bd9806-e246-4a1a-96f4-2a92f2bc6723",
                                "sense_id": "6da0840a-bf57-3865-b713-ad98bea5bb7d",
                                "text": "Histoire de leur expliquer que ce suivi n'est jamais devenu une obligation, pour éviter d'inconfortabiliser la majorité bien portante ?"
                            },
                            {
                                "example_id": "3f8dae02-347c-40a7-ac63-9de3dfabd384",
                                "sense_id": "6da0840a-bf57-3865-b713-ad98bea5bb7d",
                                "text": "C'est ainsi que je profite de ces moments précieux avec toi qui me permettent de me sentir bien, mais surtout de me libérer de certaines parties qui, parfois, « inconfortabilisent » ma Paix intérieure."
                            },
                            {
                                "example_id": "20707e1f-6bc6-4612-bf44-e9f8385aa8ed",
                                "sense_id": "6da0840a-bf57-3865-b713-ad98bea5bb7d",
                                "text": "Pour Dominic et moi, c'est important qu'on « s'inconfortabilise » un peu, qu'on ait l'impression d'évoluer et d'aller vers autre chose."
                            }
                        ]
                    }
                ],
