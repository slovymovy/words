                "translations": [
                    {
                        "translation_id": "d2817f84-3149-44fd-9a35-efac68890248",
                        "source_entry_id": "3ab3e5c3-3204-30f1-bbe6-d4381d5b8d4f",
                        "target_lang_word": "rigger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rigger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d429eb2-27b9-31ea-a483-0d1b529ff5e1",
                                        "entry_id": "961cf55e-10f5-364b-a434-8b52f6ca5fdb",
                                        "glosses": [
                                            "One who rigs or dresses; as:",
                                            "One whose occupation is to fit the rigging of a ship or of a counterweight system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddc09661-acd5-45d2-ac5f-4f53ddf590d0",
                                                "sense_id": "3d429eb2-27b9-31ea-a483-0d1b529ff5e1",
                                                "text": "So far there was not a hitch. The workpeople, to be sure — riggers and what not — were most annoyingly slow; but time cured that. It was the crew that troubled me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "495fb524-0849-39f5-9350-fbf6d395e540",
                                        "entry_id": "961cf55e-10f5-364b-a434-8b52f6ca5fdb",
                                        "glosses": [
                                            "One who rigs or dresses; as:",
                                            "One whose occupation is to lift and move large and heavy objects (such as industrial machinery) with the help of cables, hoists, and other equipment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ff4318c-d2c2-4d44-957f-ce78a26ad4f2",
                                                "sense_id": "495fb524-0849-39f5-9350-fbf6d395e540",
                                                "text": "What if the rigger (the person who anchors the grids to the building ceiling) mishangs a single cable?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fc95557-93fe-3db2-8614-11b97f4beab0",
                                        "entry_id": "961cf55e-10f5-364b-a434-8b52f6ca5fdb",
                                        "glosses": [
                                            "One who rigs or dresses; as:",
                                            "One whose occupation is to outfit a computer model with controls for animation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7a3ec7d-2c75-4bb4-b68f-ebc004506a7e",
                                                "sense_id": "0fc95557-93fe-3db2-8614-11b97f4beab0",
                                                "text": "It is common that after the rig is created an animator asks the rigger to create new controls, because the character needs to support new poses or simply needs to look better."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7be60e5-cc99-3be1-92fa-08df2fa4c490",
                                        "entry_id": "961cf55e-10f5-364b-a434-8b52f6ca5fdb",
                                        "glosses": [
                                            "A worker on an oil rig."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c3dabdc-a3ee-3a0c-9372-1230ca154399",
                                        "entry_id": "961cf55e-10f5-364b-a434-8b52f6ca5fdb",
                                        "glosses": [
                                            "One who rigs or manipulates (an election, etc)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45f9a842-db0d-49a5-a224-78642e13fcc5",
                                                "sense_id": "8c3dabdc-a3ee-3a0c-9372-1230ca154399",
                                                "text": "The real riggers of electoral boundaries in New South Wales were those who got loose after 1965. When the boys from George Street and Ash Street got loose there was a majority in the Parliament. That is when there was a redistribution […]"
                                            },
                                            {
                                                "example_id": "e713af4b-67c0-4737-9711-04069848ce59",
                                                "sense_id": "8c3dabdc-a3ee-3a0c-9372-1230ca154399",
                                                "text": "An election rigger who assumes illegitimate political power would be primarily motivated to spread their corrosive toxins across the political system, thus rendering institutions of government dysfunctional and convoluted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36e52ddf-4e6e-393e-a13e-4ce2f9aed537",
                                        "entry_id": "961cf55e-10f5-364b-a434-8b52f6ca5fdb",
                                        "glosses": [
                                            "A part of a rowing boat's equipment used to provide leverage for a rowing blade or oar around a fixed fulcrum."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cba5739c-1164-32c9-8589-79db6e814d14",
                                        "entry_id": "961cf55e-10f5-364b-a434-8b52f6ca5fdb",
                                        "glosses": [
                                            "A ship with a certain type of rigging."
                                        ],
                                        "tags": [
                                            "in-compounds"
                                        ],
                                        "examples": []
                                    },
                                    {
