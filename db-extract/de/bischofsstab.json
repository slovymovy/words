                ],
                "senses": [
                    {
                        "sense_id": "cfe526b3-11ab-3de6-8f56-0723032a4acf",
                        "entry_id": "9e8e7675-0e6a-3cdf-909b-63d2d44b69e1",
                        "glosses": [
                            "Krummstab eines Bischofs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a8ab79d-6a53-4b08-a1c8-21e35647c192",
                                "sense_id": "cfe526b3-11ab-3de6-8f56-0723032a4acf",
                                "text": "Der Bischofsstab ist ein Symbol der Amtswürde des Bischofs."
                            },
                            {
                                "example_id": "658ce352-2e73-4301-b3bb-e069d55ee371",
                                "sense_id": "cfe526b3-11ab-3de6-8f56-0723032a4acf",
                                "text": "„Neben dem Altar ist eine Replik des Bischofsstabs ausgestellt.“"
                            },
                            {
                                "example_id": "35c6a774-8332-454c-9c8d-1018ff43b7ce",
                                "sense_id": "cfe526b3-11ab-3de6-8f56-0723032a4acf",
                                "text": "„Das Symbol des Hirtenstabes wurde dem mittelalterlichen Europa überliefert und dort abgewandelt zum Bischofsstab.“"
                            },
                            {
                                "example_id": "2c026134-ead1-4c25-b5fc-1a8ee6f422cd",
                                "sense_id": "cfe526b3-11ab-3de6-8f56-0723032a4acf",
                                "text": "„Albrecht präsentiert sich in voller Pracht mit Bischofsmütze (darunter lugt noch ein wenig Kardinalsrot hervor), Bischofsstab und juwelenübersätem Ornat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
