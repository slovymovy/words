                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assamais",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a011027-7d73-3047-85e9-54f69165687f",
                                        "entry_id": "972827bb-e1e3-32f1-bfc3-e567260c46bc",
                                        "glosses": [
                                            "Relatif à l’Assam, État du nord-est de l’Inde, ou à ses habitants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2883aeb5-5116-42c7-9768-0143efce39a9",
                                                "sense_id": "5a011027-7d73-3047-85e9-54f69165687f",
                                                "text": "Le paysage assamais classique, vert et or, se compose de rizières et de plantations de thé à perte de vue, encadrées au loin par les montagnes bleutées de l’Arunachal au nord et par les hauts plateaux du Meghalaya et du Nagaland au sud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adab6eda-ad32-37e0-8075-bf5a31944ae7",
                                        "entry_id": "972827bb-e1e3-32f1-bfc3-e567260c46bc",
                                        "glosses": [
                                            "Relatif à l’assamais (langue)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82873653-3583-42f5-ab85-87a2ccfe64fc",
                                                "sense_id": "adab6eda-ad32-37e0-8075-bf5a31944ae7",
                                                "text": "Le thibétain n’est lui-même qu’une modification, qu’une altération des langues de la famille monosyllabique à laquelle appartiennent les dialectes assamais : c’est ce que nous montrent les idiomes de plusieurs tribus de l’Assam et de l’Aracan, par exemple celui des Nagas et celui des Youmahs, qui servent de passage du barman au thibétain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "assamais",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa0755b7-68fe-34c7-ab4c-941cd36db097",
                                        "entry_id": "269cb90a-6a51-3406-897b-b45067c942e9",
                                        "glosses": [
                                            "Langue parlée en Assam, État du nord-est de l’Inde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bcfc0fa-a24a-40af-9eb8-bce77d842956",
                                                "sense_id": "aa0755b7-68fe-34c7-ab4c-941cd36db097",
                                                "text": "L'assamais fait partie du groupe linguistique indo-européen, dont il représente la forme la plus orientale. Il est parlé par quelque 13 millions de personnes (2001), essentiellement dans l’État d’Assam où il constitue une langue officielle (statut qu’il a aussi dans l’Arunachal Pradech)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
