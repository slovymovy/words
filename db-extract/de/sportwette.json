                        "entry_id": "8d333e97-85d4-3a0f-971f-01590d613144",
                        "glosses": [
                            "Wette, die sich auf das Ergebnis eines sportlichen Wettbewerbs bezieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5bc89ae-d772-47d6-893f-7526ad4dcbec",
                                "sense_id": "d3729d5a-4ed1-355f-a82e-555b9700ac92",
                                "text": "Ich habe bereits Sportwetten mit einem Einsatz von 1.000 Euro abgeschlossen."
                            },
                            {
                                "example_id": "d4cf2cad-2d76-409e-a530-9cb6ddfeae9a",
                                "sense_id": "d3729d5a-4ed1-355f-a82e-555b9700ac92",
                                "text": "„Bis 1. Juli 2012 war die Rechtslage klar: Es gab ein staatliches Monopol für Sportwetten und es gab nur die Lotto-Sportwette Oddset - keine Internetanbieter, keine Wettbüros.“"
                            },
                            {
                                "example_id": "6acf9270-4bdb-41c2-bdfb-98116fde5a07",
                                "sense_id": "d3729d5a-4ed1-355f-a82e-555b9700ac92",
                                "text": "„Seit das Gericht 2018 Sportwetten legalisierte, gibt es noch mehr Neider.“"
                            }
                        ],
