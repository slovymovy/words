                        "examples": [
                            {
                                "example_id": "070baaf0-6043-4ff7-8b8e-84fada8fc069",
                                "sense_id": "12f8a4e9-8730-32fd-b768-4b4407ddf0b0",
                                "text": "Il va devoir régler des problèmes familiaux et sentimentaux que connaissent les ados et se farcir La Tache, un méchant sans visage couvert de mini-multivers et résolu à se venger de lui."
                            },
                            {
                                "example_id": "2710d379-f139-4e9e-80a5-ea6f595a2912",
                                "sense_id": "12f8a4e9-8730-32fd-b768-4b4407ddf0b0",
                                "text": "En effet, ce n’est qu’à la toute dernière seconde de Split, porté par un James McAvoy aux multiples personnalités, que réapparaît un certain David Dunn (incarné par Bruce Willis dans Incassable), nous révélant ainsi une stupéfiante connexion entre les deux films, et par la même occasion l’élaboration d’un \"mini-multivers\"."
                            },
                            {
                                "example_id": "f9ae0c29-fec6-424e-9386-0c4318e865ec",
                                "sense_id": "12f8a4e9-8730-32fd-b768-4b4407ddf0b0",
                                "text": "Même si le dispositif narratif en boucle temporelle joue un rôle minimal, l’approche mini-multivers fonctionne parfaitement."
                            }
                        ]
                    }
