                        "examples": [
                            {
                                "example_id": "81f770e9-3480-4bf7-938a-573c992b5a00",
                                "sense_id": "1a585604-a1df-37a1-a4d3-8766f54a9b2a",
                                "text": "Het poliovirus is in heel Afrika bedwongen. Nigeria was het laatste land waar de belangrijkste variant, het wildtype, nog voorkwam. Nu ook in het noordoosten van dat land vier jaar geen nieuwe uitbraken zijn vastgesteld, kan het hele continent poliovrij worden verklaard. Vijfentwintig jaar geleden raakten jaarlijks nog 75.000 kinderen in Afrika besmet."
                            },
                            {
                                "example_id": "4fbea6a7-40a7-4bf0-abd3-2e67312d9ccd",
                                "sense_id": "1a585604-a1df-37a1-a4d3-8766f54a9b2a",
                                "text": "Over de hele wereld zijn er meer dan veertig incidenten bekend, maar die virussen zijn tot nog toe steeds minder fit gebleken. Ze zijn als het ware kreupel en kunnen het daarom niet overnemen van het wildtype virus.”"
                            }
                        ]
