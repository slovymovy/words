                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3eb29af6-fdf9-4d1b-a5b2-c2e7824fbe3e",
                                "sense_id": "bb5e6a46-bd10-375e-b5a6-b0e2e98b3f9d",
                                "text": "Руфина Онисимовна готова была побожиться, что Лара разыгрывает помешанную Маргариту в темнице."
                            },
                            {
                                "example_id": "8f493ef1-9ceb-40b5-a2f1-ecdda77dd9c7",
                                "sense_id": "bb5e6a46-bd10-375e-b5a6-b0e2e98b3f9d",
                                "text": "После этого нищий заставил его побожиться, что не обманет, и ударился, с ним по рукам."
                            }
                        ]
                    }
