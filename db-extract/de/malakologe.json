                "senses": [
                    {
                        "sense_id": "e9c05a83-19e5-351f-9c23-4c93085cb435",
                        "entry_id": "9423915a-6cf9-3b56-9269-c10423c4a10f",
                        "glosses": [
                            "Wissenschaftler, der sich mit Weichtieren oder Mollusken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92873c92-4e06-46cd-a9b2-9795d9348142",
                                "sense_id": "e9c05a83-19e5-351f-9c23-4c93085cb435",
                                "text": "„Er forschte vor allem über Weichtiere (Schnecken; Muscheln) und machte sich einen Namen als Malakologe.“"
                            },
                            {
                                "example_id": "b113eb84-13e8-4ed6-b893-a158a01992bb",
                                "sense_id": "e9c05a83-19e5-351f-9c23-4c93085cb435",
                                "text": "„Der Entdecker und Malakologe William Healy Dall wird in Boston, Massachusetts geboren.“"
                            },
                            {
                                "example_id": "f956ba12-26ab-4e77-8602-2bc86d97b8b9",
                                "sense_id": "e9c05a83-19e5-351f-9c23-4c93085cb435",
                                "text": "„Aber auch die Thierwelt hat ihre Vertreter, und nicht minder wie der Botaniker muss der Entomologe und Malakologe hier Arbeit finden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
