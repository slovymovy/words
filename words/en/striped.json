    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "926bdee3-2904-3628-ad10-2cf41cfc4728",
                    "sense_definition": "Having stripes, decorated or marked with bands differing in color.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "patterns",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The zebra is famous for its distinctive black and white <w>striped</w> coat.",
                            "target_lang_translations": {
                                "ru": "Зебра знаменита своей характерной черно-белой <w>полосатой</w> шкурой."
                            }
                        },
                        {
                            "text": "He decided to wear a <w>striped</w> shirt for the family photo today.",
                            "target_lang_translations": {
                                "ru": "Сегодня для семейного фото он решил надеть рубашку <w>в полоску</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "stripy"
                    ],
                    "antonyms": [
                        "plain",
                        "solid"
                    ],
                    "common_phrases": [
                        "striped shirt",
                        "striped pattern",
                        "black and white striped"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий полосы, украшенный или отмеченный линиями другого цвета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полосатый",
                                "target_lang_sense_clarification": "имеющий рисунок из полос"
                            },
                            {
                                "target_lang_word": "в полоску",
                                "target_lang_sense_clarification": "о ткани или одежде с узором из полос"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dc6deeb3-48c4-3033-81d7-b5071ad82385",
                    "sense_definition": "Past tense and past participle of <w>stripe</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers <w>striped</w> the newly paved road with bright yellow paint.",
                            "target_lang_translations": {
                                "ru": "Рабочие <w>нанесли полосы</w> ярко-желтой краской на недавно заасфальтированную дорогу."
                            }
                        },
                        {
                            "text": "The gardener carefully <w>striped</w> the lawn while mowing it yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера садовник аккуратно <w>разлиновал</w> газон во время стрижки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "striped the road",
                        "striped the field"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время глагола «наносить полосы» или «разлиновывать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наносил полосы",
                                "target_lang_sense_clarification": "делал полосатым"
                            },
                            {
                                "target_lang_word": "разлиновал",
                                "target_lang_sense_clarification": "проводил линии"
                            }
                        ]
                    }
