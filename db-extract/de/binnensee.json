                "senses": [
                    {
                        "sense_id": "679c22e2-39a4-3e10-bd2b-25716ed7edb8",
                        "entry_id": "a5dbe606-118e-3556-9658-07861f71dd97",
                        "glosses": [
                            "ein See ohne unmittelbaren Zugang zum Meer; ein See des Binnenlandes"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "18fc9852-ee3e-4bc3-bb5d-e8b8e1815ff7",
                                "sense_id": "679c22e2-39a4-3e10-bd2b-25716ed7edb8",
                                "text": "Der Binnensee Almere lag in dem Gebiet, in dem sich heute das IJsselmeer in den Niederlanden befindet."
                            },
                            {
                                "example_id": "b07cf6d4-8c97-4a44-8cf4-24536a1cc4d4",
                                "sense_id": "679c22e2-39a4-3e10-bd2b-25716ed7edb8",
                                "text": "Der Tschadsee ist ein abflussloser Binnensee in Westafrika."
                            },
                            {
                                "example_id": "d3201ffb-b606-4757-aa75-118d1c7f29bb",
                                "sense_id": "679c22e2-39a4-3e10-bd2b-25716ed7edb8",
                                "text": "Der Lake Wakatipu ist der drittgrößte Binnensee Neuseelands und nach dem Lake Te Anau der zweitgrößte auf der Südinsel."
                            },
                            {
                                "example_id": "ff092c7b-a6fb-4a87-9297-ae927612b5ea",
                                "sense_id": "679c22e2-39a4-3e10-bd2b-25716ed7edb8",
                                "text": "„In der Folge verfestigte sich zudem die Auffassung, dass das Ptolemäische Mondgebirge nicht mit dem Kilimandscharo identisch sei und dass an diesem Berg auch kein Fluss entspringe, der einen der großen afrikanischen Binnenseen speisen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
