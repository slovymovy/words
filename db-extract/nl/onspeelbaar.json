                        "glosses": [
                            "van een spel dat het te moeilijk of ongeschikt is om te spelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "057af98b-4124-4fb0-b939-473e2d3b16f9",
                                "sense_id": "b3e6e0be-18b1-3911-8e69-d777e5c0da93",
                                "text": "Al jaren waren er hardnekkige geruchten dat Atari in 1983 miljoenen exemplaren van het spelletje E.T. the Extra-Terrestrial dumpte op een vuilnisbelt in de plaats Almogordo. De computergame bleek onspeelbaar en werd daarom allesbehalve een verkoopsucces."
                            }
                        ]
