{
    "word_family": [
        "summary",
        "summarize",
        "summarization"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "20b9deeb-ac14-3cdb-a1e4-6bde8cacd84c",
                    "sense_definition": "In a prompt, direct manner without following formal procedures or delay.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers were <w>summarily</w> dismissed without any prior notice.",
                            "target_lang_translations": {
                                "tr": "İşçiler herhangi bir ön bildirim yapılmaksızın <w>derhal</w> işten çıkarıldı."
                            }
                        },
                        {
                            "text": "If you break the rules, you will be <w>summarily</w> dismissed from your post.",
                            "target_lang_translations": {
                                "tr": "Kuralları ihlal ederseniz, <w>sorgusuz sualsiz</w> görevinizden uzaklaştırılırsınız."
                            }
                        }
                    ],
                    "synonyms": [
                        "unceremoniously"
                    ],
                    "common_phrases": [
                        "summarily dismissed",
                        "summarily rejected",
                        "summarily executed"
                    ],
                    "target_lang_definitions": {
                        "tr": "Resmi prosedürlere uymadan, derhal ve doğrudan bir şekilde."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "derhal",
                                "target_lang_sense_clarification": "gecikmeksizin, hemen"
                            },
                            {
                                "target_lang_word": "kısaca ve usulsüzce",
                                "target_lang_sense_clarification": "resmi prosedür izlemeden"
                            },
                            {
                                "target_lang_word": "sorgusuz sualsiz",
                                "target_lang_sense_clarification": "yargılamadan veya dinlemeden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4203515b-a523-3e6f-82fe-8b1b1b89e051",
                    "sense_definition": "In a concise manner; briefly or in short form.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher <w>summarily</w> reviewed the main points of the chapter before the exam.",
                            "target_lang_translations": {
                                "tr": "Öğretmen sınavdan önce bölümün ana noktalarını <w>kısaca</w> gözden geçirdi."
                            }
                        },
                        {
                            "text": "The report covered the complex financial issue <w>summarily</w> in just two paragraphs.",
                            "target_lang_translations": {
                                "tr": "Rapor, karmaşık finansal konuyu sadece iki paragrafta <w>özetle</w> ele aldı."
                            }
                        }
                    ],
                    "synonyms": [
                        "fleetingly",
                        "temporarily",
                        "transiently",
                        "ephemerally"
                    ],
                    "common_phrases": [
                        "summarily reviewed",
                        "summarily described"
                    ],
                    "target_lang_definitions": {
                        "tr": "Özetle, kısa ve öz bir şekilde."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "özetle",
                                "target_lang_sense_clarification": "kısaca, özet halinde"
                            },
                            {
                                "target_lang_word": "kısaca",
                                "target_lang_sense_clarification": "özet biçiminde"
                            }
                        ]
                    }
                }
            ]
        }
    ]
