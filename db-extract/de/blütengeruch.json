                "senses": [
                    {
                        "sense_id": "fd5c3e1e-aa58-33bf-ab97-a9f0e106d652",
                        "entry_id": "ec293f63-1582-37ee-b3f9-d30a78ee4a32",
                        "glosses": [
                            "Geruch, der von Blüten ausgeht oder diesem ähnelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2bf9269-4d17-4cb3-911a-39e7f1e9ae9a",
                                "sense_id": "fd5c3e1e-aa58-33bf-ab97-a9f0e106d652",
                                "text": "„Weil Katzen von dem Blütengeruch der Pflanze magisch angezogen werden, wurde sie gelegentlich mit Hexenkünsten in Verbindung gebracht.“"
                            },
                            {
                                "example_id": "e0ad2f54-bc8b-4f0d-95df-0ffca057df43",
                                "sense_id": "fd5c3e1e-aa58-33bf-ab97-a9f0e106d652",
                                "text": "„Besonders die blaue Hyazinthe überzeugt mit ihrem Zusatz-Gimmick, nämlich einem intensiven, süßlichen Blütengeruch.“"
                            },
                            {
                                "example_id": "5e29f59d-2676-4705-a178-c42f20c449cd",
                                "sense_id": "fd5c3e1e-aa58-33bf-ab97-a9f0e106d652",
                                "text": "„Die Nase wird durchzogen von den Düften von Stachelbeeren und dem Blütengeruch der Honeysuckle-Pflanze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
