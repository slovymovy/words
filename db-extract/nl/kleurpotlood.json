                        "cross_references": [
                            {
                                "target_word": "crayon de couleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "60ea4e09-1917-3f84-b87a-5e81494831b0",
                                        "entry_id": "14f7d12f-7ab5-3999-a22a-96bdeb5ee9c3",
                                        "glosses": [
                                            "Crayon ayant une mine de couleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e336413-bc31-419a-be12-0a6a87097ea0",
                                                "sense_id": "60ea4e09-1917-3f84-b87a-5e81494831b0",
                                                "text": "Il reprit ses crayons de couleur et ses estompes abandonnés depuis dix-huit mois, depuis certains jours de vacances où il avait fait le portrait du capitaine Barbier, fier de son uniforme, le visage monté en couleurs, comme en grande tenue de santé."
                                            },
                                            {
                                                "example_id": "78211cec-b8e4-4ad9-9b9f-27a5f57fe7b5",
                                                "sense_id": "60ea4e09-1917-3f84-b87a-5e81494831b0",
                                                "text": "Nous disions crayon de papier, pour le distinguer du crayon d’ardoise ; mais en réalité le terme s’opposait dans nos esprits aux crayons de couleur, qui avaient l'avantage inestimable de s'écrire toujours au pluriel."
                                            },
                                            {
                                                "example_id": "2212bdd1-961f-4aa9-a12a-7dac403a57a3",
                                                "sense_id": "60ea4e09-1917-3f84-b87a-5e81494831b0",
                                                "text": "Par le terme « crayon », nous désignons tous les instruments graphiques : feutre, crayon de papier, crayon de couleur, pastel, pinceau, craie, etc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
