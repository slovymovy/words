                                        "glosses": [
                                            "met de tong naar achter gebogen zodat het in een verticale positie komt te staan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88a81df4-5497-4fc4-85bc-0e1eed335341",
                                                "sense_id": "f60638e2-9fb7-3d0f-bee0-6e6e7f9a7b84",
                                                "text": "De talen van India staan erom bekend dat zij veel retroflexe klanken bevatten."
