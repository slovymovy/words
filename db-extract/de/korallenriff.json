                "senses": [
                    {
                        "sense_id": "1679bde5-4442-3113-a77b-ce4dc5b362cf",
                        "entry_id": "711b482d-1b89-34e2-932f-8341007624cf",
                        "glosses": [
                            "aus abgestorbenen Korallen bestehendes und von Korallen besiedeltes Riff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19948355-8e28-4380-a72f-579725ebb7e4",
                                "sense_id": "1679bde5-4442-3113-a77b-ce4dc5b362cf",
                                "text": "„Saint Thomas und Saint John waren vulkanischen Ursprungs, mit Bergen und steiler Topografie, während die Insel Saint Croix etwas flacher und von Korallenriffen umgeben war.“"
                            },
                            {
                                "example_id": "81303929-dad6-4e32-9a91-95608597c6fd",
                                "sense_id": "1679bde5-4442-3113-a77b-ce4dc5b362cf",
                                "text": "„Wir segelten parallel zum Riff, dann sahen wir die roten und grünen Lichter, die die Durchfahrt durchs Korallenriff markierten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
