                "senses": [
                    {
                        "sense_id": "ea783a9d-dda8-31d1-b2ac-52ae09eb141c",
                        "entry_id": "589988f7-db7b-3fc1-88ab-5098820936cc",
                        "glosses": [
                            "Caleb the son of Jephunneh, an Israelite who entered Canaan with Joshua."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "807e19ad-9b84-400a-b39e-aa7a24d6629c",
                                "sense_id": "ea783a9d-dda8-31d1-b2ac-52ae09eb141c",
                                "text": "Doubtless ye shall not come into the land, concerning which I sware to make you dwell therein, save Caleb the son of Jephunneh, and Joshua the son of Nun."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8309eff-c60f-3096-a707-73797e6dcc10",
                        "entry_id": "589988f7-db7b-3fc1-88ab-5098820936cc",
                        "glosses": [
                            "A male given name from Hebrew first used by Puritans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac774f7f-621c-4b0b-9e5e-347c6b8c55f4",
                                "sense_id": "a8309eff-c60f-3096-a707-73797e6dcc10",
                                "text": "\"My brother's name was Caleb Peck.\"\n\"What a fine old-fashioned name,\" said Mrs. Tabor."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c32d167-6871-4ec9-94cf-4197e073eba1",
                        "source_entry_id": "589988f7-db7b-3fc1-88ab-5098820936cc",
