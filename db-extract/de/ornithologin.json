                "senses": [
                    {
                        "sense_id": "d70e77ba-354b-3db1-a809-0be47b635169",
                        "entry_id": "b239b742-b606-33a7-93ae-7eff0e6659ec",
                        "glosses": [
                            "weibliche Person, die sich mit der Ornithologie befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9cec2ee-3fb5-44d6-90ef-4a93bf4f83a2",
                                "sense_id": "d70e77ba-354b-3db1-a809-0be47b635169",
                                "text": "Ornithologinnen haben im brasilianischen Regenwald zwei neue Vogelarten entdeckt."
                            },
                            {
                                "example_id": "6499cb0e-f795-42d4-b049-de98dcb0660b",
                                "sense_id": "d70e77ba-354b-3db1-a809-0be47b635169",
                                "text": "Zum Handwerkszeug einer Ornithologin gehört unbedingt ein Fernglas."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ec69a32-1c8d-4dc9-bbd0-50b43fd2c688",
                        "source_entry_id": "b239b742-b606-33a7-93ae-7eff0e6659ec",
                        "source_sense_id": "d70e77ba-354b-3db1-a809-0be47b635169",
                        "source_sense_description": "weibliche Person, die sich mit der Ornithologie befasst",
                        "target_lang_word": "ornithologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ornithologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c24bc0c-d5fa-32b4-aabf-97ae84cae3c6",
                                        "entry_id": "7fe72f1e-3c82-3614-9d0c-a952505912c9",
                                        "glosses": [
                                            "A person who studies or practices ornithology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2744c2e-7891-4d75-adda-fd45c952f655",
                                                "sense_id": "8c24bc0c-d5fa-32b4-aabf-97ae84cae3c6",
                                                "text": "Mr. Worple in his spare time was what is known as an ornithologist. He had written a book called American Birds, and was writing another, to be called More American Birds."
                                            },
                                            {
                                                "example_id": "7840cd92-ee57-4029-b369-f2bd6c312168",
                                                "sense_id": "8c24bc0c-d5fa-32b4-aabf-97ae84cae3c6",
                                                "text": "Many of these classic methods are still used, with some modern improvements. For example, with the aid of special microphones and automated sound detection software, ornithologists recently reported […] that pine siskins (Spinus pinus) undergo an irregular, nomadic type of nocturnal migration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06947bff-51cd-4db5-bd98-f521ca996c63",
                        "source_entry_id": "b239b742-b606-33a7-93ae-7eff0e6659ec",
                        "source_sense_id": "d70e77ba-354b-3db1-a809-0be47b635169",
                        "source_sense_description": "weibliche Person, die sich mit der Ornithologie befasst",
                        "target_lang_word": "ornithologiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ornithologiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6632de05-8b7c-3bc2-a373-e95236eda8bb",
                                        "entry_id": "f36effa6-f74c-3e92-b170-517ac765e22f",
                                        "glosses": [
                                            "Celui, celle qui s’occupe d’ornithologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1607e97b-ddfb-41a0-950c-ea3f0d0a2548",
                                                "sense_id": "6632de05-8b7c-3bc2-a373-e95236eda8bb",
                                                "text": "L’ornithologiste en conclut qu’elle avait pondu et qu’elle commençait à couver."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "677cb310-7182-41ff-b389-7dfb8a8b57f6",
                        "source_entry_id": "b239b742-b606-33a7-93ae-7eff0e6659ec",
                        "source_sense_id": "d70e77ba-354b-3db1-a809-0be47b635169",
                        "source_sense_description": "weibliche Person, die sich mit der Ornithologie befasst",
                        "target_lang_word": "ornithologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ornithologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6416f18a-d51a-321c-9736-c5fdd2efbf3d",
                                        "entry_id": "8dec15ce-ac99-39cb-9c9b-39c268a3e98a",
                                        "glosses": [
                                            "Celui, celle qui s’occupe d’ornithologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "218b08eb-c1c2-4a88-a3e3-de48959a2a06",
                                                "sense_id": "6416f18a-d51a-321c-9736-c5fdd2efbf3d",
                                                "text": "En Nouvelle-Zélande, le vote pour l’Oiseau de l'année, toujours controversé, a commencé avec la colère d’ornithologues amateurs, furieux de voir le kakapo exclu."
                                            },
                                            {
                                                "example_id": "c2382fc3-d27f-45dd-b848-52de2f7cd431",
                                                "sense_id": "6416f18a-d51a-321c-9736-c5fdd2efbf3d",
                                                "text": "Certaines espèces s’en sortent mieux que d’autres, note l’ornithologue Alexandre Millon, maître de conférences à Aix-Marseille université."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d56c4e7-53e3-459f-9664-6ad5f855373b",
                        "source_entry_id": "b239b742-b606-33a7-93ae-7eff0e6659ec",
