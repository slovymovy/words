                                    {
                                        "sense_id": "e76d8edf-4729-3cf5-a227-d3c5f5edaa9a",
                                        "entry_id": "bc2973c5-2464-3476-a406-f6fa53397ce3",
                                        "glosses": [
                                            "Under an obligation to do something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e0922c7-ba96-4a57-9537-c4ecadde8a00",
                                                "sense_id": "e76d8edf-4729-3cf5-a227-d3c5f5edaa9a",
                                                "text": "All employees are obliged to complete a tax return every year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caa58287-a205-3bd5-9a7d-78634972dc88",
                                        "entry_id": "bc2973c5-2464-3476-a406-f6fa53397ce3",
                                        "glosses": [
                                            "Grateful or indebted because of a favor done."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e14dba5-f5b3-4747-8280-70d652faf460",
                                                "sense_id": "caa58287-a205-3bd5-9a7d-78634972dc88",
                                                "text": "I'm greatly obliged for your help with this problem."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "obliged",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a764243b-a8be-32c2-9d29-9da7a5c26e38",
                                        "entry_id": "e98ef9de-120d-3749-aea0-9ed45b14df60",
