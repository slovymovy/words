                "senses": [
                    {
                        "sense_id": "22c866bf-2260-3688-9373-16f33fd5ff7e",
                        "entry_id": "6328b946-607c-3fb0-b95a-fe396c1ac8f5",
                        "glosses": [
                            "nicht-selbständiges Arbeitsverhältnis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0c95e49-1168-4ede-9302-27443d07f82e",
                                "sense_id": "22c866bf-2260-3688-9373-16f33fd5ff7e",
                                "text": "„Unter einem »Beschäftigungsverhältnis« ist grundsätzlich das dienstliche »Verhältnis persönlicher und wirtschaftlicher Abhängigkeit« des »Dienstnehmers« im Sinne des § 4 Abs 2 ASVG zu dem »Dienstgeber« im Sinne des § 35 Abs 1 erster Satz ASVG zu verstehen (…).“"
                            },
                            {
                                "example_id": "197b6998-f1b3-44fd-aa53-c00c21da1df2",
                                "sense_id": "22c866bf-2260-3688-9373-16f33fd5ff7e",
                                "text": "„Mit der Bewerbung muss eine Freigabeerklärung des bisherigen Arbeitgebers vorgelegt werden oder ein Nachweis, dass das Beschäftigungsverhältnis durch ordentliche Kündigung oder im gegenseitigen Einvernehmen, z. B. durch Auflösungsvertrag, rechtzeitig beendet werden kann.“"
                            },
                            {
                                "example_id": "86cd19e4-d502-4aa9-b0a2-f07b894665e2",
                                "sense_id": "22c866bf-2260-3688-9373-16f33fd5ff7e",
                                "text": "„Tarifbeschäftigte Lehrer können die Berechtigung zum Führen der Berufsbezeichnung ‚Studienrat im Beschäftigungsverhältnis‘ (StR i. BV) erhalten, allerdings nur dann, wenn sie einen unbefristeten Vertrag besitzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
