                "senses": [
                    {
                        "sense_id": "2af15c3d-ebeb-37eb-824c-8519d26705dd",
                        "entry_id": "1fac0dfc-7e7e-38f4-bdf8-4d31fe33479e",
                        "glosses": [
                            "Zirkus, der mit einem Zelt von Ort zu Ort zieht und Vorstellungen gibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c244de7-e5c5-4f10-9374-6444e25e076d",
                                "sense_id": "2af15c3d-ebeb-37eb-824c-8519d26705dd",
                                "text": "„Die meisten Leute schienen zu vermuten, dass das Gefährt zu einem Wanderzirkus gehörte.“"
                            },
                            {
                                "example_id": "bf84bed9-fb36-49af-b356-a5b128768628",
                                "sense_id": "2af15c3d-ebeb-37eb-824c-8519d26705dd",
                                "text": "„Das große Heer des Kaisers wurde von einem Wanderzirkus begleitet.“"
                            },
                            {
                                "example_id": "dfa40907-91d8-44a1-83e9-b0235772af6b",
                                "sense_id": "2af15c3d-ebeb-37eb-824c-8519d26705dd",
                                "text": "„Im Wanderzirkus tritt auch ein Messerwerfer auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "acb59256-05ce-3a18-81ac-b5af35d8e601",
                        "entry_id": "1fac0dfc-7e7e-38f4-bdf8-4d31fe33479e",
                        "glosses": [
                            "z. B. Reihe von sportlichen, politischen oder kulturellen Großveranstaltungen wie beispielsweise Motorrennen, die weltweit nacheinander an verschiedenen Orten ausgeführt werden"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "e23b5c15-b419-4c76-8e6f-7243d378962a",
                                "sense_id": "acb59256-05ce-3a18-81ac-b5af35d8e601",
                                "text": "„Schon 19 Rennen im Vorjahr waren fordernd, \"und es stellt sich auch die Frage, ob diese neue Anzahl nicht eine Überreizung ist,\" sagte Mercedes-Motorsportchef Toto Wolff dem SID. Anders als 2015 macht der Wanderzirkus auch wieder in Deutschland Station, am 31. Juli steigt das Rennen in Hockenheim. Neu ist der umstrittene Große Preis von Europa in Baku ( 19. Juni ) - Formel-1-Chef Bernie Ecclestone beweist mal wieder, dass die Menschenrechtslage in den Gastgeberländern eher nicht das erste Kriterium für den Zuschlag ist.“"
                            },
                            {
                                "example_id": "40c86500-1c75-4c58-b9a2-6c59a42ad757",
                                "sense_id": "acb59256-05ce-3a18-81ac-b5af35d8e601",
                                "text": "„Die meisten der 732 Volksvertreter würden den Wanderzirkus allerdings lieber heute als morgen einstellen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
