                "senses": [
                    {
                        "sense_id": "4fa16ab6-6003-30c9-9c76-f90097b0b22c",
                        "entry_id": "d27c6190-d34f-33e1-bac6-82fbca3cba07",
                        "glosses": [
                            "von mehreren der wichtigste Sitz einer Firma, Behörde, Institution"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58ffcd81-6b34-424f-98a0-b0eb199510eb",
                                "sense_id": "4fa16ab6-6003-30c9-9c76-f90097b0b22c",
                                "text": "Am Hauptsitz der EZB wird über den Leitzins beraten."
                            },
                            {
                                "example_id": "3f7b2c02-775d-4667-afba-c9bd44aecf51",
                                "sense_id": "4fa16ab6-6003-30c9-9c76-f90097b0b22c",
                                "text": "„Die Behörde mit Hauptsitz in Wiesbaden und rund 2400 Mitarbeiterinnen und Mitarbeitern ist dem Bundesinnenministerium unterstellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4413398-2499-4768-9c1a-e854e995c270",
                        "source_entry_id": "d27c6190-d34f-33e1-bac6-82fbca3cba07",
                        "source_sense_id": "4fa16ab6-6003-30c9-9c76-f90097b0b22c",
                        "source_sense_description": "von mehreren der wichtigste Sitz einer Firma, Behörde, Institution",
                        "target_lang_word": "headquarter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "headquarter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e1d16c9-4db9-3092-8650-dc0eb22695cc",
                                        "entry_id": "26f477ba-9baf-31e7-85f8-7935ac26b649",
                                        "glosses": [
                                            "To provide (an organization) with headquarters."
                                        ],
                                        "tags": [
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b2e5de4-7bc9-3dcc-9e67-6f9fd4250b16",
                                        "entry_id": "26f477ba-9baf-31e7-85f8-7935ac26b649",
                                        "glosses": [
                                            "To establish headquarters."
                                        ],
                                        "tags": [
                                            "US",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28e0cb73-9af7-4721-8744-41370e6e0041",
                                                "sense_id": "5b2e5de4-7bc9-3dcc-9e67-6f9fd4250b16",
                                                "text": "As the AANHPI population of the United States continued to grow and diversify following the elimination of most race-based restrictions on immigration, the Organization of Chinese Americans also changed to reflect that growing diversity. In 2013, it renamed itself “OCA-Asian Pacific American Advocates” to reflect its work on behalf of all AANHPIs. OCA is headquartered in Washington, D.C."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8d2d3b7-236d-45bb-8263-dcc4a2e6ad20",
                        "source_entry_id": "d27c6190-d34f-33e1-bac6-82fbca3cba07",
                        "source_sense_id": "4fa16ab6-6003-30c9-9c76-f90097b0b22c",
                        "source_sense_description": "von mehreren der wichtigste Sitz einer Firma, Behörde, Institution",
                        "target_lang_word": "quartier général",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quartier général",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e149d5e-b807-3d4b-b82e-0d7442a9239c",
                                        "entry_id": "706b3b2c-5d3a-3a6b-bbb2-3fcd565e7b8f",
                                        "glosses": [
                                            "Lieu où sont installés un général et son état-major."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25ddf0f4-a19a-43a2-bdd4-a8da2f3e771c",
                                                "sense_id": "6e149d5e-b807-3d4b-b82e-0d7442a9239c",
                                                "text": "L'artillerie et le génie à gauche du chemin d’Acy-Romance au pont du canal, le front de bandière est tourné vers le canal. Le quartier impérial, le grand quartier général et le quartier général du 12ᵉ corps sont à Rethel."
                                            },
                                            {
                                                "example_id": "1fd8428d-7aa5-4958-9238-c0ebc290300d",
                                                "sense_id": "6e149d5e-b807-3d4b-b82e-0d7442a9239c",
                                                "text": "Après la prise de Dinant en mai 1940, Rommel pénétrait en France via Philippeville et Chimay, tandis que Hitler établissait son quartier général à proximité, à Brûly-de-Pesche exactement, entre le 6 et le 28 juin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69692bf3-d5b7-30ca-b794-459e94a8763a",
                                        "entry_id": "706b3b2c-5d3a-3a6b-bbb2-3fcd565e7b8f",
                                        "glosses": [
                                            "Lieu de rencontre habituel d'un groupe de personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "689984cc-65c0-4a39-82d4-5712f01c56e1",
                                                "sense_id": "69692bf3-d5b7-30ca-b794-459e94a8763a",
                                                "text": "Les deux Administrations lancent donc un S.O.S. à l'équipe des hommes-grenouilles de la « Sogetram ». Cette étonnante coopérative ouvrière d'une soixantaine d'hommes-grenouilles, créée en 1952 par des « mordus » de la spéléologie a son quartier général sur un vieux ponton, ancré au pied des piles du pont de Bercy."
                                            },
                                            {
                                                "example_id": "d2665d3d-3ff5-485e-abbb-558a115304d9",
                                                "sense_id": "69692bf3-d5b7-30ca-b794-459e94a8763a",
                                                "text": "Des adolescents parmi des mobylettes, devant le bistrot de la placette, c'est leur quartier général, bien connu de la police qui pour l'instant contrôle les papiers. Sans raison, routine. Ça rassure la population […]."
                                            },
                                            {
                                                "example_id": "73570263-a1fe-4c3b-b054-f86a5e0d3eb7",
                                                "sense_id": "69692bf3-d5b7-30ca-b794-459e94a8763a",
                                                "text": "Lorsque nous eûmes changé nos costumes souillés et ruisselants, nous établîmes notre quartier général dans la cuisine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
