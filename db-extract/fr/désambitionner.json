                "senses": [
                    {
                        "sense_id": "936badb5-6b65-397d-9082-4775d308fd5e",
                        "entry_id": "80de6fc5-3ab9-33ab-8e3c-0147f023ff11",
                        "glosses": [
                            "Ne plus ambitionner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "471252cd-b25e-425b-9cb8-eec7538e443d",
                                "sense_id": "936badb5-6b65-397d-9082-4775d308fd5e",
                                "text": "Désambitionner, c'est vous apprendre à faire bien, à approfondir votre sujet et à développer vos compétences."
                            },
                            {
                                "example_id": "0d638870-15e4-4ee9-8a33-41779b77ff5d",
                                "sense_id": "936badb5-6b65-397d-9082-4775d308fd5e",
                                "text": "Choisir de désambitionner est un choix nettement plus fort que d'être ambitieux."
                            },
                            {
                                "example_id": "287b6f8e-8e5e-4ea4-8b4f-c962ba0fbe75",
                                "sense_id": "936badb5-6b65-397d-9082-4775d308fd5e",
                                "text": "J'aurais tendance à plaindre ma propre situation mais pour connaitre une fille qui est désambitionnée de la vie, je crois que c'est assez déprimant."
                            }
                        ]
                    }
