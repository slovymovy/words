                "translations": [
                    {
                        "translation_id": "b23644e5-6d15-4b9f-863e-c9db81f3857c",
                        "source_entry_id": "6f5f3dde-5b18-37e7-9652-0bb326915e5c",
                        "source_sense_id": "e70850fd-e1b3-3bf9-bac9-b74bf8aef669",
                        "target_lang_word": "vulcanise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vulcanise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f728ef0-28e5-3dce-a19b-57921d86c6dd",
