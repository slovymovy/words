                        "sense_id": "701bb0a0-12cc-3724-9761-b4a79a8e1052",
                        "entry_id": "f42aaf0c-db82-38ca-8c98-abaf3312e293",
                        "glosses": [
                            "aus Fischen (und/oder Meeresfrüchten) gekochte Suppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cdffa16-c0ea-41a8-a89a-178fe3abcae3",
                                "sense_id": "701bb0a0-12cc-3724-9761-b4a79a8e1052",
                                "text": "Die Fischsuppe sollte mit viel Fisch gekocht werden."
                            },
                            {
                                "example_id": "e6b5e52d-523b-4d6c-8cd7-c4da6d2240e3",
                                "sense_id": "701bb0a0-12cc-3724-9761-b4a79a8e1052",
                                "text": "„Die toten Fische glitzerten, die gefesselten Hummer bewegten sich frierend auf ihren Eisbetten, die Kellner balancierten Terrinen mit Fischsuppe über ihren Köpfen, das Lokal war voll, aber Hirsch war nicht da.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
