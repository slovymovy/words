                        "examples": [
                            {
                                "example_id": "f15c782c-2624-4480-9f9a-d34f2e27a001",
                                "sense_id": "e906ec25-e4e4-349d-bb4b-491711c12b53",
                                "text": "Венгр скоро сдался, и Лужин сел играть с компатриотом."
                            }
                        ]
