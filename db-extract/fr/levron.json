                        "sense_id": "50b6a98f-1633-3b5e-977c-d6a0b9742176",
                        "entry_id": "6096e1af-9d46-33c1-8fb9-f725612c45ab",
                        "glosses": [
                            "Lévrier de fort petite taille."
                        ],
                        "tags": [
                            "Cynologie"
                        ],
                        "examples": [
                            {
                                "example_id": "88a78b7a-0bd5-4cbe-8d45-01279f8b0e04",
                                "sense_id": "50b6a98f-1633-3b5e-977c-d6a0b9742176",
                                "text": "Le petit lévrier italien ou levron d’Italie est le plus petit des lévriers."
                            },
                            {
                                "example_id": "d6849289-99f0-442d-a479-ff59a11adea0",
                                "sense_id": "50b6a98f-1633-3b5e-977c-d6a0b9742176",
                                "text": "Le mâtin, transporté au Nord, est devenu grand danois, et transporté au Midi, est devenu lévrier : les grands lévriers viennent du Levant, ceux de taille médiocre, d’Italie ; et ces lévriers d’Italie, transportés en Angleterre, sont devenus levrons, c'est-à-dire, lévriers encore plus petits."
                            }
                        ]
                    },
