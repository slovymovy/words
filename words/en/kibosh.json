    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aa1e4c2d-20e1-3b7a-a927-0411426f1071",
                    "sense_definition": "Something that stops, restrains, or brings an end to an activity or plan, especially in the phrase \"put the kibosh on\".",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stop_end",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rainstorm put the <w>kibosh</w> on our plans for a weekend camping trip.",
                            "target_lang_translations": {
                                "cs": "Silná bouřka <w>udělala škrt přes rozpočet</w> našim plánům na víkendové kempování."
                            }
                        },
                        {
                            "text": "Unexpected budget cuts finally put the <w>kibosh</w> on the development of the new stadium.",
                            "target_lang_translations": {
                                "cs": "Nečekané škrty v rozpočtu nakonec <w>zatnuly tipec</w> výstavbě nového stadionu."
                            }
                        }
                    ],
                    "synonyms": [
                        "halt",
                        "check"
                    ],
                    "common_phrases": [
                        "put the kibosh on"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "commonly used in idioms"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Něco, co zastaví, zmaří nebo ukončí nějakou činnost či plán; používá se zejména ve spojení „put the kibosh on“ (udělat přítrž, zatnout tipec)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "přítrž",
                                "target_lang_sense_clarification": "ve vazbě učinit přítrž"
                            },
                            {
                                "target_lang_word": "tipec",
                                "target_lang_sense_clarification": "ve vazbě zatnout tipec"
                            },
                            {
                                "target_lang_word": "stopka",
                                "target_lang_sense_clarification": "definitivní konec, zastavení"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b92cd71-abd2-3a38-9772-6720b9186f0e",
                    "sense_definition": "Nonsense; foolish or absurd talk or ideas.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not listen to his theories, as the whole thing is just utter <w>kibosh</w>.",
                            "target_lang_translations": {
                                "cs": "Neposlouchej jeho teorie, celá ta věc je jen naprostý <w>nesmysl</w>."
                            }
                        },
                        {
                            "text": "She was tired of hearing all that <w>kibosh</w> about traditional etiquette.",
                            "target_lang_translations": {
                                "cs": "Měla už po krk poslouchání všech těch <w>žvástů</w> o tradiční etiketě."
                            }
                        }
                    ],
                    "synonyms": [
                        "bosh",
                        "nonsense"
                    ],
                    "antonyms": [
                        "sense"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "archaic or dated slang"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "infrequently encountered in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Nesmysl, hloupost nebo absurdní řeči."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nesmysl",
                                "target_lang_sense_clarification": "blbost, hloupost"
                            },
                            {
                                "target_lang_word": "báchorka",
                                "target_lang_sense_clarification": "vymyšlené řeči"
                            },
                            {
                                "target_lang_word": "kravina",
                                "target_lang_sense_clarification": "hovorově"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "209372f0-5b96-3461-9990-fece7de36347",
                    "sense_definition": "The height of fashion, style, or high-class society.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dressed in an elegant velvet coat, she truly looked like the proper <w>kibosh</w>.",
                            "target_lang_translations": {
                                "cs": "Oblečená v elegantním sametovém kabátě vypadala jako skutečný <w>vrchol módy</w>."
                            }
                        },
                        {
                            "text": "The grand socialites believed their lavish ballroom party was the very peak of the <w>kibosh</w>.",
                            "target_lang_translations": {
                                "cs": "Významní příslušníci smetánky věřili, že jejich velkolepý ples je samotným vrcholem <w>společenského šiku</w>."
