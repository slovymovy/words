        "nl-extract.jsonl": [
            {
                "entry_id": "e1fb791e-608a-3daa-bc56-47c694df9c5f",
                "word": "noorderlicht",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "719a17dc-eb8c-3a67-b652-e33c80eef2d2",
                        "entry_id": "e1fb791e-608a-3daa-bc56-47c694df9c5f",
                        "glosses": [
                            "een lichtverschijnsel in de atmosfeer in het noordpoolgebied veroorzaakt door het binnendringen van kosmische straling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "486363e2-9079-4280-8c87-3dd42a5c5d59",
                                "sense_id": "719a17dc-eb8c-3a67-b652-e33c80eef2d2",
                                "text": "Het noorderlicht is regelmatig in Canada of Scandinavië te bewonderen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "beb2ec37-ff0c-4f77-a7e7-854378ca2297",
                        "source_entry_id": "e1fb791e-608a-3daa-bc56-47c694df9c5f",
                        "source_sense_id": "719a17dc-eb8c-3a67-b652-e33c80eef2d2",
                        "target_lang_word": "Nordlicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nordlicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "21c75fef-fa29-3d72-ad0d-7026a74c1182",
                                        "entry_id": "a6451e60-ea5b-32de-adf0-362f9644e4e0",
                                        "glosses": [
                                            "Polarlicht des nördlichen Polarkreises"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2f4fd1f-7248-4458-b5a1-6dbd020133a3",
                                                "sense_id": "21c75fef-fa29-3d72-ad0d-7026a74c1182",
                                                "text": "Das Nordlicht entsteht wesentlich über der nördlichen Polkappe durch Fluoreszierung der Erdmagnetfelder."
                                            },
                                            {
                                                "example_id": "2a888bb8-c09e-42f8-8fd1-8f849beacff7",
                                                "sense_id": "21c75fef-fa29-3d72-ad0d-7026a74c1182",
                                                "text": "„Und im Winter sieht man hier Nordlichter.“"
                                            },
                                            {
                                                "example_id": "095a17f9-3819-4e50-baeb-0a9f4ce5cef5",
                                                "sense_id": "21c75fef-fa29-3d72-ad0d-7026a74c1182",
                                                "text": "„Es ist das Feuer des Nordlichts in der Weite des Eismeeres.“"
                                            },
                                            {
                                                "example_id": "0affe5a3-5b49-4a6d-b264-860239584ab7",
                                                "sense_id": "21c75fef-fa29-3d72-ad0d-7026a74c1182",
                                                "text": "„Bis auf die heißen Quellen ist die Wunscherfüllung nicht immer möglich: Wale und Nordlichter sind ein saisonales Geschäft.“"
                                            },
                                            {
                                                "example_id": "a6262280-9ba9-4ddc-9b87-72212da97be4",
                                                "sense_id": "21c75fef-fa29-3d72-ad0d-7026a74c1182",
                                                "text": "„Nordlichter sind in dieser Gegend nicht selten, zu bestimmten Jahrszeiten alltäglich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9718d466-f509-35a1-8438-c550dace591b",
                                        "entry_id": "a6451e60-ea5b-32de-adf0-362f9644e4e0",
                                        "glosses": [
                                            "für Bewohner Norddeutschlands"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea59a811-2210-47da-a4c4-33f6b3b681c4",
                                                "sense_id": "9718d466-f509-35a1-8438-c550dace591b",
                                                "text": "Da mein Freund aus Flensburg stammt, nennt man ihn bisweilen Nordlicht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "843af41a-b38c-434e-88db-023acbce12ca",
                        "source_entry_id": "e1fb791e-608a-3daa-bc56-47c694df9c5f",
                        "source_sense_id": "719a17dc-eb8c-3a67-b652-e33c80eef2d2",
                        "target_lang_word": "Northern lights",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b6d072bb-8798-4b66-84d0-a406e6fdfe6a",
                        "source_entry_id": "e1fb791e-608a-3daa-bc56-47c694df9c5f",
                        "source_sense_id": "719a17dc-eb8c-3a67-b652-e33c80eef2d2",
                        "target_lang_word": "aurora borealis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aurora borealis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03a72c7d-8f2d-3f6b-a928-eb512e3f8b65",
                                        "entry_id": "de73496f-afc7-37c3-a58a-fb0020c87e4b",
                                        "glosses": [
                                            "The aurora of the northern hemisphere."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abf1ba9c-bbaf-4a51-93fd-47d5ed1b8b4e",
                                                "sense_id": "03a72c7d-8f2d-3f6b-a928-eb512e3f8b65",
                                                "text": "A common and beautiful side-effect of high solar activity is the Aurora Borealis - the northern lights that dance across Arctic skies."
                                            },
                                            {
                                                "example_id": "b20cf4fd-8063-44f4-a8eb-e5fa637be604",
                                                "sense_id": "03a72c7d-8f2d-3f6b-a928-eb512e3f8b65",
                                                "text": "Superintendent Chalmers: Yes, I should be—Good Lord what is happening in there!?\nPrincipal Skinner: Aurora borealis.\nSuperintendent Chalmers: Uh—Aurora borealis, at this time of year, at this time of day, in this part of the country, localised entirely within your kitchen?\nPrincipal Skinner: Yes.\nSuperintendent Chalmers: May I see it?\nPrincipal Skinner: No."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5222c190-4351-4393-8bc1-5de95902f9c3",
                        "source_entry_id": "e1fb791e-608a-3daa-bc56-47c694df9c5f",
                        "source_sense_id": "719a17dc-eb8c-3a67-b652-e33c80eef2d2",
                        "target_lang_word": "aurore boréale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aurore boréale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "364f0b1a-53ec-3940-99f8-b4407ea3a0f5",
                                        "entry_id": "65988ac4-ba75-327d-ad46-4c896a66cc50",
                                        "glosses": [
                                            "Phénomène lumineux qui paraît quelquefois la nuit dans le ciel dans l’hémisphère nord."
                                        ],
                                        "tags": [
                                            "Géophysique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c10db8a1-cd83-4908-ad6e-ec581e87d711",
                                                "sense_id": "364f0b1a-53ec-3940-99f8-b4407ea3a0f5",
                                                "text": "On voit là des soleils de minuit, des aurores boréales accompagnées d’étranges phénomènes météorologiques, des parhélies, images multiples du soleil ; la lune à son tour s’y montre avec son cortège de parasélènes."
                                            },
                                            {
                                                "example_id": "2c6d1e89-7f04-43e6-809a-25a3aa78a9ae",
                                                "sense_id": "364f0b1a-53ec-3940-99f8-b4407ea3a0f5",
                                                "text": "À trente degrés du pôle, il n’est véritablement plus à sa place ! Le ciel de cette contrée, c’est le ciel pur et froid de l’hiver, ciel tout constellé, qu’enflamme parfois l’éclat d’une aurore boréale. C’est ici le pays de la nuit, non celui du jour […]"
                                            },
                                            {
                                                "example_id": "522ca26c-e026-424f-ade6-9096d4c3a7e3",
                                                "sense_id": "364f0b1a-53ec-3940-99f8-b4407ea3a0f5",
                                                "text": "Les aurores boréales ou polaires s'observent quant à elles lorsque les particules du vent solaire qui se déplacent rapidement entrent en collision avec des gaz à basse pression dans la haute atmosphère terrestre, selon Environnement Canada."
                                            },
                                            {
                                                "example_id": "dbd9bb46-64ea-4058-a0ef-8a449e6c9c7a",
                                                "sense_id": "364f0b1a-53ec-3940-99f8-b4407ea3a0f5",
                                                "text": "Et le soleil disparu jette, par reflet, une dernière lumière sur cette immensité désolée ; il y a dans les gorges des teintes vaporeuses d’un gris crépusculaire, et, sur les crêtes, des teintes rosées, comme des lueurs d’aurore boréale…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
