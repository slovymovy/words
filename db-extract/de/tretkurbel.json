                        "glosses": [
                            "mit dem Fuß zu betätigende Kurbel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eab87d71-3972-4fa9-8860-28c635d745e0",
                                "sense_id": "a9e82350-61cc-368a-a1d5-ee264e60b1f3",
                                "text": "Ein Schweinfurfer Mechaniker namens Fischer soll der erste gewesen sein, der Tretkurbeln zum Betrieb von Schleifsteinen und anderen Werkmaschinen sowie auch von Krankenstühlen und kleinen Wagen herstellte und verwandte."
                            },
                            {
                                "example_id": "19f84327-1229-4167-b5f7-b8f86b21ccec",
                                "sense_id": "a9e82350-61cc-368a-a1d5-ee264e60b1f3",
                                "text": "Der Sitz des Fahrrads war weit nach hinten verlegt, um eine möglichst unmittelbare Wirkung der Beine auf die Tretkurbel zu ermöglichen."
                            },
                            {
                                "example_id": "4585f5c1-4ff0-40f3-b051-47cd5bf94113",
                                "sense_id": "a9e82350-61cc-368a-a1d5-ee264e60b1f3",
                                "text": "„Die Spinnräder wurden mit einer Tretkurbel angetrieben, und das Garn war nicht gefärbt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
