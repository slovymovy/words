                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36a92369-20dc-4a31-875e-ecef2cde35c0",
                        "source_entry_id": "857c2258-7f85-38fe-a9e3-281acf2f215e",
                        "source_sense_id": "b17917d3-7cb1-39c4-98a4-47a5fd71c53f",
                        "target_lang_word": "teosofia",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teosofia",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "7f7f460f-f8d3-367d-9296-2c21065a2bfb",
                                        "entry_id": "90fc9a20-d525-3a9f-be96-b5da28f00bd0",
                                        "glosses": [
                                            "definizione mancante; se vuoi, aggiungila tu"
                                        ],
                                        "tags": [],
