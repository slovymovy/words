        "nl-extract.jsonl": [
            {
                "entry_id": "722ce7ec-5e62-3062-9d19-216002d9f67a",
                "word": "hinten",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "665339dc-16b0-344d-8039-4c82c3bf7bd0",
                        "entry_id": "722ce7ec-5e62-3062-9d19-216002d9f67a",
                        "glosses": [
                            "het geven van een aanwijzing of wenk; geven van een hint"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3634d63e-fd93-4583-9495-1cc135369bd4",
                                "sense_id": "665339dc-16b0-344d-8039-4c82c3bf7bd0",
                                "text": "Daarmee lijkt de voormalige VVD-fractieleider er na de ochtendsessie van de formatieonderhandelingen op te hinten dat een nieuw kabinet ook extra geld wil uittrekken voor lerarensalarissen. ,,Wij weten wat ook wat er hier aan tafel gebeurt. We gaan geen nucleaire explosie veroorzaken omdat iets wat toch al geregeld is nog een keer bevestigd moet worden in een demissionair kabinet.”"
                            },
                            {
                                "example_id": "41ee4999-60f3-4470-b592-f5a6bc6ca299",
                                "sense_id": "665339dc-16b0-344d-8039-4c82c3bf7bd0",
                                "text": "Schenk er vervolgens nog 200 ml warme melk (65 tot 80 graden voor lekkerste resultaat) bij. Eventueel garneren met slagroom. Geniet van deze volle chocolademelk met hinten van caramel en zoet fruit."
                            },
                            {
                                "example_id": "4b973247-3f72-425a-bb2b-2c6804c29b89",
                                "sense_id": "665339dc-16b0-344d-8039-4c82c3bf7bd0",
                                "text": "Zou er snel een einde komen aan de onduidelijkheid over het stoeltje van Lewis Hamilton bij Mercedes volgend jaar? Daar lijkt de renstal wel op te hinten met een foto van een overeenkomst waarop alleen nog naam en handtekening ontbreekt. Mercedes zou Hamilton de best verdienende F1-coureur uit de geschiedenis willen maken."
                            }
                        ]
                    }
