                "senses": [
                    {
                        "sense_id": "0392888e-9731-310b-b173-df05b6130f4d",
                        "entry_id": "c432286f-0759-30d5-b2e5-27d42b3820a5",
                        "glosses": [
                            "мед. больной, заражённый тифом"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1e71557a-03b5-33aa-8d02-fac367291a77",
                        "entry_id": "c432286f-0759-30d5-b2e5-27d42b3820a5",
                        "glosses": [
                            "субстантивир. больной тифом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42b4a955-c94c-49a7-b616-74cf2f8a34f1",
                                "sense_id": "1e71557a-03b5-33aa-8d02-fac367291a77",
                                "text": "Тифозный в углу вдруг глухо вскрикнул и сел на постели."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7702231-4228-3e43-a822-b764478ee95c",
                        "entry_id": "c432286f-0759-30d5-b2e5-27d42b3820a5",
                        "glosses": [
                            "вызывающий тифом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21ff0228-96f0-416b-8ffc-f82787593135",
                                "sense_id": "c7702231-4228-3e43-a822-b764478ee95c",
                                "text": "Но в коридоре был удручающий тифозный воздух, пропитанный запахом испражнений, дёгтя и гнили, который тотчас же приводил в уныние и грусть всякого вновь приходившего человека."
                            },
                            {
                                "example_id": "dff23586-cc0a-429d-be14-2e9899932e02",
                                "sense_id": "c7702231-4228-3e43-a822-b764478ee95c",
                                "text": "Именно вследствие подобного переполнения и феноменальной грязи возникла в Киевской тюрьме знаменитая тифозная эпидемия."
                            }
                        ]
                    }
                ],
