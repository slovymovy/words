                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5374d44-08bb-4677-857f-343e1b202503",
                                "sense_id": "b62fc52f-0a41-374e-afb2-215416c0aa20",
                                "text": "„Es war ein bitterkalter Dezembertag.“"
                            },
                            {
                                "example_id": "071218a6-f87d-43be-9c51-e56b19749252",
                                "sense_id": "b62fc52f-0a41-374e-afb2-215416c0aa20",
                                "text": "„Als er an einem Dezembertag 1770 in Bonn das Licht der Welt erblickte, einer \"reinlich gebauten\" Provinzstadt, deutete wenig auf die Geburt eines Titanen hin.“"
                            },
                            {
                                "example_id": "0696cc67-722d-4718-af10-33d374ebcd5f",
                                "sense_id": "b62fc52f-0a41-374e-afb2-215416c0aa20",
                                "text": "Milena kam an einem Dezembertag."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
