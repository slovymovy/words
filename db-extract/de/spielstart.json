                "senses": [
                    {
                        "sense_id": "b96bcac0-227f-37b4-a867-2f1ae93b74f7",
                        "entry_id": "f6429713-2f42-3357-bde5-b090f719abe9",
                        "glosses": [
                            "Beginn, Eröffnung eines Spielgeschehens, eines Einzelspiels, einer Spielserie, einer Spielsaison"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b3ba4e7-6646-4f25-bfed-1542b22a934b",
                                "sense_id": "b96bcac0-227f-37b4-a867-2f1ae93b74f7",
                                "text": "„Die illegalen Downloads begannen schon vor dem offiziellen Spielstart.“"
                            },
                            {
                                "example_id": "85010145-5379-45b8-aaba-3e7bea8fc409",
                                "sense_id": "b96bcac0-227f-37b4-a867-2f1ae93b74f7",
                                "text": "„Der Andrang dürfte groß sein, obwohl auf der Gamescom in Köln erst der April 2012 als offizieller Spielstart genannt wurde.“"
                            },
                            {
                                "example_id": "d2af9d67-9d9e-4e22-ac11-9744aa7211e6",
                                "sense_id": "b96bcac0-227f-37b4-a867-2f1ae93b74f7",
                                "text": "„Nach katastrophalem Spielstart (Rußland gewann den ersten Satz nach 17 Minuten) steigerte sich die deutsche Auswahl zu ihrer besten Turnlerleistung.“"
                            },
                            {
                                "example_id": "712d7cf3-37ec-41d2-9273-9e0c1225fb21",
                                "sense_id": "b96bcac0-227f-37b4-a867-2f1ae93b74f7",
                                "text": "„Welche Produktion gezeigt werden soll, darüber hat die Hamburger Stella AG noch nicht entschieden, der Spielstart ist für Anfang 1999 geplant.“"
                            },
                            {
                                "example_id": "786a42c0-48b9-49c2-896b-2a5b78b9747e",
                                "sense_id": "b96bcac0-227f-37b4-a867-2f1ae93b74f7",
                                "text": "„Das Bühnenbild, für das Teo Otto verantwortlich zeichnete, hatte Szenenapplaus schon vor Spielbeginn ausgelöst: als ein zweigeschossiger Aufbau langsam, wie ein musikalischer Auftakt, zum Spielstart eindrehte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
