                ],
                "senses": [
                    {
                        "sense_id": "14e84d15-d601-335c-af3c-2fa7c757eec7",
                        "entry_id": "2c06fb1d-08ac-3e76-bb9c-d3179de05216",
                        "glosses": [
                            "Relatif à la République démocratique allemande (1949-1990, aussi appelée l’Allemagne de l’Est), à sa culture ou à ses institutions."
                        ],
                        "tags": [
                            "Communisme",
                            "RDA"
                        ],
                        "examples": [
                            {
                                "example_id": "cc6a1ba0-9547-406c-b0ab-ed1f9293668f",
                                "sense_id": "14e84d15-d601-335c-af3c-2fa7c757eec7",
                                "text": "Sur « l’avenue des Allemands » du centre-ville – entre 1955 et 1962, des ingénieurs est-allemands ont reconstruit Hamhung réduite en cendres par les bombardements américains de la guerre de Corée –, on ne croise pas d’élégantes comme à Pyongyang."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "859beaca-4e37-4df2-85c1-1e3500c9fdd0",
                        "source_entry_id": "2c06fb1d-08ac-3e76-bb9c-d3179de05216",
                        "source_sense_id": "14e84d15-d601-335c-af3c-2fa7c757eec7",
                        "target_lang_word": "ostdeutsch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ostdeutsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd9703ac-2109-3cd8-8502-8b632b74f94a",
                                        "entry_id": "f30911b6-fd8f-3af8-92c7-eee9e6bbef05",
                                        "glosses": [
                                            "auf den östlichen Teil Deutschlands, zumeist die neuen Bundesländer bezogen (Vergleiche Ostdeutschland)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2300a06a-e7f5-403d-afd2-9f1497635845",
                                                "sense_id": "fd9703ac-2109-3cd8-8502-8b632b74f94a",
                                                "text": "„Konkret soll das Lohnniveau auf das Niveau des ostdeutschen Standortes Eisenach gesenkt werden. Für die Opelaner an der Ruhr bedeutet das einen Einschnitt von etwa 20 Prozent.“"
                                            },
                                            {
                                                "example_id": "5769efb4-a079-425b-8488-a12aaccc5fb7",
                                                "sense_id": "fd9703ac-2109-3cd8-8502-8b632b74f94a",
                                                "text": "„Acht Leute vom Landestheater Tübingen nennen sich Randgruppencombo und spielen zwei Dutzend Lieder von Gerhard Gundermann - dem ostdeutschesten Liedermacher.“"
                                            },
                                            {
                                                "example_id": "3076a7d6-cdcf-4a30-984d-6c5d98c90eec",
                                                "sense_id": "fd9703ac-2109-3cd8-8502-8b632b74f94a",
                                                "text": "„Ein nahezu flächendeckender Zusammenbruch der Industrie, massenhafte Arbeitslosigkeit und beständige Abwanderung erschütterten in den neunziger Jahren die ostdeutschen Bundesländer.“"
                                            },
                                            {
                                                "example_id": "190e2322-9635-40f2-84fa-698b93101dc2",
                                                "sense_id": "fd9703ac-2109-3cd8-8502-8b632b74f94a",
                                                "text": "„Die Arbeit der ostdeutschen Meisterspione wird nicht bestraft, ihre Bubenstücke schon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b01e92a-2a25-4e1a-b18a-0964681887cb",
