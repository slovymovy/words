                    },
                    {
                        "translation_id": "136f5d80-4e6c-4f0a-a6a0-367b3d6ca0c9",
                        "source_entry_id": "973c6936-2cf1-3a04-bbbd-6ef3a91e9cc7",
                        "target_lang_word": "Bluse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bluse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f57cdc2-752b-35a1-9e7d-42aa983d14c6",
                                        "entry_id": "9a63b29c-2526-3815-9efc-41cc8f27e1ec",
                                        "glosses": [
                                            "den Oberkörper bedeckendes, leichtes Kleidungsstück, vor allem für Damen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d576fa5b-edb7-480b-9bd6-a0116855b5cf",
                                                "sense_id": "1f57cdc2-752b-35a1-9e7d-42aa983d14c6",
                                                "text": "Zum seriösen dunklen Hosenanzug passt eine schlichte weiße Bluse."
                                            },
                                            {
                                                "example_id": "8aa68b81-bcf5-43b2-a677-8a8c3017b022",
                                                "sense_id": "1f57cdc2-752b-35a1-9e7d-42aa983d14c6",
                                                "text": "„Sie ist schwarz gekleidet, die Rockfalten bewegen sich fast nicht, die Bluse ist knapp und hat einen Kragen aus weißer kleinmaschiger Spitze.“"
                                            },
                                            {
                                                "example_id": "613a937d-6ac3-4f6e-a888-44c21ed3470a",
                                                "sense_id": "1f57cdc2-752b-35a1-9e7d-42aa983d14c6",
                                                "text": "„Normalerweise fangen Frauen beim Oberkörper an und legen als Erstes die Bluse ab.“"
                                            },
                                            {
                                                "example_id": "036ce099-421a-467a-9802-814b34b91783",
                                                "sense_id": "1f57cdc2-752b-35a1-9e7d-42aa983d14c6",
                                                "text": "„Die Bluse war tief ausgeschnitten.“"
                                            },
                                            {
                                                "example_id": "7ead9be2-110a-4401-9b55-5f882be18705",
                                                "sense_id": "1f57cdc2-752b-35a1-9e7d-42aa983d14c6",
                                                "text": "„Sie hatte die zu weite Bluse eingenäht, den Wollrock gekürzt und sich in einem Anfall von Übermut Seidenstrümpfe gekauft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "541f8fe3-7c69-465c-a8d7-5f412e063ff4",
                        "source_entry_id": "973c6936-2cf1-3a04-bbbd-6ef3a91e9cc7",
                        "target_lang_word": "blouse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blouse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c21d920c-cafa-3f5c-a093-756262dbbce1",
                                        "entry_id": "c256e366-90ec-3e47-a85f-e44bbd3ca317",
                                        "glosses": [
                                            "Vêtement de travail ouvert par-devant et qui se porte par-dessus les autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20633a3d-eb9d-440c-92b6-b8e66ed3bdf2",
                                                "sense_id": "c21d920c-cafa-3f5c-a093-756262dbbce1",
                                                "text": "L’un des plus âgés s’avança suivi de dix ou douze jeunes paysans, ses fils et neveux ; ils portaient tous le grand chapeau et cette blouse bleue, ancien habit des Gaulois que le peuple de France met encore sur tous ses autres vêtements, et qui convient si bien à son climat pluvieux et à ses laborieux usages."
                                            },
                                            {
                                                "example_id": "21739d4a-8272-4531-9d4a-15e290d0b71d",
                                                "sense_id": "c21d920c-cafa-3f5c-a093-756262dbbce1",
                                                "text": "Le vieux Dominique l’accompagnait, ayant passé pour la circonstance sa blouse de cérémonie, une blouse de toile bleue, ornée de broderies blanches aux poignets et sur les épaules."
                                            },
                                            {
                                                "example_id": "9a1d748e-33ef-4398-8efe-16589428b685",
                                                "sense_id": "c21d920c-cafa-3f5c-a093-756262dbbce1",
                                                "text": "L’autre grande place de Parthenay, […], comme tous les mercredis grouillait de paysans en blouses bleues toutes neuves rêches comme des chasubles, […]."
                                            },
                                            {
                                                "example_id": "90f1c48c-86ae-492a-ba89-cf76fddb228d",
                                                "sense_id": "c21d920c-cafa-3f5c-a093-756262dbbce1",
                                                "text": "Blouse de peintre, de sculpteur, de chirurgien, d’infirmier, etc."
                                            },
                                            {
                                                "example_id": "dafafe3f-9376-43a4-a54a-f9f0c73ecb2d",
                                                "sense_id": "c21d920c-cafa-3f5c-a093-756262dbbce1",
                                                "text": "Jusqu’à la fin, elle protégea ses robes par des blouses & comme c’était la grand-mère & non la femme qui m’intéressait en elle, je ne comprenais pas sa coquetterie, chaque fois que nous voulions la photographier, d’ôter d’abord sa blouse pour être présentable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a60c61c0-ace6-3d44-beed-52aa6c764991",
