            {
                "entry_id": "64a793cf-ca9c-39b9-a326-096205637b57",
                "word": "pepsine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "765e8c70-a4e6-4ed8-9a22-7e99af6a2833",
                        "entry_id": "64a793cf-ca9c-39b9-a326-096205637b57",
                        "tags": [
                            "plural"
