                            {
                                "target_lang_word": "maudit",
                                "target_lang_sense_clarification": "utilisé pour exprimer l'agacement envers une personne ou une chose"
                            },
                            {
                                "target_lang_word": "sacré",
                                "target_lang_sense_clarification": "utilisé pour exprimer une irritation ou une surprise familière"
                            }
