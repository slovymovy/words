                "senses": [
                    {
                        "sense_id": "54b03d52-0eca-3728-b8df-2133ec84cf2e",
                        "entry_id": "f1b6b321-b84a-3fd8-881f-76bac6d62a81",
                        "glosses": [
                            "jongensnaam"
                        ],
                        "tags": [
                            "masculine",
                            "name"
                        ],
                        "examples": [
                            {
                                "example_id": "54b26a88-7a1c-41ce-a2b8-09c9544e613d",
                                "sense_id": "54b03d52-0eca-3728-b8df-2133ec84cf2e",
                                "text": "Het was in deze straat dat Piet en Corrie hun allerbeste vrienden voor het leven ontmoetten, de verderop wonende Gjalt en Marie Aardema."
                            },
                            {
                                "example_id": "25d75505-7caf-43d2-90ed-da81cbb10e9c",
                                "sense_id": "54b03d52-0eca-3728-b8df-2133ec84cf2e",
                                "text": "Hier, waar we nu zaten, stond ook onze eettafel, en ik weet nog hoe we onder die tafel door kropen om zo veel mogelijk van de door Zwarte Piet gestrooide pepernoten te bemachtigen."
                            },
                            {
                                "example_id": "513bcbca-ddd6-4a36-972c-d96bb11b7e63",
                                "sense_id": "54b03d52-0eca-3728-b8df-2133ec84cf2e",
                                "text": "Want ieder jaar gaat er een nieuw Pietje mee, klein genoeg om door de schoorstenen te roetsjen en handig in klauteren en springen."
                            },
                            {
                                "example_id": "a44a8d72-ed9d-4788-ae85-e39ce58b1a8c",
                                "sense_id": "54b03d52-0eca-3728-b8df-2133ec84cf2e",
                                "text": "Vooral in de media werd Buikhuisen verguisd, onder meer door columnist Piet Grijs (een pseudoniem van Hugo Brandt Corstius). Die noemde hem een \"kale, impotente carrièrewetenschapper\" en vergeleek hem met de toenmalige leider van de nationaalsocialistische Nederlandse Volks-Unie (NVU)."
                            }
                        ]
                    }
