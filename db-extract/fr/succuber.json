                "senses": [
                    {
                        "sense_id": "df980595-528a-3ac1-a0bd-8a4a912161f5",
                        "entry_id": "64f72ad9-9cdc-32ae-b09b-ee71272d602b",
                        "glosses": [
                            "Faire l’amour (en parlant d’une femme)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41ecc721-26a0-478e-9629-0ea0f31c0030",
                                "sense_id": "df980595-528a-3ac1-a0bd-8a4a912161f5",
                                "text": "« Toujours, toujours, toujours », dit-il, tandis que leurs deux corps s’incubaient-succubaient."
                            },
                            {
                                "example_id": "a3208980-a3fc-4ea1-98ef-81fbae9a0294",
                                "sense_id": "df980595-528a-3ac1-a0bd-8a4a912161f5",
                                "text": "ce n’est pas que j’ai été succubé par les esprits de l’au-delà."
                            },
                            {
                                "example_id": "7f3cb405-efe3-47e5-8703-3b413cb545b9",
                                "sense_id": "df980595-528a-3ac1-a0bd-8a4a912161f5",
                                "text": "Même si elle est génétiquement disposée à « succuber » tous ses partenaires, il n’en reste pas moins qu’elle a a priori les ressources intérieures suffisantes pour s’en écarter si on lui laisse le temps ou si on lui file un gros coup de main."
                            },
                            {
                                "example_id": "303f5bf1-0b4e-4408-bd91-af50f30d3fdc",
                                "sense_id": "df980595-528a-3ac1-a0bd-8a4a912161f5",
                                "text": "La chair est de ne pas incuber ni succuber."
                            }
                        ]
                    }
