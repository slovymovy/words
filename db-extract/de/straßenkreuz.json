                "senses": [
                    {
                        "sense_id": "8ed6f9f6-7aae-37d2-8104-d686e81c02ad",
                        "entry_id": "9d6f4485-d5a2-327b-a99b-7a5aa1d6d52f",
                        "glosses": [
                            "Stelle, an der Straßen sich kreuzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72ca9419-9266-4066-b0e4-977c48a42246",
                                "sense_id": "8ed6f9f6-7aae-37d2-8104-d686e81c02ad",
                                "text": "„Auf ein Straßenkreuz ging alle paar Minuten ein Schuss, aber so genau immer auf denselben Fleck, dass wir nur auf das Feld zu biegen brauchten und dann wieder auf die Straße.“"
                            },
                            {
                                "example_id": "72db67ca-c242-4348-9d8d-deb3bfbbcd11",
                                "sense_id": "8ed6f9f6-7aae-37d2-8104-d686e81c02ad",
                                "text": "„Vor ihnen wölbt sich die Landsberger Allee in flachem Bogen über die S-Bahn auf das Straßenkreuz am Steuerhaus hin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "84c5d1d6-c02e-3779-85a0-151874ef19e9",
                        "entry_id": "9d6f4485-d5a2-327b-a99b-7a5aa1d6d52f",
                        "glosses": [
                            "Kreuz, das an einer Straße aufgestellt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1a0e0f3-7cf2-4dfc-b645-edb86062b2b1",
                                "sense_id": "84c5d1d6-c02e-3779-85a0-151874ef19e9",
                                "text": "Es gibt Strecken, an denen viele Straßenkreuze stehen."
                            }
                        ],
                        "sense_index_json": "\"2\""
