                                "target_senses": [
                                    {
                                        "sense_id": "cf8daff6-b2e7-3f5a-a3ef-77fd18ec9381",
                                        "entry_id": "39730baf-ee35-363b-bc8e-797eaaf4e44c",
                                        "glosses": [
                                            "Spielkarte, die bei der Auszählung keine Punkte bringt (7er, 8er, 9er)"
                                        ],
                                        "tags": [],
