                "senses": [
                    {
                        "sense_id": "9da7267a-6662-3e86-a2b9-87314b2b0cda",
                        "entry_id": "9df91549-b25d-3492-9dce-9ef149a30290",
                        "glosses": [
                            "System der Grapheme einer Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9732be1-0f6a-4e60-9160-9b47ac8985b3",
                                "sense_id": "9da7267a-6662-3e86-a2b9-87314b2b0cda",
                                "text": "Die Graphemik des Deutschen unterscheidet sich etwas von der der Nachbarsprachen, die z.B. kein <ß> haben."
                            },
                            {
                                "example_id": "7480efdf-33fd-4315-be1a-72a0fc1370ba",
                                "sense_id": "9da7267a-6662-3e86-a2b9-87314b2b0cda",
                                "text": "„Die Graphemik paßt sich also nicht nur der Phonemik an; bisweilen wird auch die Phonemik von der Graphemik beinflußt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f16f93ea-5629-3f0b-9528-94e18831dd9e",
                        "entry_id": "9df91549-b25d-3492-9dce-9ef149a30290",
                        "glosses": [
                            "Wissenschaftsdisziplin, die das System der Grapheme einer Sprache erforscht."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22e7ef08-aae2-42ce-8aa6-8e363d5427f1",
                                "sense_id": "f16f93ea-5629-3f0b-9528-94e18831dd9e",
                                "text": "Die Graphemik erarbeitet das System der Grapheme einer Sprache."
                            }
