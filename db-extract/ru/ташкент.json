                "senses": [
                    {
                        "sense_id": "bf66acf1-6b3a-3c9e-a827-806a26940ea1",
                        "entry_id": "6c1855cd-d325-3f72-a82f-f95b4ff6f8db",
                        "glosses": [
                            "геогр. город в Средней Азии, столица Узбекистана"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d50cf06f-4a4e-3d1f-ab39-b83e0ffc0b0b",
                        "entry_id": "6c1855cd-d325-3f72-a82f-f95b4ff6f8db",
                        "glosses": [
                            "метоним., полит. правительство Республики Узбекистан"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8428af2c-0aa0-3932-ba10-bad69faa2a0e",
                        "entry_id": "6c1855cd-d325-3f72-a82f-f95b4ff6f8db",
                        "glosses": [
                            "разг. о жаркой погоде, жарком воздухе где-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e6e807e-174b-453d-b577-ab221d930c51",
                                "sense_id": "8428af2c-0aa0-3932-ba10-bad69faa2a0e",
                                "text": "— Ух, жара! — сказал Грошев, отскочил от костра. — Ташкент! // — Это ещё не Ташкент, — ответил Генка, протягивая к огню руки."
                            },
                            {
                                "example_id": "26b3444c-fb4c-43c7-ac9f-c50635642665",
                                "sense_id": "8428af2c-0aa0-3932-ba10-bad69faa2a0e",
                                "text": "Тут ещё дым повалил, зенки выедает. Ташкент в натуре. Один говорит: хана нам всем, или поджаримся, или эти с улицы замочат, или свои же засекут, давай гранатой взломить попробуем."
                            }
                        ]
                    }
