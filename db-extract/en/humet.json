                    {
                        "sense_id": "ce9060d3-59c9-3f82-9955-c583e2bba593",
                        "entry_id": "aa30300f-8b8a-3041-b799-0b1b6f0131b6",
                        "glosses": [
                            "A fesse or bar cut off short at each end."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "0dae22b5-22a9-4946-9aa6-b09592b46fe7",
                                "sense_id": "ce9060d3-59c9-3f82-9955-c583e2bba593",
                                "text": "[...] who take their Name from Hameyde, one of the two and twenty Baronies of that Province; thus D'Or a trois Hameydes de Geules, that is, Or, three Humets Gules, or Bars couped;"
                            },
                            {
                                "example_id": "6101f277-f4dd-4333-9d70-24a433c8f381",
                                "sense_id": "ce9060d3-59c9-3f82-9955-c583e2bba593",
                                "text": "Sa., on a humet arg., a martlet arg. (or.) Creft : A martlet as in the shield. Confirmed (with 1 quartering) to Hugh Bostock, of Moreton Say, who m. Margaret, daug. of Thomas Lee, of Langley. Harl MS. Boteler."
                            },
                            {
                                "example_id": "f7246fcb-043a-4b75-a727-a2142199c8c1",
                                "sense_id": "ce9060d3-59c9-3f82-9955-c583e2bba593",
                                "text": "The Humet is a term sometimes, but seldom, used for a fesse, or bar humetty, i.e. couped at each of the extremities. Or, three humets sable , charged with as many annulets argent—AMBROSE, Lancashire."
                            }
                        ]
                    }
