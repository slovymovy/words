                ],
                "senses": [
                    {
                        "sense_id": "41569053-c213-33c9-b297-de260db11dd7",
                        "entry_id": "ac8e4894-bd53-3ae4-99c8-193020d1bb86",
                        "glosses": [
                            "Heiligenschein"
                        ],
                        "tags": [
                            "meist Singular",
                            "bildende Kunst"
                        ],
                        "examples": [
                            {
                                "example_id": "6717658a-f6b4-4d62-95df-0da56adbd3a3",
                                "sense_id": "41569053-c213-33c9-b297-de260db11dd7",
                                "text": "Köpfe von Heiligen werden von Künstlern oft mit einem Nimbus dargestellt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "36c03a75-f592-3328-ad7b-be50a9b305da",
                        "entry_id": "ac8e4894-bd53-3ae4-99c8-193020d1bb86",
                        "glosses": [
                            "Regenwolke"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "4d5f37bf-2449-4024-b503-ad9f95e11763",
                                "sense_id": "36c03a75-f592-3328-ad7b-be50a9b305da",
                                "text": "„Er [Luke Howard] teilte Wolken in Stratus (Schichtwolken), Cumulus (Haufenwolken) und Cirrus (Schleierwolken) sowie auch Nimbus (Regenwolken) ein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "d281a983-e4b4-3d75-8f18-c1665381ca42",
                        "entry_id": "ac8e4894-bd53-3ae4-99c8-193020d1bb86",
                        "glosses": [
                            "besonderer Ruf, bestimmtes Renommee"
                        ],
                        "tags": [
                            "figurative",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "7b86fc0c-f2e6-47c1-a8e7-be00e80c5073",
                                "sense_id": "d281a983-e4b4-3d75-8f18-c1665381ca42",
                                "text": "„Danach kam eine lange Durststrecke, in der er den Nimbus des Unschlagbaren verlor“."
                            },
                            {
                                "example_id": "957b7b64-f288-414e-8e3a-88823afc55d6",
                                "sense_id": "d281a983-e4b4-3d75-8f18-c1665381ca42",
                                "text": "„Die Vorveröffentlichungen hatten ihren Anteil an dem Nimbus, den Seume sich mit diesem Buch zu verschaffen und erschreiben wusste.“"
                            },
                            {
                                "example_id": "c7ae07d7-53f0-4b94-ae09-be1107114c57",
                                "sense_id": "d281a983-e4b4-3d75-8f18-c1665381ca42",
                                "text": "„Weiterhin gehört zum Nimbus der vulkanische Ursprung des Berges; er unterstreicht die bereits aus der geographischen Lage resultierende Synthese der Elemente Feuer und Eis.“"
                            },
                            {
                                "example_id": "2f3ef7a1-fabf-4834-9a80-d1335c0b0c12",
                                "sense_id": "d281a983-e4b4-3d75-8f18-c1665381ca42",
                                "text": "„Mit irgendeinem von den Bengeln hier läßt sie sich bestimmt nicht ein - dafür fühlt sie sich viel zu sehr als großmächtige Erbin und möchte nichts von ihrem Nimbus als künftige Besitzerin einbüßen.“"
                            },
                            {
                                "example_id": "2769982c-11ad-4e9f-8508-e632b6db33c7",
                                "sense_id": "d281a983-e4b4-3d75-8f18-c1665381ca42",
                                "text": "„So begann die überseeische, die transatlantische Phase im Leben Alf Bertinis, nun in den Augen seiner drei Söhne von ungeheurem Nimbus umgeben, Weltreisender, Abenteurer und zärtlich geliebter Vater zugleich.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
