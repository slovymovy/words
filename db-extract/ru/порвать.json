                            {
                                "example_id": "ac32c552-1482-4b47-a412-d0226fb4291e",
                                "sense_id": "59218aba-4e47-32eb-b9b1-2bee74f347c6",
                                "text": "Неиспра́вный при́нтер то́лько порва́л бума́гу и ничего́ не печа́тал.",
                                "translation": "The broken printer only tore the paper apart and didn't print anything.",
                                "english": "The broken printer only tore the paper apart and didn't print anything."
                            }
                        ]
                    },
                    {
