                    "sense_definition": "meervoud verleden tijd van <w>letten</w>",
                    "learner_level": "C2",
                    "frequency": "Middle",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vorig jaar <w>letten</w> we veel strenger op de uitgaven van het bedrijf.",
                            "target_lang_translations": {
                                "en": "Last year we <w>paid</w> much stricter <w>attention</w> to the company's expenses.",
                                "ru": "В прошлом году мы гораздо строже <w>следили</w> за расходами компании."
                            }
                        },
                        {
                            "text": "Zij <w>letten</w> vroeger nooit op de waarschuwingen van hun ouders.",
                            "target_lang_translations": {
                                "en": "They never <w>watched</w> for or heeded their parents' warnings in the past.",
                                "ru": "Раньше они никогда не <w>обращали внимания</w> на предупреждения своих родителей."
                            }
                        }
