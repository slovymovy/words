                            {
                                "example_id": "04f10105-a698-48db-b395-c474055b2a97",
                                "sense_id": "e02ae47f-3096-336b-9ead-170e60abd8f7",
                                "text": "U denkt warempel dat ik in de eerste instantie werkelijk een conciërge ben, maar welbeschouwd ben ik van mijn eigen aspect meubelmaker, kom ik uit de meubelmakerij."
                            },
                            {
