                            {
                                "example_id": "0e49f87e-4aa6-4356-b6fa-1db1059d9531",
                                "sense_id": "a04cc8d1-94f1-3b51-8cdd-edadb66043fa",
                                "text": "„Jemand hat seine Zigarrenkiste hingestellt und bestellt zwei Allasch. Das Hinstellen der Kiste und die Bestellung haben ein großes Loch in die Unterhaltung der Gesellschaft geschlagen: sie schweigen.“"
                            },
                            {
                                "example_id": "97c2f1f7-9d81-48b1-90fc-df24b254316f",
                                "sense_id": "a04cc8d1-94f1-3b51-8cdd-edadb66043fa",
                                "text": "„Der verdammte Allasch hatte mir übel zugesetzt.“"
                            }
                        ],
