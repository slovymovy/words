                ],
                "senses": [
                    {
                        "sense_id": "9b6f5937-e1c6-3766-b302-6d55f18ab47b",
                        "entry_id": "aa30553f-91df-36a2-abce-e4bbfe49f1a1",
                        "glosses": [
                            "Donner un caractère auto-érotique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b913395-54f3-4b3e-b4ce-fdc8be3b6b63",
                                "sense_id": "9b6f5937-e1c6-3766-b302-6d55f18ab47b",
                                "text": "Je ne peux pas m'empêcher de me représenter ta petite personne comme un pleutre, en train d'autoérotiser sa prose devant son ordinateur, genre \"han bien envoyée celle là\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "cdc59cf9-ca1d-3535-a4e8-8c3d5a7eb38c",
                        "entry_id": "aa30553f-91df-36a2-abce-e4bbfe49f1a1",
                        "glosses": [
                            "Se procurer soi-même un plaisir érotique."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "083f562e-57d3-4c27-8254-bbf6fb1fe07c",
                                "sense_id": "cdc59cf9-ca1d-3535-a4e8-8c3d5a7eb38c",
                                "text": "Au-delà des sensations requises, chacun peut donc posséder cette faculté de s’autoérotiser mentalement par la création de fantasmes."
                            },
                            {
                                "example_id": "0e1dddf6-ffcf-4555-a2ea-3aed9e72eb8e",
                                "sense_id": "cdc59cf9-ca1d-3535-a4e8-8c3d5a7eb38c",
                                "text": "J'ai lu un article qui disait qu'aux États-Unis il y avait des hommes qui préfèrent s'autoérotiser plutôt que de coucher avec une femme."
                            }
                        ]
                    }
                ],
