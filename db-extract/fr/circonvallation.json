        "fr-extract.jsonl": [
            {
                "entry_id": "255a60aa-b284-31ab-8e1a-ca49c5c51fd2",
                "word": "circonvallation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "950059cb-3533-4ff4-8c8d-38bd3368c309",
                        "entry_id": "255a60aa-b284-31ab-8e1a-ca49c5c51fd2",
                        "tags": [
                            "plural"
                        ],
                        "form": "circonvallations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2edcf73d-a11b-39a2-a144-a09cd74bcda9",
                        "entry_id": "255a60aa-b284-31ab-8e1a-ca49c5c51fd2",
                        "glosses": [
                            "Tranchée à parapet, à redoutes, à place d’armes, etc., que des assiégeants font autour de leur position pour se garantir des attaques du dehors et pour empêcher qu’il n’entre du secours dans la place assiégée."
                        ],
                        "tags": [
                            "Poliorcétique"
                        ],
                        "examples": [
                            {
                                "example_id": "4444d4cc-84c0-4628-8463-93d8db66d771",
                                "sense_id": "2edcf73d-a11b-39a2-a144-a09cd74bcda9",
                                "text": "Il pensait que mieux valait, en tout cas, se mettre à l'abri d'un coup de main. La ligne de circonvallation fut donc tracée de manière à entourer la factorerie."
                            },
                            {
                                "example_id": "0a14748c-1da9-48a7-a76f-298e9f365490",
                                "sense_id": "2edcf73d-a11b-39a2-a144-a09cd74bcda9",
                                "text": "A la sortie du village, au Nord, on aperçoit des espèces de remparts en terre avec des lignes de circonvallation et terrasses; leur emplacement offre dans l'ensemble un tracé conforme aux règles de la castramétation romaine."
                            },
                            {
                                "example_id": "d9f05808-d237-4f3d-bc3a-365aa0870a38",
                                "sense_id": "2edcf73d-a11b-39a2-a144-a09cd74bcda9",
                                "text": "L’architecte saxon avait épuisé son art à rendre le principal donjon imprenable, et la seule circonvallation qu’on y vît était une barrière en palissades grossièrement construites."
                            },
                            {
                                "example_id": "0c816c60-69a7-4df5-98b1-3214e01b6aeb",
                                "sense_id": "2edcf73d-a11b-39a2-a144-a09cd74bcda9",
                                "text": "— Son origine glaciaire est marquée vers l'W, par une double « circonvallation » d'alluvions formée essentiellement par des grès triturés emballant des blocs de poudingues et des quartzites, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64cacf4f-f03a-4665-8b80-7d72370d5bea",
                        "source_entry_id": "255a60aa-b284-31ab-8e1a-ca49c5c51fd2",
                        "source_sense_id": "2edcf73d-a11b-39a2-a144-a09cd74bcda9",
                        "target_lang_word": "circumvallation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "circumvallation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48e521d5-17e2-3efa-b816-2bd07aa296f7",
                                        "entry_id": "07612705-2a6e-3d64-8315-399337100167",
                                        "glosses": [
                                            "A rampart or other defensive entrenchment that entirely encircles the position being defended."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "add67c9c-6c13-4363-8a51-758afd9c919d",
                                                "sense_id": "48e521d5-17e2-3efa-b816-2bd07aa296f7",
                                                "text": "[...] and in a word, would intrench and fortify them round with as many circumvallations and breast-works, as my uncle Toby would a citadel."
                                            },
                                            {
                                                "example_id": "3715e928-63c5-4ec1-989b-36b9859169cc",
                                                "sense_id": "48e521d5-17e2-3efa-b816-2bd07aa296f7",
                                                "text": "The Saxon architect had exhausted his art in rendering the main keep defensible, and there was no other circumvallation than a rude barrier of palisades."
                                            },
                                            {
                                                "example_id": "0d7aaa17-63a0-460a-b920-7465b0d294d1",
                                                "sense_id": "48e521d5-17e2-3efa-b816-2bd07aa296f7",
                                                "text": "He just managed to finish her in time—the day before the date fixed for his breaking ground on a greater business still, the circumvallation of Mrs. Dunn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75280937-0f7e-48e2-a19a-97818bdad298",
                        "source_entry_id": "255a60aa-b284-31ab-8e1a-ca49c5c51fd2",
