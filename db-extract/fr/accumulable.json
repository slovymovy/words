                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dde46c2f-40b2-4c2f-84d0-3cdc67b7d4e6",
                                "sense_id": "de43480d-a82c-32b4-ab70-97f77b0ce90b",
                                "text": "Si la propriété est accumulable, si elle doit être accumulée en une certaine mesure pour assurer la conservation des êtres, elle est aussi transmissible, et doit être transmise par la même raison."
                            },
                            {
                                "example_id": "fe9b7596-a1e4-4361-af44-58649cf416fc",
                                "sense_id": "de43480d-a82c-32b4-ab70-97f77b0ce90b",
                                "text": "Celle-ci est inhérente au modèle fondateur de Solow (1956), qui entraîne la convergence des pays entre eux du fait de la décroissance des rendements marginaux sur le facteur accumulable (le capital physique)."
                            }
                        ]
                    }
                ],
