                                        "glosses": [
                                            "Having, or assuming, a variety of forms, characters, or styles"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd341256-4d98-4fb7-a739-c9dd20752b2f",
                                                "sense_id": "03a243c0-2ad3-3b36-b2f5-7863b034f667",
                                                "text": "Idealism is an exceedingly complex system, varying much with varying authors, very polymorphous, and consequently very difficult to discuss."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c911a0a-107f-3fd9-9042-42b6e8f29a0b",
                                        "entry_id": "8cd49502-e29c-374e-b504-f8c377c73bf0",
                                        "glosses": [
                                            "Having, or occurring in, several distinct forms"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e44c3511-a1e5-4748-b997-d452c2ae8b03",
                                                "sense_id": "4c911a0a-107f-3fd9-9042-42b6e8f29a0b",
                                                "text": "1913, R. Chodat in Popular Science Monthly Volume 82 Janauay 1913, A Grain of Wheat\nIn order to establish itself in any locality a plant must hold its own against competitors which, masters of the soil from time immemorial, have been selected to fit the soil and climate. Moreover, emmer is not cultivated anywhere in Palestine. This wild wheat is furthermore a different plant from any known in cultivation, a polymorphous race, no doubt, but a distinct one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83c7e21f-61e5-3db1-a3c6-adf7cba4dc20",
                                        "entry_id": "8cd49502-e29c-374e-b504-f8c377c73bf0",
                                        "glosses": [
                                            "Crystallizing in two or more different forms; polymorphic"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
