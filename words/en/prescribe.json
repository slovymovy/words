{
    "word_family": [
        "prescription",
        "prescriptive",
        "prescriber",
        "prescript"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "74382395-a7ca-345d-a36f-ffb540e80bc9",
                    "sense_definition": "To order a specific drug or medical treatment for a patient under professional authority.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "medical_treatment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor decided to <w>prescribe</w> aspirin to help manage the patient's recurring headaches.",
                            "target_lang_translations": {
                                "ru": "Врач решил <w>выписать</w> аспирин, чтобы помочь справиться с повторяющимися головными болями пациента."
                            }
                        },
                        {
                            "text": "Many doctors are in the habit of <w>prescribing</w> medication that can cause drowsiness as a side effect.",
                            "target_lang_translations": {
                                "ru": "У многих врачей есть привычка <w>назначать</w> лекарства, которые могут вызвать сонливость в качестве побочного эффекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "order",
                        "direct"
                    ],
                    "common_phrases": [
                        "prescribe medication",
                        "prescribe antibiotics",
                        "habit of prescribing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выписывать лекарство или назначать лечение пациенту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выписывать",
                                "target_lang_sense_clarification": "рецепт на лекарство"
                            },
                            {
                                "target_lang_word": "назначать",
                                "target_lang_sense_clarification": "лечение или препарат"
                            },
                            {
                                "target_lang_word": "прописывать",
                                "target_lang_sense_clarification": "медицинское средство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5347a5a-ae5c-3761-a681-d8bc1ae9aaa6",
                    "sense_definition": "To officially state a rule or a required way of doing something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rules_and_regulations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The property must meet all the criteria <w>prescribed</w> by the local building regulations.",
                            "target_lang_translations": {
                                "ru": "Имущество должно соответствовать всем критериям, <w>предписанным</w> местными строительными нормами."
                            }
                        },
                        {
                            "text": "The law does not <w>prescribe</w> a specific method for how these records should be kept.",
                            "target_lang_translations": {
                                "ru": "Закон не <w>устанавливает</w> конкретного метода ведения этих записей."
                            }
                        }
                    ],
                    "synonyms": [
                        "stipulate",
                        "dictate",
                        "specify",
                        "ordain"
                    ],
                    "antonyms": [
                        "proscribe"
                    ],
                    "common_phrases": [
                        "prescribed by law",
                        "prescribed procedure",
                        "prescribed format"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально устанавливать правило или порядок действий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предписывать",
                                "target_lang_sense_clarification": "устанавливать правила"
                            },
                            {
                                "target_lang_word": "устанавливать",
                                "target_lang_sense_clarification": "нормы или требования"
                            },
                            {
                                "target_lang_word": "определять",
                                "target_lang_sense_clarification": "порядок действий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "161a5820-50fb-3aef-9d89-3e75c6ea8ec1",
                    "sense_definition": "To claim or establish a right or title through long-term use or custom.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_rights",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company attempted to <w>prescribe</w> a right of way over the neighbor's land after decades of use.",
                            "target_lang_translations": {
                                "ru": "Компания попыталась <w>установить</w> право проезда через землю соседа на основании давности использования после десятилетий эксплуатации."
                            }
                        },
                        {
                            "text": "It is possible to <w>prescribe</w> a right to the minerals found on the property through continuous possession.",
                            "target_lang_translations": {
                                "ru": "Можно <w>приобрести по давности</w> право на полезные ископаемые, найденные на участке, путем непрерывного владения."
                            }
                        }
                    ],
                    "synonyms": [
                        "claim"
                    ],
                    "common_phrases": [
                        "prescribe a right"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приобретать право на что-либо в силу давности владения или пользования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приобретать по давности",
                                "target_lang_sense_clarification": "юридическое право"
                            },
                            {
                                "target_lang_word": "устанавливать",
                                "target_lang_sense_clarification": "право через обычай"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59b2437d-447e-3e39-b71d-829b51c35248",
                    "sense_definition": "To become invalid or lose legal force because a period of time has passed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_expiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The debt will <w>prescribe</w> after three years if no legal action is taken to recover it.",
                            "target_lang_translations": {
                                "ru": "Долг <w>аннулируется по истечении срока давности</w> через три года, если не будут предприняты юридические действия по его взысканию."
                            }
                        },
                        {
                            "text": "The right to sue for damages may <w>prescribe</w> if the claimant waits too long.",
                            "target_lang_translations": {
                                "ru": "Право на иск о возмещении ущерба может <w>прекратиться по давности</w>, если истец будет ждать слишком долго."
                            }
                        }
                    ],
                    "synonyms": [
                        "lapse",
                        "expire"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Утрачивать силу или прекращаться по истечении установленного законом срока."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прекращаться по давности",
                                "target_lang_sense_clarification": "о праве или иске"
                            },
                            {
                                "target_lang_word": "истекать",
                                "target_lang_sense_clarification": "о сроке давности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}