                {
                    "sense_id": "843b003d-7403-3cbb-854a-c384772fd7cd",
                    "sense_definition": "A piece of soft, absorbent paper used as a handkerchief, for cleaning, or for wrapping delicate items.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "paper_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She grabbed a <w>tissue</w> from the box to wipe her nose.",
                            "target_lang_translations": {
                                "ru": "Она взяла <w>салфетку</w> из коробки, чтобы вытереть нос.",
                                "zh": "她从盒子里抽出一张<w>纸巾</w>擦了擦鼻子。"
                            }
                        },
                        {
                            "text": "Please wrap the crystal glasses in <w>tissue</w> before packing them.",
