            "senses": [
                {
                    "sense_id": "0523104f-1938-3fbc-9c8c-d8e8bb379d24",
                    "sense_definition": "En dépit de ; sans être empêché ou arrêté par un obstacle matériel ou concret.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "opposition_obstacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons décidé de sortir nous promener <w>malgré</w> le mauvais temps."
                        },
                        {
                            "text": "Elle a continué à courir <w>malgré</w> une vive douleur au genou."
                        }
                    ],
                    "synonyms": [
                        "nonobstant"
                    ],
                    "common_phrases": [
                        "malgré tout"
                    ]
                },
                {
                    "sense_id": "9cd2111f-c507-3420-9eea-ebb70dfdd3b6",
                    "sense_definition": "Contre la volonté, le consentement ou l'opposition de quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "opposition_volonte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a dû partir vivre à l'étranger <w>malgré</w> lui pour son travail."
                        },
                        {
                            "text": "Ils ont voté la nouvelle loi <w>malgré</w> les vives protestations des citoyens."
                        }
                    ],
                    "common_phrases": [
                        "malgré lui",
                        "malgré moi",
                        "malgré soi"
                    ]
                },
                {
                    "sense_id": "abcf943b-63b5-3fb8-ab1c-276104de022f",
                    "sense_definition": "En dépit d'une circonstance abstraite ou d'un fait qui laissait prévoir le contraire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opposition_obstacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet auteur reste très populaire <w>malgré</w> certaines critiques virulentes de la presse."
                        },
                        {
                            "text": "Le projet a finalement été accepté par la direction <w>malgré</w> son coût élevé."
                        }
                    ],
                    "synonyms": [
                        "nonobstant"
                    ]
                }
            ]
        },
        {
