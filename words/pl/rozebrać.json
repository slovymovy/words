{
    "word_family": [
        "rozbiórka",
        "rozbiór",
        "rozebrany",
        "rozbieranie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "75acd8c6-70a0-397b-8c6c-f3c5f9bfc79b",
                    "sense_definition": "zdjąć ubranie z kogoś lub z czegoś",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ubranie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mama szybko <w>rozebrała</w> zmarznięte dziecko z mokrej kurtki.",
                            "target_lang_translations": {
                                "ru": "Мама быстро <w>сняла</w> с замерзшего ребёнка мокрую куртку."
                            }
                        },
                        {
                            "text": "Lekarz poprosił pacjenta, aby ten <w>rozebrał</w> się do pasa.",
                            "target_lang_translations": {
                                "ru": "Врач попросил пациента <w>раздеться</w> до пояса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rozebrać do naga",
                        "rozebrać do pasa"
                    ],
                    "target_lang_definitions": {
                        "ru": "снять одежду с кого-либо или с чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздеть",
                                "target_lang_sense_clarification": "снять одежду с кого-то"
                            },
                            {
                                "target_lang_word": "раздеться",
                                "target_lang_sense_clarification": "снять одежду с себя (в возвратной форме)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac83b9eb-f59f-37c2-8e42-30bfdafa090d",
                    "sense_definition": "rozłożyć urządzenie lub mechanizm na pojedyncze części",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "demontaz",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mechanik <w>rozebrał</w> silnik na części, aby znaleźć usterkę.",
                            "target_lang_translations": {
                                "ru": "Механик <w>разобрал</w> двигатель на части, чтобы найти неисправность."
                            }
                        },
                        {
                            "text": "Muszę <w>rozebrać</w> ten stary zegar i dokładnie go wyczyścić.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>разобрать</w> эти старые часы и тщательно их почистить."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rozebrać na części"
                    ],
                    "target_lang_definitions": {
                        "ru": "разобрать механизм или устройство на отдельные части"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разобрать",
                                "target_lang_sense_clarification": "разъединить на части механизм или устройство"
                            },
                            {
                                "target_lang_word": "демонтировать",
                                "target_lang_sense_clarification": "произвести демонтаж механизма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "598ad6eb-c7d3-3b5d-b18e-afc11338f260",
                    "sense_definition": "zlikwidować konstrukcję lub budynek, usuwając poszczególne elementy",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "demontaz",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Robotnicy <w>rozebrali</w> stary drewniany most w zaledwie dwa dni.",
                            "target_lang_translations": {
                                "ru": "Рабочие <w>разобрали</w> старый деревянный мост всего за два дня."
                            }
                        },
                        {
                            "text": "Władze miasta postanowiły <w>rozebrać</w> opuszczony budynek fabryki.",
                            "target_lang_translations": {
                                "ru": "Власти города решили <w>снести</w> заброшенное здание фабрики."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rozebrać stary budynek",
                        "rozebrać rusztowanie"
                    ],
                    "target_lang_definitions": {
                        "ru": "снести или ликвидировать конструкцию либо здание, убирая отдельные элементы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разобрать",
                                "target_lang_sense_clarification": "снять по частям конструкцию или здание"
                            },
                            {
                                "target_lang_word": "снести",
                                "target_lang_sense_clarification": "полностью демонтировать постройку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9db2326c-3c5c-3526-8805-bf910d0ad2f7",
                    "sense_definition": "podzielić między obce państwa terytorium jakiegoś kraju",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W osiemnastym wieku sąsiednie mocarstwa postanowiły <w>rozebrać</w> Polskę.",
                            "target_lang_translations": {
                                "ru": "В восемнадцатом веке соседние державы решили <w>разделить</w> Польшу."
                            }
                        },
                        {
                            "text": "Zaborcy <w>rozebrali</w> kraj, dzieląc jego ziemie między siebie.",
                            "target_lang_translations": {
                                "ru": "Захватчики <w>разделили</w> страну, распределив её земли между собой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rozebrać państwo"
                    ],
                    "target_lang_definitions": {
                        "ru": "разделить территорию страны между другими государствами"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разделить",
                                "target_lang_sense_clarification": "расчленить территорию государства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78f381ac-3373-3adf-a803-cf700150e9ed",
                    "sense_definition": "rozchwytać lub podzielić między siebie ograniczony towar albo zapasy",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Klienci błyskawicznie <w>rozebrali</w> cały zapas tanich telewizorów.",
                            "target_lang_translations": {
                                "ru": "Покупатели мгновенно <w>разобрали</w> весь запас дешёвых телевизоров."
                            }
                        },
                        {
                            "text": "Wszystkie bilety na koncert natychmiast <w>rozebrano</w> w kasach.",
                            "target_lang_translations": {
                                "ru": "Все билеты на концерт тут же <w>расхватали</w> в кассах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rozebrać towar"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne użycie dotyczące szybkiego wykupienia towaru"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "быстро раскупить или разобрать дефицитный товар либо запасы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разобрать",
                                "target_lang_sense_clarification": "быстро раскупить все запасы товара"
                            },
                            {
                                "target_lang_word": "расхватать",
                                "target_lang_sense_clarification": "нарасхват скупить товар"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c450dbba-36ee-3aae-ae52-7497fea2875a",
                    "sense_definition": "podzielić tuszę zabitego zwierzęcia na części kulinarne",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rzeźnik sprawnie <w>rozebrał</w> półtuszę wieprzową na mniejsze porcje.",
                            "target_lang_translations": {
                                "ru": "Мясник ловко <w>разделал</w> свиную полутушу на меньшие части."
                            }
                        },
                        {
                            "text": "Kucharz musiał najpierw dokładnie <w>rozebrać</w> tuszę indyka.",
                            "target_lang_translations": {
                                "ru": "Повару сначала нужно было тщательно <w>разделать</w> тушку индейки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rozebrać tuszę"
                    ],
                    "target_lang_definitions": {
                        "ru": "разделать тушу убитого животного на части"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разделать",
                                "target_lang_sense_clarification": "разрезать тушу на кулинарные части"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20b3d249-6695-3feb-9709-160d7ea01a5b",
                    "sense_definition": "pojąć sens czegoś, właściwie zinterpretować lub <w>zrozumieć</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Trudno było <w>rozebrać</w> jego skomplikowane i zawiłe tłumaczenia.",
                            "target_lang_translations": {
                                "ru": "Трудно было <w>разобрать</w> его сложные и запутанные объяснения."
                            }
                        },
                        {
                            "text": "A mnie doprawdy ciężko całą tę mustrę <w>rozebrać</w>.",
                            "target_lang_translations": {
                                "ru": "А мне право же тяжело всю эту муштру <w>понять</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "zrozumieć"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "znaczenie dawne, książkowe"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "понять смысл чего-либо, разобраться в чём-то сложном"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разобрать",
                                "target_lang_sense_clarification": "понять, уяснить сложный смысл"
                            },
                            {
                                "target_lang_word": "разобраться",
                                "target_lang_sense_clarification": "понять суть чего-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}