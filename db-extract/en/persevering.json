                                "target_senses": [
                                    {
                                        "sense_id": "8596f39b-e08a-39db-b574-3a1b34ceabf2",
                                        "entry_id": "6c59b984-c0a5-36b5-82b5-7f02d446ed45",
                                        "glosses": [
                                            "Qui persévère, qui ne baisse pas les bras devant les obstacles, qui continue de poursuivre son but."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e56a9f13-44f1-42a8-9753-bfba7194a362",
                                                "sense_id": "8596f39b-e08a-39db-b574-3a1b34ceabf2",
                                                "text": "Et ce fut par cette invariable réponse qu’il accueillit toutes les parlementaires juponnées que, patiente et persévérante, sa femme persistait à lui dépêcher d’heure en heure sous des prétextes, semblait-il, de plus en plus urgents."
                                            },
                                            {
                                                "example_id": "4356c622-bf3e-4f0f-b15b-b3bba845c87a",
                                                "sense_id": "8596f39b-e08a-39db-b574-3a1b34ceabf2",
                                                "text": "Une importante leçon de l'expérience hongroise est l'importance de réformes cohérentes et persévérantes pendant plusieurs années."
                                            }
                                        ]
                                    }
                                ]
                            },
