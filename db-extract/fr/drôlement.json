        "fr-extract.jsonl": [
            {
                "entry_id": "e7f7f503-29a8-3fca-89ce-a97556b03203",
                "word": "drôlement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4cd93610-c0ca-38b4-aca7-7b49e2a03c9c",
                        "entry_id": "e7f7f503-29a8-3fca-89ce-a97556b03203",
                        "glosses": [
                            "D’une manière drôle."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "046d77f9-38f5-451f-a0c0-03f9041172d3",
                                "sense_id": "4cd93610-c0ca-38b4-aca7-7b49e2a03c9c",
                                "text": "M. Paul, que cette malice cousue de fil blanc laissait insensible, sourit, hocha la tête, plissa drôlement son petit œil et répondit : […]."
                            },
                            {
                                "example_id": "7c016450-77ec-4542-b0eb-3769730be1df",
                                "sense_id": "4cd93610-c0ca-38b4-aca7-7b49e2a03c9c",
                                "text": "Il s'est drôlement tiré d’affaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "e8e102b0-aca8-31af-92b1-fab50b029c46",
                        "entry_id": "e7f7f503-29a8-3fca-89ce-a97556b03203",
                        "glosses": [
                            "Dans les réponses pour indiquer que c’est tout le contraire."
                        ],
                        "tags": [
                            "ironic"
                        ],
                        "examples": [
                            {
                                "example_id": "ac5e6ef2-9df6-4b1b-8f56-813a89936451",
                                "sense_id": "e8e102b0-aca8-31af-92b1-fab50b029c46",
                                "text": "Vous avez reçu votre argent ? - Oui, drôlement ; je n’ai eu que des sottises."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca806903-d3b0-3a55-bcd3-e3b9d8292165",
                        "entry_id": "e7f7f503-29a8-3fca-89ce-a97556b03203",
                        "glosses": [
                            "Très, énormément."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f7dcab9a-8b88-48f6-af94-8abe5389a7b4",
                                "sense_id": "ca806903-d3b0-3a55-bcd3-e3b9d8292165",
                                "text": "Elle tordit les lèvres en une moue inquiète.\n— Mais tu es drôlement maigrichonne, dis-moi ! Regarde-toi... Tu n’as plus que la peau sur les os !\n— C'est à l'hôpital que j'ai perdu du poids, admit Michelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e3805b3-770b-3600-842b-460afa676594",
                        "entry_id": "e7f7f503-29a8-3fca-89ce-a97556b03203",
                        "glosses": [
                            "Beaucoup, très."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "573c16c6-378b-409b-9184-43029fc01e20",
                                "sense_id": "0e3805b3-770b-3600-842b-460afa676594",
                                "text": "Il a drôlement plu."
                            }
                        ]
                    }
                ],
