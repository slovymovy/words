                    {
                        "sense_id": "7c879ae7-0895-3635-8b7f-122adcc7659a",
                        "entry_id": "77f96c10-de21-3c6c-9e3b-f72cb0f8523f",
                        "glosses": [
                            "Schlafsaal in einem Kloster, Dormitorium"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "129e6fca-c036-4705-96d7-92591403c599",
                                "sense_id": "7c879ae7-0895-3635-8b7f-122adcc7659a",
                                "text": "„Zwischen den vielen Brüdern, deren Schwarm die Dormente, Kirchen und Schulsäle erfüllte, gab es zwei, von denen jeder wußte, auf die jeder achtete.“"
                            },
                            {
                                "example_id": "99cc127e-d43d-418b-b8ad-d93e740de0db",
                                "sense_id": "7c879ae7-0895-3635-8b7f-122adcc7659a",
                                "text": "„Das Dorment ist mit dem Herrenhause durch das Gebäude O verbunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
