                                                "sense_id": "144de343-70b1-3c63-b823-f93edaf23bb2",
                                                "text": "acabar com polêmicas sobre beleza e morte da 'faraoa'."
                                            },
                                            {
                                                "example_id": "04509798-a5cc-4706-8059-1ee4b74604da",
                                                "sense_id": "144de343-70b1-3c63-b823-f93edaf23bb2",
                                                "text": "Meu corpo daria um romance: narrativa desarmada"
                                            },
                                            {
                                                "example_id": "8540fa9f-86bc-4af5-b68d-a735a1c9197b",
                                                "sense_id": "144de343-70b1-3c63-b823-f93edaf23bb2",
                                                "text": "com seus olhos puxados como o de uma faraoa"
                                            },
                                            {
                                                "example_id": "f2b266ba-6032-4cc8-8958-f25461ec6e36",
                                                "sense_id": "144de343-70b1-3c63-b823-f93edaf23bb2",
                                                "text": "Um Conto De Fadas Que Não Te Contaram"
                                            },
                                            {
                                                "example_id": "1919017f-a908-4180-9662-9a61cc893f00",
                                                "sense_id": "144de343-70b1-3c63-b823-f93edaf23bb2",
