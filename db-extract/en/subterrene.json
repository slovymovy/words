                        "form": "more subterrene"
                    },
                    {
                        "form_id": "fa9ac7ba-b803-456c-a9f0-c443dc4a0e34",
                        "entry_id": "0402be2c-f188-3e8f-8a90-8cf559ed5c54",
                        "tags": [
                            "superlative"
