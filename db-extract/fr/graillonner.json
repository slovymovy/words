                "senses": [
                    {
                        "sense_id": "dc5fb13a-bcf3-3dfb-9164-734305de757d",
                        "entry_id": "66fdd2fa-e565-3c30-9195-bb8a95b9815c",
                        "glosses": [
                            "Prendre en cuisant une odeur de graillon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa820ffa-8670-43bd-9289-8d42780bebc2",
                                "sense_id": "dc5fb13a-bcf3-3dfb-9164-734305de757d",
                                "text": "Ce ragoût a graillonné."
                            }
                        ]
                    },
                    {
                        "sense_id": "d541343f-eadb-3d32-b8fd-40aa40cd6aec",
                        "entry_id": "66fdd2fa-e565-3c30-9195-bb8a95b9815c",
                        "glosses": [
                            "Faire effort pour expectorer les mucosités qui embarrassent la gorge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e6bd0c8-c6d3-48f8-8127-ce4827cb1562",
                                "sense_id": "d541343f-eadb-3d32-b8fd-40aa40cd6aec",
                                "text": "Comme on allait se mettre à table, M. Follenvie reparut, et de sa voix graillonnante il prononça: « L'officier prussien fait demander à Mlle Élisabeth Rousset si elle n'a pas encore changé d'avis. »"
                            },
                            {
                                "example_id": "db8ddbeb-3934-4e42-9cfd-9fca64b6cd37",
                                "sense_id": "d541343f-eadb-3d32-b8fd-40aa40cd6aec",
                                "text": "Bah, pour vous expliquer, graillonna-t-il, c’est plutôt dur."
                            },
                            {
                                "example_id": "c6691cf9-18ce-474e-a0a6-70a0bc25dd4a",
                                "sense_id": "d541343f-eadb-3d32-b8fd-40aa40cd6aec",
                                "text": "Les filles d’auberge, à force de tousser dans les fumées, graillonnent souvent."
                            }
                        ]
                    }
                ],
