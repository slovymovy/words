{
    "word_family": [
        "common",
        "commonality",
        "commonplace",
        "commonwealth"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b2c693ff-1835-318b-b34c-905d092e2cf1",
                    "sense_definition": "A person who does not belong to the nobility or aristocracy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king married a <w>commoner</w> instead of a princess from another country.",
                            "target_lang_translations": {
                                "zh": "国王娶了一位<w>平民</w>，而不是别国的公主。"
                            }
                        },
                        {
                            "text": "Even a <w>commoner</w> could rise to power through military service in that era.",
                            "target_lang_translations": {
                                "zh": "在那个时代，即使是<w>平民</w>也能通过服兵役获得权力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plebeian",
                        "peasant"
                    ],
                    "antonyms": [
                        "nobleman"
                    ],
                    "target_lang_definitions": {
                        "zh": "指非贵族或非显贵阶层的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "平民",
                                "target_lang_sense_clarification": "指普通百姓，与贵族相对。"
                            },
                            {
                                "target_lang_word": "庶民",
                                "target_lang_sense_clarification": "指古代社会地位较低的普通人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bc09a69-70a1-3301-9c29-4cd805999f30",
                    "sense_definition": "A university student who pays full fees and does not receive financial support from a foundation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wealthy <w>commoner</w> lived in private rooms outside the college foundation.",
                            "target_lang_translations": {
                                "zh": "这位富有的<w>自费生</w>住在学院基金会之外的私人房间里。"
                            }
                        },
                        {
                            "text": "Historical records show that the <w>commoner</w> paid all his own university charges.",
                            "target_lang_translations": {
                                "zh": "历史记录显示，这位<w>自费生</w>支付了他所有的大学费用。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在大学里自费学习、不接受基金会资助的学生。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "自费生",
                                "target_lang_sense_clarification": "指不享受奖学金或资助，完全自费的学生。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cd2b6ee-cf5d-3478-8873-43402fc9c713",
                    "sense_definition": "A person who has legal rights to use a specific piece of land, such as for grazing livestock.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "land_rights",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>commoner</w> exercised his right to graze sheep on the village green.",
                            "target_lang_translations": {
                                "zh": "当地的<w>公地使用权人</w>行使了他在村庄绿地上放羊的权利。"
                            }
                        },
                        {
                            "text": "Disputes often arose between the landowner and the <w>commoner</w> regarding land usage.",
                            "target_lang_translations": {
                                "zh": "土地所有者和<w>公地使用权人</w>之间经常因土地使用问题产生纠纷。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "拥有特定土地使用权（如放牧权）的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "公地使用权人",
                                "target_lang_sense_clarification": "指依法享有在公共土地上进行特定活动权利的人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90fdc75c-32bc-3adc-9466-a476790170f2",
                    "sense_definition": "A prostitute.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The play describes the woman as a <w>commoner</w> of the camp.",
                            "target_lang_translations": {
                                "zh": "这部剧将那个女人描述为营地里的<w>娼妓</w>。"
                            }
                        },
                        {
                            "text": "In this archaic context, the term <w>commoner</w> was used to insult her profession.",
                            "target_lang_translations": {
                                "zh": "在这种古语语境下，用“commoner”这个词是为了侮辱她的职业，即<w>娼妓</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prostitute"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literature to refer to a prostitute."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指妓女（古语用法）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "娼妓",
                                "target_lang_sense_clarification": "指从事性交易的女性，在特定语境下带有贬义。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "52250a48-01b4-3f50-bd64-8cc055fc5005",
                    "sense_definition": "The comparative form of <w>common</w>, meaning more frequent or widespread.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These types of errors are <w>commoner</w> among students who are just beginning to learn.",
                            "target_lang_translations": {
                                "zh": "这类错误在刚开始学习的学生中<w>更常见</w>。"
                            }
                        },
                        {
                            "text": "In the winter, colds are <w>commoner</w> than at any other time of the year.",
                            "target_lang_translations": {
                                "zh": "冬天感冒比一年中任何时候都<w>更常见</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Comparative adjective form."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "形容词 common 的比较级，意为更常见或更普遍。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "更常见",
                                "target_lang_sense_clarification": "表示频率更高或分布更广。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}