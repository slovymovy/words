{
    "word_family": [
        "coaxially",
        "coaxiality"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1d101fe9-27e2-3d05-8abb-4daaa2e6e4bf",
                    "sense_definition": "Having or sharing a common central axis.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "axis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician installed a <w>coaxial</w> cable to connect the television directly to the satellite dish.",
                            "target_lang_translations": {
                                "zh": "技术人员安装了一根<w>同轴</w>电缆，将电视机直接连接到卫星天线。"
                            }
                        },
                        {
                            "text": "These speakers use a <w>coaxial</w> design to improve sound clarity across different frequencies.",
                            "target_lang_translations": {
                                "zh": "这些扬声器采用<w>同轴</w>设计，以提高不同频率下的声音清晰度。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "coaxial cable"
                    ],
                    "target_lang_definitions": {
                        "zh": "共轴的；同轴的（拥有或共享同一个中心轴）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "同轴的",
                                "target_lang_sense_clarification": "最常用，指共用同一中心轴"
                            },
                            {
                                "target_lang_word": "共轴的",
                                "target_lang_sense_clarification": "几何或光学中指共享同一轴线"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7cfefb8e-0ba2-30b1-bc38-7186d8bf36e9",
                    "sense_definition": "A coaxial cable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We replaced the damaged <w>coaxial</w> to restore the high-speed internet connection.",
                            "target_lang_translations": {
                                "zh": "我们更换了受损的<w>同轴电缆</w>，以恢复高速网络连接。"
                            }
                        },
                        {
                            "text": "Several heavy <w>coaxials</w> ran along the studio floor to transmit video signals.",
                            "target_lang_translations": {
                                "zh": "演播室地板上铺设了几根粗重的<w>同轴线</w>来传输视频信号。"
                            }
                        }
                    ],
                    "synonyms": [
                        "coax"
                    ],
                    "target_lang_definitions": {
                        "zh": "同轴电缆（常简称同轴线）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "同轴电缆",
                                "target_lang_sense_clarification": "指用于传输高频信号的同轴电缆"
                            },
                            {
                                "target_lang_word": "同轴线",
                                "target_lang_sense_clarification": "口语或工程中同轴电缆的常用简称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
