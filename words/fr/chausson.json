    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "80ab3908-3976-39dc-bde9-958631887e75",
                    "sense_definition": "Chaussure d'intérieur légère et confortable, généralement sans talon dur, que l'on porte chez soi pour garder les pieds au chaud.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "chaussure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès qu'il rentre à la maison, il retire ses chaussures et enfile ses <w>chaussons</w>."
                        },
                        {
                            "text": "J'ai acheté une paire de <w>chaussons</w> très confortables pour passer les longues soirées d'hiver."
                        }
                    ],
                    "synonyms": [
                        "pantoufle",
                        "charentaise"
                    ],
                    "common_phrases": [
                        "paire de chaussons",
                        "enfiler ses chaussons"
                    ]
                },
                {
                    "sense_id": "6e959dec-c3f2-35e4-ab62-f89065e1089e",
                    "sense_definition": "Pâtisserie feuilletée repliée sur elle-même en forme de demi-lune, traditionnellement garnie de compote ou de marmelade.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "nourriture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque dimanche matin, il achète un <w>chausson</w> aux pommes tout chaud à la boulangerie."
                        },
                        {
                            "text": "Le boulanger prépare un délicieux <w>chausson</w> doré au four avec une compote fondante."
                        }
                    ],
                    "synonyms": [
                        "gosette"
                    ],
                    "common_phrases": [
                        "chausson aux pommes"
                    ]
                },
                {
                    "sense_id": "c7b605bf-c51b-3657-97ef-124daa5cad5a",
                    "sense_definition": "Chaussure légère, souple et sans talon, conçue spécifiquement pour la pratique de disciplines comme la danse ou l'escalade.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "chaussure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La danseuse ajuste les rubans de ses <w>chaussons</w> avant de monter sur scène."
                        },
                        {
                            "text": "Il a soigneusement rangé ses <w>chaussons</w> d'escalade dans son sac après l'entraînement."
                        }
                    ],
                    "common_phrases": [
                        "chaussons de danse",
                        "chaussons d'escalade"
                    ]
                },
                {
                    "sense_id": "6bb48370-36b0-3f97-98fe-1f2d9c433070",
                    "sense_definition": "Petite chaussette ou chaussure souple, souvent tricotée en laine, destinée à protéger les pieds d'un nourrisson.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "chaussure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa grand-mère a tricoté une jolie paire de <w>chaussons</w> en laine pour le nouveau-né."
                        },
                        {
                            "text": "On met souvent des petits <w>chaussons</w> aux bébés pour leur éviter d'avoir froid aux pieds."
                        }
                    ],
                    "common_phrases": [
                        "chaussons de bébé"
                    ]
                },
                {
                    "sense_id": "a790e0ea-f937-384f-9bac-bf8f948f9c07",
                    "sense_definition": "Ancien sport de combat français ancêtre de la savate et de la boxe française, utilisant principalement des coups de pied.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au dix-neuvième siècle, ce maître d'armes enseignait la pratique du <w>chausson</w> aux jeunes gens."
                        },
                        {
                            "text": "Le vieux boxeur maîtrisait aussi bien la boxe anglaise que le traditionnel jeu de <w>chausson</w>."
                        }
                    ],
                    "synonyms": [
                        "savate"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Désigne l'ancêtre historique de la boxe française"
                        }
                    ]
                }
            ]
        },
