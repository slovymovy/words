                                    {
                                        "sense_id": "b966c2c5-58d6-33f3-9557-2529c5887cfd",
                                        "entry_id": "5b022540-4078-3fd6-96bf-dbdadd5c8ec3",
                                        "glosses": [
                                            "An organized search for a criminal or enemy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a552b09d-b2a2-4125-95f8-e3d087bf3456",
                                                "sense_id": "b966c2c5-58d6-33f3-9557-2529c5887cfd",
                                                "text": "After the murderer escaped, there was a full-scale manhunt to catch him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c554d543-2c12-3b64-ad19-43010d4a70ea",
                                        "entry_id": "5b022540-4078-3fd6-96bf-dbdadd5c8ec3",
                                        "glosses": [
                                            "A variant of hide and seek in which a player who is caught by the seeker themselves becomes a seeker, and the final player remaining is declared the winner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f377e11e-dbf1-4ed7-880e-955c3199c8f2",
                                                "sense_id": "c554d543-2c12-3b64-ad19-43010d4a70ea",
                                                "text": "Manhunt is a variant of hide-and-seek, she tells me. One person is the seeker. Everyone else hides. If the seeker finds you, you become a seeker, too."
                                            }
                                        ]
                                    }
                                ]
                            }
