                "translations": [
                    {
                        "translation_id": "5a7b181d-48de-4ce5-a219-5bc91f6a46e8",
                        "source_entry_id": "1c639fd6-a2e6-3d4c-b14d-c7d6b6b6c3d0",
                        "source_sense_id": "97619436-e228-3eb7-8446-2d7f69669851",
                        "target_lang_word": "impurity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impurity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1f9caf0-a46b-3379-8bb9-d1b48b9ee74f",
                                        "entry_id": "27d945ab-d8ee-3dc5-a893-33a4679a4b66",
                                        "glosses": [
                                            "The condition of being impure; because of contamination, pollution, adulteration or insufficient purification."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7eceec55-d301-4c5e-81fd-763a3e053734",
                                                "sense_id": "d1f9caf0-a46b-3379-8bb9-d1b48b9ee74f",
                                                "text": "Even animals in the Jewish system cause impurity only when they are dead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59058ddf-a585-3446-9fff-241d94ecfa51",
                                        "entry_id": "27d945ab-d8ee-3dc5-a893-33a4679a4b66",
                                        "glosses": [
                                            "A component or additive that renders something else impure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56afd81c-595d-4858-8569-f1d0ef290ac4",
                                                "sense_id": "59058ddf-a585-3446-9fff-241d94ecfa51",
                                                "text": "The impurities in the iron ore made extraction of the iron very difficult."
                                            },
                                            {
                                                "example_id": "d2540255-667a-4f00-85bf-eba7407275a0",
                                                "sense_id": "59058ddf-a585-3446-9fff-241d94ecfa51",
                                                "text": "An artificial kidney these days still means a refrigerator-sized dialysis machine. Such devices mimic the way real kidneys cleanse blood and eject impurities and surplus water as urine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d730e686-0849-328b-9c09-89d1162eb5c9",
                                        "entry_id": "27d945ab-d8ee-3dc5-a893-33a4679a4b66",
                                        "glosses": [
                                            "A state of immorality or sin; especially the weakness of the flesh: inchastity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6498f97f-51f9-449c-bc85-fae845925ee1",
                                                "sense_id": "d730e686-0849-328b-9c09-89d1162eb5c9",
                                                "text": "With his cheating, lying and stealing, he epitomised the impurity of humanity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
