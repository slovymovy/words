                "senses": [
                    {
                        "sense_id": "390b156e-0f9a-37f3-9aee-245efe8a9b1b",
                        "entry_id": "7ee042d6-f884-3211-b9cf-715fe84a7c39",
                        "glosses": [
                            "Gomme-résine irritante extraite par incision des racines de certaines ombellifères du Caucase comme en particulier Ferula persica et Ferula szowitziana."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "695b8983-0bfd-460c-bea2-b6623ad4c387",
                                "sense_id": "390b156e-0f9a-37f3-9aee-245efe8a9b1b",
                                "text": "Gomme sagapenum ou sagapin, le cent pesant, payera 6 livres, 5 sous"
                            },
                            {
                                "example_id": "7adef773-f9f7-4c43-b782-557d70744390",
                                "sense_id": "390b156e-0f9a-37f3-9aee-245efe8a9b1b",
                                "text": "Le sagapénum était connu des anciens et figure dans plusieurs médicaments composés qu'ils nous ont laissés. Comme l'assa-foetida , il est recueilli en Perse, en Médie, en Arabie, etc. Il se présente en masses et rarement en larmes ; il est mou demi transparent, d'une couleur plus foncée que celle du galbnum ; …."
                            },
                            {
                                "example_id": "edb31e54-517f-42d3-b078-d14ff97283e5",
                                "sense_id": "390b156e-0f9a-37f3-9aee-245efe8a9b1b",
                                "text": "Les sagapénums de Perse se sont comportés vis à vis des réactifs comme les galbanums de Perse, et les sagapénums du Levant comme les galbanums du Levant."
                            }
                        ]
                    }
                ],
