                                        "examples": [
                                            {
                                                "example_id": "5eed3335-2b34-42f0-857c-88d84316c83a",
                                                "sense_id": "50ccfc65-0ab7-36e3-9118-5ad8478108fb",
                                                "text": "Oh, great! I just dumped all 500 sheets of the manuscript all over and now I have to put them back in order."
