                                    {
                                        "sense_id": "163736df-b80d-3cbf-b8da-bbb44d9ee477",
                                        "entry_id": "bf8dafe5-e551-3bbb-8f39-821dfc18451a",
                                        "glosses": [
                                            "Polyèdre convexe possédant douze faces carrées régulières, huit faces hexagonales régulières et six faces octogonales régulières."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40386295-48ed-402d-bc7a-389c57476cd5",
                                                "sense_id": "163736df-b80d-3cbf-b8da-bbb44d9ee477",
                                                "text": "Premier solide à trois sortes de faces, le cuboctaèdre tronqué de Kepler, autrement dit l’icosihexahèdre, formé de 12 carrés, 6 octogones et 8 hexagones, coupe faite dans l’octaèdre."
                                            }
                                        ]
                                    }
                                ]
