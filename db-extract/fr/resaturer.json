                "senses": [
                    {
                        "sense_id": "0aee93d2-0677-3075-8811-549378ee090d",
                        "entry_id": "87dfdd54-2788-3c8c-9833-1f34cca49d84",
                        "glosses": [
                            "Saturer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82440e8d-54a4-4098-90c7-af99b3f4649d",
                                "sense_id": "0aee93d2-0677-3075-8811-549378ee090d",
                                "text": "Celui-ci n'apparaît que si le réservoir profond n'est pas plein et si la pluie tombée lors d'un épisode donné ne permet pas de le resaturer."
                            },
                            {
                                "example_id": "55a3633e-c067-4227-92a2-1b08d6aa76a5",
                                "sense_id": "0aee93d2-0677-3075-8811-549378ee090d",
                                "text": "Comme ce qui a été dissous va permettre de construire le cristal, il faudra régulièrement compléter et resaturer la solution."
                            },
                            {
                                "example_id": "02aa650d-02bf-47be-ac47-89f7488c516a",
                                "sense_id": "0aee93d2-0677-3075-8811-549378ee090d",
                                "text": "Peut-on resaturer une couleur?"
                            }
                        ]
                    }
