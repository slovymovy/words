                "senses": [
                    {
                        "sense_id": "97add3ba-6e9a-31fa-962a-ebe75b905cf4",
                        "entry_id": "c3404c76-74e8-318b-bbe8-f0393e353da8",
                        "glosses": [
                            "Tourner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0afe5ca-3291-4fe4-adf2-7c5c55f2626b",
                                "sense_id": "97add3ba-6e9a-31fa-962a-ebe75b905cf4",
                                "text": "Enfin si, y’a moyen de le faire tournoter quand même, et je crois même pas mal en ng."
                            },
                            {
                                "example_id": "5fc5cf11-14dc-45b6-9b3e-42a9b16e2843",
                                "sense_id": "97add3ba-6e9a-31fa-962a-ebe75b905cf4",
                                "text": "Effectivement, ça ne fait pas très \"frime\" de tournoter sur des pistes bleues pour travailler notamment le placement du bassin, la reprise de carres, etc ... mais c’est souvent les bases qui pèchent."
                            },
                            {
                                "example_id": "c6a6d2bb-3161-45a8-ab37-c428c6c012d9",
                                "sense_id": "97add3ba-6e9a-31fa-962a-ebe75b905cf4",
                                "text": "Mais tout cela, c’est l’histoire de se tournoter, de viroter, de présenter sa jeunesse nerveuse…"
                            }
                        ]
                    }
