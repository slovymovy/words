                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b33d618-59fd-45b6-9898-79dec3f57d9b",
                                                "sense_id": "065623cf-71ac-3fa1-bb95-993c30fa9a4d",
                                                "text": "You use ta give a good meetin'. I recollect one time you give a whole sermon walkin' around on your hands, yellin' your head off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "399a6a82-1404-396b-8751-7012c84152ae",
