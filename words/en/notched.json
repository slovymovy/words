{
    "word_family": [
        "notch",
        "notcher"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b6edd2b9-12dc-3670-ad57-52482fcd6a26",
                    "sense_definition": "Having small cuts, indentations, or V-shaped marks along an edge or surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>notched</w> edge of the leaf helped the botanist identify the plant species.",
                            "target_lang_translations": {
                                "cs": "<w>Zubatý</w> okraj listu pomohl botanikovi identifikovat druh rostliny."
                            }
                        },
                        {
                            "text": "He used a <w>notched</w> stick to keep track of the days he spent in the forest.",
                            "target_lang_translations": {
                                "cs": "Používal <w>vrubovanou</w> hůl, aby si udržel přehled o dnech strávených v lese."
                            }
                        }
                    ],
                    "synonyms": [
                        "serrated",
                        "jagged",
                        "indented",
                        "nicked"
                    ],
                    "antonyms": [
                        "flat",
                        "smooth",
                        "straight",
                        "unnotched"
                    ],
                    "common_phrases": [
                        "notched edge",
                        "notched stick"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající malé zářezy, vtisky nebo značky ve tvaru V podél okraje nebo povrchu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zubatý",
                                "target_lang_sense_clarification": "mající okraj s výstupky nebo zářezy"
                            },
                            {
                                "target_lang_word": "vrubovaný",
                                "target_lang_sense_clarification": "mající vyřezané zářezy nebo vrypy"
                            },
                            {
                                "target_lang_word": "ozubený",
                                "target_lang_sense_clarification": "mající tvar zubů nebo zářezů"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d65ee97a-e884-38fc-868d-9e5981814df8",
                    "sense_definition": "Simple past and past participle of <w>notch</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter <w>notched</w> the wooden beam to ensure a perfect fit for the joint.",
                            "target_lang_translations": {
                                "cs": "Tesař <w>vyřízl</w> do dřevěného trámu zářez, aby zajistil dokonalé spojení."
                            }
                        },
                        {
                            "text": "She has <w>notched</w> several victories in her career as a professional athlete.",
                            "target_lang_translations": {
                                "cs": "Během své kariéry profesionální sportovkyně si <w>připsala</w> několik vítězství."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Minulý čas a příčestí minulé slovesa notch (vyříznout, udělat zářez)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vyřízl",
                                "target_lang_sense_clarification": "vytvořil zářez do materiálu"
                            },
                            {
                                "target_lang_word": "zaznamenal",
                                "target_lang_sense_clarification": "dosáhl úspěchu nebo si připsal výsledek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}