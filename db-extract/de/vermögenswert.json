                    {
                        "sense_id": "f3a4e6c1-f696-31dc-bf21-efd64d85f4e5",
                        "entry_id": "9e8f56a0-872e-324c-b884-d80f774bad57",
                        "glosses": [
                            "Finanz- oder Sachwert als Teil eines Vermögens"
                        ],
                        "tags": [
                            "finance"
                        ],
                        "examples": [
                            {
                                "example_id": "5ed52cdc-79ae-4257-80eb-370883953f7e",
                                "sense_id": "f3a4e6c1-f696-31dc-bf21-efd64d85f4e5",
                                "text": "Ihr kleines Einfamilienhaus ist der einzige Vermögenswert, den meine Tante besitzt."
                            },
                            {
                                "example_id": "e6aabac9-2626-4e12-a752-e31b04e48000",
                                "sense_id": "f3a4e6c1-f696-31dc-bf21-efd64d85f4e5",
                                "text": "Obwohl die Firma viele ihrer Vermögenswerte veräußerte, konnte die Insolvenz nicht verhindert werden."
                            },
                            {
                                "example_id": "a56d45e0-bc2a-4a88-b181-43bfcb8412d3",
                                "sense_id": "f3a4e6c1-f696-31dc-bf21-efd64d85f4e5",
                                "text": "Der Betrüger Paul Müller wurde zu einer Gefängnisstrafe verurteilt und seine illegal erworbenen Vermögenswerte wurden eingezogen."
                            },
                            {
                                "example_id": "5da25e78-5ac4-464d-874d-009763d012ad",
                                "sense_id": "f3a4e6c1-f696-31dc-bf21-efd64d85f4e5",
                                "text": "„Daß Ausländer Vermögenswerte deponierten, war ihm nichts Neues.“"
                            },
                            {
                                "example_id": "dbdbfa1c-3f16-46f6-8832-1a5ed16eccba",
                                "sense_id": "f3a4e6c1-f696-31dc-bf21-efd64d85f4e5",
                                "text": "„Der ehemalige US-Präsident Trump hat im Prozess um manipulierte Vermögenswerte die vom Gericht neu festgelegte Kaution über 175 Millionen Dollar hinterlegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
