                "senses": [
                    {
                        "sense_id": "ae80661b-400b-36c7-894a-ea927737d495",
                        "entry_id": "7854510b-0bfe-3e8d-82ef-df116859daf0",
                        "glosses": [
                            "давя или нажимая, оставлять след, отпечаток, оттиск на чём-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7539dced-5fa0-4554-88ba-ee3e94360b59",
                                "sense_id": "ae80661b-400b-36c7-894a-ea927737d495",
                                "text": "В случае надобности он вынимал из жилетного кармана печатку и, любовно дохнув на неё, оттискивал против титула сиреневое факсимиле."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe5dde91-c14a-34c6-a604-baf395458d86",
                        "entry_id": "7854510b-0bfe-3e8d-82ef-df116859daf0",
                        "glosses": [
                            "отпечатывать что-либо типографским способом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bfcc460-0098-4f5d-80bf-8b489fae2694",
                                "sense_id": "fe5dde91-c14a-34c6-a604-baf395458d86",
                                "text": "Происхождение же нашей гравюры — техническое: намазывая резьбу краской, оттискивали изображение на бумаге, — получился эстамп."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba026375-130b-3d93-9a34-78685e1400ab",
                        "entry_id": "7854510b-0bfe-3e8d-82ef-df116859daf0",
                        "glosses": [
                            "то же, что оттеснять"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2b4d814-59a8-498d-ab86-18a73dd99e78",
                                "sense_id": "ba026375-130b-3d93-9a34-78685e1400ab",
                                "text": "Чиновников обожатели оттискивали от окон кареты, а одного чиновника, более ревностного, вывалили из дрожек в грязь."
                            }
                        ]
                    }
                ],
