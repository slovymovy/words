                    },
                    {
                        "translation_id": "8bf6b4d2-b734-407c-98ce-be404e2de4f6",
                        "source_entry_id": "d43be52c-8497-30a2-abdb-b3d5e6ef04c4",
                        "source_sense_id": "9eab3d9d-ba93-32a8-92e7-00a6e2a02b20",
                        "target_lang_word": "reinvest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reinvest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4de6808-e9ab-33d6-90dd-2c2d40a56634",
                                        "entry_id": "33f116ee-72d7-3b85-99eb-a6ae178b72d1",
                                        "glosses": [
                                            "To invest again, give another investment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6561d17-bcd8-46ae-9af8-026cb04b5b9e",
                                                "sense_id": "e4de6808-e9ab-33d6-90dd-2c2d40a56634",
                                                "text": "Jeff Bezos, Amazon's founder and CEO, has traditionally focused on reinvesting all (or almost all) profits back into big bets like fulfillment centers, hardware, video streaming and cloud computing.\nWhen Amazon chooses to turn the knobs slightly down on how much it reinvests and posts a slight profit, investors cheer."
                                            },
                                            {
                                                "example_id": "bee3ee3e-203f-42da-9124-03435fe82b40",
                                                "sense_id": "e4de6808-e9ab-33d6-90dd-2c2d40a56634",
                                                "text": "Ideally when you harvest a tax loss you will immediately reinvest the money from the sale into an asset that is similar but not “substantially identical” to maintain the same exposure to a sector or asset class."
                                            },
                                            {
                                                "example_id": "add4de00-a4b2-463b-a186-6d0f4e3fa685",
                                                "sense_id": "e4de6808-e9ab-33d6-90dd-2c2d40a56634",
                                                "text": "Quarterly or annual dividend payments provide good income streams for investors who need cash in the short-term. And for those playing the longer game, dividends can be reinvested to buy even more shares in those same companies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
