                "senses": [
                    {
                        "sense_id": "583e1c52-3908-3576-a634-9b3c51a51a92",
                        "entry_id": "1f1f660b-c668-3f4d-99d9-43cf0b444934",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным злодей; свойственный, характерный для него"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1ac9ea9-7c37-4483-abb0-3bfe862c744c",
                                "sense_id": "583e1c52-3908-3576-a634-9b3c51a51a92",
                                "text": "Запоручат меня да молодешеньку, // Запоручат да меня за поруки за крепкие, // За рамки за железные, на житье меня вековечное, // На злодейское житье да замужнее?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
