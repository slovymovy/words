                ],
                "senses": [
                    {
                        "sense_id": "52d2017a-cd5e-3a7f-a29c-2f270ac23d7e",
                        "entry_id": "33d04ce3-1cf7-3027-818c-61b822989de4",
                        "glosses": [
                            "die Einhaltung von Verhaltensmaßregeln, Gesetzen und Richtlinien durch Unternehmen und deren Mitarbeiter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0feaad79-3ac5-40eb-bcc6-49eb0f75d641",
                                "sense_id": "52d2017a-cd5e-3a7f-a29c-2f270ac23d7e",
                                "text": "Compliance in der Wirtschaft bedeutet, sich bei sämtlichen wirtschaftlichen Aktivitäten an geltendes Recht zu halten."
                            },
                            {
                                "example_id": "f6a2b005-ba37-46ae-875a-bc5a2b5e7e86",
                                "sense_id": "52d2017a-cd5e-3a7f-a29c-2f270ac23d7e",
                                "text": "„Lange Zeit mischten europäische Firmen hier fleißig mit, erst seit einigen Jahren hat sich in den Unternehmen eine strengere Compliance durchgesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3ecb87e1-0194-389a-b8ca-a3b2500829ab",
                        "entry_id": "33d04ce3-1cf7-3027-818c-61b822989de4",
                        "glosses": [
                            "die Einhaltung von Verhaltensmaßregeln, Gesetzen und Richtlinien durch den Patienten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7505af28-61c5-4d86-a068-18750703d516",
                                "sense_id": "3ecb87e1-0194-389a-b8ca-a3b2500829ab",
                                "text": "Die sogenannte Compliance, das Maß und die Bereitschaft eines Patienten, diagnostische und therapeutische Vorgaben zu befolgen, ist um so ausgeprägter, je besser der Patient über die eigene Situation orientiert ist."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "bbeb7257-b5ca-3a84-a561-d3594730543d",
                        "entry_id": "33d04ce3-1cf7-3027-818c-61b822989de4",
                        "glosses": [
                            "ein Maß für die Dehnbarkeit von Körperstrukturen wie z. B. die Lunge"
                        ],
                        "tags": [
                            "Physiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "3506bcd0-6905-4a85-8a38-8f498da1d8b5",
                                "sense_id": "bbeb7257-b5ca-3a84-a561-d3594730543d",
                                "text": "„Das Verständnis von der Compliance einer Lunge ist […] dann von Bedeutung, wenn künstlich beatmet werden muss.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
