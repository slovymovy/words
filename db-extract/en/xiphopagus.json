    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e7919735-9bf0-3d87-8953-2eb761e8e7e8",
                "word": "xiphopagus",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d1076d13-24c6-3c3d-ba32-852cefa4d8a2",
                        "entry_id": "e7919735-9bf0-3d87-8953-2eb761e8e7e8",
                        "glosses": [
                            "United at the xiphoid process."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "24c21b46-8861-4fe4-bfcb-db98f31dfa83",
                                "sense_id": "d1076d13-24c6-3c3d-ba32-852cefa4d8a2",
                                "text": "Of particular interest in the Section on Obstetrics is the detailed article touching on the xiphopagus twins Radica and Doodica."
                            },
                            {
                                "example_id": "3d12398a-331b-4b36-9677-f0eb85876c3b",
                                "sense_id": "d1076d13-24c6-3c3d-ba32-852cefa4d8a2",
                                "text": "This type of anomaly, along with the xiphopagus type, is especially compatible with survival."
                            },
                            {
                                "example_id": "eb0a2920-edfc-4959-b96b-e0b01fedc9cf",
                                "sense_id": "d1076d13-24c6-3c3d-ba32-852cefa4d8a2",
                                "text": "Second, a discordant presentation does not preclude the diagnosis of conjoined twins, particularly in xiphopagus twins."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "9197b2c9-7dac-4f7e-aad5-715301c4bf34",
                        "source_entry_id": "e7919735-9bf0-3d87-8953-2eb761e8e7e8",
                        "source_sense_ids": [
                            "d1076d13-24c6-3c3d-ba32-852cefa4d8a2"
                        ],
                        "linkage_type": "synonyms",
                        "word": "xiphopagic"
                    }
                ]
            },
            {
                "entry_id": "c8c34bd5-6447-39f1-a5aa-4e7097abe1a6",
                "word": "xiphopagus",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "baff183b-0ddf-4626-8d02-26824f4822bf",
                        "entry_id": "c8c34bd5-6447-39f1-a5aa-4e7097abe1a6",
                        "tags": [
                            "plural"
                        ],
                        "form": "xiphopagi"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f8ab3190-39b3-3bac-8687-c0077aedac48",
                        "entry_id": "c8c34bd5-6447-39f1-a5aa-4e7097abe1a6",
                        "glosses": [
                            "Either of a pair of congenitally joined twins (Siamese twin) united at the xiphoid process."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "ec1c0dd1-6420-4883-a8cc-087915041da8",
                                "sense_id": "f8ab3190-39b3-3bac-8687-c0077aedac48",
                                "text": "Xiphopagi are those in which the ensiform processes are united by a cartilaginous bridge. The peritoneum passes for some distance into the connecting structure (the well-known Siamese twins were xiphopagi)."
                            },
                            {
                                "example_id": "c597faff-ba51-4075-aded-567ee38818ce",
                                "sense_id": "f8ab3190-39b3-3bac-8687-c0077aedac48",
                                "text": "Dr. Chapot-Prevost, who successfully operated upon the only other living xiphopagus, has just published a report of his examination of the new living Chinese twins, Liou-Tang-Sen and Liou-Seng-Sen."
                            },
                            {
                                "example_id": "a2a9b620-0628-49c8-bf95-94d06fdb894e",
                                "sense_id": "f8ab3190-39b3-3bac-8687-c0077aedac48",
                                "text": "In the case of a xiphopagus, there is most commonly only a band-like union in the region of the xiphoid process of the sternum."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f2700fc-5237-3155-b700-22cb5c6fbb8e",
                        "entry_id": "c8c34bd5-6447-39f1-a5aa-4e7097abe1a6",
                        "glosses": [
                            "The condition of being such a twin."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "88668049-da4e-49e1-a0b1-0e82aec70e03",
                                "sense_id": "4f2700fc-5237-3155-b700-22cb5c6fbb8e",
                                "text": "They were born in the East Indies, and make the eighth case of xiphopagus reported."
                            },
                            {
                                "example_id": "78be51b9-c162-4604-884c-7174f58cf664",
                                "sense_id": "4f2700fc-5237-3155-b700-22cb5c6fbb8e",
                                "text": "The common twin types include thoracopagus, xiphopagus or omphalopagus, pygopagus, ischiopagus, and craniopagus."
                            },
                            {
                                "example_id": "3cbca081-e3c6-4ae8-89b1-355ef52e13e9",
                                "sense_id": "4f2700fc-5237-3155-b700-22cb5c6fbb8e",
                                "text": "Thoracopagus is the most common type of conjoined twinning and, along with omphalopagus/xiphopagus, represents about 75% of reported cases."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
