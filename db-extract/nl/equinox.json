            {
                "entry_id": "eda50378-e5c1-3327-adc6-ad6da5192196",
                "word": "equinox",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "4b921c11-3ec2-4f8f-94da-29653f06c025",
                        "entry_id": "eda50378-e5c1-3327-adc6-ad6da5192196",
                        "tags": [
                            "plural"
                        ],
                        "form": "equinoxen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b5747fbe-dc6c-3412-aea8-e9ced2e52322",
                        "entry_id": "eda50378-e5c1-3327-adc6-ad6da5192196",
                        "glosses": [
                            "het moment dat de zon het denkbeeldige vlak van de evenaar in zuidelijke of noordelijke richting passeert, de nacht duurt dan evenlang als de dag (nachtevening)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82fb42c1-33d7-4c2b-aeaf-a24dc1a11c77",
                                "sense_id": "b5747fbe-dc6c-3412-aea8-e9ced2e52322",
                                "text": "Bij het lente- en herfstpunt is er sprake van equinox."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b604cb6-9cd5-4a71-aa4d-13aac93ad377",
                        "source_entry_id": "eda50378-e5c1-3327-adc6-ad6da5192196",
                        "source_sense_id": "b5747fbe-dc6c-3412-aea8-e9ced2e52322",
                        "source_sense_description": "passage van de zon door het vlak van de evenaar",
                        "target_lang_word": "Äquinoktium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Äquinoktium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b38b0582-a0bf-3170-84af-ee3a366eb8df",
                                        "entry_id": "13e9cb4b-4395-31f9-8414-195feb542f8b",
                                        "glosses": [
                                            "Schnittpunkt der Ekliptik mit dem Himmelsäquator"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a59d8ae3-a1a7-49ed-a365-ddbdb23ca9ce",
                                                "sense_id": "b38b0582-a0bf-3170-84af-ee3a366eb8df",
                                                "text": "„Dabei durchläuft die Sonne um den 21. März und den 23. September die Schnittpunkte der Ekliptik mit dem Himmelsäquator; es ist dies die Zeit der Tagundnachtgleichen (Äquinoktien), die beiden Schnittpunkte werden Frühlings- und Herbstpunkt genannt.“"
                                            },
                                            {
                                                "example_id": "6c859f84-ef00-408b-8f9d-05d4ecaebf14",
                                                "sense_id": "b38b0582-a0bf-3170-84af-ee3a366eb8df",
                                                "text": "„Diese Stürme entstehen während der Äquinoktien sehr häufig und werden auf der weiten Fläche des Ozeans durch nichts aufgehalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0b3fa3d5-e238-398e-ade6-50af26258bd0",
                                        "entry_id": "13e9cb4b-4395-31f9-8414-195feb542f8b",
                                        "glosses": [
                                            "der Zeitpunkt, an dem für alle Orte auf der Erde Tag und Nacht gleich lang sind, weil die Sonne in [1] steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80d9314f-87eb-46ef-9594-16e76a4ee63e",
                                                "sense_id": "0b3fa3d5-e238-398e-ade6-50af26258bd0",
                                                "text": "„Damit ist er wie der Frühlingsbeginn am 21. März ein Äquinoktium, auch Tag-Nacht-Gleiche genannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d801466-5ea2-40d2-b6d2-e4498294af3a",
                        "source_entry_id": "eda50378-e5c1-3327-adc6-ad6da5192196",
                        "source_sense_id": "b5747fbe-dc6c-3412-aea8-e9ced2e52322",
                        "source_sense_description": "passage van de zon door het vlak van de evenaar",
                        "target_lang_word": "equinox",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "equinox",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d2a6f75-c65b-3451-aba6-294fb40ded26",
                                        "entry_id": "fd41fce6-30d2-3320-99ab-e0bff00f24ea",
                                        "glosses": [
                                            "One of two times in the year (one in March and the other in September) when the length of the day and the night are equal, which occurs when the sun is directly overhead at the equator; this marks the beginning of spring in one hemisphere and autumn in the other."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85c7cfb1-977d-4c2f-8191-62c812421cbe",
                                                "sense_id": "3d2a6f75-c65b-3451-aba6-294fb40ded26",
                                                "text": "[T]he Months of March and September, the tvvo Æquinoxes of Our year, are the moſt vvindy and tempeſtuous, the moſt unſettled and unequable of Seaſons in moſt Countries of the VVorld."
                                            },
                                            {
                                                "example_id": "7bcb2648-b583-44b2-9b9e-f156232a0400",
                                                "sense_id": "3d2a6f75-c65b-3451-aba6-294fb40ded26",
                                                "text": "The four grand and ſolemn Bardic days are, of ancient uſage, the tvvo equinoxes, and the tvvo ſolſtices; the nevv and full moons are alſo, ſubordinately, ſolemn Bardic days: […]"
                                            },
                                            {
                                                "example_id": "30627e53-1527-4aee-a241-1045ab228fcb",
                                                "sense_id": "3d2a6f75-c65b-3451-aba6-294fb40ded26",
                                                "text": "[H]e [Milton] believed, his poetic vein only flowed from the autumnal to the vernal equinox; and, in his essay on Education, he doubts whether, in the fine days of spring, any study can be accomplished by young men."
                                            },
                                            {
                                                "example_id": "6bc65e79-5552-47e6-8623-3e25b1c08fe2",
                                                "sense_id": "3d2a6f75-c65b-3451-aba6-294fb40ded26",
                                                "text": "Live long, nor feel in head or chest / Our changeful equinoxes, / Till mellow Death, like some late guest, / Shall call thee from the boxes."
                                            },
                                            {
                                                "example_id": "098bf1db-5251-4ce4-8396-ae931aeede4b",
                                                "sense_id": "3d2a6f75-c65b-3451-aba6-294fb40ded26",
                                                "text": "21. Report the experiments, if conveniently they may, at both the solstices and equinoctes. / 22. Observe accurately the time of the sun’s rising on the top of the hill and below, and note the difference."
                                            },
                                            {
                                                "example_id": "580653df-7151-48af-820b-6b80baf32e4f",
                                                "sense_id": "3d2a6f75-c65b-3451-aba6-294fb40ded26",
                                                "text": "For [Julius] Cæsar says, that on the night of the fourth day after his landing there was a full moon. He had before mentioned that the summer was far spent, and the æquinox not come, hence, the full moon must have been either in July or August."
                                            },
                                            {
                                                "example_id": "00d3deb4-82fd-4ff2-9441-4c1713298d68",
                                                "sense_id": "3d2a6f75-c65b-3451-aba6-294fb40ded26",
                                                "text": "The word equinox is generally taken to refer to the days when, at every point on the earth, day and night are of equal length. But this definition of the equinox is a bit misleading. Since it gets light before the sun rises and remains light after the sun sets, the actual period of darkness at the equinox will be substantially less than twelve hours, the exact amount depending on latitude and how one defines the boundary between twilight and night. […] In practice, one cannot determine the equinox by measuring the length of time between sunrise and sunset."
                                            },
                                            {
                                                "example_id": "3693ae39-679e-41a3-92bb-71e0628c1abf",
                                                "sense_id": "3d2a6f75-c65b-3451-aba6-294fb40ded26",
                                                "text": "[…] Midsummer’s Day falls near the beginning of summer meteorologically, but was the midpoint of summer in the traditional calendar. Though Midsummer’s Day celebrations are common in the modern Celtic countries, there is no evidence that the ancient Celts celebrated either the solstices or the equinoctes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8e357a5-1545-3454-8968-5a905805859c",
                                        "entry_id": "fd41fce6-30d2-3320-99ab-e0bff00f24ea",
                                        "glosses": [
                                            "The circumstance of a twenty-four hour time period having the day and night of equal length."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30162b8b-35eb-44d1-bef2-e106673673ea",
                                                "sense_id": "f8e357a5-1545-3454-8968-5a905805859c",
                                                "text": "[D]oe but ſee his vice, / Tis to his vertue, a iuſt equinox, / The one as long as th'other: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "873c1cc8-daef-302e-94d0-18714dd90bd1",
                                        "entry_id": "fd41fce6-30d2-3320-99ab-e0bff00f24ea",
                                        "glosses": [
                                            "One of the two points in space where the apparent path of the Sun intersects with the equatorial plane of the Earth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6aad45eb-7a72-3b78-a0df-99bc760dd8ab",
                                        "entry_id": "fd41fce6-30d2-3320-99ab-e0bff00f24ea",
                                        "glosses": [
                                            "A gale (“very strong wind”) once thought to occur more frequently around the time of an equinox (sense 1), now known to be a misconception; an equinoctial gale."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2b2ebaf-e8fd-48f3-a18a-1cdf85cd7921",
                                                "sense_id": "6aad45eb-7a72-3b78-a0df-99bc760dd8ab",
                                                "text": "The paſſage yet vvas good, the vvind, 'tis true, / VVas ſomevvhat high, but that vvas nothing nevv, / Nor more than uſual Equinoxes blevv."
                                            },
                                            {
                                                "example_id": "364e7b15-c82d-4398-9d4c-873e91a8e11f",
                                                "sense_id": "6aad45eb-7a72-3b78-a0df-99bc760dd8ab",
                                                "text": "The Equinox drove the sand into their faces or round their legs, as they dived among the sheep-haunted hollows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9453a00c-869d-35c8-979d-88c6670bb41d",
                                        "entry_id": "fd41fce6-30d2-3320-99ab-e0bff00f24ea",
                                        "glosses": [
                                            "A celestial equator (“great circle on the celestial sphere, coincident with the plane of the Earth's equator (the equatorial plane)”); also, the Earth's equator."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96019198-2338-4b50-ba50-fe1bb74c7ec1",
                                                "sense_id": "9453a00c-869d-35c8-979d-88c6670bb41d",
                                                "text": "[T]hey [seals] are over all the American Coaſt of the South Seas, from Terra del Fuego, up to the Equinoctial Line: but to the North of the Equinox again, in theſe Sea, I never ſavv any, till as far as 21 North Lat[itude]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81858862-8c9a-4916-8475-2ce0a31c2c75",
                        "source_entry_id": "eda50378-e5c1-3327-adc6-ad6da5192196",
                        "source_sense_id": "b5747fbe-dc6c-3412-aea8-e9ced2e52322",
                        "source_sense_description": "passage van de zon door het vlak van de evenaar",
                        "target_lang_word": "équinoxe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "équinoxe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b087b22-d1ee-3f15-95a3-a98ae12735a4",
                                        "entry_id": "5bb45e81-b685-3fe3-b430-18c5123ed77f",
                                        "glosses": [
                                            "Instant où le Soleil traverse le plan de l’équateur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0f1d17f-b588-4946-b78f-ec7edb682955",
                                                "sense_id": "8b087b22-d1ee-3f15-95a3-a98ae12735a4",
                                                "text": "Le point de l'équinoxe vernal est aussi nommé plus simplement point vernal ou point gamma."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3b86746-fcb7-3edf-8580-75ce77569323",
                                        "entry_id": "5bb45e81-b685-3fe3-b430-18c5123ed77f",
                                        "glosses": [
                                            "Période où, le Soleil passant par l’équateur céleste, les jours deviennent sensiblement égaux aux nuits pour toutes les régions de la Terre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6dac5d2-907b-4348-8b8d-d6ee26006a6e",
                                                "sense_id": "f3b86746-fcb7-3edf-8580-75ce77569323",
                                                "text": "L'équinoxe de printemps."
                                            },
                                            {
                                                "example_id": "8840c5c3-dc1a-469b-9c78-7a54cfa4da4d",
                                                "sense_id": "f3b86746-fcb7-3edf-8580-75ce77569323",
                                                "text": "Les marées d'équinoxe."
                                            },
                                            {
                                                "example_id": "eac05381-ac6a-47b2-b753-05c197402082",
                                                "sense_id": "f3b86746-fcb7-3edf-8580-75ce77569323",
                                                "text": "[…] et j’affirmerais presque que dans quinze jours, au 22 septembre, en plein équinoxe, c’est-à-dire au moment même où le phénomène atteindra son maximum, le déplacement des eaux ne dépassera pas un pied et demi sur les rivages du cap Bathurst."
                                            },
                                            {
                                                "example_id": "428bd683-e25b-42de-bd33-994757c57bf2",
                                                "sense_id": "f3b86746-fcb7-3edf-8580-75ce77569323",
                                                "text": "Mais sitôt que commencent les pluies de l’équinoxe d’automne, dès que le froid se fait sentir, ces populations nomades se dispersent."
                                            },
                                            {
                                                "example_id": "4d602d70-b04f-4bed-820b-0c585b2abdc8",
                                                "sense_id": "f3b86746-fcb7-3edf-8580-75ce77569323",
                                                "text": "L’an premier dut commencer le 22 septembre 1792, jour de proclamation de la République et en même temps de l’équinoxe d’automne."
                                            },
                                            {
                                                "example_id": "a82aa55b-ca5c-4c75-ab82-5292371a6ac4",
                                                "sense_id": "f3b86746-fcb7-3edf-8580-75ce77569323",
                                                "text": "Elles arrivaient de loin, comme ces oiseaux de mer que la tempête chasse vers la côte, au temps de l’équinoxe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c578f212-46be-479e-8504-344be0dd42d4",
                        "source_entry_id": "eda50378-e5c1-3327-adc6-ad6da5192196",
                        "source_sense_id": "b5747fbe-dc6c-3412-aea8-e9ced2e52322",
