                "senses": [
                    {
                        "sense_id": "19964d56-cfc5-3d18-b89f-c3a7a7b8e2ca",
                        "entry_id": "8bb27322-9a4a-3765-ace3-9a25288eb3b7",
                        "glosses": [
                            "Naturkonstante, die nach Johannes Rydberg benannt wurde und zur Berechnung von Atomspektren verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07ea361c-0498-4550-a0d7-22154daa7160",
                                "sense_id": "19964d56-cfc5-3d18-b89f-c3a7a7b8e2ca",
                                "text": "„Bohrs erster Ansatz eleminierte sogar einen theoretischen Term, die Rydbergkonstante.“"
                            },
                            {
                                "example_id": "1ae4355c-95bb-4524-9eb8-69dda9736f6f",
                                "sense_id": "19964d56-cfc5-3d18-b89f-c3a7a7b8e2ca",
                                "text": "„Wie groß sind (a) die Ionisierungsenergie dieses Zustands und (b) die Rydbergkonstante?“"
                            },
                            {
                                "example_id": "03d04cbe-fc8b-4b4c-9305-198cdc546891",
                                "sense_id": "19964d56-cfc5-3d18-b89f-c3a7a7b8e2ca",
                                "text": "„Der Grenzwert der Lyman-Serie entspricht der Frequenz der Rydbergkonstante für Wasserstoff.“"
                            },
                            {
                                "example_id": "02851ac4-0bf9-400e-874e-cb872e5af0f3",
                                "sense_id": "19964d56-cfc5-3d18-b89f-c3a7a7b8e2ca",
                                "text": "„Die Rydbergkonstante des schweren Wasserstoffs liegt zwischen der des leichten Wasserstoffs und der des Heliums.“"
                            },
                            {
                                "example_id": "e6dd7e08-636e-4516-8bb3-2bd8bb8285ae",
                                "sense_id": "19964d56-cfc5-3d18-b89f-c3a7a7b8e2ca",
                                "text": "„Und eine Naturkonstante müsste ein wenig geändert werden – die sogenannte Rydbergkonstante, die bei der Berechnung und Messung von Wasserstoffspektren eine zentrale Rolle spielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
