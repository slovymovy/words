                ],
                "senses": [
                    {
                        "sense_id": "dc0b43cd-e6b1-3397-b178-b1aeda16be19",
                        "entry_id": "47ce6baa-a8fd-381a-b172-f4dc365b173a",
                        "glosses": [
                            "Qui suit, qui vient après."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b3f6bab-b8d2-43e5-b52e-301667f6005b",
                                "sense_id": "dc0b43cd-e6b1-3397-b178-b1aeda16be19",
                                "text": "Des décrets du premier Empire et une loi de la Restauration, aggravés par d’autres décrets subséquents, avaient livré la France à une invasion monacale plus ancienne, qui l’avait couverte d’un flot dévastateur de 914 congrégations."
                            },
                            {
                                "example_id": "ba50d992-8960-4291-b8c0-cb9028bfca12",
                                "sense_id": "dc0b43cd-e6b1-3397-b178-b1aeda16be19",
                                "text": "[…] : celles-ci sont, ou d’un blanc pur, ou présentent des traces de coloration qui leur avait été donnée une première fois et qu’un blanchiment subséquent a fait disparaître."
                            },
                            {
                                "example_id": "2cab2554-6e0b-42b4-bd6d-3ffa1b9ebb01",
                                "sense_id": "dc0b43cd-e6b1-3397-b178-b1aeda16be19",
                                "text": "Au cours d’une escale à Délos que n’encombrait pas encore le tourisme organisé, le jeune voyageur erra le soir dans un bois de lauriers, presque assurément abattu depuis au cours de subséquentes campagnes de fouilles."
                            },
                            {
                                "example_id": "3a43cfb4-74d2-44be-b941-8dffd845fd45",
                                "sense_id": "dc0b43cd-e6b1-3397-b178-b1aeda16be19",
                                "text": "Le dogme de la réincarnation motivera sans doute à mener une bonne vie présente, puisque le cumul des bonnes actions garantira une vie subséquente plus heureuse, et vice versa."
                            }
                        ]
                    }
