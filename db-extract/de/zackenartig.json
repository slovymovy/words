                ],
                "senses": [
                    {
                        "sense_id": "15ddb95e-4c62-3e9c-99c2-c369338d995a",
                        "entry_id": "34c0482e-5d33-36cc-a64a-e4ca69c843f6",
                        "glosses": [
                            "Zacken ähnelnd; mit Zacken versehen, besetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "474fbdc8-41f2-46ef-b339-30991ff1160f",
                                "sense_id": "15ddb95e-4c62-3e9c-99c2-c369338d995a",
                                "text": "„Er zeigte auf die zackenartigen Krallen, die auf dem kleinen Würfel nur schwer zu erkennen waren.“"
                            },
                            {
                                "example_id": "87b8077a-e0ed-4873-ad58-e8f479ecb089",
                                "sense_id": "15ddb95e-4c62-3e9c-99c2-c369338d995a",
                                "text": "„Umschlossen von einer Lipidmembran, auf der spezifische Eiweiße sitzen, die zackenartig aus der Virushülle herausragen.“"
                            },
                            {
                                "example_id": "5915eccf-1729-4cd5-a056-9e753e533059",
                                "sense_id": "15ddb95e-4c62-3e9c-99c2-c369338d995a",
                                "text": "„Schneide den Kreis etwas größer als aufgezeichnet aus und bis zur auf Alufolie, gezeichneten Linie zackenartig ein.“"
                            },
                            {
                                "example_id": "3325c3ba-4d85-4e09-97a5-9933d0538fb5",
                                "sense_id": "15ddb95e-4c62-3e9c-99c2-c369338d995a",
                                "text": "[übertragen:] „Schmerz zuckte zackenartig in sein Gehirn und löste wie auf Knopfdruck eine rücksichtslose Wut aus.“"
