                        "entry_id": "98a68d5f-8893-3740-9a7e-ce6d8aea9a87",
                        "glosses": [
                            "kleine, silberweiße Zwiebel, die vor allem in Essig eingelegt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3404cc6b-ef85-4c9d-8379-e90ff141751f",
                                "sense_id": "b1222ea6-4e17-31f4-a476-cf20b2de16a5",
                                "text": "„Bei der Silberzwiebel handelt es sich um eine kleine Form der Speisezwiebel.“"
                            },
                            {
                                "example_id": "0bd9ee29-b4cb-4a3e-a77a-b2f829dd5339",
                                "sense_id": "b1222ea6-4e17-31f4-a476-cf20b2de16a5",
                                "text": "„Fünf Minuten später bringt er uns mit strahlenden Augen das brennende Réchaud, einen Brotkorb und ein Porzellanschiffchen mit Silberzwiebeln, frischer Ananas, Schinkenquadern, Paprikastreifen und Cornichons.“"
                            }
                        ],
