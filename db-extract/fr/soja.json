                                                "example_id": "de43dab0-b226-4e17-85cf-3d9d93f4a437",
                                                "sense_id": "44363682-de96-3e13-a916-361e98b8431a",
                                                "text": "Even Reddit, the most soy place on the internet, is giving up on female Space Marines ever happening."
                                            },
