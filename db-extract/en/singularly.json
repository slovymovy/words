                "senses": [
                    {
                        "sense_id": "d8526312-ccf1-3b41-9148-0223874929d5",
                        "entry_id": "4673d082-26ea-363b-8cd6-89c2860b7956",
                        "glosses": [
                            "Strangely; oddly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a35ce0f8-bc1a-4099-9990-7027a8091c70",
                                "sense_id": "d8526312-ccf1-3b41-9148-0223874929d5",
                                "text": "He behaved most singularly when we met him last night."
                            }
                        ]
                    },
                    {
                        "sense_id": "f85694c9-8ccc-3168-8705-9cc04002675a",
                        "entry_id": "4673d082-26ea-363b-8cd6-89c2860b7956",
                        "glosses": [
                            "Extremely; remarkably."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "912ad05a-4697-4852-8a81-1b30e04a828f",
                                "sense_id": "f85694c9-8ccc-3168-8705-9cc04002675a",
                                "text": "I fancied at first the stuff was paraffin wax, and smashed the jar accordingly. But the odor of camphor was unmistakable. It struck me as singularly odd, that among the universal decay, this volatile substance had chanced to survive, perhaps through many thousand years."
                            },
                            {
                                "example_id": "96b73c44-d3b7-4cd7-9f1b-c2fbdcca8cf4",
                                "sense_id": "f85694c9-8ccc-3168-8705-9cc04002675a",
                                "text": "\"There were scraps of verse. I do not profess to be a judge of such things, but they appeared to me to be singularly wanting in merit.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "5564e071-e726-3187-a530-e3040e4dd9fb",
                        "entry_id": "4673d082-26ea-363b-8cd6-89c2860b7956",
                        "glosses": [
                            "In the singular number; in terms of a single thing."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2313ba46-bc7e-3ee0-9bd8-1bbe57d06437",
                        "entry_id": "4673d082-26ea-363b-8cd6-89c2860b7956",
                        "glosses": [
                            "solely; only; uniquely"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec5f9f9c-811a-4d00-8d75-5ae5aed307af",
                                "sense_id": "2313ba46-bc7e-3ee0-9bd8-1bbe57d06437",
                                "text": "A vast number of Iranians will singularly hold Ayatollah Khamenei, who first became leader in 1989, responsible for setting Iran on a collision course with Israel and the US that ultimately brought considerable ruin to his country and people."
                            }
                        ]
                    }
                ],
