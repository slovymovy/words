                                                "sense_id": "45b1a4aa-8fbd-34a9-9dbd-4a6b634429ef",
                                                "text": "Będąc w Wiśle, oglądaliśmy skocznię narciarską."
                                            },
                                            {
                                                "example_id": "ae113b3f-663b-43df-8722-b7aac24f96db",
                                                "sense_id": "45b1a4aa-8fbd-34a9-9dbd-4a6b634429ef",
