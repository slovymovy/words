                {
                    "sense_id": "a3d21417-901d-39dd-a14c-ff7a2755acbc",
                    "sense_definition": "De beweging waarbij iets of iemand van richting verandert.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_turn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De piloot maakte een scherpe <w>wending</w> om het onweer te ontwijken.",
                            "target_lang_translations": {
                                "en": "The pilot made a sharp <w>turn</w> to avoid the thunderstorm.",
                                "ru": "Пилот совершил резкий <w>вираж</w>, чтобы избежать грозы.",
                                "fr": "Le pilote a effectué un <w>virage</w> serré pour éviter l'orage."
                            }
                        },
                        {
                            "text": "Met een soepele <w>wending</w> draaide het schip de haven in.",
                            "target_lang_translations": {
                                "en": "With a smooth <w>turn</w>, the ship steered into the harbor.",
                                "ru": "Совершив плавный <w>разворот</w>, корабль зашел в гавань.",
                                "fr": "Avec un <w>virage</w> en douceur, le navire est entré dans le port."
                            }
                        }
                    ],
                    "synonyms": [
