                "senses": [
                    {
                        "sense_id": "c27d9dc3-6c4d-3213-af38-fcf7879bbd81",
                        "entry_id": "ffddab33-80fa-3f3c-a583-7673119c2649",
                        "glosses": [
                            "związany z Erazmem z Rotterdamu, jego dziełami i poglądami"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de9baaa2-f277-47df-b6b0-08555ad7ec51",
                                "sense_id": "c27d9dc3-6c4d-3213-af38-fcf7879bbd81",
