                        "glosses": [
                            "In a way that is counter to something else, for example in colour (being divided, as a field, bordure, etc, into different colours), or placement (facing different directions, or crossed)."
                        ],
                        "tags": [
                            "not-comparable",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e38ab9a7-b3cb-49ff-94b5-1da3022fefee",
                                "sense_id": "3c0d2526-71ee-3113-947f-f852fca768fe",
                                "text": "3 He beareth Azure a Bordure counter-componed: Or, and Guiles; which is as much to say, as Compounded of these two Colours counterly placed. Note that Countercompony consisteth euermore of two tracts onely and no more."
                            },
                            {
                                "example_id": "c1ceead1-cf47-4882-b513-bf3119043219",
                                "sense_id": "3c0d2526-71ee-3113-947f-f852fca768fe",
                                "text": "N. 23. Gules, a cherub, having three pair of wings, whereof the uppermost and lowermost are counterly crossed, and the middlemost displayed or, name, Buocafoco."
                            }
                        ]
                    }
