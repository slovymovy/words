                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "abrupt",
                                "target_lang_sense_clarification": "sudden and unexpected"
                            },
                            {
                                "target_lang_word": "sudden",
                                "target_lang_sense_clarification": "happening quickly and without warning"
                            }
                        ]
                    }
                }
            ]
        },
