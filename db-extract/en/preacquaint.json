                "senses": [
                    {
                        "sense_id": "cf40497c-34f4-39f2-9e2d-5a6322ac7c34",
                        "entry_id": "930062cd-168d-3a69-8b5f-a4c98c879973",
                        "glosses": [
                            "To acquaint beforehand."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "945be7d0-ef2b-43b9-a4c6-e412c5fa3866",
                                "sense_id": "cf40497c-34f4-39f2-9e2d-5a6322ac7c34",
                                "text": "1633, James Shirley, The Witty Fair One, London: William Cooke, Act I, Scene 1,\nWor[thy]. […] You haue not made your loue knowne to my Neece yet.\nAym[well]. No, my intention was to preacquaint you."
                            },
                            {
                                "example_id": "8927ca49-3f2c-4acc-9041-599cefe34a49",
                                "sense_id": "cf40497c-34f4-39f2-9e2d-5a6322ac7c34",
                                "text": "[S]he inadvertently confirmed many Hints, vvith vvhich Slipſlop, vvhoſe Gallant he vvas, had pre-acquainted him; […]"
                            },
                            {
                                "example_id": "c5ef0029-b6ef-45d3-9db8-de2ef26f8463",
                                "sense_id": "cf40497c-34f4-39f2-9e2d-5a6322ac7c34",
                                "text": "Those things which have been previously stated, or which are necessarily implied, or with which we presume our hearers to have been preacquainted, we pronounce with such a subordination of stress as is suitable to the small importance of things already understood […]"
                            },
                            {
                                "example_id": "9d806b4e-1375-4384-9c65-8625a2a222c2",
                                "sense_id": "cf40497c-34f4-39f2-9e2d-5a6322ac7c34",
                                "text": "1969, Tibor Agoston, Insight Therapy, State of Ohio Department of Mental Hygiene and Correction, Part 4, Chapter 110, p. 215,\n[…] we may describe differential dynamics as a gallery of disease patterns that may preacquaint the therapist with the picture which is likely to emerge when all the pieces are fitted together."
                            }
                        ]
                    }
