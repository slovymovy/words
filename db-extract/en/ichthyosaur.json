                    {
                        "sense_id": "d9069134-34af-3197-87b1-e469a65707e9",
                        "entry_id": "79c7d9dd-3db4-3afc-b8d1-8d3c8e4ac4c2",
                        "glosses": [
                            "Any fishlike marine reptiles of the extinct order †Ichthyosauria of the early Triassic to the late Cretaceous period, that had a body somewhat like a porpoise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b1f5582-9aed-48e3-9266-4e09e725c962",
                                "sense_id": "d9069134-34af-3197-87b1-e469a65707e9",
                                "text": "The most striking marine reptiles are the fishlike or porpoiselike ichthyosaurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0fb7009-c11c-4cc9-ac31-14713822e1fd",
                        "source_entry_id": "79c7d9dd-3db4-3afc-b8d1-8d3c8e4ac4c2",
