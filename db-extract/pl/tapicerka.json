                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21945d5c-a53f-4fcf-8a43-9f69ab7ac417",
                        "source_entry_id": "45151c04-d4dc-3203-9ea6-df1e1a490db3",
                        "source_sense_id": "8b2d44d4-a985-3daa-ac0b-da5b389ba6fa",
                        "target_lang_word": "Polster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16a4c4fb-af7f-3364-ac7b-6f67e0caf221",
                                        "entry_id": "5a209fab-d304-3575-9181-972a33efaf23",
                                        "glosses": [
                                            "Kissen im Bett"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af7f06c2-399f-4d67-a771-4981081fc433",
                                                "sense_id": "16a4c4fb-af7f-3364-ac7b-6f67e0caf221",
                                                "text": "„Helfer des Roten Kreuzes und der Caritas versorgten sie mit Lebensmitteln, Getränken, Decken und Polstern.“"
                                            },
                                            {
                                                "example_id": "1da9dbc1-a136-42d5-9c71-207bfaa3cb86",
                                                "sense_id": "16a4c4fb-af7f-3364-ac7b-6f67e0caf221",
                                                "text": "„Sie schob einen Polster unter Auguste Schmerdas Kopf und ein Zierkissen unter ihre Beine.“"
                                            },
                                            {
                                                "example_id": "db9f2b81-c511-4879-aea8-968ec23e9fc5",
                                                "sense_id": "16a4c4fb-af7f-3364-ac7b-6f67e0caf221",
                                                "text": "„Die Tante Gustl thronte, gestützt von Pölstern, geschminkt und frisiert im Bett und stach gierig nach dem Apfelstrudel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bd8c6ece-42bd-3142-95ea-2ab01a24b660",
                                        "entry_id": "5a209fab-d304-3575-9181-972a33efaf23",
                                        "glosses": [
                                            "Ausstaffierung in"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "13585b84-2a44-3cab-9390-f71669d1cb91",
                                        "entry_id": "5a209fab-d304-3575-9181-972a33efaf23",
                                        "glosses": [
                                            "Ausstaffierung in",
                                            "Kleidungsstücken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e5e9d2a-8b56-4cd2-8f98-8f23953c025d",
                                                "sense_id": "13585b84-2a44-3cab-9390-f71669d1cb91",
                                                "text": "Sag mal, hast du immer noch Polster in der Jacke?"
                                            }
                                        ],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "66507e94-ca35-3421-bf19-037457bf03e9",
                                        "entry_id": "5a209fab-d304-3575-9181-972a33efaf23",
                                        "glosses": [
                                            "Ausstaffierung in",
                                            "Möbelstücken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8ef730f-4e0c-4037-80b5-f6779744fed2",
                                                "sense_id": "66507e94-ca35-3421-bf19-037457bf03e9",
                                                "text": "Bitte keine Flecke auf das wertvolle Polster machen!"
                                            },
                                            {
                                                "example_id": "f8fea721-f94b-41d0-8a8e-13c4e0e2260c",
                                                "sense_id": "66507e94-ca35-3421-bf19-037457bf03e9",
                                                "text": "„Aus ihren Geschichten wüßten sie, daß sie die Wände und die Treppe allein gestrichen, die Polster selbst bezogen und die Bilder restauriert habe.“"
                                            },
                                            {
                                                "example_id": "f51e99e6-033a-4457-9205-8da97b2e793e",
                                                "sense_id": "66507e94-ca35-3421-bf19-037457bf03e9",
                                                "text": "„Die Sprungfedern des Polsters drückten unangenehm in den Rücken.“"
                                            },
                                            {
                                                "example_id": "a7b27686-ee13-4922-9fc0-5db70ad49ce6",
                                                "sense_id": "66507e94-ca35-3421-bf19-037457bf03e9",
                                                "text": "„Ihr Vater hatte um sich einen ledernen Schlafsack und lag auf Polstern, die von Heu dufteten, was ein vornehmer Duft war an einem Frühjahrstag, wo niemand Heu besitzt.“"
                                            },
                                            {
                                                "example_id": "96e895e8-c382-43a0-baf0-744843b16d65",
                                                "sense_id": "66507e94-ca35-3421-bf19-037457bf03e9",
                                                "text": "„Auf den schäbigsten Polstern, in die schmierigsten Burnusse eingewickelt, lag ein Dutzend Araber herum, oder welch ein Volk sich sonst glücklich pries, sie losgeworden zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2b\""
                                    },
                                    {
