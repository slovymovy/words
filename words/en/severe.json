    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "48734a32-e5b9-3173-855e-5d126b28c3d7",
                    "sense_definition": "Very bad, serious, or intense, often describing pain, weather, or damage.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm caused <w>severe</w> damage to the roof of the house.",
                            "target_lang_translations": {
                                "ru": "Шторм нанёс <w>серьёзный</w> ущерб крыше дома.",
                                "tr": "Fırtına, evin çatısında <w>ağır</w> hasara yol açtı.",
                                "zh": "这场风暴对屋顶造成了<w>严重</w>的损坏。"
                            }
                        },
                        {
                            "text": "He was taken to the hospital because of <w>severe</w> chest pain.",
                            "target_lang_translations": {
                                "ru": "Его доставили в больницу из-за <w>сильной</w> боли в груди.",
                                "tr": "<w>Şiddetli</w> göğüs ağrısı nedeniyle hastaneye kaldırıldı.",
                                "zh": "他因为<w>剧烈</w>的胸痛被送往医院。"
                            }
                        }
                    ],
                    "synonyms": [
                        "intense",
                        "extreme",
                        "serious",
                        "acute",
                        "critical"
                    ],
                    "antonyms": [
                        "mild",
                        "minor"
                    ],
                    "common_phrases": [
                        "severe pain",
                        "severe weather",
                        "severe damage",
                        "severe consequences",
                        "severe depression"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень плохой, серьёзный или интенсивный (часто о боли, погоде или ущербе).",
                        "tr": "Genellikle ağrı, hava durumu veya hasar için kullanılan; çok kötü, ciddi veya şiddetli.",
                        "zh": "指非常糟糕、严重或强烈的程度，常用于描述疼痛、天气或损坏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тяжёлый",
                                "target_lang_sense_clarification": "о болезни, последствиях или состоянии"
                            },
                            {
                                "target_lang_word": "суровый",
                                "target_lang_sense_clarification": "о климате или испытаниях"
                            },
                            {
                                "target_lang_word": "сильный",
                                "target_lang_sense_clarification": "о боли, ветре или повреждениях"
                            },
                            {
                                "target_lang_word": "серьёзный",
                                "target_lang_sense_clarification": "об ущербе или проблемах"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "şiddetli",
                                "target_lang_sense_clarification": "ağrı, fırtına veya hava durumu için"
                            },
                            {
                                "target_lang_word": "ciddi",
                                "target_lang_sense_clarification": "hasar, hastalık veya durumlar için"
                            },
                            {
                                "target_lang_word": "ağır",
                                "target_lang_sense_clarification": "hasar, ceza veya kayıplar için"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "严重",
                                "target_lang_sense_clarification": "用于描述损坏、后果或病情"
                            },
                            {
                                "target_lang_word": "剧烈",
                                "target_lang_sense_clarification": "用于描述疼痛或强烈的反应"
                            },
                            {
                                "target_lang_word": "恶劣",
                                "target_lang_sense_clarification": "用于描述天气或环境"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2627c07-730b-3c36-95d2-a7b6fd322cc8",
                    "sense_definition": "Strict, harsh, or not kind in treatment or judgment.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge decided to give the criminal a <w>severe</w> punishment.",
                            "target_lang_translations": {
                                "ru": "Судья решил назначить преступнику <w>суровое</w> наказание.",
                                "tr": "Yargıç, suçluya <w>ağır</w> bir ceza vermeye karar verdi.",
                                "zh": "法官决定给予罪犯<w>严厉</w>的惩罚。"
                            }
                        },
                        {
                            "text": "Her father was quite <w>severe</w> with her when she broke the rules.",
                            "target_lang_translations": {
                                "ru": "Отец был довольно <w>строг</w> с ней, когда она нарушила правила.",
                                "tr": "Kuralları ihlal ettiğinde babası ona karşı oldukça <w>sertti</w>.",
                                "zh": "当她违反规则时，她父亲对她非常<w>严厉</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strict",
                        "harsh",
                        "stern",
                        "rigorous",
                        "tough"
                    ],
                    "antonyms": [
                        "lenient"
                    ],
                    "common_phrases": [
                        "severe punishment",
                        "severe criticism",
                        "severe look",
                        "severe judgment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Строгий, резкий или недобрый в обращении или суждениях.",
                        "tr": "Davranışta veya yargıda katı, sert veya acımasız.",
                        "zh": "指在对待他人或进行判断时表现得严厉、苛刻或不留情面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суровый",
                                "target_lang_sense_clarification": "о наказании или взгляде"
                            },
                            {
                                "target_lang_word": "строгий",
                                "target_lang_sense_clarification": "о человеке или правилах"
                            },
                            {
                                "target_lang_word": "жёсткий",
                                "target_lang_sense_clarification": "о критике или мерах"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sert",
                                "target_lang_sense_clarification": "ceza, eleştiri veya tutum için"
                            },
                            {
                                "target_lang_word": "katı",
                                "target_lang_sense_clarification": "kurallar veya yaklaşım için"
                            },
                            {
                                "target_lang_word": "ağır",
                                "target_lang_sense_clarification": "ceza veya yargı için"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "严厉",
                                "target_lang_sense_clarification": "用于描述惩罚、态度或批评"
                            },
                            {
                                "target_lang_word": "苛刻",
                                "target_lang_sense_clarification": "用于描述要求或判断"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af7de7d4-6005-3249-a352-234dfe51bc60",
                    "sense_definition": "Very plain and simple in style or appearance, without decoration.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a <w>severe</w> black dress with absolutely no jewelry.",
                            "target_lang_translations": {
                                "ru": "На ней было <w>строгое</w> чёрное платье без каких-либо украшений.",
                                "tr": "Üzerinde kesinlikle hiçbir takı olmayan <w>sade</w> siyah bir elbise vardı.",
                                "zh": "她穿了一件<w>朴素</w>的黑色连衣裙，身上没有任何首饰。"
                            }
                        },
                        {
                            "text": "The modern building had a <w>severe</w> style that some people found cold.",
                            "target_lang_translations": {
                                "ru": "У этого современного здания был <w>строгий</w> стиль, который некоторые находили холодным.",
                                "tr": "Modern binanın, bazılarının soğuk bulduğu <w>sert</w> bir tarzı vardı.",
                                "zh": "这座现代建筑有着一种<w>简洁</w>的风格，有些人觉得它很冷清。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plain",
                        "simple",
                        "austere",
                        "unadorned",
                        "spartan"
                    ],
                    "common_phrases": [
                        "severe style",
                        "severe haircut",
                        "severe dress",
                        "severe lines"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень простой и сдержанный по стилю, без украшений.",
                        "tr": "Tarz veya görünüş olarak süssüz, son derece sade ve gösterişsiz.",
                        "zh": "指风格或外观极其朴素、简洁，没有任何装饰。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "строгий",
                                "target_lang_sense_clarification": "о стиле или одежде"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sade",
                                "target_lang_sense_clarification": "tarz veya kıyafet için"
                            },
                            {
                                "target_lang_word": "sert",
                                "target_lang_sense_clarification": "keskin ve süssüz çizgiler/tarz için"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "朴素",
                                "target_lang_sense_clarification": "用于描述风格或衣着"
                            },
                            {
                                "target_lang_word": "简洁",
                                "target_lang_sense_clarification": "用于描述建筑或设计风格"
                            }
                        ]
                    }
                }
            ]
