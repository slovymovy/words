                        "entry_id": "5dfd54ba-d7ac-3585-9e3b-b04abc3022c5",
                        "glosses": [
                            "Activité d’une communauté féministe s’intéressant au cyberespace."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "1a6f480f-8f95-4276-af67-6766cbabec61",
                                "sense_id": "188cb69a-b331-3597-8fb5-16e5edd74d01",
                                "text": "Après des ateliers consacrés, entre autres, aux femmes artistes et aux femmes dans les jeux vidéo, cet après-midi est voué au cyberféminisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b26f6be-1d66-4ba6-9279-ed38b35b34be",
                        "source_entry_id": "5dfd54ba-d7ac-3585-9e3b-b04abc3022c5",
                        "source_sense_id": "188cb69a-b331-3597-8fb5-16e5edd74d01",
                        "target_lang_word": "cyberfeminism",
