                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40300d42-0d8e-484e-a6bb-048b9be9cd26",
                                                "sense_id": "dfd033e1-9d5b-321b-8cf5-6acdc68177ee",
                                                "text": "Zpěvaččin styl bývá označován jako směs jazzu, popu a country."
