        "fr-extract.jsonl": [
            {
                "entry_id": "97875464-90d3-3040-84f9-cfb3fc0cbb39",
                "word": "contexture",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1c9eda7a-e0d9-4ef1-aee0-a28b55801990",
                        "entry_id": "97875464-90d3-3040-84f9-cfb3fc0cbb39",
                        "tags": [
                            "plural"
                        ],
                        "form": "contextures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "17cf813f-952c-3cbe-8547-0c8bc296002f",
                        "entry_id": "97875464-90d3-3040-84f9-cfb3fc0cbb39",
                        "glosses": [
                            "Organisation de plusieurs parties qui forment un tout."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27cf33f7-792b-4446-aad6-0e7b20b9c1f4",
                                "sense_id": "17cf813f-952c-3cbe-8547-0c8bc296002f",
                                "text": "Manicamp, passant à droite. – Vous savez si je vous aime, Folleville !… mon bon Folleville !… Parce que la chasse aux canards, voyez-vous… c’est magnifique ! mais d’un autre côté ce verre d’eau qui… enfin c’est magnifique aussi… alors, vous comprenez… les événements… les circonstances… produisent un amalgame… dont la contexture… forme un tissu… et plus tard…"
                            },
                            {
                                "example_id": "a7e82b9d-3daa-4ac2-b73c-d77901fec791",
                                "sense_id": "17cf813f-952c-3cbe-8547-0c8bc296002f",
                                "text": "Du sud-ouest avait commencé à se lever une masse compacte, un continent de nuages menaçants ; ici et là, à travers les fentes de sa contexture, le soleil continuait de déverser sur la mer des gerbes de rayons."
                            },
                            {
                                "example_id": "961fa44d-d2f6-4e30-a99d-60eb1a133e5f",
                                "sense_id": "17cf813f-952c-3cbe-8547-0c8bc296002f",
                                "text": "Les nuages cessaient de ressembler à des cimes neigeuses ; ils devenaient immatériels et révélaient dans leur contexture un tourbillonnement immense et silencieux."
                            },
                            {
                                "example_id": "50785d4c-1b02-4623-9d7b-a6a60a5a63ed",
                                "sense_id": "17cf813f-952c-3cbe-8547-0c8bc296002f",
                                "text": "Le seul déchet consiste dans les « vestes » ou couches supérieures formées d’un fil de contexture irrégulière que l’on enlève au moment du dévidage."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc24d154-784c-3f18-ac3e-2184f3c21faf",
                        "entry_id": "97875464-90d3-3040-84f9-cfb3fc0cbb39",
                        "glosses": [
                            "Liaison des différentes parties d’un texte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "331e1b52-b519-4b78-915a-832b16d4a913",
                                "sense_id": "fc24d154-784c-3f18-ac3e-2184f3c21faf",
                                "text": "Par-ci, par-là, comme je l’ai déjà dit plus haut, me reviennent en même temps que des parcelles du rêve des souvenirs très vifs de la contexture même du récit."
                            },
                            {
                                "example_id": "266a5cfa-decc-4038-82ec-0ce29c9127eb",
                                "sense_id": "fc24d154-784c-3f18-ac3e-2184f3c21faf",
                                "text": "La contexture d’un discours."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a966740-5ca4-3466-aba3-ebf0019f1f74",
                        "entry_id": "97875464-90d3-3040-84f9-cfb3fc0cbb39",
                        "glosses": [
                            "Collecte des différents éléments formant un tout (dans un ouvrage, une historiographie)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3e4598e-b4d2-4a55-9287-2431b2154e7d",
                                "sense_id": "1a966740-5ca4-3466-aba3-ebf0019f1f74",
                                "text": "La contexture de l’histoire juive, du rite. En dressant une contexture des faits dans l’ordre chronologique."
                            }
                        ]
                    },
                    {
                        "sense_id": "29ed1aea-d0dd-3ff8-9d05-10a97d22d982",
                        "entry_id": "97875464-90d3-3040-84f9-cfb3fc0cbb39",
                        "glosses": [
                            "Réunion des composants qui forment un tout."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4512b643-a124-4095-9386-f36ec0eabb0d",
                                "sense_id": "29ed1aea-d0dd-3ff8-9d05-10a97d22d982",
                                "text": "La contexture invariable des rites"
                            }
                        ]
                    }
                ],
