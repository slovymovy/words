                                    {
                                        "sense_id": "ad1f5a72-1283-3b2f-9823-385260d18d90",
                                        "entry_id": "735fd99e-d1a0-3ce2-999e-36e369d09d01",
                                        "glosses": [
                                            "ανδρικό όνομα, λόγια μορφή του Πλάτωνας"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff1c5055-939a-4f1a-977d-f04bc4cc17f0",
                                                "sense_id": "ad1f5a72-1283-3b2f-9823-385260d18d90",
                                                "text": "Ένας από τους πρωτεργάτες του ελληνικού σοσιαλισμού υπήρξε ο Πλάτων Δρακούλης."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9dea353-75e7-33ec-ac00-462775dbbb4c",
                                        "entry_id": "735fd99e-d1a0-3ce2-999e-36e369d09d01",
                                        "glosses": [
                                            "επιφανής αρχαίος Έλληνας φιλόσοφος (427-347 π.Χ.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d5a4627-e02e-45e3-8d08-fc0cb5783612",
                                                "sense_id": "d9dea353-75e7-33ec-ac00-462775dbbb4c",
                                                "text": "Ο Πλάτων υπήρξε μαθητής του Σωκράτη, αλλά και δάσκαλος του Αριστοτέλη."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a96f3b70-5d4f-3190-bb77-c95769cb6005",
                                        "entry_id": "735fd99e-d1a0-3ce2-999e-36e369d09d01",
                                        "glosses": [
                                            "ανδρικό επώνυμο (θηλυκό Πλάτωνος)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74f469a7-8834-4f07-b123-40c9a7cd2d85",
                                                "sense_id": "a96f3b70-5d4f-3190-bb77-c95769cb6005",
                                                "text": "Ο Γεώργιος Πλάτων ήταν γνωστός Έλληνας συνθέτης και πιανίστας και κόρη του είναι η, επίσης γνωστή, συνθέτρια Λένα Πλάτωνος."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f63630d4-071c-3ef9-8797-a75a80349528",
                                        "entry_id": "735fd99e-d1a0-3ce2-999e-36e369d09d01",
                                        "glosses": [
                                            "άνθρωπος που ασκεί μεγάλη επιρροή σε κάποιο γνωστικό τομέα"
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab25ca56-5a23-4a50-b8d6-103122c1217f",
                                                "sense_id": "f63630d4-071c-3ef9-8797-a75a80349528",
                                                "text": "Γιατί δε βγάζει η Ελλάδα πια Πλάτωνες και Αριστοτέληδες;"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
