                        "sense_id": "9eb833e3-a07a-3e14-ac9c-b1f3c47c9998",
                        "entry_id": "49eedf66-2dd9-34a3-8bbe-d1de4384097e",
                        "glosses": [
                            "Handlung, jemanden bezogen auf ein Fehlverhalten zurechtzuweisen und/oder zu bestrafen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66bcf0ad-c32e-4d83-91d7-075f70ac4c19",
                                "sense_id": "9eb833e3-a07a-3e14-ac9c-b1f3c47c9998",
                                "text": "„Erst meine beiden Hände ließen mich das ganze Greuel dieser unerhörten Maßregelung erkennen.“"
                            },
                            {
                                "example_id": "c7abda6c-3e06-4a66-883a-5f19deb99d6c",
                                "sense_id": "9eb833e3-a07a-3e14-ac9c-b1f3c47c9998",
                                "text": "„Vielleicht sollte man den Bürgern die Freiheit geben, ihre Suchtmittel ohne staatliche Maßregelungen und Verbote selbst zu wählen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
