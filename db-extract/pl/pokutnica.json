                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a706bda8-0451-4570-bcc1-f63da6f18559",
                                "sense_id": "aa1286b9-ce74-31b1-8fe7-3be04e30ee24",
                                "text": "Drogą szła pokutnica odziana we włosiennicę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85aed417-fb03-42d9-9f54-a35e05314cd0",
                        "source_entry_id": "3b90ed66-4d7a-354e-95e8-7b2e9f614594",
                        "source_sense_id": "aa1286b9-ce74-31b1-8fe7-3be04e30ee24",
                        "target_lang_word": "Büßerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Büßerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "553add34-b913-3889-866d-fe61501d65cf",
                                        "entry_id": "4649e6ce-53c1-3068-a96c-bd7e137f2c33",
                                        "glosses": [
                                            "weibliche Person, die für eine begangene Tat büßt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c5cea0e-ca8a-4c70-ad70-25fff88ddfe4",
                                                "sense_id": "553add34-b913-3889-866d-fe61501d65cf",
                                                "text": "„Besonders Rosetti hat sie immer wieder gemalt, eher als mittelalterliche Magdalena, die Büßerin, denn als Maria.“"
                                            },
                                            {
                                                "example_id": "bcd313b4-410c-428e-b30a-5e48abdabde2",
                                                "sense_id": "553add34-b913-3889-866d-fe61501d65cf",
                                                "text": "„Sie erscheinen dem Kirchenbesucher von heute an dieser Stelle ziemlich rätselhaft, denn sie zeigen den reumütigen Apostel Petrus mit dem krähenden Hahn und die Büßerin Maria Magdalena.“"
                                            },
                                            {
                                                "example_id": "de0c92e4-6fb4-48c2-9150-4491fbab5edf",
                                                "sense_id": "553add34-b913-3889-866d-fe61501d65cf",
                                                "text": "„Wir betraten einen großen Raum, in dem ich die Berühmte leicht unter fünf oder sechs andern Büßerinnen herausfand, die jedoch nicht viel zu bereuen haben konnten, denn sie erschienen mir häßlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
