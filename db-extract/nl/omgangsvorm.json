                        "examples": [
                            {
                                "example_id": "70ebd69b-ad94-4b0e-be6e-49d4d49c0f0c",
                                "sense_id": "2d95f3b9-2ff3-3955-8f1a-298a94a2d0b9",
                                "text": "„Ga het gesprek aan over het lawaai waarmee de ruzies worden uitgevochten. Dat is een gesprek met z’n vieren, met vader erbij. De basis voor het aanleren van omgangsvormen ligt in het gezin. De goede voorbeelden in de buitenwereld worden schaarser. De verruwing heeft zelfs het parlementaire debat bereikt.”"
