                "senses": [
                    {
                        "sense_id": "28b55c4a-b052-3698-9c99-d9639f576b8a",
                        "entry_id": "8b92fd61-bb5e-35d1-9000-3258e7778ca3",
                        "glosses": [
                            "(abgezogenes) Fell eines Leoparden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afd07761-d273-4ac4-a94a-8d0ec7b42b4d",
                                "sense_id": "28b55c4a-b052-3698-9c99-d9639f576b8a",
                                "text": "„Die Weiber liebkosten ihn mit wilder Begeisterung, setzten ihm einen Efeukranz aufs Haupt, und warfen auf seine Schulter ein prachtvolles Leopardenfell.“"
                            },
                            {
                                "example_id": "0992986c-d75c-44e1-ba6f-bda1dad6a489",
                                "sense_id": "28b55c4a-b052-3698-9c99-d9639f576b8a",
                                "text": "„Auf dem Kopfe trug er ein Netz aus Rindenfasern, um die Hüften einen Gurt aus Leopardenfell, in dem zwei furchtbare Messer blinkten.“"
                            },
                            {
                                "example_id": "3c5e2bee-86f1-405a-87e7-c0eeffff52d5",
                                "sense_id": "28b55c4a-b052-3698-9c99-d9639f576b8a",
                                "text": "„Manche tragen Gehrock nach britischer Mode, andere Leopardenfelle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23d4f108-46cb-44fa-b9ce-39b7607c0b21",
                        "source_entry_id": "8b92fd61-bb5e-35d1-9000-3258e7778ca3",
