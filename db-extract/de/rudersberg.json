                                "example_id": "5af728e9-658c-41e5-8304-193a7d3eb590",
                                "sense_id": "b7d4376e-3bf3-30fe-b033-282b57a9b786",
                                "text": "„Einer der schönsten Orte in dieser Region ist Rudersberg, eine Stadt mit knapp 11.200 Einwohnern.“"
                            },
