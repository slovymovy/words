    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "71ff8c50-0bed-36e7-9c5e-45ceaf55e01c",
                    "sense_definition": "The activity of presenting, advertising, and selling a company's products or services in the best possible way.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "business_promotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to study <w>marketing</w> at the university to start her business career.",
                            "target_lang_translations": {
                                "ru": "Она решила изучать <w>маркетинг</w> в университете, чтобы начать свою карьеру в бизнесе.",
                                "zh": "她决定在大学学习<w>市场营销</w>，以便开启她的商业生涯。"
                            }
                        },
                        {
                            "text": "The company launched a new <w>marketing</w> campaign to attract younger customers.",
                            "target_lang_translations": {
                                "ru": "Компания запустила новую <w>маркетинговую</w> кампанию для привлечения более молодых клиентов.",
                                "zh": "公司发起了一项新的<w>营销</w>活动，以吸引更年轻的客户。"
                            }
                        }
                    ],
                    "synonyms": [
                        "promotion",
                        "advertising",
                        "selling",
                        "branding"
                    ],
                    "common_phrases": [
                        "marketing strategy",
                        "digital marketing",
                        "marketing campaign",
                        "direct marketing",
                        "social media marketing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деятельность по представлению, рекламе и продаже продуктов или услуг компании наилучшим образом.",
                        "zh": "指通过广告、推广和销售等方式，以最佳方式展示公司产品或服务的商业活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маркетинг",
                                "target_lang_sense_clarification": "сфера деятельности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "市场营销",
                                "target_lang_sense_clarification": "商业领域中的专业活动"
                            },
                            {
                                "target_lang_word": "营销",
                                "target_lang_sense_clarification": "市场营销的简称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "995778a8-9713-3146-a003-1f8ee721bcdb",
                    "sense_definition": "The act of going to a store or market to buy food and household supplies.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shopping_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandmother prefers to do her <w>marketing</w> early in the morning to avoid the crowds.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка предпочитает делать <w>покупки</w> рано утром, чтобы избежать толпы.",
                                "zh": "我祖母喜欢清早去<w>买菜</w>，以避开人群。"
                            }
                        },
                        {
                            "text": "She finished the <w>marketing</w> and returned home with a basket full of fresh vegetables.",
                            "target_lang_translations": {
                                "ru": "Она закончила <w>покупки</w> и вернулась домой с корзиной, полной свежих овощей.",
                                "zh": "她<w>购物</w>回来，带回了一篮新鲜蔬菜。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shopping"
                    ],
                    "common_phrases": [
                        "do the marketing"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "common in older texts or specific dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поход в магазин или на рынок для покупки еды и бытовых товаров.",
                        "zh": "指去商店或市场购买食品和生活用品的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покупки",
                                "target_lang_sense_clarification": "приобретение товаров"
                            },
                            {
                                "target_lang_word": "поход за покупками",
                                "target_lang_sense_clarification": "процесс покупки"
                            }
                        ],
                        "zh": [
