                        "examples": [
                            {
                                "example_id": "521b4057-e4ad-4979-9a26-ef69a1bf8847",
                                "sense_id": "888124ee-c524-3c97-9695-13bc335ac1f8",
                                "text": "„Bis vor knapp sechs Jahren hatte er kein Foto dieser Kreatur gesehen – sie war, wie Architeuthis Dux, der Riesenkalmar, weniger ein umstrittenes als ein enigmatisches, schwer fassbares Tier, zumal es schien, dass im See nur noch ein Exemplar lebte –, und jetzt hatte er es selbst fotografiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
