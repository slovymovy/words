                "senses": [
                    {
                        "sense_id": "26791295-36db-343a-ad4f-2119e86a86aa",
                        "entry_id": "17eb64d0-394a-3560-8025-c245c84aed42",
                        "glosses": [
                            "Kugel aus Holz; aus Holz gefertigtes kugelförmiges Objekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29b6fda7-4116-4082-a702-6da70dc3a3ea",
                                "sense_id": "26791295-36db-343a-ad4f-2119e86a86aa",
                                "text": "„Das Wichtigste in diesem Spiel ist aber eine kleine Holzkugel, die seltsamerweise Schweinchen heißt: le cochonnet. Und dieses Schweinchen ist das Ziel.“"
                            },
                            {
                                "example_id": "e52ccdf2-b761-442e-b723-06039fd45ff9",
                                "sense_id": "26791295-36db-343a-ad4f-2119e86a86aa",
                                "text": "„Big Kermit hat Pech, die Nuss klebt fest. Also marschiert er zielstrebig zu jener Holzkugel, deren Durchmesser augenscheinlich passen könnte – und wählt auf Anhieb die richtige.“"
                            },
                            {
                                "example_id": "e0be3f4b-4779-4018-9527-9b9225b705b7",
                                "sense_id": "26791295-36db-343a-ad4f-2119e86a86aa",
                                "text": "„Eine Holzkugel mit möglichst wenigen Würfen durch den Wald bewegen, darum geht es beim Boßeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
