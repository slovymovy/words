                        "examples": [
                            {
                                "example_id": "6d44d4ad-dd33-42b3-ae72-74bc66055a9f",
                                "sense_id": "f5153ed6-8ff5-36a6-9e28-f342aa14f29e",
                                "text": "Ze wspomnień i pamiętników wiadomo, że dosadność ta nie była pozą: Huysmans tak samo pisał, jak mówił, nie stroniąc od gwary ulicznej i wyrażeń uchodzących podówczas za trywialne"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "cdb3e9d0-d673-329e-85ed-622dac7f69a2",
                        "entry_id": "d3352e6e-36c8-3d9e-93b2-f341a5c4019c",
                        "glosses": [
                            "oczywisty i banalnie łatwy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be75c918-7649-4cb2-bb44-22e7b73e35a5",
                                "sense_id": "cdb3e9d0-d673-329e-85ed-622dac7f69a2",
                                "text": "Rebelianci wykryli naszą obecność – odparł spokojnym tonem Vader, jakby zastanawiał się nad trywialnymi kwestiami"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
