                "senses": [
                    {
                        "sense_id": "e55e4dad-1354-3482-a452-db6003b619de",
                        "entry_id": "f33f7d9c-594d-3f0f-9e23-4f8c2a215bf9",
                        "glosses": [
                            "Télécopieur, téléfax, fax."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cf6724d-7e54-4d9c-b627-c438b48a0abc",
                                "sense_id": "e55e4dad-1354-3482-a452-db6003b619de",
                                "text": "Ich möchte mich nach einem Faxgerät erkundigen.",
                                "translation": "Je voudrais me renseigner sur un télécopieur."
                            },
                            {
                                "example_id": "2723455e-66e9-4db0-acf1-255d2d6c99d1",
                                "sense_id": "e55e4dad-1354-3482-a452-db6003b619de",
                                "text": "Das Telefon und das Faxgerät funktionieren über eine Rufnummer.",
                                "translation": "Le téléphone et le télécopieur fonctionnent sur le même numéro d'appel."
                            }
                        ]
                    }
