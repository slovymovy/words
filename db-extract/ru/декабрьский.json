                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "0175928b-8c8f-471a-b13a-07130a3abb1c",
                                "sense_id": "75a8af57-7540-3ead-8737-9e9e7b4fdff0",
                                "text": "дека́брьский день",
                                "translation": "a December day",
                                "english": "a December day"
                            },
                            {
                                "example_id": "d3b1f239-8a85-4df3-9d42-fa1c8c7ae380",
                                "sense_id": "75a8af57-7540-3ead-8737-9e9e7b4fdff0",
                                "text": "Нема́ло дней прошло́, пока́ я не привы́к к тому́, что одноэта́жные корпуса́ больни́цы в дека́брьские су́мерки, сло́вно по кома́нде, загора́лись электри́ческим све́том.",
                                "translation": "Mikhail Bulgakov",
                                "english": "Mikhail Bulgakov"
                            }
                        ]
                    }
                ],
