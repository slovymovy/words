                                                "sense_id": "d0fe3625-121f-3150-90e9-aa29999f24ee",
                                                "text": "Im Gegensatz zu polymorphen Arten kann bei einer monomorphen Ameisenart genau eine Form/Gestalt innerhalb der Arbeiter-Kaste vorkommen."
                                            },
                                            {
                                                "example_id": "5ba6a7c3-f772-4196-862b-8e00d6ed493a",
                                                "sense_id": "d0fe3625-121f-3150-90e9-aa29999f24ee",
                                                "text": "Die Instanziierung eines polymorphen Typsystems ergibt ein konkretes monomorphes Typsystem."
                                            }
                                        ],
