                        "source_sense_id": "99422d63-3052-36d1-b696-7d41bb76cadf",
                        "target_lang_word": "weigh",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weigh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cbb84ebf-8363-311c-b9f4-0431a04b94e9",
                                        "entry_id": "fc199d8a-4acc-3d3d-ad40-d0320b0a6330",
                                        "glosses": [
                                            "To determine the weight of an object."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0cf2e4a9-19b7-3cc9-b0c9-4294adabdaea",
                                        "entry_id": "fc199d8a-4acc-3d3d-ad40-d0320b0a6330",
                                        "glosses": [
                                            "Often with \\\"out\\\", to measure a certain amount of something by its weight, e.g. for sale."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71c5323a-e41b-46ec-b3c2-52de23db570f",
                                                "sense_id": "0cf2e4a9-19b7-3cc9-b0c9-4294adabdaea",
                                                "text": "He weighed out two kilos of oranges for a client."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c920da6-7ea1-3106-ab4b-0b36189ed54e",
                                        "entry_id": "fc199d8a-4acc-3d3d-ad40-d0320b0a6330",
                                        "glosses": [
                                            "To determine the intrinsic value or merit of an object, to evaluate."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b78b30d8-a183-4101-a3e4-de0b5e6c8db9",
                                                "sense_id": "0c920da6-7ea1-3106-ab4b-0b36189ed54e",
                                                "text": "You have been weighed in the balance and found wanting."
                                            },
                                            {
                                                "example_id": "e62f787a-66fe-4bd0-8dd7-fd855129ee1f",
                                                "sense_id": "0c920da6-7ea1-3106-ab4b-0b36189ed54e",
                                                "text": "He took a long time weighing his options."
                                            },
                                            {
                                                "example_id": "422ffad3-eeaa-4181-a81f-9ad0f9eebb92",
                                                "sense_id": "0c920da6-7ea1-3106-ab4b-0b36189ed54e",
                                                "text": "As they started picking features, customers would carefully weigh the choices, but as decision fatigue set in they'd start settling for whatever the default option was."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c90cc264-0320-39f2-80d2-1ab1ff608afa",
                                        "entry_id": "fc199d8a-4acc-3d3d-ad40-d0320b0a6330",
                                        "glosses": [
                                            "To judge; to estimate."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa8a2c61-5359-43f2-b5ae-9acbaf267f3c",
                                                "sense_id": "c90cc264-0320-39f2-80d2-1ab1ff608afa",
                                                "text": "But ſhe thereof grew proud and inſolent, / That none ſhe worthie thought to be her fere, / But ſcornd them all, that loue vnto her ment; / Yet was ſhe lou’d of many a worthy pere, / Vnworthy ſhe to be belou’d ſo dere, / That could not weigh of worthineſſe aright."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfba9e15-d977-37d5-bcd4-2cc33adbc453",
                                        "entry_id": "fc199d8a-4acc-3d3d-ad40-d0320b0a6330",
                                        "glosses": [
                                            "To consider a subject."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8dc32bf8-d07f-38af-af3b-4e892506b3a4",
                                        "entry_id": "fc199d8a-4acc-3d3d-ad40-d0320b0a6330",
                                        "glosses": [
                                            "To have a certain weight."
                                        ],
                                        "tags": [
                                            "copulative",
                                            "intransitive",
                                            "stative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75620b31-13cf-4d1a-8354-beb3e609a30f",
                                                "sense_id": "8dc32bf8-d07f-38af-af3b-4e892506b3a4",
                                                "text": "I weigh ten and a half stone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cb49c77-21c0-3867-9b2a-fc11330d2d23",
                                        "entry_id": "fc199d8a-4acc-3d3d-ad40-d0320b0a6330",
                                        "glosses": [
                                            "To have weight; to be heavy; to press down."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27a531da-f9fc-41d9-b0b6-a0f574129e68",
                                                "sense_id": "1cb49c77-21c0-3867-9b2a-fc11330d2d23",
                                                "text": "If they ſhall faile, I with mine Enemies\nWill triumph o're my perſon, which I waigh not,\nBeing of thoſe Vertues vacant."
                                            },
                                            {
                                                "example_id": "c9b3a6ff-fbd4-4125-b499-781f4c988930",
                                                "sense_id": "1cb49c77-21c0-3867-9b2a-fc11330d2d23",
                                                "text": "They only weigh the heavier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28c77891-593d-3b4b-9ae4-d688d5e6ebb5",
                                        "entry_id": "fc199d8a-4acc-3d3d-ad40-d0320b0a6330",
                                        "glosses": [
                                            "To be considered as important; to have weight in the intellectual balance."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b1fa5cc-d75d-4dcc-b5c0-46f8dfb2180a",
                                                "sense_id": "28c77891-593d-3b4b-9ae4-d688d5e6ebb5",
                                                "text": "Your vowes to her, and me,[…] / Will euen weigh, and both as light as tales."
                                            },
                                            {
                                                "example_id": "242223a1-188a-4771-a054-7f9e7ee0cf9b",
                                                "sense_id": "28c77891-593d-3b4b-9ae4-d688d5e6ebb5",
                                                "text": "I anſwer, this is a good Objection, and ought to weigh with thoſe whoſe Reading is deſign’d for much Talk and little Knowledge, and I have nothing to ſay to it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "039d2dbf-f93d-3b29-8154-07bc13135f0b",
                                        "entry_id": "fc199d8a-4acc-3d3d-ad40-d0320b0a6330",
                                        "glosses": [
                                            "To raise an anchor free of the seabed."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c081663-4035-3d92-ae66-835ad04aa1a8",
                                        "entry_id": "fc199d8a-4acc-3d3d-ad40-d0320b0a6330",
                                        "glosses": [
                                            "To weigh anchor."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6607d88-40d3-4884-a0c6-e406b797d315",
                                                "sense_id": "2c081663-4035-3d92-ae66-835ad04aa1a8",
                                                "text": "Towards the euening we wayed, & approaching the ſhoare [...], we landed where there lay a many of baskets and much bloud, but ſaw not a Salvage."
                                            },
                                            {
                                                "example_id": "4a0ce241-b3e5-4994-9e3d-dbf78030f924",
                                                "sense_id": "2c081663-4035-3d92-ae66-835ad04aa1a8",
                                                "text": "Here we used to remain until nearly time for slack-water again, when we weighed and made for home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47826b09-675d-3484-af0e-64fa928fc1e5",
                                        "entry_id": "fc199d8a-4acc-3d3d-ad40-d0320b0a6330",
                                        "glosses": [
                                            "To bear up; to raise; to lift into the air; to swing up."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5e9fee5-34be-41fa-9731-5a2d6d0cc458",
                                                "sense_id": "47826b09-675d-3484-af0e-64fa928fc1e5",
                                                "text": "Weigh the vessel up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfaab05d-8de6-3130-bf09-375a3a4133cb",
                                        "entry_id": "fc199d8a-4acc-3d3d-ad40-d0320b0a6330",
                                        "glosses": [
                                            "To consider as worthy of notice; to regard."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a71f355f-8484-498b-a370-d0c4c29aa62c",
                                                "sense_id": "bfaab05d-8de6-3130-bf09-375a3a4133cb",
                                                "text": "Thinke you I weigh this treaſure more than you?\nNot all the Gold in Indias welthy armes,\nShall buy the meaneſt ſouldier in my traine."
                                            },
                                            {
                                                "example_id": "42d231dc-571f-4e34-b3df-c40b5b465cdc",
                                                "sense_id": "bfaab05d-8de6-3130-bf09-375a3a4133cb",
                                                "text": "Them all, and all that ſhe ſo deare did way,[…]"
                                            },
                                            {
                                                "example_id": "ea62bd22-d434-47e8-964a-ed6656b4eaf5",
                                                "sense_id": "bfaab05d-8de6-3130-bf09-375a3a4133cb",
                                                "text": "Kat. So do not you, for you are a light Wench. / Roſ. Indeed I waigh not you, and therefore light. / Ka. You waigh me not, O that’s you care not for me."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
