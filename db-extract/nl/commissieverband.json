                        "examples": [
                            {
                                "example_id": "f471104f-1d2f-4c5c-b0c9-3cc915dab7fb",
                                "sense_id": "f7783a24-4a43-30ac-8aaa-aa1b1d7771ce",
                                "text": "In de Tweede Kamer wordt in commissieverband vergaderd over de toekomst van Tata Steel. Vorige week bleek uit een rapport van het RIVM dat in de omgeving van de fabriek schadelijke hoeveelheden lood voorkomen."
                            },
                            {
                                "example_id": "3f9a1f92-4bbf-432e-a2bf-5a344d53ccfe",
                                "sense_id": "f7783a24-4a43-30ac-8aaa-aa1b1d7771ce",
                                "text": "De Tweede Kamer spreekt in commissieverband over klimaat en energie. Het debat zal vooral gaan over de gestegen gasprijzen, die zich komende winter dreigen te vertalen in een fors hogere energierekening voor huishoudens. Het kabinet zint op maatregelen om de pijn te verzachten."
                            }
