                ],
                "senses": [
                    {
                        "sense_id": "b9761ca1-d50b-39f2-88bc-daf675418485",
                        "entry_id": "58c07021-d265-3a99-a588-04911520b153",
                        "glosses": [
                            "Faire perdre son caractère artisanal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "523b21e7-b78f-4438-b2e8-4f5ac53a0e87",
                                "sense_id": "b9761ca1-d50b-39f2-88bc-daf675418485",
                                "text": "Non, elles collaient trop à leur siècle marchand, spectaculaire, utilitariste, pollueur, narcissique, menteur, robotisé, aseptisé, sur protéiné, désartisanalisé, idéologisé, désapprenti-librairisé, dixit mon imprimeur."
                            },
                            {
                                "example_id": "7f989bfa-3e69-4ea6-9228-8b75a8a53d2d",
                                "sense_id": "b9761ca1-d50b-39f2-88bc-daf675418485",
                                "text": "Parallèlement la cité se « désartisanalise » — le pourcentage des artisans-patrons régresse de 78 % en un demi-siècle, ce qui entraîne une modification des structures socio-professionnelles des classes populaires, d'autant que le genre de vie des milieux aisés, dions, pour schématiser, bourgeois, se modifie."
                            }
                        ]
                    }
