                "word": "Bacchanalian",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "33379a0a-053f-3935-b8df-b2e1b07e8e44",
                        "entry_id": "300e0914-bfd1-3d9d-8f74-701c2de6383c",
                        "glosses": [
                            "Of or pertaining to the festival of Bacchus, relating to or given to reveling and drunkenness."
                        ],
                        "tags": [
                            "Greek",
                            "Roman",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "98dc0ad5-c4bf-44a0-8222-5cbd7d49015a",
                                "sense_id": "33379a0a-053f-3935-b8df-b2e1b07e8e44",
                                "text": "Near-synonyms: bacchic, bacchian; Dionysiac, Dionysian; dionysiac, dionysian"
                            },
                            {
                                "example_id": "657b77ac-b4a4-4c9d-876f-185bb5b7fed0",
                                "sense_id": "33379a0a-053f-3935-b8df-b2e1b07e8e44",
                                "text": "Even Bacchanalian madness has its charms."
                            }
                        ]
                    }
                ],
