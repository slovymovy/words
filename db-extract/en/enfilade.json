                                                "example_id": "8449f6fa-a23c-4142-91de-d36539a8f018",
                                                "sense_id": "0955044c-31d8-379b-a188-13fd3b4bca61",
                                                "text": "„Obwohl die architektonischen Eingriffe aus unterschiedlichen Jahrzehnten stammen, präsentiert sich die 120 Meter lange Raumflucht als stilistisch stimmiges Ensemble.“"
                                            }
