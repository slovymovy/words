                                    {
                                        "sense_id": "126e87b6-8e6e-3d9f-a548-5559943755b3",
                                        "entry_id": "ed05f405-2bb2-3cc4-bff4-b5478f79bbdd",
                                        "glosses": [
                                            "naam voor koperlegeringen met zink"
                                        ],
                                        "tags": [
                                            "materiaalkunde"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46dd75f2-98c3-4360-977d-8db45a12d7f5",
                                                "sense_id": "126e87b6-8e6e-3d9f-a548-5559943755b3",
                                                "text": "De speciale munt is vervaardigd van tombak, een goudkleurige legering van koper (85 procent) en zink (15 procent)."
                                            },
                                            {
                                                "example_id": "249bb062-4347-4450-a3cd-4078c55759e0",
                                                "sense_id": "126e87b6-8e6e-3d9f-a548-5559943755b3",
                                                "text": "⧖ Zyne Majesteit, de Keizer, goedgevonden hebbende, dat in het toekomende de Kamerheeren altyd en ook buiten den dienst den Sleutel draagen, zo is reeds bevel gegeven, dat eenige honderd Kamerheeren-Sleutels van Tombak, in hét vuur verguld, zullen vervaardigd worden."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tombak",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f0e132fd-294b-37fd-94b0-8e01befd98cf",
                                        "entry_id": "42a7eac4-b394-3770-baca-e661b5e4edda",
                                        "glosses": [
                                            "soort trommel die veel wordt gebruikt in Perzische muziek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df2aba0a-e67b-416c-ae8f-a4a5391e1568",
                                                "sense_id": "f0e132fd-294b-37fd-94b0-8e01befd98cf",
                                                "text": "Het belangrijkste Iraanse slaginstrument is de tombak, ook wel zarb genoemd."
                                            }
                                        ]
