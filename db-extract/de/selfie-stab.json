                        "sense_id": "d9a424cc-2905-3288-9f42-41282aa0071e",
                        "entry_id": "ce332a72-4d7e-364e-ab6d-c48539978a97",
                        "glosses": [
                            "(ausziehbare) Stange, an deren Ende ein Smartphone oder eine Kamera befestigt werden kann, um damit ein Foto von sich selbst zu machen"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5d9aabf2-a6bb-43ef-a847-075be31b4317",
                                "sense_id": "d9a424cc-2905-3288-9f42-41282aa0071e",
                                "text": "Mithilfe von Selfie-Stäben lassen sich Gruppenfotos deutlich bequemer schießen."
                            },
                            {
                                "example_id": "e7570fd4-108c-4e89-932c-cb19144c094d",
                                "sense_id": "d9a424cc-2905-3288-9f42-41282aa0071e",
                                "text": "„Beim Fotografieren soll der Selfie-Stab das Leben leichter machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
