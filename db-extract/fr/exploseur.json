                        "glosses": [
                            "Dispositif permettant la mise à feu d’une charge explosive au moyen d’un courant électrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0ba12eb-db09-4537-be15-d048f6b4f753",
                                "sense_id": "e018c724-a6f7-3dd2-9313-59357fed4dd6",
                                "text": "Le détonateur peut être mis à feu par l’intermédiaire d'un exploseur, d'une mèche lente ou encore d’une amorce à percussion."
                            },
                            {
                                "example_id": "93231ac4-6560-41a3-bf8b-d4cca9b473ac",
                                "sense_id": "e018c724-a6f7-3dd2-9313-59357fed4dd6",
                                "text": "Chaque exploseur agit avec un intervalle possible sur dix charges, et sur une vingtaine en simultané."
                            }
                        ]
