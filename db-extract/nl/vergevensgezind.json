                                                "sense_id": "cbb7561b-c989-3592-aba0-9398aebd0956",
                                                "text": "„Die Datenstrukturen in Gleichung 6 sind miteinander verträglich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8bada339-043c-3f1f-9a40-2fa800aef555",
                                        "entry_id": "7fcc6a56-f949-35f4-b258-3ab5553cf8f6",
