                "senses": [
                    {
                        "sense_id": "f485d08a-390c-3e48-b186-ed3cbdd1a922",
                        "entry_id": "c0b1e780-a917-389f-ad66-1774012aa4c9",
                        "glosses": [
                            "Petit d’une souris, jeune souris."
                        ],
                        "tags": [
                            "Glirologie"
                        ],
                        "examples": [
                            {
                                "example_id": "1ca00dfa-e440-442d-b350-c2068562b321",
                                "sense_id": "f485d08a-390c-3e48-b186-ed3cbdd1a922",
                                "text": "Un souriceau tout jeune, et qui n’avait rien vu,\nfut presque pris au dépourvu."
                            },
                            {
                                "example_id": "a2fa8f58-cde6-4825-8cb2-9971f817cd5d",
                                "sense_id": "f485d08a-390c-3e48-b186-ed3cbdd1a922",
                                "text": "Bien que je ne fusse plus tout à fait le jeune souriceau dont parle la fable et qui trouve dans tout ce qu’il voit un sujet d’étonnement, d’admiration ou d’épouvante, je tombai, dès le commencement de ce voyage, dans une erreur qui fit bien rire mon maître et me valut ses railleries jusqu’à notre arrivée à Pau."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa4abe35-4000-4ef5-89b7-c338d6990d72",
                        "source_entry_id": "c0b1e780-a917-389f-ad66-1774012aa4c9",
                        "source_sense_id": "f485d08a-390c-3e48-b186-ed3cbdd1a922",
