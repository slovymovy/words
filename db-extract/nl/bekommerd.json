                    {
                        "sense_id": "9915f5ae-9b4b-3ece-aeab-ae6bb26352e7",
                        "entry_id": "d2bb0b7d-37a7-3f03-92dc-9b655fbcad07",
                        "glosses": [
                            "veel zorgen makend, van zorg vervuld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a3911dd-3885-4b59-b929-2eae0ad73859",
                                "sense_id": "9915f5ae-9b4b-3ece-aeab-ae6bb26352e7",
                                "text": "De bekommerde oma stond al bij het raam op de uitkijk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0849f5c1-a2ac-409b-96aa-b97f8b3db1b6",
                        "source_entry_id": "d2bb0b7d-37a7-3f03-92dc-9b655fbcad07",
                        "source_sense_id": "9915f5ae-9b4b-3ece-aeab-ae6bb26352e7",
                        "source_sense_description": "veel zorgen makend",
                        "target_lang_word": "anxious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anxious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c79f97a-dd45-3b30-9f59-60190c1e68b5",
                                        "entry_id": "7998b438-2de0-3b4c-aa86-2f240ee57a20",
                                        "glosses": [
                                            "Nervous and worried."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3add0a28-77b9-37a5-941b-810775236a6f",
                                        "entry_id": "7998b438-2de0-3b4c-aa86-2f240ee57a20",
                                        "glosses": [
                                            "Having a feeling of anxiety or disquietude; extremely concerned, especially about something that will happen in the future or that is unknown."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a37c49d-81a6-4cec-ad2f-f67d617f56d5",
                                                "sense_id": "3add0a28-77b9-37a5-941b-810775236a6f",
                                                "text": "She was anxious to hear how her test results were."
                                            },
                                            {
                                                "example_id": "f0388583-6d84-42f0-a85c-da60cb6ccc6a",
                                                "sense_id": "3add0a28-77b9-37a5-941b-810775236a6f",
                                                "text": "I could tell she was anxious as she was biting her nails."
                                            },
                                            {
                                                "example_id": "c9df8372-268f-45e4-8420-492485864765",
                                                "sense_id": "3add0a28-77b9-37a5-941b-810775236a6f",
                                                "text": "Thanks to that penny he had just spent so recklessly [on a newspaper] he would pass a happy hour, taken, for once, out of his anxious, despondent, miserable self. It irritated him shrewdly to know that these moments of respite from carking care would not be shared with his poor wife, with careworn, troubled Ellen."
                                            },
                                            {
                                                "example_id": "a6791298-93a1-4086-9689-62bc211b87da",
                                                "sense_id": "3add0a28-77b9-37a5-941b-810775236a6f",
                                                "text": "Meanwhile Nanny Broome was recovering from her initial panic and seemed anxious to make up for any kudos she might have lost, by exerting her personality to the utmost. She took the policeman's helmet and placed it on a chair, and unfolded his tunic to shake it and fold it up again for him."
                                            },
                                            {
                                                "example_id": "307c2a28-7953-4acc-80bf-409bbf9a2326",
                                                "sense_id": "3add0a28-77b9-37a5-941b-810775236a6f",
                                                "text": "But, with United fans in celebratory mood as it appeared their team might snatch glory, they faced an anxious wait as City equalised in stoppage time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ce9f4c9-3deb-33a9-9b71-f3ad312807c4",
                                        "entry_id": "7998b438-2de0-3b4c-aa86-2f240ee57a20",
                                        "glosses": [
                                            "Accompanied with, or causing, anxiety; worrying."
                                        ],
                                        "tags": [
                                            "of things"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d14c0e5-c9db-4f8a-b5a1-4ae4512d9cd5",
                                                "sense_id": "9ce9f4c9-3deb-33a9-9b71-f3ad312807c4",
                                                "text": "anxious labor"
                                            },
                                            {
                                                "example_id": "998cb87e-a83e-4a34-9518-5bd0c3629465",
                                                "sense_id": "9ce9f4c9-3deb-33a9-9b71-f3ad312807c4",
                                                "text": "There was an anxious wait before the results were revealed."
                                            },
                                            {
                                                "example_id": "29cb31ee-eb48-413e-beea-6f9b05484ef2",
                                                "sense_id": "9ce9f4c9-3deb-33a9-9b71-f3ad312807c4",
                                                "text": "The sweet of life, from which God hath bid dwell far off all anxious cares."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e49a0a8d-d196-336f-b4dd-b58bdf4e0b94",
                                        "entry_id": "7998b438-2de0-3b4c-aa86-2f240ee57a20",
                                        "glosses": [
                                            "Earnestly desirous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cad06ef-b5fa-4a82-9fd6-0c92c9fae370",
                                                "sense_id": "e49a0a8d-d196-336f-b4dd-b58bdf4e0b94",
                                                "text": "He is anxious to please, so you can count on him."
                                            },
                                            {
                                                "example_id": "d1b46214-811f-42e9-bc6e-6c17792fc98e",
                                                "sense_id": "e49a0a8d-d196-336f-b4dd-b58bdf4e0b94",
                                                "text": "All the voters were anxious to hear the election result."
                                            },
                                            {
                                                "example_id": "ef7a99d4-ee8b-4712-9b34-7f6b661b3fe0",
                                                "sense_id": "e49a0a8d-d196-336f-b4dd-b58bdf4e0b94",
                                                "text": "He sneers alike at those who are anxious to preserve and at those who are eager for reform."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8e758d6-e241-4a61-8f06-a3526e4fba17",
                        "source_entry_id": "d2bb0b7d-37a7-3f03-92dc-9b655fbcad07",
