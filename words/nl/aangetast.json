                {
                    "sense_id": "ca3cee2d-8e81-3dd6-b21d-f29a666f8e5a",
                    "sense_definition": "beschadigd of verzwakt door de inwerking van een schadelijke invloed, ziekte of slijtage",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aantasting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De door de schimmel <w>aangetaste</w> bomen moeten zo snel mogelijk worden gekapt.",
                            "target_lang_translations": {
                                "fr": "Les arbres <w>attaqués</w> par le champignon doivent être abattus le plus rapidement possible."
                            }
                        },
                        {
                            "text": "Zijn gezondheid is ernstig <w>aangetast</w> door de jarenlange zware arbeid.",
                            "target_lang_translations": {
                                "fr": "Sa santé a été gravement <w>altérée</w> par des années de travail pénible."
                            }
                        }
                    ],
                    "synonyms": [
                        "aangevreten"
                    ],
                    "antonyms": [
                        "onaangetast"
                    ],
                    "common_phrases": [
                        "ernstig aangetast",
                        "aangetast door vocht"
                    ],
                    "target_lang_definitions": {
                        "fr": "Endommagé, altéré ou affaibli par l'effet d'une influence nocive, d'une maladie ou de l'usure."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "touché",
                                "target_lang_sense_clarification": "par une maladie ou un dommage"
                            },
                            {
                                "target_lang_word": "atteint",
                                "target_lang_sense_clarification": "affecté physiquement ou par une maladie"
                            },
                            {
                                "target_lang_word": "altéré",
                                "target_lang_sense_clarification": "détérioré, dégradé"
                            },
                            {
                                "target_lang_word": "attaqué",
                                "target_lang_sense_clarification": "rongé ou détérioré par un élément externe"
                            }
                        ]
                    }
                }
            ]
        },
        {
