                        ],
                        "examples": [
                            {
                                "example_id": "4c438763-31f8-401e-85b8-06b6a716c8cf",
                                "sense_id": "fb3cc9c6-9d7b-3916-8849-78594116f989",
                                "text": "Il était onze heures, M. Pelletier détourna à regret son regard de la mer qui, à cette heure-ci, tirait sur le violet, \"une mer vineuse\", pensa Hélène qui avait lu Homère et qui, elle aussi, mais trois étages plus haut, debout face à la baie vitrée, regardait l'horizon tandis que Xavier Lhomond, derrière, en la besognant, disait des choses cochonnes qui la lassaient."
                            }
                        ]
                    }
                ],
