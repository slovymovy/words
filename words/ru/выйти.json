                        "de": [
                            {
                                "target_lang_word": "erscheinen",
                                "target_lang_sense_clarification": "von Büchern, Filmen oder Alben"
                            },
                            {
                                "target_lang_word": "herauskommen",
                                "target_lang_sense_clarification": "auf den Markt oder ins Kino kommen"
