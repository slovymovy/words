                "translations": [
                    {
                        "translation_id": "186f5c04-5c38-4253-9b08-71f7bba4757a",
                        "source_entry_id": "2ce58b0d-9ded-36e4-97fe-96a74dfb9721",
                        "source_sense_id": "bc7c423b-2c11-3d4d-a2de-55d591b231cd",
                        "source_sense_description": "een ondergrondse ruimte die bestemd is voor het opsluiten van gevangenen",
                        "target_lang_word": "Kerker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kerker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23cccc0d-d710-3022-97a6-f3f02ee0544e",
                                        "entry_id": "1e5315f3-c1bf-331a-8c9b-f13536792f4e",
                                        "glosses": [
                                            "Gefängnis, Zuchthaus, Justizvollzugsanstalt"
                                        ],
                                        "tags": [
                                            "historical",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e019510e-428b-4d2c-99bc-86a77756e043",
                                                "sense_id": "23cccc0d-d710-3022-97a6-f3f02ee0544e",
                                                "text": "Sie hielten ihn im Kerker gefangen."
                                            },
                                            {
                                                "example_id": "69872496-5123-4cc4-87b5-60e0ebb421a2",
                                                "sense_id": "23cccc0d-d710-3022-97a6-f3f02ee0544e",
                                                "text": "„Während Harald im Kerker sitzt, begehrt das Volk gegen den neuen Kaiser auf.“"
                                            },
                                            {
                                                "example_id": "2112db0e-e673-43e2-865e-f09cea6f31e2",
                                                "sense_id": "23cccc0d-d710-3022-97a6-f3f02ee0544e",
                                                "text": "„Der Rest wurde in den Kerker der Festung gebracht.“"
                                            },
                                            {
                                                "example_id": "85e075a1-8df5-42ad-8f5e-6d0305a62263",
                                                "sense_id": "23cccc0d-d710-3022-97a6-f3f02ee0544e",
                                                "text": "„Die Kerle, die in den verschiedenen Kerkern folterten, waren kleine Emporkömmlinge, die man hier und da in einem der zahlreichen Befreiungskriege aufgelesen hatte.“"
                                            },
                                            {
                                                "example_id": "ebfb180c-f18d-49fe-9cfd-44432553f02a",
                                                "sense_id": "23cccc0d-d710-3022-97a6-f3f02ee0544e",
                                                "text": "„Während wir in diesem Kerker saßen, feuerte eine Gruppe betrunkener Indianer im Vorbeigehen eine Salve auf uns, aber zum Glück wurde niemand verletzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
