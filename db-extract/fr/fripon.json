                                "target_word": "szelma",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "2e5fc13f-32a6-3b74-91d3-3fc780f34878",
                                        "entry_id": "54c8c33f-cb88-3082-bc16-f2c234bb8d7a",
                                        "glosses": [
                                            "osoba przebiegła, cwana, pozbawiona skrupułów; hultajska, łajdacka, łotrowska"
                                        ],
                                        "tags": [
                                            "commonly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15f62d18-aeb3-459a-993f-72fa1300d7d1",
                                                "sense_id": "2e5fc13f-32a6-3b74-91d3-3fc780f34878",
                                                "text": "Sąsiad należy do grona szelmów, typków spod ciemnej gwiazdy."
                                            },
                                            {
                                                "example_id": "6bbdb515-088b-4d66-a695-39233cd7b5de",
                                                "sense_id": "2e5fc13f-32a6-3b74-91d3-3fc780f34878",
                                                "text": "Ewa poczuła nareszcie, że jest dziewką schorowaną, zżartą od syfilisu, szelmą uliczną, sprzedajnym bydlęciem"
                                            },
                                            {
                                                "example_id": "4db5f97f-bd0e-4466-b645-4b77b7f47ea8",
                                                "sense_id": "2e5fc13f-32a6-3b74-91d3-3fc780f34878",
                                                "text": "Szelmy, chcą mnie do ruiny doprowadzić tą swoją pomadą! […] Odkąd bawimy tutaj, spotrzebowały tłuszczu co najmniej z dwunastu świń […] Potrzebne doprawdy wyrzucać tyle pieniędzy po to, aby sobie gęby paćkać!"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "6e9cde66-7af2-3031-8d10-938a81c50f71",
                                        "entry_id": "54c8c33f-cb88-3082-bc16-f2c234bb8d7a",
                                        "glosses": [
                                            "spryciarz, urwis, psotnik, wisus"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfa1f815-c31a-4f81-8d32-e357d845fede",
                                                "sense_id": "6e9cde66-7af2-3031-8d10-938a81c50f71",
                                                "text": "A to szelma, znowu mu się udało."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    }
