                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "29542bc9-9af9-483d-9dcf-416105b823b1",
                        "entry_id": "b19b023c-89ba-3aac-acd0-cbb312c82bae",
                        "tags": [
                            "plural"
                        ],
                        "form": "olivines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0d4d196e-aeef-329f-a18d-5be9c17d5b7b",
                        "entry_id": "b19b023c-89ba-3aac-acd0-cbb312c82bae",
                        "glosses": [
                            "Any of a group of olive green magnesium-iron silicate minerals that crystallize in the orthorhombic system."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "12aaff5e-20d6-4f84-b551-1d08a8e881c4",
                                "sense_id": "0d4d196e-aeef-329f-a18d-5be9c17d5b7b",
                                "text": "The olivine crystals in most basalts are imperfect, lacking clear crystal faces."
                            },
                            {
                                "example_id": "a34b9822-5818-4474-be8c-f3baf415c2c1",
                                "sense_id": "0d4d196e-aeef-329f-a18d-5be9c17d5b7b",
                                "text": "To do so, his team mixed together limestone with a crushed silicate mineral that contains magnesium — such as olivine, an olive-tinted mineral that can be found around the world. When heated to furiously high temperatures in a kiln, calcium in the limestone and magnesium in the silicate jiggle and switch sides, like participants in a square dance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90168635-535c-4b7d-8d59-48cada8eedf9",
                        "source_entry_id": "b19b023c-89ba-3aac-acd0-cbb312c82bae",
                        "source_sense_id": "0d4d196e-aeef-329f-a18d-5be9c17d5b7b",
                        "source_sense_description": "family of minerals forming orthorhombic crystals",
                        "target_lang_word": "olivine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "olivine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c629ad86-fa91-3c2d-bdf4-a512f4dd3a64",
                                        "entry_id": "707c86d5-5e2f-35b5-980a-380906cf6e2f",
                                        "glosses": [
                                            "Minéral de couleur verdâtre du groupe des silicates, sous-groupe des nésosilicates qui cristallise dans le système orthorhombique; considéré en joaillerie comme une pierre fine (semi-précieuse)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9082a82-5803-4b8c-9ea0-cd5cd3208571",
                                                "sense_id": "c629ad86-fa91-3c2d-bdf4-a512f4dd3a64",
                                                "text": "Cet élément-trace est aussi présent dans les émeraudes, le grenat-pyrope et l’olivine."
                                            },
                                            {
                                                "example_id": "dc496e77-7597-4920-95cd-1e803f297a56",
                                                "sense_id": "c629ad86-fa91-3c2d-bdf4-a512f4dd3a64",
                                                "text": "La source la plus considérable est le manteau terrestre, où les péridotites sont justement formées de minéraux ferro-magnésiens comme les olivines et les pyroxènes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63fedea3-171a-48ee-81ff-38dd2dc1eef0",
                        "source_entry_id": "b19b023c-89ba-3aac-acd0-cbb312c82bae",
