        "fr-extract.jsonl": [
            {
                "entry_id": "69747ac5-7106-36c5-8fda-b08197a97051",
                "word": "odalisque",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d992000d-97bb-4a1f-b330-684093c22a3c",
                        "entry_id": "69747ac5-7106-36c5-8fda-b08197a97051",
                        "tags": [
                            "plural"
                        ],
                        "form": "odalisques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e914cc83-8b14-31d4-9951-3bf10e5b3e77",
                        "entry_id": "69747ac5-7106-36c5-8fda-b08197a97051",
                        "glosses": [
                            "Femme de chambre ou esclave qui était au service des femmes d'un harem."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "789fb084-5240-46bf-970b-30f5eafbd6f2",
                                "sense_id": "e914cc83-8b14-31d4-9951-3bf10e5b3e77",
                                "text": "C'est contre elles et l'air de galanterie que Mme de Chartres prévient sa fille, car cette cour est surpeuplée de femmes de petite vertu, toujours prêtes à se donner, comme des odalisques de sérail, même si elles ne sont plus favorites: […]."
                            },
                            {
                                "example_id": "b14295db-564f-4921-81d6-ae522d526352",
                                "sense_id": "e914cc83-8b14-31d4-9951-3bf10e5b3e77",
                                "text": "Le tiaré est particulièrement l’ornement des fêtes, des festins et des danses ; lorsqu’il est offert par une Tahitienne à un jeune homme, il a le même sens à peu près que le mouchoir jeté par le sultan à son odalisque préférée."
                            }
                        ]
                    },
                    {
                        "sense_id": "710ae11a-8b03-3504-b2e6-74f7db65554f",
                        "entry_id": "69747ac5-7106-36c5-8fda-b08197a97051",
                        "glosses": [
                            "Femme d'un harem, un des thèmes favoris de la peinture orientaliste où elle est généralement représentée allongée, nue ou peu vêtue."
                        ],
                        "tags": [
                            "Peinture"
                        ],
                        "examples": [
                            {
                                "example_id": "e9bb6829-780f-4226-b122-7d25e8d957b6",
                                "sense_id": "710ae11a-8b03-3504-b2e6-74f7db65554f",
                                "text": "L'Odalisque couchée, tableau d'Ingres."
                            }
                        ]
                    },
                    {
                        "sense_id": "e871d67f-c585-3915-9451-ca3ea303f1e4",
                        "entry_id": "69747ac5-7106-36c5-8fda-b08197a97051",
                        "glosses": [
                            "Courtisane, maîtresse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "523927de-c058-4bab-98d1-5d3bb1beb9d4",
                                "sense_id": "e871d67f-c585-3915-9451-ca3ea303f1e4",
                                "text": "— Odalisque, jubilait-elle, ils ont pris la princesse Popo pour une odalisque, sont-ils assez sots ? Et moi qui provoque une querelle byzantine ! Et toi qui m’enlèves à leur nez et à leur barbe !… Voilà le sérail qui déraille…"
                            }
                        ]
                    },
                    {
                        "sense_id": "24c7c156-0b9b-3303-ab21-a78915da49f8",
                        "entry_id": "69747ac5-7106-36c5-8fda-b08197a97051",
                        "glosses": [
                            "Libellule dont une espèce eurasiatique vit en Grèce, à Chypre, en Turquie, jusqu'au Cachemire à l'est."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2e5976e-24f2-4021-8fe2-01c9ff7097b3",
                        "source_entry_id": "69747ac5-7106-36c5-8fda-b08197a97051",
                        "target_lang_word": "Odaliske",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Odaliske",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87a10af9-a646-3ff8-a492-1e1a6662a967",
                                        "entry_id": "565c3cd4-ff45-3a04-b93c-2348ab114788",
                                        "glosses": [
                                            "hellhäutige (europäische oder kaukasische) Sklavin, die als Dienerin, Konkubine oder Kammermädchen in einem osmanischen Harem dem Sultan oder anderen hochgestellten Personen persönlich zur Verfügung stand"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba15799a-f811-4268-8c48-ef9f6dfa1252",
                                                "sense_id": "87a10af9-a646-3ff8-a492-1e1a6662a967",
                                                "text": "„Ich war in deinen Harem eingesperrt, saß da, hatte zu warten, bis der Pascha so gnädig war, seiner Odaliske das Taschentuch zuzuwerfen …“"
                                            },
                                            {
                                                "example_id": "c605c5fd-07d3-4613-9d93-947fbcf2feda",
                                                "sense_id": "87a10af9-a646-3ff8-a492-1e1a6662a967",
                                                "text": "„Und alle Sorten Wasser haben sie, für Odalisken und für Efendis, wenn die duften wollen, und Pulver, die den Augen Glanz verleihen, und Tropfen in den Kaffee, die eitel Freude bewirken.“"
                                            },
                                            {
                                                "example_id": "2ff87574-c912-4ab1-bb4a-c7e15585b20e",
                                                "sense_id": "87a10af9-a646-3ff8-a492-1e1a6662a967",
                                                "text": "„Im Traum vermeint sie sich zu erinnern, wie sie einst als Kind in einem Basar entführt wurde, hernach als Odaliske im Harem eines Scheichs heranwuchs und wie später die eifersüchtige erste Frau ihres Gebieters den Fluch ewiger Amnesie über sie verhängte.“"
                                            },
                                            {
                                                "example_id": "23db012b-4d24-4b3b-80b2-3ac41a918873",
                                                "sense_id": "87a10af9-a646-3ff8-a492-1e1a6662a967",
                                                "text": "„Die Odalisken im Harem konnten sich in den aus Venedig eingeführten Spiegeln an ihrer Schönheit gar nicht sattsehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a87bcbd-6faf-44a6-b9ea-e1d62cdc967d",
                        "source_entry_id": "69747ac5-7106-36c5-8fda-b08197a97051",
                        "target_lang_word": "odalisque",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "odalisque",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad6e8fff-20c5-3818-833b-5db1781439de",
                                        "entry_id": "4e6c2485-c1bb-3f7b-b64c-104ac316b53a",
                                        "glosses": [
                                            "A female slave in a harem, especially one in the Ottoman seraglio."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0155f9c-d5a4-4df9-a218-5f1ec1ebb2f0",
                                                "sense_id": "ad6e8fff-20c5-3818-833b-5db1781439de",
                                                "text": "When the young Mauretanians were his guests in the little houses before the town gates, and he was of a good humour, it would come about that he displayed his odalisques as others would their jewels."
                                            },
                                            {
                                                "example_id": "54d1eebf-71d5-4ec3-86e2-b9d9d2bf5766",
                                                "sense_id": "ad6e8fff-20c5-3818-833b-5db1781439de",
                                                "text": "They grew fat, but successfully resisted the enticing odalisques with whom they were confronted."
                                            },
                                            {
                                                "example_id": "3aa9c90d-04b6-4694-9193-2244b9fcbce5",
                                                "sense_id": "ad6e8fff-20c5-3818-833b-5db1781439de",
                                                "text": "Though I could see the titan odalisques and their garden and knew them to be no more than dream-stuff recalled, I could not escape from their fascination and the memory of the dream."
                                            },
                                            {
                                                "example_id": "ad1307ac-b873-41f0-9e41-a336fc210a28",
                                                "sense_id": "ad6e8fff-20c5-3818-833b-5db1781439de",
                                                "text": "The Sector is borne in a padded Waggon, like some mechanickal Odalisque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7f4124d-0787-375c-9912-304720b5b9cd",
                                        "entry_id": "4e6c2485-c1bb-3f7b-b64c-104ac316b53a",
                                        "glosses": [
                                            "A desirable or sexually attractive woman."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
