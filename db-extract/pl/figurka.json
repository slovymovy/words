                        "sense_id": "1b79e679-15f9-3b14-81e3-d75e5e58d2bc",
                        "entry_id": "370e650f-c911-373a-8bf4-0df50b23fbb1",
                        "glosses": [
                            "od: figura"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c8db10cc-b410-32ac-b69b-c298d29837e5",
                        "entry_id": "370e650f-c911-373a-8bf4-0df50b23fbb1",
                        "glosses": [
                            "mała figura, rzeźba"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38130383-caa9-4b38-8f52-46720d7452c4",
                                "sense_id": "c8db10cc-b410-32ac-b69b-c298d29837e5",
                                "text": "Istnieje przekonanie, że figurka słonia z podniesioną trąbą przynosi szczęście."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3c52c04-89d3-4cf4-ad09-4ad19ba170af",
                        "source_entry_id": "370e650f-c911-373a-8bf4-0df50b23fbb1",
                        "source_sense_id": "c8db10cc-b410-32ac-b69b-c298d29837e5",
                        "target_lang_word": "figurine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "figurine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "878bee31-ab84-34c8-870c-41c175f49785",
                                        "entry_id": "46f6a49a-bdfc-32cb-83b6-240067a65994",
                                        "glosses": [
                                            "A small carved or molded figure; a statuette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f37ed64-266d-48a0-9dc0-ee989a10ac57",
                                                "sense_id": "878bee31-ab84-34c8-870c-41c175f49785",
                                                "text": "Galvanised by this knowledge, the figurine family take to exercise and healthy eating in the park, forming themselves into the key words \"Eat\" (better), \"Move\" (more) and \"Live\" (longer) of the government's urgings and soon the municipal landscape is filled with other happy, healthier families who, incidentally, look even more delicious en masse."
                                            },
                                            {
                                                "example_id": "352f8ba8-3d16-4d08-acda-568b639cbe5a",
                                                "sense_id": "878bee31-ab84-34c8-870c-41c175f49785",
                                                "text": "While figurines were an integral part of Late Neolithic and Early Copper Age life, they disappear from society until the later Nuragic period.[…]The lack of figurines is a conscious choice, as is the decision to produce over 500 bronze figurines (bronzetti) in phases III and IV of the Nuragic period."
                                            },
                                            {
                                                "example_id": "17394593-3b3f-48ac-8b5a-75777649bab4",
                                                "sense_id": "878bee31-ab84-34c8-870c-41c175f49785",
                                                "text": "For the abbreviation of the name of the pieces, each player is free to use the name which is commonly used in his/her country. Examples: F = fou (French for bishop), L = loper (Dutch for bishop). In printed periodicals, the use of figurines is recommended."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6be0e254-d2b1-4ab1-a574-cf1cf54b492e",
                        "source_entry_id": "370e650f-c911-373a-8bf4-0df50b23fbb1",
                        "source_sense_id": "c8db10cc-b410-32ac-b69b-c298d29837e5",
                        "target_lang_word": "figurine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "figurine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08e1b5f6-5770-342c-9330-4d76f558597e",
                                        "entry_id": "f47f457b-0da0-3b4e-bde8-af1a380a208e",
                                        "glosses": [
                                            "Petite figure préhistorique ou antique de terre cuite, de bronze, d’argent, etc."
                                        ],
                                        "tags": [
                                            "Sculpture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3865c0c0-d245-43b0-8b17-b23a078d11e5",
                                                "sense_id": "08e1b5f6-5770-342c-9330-4d76f558597e",
                                                "text": "Cet amateur a une précieuse collection de figurines."
                                            },
                                            {
                                                "example_id": "1471b0bb-94f8-4e31-861f-6cfb6ae6ee92",
                                                "sense_id": "08e1b5f6-5770-342c-9330-4d76f558597e",
                                                "text": "Sauf une figurine informe trouvée à Solutré et un équidé gravé sur un os provenant de Creswell-Crags (Angleterre), toutes ces ébauches, tous ces essais de gravure ou de sculpture avaient été trouvés dans le midi de la France ; et on pensait que les troglodytes de la Gascogne avaient eu le monopole de l’art, dans les premiers temps où nous pouvons affirmer l’existence de l’homme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d3a7264-9890-3960-8451-08b35ec1ac1f",
                                        "entry_id": "f47f457b-0da0-3b4e-bde8-af1a380a208e",
                                        "glosses": [
                                            "Statuette."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25aa22e6-1de8-4a70-bcdc-0bf43e805980",
                                                "sense_id": "8d3a7264-9890-3960-8451-08b35ec1ac1f",
                                                "text": "Ce tombeau est un monument fort intéressant, bien que la figure du personnage, traitée en bas-relief, soit médiocre ; le simulacre du sarcophage qui la porte donne une série de figurines d’une conservation parfaite, […]."
                                            },
                                            {
                                                "example_id": "9d6e4d8f-1407-46aa-ac42-fc8c281a729d",
                                                "sense_id": "8d3a7264-9890-3960-8451-08b35ec1ac1f",
                                                "text": "On peut, mais plus rarement, en rencontrer modelant, parfois avec un instinct sûr, de « rustiques figurines », si originales qu’un musée d’ethnographie pourrait désirer les mettre dans ses vitrines, affirmant ainsi la vérité de cette parole d’un savant archéologue : « Il n’y a pas de différence entre les inventions des Bushmen ou des Hottentots et celles des premiers Grecs. »"
                                            },
                                            {
                                                "example_id": "14a6008e-3824-4693-81bb-951efe8d59e5",
                                                "sense_id": "8d3a7264-9890-3960-8451-08b35ec1ac1f",
                                                "text": "Figurines de Saxe, de Sèvres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10b5f628-1b06-3720-89a4-076e847619a5",
                                        "entry_id": "f47f457b-0da0-3b4e-bde8-af1a380a208e",
                                        "glosses": [
                                            "Pion ou petit jouet représentant un personnage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "803364e0-b64c-4514-bc3c-948a5b8f9e98",
                                                "sense_id": "10b5f628-1b06-3720-89a4-076e847619a5",
                                                "text": "Après un jeu de figurines (encore un) ayant récolté des centaines de millions d’euros via Kickstarter, Conan le Barbare est l’objet de nombreux projets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41df29a4-7217-3d34-a553-48dedeb51ae2",
                                        "entry_id": "f47f457b-0da0-3b4e-bde8-af1a380a208e",
                                        "glosses": [
                                            "Petite image en deux dimensions symbolisant une personne ou un usager."
                                        ],
                                        "tags": [
                                            "Dessin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43d9acd2-6753-4432-b7b4-7da1b683f09a",
                                                "sense_id": "41df29a4-7217-3d34-a553-48dedeb51ae2",
                                                "text": "Le 12 décembre, mise en place de figurines vélo en association des doubles chevron au niveau des différentes bretelles d’accès afin d’indiquer les zones d’interaction potentielle avec les cyclistes (bretelles d’accès à la RD 1085). Cela permet aussi pour les véhicules venant de la RD 1085, de mieux visualiser la présence des cyclistes et la répartition des différents espaces au niveau de la CVCB."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8702ee3f-168a-3cb8-8b29-e82256b4c084",
                                        "entry_id": "f47f457b-0da0-3b4e-bde8-af1a380a208e",
                                        "glosses": [
                                            "Petite image en deux dimensions symbolisant une personne ou un usager.",
                                            "Représentation en deux dimensions d’un modèle de mode."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56a5ab9f-8690-41a1-953f-5938c83bb7d8",
                                                "sense_id": "8702ee3f-168a-3cb8-8b29-e82256b4c084",
                                                "text": "Le patron d’une figurine de mode."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
