                    {
                        "translation_id": "7bcf1bc8-f90c-4e57-9e5e-46ab565dfe7d",
                        "source_entry_id": "3d11402c-0f2e-377a-866c-f6c178c9d66d",
                        "source_sense_id": "ee0d2d14-c5b3-320f-81b0-5bc921d0aed8",
                        "target_lang_word": "květenství",
