                ],
                "senses": [
                    {
                        "sense_id": "8f8da8a1-1899-30a4-b6bd-e1c98a039650",
                        "entry_id": "c9c7a4e5-7740-3856-88b1-27cc325fc26b",
                        "glosses": [
                            "(u ludzi i zwierząt) niechęć lub chorobliwy lęk przed ludźmi"
                        ],
                        "tags": [
                            "psychology"
                        ],
                        "examples": [
                            {
                                "example_id": "91e60297-414a-4fdd-8a87-1210642b8ca8",
                                "sense_id": "8f8da8a1-1899-30a4-b6bd-e1c98a039650",
                                "text": "Najbardziej istotne zmiany występują w grupach zwierząt wykazujących antropofobię lub ścisły związek ze środowiskami naturalnymi. Zmiany wywołane urbanizacją powodują w pierwszym rzędzie zmniejszanie się powierzchni terenów, na których mogą one żyć"
                            },
                            {
                                "example_id": "ce18cf71-3e16-4dba-95cc-c99a44bbbb52",
                                "sense_id": "8f8da8a1-1899-30a4-b6bd-e1c98a039650",
                                "text": "Miliony ludzi cierpią na antropofobię, czyli chorobliwy lęk przed innymi ludźmi"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ceff1dea-5169-440a-8de7-953921004809",
                        "source_entry_id": "c9c7a4e5-7740-3856-88b1-27cc325fc26b",
                        "source_sense_id": "8f8da8a1-1899-30a4-b6bd-e1c98a039650",
                        "target_lang_word": "anthropophobia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anthropophobia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "382c17f3-add9-36de-8378-4d9d62a823fa",
                                        "entry_id": "73e3d396-4a13-33fc-8683-95a67d576bbd",
                                        "glosses": [
                                            "A profound fear of human beings, or of human society."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "552becd2-5d8d-4238-b995-9a7bebe7796e",
                                                "sense_id": "382c17f3-add9-36de-8378-4d9d62a823fa",
                                                "text": "The affection is unlike anthropophobia, because this is characterized by dislike of men, and decided aversion to sexual intercourse."
                                            },
                                            {
                                                "example_id": "c923b590-084d-4b88-8fc6-96ef329deb70",
                                                "sense_id": "382c17f3-add9-36de-8378-4d9d62a823fa",
                                                "text": "It was when anthropophobia set in, when he was made uneasy by people who walked too close to him, that, sagely viewing his list and seeing how many phobias were now checked, he permitted himself to rest."
                                            },
                                            {
                                                "example_id": "8453c097-955e-4cc0-9d40-fb378ca8c7e7",
                                                "sense_id": "382c17f3-add9-36de-8378-4d9d62a823fa",
                                                "text": "He was suffering from anthropophobia, a typical Japanese symptom which shows alienation, and liberation, from the embracing community."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d22f373-8d1b-4db9-92e3-8f8194313f1b",
                        "source_entry_id": "c9c7a4e5-7740-3856-88b1-27cc325fc26b",
                        "source_sense_id": "8f8da8a1-1899-30a4-b6bd-e1c98a039650",
