                "translations": [
                    {
                        "translation_id": "1e6ccf74-7750-43f4-a952-bc4f78e07d2b",
                        "source_entry_id": "92bd57ab-98a5-357c-8971-1cec812dbdee",
                        "source_sense_id": "4b94e604-3dc3-3c3b-baac-7a31aa98eeae",
                        "target_lang_word": "monograph",
