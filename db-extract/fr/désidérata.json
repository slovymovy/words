                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9701017-2442-496a-bac4-3ea27faf5454",
                                "sense_id": "6e4507af-4822-340b-b9a3-864acb61c316",
                                "text": "Quels sont vos désidératas en matière de vacances ?"
                            },
                            {
                                "example_id": "a11e77a6-79ca-419c-9d97-cc39033dc5e8",
                                "sense_id": "6e4507af-4822-340b-b9a3-864acb61c316",
                                "text": "J'ai des idées arrêtées\nTrop de désidératas"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a21fc078-2be5-4f2e-82ff-28b64d5cd59d",
