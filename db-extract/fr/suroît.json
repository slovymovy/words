                    }
                ],
                "senses": [
                    {
                        "sense_id": "386a0893-b528-3b34-b58e-4b53940f4096",
                        "entry_id": "3d0cc2e0-9c4d-3040-9414-908effdfef6e",
                        "glosses": [
                            "Direction sud-ouest."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6e2f5bb0-d280-357c-b6b0-502d60790700",
                        "entry_id": "3d0cc2e0-9c4d-3040-9414-908effdfef6e",
                        "glosses": [
                            "Vent du sud-ouest."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "387fd5bf-6db1-41aa-9c53-7be8ca6eca79",
                                "sense_id": "6e2f5bb0-d280-357c-b6b0-502d60790700",
                                "text": "Une tempête de suroît."
                            },
                            {
                                "example_id": "2b6108b3-3d31-4ead-90ac-c7be233827c5",
                                "sense_id": "6e2f5bb0-d280-357c-b6b0-502d60790700",
                                "text": "D’autant que, Leterrier ne me contredira point, c’est pas d’la brume de mer, c’tte brume-là : le vent est quasi de suroît, c’est de la brume de terre."
                            },
                            {
                                "example_id": "18e0f5ca-6580-490c-9193-2656daa94721",
                                "sense_id": "6e2f5bb0-d280-357c-b6b0-502d60790700",
                                "text": "Et tout à coup,sans sommation, l’invisible tempête de suroît se rue sur nous avec la violence d’une charge de cavalerie."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ebfc6ce-a3a9-3716-a315-ea49485ba714",
                        "entry_id": "3d0cc2e0-9c4d-3040-9414-908effdfef6e",
                        "glosses": [
                            "Chapeau imperméable qui protège la tête et la partie postérieure du cou des marins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1978699d-80a3-43b7-8b8f-91dd759d68cf",
                                "sense_id": "3ebfc6ce-a3a9-3716-a315-ea49485ba714",
                                "text": "À cause de la pluie, personne n’était sorti, sauf le vieux M. Thévenard qui, en ciré de marin, un suroît sur la tête, était allé prendre sa place au bout de la jetée."
                            },
                            {
                                "example_id": "f30a0c55-ee87-4b7b-a1b2-d65601088c17",
                                "sense_id": "3ebfc6ce-a3a9-3716-a315-ea49485ba714",
                                "text": "Par-dessous, il y avait un vieux suroît blanchi aux embruns de bien des môles."
                            },
                            {
                                "example_id": "1c2489c3-cec2-48e8-9e79-a9ef1db3d286",
                                "sense_id": "3ebfc6ce-a3a9-3716-a315-ea49485ba714",
                                "text": "Ces cinq hommes étaient vêtus pareillement, un épais tricot de laine bleue serrant le torse et s’enfonçant dans la ceinture du pantalon ; sur la tête, l’espèce de casque en toile goudronnée qu’on appelle suroît (du nom de ce vent de sud-ouest qui dans notre hémisphère amène les pluies)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "565e5ae5-8e73-4fb9-b1a4-7584d1202257",
                        "source_entry_id": "3d0cc2e0-9c4d-3040-9414-908effdfef6e",
                        "source_sense_id": "386a0893-b528-3b34-b58e-4b53940f4096",
                        "source_sense_description": "Direction",
                        "target_lang_word": "Südwester",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Südwester",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e77c20b-b769-3554-9fed-ff4c13d82085",
                                        "entry_id": "af5e23af-5bed-3460-aaca-6d9b634a7e8e",
                                        "glosses": [
                                            "eine haubenartige Kopfbedeckung zum Wetterschutz (überwiegend auf See)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db9b60c2-6e7a-4d66-ad56-1b8289b7b31e",
                                                "sense_id": "5e77c20b-b769-3554-9fed-ff4c13d82085",
                                                "text": "Besser ist du setzt deinen Südwester auf."
                                            },
                                            {
                                                "example_id": "453d33fc-788b-4904-a88f-db5599294555",
                                                "sense_id": "5e77c20b-b769-3554-9fed-ff4c13d82085",
                                                "text": "„Es half nichts, daß mir Gummistiefel, ein Südwester für den Kopf und ein Regenmantel, der bis zum Boden reichte, gekauft wurden.“"
                                            },
                                            {
                                                "example_id": "e3da40da-e612-4db6-b0b6-1ac5c1fea225",
                                                "sense_id": "5e77c20b-b769-3554-9fed-ff4c13d82085",
                                                "text": "„Auf dem Kopf der Südwester verbarg sein Gesicht.“"
                                            },
                                            {
                                                "example_id": "9f6784d6-10cc-4067-93a3-11130ec789ea",
                                                "sense_id": "5e77c20b-b769-3554-9fed-ff4c13d82085",
                                                "text": "„Kleine Kinder in gelben Gummimänteln und Südwestern drängten sich an die Beine ihrer Eltern.“"
                                            },
                                            {
                                                "example_id": "426987c3-b967-46d0-b624-ab0eae003cf2",
                                                "sense_id": "5e77c20b-b769-3554-9fed-ff4c13d82085",
                                                "text": "„Bevor Thomas widersprechen konnte, hatte sie bereits einen Wettermantel angezogen und einen dunklen Südwester übergestülpt; ihren Hiddensee-Look.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "48109391-29fc-3d33-a1d7-f9e1a255cbba",
                                        "entry_id": "af5e23af-5bed-3460-aaca-6d9b634a7e8e",
                                        "glosses": [
                                            "Eigenbezeichnung der deutschsprachigen Einwohner Namibias"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fd250cd-3751-455b-a5b9-5ca8a24ec2b3",
                                                "sense_id": "48109391-29fc-3d33-a1d7-f9e1a255cbba",
                                                "text": "Ich bin geborener Südwester."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1d04af3b-8d7d-3307-8258-2b5c6ff2e243",
                                        "entry_id": "af5e23af-5bed-3460-aaca-6d9b634a7e8e",
                                        "glosses": [
                                            "Hut der Schutztruppe im ehemaligen Deutsch-Südwestafrika"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
