        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7deedd27-e1ae-36c5-91dd-59a3d91e13d9",
                    "sense_definition": "Qui est dénoué, désassemblé ou mis en désordre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "desordre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a laissé un lit <w>défait</w> au milieu de la pièce avant de partir.",
                            "target_lang_translations": {
                                "en": "She left an <w>unmade</w> bed in the middle of the room before leaving.",
                                "ru": "Перед уходом она оставила посреди комнаты <w>неубранную</w> кровать.",
                                "de": "Vor dem Gehen hat sie ein <w>ungemachtes</w> Bett mitten im Zimmer zurückgelassen.",
                                "es": "Antes de marcharse, dejó una cama <w>deshecha</w> en medio de la habitación.",
                                "zh": "她离开前，房间中央留下了一张<w>凌乱</w>的床。"
                            }
                        },
                        {
                            "text": "Il portait une veste froissée et un col de chemise entièrement <w>défait</w>.",
                            "target_lang_translations": {
                                "en": "He was wearing a crumpled jacket and a shirt collar completely <w>undone</w>.",
                                "ru": "На нём был помятый пиджак и полностью <w>расстёгнутый</w> воротник рубашки.",
                                "de": "Er trug eine zerknitterte Jacke und einen vollständig <w>aufgeknöpften</w> Hemdkragen.",
                                "es": "Llevaba una chaqueta arrugada y el cuello de la camisa totalmente <w>desabrochado</w>.",
                                "zh": "他穿着一件皱巴巴的外套，衬衫领口完全<w>敞开</w>着。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dénoué",
                        "désordonné"
                    ],
                    "antonyms": [
                        "noué",
                        "ordonné"
                    ],
                    "common_phrases": [
                        "lit défait"
                    ],
                    "target_lang_definitions": {
                        "en": "Loosened, taken apart, or left in disorder.",
                        "ru": "Развязанный, расстёгнутый, разобранный или пришедший в беспорядок.",
                        "de": "Gelöst, auseinandergenommen oder in Unordnung gebracht.",
                        "es": "Que está desatado, desmontado o en desorden.",
                        "zh": "形容词，指被解开、拆散或弄乱的，处于凌乱或敞开的状态。"
                    },
