    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "878b4f1f-aa97-3c5c-bd85-52bced0e126b",
                    "sense_definition": "To identify a medical condition or disease by examining the symptoms of a patient.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "identification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor was able to <w>diagnose</w> the illness after looking at the blood test results.",
                            "target_lang_translations": {
                                "ru": "Врач смог <w>диагностировать</w> болезнь после изучения результатов анализа крови."
                            }
                        },
                        {
                            "text": "It is often difficult to <w>diagnose</w> a rare disease without specialized medical equipment.",
                            "target_lang_translations": {
                                "ru": "Часто бывает трудно <w>поставить диагноз</w> при редком заболевании без специального медицинского оборудования."
                            }
                        }
                    ],
                    "synonyms": [
                        "identify"
                    ],
                    "common_phrases": [
                        "diagnose a disease",
                        "diagnose a patient",
                        "correctly diagnose"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определить заболевание или состояние здоровья пациента на основе обследования и симптомов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диагностировать",
                                "target_lang_sense_clarification": "определять болезнь"
                            },
                            {
                                "target_lang_word": "поставить диагноз",
                                "target_lang_sense_clarification": "заключить о наличии болезни"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85ca555c-a25a-31bd-b247-d3b9c2721d9c",
                    "sense_definition": "To determine the nature or cause of a technical problem or mechanical fault.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "identification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mechanics use this portable tool to <w>diagnose</w> engine faults and clear error codes.",
                            "target_lang_translations": {
                                "ru": "Механики используют этот портативный инструмент, чтобы <w>диагностировать</w> неисправности двигателя и сбрасывать коды ошибок."
                            }
                        },
                        {
                            "text": "The technician spent several hours trying to <w>diagnose</w> the problem with the computer network.",
                            "target_lang_translations": {
                                "ru": "Техник потратил несколько часов, пытаясь <w>выявить</w> проблему в компьютерной сети."
                            }
                        }
                    ],
                    "synonyms": [
                        "troubleshoot",
                        "analyze"
                    ],
                    "common_phrases": [
                        "diagnose a fault",
                        "diagnose the problem",
                        "diagnose an issue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определить характер или причину технической неисправности или механического дефекта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диагностировать",
                                "target_lang_sense_clarification": "выявлять неисправность системы"
                            },
                            {
                                "target_lang_word": "проводить диагностику",
                                "target_lang_sense_clarification": "технический осмотр"
                            },
                            {
                                "target_lang_word": "выявлять",
                                "target_lang_sense_clarification": "находить причину проблемы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
