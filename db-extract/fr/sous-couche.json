                    {
                        "sense_id": "f5adabb9-1210-3f2a-afca-409070cb7149",
                        "entry_id": "e9fbbd32-580d-3064-adbe-d6c6196eed2d",
                        "glosses": [
                            "Première couche de peinture, avant la couche définitive (ou les couches définitives), destinée à faciliter l’adhérence de la peinture finale."
                        ],
                        "tags": [
                            "Peinture"
                        ],
                        "examples": [
                            {
                                "example_id": "04fab671-ac73-4d47-b4ca-0ee8e593ab63",
                                "sense_id": "f5adabb9-1210-3f2a-afca-409070cb7149",
                                "text": "À ce stade, le sondage restait désespérément improductif. La sous-couche la plus ancienne paraissait ne jamais avoir reçu la moindre polychromie."
                            }
                        ]
                    }
