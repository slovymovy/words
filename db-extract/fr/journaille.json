                        "sense_id": "f1a061df-74ba-3583-89a7-6abd75dffcca",
                        "entry_id": "94f3bcaa-6d06-3c34-85cc-37dbdeeafc0a",
                        "glosses": [
                            "Journée."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "ddc78d60-06aa-462f-9cf1-a3cf8e43523f",
                                "sense_id": "f1a061df-74ba-3583-89a7-6abd75dffcca",
                                "text": "On peut pas glander ici quatre journailles à se croûtonner derrière la lourde."
                            },
                            {
                                "example_id": "a3b7fa82-aedb-4b19-89ea-e6d14303afc7",
                                "sense_id": "f1a061df-74ba-3583-89a7-6abd75dffcca",
                                "text": "Seuls, par des journailles trop chaudardes, des papillons venaient filer des petits coups d’ailes pour rafraîchir les tendres amours des deux mignons."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "c8dc03d6-bb6c-30af-a0ba-db237ece2496",
                "word": "journaille",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8b01dd34-8b09-3c2c-9aee-adbcb21fd55a",
                        "entry_id": "c8dc03d6-bb6c-30af-a0ba-db237ece2496",
                        "glosses": [
                            "L’ensemble des mauvais journalistes, notamment les compromis avec le pouvoir et les lobbies, ainsi que ceux de la presse à sensation."
                        ],
                        "tags": [
                            "collective",
                            "pejorative",
                            "singular"
                        ],
                        "examples": [
                            {
                                "example_id": "7741d382-303a-4088-8e2c-b803af20f341",
                                "sense_id": "8b01dd34-8b09-3c2c-9aee-adbcb21fd55a",
                                "text": "Au rayon des oxymorons de notre postmodernité libérale, voici un cas qui tient presque de l’allégorie vivante. Célèbre designer bruxellois, Karl Nisiak* pratique ce qu’on pourrait appeler l’“exploitation sympa”. C’est en quelque sorte un négrier humaniste, un BHL du design. Les toutous de la journaille le kiffent, comme de bien entendu."
                            },
                            {
                                "example_id": "a4623478-27a0-4d77-b604-cd58581a888a",
                                "sense_id": "8b01dd34-8b09-3c2c-9aee-adbcb21fd55a",
                                "text": "La messe était dite, célébrée par la journaille sur la foi de sondages mesurant les effets de son matraquage."
                            },
                            {
                                "example_id": "fbb10e70-a11b-493e-ac1f-f1a0baea247b",
                                "sense_id": "8b01dd34-8b09-3c2c-9aee-adbcb21fd55a",
                                "text": "Peu importe à la journaille, la condamnation de Hulot vient de tomber en moins de 72 heures sur les plateaux de télévision. Une curieuse justice, très expéditive, qui ne se soucie ni de loyauté, ni des droits de la défense, ni d’équité, ni de la présomption d’innocence – Pour la journaille c’est la présomption de culpabilité qui compte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39ee8a35-640a-4972-b4bc-7dd96c854655",
                        "source_entry_id": "c8dc03d6-bb6c-30af-a0ba-db237ece2496",
                        "source_sense_id": "8b01dd34-8b09-3c2c-9aee-adbcb21fd55a",
                        "target_lang_word": "Journaille",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Journaille",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8d0a5192-2843-316e-b727-89c51e6e58ea",
                                        "entry_id": "3b60a928-645f-3ffb-ba00-796b48ac85b4",
                                        "glosses": [
                                            "minderwertige, sensationsgierige Presse und ihre Vertreter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "979b3754-4e9b-4acf-abe8-5f3b4cda7df2",
                                                "sense_id": "8d0a5192-2843-316e-b727-89c51e6e58ea",
                                                "text": "„Finstere Mächte und die Journaille hätten sich verbündet, die rot-rote Koalition zu sprengen.“"
                                            },
                                            {
                                                "example_id": "54e586d7-bd1a-47b0-8a72-f1d7d53e3de4",
                                                "sense_id": "8d0a5192-2843-316e-b727-89c51e6e58ea",
                                                "text": "„Journalisten kritisierten in Journalen wortreich die Journaille…“"
                                            },
                                            {
                                                "example_id": "b8695968-e19f-4ead-b9da-1dd31c1e052b",
                                                "sense_id": "8d0a5192-2843-316e-b727-89c51e6e58ea",
                                                "text": "„So stark war seine Verachtung der Journaille, so stark seine Achtung vor formaler Pressefreiheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
