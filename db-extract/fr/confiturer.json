                    },
                    {
                        "sense_id": "a609396c-f9c8-3108-b235-ac7bf30e7c64",
                        "entry_id": "dcfae5fc-4929-36e7-af5d-bbef4c8093ec",
                        "glosses": [
                            "Tartiner de confiture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52d159ec-a692-4dca-8029-b2d3f9d6e6e7",
                                "sense_id": "a609396c-f9c8-3108-b235-ac7bf30e7c64",
                                "text": "Il se fit un café et trempa dedans une biscotte confiturée."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2bf2e09-57c9-3436-8ae0-f591d01a4b35",
                        "entry_id": "dcfae5fc-4929-36e7-af5d-bbef4c8093ec",
                        "glosses": [
                            "Doter de confiture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2e27d6b-5d7b-49d3-9b8a-cb090400c2c1",
                                "sense_id": "f2bf2e09-57c9-3436-8ae0-f591d01a4b35",
                                "text": "Quand j’eus relié tous ces signes entre eux, je compris que le dépôt du Centre Aéré n’était pas la plus riche colonie de la plage, et que je ne pouvais décemment pas rester l’amie d'une enfant dont la famille — dûment confiturée tous les matins — pouvait s’enorgueillir de la possession d’un vrai sac de plage, de la location de deux transats, et d’un séjour-plein-tarif aux \"Ducs de Bretagne\"."
                            }
                        ]
                    }
