                "senses": [
                    {
                        "sense_id": "7b690e03-a0f6-3327-a501-19a80decf4fc",
                        "entry_id": "460087e3-4520-3156-a780-93122042a1ad",
                        "glosses": [
                            "Donner un caractère unisexe à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1393701-6431-47eb-a378-0f2c10049493",
                                "sense_id": "7b690e03-a0f6-3327-a501-19a80decf4fc",
                                "text": "Il serait bon de ne pas toujours unisexuer des défauts au détriment des uns ou à l'avantage des autres..."
                            },
                            {
                                "example_id": "5f615711-c39f-48ac-9312-12795293cc1a",
                                "sense_id": "7b690e03-a0f6-3327-a501-19a80decf4fc",
                                "text": "On observera aussi le ridicule consistant à vouloir sexuer à mort les mots dans le but d'unisexuer les comportements…"
                            },
                            {
                                "example_id": "ba3f0b52-19c4-4208-ac32-859379122661",
                                "sense_id": "7b690e03-a0f6-3327-a501-19a80decf4fc",
                                "text": "Je ne parle pas de ceux qui pratiquent la bicyclette, cette saine activité qui allie la détente, la dépense physique et la joie simple d’être ensemble pour une belle promenade : cela ne concerne plus qu’une élite très restreinte, généralement regroupée en familles, ces trucs dépassés qu’on voudrait monoparentaliser ou unisexuer pour mieux s'en défaire."
                            }
                        ]
                    }
