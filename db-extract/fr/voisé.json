                    {
                        "sense_id": "3841a5ec-d6c0-3085-8da6-246e3cdb7516",
                        "entry_id": "7a55c06f-61e4-383f-9182-5245d8acd77b",
                        "glosses": [
                            "Se dit d’un son dont la prononciation implique la vibration des cordes vocales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31b2ed1b-6361-4946-8e75-672aacab6cb5",
                                "sense_id": "3841a5ec-d6c0-3085-8da6-246e3cdb7516",
                                "text": "/z/ et /ʒ/ sont des consonnes voisées, au contraire de leurs pendants sourds respectifs, /s/ et /ʃ/."
                            },
                            {
                                "example_id": "68eddf4b-6a02-4cd0-8c30-9c096cd34869",
                                "sense_id": "3841a5ec-d6c0-3085-8da6-246e3cdb7516",
                                "text": "Elle passe des soirées entières sur les consonnes rétroflexes, doubles ou voisées, s’entraînant à replier sa langue sur son palais pour la faire claquer, comme les gens d’ici."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "909125ae-14ae-4c54-aa0e-9af98f91761d",
                        "source_entry_id": "7a55c06f-61e4-383f-9182-5245d8acd77b",
                        "source_sense_id": "3841a5ec-d6c0-3085-8da6-246e3cdb7516",
                        "target_lang_word": "stimmhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stimmhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "09ca4336-8f13-3a09-a44e-4380144c49ea",
                                        "entry_id": "09ef65d0-9760-3358-9525-72d46dabfc5e",
                                        "glosses": [
                                            "Eigenschaft eines Lautes, der mit Schwingung der Stimmlippen (Stimmbänder) artikuliert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "270bb5f9-efad-4b42-8b65-b137f927abcc",
                                                "sense_id": "09ca4336-8f13-3a09-a44e-4380144c49ea",
                                                "text": "Stimmhaft werden im Deutschen gebildet: Vokale, Sonanten, einige Gleitlaute (vor allem: [i̯, ʊ̯]) und diejenigen Plosive ([b, d, g]) und Frikative ([v, z, ʒ]), bei denen die Stimmbänder schwingen."
                                            },
                                            {
                                                "example_id": "a4b1f7e3-aca9-4686-86f1-0f528953d16e",
                                                "sense_id": "09ca4336-8f13-3a09-a44e-4380144c49ea",
                                                "text": "Phonologisch gesehen gehört stimmhaft zur Opposition von stimmhaft - stimmlos; das Wortpaar \"reisen\" ([ʀaɪ̯zn̩]) - \"reißen\" ([ʀaɪ̯sn̩]) unterscheidet sich genau durch diese Opposition."
                                            },
                                            {
                                                "example_id": "f8a07d9a-001e-4e3d-8e28-3f9453a0c4f1",
                                                "sense_id": "09ca4336-8f13-3a09-a44e-4380144c49ea",
                                                "text": "„Der Stoßton, ein Fast-Kehlkopfverschluss in langvokalischer und stimmhaft konsonantischer Umgebung (…), ist Deutschen weniger von der phonetischen Substanz, sondern eher von der Distribution her fremd.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
