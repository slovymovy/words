                    {
                        "translation_id": "d1338649-f332-4965-80c8-82c4ed25b171",
                        "source_entry_id": "a7f740f5-451f-3336-93aa-5e384d1b9a94",
                        "source_sense_description": "plant of the genus Hedera",
                        "target_lang_word": "lierre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lierre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9c3e3db-b3f0-3092-b7cc-7b9c609b9bc8",
                                        "entry_id": "8a096e70-34b0-3aaa-83e1-0b087f7b9eac",
                                        "glosses": [
                                            "Nom usuel des représentants du genre Hedera, plantes sempervirentes, qui rampent à terre ou qui grimpent le long des murailles et autour des arbres et dont le type est le lierre grimpant ou Hedera helix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7556fe0-44d0-4576-8b0d-da2631a799d2",
                                                "sense_id": "c9c3e3db-b3f0-3092-b7cc-7b9c609b9bc8",
                                                "text": "Bien des fois la nuit, de cette fenêtre tapissée de lierre, j'ai regardé avant de m'endormir le grand Orion inclinant vers l'ouest ; […]."
                                            },
                                            {
                                                "example_id": "3518c22d-87a6-4ce7-80c0-89fb091a17ee",
                                                "sense_id": "c9c3e3db-b3f0-3092-b7cc-7b9c609b9bc8",
                                                "text": "Pour ne pas se griser, malgré les nombreuses libations inhérentes à des fêtes de ce genre, on garnissait de lierre, bouteilles, lampes et meubles !"
                                            },
                                            {
                                                "example_id": "f519e526-8441-4b36-bc55-3c8f73c6427d",
                                                "sense_id": "c9c3e3db-b3f0-3092-b7cc-7b9c609b9bc8",
                                                "text": "Les sapins ont cent ans et ne verront pas un autre siècle, parce que le lierre gaine leurs troncs et les étouffe…"
                                            },
                                            {
                                                "example_id": "c72af7e3-2779-459a-9a80-db33b789316f",
                                                "sense_id": "c9c3e3db-b3f0-3092-b7cc-7b9c609b9bc8",
                                                "text": "Le lierre, toujours vert, même en hiver, symbolise en effet pleinement la vigueur de la nature et la sève vitale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
