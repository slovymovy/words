            {
                "entry_id": "9d404ba5-d265-390e-8c92-970c13e15803",
                "word": "Juul",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4bd3efdc-7ff5-4603-b65f-c23954e14e7f",
                        "entry_id": "9d404ba5-d265-390e-8c92-970c13e15803",
                        "tags": [
                            "plural"
                        ],
                        "form": "Juuls"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c1a29e9e-05f9-349d-9172-5fcc3dfb0654",
                        "entry_id": "9d404ba5-d265-390e-8c92-970c13e15803",
                        "glosses": [
                            "A particular electronic cigarette of this type."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95c381be-b8f3-4fa7-a8d2-8c5f8de5cab7",
                                "sense_id": "c1a29e9e-05f9-349d-9172-5fcc3dfb0654",
                                "text": "While adolescents are canny enough to hide their Juuls from you, they don't really believe that vaping is harmful."
                            },
                            {
                                "example_id": "127df338-536c-4bc1-b4f4-baaf4e868fad",
                                "sense_id": "c1a29e9e-05f9-349d-9172-5fcc3dfb0654",
                                "text": "A Juul is an e-cigarette that looks like a USB thumb drive and uses a \"pod\" system for refills."
                            },
                            {
                                "example_id": "b9cdbd7a-a59e-45bb-8380-88c49e9ea0ec",
                                "sense_id": "c1a29e9e-05f9-349d-9172-5fcc3dfb0654",
                                "text": "[Jason] Jeong, the Cornell graduate, says his peers stopped using Juuls when the company discontinued its popular flavors. People liked mint, which remained on the shelves, but no one wanted to puff on a tobacco-flavored Juul."
                            },
                            {
                                "example_id": "ffac08ab-6313-4b56-a15a-3fe2938c0f37",
                                "sense_id": "c1a29e9e-05f9-349d-9172-5fcc3dfb0654",
                                "text": "But by spring of that year, nobody had a lighter – everyone had started vaping instead. So I followed my friends and jumped off the cliff: I bought a Juul."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "88ed0de9-80fc-3672-9b8d-d7034e91e1fa",
                "word": "Juul",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "fca777e7-30d6-49be-b7e1-8dae4f5f01a2",
