                "senses": [
                    {
                        "sense_id": "686b2b62-4352-37f3-8a25-98a4900f0e9e",
                        "entry_id": "bcdaa578-5cef-336a-b033-260f02dc152b",
                        "glosses": [
                            "Waage, die von 0 bis 200 oder 500 Gramm wiegt, mit einer Toleranz von 0,1 Gramm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0d044e8-a5e4-437d-80cc-aa8495de4db1",
                                "sense_id": "686b2b62-4352-37f3-8a25-98a4900f0e9e",
                                "text": "Goldwaagen werden von Juwelieren benutzt, um das Gewicht eines Schmuckstückes und somit dessen Wert zu bestimmen."
                            },
                            {
                                "example_id": "18da09dd-4285-40ec-8277-fa01f4cad839",
                                "sense_id": "686b2b62-4352-37f3-8a25-98a4900f0e9e",
                                "text": "Meist sind Goldwaagen so gebaut, dass man sie leicht verstauen und transportieren kann."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
