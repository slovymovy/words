                        "glosses": [
                            "The father of a family; the male head of household, or of any collection of persons living as a family or in common, as in a primitive community."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fb9134b4-c6fe-3597-b9d2-a9adb877104c",
                        "entry_id": "3198918d-0c7a-36fc-952e-9a9b687d4edc",
                        "glosses": [
                            "A man in charge of a residence for young people to look after them."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a4996b5-02d9-4a26-89a2-762693e33a80",
                        "source_entry_id": "3198918d-0c7a-36fc-952e-9a9b687d4edc",
                        "source_sense_description": "father of a family; the male head of household",
                        "target_lang_word": "Hausvater",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hausvater",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "20747cd3-fd4c-3a68-bb2a-e313ebd329a3",
                                        "entry_id": "97425e7a-b8cd-399a-8bd4-1c0985c333bf",
                                        "glosses": [
                                            "Verantwortlicher/hierarchisch übergeordnete Person eines einzelnen Hauses einer Einrichtung, in welcher mehrere Personen über einen längeren Zeitraum wohnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f029d93-7a45-448c-a96b-c7a9ffb3d569",
                                                "sense_id": "20747cd3-fd4c-3a68-bb2a-e313ebd329a3",
                                                "text": "Mein Hausvater hat mir Hausarrest aufgebrummt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1152f463-d9c9-3f70-8ab5-352ceceef805",
                                        "entry_id": "97425e7a-b8cd-399a-8bd4-1c0985c333bf",
                                        "glosses": [
                                            "männlicher Haushaltsvorstand mit Verantwortung gegenüber Familie und Angestellten"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "552551f7-76fd-4c81-a048-a9da3d93122d",
                                                "sense_id": "1152f463-d9c9-3f70-8ab5-352ceceef805",
                                                "text": "„Der Hausvater soll eine gute Schule haben und ein großes Haus recht regieren; er soll aber auch ein tüchtiger Oekonom sein, der 10, 20–30 und mehr Morgen Feldes gut bewirthschaftet.“ (1863)"
                                            },
                                            {
                                                "example_id": "75b0c475-51b2-4828-85ba-cd0f8a607043",
                                                "sense_id": "1152f463-d9c9-3f70-8ab5-352ceceef805",
                                                "text": "„Ohne jedoch ein Wort zu sagen, setzte sich die Familie zu Tische, über welchen der Hausvater ein langes Gebet verrichtete.“"
                                            },
                                            {
                                                "example_id": "0e3fc987-3fdf-42db-9ebf-059c14511bf4",
                                                "sense_id": "1152f463-d9c9-3f70-8ab5-352ceceef805",
                                                "text": "„Der Hausvaterbegleitete mich hinaus – er war der Zellenleiter.“"
                                            },
                                            {
                                                "example_id": "2aaa16c9-dc19-49ce-94ff-84e41678820c",
                                                "sense_id": "1152f463-d9c9-3f70-8ab5-352ceceef805",
                                                "text": "„Der Hausvater stellt eine Frage.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
