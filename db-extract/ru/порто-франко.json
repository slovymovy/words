                    {
                        "translation_id": "9034bea7-b056-4d2a-91c1-55097cefe039",
                        "source_entry_id": "7e6c4f9f-f2ba-38fd-9644-9f300551c975",
                        "target_lang_word": "Freihafen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Freihafen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "04db543f-25ea-373a-b61e-114c95680c0d",
                                        "entry_id": "038a6266-7023-3aa6-9d5a-f4fec9909390",
                                        "glosses": [
                                            "Hafen oder Teil eines Hafens, auf dessen Gebiet keine Zölle oder Einfuhrumsatzsteuern erhoben werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e94a6c8f-b245-4821-8a5f-11705087b471",
                                                "sense_id": "04db543f-25ea-373a-b61e-114c95680c0d",
                                                "text": "„Seit 18 Jahren ist der bärtige Wasserzöllner im Hamburger Hafen unterwegs. Seine Truppe und er sind zuständig für die mehr als 4 Hektar Freihafen und 3 Hektar Wasserfläche.“"
                                            },
                                            {
                                                "example_id": "1557ba69-5efe-4bd4-8754-007e11e27006",
                                                "sense_id": "04db543f-25ea-373a-b61e-114c95680c0d",
                                                "text": "„Die Kennzeichnungspflicht nach dem Pflanzenschutzgesetz gilt auch nicht für Pflanzenschutzmittel, die für die Ausfuhr bestimmt sind oder sich im Falle der Einfuhr in einem Freihafen oder noch nicht im freien Verkehr befinden.“"
                                            },
                                            {
                                                "example_id": "dcf2bb43-b778-46c6-bce1-999c10094547",
                                                "sense_id": "04db543f-25ea-373a-b61e-114c95680c0d",
                                                "text": "„Auf italienischer Seite bekam Triest den Status eines Freihafens innerhalb der EU, unter anderem mit reduziertem Zoll.“"
                                            },
                                            {
                                                "example_id": "96297a3d-ae4b-4888-b92b-00a654921c9a",
                                                "sense_id": "04db543f-25ea-373a-b61e-114c95680c0d",
                                                "text": "„Denn wir befinden uns nicht einfach im Hafengebiet, sondern in einem besonderen, streng abgeriegelten Bezirk: im Freihafen, der jetzt den Russen vorbehalten ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
