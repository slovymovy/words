                "senses": [
                    {
                        "sense_id": "9eb55e23-dcb7-3812-9eaa-9a269754eb13",
                        "entry_id": "fe32b779-c2db-34de-9f31-78438a639f6c",
                        "glosses": [
                            "Action de flageoler, tremblement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84face50-c804-4ea3-b317-97db8c7d925a",
                                "sense_id": "9eb55e23-dcb7-3812-9eaa-9a269754eb13",
                                "text": "Heureusement ce n’était pas encore trop grave et, avec mon aide, Izo put regagner la boucherie sans que trop de clients ne remarquassent son flageolement généralisé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95d0cba3-4b4c-4a26-bd39-8cafd8384dea",
                        "source_entry_id": "fe32b779-c2db-34de-9f31-78438a639f6c",
                        "source_sense_id": "9eb55e23-dcb7-3812-9eaa-9a269754eb13",
                        "target_lang_word": "stagger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stagger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3332155e-35f5-3f50-8196-9c126258977b",
                                        "entry_id": "4c209643-6a82-345c-b695-5b30ef5f1d8e",
                                        "glosses": [
                                            "An unsteady movement of the body in walking or standing as if one were about to fall; a reeling motion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1daeee54-1695-4299-bbfb-de9361d6d739",
                                                "sense_id": "3332155e-35f5-3f50-8196-9c126258977b",
                                                "text": "7 October 2012, Paolo Bandini in The Guardian, Denver Broncos 21 New England Patriots 31 - as it happened\nPut down the rosary beads folks, I believe hell may just have frozen over. Peyton Manning drops back, sees nothing open and runs for a first down. If you can call that running. More like the stagger of a wounded rhino. Did the job, though"
                                            },
                                            {
                                                "example_id": "a625cc8b-7e70-4e4f-aab4-91d495283379",
                                                "sense_id": "3332155e-35f5-3f50-8196-9c126258977b",
                                                "text": "Afy slowly gathered in the sense of the words. She gasped twice, as if her breath had gone, and then, with a stagger and a shiver, fell heavily to the ground."
                                            },
                                            {
                                                "example_id": "d3d535f9-5a1c-412f-9adf-1975c24966a6",
                                                "sense_id": "3332155e-35f5-3f50-8196-9c126258977b",
                                                "text": "the stagger of a drunken man"
                                            },
                                            {
                                                "example_id": "2881c12f-7e90-4512-98ec-4e73ea52faf8",
                                                "sense_id": "3332155e-35f5-3f50-8196-9c126258977b",
                                                "text": "And when old Fezziwig and Mrs. Fezziwig had gone all through the dance; advance and retire; both hands to your partner, bow and courtesy, corkscrew, thread the needle, and back again to your place; Fezziwig \"cut\"—cut so deftly that he appeared to wink with his legs, and came upon his feet again without a stagger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "000bf55b-6c5f-33a6-86ba-b017864640e4",
                                        "entry_id": "4c209643-6a82-345c-b695-5b30ef5f1d8e",
                                        "glosses": [
                                            "A disease of horses and other animals, attended by reeling, unsteady gait or sudden falling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c82b39a0-e250-44a5-a4d0-5392766f0b7d",
                                                "sense_id": "000bf55b-6c5f-33a6-86ba-b017864640e4",
                                                "text": "parasitic staggers"
                                            },
                                            {
                                                "example_id": "97894e01-83e6-4525-9c00-392ec436b18e",
                                                "sense_id": "000bf55b-6c5f-33a6-86ba-b017864640e4",
                                                "text": "apoplectic or sleepy staggers"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0a46a63-b8e9-3e3d-83d2-6637f45378ec",
                                        "entry_id": "4c209643-6a82-345c-b695-5b30ef5f1d8e",
                                        "glosses": [
                                            "Bewilderment; perplexity."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bf991440-9954-3c16-9f0e-ebab481529e8",
                                        "entry_id": "4c209643-6a82-345c-b695-5b30ef5f1d8e",
                                        "glosses": [
                                            "The spacing out of various actions over time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac1038cd-a644-4652-8596-90e6ad0a4dbd",
                                                "sense_id": "bf991440-9954-3c16-9f0e-ebab481529e8",
                                                "text": "19 April 2016, Rachel Roddy in The Guardian, Rachel Roddy’s Roman spring vegetable stew recipe\nI don’t include cured pork, although it is very nice, and rather than putting everything in the pan at once I prefer a stagger of ingredients, which ensures each one gets the right amount of time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0c2cdbd-fddd-3633-af67-c2af8067eafa",
                                        "entry_id": "4c209643-6a82-345c-b695-5b30ef5f1d8e",
                                        "glosses": [
                                            "The difference in circumference between the left and right tires on a racing vehicle. It is used on oval tracks to make the car turn better in the corners."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0b5d1b21-26af-3bef-953f-1a5cce5fe211",
                                        "entry_id": "4c209643-6a82-345c-b695-5b30ef5f1d8e",
                                        "glosses": [
                                            "The horizontal positioning of a biplane, triplane, or multiplane's wings in relation to one another."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "stagger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5f191ce-ed7d-3a5a-b1ee-21268a7c9234",
                                        "entry_id": "d7f2a7bf-4222-3478-a206-1d75f6fd0559",
                                        "glosses": [
                                            "To sway unsteadily, reel, or totter.",
                                            "In standing or walking, to sway from one side to the other as if about to fall; to stand or walk unsteadily; to reel or totter."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6629790c-0999-4735-83f1-1657e0118170",
                                                "sense_id": "c5f191ce-ed7d-3a5a-b1ee-21268a7c9234",
                                                "text": "She began to stagger across the room."
                                            },
                                            {
                                                "example_id": "f3c47a04-46e4-4442-905a-5b4b1574b5f1",
                                                "sense_id": "c5f191ce-ed7d-3a5a-b1ee-21268a7c9234",
                                                "text": "Deep was the wound; he staggered with the blow."
                                            },
                                            {
                                                "example_id": "142a0648-fa2e-4b5a-ba02-0cc2aa2a1f74",
                                                "sense_id": "c5f191ce-ed7d-3a5a-b1ee-21268a7c9234",
                                                "text": "The burnt and bleeding man staggered to his feet, dazed and unbelieving, and asked the startled townspeople who came running whether his fireman and guard were safe. He was kept away from the smouldering crater where his engine had been, and taken to hospital."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31f6e483-b61c-31a6-a848-c162033bc57f",
                                        "entry_id": "d7f2a7bf-4222-3478-a206-1d75f6fd0559",
                                        "glosses": [
                                            "To sway unsteadily, reel, or totter.",
                                            "To cause to reel or totter."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a79f4ac9-3f4e-42e5-9aaf-90782a1dbdf6",
                                                "sense_id": "31f6e483-b61c-31a6-a848-c162033bc57f",
                                                "text": "The powerful blow of his opponent's fist staggered the boxer."
                                            },
                                            {
                                                "example_id": "ca76ea4b-b214-4421-9c2e-2987798141f7",
                                                "sense_id": "31f6e483-b61c-31a6-a848-c162033bc57f",
                                                "text": "That hand shall burn in never-quenching fire / That staggers thus my person."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4ec8171-8537-39e6-9bc9-4fecec31849a",
                                        "entry_id": "d7f2a7bf-4222-3478-a206-1d75f6fd0559",
                                        "glosses": [
                                            "To sway unsteadily, reel, or totter.",
                                            "To cease to stand firm; to begin to give way; to fail."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19666895-fc4e-45db-8c4f-e8aa8ace5d5c",
                                                "sense_id": "a4ec8171-8537-39e6-9bc9-4fecec31849a",
                                                "text": "1708, Joseph Addison, The Present State of the War, and the Necessity of an Augmentation"
                                            },
                                            {
                                                "example_id": "4194d458-63e4-47fb-b437-42ede7b48924",
                                                "sense_id": "a4ec8171-8537-39e6-9bc9-4fecec31849a",
                                                "text": "The enemy staggers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c527be4b-9adf-3abe-b5df-04772a247900",
                                        "entry_id": "d7f2a7bf-4222-3478-a206-1d75f6fd0559",
                                        "glosses": [
                                            "Doubt, waver, be shocked.",
                                            "To begin to doubt and waver in purposes; to become less confident or determined; to hesitate."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1a46a15-17cc-4149-8350-5ad8076ea1b3",
                                                "sense_id": "c527be4b-9adf-3abe-b5df-04772a247900",
                                                "text": "He [Abraham] staggered not at the promise of God through unbelief."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcf5ec1e-dbb4-3fee-a8ec-808634c48591",
                                        "entry_id": "d7f2a7bf-4222-3478-a206-1d75f6fd0559",
                                        "glosses": [
                                            "Doubt, waver, be shocked.",
                                            "To cause to doubt and waver; to make to hesitate; to make less steady or confident; to shock."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bf1b349-063d-4a49-b6e8-f5f796a5a43a",
                                                "sense_id": "bcf5ec1e-dbb4-3fee-a8ec-808634c48591",
                                                "text": "He will stagger the committee when he presents his report."
                                            },
                                            {
                                                "example_id": "ff8b4e58-628b-4850-9ca2-894e2fac7a5b",
                                                "sense_id": "bcf5ec1e-dbb4-3fee-a8ec-808634c48591",
                                                "text": "[W]hoſoever vvill be curious to read the future ſtory of this intricate VVarre (if it be poſsible to compile a ſtory of it) he vvill find himſelfe much ſtagger'd, and put to a kind of riddle; […]"
                                            },
                                            {
                                                "example_id": "f9ab77f5-29e8-4459-bc90-972d975192da",
                                                "sense_id": "bcf5ec1e-dbb4-3fee-a8ec-808634c48591",
                                                "text": "Grants to the house of Russell were so enormous, as not only to outrage economy, but even to stagger credibility."
                                            },
                                            {
                                                "example_id": "36ad844e-1424-416f-aa6a-58e0d740515c",
                                                "sense_id": "bcf5ec1e-dbb4-3fee-a8ec-808634c48591",
                                                "text": "Unless it is intended to divert much of the Southern suburban traffic underground, the size of the structure needed to handle all the Southern Railway suburban, outer suburban, and main-line traffic in one station staggers the imagination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dc457eb-9e4a-33e3-82c6-a9a3634d2dfa",
                                        "entry_id": "d7f2a7bf-4222-3478-a206-1d75f6fd0559",
                                        "glosses": [
                                            "Have multiple groups doing the same thing in a uniform fashion, but starting at different, evenly spaced, times or places (attested from 1856).",
                                            "To arrange (a series of parts) on each side of a median line alternately, as the spokes of a wheel or the rivets of a boiler seam."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1dfc12b1-e117-32fb-a1c7-96b3a5144c22",
                                        "entry_id": "d7f2a7bf-4222-3478-a206-1d75f6fd0559",
                                        "glosses": [
                                            "Have multiple groups doing the same thing in a uniform fashion, but starting at different, evenly spaced, times or places (attested from 1856).",
                                            "To arrange similar objects such that each is ahead or above and to one side of the next."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceabd776-79de-4ee7-abd5-cedce804de2b",
                                                "sense_id": "1dfc12b1-e117-32fb-a1c7-96b3a5144c22",
                                                "text": "We will stagger the starting positions for the race on the oval track."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a61591c0-8890-39d9-8267-dc834fe8df44",
                                        "entry_id": "d7f2a7bf-4222-3478-a206-1d75f6fd0559",
                                        "glosses": [
                                            "Have multiple groups doing the same thing in a uniform fashion, but starting at different, evenly spaced, times or places (attested from 1856).",
                                            "To schedule in intervals or at different times."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46091eba-705f-42f6-b668-462bb0417735",
                                                "sense_id": "a61591c0-8890-39d9-8267-dc834fe8df44",
                                                "text": "We will stagger the run so the faster runners can go first, then the joggers."
                                            },
                                            {
                                                "example_id": "c811b66c-4b6f-4a60-ab3b-46d02627707b",
                                                "sense_id": "a61591c0-8890-39d9-8267-dc834fe8df44",
                                                "text": "The evening peak (5.30-5.45) is more concentrated than the morning (9–9.15), but it had not been intensified in the 12 months to last November; this is attributed by London Transport partly to efforts to persuade firms to stagger their hours."
                                            },
                                            {
                                                "example_id": "3099afb5-f63a-47cb-a22a-5b95af417bc4",
                                                "sense_id": "a61591c0-8890-39d9-8267-dc834fe8df44",
                                                "text": "You'll leave at 5:00. Well, actually, they stagger our exits, so 5:15. But it won’t feel like it. Not to this version of you anyway."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stagger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a69627a-1d83-3947-90b8-68a61b66c17f",
                                        "entry_id": "22c8d054-de2e-323d-ae1d-d12817e0596f",
                                        "glosses": [
                                            "One who attends a stag night."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1445853-88d0-4c9b-b2bd-cc671a42d332",
                                                "sense_id": "5a69627a-1d83-3947-90b8-68a61b66c17f",
                                                "text": "Tallinn no longer takes pride in the title of 'favourite destination of British staggers'."
                                            }
                                        ]
                                    }
                                ]
