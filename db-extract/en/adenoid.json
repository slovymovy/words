                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6939d4ab-d66e-49ef-a298-b177ded73d03",
                        "source_entry_id": "6cee4bbb-a872-3fbb-8bf0-069cafbade9b",
                        "source_sense_description": "folds of lymphatic tissue",
                        "target_lang_word": "Polyp",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polyp",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18601e0e-f5df-320f-872d-a31412ec96ae",
                                        "entry_id": "c9f9c7af-9f7f-386f-8868-126a90be8bb9",
                                        "glosses": [
                                            "Tier vom Stamm der Nesseltiere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fedee332-a144-42cf-a002-491a7bc2390b",
                                                "sense_id": "18601e0e-f5df-320f-872d-a31412ec96ae",
                                                "text": "„Aus der befruchteten Eizelle entsteht bei vielen Coelenteraten eine bewimperte, freischwimmende Planula-Larve, die sich in den festsitzenden Polypen umwandelt, er bringt die Medusen hervor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "68a22913-c6c7-3af2-8b78-2bec26ce08c8",
                                        "entry_id": "c9f9c7af-9f7f-386f-8868-126a90be8bb9",
                                        "glosses": [
                                            "eine meist gutartige Geschwulst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f518fc5-7d60-4a6c-a5e6-c980e7837f8d",
                                                "sense_id": "68a22913-c6c7-3af2-8b78-2bec26ce08c8",
                                                "text": "„In manchen Fällen führt die vergrößerte Rachenmandel (im Volksmund auch „Polypen“ genannt) aber zu Symptomen wie Dauerschnupfen, behinderte Nasenatmung und Schnarchen.“"
                                            },
                                            {
                                                "example_id": "cc4d9e0d-4b23-421d-adaa-650d63756601",
                                                "sense_id": "68a22913-c6c7-3af2-8b78-2bec26ce08c8",
                                                "text": "„Er hat Polypen in seiner dicken Nase und schwillt leicht an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9216c83c-18c6-32bb-b8bd-3ba49bec5bee",
                                        "entry_id": "c9f9c7af-9f7f-386f-8868-126a90be8bb9",
                                        "glosses": [
                                            "Polizist"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "645da72c-3b33-4a4f-9e8b-27726ee8c923",
                                                "sense_id": "9216c83c-18c6-32bb-b8bd-3ba49bec5bee",
                                                "text": "„Die gepflegte und elegante Erscheinung seines Opfers und die Allgegenwart des diensteifrigen Polypen bestärkten ihn in der Hoffnung, dass er bald den angenehmen amtlichen Griff auf seinem Arm spüren werde, der ihm das Winterquartier auf der fernen kleinen Insel sicherte.“"
