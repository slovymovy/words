                        "examples": [
                            {
                                "example_id": "35052955-620c-4181-997b-3eb550556dda",
                                "sense_id": "7abbf1a0-7620-3350-9442-2ff5821a6275",
                                "text": "De twee fietsende studenten in de voetgangerstunnel hadden meerdere van de verdachten tenslotte van dichtbij gezien."
                            },
                            {
                                "example_id": "4ba27324-a8bb-4ecf-8317-8950bde53060",
                                "sense_id": "7abbf1a0-7620-3350-9442-2ff5821a6275",
                                "text": "Vuurwerkvandalen hebben in Vught grote schade aangericht aan het treinstation. Vooral de voetgangerstunnel is een ravage, met gesneuvelde reclamevensters en tl-buizen die aan stukken op de grond liggen. Ook is een kaartjesautomaat vernield."
                            }
                        ]
