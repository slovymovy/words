                        "entry_id": "de4fe4b7-4185-3f84-985f-b223022c14ea",
                        "glosses": [
                            "Abri en forme de dôme protégeant une antenne de radar, au sol, au sommet d'un bâtiment ou encore sur un véhicule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1a3ed53-76f6-4c5d-8c5b-98e12a500a72",
                                "sense_id": "95c40e97-6e30-358d-b2ad-d81b3b7fc67d",
                                "text": "Je confirme transpondeur sur 7 700, nous avons traversé un gros nuage de grêle, le pare-brise est fissuré, le radôme est sûrement défoncé."
                            }
                        ]
                    }
                ],
