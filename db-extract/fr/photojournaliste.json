                        "entry_id": "46d944ae-b282-3895-87e2-e7d0db89a2e8",
                        "glosses": [
                            "Journaliste usant du support photographique pour communiquer l’événement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d31aad74-3344-4cf3-b530-42ed9c136a28",
                                "sense_id": "0ac5ddcd-5fd6-3664-abd1-0df76788b53e",
                                "text": "La photojournaliste Sophie Garcia a assisté à la première projection."
                            },
                            {
                                "example_id": "70462d38-ebf4-4414-9ff6-1d79092d4ee4",
                                "sense_id": "0ac5ddcd-5fd6-3664-abd1-0df76788b53e",
                                "text": "C’est comme ça que j’ai appris le métier de photojournaliste !"
                            },
                            {
                                "example_id": "d538d0cd-5e25-448b-92eb-0be76d66f760",
                                "sense_id": "0ac5ddcd-5fd6-3664-abd1-0df76788b53e",
                                "text": "Sur la plage de Teahupo'o, à Tahiti, tous les photojournalistes travaillent sur un bateau. Tous, sauf un."
                            }
                        ]
                    }
                ],
