                        "entry_id": "cc9589a3-9ad9-3fb4-8e6e-cba7a5e2151c",
                        "glosses": [
                            "bemalter oder bedruckter Baumwollstoff, der ursprünglich aus Indien stammte"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "3dc59599-65f4-47f8-b1eb-4c137a9b74fc",
                                "sense_id": "cee6ae3a-acac-34f8-b2b5-8f11df33e0d3",
                                "text": "Der alte Herr trug ein enges, kurzes Schlafröckchen, ein Peten l'air, wie man es sonst nannte, von Indienne mit gewaltigen großen Blumen bedruckt. (1825)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
