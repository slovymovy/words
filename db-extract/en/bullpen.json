    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "671137cc-073d-3770-b8f1-37ca033deae8",
                "word": "bullpen",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "47ade81b-2093-4f6e-8d80-e210623105a5",
                        "entry_id": "671137cc-073d-3770-b8f1-37ca033deae8",
                        "tags": [
                            "plural"
                        ],
                        "form": "bullpens"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2f5e9bd3-f584-3e97-94e4-0fd587ea39a2",
                        "entry_id": "671137cc-073d-3770-b8f1-37ca033deae8",
                        "glosses": [
                            "An enclosed area used to hold bulls."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c1da3b1-7992-4171-9c08-1d7bc8de6c24",
                                "sense_id": "2f5e9bd3-f584-3e97-94e4-0fd587ea39a2",
                                "text": "Magnus and Big Dick are over in the bullpen, ready for tonight's rodeo."
                            }
                        ]
                    },
                    {
                        "sense_id": "e23b505b-2c05-3f52-ba30-682152a74fe0",
                        "entry_id": "671137cc-073d-3770-b8f1-37ca033deae8",
                        "glosses": [
                            "An enclosed area for pitchers to warm up in during a game."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06426a02-697b-42ee-b986-4da89985a27e",
                                "sense_id": "e23b505b-2c05-3f52-ba30-682152a74fe0",
                                "text": "After that hit, there is activity in the bullpen."
                            },
                            {
                                "example_id": "3cce1b6a-2ebb-476b-89c9-3131b1a2b197",
                                "sense_id": "e23b505b-2c05-3f52-ba30-682152a74fe0",
                                "text": "Now the bullpens are hidden away underneath the bleachers, out of sight and sound."
                            },
                            {
                                "example_id": "fd15e758-ceb9-47a6-9233-1e1d91ed76d5",
                                "sense_id": "e23b505b-2c05-3f52-ba30-682152a74fe0",
                                "text": "Even though the Phillies bullpen has been a strength, it may be shopping for a veteran capable of handling the ninth inning."
                            }
                        ]
                    },
                    {
                        "sense_id": "f116f5d2-fdb5-35b8-b450-f4f24eec0aed",
                        "entry_id": "671137cc-073d-3770-b8f1-37ca033deae8",
                        "glosses": [
                            "The relief pitchers of a team collectively."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e62a6373-1e5a-4295-9159-75e72648b924",
                                "sense_id": "f116f5d2-fdb5-35b8-b450-f4f24eec0aed",
                                "text": "Their bullpen is worn out after yesterday's doubleheader where both games went 12 innings."
                            }
                        ]
                    },
                    {
                        "sense_id": "6472c218-9add-3800-9d41-f995a645857a",
                        "entry_id": "671137cc-073d-3770-b8f1-37ca033deae8",
                        "glosses": [
                            "A place for someone or something to get ready."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "57078150-75ac-47d7-b7cc-66efbebc56f3",
                                "sense_id": "6472c218-9add-3800-9d41-f995a645857a",
                                "text": "If this team of consultants fails, I have another warming up in the bullpen."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6d4492c-a727-336a-bac5-58b1e8d7d3a6",
                        "entry_id": "671137cc-073d-3770-b8f1-37ca033deae8",
                        "glosses": [
                            "An open seating arrangement where project teams can communicate openly with minimal effort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b6d851b-5336-45fb-a7ed-e9a6bacf7c08",
                                "sense_id": "e6d4492c-a727-336a-bac5-58b1e8d7d3a6",
                                "text": "We have our sales team in a bullpen setup to keep their energy flowing."
                            }
                        ]
                    },
                    {
                        "sense_id": "fafaf347-23b7-3a95-b321-030973e011f4",
                        "entry_id": "671137cc-073d-3770-b8f1-37ca033deae8",
                        "glosses": [
                            "A military prison or its enclosing stockade."
                        ],
                        "tags": [
                            "US",
                            "slang"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0aa49397-437d-4ff9-868b-ce7bf57e44ec",
                        "source_entry_id": "671137cc-073d-3770-b8f1-37ca033deae8",
                        "source_sense_description": "enclosed area to hold bulls",
                        "target_lang_word": "toril",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toril",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d54fb32-6b60-346e-a04d-ae9424c8374c",
                                        "entry_id": "3716f50d-2cbf-3196-9de0-e3bd3e14509e",
                                        "glosses": [
                                            "Lieu où l’on tient enfermés les taureaux avant le combat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46f6ff30-c442-409f-a622-b04b772c6183",
                                                "sense_id": "6d54fb32-6b60-346e-a04d-ae9424c8374c",
                                                "text": "Pour rien au monde, on ne voudrait manquer l’évacuation de l’arène et la fuite précipitée de l’alguazil, quand il a jeté au garçon de combat la clef du toril où sont enfermés les gladiateurs à cornes. Le toril fait face au matadero, où l’on écorche les bêtes abattues."
                                            },
                                            {
                                                "example_id": "154ea99b-ec5c-4aa1-951f-9f10410e4b6a",
                                                "sense_id": "6d54fb32-6b60-346e-a04d-ae9424c8374c",
                                                "text": "Le salon a deux portes. Il les regarde comme le toréador doit regarder les portes du toril, et se place de telle façon que Telcide pourra entrer par l’une ou l’autre, il lui fera toujours face."
                                            },
                                            {
                                                "example_id": "41583d9f-2f3c-453e-bcc0-c3bbc872ea5f",
                                                "sense_id": "6d54fb32-6b60-346e-a04d-ae9424c8374c",
                                                "text": "La vachette apparaissait aux portes du toril, elle fonçait au milieu de la piste, en marquant un temps d'arrêt, pour regarder ceux qui l'entouraient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5676ce4f-516e-4275-9a2c-3ebd228d61d6",
                        "source_entry_id": "671137cc-073d-3770-b8f1-37ca033deae8",
                        "source_sense_description": "enclosed area to hold bulls",
                        "target_lang_word": "toril",
