                                    },
                                    {
                                        "sense_id": "8b586145-324d-3937-ba3c-237238afe984",
                                        "entry_id": "b613dca6-bc7e-38b1-acf5-3c70890a3edc",
                                        "glosses": [
                                            "To destroy the political influence of."
