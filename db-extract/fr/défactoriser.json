                "senses": [
                    {
                        "sense_id": "e1c52219-40bb-32a1-9271-75d4bec6d881",
                        "entry_id": "aaed0e0b-25e6-3c46-b48e-20f70b417ce1",
                        "glosses": [
                            "Faire revenir en arrière par rapport à une factorisation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2db4fd05-2620-4a5d-9844-1e2dc46b5f38",
                                "sense_id": "e1c52219-40bb-32a1-9271-75d4bec6d881",
                                "text": "Il nous faut donc défactoriser les opérations pour les isoler vers chaque bit de sortie individuel."
                            },
                            {
                                "example_id": "a389a2e6-889b-41ad-bd70-17ab67cf3ea3",
                                "sense_id": "e1c52219-40bb-32a1-9271-75d4bec6d881",
                                "text": "N’abusez pas des effets d’entrée et de sortie. En effet, en cas de modification de l’effet sur une des transitions concernées, il vous faudra penser à « défactoriser » et à remettre l’effet sur chaque autre transition."
                            },
                            {
                                "example_id": "f975b0b6-f8b7-47a8-9dca-31ef96ffc64f",
                                "sense_id": "e1c52219-40bb-32a1-9271-75d4bec6d881",
                                "text": "J'ai défactorisé ma fonction read en plusieurs adaptées pour pouvoir les préparer."
                            },
                            {
                                "example_id": "2ffe8104-8787-441b-bbad-21e7c4d4a85e",
                                "sense_id": "e1c52219-40bb-32a1-9271-75d4bec6d881",
                                "text": "et pour le 6 (y+5) je ne sais pas si il faut la défactoriser ou autre chose."
                            }
                        ]
                    }
                ],
