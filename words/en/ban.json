                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I found a coin worth one <w>ban</w> on the sidewalk.",
                            "target_lang_translations": {
                                "ru": "Я нашел на тротуаре монету достоинством в один <w>бан</w>.",
