                                            "jemand, dessen Verhalten vor allem auf sinnliche Genüsse ausgerichtet ist"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83e86b99-78fb-419b-9029-93321c76ae8d",
                                                "sense_id": "412ac87b-ea8b-3718-8d42-3f6a247d12fc",
                                                "text": "Er ist ein Hedonist."
                                            },
                                            {
                                                "example_id": "9b7f56e9-4683-462d-8abd-a071ae1875e2",
                                                "sense_id": "412ac87b-ea8b-3718-8d42-3f6a247d12fc",
