                        "examples": [
                            {
                                "example_id": "e45c7fd0-1580-4ddd-baa8-cc00d4c69063",
                                "sense_id": "bcaf8ff4-445a-3a15-b5d3-19d75c80aab4",
                                "text": "Men ontkleedde de stronk en een klassicist versierde het benedenlichaam met witte tul."
                            },
                            {
                                "example_id": "f5ab3baa-d8e3-4708-af7e-d37fd298017c",
                                "sense_id": "bcaf8ff4-445a-3a15-b5d3-19d75c80aab4",
                                "text": "Elk hunner hield voor zich een vierkant raam, waarover een stuk tul of geweven kant gespannen was, en daarop borduurden zij, met naald en draad, allerlei bloemen en loofwerk."
                            }
                        ]
                    }
