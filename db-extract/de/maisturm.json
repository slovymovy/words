                                "example_id": "1ad5ad28-8276-4150-b510-8e23e1b89cdd",
                                "sense_id": "bb4571c5-a410-39e0-ba11-9a87fbc07771",
                                "text": "„Sie war in Thränen gebadet und zitterte wie eine Grasmücke außer dem Neste nach dem ersten Maisturm.“"
                            },
                            {
                                "example_id": "1be22206-625d-4aed-9c48-0b451038dd40",
                                "sense_id": "bb4571c5-a410-39e0-ba11-9a87fbc07771",
                                "text": "„Der Maisturm hat nun ausgetobt; ja es gieng wirklich stürmisch zu an manchen Orten.“"
                            }
                        ],
