                            {
                                "example_id": "59f8d40b-2011-4d96-81c5-12fb4ccb836d",
                                "sense_id": "5ca791f4-5cc4-38da-8284-140668b3b6ec",
                                "text": "повседне́вный обихо́д",
                                "translation": "everyday practice",
