                "senses": [
                    {
                        "sense_id": "0f5646d9-4e29-3b70-b005-29089e8cf394",
                        "entry_id": "d9363d86-24c6-3296-b44c-51265a8e563f",
                        "glosses": [
                            "pracownik służby zdrowia uprawniony do pielęgnowania chorych i do wykonywania prostszych zabiegów leczniczych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0301f22-793f-4c27-9811-0229cfe78ff0",
                                "sense_id": "0f5646d9-4e29-3b70-b005-29089e8cf394",
                                "text": "W szpitalach pielęgniarze są pożądanymi pracownikami, ponieważ z reguły dysponują większą siłą fizyczną, niż pielęgniarki."
                            },
                            {
                                "example_id": "cbea51f1-9229-483c-b913-2ff1c8d7b73a",
                                "sense_id": "0f5646d9-4e29-3b70-b005-29089e8cf394",
                                "text": "Szybko wciągnął na siebie zielone ubranie pielęgniarza i zamknął szafkę w tym samym momencie, w którym otworzyły się drzwi"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21d38b5f-e94f-4b49-a0c3-ab76e07d85eb",
                        "source_entry_id": "d9363d86-24c6-3296-b44c-51265a8e563f",
                        "source_sense_id": "0f5646d9-4e29-3b70-b005-29089e8cf394",
                        "target_lang_word": "nurse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nurse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1b566c1-494b-3387-a553-7f4bdc9dc021",
                                        "entry_id": "9015b03b-593c-302e-a5f7-57dfdf846762",
                                        "glosses": [
                                            "A person involved in providing direct care for the sick:",
                                            "Anyone performing this role, regardless of training or profession."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "381bb4f3-9cd1-46b1-8205-b86dd6795350",
                                                "sense_id": "e1b566c1-494b-3387-a553-7f4bdc9dc021",
                                                "text": "My aunt was my nurse while I recuperated at home from surgery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c421f213-26cc-321f-bf58-6348db6bc246",
                                        "entry_id": "9015b03b-593c-302e-a5f7-57dfdf846762",
                                        "glosses": [
                                            "A person involved in providing direct care for the sick:",
                                            "A medical worker performing this role, typically someone trained to provide such care but having credentials and rank below a doctor or physician assistant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c807ff4-01ae-4346-a277-9481b6a04023",
                                                "sense_id": "c421f213-26cc-321f-bf58-6348db6bc246",
                                                "text": "The nurse made her rounds through the hospital ward."
                                            },
                                            {
                                                "example_id": "5bd85081-48f5-4611-9f62-b4b63d49c719",
                                                "sense_id": "c421f213-26cc-321f-bf58-6348db6bc246",
                                                "text": "Francis Urquhart: Right. Mackenzie. Health. No chance of getting him into a demo at a hospital, I suppose?\nTim Stamper: Doesn't go to hospitals any more. Kept getting beaten up by the nurses... I think he has trouble getting insured now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "225a5271-7721-3054-9f1f-6e9f3ca22d85",
                                        "entry_id": "9015b03b-593c-302e-a5f7-57dfdf846762",
                                        "glosses": [
                                            "A person involved in providing direct care for the sick:",
                                            "A medical worker, such as a registered nurse, having training, credentials, and rank above a nurse assistant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13c62015-41af-398f-91db-7ab1665f0a27",
                                        "entry_id": "9015b03b-593c-302e-a5f7-57dfdf846762",
                                        "glosses": [
                                            "A person (usually a woman) who takes care of other people’s children."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb1409e8-edd3-4206-8057-88fe8fd81c79",
                                                "sense_id": "13c62015-41af-398f-91db-7ab1665f0a27",
                                                "text": "They hired a nurse to care for their young boy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86585b6c-2971-3df2-a898-46bf0e66c24a",
                                        "entry_id": "9015b03b-593c-302e-a5f7-57dfdf846762",
                                        "glosses": [
                                            "One who, or that which, brings up, rears, causes to grow, trains, or fosters."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d77c1e7-2119-4cd5-b9df-37e1fe5c11f9",
                                                "sense_id": "86585b6c-2971-3df2-a898-46bf0e66c24a",
                                                "text": "Eton College has been called \"the chief nurse of England's statesmen\"."
                                            },
                                            {
                                                "example_id": "e9f1c8ff-95e1-4d6d-95ed-0ed311014db1",
                                                "sense_id": "86585b6c-2971-3df2-a898-46bf0e66c24a",
                                                "text": "the nurse of manly sentiment and heroic enterprise"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a95318d7-ebb3-30bc-8569-d708c4227385",
                                        "entry_id": "9015b03b-593c-302e-a5f7-57dfdf846762",
                                        "glosses": [
                                            "A shrub or tree that protects a young plant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3be819eb-ad20-33bc-b664-a6fd16e52b1d",
                                        "entry_id": "9015b03b-593c-302e-a5f7-57dfdf846762",
                                        "glosses": [
                                            "A lieutenant or first officer who takes command when the captain is unfit for his place."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
