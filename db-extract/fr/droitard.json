                        "sense_id": "9d817b37-3377-37b6-9100-9af2876c7205",
                        "entry_id": "4435b904-3da6-3993-900a-318776cca402",
                        "glosses": [
                            "Qualificatif employé par une organisation politique pour qualifier une doctrine, une politique ou une organisation située plus à droite qu'elle sur l'échiquier politique."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "017db203-03d6-4a16-af41-70dc8d16e86a",
                                "sense_id": "9d817b37-3377-37b6-9100-9af2876c7205",
                                "text": "Comme je ne m'arrête pas aux idées droitardes de Chardonne et Morand mais seulement à l'élégance et au style, je me suis fait offrir, pour mon anniversaire, au mois de mai, le Tome II de leur correspondance."
                            }
                        ]
                    }
                ],
