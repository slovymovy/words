                    }
                ],
                "senses": [
                    {
                        "sense_id": "8db0ee27-0a06-3bcd-8a72-803124adc05d",
                        "entry_id": "1a3503a0-7e40-3380-951a-0c58624bcaa4",
                        "glosses": [
                            "агрегат для кондиционирования воздуха"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a46879e3-6305-4843-a97d-afa3f8751ce6",
                                "sense_id": "8db0ee27-0a06-3bcd-8a72-803124adc05d",
                                "text": "Ад, как можно было догадаться, расположен где-то в Америке, снятой в духе Уолтера Хилла ― в чудовищных синюшных цветах, с густым англоязычным матом, злыми доберманами и повсеместными кондиционерами, сводящими на нет весь эффект от пресловутой адской жары."
                            },
                            {
                                "example_id": "a6b1bca6-fb34-43b6-81c6-e364b79f77a0",
                                "sense_id": "8db0ee27-0a06-3bcd-8a72-803124adc05d",
                                "text": "В последующие годы дизайнеры и конструкторы General Motors могли изгаляться как угодно: оснащать открытую машину кондиционером, ставить под капот 7-литровый движок, а на капот ― огромный воздухозаборник."
                            }
                        ]
                    },
                    {
                        "sense_id": "a109c074-e4a5-3c5f-ae9c-c841d95b73a5",
                        "entry_id": "1a3503a0-7e40-3380-951a-0c58624bcaa4",
                        "glosses": [
                            "средство для полоскания белья после стирки, смягчающее ткань"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "71af18a4-3b9c-332f-a25e-d627291d0cc9",
                        "entry_id": "1a3503a0-7e40-3380-951a-0c58624bcaa4",
                        "glosses": [
                            "косметическое средство для волос, придающее блеск волосам и делающее их мягче"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c59b13bc-f823-46d3-b085-733b4cc4efa6",
                                "sense_id": "71af18a4-3b9c-332f-a25e-d627291d0cc9",
                                "text": "— А какие шампуни предпочтительней покупать: отечественные или импортные, особенно когда «три в одном флаконе» ― шампунь, бальзам и кондиционер? // — Лучше тот, который подобран врачом."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c707e1a0-7db7-427c-b5da-9538d44442ed",
                        "source_entry_id": "1a3503a0-7e40-3380-951a-0c58624bcaa4",
                        "source_sense_description": "агрегат для кондиционирования воздуха",
                        "target_lang_word": "air conditioner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "air conditioner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a549b8ad-366b-3a7a-8a39-8778a7b40a01",
                                        "entry_id": "38ff3cd5-3030-343d-9c6c-c98610ac8d7f",
                                        "glosses": [
                                            "A machine that is used to control temperature and humidity in an enclosed space."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cff2bfc5-0733-4687-b1a2-778ef726923b",
                                                "sense_id": "a549b8ad-366b-3a7a-8a39-8778a7b40a01",
                                                "text": "She started the air conditioner for three hours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d20b767f-e777-4b3a-be55-3f7795aa40a7",
                        "source_entry_id": "1a3503a0-7e40-3380-951a-0c58624bcaa4",
                        "source_sense_description": "агрегат для кондиционирования воздуха",
                        "target_lang_word": "Klimaanlage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klimaanlage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9bd34238-2d94-3210-9a92-287aed20e2e7",
                                        "entry_id": "ed1ecf0f-eca0-38c2-a0e6-9c9cbc84c329",
                                        "glosses": [
                                            "elektrisches Gerät, das die Lufteigenschaften wie Wärme, Luftfeuchtigkeit oder Ähnliches an die Bedürfnisse anpasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "612afa20-225e-4694-9295-25b5355af709",
                                                "sense_id": "9bd34238-2d94-3210-9a92-287aed20e2e7",
                                                "text": "Klimaanlagen verändern nicht nur das Raumklima, sondern tragen durch ihren Verbrauch an Energie zum Klimawandel bei."
                                            },
                                            {
                                                "example_id": "4ee8e12e-7883-4e8d-8eaf-04e1abe72a75",
                                                "sense_id": "9bd34238-2d94-3210-9a92-287aed20e2e7",
                                                "text": "„Eine Klimaanlage ist eine Kombination aus sämtlichen Bauteilen, die zur Bereitstellung einer Form der Luftbehandlung erforderlich sind, bei der die Temperatur, eventuell in Kombination mit Lüftung, Luftfeuchte und Luftreinheit, geregelt wird.“"
                                            },
                                            {
                                                "example_id": "94eb48c0-d18b-4b19-88f0-3e54ec696d6a",
                                                "sense_id": "9bd34238-2d94-3210-9a92-287aed20e2e7",
                                                "text": "„Ein fensterloser Raum im Keller des bischöflichen Palais. Es riecht nicht gut, und es gibt keine Klimaanlage.“"
                                            },
                                            {
                                                "example_id": "0d115f49-82b5-45a9-8853-f95be55ce680",
                                                "sense_id": "9bd34238-2d94-3210-9a92-287aed20e2e7",
                                                "text": "„Sie saß einfach nur da und lauschte dem Brausen der Jetmotoren und der Klimaanlage.“"
                                            },
                                            {
                                                "example_id": "0528f859-bc1d-48fb-ab1f-a945691c8cc1",
                                                "sense_id": "9bd34238-2d94-3210-9a92-287aed20e2e7",
                                                "text": "„Eine Klimaanlage hielt die drückende Hitze von Lagos fern, und ihre Haut fühlte sich kühl an, als ob sie gerade eine Abenddusche genommen hätte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
