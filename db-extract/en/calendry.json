                "senses": [
                    {
                        "sense_id": "6a5dcb1c-b546-396f-adc6-93ce78b27325",
                        "entry_id": "03038341-9ba4-39c4-b3f4-92bcdd53e667",
                        "glosses": [
                            "The calculation and development of calendars, especially the determination of the timing of astronomical movements."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "e8d5fd09-271d-49cb-88ff-68d1af7dc3ee",
                                "sense_id": "6a5dcb1c-b546-396f-adc6-93ce78b27325",
                                "text": "It attained to cities, kingdoms, most metallurgical arts, some astronomy and calendry, and extraordinarily complex rituals."
                            },
                            {
                                "example_id": "caf0ef83-7bbd-4503-bd0d-5fed2650c20f",
                                "sense_id": "6a5dcb1c-b546-396f-adc6-93ce78b27325",
                                "text": "Li Chunfeng mastered all sorts of subjects in youth and was an expert at calendry."
                            }
                        ]
                    },
                    {
                        "sense_id": "08b5e804-613c-3ee4-9ac6-a6625699516d",
                        "entry_id": "03038341-9ba4-39c4-b3f4-92bcdd53e667",
                        "glosses": [
                            "A specialized calendar or set of calendars."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "2b26eb34-6f4a-44c5-8b7c-8571879e1435",
                                "sense_id": "08b5e804-613c-3ee4-9ac6-a6625699516d",
                                "text": "“Peak day” means that day during a calendry when demand is the greatest;"
                            },
                            {
                                "example_id": "94f924b3-4883-4250-8079-6cdd43d77f1a",
                                "sense_id": "08b5e804-613c-3ee4-9ac6-a6625699516d",
                                "text": "He will not again decorate his room with cheap prints and art calendry."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "9a71b27b-7dad-32cc-b79f-955992b2da8c",
