                                    {
                                        "sense_id": "181a33a8-c679-3113-8dde-16da1b27260f",
                                        "entry_id": "c15627e9-00a6-3c74-bfc8-ef75b65cdaed",
                                        "glosses": [
                                            "iemand die een hekel heeft aan joden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f469c199-798b-4d09-9fae-138c9f268a52",
                                                "sense_id": "181a33a8-c679-3113-8dde-16da1b27260f",
                                                "text": "Wat misschien een beetje vreemd overkwam, omdat er door iedereen zo naar uit was gekeken, zowel door de antisemieten als door de joden zelf."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd189797-0c2e-41fa-8282-0462b4dbdf4f",
                        "source_entry_id": "3ed1fd52-faf0-3e38-b56b-ac5e4910b31d",
                        "source_sense_id": "0c4ebc4f-5549-33a9-94db-a2494a94a3dd",
                        "target_lang_word": "antisemitisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antisemitisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c6b5fe6c-90cd-3d41-ab80-7fcda5450730",
                                        "entry_id": "82ed88db-6dfb-3028-86af-9c1e66e38dc5",
                                        "glosses": [
                                            "anti-Joods, tegen het Joodse volk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48ceb825-0d5f-4234-b90b-0f64bc4e9509",
                                                "sense_id": "c6b5fe6c-90cd-3d41-ab80-7fcda5450730",
                                                "text": "Een antisemitische actie wordt je in West-Europa door de meeste mensen niet in dank afgenomen."
                                            },
                                            {
                                                "example_id": "e4f592e8-aac1-4af5-b39b-8737f62d3f69",
                                                "sense_id": "c6b5fe6c-90cd-3d41-ab80-7fcda5450730",
                                                "text": "Alle gewone rechtse partijen, en zelfs het centrum, waren antisemitisch, dus die stellingname kon niemand meer voor zichzelf uitbuiten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04f60eef-ebf7-4dd7-99f5-cff691c2d8f9",
