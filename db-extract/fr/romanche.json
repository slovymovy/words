            {
                "entry_id": "45f29f5d-636d-3cf6-83e4-49b4d97a0b43",
                "word": "romanche",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a18aaa34-762e-417a-a682-b8498824cb0b",
                        "entry_id": "45f29f5d-636d-3cf6-83e4-49b4d97a0b43",
                        "tags": [
                            "Daniel Josty, Bière de mon tonneau, Sander, Berlin, 1835, page 56 → lire en ligne"
                        ],
                        "form": "romaunsch"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2ea249e1-580c-3bc3-8255-209c46ef53d5",
                        "entry_id": "45f29f5d-636d-3cf6-83e4-49b4d97a0b43",
                        "glosses": [
                            "Langue romane parlée en Suisse, dans le canton des Grisons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c17364a5-ffa2-4763-b95a-38ed2225e799",
                                "sense_id": "2ea249e1-580c-3bc3-8255-209c46ef53d5",
                                "text": "Le romanche comprend six formes écrites, le vallader, le puter, le sursilvan, le sutsilvan, le surmiran et le rumantsch grischun."
                            },
                            {
                                "example_id": "ba670a0a-8a7f-4007-9817-3c24b192cc93",
                                "sense_id": "2ea249e1-580c-3bc3-8255-209c46ef53d5",
                                "text": "Logiquement, tout devrait tendre à une simplification des langues et donc à l’abandon programmé de celles qui le sont peu, et en premier lieu le romanche."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2e99096-d2f5-4691-98e2-ecea243fc00d",
                        "source_entry_id": "45f29f5d-636d-3cf6-83e4-49b4d97a0b43",
                        "source_sense_id": "2ea249e1-580c-3bc3-8255-209c46ef53d5",
                        "target_lang_word": "Rätoromanisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rätoromanisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab0be463-7d66-38cc-a481-4d1351d1aa6b",
                                        "entry_id": "cfb3c135-1650-315d-af6f-b7a55675486a",
                                        "glosses": [
                                            "rätoromanische Sprache, die in Graubünden (Schweiz) gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cbf7b4a-7e1c-471b-95a4-a401e75303f8",
                                                "sense_id": "ab0be463-7d66-38cc-a481-4d1351d1aa6b",
                                                "text": "Noch rund 60.000 Schweizer sprechen Rätoromanisch."
                                            },
                                            {
                                                "example_id": "47559017-d169-483e-96db-5394aeb68840",
                                                "sense_id": "ab0be463-7d66-38cc-a481-4d1351d1aa6b",
                                                "text": "„Rätoromanisch hört sich im ersten Moment vielleicht wie Italienisch oder wie ein italienischer Dialekt an.“"
                                            },
                                            {
                                                "example_id": "ce9c263b-088d-427a-a3c4-f0f1af9fb3ca",
                                                "sense_id": "ab0be463-7d66-38cc-a481-4d1351d1aa6b",
                                                "text": "Die Schweiz „ist offiziell mehrsprachig; Französisch, Italienisch und Rätoromanisch stehen im Prinzip gleichberechtigt neben dem Deutschen.“"
                                            },
                                            {
                                                "example_id": "b36f3609-73e8-43ac-97e4-640a55f74d26",
                                                "sense_id": "ab0be463-7d66-38cc-a481-4d1351d1aa6b",
                                                "text": "„Dieser Titel hat seinen Weg von den Langobarden ins Rätoromanische und weiter nordwärts nach Bayern und ins Fränkische genommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ff526467-5117-3015-9174-8eb7a188bf73",
                                        "entry_id": "cfb3c135-1650-315d-af6f-b7a55675486a",
                                        "glosses": [
                                            "eine Untergruppe der romanischen Sprachen, die in Italien und der Schweiz gesprochen werden"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
