                "senses": [
                    {
                        "sense_id": "d187e911-7a72-3025-a3d6-3a4e73a6ed16",
                        "entry_id": "b3ee3789-beb1-3c25-a044-842232a612f7",
                        "glosses": [
                            "binnenste band, de band waarin de lucht aanwezig is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "142f97c2-2f2a-491f-83bb-0f6516b50637",
                                "sense_id": "d187e911-7a72-3025-a3d6-3a4e73a6ed16",
                                "text": "Gister reed ik door glas, maar alleen mijn buitenband is beschadigd. Aan mijn binnenband zie je niks, dus ik kan nog gewoon fietsen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c4e74cc-fe10-4b2f-9a5b-e3b9f4c3c340",
                        "source_entry_id": "b3ee3789-beb1-3c25-a044-842232a612f7",
                        "source_sense_id": "d187e911-7a72-3025-a3d6-3a4e73a6ed16",
                        "source_sense_description": "binnenste band, de band waarin de lucht aanwezig is",
                        "target_lang_word": "Schlauch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlauch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4bbe24be-e0f9-3dac-a632-b8fe2b66537c",
                                        "entry_id": "d7beda50-0996-319a-a996-08ba738a7c2f",
                                        "glosses": [
                                            "flexible Leitung zur Förderung fester, flüssiger und gasförmiger Stoffe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b8d25d2-3c11-489f-9f27-1dfd0f9fa8d8",
                                                "sense_id": "4bbe24be-e0f9-3dac-a632-b8fe2b66537c",
                                                "text": "Mit einem Schlauch bewässert man große Grünflächen in Parks."
                                            },
                                            {
                                                "example_id": "91a65ba1-6919-409b-8e18-ab496253b63b",
                                                "sense_id": "4bbe24be-e0f9-3dac-a632-b8fe2b66537c",
                                                "text": "„Es ist ein Gewirr aus Schläuchen und Leitungen.“"
                                            },
                                            {
                                                "example_id": "c079f9f1-ca92-4f3d-b1d1-66c722ec1d7a",
                                                "sense_id": "4bbe24be-e0f9-3dac-a632-b8fe2b66537c",
                                                "text": "„Unser neuer Bekannter rollte bedachtsam den Schlauch seiner Wasserpfeife zusammen und holte hinter einem Vorhang einen sehr langen kuttenartigen Überzieher mit pelzbesetztem Kragen hervor, den er anzog und trotz der Abendschwüle bis oben zuknöpfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e96a33bc-b464-38b8-b685-219def5cda0f",
                                        "entry_id": "d7beda50-0996-319a-a996-08ba738a7c2f",
                                        "glosses": [
                                            "kreisförmiger hohler Ring (Torus) aus Gummi, der im Inneren des Reifens die Luft enthält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a091ff59-77aa-4bee-b2a0-790f53cfd2de",
                                                "sense_id": "e96a33bc-b464-38b8-b685-219def5cda0f",
                                                "text": "Durch einen undichten Schlauch verliert der Hinterreifen während der Fahrt an Luft."
                                            },
                                            {
                                                "example_id": "2b85591b-6115-41af-847d-3df8d2c5e106",
                                                "sense_id": "e96a33bc-b464-38b8-b685-219def5cda0f",
                                                "text": "„Mit der Bahn fuhren die Hamsterer weit hinaus aufs Land, zwanzig, dreißig, fünfzig Kilometer, mit dem Fahrrad auch, solange sie genug heile Schläuche und Mäntel hatten, notfalls eben zu Fuß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1c4f2317-c11a-3ce7-b75d-ead63118a5ab",
                                        "entry_id": "d7beda50-0996-319a-a996-08ba738a7c2f",
                                        "glosses": [
                                            "ein Behältnis zur Aufbewahrung und zum Transport von Flüssigkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c47a1d3-571b-4bba-89b8-811f9fb0d011",
                                                "sense_id": "1c4f2317-c11a-3ce7-b75d-ead63118a5ab",
                                                "text": "Im Orient nutzt man Schläuche als Behältnis für Wasser und Wein."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2d31e111-0d32-3484-9511-b98f6c4f5dd7",
                                        "entry_id": "d7beda50-0996-319a-a996-08ba738a7c2f",
                                        "glosses": [
                                            "eine topologische Struktur"
                                        ],
                                        "tags": [
                                            "Topographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbd3e699-0cbf-4aaa-9197-ac6194a1e161",
                                                "sense_id": "2d31e111-0d32-3484-9511-b98f6c4f5dd7",
                                                "text": "„Die Harnröhre ist ein Schlauch mit ungleichmäßiger Lichtung, an welchem enge und weite Stellen miteinander abwechseln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "a861f409-0f37-356d-b586-9cc3d0fd1f66",
                                        "entry_id": "d7beda50-0996-319a-a996-08ba738a7c2f",
                                        "glosses": [
                                            "der Penis eines Hengstes oder Wallachs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b33a1cc9-ce23-4e9f-9fb1-5837fd12eb4a",
                                                "sense_id": "a861f409-0f37-356d-b586-9cc3d0fd1f66",
                                                "text": "„Sein Penis, den die Branche treffend auch Schlauch nennt, ist mit einer Schürze abgedeckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "a98a98fc-bbdf-395a-b86f-aeaac4c1cb64",
                                        "entry_id": "d7beda50-0996-319a-a996-08ba738a7c2f",
                                        "glosses": [
                                            "etwas sehr Anstrengendes"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed43bc6a-c8a4-4ed8-85c6-b87fcfdbd67f",
                                                "sense_id": "a98a98fc-bbdf-395a-b86f-aeaac4c1cb64",
                                                "text": "„‚Ich bin froh, wenn dieser Schlauch endlich vorbei ist‘, war immer öfter von ihm zu hören.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
