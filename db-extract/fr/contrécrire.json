                ],
                "senses": [
                    {
                        "sense_id": "4c155966-92da-3350-b7bf-fc0e432f7bca",
                        "entry_id": "901f48e3-560a-3444-ac2b-eef2b6979c46",
                        "glosses": [
                            "Écrire en ayant une démarche opposée à l’écriture. Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abe3e558-ee5d-417f-82c0-35f57f9f6d56",
                                "sense_id": "4c155966-92da-3350-b7bf-fc0e432f7bca",
                                "text": "Comment « contrécrire » dans une contradiction et une complémentarité avec l’écriture ?"
                            },
                            {
                                "example_id": "c2e4fc72-e6bf-4f00-9a16-d6d4710a16a2",
                                "sense_id": "4c155966-92da-3350-b7bf-fc0e432f7bca",
                                "text": "Dire contre soi, contrécrire, mécrire enfin (on n’oubliera pas que Beckett, qui fit cette expérience dans la prose, eut le prix Nobel !)."
                            },
                            {
                                "example_id": "ef4068ea-69ad-48fe-87bf-3b1dd436283a",
                                "sense_id": "4c155966-92da-3350-b7bf-fc0e432f7bca",
                                "text": "Et continuer à contrécrire ce livre malgré moi ?"
                            },
                            {
                                "example_id": "76f430bf-92eb-4cfb-ad8e-8a86c2fe9492",
                                "sense_id": "4c155966-92da-3350-b7bf-fc0e432f7bca",
                                "text": "Il parle aussi de se « contrécrire » pour mieux se découvrir dans un monde « où on parlera sans avoir à rencontrer ces mots qui font saigner le temps »."
                            }
                        ]
                    }
                ],
