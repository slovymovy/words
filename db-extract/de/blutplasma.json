                        "source_sense_id": "5775a3cf-9ce7-320a-8802-4b25edd550dc",
                        "source_sense_description": "Transportflüssigkeit im Blut, die Nährstoffe, Elektrolyte, Abbauprodukte und Signalstoffe enthält",
                        "target_lang_word": "bloedplasma",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bloedplasma",
