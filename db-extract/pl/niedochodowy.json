                    },
                    {
                        "sense_id": "8c366ea5-3ff9-322e-a01e-476cb051468b",
                        "entry_id": "970a125a-a288-33fd-9e1d-c635698027f7",
                        "glosses": [
                            "z zasady nastawiony nie na osiąganie zysków, ale na realizację celów np. charytatywnych, oświatowych"
