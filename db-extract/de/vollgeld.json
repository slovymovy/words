                "senses": [
                    {
                        "sense_id": "b1b4f51a-4718-38b2-9297-7b082b42008a",
                        "entry_id": "daecbef1-8b7f-3e8b-accf-b48191908bc2",
                        "glosses": [
                            "Kontoplus (Geld) mit der Deckung durch eine Nationalbank (also Gleichstellung mit einer Bargeldsumme)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d8bb92a-dee4-4ce4-b010-96fd4f2729c3",
                                "sense_id": "b1b4f51a-4718-38b2-9297-7b082b42008a",
                                "text": "„Auch die Gefahr von Spekulationsblasen und Finanzkrisen würde durch Vollgeld deutlich verringert.“"
                            },
                            {
                                "example_id": "7a734791-e528-4e65-a762-85c58c7a2369",
                                "sense_id": "b1b4f51a-4718-38b2-9297-7b082b42008a",
                                "text": "„In Island holte das Parlament 2015 sogar Expertenmeinungen zur Einführung von Vollgeld ein.“"
                            },
                            {
                                "example_id": "24454cf2-76c8-44b5-92fd-fe7652c9afad",
                                "sense_id": "b1b4f51a-4718-38b2-9297-7b082b42008a",
                                "text": "„Ein Konto ist bloss eine Forderung des Kunden an die Bank, ihm Bargeld auszuzahlen, selbst aber nicht echtes Geld. Mit der Vollgeld-Initiative wird das elektronische Geld auf unseren Bankkonten zu gesetzlichem Zahlungsmittel, echtes Geld, Vollgeld eben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
