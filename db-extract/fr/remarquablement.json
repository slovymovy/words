                    {
                        "translation_id": "a290076b-9ec2-4781-a4e7-62188f3b17be",
                        "source_entry_id": "bd587606-8cc5-3225-b209-c8b6f737e0fd",
                        "source_sense_id": "73e79eb0-718d-3c4a-81b5-f06b029637f5",
                        "target_lang_word": "remarkably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "remarkably",
