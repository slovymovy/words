                        "entry_id": "26474e84-d7cf-34bf-983f-646c9862dbd9",
                        "glosses": [
                            "Passereau dentirostre au plumage paré de couleurs brillantes et vivant dans les contrées chaudes de l’Amérique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ea74f4c-3ed2-4cff-87d6-74390b74f3f4",
                                "sense_id": "0a0e857e-66e9-3441-a8fe-cfdc8d599ae3",
                                "text": "Cotinga de Daubenton."
                            },
                            {
                                "example_id": "8e5e91ea-d3cc-4578-97ed-93491191e1cf",
                                "sense_id": "0a0e857e-66e9-3441-a8fe-cfdc8d599ae3",
                                "text": "Sur une branche de l’arbre mort qui se dressait au centre de la plage, deux cotingas venaient de se poser."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e3651f8-8420-4553-940a-6c9000eea3c0",
                        "source_entry_id": "26474e84-d7cf-34bf-983f-646c9862dbd9",
                        "source_sense_id": "0a0e857e-66e9-3441-a8fe-cfdc8d599ae3",
                        "target_lang_word": "cotinga",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cotinga",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dba0009a-058d-30a0-abff-7aa23d1a1df5",
                                        "entry_id": "c0a598d3-0177-31cd-a657-0423f521776b",
                                        "glosses": [
                                            "Any of the neotropical passerine birds of the family Cotingidae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7f1ac2b-f7cb-42bc-a5c3-c9d17778dd91",
                                                "sense_id": "dba0009a-058d-30a0-abff-7aa23d1a1df5",
                                                "text": "Flocks of aquatic birds were to be seen on every side, the most numerous being the pelican, and a bird of the cotinga species, about the size of an English throstle, the plumage of which, being jet black and flamingo red, had a beautiful effect in the sunshine, as they flew or settled in thousands on the canes."
                                            },
                                            {
                                                "example_id": "54c53a2e-71c9-44db-b63f-9389ab37eec5",
                                                "sense_id": "dba0009a-058d-30a0-abff-7aa23d1a1df5",
                                                "text": "Sheer color alone is powerful enough, but when heightened by contrast, it becomes still more effective, and I seemed to have secured, with two barrels, a cotinga and its shadow."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
