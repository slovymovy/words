                                                "sense_id": "2b203543-c2cf-3987-940b-ce4eb07b3127",
                                                "text": "This new yard will replace a group of out-of-date yards, and there will be an estimated net saving of £150,000 a year."
                                            },
                                            {
                                                "example_id": "1c339e5f-f952-4dd9-8ee1-e624772dbecb",
                                                "sense_id": "2b203543-c2cf-3987-940b-ce4eb07b3127",
                                                "text": "The shift of the supplier gave us a saving of 10 percent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48fe7224-c6e9-37c2-9c49-f40a6e289194",
                                        "entry_id": "f9243693-6b1f-35d3-bbe3-c70447a90a00",
                                        "glosses": [
                                            "Something (usually money) that is saved, particularly money that has been set aside for the future."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
