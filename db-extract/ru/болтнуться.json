                        "examples": [
                            {
                                "example_id": "930128be-7055-4d4a-aa60-d169f80932de",
                                "sense_id": "53d606c5-a82d-3232-bc9b-d48571fa9fe2",
                                "text": "Юноша, вместо поклона, болтнулся всей фигурой, густо покраснел и опять окоченел на месте."
                            },
                            {
                                "example_id": "2ae95cdd-5034-4205-bfff-89ac0d43e5bc",
                                "sense_id": "53d606c5-a82d-3232-bc9b-d48571fa9fe2",
                                "text": "Лодка Карташёва на мгновение качнулась, круто стала против ветра, болтнулись паруса, и уже правым галсом понеслась наперерез второй лодке."
                            }
                        ]
                    }
