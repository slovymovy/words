                        "entry_id": "dd4ba2c6-368b-3c6b-b636-cc194b2a90db",
                        "glosses": [
                            "Relatif à un festival."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cca80c1-7c22-4408-a411-c7778e731370",
                                "sense_id": "56ed8cc0-aa99-3c37-b3c7-443561799bb9",
                                "text": "Un concert surprise calé en dernière minute par les Anglais (et organisé en l’occurrence par Les Ardentes) à la veille de leur saison festivalière qui devait démarrer le lendemain au Pinkpop tout proche (Pays-Bas)."
                            }
                        ]
                    }
                ],
