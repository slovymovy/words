                    {
                        "translation_id": "f69ac78c-70b3-4ca3-b48a-3aa5b02b2e6c",
                        "source_entry_id": "d36a917f-70e1-32b1-b278-3ab4edb3eb56",
                        "source_sense_description": "of or pertaining to an acrobat",
                        "target_lang_word": "artistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "artistisch",
