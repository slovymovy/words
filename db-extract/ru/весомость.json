                                                "example_id": "d7957ff9-be82-4dcc-8a72-158901b889b7",
                                                "sense_id": "9869b3d5-85c8-383f-85e8-4b34b8849179",
                                                "text": "In an age that had accepted imponderable fluids of electricity, magnetism, and even of vitality, attachment to ponderability was not an essential."
                                            }
