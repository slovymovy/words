            },
            {
                "entry_id": "26caf4e7-08af-31f3-83ec-53d84040528c",
                "word": "LLL",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "143e3fef-2896-3d8d-ad2b-2b7985259124",
                        "entry_id": "26caf4e7-08af-31f3-83ec-53d84040528c",
                        "glosses": [
                            "Initialism of lifelong learning."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "489fe246-94ad-40f9-8374-8981c4d820d5",
                                "sense_id": "143e3fef-2896-3d8d-ad2b-2b7985259124",
                                "text": "Near-synonyms: continuing education, further education, adult education"
                            },
                            {
                                "example_id": "daeea04a-5811-4a2a-82b9-862fecc06624",
                                "sense_id": "143e3fef-2896-3d8d-ad2b-2b7985259124",
                                "text": "Number of lines favourable to lifelong learning (\"LLL\") belonging to the main criteria divided between sub-categories, expressed in a percentage of the total number of lines in the curriculum for the basic school."
                            },
                            {
                                "example_id": "085e6eae-8db0-4f11-a74e-cda60349f58b",
                                "sense_id": "143e3fef-2896-3d8d-ad2b-2b7985259124",
                                "text": "Lifelong learning (LLL), as we see it, is not a norm to prescribe, but an empirical reality to analyse and reconstruct. There are different processes of transformation at work in education, and there are many \"lifelong educations\" (Giere*). LLL in each society refers to the totality of learning activities which, for analytical purposes, can be broken into three specific constituent elements…"
                            },
                            {
                                "example_id": "a6603d5d-84a6-4582-83b6-54a925b13a59",
                                "sense_id": "143e3fef-2896-3d8d-ad2b-2b7985259124",
                                "text": "If these ambitions are to become reality, various education and training practices need to support the aims of LLL. Research on possible transformations of national education and training systems into a state of lifelong learning should look into the policy interventions behind the efforts to put the systems on an LLL track."
                            }
                        ]
                    },
