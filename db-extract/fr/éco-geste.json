                        "sense_id": "b60d2037-5f55-355e-820d-fc0120014c45",
                        "entry_id": "046703f1-ed31-31cd-bf4e-649dd331cc68",
                        "glosses": [
                            "Geste, souvent simple et quotidien, que chaque citoyen peut faire afin de diminuer la pollution et améliorer son environnement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cfd7cda-a2ab-43e8-ad47-4db7b8b18fae",
                                "sense_id": "b60d2037-5f55-355e-820d-fc0120014c45",
                                "text": "Soyez curieux et n’oubliez pas que les éco-gestes sont aussi dans votre assiette et dans vos achats au quotidien."
                            },
                            {
                                "example_id": "dddb76da-1f00-4080-8884-d574ade29587",
                                "sense_id": "b60d2037-5f55-355e-820d-fc0120014c45",
                                "text": "Cet éco-geste a son « bonus » car, en retour, l’entreprise verse à la coopérative de l’école une petite somme devant servir à un projet éducatif."
                            },
                            {
                                "example_id": "15bbccc7-f517-4e96-a3dd-2f08ee28ab25",
                                "sense_id": "b60d2037-5f55-355e-820d-fc0120014c45",
                                "text": "Dans diverses occasions (spectacles, expositions), nous avons mis en place un dispositif permettant au spectateur ou au visiteur de formuler publiquement un engagement (en général, un éco-geste)."
                            }
                        ]
                    }
