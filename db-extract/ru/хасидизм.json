                    {
                        "translation_id": "9b6d056e-a043-4d69-929a-336bf4f2d359",
                        "source_entry_id": "ceb5b4e7-34b0-374c-9340-924a18b08d01",
                        "source_sense_id": "53e2d8d9-8f8f-3fd6-8b36-54063c7f37ac",
                        "target_lang_word": "Chassidismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chassidismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a766cb3d-3ee7-3cef-aba8-4970f7292c34",
                                        "entry_id": "a18a1950-a828-3dc8-a185-9bad700d07f7",
                                        "glosses": [
                                            "Richtung des osteuropäischen Judentums"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e4353b5-b0b9-491c-87b9-fd301d83e5d6",
                                                "sense_id": "a766cb3d-3ee7-3cef-aba8-4970f7292c34",
                                                "text": "„Natürlich steht hinter den zahllosen Geschichten vom Wunder-Rebbe die mystische Frömmigkeitsbewegung des Chassidismus (von Hebräisch chassid = fromm).“"
                                            },
                                            {
                                                "example_id": "016a3aa2-1740-446a-addc-67537d3a85c5",
                                                "sense_id": "a766cb3d-3ee7-3cef-aba8-4970f7292c34",
                                                "text": "„Gegen die Strenge der dogmatischen Talmud-Gelehrsamkeit entstand um die Mitte des 18. Jahrhunderts im Milieu der ostjüdischen Gemeinden die Bewegung des Chassidismus.“"
                                            },
                                            {
                                                "example_id": "81e9901e-9e50-48ca-9e66-802656daee53",
                                                "sense_id": "a766cb3d-3ee7-3cef-aba8-4970f7292c34",
                                                "text": "„Der Chassidismus nahm seinen Ausgangspunkt in Podolien (Ukraine) und verbreitete sich rasch über einen Großteil des aschkenasischen Osteuropa.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
