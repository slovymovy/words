{
    "word_family": [
        "inventorize",
        "inventorial"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "76078b01-dd62-3ea8-8393-3bf9deef384a",
                    "sense_definition": "The stock of an item on hand at a particular location or business.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The store has a large <w>inventory</w> of winter coats.",
                            "target_lang_translations": {
                                "ru": "В магазине большие <w>запасы</w> зимних пальто.",
                                "zh": "这家店有大量的冬装<w>库存</w>。"
                            }
                        },
                        {
                            "text": "We need to reduce our <w>inventory</w> to save space.",
                            "target_lang_translations": {
                                "ru": "Нам нужно сократить <w>товарные запасы</w>, чтобы сэкономить место.",
                                "zh": "我们需要减少<w>存货</w>以节省空间。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "inventory control",
                        "low inventory",
                        "reduce inventory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запасы товара или ресурсов, имеющиеся в наличии в определенном месте или на предприятии.",
                        "zh": "在特定地点或企业中现有的商品或资源储备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запасы",
                                "target_lang_sense_clarification": "reserves, stock"
                            },
                            {
                                "target_lang_word": "товарные запасы",
                                "target_lang_sense_clarification": "merchandise stock"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "库存",
                                "target_lang_sense_clarification": "stock of goods"
                            },
                            {
                                "target_lang_word": "存货",
                                "target_lang_sense_clarification": "merchandise stock"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb99c8bf-c7e5-3ac0-9766-a3b80e22cc23",
                    "sense_definition": "A detailed list of all of the items on hand.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She checked the <w>inventory</w> to see if the book was in stock.",
                            "target_lang_translations": {
                                "ru": "Она сверилась с <w>описью</w>, чтобы узнать, есть ли книга в наличии.",
                                "zh": "她核对了<w>清单</w>，看看那本书是否有货。"
                            }
                        },
                        {
                            "text": "The manager kept a strict <w>inventory</w> of all office supplies.",
                            "target_lang_translations": {
                                "ru": "Менеджер вел строгий <w>учёт</w> всех канцелярских принадлежностей.",
                                "zh": "经理对所有办公用品都进行了严格的<w>盘点</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "inventory list",
                        "full inventory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подробный список всех имеющихся предметов или имущества.",
                        "zh": "一份关于现有物品或财产的详细清单。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опись",
                                "target_lang_sense_clarification": "formal inventory list"
                            },
                            {
                                "target_lang_word": "список",
                                "target_lang_sense_clarification": "list"
                            },
                            {
                                "target_lang_word": "реестр",
                                "target_lang_sense_clarification": "register"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "清单",
                                "target_lang_sense_clarification": "list of items"
                            },
                            {
                                "target_lang_word": "目录",
                                "target_lang_sense_clarification": "register or catalog"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43ff13e1-b460-345c-8272-d6132c4263bd",
                    "sense_definition": "A space containing the items available to a character, especially in a video game, for immediate use.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Press the button to open your <w>inventory</w>.",
                            "target_lang_translations": {
                                "ru": "Нажмите кнопку, чтобы открыть <w>инвентарь</w>.",
                                "zh": "按下按钮打开你的<w>背包</w>。"
                            }
                        },
                        {
                            "text": "My <w>inventory</w> is full, so I cannot pick up the sword.",
                            "target_lang_translations": {
                                "ru": "Мой <w>инвентарь</w> полон, поэтому я не могу подобрать меч.",
                                "zh": "我的<w>物品栏</w>满了，所以我拿不了这把剑。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "open inventory",
                        "inventory slot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пространство или меню, содержащее предметы, доступные персонажу, особенно в видеоиграх.",
                        "zh": "电子游戏中用于存放角色可立即使用的物品的空间或菜单。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инвентарь",
                                "target_lang_sense_clarification": "items in a game"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "背包",
                                "target_lang_sense_clarification": "game inventory"
                            },
                            {
                                "target_lang_word": "物品栏",
                                "target_lang_sense_clarification": "game inventory slot"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3af549a9-160f-3633-8ce2-401d99d00882",
                    "sense_definition": "The process of producing or updating a list of items on hand.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shop is closed for <w>inventory</w> today.",
                            "target_lang_translations": {
                                "ru": "Магазин сегодня закрыт на <w>переучёт</w>.",
                                "zh": "商店今天关门进行<w>盘点</w>。"
                            }
                        },
                        {
                            "text": "Doing the <w>inventory</w> took longer than expected.",
                            "target_lang_translations": {
                                "ru": "<w>Инвентаризация</w> заняла больше времени, чем ожидалось.",
                                "zh": "进行<w>清点</w>花费的时间比预期的要长。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "annual inventory",
                        "do inventory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс подсчета и составления списка имеющихся предметов или товаров.",
                        "zh": "清点现有物品或商品并编制清单的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инвентаризация",
                                "target_lang_sense_clarification": "formal process"
                            },
                            {
                                "target_lang_word": "переучёт",
                                "target_lang_sense_clarification": "stocktaking (retail context)"
                            },
                            {
                                "target_lang_word": "учёт",
                                "target_lang_sense_clarification": "accounting, record keeping"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "盘点",
                                "target_lang_sense_clarification": "stocktaking"
                            },
                            {
                                "target_lang_word": "清点",
                                "target_lang_sense_clarification": "counting items"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a612e07c-0b54-38b4-909a-35f30012ee09",
                    "sense_definition": "The total set of a specified linguistic feature within a language.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "English has a large vowel <w>inventory</w> compared to Spanish.",
                            "target_lang_translations": {
                                "ru": "В английском языке большой <w>инвентарь</w> гласных по сравнению с испанским.",
                                "zh": "与西班牙语相比，英语拥有庞大的元音<w>系统</w>。"
                            }
                        },
                        {
                            "text": "The study analyzes the consonant <w>inventory</w> of the dialect.",
                            "target_lang_translations": {
                                "ru": "В исследовании анализируется <w>инвентарь</w> согласных этого диалекта.",
                                "zh": "这项研究分析了该方言的辅音<w>系统</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "phonemic inventory",
                        "vowel inventory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совокупность определенных лингвистических единиц в языке.",
                        "zh": "语言中特定语言特征的总集合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инвентарь",
                                "target_lang_sense_clarification": "set of linguistic units"
                            },
                            {
                                "target_lang_word": "состав",
                                "target_lang_sense_clarification": "composition"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "系统",
                                "target_lang_sense_clarification": "linguistic system"
                            },
                            {
                                "target_lang_word": "音系",
                                "target_lang_sense_clarification": "phonemic inventory"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "afb86dde-40d6-3529-8f0a-ef8fc6b22742",
                    "sense_definition": "To take stock of the resources or items on hand; to produce an inventory.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>inventory</w> the warehouse before the shipment arrives.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>инвентаризировать</w> склад до прибытия груза.",
                                "zh": "我们需要在货物到达前<w>盘点</w>仓库。"
                            }
                        },
                        {
                            "text": "They spent the whole weekend <w>inventorying</w> the books.",
                            "target_lang_translations": {
                                "ru": "Они провели все выходные, <w>инвентаризируя</w> книги.",
                                "zh": "他们整个周末都在<w>清点</w>书籍。"
                            }
                        }
                    ],
                    "synonyms": [
                        "take stock",
                        "take inventory",
                        "inventorize"
                    ],
                    "common_phrases": [
                        "inventory the stock",
                        "inventory supplies"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проводить проверку наличия и состояния имущества; составлять опись.",
                        "zh": "清点现有资源或物品；编制清单。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инвентаризировать",
                                "target_lang_sense_clarification": "to conduct an inventory"
                            },
                            {
                                "target_lang_word": "делать опись",
                                "target_lang_sense_clarification": "to make a list"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "盘点",
                                "target_lang_sense_clarification": "to conduct an inventory"
                            },
                            {
                                "target_lang_word": "清点",
                                "target_lang_sense_clarification": "to count and list"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}