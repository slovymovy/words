                "senses": [
                    {
                        "sense_id": "dc558d03-c7c0-3ded-8fb6-badeb27954df",
                        "entry_id": "1e121e80-44ae-3bc2-80ef-9b76cb88d075",
                        "glosses": [
                            "„in der germanischen Dichtung ein Einzellied, das von Sängern im Wechselgesang am Fürstenhof dargeboten wurde“"
                        ],
                        "tags": [
                            "Literaturwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "cb98c5d9-c580-4aa1-9a7d-ade6580d6b56",
                                "sense_id": "dc558d03-c7c0-3ded-8fb6-badeb27954df",
                                "text": "„Man hat sehr diskutiert, ob dieses Gedicht mit dem germanischen Preislied oder mit lateinischer Zeitdichtung zusammenhänge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "96da6e82-bbb3-3ced-9061-94f66aff8402",
                        "entry_id": "1e121e80-44ae-3bc2-80ef-9b76cb88d075",
                        "glosses": [
                            "Lied, in dem jemand oder etwas gelobt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d5dfcfa-70d3-47e5-8552-9b5c4e463ad3",
                                "sense_id": "96da6e82-bbb3-3ced-9061-94f66aff8402",
                                "text": "„Appar blieb eine Zeit lang dort und sang Preislieder für den flammenden Herrn, dem Geber der heiligen Schriften.“"
                            },
                            {
                                "example_id": "27340273-31e8-433b-a886-e7b8f0a7a542",
                                "sense_id": "96da6e82-bbb3-3ced-9061-94f66aff8402",
                                "text": "„In der indogermanischen Vorstellung war das Preislied für die Götter nicht nur ein Ausdruck der Verehrung und Anbetung.“"
                            },
                            {
                                "example_id": "8b293f14-b5b7-46d1-9ac1-273bf7593be0",
                                "sense_id": "96da6e82-bbb3-3ced-9061-94f66aff8402",
                                "text": "„Ein Preislied sollte erschallen, dass ihr in allem Elend dies eine große Glück des Gesanges gegeben!“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "2f24e8de-de12-341e-a045-57f852fcbfc4",
                        "entry_id": "1e121e80-44ae-3bc2-80ef-9b76cb88d075",
