                                "sense_id": "f3567a6b-1ff5-3094-8139-6c297089f60b",
                                "text": "»Einfach nicht beachten«, sagte Hermine kühl, …, »Ist doch schnuppe, Harry.«",
                                "translation": "Ne fais pas attention, tout simplement », dit froidement Hermione, …, »On s'en fout, Harry."
                            },
                            {
                                "example_id": "f7377a93-47f3-4150-84fc-30d67d8365e0",
                                "sense_id": "f3567a6b-1ff5-3094-8139-6c297089f60b",
                                "text": "Er zuckte mit den Schultern, es schien ihm vollständig schnuppe zu sein.",
                                "translation": "Il haussa les épaules, l’air de s’en foutre complètement."
                            }
                        ]
                    }
