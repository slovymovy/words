                "senses": [
                    {
                        "sense_id": "5de032ed-033c-334f-9429-11704d4be660",
                        "entry_id": "fc42a0c4-8df9-3e25-b61a-85500734f970",
                        "glosses": [
                            "Absence or lack of luck; lucklessness; bad luck; misfortune."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "70c78b79-1745-43ce-ac57-43f10808f128",
                                "sense_id": "5de032ed-033c-334f-9429-11704d4be660",
                                "text": "Truly the unluck had been visited upon him."
                            },
                            {
                                "example_id": "903ed87c-5b06-4019-956d-1b06ace8daad",
                                "sense_id": "5de032ed-033c-334f-9429-11704d4be660",
                                "text": "With a look of amusement on your face you ask me if I believe in luck. I fumble around for an answer, but the question stays with me as I venture out into the chill of the afternoon. It's not luck I believe in, but unluck. I have seen unluck in many guises."
                            }
                        ]
                    }
                ],
