                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "101f8fdb-b12d-44a5-86ac-3d8861b9fec2",
                                "sense_id": "5b2557e1-b9e2-377a-b361-966364c9c6de",
                                "text": "Heute säubern wir den Wirtschaftsraum."
                            }
                        ],
