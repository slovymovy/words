                "senses": [
                    {
                        "sense_id": "514eb7c6-9b63-3be6-bf5a-3444e4630147",
                        "entry_id": "9f3ed4aa-b767-35bc-9e30-d9a6a9011eba",
                        "glosses": [
                            "Se débrouiller."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c94342b0-9f5f-4416-9248-87c084395d10",
                                "sense_id": "514eb7c6-9b63-3be6-bf5a-3444e4630147",
                                "text": "Et comme on dit aux Antilles, « débrouillarder, c’est pas pécher»."
                            },
                            {
                                "example_id": "b2ba8aa2-b810-4635-b27c-f48bcb0f5c68",
                                "sense_id": "514eb7c6-9b63-3be6-bf5a-3444e4630147",
                                "text": "J’en déduis qu’une personne non phobique à l’eau et sachant se débrouillarder en surface peut parfaitement envisager un baptème."
                            },
                            {
                                "example_id": "08f13f3a-78d8-467b-96d3-bfa16280775f",
                                "sense_id": "514eb7c6-9b63-3be6-bf5a-3444e4630147",
                                "text": "À longueur de temps, je dois me débrouillarder."
                            }
                        ]
                    }
