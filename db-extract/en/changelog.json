                                    {
                                        "sense_id": "93dc082c-df0b-337f-99fe-bc41ac8633d4",
                                        "entry_id": "cb1bb17f-eea5-354d-b730-1337ce577e9d",
                                        "glosses": [
                                            "Auflistung aller Änderungen/Neuerungen bei einem Projekt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "978dc56c-d2f2-4e51-9a82-efaf9988c9e7",
                                                "sense_id": "93dc082c-df0b-337f-99fe-bc41ac8633d4",
                                                "text": "„Als Änderungsprotokoll hätte es, um in Kraft treten zu können, der Ratifizierung durch alle 21 Staaten, die Vertragspartei der Konvention sind, bedurft, was im damaligen Zeitpunkt nicht erreichbar schien”.“"
                                            },
                                            {
                                                "example_id": "8e967a9a-899e-4601-ada1-314ff430e7cf",
                                                "sense_id": "93dc082c-df0b-337f-99fe-bc41ac8633d4",
                                                "text": "„Die jeweiligen Verfügungen über die Änderungsanträge werden im Änderungsprotokoll als Aktualisierung des Projektdokuments festgehalten.“"
                                            },
                                            {
                                                "example_id": "89201db0-42ca-43ca-adb3-fdce7d3e92e8",
                                                "sense_id": "93dc082c-df0b-337f-99fe-bc41ac8633d4",
                                                "text": "„Anschließend wird, bevor Sie Ihre Änderungen übernehmen, ein Änderungsprotokoll angezeigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
