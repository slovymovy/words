{
    "word_family": [
        "menially"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d64d048d-55e4-3bf4-b78f-1dabbe153103",
                    "sense_definition": "Relating to work that is unskilled, repetitive, or considered low-status.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "low-status-work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent his summer doing <w>menial</w> jobs to save money for college.",
                            "target_lang_translations": {
                                "cs": "Léto strávil vykonáváním <w>podřadných</w> prací, aby si ušetřil na vysokou školu."
                            }
                        },
                        {
                            "text": "She felt that her degree was wasted on such <w>menial</w> tasks at the office.",
                            "target_lang_translations": {
                                "cs": "Měla pocit, že její diplom je na takové <w>podřadné</w> úkoly v kanceláři zbytečný."
                            }
                        }
                    ],
                    "synonyms": [
                        "unskilled",
                        "low-level",
                        "humble"
                    ],
                    "antonyms": [
                        "skilled",
                        "professional"
                    ],
                    "common_phrases": [
                        "menial job",
                        "menial task"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vztahující se k práci, která je nekvalifikovaná, opakující se nebo považovaná za podřadnou."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "podřadný",
                                "target_lang_sense_clarification": "označující práci s nízkým statusem"
                            },
                            {
                                "target_lang_word": "nekvalifikovaný",
                                "target_lang_sense_clarification": "označující práci nevyžadující odbornost"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15cfbb12-014b-3efb-8379-99d07ad4bd0b",
                    "sense_definition": "Relating to domestic work performed by a servant.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "low-status-work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The butler was expected to perform various <w>menial</w> duties around the large estate.",
                            "target_lang_translations": {
                                "cs": "Od komorníka se očekávalo, že bude na velkém panství vykonávat různé <w>služebné</w> povinnosti."
                            }
                        },
                        {
                            "text": "She refused to engage in <w>menial</w> chores that she believed were beneath her social standing.",
                            "target_lang_translations": {
                                "cs": "Odmítla se zapojit do <w>podřadných</w> domácích prací, o kterých věřila, že jsou pod její společenskou úroveň."
                            }
                        }
                    ],
                    "synonyms": [
                        "domestic",
                        "servile"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vztahující se k domácím pracím vykonávaným služebnictvem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "služebný",
                                "target_lang_sense_clarification": "týkající se práce služebnictva"
                            },
                            {
                                "target_lang_word": "domácí",
                                "target_lang_sense_clarification": "v kontextu domácích prací"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a385227-2521-3d63-ac87-f606d0d4e814",
                    "sense_definition": "Showing a submissive or servile attitude.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "subservient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>menial</w> behavior toward his boss made his coworkers feel uncomfortable.",
                            "target_lang_translations": {
                                "cs": "Jeho <w>servilní</w> chování vůči šéfovi bylo kolegům nepříjemné."
                            }
                        },
                        {
                            "text": "She despised the <w>menial</w> tone he adopted whenever he spoke to people in power.",
                            "target_lang_translations": {
                                "cs": "Pohrdala tím <w>podlézavým</w> tónem, který nasadil pokaždé, když mluvil s mocnými lidmi."
                            }
                        }
                    ],
                    "synonyms": [
                        "servile",
                        "obsequious",
                        "submissive"
                    ],
                    "antonyms": [
                        "assertive",
                        "haughty"
                    ],
                    "target_lang_definitions": {
                        "cs": "Projevující podřízený nebo servilní postoj."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "servilní",
                                "target_lang_sense_clarification": "přehnaně podlézavý"
                            },
                            {
                                "target_lang_word": "podlézavý",
                                "target_lang_sense_clarification": "projevující nepatřičnou podřízenost"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ece4fe41-6061-3b28-919c-dd4472e712a8",
                    "sense_definition": "A person who performs domestic or low-status work for others.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "subservient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wealthy family treated their <w>menials</w> with very little respect or kindness.",
                            "target_lang_translations": {
                                "cs": "Bohatá rodina se ke svým <w>služebníkům</w> chovala s velmi malým respektem či laskavostí."
                            }
                        },
                        {
                            "text": "In the old castle, the <w>menials</w> worked from dawn until dusk to keep everything clean.",
                            "target_lang_translations": {
                                "cs": "Ve starém hradě pracovali <w>služebníci</w> od úsvitu do soumraku, aby udrželi vše v čistotě."
                            }
                        }
                    ],
                    "synonyms": [
                        "servant",
                        "domestic"
                    ],
                    "antonyms": [
                        "master",
                        "employer"
                    ],
                    "target_lang_definitions": {
                        "cs": "Osoba, která vykonává domácí nebo podřadné práce pro ostatní."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "služebník",
                                "target_lang_sense_clarification": "osoba vykonávající podřadné práce"
                            },
                            {
                                "target_lang_word": "poskok",
                                "target_lang_sense_clarification": "hanlivé označení pro někoho v podřízené roli"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c6ed67a-82e3-3703-9838-727d1650ed83",
                    "sense_definition": "A person who has a naturally submissive or subservient character.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "subservient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a <w>menial</w> at heart, always seeking approval from those he considered superior.",
                            "target_lang_translations": {
                                "cs": "Byl to v jádru <w>přisluhovač</w>, který vždy hledal uznání u těch, které považoval za nadřízené."
                            }
                        },
                        {
                            "text": "She refused to be a <w>menial</w> to anyone, preferring to stand on her own two feet.",
                            "target_lang_translations": {
                                "cs": "Odmítla být komukoliv <w>poskokem</w> a raději se spoléhala sama na sebe."
                            }
                        }
                    ],
                    "synonyms": [
                        "sycophant",
                        "lackey"
                    ],
                    "target_lang_definitions": {
                        "cs": "Osoba, která má přirozeně podřízenou nebo servilní povahu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "přisluhovač",
                                "target_lang_sense_clarification": "osoba bez vlastní vůle sloužící druhým"
                            },
                            {
                                "target_lang_word": "lokaj",
                                "target_lang_sense_clarification": "přeneseně osoba s podlézavou povahou"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}