                ],
                "senses": [
                    {
                        "sense_id": "b8aba64c-c27e-33a8-8ec6-c04edca8881c",
                        "entry_id": "2c26c772-2e93-38b0-aea0-e70f35a2299e",
                        "glosses": [
                            "Faire passer sous un système nassérien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94ba5cbc-6cad-42f1-bcb1-6d155bba10bc",
                                "sense_id": "b8aba64c-c27e-33a8-8ec6-c04edca8881c",
                                "text": "Haidalla avait bien raison de réprimer ces milices de nationalistes arabisants, qui voulaient baa’thiser, irakiser, ou nassériser le pays en l’entraînant vers un avenir incertain."
                            },
                            {
                                "example_id": "237d4691-86fd-4958-b636-bb747bf36a00",
                                "sense_id": "b8aba64c-c27e-33a8-8ec6-c04edca8881c",
                                "text": "Si seulement ils avaient su l'apprécier à sa juste valeur , au lieu d'écouter les effroyables hurlements de fous furieux nassérisés et islamisés !"
                            },
                            {
                                "example_id": "74b44cdd-9e22-4136-91aa-07402c8a0c7f",
                                "sense_id": "b8aba64c-c27e-33a8-8ec6-c04edca8881c",
                                "text": "Et si l’Arabie salaouite se nassérise, Hussein de Jordanie n’en a pas pour un an."
                            }
                        ]
                    }
                ],
