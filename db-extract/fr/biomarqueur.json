        "fr-extract.jsonl": [
            {
                "entry_id": "9a5932ce-18bf-3095-87bb-b1d72135cace",
                "word": "biomarqueur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a23c029e-d1a7-484d-b07e-26c0d715b721",
                        "entry_id": "9a5932ce-18bf-3095-87bb-b1d72135cace",
                        "tags": [
                            "plural"
                        ],
                        "form": "biomarqueurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dbd980b2-587e-32a3-802a-85cc9f7aa4d1",
                        "entry_id": "9a5932ce-18bf-3095-87bb-b1d72135cace",
                        "glosses": [
                            "Marqueur biologique, le plus souvent une protéine, par opposition aux marqueurs chimiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39a3c4c6-3c33-47ef-a66b-396d08c24aa5",
                                "sense_id": "dbd980b2-587e-32a3-802a-85cc9f7aa4d1",
                                "text": "Plus exactement, la détection et le dosage des cytokines dans le sang, un biomarqueur inflammatoire, permettent de différencier les patients atteints de troubles bipolaires de ceux qui souffrent d’un trouble dépressif."
                            },
                            {
                                "example_id": "c2f03a05-3ab8-4ac4-9eea-5a203d2c6096",
                                "sense_id": "dbd980b2-587e-32a3-802a-85cc9f7aa4d1",
                                "text": "Notre dénominateur commun est donc d'utiliser les biomarqueurs, la génomique et la génétique pour mieux individualiser les diagnostics et les traitements qui s'ensuivent."
                            },
                            {
                                "example_id": "6d9cf533-443b-44c7-ae6a-941a4b698d4e",
                                "sense_id": "dbd980b2-587e-32a3-802a-85cc9f7aa4d1",
                                "text": "Il faut toutefois faire la différence entre « molécule organique » et « biosignature organique » ou « biomarqueur ». Les molécules organiques pourraient être un signe de vie, mais attention : en réalité, peu d’entre elles le sont. Nous appelons cela des biomarqueurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a74a365-a3b8-305b-8775-0e923e3d1dcf",
                        "entry_id": "9a5932ce-18bf-3095-87bb-b1d72135cace",
                        "glosses": [
                            "Signe observable biologiquement, par oppositions aux signes psychologiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5fc486b-a827-46cd-8677-910eb4b9200c",
                                "sense_id": "0a74a365-a3b8-305b-8775-0e923e3d1dcf",
                                "text": "Un diagnostic psychiatrique est bien plus difficile à préciser que le diabète à la suite d'une glycémie élevée! […] Pourra-t-il y avoir un jour en psychiatrie des biomarqueurs déterminants?"
                            }
                        ]
                    },
                    {
                        "sense_id": "171218b7-e5d4-3d1a-8f49-07218668d8cf",
                        "entry_id": "9a5932ce-18bf-3095-87bb-b1d72135cace",
                        "glosses": [
                            "Molécule organique spécifique produite par des organismes vivants, utilisée pour identifier des sources biologiques dans les échantillons géologiques."
                        ],
                        "tags": [
                            "Géochimie"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89585e70-e44f-435b-86d6-741f1f15247b",
                        "source_entry_id": "9a5932ce-18bf-3095-87bb-b1d72135cace",
                        "target_lang_word": "Biomarker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Biomarker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "840d17ad-3407-3970-9f5b-a46504026ba0",
                                        "entry_id": "920b726a-2ca6-3d75-8a1d-2555e950fb91",
                                        "glosses": [
                                            "messbare Produkte von Organismen, die als Indikatoren für zum Beispiel Umweltbelastungen oder Krankheiten herangezogen werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06f2a9f8-15b0-44db-b7bd-c061ba5457ee",
                                                "sense_id": "840d17ad-3407-3970-9f5b-a46504026ba0",
                                                "text": "Der Biomarker half dabei, eine Umweltbelastung festzustellen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e8edf7d-0307-4061-9622-81ac71720380",
                        "source_entry_id": "9a5932ce-18bf-3095-87bb-b1d72135cace",
                        "target_lang_word": "biomarker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biomarker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44ca2a7a-69a0-3892-b732-11a6577de5ba",
                                        "entry_id": "4f2f3086-1221-3338-bbad-a8f30722c4cc",
                                        "glosses": [
                                            "A substance used as an indicator of a biological state, most commonly disease."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a686380-75dd-4f26-b3fc-5abb40f5dd65",
                                                "sense_id": "44ca2a7a-69a0-3892-b732-11a6577de5ba",
                                                "text": "The goal of combining biomarkers is usually to increase the predictive power beyond that afforded by an individual molecular biomarker."
                                            },
                                            {
                                                "example_id": "64a4a5ce-6afb-4a3f-9755-f14371425ddb",
                                                "sense_id": "44ca2a7a-69a0-3892-b732-11a6577de5ba",
                                                "text": "“We are very interested in the concept of biomarkers, including digital biomarkers; in other words, the pattern of your accessing the internet may allow us to detect whether or not you are going to turn out to be vulnerable or not,” said Fineberg, although she admits at present this is just a theoretical idea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86715e4d-6626-3748-a50a-772373906df2",
                                        "entry_id": "4f2f3086-1221-3338-bbad-a8f30722c4cc",
                                        "glosses": [
                                            "Any measurable phenomenon that indicates the presence of life."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
