{
    "word_family": [
        "pokwitowanie",
        "kwit"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ebf32e5f-2363-39f1-a598-e378c20fc152",
                    "sense_definition": "potwierdzać odbiór czegoś podpisem lub wystawieniem dokumentu",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dokumentacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kurier poprosił, abym <w>kwitował</w> odbiór przesyłki na tablecie.",
                            "target_lang_translations": {
                                "ru": "Курьер попросил меня <w>расписаться</w> в получении посылки на планшете."
                            }
                        },
                        {
                            "text": "Pracownik musi <w>kwitować</w> pobranie gotówki z kasy firmowej.",
                            "target_lang_translations": {
                                "ru": "Сотрудник должен <w>подтверждать</w> получение наличных из кассы фирмы подписью."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kwitować odbiór"
                    ],
                    "target_lang_definitions": {
                        "ru": "подтверждать получение чего-либо подписью или выдачей документа"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расписываться в получении",
                                "target_lang_sense_clarification": "подтверждение получения подписью"
                            },
                            {
                                "target_lang_word": "квитировать",
                                "target_lang_sense_clarification": "официальный термин для подтверждения получения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f052db2b-77fa-3ba9-b317-469077bfd365",
                    "sense_definition": "zwięźle podsumowywać lub komentować sytuację",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "komunikacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziennikarz <w>kwituje</w> całą sytuację krótkim stwierdzeniem, że to był błąd.",
                            "target_lang_translations": {
                                "ru": "Журналист <w>резюмирует</w> всю ситуацию кратким утверждением, что это была ошибка."
                            }
                        },
                        {
                            "text": "Trener <w>kwituje</w> słabą grę drużyny jednym, wymownym spojrzeniem.",
                            "target_lang_translations": {
                                "ru": "Тренер <w>отзывается</w> о слабой игре команды одним красноречивым взглядом."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "кратко резюмировать или комментировать ситуацию"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резюмировать",
                                "target_lang_sense_clarification": "подводить итог сказанному"
                            },
                            {
                                "target_lang_word": "отзываться",
                                "target_lang_sense_clarification": "давать краткую оценку ситуации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b839819e-6fbf-3de4-bc16-62d7484ba32d",
                    "sense_definition": "udzielać odpowiedzi na coś",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "komunikacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na każde pytanie dziennikarzy polityk <w>kwituje</w> krótkim milczeniem.",
                            "target_lang_translations": {
                                "ru": "На каждый вопрос журналистов политик <w>отвечает</w> коротким молчанием."
                            }
                        },
                        {
                            "text": "Nie warto <w>kwitować</w> każdej złośliwej uwagi, lepiej zachować spokój.",
                            "target_lang_translations": {
                                "ru": "Не стоит <w>реагировать</w> на каждое злобное замечание, лучше сохранять спокойствие."
                            }
                        }
                    ],
                    "synonyms": [
                        "odpowiadać"
                    ],
                    "target_lang_definitions": {
                        "ru": "давать ответ на что-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отвечать",
                                "target_lang_sense_clarification": "общий термин для реакции на слова или действия"
                            },
                            {
                                "target_lang_word": "реагировать",
                                "target_lang_sense_clarification": "отвечать действием или отношением"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}