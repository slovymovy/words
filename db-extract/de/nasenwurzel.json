                "senses": [
                    {
                        "sense_id": "9fbc9feb-e44f-3da4-9a04-d91189772e8d",
                        "entry_id": "3bfcfe17-5ed6-307c-8450-b5bfb06fdb55",
                        "glosses": [
                            "oberer Ansatz der Nase"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30168f05-afd8-4b3f-8ad1-7af60d31821f",
                                "sense_id": "9fbc9feb-e44f-3da4-9a04-d91189772e8d",
                                "text": "„Sie hörte sich geduldig meine Geschichte an und drückte ihre goldgerahmte Brille gegen die Nasenwurzel.“"
                            },
                            {
                                "example_id": "3a361359-8ad7-44cb-abf5-0d206184a78a",
                                "sense_id": "9fbc9feb-e44f-3da4-9a04-d91189772e8d",
                                "text": "„Über ihrer Nasenwurzel bildete sich eine scharfe senkrechte Falte.“"
                            },
                            {
                                "example_id": "ef841fb4-c8cd-4857-a76c-86fed6526ec8",
                                "sense_id": "9fbc9feb-e44f-3da4-9a04-d91189772e8d",
                                "text": "„Ich schloss die Augen, massierte mir die Nasenwurzel.“"
                            },
                            {
                                "example_id": "c4a04526-5cfe-4e65-9c48-c543af562991",
                                "sense_id": "9fbc9feb-e44f-3da4-9a04-d91189772e8d",
                                "text": "„Über ihrer Nasenwurzel haben sich zwei Falten gebildet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
