                    {
                        "sense_id": "1dd94d13-e741-3b93-bd6e-5d79221c64f1",
                        "entry_id": "3821f6e5-dd7c-3bcb-8a62-119adb5c0b69",
                        "glosses": [
                            "Einteilung der Geschichte in Zeitalter respektive Epochen anhand von bestimmten Merkmalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "957dd8bb-677e-4be7-939e-776ad864e304",
                                "sense_id": "1dd94d13-e741-3b93-bd6e-5d79221c64f1",
                                "text": "„Die Periodisierung der japanischen Geschichte orientiert sich an den innerjapanischen kulturellen und politischen Entwicklungen und Herrscherhäusern und stimmen nicht notwendigerweise mit westlichen Einteilungen überein.“"
                            },
                            {
                                "example_id": "d9496603-27de-43cc-950d-14094ee3da05",
                                "sense_id": "1dd94d13-e741-3b93-bd6e-5d79221c64f1",
                                "text": "„Daher lohnt sich an dieser Stelle ein kurzer Ausblick auf die weitere Entwicklung der deutschen Sprachgeschichte, insbesondere auf ihre Periodisierung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
