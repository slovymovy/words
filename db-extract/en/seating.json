                                        "sense_id": "ec7dc5ed-6b28-3afa-aad5-46858430e041",
                                        "entry_id": "fcd6f52e-4887-3af9-9cee-bdbf1330f10b",
                                        "glosses": [
                                            "Summe der Sitzplätze (die der Anzahl Stühle entsprechen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b93f6535-8ac6-4027-a1ab-f22e6fdeee87",
                                                "sense_id": "ec7dc5ed-6b28-3afa-aad5-46858430e041",
                                                "text": "Schwarzes Gestühl mit hellgrünen Überzügen vervollständigt die Einrichtung des Kinos."
                                            },
                                            {
                                                "example_id": "5e359b63-8819-4b99-ad39-c6ba863d14e7",
                                                "sense_id": "ec7dc5ed-6b28-3afa-aad5-46858430e041",
                                                "text": "Die kleine Kapelle besitzt ein Gestühl aus Eichenholz und in den Fenstern buntfarbiges Glas."
                                            },
                                            {
                                                "example_id": "f934939c-12a7-4bc9-94e8-af308e78ae60",
                                                "sense_id": "ec7dc5ed-6b28-3afa-aad5-46858430e041",
                                                "text": "„Vom Einbau einer Empore im westlichen Teil der Kirche konnte daher ausnahmsweise abgesehen werden; die Aufstellung des Gestühles für die Nonnen im Langhaus zu ebener Erde hatte nichts Bedenkliches.“"
                                            },
                                            {
                                                "example_id": "fc76a87e-89cf-4df4-9886-6dc9904efb99",
                                                "sense_id": "ec7dc5ed-6b28-3afa-aad5-46858430e041",
                                                "text": "„In dem Kirchlein nahmen sie auch ihre Mahlzeit ein, garten das Fleisch an offenem Feuer, achteten aber darauf, dass es nicht das Gestühl in Brand setzte.“"
                                            }
                                        ],
