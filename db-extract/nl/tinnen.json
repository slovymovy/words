                    {
                        "translation_id": "d26b0f9e-c698-4957-9a1e-d087bf93dd41",
                        "source_entry_id": "0dfcae5c-0d92-3828-8bcd-0d4260a8c3ce",
                        "source_sense_id": "ab596d53-6117-3338-87e0-002a0e592cb9",
                        "source_sense_description": "van tin vervaardigd",
                        "target_lang_word": "оловянный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "оловянный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4e91fd2d-fcb9-36c2-809f-63911a38636b",
                                        "entry_id": "5649f1de-cf6a-3866-8e8a-b9b2295ac11f",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным олово"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2ff45d1-d457-4d71-b809-4d9f07a335ed",
                                                "sense_id": "4e91fd2d-fcb9-36c2-809f-63911a38636b",
                                                "text": "Производство элемента № 50 из руд и россыпей всегда начинается с обогащения. Методы обогащения оловянных руд довольно разнообразны. 〈…〉 Чаще всего оловянные сплавы применяют в качестве антифрикционных материалов или припоев. 〈…〉 Едва достигнут этот температурный порог, в кристаллической структуре оловянного слитка начинается перестройка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23dd8f30-a2a2-3454-9962-09b64fc4d0c2",
                                        "entry_id": "5649f1de-cf6a-3866-8e8a-b9b2295ac11f",
                                        "glosses": [
                                            "свойственный олову, характерный для него"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b05ef17a-97a0-3ce3-854e-668d48748c69",
                                        "entry_id": "5649f1de-cf6a-3866-8e8a-b9b2295ac11f",
                                        "glosses": [
                                            "состоящий из олова, содержащий в себе олово"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cecbc5a9-9fcd-4be9-834e-08cc5d41f930",
                                                "sense_id": "b05ef17a-97a0-3ce3-854e-668d48748c69",
                                                "text": "Другой важный минерал — станнин или оловянный колчедан CuFeSnS4."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1316062b-0fcb-3a91-a6db-019a341301b8",
                                        "entry_id": "5649f1de-cf6a-3866-8e8a-b9b2295ac11f",
                                        "glosses": [
                                            "сделанный, изготовленный из олова"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a449c359-20ce-487a-bce5-5746269a6e57",
                                                "sense_id": "1316062b-0fcb-3a91-a6db-019a341301b8",
                                                "text": "Одна пуговица была оловянная, солдатская, сзади пришит поясок."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f3f177a-a576-3025-891f-bbf042cd9dec",
                                        "entry_id": "5649f1de-cf6a-3866-8e8a-b9b2295ac11f",
                                        "glosses": [
                                            "перен. имеющий цвет олова, тёмно-серый или светло-серый с тусклым отливом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2f0d350-4242-4178-95c0-c1dffe503cad",
                                                "sense_id": "4f3f177a-a576-3025-891f-bbf042cd9dec",
                                                "text": "Медленно катилась мутная оловянная вода реки, испещрённая отмелями жёлтых песков."
                                            },
                                            {
                                                "example_id": "31e3d58b-482b-4f00-8278-6cc0357e765f",
                                                "sense_id": "4f3f177a-a576-3025-891f-bbf042cd9dec",
                                                "text": "Тускло блещет оловянное небо, ни облачка, ни ветерка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e60fb2d-7619-3fc0-b80b-e6efbc1795aa",
                                        "entry_id": "5649f1de-cf6a-3866-8e8a-b9b2295ac11f",
                                        "glosses": [
                                            "перен. тусклый, ничего не выражающий (о глазах, взгляде)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8aada069-d5b6-48eb-ad2a-638495411131",
                                                "sense_id": "6e60fb2d-7619-3fc0-b80b-e6efbc1795aa",
                                                "text": "Глаза у Асыки были тусклые, оловянные."
                                            },
                                            {
                                                "example_id": "2c0430ff-453b-4d6b-a702-ddd67cb5bbb9",
                                                "sense_id": "6e60fb2d-7619-3fc0-b80b-e6efbc1795aa",
                                                "text": "Он медленно поднялся и вперил в меня свой оловянный взгляд."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
