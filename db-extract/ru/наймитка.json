                "translations": [
                    {
                        "translation_id": "ae67147d-5d10-473e-938c-194dcdf619f8",
                        "source_entry_id": "f8c5ae8b-2dfd-32ab-8a53-eb4619069dc5",
                        "target_lang_word": "hireling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hireling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "373344b1-7f96-391f-a596-c4a86733fb19",
                                        "entry_id": "a94d845b-7187-37ce-82ee-08b9c94dade2",
                                        "glosses": [
                                            "An employee who is hired, often to perform unpleasant tasks with little independence."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d02a463-6187-4d0c-96db-971ca04bd1ee",
                                                "sense_id": "373344b1-7f96-391f-a596-c4a86733fb19",
                                                "text": "Is there not an appointed time to man vpon earth? are not his dayes alſo like the dayes of an hireling?"
                                            },
                                            {
                                                "example_id": "022d872e-440e-4b22-8425-16e5bb9e15e1",
                                                "sense_id": "373344b1-7f96-391f-a596-c4a86733fb19",
                                                "text": "When my poor James was in the small-pox, did I allow any hireling to nurse him?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "185193d2-807f-39cc-85e9-f74d03911110",
                                        "entry_id": "a94d845b-7187-37ce-82ee-08b9c94dade2",
                                        "glosses": [
                                            "Someone who does a job purely for money, rather than out of interest in the work itself."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b69a1a6d-16dc-467f-987f-134800c3da96",
                                                "sense_id": "185193d2-807f-39cc-85e9-f74d03911110",
                                                "text": "[…]it may bee truely affirmed, that no kinde of men loue buſineſſe for it ſelfe, but thoſe that are learned; for other perſons loue it for profite; as an hireling that loues the worke for the wages;"
                                            },
                                            {
                                                "example_id": "413c402b-8930-4c60-89ab-a1f1a3bf8913",
                                                "sense_id": "185193d2-807f-39cc-85e9-f74d03911110",
                                                "text": "These vain bickerings / Are spawn'd in courts by base intrigues and baser / Hirelings, who live by lies on good men's lives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f12300d3-8503-3acd-b5f1-5e5f8e403e37",
                                        "entry_id": "a94d845b-7187-37ce-82ee-08b9c94dade2",
                                        "glosses": [
                                            "A horse for hire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f39b9bbb-6eb2-495a-a666-bf035ef55586",
                                                "sense_id": "f12300d3-8503-3acd-b5f1-5e5f8e403e37",
                                                "text": "In the afternoon they went to a neighbouring livery stables to look for hirellings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "421abfaf-73ab-3499-a03b-cd63dce13534",
                                        "entry_id": "a94d845b-7187-37ce-82ee-08b9c94dade2",
                                        "glosses": [
                                            "A prostitute."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
