                    "frequency": "High",
                    "semantic_group_id": "ontwikkelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij kon haar boetiekje <w>uitbouwen</w> tot een modeketen met filialen in tien landen.",
                            "target_lang_translations": {
                                "en": "She was able to <w>expand</w> her small boutique into a fashion chain with branches in ten countries."
                            }
                        },
                        {
                            "text": "Hij <w>bouwde</w> de kleine zaak <w>uit</w> tot een internationaal succesvol bedrijf.",
                            "target_lang_translations": {
                                "en": "He <w>built</w> the small business <w>up</w> into an internationally successful company."
                            }
                        }
