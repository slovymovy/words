                ],
                "senses": [
                    {
                        "sense_id": "178e1893-14b1-39da-afea-33b6fdb0190c",
                        "entry_id": "586ec382-5b2f-3613-bcab-c99f4be291d9",
                        "glosses": [
                            "so, dass es bezogen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc979161-be62-4db0-8020-dd1623a5a91a",
                                "sense_id": "178e1893-14b1-39da-afea-33b6fdb0190c",
                                "text": "„Der Endtermin ist um drei Wochen überschritten. Wann werden die Wohnhallen fertig beziehbar dastehen?“"
                            },
                            {
                                "example_id": "bb37704b-b049-4cab-a94f-a32c318c21e1",
                                "sense_id": "178e1893-14b1-39da-afea-33b6fdb0190c",
                                "text": "„Zum Gesicht der Inflation gehören auch die Bezugsscheine, mit denen allein viele Warengattungen in den Staatsgeschäften beziehbar sind, daher das Anstellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
