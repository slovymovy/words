                        "examples": [
                            {
                                "example_id": "fc8a4fed-34cc-45fc-ba05-d69faf905d8a",
                                "sense_id": "d9a42372-ba64-3b56-9dce-e826fff219fa",
                                "text": "\"Artsen hebben lange tijd hoofdpijn niet interessant gevonden. Het werd gezien als 'vrouwenkwaaltje', men moest maar een paracetamol slikken en dat was het.\""
                            },
                            {
                                "example_id": "76205a22-7255-44b2-95b6-d380a06b8364",
                                "sense_id": "d9a42372-ba64-3b56-9dce-e826fff219fa",
                                "text": "Ook in Almelo zijn schildklierklachten dus een 'vrouwenkwaal': 6,30 procent van alle vrouwen in deze gemeente slikte in 2022, het meest recente jaar waarover het CBS cijfers heeft, medicijnen, tegen 1,47 procent van alle mannen. Ter vergelijking: in heel Overijssel gaat het om 5,25 procent van alle vrouwen, en 1,13 procent van alle mannen. Landelijk zit 4,88 procent van alle vrouwen aan de schildkliermedicijnen, tegen 1,12 procent van alle mannen."
                            }
