                "senses": [
                    {
                        "sense_id": "73638f76-a06e-3452-82a0-d688dbde4daf",
                        "entry_id": "20ec6931-cd11-36c0-83b1-4346174c771d",
                        "glosses": [
                            "To leach from an overlying stratum and accumulate in suspension."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "749840af-953c-4950-99ad-a42cb91a19e7",
                                "sense_id": "73638f76-a06e-3452-82a0-d688dbde4daf",
                                "text": "This is due to the reason that these materials are rich in organic matter which tend to illuviate from the surface to the subsurface in the longrun and have tend to increase the clay per cent in the subsurface soil layers (Prashanthi, 1997)."
                            },
                            {
                                "example_id": "3651c3b2-391f-4aef-986f-064e15efa7c2",
                                "sense_id": "73638f76-a06e-3452-82a0-d688dbde4daf",
                                "text": "Defining the exact mechanism by which these metal cations become mobile and illuviate is where the two main theories of podzolization diverge."
                            },
                            {
                                "example_id": "0c98cd57-1773-4f8b-8724-b81f2575fe6c",
                                "sense_id": "73638f76-a06e-3452-82a0-d688dbde4daf",
                                "text": "In flooding seasons, because the Eh value rises beginning from the lower part of this horizon downwards, some substances moving with the water begin to illuviate here, resulting in the formation of mottling spots and coatings."
                            }
                        ]
                    }
