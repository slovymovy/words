                    },
                    {
                        "translation_id": "ef84a005-ddac-48fe-8ac5-8659006cee5f",
                        "source_entry_id": "3026dda9-5198-3001-9628-7c93b8317a50",
                        "source_sense_id": "07b99a76-627e-3a85-b2e7-8fb820b126ed",
