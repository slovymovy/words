                "senses": [
                    {
                        "sense_id": "70f80cd9-7f5e-3a37-87a5-9fa0777ffeba",
                        "entry_id": "7ff475e4-6015-37b6-9480-74cdf1b62e4b",
                        "glosses": [
                            "das einem konkreten Satz zugrundeliegende Muster"
                        ],
                        "tags": [
                            "(Sprachwissenschaft)"
                        ],
                        "examples": [
                            {
                                "example_id": "bbc556ff-a27f-4cc4-a4db-022f2ad1c676",
                                "sense_id": "70f80cd9-7f5e-3a37-87a5-9fa0777ffeba",
                                "text": "„Dies wäre jedoch allenfalls dann für die Satzstruktur von ausschlaggebender Bedeutung, wenn die Objekte ein einheitliches Verhalten hätten.“"
                            },
                            {
                                "example_id": "1e389566-d7e5-4996-bb04-f16e3dceee04",
                                "sense_id": "70f80cd9-7f5e-3a37-87a5-9fa0777ffeba",
                                "text": "„Satzstrukturen in Zeitungstexten sind der Gegenstand der Untersuchung von ŠVEC (1979).“"
                            },
                            {
                                "example_id": "016e8031-112b-41c6-8e95-3c5c5360b437",
                                "sense_id": "70f80cd9-7f5e-3a37-87a5-9fa0777ffeba",
                                "text": "Man kann Satzstrukturen aufgrund von ganz unterschiedlichen Kriterien beschreiben."
                            },
                            {
                                "example_id": "0bfaf9ca-5898-4383-affb-49f7ccb3699a",
                                "sense_id": "70f80cd9-7f5e-3a37-87a5-9fa0777ffeba",
                                "text": "„Mit dieser These vom Beitrag der Wortbedeutung zur Satzbedeutung soll selbstverständlich die Rolle der lexikologisch nicht thematisierbaren Satzstruktur für die Satzbedeutung nicht geleugnet werden.“"
                            },
                            {
                                "example_id": "b0491fb3-bc4a-4a26-9248-04359085c661",
                                "sense_id": "70f80cd9-7f5e-3a37-87a5-9fa0777ffeba",
                                "text": "„Beowulf wurde auf Altenglisch geschrieben, der frühen germanischen Version des Englischen mit skandinavischen Einflüssen, die gesprochen wurde, bevor mit der normannischen Invasion von 1066 französische und lateinische Wörter und Satzstrukturen übernommen wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
