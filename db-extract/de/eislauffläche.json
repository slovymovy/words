                "senses": [
                    {
                        "sense_id": "97b0e131-13b1-3957-a023-e297c5601655",
                        "entry_id": "4f8c4295-e331-36e9-9c0d-ee46fc205c37",
                        "glosses": [
                            "Wintersport: natürliche oder künstlich hergestellte vereiste, besonders zum Eislauf genutzte Fläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "214e6efe-5ef5-418c-86f1-6d531424c022",
                                "sense_id": "97b0e131-13b1-3957-a023-e297c5601655",
                                "text": "„Die Situation am Heumarkt kann nur verbessert werden, wenn sich alle ‚Stakeholder‘ bewegen, nicht nur die Investoren, sondern auch der Eislaufverein, der mit mehr Flexibilität in Bezug auf Proportion und Größe der Eislauffläche eine wesentlich attraktivere, auch für eine hochwertige Sommernutzung geeignete Infrastruktur erhalten könnte.“"
                            },
                            {
                                "example_id": "7b60349e-61d7-4aea-936c-4364ad2fc132",
                                "sense_id": "97b0e131-13b1-3957-a023-e297c5601655",
                                "text": "„Wir lebten an drei Orten: der Schule, der Kirche und der Eislauffläche, aber das wahre Leben ist auf der Eislauffläche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
