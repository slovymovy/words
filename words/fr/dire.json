                    "sense_id": "ccc53b40-1a64-39e1-824b-d86bfc848543",
                    "sense_definition": "Exprimer ou formuler une pensée, un fait ou un sentiment par la parole.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il m'a regardé dans les yeux avant de me <w>dire</w> la vérité."
                        },
                        {
                            "text": "Les enfants pensent toujours à <w>dire</w> bonjour quand ils entrent dans la pièce."
                        }
