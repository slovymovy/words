                "senses": [
                    {
                        "sense_id": "0504837d-60ea-3133-9ee7-03cbebf0e085",
                        "entry_id": "0e8794be-33c9-3301-8ace-d692fac1e0c6",
                        "glosses": [
                            "Begriff für die Lüftungsarten in einem Wohnraum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "774be67f-f7df-4395-906e-997c78cf053e",
                                "sense_id": "0504837d-60ea-3133-9ee7-03cbebf0e085",
                                "text": "„Die Wohnraumlüftung ist der Dreh- und Angelpunkt und die Grundlage für gesundes Wohnen und Wohlbefinden.“"
                            },
                            {
                                "example_id": "287204e6-fd78-495c-9205-eaa6126410da",
                                "sense_id": "0504837d-60ea-3133-9ee7-03cbebf0e085",
                                "text": "„Dies erfordert eine schnelle Änderung dieser Situation durch den Einbau einer Wohnraumlüftung oder zumindest einer Einzelraumunit.“"
                            },
                            {
                                "example_id": "d9a5bbdd-6f21-4321-868f-67c6a3b05585",
                                "sense_id": "0504837d-60ea-3133-9ee7-03cbebf0e085",
                                "text": "„Dies funktioniert nur mit einer Wohnraumlüftung, welche den entsprechenden Luftwechsel pro Stunde sicherstellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
