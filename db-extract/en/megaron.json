                                        "entry_id": "8e2e82e4-8555-3f19-986f-ff300140896d",
                                        "glosses": [
                                            "Partie centrale et principale des palais grecs de l'époque mycénienne, elle comporte une salle de réception, une antichambre et la salle du trône."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78b4a9d9-b21a-46f1-b7cd-f583e1815a23",
                                                "sense_id": "ea46841c-6253-335a-90cf-9d23833a1429",
                                                "text": "À Mycènes, on trouve un petit groupe de pièces pour les femmes, à l’étage, accessibles par un couloir et un escalier ; elles s’y retirent lorsque le mégaron est occupé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52506c8b-f55a-3bbf-af9e-950a0958926b",
                                        "entry_id": "8e2e82e4-8555-3f19-986f-ff300140896d",
                                        "glosses": [
                                            "Pièce principale des maisons de l'âge de bronze en Grèce, dans laquelle se trouvait un foyer fixe central."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
