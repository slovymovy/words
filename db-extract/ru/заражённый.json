                "senses": [
                    {
                        "sense_id": "f7258da4-b3f8-314e-b526-7927872a0f16",
                        "entry_id": "fb604397-22ec-3327-a049-164257301c56",
                        "glosses": [
                            "получивший определённое заболевание или инфекцию"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af5f2041-505b-4f9e-abcb-7bdec463ca7e",
                                "sense_id": "f7258da4-b3f8-314e-b526-7927872a0f16",
                                "text": "Заражённый оспой."
                            },
                            {
                                "example_id": "2aa3274d-070c-41c6-9e70-8b7961a8d3c6",
                                "sense_id": "f7258da4-b3f8-314e-b526-7927872a0f16",
                                "text": "Заражённый чумой."
                            },
                            {
                                "example_id": "d39a150a-6dd3-4fd6-b2d7-0ebb5e301239",
                                "sense_id": "f7258da4-b3f8-314e-b526-7927872a0f16",
                                "text": "Заражённый гриппом."
                            },
                            {
                                "example_id": "522e25fe-49a3-4d76-9ebb-0f5b9b7b90ad",
                                "sense_id": "f7258da4-b3f8-314e-b526-7927872a0f16",
                                "text": "Только следует помнить, что заражённая старая мебель — угроза новой, только привезённой из магазина."
                            }
                        ]
                    },
                    {
                        "sense_id": "e10a3cbb-9eb5-3b82-9637-8b2040d70cf1",
                        "entry_id": "fb604397-22ec-3327-a049-164257301c56",
                        "glosses": [
                            "перен. подвергшийся влиянию каких-либо идей, убеждений"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a4270b8-d55f-4d59-b85b-52013cc1a292",
                                "sense_id": "e10a3cbb-9eb5-3b82-9637-8b2040d70cf1",
                                "text": "Катя, заражённая смехом брата, тоже начинает смеяться."
                            }
                        ]
                    }
