                "forms": [],
                "senses": [
                    {
                        "sense_id": "491ef843-e1c7-31f4-8da4-af05056f3dd4",
                        "entry_id": "4f69062a-6baf-3565-b113-4aa93b83d50b",
                        "glosses": [
                            "Parteilichkeit, Vorurteil, Befangenheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d411cf6-6a3c-4707-8bff-f7a911cbd888",
                                "sense_id": "491ef843-e1c7-31f4-8da4-af05056f3dd4",
                                "text": "The judge's partiality towards the defendant caused him to be replaced, with someone who was apparently more neutral. - Die Parteilichkeit des Richters für den Angeklagten führte dazu, dass er ersetzt wurde, durch jemanden, der offensichtlich neutraler war."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc798c7d-63bb-40ba-8edc-1392baa5794a",
                        "source_entry_id": "4f69062a-6baf-3565-b113-4aa93b83d50b",
                        "source_sense_id": "491ef843-e1c7-31f4-8da4-af05056f3dd4",
                        "source_sense_description": "Parteilichkeit, Vorurteil, Befangenheit",
                        "target_lang_word": "Parteilichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2cf9c682-7cd9-4208-b8f2-1a39edcf4389",
                        "source_entry_id": "4f69062a-6baf-3565-b113-4aa93b83d50b",
                        "source_sense_id": "491ef843-e1c7-31f4-8da4-af05056f3dd4",
                        "source_sense_description": "Parteilichkeit, Vorurteil, Befangenheit",
                        "target_lang_word": "Vorurteil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorurteil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30ae23bd-99b5-3caa-aeb0-ef6d4cff0d91",
                                        "entry_id": "ca6b2eee-2e7c-3fb0-96e1-d8d3a4537682",
                                        "glosses": [
                                            "voreilig gebildete, oft falsche Meinung über jemanden oder etwas, das nicht auf Erfahrungen oder Wissen beruht und meist mit Abneigung oder Hass verbunden ist; Urteil vor oder ohne Kenntnis des einzelnen Beurteilten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "686337b7-f83c-4036-9cb0-de42f56e22f3",
                                                "sense_id": "30ae23bd-99b5-3caa-aeb0-ef6d4cff0d91",
                                                "text": "Es ist ein Vorurteil, dass alle Schotten geizig seien."
                                            },
                                            {
                                                "example_id": "4767ab71-0ca3-466e-829e-f00b0585c53f",
                                                "sense_id": "30ae23bd-99b5-3caa-aeb0-ef6d4cff0d91",
                                                "text": "„Vorurteile werden manchmal als Urteile und Wertungen definiert, die nicht auf eigener Erfahrung beruhen.“"
                                            },
                                            {
                                                "example_id": "b51ac851-3b9c-4434-89d9-c2bb685c836e",
                                                "sense_id": "30ae23bd-99b5-3caa-aeb0-ef6d4cff0d91",
                                                "text": "„An dieser Stelle muss Einspruch gegen ein beliebtes polnisches Vorurteil erhoben werden, nämlich dass Polen frech über rote Ampeln marschieren, während deutsche Fußgänger brav stehen bleiben.“"
                                            },
                                            {
                                                "example_id": "40a3b325-6ecb-492c-8b5d-09e6dfff7866",
                                                "sense_id": "30ae23bd-99b5-3caa-aeb0-ef6d4cff0d91",
                                                "text": "„Bekanntlich steckt ja in jedem Vorurteil ein Körnchen Wahrheit.“"
                                            },
                                            {
                                                "example_id": "53ad2a1d-e2af-4e70-9a23-7f19c0211acb",
                                                "sense_id": "30ae23bd-99b5-3caa-aeb0-ef6d4cff0d91",
                                                "text": "„Dazwischen stößt man auf eine vortreffliche Auswahl an Klischees, Vorurteilen und frivolen Halluzinationen, wie sie nur der menschliche Geist zu ersinnen imstande ist, alles sorgfältig illustriert und kommentiert.“"
                                            },
                                            {
                                                "example_id": "af76a609-8518-4762-955f-2736fe639fa4",
                                                "sense_id": "30ae23bd-99b5-3caa-aeb0-ef6d4cff0d91",
                                                "text": "„Die Sprachwissenschaft sieht sich dem Vorurteil gegenüber, ihre Aussagen zum öffentlich gefühlten Sprachverfall seien nichts als Beschwichtigungen, die dazu dienten, im Sinne von politischer Überkorrektheit abweichendes Deutsch zur guten Sprache schönzureden.“"
                                            },
                                            {
                                                "example_id": "c3987756-a43b-4aaa-94f2-0c8ac2d0cd1e",
                                                "sense_id": "30ae23bd-99b5-3caa-aeb0-ef6d4cff0d91",
                                                "text": "[2025:] „In der Diskussion über Elektroautos halten sich viele Vorurteile über Wertverlust, Reichweite, Ladedauer und Reparaturkosten. Welche stimmen, welche nicht?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae1f33c5-a055-49a7-9f42-17f235ce0df7",
                        "source_entry_id": "4f69062a-6baf-3565-b113-4aa93b83d50b",
                        "source_sense_id": "491ef843-e1c7-31f4-8da4-af05056f3dd4",
                        "source_sense_description": "Parteilichkeit, Vorurteil, Befangenheit",
                        "target_lang_word": "Befangenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Befangenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c33a6cef-94e6-3a9a-98e0-fbd7ec6958d2",
                                        "entry_id": "a0b1e802-53ed-3710-bb83-b22c25c67da6",
                                        "glosses": [
                                            "Unsicherheit oder Zögern einer Sache gegenüber"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e035be93-b949-4a4b-8932-3a4e008cb3dc",
                                                "sense_id": "c33a6cef-94e6-3a9a-98e0-fbd7ec6958d2",
                                                "text": "Als Anna vorgestellt wurde, wich ihre Befangenheit schnell dem Interesse an ihren neuen Klassenkameraden."
                                            },
                                            {
                                                "example_id": "09389e00-9a2d-45e0-83bd-80fa31adc820",
                                                "sense_id": "c33a6cef-94e6-3a9a-98e0-fbd7ec6958d2",
                                                "text": "„Er geht wie im Traum weiter, dann aber schüttelt er die Befangenheit ab, als neben ihm, hoch oben auf den Stadtbahnbögen, eine S-Bahn vorüberrasselt.“"
                                            },
                                            {
                                                "example_id": "bbfd4eef-6b3a-4dd9-a2ba-b77c530b8370",
                                                "sense_id": "c33a6cef-94e6-3a9a-98e0-fbd7ec6958d2",
                                                "text": "„Als Thomas seine anfängliche Befangenhet abgelegt hatte, war er bereit, bei diesem Spiel mitzuwirken, das ihn zeitweise an absurdes Theater erinnerte.“"
                                            },
                                            {
                                                "example_id": "b00b7549-3808-45be-bfb0-2877a45ec359",
                                                "sense_id": "c33a6cef-94e6-3a9a-98e0-fbd7ec6958d2",
                                                "text": "„Die Tanzenden hatten sich ein für allemal gesagt, sie seien eben maskiert und niemand könne sie erkennen, und darum waren sie auch von jeglicher Befangenheit frei.“"
                                            },
                                            {
                                                "example_id": "d973f468-2f22-4e9c-a33e-c108783ea752",
                                                "sense_id": "c33a6cef-94e6-3a9a-98e0-fbd7ec6958d2",
                                                "text": "„Vielleicht erklärte sich die Befangenheit auch daher, daß er irgendwelche Aufgaben zu versäumen glaubte, die seiner im Archiv warteten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "015e9c74-4b68-3c94-88a2-b5d1b415580e",
                                        "entry_id": "a0b1e802-53ed-3710-bb83-b22c25c67da6",
                                        "glosses": [
                                            "mangelnde Fähigkeit, ein objektives und unabhängiges Urteil zu bilden, insbesondere aufgrund einer persönlichen Verwicklung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6323d513-123a-4317-a5bc-03b5fcb1f727",
                                                "sense_id": "015e9c74-4b68-3c94-88a2-b5d1b415580e",
                                                "text": "Der Staatsanwalt unterstellt dem Richter Befangenheit, weil er ein Stammtischbruder des Angeklagten sei."
                                            },
                                            {
                                                "example_id": "8ed6a3f3-6b03-4cd2-938f-1a0e9ded2b07",
                                                "sense_id": "015e9c74-4b68-3c94-88a2-b5d1b415580e",
                                                "text": "„Das Wesen der Befangenheit besteht in der Hemmung einer unparteiischen Entschließung durch unsachliche psychologische Motive.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
