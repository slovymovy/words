                        "form": "den Sportunterricht"
                    },
                    {
                        "form_id": "cebbce4c-6ce9-4778-a0a8-97b72b8e42c5",
                        "entry_id": "d4032ffd-a46e-327a-85da-d1e0ca79522c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sportunterrichte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d729d9d8-234e-302c-9996-ef5a08c4fa62",
                        "entry_id": "d4032ffd-a46e-327a-85da-d1e0ca79522c",
                        "glosses": [
                            "Unterricht in Sport"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d136b9b2-d572-4464-88b8-40e36b7e994d",
                                "sense_id": "d729d9d8-234e-302c-9996-ef5a08c4fa62",
                                "text": "„Der Sport in der Bundeswehr gliedert sich in zwei Bereiche: Zum einen die breit angelegte Ausbildung von Sportlehrern, die letztlich für alle Angehörigen in der Truppe Sportunterrichte und -wettkämpfe organisieren und durchführen. Zum anderen ...“"
                            },
                            {
                                "example_id": "bd33ce6e-6281-4fd0-b95b-3a1ccd736faa",
                                "sense_id": "d729d9d8-234e-302c-9996-ef5a08c4fa62",
                                "text": "„Hat sich die Koalition überhaupt Gedanken gemacht, was mit intersexuellen Kindern ohne Geschlechtsantrag im Kindergarten oder in der Schule passiert? Sind diese Einrichtungen darauf vorbereitet? Wie sollen diese Kinder an den Sportunterrichten teilnehmen?“"
                            },
                            {
                                "example_id": "e27de8d2-625d-4a30-98dd-98b45e96e520",
                                "sense_id": "d729d9d8-234e-302c-9996-ef5a08c4fa62",
                                "text": "„Deswegen fiel für alle Klassen ein Jahr lang der Sportunterricht aus.“"
                            },
                            {
                                "example_id": "2d18dc49-8ff1-46b1-9703-bb3e2ad1075b",
                                "sense_id": "d729d9d8-234e-302c-9996-ef5a08c4fa62",
                                "text": "„Der Sportunterricht bietet zahlreiche erprobte Ansätze, um, einhergehend mit der Erarbeitung motorischer Kompetenzen, das sozial-emotionale Lernen von Schülerinnen und Schülern in den Mittelpunkt zu stellen. Ein Beispiel dafür ist die Wagniserziehung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
