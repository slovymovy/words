{
    "word_family": [
        "miscellany",
        "miscellaneously",
        "miscellaneousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "86b35d01-551a-3827-8c6f-547907dd3858",
                    "sense_definition": "Consisting of a variety of different items, ingredients, or parts that are not necessarily related.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "variety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The drawer was filled with a <w>miscellaneous</w> collection of old keys, stamps, and loose coins.",
                            "target_lang_translations": {
                                "ru": "Ящик был наполнен <w>разнообразной</w> коллекцией старых ключей, марок и разрозненных монет."
                            }
                        },
                        {
                            "text": "She spent the afternoon sorting through a <w>miscellaneous</w> pile of clothes and household tools.",
                            "target_lang_translations": {
                                "ru": "Она провела вторую половину дня, разбирая <w>смешанную</w> кучу одежды и хозяйственных инструментов."
                            }
                        }
                    ],
                    "synonyms": [
                        "assorted",
                        "diverse"
                    ],
                    "common_phrases": [
                        "miscellaneous items",
                        "miscellaneous collection",
                        "miscellaneous pile"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состоящий из множества различных предметов, ингредиентов или частей, которые не обязательно связаны между собой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разнообразный",
                                "target_lang_sense_clarification": "состоящий из разных элементов"
                            },
                            {
                                "target_lang_word": "смешанный",
                                "target_lang_sense_clarification": "состоящий из смеси разных вещей"
                            },
                            {
                                "target_lang_word": "разный",
                                "target_lang_sense_clarification": "неодинаковый по составу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57fd4e20-0855-3be9-9f6c-b2654bc76630",
                    "sense_definition": "Grouped together because they do not fit into any other specific category.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "categorization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Any costs that do not fit under travel or food should be listed as <w>miscellaneous</w> expenses.",
                            "target_lang_translations": {
                                "ru": "Любые расходы, которые не подпадают под категории транспорта или питания, должны быть указаны как <w>прочие</w> расходы."
                            }
                        },
                        {
                            "text": "The final folder in the filing cabinet is for <w>miscellaneous</w> documents that are rarely used.",
                            "target_lang_translations": {
                                "ru": "Последняя папка в картотеке предназначена для <w>разных</w> документов, которые редко используются."
                            }
                        }
                    ],
                    "synonyms": [
                        "other"
                    ],
                    "common_phrases": [
                        "miscellaneous expenses",
                        "miscellaneous category",
                        "miscellaneous costs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сгруппированные вместе, потому что они не подходят ни под одну другую конкретную категорию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прочий",
                                "target_lang_sense_clarification": "остальной, не вошедший в основные группы"
                            },
                            {
                                "target_lang_word": "разный",
                                "target_lang_sense_clarification": "относящийся к разным мелким категориям"
                            },
                            {
                                "target_lang_word": "непредвиденный",
                                "target_lang_sense_clarification": "о расходах, не вошедших в бюджет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2f8b952-64d6-300a-a4da-eb92fa58d811",
                    "sense_definition": "Having diverse characteristics, abilities, or appearances.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "variety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The club attracted a <w>miscellaneous</w> group of people with very different backgrounds and interests.",
                            "target_lang_translations": {
                                "ru": "Клуб привлек <w>разношерстную</w> группу людей с самыми разными взглядами и интересами."
                            }
                        },
                        {
                            "text": "His <w>miscellaneous</w> talents made him a valuable asset to the creative team.",
                            "target_lang_translations": {
                                "ru": "Его <w>разносторонние</w> таланты сделали его ценным приобретением для творческой команды."
                            }
                        }
                    ],
                    "synonyms": [
                        "manifold",
                        "diverse"
                    ],
                    "common_phrases": [
                        "miscellaneous group",
                        "miscellaneous talents"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий разнообразными характеристиками, способностями или внешним видом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разношерстный",
                                "target_lang_sense_clarification": "о группе людей с разными интересами или происхождением"
                            },
                            {
                                "target_lang_word": "разносторонний",
                                "target_lang_sense_clarification": "о талантах или способностях"
                            },
                            {
                                "target_lang_word": "различный",
                                "target_lang_sense_clarification": "отличающийся по свойствам"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}