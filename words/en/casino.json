                {
                    "sense_id": "9f9c9d79-956d-3782-a7c3-9bd8da0c0d70",
                    "sense_definition": "A specific card that holds special value or meaning in the game of casino.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "card_game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ten of diamonds is known as the big <w>casino</w> and is worth two points.",
                            "target_lang_translations": {
                                "ru": "Десятка бубен называется «большое <w>казино</w>» и приносит два очка.",
                                "zh": "方块十被称为“大<w>卡西诺牌</w>”，价值两分。"
                            }
                        },
                        {
                            "text": "She managed to capture the little <w>casino</w>, which is the two of spades.",
                            "target_lang_translations": {
                                "ru": "Ей удалось взять «малое <w>казино</w>» — двойку пик.",
                                "zh": "她成功赢得了“小<w>卡西诺牌</w>”，也就是黑桃二。"
                            }
