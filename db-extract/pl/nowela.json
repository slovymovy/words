                                        "sense_id": "eaab2316-cc3a-3c03-846c-341e57a0b337",
                                        "entry_id": "7c9d29e2-1757-38b1-8507-88289aec7f55",
                                        "glosses": [
                                            "eine kürzere Erzählung, die von einem einzelnen ungewöhnlichen Ereignis handelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ebb36fa-7607-4d69-bb67-35e798cab62a",
                                                "sense_id": "eaab2316-cc3a-3c03-846c-341e57a0b337",
                                                "text": "Die Novelle erschien bewusst gestaltet erstmals im „Decamerone“."
                                            },
                                            {
                                                "example_id": "0120e57b-bb17-490d-8386-d8165877d67b",
                                                "sense_id": "eaab2316-cc3a-3c03-846c-341e57a0b337",
                                                "text": "Die Novelle entstand in der italienischen Frührenaissance."
                                            },
                                            {
                                                "example_id": "0e655ed9-fbf0-4579-bd37-d023fc4a0e83",
                                                "sense_id": "eaab2316-cc3a-3c03-846c-341e57a0b337",
                                                "text": "„Mit ihren Novellen und historischen Büchern, die sie in den folgenden Jahren verfasste, erlangte sie großes Ansehen.“"
                                            },
                                            {
                                                "example_id": "34f279ac-c89c-4163-a1c2-38752a35f1da",
                                                "sense_id": "eaab2316-cc3a-3c03-846c-341e57a0b337",
                                                "text": "„In der Novelle Lenz ringt der Held ausdrücklich um die religiöse Sinngebung seines Leids.“"
                                            },
                                            {
                                                "example_id": "cc0527c6-89f0-465f-8a0f-c966885d91ca",
                                                "sense_id": "eaab2316-cc3a-3c03-846c-341e57a0b337",
                                                "text": "„Die hundert Novellen des Decamerone handeln dann gerade nicht von der Pest, sondern von ganz anderen, heiteren Gegenständen, die zu lachen Anlaß geben.“"
                                            },
                                            {
                                                "example_id": "6c8fb027-4a88-4e9e-b46b-b31d3792139f",
                                                "sense_id": "eaab2316-cc3a-3c03-846c-341e57a0b337",
                                                "text": "„In der Novelle von den drei Witwen ist es anders.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6ee7967b-358b-3f32-af7a-22fd2d637e42",
                                        "entry_id": "7c9d29e2-1757-38b1-8507-88289aec7f55",
                                        "glosses": [
                                            "Nachtragsgesetz, das ein zeitlich vorhergehendes Gesetz abändert oder ergänzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d0d437c-9e59-409b-9ece-6561d48bbed6",
                                                "sense_id": "6ee7967b-358b-3f32-af7a-22fd2d637e42",
                                                "text": "„Am Donnerstagabend verabschiedete der Bundestag eine Novelle, die es Behörden ermöglicht, Verbraucher schneller über Fälle von Etikettenschwindel zu informieren.“"
                                            },
                                            {
                                                "example_id": "b6f61ad1-58d7-4d0b-be1c-71d87028a966",
                                                "sense_id": "6ee7967b-358b-3f32-af7a-22fd2d637e42",
                                                "text": "In der Glücksspielgesetz-Novelle 2008 (GSpG-Novelle 2008) wurden grundsätzliche Gesetze geändert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
