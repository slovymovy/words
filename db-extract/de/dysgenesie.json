                "senses": [
                    {
                        "sense_id": "4fd480fd-3202-3b45-8940-d63d724d9111",
                        "entry_id": "03bdf694-8da2-31c6-9840-a5803ad7908e",
                        "glosses": [
                            "genetisch bedingte Fehlentwicklung eines Organs oder Organteils"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8734db3-ab41-4b61-a9f8-a7817a05848f",
                                "sense_id": "4fd480fd-3202-3b45-8940-d63d724d9111",
                                "text": "„Segmentale spinale Dysgenesie heißt die Krankheit im Medizinerlatein, was nicht viel mehr bedeutet, als dass Teile des Rückgrats und Rückenmarks sich im Mutterleib nicht entwickelt haben.“"
                            },
                            {
                                "example_id": "5ab9692c-4901-4be2-bccd-f28bef1a626e",
                                "sense_id": "4fd480fd-3202-3b45-8940-d63d724d9111",
                                "text": "„Die retikuläre Dysgenesie (MIM 267500) ist einer der schwersten kombinierten Immundefekte (2 % aller SCID) mit sensorischer Schwerhörigkeit, dem biallelische Mutationen in AK2 zugrunde liegen (Pannicke et al. 2009).“"
                            },
                            {
                                "example_id": "0c15865d-07a6-42d6-ba43-14af40a5de15",
                                "sense_id": "4fd480fd-3202-3b45-8940-d63d724d9111",
                                "text": "„Tritt die Störung nach beendeter Ausbildung der Geschlechtsorgane auf, resultiert eine isolierte testikuläre Dysgenesie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
