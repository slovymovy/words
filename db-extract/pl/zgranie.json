                            {
                                "example_id": "ab9e4ec9-5650-4f9a-a794-1a45433a37e1",
                                "sense_id": "77a6b6f4-6bc3-3ce6-9bab-4641e1652e47",
                                "text": "Dwunastu trębaczy dało popis idealnego zgrania w utworze Antonio Agostiniego — „Trzej trębacze”"
                            },
                            {
                                "example_id": "ca18244f-0fe8-437c-b378-c60fdf8049d1",
                                "sense_id": "77a6b6f4-6bc3-3ce6-9bab-4641e1652e47",
                                "text": "Piłkarze stalinogrodzcy, reprezentowani w zasadzie przez sosnowiecką Stal (w drużynie wystąpiło 9 jej piłkarzy) przewyższali krakowian szybkością i zgraniem"
                            }
                        ],
