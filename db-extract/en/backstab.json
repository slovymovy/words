                    {
                        "sense_id": "c31c214c-144e-3ad8-b9eb-67f9a774e14e",
                        "entry_id": "c39cb708-7c35-3b73-8975-8853550c7a68",
                        "glosses": [
                            "To attack someone (especially verbally) unfairly in a deceitful, underhand, or treacherous manner, especially when they're not present in the place or situation that it happens."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "878c9a3d-ca0e-4fd7-b3c5-9237145eea3a",
                        "source_entry_id": "c39cb708-7c35-3b73-8975-8853550c7a68",
                        "source_sense_id": "c31c214c-144e-3ad8-b9eb-67f9a774e14e",
                        "source_sense_description": "to attack someone (especially verbally) unfairly",
                        "target_lang_word": "hintergehen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hintergehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e71dcc78-a478-383c-b1ae-2b65930dbcb4",
                                        "entry_id": "d9940a3c-3f43-3372-a5d0-939bca92d6af",
                                        "glosses": [
                                            "etwas heimlich, ohne das Wissen einer Person tun, was dieser schadet"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bc3978f-18ec-4c53-a525-1742ee0d7041",
                                                "sense_id": "e71dcc78-a478-383c-b1ae-2b65930dbcb4",
                                                "text": "„Mit dieser Rolle der Gefühle ist leicht einsehbar, warum viele Menschen niemals einen Freund hintergehen würden, sich aber nichts dabei denken, wenn sie Firmeneigentum mitgehen lassen oder ihre Einkommensteuererklärung frisieren.“"
                                            },
                                            {
                                                "example_id": "6d6e2ea9-4d01-4d4f-b763-e745d7dcc5c6",
                                                "sense_id": "e71dcc78-a478-383c-b1ae-2b65930dbcb4",
                                                "text": "Ich hoffe wirklich, dass er mich nicht hintergangen hat."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "hintergehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b83dd99c-729f-389b-83b8-0e7cd3365243",
                                        "entry_id": "6f5659a7-e946-353f-9491-8bf5202ced64",
                                        "glosses": [
                                            "nach hinten gehen"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bfe6ab3-c2a8-4a36-b104-f77b516d9e44",
                                                "sense_id": "b83dd99c-729f-389b-83b8-0e7cd3365243",
                                                "text": "„Sie ist hintergegangen und hat ihn wollen aufwecken; aber er ist nicht aufgewacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
