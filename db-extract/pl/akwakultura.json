                    },
                    {
                        "sense_id": "62bbb958-667e-31a8-9d46-3b8c8409717d",
                        "entry_id": "068f3e69-af14-3d87-9678-ca952888ad8c",
                        "glosses": [
                            "Wissenschaft, die sich mit [1] beschäftigt; Aquakultur"
