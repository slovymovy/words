                                        "sense_id": "b9e566dd-14f9-3fe3-b9e8-055c01da929d",
                                        "entry_id": "23866f26-5c97-3138-aabe-64a3cfe9ea30",
                                        "glosses": [
                                            "jemand, der etwas auf extreme Art und Weise tut; Anhänger des Extremismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce5deebc-c018-452a-ad9e-4c4ac3c64c3a",
                                                "sense_id": "b9e566dd-14f9-3fe3-b9e8-055c01da929d",
                                                "text": "SindExtremisten eine Bedrohung für die freie Welt?"
                                            },
                                            {
                                                "example_id": "98f0eb3a-3302-4663-918a-8f2531b98029",
                                                "sense_id": "b9e566dd-14f9-3fe3-b9e8-055c01da929d",
                                                "text": "„In Syrien sind seit dem Beginn der US-geführten Offensive gegen die Dschihadistengruppe vor einer Woche nach Angaben von Aktivisten bereits mehr als 200 Extremisten getötet worden.“"
                                            },
                                            {
                                                "example_id": "f89ad0ae-7758-47d6-8c16-e6ed19e0ac63",
                                                "sense_id": "b9e566dd-14f9-3fe3-b9e8-055c01da929d",
                                                "text": "„Die Bürger zudem als Extremisten zu denunzieren war der Beginn des Zusammenschlusses der Istanbuler, egal welcher politischen Überzeugung.“"
                                            },
                                            {
                                                "example_id": "61607d5f-5a0f-4183-abf2-0f6c1a4463c1",
                                                "sense_id": "b9e566dd-14f9-3fe3-b9e8-055c01da929d",
                                                "text": "„Doch nicht alle Kenianer folgen den Extremisten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
