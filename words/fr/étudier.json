    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ab3f951d-4b2d-3f99-a97a-c3cf1c96dcf9",
                    "sense_definition": "Suivre des cours dans un établissement d'enseignement ; faire ses études.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "scolarite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ma sœur <w>étudie</w> à l'université de Lyon depuis deux ans."
                        },
                        {
                            "text": "Beaucoup de jeunes préfèrent <w>étudier</w> à l'étranger pour apprendre une langue."
                        }
                    ],
                    "common_phrases": [
                        "étudier à l'université",
                        "étudier à l'étranger"
                    ]
                },
                {
                    "sense_id": "5ffb66b7-3795-3d3c-8e27-fca40f8b80e4",
                    "sense_definition": "S'appliquer à apprendre une matière, une langue ou une discipline intellectuelle.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "apprentissage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous <w>étudions</w> le français tous les matins avec notre professeur."
                        },
                        {
                            "text": "Il doit <w>étudier</w> sa leçon avant de faire les exercices."
                        }
                    ],
                    "synonyms": [
                        "apprendre"
                    ],
                    "common_phrases": [
                        "étudier une langue",
                        "étudier le droit"
                    ]
                },
                {
                    "sense_id": "73ff7e50-654a-3cb6-88aa-fa80bad1eec3",
                    "sense_definition": "Examiner attentivement une question, un projet ou une proposition afin de l'analyser.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "analyse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur va <w>étudier</w> votre proposition lors de la prochaine réunion."
                        },
                        {
                            "text": "La commission <w>étudie</w> ce dossier avec une attention toute particulière."
                        }
                    ],
                    "synonyms": [
                        "examiner",
                        "analyser"
                    ],
                    "common_phrases": [
                        "étudier un projet",
                        "étudier la question",
                        "étudier une proposition"
                    ]
                },
                {
                    "sense_id": "14091ba5-034f-37a0-8c59-00a959e401e3",
                    "sense_definition": "Observer avec attention le comportement, les réactions ou la psychologie de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "observation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin <w>étudie</w> les réactions de son patient face au traitement."
                        },
                        {
                            "text": "Elle <w>étudiait</w> discrètement le visage de son interlocuteur pour deviner ses pensées."
                        }
                    ],
                    "synonyms": [
                        "observer",
                        "scruter"
                    ],
                    "common_phrases": [
                        "étudier le comportement"
                    ]
                },
                {
                    "sense_id": "857412c7-a312-39d4-ae58-5e5cf25fa81c",
                    "sense_definition": "S'appliquer avec grand soin ou artifice à faire quelque chose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'<w>étudie</w> à masquer ses sentiments derrière une politesse irréprochable."
                        },
                        {
                            "text": "L'orateur s'<w>étudiait</w> à peser chaque mot pour convaincre l'assemblée."
                        }
                    ],
                    "synonyms": [
                        "s'appliquer",
                        "s'efforcer"
                    ],
                    "common_phrases": [
                        "s'étudier à plaire"
                    ]
                }
            ]
        }
    ]
