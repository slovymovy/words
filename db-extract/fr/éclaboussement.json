                "senses": [
                    {
                        "sense_id": "be27d05c-3429-3c53-8f78-0ef1e306f08f",
                        "entry_id": "6a85773c-b3f9-33ff-9131-9b4d92bb40fb",
                        "glosses": [
                            "Action d’éclabousser; résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdd63487-6453-4379-9e98-0013a03feecc",
                                "sense_id": "be27d05c-3429-3c53-8f78-0ef1e306f08f",
                                "text": "Le ballon, poussé par le vent, […] s’inclina, toucha l’eau en un éclaboussement argenté et se releva vivement, […]."
                            },
                            {
                                "example_id": "67bf4daf-b0de-4f45-bf53-1e48945e2293",
                                "sense_id": "be27d05c-3429-3c53-8f78-0ef1e306f08f",
                                "text": "Marylène s’amusa bien à cause des types dans les autres barques, qui venaient les éperonner avec de grands éclaboussements de rames."
                            },
                            {
                                "example_id": "eb2ab3d0-2d94-4236-b3ac-ed124728f6d6",
                                "sense_id": "be27d05c-3429-3c53-8f78-0ef1e306f08f",
                                "text": "— L'éclaboussement du sol par les gouttes de pluie est habituellement le plus fort et le plus évident lors d'orages de courte durée et de grande intensité."
                            },
                            {
                                "example_id": "1acf00a2-1f01-41e7-812c-b6db249f3a0b",
                                "sense_id": "be27d05c-3429-3c53-8f78-0ef1e306f08f",
                                "text": "Une population de Littorina neritoides, ordinairement caractéristique des zones d'éclaboussement, habite la jetée et s'y divise entre deux niches très différentes."
                            },
                            {
                                "example_id": "56bc1c7b-0146-4f48-b93f-36470b793578",
                                "sense_id": "be27d05c-3429-3c53-8f78-0ef1e306f08f",
                                "text": "Bien que les cas d'éclaboussement des yeux ou de contamination des yeux par des composés chimiques des lieux de travail soient assez communs, il est probable que les quantités de substances chimiques qui pénètrent ainsi dans l'organisme ne sont pas très grandes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
