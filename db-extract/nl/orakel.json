                        "word": "godsspraak"
                    }
                ]
            },
            {
                "entry_id": "f2b1a6a9-beeb-3d3a-9aad-2aa469553fd7",
                "word": "orakel",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "35b633cc-38d5-3d32-b7d1-bc42c7c4ea5b",
                        "entry_id": "f2b1a6a9-beeb-3d3a-9aad-2aa469553fd7",
                        "glosses": [
                            "eerste persoon enkelvoud tegenwoordige tijd van orakelen"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
