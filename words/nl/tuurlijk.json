                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "affirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Tuurlijk</w>! Wat een vraag! Kom maar binnen, hoor!",
                            "target_lang_translations": {
                                "en": "<w>Of course</w>! What a question! Come on in!",
                                "ru": "<w>Конечно</w>! Что за вопрос! Заходи!",
                                "pl": "<w>Oczywiście</w>! Co za pytanie! Wchodź śmiało!",
                                "de": "<w>Natürlich</w>! Was für eine Frage! Komm nur rein!",
                                "fr": "<w>Bien sûr</w> ! Quelle question ! Entre, je t'en prie !",
                                "it": "<w>Certo</w>! Che domanda! Entra pure!",
                                "cs": "<w>Jasně</w>! Co je to za otázku! Pojď dál!",
                                "tr": "<w>Elbette</w>! Ne biçim soru! İçeri gel hadi!",
                                "es": "¡<w>Claro</w>! ¡Qué pregunta! ¡Pasa, hombre!",
                                "zh": "<w>当然</w>！这还用问吗？快进来！"
                            }
                        },
                        {
                            "text": "Ga je vanavond mee naar de film? <w>Tuurlijk</w>!",
                            "target_lang_translations": {
                                "en": "Are you coming to the movies tonight? <w>Sure</w>!",
                                "ru": "Пойдешь сегодня вечером в кино? <w>Естественно</w>!",
                                "pl": "Idziesz wieczorem do kina? <w>Pewnie</w>!",
                                "de": "Gehst du heute Abend mit ins Kino? <w>Klar</w>!",
                                "fr": "Tu viens au cinéma ce soir ? <w>Bien sûr</w> !",
                                "it": "Vieni al cinema stasera? <w>Sicuro</w>!",
                                "cs": "Půjdeš dnes večer do kina? <w>Jasně</w>!",
                                "tr": "Bu akşam sinemaya geliyor musun? <w>Tabii ki</w>!",
                                "es": "¿Vienes al cine esta noche? ¡<w>Por supuesto</w>!",
                                "zh": "你今晚去看电影吗？<w>没问题</w>！"
                            }
                        }
