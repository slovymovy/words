                                "target_senses": [
                                    {
                                        "sense_id": "bd3d8fa1-8c32-3c4c-9965-ed92522924ea",
                                        "entry_id": "ea8a985d-f3d0-3c6d-958b-0d5e3790b826",
                                        "glosses": [
                                            "A high cover providing shelter, such as a cloth supported above an object, particularly over a bed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0831bf9f-9ff6-46b5-bc08-5c4438dc9546",
                                                "sense_id": "bd3d8fa1-8c32-3c4c-9965-ed92522924ea",
                                                "text": "golden canopies and beds of state"
                                            },
                                            {
                                                "example_id": "f2cab23e-f462-401e-8104-5370cf684aca",
                                                "sense_id": "bd3d8fa1-8c32-3c4c-9965-ed92522924ea",
                                                "text": "Platforms would be widened and covered by canopies with heated waiting areas for passengers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5018b6a5-8e79-31f7-81ef-c31a2e7523be",
                                        "entry_id": "ea8a985d-f3d0-3c6d-958b-0d5e3790b826",
                                        "glosses": [
                                            "Any overhanging or projecting roof structure, typically over entrances or doors."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "36fc5be2-d377-3591-b613-18d7285afedd",
                                        "entry_id": "ea8a985d-f3d0-3c6d-958b-0d5e3790b826",
                                        "glosses": [
                                            "The zone of the highest foliage and branches of a forest."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e743414-b90f-3c3c-a72d-2230dc392aa2",
                                        "entry_id": "ea8a985d-f3d0-3c6d-958b-0d5e3790b826",
                                        "glosses": [
                                            "In an airplane, the transparent cockpit cover."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a772521c-bff9-36d1-b370-5676330e4954",
                                        "entry_id": "ea8a985d-f3d0-3c6d-958b-0d5e3790b826",
                                        "glosses": [
                                            "In a parachute, the cloth that fills with air and thus limits the falling speed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "canopy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "debbe0f2-a1bd-36b4-acb7-1b7a8dfd459d",
                                        "entry_id": "b69153a7-86f7-310b-b6f0-6479f90e2ea6",
                                        "glosses": [
                                            "To cover with or as if with a canopy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcb5fa6c-a946-4f30-94e3-ac91bd9edaf8",
                                                "sense_id": "debbe0f2-a1bd-36b4-acb7-1b7a8dfd459d",
                                                "text": "Away before me to sweet beds of flowers:\nLove-thoughts lie rich when canopied with bowers."
                                            },
                                            {
                                                "example_id": "8a4ea2cb-43ce-4066-bd45-f6b04e9036d9",
                                                "sense_id": "debbe0f2-a1bd-36b4-acb7-1b7a8dfd459d",
                                                "text": "I sat me down to watch upon a bank\nWith ivy canopied, and interwove\nWith flaunting honeysuckle […]",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            },
                                            {
                                                "example_id": "7c9191c1-3a52-4037-bb5e-e61ec7bd48aa",
                                                "sense_id": "debbe0f2-a1bd-36b4-acb7-1b7a8dfd459d",
                                                "text": "I began also to observe, with greater accuracy, the forms that surrounded me, and to perceive the boundaries of the radiant roof of light which canopied me."
                                            },
                                            {
                                                "example_id": "4577f5a5-af6c-491f-9734-1ee5d232f710",
                                                "sense_id": "debbe0f2-a1bd-36b4-acb7-1b7a8dfd459d",
                                                "text": "1850, The Madras Journal of Literature and Science, Vol. XVI, No. 38, Vepery: J.P. Bantleman, p. 366,\nThe walls of the vestibule and passage passing round the sanctuary, are covered with compartments holding high reliefs of Buddha seated on a lotus, the stem of which is grasped by two figures wearing wigs and tiaras, canopied by snakes; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f8b2970-bfdb-3155-abaa-06730b4fd697",
                                        "entry_id": "b69153a7-86f7-310b-b6f0-6479f90e2ea6",
                                        "glosses": [
                                            "To go through the canopy of a forest on a zipline."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b8d1d61-418b-4c1d-a19d-8401814dae00",
                                                "sense_id": "3f8b2970-bfdb-3155-abaa-06730b4fd697",
                                                "text": "2013, Tara Morris, “Canopying In Rio Claro,” colombiareports.com, 11 March, 2013,\nIf you’re looking for a little adventure in Colombia, look no further than canopying through Rio Claro’s lush, secluded jungle, located just five hours bus ride from either Medellin or Bogota."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81728fe7-6748-439a-9bf1-ef1fde6ee1a4",
                        "source_entry_id": "98f93783-4143-3c15-b6c6-b8e5f5a3bc8e",
                        "source_sense_id": "509b43b2-4a90-3397-a989-a0d9174b915f",
                        "source_sense_description": "stoffen overdekking als ornament, meestal boven een troon, altaar of hemelbed",
                        "target_lang_word": "baldaquin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baldaquin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac454c6e-deb6-3d2e-adb2-b2bb4d706e4d",
                                        "entry_id": "948daa26-6e4d-3ffc-933b-5726dfd3d981",
                                        "glosses": [
                                            "Dais qui sert de couronnement à un trône, à un autel, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "488bb40c-0290-4cfc-a211-62c40dd760f3",
                                                "sense_id": "ac454c6e-deb6-3d2e-adb2-b2bb4d706e4d",
                                                "text": "De là l’importance décorative donnée dans les églises baroques à la chaire, aux confessionnaux et à l’autel que surmonte un baldaquin. L’Église n’est plus comme au Moyen Age une sublimation de la Cité : elle est devenue un engin spécialisé du salut, une happeuse d’âmes."
                                            },
                                            {
                                                "example_id": "bc9170a3-e89b-4c51-b585-cca47193cf45",
                                                "sense_id": "ac454c6e-deb6-3d2e-adb2-b2bb4d706e4d",
                                                "text": "« Est-ce que j’arrive à me passer de tant de garnitures superflues, pour mener une vie plus simple ? Demandons-nous : à Noël, est-ce que je partage mon pain avec celui qui n’en a pas ? », a lancé François, s’exprimant sous le baldaquin dessiné par le Bernin, où seul le souverain pontife est autorisé à célébrer la messe. Le Monde avec AFP, « L’homme est devenu avide et vorace » : le pape plaide contre un consumérisme vide de sens, Le Monde. Mis en ligne le 25 décembre 2018"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f6db4b2-204e-3f11-b9e7-8731e724ee60",
                                        "entry_id": "948daa26-6e4d-3ffc-933b-5726dfd3d981",
                                        "glosses": [
                                            "Ciel de lit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62d2185d-3cad-4a4b-9754-67e5ab996f0f",
                                                "sense_id": "2f6db4b2-204e-3f11-b9e7-8731e724ee60",
                                                "text": "Deux couverts, avec des timbales d’argent, y étaient mis sur une petite table, au pied d’un grand lit à baldaquin revêtu d’une indienne à personnages représentant des Turcs."
                                            },
                                            {
                                                "example_id": "37f1e220-1b42-4f82-9a84-f2fc54d6635c",
                                                "sense_id": "2f6db4b2-204e-3f11-b9e7-8731e724ee60",
                                                "text": "Vous n'y pensez pas, un baldaquin Louis Xlll, familial, une valeur inestimable."
                                            },
                                            {
                                                "example_id": "4892936f-b4ef-4085-a483-6e197f7e8f30",
                                                "sense_id": "2f6db4b2-204e-3f11-b9e7-8731e724ee60",
                                                "text": "Chez lui !… Il appelait ainsi un banc qu’il avait choisi dans le square de la place d’Anvers, et sur lequel, depuis plus d’un mois, il dormait, avec la voûte d’un marronnier pour baldaquin…"
                                            },
                                            {
                                                "example_id": "6e9ee3d6-d231-430f-9f84-3aa865336a88",
                                                "sense_id": "2f6db4b2-204e-3f11-b9e7-8731e724ee60",
                                                "text": "Il pionce avec son cheval dans son lit à baldaquin, découpe ses pages en rondelles et fout carrément le feu à son bénard au « bal des Ardents » en voulant, disait-il, « allumer son tison pour les gentes demoiselles » !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
