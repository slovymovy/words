{
    "word_family": [
        "absurdity",
        "absurdism",
        "absurdist",
        "absurdly",
        "absurdness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "23e86102-ff20-3530-ac52-04e548febfa2",
                    "sense_definition": "Completely unreasonable, illogical, or inappropriate; ridiculous.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "illogical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>absurd</w> to suggest that we can finish this entire project in just one hour.",
                            "target_lang_translations": {
                                "ru": "Просто <w>абсурдно</w> предполагать, что мы сможем закончить весь этот проект всего за один час."
                            }
                        },
                        {
                            "text": "The idea of wearing a heavy winter coat in the middle of summer is simply <w>absurd</w>.",
                            "target_lang_translations": {
                                "ru": "Идея носить тяжелое зимнее пальто в середине лета просто <w>нелепа</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ridiculous",
                        "ludicrous",
                        "preposterous",
                        "nonsensical",
                        "irrational",
                        "foolish"
                    ],
                    "antonyms": [
                        "reasonable",
                        "logical",
                        "sensible"
                    ],
                    "common_phrases": [
                        "completely absurd",
                        "sounds absurd",
                        "absurd suggestion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершенно необоснованный, нелогичный или неуместный; нелепый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "абсурдный",
                                "target_lang_sense_clarification": "противоречащий здравому смыслу"
                            },
                            {
                                "target_lang_word": "нелепый",
                                "target_lang_sense_clarification": "странный и вызывающий смех"
                            },
                            {
                                "target_lang_word": "бессмысленный",
                                "target_lang_sense_clarification": "не имеющий логики"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13cac2b4-3b3f-3d1b-b6d1-514c471203f3",
                    "sense_definition": "Lacking order, value, or a rational relationship to human life; meaningless.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "meaningless",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The protagonist struggled to find purpose while living in an <w>absurd</w> universe.",
                            "target_lang_translations": {
                                "ru": "Главный герой изо всех сил пытался найти цель, живя в <w>абсурдной</w> вселенной."
                            }
                        },
                        {
                            "text": "Many modern plays explore the <w>absurd</w> nature of human existence.",
                            "target_lang_translations": {
                                "ru": "Многие современные пьесы исследуют <w>абсурдную</w> природу человеческого существования."
                            }
                        }
                    ],
                    "synonyms": [
                        "irrational",
                        "incongruous"
                    ],
                    "antonyms": [
                        "meaningful",
                        "orderly"
                    ],
                    "common_phrases": [
                        "absurd universe",
                        "absurd situation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in philosophical or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный порядка, ценности или рациональной связи с человеческой жизнью; бессмысленный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "абсурдный",
                                "target_lang_sense_clarification": "в философском смысле"
                            },
                            {
                                "target_lang_word": "иррациональный",
                                "target_lang_sense_clarification": "не поддающийся разумному объяснению"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e2d0145-493d-39fc-9f18-3fdba25f2fe0",
                    "sense_definition": "Relating to or dealing with the philosophy of absurdism.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "absurdism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author is famous for his <w>absurd</w> fiction that challenges traditional storytelling.",
                            "target_lang_translations": {
                                "ru": "Автор знаменит своей <w>абсурдистской</w> прозой, которая бросает вызов традиционному повествованию."
                            }
                        },
                        {
                            "text": "We studied <w>absurd</w> drama in our university literature course.",
                            "target_lang_translations": {
                                "ru": "Мы изучали драму <w>абсурда</w> в университетском курсе литературы."
                            }
                        }
                    ],
                    "synonyms": [
                        "farcical"
                    ],
                    "common_phrases": [
                        "absurd drama",
                        "absurd fiction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к философии абсурдизма или имеющий с ней дело."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "абсурдистский",
                                "target_lang_sense_clarification": "связанный с направлением в искусстве"
                            },
                            {
                                "target_lang_word": "абсурдный",
                                "target_lang_sense_clarification": "в контексте драмы или литературы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f43f9f5-361e-38fa-a2ab-706f80ff4748",
                    "sense_definition": "Lacking harmony; sounding harsh or unpleasant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dissonant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>absurd</w> clashing of the instruments made the music difficult to listen to.",
                            "target_lang_translations": {
                                "ru": "<w>Нелепое</w> столкновение звуков инструментов мешало слушать музыку."
                            }
                        },
                        {
                            "text": "The choir produced an <w>absurd</w> sound because they were all out of tune.",
                            "target_lang_translations": {
                                "ru": "Хор издавал <w>диссонирующий</w> звук, потому что все пели не впопад."
                            }
                        }
                    ],
                    "antonyms": [
                        "harmonious"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный гармонии; звучащий резко или неприятно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диссонирующий",
                                "target_lang_sense_clarification": "нарушающий гармонию"
                            },
                            {
                                "target_lang_word": "нелепый",
                                "target_lang_sense_clarification": "о странном, неприятном звуке"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d9089f83-a020-3250-b4b6-30727a31dbe3",
                    "sense_definition": "The conflict between the human search for meaning and the silent, meaningless universe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "meaningless",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Philosophers often write about the <w>absurd</w> and how humans should respond to it.",
                            "target_lang_translations": {
                                "ru": "Философы часто пишут об <w>абсурде</w> и о том, как люди должны на него реагировать."
                            }
                        },
                        {
                            "text": "He found a strange kind of freedom in accepting the <w>absurd</w>.",
                            "target_lang_translations": {
                                "ru": "Он нашел своего рода странную свободу в принятии <w>абсурда</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the absurd"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "philosophical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конфликт между поиском смысла человеком и безмолвной, бессмысленной вселенной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "абсурд",
                                "target_lang_sense_clarification": "философское понятие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c0438e6-658d-3819-9d32-506178b0c270",
                    "sense_definition": "A situation or statement that is an <w>absurdity</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "illogical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The legal case was full of <w>absurds</w> that made no sense to the jury.",
                            "target_lang_translations": {
                                "ru": "Судебное дело было полно <w>абсурда</w>, который не имел смысла для присяжных."
                            }
                        },
                        {
                            "text": "He pointed out the various <w>absurds</w> in the government's new policy.",
                            "target_lang_translations": {
                                "ru": "Он указал на различные <w>нелепости</w> в новой политике правительства."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ситуация или утверждение, представляющее собой нелепость."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "абсурд",
                                "target_lang_sense_clarification": "бессмыслица"
                            },
                            {
                                "target_lang_word": "нелепость",
                                "target_lang_sense_clarification": "глупость или несообразность"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}