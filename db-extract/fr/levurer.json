                ],
                "senses": [
                    {
                        "sense_id": "734946fa-cfc1-3337-9d10-0acd28499baa",
                        "entry_id": "6b934fcf-997b-32f6-860a-9692481b50e4",
                        "glosses": [
                            "Ensemencer le moût avec des levures afin de provoquer sa fermentation alcoolique et de prévenir sa madérisation (étape de la vinification et du brassage)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75621c66-2752-4e5c-b86c-f7d986f5c202",
                                "sense_id": "734946fa-cfc1-3337-9d10-0acd28499baa",
                                "text": "Un apport massif de levures de fermentation « saccharomyces cerevisiae » va occuper le terrain et empêcher les autres micro-organismes de se développer. La méthode la plus sûre est de levurer avec un levain « maison », ou un levain commercial."
                            },
                            {
                                "example_id": "39b4118b-761e-4916-a692-5168bebc63d1",
                                "sense_id": "734946fa-cfc1-3337-9d10-0acd28499baa",
                                "text": "Je n’ai pas touché au paquet de levures, laissé par l’œnologue, ni au SO2. Égrapper, levurer, sulfiter font partie des gestes que je répugne toujours à faire."
                            }
                        ]
                    }
                ],
