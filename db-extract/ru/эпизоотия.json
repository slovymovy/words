                                        "glosses": [
                                            "Infektionskrankheit bei Tieren mit besonderer rechtlicher Regelung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf699cad-aee0-4184-9d2b-49d9047496be",
                                                "sense_id": "0cae413a-236e-36e4-a7cc-e2974d1721a0",
                                                "text": "Maul- und Klauenseuche und Rinderpest sind ernstzunehmende Tierseuchen."
                                            },
                                            {
                                                "example_id": "788b9c19-e668-4682-901a-8ee36a042487",
                                                "sense_id": "0cae413a-236e-36e4-a7cc-e2974d1721a0",
                                                "text": "Tierseuchen sind nach dem Tierseuchengesetz anzeige- und meldepflichtig."
                                            }
                                        ],
