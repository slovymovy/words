                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0c8db8a-5549-4ff8-9f35-570fb1e696bc",
                        "source_entry_id": "cc94c325-d3c8-30f4-a2cc-253ba2c49e3d",
                        "source_sense_id": "52bab9df-2d28-36f3-a6a8-6f2c42f936c0",
                        "target_lang_word": "condom",
                        "target_lang_code": "en",
