                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b9e0527-c097-43e2-a946-de667d73ec50",
                        "source_entry_id": "17d4593c-2cb6-3af2-9178-4bd3411e9924",
                        "source_sense_id": "76959c85-3a5d-334e-bc97-c841915fd3c6",
                        "source_sense_description": "vervoermiddel op twee wielen, (gedeeltelijk) met de voet aangedreven",
                        "target_lang_word": "Roller",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Roller",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e68d4c61-23d9-372b-a71c-6bcce9b55da1",
                                        "entry_id": "c9ed7a52-b409-3912-9ede-7fe6e495084e",
                                        "glosses": [
                                            "Kurzform für Motorroller"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c17938f3-935f-4d1c-935a-d047475129b1",
                                                "sense_id": "e68d4c61-23d9-372b-a71c-6bcce9b55da1",
                                                "text": "„Was aber auch für den Roller als das motorisierte Zweirad schlechthin für Frauen spricht, ist seine runde, weiche, irgendwie niedliche Form.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5f0bbc45-c980-3142-84cd-3c5425ac984b",
                                        "entry_id": "c9ed7a52-b409-3912-9ede-7fe6e495084e",
                                        "glosses": [
                                            "muskelgetriebenes, zweirädriges Fahrzeug, das auf einem Trittbrett stehend benutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b459ae1-2553-485c-8359-392bf5369c56",
                                                "sense_id": "5f0bbc45-c980-3142-84cd-3c5425ac984b",
                                                "text": "„Wir sind zusammen auf der Bockenheimer Landstraße Roller gefahren.“"
                                            },
                                            {
                                                "example_id": "af69db15-dadc-4e96-ab8e-4366d8b72a28",
                                                "sense_id": "5f0bbc45-c980-3142-84cd-3c5425ac984b",
                                                "text": "„Wieso lachte er bereits, wenn ich meinen Roller aus dem Keller geholt hatte und losfuhr?“"
                                            },
                                            {
                                                "example_id": "0c384032-430c-4188-8f79-58d55bd3d054",
                                                "sense_id": "5f0bbc45-c980-3142-84cd-3c5425ac984b",
                                                "text": "„Mit dem Roller fuhr ich die Straße neben dem Haus runter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b36b3680-34f6-30f2-83de-f9f55bc1cac0",
                                        "entry_id": "c9ed7a52-b409-3912-9ede-7fe6e495084e",
                                        "glosses": [
                                            "Kurzform für Harzer Roller"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f4c8c5e-5bb4-444d-8abf-c6ca6282c9dc",
                                                "sense_id": "b36b3680-34f6-30f2-83de-f9f55bc1cac0",
                                                "text": "Der Roller stammt aus dem Harz."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f681efbe-cd3e-3fe9-a32a-dc6055221e5c",
                                        "entry_id": "c9ed7a52-b409-3912-9ede-7fe6e495084e",
                                        "glosses": [
                                            "ein Rollsprung"
                                        ],
                                        "tags": [
                                            "Leichtathletik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "900d742a-8d88-494d-8a6f-8eaee49385fc",
                                                "sense_id": "f681efbe-cd3e-3fe9-a32a-dc6055221e5c",
                                                "text": "Ein echter Roller ist ja nur einer, bei dem man die eigene Körpergröße überspringt, sagt man so."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "c2a02e71-cc77-3639-9393-b30d247f2215",
                                        "entry_id": "c9ed7a52-b409-3912-9ede-7fe6e495084e",
                                        "glosses": [
                                            "ein Schuss, der den Ball nur rollen lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00f83a1c-818e-4674-9a89-fe3180c15d61",
                                                "sense_id": "c2a02e71-cc77-3639-9393-b30d247f2215",
                                                "text": "Niemand hätte gedacht, dass es dieser Roller bis ins Tor schaffen würde."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "401b9ecb-dfbf-3435-8837-b50e6fd17847",
                                        "entry_id": "c9ed7a52-b409-3912-9ede-7fe6e495084e",
                                        "glosses": [
                                            "eine lange und hohe Welle in schwerer Brandung"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "f5352999-236c-34c5-9634-4e09b4e23f2e",
                                        "entry_id": "c9ed7a52-b409-3912-9ede-7fe6e495084e",
                                        "glosses": [
                                            "ein niedriges Transportgerät mit schwenkbaren Rollen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "369d3957-1f85-486f-9215-eedaf9546ab1",
                        "source_entry_id": "17d4593c-2cb6-3af2-9178-4bd3411e9924",
                        "source_sense_id": "76959c85-3a5d-334e-bc97-c841915fd3c6",
