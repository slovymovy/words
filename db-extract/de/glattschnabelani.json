                        "entry_id": "e977f6b6-e8bc-36b6-9ed6-d6e160560856",
                        "glosses": [
                            "in Südamerika, weiten Teilen der Karibik sowie einigen Gebieten Mittelamerikas beheimateter schwarz gefiederter, langschwänziger Vogel (Crotophaga ani) aus der Familie der Kuckucke (Cuculidae)"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "df538595-10dd-47b1-933c-b74a16340c6e",
                                "sense_id": "c980d715-171e-3261-b993-0a66a0eb37b7",
                                "text": "„Ein kleiner dunkler Vogel, eigentlich nichts Besonderes, hüpft graziös wie eine Ballerina über die breiten Blätter der Seerosen. Sein Name – Glattschnabelani – bleibt mir im Gedächtnis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
