{
    "word_family": [
        "glitter",
        "gleam",
        "glisten"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6838f927-6057-3c47-b0f2-ef5df90be5e7",
                    "sense_definition": "A short flash of light, usually when reflected off a shiny surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I saw the <w>glint</w> of metal as he raised the gun.",
                            "target_lang_translations": {
                                "zh": "当他举起枪时，我看到了金属的<w>闪光</w>。",
                                "fr": "J'ai vu l'<w>éclat</w> du métal lorsqu'il a levé l'arme."
                            }
                        },
                        {
                            "text": "The <w>glint</w> of sunlight on the water was beautiful.",
                            "target_lang_translations": {
                                "zh": "水面上阳光的<w>闪烁</w>非常美丽。",
                                "fr": "Le <w>reflet</w> du soleil sur l'eau était magnifique."
                            }
                        }
                    ],
                    "synonyms": [
                        "flash",
                        "gleam",
                        "sparkle"
                    ],
                    "common_phrases": [
                        "glint of light",
                        "metallic glint"
                    ],
                    "target_lang_definitions": {
                        "zh": "指物体表面反射出的短促闪光。",
                        "fr": "Un bref éclat de lumière, généralement produit par la réflexion sur une surface brillante."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "闪光",
                                "target_lang_sense_clarification": "指物体表面反射出的光亮。"
                            },
                            {
                                "target_lang_word": "微光",
                                "target_lang_sense_clarification": "指细微的闪烁光芒。"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "éclat",
                                "target_lang_sense_clarification": "Lumière vive et soudaine."
                            },
                            {
                                "target_lang_word": "reflet",
                                "target_lang_sense_clarification": "Lumière renvoyée par une surface."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b17ad670-6a7d-31ef-bf2e-0d2047f526e1",
                    "sense_definition": "A brief look; a glance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave a quick <w>glint</w> at the clock before leaving the room.",
                            "target_lang_translations": {
                                "zh": "他在离开房间前向时钟<w>瞥</w>了一眼。",
                                "fr": "Il a jeté un <w>coup d'œil</w> rapide à l'horloge avant de quitter la pièce."
                            }
                        },
                        {
                            "text": "She cast a <w>glint</w> at the stranger to see if he was watching.",
                            "target_lang_translations": {
                                "zh": "她向那个陌生人<w>瞥</w>了一眼，看看他是否在注视着自己。",
                                "fr": "Elle a jeté un <w>coup d'œil</w> à l'inconnu pour voir s'il regardait."
                            }
                        }
                    ],
                    "synonyms": [
                        "glance",
                        "look"
                    ],
                    "common_phrases": [
                        "cast a glint"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This sense is archaic or dialectal in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "匆匆一瞥；扫视。",
                        "fr": "Un regard rapide ou furtif."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "一瞥",
                                "target_lang_sense_clarification": "指快速地看一眼。"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "coup d'œil",
                                "target_lang_sense_clarification": "Regard rapide."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "732feef7-af87-3fd8-ab99-607a0e47110d",
                    "sense_definition": "To flash or gleam briefly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A wedding ring <w>glinted</w> on her finger.",
                            "target_lang_translations": {
                                "zh": "她手指上的结婚戒指在<w>闪烁</w>。",
                                "fr": "Une alliance <w>brillait</w> à son doigt."
                            }
                        },
                        {
                            "text": "The stars <w>glinted</w> in the dark night sky.",
                            "target_lang_translations": {
                                "zh": "星星在漆黑的夜空中<w>闪耀</w>。",
                                "fr": "Les étoiles <w>scintillaient</w> dans le ciel nocturne sombre."
                            }
                        }
                    ],
                    "synonyms": [
                        "flash",
                        "gleam",
                        "sparkle"
                    ],
                    "common_phrases": [
                        "glint in the sun"
                    ],
                    "target_lang_definitions": {
                        "zh": "发出短促的闪光或微光。",
                        "fr": "Briller brièvement ou émettre un éclat."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "闪烁",
                                "target_lang_sense_clarification": "指光亮忽明忽暗。"
                            },
                            {
                                "target_lang_word": "闪耀",
                                "target_lang_sense_clarification": "指发出光芒。"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "briller",
                                "target_lang_sense_clarification": "Émettre de la lumière."
                            },
                            {
                                "target_lang_word": "scintiller",
                                "target_lang_sense_clarification": "Briller par intermittence."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58789c1c-e3b9-3fd7-8f4a-f6807afa9350",
                    "sense_definition": "To cause to flash or gleam; to reflect.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The polished surface <w>glinted</w> a bright reflection into the room.",
                            "target_lang_translations": {
                                "zh": "抛光的表面将一道明亮的光<w>反射</w>进房间里。",
                                "fr": "La surface polie <w>reflétait</w> une lumière vive dans la pièce."
                            }
                        },
                        {
                            "text": "The mirror <w>glinted</w> the light across the wall.",
                            "target_lang_translations": {
                                "zh": "镜子将光线<w>反射</w>到墙上。",
                                "fr": "Le miroir <w>reflétait</w> la lumière sur le mur."
                            }
                        }
                    ],
                    "synonyms": [
                        "reflect"
                    ],
                    "target_lang_definitions": {
                        "zh": "使发出闪光；反射光线。",
                        "fr": "Renvoyer une lumière vive ou un éclat."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "反射",
                                "target_lang_sense_clarification": "指光线投射到物体表面后折回。"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "refléter",
                                "target_lang_sense_clarification": "Renvoyer la lumière."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4dc5419-83e2-3e6a-a6ed-51f534cd4057",
                    "sense_definition": "To glance; to peep forth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sun was <w>glinting</w> through the morning clouds.",
                            "target_lang_translations": {
                                "zh": "阳光正透过晨云<w>闪烁</w>。",
                                "fr": "Le soleil <w>brillait</w> à travers les nuages du matin."
                            }
                        },
                        {
                            "text": "He stopped to <w>glint</w> at the flowers in the garden.",
                            "target_lang_translations": {
                                "zh": "他停下来<w>窥视</w>花园里的花朵。",
                                "fr": "Il s'est arrêté pour <w>jeter un coup d'œil</w> aux fleurs dans le jardin."
                            }
                        }
                    ],
                    "synonyms": [
                        "glance",
                        "peep"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in literary or older contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "瞥见；窥视。",
                        "fr": "Regarder furtivement ou apparaître brièvement."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "窥视",
                                "target_lang_sense_clarification": "指从缝隙或隐蔽处看。"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "jeter un coup d'œil",
                                "target_lang_sense_clarification": "Regarder rapidement."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d291893a-7fcb-39df-a2cd-2150b1638252",
                    "sense_definition": "To dry; to wither.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The intense heat began to <w>glint</w> the crops in the field.",
                            "target_lang_translations": {
                                "zh": "酷热开始使田里的庄稼<w>枯萎</w>。",
                                "fr": "La chaleur intense a commencé à <w>flétrir</w> les récoltes dans le champ."
                            }
                        },
                        {
                            "text": "The summer sun <w>glinted</w> the grass until it turned brown.",
                            "target_lang_translations": {
                                "zh": "夏日的阳光将草地晒得<w>枯萎</w>，直到它们变成褐色。",
                                "fr": "Le soleil d'été a <w>desséché</w> l'herbe jusqu'à ce qu'elle devienne brune."
                            }
                        }
                    ],
                    "synonyms": [
                        "wither",
                        "dry"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使干燥；使枯萎。",
                        "fr": "Dessécher ou flétrir sous l'effet de la chaleur."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "枯萎",
                                "target_lang_sense_clarification": "指植物因缺水而干枯。"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "flétrir",
                                "target_lang_sense_clarification": "Perdre sa fraîcheur."
                            },
                            {
                                "target_lang_word": "dessécher",
                                "target_lang_sense_clarification": "Rendre sec."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a51e5e2e-68c5-33cd-8375-9d8584119dc8",
                    "sense_definition": "Not sharp; dull.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old kitchen knife is <w>glint</w>.",
                            "target_lang_translations": {
                                "zh": "那把旧菜刀已经<w>钝</w>了。",
                                "fr": "Le vieux couteau de cuisine est <w>émoussé</w>."
                            }
                        },
                        {
                            "text": "After years of use, the blade became <w>glint</w>.",
                            "target_lang_translations": {
                                "zh": "经过多年的使用，刀刃变得<w>钝</w>了。",
                                "fr": "Après des années d'utilisation, la lame est devenue <w>émoussée</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dull",
                        "blunt"
                    ],
                    "antonyms": [
                        "sharp"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "This usage is no longer standard."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "不锋利；钝。",
                        "fr": "Qui n'est pas tranchant ; émoussé."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "钝",
                                "target_lang_sense_clarification": "指刀刃不锋利。"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "émoussé",
                                "target_lang_sense_clarification": "Qui a perdu son tranchant."
                            },
                            {
                                "target_lang_word": "mousse",
                                "target_lang_sense_clarification": "Qui ne coupe pas."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}