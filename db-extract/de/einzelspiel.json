                        ],
                        "form": "die Einzelspiele"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a29ce793-f54c-3918-8e1f-b706de7a7a46",
                        "entry_id": "77b76137-63ce-3502-86e0-24d993bc10b1",
                        "glosses": [
                            "Alleinspiel, spielerische Aktivität einer einzigen Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97d12a58-eb67-4669-97b5-b4a89e89e504",
                                "sense_id": "a29ce793-f54c-3918-8e1f-b706de7a7a46",
                                "text": "„Bevor es zum koordinierten Sozialspiel kommt, kann man als häufige Form eine Zwischenform zwischen Einzelspiel und Sozialspiel beobachten, das Parallelspiel.“"
                            },
                            {
                                "example_id": "9d2cc111-f86a-4b05-8972-0908e50f6857",
                                "sense_id": "a29ce793-f54c-3918-8e1f-b706de7a7a46",
                                "text": "„Der Spielausgang wird im Einzelspiel insgesamt nur durch den Zufall beeinflusst, wenn der Spieler an der Kandidatenauswahl scheitert.“"
                            },
                            {
                                "example_id": "dc774909-c624-4315-bf08-a5b996f5278b",
                                "sense_id": "a29ce793-f54c-3918-8e1f-b706de7a7a46",
                                "text": "„Viele Brett-, Gedulds- und Einzelspiele liegen dort bereit; es wird auch – unter Anleitung der beiden Freizeithelfer Moni und Schorsch – gebastelt.“"
                            },
                            {
                                "example_id": "9d139170-7145-4cf4-b5ef-8e3d564314f4",
                                "sense_id": "a29ce793-f54c-3918-8e1f-b706de7a7a46",
                                "text": "„Der Spieler ist dann ein alter Schwanzer, oder er hat, wie es besonders Fritz Klein immer so schön sagt, zu lange getändelt, sich in wenig ergiebigem Einzelspiel oder in nutzloser Ballartistik versucht.“"
                            },
                            {
                                "example_id": "508e00fd-89cd-489f-b80a-8c1ae98af273",
                                "sense_id": "a29ce793-f54c-3918-8e1f-b706de7a7a46",
                                "text": "„Einzelspiele wird man schneller leid als Zweierspiele.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "15c7d938-92f7-3e2e-b180-d2dcdcea6a33",
                        "entry_id": "77b76137-63ce-3502-86e0-24d993bc10b1",
                        "glosses": [
                            "ein Spiel aus einer Reihe weiterer Spiele"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4effc295-7fe8-4d5b-88f9-d937f97eedba",
                                "sense_id": "15c7d938-92f7-3e2e-b180-d2dcdcea6a33",
                                "text": "„Nach dem 3 : 0-Stand, der den Endsieg bereits sicherte, gingen die beiden letzten Einzelspiele verloren.“"
                            },
                            {
                                "example_id": "2c0548c0-53a0-4e99-9f1a-11b8e9de87f0",
                                "sense_id": "15c7d938-92f7-3e2e-b180-d2dcdcea6a33",
                                "text": "„Das Sportradio überträgt alle 612 Begegnungen der Bundesliga und 2. Liga live als Einzelspiel oder in der Konferenz.“"
                            },
                            {
                                "example_id": "cdaa429b-cb34-42a7-b7c8-3485aa624fbc",
                                "sense_id": "15c7d938-92f7-3e2e-b180-d2dcdcea6a33",
                                "text": "„Mit dem Blick des geübten Regisseurs erkennt er die vorzüglichen Leistungen in der Massenregie wie im Einzelspiel.“"
                            },
                            {
                                "example_id": "8211e445-7b43-484a-a7c2-e165994339fe",
                                "sense_id": "15c7d938-92f7-3e2e-b180-d2dcdcea6a33",
                                "text": "„Sämtliche Sonder- und Einzelspiele aufzuzeichnen sei gar nicht nötig, meint Dirk Lamprecht, Sprecher des größten Dachverbandes der deutschen Automatenwirtschaft, in dem auch Löwen und Gauselmann vertreten sind.“"
                            },
                            {
                                "example_id": "2990b6a4-a8f6-4e28-96cc-777e791e1230",
                                "sense_id": "15c7d938-92f7-3e2e-b180-d2dcdcea6a33",
                                "text": "„Das Sportradio überträgt alle 612 Begegnungen der Bundesliga und 2. Liga live als Einzelspiel oder in der Konferenz.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "875a8e19-8b0d-37bb-a80e-c690c3eaee9d",
                        "entry_id": "77b76137-63ce-3502-86e0-24d993bc10b1",
                        "glosses": [
                            "Einzel, Spielart, bei der ein einzelner Spieler gegen einen anderen spielt, etwa beim Tennis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da8ed715-f9a2-40e0-bc56-32892477f1cb",
                                "sense_id": "875a8e19-8b0d-37bb-a80e-c690c3eaee9d",
                                "text": "„Derweil verlor die 45-jährige Martina Navratilova (USA) ihr erstes Einzelspiel seit zehn Jahren in Paris gegen die 28 Jahre jüngere Argentinierin Gisela Dulko 1:6, 3:6.“"
                            },
                            {
                                "example_id": "f0a466f1-6513-4f99-bbab-dc24b6b44a26",
                                "sense_id": "875a8e19-8b0d-37bb-a80e-c690c3eaee9d",
                                "text": "„Die Gäste lagen zwar nach den Auftaktdoppeln schnell 2:0 in Führung, hatten aber in den Einzelspielen mehr Mühe als erwartet.“"
                            },
                            {
                                "example_id": "060c7c2a-a77d-42f6-962a-2989c3526d39",
                                "sense_id": "875a8e19-8b0d-37bb-a80e-c690c3eaee9d",
                                "text": "„Exakt 100 Tage hatte Steffi Graf kein Einzelspiel mehr bestritten, seitdem die schmerzende Patellasehne sie beim Turnier in Tokio zur vorzeitigen Aufgabe zwang.“"
                            },
                            {
                                "example_id": "9fd97cca-0a01-4487-a48f-67f62564cff3",
                                "sense_id": "875a8e19-8b0d-37bb-a80e-c690c3eaee9d",
                                "text": "„Die anderen beiden Doppel sowie alle Einzelspiele wurden klar gewonnen.“"
                            },
                            {
                                "example_id": "e760a1f0-eb65-4b0f-a05a-64e00ff49078",
                                "sense_id": "875a8e19-8b0d-37bb-a80e-c690c3eaee9d",
                                "text": "„Die als neue Nummer eins verpflichtete Chinesin verlor dagegen ihre beiden Einzelspiele.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
