                                            {
                                                "example_id": "230dd112-7ff8-49b8-b382-7654069edde4",
                                                "sense_id": "e9fca607-4a0f-3954-a6cb-1a3ad1666792",
                                                "text": "A single slice of this could leave you supine in front of the Queen's speech without even the wherewithal to reach for the remote control."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52aa3ad8-7ca5-3b69-9f56-c03e0e29b376",
                                        "entry_id": "1a5c2404-53e8-3018-9239-55524d2164f8",
                                        "glosses": [
                                            "A means of operating a device from a distance."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f16648b-7a63-4085-bbbc-56f1a6c39d6f",
                                                "sense_id": "52aa3ad8-7ca5-3b69-9f56-c03e0e29b376",
                                                "text": "The bomb was detonated by remote control."
                                            }
                                        ]
                                    }
                                ]
                            }
