                "forms": [],
                "senses": [
                    {
                        "sense_id": "83540852-9d6d-3c15-a03b-e4b455153441",
                        "entry_id": "4c8cee35-366d-3f91-8738-134a12e4f389",
                        "glosses": [
                            "A second helping of food for one person, or refill of coffee or other drink."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "54c65489-d6f8-4d28-a53f-ecfc3eb3cd9a",
                                "sense_id": "83540852-9d6d-3c15-a03b-e4b455153441",
                                "text": "There is plenty of pie left, if you have room for seconds."
                            },
                            {
                                "example_id": "97f1750b-a6b5-4264-a2f8-a2479035ceba",
                                "sense_id": "83540852-9d6d-3c15-a03b-e4b455153441",
                                "text": "Everybody helped themselves to seconds and Meren even went for thirds. He had always been partial to good food."
                            }
                        ]
                    },
                    {
                        "sense_id": "8fe501e1-9b59-35e5-a7f3-4b57ffcd41fa",
                        "entry_id": "4c8cee35-366d-3f91-8738-134a12e4f389",
                        "glosses": [
                            "An item of clothing that has failed quality control and is sold at a discount"
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "02bc4f90-e0c7-47d7-a0ea-85cc9ace20b7",
                                "sense_id": "8fe501e1-9b59-35e5-a7f3-4b57ffcd41fa",
                                "text": "It was marked as seconds, but I can't find anything wrong with it."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1adc8c1-47a4-37a2-a69a-e0b569533ea8",
                        "entry_id": "4c8cee35-366d-3f91-8738-134a12e4f389",
                        "glosses": [
                            "Any article of merchandise of a grade inferior to the best; especially, a coarse or inferior kind of flour."
                        ],
                        "tags": [
