    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "309f407b-1974-3691-a2f6-bed03f7f0444",
                "word": "Funj",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1ca187e7-f3c3-37dc-b85d-9ed3b997e547",
                        "entry_id": "309f407b-1974-3691-a2f6-bed03f7f0444",
                        "glosses": [
                            "An ethnic group in present-day Sudan from which the historical Funj Sultanate arose; the sultanate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "914493b2-b897-498c-b1cb-f2d9ac011a16",
                                "sense_id": "1ca187e7-f3c3-37dc-b85d-9ed3b997e547",
                                "text": "It is known that the Funj rose from southern Nubia (present-day southern Sudan) to overthrow the kingdom of Alodia, but their origins before that remain obscure and disputed. The Funj themselves claimed descent from the Umayyad dynasty through those who escaped slaughter at the hands of the Abbasids and fled to Abyssinia. A currently more accepted theory is that they are Nubians who mixed with Arabs."
                            },
                            {
                                "example_id": "ae92d51e-8577-4679-bc9f-596f47d9bff0",
                                "sense_id": "1ca187e7-f3c3-37dc-b85d-9ed3b997e547",
                                "text": "It is possibly the jabalawīn′s own identification with Sinnār, a suitable answer for groups who appear to have lost their own cultural identity as a scattered minority in the midst of society, that makes them often become associated with the Funj in present-day local traditions."
                            },
                            {
                                "example_id": "8aa330b5-752d-43b0-bfc2-5129002d935a",
                                "sense_id": "1ca187e7-f3c3-37dc-b85d-9ed3b997e547",
                                "text": "The plains of Kordofan proper did not fall to the Funj until the reign of Bādi IV Abū Shūlūkh (reigned 1724–62)."
                            },
                            {
                                "example_id": "3e7107e8-525e-41d8-8618-7c195927f20d",
                                "sense_id": "1ca187e7-f3c3-37dc-b85d-9ed3b997e547",
                                "text": "2014, Anders Breidlid, et al. (editors), A Concise History of South Sudan, Fountain Publishers, Revised Edition, page 52,\nSlavery was the cornerstone of Funj wealth and power. In the 18ᵗʰ century, the Funj rulers built up a military division of slaves from foreign lands who were loyal only to themselves. By the mid 18ᵗʰ century, these Funj rulers were very powerful."
                            }
                        ]
                    }
                ],
