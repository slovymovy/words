                        "form": "succubes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d0196243-fb96-3ea2-a4ca-9a913eb96100",
                        "entry_id": "4f936529-ad3f-31c9-be09-ae38823f4310",
                        "glosses": [
                            "Démon qui, suivant l’opinion populaire, prend l’apparence d’une femme et est censé apparaître la nuit pour abuser sexuellement d’un homme pendant son sommeil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "085078c4-7944-415e-a990-bc8e004b0682",
                                "sense_id": "d0196243-fb96-3ea2-a4ca-9a913eb96100",
                                "text": "Sa bouche était grande. Mais sans cette gloutonnerie de succube que se donnent les stars."
                            },
                            {
                                "example_id": "dd5b9cb5-7230-4b8b-9c70-ab20086fe360",
                                "sense_id": "d0196243-fb96-3ea2-a4ca-9a913eb96100",
                                "text": "— Ah, Méridiana, perle de mes bataillons de succubes ! Tu daignes enfin nous rejoindre, se réjouit le Maître comme la belle démone s’avançait."
                            },
                            {
                                "example_id": "39af53c0-bd77-4599-9cc2-c5afb7130c33",
                                "sense_id": "d0196243-fb96-3ea2-a4ca-9a913eb96100",
                                "text": "Elle dormait la tête renversée, un de ses pieds refoulant ses couvertures, comme la succube au-dessus de laquelle le rêve bat des ailes."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0bc5a42-3a6e-3dfd-84a7-0b8eac056dff",
                        "entry_id": "4f936529-ad3f-31c9-be09-ae38823f4310",
                        "glosses": [
                            "Insulte à connotation religieuse."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "f0856784-ad9e-418d-ad95-4bb87aaa7759",
                                "sense_id": "b0bc5a42-3a6e-3dfd-84a7-0b8eac056dff",
                                "text": "– Honte à toi! Lâche! Succube! Menteuse! Parjure!"
                            }
                        ]
                    },
                    {
                        "sense_id": "82b6b5c2-2a36-3643-a9e3-39c13577e2ed",
                        "entry_id": "4f936529-ad3f-31c9-be09-ae38823f4310",
                        "glosses": [
                            "Dans le jeu Donjons et Dragons, un démon avec un pouvoir de métamorphose."
                        ],
                        "tags": [
                            "Fantastique"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a72d18ab-c52e-3e31-af10-457295443cd9",
                        "entry_id": "4f936529-ad3f-31c9-be09-ae38823f4310",
                        "glosses": [
                            "Bottomhttps://fr.wikisource.org/wiki/Dictionnaire_%C3%A9rotique_moderne."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af25e72d-e490-4250-bd12-fe55bec0a752",
                        "source_entry_id": "4f936529-ad3f-31c9-be09-ae38823f4310",
                        "target_lang_word": "Sukkubus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sukkubus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2559f163-6244-3f60-933d-d02175ebdcda",
                                        "entry_id": "d2b33780-be10-30e3-a2f1-5ac6b6e53187",
                                        "glosses": [
                                            "weiblicher Dämon, der Männer nachts zu sexuellen Handlungen zwingt und ihre Seelen aussaugt"
                                        ],
                                        "tags": [
                                            "mittelalterliche Volksglaube"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd56ba59-cab3-4f8b-b082-b476b366959e",
                                                "sense_id": "2559f163-6244-3f60-933d-d02175ebdcda",
                                                "text": "„Besonders aber staunte Giovanni über die Lehre von den Inkuben und Sukkuben, den doppelgeschlechtlichen Teufeln, die willkürlich männliche oder weibliche Gestalt annehmen, um die Menschen zu verführen und mit ihnen in fleischlichen Verkehr zu treten.“"
                                            },
                                            {
                                                "example_id": "4ed904f0-8abb-4a6b-ab45-1c3a466ffad3",
                                                "sense_id": "2559f163-6244-3f60-933d-d02175ebdcda",
                                                "text": "„Die Natur hier ist mit ihrer Hütte aus Papiermaché und den Tannen aus grünbemaltem Holz sehr viel künstlicher als alle Kunststücke des Dichters, der uns hier nicht zu überzeugen vermag, was ihm doch so gut mit seinen unheilvollen Zaubereien, den Reflexen, die aus dem Spiegel treten, und den klavierspielenden Sukkuben gelingt.“"
                                            },
                                            {
                                                "example_id": "f702009d-0872-4ebc-a061-19dcf94120d0",
                                                "sense_id": "2559f163-6244-3f60-933d-d02175ebdcda",
                                                "text": "„Mit enormer Willenanstrengung, die Schweißperlen auf sein Gesicht und seine Stirn treten ließ, gelang es ihm, den Bann zu brechen, der seine Seele wie ein geschlechtsloser Sukkubus in eitriger Umarmung hielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c078c6a-fb81-4ec3-885c-7e8cf671ef04",
                        "source_entry_id": "4f936529-ad3f-31c9-be09-ae38823f4310",
