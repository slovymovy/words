                    }
                ],
                "senses": [
                    {
                        "sense_id": "5a77a819-669c-32c0-bc32-27ea54c82e94",
                        "entry_id": "6b02f75e-b89f-343d-ad7b-a20bd387383b",
                        "glosses": [
                            "устар. домашний халат"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b058e29-5275-44d4-80f9-76c67c45b7c5",
                                "sense_id": "5a77a819-669c-32c0-bc32-27ea54c82e94",
                                "text": "Он большой хлебосол и балагур; живёт, как говорится, в своё удовольствие; зиму и лето ходит в полосатом шлафроке на вате."
                            },
                            {
                                "example_id": "961b85a3-43a5-4612-961e-4879e543353b",
                                "sense_id": "5a77a819-669c-32c0-bc32-27ea54c82e94",
                                "text": "Он слушал молча, поникнув головой, и играл кистью своего шлафрока."
                            },
                            {
                                "example_id": "a9d1621a-642f-423d-8fc0-8e9fca7e1f6b",
                                "sense_id": "5a77a819-669c-32c0-bc32-27ea54c82e94",
                                "text": "С лица беспечность переходила в позы всего тела, даже в складки шлафрока."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b0119eb-399c-47c7-a7d7-12c22436cbc8",
                        "source_entry_id": "6b02f75e-b89f-343d-ad7b-a20bd387383b",
                        "source_sense_id": "5a77a819-669c-32c0-bc32-27ea54c82e94",
                        "target_lang_word": "Schlafrock",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlafrock",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbd9db22-f819-379a-b3ce-37c890269d4a",
                                        "entry_id": "05d94b51-f968-354f-af55-5e11752d123a",
                                        "glosses": [
                                            "einteiliges Bekleidungsstück, das nach dem Aufstehen getragen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe320304-d9a0-460b-a8f7-0912ac78e1b7",
                                                "sense_id": "cbd9db22-f819-379a-b3ce-37c890269d4a",
                                                "text": "„Er trug ein rotes Samtkäppchen mit grüner Hahnenfeder, einen Schlafrock von Maulwurfsfellen, eine hirschlederne Hose und spitze Pantoffeln von Krokodilshaut.“"
                                            },
                                            {
                                                "example_id": "31a4ee6d-0193-4963-ac5a-9a0b1265f715",
                                                "sense_id": "cbd9db22-f819-379a-b3ce-37c890269d4a",
                                                "text": "„Morgens mußte ich seinen persischen Schlafrock überwerfen und abends in schwarzem Pagenkostüm durchs Zimmer gehn; an Hals, an Knien und Ärmeln weiße Spitzenaufschläge.“"
                                            },
                                            {
                                                "example_id": "84ee11ae-2073-4b5f-b584-815ce7a1daee",
                                                "sense_id": "cbd9db22-f819-379a-b3ce-37c890269d4a",
                                                "text": "„Dann erhebt er sich vor der ganzen Gesellschaft aus dem Bette, zieht die Pantoffeln und den ihm vom Großkämmerer und vom ersten Kammer-Edelmann gereichten Schlafrock an und setzt sich auf den Ankleide-Sessel.“"
                                            },
                                            {
                                                "example_id": "4691591d-2ede-4fa3-9dfe-4b5080c6d457",
                                                "sense_id": "cbd9db22-f819-379a-b3ce-37c890269d4a",
                                                "text": "„Im Schlafrock strebte er eiligen Schrittes dem Rhein zu.“"
                                            },
                                            {
                                                "example_id": "344fe900-2cb3-4d43-9fcb-358e48b146ee",
                                                "sense_id": "cbd9db22-f819-379a-b3ce-37c890269d4a",
                                                "text": "„In Schlafrock und Nachtmütze legte ich mich an den Platz, den Eleonora gerade verlassen hatte, und deckte mich bis zum Hals zu; sie lachte, während mein Herz klopfte und mein Verstand sich als unfähig erkannte, diesem Streich einen scherzhaften Anstrich zu geben, der allein ihn mit dem Mantel der Unschuld verhüllen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
