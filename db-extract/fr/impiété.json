        "fr-extract.jsonl": [
            {
                "entry_id": "400ff479-4dc6-32b9-a895-2fa6aeb4fffd",
                "word": "impiété",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3211f4b0-2b14-42bd-9f9c-88afd78fa91c",
                        "entry_id": "400ff479-4dc6-32b9-a895-2fa6aeb4fffd",
                        "tags": [
                            "plural"
                        ],
                        "form": "impiétés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "08c791c2-d0f9-3ab9-903d-cd56f38bbbf8",
                        "entry_id": "400ff479-4dc6-32b9-a895-2fa6aeb4fffd",
                        "glosses": [
                            "Mépris pour les choses de la religion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e7a964d-b5a0-4a76-89dc-f3db55ccacf4",
                                "sense_id": "08c791c2-d0f9-3ab9-903d-cd56f38bbbf8",
                                "text": "J’entends crier de toute part à l’impiété. Le chrétien est impie en Asie, le musulman en Europe, le papiste à Londres, le calviniste à Paris, le janséniste au haut de la rue Saint-Jacques, le moliniste au fond du faubourg Saint-Médard. Qu’est-ce donc qu’un impie ? Tout le monde l’est-il, ou personne ?"
                            },
                            {
                                "example_id": "9937ccd7-8c35-4dd9-aaf4-67216afcadf5",
                                "sense_id": "08c791c2-d0f9-3ab9-903d-cd56f38bbbf8",
                                "text": "En voyant ses mauvais mœurs, ses goûts épicuriens, l’impiété même dont il faisait profession ouverte, sauf à s'en défendre tant bien que mal, soupçonnerait-on que Costar était d'église ?"
                            },
                            {
                                "example_id": "efa48ac3-ef96-4ec0-9940-6dcd065b0a59",
                                "sense_id": "08c791c2-d0f9-3ab9-903d-cd56f38bbbf8",
                                "text": "Tout le monde étant d'accord pour me désigner nettement sous le nom de scepticisme, d'impiété ou de laïcisme l'esprit dominant du département, tout le monde aussi, on l'a vu, reconnaît son esprit de progrès."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b7ac47f-6b72-3077-85ad-5fd421c75eeb",
                        "entry_id": "400ff479-4dc6-32b9-a895-2fa6aeb4fffd",
                        "glosses": [
                            "Action, parole, sentiment qui dénote du mépris pour la religion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f7fbfb0-3de2-4447-bdad-b30aa41970f5",
                                "sense_id": "1b7ac47f-6b72-3077-85ad-5fd421c75eeb",
                                "text": "Commettre des impiétés."
                            },
                            {
                                "example_id": "9178dce8-127d-4dfa-85f8-bd221e2aae5c",
                                "sense_id": "1b7ac47f-6b72-3077-85ad-5fd421c75eeb",
                                "text": "Dire des impiétés."
                            },
                            {
                                "example_id": "5f98a0ce-64c3-4736-804f-4972e2dc82b2",
                                "sense_id": "1b7ac47f-6b72-3077-85ad-5fd421c75eeb",
                                "text": "Cet ouvrage renferme des impiétés."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a97b2e8-72f7-3723-ace5-cbfa030ccc9f",
                        "entry_id": "400ff479-4dc6-32b9-a895-2fa6aeb4fffd",
                        "glosses": [
                            "Mépris pour des sentiments universellement respectés."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "427683db-13a4-4860-b7d1-5e52a5472a45",
                                "sense_id": "7a97b2e8-72f7-3723-ace5-cbfa030ccc9f",
                                "text": "Sa conduite à l’égard de son père fut une impiété."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e0fe62c1-3ec9-4f1a-990c-cb5b2c71fddc",
                        "source_entry_id": "400ff479-4dc6-32b9-a895-2fa6aeb4fffd",
                        "target_lang_word": "profanity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "profanity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "face2857-582c-3060-97bd-ea11491d0358",
                                        "entry_id": "d9ed9e0d-ba26-3f71-bde8-5f4591733e77",
                                        "glosses": [
                                            "The quality of being profane; quality of irreverence, of treating sacred things with contempt."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76cc6980-832c-4b2a-9c39-41edab25fe0f",
                                                "sense_id": "face2857-582c-3060-97bd-ea11491d0358",
                                                "text": "The overwhelming power of his imagination led him to contemplate acts of impiety and profanity, and to a vivid realisation of the dangers these involved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "012545b2-d338-3302-8e15-955b37b12694",
                                        "entry_id": "d9ed9e0d-ba26-3f71-bde8-5f4591733e77",
                                        "glosses": [
                                            "Obscene, lewd or abusive language."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d58ebb08-808f-4bcb-b845-8808958c475f",
                                                "sense_id": "012545b2-d338-3302-8e15-955b37b12694",
                                                "text": "He ran up and down the street screaming profanities like a madman."
                                            },
                                            {
                                                "example_id": "6a827943-b340-4869-bad1-a5b489d2ea41",
                                                "sense_id": "012545b2-d338-3302-8e15-955b37b12694",
                                                "text": "Swearing doesn't just mean what we now understand by \"dirty words\". It is entwined, in social and linguistic history, with the other sort of swearing: vows and oaths. Consider for a moment the origins of almost any word we have for bad language – \"profanity\", \"curses\", \"oaths\" and \"swearing\" itself."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
