                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a9c5392-94a6-4a2c-a3d4-3bbffc17fb5e",
                        "source_entry_id": "fec3e3cd-59e2-3168-beb2-188936944550",
                        "source_sense_id": "e2ce6461-9560-3229-a9ed-d86e366fb763",
                        "target_lang_word": "napalm",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "napalm",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa574db7-a89c-3278-9bdb-29105197809e",
                                        "entry_id": "a666358b-9b62-300c-84a4-043b962a0c4b",
                                        "glosses": [
                                            "Substance à base d’essence gélifiée, habituellement utilisée dans les bombes incendiaires durant les guerres."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b9651db-91c0-4f8f-b824-5395610cd651",
                                                "sense_id": "fa574db7-a89c-3278-9bdb-29105197809e",
                                                "text": "Elle jeta alors un vif regard à bâbord, comme pour s’assurer que les rameurs ne verraient pas ce qu’elle avait résolu de faire et, leur tournant le dos, déboutonna son chemisier, offrant à mon regard deux seins hauts, bruns, fermes, et, sous le gauche, une terrible et profonde entaille calcinée qui balafrait son torse, prononçant à la coréenne un seul mot universel : napalm."
                                            },
                                            {
                                                "example_id": "7b3bc788-8731-424c-9e2c-2b2199200a84",
                                                "sense_id": "fa574db7-a89c-3278-9bdb-29105197809e",
                                                "text": "Cette guerre qu'on voit à la télé, Hélène, et la photo de la petite fille brûlée au napalm par ces impérialistes d'Américains, tu t'en souviens?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f1244bb-6e1b-4d52-a261-8ec30fd948d5",
                        "source_entry_id": "fec3e3cd-59e2-3168-beb2-188936944550",
