                "senses": [
                    {
                        "sense_id": "c86b704a-c6b1-32b1-a405-b6cc0d66d976",
                        "entry_id": "6c349820-0606-3751-bec7-d8f69e4f3940",
                        "glosses": [
                            "Brot"
                        ],
