                ],
                "senses": [
                    {
                        "sense_id": "317e7ef5-27fa-348c-b848-28c1c091265e",
                        "entry_id": "e57d75c5-e2dd-3044-922a-3238203a18ec",
                        "glosses": [
                            "sehr ernste Lage, die das Leben von Menschen gefährdet und auf Erkrankungen/Infektionen zurückzuführen ist (oder darauf beruht, dass das Gesundheitswesen seinen Aufgaben nicht (mehr) nachkommen kann)"
                        ],
                        "tags": [
                            "von offizieller Stelle so bezeichnet"
                        ],
                        "examples": [
                            {
                                "example_id": "81eb1c1f-5a34-4942-a057-7a9b4fd63e82",
                                "sense_id": "317e7ef5-27fa-348c-b848-28c1c091265e",
                                "text": "„Rechtsexpertinnen und -experten der Universität Passau wollen Optionen für ein zusammenhängendes Regelwerk aufzeigen und Vorschläge für einen umfassenden Rechtsrahmen für den Fall eines Gesundheitsnotstands wie der durch das Coronavirus SARS-CoV-2 ausgelösten Pandemie entwickeln. “"
                            },
                            {
                                "example_id": "0390bca3-9ef9-4f6b-a8ab-fa0707567c7f",
                                "sense_id": "317e7ef5-27fa-348c-b848-28c1c091265e",
                                "text": "„Der Internationale Gesundheitsnotstand ist eine formal erklärte Notlage, die von der Weltgesundheitsorganisation (WHO) ausgerufen wird. Sie tritt ein, wenn die internationale Verbreitung einer Krankheit ein Risiko für die öffentliche Gesundheit in mehreren Staaten darstellt und eine internationale Koordination notwendig ist.“"
                            },
                            {
                                "example_id": "de1715e1-63d4-476f-8429-66c5f5c4c1d9",
                                "sense_id": "317e7ef5-27fa-348c-b848-28c1c091265e",
                                "text": "Im Falle von Naturkatastrophen, Gesundheitsnotständen und Lebensmittelmangel können die regionalen Entscheider autark handeln."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
