                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1403cf58-c3e7-42c7-b04c-7dea75e0d53d",
                                "sense_id": "39f2205c-d55c-3dc3-a92d-1eaa385f2c07",
                                "text": "Das Gehalt kommt pünktlich zum 1. des Monats aufs Konto und ist mein monatliches Einkommen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "65175a2a-6c47-39b8-b57f-437d03fb14c7",
                        "entry_id": "908b0cb7-8dab-3a17-a765-6e85b49351f6",
                        "glosses": [
                            "Vergütung im Sinne von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1ef9d0e-7e05-4837-9b22-8cc78315ceb1",
                                "sense_id": "65175a2a-6c47-39b8-b57f-437d03fb14c7",
                                "text": "Die Heuer des Matrosen auf dem Schiff ist sein einzige Einkunft auf See."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "11ccd88d-145f-3d33-b347-d017041d2c54",
                        "entry_id": "908b0cb7-8dab-3a17-a765-6e85b49351f6",
                        "glosses": [
                            "Gewinn im Sinne von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f30fa16-9ed8-43b9-917e-df8804b24ed3",
                                "sense_id": "11ccd88d-145f-3d33-b347-d017041d2c54",
                                "text": "Wenn die Einnahmen die Ausgaben übersteigen, ist der Erlös daraus eine steuerpflichtige Einnahme als Gewinn."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "e78afb7c-4e82-3704-9f76-146a531c7dc9",
                        "entry_id": "908b0cb7-8dab-3a17-a765-6e85b49351f6",
                        "glosses": [
                            "Lohn im Sinne von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "783e529d-f411-4e94-aee1-8b6d608e8a57",
                                "sense_id": "e78afb7c-4e82-3704-9f76-146a531c7dc9",
                                "text": "Die Pension ist für manchen Rentner nicht die einzige Einnahme zum Lebensunterhalt und zudem eine steuerpflichtiger Lohn."
                            }
                        ],
                        "sense_index_json": "\"5\""
                    }
