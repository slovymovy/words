                "senses": [
                    {
                        "sense_id": "14024e1c-4683-37e8-b3b0-312b41990189",
                        "entry_id": "18c7165b-f503-3d6f-90d3-0cb7908f1419",
                        "glosses": [
                            "Dispositif permettant la connexion de circuits dont l’un transporte un signal symétrique et l’autre un signal asymétrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92bb8010-494a-4690-9674-ba4e1eefa509",
                                "sense_id": "14024e1c-4683-37e8-b3b0-312b41990189",
                                "text": "Outre l’adaptation des impédances, une antenne symétrique (comme le doublet demi-onde) doit être alimentée par une ligne symétrique (comme la ligne bifilaire) ou par un système rendant l’alimentation symétrique (balun) et une antenne asymétrique comme l’antenne verticale par une ligne asymétrique : un câble coaxial, par exemple."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f46efcaf-e080-4457-8bc4-dda4c1198671",
                        "source_entry_id": "18c7165b-f503-3d6f-90d3-0cb7908f1419",
                        "source_sense_id": "14024e1c-4683-37e8-b3b0-312b41990189",
