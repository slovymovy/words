                "senses": [
                    {
                        "sense_id": "49bf7497-137c-30ee-8f87-77be1f9eeb82",
                        "entry_id": "2f6de586-a769-3ac9-b44f-84af022bd5ef",
                        "glosses": [
                            "Faire un marquage à l’aide d’anticorps, en colorant les cellules concernées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1803cf9-05de-40ac-afa6-b6dfc9c47ea5",
                                "sense_id": "49bf7497-137c-30ee-8f87-77be1f9eeb82",
                                "text": "La distribution des corps cellulaires immunocolorés par un anticorps anti-cholécystokinine est schématisée au niveau du cerveau du ganglion sous-œsophagien (fig. 8) et des ganglions thoraciques (figs. 9 B et C) et abdominaux (fig. 9 D)."
                            },
                            {
                                "example_id": "8ae36e6c-ebdc-46f9-95ae-9f4ebfb5c230",
                                "sense_id": "49bf7497-137c-30ee-8f87-77be1f9eeb82",
                                "text": "Après coloration par le bleu Victoria-fuchsine paraldéhyde des coupes de pars intercerbralis préalablement immunocolorées (fig. 1b), toutes les cellules déjà immunocolorées par le sérum anti-neuroparsine sont recolorées en bleu (type A1)."
                            },
                            {
                                "example_id": "9aa16c07-e4de-43fe-abb9-58922f514fb6",
                                "sense_id": "49bf7497-137c-30ee-8f87-77be1f9eeb82",
                                "text": "Les immunsérums dirigés contre la neuroparsine et la Lom OMP, deux neurohormones de Locusta produites par deux types distincts de cellules protocérébrales médianes, sont capables d’immunocolorer les deux mêmes types de cellules neurosécrétrices protocérébrales médianes dans des complexes cerveau-apparentée immunologiquement à la Lom OMP."
                            }
                        ]
                    }
