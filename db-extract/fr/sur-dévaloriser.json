                "senses": [
                    {
                        "sense_id": "9ea0902e-81b0-3151-977a-c9d2becb7c6b",
                        "entry_id": "c048679c-9832-3c66-8884-9d051243d5a3",
                        "glosses": [
                            "Dévaloriser plus que ce qui est habituel ou serait normal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "345c67b4-3c5b-461e-ad80-f27d7b30d720",
                                "sense_id": "9ea0902e-81b0-3151-977a-c9d2becb7c6b",
                                "text": "Il se situe à l'extrême limite où le oui et le non, l’endroit et l’envers se rejoignent pour dérouter le sens ; et les forces de destruction qui se portent sur lui peuvent tout aussi bien le sur-dévaloriser que l’encenser."
                            },
                            {
                                "example_id": "ee209c8b-a5ce-40d4-b4cf-adc9c82a5c77",
                                "sense_id": "9ea0902e-81b0-3151-977a-c9d2becb7c6b",
                                "text": "Il est très facile de survaloriser quelqu'un quand on est aux manettes, tout comme de le sur-dévaloriser."
                            }
                        ]
                    }
