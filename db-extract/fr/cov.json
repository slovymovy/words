                        "examples": [
                            {
                                "example_id": "8019ed18-7b2f-4bd5-bc20-3f1eca9640b8",
                                "sense_id": "ab4acbe5-fa26-3999-b3d5-7ba74717f843",
                                "text": "Je bosse pas et ne touche aucune aide sociale. Toujours des soucis de santé suite à une suspicion de cov il y a 3 semaines."
                            },
                            {
                                "example_id": "b0268ae5-e3f0-426e-a3c0-a58f9f8779d6",
                                "sense_id": "ab4acbe5-fa26-3999-b3d5-7ba74717f843",
                                "text": "Comment vous allez choper le cov sur un mec mort qui ne tousse plus et ne postillonne plus ?"
                            },
                            {
                                "example_id": "9189d3cb-82f0-4f28-8a8a-08ab6eb64124",
                                "sense_id": "ab4acbe5-fa26-3999-b3d5-7ba74717f843",
                                "text": "Et je rajoute que la prescription initiale en médecine \"de ville\" est réservée à des cas très précis, bien listés, et que la suspicion de Cov n'en fait nullement partie ; dans ce cadre-là, le généraliste n'a pas le droit de le prescrire, et le pharmacien n'a pas le droit de le délivrer."
                            }
                        ]
                    }
