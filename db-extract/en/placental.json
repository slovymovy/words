                    },
                    {
                        "translation_id": "8000fe46-1de6-4a60-9b0e-e0a9477a0112",
                        "source_entry_id": "c596d0eb-2177-37a7-99a7-c2a3e267df8b",
                        "source_sense_description": "pertaining to placenta",
                        "target_lang_word": "placentaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "placentaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40bd0a33-5530-3c58-bd5d-8f7c5c017aca",
                                        "entry_id": "2adbcd73-3489-3562-842c-b762d960059d",
                                        "glosses": [
                                            "Relatif au placenta."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "348ed1a7-5b61-49ea-95b9-07010b8897c6",
                                                "sense_id": "40bd0a33-5530-3c58-bd5d-8f7c5c017aca",
                                                "text": "L’hématome rétro-placentaire est une complication très grave de la grossesse, mettant en jeu la vie de la mère et du fœtus en étant responsable d’une hémorragie parfois massive développée entre le placenta et l’utérus."
                                            },
                                            {
                                                "example_id": "494f5867-5b97-4482-9fab-0ea6dea52e6c",
                                                "sense_id": "40bd0a33-5530-3c58-bd5d-8f7c5c017aca",
                                                "text": "Au cours de la grossesse, l’estriol est produit en quantité massive par l’unité fœto-placentaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1965f6e-c5ec-38a6-8562-577d91c4022d",
                                        "entry_id": "2adbcd73-3489-3562-842c-b762d960059d",
                                        "glosses": [
                                            "Qui possède un placenta."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "032128da-1b83-4c72-aae5-fcfe8447a602",
                                                "sense_id": "f1965f6e-c5ec-38a6-8562-577d91c4022d",
                                                "text": "Mammifère placentaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91506437-cc10-3f80-9127-9a26dc7ddd2e",
                                        "entry_id": "2adbcd73-3489-3562-842c-b762d960059d",
                                        "glosses": [
                                            "Qui rappelle un placenta."
                                        ],
                                        "tags": [
                                            "literary",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24524559-6510-4673-b51c-58786a876718",
                                                "sense_id": "91506437-cc10-3f80-9127-9a26dc7ddd2e",
                                                "text": "… des morceaux de viande à demi enveloppés dans du papier d'un gluant placentaire."
                                            },
                                            {
                                                "example_id": "f9389240-f37c-4690-8bc1-2d292484132d",
                                                "sense_id": "91506437-cc10-3f80-9127-9a26dc7ddd2e",
                                                "text": "Dans la chaleur et l'humidité placentaires d'une cuisine survoltée, une sorte de grosse famille dysfonctionnelle se présente au nouveau venu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "placentaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6983f68-4a03-3e6f-b687-50929d158ac1",
                                        "entry_id": "d67b9571-f548-38be-91d3-0a9668b369fa",
                                        "glosses": [
                                            "Mammifère euthérien de la cohorte Placentalia, la plus importante des mammifères. L’embryon se développe entièrement dans le corps de sa mère, et est alimenté pendant la gestation grâce au placenta."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "292d0454-3f3b-4f5b-8099-20e700470396",
                                                "sense_id": "b6983f68-4a03-3e6f-b687-50929d158ac1",
                                                "text": "Les marsupiaux et les placentaires sont des thériens."
                                            },
                                            {
                                                "example_id": "576e1fce-3dbc-4b9f-8051-fbc5447236b2",
                                                "sense_id": "b6983f68-4a03-3e6f-b687-50929d158ac1",
                                                "text": "Les placentaires partagent le même système XY de détermination sexuelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
