                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d45d980e-4a6c-4c7f-8884-a2446e40f647",
                                                "sense_id": "821fa911-b7e3-3ccd-bb5e-93370313ec52",
                                                "text": "Je me garderai bien de dire que son ouvrage n’est qu’un recueil de petits artifices philosophiques un peu grécisés."
