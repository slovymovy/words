{
    "word_family": [
        "trip",
        "tripper"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d9839339-0649-3fbb-8577-00c72562854e",
                    "sense_definition": "Moving with quick, light, and nimble steps.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancers moved across the stage with a <w>tripping</w> gait.",
                            "target_lang_translations": {
                                "pl": "Tancerze poruszali się po scenie <w>lekkim</w> krokiem."
                            }
                        },
                        {
                            "text": "She walked with a <w>tripping</w> step that made her look very graceful.",
                            "target_lang_translations": {
                                "pl": "Szła <w>skocznym</w> krokiem, który sprawiał, że wyglądała bardzo wdzięcznie."
                            }
                        }
                    ],
                    "synonyms": [
                        "nimble",
                        "light-footed"
                    ],
                    "target_lang_definitions": {
                        "pl": "Poruszający się szybkimi, lekkimi i zwinnymi krokami."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "lekki",
                                "target_lang_sense_clarification": "odnoszący się do sposobu poruszania się"
                            },
                            {
                                "target_lang_word": "skoczny",
                                "target_lang_sense_clarification": "opisujący rytmiczny, lekki chód"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27f6cdab-9f17-3dfd-b78d-5d0cfa44f9d6",
                    "sense_definition": "Experiencing the effects of a hallucinogenic drug.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt like he was <w>tripping</w> after taking the substance.",
                            "target_lang_translations": {
                                "pl": "Czuł, że <w>jest na haju</w> po zażyciu tej substancji."
                            }
                        },
                        {
                            "text": "The music sounded strange while he was <w>tripping</w>.",
                            "target_lang_translations": {
                                "pl": "Muzyka brzmiała dziwnie, kiedy <w>miał odlot</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in informal contexts regarding drug use."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Doświadczanie efektów działania narkotyków halucynogennych."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "być na haju",
                                "target_lang_sense_clarification": "potoczne określenie stanu odurzenia"
                            },
                            {
                                "target_lang_word": "mieć odlot",
                                "target_lang_sense_clarification": "potoczne określenie stanu po zażyciu substancji"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96e6e011-0855-33a6-bc69-c63dfecba00b",
                    "sense_definition": "Acting in a strange, irrational, or foolish manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop <w>tripping</w> and just listen to what I have to say.",
                            "target_lang_translations": {
                                "pl": "Przestań <w>świrować</w> i po prostu posłuchaj, co mam do powiedzenia."
                            }
                        },
                        {
                            "text": "He was <w>tripping</w> over nothing during the entire meeting.",
                            "target_lang_translations": {
                                "pl": "Przez całe spotkanie <w>przesadzał</w> bez powodu."
                            }
                        }
                    ],
                    "synonyms": [
                        "acting crazy",
                        "overreacting"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal American English."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Zachowywanie się w dziwny, irracjonalny lub głupi sposób."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "świrować",
                                "target_lang_sense_clarification": "potoczne określenie dziwnego zachowania"
                            },
                            {
                                "target_lang_word": "przesadzać",
                                "target_lang_sense_clarification": "w kontekście niepotrzebnego reagowania"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff94bfcf-913e-3ae9-bff0-e53f9bf8e038",
                    "sense_definition": "Represented in heraldry with one forefoot raised while walking.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coat of arms features a golden stag <w>tripping</w> on a green field.",
                            "target_lang_translations": {
                                "pl": "Herb przedstawia złotego jelenia <w>w kroku</w> na zielonym polu."
                            }
                        },
                        {
                            "text": "The shield displays a buck <w>tripping</w> in its natural colors.",
                            "target_lang_translations": {
                                "pl": "Tarcza ukazuje kozła <w>w kroku</w> w naturalnych barwach."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Przedstawiony w heraldyce z jedną uniesioną przednią nogą podczas chodzenia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "w kroku",
                                "target_lang_sense_clarification": "termin heraldyczny dla zwierzęcia w ruchu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f63031a9-65b8-3d35-8ff2-49a3bcd4230a",
                    "sense_definition": "The act of stumbling or making a small mistake.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "error",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His speech was full of small <w>trippings</w> of the tongue.",
                            "target_lang_translations": {
                                "pl": "Jego mowa była pełna drobnych <w>potknięć</w> językowych."
                            }
                        },
                        {
                            "text": "She tried to ignore the minor <w>trippings</w> in his performance.",
                            "target_lang_translations": {
                                "pl": "Próbowała zignorować drobne <w>pomyłki</w> w jego występie."
                            }
                        }
                    ],
                    "synonyms": [
                        "stumbles",
                        "slips"
                    ],
                    "target_lang_definitions": {
                        "pl": "Akt potknięcia się lub popełnienia drobnego błędu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "potknięcie",
                                "target_lang_sense_clarification": "zarówno fizyczne, jak i przenośne"
                            },
                            {
                                "target_lang_word": "pomyłka",
                                "target_lang_sense_clarification": "drobny błąd w działaniu lub mowie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ff6498cb-bc5d-3a07-afeb-4e86f2ae02d4",
                    "sense_definition": "The present participle and gerund of <w>trip</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>tripping</w> over the rug because it was loose.",
                            "target_lang_translations": {
                                "pl": "Ciągle <w>potykał się</w> o dywan, ponieważ był luźny."
                            }
                        },
                        {
                            "text": "She is <w>tripping</w> on the sidewalk while running to the bus.",
                            "target_lang_translations": {
                                "pl": "Biegnąc do autobusu, <w>potyka się</w> na chodniku."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Imiesłów czasu teraźniejszego i gerundium od czasownika 'trip' (potykać się)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "potykać się",
                                "target_lang_sense_clarification": "tracić równowagę podczas chodzenia"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}