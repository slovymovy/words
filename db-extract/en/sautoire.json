                        "glosses": [
                            "A heavy skillet with straight sides, used for sautéing food."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ec251d0-33ed-46d5-8067-41bdacdec4c5",
                                "sense_id": "9d8e545d-a46d-3abf-80ee-ce283f6b9072",
                                "text": "1893, Charles Ranhofer, The Epicurean, Dover (Calla Editions), 2017 Facsimile Edition, page 334,\nUse the same slices of bread, only instead of toasting them, lay them in a sautoire with hot clarified butter; brown them on one side only, then drain, and leave the butter in the sautoire."
                            },
                            {
                                "example_id": "0ea32201-098b-4757-a6d5-026b4bcbade2",
                                "sense_id": "9d8e545d-a46d-3abf-80ee-ce283f6b9072",
                                "text": "Dip them in beaten egg, roll in fresh bread crumbs, and place in a sautoire with one ounce of clarified butter."
                            },
                            {
                                "example_id": "83f8dd9f-bdbc-45f4-8155-e537d28eebf8",
                                "sense_id": "9d8e545d-a46d-3abf-80ee-ce283f6b9072",
                                "text": "Lay them in a sautoire, season with salt, pepper and two ounces butter."
                            }
                        ]
                    },
                    {
                        "sense_id": "22c9a4f5-1e01-3111-b513-b97f6e7a2fd4",
