                                        "examples": [
                                            {
                                                "example_id": "b1fe3ce3-efc5-4958-9fc7-64843fde9401",
                                                "sense_id": "24676fc8-4df0-36c9-ac8a-86e8f0b45d07",
                                                "text": "Огромные, почти до полу, окна были распахнуты, и в одном из них я увидел странную сцену, тотчас же полностью приковавшую моё внимание."
                                            },
                                            {
                                                "example_id": "caf3aac8-5bbf-4024-9398-2619d11e4223",
                                                "sense_id": "24676fc8-4df0-36c9-ac8a-86e8f0b45d07",
                                                "text": "Я давно убедился: стоит задуматься, и тотчас вспоминаешь что-нибудь грустное."
                                            }
                                        ]
                                    }
                                ]
                            }
