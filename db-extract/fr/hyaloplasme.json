                        "sense_id": "b9f73bd5-fedf-33aa-a1c0-7d8018f869f7",
                        "entry_id": "94d2de69-d660-3852-bb5e-d6310f4e5d53",
                        "glosses": [
                            "Substance visqueuse dans laquelle baignent les organites cellulaires. Il comprend le cytosol et le cytosquelette. Avec les organites cellulaires (morphoplasme), ils forment le cytoplasme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ae83f3d-bf96-4c46-8d38-462295470ab2",
                                "sense_id": "b9f73bd5-fedf-33aa-a1c0-7d8018f869f7",
                                "text": "L’exocytose se fait par une déformation de la membrane plasmique, aboutissant au passage à l’extérieur du contenu d’une vésicule se trouvant dans le hyaloplasme."
                            }
                        ]
                    }
                ],
