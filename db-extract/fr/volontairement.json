                                "target_senses": [
                                    {
                                        "sense_id": "279fad06-9250-347d-8d77-f265f20b8b30",
                                        "entry_id": "e1051025-480f-3230-81f8-e8b7d6bc744a",
                                        "glosses": [
                                            "In a determined manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1407e2f4-d8d7-42be-8c98-6d8568835c96",
                                                "sense_id": "279fad06-9250-347d-8d77-f265f20b8b30",
                                                "text": "where closeness, when it does manage to show itself, usually falls victim to outside forces that seem determinedly hostile to any manifestation of happiness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2faf9d1f-be01-4180-8499-ac0752b924af",
                        "source_entry_id": "d83c7db8-5e00-3c98-b295-3c912578741d",
                        "source_sense_id": "b8523b9d-5c5d-3c29-81b0-b7a629d5c543",
                        "target_lang_word": "intentionally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intentionally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9c181ba-b156-3315-adf9-4df1c7a0bd34",
                                        "entry_id": "07f02f10-84c3-31b9-ba34-7f54e20936a2",
                                        "glosses": [
                                            "In an intentional manner; on purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "703a1b9d-5c09-4014-9e97-aff3e2cf8dca",
                                                "sense_id": "f9c181ba-b156-3315-adf9-4df1c7a0bd34",
                                                "text": "The body design has been carried out to the requirements of the B.T.C. Design Panel in association with the Design Research Unit and its lines are described as \"intentionally unelaborate\"."
                                            },
                                            {
                                                "example_id": "50e12eae-f2ec-4837-858b-fbe7be541c68",
                                                "sense_id": "f9c181ba-b156-3315-adf9-4df1c7a0bd34",
                                                "text": "Today, no one would intentionally smear radioactive materials on their face, but in 1933, the dangers of radioactivity were not yet fully understood."
                                            },
                                            {
                                                "example_id": "dcd31949-fbea-4ff1-a20e-e97a1b2c0efa",
                                                "sense_id": "f9c181ba-b156-3315-adf9-4df1c7a0bd34",
                                                "text": "Astrotourism has the potential to catalyze positive change and reduce light pollution globally, but it must be pursued intentionally with utmost concern for local communities and the natural environment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "914c8549-7668-4d69-960c-fc36dc004006",
                        "source_entry_id": "d83c7db8-5e00-3c98-b295-3c912578741d",
                        "source_sense_id": "b8523b9d-5c5d-3c29-81b0-b7a629d5c543",
                        "target_lang_word": "on purpose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "on purpose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e676f615-a2c3-357d-afa6-04f4ffba1ae0",
                                        "entry_id": "9fc1d1c9-0b49-388f-b475-8ce0dafb8704",
                                        "glosses": [
                                            "By design, as opposed to by accident; intentionally; deliberately."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "405a7f72-1050-4c93-8e5f-721d3ef53e29",
                                                "sense_id": "e676f615-a2c3-357d-afa6-04f4ffba1ae0",
                                                "text": "That wasn't an accident! You did it on purpose!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c4105b8-fc20-3d96-b691-0af3f86339c8",
                                        "entry_id": "9fc1d1c9-0b49-388f-b475-8ce0dafb8704",
                                        "glosses": [
                                            "In order to (do something); with the objective that."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02868d43-ccf0-4fba-b2e6-be1c205c857d",
                                                "sense_id": "2c4105b8-fc20-3d96-b691-0af3f86339c8",
                                                "text": "Blifil bowed and stammered, and looked like a fool; but Western, without giving him time to form a speech for the purpose, answered, “Well, well, I am to blame, if you will, I always am, certainly; but come, let the girl be fetched back again, or let Mr Blifil go to her.——He’s come up on purpose, and there is no time to be lost.”"
                                            },
                                            {
                                                "example_id": "36609401-b216-4dbf-be4e-1d07ce344a18",
                                                "sense_id": "2c4105b8-fc20-3d96-b691-0af3f86339c8",
                                                "text": "I send this to the town, on purpose to have it reach you by the earliest post […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2cb27236-bf79-41b6-917d-b15e73ae5c1f",
                        "source_entry_id": "d83c7db8-5e00-3c98-b295-3c912578741d",
                        "source_sense_id": "b8523b9d-5c5d-3c29-81b0-b7a629d5c543",
