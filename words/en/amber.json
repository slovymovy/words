                    "common_phrases": [
                        "amber liquid",
                        "amber glow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий коричневато-жёлтый цвет.",
                        "zh": "呈棕黄色的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "янтарный",
                                "target_lang_sense_clarification": "цвет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "琥珀色的",
                                "target_lang_sense_clarification": "颜色"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "edb613c8-e933-3b70-b646-bfcb87cf74af",
                    "sense_definition": "A female given name.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "name_person",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My best friend <w>Amber</w> is coming to visit me this weekend.",
                            "target_lang_translations": {
                                "ru": "Моя лучшая подруга <w>Эмбер</w> приедет навестить меня в эти выходные.",
                                "zh": "我最好的朋友<w>安珀</w>这个周末要来看我。"
                            }
                        },
                        {
                            "text": "They decided to name their new baby daughter <w>Amber</w>.",
                            "target_lang_translations": {
                                "ru": "Они решили назвать свою новорождённую дочь <w>Эмбер</w>.",
                                "zh": "他们决定给刚出生的女儿取名为<w>安珀</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя.",
                        "zh": "女性名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Эмбер",
                                "target_lang_sense_clarification": "имя"
                            }
