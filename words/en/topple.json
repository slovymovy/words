{
    "word_family": [
        "toppler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "10239b2b-7e72-3171-b2c4-1b17be1f6c6d",
                    "sense_definition": "to push or throw something over so that it falls",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_fall",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry protesters managed to <w>topple</w> the heavy statue in the city square.",
                            "target_lang_translations": {
                                "ru": "Разгневанным протестующим удалось <w>повалить</w> тяжелую статую на городской площади.",
                                "cs": "Rozhněvaným demonstrantům se podařilo <w>svalit</w> těžkou sochu na náměstí."
                            }
                        },
                        {
                            "text": "Be careful not to <w>topple</w> the vase while you are cleaning the shelf.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, не <w>опрокинь</w> вазу, когда будешь протирать полку.",
                                "cs": "Dávej pozor, abys <w>nepřevrhl</w> vázu, když utíráš polici."
                            }
                        }
                    ],
                    "synonyms": [
                        "knock over",
                        "overturn",
                        "upset"
                    ],
                    "common_phrases": [
                        "topple the statue"
                    ],
                    "target_lang_definitions": {
                        "ru": "толкнуть или бросить что-либо так, чтобы оно упало",
                        "cs": "strčit do něčeho nebo to shodit tak, aby to spadlo"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опрокинуть",
                                "target_lang_sense_clarification": "повалить предмет на бок или вверх дном"
                            },
                            {
                                "target_lang_word": "повалить",
                                "target_lang_sense_clarification": "заставить что-то упасть на землю"
                            },
                            {
                                "target_lang_word": "свалить",
                                "target_lang_sense_clarification": "толкнуть так, чтобы предмет упал"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "převrhnout",
                                "target_lang_sense_clarification": "shodit předmět tak, že se převrátí"
                            },
                            {
                                "target_lang_word": "svalit",
                                "target_lang_sense_clarification": "shodit něco na zem"
                            },
                            {
                                "target_lang_word": "překotit",
                                "target_lang_sense_clarification": "převrátit předmět na bok"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9ec1e22-baa4-3df6-816b-345578c61d47",
                    "sense_definition": "to become unsteady and fall down, or to lean as if about to fall",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_fall",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tall stack of books began to <w>topple</w> after he added one more volume.",
                            "target_lang_translations": {
                                "ru": "Высокая стопка книг начала <w>валиться</w>, после того как он добавил еще один том.",
                                "cs": "Vysoký komínek knih se začal <w>kácet</w>, když přidal další svazek."
                            }
                        },
                        {
                            "text": "The old fence started to <w>topple</w> over during the heavy windstorm.",
                            "target_lang_translations": {
                                "ru": "Старый забор начал <w>заваливаться</w> во время сильной бури.",
                                "cs": "Starý plot se během silné bouře začal <w>převracet</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "totter",
                        "tumble",
                        "collapse"
                    ],
                    "antonyms": [
                        "stabilize"
                    ],
                    "common_phrases": [
                        "begin to topple"
                    ],
                    "target_lang_definitions": {
                        "ru": "потерять устойчивость и упасть или сильно наклониться, грозя падением",
                        "cs": "ztratit stabilitu a spadnout, nebo se naklonit, jako by člověk nebo věc měla spadnout"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повалиться",
                                "target_lang_sense_clarification": "упасть, потеряв равновесие"
                            },
                            {
                                "target_lang_word": "опрокинуться",
                                "target_lang_sense_clarification": "упасть на бок или перевернуться"
                            },
                            {
                                "target_lang_word": "рухнуть",
                                "target_lang_sense_clarification": "внезапно и тяжело упасть"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "kácet se",
                                "target_lang_sense_clarification": "ztrácet rovnováhu a padat"
                            },
                            {
                                "target_lang_word": "převrhnout se",
                                "target_lang_sense_clarification": "spadnout na bok nebo se převrátit"
                            },
                            {
                                "target_lang_word": "překotit se",
                                "target_lang_sense_clarification": "převrátit se v důsledku ztráty rovnováhy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3e9b955-1d3a-3a9f-a72c-0ace2973bbec",
                    "sense_definition": "to remove a government or a leader from power",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "overthrow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rebel forces worked for years to <w>topple</w> the government and establish a democracy.",
                            "target_lang_translations": {
                                "ru": "Повстанческие силы годами работали над тем, чтобы <w>свергнуть</w> правительство и установить демократию.",
                                "cs": "Povstalecké síly roky pracovaly na tom, aby <w>svrhly</w> vládu a nastolily demokracii."
                            }
                        },
                        {
                            "text": "A major financial scandal could easily <w>topple</w> the prime minister from his position.",
                            "target_lang_translations": {
                                "ru": "Крупный финансовый скандал мог бы легко <w>лишить</w> премьер-министра его поста.",
                                "cs": "Velký finanční skandál by mohl snadno <w>svrhnout</w> premiéra z jeho postu."
                            }
                        }
                    ],
                    "synonyms": [
                        "overthrow",
                        "unseat",
                        "oust"
                    ],
                    "antonyms": [
                        "install",
                        "establish"
                    ],
                    "common_phrases": [
                        "topple the government",
                        "topple a leader"
                    ],
                    "target_lang_definitions": {
                        "ru": "отстранить правительство или лидера от власти",
                        "cs": "odstranit vládu nebo vůdce z moci"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свергнуть",
                                "target_lang_sense_clarification": "лишить власти силой"
                            },
                            {
                                "target_lang_word": "опрокинуть",
                                "target_lang_sense_clarification": "переносно: лишить власти или статуса"
                            },
                            {
                                "target_lang_word": "низложить",
                                "target_lang_sense_clarification": "официально лишить высокого поста"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "svrhnout",
                                "target_lang_sense_clarification": "zbavit moci násilnou cestou"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4b5736d5-5786-37d8-b68a-c81cdf3e705a",
                    "sense_definition": "an instance of falling over or collapsing",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_fall",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gymnast took a sudden <w>topple</w> during her routine but quickly recovered.",
                            "target_lang_translations": {
                                "ru": "Гимнастка внезапно <w>упала</w> во время выступления, но быстро пришла в себя.",
                                "cs": "Gymnastka během sestavy náhle <w>upadla</w>, ale rychle se vzpamatovala."
                            }
                        },
                        {
                            "text": "One small <w>topple</w> of the blocks caused the entire tower to come down.",
                            "target_lang_translations": {
                                "ru": "Одно небольшое <w>падение</w> кубика привело к обрушению всей башни.",
                                "cs": "Jedno malé <w>převržení</w> kostek způsobilo, že se celá věž zřítila."
                            }
                        }
                    ],
                    "synonyms": [
                        "fall",
                        "tumble",
                        "spill"
                    ],
                    "target_lang_definitions": {
                        "ru": "случай падения или обрушения",
                        "cs": "případ pádu nebo zřícení"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "падение",
                                "target_lang_sense_clarification": "акт потери равновесия и приземления"
                            },
                            {
                                "target_lang_word": "обрушение",
                                "target_lang_sense_clarification": "падение конструкции или груды предметов"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "pád",
                                "target_lang_sense_clarification": "akt ztráty rovnováhy a dopadu na zem"
                            },
                            {
                                "target_lang_word": "zřícení",
                                "target_lang_sense_clarification": "náhlý pád konstrukce nebo hromady věcí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c1e087d-4b17-382d-b9ff-0d4850084779",
                    "sense_definition": "a sequence of objects falling one after another, like a chain reaction of dominoes",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_fall",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children set up a long <w>topple</w> of dominoes that stretched across the living room.",
                            "target_lang_translations": {
                                "ru": "Дети выстроили длинную <w>цепочку</w> домино, которая растянулась через всю гостиную.",
                                "cs": "Děti postavily dlouhou <w>řadu</w> domina, která se táhla přes celý obývací pokoj."
                            }
                        },
                        {
                            "text": "We watched the satisfying <w>topple</w> as each piece knocked down the next one.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали за приятным глазу <w>падением</w>, когда каждая деталь сбивала следующую.",
                                "cs": "Sledovali jsme uspokojivé <w>kaskádové padání</w>, jak každý dílek shodil ten další."
                            }
                        }
                    ],
                    "synonyms": [
                        "cascade",
                        "chain reaction"
                    ],
                    "common_phrases": [
                        "domino topple"
                    ],
                    "target_lang_definitions": {
                        "ru": "последовательное падение объектов один за другим, подобно цепной реакции домино",
                        "cs": "postupné padání objektů jeden za druhým, jako řetězová reakce domina"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эффект домино",
                                "target_lang_sense_clarification": "цепная реакция падения"
                            },
                            {
                                "target_lang_word": "каскадное падение",
                                "target_lang_sense_clarification": "последовательное обрушение"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "domino efekt",
                                "target_lang_sense_clarification": "řetězová reakce pádů"
                            },
                            {
                                "target_lang_word": "kaskádový pád",
                                "target_lang_sense_clarification": "postupné zřícení řady objektů"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}