                ],
                "senses": [
                    {
                        "sense_id": "eddc2e63-90e1-328f-bf0d-b5e9ebee128c",
                        "entry_id": "51e73502-d21d-35b8-a0bc-02f64d240709",
                        "glosses": [
                            "Manger avidement et avec excès."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "65b5674c-e87e-47ee-9ae8-8d78ca6f9c86",
                                "sense_id": "eddc2e63-90e1-328f-bf0d-b5e9ebee128c",
                                "text": "Tout affairés à baffrer, ils fermaient leurs gueules, et j’appréciais bien ce demi-silence."
                            },
                            {
                                "example_id": "46fd871f-8a32-4330-853b-eba69bff13a7",
                                "sense_id": "eddc2e63-90e1-328f-bf0d-b5e9ebee128c",
                                "text": "Pas plus que ce que va coûter à cette entreprise le généreux en-cas que vous vous apprêtez à baffrer sur le compte de Balland S.A."
                            },
                            {
                                "example_id": "6d5fa96f-77c6-4702-bb17-1faafce941c7",
                                "sense_id": "eddc2e63-90e1-328f-bf0d-b5e9ebee128c",
                                "text": "Alors, que voulez-vous qu’ils fassent ? Qu’ils beuvaillent, fricotent, baffrent, fument la pipe, chantent, dansent, cavalcadent, boustifaillent, tortillent, goinfrent ou pignochent, boulottent, buvotent, lichent, picolent, chopinent, trinquent et qu’ils rotent et qu’ils cuvent ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "2838de66-e1ae-3802-b008-36efce02bc5b",
                        "entry_id": "51e73502-d21d-35b8-a0bc-02f64d240709",
                        "glosses": [
                            "Manger quelque chose avidement et avec excès."
                        ],
                        "tags": [
                            "colloquial",
                            "pronominal"
                        ],
                        "examples": []
                    }
