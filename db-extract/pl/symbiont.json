                "senses": [
                    {
                        "sense_id": "2ff68a35-4cca-3733-ba65-df80353575bf",
                        "entry_id": "cee45824-8f02-3c23-a56e-13199463ceda",
                        "glosses": [
                            "organizm żyjący w symbiozie z organizmem innego gatunku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d647da8d-a9cc-467e-87d3-37adaa3067cb",
                                "sense_id": "2ff68a35-4cca-3733-ba65-df80353575bf",
                                "text": "Instytut prowadzi badania nad symbiontami żyjącymi w przewodzie pokarmowym człowieka"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae9dd179-91d9-4364-86f4-3630302283a2",
                        "source_entry_id": "cee45824-8f02-3c23-a56e-13199463ceda",
                        "source_sense_id": "2ff68a35-4cca-3733-ba65-df80353575bf",
                        "target_lang_word": "symbiont",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "symbiont",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cfbe7b86-eb2e-3e6e-94bc-494b1df7aede",
                                        "entry_id": "3d549664-d0a5-3e5c-b900-7e6440484c8d",
                                        "glosses": [
                                            "An organism that lives in a symbiotic relationship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a1132fa-05fd-4f9f-b6d8-a93eb042419b",
                                                "sense_id": "cfbe7b86-eb2e-3e6e-94bc-494b1df7aede",
                                                "text": "The close analogies between DNA-containing eukaryotic cell organelles and microbial symbionts require revision of classic cell theory, wrote Scwemmler and Schenk (1980) on introducing the field of endocytobiology."
                                            },
                                            {
                                                "example_id": "e5ff68de-c6af-49e3-88ad-0003e40a43df",
                                                "sense_id": "cfbe7b86-eb2e-3e6e-94bc-494b1df7aede",
                                                "text": "It had been known that sponges somehow took in dissolved organic matter, but it remained unclear whether they could do it on their own or needed help from their bacterial symbionts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c250b87-81b9-4d19-9308-407ee54d2717",
                        "source_entry_id": "cee45824-8f02-3c23-a56e-13199463ceda",
