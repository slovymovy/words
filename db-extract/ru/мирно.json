                                                "sense_id": "9c4b3aff-9b97-3b30-9b4b-fc3b63a25d25",
                                                "text": "You may go in peace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "add5ae99-22d1-3785-a6b8-4fdb3c50ee17",
                                        "entry_id": "bb2382ff-3791-39be-9e47-93ba2c40ca21",
                                        "glosses": [
                                            "Without interruption; in tranquility; peacefully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f62bf008-bf0b-45fc-bb6f-0d501e1a5ada",
                                                "sense_id": "add5ae99-22d1-3785-a6b8-4fdb3c50ee17",
                                                "text": "Now the children have gone, perhaps I can get on with my work in peace."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
