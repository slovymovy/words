                                    {
                                        "sense_id": "6e6a84e4-7ca7-34b3-8d9e-3e2892195108",
                                        "entry_id": "5aac7e84-231d-3478-bdaa-4711f08c4fc0",
                                        "glosses": [
                                            "Adepte de l'expressionnisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70f19132-57a6-42fa-b6c1-c7ca74c577da",
                                                "sense_id": "6e6a84e4-7ca7-34b3-8d9e-3e2892195108",
                                                "text": "Otto Dix est un expressionniste allemand."
                                            },
                                            {
                                                "example_id": "dff99563-b23d-4ecd-ba37-c20a30e155c7",
                                                "sense_id": "6e6a84e4-7ca7-34b3-8d9e-3e2892195108",
                                                "text": "Paul Klee n’était pas à proprement parler un expressionniste typique."
                                            },
                                            {
                                                "example_id": "1fdaf16d-beb2-488d-9c9a-d8a936714553",
                                                "sense_id": "6e6a84e4-7ca7-34b3-8d9e-3e2892195108",
                                                "text": "… il revient avec le coffret de thuya où il garde, avec son carnet de la Caisse Populaire et ses polices d'assurances\n (vie, feu, vol), les dessins de Laïnou. Elle les lui donne à mesure ; de toute façon ils sont sans valeur ; les critiques l'ont classée expressionniste abstraite, ça fait que tout ce qu'elle fait qui ressemble à de quoi ne vaut pas 5 cennes."
                                            }
                                        ]
                                    }
                                ]
                            },
