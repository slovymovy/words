                                "target_senses": [
                                    {
                                        "sense_id": "43482c43-c719-3c5a-90ca-b7dac23fd3e2",
                                        "entry_id": "d7e8ea9f-1dc0-32a8-982d-601765a9cc71",
                                        "glosses": [
                                            "Flacon muni d’une tétine qui sert à allaiter artificiellement les enfants."
                                        ],
                                        "tags": [
                                            "Puériculture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89cee203-ae10-4a6f-b2f6-f2bfa761c266",
                                                "sense_id": "43482c43-c719-3c5a-90ca-b7dac23fd3e2",
                                                "text": "Cette solution consiste à allaiter en même temps les deux jumeaux, l’un au sein, par la mère, et l’autre au biberon, par le père ou une autre personne."
                                            },
                                            {
                                                "example_id": "76a43bd4-c0b0-48ee-ac75-1fbc6a4b3fee",
                                                "sense_id": "43482c43-c719-3c5a-90ca-b7dac23fd3e2",
                                                "text": "Avez-vous inventé des corsets mécaniques ou des biberons, des pompes à incendie ou des pare-crottes, des cheminées qui ne consomment pas de bois, ou des fourneaux qui cuisent les côtelettes avec trois feuilles de papier ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40629e9d-a766-304d-a3d1-021d4d0653fd",
                                        "entry_id": "d7e8ea9f-1dc0-32a8-982d-601765a9cc71",
                                        "glosses": [
                                            "Petit vase équipé d’un bec ou d’un tuyau par lequel on fait boire un malade."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "317b7a7a-19c8-3d16-b530-602bb809fada",
                                        "entry_id": "d7e8ea9f-1dc0-32a8-982d-601765a9cc71",
                                        "glosses": [
                                            "Boule accolée au but par un pointeur."
                                        ],
                                        "tags": [
                                            "Jeux de boules"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be3aab40-8a5e-4dd6-b8a7-721980d98ed4",
                                                "sense_id": "317b7a7a-19c8-3d16-b530-602bb809fada",
                                                "text": "… mais à l’avant-dernière mène, catastrophe, nos joueurs manquent le cadre et Cretet, sur un carreau, marque 6 points : finie la belle aventure. Eh bien ! Non, Maestro annulle sur un biberon, puis fait deux touches capitales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0369c571-776a-368a-882a-773f755fb7f7",
                                        "entry_id": "d7e8ea9f-1dc0-32a8-982d-601765a9cc71",
                                        "glosses": [
                                            "Personne qui aime le vin, qui en boit beaucoup."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "270ea604-af7e-4c2f-ac70-cef7affeb22e",
                                                "sense_id": "0369c571-776a-368a-882a-773f755fb7f7",
                                                "text": "C’est un bon biberon."
                                            },
                                            {
                                                "example_id": "1fc25468-7228-4455-9ded-2103e1887d33",
                                                "sense_id": "0369c571-776a-368a-882a-773f755fb7f7",
                                                "text": "Certes, il fallait qu’il fût bien navré dans l’âme, car il était de ces biberons qui souhaitaient d’être enterrés sous le baril, afin que la cannelle leur dégoutte dans la bouche, et il se fût relevé du cercueil pour crier « masse » à un rouge-bord."
                                            },
                                            {
                                                "example_id": "45654129-54d6-4e59-bb97-646520b4734b",
                                                "sense_id": "0369c571-776a-368a-882a-773f755fb7f7",
                                                "text": "Buvons ! Vive le roi qui boit ! Et vive aussi son peuple biberon !…"
                                            },
                                            {
                                                "example_id": "4b5a9c0f-0919-46c0-abb9-3b622d6fe719",
                                                "sense_id": "0369c571-776a-368a-882a-773f755fb7f7",
                                                "text": "De la Halle aux vins aux entrepôts de Bercy […]. Les picots sont des biberons qui vous pompent des barriques et revendent le contenu à des bistros."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
