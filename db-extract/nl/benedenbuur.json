                        "glosses": [
                            "mensen die op een lagere verdieping van hetzelfde gebouw wonen waarin jezelf woont"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb07feee-517b-4058-8a79-c4b719aa041d",
                                "sense_id": "40673154-0b33-366f-9dde-2f403c71e88a",
                                "text": "Het viel me zondagmiddag weer op, toen de benedenburen de bewoners van ons pand hadden uitgenodigd voor een koffie in kerstsfeer. Ze hadden grote, zelf gevouwen papieren ‘sneeuwvlokken’ opgehangen, een adventsster voor het raam en kerstlampjes op het balkon. Er was koffie, thee, Glühwein of iets sterkers. De eettafel stond vol: chocolade-cranberrytaart, een tulband, rumballen en kerststol natuurlijk - alles zelf gemaakt."
                            }
                        ]
                    }
