                    {
                        "sense_id": "eefe1c11-6ca9-3b4b-be1c-2c8934dc2862",
                        "entry_id": "de3b25aa-c644-3502-a45a-66e09f1f8781",
                        "glosses": [
                            "Wissenschaft der Erforschung des Weltraums, entweder durch Beobachtung, Fernerkundung oder Sondierung von Himmelskörpern oder durch terrestrische (auf der Erde durchgeführte) Experimente, die sich auf Zustände im Weltraum übertragen lassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1148f097-8a79-4aab-bdad-dd40356c3f27",
                                "sense_id": "eefe1c11-6ca9-3b4b-be1c-2c8934dc2862",
                                "text": "„Seit 1984 existiert ein Abkommen zwischen China und Deutschland über die Zusammenarbeit in der zivilen Weltraumwissenschaft und -technik.“"
                            },
                            {
                                "example_id": "d34af68a-1f6f-4167-a651-1a82f7fc4c29",
                                "sense_id": "eefe1c11-6ca9-3b4b-be1c-2c8934dc2862",
                                "text": "„Mehr noch: Heute verkörpert die ESA den Rang Europas als einer der großen Raumfahrtpioniere weltweit - insbesondere bei der Weltraumwissenschaft, der Erdbeobachtung, der Telekommunikation und den Raumfahrzeugträgern.“"
                            }
                        ],
