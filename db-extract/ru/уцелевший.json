                "senses": [
                    {
                        "sense_id": "b7438662-9a70-3b51-a237-8681b2cf04be",
                        "entry_id": "854d2a42-4c29-379f-b738-762661ec2a46",
                        "glosses": [
                            "действ. прич. прош. вр. от уцелеть"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "82ef0dbd-0670-4db3-970f-9851d555b37a",
                                "sense_id": "b7438662-9a70-3b51-a237-8681b2cf04be",
                                "text": "Кто же мог засвидетельствовать ее красоту, если всех очевидцев поубивало, ну, а тот уцелевший, безбашенный, как там его… не Геракл… Персей… что он мог разглядеть, кроме жалкого отражения?.."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58f251f9-6390-43f1-a207-46f33e64204f",
                        "source_entry_id": "854d2a42-4c29-379f-b738-762661ec2a46",
                        "source_sense_id": "b7438662-9a70-3b51-a237-8681b2cf04be",
                        "target_lang_word": "survivor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "survivor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54954f96-ed6d-3ee8-91da-d5d0551aa1df",
                                        "entry_id": "b7f3cf55-bc23-3832-aa1a-be514c6c5b9d",
                                        "glosses": [
                                            "One who survives, especially one who survives a traumatic experience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7db8ebe5-2b85-4588-9d06-f21942e0be8c",
                                                "sense_id": "54954f96-ed6d-3ee8-91da-d5d0551aa1df",
                                                "text": "From this moment on, I choose to live not as a victim, but as a survivor."
                                            },
                                            {
                                                "example_id": "2cb27de0-239c-4de8-878b-4651667d2acc",
                                                "sense_id": "54954f96-ed6d-3ee8-91da-d5d0551aa1df",
                                                "text": "Believing that requires trust, and trust is understandably a tough issue for those of us who are survivors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35f41446-e2c7-3420-831f-edd6021be7ae",
                                        "entry_id": "b7f3cf55-bc23-3832-aa1a-be514c6c5b9d",
                                        "glosses": [
                                            "A person who is able to endure hardship."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d58f2fb7-e29c-41c1-8883-6c69f9bef6ae",
                                                "sense_id": "35f41446-e2c7-3420-831f-edd6021be7ae",
                                                "text": "I'm a survivor. We're a dying breed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64407244-0a72-37b3-a4b7-b63249389a3a",
                                        "entry_id": "b7f3cf55-bc23-3832-aa1a-be514c6c5b9d",
                                        "glosses": [
                                            "One who knew a specific decedent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a16208b-8edd-4871-b2b3-b61a9533fe5d",
                                                "sense_id": "64407244-0a72-37b3-a4b7-b63249389a3a",
                                                "text": "She was from a large family and had many friends, so the funeral was crowded with mourning survivors."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
