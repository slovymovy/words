                    },
                    {
                        "sense_id": "b5303939-4bc1-3d9f-abcf-7d6d1a6730e6",
                        "entry_id": "8d6821a8-88ff-366d-bfe3-782e7e171b3f",
                        "glosses": [
                            "The decline in value of assets."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2515db35-87b3-433e-b7af-e98a0670feec",
                                "sense_id": "b5303939-4bc1-3d9f-abcf-7d6d1a6730e6",
                                "text": "asset depreciation"
                            },
                            {
                                "example_id": "5995c69e-9dab-4a82-b008-1bf0ab047e5d",
                                "sense_id": "b5303939-4bc1-3d9f-abcf-7d6d1a6730e6",
                                "text": "currency depreciation"
                            },
                            {
                                "example_id": "4aed2506-c8e0-40d7-b36e-e7786fbe680e",
                                "sense_id": "b5303939-4bc1-3d9f-abcf-7d6d1a6730e6",
                                "text": "The accountant calculated the annual depreciation of the machinery."
                            },
                            {
                                "example_id": "22afee68-e92e-4258-8e40-9a3479ecdde2",
                                "sense_id": "b5303939-4bc1-3d9f-abcf-7d6d1a6730e6",
                                "text": "There was a sharp depreciation in the value of the currency."
                            }
                        ]
                    },
                    {
                        "sense_id": "5516c789-15f1-3088-8d03-6bea45c37c57",
                        "entry_id": "8d6821a8-88ff-366d-bfe3-782e7e171b3f",
                        "glosses": [
                            "The measurement of the decline in value of assets. Not to be confused with impairment, which is the measurement of the unplanned, extraordinary decline in value of assets."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "51d87c0f-14ca-456c-a30a-f22c5b46f9a4",
                                "sense_id": "5516c789-15f1-3088-8d03-6bea45c37c57",
                                "text": "annual depreciation"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca17d545-d49c-427d-8a86-6cd8becca8e2",
                        "source_entry_id": "8d6821a8-88ff-366d-bfe3-782e7e171b3f",
                        "source_sense_description": "state",
                        "target_lang_word": "dépréciation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dépréciation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b52974c-0abd-3df8-97c2-4153edf54888",
                                        "entry_id": "df523250-2666-3a0f-8ed5-91d28d9b1358",
                                        "glosses": [
                                            "Action de déprécier ou état d’une chose dépréciée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e0bed43-f5cd-416f-9d5a-6e62577cdbad",
                                                "sense_id": "2b52974c-0abd-3df8-97c2-4153edf54888",
                                                "text": "Parmi les gouvernants d’aujourd'hui […], les uns pensent que la difficulté financières peuvent se résoudre très simplement par l’artifice de la dépréciation monétaire, par la dévalorisation des milliards, c’est à dire pour parler français, par le recours aux assignats, par une faillite plus ou moins habilement dissimulée."
                                            },
                                            {
                                                "example_id": "c5b10cc7-5c68-4d9f-a4d4-78ac0d263295",
                                                "sense_id": "2b52974c-0abd-3df8-97c2-4153edf54888",
                                                "text": "A mesure qu’augmentait les émissions de papier-monnaie, s’accentuait la dépréciation du mark, et de plus en plus les particuliers s’efforçaient, quand ils recevaient de billets, de les échanger aussitôt contre des marchandises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66a826c8-16f6-3e01-a552-a1240c140347",
                                        "entry_id": "df523250-2666-3a0f-8ed5-91d28d9b1358",
                                        "glosses": [
                                            "Baisse de la valeur d’une monnaie par rapport aux autres devises sur le marché des changes."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e66dd131-543f-49b0-85bf-bdc4ca82b8a5",
                                                "sense_id": "66a826c8-16f6-3e01-a552-a1240c140347",
                                                "text": "La dépréciation d’une monnaie peut être due à une augmentation du nombre de ses unités monétaires en circulation."
                                            },
                                            {
                                                "example_id": "71aad669-0de0-428d-ba0a-7323d07aa83b",
                                                "sense_id": "66a826c8-16f6-3e01-a552-a1240c140347",
                                                "text": "Cela a entraîné dans la foulée la dépréciation des monnaies de plusieurs ex-Républiques soviétiques, par exemple la Géorgie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ff8f798-c383-3b0d-b05e-0ae04ff0e232",
                                        "entry_id": "df523250-2666-3a0f-8ed5-91d28d9b1358",
                                        "glosses": [
                                            "Baisse de la valeur d’un actif ou d’un investissement en excès de la variabilité \\\"normale\\\", souvent à cause d’une réduction du crédit de l’émetteur d’un titre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
