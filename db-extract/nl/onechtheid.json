                "senses": [
                    {
                        "sense_id": "ec8cb9e3-6836-3eab-981e-8be3e6b3fd81",
                        "entry_id": "039ff78b-f135-363a-b524-4285d1b32dc3",
                        "glosses": [
                            "het waar zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4585e91-ca4e-45ee-9cab-497eb9b21f1f",
                                "sense_id": "ec8cb9e3-6836-3eab-981e-8be3e6b3fd81",
                                "text": "Volgens de stichting blijkt uit de literatuur dat veel kinderen tussen de 4 en 6 nog moeite hebben met het herkennen van onechtheid van filmpjes. Dat geldt nog sterker voor jongere kinderen."
                            }
                        ]
                    },
                    {
                        "sense_id": "9be74667-b0a3-3cdf-86ec-a614ec2a2669",
                        "entry_id": "039ff78b-f135-363a-b524-4285d1b32dc3",
                        "glosses": [
                            "het zich anders voordoen dan men echt is"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d9a7d2d0-c20b-4952-bcf9-3940192897b9",
                                "sense_id": "9be74667-b0a3-3cdf-86ec-a614ec2a2669",
                                "text": "Bovendien was iedereen die hem vroeger had gekend van mening dat hij in de laatste vijf jaar zeer in zijn voordeel veranderd was, dat hij zachtaardiger en mannelijker was geworden, dat hij nu die onechtheid, trots en spotzucht van vroeger miste, en dat hij de rust over zich had gekregen die met de jaren komt."
                            }
                        ]
                    },
                    {
                        "sense_id": "4758acaa-a14f-32d0-8a4e-8c92036f446d",
                        "entry_id": "039ff78b-f135-363a-b524-4285d1b32dc3",
                        "glosses": [
                            "iets wat niet waar is"
                        ],
                        "tags": [],
                        "examples": []
                    }
