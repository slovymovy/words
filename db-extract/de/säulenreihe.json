                        "examples": [
                            {
                                "example_id": "95432a98-bdd4-42bf-89ff-cd9abff8b664",
                                "sense_id": "089300ca-69cd-33b4-b4cb-8aedade778d4",
                                "text": "„Dies grosse, durch eine bogenüberspannte Säulenreihe in zwei Hälften geteilte, ganz mit Perserteppichen ausgeschlagene Zimmer war Pierre wohlbekannt.“"
                            },
                            {
                                "example_id": "dca991e6-43d9-45c9-9425-98098a576363",
                                "sense_id": "089300ca-69cd-33b4-b4cb-8aedade778d4",
                                "text": "„Er trat in ein Peristyl mit doppelter Säulenreihe, blieb vor mir stehen, musterte mich von Kopf bis zu den Füßen und von den Füßen bis zum Kopf und sagte dann nach kurzem Nachdenken: »Sie sind ein sehr schöner Mann.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
