                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "первое лицо единственного числа настоящего времени глагола 'flikken' (делать, совершать, часто в негативном контексте)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делаю",
                                "target_lang_sense_clarification": "общее значение действия"
                            },
                            {
                                "target_lang_word": "вытворяю",
                                "target_lang_sense_clarification": "совершаю что-то неожиданное или неприятное"
                            }
