                                            {
                                                "example_id": "d22fe393-6937-43f8-84e2-36d4634d3f86",
                                                "sense_id": "ba25fc93-7dbd-395c-ab3d-0999bf649fc9",
                                                "text": "I was fidgeting a bit, because three dogs were sniffing at my ankles in an interested fashion. They were going out to be kerbed[.]"
