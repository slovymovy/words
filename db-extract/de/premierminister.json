                "senses": [
                    {
                        "sense_id": "4bfaaca8-7281-3a07-b992-75428eafda5d",
                        "entry_id": "c55189f5-49ec-3f60-97df-5b2830a1bff6",
                        "glosses": [
                            "Premier ministre, titre porté par le chef du gouvernement dans certains États."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c40d394-4672-4a45-8dcf-6e15840538d4",
                                "sense_id": "4bfaaca8-7281-3a07-b992-75428eafda5d",
                                "text": "Es gibt ein Foto, das Olaf Scholz und den indischen Premierminister Narendra Modi am Rande des Treffens zeigt. Die beiden sitzen nahe beieinander am Wasser, Modi spricht mit großer Geste und Scholz hört aufmerksam zu.",
                                "translation": "Il existe une photo montrant Olaf Scholz et le Premier ministre indien Narendra Modi en marge de la réunion. Ils sont assis près l'un de l’autre au bord de l’eau, Modi parle avec de grands gestes et Scholz écoute attentivement."
                            },
                            {
                                "example_id": "3c9215a3-49dc-4d5b-86a9-aef80c297074",
                                "sense_id": "4bfaaca8-7281-3a07-b992-75428eafda5d",
                                "text": "Die Regierung unter Premierminister Tusk will das Abtreibungsrecht liberalisieren. Aber selbst in der Koalition gibt es keine einheitliche Linie",
                                "translation": "Le gouvernement du Premier ministre Tusk veut libéraliser le droit à l’avortement. Mais même au sein de la coalition, il n'y a pas de ligne uniforme"
                            }
                        ]
                    }
                ],
