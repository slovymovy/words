                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0c59d06-187f-4c20-9fcb-2dcc0c934d0a",
                                "sense_id": "13afc6cb-a67e-3c66-b0db-fb9c854e9b90",
                                "text": "„Ariowist gefiel sich in ihren fruchtbaren Fluren, und zog immer mehrere Landsleute an sich.“"
                            },
                            {
                                "example_id": "b9bd8734-391c-46f0-9af7-7d715b813638",
                                "sense_id": "13afc6cb-a67e-3c66-b0db-fb9c854e9b90",
                                "text": "„Aber Ariowist machte es wie der Mann in der Fabel, der dem Pferde gegen seinen Feind half, und nachher drauf sitzen blieb.“"
                            },
                            {
                                "example_id": "1308ebfa-40e3-4567-bc3f-b076cc321698",
                                "sense_id": "13afc6cb-a67e-3c66-b0db-fb9c854e9b90",
                                "text": "„Ich bin Gotwin und fahre in Gotenhafen ein. […] Bin der Ariowist der Geschichte und finde im Bischof zu Roma den Milchzahn der Geschichte wieder auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
