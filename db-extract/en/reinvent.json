                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38f82620-58af-4c16-bb35-bb84a99a815d",
                                                "sense_id": "28536da0-cf47-33c5-aaa9-d31aa3265174",
                                                "text": "Etwas zu erfinden ist weder als Kunst noch als Wissenschaft zu verstehen."
                                            },
                                            {
                                                "example_id": "7df43ec6-5d0a-4135-87e6-c00d7b831821",
                                                "sense_id": "28536da0-cf47-33c5-aaa9-d31aa3265174",
                                                "text": "Sie erfindet alle möglichen Hilfsmittel für Linkshänder."
                                            },
                                            {
                                                "example_id": "5cfcf6e2-f48a-4385-8914-ca688d26cb6d",
                                                "sense_id": "28536da0-cf47-33c5-aaa9-d31aa3265174",
                                                "text": "Der Schotte John Napier entdeckte die Logarithmen und erfand das Rechnen mit Logarithmentafeln."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e49bb32f-b5e8-3e67-a605-368e1e0ec09f",
                                        "entry_id": "d2285cf2-c373-3a04-89eb-b6af2a22d700",
                                        "glosses": [
                                            "sich etwas Unwahres ausdenken"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95adc1c0-4a7d-4ea3-8b38-820197077ccb",
                                                "sense_id": "e49bb32f-b5e8-3e67-a605-368e1e0ec09f",
                                                "text": "In deutschen Gerichtsshows im Fernsehen sind alle Fälle frei erfunden."
                                            },
                                            {
                                                "example_id": "68962ec8-722c-44bd-9eec-7d2eac1d9102",
                                                "sense_id": "e49bb32f-b5e8-3e67-a605-368e1e0ec09f",
                                                "text": "Ne, diese Geschichte hast du aber jetzt erfunden!"
                                            },
                                            {
