                "senses": [
                    {
                        "sense_id": "456f8d1a-8578-3693-b778-d0d12edb62c2",
                        "entry_id": "c732b2f4-d979-3879-bec2-686300d122ad",
                        "glosses": [
                            "eine oft höchstens einmal jährlich vorgenommene Untersuchung des Körpers eines beschwerdefreien Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee809f29-c174-413c-a44f-abbbec72d3ba",
                                "sense_id": "456f8d1a-8578-3693-b778-d0d12edb62c2",
                                "text": "Die Vorsorgeuntersuchung ergab, dass er einen Knoten in der Schilddrüse hatte, der derzeit harmlos ist."
                            },
                            {
                                "example_id": "556b59ac-860e-42ea-8542-a2f433f088a4",
                                "sense_id": "456f8d1a-8578-3693-b778-d0d12edb62c2",
                                "text": "„So was geht einem durch den Kopf, wenn man selbst in einem Berliner Wartezimmer sitzt und seiner Vorsorgeuntersuchung entgegensieht.“"
                            },
                            {
                                "example_id": "aacb5446-1bf4-443a-a468-917190ea1468",
                                "sense_id": "456f8d1a-8578-3693-b778-d0d12edb62c2",
                                "text": "„Die bevorstehende Vorsorgeuntersuchung bei meinem Hausarzt fiel mir ein; unser Streit neulich; allerlei Büroquerelen.“"
                            },
                            {
                                "example_id": "a7070b64-eab3-4f29-b397-196dfc102b59",
                                "sense_id": "456f8d1a-8578-3693-b778-d0d12edb62c2",
                                "text": "„Werdende Mütter gehen nicht mehr zu Vorsorgeuntersuchungen, weil das eine Anordnung der Weißen sei.“"
                            },
                            {
                                "example_id": "d6de10c8-7b0e-4a7b-baaa-0bf2fb49aaea",
                                "sense_id": "456f8d1a-8578-3693-b778-d0d12edb62c2",
                                "text": "„Bei den Geburten meiner Kinder war ich dabei und vor etwas über einem Jahr bei einer Vorsorgeuntersuchung beim Urologen.“"
                            },
                            {
                                "example_id": "7f66782b-bd4c-4907-a5ac-61e8e937f2fd",
                                "sense_id": "456f8d1a-8578-3693-b778-d0d12edb62c2",
                                "text": "„Empfohlen wird die Vorsorgeuntersuchung ab einem Alter von 45.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
