                "senses": [
                    {
                        "sense_id": "6e58fb7c-3406-375a-ae4b-30afa320d416",
                        "entry_id": "aac5bf45-adb9-3c0c-8e00-bed24a380807",
                        "glosses": [
                            "psychische Unruhe oder Anspannung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0eabdfaf-a372-4633-9616-e84bf66867dc",
                                "sense_id": "6e58fb7c-3406-375a-ae4b-30afa320d416",
                                "text": "Ich suche ein Medikament gegen Nervosität und Schlaflosigkeit."
                            },
                            {
                                "example_id": "15940403-55e6-449c-8ae5-53f891d9d631",
                                "sense_id": "6e58fb7c-3406-375a-ae4b-30afa320d416",
                                "text": "„Als wäre der Laden nie geschlossen gewesen, als wären wir immer da gewesen, öffnet sich die Tür, und herein kommen Menschen, die keine Ahnung davon haben, dass wir hier vor Nervosität fast vergehen.“"
                            },
                            {
                                "example_id": "5fb92181-bdef-426c-a4c8-9c38347b4201",
                                "sense_id": "6e58fb7c-3406-375a-ae4b-30afa320d416",
                                "text": "„Ledwina wird von ihrer eigenen Nervosität nahezu aufgezehrt.“"
                            },
                            {
                                "example_id": "2cbc3813-c261-47a8-9a3f-d5338ea15ba3",
                                "sense_id": "6e58fb7c-3406-375a-ae4b-30afa320d416",
                                "text": "„Enorme Nervosität hatte die Passanten erfasst, sodass jeder, der irgendwie oder auch gerade gar nicht auffiel, in den Verdacht geraten konnte, ein verdeckter Feind zu sein.“"
                            },
                            {
                                "example_id": "d759a03c-3eb4-4e87-a927-c81afd155dcc",
                                "sense_id": "6e58fb7c-3406-375a-ae4b-30afa320d416",
                                "text": "„Die Nervosität war von mir abgefallen und hatte einem Hochgefühl Platz gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
