                "senses": [
                    {
                        "sense_id": "bc6dfcb8-c745-3697-8772-a0394a9bb231",
                        "entry_id": "4cbba5e3-2723-3175-a728-f669b81dc484",
                        "glosses": [
                            "een vereniging van sportvissers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "410886eb-c269-42ef-8d10-ae88047de013",
                                "sense_id": "bc6dfcb8-c745-3697-8772-a0394a9bb231",
                                "text": "Twee verenigingen uit Nijmegen zijn bestolen door dezelfde man, die daar werkzaam was als penningmeester. De man stak bijna 25.000 euro in zijn zak van visclub 't Mokse Broek en verduisterde 19.500 euro van de Nijmeegse Bowlingvereniging."
                            },
                            {
                                "example_id": "54f3c124-3be4-4d54-8a40-6ec4149aca34",
                                "sense_id": "bc6dfcb8-c745-3697-8772-a0394a9bb231",
                                "text": "De psycholoog van Bob Smith adviseerde hem om lekker te gaan vissen. \"Het klopt dat dit je hoofd leeg maakt\", schrijft hij Niet dat hij altijd wat vangt, maar hij geniet er toch van. Visclubs maken er op de radio zelfs reclame voor. Vindt u vissen een goed tijdverdrijf?"
                            },
                            {
                                "example_id": "d8e29cd4-3b77-4005-9892-424b86965818",
                                "sense_id": "bc6dfcb8-c745-3697-8772-a0394a9bb231",
                                "text": "Vrouwelijk lid visclub ontvlucht Woudrichem: Een vrouw uit Woudrichem die bij hoge uitzondering werd toegelaten tot een visserijvereniging voor mannen, is na een hoogopgelopen ruzie met conservatieve dorpsgenoten halsoverkop uit het stadje vertrokken. Nanka van de Meer vertrok met al haar hengels."
                            }
                        ]
                    }
