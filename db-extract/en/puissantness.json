                        "examples": [
                            {
                                "example_id": "2b6ac1f0-3ed5-42a1-926e-81bc42728154",
                                "sense_id": "36f24c98-c6ed-3442-a9d6-c96ec540a458",
                                "text": "We hear of great stirs in those parts; and how the Emperor, a prince of great wisdom and great power, hath been driven to extreme shifts; and that by the policy of mean men, who were thought to be his friends, and not by the puissantness of others who were known to be his open enemies."
                            },
                            {
                                "example_id": "669686ee-a13e-4480-9791-672426b89fda",
                                "sense_id": "36f24c98-c6ed-3442-a9d6-c96ec540a458",
                                "text": "“Look,” said Terne, sounding as though he spoke through clenched teeth, “are you begging for a private audience with her puissantness? Is that what you want? I'm telling you to.be sober for a while. You pick a side and you stay on it, you hear me, Hul?\""
                            },
                            {
                                "example_id": "0d794e82-efbb-4f0b-8f9b-d9bfde04cee7",
                                "sense_id": "36f24c98-c6ed-3442-a9d6-c96ec540a458",
                                "text": "‘Yeah, we'll bring the stuff; you bring the puissantness,’ Shaunee said, giving Damien a smartass look."
                            },
                            {
                                "example_id": "47d6cecb-3c2d-401f-bead-d8f62ac53fbe",
                                "sense_id": "36f24c98-c6ed-3442-a9d6-c96ec540a458",
                                "text": "The name of Wuwei is from the “brilliant military puissantness” of the General Huo Qubin in the Han Dynasty to defeat the Xunnu ethnic group invader in the ancient Hexi Corridor."
                            }
                        ]
                    }
