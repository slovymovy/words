                ],
                "senses": [
                    {
                        "sense_id": "1b9f4e61-3058-3a33-807e-590ac29fb7af",
                        "entry_id": "5f6cd5c5-e696-3ed8-8c9c-cabffaad3c5c",
                        "glosses": [
                            "Qui n’a qu’un œil, d’un seul œil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e830e7e-d42a-4e44-8952-5ea7d0eb8b5e",
                                "sense_id": "1b9f4e61-3058-3a33-807e-590ac29fb7af",
                                "text": "M. Dufour communique l’observation d’un cas remarquable de triplopie monoculaire, qu’il eut l’occasion d’analyser et de traiter dans la clinique du professeur de Græfe."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d4cc680-dd88-3a23-87c2-0406c7f8b370",
                        "entry_id": "5f6cd5c5-e696-3ed8-8c9c-cabffaad3c5c",
                        "glosses": [
                            "Qui ne concerne qu’un œil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01b8e560-a6d3-4b26-abb0-a45ef812af02",
                                "sense_id": "8d4cc680-dd88-3a23-87c2-0406c7f8b370",
                                "text": "L’écart des chiffres pour les deux sexes est beaucoup moins considérable dans la cécité binoculaire que dans la cécité monoculaire."
                            },
                            {
                                "example_id": "83dc154e-e5e9-457a-bfd9-a3ebb777eb38",
                                "sense_id": "8d4cc680-dd88-3a23-87c2-0406c7f8b370",
                                "text": "L’acuité visuelle est plus élevée en vision binoculaire qu’en vision monoculaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e600c9e7-ce93-4416-89dd-be100208d4f9",
                        "source_entry_id": "5f6cd5c5-e696-3ed8-8c9c-cabffaad3c5c",
                        "target_lang_word": "monokular",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monokular",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "86a6967e-ca8e-30c2-b73c-1c0aec9f5a3e",
                                        "entry_id": "895381f8-6ab1-3af5-ab72-433ac79dbfad",
                                        "glosses": [
                                            "mit einem Auge erfolgend; ein Auge betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaa8c02b-75d5-49bc-9926-640dcb3b022e",
                                                "sense_id": "86a6967e-ca8e-30c2-b73c-1c0aec9f5a3e",
                                                "text": "Nach der Treffertheorie ist binokular eine höhere Sehschärfe gegenüber monokular nur bei geringen Leuchtdichten zu erwarten, bei höheren dagegen nicht mehr, sobald die Trefferwahrscheinlickeit gleich 1 wird."
                                            },
                                            {
                                                "example_id": "51d220cb-3725-4f1d-a0b8-90690e1bd494",
                                                "sense_id": "86a6967e-ca8e-30c2-b73c-1c0aec9f5a3e",
                                                "text": "Dabei wird der Visus in der Regel ohne und mit (Voll-) Korrektion monokular und binokular für die Ferne sowie gegebenenfalls zusätzlich für die Nähe geprüft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "58ef50b9-0528-3e85-9879-02842de49905",
                                        "entry_id": "895381f8-6ab1-3af5-ab72-433ac79dbfad",
                                        "glosses": [
                                            "für das Sehen mit einem Auge bestimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6067307c-1898-4cb3-9184-b105d0c6b435",
                                                "sense_id": "58ef50b9-0528-3e85-9879-02842de49905",
                                                "text": "Ferngläser haben zwei Okulare (und Objektive), monokulare Ferngläser – z.B. Spektive oder manche Taschenferngläser – nur eines."
                                            },
                                            {
                                                "example_id": "28e0424e-069b-4b66-9e7e-ca5c5c168b00",
                                                "sense_id": "58ef50b9-0528-3e85-9879-02842de49905",
                                                "text": "Er benutzte als erster Arzt ein monokulares Mikroskop (monokulares Sehen) während einer Operation und gilt daher auch als der \"Vater\" der Mikrochirurgie."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2845b826-bbbc-4578-bd98-caebad6ec53f",
                        "source_entry_id": "5f6cd5c5-e696-3ed8-8c9c-cabffaad3c5c",
