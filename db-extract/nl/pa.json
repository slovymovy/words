                                        "sense_id": "e9b3e3bd-016b-3c32-bb1e-d3630816b84c",
                                        "entry_id": "38d8630d-94da-3a96-b525-be56f61b57ff",
                                        "glosses": [
                                            "A fortified Maori settlement, especially of pre-European times."
                                        ],
                                        "tags": [
                                            "New-Zealand",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "148b06af-17b9-44d2-a6cb-9341fe5ab162",
                                                "sense_id": "e9b3e3bd-016b-3c32-bb1e-d3630816b84c",
                                                "text": "The very existence of fortified pā was often a sign that those who lived near such complexes sought to discourage attack and wanted to make conflict less likely, not more so."
                                            },
                                            {
                                                "example_id": "958a76f9-04ef-44e0-b662-f86cdf96cd73",
                                                "sense_id": "e9b3e3bd-016b-3c32-bb1e-d3630816b84c",
                                                "text": "A pa or Māori defence fortification appears at a height on the hill above the bay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98246ec2-fa1c-39c7-a90c-64a6a2dc914f",
                                        "entry_id": "38d8630d-94da-3a96-b525-be56f61b57ff",
                                        "glosses": [
