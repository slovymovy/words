    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d026bc4b-56cf-301e-b9f4-1ccc81009158",
                    "sense_definition": "Numériser un document ou une image à l'aide d'un appareil électronique pour obtenir un fichier informatique.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "numerisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je dois <w>scanner</w> ma pièce d'identité pour compléter mon dossier en ligne."
                        },
                        {
                            "text": "Elle a <w>scanné</w> toutes les vieilles photos de famille pour créer un album numérique."
                        }
                    ],
                    "synonyms": [
                        "scannériser"
                    ],
                    "common_phrases": [
                        "scanner un document",
                        "scanner une photo",
                        "scanner un fichier"
                    ]
                },
                {
                    "sense_id": "91b8cbdf-4a67-3a1c-8c25-01a0fbb2284f",
                    "sense_definition": "Lire une information encodée, comme un code-barres ou un code QR, au moyen d'un capteur optique.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "numerisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veuillez <w>scanner</w> votre billet électronique devant la borne avant de monter dans le train."
                        },
                        {
                            "text": "L'employé <w>scanne</w> rapidement chaque article pour enregistrer les prix à la caisse."
                        }
                    ],
                    "common_phrases": [
                        "scanner un code-barres",
                        "scanner un code QR"
                    ]
                },
                {
                    "sense_id": "9b887bcd-f18c-377e-92bc-bf3b08da1eab",
                    "sense_definition": "Inspecter un objet, un bagage ou une partie du corps à l'aide de rayons X ou d'un dispositif d'imagerie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "examen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au point de contrôle de l'aéroport, les agents ont <w>scanné</w> tous nos bagages à main."
                        },
                        {
                            "text": "Le spécialiste a décidé de <w>scanner</w> la cheville du joueur afin d'évaluer la blessure."
                        }
                    ],
                    "common_phrases": [
                        "scanner les bagages"
                    ]
                },
                {
                    "sense_id": "5bcc6a34-ca82-3d93-825a-e91b8f9e5ea6",
                    "sense_definition": "Observer ou scruter un lieu ou des personnes de façon attentive et systématique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "examen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le détective <w>scannait</w> la foule attentivement pour repérer la moindre attitude suspecte."
                        },
                        {
                            "text": "Dès son entrée dans la salle, son regard <w>scanne</w> l'assistance à la recherche d'un ami."
                        }
                    ],
                    "common_phrases": [
                        "scanner la foule",
                        "scanner du regard"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ef41b24b-d50e-3b5d-8174-44bd0041fcc3",
                    "sense_definition": "Appareil d'imagerie médicale utilisant les rayons X pour produire des images détaillées en coupe du corps humain.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "imagerie_medicale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'hôpital vient d'installer un nouveau <w>scanner</w> plus moderne dans son service de radiologie."
                        },
                        {
                            "text": "Le patient est allongé immobile à l'intérieur du grand <w>scanner</w> pendant l'analyse."
                        }
                    ],
                    "common_phrases": [
                        "salle du scanner",
                        "passer au scanner"
                    ]
                },
                {
                    "sense_id": "82699680-b8c1-332e-aaac-9a1b3d888f5e",
                    "sense_definition": "Examen médical d'imagerie radiologique réalisé au moyen de cet appareil.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "imagerie_medicale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin m'a prescrit un <w>scanner</w> pour vérifier l'état de mes vertèbres lombaires."
                        },
                        {
                            "text": "Les résultats du <w>scanner</w> ont immédiatement écarté tout risque d'hémorragie interne."
                        }
                    ],
                    "common_phrases": [
                        "passer un scanner",
                        "faire un scanner",
                        "résultats du scanner"
                    ]
                }
            ]
        }
    ]
