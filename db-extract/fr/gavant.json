                "senses": [
                    {
                        "sense_id": "14e134e9-5aed-37b1-b324-0027dbaecea8",
                        "entry_id": "6d42c795-b1bb-3423-bdf7-99d7e0f234c4",
                        "glosses": [
                            "Qui gave de nourriture (souvent utilisé pour qualifier un comportement maternel)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbdc87da-3e6d-43f1-b196-a81e604e75a4",
                                "sense_id": "14e134e9-5aed-37b1-b324-0027dbaecea8",
                                "text": "La mère gavante fait l’unanimité des critiques contre elle parce qu’elle perturbe l’apprentissage des processus de régulation alimentaire."
                            },
                            {
                                "example_id": "ba4356aa-a927-4611-8a46-c5993fcd9d9c",
                                "sense_id": "14e134e9-5aed-37b1-b324-0027dbaecea8",
                                "text": "Elle a été jusque là assez présente, mais aussi suffisamment absente, nourricière mais pas gavante, pour ne pas représenter un danger, celui de sa disparition comme celui de l’étouffement."
                            }
                        ]
                    },
                    {
                        "sense_id": "07baa6c6-4882-3e04-a971-c9cd7953f4e4",
                        "entry_id": "6d42c795-b1bb-3423-bdf7-99d7e0f234c4",
                        "glosses": [
                            "Qui gave, dans le sens d’excéder, ennuyer."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "6bc19f0d-7cac-425b-8466-3c03b10127b5",
                                "sense_id": "07baa6c6-4882-3e04-a971-c9cd7953f4e4",
                                "text": "Ben, oui, ça existe aussi chez les rats et les humains n’ont pas le monopole des comportements gavants !"
                            },
                            {
                                "example_id": "8c60e4d2-4791-4637-853e-bc5c97f2bce4",
                                "sense_id": "07baa6c6-4882-3e04-a971-c9cd7953f4e4",
                                "text": "«Un + Une», les Indes gavantes de Lelouch : déconnecté du réel, le cinéaste en balade s’englue dans un chromo néocolonial."
                            }
                        ]
                    }
                ],
