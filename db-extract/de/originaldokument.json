                "senses": [
                    {
                        "sense_id": "58aa0855-72e4-30e7-b51a-3c7287c7b9ac",
                        "entry_id": "a46f7c0c-194e-3be4-aca6-970465e33709",
                        "glosses": [
                            "ursprüngliche, zuerst angefertigte Version eines Dokuments"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ead5c216-af1d-4b49-aa3e-445d5d0cb77b",
                                "sense_id": "58aa0855-72e4-30e7-b51a-3c7287c7b9ac",
                                "text": "„Tarullo wandte ein, dass Crane lediglich Kopien von den Originaldokumenten vorlegte und dass diese als Beweisstücke nicht zulässig seien.“"
                            },
                            {
                                "example_id": "e880ac92-3632-42b9-9d47-12bd7adcda00",
                                "sense_id": "58aa0855-72e4-30e7-b51a-3c7287c7b9ac",
                                "text": "„›Die Schwärzungen sind bereits in den Originaldokumenten.‹“"
                            },
                            {
                                "example_id": "277bdfdd-fe7d-4f74-bae0-c9c7a7e3fd53",
                                "sense_id": "58aa0855-72e4-30e7-b51a-3c7287c7b9ac",
                                "text": "„Andererseits sind in den vergangenen 500 Jahren viele Originaldokumente verloren gegangen, und es stehen auch keine baulichen Zeugnisse aus aztekischer Zeit mehr unversehrt für unsere unmittelbare Anschauung bereit.“"
                            },
                            {
                                "example_id": "8f71b6af-c780-4de6-bfd2-de8dddeaa483",
                                "sense_id": "58aa0855-72e4-30e7-b51a-3c7287c7b9ac",
                                "text": "„›Könnten wir einen BLick auf das Originaldokument werfen?‹, fragte Graber.“"
                            },
                            {
                                "example_id": "989f1575-d49d-432e-a1c0-53e685aaa3e9",
                                "sense_id": "58aa0855-72e4-30e7-b51a-3c7287c7b9ac",
                                "text": "„Alle relevanten Informationen werden jedoch im Weiteren angeführt, und Du darfst versichert sein, dass die Originaldokumente ausnahmslos in meiner Hand sind, falls Du später einmal darauf zurückgreifen möchtest.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
