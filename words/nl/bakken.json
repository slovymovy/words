                    "semantic_group_id": "crafting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kunstenaar <w>bakte</w> prachtige vazen in zijn eigen oven.",
                            "target_lang_translations": {
                                "en": "The artist <w>fired</w> beautiful vases in his own kiln.",
                                "ru": "Художник <w>обжигал</w> прекрасные вазы в своей собственной печи.",
                                "pl": "Artysta <w>wypalał</w> piękne wazy we własnym piecu.",
                                "de": "Der Künstler <w>brannte</w> wunderschöne Vasen in seinem eigenen Ofen.",
                                "fr": "L'artiste <w>cuisait</w> de magnifiques vases dans son propre four.",
                                "it": "L'artista <w>cuoceva</w> bellissimi vasi nel suo forno.",
                                "cs": "Umělec ve své vlastní peci <w>vypaloval</w> krásné vázy.",
