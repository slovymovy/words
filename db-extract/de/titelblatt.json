                    {
                        "sense_id": "f27d55a4-182c-3c98-9bcc-fc2cf0f9d679",
                        "entry_id": "76191030-5518-3b25-8c7b-0e06ce11c818",
                        "glosses": [
                            "Blatt am Anfang eines Buches, auf dem (mindestens) Autor/Herausgeber und Titel aufgeführt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b98eb0f-76e1-4811-9498-536f776f0741",
                                "sense_id": "f27d55a4-182c-3c98-9bcc-fc2cf0f9d679",
                                "text": "„Es wäre doch eine nette Überraschung, wenn der Gatte als Stimulans für die Genesung das fertige Buch mit seinem Namen auf dem Titelblatt bald in Händen hätte.“"
                            },
                            {
                                "example_id": "f37e416f-347a-4e24-bcf4-1450faff035b",
                                "sense_id": "f27d55a4-182c-3c98-9bcc-fc2cf0f9d679",
                                "text": "„Das Titelblatt dieser 1522 in Wittenberg herausgebrachten bilderstürmerischen Schrift ist geschmückt mit einem Bild.“"
                            }
                        ],
