                ],
                "senses": [
                    {
                        "sense_id": "3d897920-2926-3276-ab96-9c5fff35e6b3",
                        "entry_id": "991dc74a-5bd9-3d32-abc9-0bf56608cd4d",
                        "glosses": [
                            "Verstärker für schwache Elektronenströme, auch als Komponente eines Fotovervielfachers"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "2609da0b-46f8-4d76-a0cb-02ebaf71755d",
                                "sense_id": "3d897920-2926-3276-ab96-9c5fff35e6b3",
                                "text": "„Ein fokussierendes elektrisches Feld in der Driftkammer (18) ermöglicht eine Reduzierung der Detektorfläche gegenüber dem Elektronenvervielfacher und die Erzeugung gewünschter Projektionseigenschaften.“"
                            },
                            {
                                "example_id": "c5ac344e-1b6c-4c3e-b81a-d13a8694a284",
                                "sense_id": "3d897920-2926-3276-ab96-9c5fff35e6b3",
                                "text": "„Elektronenvervielfacher (1) für ein Rasterelektronenmikroskop (10), der einen Elektronenstrahl (B) zu einer Probe (2) aussendet und ein Bild der Probe (2) erzeugt, wobei der Elektronenvervielfacher (1) umfaßt: […].“"
                            },
                            {
                                "example_id": "8fdd19c9-3f8a-46b3-a503-05ed2029decb",
                                "sense_id": "3d897920-2926-3276-ab96-9c5fff35e6b3",
                                "text": "„Stattdessen müssen Elektronenvervielfacher benutzt werden, die eine erheblich größere Empfindlichkeit aufweisen.“"
                            },
                            {
                                "example_id": "adf06533-455e-465a-b963-f27ea6799c50",
                                "sense_id": "3d897920-2926-3276-ab96-9c5fff35e6b3",
                                "text": "„Sie wissen wahrscheinlich, dass Elektronenvervielfacher die 'Augen' eines Massenspektrometers sind und jedes Ion der selektierten Masse erkennen, die am Massenfilter vorbei geführt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
