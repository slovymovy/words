            {
                "entry_id": "9c7fc541-be27-31da-ad83-ab9eb038eec5",
                "word": "Phan",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e4f8da24-1465-4d29-9a1a-8d9e6a619e29",
                        "entry_id": "9c7fc541-be27-31da-ad83-ab9eb038eec5",
                        "tags": [
                            "plural"
                        ],
                        "form": "Phans"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2e654151-d625-3462-8e8c-14d473f3a596",
                        "entry_id": "9c7fc541-be27-31da-ad83-ab9eb038eec5",
                        "glosses": [
                            "A fan of the American rock band Phish."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "fe18dc4a-79ad-4de5-95fb-25e6f0b0a76c",
                                "sense_id": "2e654151-d625-3462-8e8c-14d473f3a596",
                                "text": "Phish \"phans\" compile set lists, take notes on performances and tape-record everything from a section designated for them at each show."
                            },
                            {
                                "example_id": "bda0ab67-0b49-418b-bd13-0d2266be3d5f",
                                "sense_id": "2e654151-d625-3462-8e8c-14d473f3a596",
                                "text": "But none were as crazy as this one -- when Phish's tie-dyed \"Phans\" danced in the aisles, sang along to the music and generally created a scene that recalled the Grateful Dead's glory daze."
                            },
                            {
                                "example_id": "7fa4206b-5a5b-4116-82c5-53aa0c3a71cd",
                                "sense_id": "2e654151-d625-3462-8e8c-14d473f3a596",
                                "text": "It was the type of evening -- an entirely mesmerizing and moving two-set concert filled with superb musicianship and incredible improvisation -- that made the undying devotion of the \"phans\" seem quite logical."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "785b4b6f-54d4-4e5b-9a5c-f4f747dd0ec0",
                        "source_entry_id": "9c7fc541-be27-31da-ad83-ab9eb038eec5",
                        "source_sense_ids": [
                            "2e654151-d625-3462-8e8c-14d473f3a596"
                        ],
                        "linkage_type": "synonyms",
                        "word": "Phishhead"
                    }
                ]
