                "senses": [
                    {
                        "sense_id": "1f2b40bf-40c4-3f89-b2b4-4e10e91ac6d2",
                        "entry_id": "2e318b30-03fd-328e-bcfc-d97349f7af2c",
                        "glosses": [
                            "ruimte in een gebouw waar men gasten welkom heet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3492182f-0c81-4d50-b6e6-1c9893f7b891",
                                "sense_id": "1f2b40bf-40c4-3f89-b2b4-4e10e91ac6d2",
                                "text": "De twee kamerdienaren kleedden zijne majesteit snel aan, en hij begaf zich in het blauwe uniform van de garde met ferme, snelle pas naar de ontvangstruimte."
                            },
                            {
                                "example_id": "9d58da84-2f72-4e84-a35d-416127f0f09e",
                                "sense_id": "1f2b40bf-40c4-3f89-b2b4-4e10e91ac6d2",
                                "text": "De bouw van een nieuwe ontvangstruimte onder de grond bij de Nieuwe Kerk in Delft mag doorgaan. De Raad van State stelt dat de vergunning voor de ingrijpende verbouwing terecht is verleend."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62d8990a-94e1-4b2e-a2d3-38f784faea40",
                        "source_entry_id": "2e318b30-03fd-328e-bcfc-d97349f7af2c",
                        "source_sense_id": "1f2b40bf-40c4-3f89-b2b4-4e10e91ac6d2",
                        "source_sense_description": "ruimte in een gebouw waar men gasten welkom heet",
                        "target_lang_word": "waiting-room",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "waiting-room",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2292af9-769e-375c-86da-1fc2454c0963",
                                        "entry_id": "7fc47480-17e7-3a1f-8074-405efe187f3f",
                                        "glosses": [
                                            "Dated form of waiting room."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09d9f28d-1f3f-47fe-98b0-c5acc8f55562",
                                                "sense_id": "f2292af9-769e-375c-86da-1fc2454c0963",
                                                "text": "In the third place, by its situation it serves only for a waiting-room, and a passage to the principal apartments, instead of being reserved, as it ought to be, for entertaining company […]"
                                            },
                                            {
                                                "example_id": "f187c53a-9267-4804-b30c-8ab86ff3ea56",
                                                "sense_id": "f2292af9-769e-375c-86da-1fc2454c0963",
                                                "text": "The division bell was still ringing; peers and diplomatists and strangers were turned out; members came rushing in from library and smoking-room; some desperate cabs just arrived in time to land their passengers in the waiting-room."
                                            },
                                            {
                                                "example_id": "9e019b90-cab5-461f-84ec-c294a2e37f68",
                                                "sense_id": "f2292af9-769e-375c-86da-1fc2454c0963",
                                                "text": "\"Look keerfully arter that baggage, Kernel,\" said the expressman, with affected concern, as he looked after Colonel Starbottle, gloomily bringing up the rear of the triumphant procession to the waiting-room. Mr. Hamlin did not stay for dinner."
                                            },
                                            {
                                                "example_id": "eea0066c-f77e-4a6f-b49c-efd405f72473",
                                                "sense_id": "f2292af9-769e-375c-86da-1fc2454c0963",
                                                "text": "Her dress was as plain as an umbrella-cover, and she turned round without a word and preceded me into a waiting-room."
                                            },
                                            {
                                                "example_id": "cc9ba6d1-9e41-4518-862a-8ba1e2f88ee0",
                                                "sense_id": "f2292af9-769e-375c-86da-1fc2454c0963",
                                                "text": "She walked into the waiting-room of the ferry, and up the stairs, and by a marvellous swift, little run, caught the ferry-boat that was just going out."
                                            },
                                            {
                                                "example_id": "293bd584-8207-47ff-a19c-1b7cc74cf866",
                                                "sense_id": "f2292af9-769e-375c-86da-1fc2454c0963",
                                                "text": "Over on that platform's the general waiting-room,... and over there's the Gentlemen's, and, any'ow, everythink's written up."
                                            },
                                            {
                                                "example_id": "8e4c03b5-c33b-492b-824c-79ce18ff1c9b",
                                                "sense_id": "f2292af9-769e-375c-86da-1fc2454c0963",
                                                "text": "The waiting-room was now less empty than Watt had at first supposed, to judge by the presence, some two paces to Watt's fore, and as many to his right, of what seemed to be an object of some importance."
                                            },
                                            {
                                                "example_id": "b6ed2a4b-9450-4ecd-8f25-c99a5c920f14",
                                                "sense_id": "f2292af9-769e-375c-86da-1fc2454c0963",
                                                "text": "There his chains would be removed and he would be ushered into the waiting-room for a five-minute chat with his wife surrounded on all sides by security men and civilian-clad prison warders."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f81a5f2-45bb-4be3-b9a1-19e831a72767",
                        "source_entry_id": "2e318b30-03fd-328e-bcfc-d97349f7af2c",
