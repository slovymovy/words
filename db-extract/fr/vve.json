                        "glosses": [
                            "Veuve, dans l’expression « Madame veuve + nom patronymique »."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "219adc1f-fa22-466d-9242-6920974fd4df",
                                "sense_id": "921fd921-71de-3a5f-86c5-dc02c4a7bad0",
                                "text": "Mme Vᵛᵉ Justin Dupont est désormais présidente de la société bâtie par feu son mari."
                            },
                            {
                                "example_id": "3c8fabd9-26da-4483-9725-acdd4e117562",
                                "sense_id": "921fd921-71de-3a5f-86c5-dc02c4a7bad0",
                                "text": "Les créanciers de feu Saliba Michel, Grand-Goàve, connu jusqu’à cette date, ayant décidé la liquidation de ses affaires, d’accord avec Mme Vve Saliba Michel, prient tout autre créancier qui pouvait être intéressé de se faire inscrire chez la sous-dite maison en présentant un document prouvant la dette de Saliba Michel."
                            },
                            {
                                "example_id": "f216445f-edb7-4521-8b41-ac98a6951ece",
                                "sense_id": "921fd921-71de-3a5f-86c5-dc02c4a7bad0",
                                "text": "Il s'agissait de Mlle Salomé Forut. On avait seulement rajouté au crayon feutre rouge, en dessous : et Mme Vve Rezeau."
                            }
                        ]
                    }
