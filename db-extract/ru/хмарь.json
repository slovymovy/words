                "senses": [
                    {
                        "sense_id": "b0ab6d71-e6f9-3ba7-a524-6a4672587bc2",
                        "entry_id": "5674f221-1e1d-332f-81fc-5d6bf1ebf094",
                        "glosses": [
                            "рег. пелена туч"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0edb9a42-a451-461e-b5fd-978ea19aa1fb",
                                "sense_id": "b0ab6d71-e6f9-3ba7-a524-6a4672587bc2",
                                "text": "Тогда серая хмарь плотно надвинулась и закрыла всё солнце с его живительными лучами."
                            }
                        ]
                    },
                    {
                        "sense_id": "bee4a3df-fa67-3728-88f1-c0df6d05c3d9",
                        "entry_id": "5674f221-1e1d-332f-81fc-5d6bf1ebf094",
                        "glosses": [
                            "мгла, пелена тумана"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2278da62-e70e-4745-bfd8-f5e18592054a",
                                "sense_id": "bee4a3df-fa67-3728-88f1-c0df6d05c3d9",
                                "text": "Туманная хмарь застила слабую краску зари."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d915999e-aa29-4add-abde-5a2ede9bb546",
                        "source_entry_id": "5674f221-1e1d-332f-81fc-5d6bf1ebf094",
