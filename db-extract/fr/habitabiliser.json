                "senses": [
                    {
                        "sense_id": "d4d03fc3-2986-3340-ac78-1e45e174f0aa",
                        "entry_id": "f1853623-60a8-3928-baa5-93252afc3dac",
                        "glosses": [
                            "Rendre habitable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca766955-9eba-4afe-8320-3b9eb9ea0847",
                                "sense_id": "d4d03fc3-2986-3340-ac78-1e45e174f0aa",
                                "text": "Sur cette question, nous retenons des travaux menés dans le domaine des études culturelles, comme la définition que donne MacGregor de « home », notion qui dépasse le simple cadre matériel pour insister sur la dimension psychique de cet acte, qui transformerait le simple fait d’habiter un lieu en celui de l’habitabiliser, c’est-à-dire de le faire sien, de l’investir psychiquement tout autant que physiquement."
                            },
                            {
                                "example_id": "85e5ec12-714b-44a0-a41f-16c5b701b21a",
                                "sense_id": "d4d03fc3-2986-3340-ac78-1e45e174f0aa",
                                "text": "Elle tire parti des énergies et des situations ambiantes pour « habitabiliser » l'espace."
                            },
                            {
                                "example_id": "74c18d8f-64fd-4b06-b23e-a9950acb7fbe",
                                "sense_id": "d4d03fc3-2986-3340-ac78-1e45e174f0aa",
                                "text": "A LA RECHERCHE D'UNE INSTALLATION CHAUFFAGE DANS DEPOT à HABITABILISER AFIN DE FAIRE UN BEL APPARTEMENT."
                            }
                        ]
                    }
