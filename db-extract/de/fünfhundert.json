                                        "sense_id": "e894c160-8a7b-3841-a962-915b09300536",
                                        "entry_id": "e880bc24-cb35-3442-a2e4-fbd63fbb1ccf",
                                        "glosses": [
                                            "A trick-taking card game with elements of euchre and bridge."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "824d0eaa-6d03-4e1d-b2cd-739364543acd",
                                                "sense_id": "e894c160-8a7b-3841-a962-915b09300536",
                                                "text": "Gallipoli von Kessler asked him if he had thought of playing five hundred, saying that though some people said that five hundred was perhaps a brainier game than crib, he didn’t necessarily agree, but it might be more Rooster’s fancy. It was really bridge without the bad company."
                                            }
