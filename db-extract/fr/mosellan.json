                    {
                        "sense_id": "6689d96e-5373-3268-a730-da25895ed714",
                        "entry_id": "9bb93989-e37e-3703-ab1d-2d9b55d692f0",
                        "glosses": [
                            "Habitant du département de la Moselle, ou personne originaire de ce département."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af5855a1-6d2e-4060-a7ff-64de87ade2ea",
                                "sense_id": "6689d96e-5373-3268-a730-da25895ed714",
                                "text": "Quand des Alsaciens ou des Mosellans se précipitaient dans le Bade-Wurtemberg, la Sarre ou la Rhénanie-Palatinat pour faire le plein, chercher du tabac ou acheter des produits d’hygiène…"
                            },
                            {
                                "example_id": "0deb4fe1-e9a8-4d23-8726-0954a2b8df26",
                                "sense_id": "6689d96e-5373-3268-a730-da25895ed714",
                                "text": "Un Mosellan est assez différent d'un Meusien et d'un Vosgien."
                            },
                            {
                                "example_id": "59330534-a174-459f-87be-8b80018bada1",
                                "sense_id": "6689d96e-5373-3268-a730-da25895ed714",
                                "text": "Parmi eux, le LR le mieux élu en 2022: le Mosellan Fabien Di Filippo, 36 ans, proche de Laurent Wauquiez."
                            }
                        ]
                    }
