                "senses": [
                    {
                        "sense_id": "4bfa141d-f3f0-355a-9d41-f310e7b13afc",
                        "entry_id": "e2e51c38-6cfd-3656-8c80-ad92fa51ffe7",
                        "glosses": [
                            "vorangestellter Name (Vorname) einer Person im alten Rom"
                        ],
