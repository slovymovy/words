                "senses": [
                    {
                        "sense_id": "012fd34d-46a2-3d25-84e6-095559fce113",
                        "entry_id": "98fc4434-6252-32e4-8cb2-96416ac36f60",
                        "glosses": [
                            "Fine red dust, found in desert regions of Australia."
                        ],
                        "tags": [
                            "Australia",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "152ffeec-50a4-4844-9916-20f0accaf5ca",
                                "sense_id": "012fd34d-46a2-3d25-84e6-095559fce113",
                                "text": "Bulldust is like talcum powder and it covers the holes in the road. No matter how carefully we drove, the bulldust rose in the air and cascaded down over our vehicle to the extent that we sometimes used the wipers to clear the windscreen."
                            },
                            {
                                "example_id": "d9629c75-5f05-484d-9c9b-da188c51e740",
                                "sense_id": "012fd34d-46a2-3d25-84e6-095559fce113",
                                "text": "Road trains are over 50 m long when towing three trailers. On dirt roads, they trail a blinding cloud of bulldust and window smashing, fist-size stones."
                            },
                            {
                                "example_id": "8eadddb6-11b0-4511-9379-0fbf3221a54b",
                                "sense_id": "012fd34d-46a2-3d25-84e6-095559fce113",
                                "text": "The bulldust was starting to get really thick now and even thicker in the back of the Hudson! It got into everything."
                            }
                        ]
                    },
                    {
                        "sense_id": "22654f52-0436-3c65-9eff-1b32febce902",
                        "entry_id": "98fc4434-6252-32e4-8cb2-96416ac36f60",
                        "glosses": [
                            "Nonsense; blatantly false statements."
                        ],
                        "tags": [
                            "Australia",
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "90d91c20-38da-47d7-805a-24a120418dea",
                                "sense_id": "22654f52-0436-3c65-9eff-1b32febce902",
                                "text": "She was told some bulldust. The same bulldust they tell any dickhead willing to part with money: that she'd be rich one day and live to a ripe old age."
                            },
                            {
                                "example_id": "132ea631-f26f-4408-af78-8d4288469b43",
                                "sense_id": "22654f52-0436-3c65-9eff-1b32febce902",
                                "text": "“Your theory is bulldust, Arthur,” said Pancho. “Nothing but bulldust. You should play your best doubles players even if they are playing singles. If they are fit, they are not going to be too tired. McEnroe would not have lost that match.”"
                            },
                            {
                                "example_id": "447f30c5-0c56-4a9b-b3cf-41537c0575da",
                                "sense_id": "22654f52-0436-3c65-9eff-1b32febce902",
                                "text": "In these harsh times of economic rationalism (sacking), restructuring (sacking) and merit-assessed and incentive-based liquidation and redirecting of human resources (sacking), the bulldust detector is invaluable."
                            }
                        ]
                    }
