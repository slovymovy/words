                ],
                "senses": [
                    {
                        "sense_id": "fa6fd28a-4dc2-3915-ae52-1f242f2cf46e",
                        "entry_id": "a0eefdbe-d924-3250-bf19-576efbf4637c",
                        "glosses": [
                            "Déformation de l’adverbe plus."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "4a91bb1a-6bb5-469d-a70b-fa75f3e37196",
                                "sense_id": "fa6fd28a-4dc2-3915-ae52-1f242f2cf46e",
                                "text": "C’est rudement joli la ville de Boussac ! c’est la p’u brave ville que j’asse pas connaissue."
                            },
                            {
                                "example_id": "ee6cb8df-7c81-4b9f-9159-32ef9336c226",
                                "sense_id": "fa6fd28a-4dc2-3915-ae52-1f242f2cf46e",
                                "text": "— Faut pas trop traîner pour arranger la chose, mon fi. J’ai pu guère de temps à vivre : on s’imagine pas ça à ton âge, mais les vieux le sentent bien. Les forces n’y sont pu. J’voudrais voir mes petits-enfants, avant qu’on me descende dans le trou."
                            },
                            {
                                "example_id": "a8c72a30-559a-4c86-9f5c-e7e7711cf2ef",
                                "sense_id": "fa6fd28a-4dc2-3915-ae52-1f242f2cf46e",
                                "text": "Depuis qu’je fume pu d’shit\nJ’ai d’la conversation\nJe suis plus tout seul dans mon coin\nÀ flipper comme un con"
                            }
                        ]
                    },
                    {
                        "sense_id": "71508edd-bea1-33e9-8a3a-5a2ad36b92ae",
                        "entry_id": "a0eefdbe-d924-3250-bf19-576efbf4637c",
                        "glosses": [
                            "Déformation de l’adverbe de négation plus."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "18225ce4-9679-4a38-9999-9b47e6f59179",
                                "sense_id": "71508edd-bea1-33e9-8a3a-5a2ad36b92ae",
                                "text": "Ah non ! Moi, j’m’en fous, j’les appelle pu’ !"
                            },
                            {
                                "example_id": "c1029a9e-3e1b-45a7-b01f-237677db0b18",
                                "sense_id": "71508edd-bea1-33e9-8a3a-5a2ad36b92ae",
                                "text": "J'en veux pas plus. Au contraire, j'en veux pu pantoute!"
                            }
                        ]
                    }
                ],
