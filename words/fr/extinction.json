                    ]
                },
                {
                    "sense_id": "fcda534c-0c5e-3dcf-8536-ba736bff7e22",
                    "sense_definition": "Hydratation de la chaux vive qui neutralise sa causticité pour former de la chaux éteinte.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chimie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le maçon verse lentement de l'eau pour réaliser l'<w>extinction</w> de la chaux."
                        },
                        {
                            "text": "Cette technique ancienne permet l'<w>extinction</w> des particules de chaux pour le mortier."
                        }
                    ],
                    "synonyms": [
