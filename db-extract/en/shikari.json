                        "glosses": [
                            "A hunter or tracker, especially in the Indian subcontinent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cb4f18e-c0b4-40ac-b81e-effaf638c3ee",
                                "sense_id": "2639e3bc-890e-3c6d-87c5-0a593ca65f71",
                                "text": "‘And if thou art not a shikarri, where didst thou learn thy knowledge of the tiger-folk?’ said he. ‘No tracker could have done better.’"
                            },
                            {
                                "example_id": "2f058af3-b3d6-44a6-bdbd-f2e7f665d399",
                                "sense_id": "2639e3bc-890e-3c6d-87c5-0a593ca65f71",
                                "text": "I wonder that my very simple stratagem could deceive so old a shikari,’ said Holmes."
                            },
                            {
                                "example_id": "86ff5706-6b8d-42e7-bb5b-a7322c34a03d",
                                "sense_id": "2639e3bc-890e-3c6d-87c5-0a593ca65f71",
                                "text": "\"I'll stake my good name as a shikarree,\" said he, \"that the track is a fresh one.\""
                            }
                        ]
                    },
