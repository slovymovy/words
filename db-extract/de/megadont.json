                    }
                ],
                "senses": [
                    {
                        "sense_id": "91c92d22-2e52-3d2b-98e4-35dc81757191",
                        "entry_id": "ed7a795b-b037-3e30-b69d-f92b7a9651d5",
                        "glosses": [
                            "große Zähne habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36c15a0a-2500-4d1b-83b7-77cab6b65bdd",
                                "sense_id": "91c92d22-2e52-3d2b-98e4-35dc81757191",
                                "text": "„Im Laufe der Zeit entwickelte sich bei diesen spezialisierten Hominiden ein sehr viel robusterer Gesichtsschädel und eine megadonte Bezahlung, um die härtere Nahrung der Savannen effizienter verarbeiten zu können.“"
                            },
                            {
                                "example_id": "357f881a-4b07-4294-995f-81eec074b074",
                                "sense_id": "91c92d22-2e52-3d2b-98e4-35dc81757191",
                                "text": "„Diese Merkmale und auch die megadonte Bezahnung deuten darauf hin, dass vor allem harte und grobe pflanzliche Nahrung, zum Beispiel Samen und Pflanzenfasern, zerkaut wurde.“"
                            },
                            {
                                "example_id": "b4c4f0a6-6268-4070-912e-0cd2de2e0632",
                                "sense_id": "91c92d22-2e52-3d2b-98e4-35dc81757191",
                                "text": "„Die Paranthropus-Arten entwickelten einen massiven Kauapparat mit megadonten Zähnen, die den Verzehr zäher, trockener pflanzlicher Nahrung erlaubten.“"
                            },
                            {
                                "example_id": "f02a1670-92b3-4177-802e-49efbf058aa4",
                                "sense_id": "91c92d22-2e52-3d2b-98e4-35dc81757191",
