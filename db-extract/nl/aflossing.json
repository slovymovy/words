                                "sense_id": "86d1609d-22b2-34ef-b6d7-7a152f54ec97",
                                "text": "Ik zou hem om 8 uur een aflossing geven, zodat hij naar huis kon."
                            }
                        ]
                    },
                    {
                        "sense_id": "839ecdbb-7363-35be-ba7e-c51086184b6e",
                        "entry_id": "2300261b-3597-3466-8d86-84e63c3d94b6",
                        "glosses": [
                            "een bedrag waarmee een schuld wordt afgelost in termijnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e212e8e8-04fc-4c4a-91b3-23c57498246b",
                                "sense_id": "839ecdbb-7363-35be-ba7e-c51086184b6e",
                                "text": "Wij doen aan aflossing in termijnen."
                            },
                            {
                                "example_id": "1932f59c-e013-4987-a6a9-1c8f61b5a66a",
                                "sense_id": "839ecdbb-7363-35be-ba7e-c51086184b6e",
                                "text": "De aflossingen van de huisleningen werden direct van het loon afgehaald, omdat de bank — om precies te zijn Stockholms Enskilda Bank de eigenaar was van de Spoorwegmaatschappij."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8eccc692-34a9-48f4-aadc-f9afb0eba1bb",
                        "source_entry_id": "2300261b-3597-3466-8d86-84e63c3d94b6",
                        "source_sense_id": "86d1609d-22b2-34ef-b6d7-7a152f54ec97",
                        "source_sense_description": "het aflossen",
                        "target_lang_word": "Ablösung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ablösung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "734aa024-c682-351e-828d-53f460ffb629",
                                        "entry_id": "944aa80a-630b-372f-9da5-4d105c01d73a",
                                        "glosses": [
                                            "(bei der Arbeit) die Tätigkeit und das Ereignis, wenn eine Schicht wechselt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1d3026c-dbcc-4753-8d61-44c0ed2c2ac9",
                                                "sense_id": "734aa024-c682-351e-828d-53f460ffb629",
                                                "text": "Wann ist eigentlich Ablösung?"
                                            },
                                            {
                                                "example_id": "d2d2ceae-62fe-4f82-942d-1eeffe2f670d",
                                                "sense_id": "734aa024-c682-351e-828d-53f460ffb629",
                                                "text": "„Nach erfolgter Ablösung hatte Rostow noch Zeit gefunden, vor Tagesanbruch einige Stunden zu schlafen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "78a66142-4a6b-3b32-a242-8a15fed00614",
                                        "entry_id": "944aa80a-630b-372f-9da5-4d105c01d73a",
                                        "glosses": [
                                            "die Person(en), die bei [1] die Arbeit übernimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9aff02d7-342b-45ba-be99-eade87b9c42b",
                                                "sense_id": "78a66142-4a6b-3b32-a242-8a15fed00614",
                                                "text": "Die Ablösung ist immer noch nicht da."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3a58c0b7-ef01-3739-9670-4d69b1b6fd8a",
                                        "entry_id": "944aa80a-630b-372f-9da5-4d105c01d73a",
                                        "glosses": [
                                            "die Tätigkeit, etwas lose zu machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f4bfc8d-63a3-467d-9c5c-18c40e21997c",
                                                "sense_id": "3a58c0b7-ef01-3739-9670-4d69b1b6fd8a",
                                                "text": "Die Ablösung der Poster sollte sich als schwieriger herausstellen, als zuvor vermutet."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9db80b84-02e0-34cc-8469-ed4d7a7e2665",
                                        "entry_id": "944aa80a-630b-372f-9da5-4d105c01d73a",
                                        "glosses": [
                                            "das Ereignis, wenn etwas nicht mehr haftet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7de1ef8-e24b-4344-bb62-5161a65656ef",
                                                "sense_id": "9db80b84-02e0-34cc-8469-ed4d7a7e2665",
                                                "text": "Wir tackern es zusätzlich noch fest, um eine Ablösung durch die Witterung zu verhindern."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38192049-de36-4fb3-a728-79705517e829",
