                        "tags": [],
                        "examples": [
                            {
                                "example_id": "234aac33-bb69-4fc5-b342-58b67ebeda61",
                                "sense_id": "03a35b6d-e2dd-335f-8de0-620457eeacea",
                                "text": "„Die Augenheilkunde zählt zu den chirurgischen Disziplinen, obwohl ihr zahlreiche, wirksame und hochentwickelte Medikamente und Hilfsmittel zur Verfügung stehen.“"
