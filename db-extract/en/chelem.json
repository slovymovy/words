                    {
                        "sense_id": "591174d5-0cc8-309d-bcbc-ba292b47fed6",
                        "entry_id": "44eba184-b6e1-33d9-8801-36cd3d9a842e",
                        "glosses": [
                            "Synonym of slam.",
                            "The act or contract for winning all, or almost all, of the possible tricks."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02e17678-135f-488f-bc10-f320e95a11ef",
                                "sense_id": "591174d5-0cc8-309d-bcbc-ba292b47fed6",
                                "text": "If the grand chelem is made, the winner receives seventeen points from each adversary and the game continues; if twelve tricks are made, the winner receives the value of sixteen points."
                            },
                            {
                                "example_id": "dc040067-b9bd-4803-acb2-6f8b58520386",
                                "sense_id": "591174d5-0cc8-309d-bcbc-ba292b47fed6",
                                "text": "The authors would claim only that the 131 tables which summarise the results of their analyses give added precision to the bridge player's judgements when, for example, he considers how to play \" le squouize \" or whether to bid a \" grand chelem \"."
                            },
                            {
                                "example_id": "c9da67b0-d5b2-44b8-aacb-423252806434",
                                "sense_id": "591174d5-0cc8-309d-bcbc-ba292b47fed6",
                                "text": "The grand chelem is a contraot to take all the tricks, the petit chelem one to take all the tricks but two, in both cases after taking the talon and discarding."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a5c9b25-9606-3193-ba7c-e5d79012b09e",
                        "entry_id": "44eba184-b6e1-33d9-8801-36cd3d9a842e",
                        "glosses": [
                            "Synonym of slam.",
                            "Winning all (or all but one) of the available, major or specified events in a given year or sports season."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad2559e7-199a-42ec-bdfd-3d0e468e5ba1",
                                "sense_id": "9a5c9b25-9606-3193-ba7c-e5d79012b09e",
                                "text": "For the first time in his career the Red Bull star achieved Formula One's grand chelem of pole, win, fastest lap and leading for every single lap, to further underline his dominant campaign."
                            },
                            {
                                "example_id": "eb5b6413-0e13-4fa0-9af6-e7966d98908a",
                                "sense_id": "9a5c9b25-9606-3193-ba7c-e5d79012b09e",
                                "text": "The number of \"grand chelems\"—pole, fastest lap, lead every lap and win the race—achieved in 2015 (Lewis Hamilton at the Italian Grand Prix)."
                            },
                            {
                                "example_id": "f5ab15ae-b16b-4294-a581-2e55902a3ab9",
                                "sense_id": "9a5c9b25-9606-3193-ba7c-e5d79012b09e",
                                "text": "It is the fifth grand chelem of Hamilton’s career – securing pole, win, fastest lap and leading every lap – matching Alberto Ascari and Michael Schumacher. Only Clark has more, with eight."
                            }
                        ]
                    }
