                    },
                    {
                        "translation_id": "d785efb1-d291-41f9-b5be-ef1cf5b1c53a",
                        "source_entry_id": "141b6b63-689c-3fe6-b1da-6d8513ee6668",
                        "source_sense_description": "platform for bands to play on",
                        "target_lang_word": "Pavillon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pavillon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2250d874-3bbb-360b-a1b0-e96212b12a84",
                                        "entry_id": "e499f702-4b18-3ca2-8b22-3c0a3c894164",
                                        "glosses": [
                                            "ein frei stehendes, allseitig offenes oder zu öffnendes Gebäude oder Zelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08c75184-4193-45c1-b19f-05b494d14b13",
                                                "sense_id": "2250d874-3bbb-360b-a1b0-e96212b12a84",
                                                "text": "Dein Pavillon ist wunderbar mit vielen Blumen geschmückt."
                                            },
                                            {
                                                "example_id": "348dd17a-991e-4db3-99a0-ba484efc5422",
                                                "sense_id": "2250d874-3bbb-360b-a1b0-e96212b12a84",
                                                "text": "„Auf unserem Rückweg zum Pavillon erklang unter den Bäumen eine Polka.“"
                                            },
                                            {
                                                "example_id": "70d687bf-011d-4bde-a440-8f8399609647",
                                                "sense_id": "2250d874-3bbb-360b-a1b0-e96212b12a84",
                                                "text": "„Sie schlenderten weiter durch den Park, an einem Pavillon vorbei, in dem eine Musikkapelle spielte.“"
                                            },
                                            {
                                                "example_id": "0c6c070d-6b3d-4d91-998d-8d884f63b444",
                                                "sense_id": "2250d874-3bbb-360b-a1b0-e96212b12a84",
                                                "text": "„Die Polizeiwache war ein kleines, mit Stuck verkleidetes Haus am Ende des Parkplatzes, gleich neben der Promenade und in der Nähe des Pavillons.“"
                                            },
                                            {
                                                "example_id": "260a677f-2c27-42ff-a760-714fcc4ddfc7",
                                                "sense_id": "2250d874-3bbb-360b-a1b0-e96212b12a84",
                                                "text": "„Da ich in einiger Entfernung einen Pavillon erblickte und sicher annahm, daß Monsieur Tronchin ihn offen gelassen hatte, hängte ich mich bei meinen Schönen ein und führte sie dorthin, ohne ihnen meine Absichten zu verraten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "185f1ad9-9e6e-32d6-93fe-91986d50c861",
                                        "entry_id": "e499f702-4b18-3ca2-8b22-3c0a3c894164",
                                        "glosses": [
                                            "ein Bettenbau eines Krankenhauses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "999470f4-2c65-40b0-be7c-171f2a20920e",
                                                "sense_id": "185f1ad9-9e6e-32d6-93fe-91986d50c861",
                                                "text": "„1932 wurden diese Baracken durch Pavillons im Spitalsgelände ersetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d31c4ffb-6c81-3baa-8f49-0353f064082d",
                                        "entry_id": "e499f702-4b18-3ca2-8b22-3c0a3c894164",
                                        "glosses": [
                                            "Neben- oder freistehendes Gebäude einer Schule"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82efa09a-4e5a-407f-9df7-fc6637a659c7",
                                                "sense_id": "d31c4ffb-6c81-3baa-8f49-0353f064082d",
                                                "text": "„Über 2 Jahre entstand der Pavillon der für viele Schüler neuen Platz schafft!“ (sic!)"
                                            },
                                            {
                                                "example_id": "73fe8d12-a06a-47ac-9164-5768d9e7920b",
                                                "sense_id": "d31c4ffb-6c81-3baa-8f49-0353f064082d",
                                                "text": "„Der Lehrer hatte Unterricht im Pavillon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3765eef1-a8cf-3304-b01f-6ae8c39c8724",
                                        "entry_id": "e499f702-4b18-3ca2-8b22-3c0a3c894164",
                                        "glosses": [
                                            "einzelnes Gebäude einer (Welt-)Ausstellung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c3356c8-935f-40a6-b1a3-ce29f503f643",
                                                "sense_id": "3765eef1-a8cf-3304-b01f-6ae8c39c8724",
                                                "text": "„1914 schmückte [Anton Hanak] den österreichischen Pavillon der Kölner Werkbundausstellung mit den Kolossalplastiken „Der Schöpfer“ und „Die Verklärung“; er arbeitete eng mit Josef Hoffmann zusammen.“"
                                            },
                                            {
                                                "example_id": "80563c4b-95a5-4356-8a8d-74a40b70d179",
                                                "sense_id": "3765eef1-a8cf-3304-b01f-6ae8c39c8724",
                                                "text": "„Die Gastländer gestalten jeweils einen eigenen Pavillon zu ihrer Geschichte, Kultur und Literatur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
