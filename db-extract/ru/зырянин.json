                "senses": [
                    {
                        "sense_id": "395fc473-c1bb-3cdb-82fd-2c7c1f4b8663",
                        "entry_id": "3f61f5de-3796-340b-b7aa-de43375aa1da",
                        "glosses": [
                            "Komi (person)"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "4ff30b71-02f3-40ab-889f-12c4663016da",
                                "sense_id": "395fc473-c1bb-3cdb-82fd-2c7c1f4b8663",
                                "text": "Откла́дывать бы́ло не́зачем, и мы на друго́е же у́тро раным-рано отпе́ли обе́денку, оде́лись о́ба по-тузе́мному и вы́ехали, держа́ путь к са́мому се́веру, где мой зыря́нин апо́стольствовал.",
                                "translation": "There was no reason to delay our departure, so already the next morning after having assisted at very early matins, we dressed ourselves like the natives, and set out, taking the road straight to the North, where my Zyryan was carrying on his apostolic mission.",
                                "english": "There was no reason to delay our departure, so already the next morning after having assisted at very early matins, we dressed ourselves like the natives, and set out, taking the road straight to the North, where my Zyryan was carrying on his apostolic mission."
                            }
                        ]
                    }
