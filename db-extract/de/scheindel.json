                "senses": [
                    {
                        "sense_id": "bae7257a-6104-3244-968c-48aa8709d392",
                        "entry_id": "c779bdec-a1b0-38e4-a5c0-cfb4f4c12491",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cb6186f-d86c-4ab7-a7a2-3c48c5b246b2",
                                "sense_id": "bae7257a-6104-3244-968c-48aa8709d392",
                                "text": "Frau Scheindel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b8fd21f4-ae25-4073-b9d9-0232bddbb58c",
                                "sense_id": "bae7257a-6104-3244-968c-48aa8709d392",
                                "text": "Herr Scheindel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0ab393c5-d35d-4c6f-b5d3-40240a556551",
                                "sense_id": "bae7257a-6104-3244-968c-48aa8709d392",
                                "text": "Die Scheindels fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "1730cb76-973f-4df7-af9c-ae2e2f44ba56",
                                "sense_id": "bae7257a-6104-3244-968c-48aa8709d392",
                                "text": "Der Scheindel trägt nie die Schals, die die Scheindel ihm strickt."
                            },
                            {
                                "example_id": "b944ce0e-fe2b-4fbd-ad44-8ac5011ad6c7",
                                "sense_id": "bae7257a-6104-3244-968c-48aa8709d392",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Scheindel kommt, geht der Herr Scheindel.“"
                            },
                            {
                                "example_id": "dab928eb-db0d-4962-a8b4-d48572e35d6b",
                                "sense_id": "bae7257a-6104-3244-968c-48aa8709d392",
                                "text": "Scheindel kommt und geht."
                            },
                            {
                                "example_id": "184a1739-7054-407c-a968-1b20eff3f20f",
                                "sense_id": "bae7257a-6104-3244-968c-48aa8709d392",
                                "text": "Scheindels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
