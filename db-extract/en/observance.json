                        "examples": []
                    },
                    {
                        "sense_id": "7c6617e4-4d09-3a9a-87cd-4b15799ceee3",
                        "entry_id": "31453552-e0ae-3a72-b3c4-df93751735ef",
                        "glosses": [
                            "Observation or the act of watching."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3f643ce3-735a-391a-a7fe-08aa9c623ef4",
                        "entry_id": "31453552-e0ae-3a72-b3c4-df93751735ef",
                        "glosses": [
                            "A rule governing a religious order, especially in the Roman Catholic church."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "72bafe9c-3532-44bf-877e-b1ce3f582643",
                                "sense_id": "3f643ce3-735a-391a-a7fe-08aa9c623ef4",
                                "text": "Thomas Merton was a monk in the Order of Cistertians of the Strict Observance."
                            }
                        ]
                    },
                    {
                        "sense_id": "f4a959f6-6feb-36f0-ab3c-2e061aaac69b",
                        "entry_id": "31453552-e0ae-3a72-b3c4-df93751735ef",
                        "glosses": [
                            "That which is to be observed."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "013acca1-63da-3344-a03e-07667db5880f",
                        "entry_id": "31453552-e0ae-3a72-b3c4-df93751735ef",
                        "glosses": [
                            "Reverence; homage."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b0a63ae-0fdb-40d7-bc03-fd35dd374997",
                        "source_entry_id": "31453552-e0ae-3a72-b3c4-df93751735ef",
                        "source_sense_description": "practice of complying",
                        "target_lang_word": "dodržování",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3674e304-b529-4716-a3bc-d73fd5c5bde8",
                        "source_entry_id": "31453552-e0ae-3a72-b3c4-df93751735ef",
                        "source_sense_description": "practice of complying",
                        "target_lang_word": "observance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "observance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "efbf1fda-09a5-3c1e-b9a8-2393616abad2",
                                        "entry_id": "70607a83-0797-307f-b363-a8c33e598394",
                                        "glosses": [
                                            "Pratique d’une règle, exécution de ce que prescrit une règle, et souvent une règle religieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a4c2fa7-a3ff-4bdd-a9a1-cbbc1ae1b28b",
                                                "sense_id": "efbf1fda-09a5-3c1e-b9a8-2393616abad2",
                                                "text": "Les observances ne sont pas les mêmes pour une paysanne qui moissonne, pour une ouvrière à quinze sous par jour, pour la fille d’un petit détaillant, pour la jeune bourgeoise, pour l’enfant d’une riche maison de commerce, pour la jeune héritière d’une noble famille, …."
                                            },
                                            {
                                                "example_id": "66142899-ce36-4b50-87c6-717bc07e04a6",
                                                "sense_id": "efbf1fda-09a5-3c1e-b9a8-2393616abad2",
                                                "text": "Magie des apparences qui me fait parler du train accoutumé de notre vie, alors que le fond même en était changé à jamais ! Étais-je donc la dupe de cette observance de nos habitudes ? Ne savais-je pas qu’au milieu de tant de choses coutumières, j’apportais un cœur nouveau ?"
                                            },
                                            {
                                                "example_id": "328a9680-7fac-4acf-8d09-153478fe429f",
                                                "sense_id": "efbf1fda-09a5-3c1e-b9a8-2393616abad2",
                                                "text": "Dans ses discours, il défendit avec force cette thèse que la stricte observance des lois religieuses doit s'accompagner, pour devenir méritoire, de la pratique de la justice et de l'amour du prochain, envers les juifs comme envers les non-juifs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e6e4927-72d8-3541-bed6-1732ae9b3f47",
                                        "entry_id": "70607a83-0797-307f-b363-a8c33e598394",
                                        "glosses": [
                                            "Degré de concordance entre le comportement d’un individu et les prescriptions médicales qu’il a reçues."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "85ad99c0-5af7-31ff-a072-eb54a2f32abf",
                                        "entry_id": "70607a83-0797-307f-b363-a8c33e598394",
                                        "glosses": [
                                            "Cette règle, cette loi religieuse."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb723ba7-7c85-472c-b46f-00ba9fe6b356",
                                                "sense_id": "85ad99c0-5af7-31ff-a072-eb54a2f32abf",
                                                "text": "Observances légales, pratiques ou cérémonies que prescrit la loi de Moïse."
                                            },
                                            {
                                                "example_id": "8b2ca782-abbc-4791-96f1-bfe3c1aed23e",
                                                "sense_id": "85ad99c0-5af7-31ff-a072-eb54a2f32abf",
                                                "text": "Je surpris, j'effarouchai en marquant tout de suite, sans ostentation, mais nettement, mon éloignement des observances religieuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b64b20e8-811e-35d8-899d-0877274f08fd",
                                        "entry_id": "70607a83-0797-307f-b363-a8c33e598394",
                                        "glosses": [
                                            "Ordre religieux où la règle monastique s’observe strictement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7db4e0cf-08cc-4274-9ab0-cac68c6a4b69",
                                                "sense_id": "b64b20e8-811e-35d8-899d-0877274f08fd",
                                                "text": "Religieux d’étroite observance, religieux d’une maison qui observe la règle plus strictement que les autres maisons du même ordre."
                                            },
                                            {
                                                "example_id": "a60f428e-b4dc-4e83-b79c-90dc6cbc9698",
                                                "sense_id": "b64b20e8-811e-35d8-899d-0877274f08fd",
                                                "text": "Observance de saint François."
                                            },
                                            {
                                                "example_id": "02205126-8cd9-4e43-913b-3a1184cf13a1",
                                                "sense_id": "b64b20e8-811e-35d8-899d-0877274f08fd",
                                                "text": "Le recueillement, le silence, le calfeutré de cette maison, évoquaient un couvent de stricte observance, mais rendu aimable par un confort qui ne fait pas fi de la terre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9f6a2e5-8a33-4b12-910d-6c679573d0ca",
                        "source_entry_id": "31453552-e0ae-3a72-b3c4-df93751735ef",
                        "source_sense_description": "practice of complying",
                        "target_lang_word": "Beachtung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beachtung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ec6be509-25c8-39e2-a101-22c06eb9a4f8",
                                        "entry_id": "3a469893-19f4-366f-b468-8429451c4a9e",
                                        "glosses": [
                                            "das Bemerken und die Aufmerksamkeit einer Sache oder Person gegenüber"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb5edb04-458b-4e33-8b34-fb5af2b20748",
                                                "sense_id": "ec6be509-25c8-39e2-a101-22c06eb9a4f8",
                                                "text": "Der Zeitungsartikel fand viel Publikum und große Beachtung."
                                            },
                                            {
                                                "example_id": "f8014b3d-b7e2-423f-8099-e3dd996e183f",
                                                "sense_id": "ec6be509-25c8-39e2-a101-22c06eb9a4f8",
                                                "text": "„Ferner verbot Trajan die Beachtung anonymer Denunziationen und schließlich endete das Reskript mit einem Bekenntnis, […]: Ein allzu inquisitorisches Verhalten seitens des Staates werde dem Geist der Epoche nicht gerecht.“"
                                            },
                                            {
                                                "example_id": "fce05502-05d1-4648-87f8-e8f72eeba5c4",
                                                "sense_id": "ec6be509-25c8-39e2-a101-22c06eb9a4f8",
                                                "text": "„Besondere Beachtung gebührt ihm insofern, weil er, anders als von Spee, in aller Öffentlichkeit, während er wichtige Ämter bekleidete, die vom Aberglauben beeinflußten Prozesse kritisch beleuchtete.“"
                                            },
                                            {
                                                "example_id": "38e27912-00ca-4335-96c3-b7bd1a997e4d",
                                                "sense_id": "ec6be509-25c8-39e2-a101-22c06eb9a4f8",
                                                "text": "„Während die Munitionsfabriken längst eifrig produzieren und auch ein Mangel an Nahrung vorerst nicht zu befürchten steht, schenkt man im Kriegsministerium den essenziellen ökonomischen Fragen keinerlei Beachtung.“"
                                            },
                                            {
                                                "example_id": "0c6856c0-f5b4-4caa-8391-36b883bf9d30",
                                                "sense_id": "ec6be509-25c8-39e2-a101-22c06eb9a4f8",
                                                "text": "„Der Mann schenkte Scott keine Beachtung und setzte seine Lektüre fort.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "044f351c-6c61-3332-a39b-a51cb7fb3140",
                                        "entry_id": "3a469893-19f4-366f-b468-8429451c4a9e",
                                        "glosses": [
                                            "das Bemerken und die Befolgung von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e312adc-a1dc-4157-8ed3-980232359926",
                                                "sense_id": "044f351c-6c61-3332-a39b-a51cb7fb3140",
                                                "text": "Die Beachtung der Regeln ist unerlässlich."
                                            },
                                            {
                                                "example_id": "97f88a41-1e52-45b5-9850-b442ee0a2c73",
                                                "sense_id": "044f351c-6c61-3332-a39b-a51cb7fb3140",
                                                "text": "„In den Londoner Debattiergesellschaften wurden Teams gebildet, wahllos Themen von Korruption in der Politik bis zu intime Beziehungen zwischen den Geschlechtern verteilt, und man musste sein Thema wortgewandt und unter Beachtung strenger Zeit- und Höflichkeitsregeln überzeugend öffentlich vertreten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3edd8ac1-a6be-44c2-aac7-7cedb6a4c93f",
                        "source_entry_id": "31453552-e0ae-3a72-b3c4-df93751735ef",
                        "source_sense_description": "the custom of celebrating a holiday",
                        "target_lang_word": "feestdag",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feestdag",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d1f0da4c-3f79-312a-bf36-a5cb090075d5",
                                        "entry_id": "d44c8fa9-41d7-3d24-a507-a3cb66598926",
                                        "glosses": [
                                            "dag waarop feest gevierd wordt"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eaf399f1-9de3-32ba-915c-fc865105867c",
                                        "entry_id": "d44c8fa9-41d7-3d24-a507-a3cb66598926",
                                        "glosses": [
                                            "jaarlijks terugkerende erkende gedenkdag die gevierd wordt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bd6ef9d-80da-41de-9fce-4bfb6b8e1dbb",
                                                "sense_id": "eaf399f1-9de3-32ba-915c-fc865105867c",
                                                "text": "En men stelde zich voor hoe de machtige Nicolaas, ieder jaar op zijn feestdag, de duivel in ketenen sloeg en geboeid met zich meevoerde."
                                            },
                                            {
                                                "example_id": "9dbe8c39-c14e-4f92-86f6-8ccf06000493",
                                                "sense_id": "eaf399f1-9de3-32ba-915c-fc865105867c",
                                                "text": "Onder het koken vertelde Barbie mij over zijn werk als hotelmanager en hoe zwaar het was om jarenlang voor dag en dauw op te moeten staan en op alle feestdagen te moeten werken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
