    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7d2543ed-c107-3f12-8821-94e366fa56d0",
                    "sense_definition": "Having a salty or spicy taste rather than a sweet one.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "taste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I prefer a <w>savoury</w> snack like nuts or crisps over chocolate.",
                            "target_lang_translations": {
                                "ru": "Я предпочитаю <w>несладкие</w> перекусы, такие как орехи или чипсы, шоколаду."
                            }
                        },
                        {
                            "text": "The chef prepared a delicious <w>savoury</w> tart filled with cheese and spinach.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар приготовил восхитительный <w>пикантный</w> пирог с начинкой из сыра и шпината."
                            }
                        }
                    ],
                    "synonyms": [
                        "salty",
                        "spicy",
                        "pungent"
                    ],
                    "antonyms": [
                        "sweet"
                    ],
                    "common_phrases": [
                        "savoury_snack",
                        "savoury_dish",
                        "savoury_flavour"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий соленый или острый вкус, а не сладкий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несладкий",
                                "target_lang_sense_clarification": "о еде, не содержащей сахара"
                            },
                            {
                                "target_lang_word": "пикантный",
                                "target_lang_sense_clarification": "имеющий острый или пряный вкус"
                            },
                            {
                                "target_lang_word": "соленый",
                                "target_lang_sense_clarification": "о вкусе закусок или блюд"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4eefb0a6-afb9-3334-a9d7-42fab432008d",
                    "sense_definition": "A small dish of salty or spicy food, often served as an appetizer or at the end of a meal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "food_item",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The waiter brought a tray of hot <w>savouries</w> for the guests to enjoy before dinner.",
                            "target_lang_translations": {
                                "ru": "Официант принес поднос с горячими <w>закусками</w>, чтобы гости могли насладиться ими перед ужином."
                            }
                        },
                        {
                            "text": "We served a selection of <w>savouries</w> including mini quiches and sausage rolls.",
                            "target_lang_translations": {
                                "ru": "Мы подали ассорти из <w>несладких закусок</w>, включая мини-киши и сосиски в тесте."
                            }
                        }
                    ],
                    "synonyms": [
                        "appetizer",
                        "hors_d'oeuvre",
                        "snack"
                    ],
                    "antonyms": [
                        "sweet",
                        "dessert"
                    ],
                    "common_phrases": [
                        "selection_of_savouries",
                        "hot_savouries"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое блюдо с соленой или острой пищей, часто подаваемое в качестве закуски или в конце трапезы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закуска",
                                "target_lang_sense_clarification": "соленая или острая мини-порция еды"
                            },
                            {
                                "target_lang_word": "пикантная закуска",
                                "target_lang_sense_clarification": "небольшое несладкое блюдо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}