                                        "entry_id": "487867e5-6acf-37ee-bbef-d947d9c600ff",
                                        "glosses": [
                                            "Halbschmarotzer; Gattung, die zu der Familie der Sommerwurzgewächse zählt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2d50d3d-af49-4a7e-987e-7e196f223b83",
                                                "sense_id": "2c958cf8-a23e-3b59-9e0b-92670a18c76b",
                                                "text": "Der Steife Augentrost wächst auf Halbtrockenrasen, Magerrasen und an Wegesrändern in Höhen bis 1700 m."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27c15543-7f8b-49ad-8842-9c5b886adb5b",
                        "source_entry_id": "cec44850-1b3d-3e2d-9467-2ba07297090d",
                        "source_sense_id": "f68e8339-1f66-3dde-96b8-2ab0e984a06c",
                        "target_lang_word": "eyebright",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eyebright",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db25dc1c-4bc5-3362-9255-e1bb772e58a7",
                                        "entry_id": "f51271b7-ed40-3b99-bb72-e9545bcab4ec",
                                        "glosses": [
                                            "Any of the flowering plants of the genus Euphrasia, originally as used to treat eye infections."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a907e23d-a19d-46e5-874c-9ad99da665d2",
                                                "sense_id": "db25dc1c-4bc5-3362-9255-e1bb772e58a7",
                                                "text": "Paracelsus had been recommending the plant eyebright for bad eyes in the sixteenth century; it was still in widespread use in the eighteenth."
                                            },
                                            {
                                                "example_id": "0d9d940a-f345-4bb6-b5d5-636fc61d3d53",
                                                "sense_id": "db25dc1c-4bc5-3362-9255-e1bb772e58a7",
                                                "text": "He looks for eyebright, a tiny flowering herb he has seen before, and which he knows would make a good eye-wash: not to be found."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d56a8ba9-f177-4edb-8c8a-7ec018f1938c",
