                                                "sense_id": "f194e056-6bc2-317e-9ab8-118ed1508eb3",
                                                "text": "Un comportement intéressé."
                                            },
                                            {
                                                "example_id": "37bb04dd-ac6e-4c2b-b2cf-d46904fb0a5d",
                                                "sense_id": "f194e056-6bc2-317e-9ab8-118ed1508eb3",
                                                "text": "Le greffier refusa d’abord vivement, puis mollement, puis accepta, tout en témoignant une grande répugnance à donner à ses services une apparence intéressée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0e602ab-3e5e-34ea-aac7-808e0ad96928",
                                        "entry_id": "0276205b-7a07-3e93-afa7-144c378cee35",
                                        "glosses": [
                                            "Qualifie un salarié qui touche une prime d’intéressement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e57d9e13-286e-4a28-819e-d37c2d820ceb",
                                                "sense_id": "b0e602ab-3e5e-34ea-aac7-808e0ad96928",
                                                "text": "Par exemple les vendeurs sont intéressés aux résultats parce qu’ils gagnent ou perdent une vente (et le profit qui en découle) selon qu’un client décide ou non d’acheter."
                                            }
                                        ]
                                    }
                                ]
                            },
