                "entry_id": "4cce0389-6dad-3ccf-87c9-c5b7100f5482",
                "word": "griffen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5d2036c3-9014-3e05-93bb-2ce3c51ee75e",
                        "entry_id": "4cce0389-6dad-3ccf-87c9-c5b7100f5482",
                        "glosses": [
                            "door krassen voor altijd vastleggen in een duurzaam materiaal"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "32b4ca56-4c14-3f8b-8838-996ab1dd0be1",
                        "entry_id": "4cce0389-6dad-3ccf-87c9-c5b7100f5482",
                        "glosses": [
                            "in het geheugen griffen: voor altijd blijven onthouden"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1b590d8f-452d-4ab4-b045-f29dc223fdb9",
                                "sense_id": "32b4ca56-4c14-3f8b-8838-996ab1dd0be1",
                                "text": "De Duitse gouverneur probeerde alle gerechten, desserts en wijnen in zijn geheugen te griffen om alles haarfijn in een brief aan zijn bloedverwanten in Duitsland te kunnen beschrijven, en het ergerde hem bovenmatig dat de hofmeester niet met de in een servet gewikkelde fles bij hem langs kwam."
                            },
                            {
                                "example_id": "d4518519-d0ed-486e-a2f5-11a741efb6f1",
                                "sense_id": "32b4ca56-4c14-3f8b-8838-996ab1dd0be1",
                                "text": "‘Een grote geest heeft eens opgemerkt over een groots werk dat hij had gelezen, dat het maar één tekortkoming had: het was niet kort genoeg om het in het geheugen te griffen en niet lang genoeg om het nooit uit te krijgen. Mocht men het laatste over mijn werk zeggen, dan is dit vast niet vanwege de voortreffelijkheid ervan, maar vanwege de saaiheid en wijdlopigheid.’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a6f5bd0-7251-48f1-b792-5ba4a916274d",
                        "source_entry_id": "4cce0389-6dad-3ccf-87c9-c5b7100f5482",
                        "source_sense_id": "5d2036c3-9014-3e05-93bb-2ce3c51ee75e",
                        "source_sense_description": "door krassen voor altijd vastleggen in een duurzaam materiaal",
                        "target_lang_word": "gravieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gravieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1bc4240-eb04-357d-adaf-456829a13510",
                                        "entry_id": "a9ae3a0f-fe63-3cd8-96f9-aa2ff13eaea5",
                                        "glosses": [
                                            "etwas (Bilder, Ornamente, Wörter, Zeichen) in hartes Material oder Stein mit speziellem Werkzeug einschneiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "525578df-eade-4348-9d6e-d83cd17fc73e",
                                                "sense_id": "e1bc4240-eb04-357d-adaf-456829a13510",
                                                "text": "Die einheimische Künstlerin graviert mit einem elektrischen Gravierstift und erschafft so lebendige kleine Jagdszenen auf Schnapsgläser."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "36348d84-6867-32fb-a049-e480df10ab5d",
                                        "entry_id": "a9ae3a0f-fe63-3cd8-96f9-aa2ff13eaea5",
                                        "glosses": [
                                            "etwas mit eingeschnittenen Verzierungen (Gravierungen) versehen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8098c16-1016-4495-8b28-8a88af27d46a",
                                                "sense_id": "36348d84-6867-32fb-a049-e480df10ab5d",
                                                "text": "„Die Bauern sind beinahe alle Analphabeten, das sind aber auch viele der großen Fürsten, die sich metallene Petschaften mit ihrer Unterschrift gravieren lassen, sodass sie Dokumente nicht unterzeichnen müssen, sondern nur zu stempeln brauchen und damit verhehlen könnnen, dass sie unfähig sind, ihren eigenen erlauchten Namen zu schreiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "gravieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11efeff4-00cb-31cc-84a3-bbe8ba07c5b0",
                                        "entry_id": "d9c8416e-291d-349d-b382-ff198df44517",
                                        "glosses": [
                                            "schwer auf jemandem lasten"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1d574ca-ca13-45f8-b99c-15beb8aadc7f",
                                                "sense_id": "11efeff4-00cb-31cc-84a3-bbe8ba07c5b0",
                                                "text": "Soviel der Herr nachbar auch reden mag, das graviert mich gar nicht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44e434d4-d06e-4dbf-acc4-e902735d01d2",
                        "source_entry_id": "4cce0389-6dad-3ccf-87c9-c5b7100f5482",
