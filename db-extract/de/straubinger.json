        "de-extract.jsonl": [
            {
                "entry_id": "35fff784-7537-3eae-925f-acd4cf808e63",
                "word": "Straubinger",
                "pos": "adj",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "b7addd53-46fa-471a-a1ff-11cd2c9b9ab0",
                        "entry_id": "35fff784-7537-3eae-925f-acd4cf808e63",
                        "tags": [
                            "positive"
                        ],
                        "form": "Straubinger"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "64b857f6-b62a-3117-a37c-6cb574f091ba",
                        "entry_id": "35fff784-7537-3eae-925f-acd4cf808e63",
                        "glosses": [
                            "zu Straubing gehörig, sich auf diesen Ort beziehend, in der Art und Weise dieses Ortes, aus Straubing kommend, stammend, Straubing betreffend, zu Straubing gehörend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6af79430-f0f3-433d-8000-a973168cbdeb",
                                "sense_id": "64b857f6-b62a-3117-a37c-6cb574f091ba",
                                "text": "2016 brannte das 600 Jahre alte Straubinger Rathaus."
                            },
                            {
                                "example_id": "a289b1fa-f289-45bd-a1a2-f9862b532d1f",
                                "sense_id": "64b857f6-b62a-3117-a37c-6cb574f091ba",
                                "text": "„Eigentlich heißt der Straubinger Kabarettist \"Vogelmayer\" Thomas Mayer, sein Kollege \"da Ebner\" hört auf Patrick Ebner.“"
                            },
                            {
                                "example_id": "bdf69e0e-5126-411a-bc2d-c055c42a374f",
                                "sense_id": "64b857f6-b62a-3117-a37c-6cb574f091ba",
                                "text": "„Sie betreuen sechs Pfarreien, machen Seelsorge bei der Bundespolizei, bei der Bundeswehr und im Straubinger Gefängnis.“"
                            },
                            {
                                "example_id": "9b7eaadd-039c-4ad1-9b50-db11aa897233",
                                "sense_id": "64b857f6-b62a-3117-a37c-6cb574f091ba",
                                "text": "„Genau vier Wochen ist es her, dass das historische Straubinger Rathaus in Flammen stand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
