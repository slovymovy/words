                    "sense_definition": "A person in a marriage or marital relationship.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please write the name of your <w>spouse</w> on the application form.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, впишите имя вашего <w>супруга</w> в анкету.",
                                "de": "Bitte tragen Sie den Namen Ihres <w>Ehepartners</w> auf dem Antragsformular ein."
                            }
                        },
                        {
                            "text": "He moved to the city with his <w>spouse</w> and their two children.",
                            "target_lang_translations": {
                                "ru": "Он переехал в город со своей <w>супругой</w> и их двумя детьми.",
                                "de": "Er zog mit seinem <w>Ehepartner</w> und ihren beiden Kindern in die Stadt."
                            }
                        }
