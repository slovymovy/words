                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ba365e90-8080-3fea-8619-0fcdf1510f44",
                        "entry_id": "df205246-cfa9-35a4-9a53-4a3dc3f70089",
                        "glosses": [
                            "der Aststumpf"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db1b54b1-c797-4322-ac81-851d4a4dbb8a",
                        "source_entry_id": "df205246-cfa9-35a4-9a53-4a3dc3f70089",
                        "source_sense_id": "0ec603d3-c7f6-37c4-ad1d-897ad7e0d3e5",
                        "source_sense_description": "der Knoten",
                        "target_lang_word": "Knoten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Knoten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c6089506-5895-3c69-9884-0054f7f4860a",
                                        "entry_id": "03787c68-760c-398f-a3d9-18b0891e0fcc",
                                        "glosses": [
                                            "fest verschlungener Teil eines Fadens oder Seils"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "658fde49-c9d8-49f1-a616-850a8e80f16b",
                                                "sense_id": "c6089506-5895-3c69-9884-0054f7f4860a",
                                                "text": "Ich mache hier einen Knoten in das Seil."
                                            },
                                            {
                                                "example_id": "d54aab73-7334-453c-a34f-a0f5f4259aa8",
                                                "sense_id": "c6089506-5895-3c69-9884-0054f7f4860a",
                                                "text": "„Im Auto lockerte Siavasch als Erstes den Knoten seiner Krawatte, dann öffnete er das Handschuhfach und holte eine Tüte Eisbonbons heraus.“"
                                            },
                                            {
                                                "example_id": "06b0305a-b8d6-4ccf-ad76-827d20130b94",
                                                "sense_id": "c6089506-5895-3c69-9884-0054f7f4860a",
                                                "text": "„Sie strich sich über ihr welliges, dunkelblondes Haar, das sie in der Mitte gescheitelt und im Nacken zu einem Knoten zusammengefasst hatte.“"
                                            },
                                            {
                                                "example_id": "5cda7728-dc43-4a12-83cc-487d593525eb",
                                                "sense_id": "c6089506-5895-3c69-9884-0054f7f4860a",
                                                "text": "„Sie lag still da, und er drehte sie herum und löste den Knoten, mit dem ihre Hände zusammengebunden waren.“"
                                            },
                                            {
                                                "example_id": "99d2f6c7-3dbe-455b-af00-2bceaf3664b9",
                                                "sense_id": "c6089506-5895-3c69-9884-0054f7f4860a",
                                                "text": "„Ihre Göttin Isis war eine große Zauberin; sie besaß das geheime Wissen um die Knoten und konnte sie knüpfen und lösen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "956a260e-c38b-3a1e-ac8d-67c2c2dd34c7",
                                        "entry_id": "03787c68-760c-398f-a3d9-18b0891e0fcc",
                                        "glosses": [
                                            "Geschwindigkeitsangabe bei Luft- und Wasserfahrzeugen"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e494dc6e-3390-46e0-b2e8-f5e8598b7b79",
                                                "sense_id": "956a260e-c38b-3a1e-ac8d-67c2c2dd34c7",
                                                "text": "Wie rechnet man eigentlich Knoten in Kilometer um?"
                                            },
                                            {
                                                "example_id": "10eb2e74-04bb-40c2-8863-9a5ec0dda691",
                                                "sense_id": "956a260e-c38b-3a1e-ac8d-67c2c2dd34c7",
                                                "text": "„Wir segeln mit 6 Knoten über Grund. Dann sind wir bei 300 Seemeilen in gut zwei Tagen da.“"
                                            },
                                            {
                                                "example_id": "f0f4ae85-849b-4516-8665-d5c45a9b689c",
                                                "sense_id": "956a260e-c38b-3a1e-ac8d-67c2c2dd34c7",
                                                "text": "„Doch schon zwei weitere Tage später kam frühmorgens ein Funkspruch des Kommandanten Erich Topp von U 552 herein, man habe einen Geleitzug gesichtet, der sich mit einer Geschwindigkeit von zehn Knoten in Richtung Norden bewege.“"
                                            },
                                            {
                                                "example_id": "855338b2-6fba-4e36-827a-521c311bf619",
                                                "sense_id": "956a260e-c38b-3a1e-ac8d-67c2c2dd34c7",
                                                "text": "„Der »Seehund« konnte unter Wasser eine Geschwindigkeit von sechs Knoten erreichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7920ee86-fd04-3257-b7cd-3038f57532cf",
                                        "entry_id": "03787c68-760c-398f-a3d9-18b0891e0fcc",
                                        "glosses": [
                                            "Ansatzstelle der Blätter an der Sprossachse, meist verdickt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a14be9a-66f6-43e7-aeb5-f39c76c41e27",
                                                "sense_id": "7920ee86-fd04-3257-b7cd-3038f57532cf",
                                                "text": "An jedem Knoten entspringen kleine, schmale Blätter."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "04ab63ec-3cba-36ac-87f3-70ab6fb98c9a",
                                        "entry_id": "03787c68-760c-398f-a3d9-18b0891e0fcc",
                                        "glosses": [
                                            "die Schnittpunkte der Bahnen von Himmelskörpern mit einer Bezugsebene"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ed80c5e-5917-4b7d-9ed8-a75f70c7dae1",
                                                "sense_id": "04ab63ec-3cba-36ac-87f3-70ab6fb98c9a",
                                                "text": "Der Planet kreist auf seiner Planetenbahn, und diese hat genau zwei Schnittpunkte mit der Ekliptikebene, die Knoten."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "9a835e67-ed5d-3496-8b6d-b1da6c21f2d4",
                                        "entry_id": "03787c68-760c-398f-a3d9-18b0891e0fcc",
                                        "glosses": [
                                            "Verkehrsknoten, das Zusammentreffen mehrerer Verkehrsströme im Straßen- und Schienennetz sowie in der Luftfahrt, speziell in Österreich als Oberbegriff für ein Autobahnkreuz oder Autobahndreieck"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60e9078d-c83f-4ceb-bed6-862f7ea5eaaa",
                                                "sense_id": "9a835e67-ed5d-3496-8b6d-b1da6c21f2d4",
                                                "text": "Man kann fahren, wann man will. An dem Knoten südlich von Bremen ist immer Stau."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "008538e8-952e-3fca-b45e-57a77dbaf24d",
                                        "entry_id": "03787c68-760c-398f-a3d9-18b0891e0fcc",
                                        "glosses": [
                                            "die Verbindungsstelle von Stäben oder Elementen in der (Bau)statik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e910dd4f-e9f2-4a4c-ac1a-699f3824b6f3",
                                                "sense_id": "008538e8-952e-3fca-b45e-57a77dbaf24d",
                                                "text": "Man kann für jeden Knoten eine Knotengleichung aufstellen."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "dbb36596-96c3-36f7-a0d4-6deb7ee09faa",
                                        "entry_id": "03787c68-760c-398f-a3d9-18b0891e0fcc",
                                        "glosses": [
                                            "bei einer stehenden Welle zum Beispiel in einer Saite oder Luftsäule diejenigen Punkte, an denen die Schwingungsamplitude 0 ist (\\\"Knoten\\\" der stehenden Welle im Gegensatz zu den \\\"Bäuchen\\\" der stehenden Welle)"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd8eab1f-b90c-4041-bd89-72779cb4d973",
                                                "sense_id": "dbb36596-96c3-36f7-a0d4-6deb7ee09faa",
                                                "text": "Die Lage eines Knoten aus der Überlagerung verschiedenartiger Wellen kann man mittels Berechnung feststellen."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "e1fe6684-099f-371d-ade5-514e5388c102",
                                        "entry_id": "03787c68-760c-398f-a3d9-18b0891e0fcc",
                                        "glosses": [
                                            "Verbindungsstelle von Bauelementen in der Elektrotechnik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3add6018-bcba-4dbc-8260-c705c63d8212",
                                                "sense_id": "e1fe6684-099f-371d-ade5-514e5388c102",
                                                "text": "Die Summe aller Ströme, die in einen Knoten fließen, ist null."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "50da26c4-2ac3-3cb5-9f59-13303acb2fb7",
                                        "entry_id": "03787c68-760c-398f-a3d9-18b0891e0fcc",
                                        "glosses": [
                                            "Tumor"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50d28eb3-2464-45d9-8836-045787cd0187",
                                                "sense_id": "50da26c4-2ac3-3cb5-9f59-13303acb2fb7",
                                                "text": "Jede Frau sollte regelmäßig ihre Brust auf Knoten untersuchen."
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    },
                                    {
                                        "sense_id": "21b31b96-0a99-3fb5-a070-c456ad58e515",
                                        "entry_id": "03787c68-760c-398f-a3d9-18b0891e0fcc",
                                        "glosses": [
                                            "Objekt der Graphentheorie, an dem eine oder mehrere Kanten ansetzen"
                                        ],
                                        "tags": [
                                            "Graphentheorie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6380a759-f2f3-419b-87b6-f06b0331efda",
                                                "sense_id": "21b31b96-0a99-3fb5-a070-c456ad58e515",
                                                "text": "Ein Graph heißt \"zusammenhängend\", wenn jeder Knoten von jedem anderen aus über Knoten und Kanten erreichbar ist."
                                            }
                                        ],
                                        "sense_index_json": "\"10\""
                                    },
                                    {
                                        "sense_id": "8e36ff98-7d05-36f9-b908-1773e1714b20",
                                        "entry_id": "03787c68-760c-398f-a3d9-18b0891e0fcc",
                                        "glosses": [
                                            "Haarknoten, eine Frisur, bei der am Hinterkopf die Haare hochgesteckt und befestigt werden"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb07ae3a-c808-46c6-b184-bb204c08faa6",
                                                "sense_id": "8e36ff98-7d05-36f9-b908-1773e1714b20",
                                                "text": "„Ihre langen schwarzen Haare hat sie zu einem Knoten aufgesteckt, sodass Eiríkur ihren langen, weichen Hals sieht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"11\""
                                    }
                                ]
                            }
                        ]
                    },
