                        "sense_id": "15361051-29f6-3fa3-9a3a-cf640adfde91",
                        "entry_id": "fff40123-7644-31dc-a15f-5a9cbf27c686",
                        "glosses": [
                            "Obsolete form of quatrain."
                        ],
                        "tags": [
                            "alt-of",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "566e11cb-edd3-4c85-b1d5-884207168091",
                                "sense_id": "15361051-29f6-3fa3-9a3a-cf640adfde91",
                                "text": "Where the four first Verses are only a Quadran, and consist of 10 Syllables each in Alternate Rhyme"
                            },
                            {
                                "example_id": "7b090856-9f97-46fe-af5f-1ae55458b07a",
                                "sense_id": "15361051-29f6-3fa3-9a3a-cf640adfde91",
                                "text": "The quadran, the rondeau, the triolet, lays, virelays, the chant royal, masquerades, amphigouries, quolibets, romances, concordants, as they are in use amongst the French and Germins, are altogether uninteresting to an English reader."
                            },
                            {
                                "example_id": "705037bb-e638-4d67-92e0-ee1010a8b109",
                                "sense_id": "15361051-29f6-3fa3-9a3a-cf640adfde91",
                                "text": "Where the four first verses are only a quadran, and consist of ten syllables, each in alternate rhyme."
                            }
                        ]
                    }
