                    },
                    {
                        "form_id": "087e1477-1d39-4fc3-b910-f5a409b66b7d",
                        "entry_id": "a9eed760-a1e0-31ff-bf80-455200d910bd",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Weihnachtsmärkte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a85d5cf6-3b7c-31af-8dfe-843fa3d6b120",
                        "entry_id": "a9eed760-a1e0-31ff-bf80-455200d910bd",
                        "glosses": [
                            "in der Vorweihnachtszeit abgehaltener Markt, auf dem in Buden und an Ständen weihnachtliche Lebensmittel (etwa Glühwein, Punsch, Lebkuchen, Printen, Spekulatius oder Christstollen), Ziergegenstände und anderes verkauft werden und auf dem auch Schausteller mit Fahrgeschäften vertreten sein können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da4119c6-fa7f-4fb0-82be-a7e319a550fa",
                                "sense_id": "a85d5cf6-3b7c-31af-8dfe-843fa3d6b120",
                                "text": "Der Frankfurter Weihnachtsmarkt wurde 1393 erstmals urkundlich erwähnt."
                            },
                            {
                                "example_id": "3cbcfe9b-d77b-4d45-8a7b-621ad2637fed",
                                "sense_id": "a85d5cf6-3b7c-31af-8dfe-843fa3d6b120",
                                "text": "„Was Glühwein alles anrichten kann: Der sonst so brave Volksmusikstar Florian Silbereisen hat auf dem Passauer Weihnachtsmarkt randaliert.“"
                            },
                            {
                                "example_id": "c47257d9-0226-49db-914a-add1fadbece1",
                                "sense_id": "a85d5cf6-3b7c-31af-8dfe-843fa3d6b120",
                                "text": "„Auf dem Weihnachtsmarkt am Alexanderplatz ist eine Karussell-Gondel mit 14 jugendlichen Besuchern in etwa acht Metern Höhe steckengeblieben.“"
                            },
                            {
                                "example_id": "28bfbcf3-3663-4505-be08-c4edf428eba4",
                                "sense_id": "a85d5cf6-3b7c-31af-8dfe-843fa3d6b120",
                                "text": "„Die Besucher des kleinen Weihnachtsmarktes in Schwalbach genießen Adventsmusik, Glühwein und Bratwurst.“"
                            },
                            {
                                "example_id": "8e749a2f-2323-423a-94ab-471aadc48306",
                                "sense_id": "a85d5cf6-3b7c-31af-8dfe-843fa3d6b120",
                                "text": "„Was aber macht ‚Last Christmas‘ eigentlich so unsterblich und zu einer derart sicheren Beschallungsbank jedes Weihnachtsmarkts?“"
                            },
                            {
                                "example_id": "de116c98-97e9-46e1-9717-3682a7ea143d",
                                "sense_id": "a85d5cf6-3b7c-31af-8dfe-843fa3d6b120",
                                "text": "„Der Nürnberger Christkindlesmarkt zählt zu den schönsten und ältesten Weihnachtsmärkten in Deutschland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
