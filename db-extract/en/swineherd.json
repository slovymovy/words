                                                "example_id": "9f070435-f588-44dd-be5f-8462f4585639",
                                                "sense_id": "80049f5f-ff38-3375-beed-34ea498da22e",
                                                "text": "... alors ils laisseront les bêtes à d’autres enfants ou au porcher du village..."
                                            }
