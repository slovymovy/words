                                "target_senses": [
                                    {
                                        "sense_id": "a5263c79-c34c-36e5-ae21-b1e4692f0d53",
                                        "entry_id": "78186302-2a1c-35fa-b945-56e61d04e8e0",
                                        "glosses": [
                                            "The day of a person's death, especially when viewed as being appointed by fate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18863af6-24b8-49a7-b1f3-66a2adf2ff6d",
                                                "sense_id": "a5263c79-c34c-36e5-ae21-b1e4692f0d53",
                                                "text": "The placing of the dragon is inevitable: a man can but die upon his death-day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "788fcbf2-60d4-31c1-907d-026194395eaa",
                                        "entry_id": "78186302-2a1c-35fa-b945-56e61d04e8e0",
                                        "glosses": [
                                            "The anniversary of a death, the date upon which someone earlier died."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed4e66b0-2635-42e9-809d-44849518426d",
                                                "sense_id": "788fcbf2-60d4-31c1-907d-026194395eaa",
                                                "text": "\"Is it her deathday?\" I asked. \"Nope,\" he said."
                                            },
                                            {
                                                "example_id": "faa7a9b5-f3ff-4b48-87be-72138a4d9f3c",
                                                "sense_id": "788fcbf2-60d4-31c1-907d-026194395eaa",
                                                "text": "It only just dawned on me that intrinsically it felt better to honor her on her birthday rather than her deathday. It has always struck me as odd that more people remember the day Elvis or John Lennon died than the dates they were born."
                                            },
                                            {
                                                "example_id": "efe824c8-2ed6-4b85-ad7e-27a09cd2fabc",
                                                "sense_id": "788fcbf2-60d4-31c1-907d-026194395eaa",
                                                "text": "[…] just then we needed a tenth man and needed him badly, because one of us had a deathday to observe and wanted to say the mourner's prayer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
