                        "glosses": [
                            "Mouvement plutôt d’avant la Première Guerre mondiale qui constitue les prémices du fascisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbb7f3f4-fb48-4d1a-86d4-41645e40b08c",
                                "sense_id": "91269fc9-4f85-3517-98a6-cfc37fa7680a",
                                "text": "Ces rejetons du protofascisme n’eurent cependant pas une audience suffisante pour créer un mouvement de fond."
