                ],
                "senses": [
                    {
                        "sense_id": "3779594a-9966-30fa-a461-a18e344a8236",
                        "entry_id": "e585042c-2953-3adc-a5ff-5719ce409bc6",
                        "glosses": [
                            "beeldscherm voor een computer dat gevoelig is voor en kan reageren op aanraking"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "462e951c-c86a-4b69-8502-32a4adc60f25",
                                "sense_id": "3779594a-9966-30fa-a461-a18e344a8236",
                                "text": "En ook technologie is alomtegenwoordig. Denk maar aan e-reserveringen of aan touchscreens waarop je de hele collectie in de winkel kunt bekijken."
                            },
                            {
                                "example_id": "db7eda70-c3d9-49f8-979a-52783c88c64a",
                                "sense_id": "3779594a-9966-30fa-a461-a18e344a8236",
                                "text": "Erg fijn lezen op zo’n groot 7,8 inch scherm. De e-reader kan ongeveer 6000 boeken opslaan, ligt comfortabel in de hand en beschikt over gebruiksvriendelijke software. Houd je van lezen in bad? Geen probleem, de Aura One is waterdicht. De bediening gaat vrijwel uitsluitend via het touchscreen. Op de aan-uitknop na, bevinden er zich geen fysieke knoppen op het apparaat."
                            },
                            {
                                "example_id": "dbff7d1f-2cc4-4efe-9bbd-5b2158511dc3",
                                "sense_id": "3779594a-9966-30fa-a461-a18e344a8236",
                                "text": "Alle functies zitten achter deze twee scrollwieltjes verborgen, die computergebruikers kennen van hun muis. Van het verstellen van de buitenspiegels en het stuurwiel, tot het regelen van de airco: alles gaat met deze twee wieltjes, in combinatie met het 15 inch grote touchscreen dat bevallig over het dashboard gedrapeerd ligt."
                            }
                        ]
                    }
                ],
