                "senses": [
                    {
                        "sense_id": "3c809383-e615-3288-969b-4612202bb419",
                        "entry_id": "26a27b72-fa3d-38ac-a504-85a8dc742a0e",
                        "glosses": [
                            "Mann, der durch Charme und/oder Durchtriebenheit Eindruck macht und/oder sich etwas verschafft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18ab7652-4c02-4b4c-a183-f43a70de4cc7",
                                "sense_id": "3c809383-e615-3288-969b-4612202bb419",
                                "text": "Der alte Schwerenöter übt sich mal wieder in anzüglichen Witzen."
                            },
                            {
                                "example_id": "e510bfb0-15be-45ac-b5b3-65400117ae0e",
                                "sense_id": "3c809383-e615-3288-969b-4612202bb419",
                                "text": "„Stanik Cholonek und seine Frau Mickel - also der Schwerenöter und Überflieger in seinen Lackschuhen und seine snobistische Ehefrau - hatten viel von Janoschs Eltern.“"
                            },
                            {
                                "example_id": "3eb31e28-2f60-4ca1-8246-a4093e48792f",
                                "sense_id": "3c809383-e615-3288-969b-4612202bb419",
                                "text": "„Dieser alte Schwerenöter war nämlich seinerseits vom ersten Blick an verliebt und überbot sich mit dem Marquis an Geschenken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a1587cd6-a828-3730-9bc0-f37894acfbe6",
                        "entry_id": "26a27b72-fa3d-38ac-a504-85a8dc742a0e",
                        "glosses": [
                            "Mann, der Frauen nachstellt und deshalb besonders keck oder charmant ihnen gegenüber ist"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39af2c6e-96f1-4f50-befc-c9dbe6db9bf4",
                        "source_entry_id": "26a27b72-fa3d-38ac-a504-85a8dc742a0e",
                        "source_sense_id": "3c809383-e615-3288-969b-4612202bb419",
                        "source_sense_description": "Mann, der durch Charme und/oder Durchtriebenheit Eindruck macht und/oder sich etwas verschafft",
                        "target_lang_word": "womanizer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "womanizer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ed4c222-32bb-3d26-8829-b4ebc9ea9f2d",
                                        "entry_id": "22e85a65-8c36-3384-a08e-88fe858d2f19",
                                        "glosses": [
                                            "A man who habitually flirts with and seduces, or attempts to seduce, women."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "607858f5-b55a-4552-b886-435584250e60",
                                                "sense_id": "6ed4c222-32bb-3d26-8829-b4ebc9ea9f2d",
                                                "text": "Getting back into the dating game after a painful divorce is never easy, and the proliferation of womanizers looking to take advantage of your vulnerability only makes things worse."
                                            },
                                            {
                                                "example_id": "32c9d901-64f0-4af0-933d-8db786a6bb40",
                                                "sense_id": "6ed4c222-32bb-3d26-8829-b4ebc9ea9f2d",
                                                "text": "A couple of months ago, in a piece about the language of self-involvement, I quoted a girlfriend of Woody Allen as having described the actor as “very much of a womanizer, very self-involved”."
                                            },
                                            {
                                                "example_id": "6c2a1058-de31-42a4-b874-d2e5d47d71f5",
                                                "sense_id": "6ed4c222-32bb-3d26-8829-b4ebc9ea9f2d",
                                                "text": "Sometimes the stereotype is framed as light and cheeky—think the “boys will be boys” mentality exemplified by sitcom womanizers such as How I Met Your Mothers Barney Stinson or '''Two and a Half Mens Charlie Harper."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab5f7597-cdac-4ecf-a178-33f99b93a581",
                        "source_entry_id": "26a27b72-fa3d-38ac-a504-85a8dc742a0e",
                        "source_sense_id": "3c809383-e615-3288-969b-4612202bb419",
                        "source_sense_description": "Mann, der durch Charme und/oder Durchtriebenheit Eindruck macht und/oder sich etwas verschafft",
                        "target_lang_word": "coureur de jupons",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coureur de jupons",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "45bcc088-6d8c-3b2a-ad3d-58c806ea05f2",
                                        "entry_id": "47fad8f1-d6c9-3dcf-9ead-c39ee14feb61",
                                        "glosses": [
                                            "Personne qui aime à séduire de nombreuses femmes."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2279826-8e67-4490-8070-25d8c637c9cd",
                                                "sense_id": "45bcc088-6d8c-3b2a-ad3d-58c806ea05f2",
                                                "text": "Je m’excuse, vous n’étiez pas censé voir ce que vous avez vu. Je suis un horrible coureur de jupons, dit-il comme pour se faire pardonner, chez moi c’est pathologique."
                                            },
                                            {
                                                "example_id": "a5d86a84-c408-4c14-a87b-8d0e93c41525",
                                                "sense_id": "45bcc088-6d8c-3b2a-ad3d-58c806ea05f2",
                                                "text": "Je lisais l’article,avec une indignation croissante. Faith Smith d’AM-UK ! divorce de son mari Peter. La jolie miss météo a avoué à des amis qu’elle en « avait assez » de ses manies de coureur de jupons."
                                            },
                                            {
                                                "example_id": "f644c393-3875-4544-a948-5711da933cd5",
                                                "sense_id": "45bcc088-6d8c-3b2a-ad3d-58c806ea05f2",
                                                "text": "Le coureur de jupons ne sait plus se tenir :\nEn sa ligne de mire, une femme, messires !\nCourant comme un heureux vers sa douce conquête\nOn le soupçonne d’être un as de la quéquette !\nUn mythe qui pourrait bien vite s’écrouler […]."
                                            },
                                            {
                                                "example_id": "61b0bba8-46f3-4968-a7b8-1fe2bd6274cc",
                                                "sense_id": "45bcc088-6d8c-3b2a-ad3d-58c806ea05f2",
                                                "text": "Pauvre Bill. En plus de la gêne occasionnée par la découverte que sa femme était une coureuse de jupons, il lui fallait limiter les dégâts sur sa propre carrière politique en campant sur une position ferme concernant les valeurs familiales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5edfb32-bba6-4bf8-a378-8a9289ed023e",
                        "source_entry_id": "26a27b72-fa3d-38ac-a504-85a8dc742a0e",
                        "source_sense_id": "3c809383-e615-3288-969b-4612202bb419",
                        "source_sense_description": "Mann, der durch Charme und/oder Durchtriebenheit Eindruck macht und/oder sich etwas verschafft",
                        "target_lang_word": "séducteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "séducteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "523c2a6c-adca-3b80-a893-d88792abc312",
                                        "entry_id": "4220d491-6cec-368a-ab0b-7d4af7eba809",
                                        "glosses": [
                                            "Qui cherche à plaire, qui charme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb321a2c-c469-43dc-b7f2-a2dbca6bdae2",
                                                "sense_id": "523c2a6c-adca-3b80-a893-d88792abc312",
                                                "text": "Un discours, un ton séducteur."
                                            },
                                            {
                                                "example_id": "b46d43df-8293-4edf-ba51-94d9ef6fd8e7",
                                                "sense_id": "523c2a6c-adca-3b80-a893-d88792abc312",
                                                "text": "L’esprit séducteur : le diable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "séducteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa00affe-79f6-3b04-9c4c-55c5426c16a1",
                                        "entry_id": "8b77c9b3-664e-38cc-9533-b526cb6db47c",
                                        "glosses": [
                                            "Celui qui séduit, qui fait tomber en erreur ou en faute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d71e694-9299-4bc1-9d7f-6ba00c6dbc66",
                                                "sense_id": "aa00affe-79f6-3b04-9c4c-55c5426c16a1",
                                                "text": "Séducteur de la jeunesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2a6dd0e-396b-3234-b54f-1a3577239383",
                                        "entry_id": "8b77c9b3-664e-38cc-9533-b526cb6db47c",
                                        "glosses": [
                                            "Celui qui corrompt l’innocence, la vertu des jeunes personnes ou des adultes."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5558567a-8e77-4a43-b91b-6ab4884703ba",
                                                "sense_id": "f2a6dd0e-396b-3234-b54f-1a3577239383",
                                                "text": "Pour elle j'étais l’amant, non le séducteur; elle revoyait son premier rendez-vous, elle ressentait le premier baiser; elle se revirginisait! Pauvre Gretchen!"
                                            },
                                            {
                                                "example_id": "7e7e820b-e1f2-4fff-8401-ca9f174d7093",
                                                "sense_id": "f2a6dd0e-396b-3234-b54f-1a3577239383",
                                                "text": "Des imbéciles qui se retrouvaient en tôle[sic] parce qu'il fallait faire sa fête à la fauteuse et trucider le séducteur. Pour l'honneur ! Mon œil pensait Lekbir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
