                        "entry_id": "b651258c-23da-37f9-999f-6f4ffb712703",
                        "glosses": [
                            "A Japanese painting or woodblock print depicting everyday life."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d37a42a2-b039-420b-b7ed-7087d7eeb8b6",
                                "sense_id": "0f96d29f-fa03-379f-934d-7d2a725d71d8",
                                "text": "Like many Ukiyo-e artists, Jacoulet hires woodcarvers and printers to convert his ideas into prints."
                            },
                            {
                                "example_id": "7ece8e5b-b7fe-49f5-8f4b-5c8d3c1c3850",
                                "sense_id": "0f96d29f-fa03-379f-934d-7d2a725d71d8",
                                "text": "The masters of Ukiyo-e, the woodblock print, like Utamaro, immortalized its great courtesans and its famous houses of prostitution."
                            },
                            {
                                "example_id": "ccf7cb22-0c31-4660-bd1c-6b020333b683",
                                "sense_id": "0f96d29f-fa03-379f-934d-7d2a725d71d8",
                                "text": "Starling looked past Carter, to an ukiyo-e woodcut of a Kabuki player."
                            }
                        ]
                    }
                ],
