                "senses": [
                    {
                        "sense_id": "ce487c58-0d7a-3be2-aa7e-1cb224d94966",
                        "entry_id": "2d9ee0b0-5c51-386a-b6d1-0f475c900182",
                        "glosses": [
                            "Partie du vêtement des hommes qui couvrait depuis la ceinture jusqu’aux genoux ou plus bas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "229b7a91-2669-4720-914a-8d65338b0998",
                                "sense_id": "ce487c58-0d7a-3be2-aa7e-1cb224d94966",
                                "text": "[…] ; l’autre, son barda sur l’épaule, les chausses lui dégringolant le long des jambes, la tête rejetée en arrière et s'envoyant un jet de sa gourde dans le gosier, a l’allure épaisse et la trogne truculente d’un rustaud des Flandres."
                            },
                            {
                                "example_id": "0c433be5-d94e-4af7-877e-736096892d3a",
                                "sense_id": "ce487c58-0d7a-3be2-aa7e-1cb224d94966",
                                "text": "[…] ses chausses lui étant tombées sur les jarrets."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b5b71af-1091-4168-b289-e0dc6cf01934",
