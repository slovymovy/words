                        "glosses": [
                            "Celui qui cultive le safran."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efe4315e-50a4-40b4-84ba-6b3fe607672c",
                                "sense_id": "45609fae-d956-3e3c-8f54-c4eb19dfc812",
                                "text": "Jérôme Aussenac, safranier dans le Lauragais, ressent lui aussi le phénomène  : «  Je vends de plus en plus de bulbes à des gens qui veulent s’installer. C’est devenu mon activité principale, je vis davantage de la vente des bulbes que de la production d’épices.  »"
                            }
                        ]
                    },
                    {
                        "sense_id": "a81ae077-70a3-3139-9191-952c8e762805",
                        "entry_id": "22a119ae-7b19-388b-8110-f4f4bd4225ab",
                        "glosses": [
                            "Homme ruiné, banqueroutier."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "1a00480c-faed-4676-9f9d-7e18f9cd23e8",
                                "sense_id": "a81ae077-70a3-3139-9191-952c8e762805",
                                "text": "On vit le beau nom de la haute noblesse flétri par un tas de safraniers, mais reçus par les nobles pour faire nombre."
                            },
                            {
                                "example_id": "400f3751-0b29-4d46-a531-9d48cd51147e",
                                "sense_id": "a81ae077-70a3-3139-9191-952c8e762805",
                                "text": "Je me suis veu d’escolier conseiller ; de conseiller, ambassadeur ; d’ambassadeur, saffranier ; de saffranier, matois."
                            }
                        ]
                    }
