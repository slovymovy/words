                    "sense_id": "7d09e36d-0763-3eb9-8031-9eba22bb4276",
                    "sense_definition": "A person with whom one shares a flat.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cohabitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to find a new <w>flatmate</w> to help pay the rent this month.",
                            "target_lang_translations": {
                                "ru": "Мне нужно найти нового <w>соседа по квартире</w>, чтобы помочь оплатить аренду в этом месяце."
                            }
                        },
                        {
                            "text": "My <w>flatmate</w> and I usually take turns cleaning the kitchen and the bathroom.",
                            "target_lang_translations": {
                                "ru": "Мы с моим <w>соседом по квартире</w> обычно по очереди убираем кухню и ванную."
                            }
                        }
                    ],
                    "synonyms": [
