                        "entry_id": "77dacdbe-4b59-351f-a89c-d8a750f6a3df",
                        "glosses": [
                            "overgangsgebied tussen licht en donker op een planeet of maan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95a2e469-3b30-44bb-ac0f-89c0c0a23db6",
                                "sense_id": "423f8703-d77f-323f-b772-f061417974ef",
                                "text": "Bij het eerste of laatste kwartier van de maanfasen verdeelt de terminator de maan in twee gelijke delen."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9373be6-c4bc-3f0a-8a82-89016eac5cd1",
                        "entry_id": "77dacdbe-4b59-351f-a89c-d8a750f6a3df",
                        "glosses": [
                            "karakteristieke reeks bits in een informatiestroom die aangeeft dat die stroom wordt afgesloten"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "aabc8b64-d437-34ea-a410-de1aaed522e3",
                        "entry_id": "77dacdbe-4b59-351f-a89c-d8a750f6a3df",
                        "glosses": [
                            "een karakteristiek gen dat een sequentie afsluit"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "96eb90e2-d711-3caf-aee4-dc17b0ab0f7a",
                        "entry_id": "77dacdbe-4b59-351f-a89c-d8a750f6a3df",
                        "glosses": [
                            "component die wordt aangebracht aan het eind van transmissielijnen en databussen om signaalreflectie en vermogensverlies tegen te gaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "008b5f09-7fe0-4996-b371-8a6766554480",
                                "sense_id": "96eb90e2-d711-3caf-aee4-dc17b0ab0f7a",
                                "text": "Een terminator is nodig voor een storingsvrije werking van een stroomnetwerk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f72c2c0-85da-457d-ac19-f6d920cb023a",
                        "source_entry_id": "77dacdbe-4b59-351f-a89c-d8a750f6a3df",
                        "source_sense_id": "423f8703-d77f-323f-b772-f061417974ef",
                        "source_sense_description": "licht-donkergrens",
                        "target_lang_word": "Terminator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Terminator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f88ca46-1312-3343-8090-9b23269edff4",
                                        "entry_id": "df041aa4-919f-33a4-a3f7-98fb3c6cd35c",
                                        "glosses": [
                                            "optische Grenzlinie zwischen Tag und Nacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddf5b80a-8417-4d82-97b3-989fdf7b491d",
                                                "sense_id": "5f88ca46-1312-3343-8090-9b23269edff4",
                                                "text": "Am Terminator sind Mondkrater wegen des Schattenwurfs besonders gut zu beobachten."
                                            },
                                            {
                                                "example_id": "578b5258-d03b-40e8-90f2-423df99a0ac1",
                                                "sense_id": "5f88ca46-1312-3343-8090-9b23269edff4",
                                                "text": "„Diese Trennlinie, Terminator genannt, schiebt sich am Mondäquator täglich um 370 km weiter, also mit gemächlichen 15 km/h.“"
                                            },
                                            {
                                                "example_id": "662e3bbb-ff6f-47a9-8aad-41e1f8b9776c",
                                                "sense_id": "5f88ca46-1312-3343-8090-9b23269edff4",
                                                "text": "„Die Grenze zwischen Licht und Schatten, der Terminator, wandert langsam über die Mondoberfläche.“"
                                            },
                                            {
                                                "example_id": "48a2aa59-77cc-48e5-8460-d87c5d08f89a",
                                                "sense_id": "5f88ca46-1312-3343-8090-9b23269edff4",
                                                "text": "„Die Grenze zwischen beleuchteter und unbeleuchteter Seite, also die Tag-Nacht-Grenze, nennt man Terminator.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Terminator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "380d38bb-89f2-31d6-a902-8e72688cf073",
                                        "entry_id": "29d8dbbb-08bd-3f7d-a111-8dfa0a21be7f",
                                        "glosses": [
                                            "fiktiver Androide aus der gleichnamigen Filmreihe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f51ecedc-0a43-4c6e-836b-3d048e7a9f49",
                                                "sense_id": "380d38bb-89f2-31d6-a902-8e72688cf073",
                                                "text": "„›Wir sind vom Stamm der Kalendjin, Krieger ... so wie Rambo‹, antwortete einer und zeigte lachend auf mich. ›Oder Terminator‹, sagte ein anderer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "408d98ca-1c52-4455-9ef3-702af90bb4b8",
                        "source_entry_id": "77dacdbe-4b59-351f-a89c-d8a750f6a3df",
                        "source_sense_id": "423f8703-d77f-323f-b772-f061417974ef",
                        "source_sense_description": "licht-donkergrens",
                        "target_lang_word": "terminator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terminator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed380a79-4373-3b3e-96cf-e22f8885e1c3",
                                        "entry_id": "0592be81-84ea-391d-ac72-23fccffa5120",
                                        "glosses": [
                                            "Someone who terminates or ends something, especially (in later use) an assassin or exterminator."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7391ed6-17fd-35f0-adc1-cc6c71b7fc22",
                                        "entry_id": "0592be81-84ea-391d-ac72-23fccffa5120",
                                        "glosses": [
                                            "A text character or string that serves to mark the end of a document or transmission."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c94b510-bb32-3225-ada1-d61c4df0f4d4",
                                        "entry_id": "0592be81-84ea-391d-ac72-23fccffa5120",
                                        "glosses": [
                                            "The line between the day side and the night side of a moon, planet or other celestial body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaec27be-e84b-49c7-a34e-83b1c62ed92a",
                                                "sense_id": "6c94b510-bb32-3225-ada1-d61c4df0f4d4",
                                                "text": "Harriot, looking at the moon, saw the irregular terminator, the highlights and shadows, the mountain ranges and valleys that Galileo had described – and he also convinced himself that he saw Galileo's imaginary crater."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a937509b-5009-3830-b43b-4faeb2e84631",
                                        "entry_id": "0592be81-84ea-391d-ac72-23fccffa5120",
                                        "glosses": [
                                            "A DNA sequence that causes RNA transcription to cease and an mRNA transcript to break off."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bae6a9d5-08f0-3c00-9145-d2d04083e471",
                                        "entry_id": "0592be81-84ea-391d-ac72-23fccffa5120",
                                        "glosses": [
                                            "An electrical device that absorbs reflection at the end of a transmission line."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23de5820-6556-3a05-8fb5-6592d68dad1f",
                                        "entry_id": "0592be81-84ea-391d-ac72-23fccffa5120",
                                        "glosses": [
                                            "An intelligent android created to destroy humans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fc0b584-94ac-46ee-a6ea-a41fe5b2ec34",
                                                "sense_id": "23de5820-6556-3a05-8fb5-6592d68dad1f",
                                                "text": "Opposite of natural monsters there are technological monsters such as terminators, cyborgs, and robocops—all of which undermine dichotomies between the artificial and the organic, the prosthetic and the natural."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a05cd2b-8c4b-4bbe-8ab3-8681cc6ce0ab",
                        "source_entry_id": "77dacdbe-4b59-351f-a89c-d8a750f6a3df",
                        "source_sense_id": "423f8703-d77f-323f-b772-f061417974ef",
                        "source_sense_description": "licht-donkergrens",
                        "target_lang_word": "twilight zone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "twilight zone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c764b5f1-c8e5-3e73-b444-e74c9700d6d2",
                                        "entry_id": "87485118-e50e-321b-9124-583f4cbc5895",
                                        "glosses": [
                                            "A moving line that divides the daylit side and the dark night side of a planetary body."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b668259-2abb-3d08-8096-97e7c0773ece",
                                        "entry_id": "87485118-e50e-321b-9124-583f4cbc5895",
                                        "glosses": [
                                            "A region or context located in between others and therefore not subject to their norms."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5213bdb5-d3f2-4673-a627-22e9e8dc726e",
                                                "sense_id": "7b668259-2abb-3d08-8096-97e7c0773ece",
                                                "text": "As to this right, therefore, the people have expressly created a twilight zone, in which neither nation nor state can act."
                                            },
                                            {
                                                "example_id": "85aaf7bb-c8e9-4372-8605-e361ef84748e",
                                                "sense_id": "7b668259-2abb-3d08-8096-97e7c0773ece",
                                                "text": "They were interesting because they represented a sort of twilight zone separating the \"old days\" from modern times."
                                            },
                                            {
                                                "example_id": "5d58f852-d5ca-46a7-bb95-ac5f3866fc5d",
                                                "sense_id": "7b668259-2abb-3d08-8096-97e7c0773ece",
                                                "text": "...the classification scheme related to goods which lay in a \"twilight zone\" between consumer goods and equipment or between inventory and farm products."
                                            },
                                            {
                                                "example_id": "da1c1ac1-e4e4-4801-b7bf-7835ca408747",
                                                "sense_id": "7b668259-2abb-3d08-8096-97e7c0773ece",
                                                "text": "But is there not a twilight zone over which both Church and State put forth claims?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "861f00e5-5277-3319-8faa-ec9b3201f348",
                                        "entry_id": "87485118-e50e-321b-9124-583f4cbc5895",
                                        "glosses": [
                                            "A deteriorating area surrounding a central business district."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91f95f0e-a10c-418b-b618-8b0b88b635fc",
                                                "sense_id": "861f00e5-5277-3319-8faa-ec9b3201f348",
                                                "text": "Geographically speaking, the twilight zone encompasses those areas that lie between the central business district and the first ring of suburban shopping centers, many of which are comparatively obsolete."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ca24378-900d-383c-9312-ae88af0cd151",
                                        "entry_id": "87485118-e50e-321b-9124-583f4cbc5895",
                                        "glosses": [
                                            "Synonym of mesopelagic zone (“The part of the ocean where there is very minimal light, located below the photic epipelagic zone but above the aphotic bathypelagic zone.”)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "twilight zone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "368b2810-5452-34bf-a760-9c1be633a010",
                                        "entry_id": "8e67f19d-cb6f-3f85-a5a9-98f490bf757d",
                                        "glosses": [
                                            "To put or place into an indeterminate position; to be in an ambiguous, undetermined, or improper context."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5f32e57-015c-4546-b92e-8889679cfcc9",
                                                "sense_id": "368b2810-5452-34bf-a760-9c1be633a010",
                                                "text": "Sometimes I think she's really a gym teacher twilight-zoned into the corridors of government. I'm always surprised to see that it's a gold, clipless Cross pen she's carrying and not a gym whistle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fde223ad-640d-3bc1-8b05-4002959a7e21",
                                        "entry_id": "8e67f19d-cb6f-3f85-a5a9-98f490bf757d",
                                        "glosses": [
                                            "To cause to daydream or zone out; to cause to lose attention to one's surroundings."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5bca88c-2cd6-409e-afda-5d602b9cde3d",
                                                "sense_id": "fde223ad-640d-3bc1-8b05-4002959a7e21",
                                                "text": "\"I've been distant and into myself all night,\" I said. \"The kids say I get twilight zoned.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "twilight zone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "101e7279-babc-3a53-bd99-a436ab34e379",
                                        "entry_id": "4d45e13f-9d8d-3ee8-bdf8-a48614526bf0",
                                        "glosses": [
                                            "A region in which surreal, supernatural, or fantastic events occur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "322e59a8-a609-46ac-a3f9-1e3917a8c6a2",
                                                "sense_id": "101e7279-babc-3a53-bd99-a436ab34e379",
                                                "text": "Oh, I can't talk right now, Duke. I'm in the twilight zone."
                                            },
                                            {
                                                "example_id": "0fd173f8-203c-4567-a73b-bed3c1457882",
                                                "sense_id": "101e7279-babc-3a53-bd99-a436ab34e379",
                                                "text": "Ground controllers were uncertain for some agonizing hours what had happened to the spacecraft [...] \"We have entered the twilight zone,\" dead-panned one jaded engineer."
                                            },
                                            {
                                                "example_id": "4e1d4a74-142c-406b-898d-7860b297f9e3",
                                                "sense_id": "101e7279-babc-3a53-bd99-a436ab34e379",
                                                "text": "Suddenly, to her astonishment and mine, it turned black and blue! I wondered if we'd just entered the twilight zone."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "twilight zone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b32192df-040f-3b83-8a4f-55abaaffc703",
                                        "entry_id": "bd0c9743-9b1c-3485-868f-2fd2afb924d8",
                                        "glosses": [
                                            "To experience or perceive something bizarre or fantastic."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fadaa27c-c1f1-4536-937d-0ab1312dcbd8",
                                                "sense_id": "b32192df-040f-3b83-8a4f-55abaaffc703",
                                                "text": "Then a gnome like white haired lady, bent like a human question mark, lurched toward me and asked if I was the mailman. [...] I was Twilight Zoning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "812ab331-dc40-30fb-969d-ac60a2bd0287",
                                        "entry_id": "bd0c9743-9b1c-3485-868f-2fd2afb924d8",
                                        "glosses": [
                                            "To behave or occur in a confusing or unexpected manner."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4aa0aec5-a32a-4893-935e-b57463234569",
                                                "sense_id": "812ab331-dc40-30fb-969d-ac60a2bd0287",
                                                "text": "The service is likely from a bad twilight zone episode. [...] I did get what I required but I had to ask lots of questions as the communication was Twilight Zoning often."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11504bc0-ca8d-4457-b447-3baf4a5baefe",
