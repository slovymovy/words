                    {
                        "translation_id": "00969d9f-c5f3-402f-aed3-3fcec0f4e5c0",
                        "source_entry_id": "dadb29d1-2ccd-328a-a0cb-0b62c72f28fd",
                        "target_lang_word": "onderaannemer",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onderaannemer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b3e26b78-d0c2-355b-ac9b-709f372b7619",
                                        "entry_id": "bb6f88ad-f977-36db-90a4-611989b16111",
                                        "glosses": [
                                            "de natuurlijke of rechtspersoon, wie werk doet voor de hoofdaannemer tegen een vooraf vastgestelde prijs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0371409a-a6d1-40d7-80fc-44a5dd736dc5",
                                                "sense_id": "b3e26b78-d0c2-355b-ac9b-709f372b7619",
                                                "text": "De grote uitdagingen op het vlak van duurzaam ondernemen verschuiven van het ‘moederbedrijf’ naar de toeleveranciers, onderaannemers en distributeurs in ontwikkelingslanden of groeilanden zoals India. Dat maakte een artikel in deze krant over kinderarbeid in granietgroeves nog maar eens duidelijk"
                                            },
                                            {
                                                "example_id": "4b91c76d-8ade-4fc4-b883-5c3558db3b47",
                                                "sense_id": "b3e26b78-d0c2-355b-ac9b-709f372b7619",
                                                "text": "Grote opdrachtgevers en bouwers doen graag zaken met het Achterhoekse bedrijf, omdat Sorba niet alleen maar gevels tekent en bouwt, maar ook het projectmanagement voor zijn rekening neemt, dat wil zeggen onderaannemers aanstuurt en budget en tijdsplanning bewaakt. “Onze grote kracht schuilt in de combinatie van engineering en projectmanagement”, weet Kosters. Sorba heeft op die manier al veel prestigieuze projecten neergezet, zoals het dak van het nieuwe ov-station Arnhem, het Eye-filmmuseum in Amsterdam en Beeld en Geluid in Hilversum."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
