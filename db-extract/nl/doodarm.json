                    }
                ],
                "senses": [
                    {
                        "sense_id": "3112e7a9-3ba6-37b1-bad7-3ae6279aaa65",
                        "entry_id": "b7a25c24-e805-347e-aff6-5d47966ddff6",
                        "glosses": [
                            "heel erg arm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13f8c86a-0b50-44e7-aad5-a93231c27ffa",
                                "sense_id": "3112e7a9-3ba6-37b1-bad7-3ae6279aaa65",
                                "text": "We zien bij Job dat hij van de hoogste rijkdom verviel in de diepste armoede en op de mesthoop terechtkwam. De mens, die zo rijk was in de staat van de rechtheid, is door de zonde doodarm geworden."
                            },
                            {
                                "example_id": "4461a239-ff28-4461-b643-84ee863ac8b8",
                                "sense_id": "3112e7a9-3ba6-37b1-bad7-3ae6279aaa65",
                                "text": "In het muur-toerisme zag hij nieuwe kansen. Zijn familie protesteerde fel, de dorpelingen lachten hem uit, omdat de torens en de muur hier bijkans onbereikbaar zijn. Maar hij zette door, zoals hij in de jaren tachtig de ontginning van de mijnen in deze verlaten, doodarme streek doorzette. Toevallige, archeologische ontdekkingen bij de aanleg van een weg en de afgraving van een berg sterkten hem in zijn plannen."
                            },
                            {
                                "example_id": "624382e3-612c-44f0-a53a-2c028c133b5c",
                                "sense_id": "3112e7a9-3ba6-37b1-bad7-3ae6279aaa65",
                                "text": "Allemaal tijdrovende activiteiten die verder werden vertraagd door slechte arbeidsomstandigheden, gebrekkige laboratoria, slechte huisvesting en slecht eten in doodarme, hooggelegen dorpen in het grensgebied van China en Vietnam."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "342220e5-ac9e-4495-9384-9b487b78b9dd",
                        "source_entry_id": "b7a25c24-e805-347e-aff6-5d47966ddff6",
                        "source_sense_id": "3112e7a9-3ba6-37b1-bad7-3ae6279aaa65",
                        "source_sense_description": "heel erg arm",
                        "target_lang_word": "penniless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "penniless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a623a4bd-8554-3ae1-bdcb-fce39a6467cc",
                                        "entry_id": "88576137-0ea4-3599-b1cf-ebed817e912c",
                                        "glosses": [
                                            "Lacking even the smallest amount of money."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdd7f340-8960-4405-a210-cb343c4f16c9",
                                                "sense_id": "a623a4bd-8554-3ae1-bdcb-fce39a6467cc",
                                                "text": "In societies without national insurance of any kind, almshouses are the last refuge of penniless people."
                                            },
                                            {
                                                "example_id": "a640b167-c15d-4fc7-88f0-fe6fe03e1d33",
                                                "sense_id": "a623a4bd-8554-3ae1-bdcb-fce39a6467cc",
                                                "text": "In a functioning digital economy, being cashless is far different from being penniless, because cash is merely one form of money; but some preppers hoard gold in case the system gets destroyed and cashlessness suddenly becomes pennilessness."
                                            },
                                            {
                                                "example_id": "12e84425-26ff-4e48-a0fb-2d60186ae399",
                                                "sense_id": "a623a4bd-8554-3ae1-bdcb-fce39a6467cc",
                                                "text": "A dollar and a quarter seems a small sum, but if you are absolutely penniless it might as well be a thousand."
                                            },
                                            {
                                                "example_id": "4925aadb-5aa2-493d-acbf-4682e461618e",
                                                "sense_id": "a623a4bd-8554-3ae1-bdcb-fce39a6467cc",
                                                "text": "This time was most dreadful for Lilian. Thrown on her own resources and almost penniless, she maintained herself and paid the rent of a wretched room near the hospital by working as a charwoman, sempstress, anything. In a moment she had dropped to the level of a casual labourer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26f3721d-9d1e-3c58-baf5-5841db400a0c",
                                        "entry_id": "88576137-0ea4-3599-b1cf-ebed817e912c",
                                        "glosses": [
                                            "Abstaining from the use of penny coins, despite having fully decimalized currency, via rounding of cash transactions (but not necessarily of cashless ones)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f5485cc-bf3a-4480-9f7f-7fe212974aed",
                                                "sense_id": "26f3721d-9d1e-3c58-baf5-5841db400a0c",
                                                "text": "Canada became a penniless country in 2013 simply by rounding its cash transactions to the nearest nickel but otherwise not changing anything."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0d8f8c4-3438-4b79-a51d-a8b4e6a3b9f9",
                        "source_entry_id": "b7a25c24-e805-347e-aff6-5d47966ddff6",
                        "source_sense_id": "3112e7a9-3ba6-37b1-bad7-3ae6279aaa65",
                        "source_sense_description": "heel erg arm",
                        "target_lang_word": "destitute",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "destitute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3102d2cc-359c-327e-b8d2-b5d6f2585fe3",
                                        "entry_id": "2b45ec86-aaf3-3af8-a507-5773f9a03ffa",
                                        "glosses": [
                                            "Lacking something; devoid."
                                        ],
                                        "tags": [
                                            "followed by the preposition \\\"of\\"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62bf58ae-4ca0-4f62-b5b5-7c2b9ce3e591",
                                                "sense_id": "3102d2cc-359c-327e-b8d2-b5d6f2585fe3",
                                                "text": "Now, though this region may scarcely be said to be wedded to science, being to all intents a virgin territory as respects the enquirer into natural history, still it is greatly destitute of the treasures of the vegetable kingdom."
                                            },
                                            {
                                                "example_id": "ba69c42e-e7cb-4d6c-a3ea-d260ffb762d7",
                                                "sense_id": "3102d2cc-359c-327e-b8d2-b5d6f2585fe3",
                                                "text": "In thee is my trust; leave not my soul destitute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "156ac477-8d46-3b86-ad68-0571a7fa07fa",
                                        "entry_id": "2b45ec86-aaf3-3af8-a507-5773f9a03ffa",
                                        "glosses": [
                                            "Lacking money, poor, impoverished; especially, extremely so."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ab26f58-0a5f-4b12-aab6-b2bebe176842",
                                                "sense_id": "156ac477-8d46-3b86-ad68-0571a7fa07fa",
                                                "text": "Near-synonym: penniless"
                                            },
                                            {
                                                "example_id": "2e8d32ce-f7d4-4c5d-a1db-fc5f8d4b161e",
                                                "sense_id": "156ac477-8d46-3b86-ad68-0571a7fa07fa",
                                                "text": "‘Do you know how pinched and destitute I am?’ she retorted. ‘I do not think you do, or can. If you had eyes, and could look around you on this poor place, you would have pity on me.[…]’\nIn 1907 he moved from St. Louis to New York City, arriving as a famous composer. But he died a decade later at the age of 49, destitute in an asylum on Wards Island as ragtime was fading in popularity."
                                            },
                                            {
                                                "example_id": "d7b90b0e-348f-4226-8434-4a420327284d",
                                                "sense_id": "156ac477-8d46-3b86-ad68-0571a7fa07fa",
                                                "text": "according to the most careful estimates, 3,950,000 destitute peoples, mostly women and children who had been driven many of them as far as one thousand miles from home, turn their pitiful faces toward America for help in the reconstructive period in which we are now living."
                                            },
                                            {
                                                "example_id": "ea23ad84-18f0-4ebd-90eb-396a9b5e4977",
                                                "sense_id": "156ac477-8d46-3b86-ad68-0571a7fa07fa",
                                                "text": "He wondered how many people were destitute that same night even in his own prosperous country, how many homes were shanties, how many husbands were drunk and wives socked, and how many children were bullied, abused or abandoned."
                                            },
                                            {
                                                "example_id": "aa522dd4-b556-4448-b0c6-1aa6d76770bb",
                                                "sense_id": "156ac477-8d46-3b86-ad68-0571a7fa07fa",
                                                "text": "May 24, 2018, Alex Vadukul in The New York Times, The Forgotten Entertainer Rag"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "destitute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28e92427-4307-3779-ad92-d3de596668b5",
                                        "entry_id": "58f7e274-af1e-375c-a556-ef85f9a2db95",
                                        "glosses": [
                                            "To impoverish; to strip of wealth, resources, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
