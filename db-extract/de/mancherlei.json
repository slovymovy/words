                    {
                        "translation_id": "72b60774-f4bc-4b1c-9d85-f8875c90424f",
                        "source_entry_id": "638cb015-18ca-3403-9976-ae593aa93d47",
                        "source_sense_id": "7917844d-29c7-3775-9f9e-04d46526da95",
                        "source_sense_description": "einige verschiedene, Verschiedenes",
                        "target_lang_word": "plusieurs",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plusieurs",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a864894c-6e56-3fcc-9166-998b16271a69",
                                        "entry_id": "165779c4-13c3-3a4c-bc3c-c39383ae1611",
                                        "glosses": [
                                            "Un certain nombre, un nombre indéfini mais facilement dénombrable, supérieur à un et le plus souvent à deux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "554b487f-8ab5-4a7e-b775-345d7acff8db",
                                                "sense_id": "a864894c-6e56-3fcc-9166-998b16271a69",
                                                "text": "[…], puis sous prétexte de prendre conseil, se dirigea vers l’auberge où il fit venir une première chopine suivie de plusieurs autres."
                                            },
                                            {
                                                "example_id": "9ce9b965-16b1-4123-a488-d89276a5566c",
                                                "sense_id": "a864894c-6e56-3fcc-9166-998b16271a69",
                                                "text": "Parmi les caractères du troisième ordre, les uns sont constants dans quelques familles, les autres sont inconstants; par exemple, le nombre et la proportion des étamines, leur réunion par les filets en un, deux ou plusieurs corps ou faisceaux ; […]"
                                            },
                                            {
                                                "example_id": "fcee3eef-5db9-4a20-9452-624963f03015",
                                                "sense_id": "a864894c-6e56-3fcc-9166-998b16271a69",
                                                "text": "À chacune d’elles on a emprunté un ou plusieurs traits que l’on a juxtaposés plus ou moins habilement, et on les a mis les uns et les autres sur le compte d’un Guillaume central qui est précisément saint Guillaume de Gellone."
                                            },
                                            {
                                                "example_id": "95f9152d-372e-4849-90a8-bce8b53be004",
                                                "sense_id": "a864894c-6e56-3fcc-9166-998b16271a69",
                                                "text": "Depuis quelques jours, le temps s’est enfin remis au beau. Il fait encore assez frais, la nuit, et le thermomètre est descendu plusieurs fois à zéro."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plusieurs",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "53ee2d3b-270b-31fc-947d-7602859c087a",
                                        "entry_id": "7f0cd7d6-c91b-37d9-b2c1-204716834d85",
                                        "glosses": [
                                            "Nombre plus ou moins considérable, faisant partie d’un autre nombre plus grand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5394056b-992e-4ac3-a25f-69412aee2935",
                                                "sense_id": "53ee2d3b-270b-31fc-947d-7602859c087a",
                                                "text": "Parmi ce grand nombre de gens, il y en eut plusieurs qui voulurent…"
                                            },
                                            {
                                                "example_id": "12acf3c8-285d-4ea5-91d4-6b130da2580e",
                                                "sense_id": "53ee2d3b-270b-31fc-947d-7602859c087a",
                                                "text": "De toutes ces choses, il y en a plusieurs à rejeter."
                                            },
                                            {
                                                "example_id": "7e5b52f0-959b-48b9-b97e-ed5bd5ad27e1",
                                                "sense_id": "53ee2d3b-270b-31fc-947d-7602859c087a",
                                                "text": "Il avait acheté quantité de chevaux, mais il en mourut plusieurs en chemin."
                                            },
                                            {
                                                "example_id": "7b861740-2dbc-400a-a820-2db5040e1548",
                                                "sense_id": "53ee2d3b-270b-31fc-947d-7602859c087a",
                                                "text": "Plusieurs d’entre eux prétendaient…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d1b3a95-3c26-34cf-bb9a-8f3adec95f68",
                                        "entry_id": "7f0cd7d6-c91b-37d9-b2c1-204716834d85",
                                        "glosses": [
                                            "Un certain nombre de personnes indéfinies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c59bc4e-5926-472e-8fbc-b7581a202cd8",
                                                "sense_id": "1d1b3a95-3c26-34cf-bb9a-8f3adec95f68",
                                                "text": "Il ne faut pas que plusieurs pâtissent pour un seul."
                                            },
                                            {
                                                "example_id": "01659d80-9ef7-4c56-8a3e-24db8f1a2111",
                                                "sense_id": "1d1b3a95-3c26-34cf-bb9a-8f3adec95f68",
                                                "text": "Plusieurs tiennent, prétendent, s’imaginent…"
                                            },
                                            {
                                                "example_id": "761eec3b-55ce-40cb-8156-2598e9f7c3d4",
                                                "sense_id": "1d1b3a95-3c26-34cf-bb9a-8f3adec95f68",
                                                "text": "Plusieurs ont cru autrefois…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
