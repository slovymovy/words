                                                "example_id": "141d83ff-c065-47d1-bd51-8f1022d03f90",
                                                "sense_id": "2637a227-856b-32c5-8cda-439d8bad7e4b",
                                                "text": "Posunul si klobouk zpátky na temeno."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "087142e9-3171-3020-a5cf-968fb6fb5c86",
                                        "entry_id": "76e271f2-dd1d-35ae-b924-b101202c5658",
                                        "glosses": [
                                            "horní část ploché hory"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f124d509-40ae-49b8-b368-57102febd7c3",
                                                "sense_id": "087142e9-3171-3020-a5cf-968fb6fb5c86",
                                                "text": "Když se dostali až na temeno kopce, naskytl se jim široký rozhled."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82b47724-a554-4cea-81c7-7ca780e084be",
                        "source_entry_id": "a8b1efdf-c34d-3bf1-bbde-38e6e018f65e",
                        "source_sense_description": "top of the head",
                        "target_lang_word": "маку́шка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "маку́шка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4f36ca4e-5a86-39c7-86f1-f6cb28f5bccc",
                                        "entry_id": "12c2ba89-fbe7-31c2-9a3c-c6f7e64fb575",
                                        "glosses": [
                                            "оконечность или верхняя часть (головы, горы, дерева)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd6bf732-4525-409e-ac12-59e61a8e0eb2",
                                                "sense_id": "4f36ca4e-5a86-39c7-86f1-f6cb28f5bccc",
                                                "text": "Сильный западный ветер .. гнул макушки высоких лип и берёз сада и далеко относил падавшие жёлтые листья."
                                            },
                                            {
                                                "example_id": "240ffa17-0670-45f8-a546-44ef0e00eee6",
                                                "sense_id": "4f36ca4e-5a86-39c7-86f1-f6cb28f5bccc",
                                                "text": ".. некогда гладко выстриженная макушка его была покрыта густыми тёмно-русыми волосами .."
                                            },
                                            {
                                                "example_id": "b40c6ba5-ff6a-4fc4-bcb5-96deafcf4a4f",
                                                "sense_id": "4f36ca4e-5a86-39c7-86f1-f6cb28f5bccc",
                                                "text": ".. вороны изредка каркали, сидя высоко, высоко на обнажённой макушке берёзы .."
                                            },
                                            {
                                                "example_id": "addcfe44-edff-41de-b0f5-39ec63827a25",
                                                "sense_id": "4f36ca4e-5a86-39c7-86f1-f6cb28f5bccc",
                                                "text": "Он изловчился и, вместо чтобы ударить противника по макушке, хватил его кулаком в висок."
                                            },
                                            {
                                                "example_id": "98438d26-bdf8-4efc-bd29-865f3f35a494",
                                                "sense_id": "4f36ca4e-5a86-39c7-86f1-f6cb28f5bccc",
                                                "text": "Емельяну уже было под сорок, и на макушке у него просвечивала .. лысина."
                                            },
                                            {
                                                "example_id": "0392d13b-05aa-4f37-9189-bb4d59962304",
                                                "sense_id": "4f36ca4e-5a86-39c7-86f1-f6cb28f5bccc",
                                                "text": "В дверь заглянул .. упитанный мужчина в распахнутой шубе, с шапкой на макушке."
                                            },
                                            {
                                                "example_id": "818cd670-c9ce-423e-b464-4b994fd48b20",
                                                "sense_id": "4f36ca4e-5a86-39c7-86f1-f6cb28f5bccc",
                                                "text": "Внизу — метров 25. Видны макушки елей, стоящих рядом с кедром."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b6e2dd9-0271-4693-a5cd-297b973b9116",
                        "source_entry_id": "a8b1efdf-c34d-3bf1-bbde-38e6e018f65e",
