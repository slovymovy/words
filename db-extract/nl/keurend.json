        "nl-extract.jsonl": [
            {
                "entry_id": "ef6c52a5-c3ab-3ee7-873f-4a49d217339f",
                "word": "keurend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "75f303b1-9450-363f-9751-efe1f7f26fb8",
                        "entry_id": "ef6c52a5-c3ab-3ee7-873f-4a49d217339f",
                        "glosses": [
                            "bezig met het maken van een beoordeling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e8d582b-a9ad-4a39-bf89-3f60f33738d4",
                                "sense_id": "75f303b1-9450-363f-9751-efe1f7f26fb8",
                                "text": "Er wordt met een keurende, bedachtzame blik van de dames gekeken naar de outfits."
                            },
                            {
                                "example_id": "211b3e3e-6fa3-47be-b89b-5ae8b4881f8a",
                                "sense_id": "75f303b1-9450-363f-9751-efe1f7f26fb8",
                                "text": "De keurende instantie zegt dat ongeveer de helft van de Chinese eetgelegenheden onvoldoende hygiënisch werkt, hetgeen kan leiden tot voedselvergiftiging."
                            },
                            {
                                "example_id": "0dce9081-d9d8-408a-b898-bafd7ab5f599",
                                "sense_id": "75f303b1-9450-363f-9751-efe1f7f26fb8",
                                "text": "Tijdens het Fiesta-festival in de stad lonkte meneer Perez naar andere vrouwen. Zijn 27-jarige vrouw was de keurende blikken echter niet ontgaan en ze deed woedend haar beklag over het geflirt."
                            }
                        ]
                    }
                ],
