                        "source_sense_id": "cccc2a47-95bd-3347-ae9a-c1a095ea92e0",
                        "source_sense_description": "Botanik, süddeutsch: die Aukube, eine Zimmerpflanze",
                        "target_lang_word": "aucuba",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aucuba",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "73346383-4046-3297-9021-d56b41a3edc7",
                                        "entry_id": "3cdecb36-8ba7-38e2-bb48-4169208248a6",
                                        "glosses": [
                                            "Arbrisseau ornemental (Garryaceae) à feuilles coriaces et persistantes, d'un vert luisant qui pour certaines variétés sont panachées de jaune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cabb56c9-d451-4461-bb0d-6f9d2733d967",
                                                "sense_id": "73346383-4046-3297-9021-d56b41a3edc7",
                                                "text": "J'étais resté un peu en arrière sous l'écran d'aucubas, avec Bertille qui venait de souffler Eh bien ! en lorgnant la lourde façade de style Victoria."
                                            },
                                            {
                                                "example_id": "c8856bfa-40e3-456b-b102-f329f8b540ac",
                                                "sense_id": "73346383-4046-3297-9021-d56b41a3edc7",
                                                "text": "Les merles sous un aucuba s’aiment : je vous le dis tout bas les chants de cette pariade valent bien ceux de l’Iliade."
                                            },
                                            {
                                                "example_id": "b91f4d99-524a-47af-aecb-a36d35e13d50",
                                                "sense_id": "73346383-4046-3297-9021-d56b41a3edc7",
                                                "text": "Les angles des murs garnis de haut en bas de plantes vertes, d’aucubas et de misères approfondissaient le silence en lui donnant cette aspiration, cette délectation de soi qu’il connaît en forêt et qui lui donne comme un bruit d’ailes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
