                                    {
                                        "sense_id": "ac189cb9-9fb2-3f76-a2f5-fcbd5fe2672d",
                                        "entry_id": "b4c61492-9e23-3cb6-9b7b-3643a555df76",
                                        "glosses": [
                                            "Point de l’orbite d’un objet céleste, gravitant autour d’un autre, pour lequel la distance des deux corps est minimale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08fc171d-fa76-4b9b-8953-0d5fd09003bd",
                                                "sense_id": "ac189cb9-9fb2-3f76-a2f5-fcbd5fe2672d",
                                                "text": "Il s’agit de faire descendre le périastre jusqu’à une centaine de kilomètres d’altitude, là où la sonde est freinée par l’atmosphère."
                                            },
                                            {
                                                "example_id": "0fd95020-2ee7-4aef-81af-5ade718beaf6",
                                                "sense_id": "ac189cb9-9fb2-3f76-a2f5-fcbd5fe2672d",
                                                "text": "C’est là un effet 1 million de fois plus petit que l’avance du périastre, qui corrige l’effet Römer de quelque 50 nanosecondes par période, mais cumulatif et mesurable au bout de quelques années."
                                            }
                                        ]
                                    }
                                ]
                            }
