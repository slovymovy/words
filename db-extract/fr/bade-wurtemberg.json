                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c6dbcea-aff2-4b1b-8d72-a9d418f84679",
                                                "sense_id": "7b73d521-d674-3afe-904d-ebced1b98257",
                                                "text": "Baden-Württemberg liegt am rechten Rheinufer."
                                            },
                                            {
                                                "example_id": "0b7bfb07-3ff6-441c-9504-e8cb480a36ec",
                                                "sense_id": "7b73d521-d674-3afe-904d-ebced1b98257",
                                                "text": "Baden-Württemberg liegt im Südwesten Deutschlands."
                                            },
                                            {
                                                "example_id": "35ac0fb9-2daa-4e83-8395-7b07dbf46985",
                                                "sense_id": "7b73d521-d674-3afe-904d-ebced1b98257",
                                                "text": "„Ab den 1980er-Jahren wurden in Bayern und Baden-Württemberg Viereckschanzen systematisch ausgegraben und alte Forschungsberichte unter die Lupe genommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
