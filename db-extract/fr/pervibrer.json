                "senses": [
                    {
                        "sense_id": "16d5709a-801f-31e1-9649-00287ff0794f",
                        "entry_id": "3d0a725e-9d04-32f5-b255-b41fd68ab9d3",
                        "glosses": [
                            "Faire vibrer du béton frais pour améliorer sa fluidité et rendre le coffrage plus facile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74b2a39d-57af-4304-9c0d-b276d38e7f7e",
                                "sense_id": "16d5709a-801f-31e1-9649-00287ff0794f",
                                "text": "Un appareil à main peut être immergé dans le béton ; on le déplace pour pervibrer celui-ci."
                            },
                            {
                                "example_id": "014d5055-ed69-45cb-bf72-7011e1cbe3e7",
                                "sense_id": "16d5709a-801f-31e1-9649-00287ff0794f",
                                "text": "Rien n’avait surpris la présidente : ni la déchéance de certains bois, ni l’invasion des essences tropicales, ni la montée en flèche de l’acier, du béton pervibré."
                            }
                        ]
                    }
