                    {
                        "translation_id": "4101c053-1873-4c26-9ef4-743b7f8d082d",
                        "source_entry_id": "02adb337-13c1-33d9-85fc-b3755d05c155",
                        "source_sense_description": "relating to horses or horse-riding — see also equine",
                        "target_lang_word": "hippisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hippisch",
