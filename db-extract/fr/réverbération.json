        "fr-extract.jsonl": [
            {
                "entry_id": "fd20dc5f-682c-3f24-88c0-b9524a97ed8a",
                "word": "réverbération",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "71aa973e-23e3-403d-bc6a-42d88b3e44f2",
                        "entry_id": "fd20dc5f-682c-3f24-88c0-b9524a97ed8a",
                        "tags": [
                            "plural"
                        ],
                        "form": "réverbérations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b6f7b167-c4a7-38cd-957e-de57b02de1b4",
                        "entry_id": "fd20dc5f-682c-3f24-88c0-b9524a97ed8a",
                        "glosses": [
                            "Réflexion et diffusion d'un flux, lumière, son ou chaleur par exemple."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a48b53c-7a8b-4d48-ac3e-0aa72cddade8",
                                "sense_id": "b6f7b167-c4a7-38cd-957e-de57b02de1b4",
                                "text": "Les yeux étaient aussi attaqués par l'intense blancheur des neiges, et il était impossible de supporter longtemps cette vive réverbération, qui provoque de nombreux cas de cécité chez les Esquimaux."
                            },
                            {
                                "example_id": "35b21a40-559e-4dc0-938e-6feb0331db9a",
                                "sense_id": "b6f7b167-c4a7-38cd-957e-de57b02de1b4",
                                "text": "Ses yeux noirs et profonds lançaient des éclairs, son teint pâle s’était animé d’une couleur rosée qui était comme la réverbération d’une flamme intérieure."
                            },
                            {
                                "example_id": "fe527bb0-6718-472f-86b3-1916073a4809",
                                "sense_id": "b6f7b167-c4a7-38cd-957e-de57b02de1b4",
                                "text": "Le voilà devant elle, avec sa haute taille et sa force, sa figure cuite par le soleil et la réverbération de la neige, et ses yeux hardis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05c81e2f-f11c-421d-a55f-0e7a6eb483f0",
                        "source_entry_id": "fd20dc5f-682c-3f24-88c0-b9524a97ed8a",
                        "source_sense_id": "b6f7b167-c4a7-38cd-957e-de57b02de1b4",
                        "source_sense_description": "Pour le son uniquement",
                        "target_lang_word": "reverberation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reverberation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a5e125f-a70f-32c3-8d9e-c03ef2ede391",
                                        "entry_id": "64e6baae-05d2-315d-8a43-bff343b83e74",
                                        "glosses": [
                                            "A violent oscillation or vibration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "706fb758-8333-4672-8968-55303022c85e",
                                                "sense_id": "0a5e125f-a70f-32c3-8d9e-c03ef2ede391",
                                                "text": "The discomfort caused by the bat's reverberation surprised Tommy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "763019bd-69e8-3d27-8b53-19907d1fcc1f",
                                        "entry_id": "64e6baae-05d2-315d-8a43-bff343b83e74",
                                        "glosses": [
                                            "An echo, or a series of overlapping echoes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "160b64c7-900a-4401-92ae-f703f26c1a0b",
                                                "sense_id": "763019bd-69e8-3d27-8b53-19907d1fcc1f",
                                                "text": "The reverberation that followed Marilyn's shout filled the cavern."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5894f71-4021-3e97-b28c-27b52edec0b4",
                                        "entry_id": "64e6baae-05d2-315d-8a43-bff343b83e74",
                                        "glosses": [
                                            "The reflection of light or heat; a reflection in, or as though in, a mirror."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b7b66e6-b850-44b2-8f96-d82593df235e",
                                                "sense_id": "e5894f71-4021-3e97-b28c-27b52edec0b4",
                                                "text": "Like the several reverberations of the same image from two opposite looking glasses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "569fbe6b-413d-3ec8-b4ca-045232af443f",
                                        "entry_id": "64e6baae-05d2-315d-8a43-bff343b83e74",
                                        "glosses": [
                                            "An evolving series of effects resulting from a particular event; a repercussion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9537298f-666c-446f-be56-c49199285bda",
                                                "sense_id": "569fbe6b-413d-3ec8-b4ca-045232af443f",
                                                "text": "Reverberations from the Vietnam war affect our society to this day."
                                            }
                                        ]
