                "forms": [
                    {
                        "form_id": "fe0120c2-0e69-45f6-ad7b-bd57d938e9b4",
                        "entry_id": "06881235-db73-3f29-ad92-dfbd28ee4a1d",
                        "tags": [
                            "plural"
                        ],
                        "form": "oueds"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a2e19eae-594b-362e-b5a6-289a604faad4",
                        "entry_id": "06881235-db73-3f29-ad92-dfbd28ee4a1d",
                        "glosses": [
                            "Cours d’eau d'Afrique du Nord et des régions semi-désertiques, à régime hydrologique très irrégulier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b550c7c-7109-459a-b516-96d568e38328",
                                "sense_id": "a2e19eae-594b-362e-b5a6-289a604faad4",
                                "text": "L’oued En-Nedja coule à nos pieds dans un ravin verdoyant et se perd dans un paysage rocheux au Sud-Ouest."
                            },
                            {
                                "example_id": "7c21e798-5cc9-4de5-bab6-9a6be532f6f2",
                                "sense_id": "a2e19eae-594b-362e-b5a6-289a604faad4",
                                "text": "Hélas! il m’arriva - Dieu m’ait en sa merci!-\nDes fois où le simoun ridait ma langue anhydre,\nDe boire en des oueds, avec un noir souci,\nBestions et têtards, et de la bourbe aussi…"
                            },
                            {
                                "example_id": "4b8c3657-3813-4ff4-8216-83e46bb74b57",
                                "sense_id": "a2e19eae-594b-362e-b5a6-289a604faad4",
                                "text": "Bou-Saada, […], dort, voluptueuse, au bord escarpé de l’oued où l'eau bruisse sur les cailloux blancs et roses."
                            },
                            {
                                "example_id": "9097c358-081e-4ee8-88db-eebf34d65ed7",
                                "sense_id": "a2e19eae-594b-362e-b5a6-289a604faad4",
                                "text": "[…] c’est là que s’était écoulée sa jeunesse, car sa tribu faisait paître des chameaux et des moutons dans les oueds où rien ne croît que de rares arbustes épineux."
                            },
                            {
                                "example_id": "b6d3b849-9e34-451a-a24d-344ccad7b5d2",
                                "sense_id": "a2e19eae-594b-362e-b5a6-289a604faad4",
                                "text": "Chaque pièce est protégée par un toit plat fait de ce même roseau : le berdi, qui pousse en abondance dans les bas-fonds humides de l’oued."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8799426a-b703-452a-a276-cc63ff01fabc",
                        "source_entry_id": "06881235-db73-3f29-ad92-dfbd28ee4a1d",
                        "source_sense_id": "a2e19eae-594b-362e-b5a6-289a604faad4",
                        "source_sense_description": "cours d’eau intermittent en pays désertique",
                        "target_lang_word": "Wadi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wadi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3ee689a-74b0-3ad4-aff3-bbc02c4c1c00",
                                        "entry_id": "c3c2a364-e10f-3ed6-9e12-0420b02b1f9b",
                                        "glosses": [
                                            "talartiges Trockenbett bei Flüssen in den Wüstengebieten Nordafrikas und des Vorderen Orients, das nur nach heftigen, periodischen oder episodischen Regenfällen zeitweise Wasser führt"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "293b4f84-a340-4ac9-8ae3-e4b193ede958",
                                                "sense_id": "e3ee689a-74b0-3ad4-aff3-bbc02c4c1c00",
                                                "text": "„Aber auch die südlichen Randketten um Gafsa und der Schott-Region sowie die Wadis des Steppentieflandes sind betroffen.“"
                                            },
                                            {
                                                "example_id": "c5e5911f-42d8-499c-8260-b665894b7c1d",
                                                "sense_id": "e3ee689a-74b0-3ad4-aff3-bbc02c4c1c00",
                                                "text": "„Die Dorfbevölkerung wird motiviert, Ufer von Flußbetten (Wadis), in denen nur wenige Tage im Jahr reißende Ströme fließen und die sonst trockenliegen, durch Anpflanzung von Bäumen zu befestigen, so daß weniger fruchtbarer Boden fortgespült wird.“"
                                            },
                                            {
                                                "example_id": "06f07650-78e4-4433-afef-48f86ad0338d",
                                                "sense_id": "e3ee689a-74b0-3ad4-aff3-bbc02c4c1c00",
                                                "text": "„Als die Frühmenschen in dieser Gegend Jordaniens lebten, jagten und Pflanzen sammelten, dürfte das Wadi, das heutige Trockental, ständig Wasser geführt haben.“"
                                            },
                                            {
                                                "example_id": "3f480ae2-9099-40ca-88f7-1ea55853b504",
                                                "sense_id": "e3ee689a-74b0-3ad4-aff3-bbc02c4c1c00",
                                                "text": "„Die Pantherin gehörte zu fünf sorgfältig geschützen Tieren, die in den Hügeln und Wadis (ausgetrocknete Flußtäler) der Wüste Judäa leben, die sich über den Süden Israels und das besetzte Westjordanland erstreckt.“"
                                            },
                                            {
                                                "example_id": "b3b6e8cd-7a8c-4ac6-adc3-b9aada06b3ab",
                                                "sense_id": "e3ee689a-74b0-3ad4-aff3-bbc02c4c1c00",
                                                "text": "„Ein Vergleich mit Luftbildern der Royal Air Force, die vor 20 Jahren über dem obersten Teil des Wadis aufgenommen wurden, zeigt, dass in einigen Jahren nicht mehr viele Zeugen der einstigen Kulturlandschaft erhalten sein werden.“"
                                            },
                                            {
                                                "example_id": "0b2d4083-4c12-4592-b2c1-9e62d6cdb0d9",
                                                "sense_id": "e3ee689a-74b0-3ad4-aff3-bbc02c4c1c00",
                                                "text": "„Fünf Stunden geht es täglich in leichtem Andante dahin. Über krümelige Hänge, ausgetrocknete Flußbetten und weite Wadis.“"
                                            },
                                            {
                                                "example_id": "5ed2629c-f79d-4977-8bf5-0ee5df542807",
                                                "sense_id": "e3ee689a-74b0-3ad4-aff3-bbc02c4c1c00",
                                                "text": "„Die Route führt durch eine bizarre Wüstenlandschaft mit weiten Wadis und engen Schluchten.“"
                                            },
                                            {
                                                "example_id": "f222a1e3-7747-4ecb-bff3-bb179105c96d",
                                                "sense_id": "e3ee689a-74b0-3ad4-aff3-bbc02c4c1c00",
                                                "text": "„Anders hingegen in Jordanien: ‚Wir waren in riesigen Wadis - das sind wasserlose Flusstäler - nahe dem Toten Meer, an über 100 Meter hohen Felswänden, wo schon an der Gesteinsoberfläche Fossilien in enormer Menge und hervorragendem Zustand zu erkennen waren‘, berichtet der Forscher.“"
                                            },
                                            {
                                                "example_id": "56907a58-7c81-4f0b-aa78-1d906c7048f8",
                                                "sense_id": "e3ee689a-74b0-3ad4-aff3-bbc02c4c1c00",
                                                "text": "„Etwa zehn Kilometer winden wir uns durch schroffe Wadis, zwischen Militärlagern, Siedlungen und Beduinenzelten hindurch.“"
                                            },
                                            {
                                                "example_id": "9590048b-0e78-4ff6-a145-b293aba7bca5",
                                                "sense_id": "e3ee689a-74b0-3ad4-aff3-bbc02c4c1c00",
                                                "text": "„Schon jetzt dürfen Unifil-Helikopter nicht mehr über allen Gebieten Südlibanons fliegen, «weil Hisbollah einige Wadis in der Grenzregion zum militärischen Sperrgebiet erklärt hat».“"
                                            },
                                            {
                                                "example_id": "e6f4280b-784e-4ea0-a524-6d87578adac9",
                                                "sense_id": "e3ee689a-74b0-3ad4-aff3-bbc02c4c1c00",
                                                "text": "„Schließlich verlieren sich die phantastischen Konturen der Wadis, wie die ausgetrockneten Flusstäler genannt werden, im dichter werdenden Nebelmeer über der weiten Jordansenke.“"
                                            },
                                            {
                                                "example_id": "df2693bf-c943-40df-86b2-b429949365f9",
                                                "sense_id": "e3ee689a-74b0-3ad4-aff3-bbc02c4c1c00",
                                                "text": "„Ein Blick in das Gesicht der Wüste: kein Aufenthalt ohne Trip durch die Wadis (Wasserläufe) oder Fahrt durch die Dünen.“"
                                            },
                                            {
                                                "example_id": "17fbc7aa-c8f3-49ee-b2cb-99aed6b642c3",
                                                "sense_id": "e3ee689a-74b0-3ad4-aff3-bbc02c4c1c00",
                                                "text": "„Unten im Wadi lagerten Hunderte Kamele um einen grünlich schimmernden Teich; das Echo ihres dumpfen Gegröles hallte durch die Schlucht.“"
                                            },
                                            {
                                                "example_id": "b352c5d8-a290-4a4a-bf0b-c33a1140846c",
                                                "sense_id": "e3ee689a-74b0-3ad4-aff3-bbc02c4c1c00",
                                                "text": "„Die kleine, enge Propellermaschine fliegt über winzige Felseninseln, Korallenbänke leuchten farbig, dann biegt sie ab in das Gebirge, das wie eine faltige Greisenhand gekrümmte Felsenfinger ins Meer streckt, torkelt an den schroffen Bergwänden entlang durch die immer enger werdenden Schluchten der Wadis. Vereinzelt sind kleine Gehöfte, bebaute Terrassen erkennbar, das Wadi weitet sich zur nördlichen Küste hin, Khasab.“"
                                            },
                                            {
                                                "example_id": "00eaf280-7f64-4d5e-8a37-20f953324034",
                                                "sense_id": "e3ee689a-74b0-3ad4-aff3-bbc02c4c1c00",
                                                "text": "„Es gibt die selbst am Ende der Trockenzeit noch grünen Flusstäler, die Wadis.“"
                                            },
                                            {
                                                "example_id": "663e2533-1111-41b2-8de6-9a375d6f6e65",
                                                "sense_id": "e3ee689a-74b0-3ad4-aff3-bbc02c4c1c00",
                                                "text": "„Die schwersten Regenfälle seit 30 Jahren haben die Wadis überschwemmt und damit jeden Straßenverkehr unmöglich gemacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
