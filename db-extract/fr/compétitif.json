                "senses": [
                    {
                        "sense_id": "45cba0d7-ab59-3789-b681-9dd04ea28c71",
                        "entry_id": "cc7a59bc-8512-3c5e-b175-7ffde9e41311",
                        "glosses": [
                            "Capable d'affronter avec succès la concurrence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76f10ae3-b7ae-440f-adb5-222bc2be6b0e",
                                "sense_id": "45cba0d7-ab59-3789-b681-9dd04ea28c71",
                                "text": "Nos entreprises sont devenues très compétitives et capables de s'engager sur des marchés hyper-concurrentiels."
                            },
                            {
                                "example_id": "bb3a724a-906b-4d82-8815-eb6d853d7373",
                                "sense_id": "45cba0d7-ab59-3789-b681-9dd04ea28c71",
                                "text": "La jeune marque propose deux modèles de VAE (vélo à assistance électrique) intelligents, innovants, à des prix très compétitifs (entre 1700 et 2300 €)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfd7cc5a-5d33-411c-8f21-cc484c9996cf",
                        "source_entry_id": "cc7a59bc-8512-3c5e-b175-7ffde9e41311",
                        "source_sense_id": "45cba0d7-ab59-3789-b681-9dd04ea28c71",
                        "target_lang_word": "konkurrenzfähig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "konkurrenzfähig",
