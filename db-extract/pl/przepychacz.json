                        "source_entry_id": "041c5eac-25b3-38de-91ff-bd49f1f47c13",
                        "source_sense_id": "f1439b05-74a7-3495-83d0-98f7766cb3bd",
                        "target_lang_word": "Saugglocke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Saugglocke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b77a583-3499-35ef-a0b3-19a078fc8947",
                                        "entry_id": "9903c9b3-537b-3ffe-8871-481790bb2922",
                                        "glosses": [
                                            "ein aus einer Pumpe, einer Vakuumflasche, dem Schlauchsystem und Saugglocken in verschiedenen Größen und Materialien (Metall, Gummi und Silikon) bestehender Vakuumextraktor, mit dem bei entsprechenden Indikationen bei Geburten das Kind aus dem Mutterleib gezogen wird (Saugglockenentbindung oder Vakuumextraktion)"
                                        ],
                                        "tags": [
                                            "Geburtshilfe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da91cac9-27b5-44e9-a845-d8c20db002dd",
                                                "sense_id": "1b77a583-3499-35ef-a0b3-19a078fc8947",
                                                "text": "Das Salzburger Neujahrsbaby kam um 1.50 Uhr mit Hilfe einer Saugglocke im Diakonissenkrankenhaus auf die Welt: Anna wiegt 4.190 Gramm und ist 50 Zentimeter groß."
                                            },
                                            {
                                                "example_id": "cb70c87a-ec5e-481c-b9fe-b834b2a75b94",
                                                "sense_id": "1b77a583-3499-35ef-a0b3-19a078fc8947",
                                                "text": "„In Australien scheiterte ein Versuch, jungen Müttern nach einer schweren Geburt mit Kaiserschnitt, Zange oder Saugglocke die Zeit danach zu erleichtern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a0d6fa8c-5885-35da-8aae-6b08120a262a",
                                        "entry_id": "9903c9b3-537b-3ffe-8871-481790bb2922",
                                        "glosses": [
                                            "Sanitärbereich: eine Gummiglocke, die meist am Ende eines Holzstabes montiert ist und mit der man verstopfte Abflussrohre befreien kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6b2b42c-44c7-4596-b732-a5a941d08d7e",
                                                "sense_id": "a0d6fa8c-5885-35da-8aae-6b08120a262a",
                                                "text": "„Es sollte sich möglichst wenig Luft unter der Saugglocke und im Abfluss befinden, weil durch die Ausdehnung und Kompression der Luft die notwendige Beschleunigung der Wassersäule zu gering sein kann.“"
                                            },
                                            {
                                                "example_id": "e43da121-fc09-4d95-acad-97f0c526dd02",
                                                "sense_id": "a0d6fa8c-5885-35da-8aae-6b08120a262a",
                                                "text": "Oft lässt sich eine Verstopfung mit einer Mischung aus flüssigem Geschirrspülmaschinen-Reiniger und heißem Wasser lösen. Nutzt dies nichts, hilft die altbewährte Saugglocke."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
