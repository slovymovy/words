                                    },
                                    {
                                        "sense_id": "f54753e4-5641-33a1-a3fa-174429177485",
                                        "entry_id": "02fb3229-2e48-3714-b019-b3c566eb203b",
                                        "glosses": [
                                            "Médecin spécialisé dans les yeux."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "621c242a-a002-40e5-9e34-f59ec1b0c747",
                                                "sense_id": "f54753e4-5641-33a1-a3fa-174429177485",
                                                "text": "Après approbation par le tribunal, un ophtalmologiste expert peut demander à un autre ophtalmologiste son aide comme sapiteur sur une question précise."
                                            },
                                            {
                                                "example_id": "6ecc473a-9fd4-444e-93ef-805389da6770",
                                                "sense_id": "f54753e4-5641-33a1-a3fa-174429177485",
                                                "text": "Je pense notamment au LBD dont le Défenseur des droits a demandé l’interdiction et sur lequel même des ophtalmologistes ont alerté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e9306d1-a565-45a1-bcae-b24eb12852c3",
                        "source_entry_id": "a2777461-5121-34fd-84e4-912dfd08df73",
                        "source_sense_id": "33cd2ed6-c6bd-3b1c-b4a1-21d77c7eee0c",
                        "source_sense_description": "Ärztin, die sich mit der Augenheilkunde (Ophthalmologie) beschäftigt; Fachärztin für Augenheilkunde",
                        "target_lang_word": "ophtalmologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ophtalmologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e73749e-9ba8-355b-bd5a-c08bc1e8a011",
                                        "entry_id": "f97487e5-a656-39d7-a0a3-926b16636627",
                                        "glosses": [
                                            "Variante de ophtalmologiste, médecin spécialisé dans les yeux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a87e660-8040-4b9b-9d60-ca3ecde3d6b9",
                                                "sense_id": "1e73749e-9ba8-355b-bd5a-c08bc1e8a011",
                                                "text": "Vous êtes dispensé d’avance de frais, sur présentation de votre carte de tiers payant France Mutuelle, accompagnée de votre carte Vitale et de la prescription médicale établie par votre ophtalmologue ou votre oto-rhino-laryngologiste."
                                            },
                                            {
                                                "example_id": "cff1b9bf-532f-4e01-8372-a9454fb7e956",
                                                "sense_id": "1e73749e-9ba8-355b-bd5a-c08bc1e8a011",
                                                "text": "« Les yeux peuvent être fainéants, surtout au bout de plusieurs heures à scruter un écran. L’un peut alors dominer l’autre, et les deux finissent par ne plus travailler ensemble. Pour rétablir la situation, il suffit de placer son doigt en face de soi, bras tendu, et de le rapprocher peu à peu de son nez sans cesser de le fixer. Répéter cet exercice trois fois et le renouveler plusieurs fois au cours de la journée permet de faire travailler le muscle oculaire et rétablir la convergence », indique Dan-Alexandre Lebuisson, ophtalmologue et co-auteur du livre La vue pour les nuls."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e65151d-4890-4006-9bc3-01be0df92940",
                        "source_entry_id": "a2777461-5121-34fd-84e4-912dfd08df73",
                        "source_sense_id": "33cd2ed6-c6bd-3b1c-b4a1-21d77c7eee0c",
                        "source_sense_description": "Ärztin, die sich mit der Augenheilkunde (Ophthalmologie) beschäftigt; Fachärztin für Augenheilkunde",
                        "target_lang_word": "oculiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oculiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ddf84ae2-c5d9-3319-b5ba-55389dd374e3",
                                        "entry_id": "b67b938a-cda0-31b5-9740-5372484de37a",
                                        "glosses": [
                                            "Médecin qui soigne les différentes maladies de l’œil et corrige les imperfections de la vue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9e12822-a9a9-4a4c-88b7-928f0bf397f2",
                                                "sense_id": "ddf84ae2-c5d9-3319-b5ba-55389dd374e3",
                                                "text": "Je revenais avec papa de chez l’oculiste, qui m’avait mis une pommade sur les yeux, et je voyais tout flou."
                                            },
                                            {
