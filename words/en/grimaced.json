{
    "word_family": [
        "grimace"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e6a2c65e-a12d-36ca-8014-819596a776b2",
                    "sense_definition": "simple past and past participle of <w>grimace</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>grimaced</w> in pain when the doctor touched his injured arm.",
                            "target_lang_translations": {
                                "pl": "Gdy lekarz dotknął jego zranionego ramienia, <w>skrzywił się</w> z bólu."
                            }
                        },
                        {
                            "text": "She <w>grimaced</w> at the bitter taste of the medicine.",
                            "target_lang_translations": {
                                "pl": "<w>Skrzywiła się</w> na gorzki smak lekarstwa."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Czas przeszły i imiesłów czasu przeszłego od czasownika 'grymasić' lub 'krzywić się'."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "skrzywił się",
                                "target_lang_sense_clarification": "wyrażenie bólu lub niechęci twarzą"
                            },
                            {
                                "target_lang_word": "zrobił grymas",
                                "target_lang_sense_clarification": "wykrzywienie twarzy"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cb96d3f6-a21e-385d-a9c9-419aaa5d550b",
                    "sense_definition": "Having a facial expression of pain, disgust, or disapproval",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "facial_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>grimaced</w> face of the child showed he did not like the broccoli.",
                            "target_lang_translations": {
                                "pl": "<w>Skrzywiona</w> twarz dziecka pokazywała, że nie lubi brokułów."
                            }
                        },
                        {
                            "text": "He looked at the mess with a <w>grimaced</w> expression of pure disgust.",
                            "target_lang_translations": {
                                "pl": "Spojrzał na bałagan z <w>skrzywionym</w> wyrazem czystego wstrętu."
                            }
                        }
                    ],
                    "synonyms": [
                        "scowling",
                        "frowning"
                    ],
                    "antonyms": [
                        "smiling"
                    ],
                    "target_lang_definitions": {
                        "pl": "Mający wyraz twarzy wyrażający ból, wstręt lub dezaprobatę."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "skrzywiony",
                                "target_lang_sense_clarification": "o wyrazie twarzy pełnym niechęci"
                            },
                            {
                                "target_lang_word": "z grymasem",
                                "target_lang_sense_clarification": "opisujący wyraz twarzy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f5cf267-0573-3ca8-ad19-2d309b34ca08",
                    "sense_definition": "Having a distorted or crabby appearance",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "facial_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man had a <w>grimaced</w> look that made him seem constantly annoyed.",
                            "target_lang_translations": {
                                "pl": "Starzec miał <w>wykrzywiony</w> wyraz twarzy, przez co wydawał się ciągle poirytowany."
                            }
                        },
                        {
                            "text": "She gave a <w>grimaced</w> smile that looked more like a sneer.",
                            "target_lang_translations": {
                                "pl": "Posłała <w>skrzywiony</w> uśmiech, który bardziej przypominał drwiący grymas."
                            }
                        }
                    ],
                    "synonyms": [
                        "distorted",
                        "crabby",
                        "surly"
                    ],
                    "antonyms": [
                        "pleasant"
                    ],
                    "target_lang_definitions": {
                        "pl": "Mający zniekształcony lub zrzędliwy wygląd."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wykrzywiony",
                                "target_lang_sense_clarification": "o zniekształconym wyrazie twarzy"
                            },
                            {
                                "target_lang_word": "zrzędliwy",
                                "target_lang_sense_clarification": "o wyglądzie sugerującym niezadowolenie"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}