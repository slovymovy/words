                "senses": [
                    {
                        "sense_id": "d6ecef64-64ba-3398-a354-d0b961fa8ae9",
                        "entry_id": "b0cbd559-c789-3a56-b61d-e6ae1a381757",
                        "glosses": [
                            "kleine Schamlippe"
                        ],
                        "tags": [],
