                                                "sense_id": "c3022603-a315-3a35-9318-f7675cdc9edc",
                                                "text": "„Nie hatte ich indessen solche falsche Akkorde gegriffen, nie so im Gesange detoniert, als dasmal [damals?].“"
                                            },
                                            {
                                                "example_id": "0d234ac0-38df-4bf4-9361-b29d7a537565",
                                                "sense_id": "c3022603-a315-3a35-9318-f7675cdc9edc",
                                                "text": "Wenn die erste Jugendfrische vorüber, im 20. bis 30. Lebensjahr, detonieren solche Sänger dauernd."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
