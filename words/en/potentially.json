    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "85361b78-611f-3e73-81f7-e45e4ada517b",
                    "sense_definition": "With the possibility of happening or existing in the future.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new virus is <w>potentially</w> dangerous to humans and animals.",
                            "target_lang_translations": {
                                "ru": "Новый вирус <w>потенциально</w> опасен для людей и животных.",
                                "zh": "这种新病毒<w>可能</w>对人类和动物有危险。"
                            }
                        },
                        {
                            "text": "We need to identify any <w>potentially</w> harmful side effects of the medication.",
                            "target_lang_translations": {
                                "ru": "Нам нужно выявить любые <w>потенциально</w> вредные побочные эффекты этого лекарства.",
                                "zh": "我们需要找出该药物任何<w>潜在的</w>有害副作用。"
                            }
                        }
                    ],
                    "synonyms": [
                        "possibly",
                        "conceivably",
                        "maybe"
                    ],
                    "common_phrases": [
                        "potentially dangerous",
                        "potentially fatal",
                        "potentially hazardous",
                        "potentially useful"
                    ],
                    "target_lang_definitions": {
                        "ru": "С возможностью того, что это произойдет или будет существовать в будущем.",
                        "zh": "指未来有可能发生或存在。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потенциально",
                                "target_lang_sense_clarification": "теоретически возможно"
                            },
                            {
                                "target_lang_word": "возможно",
                                "target_lang_sense_clarification": "может быть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "潜在地",
                                "target_lang_sense_clarification": "表示具有某种可能性"
                            },
                            {
                                "target_lang_word": "可能",
                                "target_lang_sense_clarification": "表示有发生的几率"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b03154f7-0f73-3ba8-92f9-baf34c1328e8",
                    "sense_definition": "In a powerful or strong manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medicine acted <w>potentially</w> to cure the ailment in a short time.",
                            "target_lang_translations": {
                                "ru": "Лекарство подействовало <w>сильно</w>, вылечив недуг за короткое время.",
                                "zh": "这种药物<w>强有力地</w>发挥了作用，在短时间内治愈了疾病。"
                            }
                        },
                        {
                            "text": "He spoke <w>potentially</w>, commanding the attention of the entire room.",
                            "target_lang_translations": {
                                "ru": "Он говорил <w>властно</w>, приковывая внимание всей комнаты.",
                                "zh": "他<w>有力地</w>发言，吸引了全场人的注意。"
                            }
                        }
                    ],
                    "synonyms": [
                        "powerfully",
                        "strongly",
                        "vigorously"
                    ],
                    "antonyms": [
                        "weakly"
                    ],
                    "traits": [
