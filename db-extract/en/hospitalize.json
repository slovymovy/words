                                        ],
                                        "tags": [
                                            "Plus rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8572332b-6742-45e8-b48a-688000f6851e",
                                                "sense_id": "50d25ed5-ec57-30ba-8b83-30b58dd42906",
                                                "text": "Les Grecs émigrés de Turquie étaient à eux seuls un million cinq cent mille. Jamais le gouvernement hellénique n'eût pu les hospitaliser sans le secours de la S.D.N.."
                                            },
                                            {
                                                "example_id": "ac147636-dfc2-466e-b8e8-05a455f5ccda",
                                                "sense_id": "50d25ed5-ec57-30ba-8b83-30b58dd42906",
                                                "text": "Depuis une huitaine les Babouin hospitalisent un de leurs amis, un ligueur de l´Agitation française, auquel ils ont cédé une des chambres de leur villa."
                                            }
                                        ]
