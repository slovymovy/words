                        "examples": [
                            {
                                "example_id": "e953e5dc-104c-4697-a934-4f5e5c96f3eb",
                                "sense_id": "2f18581a-508b-3d00-b735-051022a86b2f",
                                "text": "[A]s the same face of the moon always is turned to the earth, the lunar tides must be permanent, and if the solid parts of the moon be spherical, must always cover the phasis next to us."
