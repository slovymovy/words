                    "common_phrases": [
                        "het budget bewaken",
                        "de kwaliteit bewaken"
                    ],
                    "target_lang_definitions": {
                        "en": "to closely monitor or control something",
                        "ru": "внимательно следить за чем-либо или контролировать процесс"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "monitor",
