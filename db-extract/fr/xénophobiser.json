                        "examples": [
                            {
                                "example_id": "98eaf231-927d-4990-83d4-8224875e63f1",
                                "sense_id": "064cb21b-d860-3452-aa30-66a2a6d24eb2",
                                "text": "Je ne crois pas qu'il faut xénophobiser les personnes qui ont voté \"oui\"."
                            },
                            {
                                "example_id": "c8b586ba-fb68-489e-9626-7241c22d1896",
                                "sense_id": "064cb21b-d860-3452-aa30-66a2a6d24eb2",
                                "text": "Au rythme des élections, la société française se xénophobise."
                            },
                            {
                                "example_id": "e1204286-3a1c-45de-b415-e3801dc24a98",
                                "sense_id": "064cb21b-d860-3452-aa30-66a2a6d24eb2",
                                "text": "Elle se droitise, se fachise, se xénophobise chaque jour un peu plus."
                            }
                        ]
