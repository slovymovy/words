{
    "word_family": [
        "matrices",
        "submatrix",
        "intermatrix"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bd256734-3276-34ae-bf0f-68774503a6bf",
                    "sense_definition": "A rectangular arrangement of numbers or terms used in mathematics to solve equations or transform coordinates.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students learned how to multiply a <w>matrix</w> by a vector in their linear algebra class.",
                            "target_lang_translations": {
                                "ru": "Студенты научились умножать <w>матрицу</w> на вектор на занятии по линейной алгебре."
                            }
                        },
                        {
                            "text": "You can represent a system of linear equations using a square <w>matrix</w>.",
                            "target_lang_translations": {
                                "ru": "Систему линейных уравнений можно представить с помощью квадратной <w>матрицы</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "array",
                        "table"
                    ],
                    "common_phrases": [
                        "square matrix",
                        "identity matrix",
                        "matrix multiplication"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прямоугольная таблица чисел или элементов, используемая в математике для решения уравнений или преобразования координат."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "матрица",
                                "target_lang_sense_clarification": "математический объект"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ae3410c-5d94-3791-98d8-ba049b6d7d42",
                    "sense_definition": "A table or grid of data organized in rows and columns.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "data structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researcher organized the survey results into a data <w>matrix</w> for easier analysis.",
                            "target_lang_translations": {
                                "ru": "Исследователь организовал результаты опроса в <w>матрицу</w> данных для облегчения анализа."
                            }
                        },
                        {
                            "text": "This data <w>matrix</w> shows the relationship between different variables in the study.",
                            "target_lang_translations": {
                                "ru": "Эта <w>матрица</w> данных показывает взаимосвязь между различными переменными в исследовании."
                            }
                        }
                    ],
                    "synonyms": [
                        "array",
                        "table",
                        "grid",
                        "spreadsheet"
                    ],
                    "common_phrases": [
                        "data matrix",
                        "decision matrix"
                    ],
                    "target_lang_definitions": {
                        "ru": "Таблица или сетка данных, организованная в виде строк и столбцов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "матрица",
                                "target_lang_sense_clarification": "структура данных"
                            },
                            {
                                "target_lang_word": "таблица",
                                "target_lang_sense_clarification": "сетка данных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ea34936-3567-3f1a-9c07-29c00446899c",
                    "sense_definition": "The metaphorical or physical environment in which something is developed, formed, or originates.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "environment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city served as a cultural <w>matrix</w> for many new artistic movements.",
                            "target_lang_translations": {
                                "ru": "Город служил культурной <w>основой</w> для многих новых художественных течений."
                            }
                        },
                        {
                            "text": "Family life is the social <w>matrix</w> in which a child's personality is formed.",
                            "target_lang_translations": {
                                "ru": "Семейная жизнь — это та социальная <w>среда</w>, в которой формируется личность ребенка."
                            }
                        }
                    ],
                    "common_phrases": [
                        "social matrix",
                        "cultural matrix"
                    ],
                    "target_lang_definitions": {
                        "ru": "Метафорическая или физическая среда, в которой что-либо развивается, формируется или берет свое начало."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основа",
                                "target_lang_sense_clarification": "база для развития"
                            },
                            {
                                "target_lang_word": "среда",
                                "target_lang_sense_clarification": "окружение"
                            },
                            {
                                "target_lang_word": "матрица",
                                "target_lang_sense_clarification": "порождающая структура"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53748031-b8b8-343a-9195-c30721b775c6",
                    "sense_definition": "A grid-like arrangement of electronic components used for coding or storing information.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "electronics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer inspected the diode <w>matrix</w> to find the fault in the circuit.",
                            "target_lang_translations": {
                                "ru": "Инженер осмотрел диодную <w>матрицу</w>, чтобы найти неисправность в цепи."
                            }
                        },
                        {
                            "text": "A transistor <w>matrix</w> is used in the encoder to manage the sequential gates.",
                            "target_lang_translations": {
                                "ru": "Транзисторная <w>матрица</w> используется в кодере для управления последовательными затворами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "diode matrix",
                        "transistor matrix",
                        "switching matrix"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сетчатая схема расположения электронных компонентов, используемая для кодирования или хранения информации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "матрица",
                                "target_lang_sense_clarification": "электроника"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88edb993-7b03-3ea6-b260-6f0c114eab12",
                    "sense_definition": "The substance or tissue between cells in an organism, providing structural support.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The extracellular <w>matrix</w> plays a vital role in cell communication and growth.",
                            "target_lang_translations": {
                                "ru": "Внеклеточный <w>матрикс</w> играет жизненно важную роль в клеточной коммуникации и росте."
                            }
                        },
                        {
                            "text": "Bone is a specialized type of connective tissue with a hard mineral <w>matrix</w>.",
                            "target_lang_translations": {
                                "ru": "Кость — это особый тип соединительной ткани с твердым минеральным <w>матриксом</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "extracellular matrix",
                        "bone matrix",
                        "mitochondrial matrix"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество или ткань между клетками в организме, обеспечивающая структурную поддержку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "матрикс",
                                "target_lang_sense_clarification": "биологическое вещество"
                            },
                            {
                                "target_lang_word": "матрица",
                                "target_lang_sense_clarification": "межклеточное вещество"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75cfaa47-08cd-3e85-910b-416bd54c38e1",
                    "sense_definition": "A mold or cavity in which something is cast or shaped.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "manufacturing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The molten metal was poured into the <w>matrix</w> to create the specific part.",
                            "target_lang_translations": {
                                "ru": "Расплавленный металл залили в <w>матрицу</w> для создания конкретной детали."
                            }
                        },
                        {
                            "text": "In traditional printing, a copper <w>matrix</w> was used to cast individual letters.",
                            "target_lang_translations": {
                                "ru": "В традиционной печати для отливки отдельных букв использовалась медная <w>матрица</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "printing form"
                    ],
                    "common_phrases": [
                        "copper matrix"
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма или полость, в которой что-либо отливается или формируется."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "матрица",
                                "target_lang_sense_clarification": "печатная или литейная форма"
                            },
                            {
                                "target_lang_word": "форма",
                                "target_lang_sense_clarification": "для литья"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93ee0f1e-f45c-37f7-9f88-eae159346602",
                    "sense_definition": "An archaic term for the womb.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old medical text described how the <w>matrix</w> closes after conception.",
                            "target_lang_translations": {
                                "ru": "В старом медицинском тексте описывалось, как <w>матка</w> закрывается после зачатия."
                            }
                        },
                        {
                            "text": "He studied ancient anatomy books that referred to the uterus as the <w>matrix</w>.",
                            "target_lang_translations": {
                                "ru": "Он изучал древние книги по анатомии, в которых матка называлась <w>матрицей</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical medical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Архаичный термин для обозначения матки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "матрица",
                                "target_lang_sense_clarification": "устар. матка"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d79db0b0-d951-3829-a321-c118b6e9eeb1",
                    "sense_definition": "A simulated reality or computer-generated world where humans are kept in a state of illusion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "simulation",
                    "name_type": "fictional_name",
                    "examples": [
                        {
                            "text": "In the movie, the hero discovers that his entire life has been a simulation called the <w>Matrix</w>.",
                            "target_lang_translations": {
                                "ru": "В фильме герой обнаруживает, что вся его жизнь была симуляцией под названием <w>Матрица</w>."
                            }
                        },
                        {
                            "text": "Many science fiction fans enjoy debating whether we are actually living in the <w>Matrix</w>.",
                            "target_lang_translations": {
                                "ru": "Многие любители научной фантастики любят спорить о том, не живем ли мы на самом деле в <w>Матрице</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the Matrix",
                        "escape the Matrix"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in pop culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Симулированная реальность или компьютерный мир, в котором люди содержатся в состоянии иллюзии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Матрица",
                                "target_lang_sense_clarification": "вымышленная вселенная"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf02e6b9-a69c-32f7-abdb-2e2417ea2632",
                    "sense_definition": "A social system or institution perceived as deceptive, controlling, or illusory.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "simulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some people use the term to describe a desire to escape the <w>matrix</w> of modern corporate life.",
                            "target_lang_translations": {
                                "ru": "Некоторые используют этот термин, чтобы описать желание вырваться из <w>матрицы</w> современной корпоративной жизни."
                            }
                        },
                        {
                            "text": "He argued that the political system was just a <w>matrix</w> designed to keep people compliant.",
                            "target_lang_translations": {
                                "ru": "Он утверждал, что политическая система — это всего лишь <w>матрица</w>, созданная для того, чтобы держать людей в повиновении."
                            }
                        }
                    ],
                    "common_phrases": [
                        "escape the matrix"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often used in conspiracy or self-help contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Социальная система или институт, воспринимаемый как обманчивый, контролирующий или иллюзорный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "матрица",
                                "target_lang_sense_clarification": "социальная система"
                            }
                        ]
                    }
                }
            ]
        }
    ]
