    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "5977759e-0993-3bab-95d6-1aa7dfa54f96",
                    "sense_definition": "In an affectionate, loving, or tender manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He looked <w>fondly</w> at the pictures of his high-school friends.",
                            "target_lang_translations": {
                                "ru": "Он <w>с нежностью</w> смотрел на фотографии своих школьных друзей."
                            }
                        },
                        {
                            "text": "She <w>fondly</w> remembered the long summers they spent together by the lake.",
                            "target_lang_translations": {
                                "ru": "Она <w>с теплотой</w> вспоминала долгие летние дни, проведённые вместе у озера."
                            }
                        }
                    ],
                    "synonyms": [
                        "affectionately",
                        "tenderly",
                        "lovingly",
                        "warmly"
                    ],
                    "antonyms": [
                        "coldly",
                        "harshly"
                    ],
                    "common_phrases": [
                        "remember fondly",
                        "look fondly at",
                        "fondly recalled"
                    ],
                    "target_lang_definitions": {
                        "ru": "С любовью, нежностью или теплотой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с нежностью",
                                "target_lang_sense_clarification": "проявляя нежные чувства"
                            },
                            {
                                "target_lang_word": "с любовью",
                                "target_lang_sense_clarification": "с глубокой привязанностью или теплом"
                            },
                            {
                                "target_lang_word": "с теплотой",
                                "target_lang_sense_clarification": "с тёплыми, приятными чувствами"
                            },
                            {
                                "target_lang_word": "нежно",
                                "target_lang_sense_clarification": "ласково, бережно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f295968-be04-3977-997d-c61865a27745",
                    "sense_definition": "In a foolish, naive, or delusionally hopeful manner.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>fondly</w> imagined that all his financial problems would disappear overnight.",
                            "target_lang_translations": {
                                "ru": "Он <w>наивно</w> воображал, что все его финансовые проблемы исчезнут в одночасье."
                            }
                        },
                        {
                            "text": "She <w>fondly</w> believed that he would change his behavior after the wedding.",
                            "target_lang_translations": {
                                "ru": "Она <w>слепо</w> верила, что после свадьбы он изменит своё поведение."
                            }
                        }
                    ],
                    "synonyms": [
                        "foolishly",
                        "naively",
                        "delusionally"
                    ],
                    "antonyms": [
                        "wisely",
                        "realistically"
                    ],
                    "common_phrases": [
                        "fondly imagine",
                        "fondly hope",
                        "fondly believe"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used to mean foolishly or naively"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наивно, глупо или теша себя иллюзиями (устаревшее или книжное значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наивно",
                                "target_lang_sense_clarification": "простодушно, легковерно"
                            },
                            {
                                "target_lang_word": "слепо",
                                "target_lang_sense_clarification": "не замечая реальности"
                            },
                            {
                                "target_lang_word": "глупо",
                                "target_lang_sense_clarification": "неблагоразумно, неоправданно"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}