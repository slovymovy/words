                        "sense_id": "0db938ba-2753-3743-a711-71ba8d03b709",
                        "entry_id": "cf2f757a-8beb-3ac8-b68e-d12100b97c74",
                        "glosses": [
                            "een bepaald lied dat vaak gezongen of ten gehore wordt gebracht tijdens bijeenkomsten van een club of vereniging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4a1982f-e0f0-4b37-beba-915e1b995e00",
                                "sense_id": "0db938ba-2753-3743-a711-71ba8d03b709",
                                "text": "\"Overal waar ik kom hang ik een vlaggetje neer, kan me niet schelen waar het is,\" zegt de bouwvakker die de vlag ophing tegen AT5. Een collega van hem zet nog even het clublied in."
                            },
                            {
                                "example_id": "2a9a31f0-f9dc-4d02-a715-103f54c1a6fa",
                                "sense_id": "0db938ba-2753-3743-a711-71ba8d03b709",
                                "text": "Heel soms schiet me zomaar het clublied van onze oude studiegroep te binnen, dat we zongen als we bij elkaar zaten. Op de wijs van het voetballied van André Hazes hadden we tekst 'Wij houden van Oranje' aangepast tot: 'Wij houden van lasagne.' Met weemoed denk ik terug aan die lasagnejaren."
                            }
                        ]
                    }
