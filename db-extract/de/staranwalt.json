                        "examples": [
                            {
                                "example_id": "d7e1f2d9-18fa-4b63-850c-1c7c050f75c2",
                                "sense_id": "c722ca31-eba0-3fc9-899a-59b478f195b7",
                                "text": "„Verteidigt von Staranwalt Herbert Eichenseder gibt er an, er kenne die drei mitangeklagten Tschetschenen aus dem von ihm betriebenen Boxklub.“"
                            },
                            {
                                "example_id": "8376487f-5f82-4a3a-b741-db92e65668f5",
                                "sense_id": "c722ca31-eba0-3fc9-899a-59b478f195b7",
                                "text": "„Die Juden in der Schweizer konnten im Kampf um ihre Gleichstellung lange auf einen herausragenden Fürsprecher zählen: den Berner Staranwalt Georges Brunschvig (1908–1973).“"
                            }
                        ],
