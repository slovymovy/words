                "senses": [
                    {
                        "sense_id": "f4fa6c53-bf5f-3500-84c0-f6d6988b2d1c",
                        "entry_id": "b47f1431-587e-33e1-b243-c7e00ae1e744",
                        "glosses": [
                            "einer Lotusblüte nachempfundene, meist beim Meditieren eingenommene Sitzhaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "990a95be-ca60-4e2b-842d-dcc0b117b95d",
                                "sense_id": "f4fa6c53-bf5f-3500-84c0-f6d6988b2d1c",
                                "text": "„Song Park Kim saß den ganzen Flug über reglos im Lotussitz an der gleichen Stelle.“"
                            },
                            {
                                "example_id": "af1fd4b4-815d-4a66-a9ed-7f6f2f66aa69",
                                "sense_id": "f4fa6c53-bf5f-3500-84c0-f6d6988b2d1c",
                                "text": "„Die große Statue einer jungen Frau im Lotussitz nahm die ganze Breite eines Sockels ein.“"
                            },
                            {
                                "example_id": "7a0993da-6855-4a24-a153-c1c58bdd2939",
                                "sense_id": "f4fa6c53-bf5f-3500-84c0-f6d6988b2d1c",
                                "text": "„Too Much löste sich aus dem Lotussitz und erhob sich.“"
                            },
                            {
                                "example_id": "847a5765-780c-4df8-a6c0-1cc569cfaaff",
                                "sense_id": "f4fa6c53-bf5f-3500-84c0-f6d6988b2d1c",
                                "text": "„Der Bus biegt um die Ecke, fährt am nächsten Einkaufszentrum und am nächsten Motel und noch einem Fast-Food-Restaurant vorbei, und dort auf dem Bordstein hockt Mutter Natur im perfekten Lotussitz, die mit dunklen Hennaranken bemalten Hände offen auf den Knien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
