                "senses": [
                    {
                        "sense_id": "f06247c8-9c93-3f88-9238-10b329909ad5",
                        "entry_id": "e80b6141-b361-3b71-a437-1e25fbd27380",
                        "glosses": [
                            "прост. то же, что хворь; болезнь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44296553-f937-4d95-b149-fc99c8a9a0b9",
                                "sense_id": "f06247c8-9c93-3f88-9238-10b329909ad5",
                                "text": "― Может, хвороба какая пристала… еще помрет, пожалуй!"
                            },
                            {
                                "example_id": "47e91de8-a944-4aab-85f8-2b5cc48f12b2",
                                "sense_id": "f06247c8-9c93-3f88-9238-10b329909ad5",
                                "text": "Сегодня у больных может наступить выздоровление после долгой хворобы."
                            }
                        ]
                    }
                ],
                "translations": [
