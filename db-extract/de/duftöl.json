                "senses": [
                    {
                        "sense_id": "183e5323-73ef-30e8-af6b-23a7b23f7602",
                        "entry_id": "ef6297b6-911e-3806-8343-8662a9886602",
                        "glosses": [
                            "ölige Flüssigkeit, die verdunstet oder aufgetragen wird und die Luft mit einem Duftstoff belegt"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "0632bc2b-ac1b-442e-9e5a-40ef9c2e6586",
                                "sense_id": "183e5323-73ef-30e8-af6b-23a7b23f7602",
                                "text": "„Um ätherische Öle im Zimmer zu nutzen, können Sie Duftöle oder Räucherwerk verwenden.“"
                            },
                            {
                                "example_id": "f0c30c59-b2f5-43c0-b665-1fcd491d79aa",
                                "sense_id": "183e5323-73ef-30e8-af6b-23a7b23f7602",
                                "text": "„Ein ätherisches Öl oder auch Duftöl genannt, entsteht durch Wasserdampfdestillation (bei Primavera Life) oder das Herkunftsprodukt wird in organischen Lösungsmitteln gebunden.“"
                            },
                            {
                                "example_id": "8c594364-e45f-4b39-9335-d1c98d887c32",
                                "sense_id": "183e5323-73ef-30e8-af6b-23a7b23f7602",
                                "text": "„An Duftöle aus dem Reformhaus® werden hohe Ansprüche gestellt.“"
                            },
                            {
                                "example_id": "86d4e858-0efd-44d7-9d25-403169246fd0",
                                "sense_id": "183e5323-73ef-30e8-af6b-23a7b23f7602",
                                "text": "„„Natur-Identische“ oder „Synthetische“ Duftöle finden in der Aromapflege bzw. Aromatherapie keine Verwendung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
