                        "sense_id": "4b81400d-17df-3a83-a23e-0a6da24feba2",
                        "entry_id": "3a2b7e19-250e-33aa-863e-a1891e7179b2",
                        "glosses": [
                            "bepalen hoelang iets duurt"
                        ],
                        "tags": [
                            "tijdrekening"
                        ],
                        "examples": [
                            {
                                "example_id": "44a20b6f-6294-4720-9428-205cb71e8d5b",
                                "sense_id": "4b81400d-17df-3a83-a23e-0a6da24feba2",
                                "text": "Ook bij de IAAF (internationale atletiekunie) en de FINA (internationale zwembond) wordt erkend dat tijdmeting in duizendsten van seconden de kans op fouten aanzienlijk vergroot."
                            },
                            {
                                "example_id": "cc158377-62fe-490f-a97f-76ea992a215d",
                                "sense_id": "4b81400d-17df-3a83-a23e-0a6da24feba2",
                                "text": "Op dit moment is de atoomklok de nauwkeurigste klok op aarde. Die wordt gebruikt als onze standaard in tijdmeting. De atoomklok bepaalt de tijd aan de hand van elektronen rondom een atoom. Die springen heen en weer als ze met een straling van een zeer specifieke frequentie worden aangeslagen. De frequentie van de straling bepaalt het tikken van de seconden."
                            }
                        ]
                    }
