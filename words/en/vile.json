            "senses": [
                {
                    "sense_id": "802cbb13-07cd-3462-92cb-f133233397c7",
                    "sense_definition": "Morally low or wicked",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "morally_bad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The criminal made a <w>vile</w> accusation against his innocent neighbor.",
                            "target_lang_translations": {
                                "cs": "Zločinec vznesl <w>odporné</w> obvinění proti svému nevinnému sousedovi.",
                                "nl": "De crimineel deed een <w>verachtelijke</w> beschuldiging tegen zijn onschuldige buurman."
                            }
                        },
                        {
                            "text": "He was known as a <w>vile</w> man who cheated everyone he met.",
                            "target_lang_translations": {
                                "cs": "Byl znám jako <w>hnusný</w> člověk, který podváděl každého, koho potkal.",
                                "nl": "Hij stond bekend als een <w>gemeen</w> man die iedereen die hij ontmoette bedroog."
                            }
                        }
                    ],
                    "synonyms": [
                        "base",
                        "despicable",
                        "mean",
                        "ignoble"
                    ],
                    "common_phrases": [
