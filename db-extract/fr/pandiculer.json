                "senses": [
                    {
                        "sense_id": "2c8cbb8f-5037-3cc1-817b-b02be81b1912",
                        "entry_id": "d2eb74df-98df-35f1-88dd-5977ddd0cdcd",
                        "glosses": [
                            "Effectuer une pandiculation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44e82989-16c7-4df1-b1f1-22a3a4e4b079",
                                "sense_id": "2c8cbb8f-5037-3cc1-817b-b02be81b1912",
                                "text": "Quant à l’amour, il le dédaignait, sans phrases, le considérant négligeable, et si, d’aventure, quelque autre docteur y faisait la moindre allusion sérieuse, aussitôt il bouffonnait et pandiculait en s’esclaffant."
                            },
                            {
                                "example_id": "97ac3e71-6d94-4c15-ae09-b9e1f4d73be9",
                                "sense_id": "2c8cbb8f-5037-3cc1-817b-b02be81b1912",
                                "text": "Après sa sieste, il pandicula avec soin puis s’éloigna comme il était venu vers sa maison."
                            }
                        ]
                    }
                ],
