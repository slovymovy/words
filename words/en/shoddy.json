                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The market was flooded with <w>shoddy</w> that broke after only a few uses.",
                            "target_lang_translations": {
                                "ru": "Рынок был наводнен <w>барахлом</w>, которое ломалось после нескольких использований.",
                                "nl": "De markt werd overspoeld met <w>rommel</w> die na slechts een paar keer gebruiken kapotging.",
                                "cs": "Trh byl zaplaven <w>šmejdem</w>, který se po několika použitích rozbil."
                            }
                        },
                        {
                            "text": "He realized too late that he had spent his savings on absolute <w>shoddy</w>.",
                            "target_lang_translations": {
                                "ru": "Он слишком поздно понял, что потратил свои сбережения на абсолютную <w>халтуру</w>.",
                                "nl": "Hij realiseerde zich te laat dat hij zijn spaargeld aan pure <w>prullaria</w> had uitgegeven.",
                                "cs": "Příliš pozdě si uvědomil, že utratil své úspory za naprostý <w>brak</w>."
                            }
                        }
