                "senses": [
                    {
                        "sense_id": "b9079702-487a-36dd-a373-b404cbf17955",
                        "entry_id": "0897fe67-d603-3c33-af7f-c030099164d4",
                        "glosses": [
                            "Celle dont le métier consiste à manœuvrer un pont roulant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da112be3-4764-4fab-8db0-f27e227965bb",
                                "sense_id": "b9079702-487a-36dd-a373-b404cbf17955",
                                "text": "Le métier de pontier ou pontière consiste à conduire un pont roulant. Un pont roulant est un engin de manutention mécanisé permettant le levage et le transport de lourdes charges."
                            }
                        ]
                    },
                    {
                        "sense_id": "a4a9ebde-cf3f-39a2-ab18-0b6784087927",
                        "entry_id": "0897fe67-d603-3c33-af7f-c030099164d4",
                        "glosses": [
                            "Celle dont le métier consiste à manœuvrer un pont mobile (tournant, levant ou basculant)."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "af963731-069f-4a8e-a830-23ca15cffdf8",
                                "sense_id": "a4a9ebde-cf3f-39a2-ab18-0b6784087927",
                                "text": "La manoeuvre du barrage des Champs-Neufs est assurée par un mécanicien et celle de l'écluse de petite navigation par une éclusière ; celle du barrage de Buzay par deux éclusiers. Enfin, une pontière est chargée de la manoeuvre du passage mobile du Migron."
                            }
                        ]
                    }
                ],
