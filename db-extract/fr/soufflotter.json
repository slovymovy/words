                ],
                "senses": [
                    {
                        "sense_id": "23a17844-69ec-3676-91e0-744c3dcb8929",
                        "entry_id": "35507441-18a5-34d1-91c5-b218f9520390",
                        "glosses": [
                            "Souffler faiblement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a242b0d1-7983-4757-8229-1d109fb58cca",
                                "sense_id": "23a17844-69ec-3676-91e0-744c3dcb8929",
                                "text": "Bien dolent, bien dolent est le cœur du comte. Dans la futaie et sur l'eau le vent soufflotte : […]."
                            },
                            {
                                "example_id": "920f4e36-92fa-4dbd-a5dc-3df1f53f1707",
                                "sense_id": "23a17844-69ec-3676-91e0-744c3dcb8929",
                                "text": "Ses petits-enfants soufflottaient sur le divan ; elle grattait doucement la plante de leurs pieds roses pour améliorer les ris de leurs rêves enfantins."
                            },
                            {
                                "example_id": "6efd7871-d7b3-47a2-91db-720890d449ef",
                                "sense_id": "23a17844-69ec-3676-91e0-744c3dcb8929",
                                "text": "« Ca grimpe gentiment, ça soufflotte ». Sur le port de La Rochelle, menacé par les grandes marées d'équinoxe, on ne cède pas à la psychose Xynthia."
                            }
                        ]
                    }
                ],
