                    {
                        "translation_id": "f2178a57-8910-45f0-a0b6-6ef4b87c59e7",
                        "source_entry_id": "af1fd0e2-ff9f-3d5e-a92e-2ea9cdf67220",
                        "source_sense_id": "94c82d4e-55ad-3d1d-9c0b-81df2dab45aa",
                        "target_lang_word": "ratelaar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ratelaar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "11eac54a-70b6-3af7-871d-2bd19b39fa5f",
                                        "entry_id": "8f891792-ed67-36f1-9edb-593ec2eee571",
                                        "glosses": [
                                            "Rhinanthus angustifolius plantengeslacht uit de bremraapfamilie (Orobanchaceae)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dca4885-19ce-47e0-be14-5f82938b2fbf",
                                                "sense_id": "11eac54a-70b6-3af7-871d-2bd19b39fa5f",
                                                "text": "Al hun tijd, en flink wat geld, steken ze in ’t Kluenven. Gewoon omdat ze ervan genieten. „Tot 1940 was 80 procent van het terrein hei. Wij proberen grote stukken open hei terug te krijgen. We hebben hier zowel droge struikhei als natte dophei”, aldus Winnie. Er groeien bijzondere planten als wolfsklauw, zonnedauw en ratelaar. Inheemse soorten die thuishoren in het gebied."
                                            },
                                            {
                                                "example_id": "4d046ee5-a690-4116-a9a8-b612a50342b0",
                                                "sense_id": "11eac54a-70b6-3af7-871d-2bd19b39fa5f",
                                                "text": "U vaart door de slootjes met een speciaal gebouwde platbodemrondvaartboot door het Natuurgebied. Een eldorado van vaarten omgeven door weelderige bloemen en kruiden waaronder waterlelies, munt, haagwinde, grote ratelaar en krabbescheer. Onderweg vertelt de boswachter over de geheimen van de avond en de nacht in de Weerribben zoals het geheimzinnige geluid van de roerdomp en het kleinst waterhoen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa7e0f6f-b9ca-3afa-8193-1c5813e468ed",
                                        "entry_id": "8f891792-ed67-36f1-9edb-593ec2eee571",
                                        "glosses": [
