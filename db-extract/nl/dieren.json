        "nl-extract.jsonl": [
            {
                "entry_id": "eb6c04c3-59bc-3a01-9aed-788ca7009c67",
                "word": "dieren",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "87795eea-c7a8-3cf5-9284-8044ea03e0c5",
                        "entry_id": "eb6c04c3-59bc-3a01-9aed-788ca7009c67",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord dier"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "b14c5eb1-dfee-45cb-ad72-b4393fc3ef14",
                                "sense_id": "87795eea-c7a8-3cf5-9284-8044ea03e0c5",
                                "text": "In hun vacht brengen de dieren de geur van de zee mee, en hun staarten slaan tegen het meubilair."
                            },
                            {
                                "example_id": "2b151f61-e0c2-4a16-972b-13e89060cac3",
                                "sense_id": "87795eea-c7a8-3cf5-9284-8044ea03e0c5",
                                "text": "Om overlast van het ongedierte te voorkomen, besteedt de gemeente vanaf dit jaar jaarlijks een kwart miljoen euro extra aan preventie. Dat is een verdubbeling. De gemeente waarschuwt dat het doden van de dieren niet bijdraagt aan het verminderen van overlast. \"Als de oorzaken van rattenoverlast niet worden weggenomen, keren ratten altijd terug en blijft overlast terugkomen.\""
                            },
                            {
                                "example_id": "bb2491ed-0221-429e-831c-a911964c8f6b",
                                "sense_id": "87795eea-c7a8-3cf5-9284-8044ea03e0c5",
                                "text": "Op de eenvoudige houten planken ligt een verzameling vergelende schedels, afkomstig van dieren die ze niet eens kan thuisbrengen: lange kaken, stompe schedeldaken, krachtige, scherpe tanden."
                            }
                        ]
                    },
                    {
                        "sense_id": "5832ca8c-b409-3dee-8d9c-1abc82011c8f",
                        "entry_id": "eb6c04c3-59bc-3a01-9aed-788ca7009c67",
                        "glosses": [
                            "taxonomisch rijk, Animalia waartoe ook de mens toe behoort"
                        ],
                        "tags": [
                            "meervoudsvorm als officiële benaming"
                        ],
                        "examples": [
                            {
                                "example_id": "d01526fb-95cd-47e1-9b00-c458e52f11c1",
                                "sense_id": "5832ca8c-b409-3dee-8d9c-1abc82011c8f",
                                "text": "Dieren zijn meercellige chemo-heterotrofe organismen."
                            }
                        ]
                    }
                ],
