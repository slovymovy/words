                "senses": [
                    {
                        "sense_id": "75c79a78-c930-30bd-9043-02114eb02cee",
                        "entry_id": "6dbdec4c-cbc0-31de-98d9-9860a157c3ea",
                        "glosses": [
                            "ein einheimischer Soldat, der im Dienste der deutschen, italienischen, britischen, belgischen, spanischen und portugiesischen Kolonialmacht stand"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "35102eba-164e-3890-8bc5-743161a21bf0",
                        "entry_id": "6dbdec4c-cbc0-31de-98d9-9860a157c3ea",
                        "glosses": [
                            "ein einheimischer Soldat, der im Dienste der deutschen, italienischen, britischen, belgischen, spanischen und portugiesischen Kolonialmacht stand",
                            "im Zeitraum von 1890 bis 1918, ein afrikanischer - anfänglich aus dem englischbesetzten Sudan, später aus den deutschen Schutzgebieten angeworbener - Soldat der Schutz- und Polizeitruppe in Deutsch-Ostafrika"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "bc84c2b8-5eaa-426b-a08f-74ca6281ee36",
                                "sense_id": "35102eba-164e-3890-8bc5-743161a21bf0",
                                "text": "„Während der Kampagne für die Rückgewinnung deutscher Kolonien in den 1920er Jahren diente der Mythos seiner treuen Askari, die bis zum Ende mit ihm gekämpft hätten, zur Widerlegung der so genannten „Kolonialschuldlüge“ – der Behauptung in § 119 des Versailler Vertrages, Deutschland sei unfähig zur Kolonisation. […] Dort war seit der Zeit nach dem ersten Weltkrieg der Mythos der treuen Askari eine der mächtigsten jener „Legenden vom deutschen Kolonialidyll“, gegen die sich Giordano in seinem Film richtete. Die in den späten 1950er undfrühen 1960er Jahren einsetzende DDR-Forschung zum Thema deutsche Kolonialgeschichtesetzte der kolonial romantisch verklärten Figur der „treuen Askari“ dann den „Kolonialsöldner“ entgegen. Diese Figur, die auch in westdeutschen antikolonialen Kreisen aufgegriffen wurde, galt als gewissenlos, brutal, brandschatzend und mordend.“ ('Treue Askari - gefürchtete German soldiers. Kosmopolitische Perspektiven', Stefanie Michels)"
                            },
                            {
                                "example_id": "9c92809e-65fd-4535-ba26-840342a02032",
                                "sense_id": "35102eba-164e-3890-8bc5-743161a21bf0",
                                "text": "„Die Askari waren geboren - eine schwarze Truppe im deutschen Waffenrock.“"
                            },
                            {
                                "example_id": "ef31c1d6-ad19-4eb7-a107-eac5139b6046",
                                "sense_id": "35102eba-164e-3890-8bc5-743161a21bf0",
                                "text": "„Viele ihrer Männer dienten den Deutschen unter General Paul von Lettow-Vorbeck als Askari.“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
