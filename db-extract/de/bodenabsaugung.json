                ],
                "senses": [
                    {
                        "sense_id": "2e33032f-b4b1-39c6-b403-654eb7abcb2b",
                        "entry_id": "9a98fca7-bf37-3fce-aa65-5dee9ef8ef99",
                        "glosses": [
                            "das Absaugen von Emissionen in Bodennähe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b35265e-63a2-4afe-b78d-14bb6cf80ae5",
                                "sense_id": "2e33032f-b4b1-39c6-b403-654eb7abcb2b",
                                "text": "„Nicht zuletzt dieser Umstand hat dazu geführt, von weiteren generellen Angaben abzusehen, so dass in der aktuellen Fassung weitere Angaben zu Teil-Volumenströmen wie die Bodenabsaugung entfallen sind.“"
                            },
                            {
                                "example_id": "6dc1b5b0-fb04-4121-b1ea-ff189c43e920",
                                "sense_id": "2e33032f-b4b1-39c6-b403-654eb7abcb2b",
                                "text": "„In der Simulation bestätigt sich die gemessene Strömungssituation, bei der nur ein geringer Teil der Luft tatsächlich über die Bodenabsaugung ausgetragen wird.“"
                            },
                            {
                                "example_id": "c10360a0-2e25-48ea-84dc-01318d4e7bb6",
                                "sense_id": "2e33032f-b4b1-39c6-b403-654eb7abcb2b",
                                "text": "„Die Norm unterstützt die Planung, Ausführung und den Betrieb der Lufttechnik im Labor unter Berücksichtigung der vielen möglichen Schnittstellen zwischen der raumlufttechnischen Anlage (im Folgenden kurz RLT-Anlage genannt) und sicherheitstechnisch relevanten ablufttechnischen Einrichtungen wie Abzügen, Punktabsaugungen, belüfteten Sicherheitsschränken oder Bodenabsaugungen.“"
                            },
                            {
                                "example_id": "291abbe8-a47b-4d67-af22-a0333c231840",
                                "sense_id": "2e33032f-b4b1-39c6-b403-654eb7abcb2b",
                                "text": "„Gegenüberliegend von der Bodenabsaugung ist bauseits eine Frischluftzufuhr zu gewährleisten.“"
                            },
                            {
                                "example_id": "ea679701-24bc-4c26-83c5-df65318a9425",
                                "sense_id": "2e33032f-b4b1-39c6-b403-654eb7abcb2b",
                                "text": "„Die Bodenabsaugung ist wichtig, um die vom Boden verdampfenden Stickstoffgase frühzeitig zu erfassen und sie gar nicht bis in den Einatembereich gelangen zu lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
