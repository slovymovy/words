                "senses": [
                    {
                        "sense_id": "b1103685-a939-321c-b138-d57188692424",
                        "entry_id": "5f2fc34e-b37a-3f43-bd72-b8d087aeea3e",
                        "glosses": [
                            "Gerät, mit dem man ein anderes aus der Entfernung steuern kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d132f82b-aff2-4637-964d-6ff75fd25823",
                                "sense_id": "b1103685-a939-321c-b138-d57188692424",
                                "text": "„Es war das Modell einer prächtigen Jacht und die riesige Fernsteuerung mit zwei Antennen trug der Sohn stolz an einem Gurt um den Hals.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe2adbed-eae2-4d47-b6c6-db3743328b96",
                        "source_entry_id": "5f2fc34e-b37a-3f43-bd72-b8d087aeea3e",
                        "source_sense_id": "b1103685-a939-321c-b138-d57188692424",
                        "source_sense_description": "Technik: Gerät, mit dem man ein anderes aus der Entfernung steuern kann",
                        "target_lang_word": "remote control",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "remote control",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9fca607-4a0f-3954-a6cb-1a3ad1666792",
                                        "entry_id": "1a5c2404-53e8-3018-9239-55524d2164f8",
                                        "glosses": [
                                            "A device used to operate an appliance (such as a television, vehicle, or mechanical toy) from a short distance away."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "230dd112-7ff8-49b8-b382-7654069edde4",
                                                "sense_id": "e9fca607-4a0f-3954-a6cb-1a3ad1666792",
                                                "text": "A single slice of this could leave you supine in front of the Queen's speech without even the wherewithal to reach for the remote control."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52aa3ad8-7ca5-3b69-9f56-c03e0e29b376",
                                        "entry_id": "1a5c2404-53e8-3018-9239-55524d2164f8",
                                        "glosses": [
                                            "A means of operating a device from a distance."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f16648b-7a63-4085-bbbc-56f1a6c39d6f",
                                                "sense_id": "52aa3ad8-7ca5-3b69-9f56-c03e0e29b376",
                                                "text": "The bomb was detonated by remote control."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a7529da-88b8-4393-9b8d-f5299bbf1aa7",
                        "source_entry_id": "5f2fc34e-b37a-3f43-bd72-b8d087aeea3e",
                        "source_sense_id": "b1103685-a939-321c-b138-d57188692424",
                        "source_sense_description": "Technik: Gerät, mit dem man ein anderes aus der Entfernung steuern kann",
                        "target_lang_word": "télécommande",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "télécommande",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e0cf621-0967-35f6-b0c6-03760cef0a3f",
                                        "entry_id": "b1db6fd2-56c5-36a0-9e73-b4190f35722b",
                                        "glosses": [
                                            "Transmission à distance d’un signal déclenchant l’exécution d’un ordre par un dispositif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dcbf0dd-95c0-4140-ab1b-ee71fdeea6d5",
                                                "sense_id": "5e0cf621-0967-35f6-b0c6-03760cef0a3f",
                                                "text": "Télécommande des aiguillages, des machines-outils, des avions."
                                            },
                                            {
                                                "example_id": "c68714d8-9d12-4c00-a031-36079e23a0cd",
                                                "sense_id": "5e0cf621-0967-35f6-b0c6-03760cef0a3f",
                                                "text": "J’enclenche la cassette, je sirote du thé au jasmin. De temps en temps, je reviens en arrière, grâce à ce rosaire laïc qu’on appelle télécommande."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "710802dd-202b-38c2-babf-ec91d0f9055f",
                                        "entry_id": "b1db6fd2-56c5-36a0-9e73-b4190f35722b",
                                        "glosses": [
                                            "Petit boîtier à boutons permettant de commander à distance un appareil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e271f95-cdcc-4e2d-af76-2e2431cadefe",
                                                "sense_id": "710802dd-202b-38c2-babf-ec91d0f9055f",
                                                "text": "D’emblée, monsieur Spitzweg s’est senti bien avec son magnétoscope. Les petites lettres bleues qui défilent sur l’écran de contrôle, les hoquets tranquilles des ressorts quand on introduit la cassette. La télécommande, surtout. Ah ! oui, ce petit geste du bras dominateur qui se tend vers l’appareil, de la main qui se penche avec une autorité condescendante : obéis-moi, ma chose, soumets-moi tes fonctions. Monsieur Spitzweg a rarement senti tant de docilité. Il n’a pas de chien, pas de jardin, pas de voiture : ce qui lui obéit, c’est son magnétoscope."
                                            },
                                            {
                                                "example_id": "d4577c93-5ff7-43a3-8005-80e355644e30",
                                                "sense_id": "710802dd-202b-38c2-babf-ec91d0f9055f",
                                                "text": "Ça me fait penser à allumer la téloche pour regarder les infos de 9 h. J’attrape la télécommande et je mets la dix."
                                            },
                                            {
                                                "example_id": "b8f11a4c-07b1-42f2-9b4b-f64f3ad6fb48",
                                                "sense_id": "710802dd-202b-38c2-babf-ec91d0f9055f",
                                                "text": "Nous nous affalons côte à côte dans le grand canapé blanc, moelleux comme un marshmallow géant ; mon corps s'enfonce confortablement dans les coussins tandis que Damen attrape la télécommande et se blottit contre moi."
                                            },
                                            {
                                                "example_id": "25130029-ae8e-43b9-bdef-c12fa0268ba2",
                                                "sense_id": "710802dd-202b-38c2-babf-ec91d0f9055f",
                                                "text": "Quand la jeune femme appuya sur la télécommande pour verrouiller sa voiture, les clignotants bipèrent en rythme avec les lointains échos de musique et de rires."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "télécommande",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50a83af8-1782-31b8-b576-f85dae00fbf5",
                                        "entry_id": "a58c93c3-a6ff-327e-b5f9-b54cb11f6035",
