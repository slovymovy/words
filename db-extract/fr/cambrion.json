                        "examples": [
                            {
                                "example_id": "03f8c17a-2102-4c4f-b92b-ed6024ae8388",
                                "sense_id": "d9756029-bf42-3def-8607-af34bc35ac61",
                                "text": "Entre la semelle première et la seconde est collé à la partie antérieure un remplissage se prolongeant à la partie postérieure par un cambrion destiné à soutenir la cambrure de la voûte plantaire."
                            }
                        ]
                    }
