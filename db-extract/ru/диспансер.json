                "senses": [
                    {
                        "sense_id": "5c8f7f5b-17b4-3e31-8d75-4d8cc32ea5aa",
                        "entry_id": "f2d28ad3-67ef-39b0-84ce-cab59e4b28f7",
                        "glosses": [
                            "мед. специализированное медицинское учреждение, осуществляющее диагностику, профилактику, динамическое наблюдение и лечение определенного типа заболеваний у определенного контингента больных"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3e60e65-2f8e-43a0-9ac6-f8763eee9926",
                                "sense_id": "5c8f7f5b-17b4-3e31-8d75-4d8cc32ea5aa",
                                "text": "Антиалкогольная пропаганда естественно должна входить в задачу диспансеров разного рода и прежде всего наркодиспансеров."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47729f14-4b3f-41f1-930d-479e5702e690",
                        "source_entry_id": "f2d28ad3-67ef-39b0-84ce-cab59e4b28f7",
                        "source_sense_id": "5c8f7f5b-17b4-3e31-8d75-4d8cc32ea5aa",
                        "target_lang_word": "sanitarium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sanitarium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c064cde-af04-3fe7-ad95-75801ae4f371",
                                        "entry_id": "15b95338-73e1-352f-bc91-6fca2442b34f",
                                        "glosses": [
                                            "Alternative form of sanatorium."
                                        ],
                                        "tags": [
                                            "US",
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddafc569-b806-4a76-a6f8-540308a5afce",
                                                "sense_id": "9c064cde-af04-3fe7-ad95-75801ae4f371",
                                                "text": "[H]e was led away to a private sanitarium for mental disease, while in the newspapers appeared pathetic accounts of his mental breakdown and of the saintliness of his character."
                                            },
                                            {
                                                "example_id": "74caa363-7d8b-45f5-b09b-9bf69ef415ca",
                                                "sense_id": "9c064cde-af04-3fe7-ad95-75801ae4f371",
                                                "text": "Of all the queer collections of humans outside of a crazy asylum, it seemed to me this sanitarium was the cup winner. […] When you're well enough off so's you don't have to fret about anything but your heft or your diseases you begin to get queer, I suppose."
                                            },
                                            {
                                                "example_id": "b0c2c04a-5d07-454f-9fcd-831219d51872",
                                                "sense_id": "9c064cde-af04-3fe7-ad95-75801ae4f371",
                                                "text": "Treatment in tuberculosis sanitariums at the expense of the public might be warranted."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
