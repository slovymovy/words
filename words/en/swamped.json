    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9242946c-026b-3315-832a-8a92c299dfcc",
                    "sense_definition": "extremely busy or overwhelmed by having too much work or too many things to deal with at once",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "busy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He can’t talk to you right now because he is <w>swamped</w> with urgent emails.",
                            "target_lang_translations": {
                                "ru": "Он не может сейчас с вами поговорить, потому что он <w>завален</w> срочными письмами."
                            }
                        },
                        {
                            "text": "The customer service team was <w>swamped</w> with calls immediately after the new product launch.",
                            "target_lang_translations": {
                                "ru": "Служба поддержки была <w>перегружена</w> звонками сразу после запуска нового продукта."
                            }
                        }
                    ],
                    "synonyms": [
                        "overwhelmed",
                        "overloaded",
                        "snowed under",
                        "busy"
                    ],
                    "antonyms": [
                        "free",
                        "idle",
                        "unoccupied"
                    ],
                    "common_phrases": [
                        "swamped with work",
                        "absolutely swamped",
                        "swamped with requests"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "commonly used in informal or business contexts to describe being busy"
                        }
                    ],
                    "target_lang_definitions": {
