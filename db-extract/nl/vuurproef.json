                        "sense_id": "a678dcba-32f0-3e93-9419-3e0f0a72375a",
                        "entry_id": "687c598f-7b17-3077-b40b-e65d3e90eaf2",
                        "glosses": [
                            "heel lastige situatie waarin meteen duidelijk wordt of vereiste kwaliteiten aanwezig zijn"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "84d30263-42ef-4752-a747-576ca77a0046",
                                "sense_id": "a678dcba-32f0-3e93-9419-3e0f0a72375a",
                                "text": "Het referendum zondag is vuurproef voor de Italiaanse premier die bijna drie jaar na zijn aanstelling het krediet bij de kiezers lijkt te hebben verspeeld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d396bdf-e307-4bc2-9cc6-c1d8af41c921",
                        "source_entry_id": "687c598f-7b17-3077-b40b-e65d3e90eaf2",
                        "source_sense_id": "39719730-61a8-3061-a6fe-85fb43b013a6",
                        "source_sense_description": "soort godsoordeel",
                        "target_lang_word": "Feuerprobe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feuerprobe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4162cbbb-ae04-347f-8fca-ed14ca87c555",
                                        "entry_id": "c4652c37-1545-31dc-afbc-e06478188e0a",
                                        "glosses": [
                                            "mittelalterliches Verfahren für ein Gottesurteil, bei dem Körperteile des Angeklagten (beispielsweise Füße, Hände) kurzzeitig unerträglicher Hitze ausgesetzt wurden. Verheilte die Wunde schnell (beispielsweise innerhalb von drei Tagen), so galt der Angeklagte als unschuldig, anderenfalls wurde er bestraft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4bbaba4-bfe8-424c-923c-c04b1063d0e7",
                                                "sense_id": "4162cbbb-ae04-347f-8fca-ed14ca87c555",
                                                "text": "Bei der Feuerprobe musste man über glühende Kohlen laufen oder ein glühendes Eisen tragen. Heilte die Wunde, ohne zu eitern, galt das als Unschuldsbeweis."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fec6b63d-0c53-3e2d-874a-c7dd870033a2",
                                        "entry_id": "c4652c37-1545-31dc-afbc-e06478188e0a",
                                        "glosses": [
                                            "Situation / Test, in der eine Person zeigen soll, dass sie hohen Anforderungen / Belastungen gewachsen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02e02a28-bdc5-4a19-97f4-89cabbf5fdb0",
                                                "sense_id": "fec6b63d-0c53-3e2d-874a-c7dd870033a2",
                                                "text": "Mit etwas Glück und großem Kampfgeist hat der Nachwuchs der deutschen [Fußball-]Weltmeister die Feuerprobe gegen heißblütige Chilenen [beim Confed-Cup 2017] bestanden."
                                            },
                                            {
                                                "example_id": "f2807f5f-7860-488a-9a19-a35eee0e2cad",
                                                "sense_id": "fec6b63d-0c53-3e2d-874a-c7dd870033a2",
                                                "text": "Die Feuerprobe für die [aus den Parlamenten ausgeschiedene] FDP und ihren Parteivorsitzenden ist die Landtagswahl in Nordrhein-Westfalen."
                                            },
                                            {
                                                "example_id": "12beebf6-ee22-45c5-a860-ad34926b6625",
                                                "sense_id": "fec6b63d-0c53-3e2d-874a-c7dd870033a2",
                                                "text": "Yehudi Menuhin bezeichnete die 24 Capricen für Violine solo von Niccolò Paganini einmal als „das Neue Testament der Geiger“. Jeder Virtuose muss diesen Parcours geigerischer Höchstschwierigkeiten beherrschen. Er ist die Feuerprobe, die ultimative Herausforderung."
                                            },
                                            {
                                                "example_id": "d9457f66-bd97-4146-a0ec-9691b5d06d6b",
                                                "sense_id": "fec6b63d-0c53-3e2d-874a-c7dd870033a2",
                                                "text": "[…] die Debatte gestern Nachmittag verlief [im niederländischen Parlament …] heftig. Doch Khadija Arib bestand diese Feuerprobe mit Bravour. Souverän leitete die Präsidentin die Debatte, sie ließ sich durch nichts und niemanden aus der Ruhe bringen […]."
                                            },
                                            {
                                                "example_id": "69e808a3-6610-48d7-8bab-607c4d85962b",
                                                "sense_id": "fec6b63d-0c53-3e2d-874a-c7dd870033a2",
                                                "text": "Für Pfarrerin Minder geht's zur Feuerprobe […]. Die neue Pfarrerin Yvonne Minder ist unterwegs zu ihrer ersten Andacht im Alters- und Pflegeheim Regenbogen. Wie werden die Dorfältesten wohl auf die junge, zugezogene Geistliche reagieren?"
                                            },
                                            {
                                                "example_id": "f55f3c00-3667-47aa-9826-cd18edabb1a3",
                                                "sense_id": "fec6b63d-0c53-3e2d-874a-c7dd870033a2",
                                                "text": "Kaum fertig gebaut, wartet auf die Kreuzfahrtschiffe der Meyer Werft die erste Feuerprobe: Die Riesenschiffe müssen über die vergleichsweise schmale Ems manövriert werden."
                                            },
                                            {
                                                "example_id": "eb56c8bd-9e10-40c1-9ddd-b6da96a79524",
                                                "sense_id": "fec6b63d-0c53-3e2d-874a-c7dd870033a2",
                                                "text": "Das Kapital für die Serienfertigung konnten sie bei der Crowdfunding-Plattform Startnext einwerben. „Unsere eigentliche Feuerprobe“, sagt Niklas Keßler. Innerhalb einer Laufzeit von knapp acht Wochen sollten 7500 Euro zusammenkommen – andernfalls hätten die beiden einpacken können."
                                            },
                                            {
                                                "example_id": "a286a674-aac2-4d16-bd58-60391bd9173b",
                                                "sense_id": "fec6b63d-0c53-3e2d-874a-c7dd870033a2",
                                                "text": "Zwar gibt es in Deutschland seit kurzer Zeit eine neues Gesetz zum Schutz von Urheberrechten, die Auslegung, Interpretation und Verfassungsmäßigkeit dieses Gesetzes steht aber noch vor der Feuerprobe, weil es in Konkurrenz zu erheblich höheren und durch das Grundgesetz geschützten Rechten steht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2e63c19-6af9-45f8-a4fe-5b91f897b7ad",
                        "source_entry_id": "687c598f-7b17-3077-b40b-e65d3e90eaf2",
                        "source_sense_id": "39719730-61a8-3061-a6fe-85fb43b013a6",
                        "source_sense_description": "soort godsoordeel",
                        "target_lang_word": "trial by fire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trial by fire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb8e60eb-b5d8-373c-9158-78d88bbe3349",
                                        "entry_id": "bae9deea-6a93-35fa-9130-7fc84524adec",
                                        "glosses": [
                                            "A test in which a person is exposed to flames in order to assess their truthfulness, commitment, courage etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72254107-90e5-48fe-821d-ff279a6e3529",
                                                "sense_id": "cb8e60eb-b5d8-373c-9158-78d88bbe3349",
                                                "text": "“[I]t seems to me Fra Francesco is the greater hero, for he offers to enter the fire for the truth, though he is sure the fire will burn him.” . . .\n“It is true, Messer Segretario,” said the shopkeeper, with subdued impatience. “But will you favour us by interpreting the Latin?”\n“Assuredly,” said Tito. “It does but express the conclusions or doctrines which the Frate specially teaches, and which the trial by fire is to prove true or false.”"
                                            },
                                            {
                                                "example_id": "9c43b92a-482b-4730-b488-71e1633c2390",
                                                "sense_id": "cb8e60eb-b5d8-373c-9158-78d88bbe3349",
                                                "text": "And he pointed with his little assegai, the assegai handled with the royal wood, to where the fire glowed reddest—ay, he pointed and laughed. Then, my father, I grew cold indeed—yes, I grew cold who soon should be hot, for I saw the purpose of Chaka. He would put me to the trial by fire."
                                            },
                                            {
                                                "example_id": "8d984e94-8a1b-4e36-b0ad-5123f8344193",
                                                "sense_id": "cb8e60eb-b5d8-373c-9158-78d88bbe3349",
                                                "text": "[T]he final test, the trial by fire, which took place in a subterranean chamber of the great temple, resulted in a candidate whose courage failed him being precipitated into that lake of flame which I have already described."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99be97f4-086e-3a08-84c4-3ec4cf9cc006",
                                        "entry_id": "bae9deea-6a93-35fa-9130-7fc84524adec",
                                        "glosses": [
                                            "A situation in which a soldier or other combatant faces the discharge of opposing weapons, as a test of their fortitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39ec36ac-c769-462b-aa1a-fbd8681dcf11",
                                                "sense_id": "99be97f4-086e-3a08-84c4-3ec4cf9cc006",
                                                "text": "French troops, submitting to a trial by fire, drew toward the German forts, capturing and holding some machine-gun nests."
                                            },
                                            {
                                                "example_id": "143eda17-e244-4ec7-b16e-4dd5393c34fd",
                                                "sense_id": "99be97f4-086e-3a08-84c4-3ec4cf9cc006",
                                                "text": "Pork Chop Hill. Director Lewis Milestone . . . has produced a nerve-shattering study of how the American infantryman met his trial by fire in Korea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90f9b688-f70c-3ddf-bc7f-330f92572e74",
                                        "entry_id": "bae9deea-6a93-35fa-9130-7fc84524adec",
                                        "glosses": [
                                            "Any ordeal which tests one's strength, endurance or resolve."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f03a9595-a898-4185-8c74-7c0b1a0852c3",
                                                "sense_id": "90f9b688-f70c-3ddf-bc7f-330f92572e74",
                                                "text": "But take it all in all, the overland trail was a trial by fire. One gets a notion of its deadliness from the fact that over five thousand people died of cholera alone."
                                            },
                                            {
                                                "example_id": "a85e3e6e-7290-41ee-9a85-a050f3ac53d0",
                                                "sense_id": "90f9b688-f70c-3ddf-bc7f-330f92572e74",
                                                "text": "Now, residents' legendary 100+-hour workweek may be on its way out. . . . Some doctors insist the long hours are a necessary trial by fire that produces highly skilled, virtually unflappable physicians."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
