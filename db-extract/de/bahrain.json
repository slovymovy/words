                                        "glosses": [
                                            "νησί και χώρα της Μέσης Ανατολής, με πρωτεύουσα τη Μανάμα, γλώσσα τα αραβικά και νόμισμα το δηνάριο"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
