{
    "word_family": [
        "prescription",
        "prescriptible",
        "imprescriptible",
        "prescripteur",
        "prescriptif"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5ee5c0e6-12ef-3045-ad42-b60324e9e66f",
                    "sense_definition": "Indiquer et ordonner l'usage d'un médicament ou d'un traitement médical.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a décidé de lui <w>prescrire</w> des antibiotiques pour traiter son infection pulmonaire."
                        },
                        {
                            "text": "Elle ne peut pas vous <w>prescrire</w> un tel traitement sans effectuer d'abord des analyses complètes."
                        }
                    ],
                    "synonyms": [
                        "ordonner"
                    ],
                    "common_phrases": [
                        "prescrire un traitement",
                        "prescrire du repos"
                    ]
                },
                {
                    "sense_id": "145bbe00-d50f-3f7a-b84a-5d660f379f21",
                    "sense_definition": "Ordonner, commander ou recommander formellement ce qui doit être fait.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "injonction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le règlement de sécurité <w>prescrit</w> le port du casque sur l'ensemble de ce chantier."
                        },
                        {
                            "text": "La direction a <w>prescrit</w> des mesures strictes pour réduire les dépenses inutiles de l'entreprise."
                        }
                    ],
                    "synonyms": [
                        "ordonner",
                        "commander",
                        "édicter"
                    ],
                    "antonyms": [
                        "interdire",
                        "proscrire"
                    ],
                    "common_phrases": [
                        "prescrire des règles",
                        "prescrire des mesures"
                    ]
                },
                {
                    "sense_id": "c7722631-5ab5-3b4e-8c53-f6fae357efa2",
                    "sense_definition": "En parlant d'un droit, d'une dette ou d'une poursuite judiciaire, s'éteindre par l'effet du temps.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "droit_extinction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette juridiction, les délits mineurs se <w>prescrivent</w> généralement après une période de trois ans."
                        },
                        {
                            "text": "L'action en justice s'est <w>prescrite</w> parce que le plaignant a attendu trop longtemps avant d'agir."
                        }
                    ],
                    "synonyms": [
                        "s'éteindre"
                    ],
                    "common_phrases": [
                        "se prescrire par"
                    ]
                },
                {
                    "sense_id": "1dd2147b-68f2-3e58-9ab6-62a96f2c04ec",
                    "sense_definition": "Acquérir un droit réel ou se libérer d'une obligation par l'écoulement prolongé d'un délai légal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "droit_acquisition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un locataire ne peut jamais <w>prescrire</w> le bien immobilier qu'il occupe à titre précaire."
                        },
                        {
                            "text": "La loi précise clairement qu'on ne peut pas <w>prescrire</w> contre les biens inaliénables de l'État."
                        }
                    ],
                    "common_phrases": [
                        "prescrire une dette",
                        "prescrire contre"
                    ]
                }
            ]
        }
    ]
}